# Compilation cache
.btrc-cache/

# Generated C files from btrc compilation (named after their test_*.btrc).
# Hand-written C-interop fixtures (e.g. cenum/color.c) are NOT generated and
# must stay tracked, so only ignore the test_*.c the runner/emit produces.
src/tests/**/test_*.c
examples/**/*.c

# Example binaries (compiled from generated C)
examples/todo/todo
examples/game/game
examples/triangle/triangle
examples/sgd/sgd
examples/tray/tray_demo

# macOS
.DS_Store

# LSP server venv
src/devex/lsp/.venv/

# Generated devcontainer
.devcontainer/

