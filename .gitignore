bin/
__pycache__/
.pytest_cache/
.ruff_cache/
*.pyc
*.o
*.dSYM/
*.egg-info/

# Coverage artifacts
.coverage
.coverage.*
htmlcov/
coverage.json
coverage.xml

# Compilation cache
.btrc-cache/

# Generated C from the examples; their native package sources stay tracked.
examples/**/*.c
!examples/native-package/packages/**/native/*.c

# Example binaries (compiled from generated C)
examples/todo/todo
examples/game/game
examples/triangle/triangle
examples/sgd/sgd
examples/tray/tray_demo
examples/callback/callback
examples/realtime-primitives/realtime-primitives
examples/realtime-primitives/realtime-gain
examples/*/*.link.json
# Output-publication locks the compilers leave beside generated files
examples/**/.btrc-*.lock
examples/native-package/build/

# macOS
.DS_Store

# LSP server venv
src/devex/lsp/.venv/

# Generated devcontainer
.devcontainer/

# Claude Code
# Claude Code: local state stays private, but the session hook and the
# project settings that register it are part of the repository.
.claude/*
!.claude/settings.json
!.claude/hooks/

# VS Code extension build artifacts
/build/devex/vscode/

# GUI and rendering example binaries
examples/gui/gui_font
examples/sgd-render/sgd_render
examples/*/frames/

# Local build artifacts. The tracked `build/*.nix` files are authored policy,
# so ignore only generated children; a new policy file must remain visible.
/build/generated/
/build/test-btrcc/
/build/architecture/
/build/out/
/build/lib/
/build/stdlib/
/build/verification/
/build/bdist.*/
/build/btrcc/
/build/temp.*/
/dist/
/build/logs/

# Local symlinks that keep heavy build output off synced storage; the tracked
# build/*.nix files stay in the real directory.
/build/*
!/build/*.nix
/dist
