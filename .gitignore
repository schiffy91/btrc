.claude/

# VS Code extension build artifacts
src/devex/ext/out/
src/devex/ext/node_modules/
src/devex/ext/server/
src/devex/ext/*.vsix

# GPU runtime
src/stdlib/gpu/build/

# GUI runtime
src/stdlib/gui/build/

# Benchmark generated C + binaries
bench/*.c
bench/fib
bench/loop
bench/vector
bench/strings

# GUI example binary
examples/gui/gui_demo

