import Library.Callback;
import Library.GUI.GUI;
import Library.GUI.IWindow;
import Library.GUI.IGPUView;
import Library.GPU.Readback;

import ./Input.btrc;
import ./Time.btrc;
import ./Gameobject.btrc;
import ./Renderer.btrc;

/* The native application owns the window, GPU child and asynchronous programs.
 * This engine owns keyboard registration and the scene's uniform resources. */
class Engine {
	public IWindow window;
	public IGPUView view;
	public Input input;
	public Time time;
	public Renderer? renderer;
	public int width;
	public int height;
	private CallbackScope _keys = CallbackScope();
	private bool _closed = false;

	public Engine(string title, int width, int height) {
		self.window = GUI.createWindow(title, (double)width, (double)height);
		self.view = GUI.createGPUView();
		self.window.attachRoot(self.view);
		self.input = Input();
		self.time = Time();
		self.window.onKey(self.input, self._keys);
		self.window.show();
	}

	public bool isRunning() { return !self._closed && self.window.isOpen(); }

	public bool update() {
		self.time.update();
		if (!self.isRunning()) { return false; }
		if (!self.window.isFocused()) { self.input.reset(); }
		bool ready = self.view.poll();
		if (!self.view.error().isEmpty()) { throw self.view.error(); }
		if (!ready) { return false; }
		self.width = self.view.pixelWidth();
		self.height = self.view.pixelHeight();
		var renderer = self.renderer;
		if (renderer == null) {
			renderer = Renderer(self.view, self.width, self.height);
			self.renderer = renderer;
		}
		if (renderer == null) { throw "Game renderer construction returned no owner"; }
		renderer.resize(self.width, self.height);
		return renderer.poll();
	}

	public GPUReadback? render(GameObject player, bool capture = false) {
		var renderer = self.renderer;
		if (renderer == null) { throw "Game renderer is not ready"; }
		return renderer.render(self.view, player, self.time.elapsed, capture);
	}

	public void close() {
		self._closed = true;
		if (self._keys != null) { self._keys.cancel(); }
		if (self.renderer != null) { self.renderer.close(); }
	}

	public void __del__() { self.close(); }
}
