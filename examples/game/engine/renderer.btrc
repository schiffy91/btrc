/* btrc 3D Engine -- Renderer
 *
 * Thin wrapper around Scene. Sets up camera follow and renders.
 */

class Renderer {
    public Scene scene;
    public int width;
    public int height;

    public Renderer(GPU gpu, int w, int h) {
        self.width = w;
        self.height = h;
        self.scene = new Scene(gpu, w, h);
    }

    public GPUFrameKind render(GPU gpu, GameObject player, float time) {
        return self.scene.render(gpu, player, time);
    }

    public void resize(int w, int h) {
        self.width = w;
        self.height = h;
        self.scene.resize(w, h);
    }

    public void close() { self.scene.close(); }

    public void __del__() { self.close(); }
}
