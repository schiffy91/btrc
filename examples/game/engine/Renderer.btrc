import Library.GUI.IGPUView;
import Library.GPU.Readback;

import ./Scene.btrc;
import ./Gameobject.btrc;

class Renderer {
	public Scene scene;

	public Renderer(IGPUView view, int width, int height) { self.scene = Scene(view, width, height); }

	public bool poll() { return self.scene.poll(); }

	public GPUReadback? render(IGPUView view, GameObject player, float time, bool capture = false) { return self.scene.render(view, player, time, capture); }

	public void resize(int width, int height) { self.scene.resize(width, height); }

	public void close() { if (self.scene != null) { self.scene.close(); } }

	public void __del__() { self.close(); }
}
