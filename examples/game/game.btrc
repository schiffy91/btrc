/* btrc 3D Ball Game
 *
 * A ball on a ground plane with WASD movement and space to jump.
 * Rendered via GPU raymarching with shadows and lighting.
 *
 * Build:
 *   make gpu && make -C examples/game
 *   ./examples/game/game
 */
#include "engine/engine.btrc"

int main() {
	var engine = Engine("btrc 3D Ball", 800, 600);
	var player = new GameObject();
	float speed = 4.0;

	while (engine.isRunning()) {
		engine.update();
		if (!engine.isRunning()) { continue; }
		float dt = engine.time.deltaTime;

		if (engine.input.key(APP_KEY_W)) { player.move(0.0, 0.0, speed * dt); }
		if (engine.input.key(APP_KEY_S)) { player.move(0.0, 0.0, -speed * dt); }
		if (engine.input.key(APP_KEY_A)) { player.move(speed * dt, 0.0, 0.0); }
		if (engine.input.key(APP_KEY_D)) { player.move(-speed * dt, 0.0, 0.0); }
		if (engine.input.key(APP_KEY_SPACE)) { player.jump(speed); }
		if (engine.input.key(APP_KEY_ESCAPE)) { break; }

		player.applyPhysics(dt);
		engine.render(player);
	}
	engine.close();
	return 0;
}
