/* btrc native system tray — example.
 *
 * Creates a REAL OS menu-bar / notification-area icon with a native clickable
 * menu. Selecting an item runs that item's shell command via the UnixShell
 * stdlib. "Quit" stops the loop and removes the icon.
 *
 * Build + run (macOS):   make            (this folder)
 * Native initialization failures are reported explicitly.
 */
import Library.UI;
import Library.Tray.Tray;

int main() {
	SystemTray tray = SystemTray("btrc")
		.tip("btrc native tray demo")
		.icon("icon.png")                                  // falls back to text
		.item("Open Anthropic", "open https://www.anthropic.com")
		.item("Say hello", "osascript -e 'display notification \"hello from btrc\"'")
		.add(TrayItem("Build (disabled)", "make").disabled())
		.item("Quit", TraySignal.quit());

	tray.show();

	print("btrc tray is live in the menu bar — click an item, or Quit to exit.");
	tray.run();
	tray.close();
	print("tray closed");
	return 0;
}
