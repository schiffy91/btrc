SDL 3.4.10: survive a clipboard requestor that destroys its window first.

SDL answers an X11 SelectionRequest by writing the requestor's property and
sending it SelectionNotify. ICCCM leaves the requestor's lifetime to the
requestor, so the window may already be gone; Xlib's default handler then
exits the process on BadWindow (X_ChangeProperty, opcode 18). This scopes an
error handler to the reply that absorbs only BadWindow errors naming that
requestor from X_ChangeProperty or X_SendEvent, and passes every other error
to the previous handler. Reproduced by
src/tests/native/gui/shell/probes/linux/ClipboardRequestor.c (mode 1).

--- a/src/video/x11/SDL_x11events.c
+++ b/src/video/x11/SDL_x11events.c
@@ -792,6 +792,23 @@
     }
 }
 
+/* A selection requestor may destroy its window before the owner answers
+   (ICCCM 2.2 leaves the requestor's lifetime to the requestor). Only the
+   BadWindow errors that name that requestor, raised by the reply's
+   XChangeProperty or XSendEvent, are absorbed; every other error goes to the
+   handler that was installed before. */
+static Window X11_SelectionRequestor = None;
+static int (*X11_SelectionPreviousErrorHandler)(Display *, XErrorEvent *) = NULL;
+
+static int X11_SelectionRequestorErrorHandler(Display *d, XErrorEvent *e)
+{
+    if (e->error_code == BadWindow && e->resourceid == X11_SelectionRequestor &&
+        (e->request_code == X_ChangeProperty || e->request_code == X_SendEvent)) {
+        return 0;
+    }
+    return X11_SelectionPreviousErrorHandler ? X11_SelectionPreviousErrorHandler(d, e) : 0;
+}
+
 static void X11_HandleClipboardEvent(SDL_VideoDevice *_this, const XEvent *xevent)
 {
     int i;
@@ -841,6 +858,12 @@
            because an SDL window might go away...? but we don't have to do
            this now (or ever, really). */
 
+        /* Deliver errors from earlier requests to the current handler before
+           scoping the requestor's lifetime errors to this reply. */
+        X11_XSync(display, False);
+        X11_SelectionRequestor = req->requestor;
+        X11_SelectionPreviousErrorHandler = X11_XSetErrorHandler(X11_SelectionRequestorErrorHandler);
+
         if (req->target == XA_TARGETS) {
             Atom *supportedFormats;
             supportedFormats = SDL_malloc((clipboard->mime_count + 1) * sizeof(Atom));
@@ -880,6 +903,9 @@
         }
         X11_XSendEvent(display, req->requestor, False, 0, &sevent);
         X11_XSync(display, False);
+        X11_XSetErrorHandler(X11_SelectionPreviousErrorHandler);
+        X11_SelectionPreviousErrorHandler = NULL;
+        X11_SelectionRequestor = None;
     } break;
 
     case SelectionNotify:
