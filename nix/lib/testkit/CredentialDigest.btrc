import Library.Digest.SHA256;
import ./Check.btrc;

class CredentialDigest {
    class string hash(string password, string salt) {
        var digest = SHA256.digest(password + salt);
        Check.that(digest.length == 64, "SHA-256 fixture digest");
        var reversed = "";
        for (int index = digest.length - 2; index >= 0; index -= 2) { reversed = reversed + digest.substring(index, 2); }
        return reversed.toUpper();
    }
}
