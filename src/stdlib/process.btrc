/* btrc standard library — Process execution
 * Cross-platform API shape with UnixShell implemented first.
 *
 * UnixShell intentionally names the POSIX implementation. PowerShell is a
 * placeholder so callers can branch explicitly when Windows support arrives.
 */

import std.bytes;
import std.io;
import std.platform;
import std.strings;
import std.vector;

#include <errno.h>
#include <fcntl.h>
#include <limits.h>
#include <signal.h>
#include <stdint.h>
#include <sys/stat.h>
#include <poll.h>
#include <sys/wait.h>
#include <time.h>
#include <unistd.h>

extern FILE* popen(const char* command, const char* mode);
extern int pclose(FILE* stream);
extern char** environ;
extern int fileno(FILE* stream);

class ProcessStatus {
    public int raw;

    public ProcessStatus(int raw) {
        self.raw = raw;
    }

    public int code() {
        if (self.raw == -1) { return 127; }
        if (WIFEXITED(self.raw)) { return WEXITSTATUS(self.raw); }
        if (WIFSIGNALED(self.raw)) { return 128 + WTERMSIG(self.raw); }
        return self.raw;
    }

    public bool ok() {
        return self.code() == 0;
    }
}

class UnixPipe {
    private FILE* handle;
    public string command;

    public UnixPipe(string command) {
        self.command = command;
        self.handle = popen(command, "r");
    }

    public bool ok() {
        return self.handle != NULL;
    }

    public string readAll() {
        if (!self.ok()) { return ""; }
        Bytes bytes = Bytes();
        char chunk[4096];
        size_t count = fread(chunk, 1, 4096, self.handle);
        while (count > (size_t)0) {
            bytes.appendRaw(chunk, (int)count);
            count = fread(chunk, 1, 4096, self.handle);
        }
        return bytes.toStringLossy();
    }

    public ProcessStatus close() {
        if (!self.ok()) { return ProcessStatus(-1); }
        int raw = pclose(self.handle);
        self.handle = NULL;
        return ProcessStatus(raw);
    }

    public void __del__() {
        if (self.handle != NULL) {
            pclose(self.handle);
            self.handle = NULL;
        }
    }
}

class UnixProcess {
    class ProcessStatus system(string command) {
        return ProcessStatus(system(command));
    }

    class UnixPipe pipe(string command) {
        return UnixPipe(command);
    }
}

class ShellWords {
    class bool isEnvNameStart(char c) {
        if (c >= 'a' && c <= 'z') { return true; }
        if (c >= 'A' && c <= 'Z') { return true; }
        return c == '_';
    }

    class bool isEnvNameChar(char c) {
        return ShellWords.isEnvNameStart(c) || (c >= '0' && c <= '9');
    }

    class bool isEnvName(string name) {
        if (name == null || name.isEmpty()) { return false; }
        if (!ShellWords.isEnvNameStart(name[0])) { return false; }
        for ch in name {
            if (!ShellWords.isEnvNameChar(ch)) { return false; }
        }
        return true;
    }

    class bool isSafeArgChar(char c) {
        if (c >= 'a' && c <= 'z') { return true; }
        if (c >= 'A' && c <= 'Z') { return true; }
        if (c >= '0' && c <= '9') { return true; }
        return c == '_' || c == '-' || c == '.' || c == '/' || c == ':' || c == '=' || c == ',' || c == '+';
    }

    class bool isSafeArg(string raw) {
        int len = raw.len();
        if (len == 0) { return false; }
        for ch in raw {
            if (!ShellWords.isSafeArgChar(ch)) { return false; }
        }
        return true;
    }

    class string quote(string raw) {
        if (ShellWords.isSafeArg(raw)) { return Strings.copy(raw); }
        string escaped = Strings.replace(raw, "'", "'\\''");
        return "'" + escaped + "'";
    }

    class string redact(string text, string sensitive) {
        if (sensitive.isEmpty()) { return text; }
        string result = Strings.copy(text);
        string quoted = ShellWords.quote(sensitive);
        string escaped = Strings.replace(sensitive, "'", "'\\''");
        string quotedTwice = ShellWords.quote(quoted);
        string escapedTwice = Strings.replace(escaped, "'", "'\\''");
        /* Shell quoting can split one secret across adjacent quoted and
         * escaped fragments. Redact those rendered forms before the raw form
         * so diagnostics cannot reconstruct a secret from shell syntax. */
        if (!quotedTwice.equals(quoted)) {
            result = Strings.replace(result, quotedTwice, "***");
        }
        if (!escapedTwice.equals(escaped)) {
            result = Strings.replace(result, escapedTwice, "***");
        }
        if (!quoted.equals(sensitive)) {
            result = Strings.replace(result, quoted, "***");
        }
        if (!escaped.equals(sensitive)) {
            result = Strings.replace(result, escaped, "***");
        }
        return Strings.replace(result, sensitive, "***");
    }

    class string envAssignment(string item) {
        int split = Strings.find(item, "=", 0);
        if (split <= 0) {
            throw f"invalid environment assignment: {item}";
        }
        string name = item.substring(0, split);
        if (!ShellWords.isEnvName(name)) {
            throw f"invalid environment variable name: {name}";
        }
        string value = item.substring(split + 1, item.len() - split - 1);
        return name + "=" + ShellWords.quote(value);
    }
}

class CommandOutput {
    class string collect() { return "collect"; }
    class string stream() { return "stream"; }
    class string combine() { return "combine"; }
    class string suppress() { return "suppress"; }

    class bool valid(string mode) {
        return mode != null
            && (mode.equals(CommandOutput.collect())
            || mode.equals(CommandOutput.stream())
            || mode.equals(CommandOutput.combine())
            || mode.equals(CommandOutput.suppress()));
    }
}

class CommandEnvironment {
    class Vector<string> empty() {
        Vector<string> env = [];
        return env;
    }
}

class ChildDescriptorMapping {
    public int sourceDescriptor;
    public int childDescriptor;

    public ChildDescriptorMapping(int sourceDescriptor, int childDescriptor) {
        self.sourceDescriptor = sourceDescriptor;
        self.childDescriptor = childDescriptor;
    }
}

class ChildDescriptorMappings {
    class Vector<ChildDescriptorMapping> empty() {
        Vector<ChildDescriptorMapping> mappings = [];
        return mappings;
    }
}

class ExecResult {
    public int code;
    public string out;
    public string err;
    public string command;
    public bool timedOut;

    public ExecResult(int code, string out, string err, string command) {
        self.code = code;
        self.out = out;
        self.err = err;
        self.command = command;
        self.timedOut = false;
    }

    public bool ok() {
        return self.code == 0;
    }

    public string stdout() {
        return self.out;
    }

    // Captured stdout with surrounding whitespace removed — the common
    // "run a command and read one value" idiom.
    public string trimmed() {
        return self.out.trim();
    }

    public string stderr() {
        return self.err;
    }

    public bool wasTimedOut() {
        return self.timedOut;
    }
}

/* One captured child stream. The parent only reads after poll(2) marks the
 * descriptor ready, so stdout and stderr can both fill without deadlocking. */
class ChildProcessCapture {
    public int descriptor;
    public int limit;
    public bool open;
    public bool failed;
    public bool exceeded;
    public Bytes buffer;

    public ChildProcessCapture(int descriptor, int limit = 8388608) {
        self.descriptor = descriptor;
        self.limit = limit < 0 ? 0
            : (limit > 2147483646 ? 2147483646 : limit);
        self.open = descriptor >= 0;
        self.failed = false;
        self.exceeded = false;
        self.buffer = Bytes();
    }

    public void readReady() {
        if (!self.open) { return; }
        char buffer[4097];
        ssize_t count = read(self.descriptor, buffer, 4096);
        if (count > (ssize_t)0) {
            int remaining = self.limit - self.buffer.len;
            if (remaining > 0) {
                int retained = (int)count < remaining
                    ? (int)count : remaining;
                self.buffer.appendRaw(buffer, retained);
            }
            if ((int)count > remaining) { self.exceeded = true; }
            return;
        }
        if (count < (ssize_t)0 && errno == EINTR) { return; }
        if (count < (ssize_t)0) { self.failed = true; }
        close(self.descriptor);
        self.descriptor = -1;
        self.open = false;
    }

    public string text() {
        return self.buffer.toStringLossy();
    }

    public void closeCapture() {
        if (self.open) {
            close(self.descriptor);
            self.descriptor = -1;
            self.open = false;
        }
    }
}

class ChildProcessClock {
    class long long millisecondsFrom(uintmax_t seconds, long nanoseconds) {
        if (nanoseconds < 0L || nanoseconds >= 1000000000L) {
            return -1LL;
        }
        if (seconds > (uintmax_t)(LLONG_MAX / 1000LL)) {
            return LLONG_MAX;
        }
        long long milliseconds = (long long)seconds * 1000LL;
        long long fraction = (long long)nanoseconds / 1000000LL;
        return milliseconds > (long long)LLONG_MAX - fraction
            ? LLONG_MAX : milliseconds + fraction;
    }

    class long long milliseconds() {
        struct timespec now;
        now.tv_sec = (time_t)0;
        now.tv_nsec = 0L;
        if (clock_gettime(CLOCK_MONOTONIC, &now) != 0) { return -1LL; }
        if (now.tv_sec < (time_t)0) { return -1LL; }
        return ChildProcessClock.millisecondsFrom(
            (uintmax_t)now.tv_sec, now.tv_nsec);
    }

    class long long deadline(long long now, int timeoutMilliseconds) {
        if (now < 0LL || timeoutMilliseconds < 0) { return -1LL; }
        long long duration = (long long)timeoutMilliseconds;
        return duration > (long long)LLONG_MAX - now
            ? LLONG_MAX : now + duration;
    }
}

/* Build the complete envp in the parent from independent raw copies. No
 * allocator, string helper, or environment mutation runs after fork. */
class ChildProcessEnvironment {
    class char* copyEntry(string value) {
        if (value == null) { return NULL; }
        size_t length = strlen(value);
        if (length == (size_t)(-1)) { return NULL; }
        char* result = (char*)malloc(length + (size_t)1);
        if (result == NULL) { return NULL; }
        memcpy(result, value, length + (size_t)1);
        return result;
    }

    class void freeEntries(char** environment) {
        if (environment == NULL) { return; }
        int index = 0;
        while (environment[index] != NULL) {
            free(environment[index]);
            index++;
        }
        free(environment);
    }

    class bool assignmentHasName(string assignment, string name) {
        int nameLength = Strings.checkedLength(name);
        int assignmentLength = Strings.checkedLength(assignment);
        return assignmentLength > nameLength
            && assignment[nameLength] == '='
            && strncmp(assignment, name, (size_t)nameLength) == 0;
    }

    class bool assignmentsShareName(string left, string right) {
        int split = Strings.find(right, "=", 0);
        if (split <= 0) { return false; }
        string name = right.substring(0, split);
        return ChildProcessEnvironment.assignmentHasName(left, name);
    }

    class bool replaced(string inherited,
                        Vector<string> environment,
                        Vector<string> unsetEnvironment) {
        for item in environment {
            if (ChildProcessEnvironment.assignmentsShareName(
                    inherited, item)) { return true; }
        }
        for name in unsetEnvironment {
            if (ChildProcessEnvironment.assignmentHasName(
                    inherited, name)) { return true; }
        }
        return false;
    }

    class char** build(Vector<string> environment,
                       Vector<string> unsetEnvironment) {
        if (environ == NULL || environment == null
                || unsetEnvironment == null || environment.len < 0
                || unsetEnvironment.len < 0) { return NULL; }
        int inheritedCount = 0;
        while (environ[inheritedCount] != NULL) {
            if (inheritedCount == 2147483646) { return NULL; }
            inheritedCount++;
        }
        if (environment.len > 2147483646 - inheritedCount) {
            return NULL;
        }
        int capacity = inheritedCount + environment.len + 1;
        if ((size_t)capacity > (size_t)(-1) / sizeof(char*)) {
            return NULL;
        }
        char** result = (char**)calloc((size_t)capacity, sizeof(char*));
        if (result == NULL) { return NULL; }
        int count = 0;
        for (int i = 0; i < inheritedCount; i++) {
            char* inherited = environ[i];
            if (!ChildProcessEnvironment.replaced(
                    inherited, environment, unsetEnvironment)) {
                result[count] = ChildProcessEnvironment.copyEntry(inherited);
                if (result[count] == NULL) {
                    ChildProcessEnvironment.freeEntries(result);
                    return NULL;
                }
                count++;
            }
        }
        for item in environment {
            result[count] = ChildProcessEnvironment.copyEntry(item);
            if (result[count] == NULL) {
                ChildProcessEnvironment.freeEntries(result);
                return NULL;
            }
            count++;
        }
        result[count] = NULL;
        return result;
    }
}

/* Materialize argv as an independently owned raw snapshot in the parent. COW
 * already protects inherited managed strings after fork; this explicit
 * ownership instead keeps the post-fork child independent of managed-runtime
 * representation and gives every pre-fork failure one uniform cleanup path. */
class ChildProcessArguments {
    class char** build(string executable, Vector<string> arguments) {
        if (executable == null || arguments == null
                || arguments.len < 0) { return NULL; }
        size_t length = (size_t)arguments.len;
        size_t maximumCount = (size_t)(-1) / sizeof(char*);
        if (maximumCount < (size_t)2
                || length > maximumCount - (size_t)2) { return NULL; }
        char** result = (char**)calloc(
            length + (size_t)2, sizeof(char*));
        if (result == NULL) { return NULL; }
        result[0] = ChildProcessEnvironment.copyEntry(executable);
        if (result[0] == NULL) {
            ChildProcessEnvironment.freeEntries(result);
            return NULL;
        }
        for (int index = 0; index < arguments.len; index++) {
            result[index + 1] = ChildProcessEnvironment.copyEntry(
                arguments.get(index));
            if (result[index + 1] == NULL) {
                ChildProcessEnvironment.freeEntries(result);
                return NULL;
            }
        }
        result[arguments.len + 1] = NULL;
        return result;
    }

    class void freeEntries(char** arguments) {
        ChildProcessEnvironment.freeEntries(arguments);
    }
}

class ChildProcessExecutable {
    class string join(string left, string right) {
        if (left.isEmpty()) { return Strings.copy(right); }
        if (left.endsWith("/")) { return left + right; }
        return left + "/" + right;
    }

    class string currentDirectory() {
        int capacity = 256;
        char* buffer = (char*)malloc((size_t)capacity);
        if (buffer == NULL) { return ""; }
        while ((char*)getcwd(buffer, (size_t)capacity) == NULL) {
            if (errno != ERANGE || capacity > 1073741823) {
                free(buffer);
                return "";
            }
            capacity = capacity * 2;
            char* grown = (char*)realloc(buffer, (size_t)capacity);
            if (grown == NULL) {
                free(buffer);
                return "";
            }
            buffer = grown;
        }
        string result = Strings.copy(buffer);
        free(buffer);
        return result;
    }

    class string workingDirectory(string cwd) {
        if (cwd == null || cwd.isEmpty()) {
            return ChildProcessExecutable.currentDirectory();
        }
        if (cwd[0] == '/') { return Strings.copy(cwd); }
        string current = ChildProcessExecutable.currentDirectory();
        if (current.isEmpty()) { return ""; }
        return ChildProcessExecutable.join(current, cwd);
    }

    class string searchPath(Vector<string> environment,
                            Vector<string> unsetEnvironment) {
        /* Environment.get copies getenv(3)'s borrowed storage before later
         * allocation or environment mutation can invalidate it. */
        string result = Environment.get("PATH", "/usr/bin:/bin");
        if (result.isEmpty()) { result = "/usr/bin:/bin"; }
        for name in unsetEnvironment {
            if (name.equals("PATH")) { result = "/usr/bin:/bin"; }
        }
        for item in environment {
            if (ChildProcessEnvironment.assignmentHasName(item, "PATH")) {
                int split = Strings.find(item, "=", 0);
                result = item.substring(split + 1, item.len() - split - 1);
            }
        }
        return result;
    }

    class string resolve(string executable, string cwd,
                         Vector<string> environment,
                         Vector<string> unsetEnvironment) {
        string working = ChildProcessExecutable.workingDirectory(cwd);
        if (working.isEmpty()) { return ""; }
        if (executable.contains("/")) {
            return executable[0] == '/'
                ? Strings.copy(executable)
                : ChildProcessExecutable.join(working, executable);
        }
        Vector<string> directories = Strings.split(
            ChildProcessExecutable.searchPath(environment, unsetEnvironment),
            ":");
        for directory in directories {
            string base = directory.isEmpty() ? working : directory;
            if (base[0] != '/') {
                base = ChildProcessExecutable.join(working, base);
            }
            string candidate = ChildProcessExecutable.join(base, executable);
            if (access(candidate, X_OK) == 0) { return candidate; }
        }
        return "";
    }
}

/* Direct child execution for structured automation. Unlike UnixShell, this
 * API never parses or renders shell syntax: executable and arguments reach
 * execve(2) as distinct argv entries. Environment changes inherit the parent
 * environment, then apply NAME=value overrides and explicit unsets. A zero
 * timeout is unbounded; expiry returns code 124 with wasTimedOut() true.
 * executableDescriptor borrows a readable regular executable; when supplied,
 * executable is only argv[0] and the diagnostic label, never an execution path.
 * Explicit descriptor mappings and descriptor-backed cwd are native-Linux
 * capabilities and fail closed everywhere else without a pathname fallback. */
class ChildProcess {
    class int descriptorCloseBound() {
        return __btrc_descriptor_close_bound();
    }

    /* Called only after fork. The runtime helper uses close_range(2) or a BSD
     * closefrom(3) where available and a precomputed hard-bound loop
     * everywhere else. */
    class int closeDescriptorsForExec(int bound) {
        return __btrc_close_descriptors_from(bound);
    }

    class bool inheritsOnExec(int descriptor) {
        int flags = fcntl(descriptor, F_GETFD, 0);
        return flags >= 0 && (flags & FD_CLOEXEC) == 0;
    }

    class void validateArguments(Vector<string> arguments) {
        for argument in arguments {
            if (argument == null) {
                throw "child arguments cannot contain null";
            }
        }
    }

    /* Keep every descriptor used as a dup2(2) source outside 0/1/2. Apart
     * from making identity mappings harmless, this prevents one remap from
     * overwriting a descriptor that a later remap still needs. */
    class int moveOutsideStandardStreams(int* descriptor) {
        return __btrc_move_descriptor_outside_stdio(descriptor);
    }

    /* A descriptor owned by a FILE remains attached to that FILE, so retain
     * the original for fclose(3) and give the child a distinct safe source. */
    class int childSourceOutsideStandardStreams(int descriptor) {
        if (descriptor < 0 || descriptor > STDERR_FILENO) {
            return descriptor;
        }
        return fcntl(descriptor, F_DUPFD_CLOEXEC, 3);
    }

    class void closeLeasedDescriptors(int* descriptors, int count) {
        if (descriptors == NULL) { return; }
        for (int index = 0; index < count; index++) {
            if (descriptors[index] >= 0) { close(descriptors[index]); }
        }
    }

    class void validateEnvironment(Vector<string> environment,
                                   Vector<string> unsetEnvironment) {
        if (environment == null || unsetEnvironment == null) {
            throw "child environment vectors cannot be null";
        }
        for item in environment {
            if (item == null) {
                throw "child environment overrides cannot contain null";
            }
            int split = Strings.find(item, "=", 0);
            if (split <= 0) {
                throw f"invalid environment assignment: {item}";
            }
            string name = item.substring(0, split);
            if (!ShellWords.isEnvName(name)) {
                throw f"invalid environment variable name: {name}";
            }
        }
        for item in environment {
            for name in unsetEnvironment {
                if (ChildProcessEnvironment.assignmentHasName(item, name)) {
                    throw "child environment variable cannot be both set and unset";
                }
            }
        }
        for (int left = 0; left < environment.len; left++) {
            for (int right = left + 1; right < environment.len; right++) {
                if (ChildProcessEnvironment.assignmentsShareName(
                        environment.get(left), environment.get(right))) {
                    throw "duplicate child environment override";
                }
            }
        }
        for name in unsetEnvironment {
            if (name == null) {
                throw "child environment unsets cannot contain null";
            }
            if (!ShellWords.isEnvName(name)) {
                throw f"invalid environment variable name: {name}";
            }
        }
    }

    class void closePipe(int* descriptors) {
        if (descriptors[0] >= 0) { close(descriptors[0]); }
        if (descriptors[1] >= 0) { close(descriptors[1]); }
        descriptors[0] = -1;
        descriptors[1] = -1;
    }

    class int openPipe(int* descriptors) {
        descriptors[0] = -1;
        descriptors[1] = -1;
        if (pipe(descriptors) != 0) { return -1; }
        int readDescriptor = descriptors[0];
        int readMoved = ChildProcess.moveOutsideStandardStreams(
            &readDescriptor);
        descriptors[0] = readDescriptor;
        if (readMoved != 0) {
            ChildProcess.closePipe(descriptors);
            return -1;
        }
        int writeDescriptor = descriptors[1];
        int writeMoved = ChildProcess.moveOutsideStandardStreams(
            &writeDescriptor);
        descriptors[1] = writeDescriptor;
        if (writeMoved != 0) {
            ChildProcess.closePipe(descriptors);
            return -1;
        }
        int readFlags = fcntl(descriptors[0], F_GETFD);
        int writeFlags = fcntl(descriptors[1], F_GETFD);
        if (readFlags < 0 || writeFlags < 0
                || fcntl(descriptors[0], F_SETFD,
                    readFlags | FD_CLOEXEC) != 0
                || fcntl(descriptors[1], F_SETFD,
                    writeFlags | FD_CLOEXEC) != 0) {
            ChildProcess.closePipe(descriptors);
            return -1;
        }
        return 0;
    }

    class ExecResult failure(string command, string message) {
        return ExecResult(
            127,
            Strings.copy(""),
            Strings.copy(message),
            Strings.copy(command));
    }

    class string render(string executable, Vector<string> arguments) {
        Vector<string> parts = [ShellWords.quote(executable)];
        for argument in arguments {
            parts.push(ShellWords.quote(argument));
        }
        return parts.join(" ");
    }

    class ExecResult run(string executable,
                         Vector<string> arguments,
                         string cwd = "",
                         Vector<string> environment = CommandEnvironment.empty(),
                         Vector<string> unsetEnvironment = CommandEnvironment.empty(),
                         int timeoutMilliseconds = 0,
                         int maxStdoutBytes = 8388608,
                         int maxStderrBytes = 8388608,
                         string stdinData = "",
                         string stdout = CommandOutput.collect(),
                         string stderr = CommandOutput.collect(),
                         int executableDescriptor = -1,
                         Vector<ChildDescriptorMapping> descriptorMappings = ChildDescriptorMappings.empty(),
                         int workingDirectoryDescriptor = -1) {
        if (executable == null || executable.isEmpty()) {
            return ChildProcess.failure(executable, "executable cannot be empty");
        }
        if (executableDescriptor < -1) {
            return ChildProcess.failure(executable,
                "executable descriptor cannot be negative");
        }
        if (workingDirectoryDescriptor < -1) {
            return ChildProcess.failure(executable,
                "working directory descriptor cannot be negative");
        }
        if (arguments == null) {
            return ChildProcess.failure(executable, "arguments cannot be null");
        }
        ChildProcess.validateArguments(arguments);
        if (descriptorMappings == null) {
            return ChildProcess.failure(executable,
                "child descriptor mappings cannot be null");
        }
        bool hasCwd = cwd != null && !cwd.isEmpty();
        if (hasCwd && workingDirectoryDescriptor >= 0) {
            return ChildProcess.failure(executable,
                "working directory path and descriptor cannot both be set");
        }
        if (timeoutMilliseconds < 0) {
            throw "timeoutMilliseconds cannot be negative";
        }
        if (maxStdoutBytes < 0 || maxStderrBytes < 0
                || maxStdoutBytes > 2147483646
                || maxStderrBytes > 2147483646) {
            throw "child capture limits are outside the supported range";
        }
        if (stdout == null || stderr == null
                || !CommandOutput.valid(stdout)
                || !CommandOutput.valid(stderr)
                || stdout.equals(CommandOutput.combine())
                || (stderr.equals(CommandOutput.combine())
                    && !stdout.equals(CommandOutput.collect()))) {
            throw "invalid child output mode combination";
        }
        ChildProcess.validateEnvironment(environment, unsetEnvironment);

        string command = ChildProcess.render(executable, arguments);
        int descriptorBound = -1;
        int maximumChildDescriptor = 2;
        bool usesExplicitDescriptorSetup = workingDirectoryDescriptor >= 0
            || descriptorMappings.len > 0;
        bool usesProcessDescriptors = executableDescriptor >= 0
            || usesExplicitDescriptorSetup;
        if (usesExplicitDescriptorSetup) {
            if (__btrc_process_descriptors_supported() == 0) {
                return ChildProcess.failure(command,
                    "process descriptor capabilities require native Linux\n");
            }
            descriptorBound = ChildProcess.descriptorCloseBound();
            if (descriptorBound < 4
                    || descriptorMappings.len > descriptorBound - 3) {
                return ChildProcess.failure(command,
                    "unsupported process descriptor limit\n");
            }
            unsigned char* sourceDescriptors = (unsigned char*)calloc(
                (size_t)descriptorBound, sizeof(unsigned char));
            unsigned char* childDescriptors = (unsigned char*)calloc(
                (size_t)descriptorBound, sizeof(unsigned char));
