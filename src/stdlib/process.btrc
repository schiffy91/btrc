}

class Command {
    public string command;
    public Vector<string> arguments;

    public Command(string command) {
        self.command = command;
        self.arguments = [];
    }

    public Command arg(string value) {
        self.arguments.push(value);
        return self;
    }

    public Command args(Vector<string> values) {
        for value in values {
            self.arguments.push(value);
        }
        return self;
    }

    public Command flag(string name, string value) {
        self.arguments.push(name);
        self.arguments.push(value);
        return self;
    }

    public string renderEnv(string item) {
        return ShellWords.envAssignment(item);
    }

    public string render() {
        Vector<string> parts = [];
        parts.push(self.command);
        for item in self.arguments {
            parts.push(ShellWords.quote(item));
        }
        return parts.join(" ");
    }

    public string toString() {
        return self.render();
    }

}

class UnixShell {
    public bool logCommands;
    public string chrootPath;

    public UnixShell() {
        self.logCommands = false;
        self.chrootPath = "";
    }

    class string quote(string raw) {
        return ShellWords.quote(raw);
    }

    class string redactText(string text, string sensitive) {
        return ShellWords.redact(text, sensitive);
    }

    class int statusCode(int rawStatus) {
        ProcessStatus status = ProcessStatus(rawStatus);
        int code = status.code();
        return code;
    }

    class void logError(string message) {
        fprintf(stderr, "%s\n", __btrc_string_or_empty(message));
    }

    public void chroot(string path) {
        self.chrootPath = path;
    }

    public void clearChroot() {
        self.chrootPath = "";
    }

    public string renderEnv(Vector<string> env) {
        Vector<string> parts = [];
        for item in env {
            parts.push(ShellWords.envAssignment(item));
        }
        return parts.join(" ");
    }

    public string withContext(string command, string cwd, Vector<string> env, bool sudo, string chroot) {
        string rendered = command;
        string envPrefix = self.renderEnv(env);
        if (!envPrefix.isEmpty()) {
            rendered = f"{envPrefix} {rendered}";
        }
        if (sudo) {
            rendered = f"sudo {rendered}";
        }
        if (!cwd.isEmpty()) {
            rendered = f"cd {ShellWords.quote(cwd)} && {rendered}";
        }
        string root = chroot.isEmpty() ? self.chrootPath : chroot;
        if (!root.isEmpty()) {
            rendered = f"nixos-enter --root {ShellWords.quote(root)} --command {ShellWords.quote(rendered)}";
        }
        return rendered;
    }

    public ExecResult run(string command,
                          string stdout = CommandOutput.collect(),
                          string stderr = CommandOutput.combine(),
                          bool logCommand = false,
                          bool logFailure = true,
                          bool throwOnFailure = false,
                          string redactSubstring = "",
                          string stdin = "",
                          string cwd = "",
                          Vector<string> env = CommandEnvironment.empty(),
                          bool sudo = false,
                          string chroot = "",
                          int timeoutMilliseconds = 0,
                          int maxStdoutBytes = 8388608,
                          int maxStderrBytes = 8388608) {
        if (!CommandOutput.valid(stdout)) { throw f"invalid stdout mode: {stdout}"; }
        if (!CommandOutput.valid(stderr)) { throw f"invalid stderr mode: {stderr}"; }
        if (stdout.equals(CommandOutput.combine())) { throw "stdout cannot use CommandOutput.combine"; }
        if (stderr.equals(CommandOutput.combine()) && !stdout.equals(CommandOutput.collect())) {
            throw "stderr can only combine with collected stdout";
        }

        var rendered = self.withContext(command, cwd, env, sudo, chroot);
        if (self.logCommands || logCommand) {
            var visible = UnixShell.redactText(rendered, redactSubstring);
            UnixShell.logError(f"LOG: {visible}");
        }

        var child = ChildProcess.run(
            "/bin/sh", ["-c", rendered],
            timeoutMilliseconds=timeoutMilliseconds,
            maxStdoutBytes=maxStdoutBytes,
            maxStderrBytes=maxStderrBytes,
            stdinData=stdin,
            stdout=stdout,
            stderr=stderr);
        var code = child.code;

        if ((logFailure || throwOnFailure) && code != 0) {
            UnixShell.logError(f"Command failed ({code}): {UnixShell.redactText(rendered, redactSubstring)}");
        }
        if (throwOnFailure && code != 0) {
            throw f"Command failed ({code}): {UnixShell.redactText(rendered, redactSubstring)}";
        }
        ExecResult result = ExecResult(code, child.out, child.err, rendered);
        result.timedOut = child.timedOut;
        return result;
    }

}

class PowerShell {
    public PowerShell() {
    }

    public ExecResult run(string command,
                          string stdout = CommandOutput.collect(),
                          string stderr = CommandOutput.combine(),
                          bool logCommand = false,
                          bool logFailure = true,
                          bool throwOnFailure = false,
                          string redactSubstring = "",
                          string stdin = "",
                          string cwd = "",
                          Vector<string> env = CommandEnvironment.empty(),
                          bool sudo = false,
                          string chroot = "",
                          int timeoutMilliseconds = 0,
                          int maxStdoutBytes = 8388608,
                          int maxStderrBytes = 8388608) {
        return ExecResult(127, "", "PowerShell support is not implemented", command);
    }
}
