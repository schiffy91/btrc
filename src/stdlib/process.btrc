/* btrc standard library — Process execution
 * Cross-platform API shape with UnixShell implemented first.
 *
 * UnixShell intentionally names the POSIX implementation. PowerShell is a
 * placeholder so callers can branch explicitly when Windows support arrives.
 */

import std.bytes;
import std.io;
import std.platform;
import std.strings;
import std.vector;

#include <errno.h>
#include <signal.h>
#include <sys/stat.h>
#include <poll.h>
#include <sys/wait.h>
#include <time.h>
#include <unistd.h>

extern FILE* popen(const char* command, const char* mode);
extern int pclose(FILE* stream);
extern int mkstemp(char* templatePath);

class ProcessStatus {
    public int raw;

    public ProcessStatus(int raw) {
        self.raw = raw;
    }

    public int code() {
        if (self.raw == -1) { return 127; }
        if (WIFEXITED(self.raw)) { return WEXITSTATUS(self.raw); }
        if (WIFSIGNALED(self.raw)) { return 128 + WTERMSIG(self.raw); }
        return self.raw;
    }

    public bool ok() {
        return self.code() == 0;
    }
}

class UnixPipe {
    private FILE* handle;
    public string command;

    public UnixPipe(string command) {
        self.command = command;
        self.handle = popen(command, "r");
    }

    public bool ok() {
        return self.handle != NULL;
    }

    public string readAll() {
        if (!self.ok()) { return ""; }
        Bytes bytes = Bytes();
        char chunk[4096];
        size_t count = fread(chunk, 1, 4096, self.handle);
        while (count > (size_t)0) {
            bytes.appendRaw(chunk, (int)count);
            count = fread(chunk, 1, 4096, self.handle);
        }
        return bytes.toStringLossy();
    }

    public ProcessStatus close() {
        if (!self.ok()) { return ProcessStatus(-1); }
        int raw = pclose(self.handle);
        self.handle = NULL;
        return ProcessStatus(raw);
    }

    public void __del__() {
        if (self.handle != NULL) {
            pclose(self.handle);
            self.handle = NULL;
        }
    }
}

class UnixProcess {
    class ProcessStatus system(string command) {
        return ProcessStatus(system(command));
    }

    class UnixPipe pipe(string command) {
        return UnixPipe(command);
    }
}

class ShellWords {
    class bool isEnvNameStart(char c) {
        if (c >= 'a' && c <= 'z') { return true; }
        if (c >= 'A' && c <= 'Z') { return true; }
        return c == '_';
    }

    class bool isEnvNameChar(char c) {
        return ShellWords.isEnvNameStart(c) || (c >= '0' && c <= '9');
    }

    class bool isEnvName(string name) {
        if (name.isEmpty()) { return false; }
        if (!ShellWords.isEnvNameStart(name[0])) { return false; }
        for ch in name {
            if (!ShellWords.isEnvNameChar(ch)) { return false; }
        }
        return true;
    }

    class bool isSafeArgChar(char c) {
        if (c >= 'a' && c <= 'z') { return true; }
        if (c >= 'A' && c <= 'Z') { return true; }
        if (c >= '0' && c <= '9') { return true; }
        return c == '_' || c == '-' || c == '.' || c == '/' || c == ':' || c == '=' || c == ',' || c == '+';
    }

    class bool isSafeArg(string raw) {
        int len = raw.len();
        if (len == 0) { return false; }
        for ch in raw {
            if (!ShellWords.isSafeArgChar(ch)) { return false; }
        }
        return true;
    }

    class string quote(string raw) {
        if (ShellWords.isSafeArg(raw)) { return Strings.copy(raw); }
        string escaped = Strings.replace(raw, "'", "'\\''");
        return "'" + escaped + "'";
    }

    class string redact(string text, string sensitive) {
        if (sensitive.isEmpty()) { return text; }
        return Strings.replace(text, sensitive, "***");
    }

    class string envAssignment(string item) {
        int split = Strings.find(item, "=", 0);
        if (split <= 0) {
            throw f"invalid environment assignment: {item}";
        }
        string name = item.substring(0, split);
        if (!ShellWords.isEnvName(name)) {
            throw f"invalid environment variable name: {name}";
        }
        string value = item.substring(split + 1, item.len() - split - 1);
        return name + "=" + ShellWords.quote(value);
    }
}

class CommandOutput {
    class string collect() { return "collect"; }
    class string stream() { return "stream"; }
    class string combine() { return "combine"; }
    class string suppress() { return "suppress"; }

    class bool valid(string mode) {
        return mode.equals(CommandOutput.collect())
            || mode.equals(CommandOutput.stream())
            || mode.equals(CommandOutput.combine())
            || mode.equals(CommandOutput.suppress());
    }
}

class CommandEnvironment {
    class Vector<string> empty() {
        Vector<string> env = [];
        return env;
    }
}

class ExecResult {
    public int code;
    public string out;
    public string err;
    public string command;
    public bool timedOut;

    public ExecResult(int code, string out, string err, string command) {
        self.code = code;
        self.out = out;
        self.err = err;
        self.command = command;
        self.timedOut = false;
    }

    public bool ok() {
        return self.code == 0;
    }

    public string stdout() {
        return self.out;
    }

    // Captured stdout with surrounding whitespace removed — the common
    // "run a command and read one value" idiom.
    public string trimmed() {
        return self.out.trim();
    }

    public string stderr() {
        return self.err;
    }

    public bool wasTimedOut() {
        return self.timedOut;
    }
}

/* One captured child stream. The parent only reads after poll(2) marks the
 * descriptor ready, so stdout and stderr can both fill without deadlocking. */
class ChildProcessCapture {
    public int descriptor;
    public bool open;
    public bool failed;
    public Bytes buffer;

    public ChildProcessCapture(int descriptor) {
        self.descriptor = descriptor;
        self.open = descriptor >= 0;
        self.failed = false;
        self.buffer = Bytes();
    }

    public void readReady() {
        if (!self.open) { return; }
        char buffer[4097];
        ssize_t count = read(self.descriptor, buffer, 4096);
        if (count > (ssize_t)0) {
            self.buffer.appendRaw(buffer, (int)count);
            return;
        }
        if (count < (ssize_t)0 && errno == EINTR) { return; }
        if (count < (ssize_t)0) { self.failed = true; }
        close(self.descriptor);
        self.descriptor = -1;
        self.open = false;
    }

    public string text() {
        return self.buffer.toStringLossy();
    }

    public void closeCapture() {
        if (self.open) {
            close(self.descriptor);
            self.descriptor = -1;
            self.open = false;
        }
    }
}

class ChildProcessClock {
    class long long milliseconds() {
        struct timespec now;
        clock_gettime(CLOCK_MONOTONIC, &now);
        return (long long)now.tv_sec * 1000LL
            + (long long)now.tv_nsec / 1000000LL;
    }
}

/* Direct child execution for structured automation. Unlike UnixShell, this
 * API never parses or renders shell syntax: executable and arguments reach
 * execvp(3) as distinct argv entries. Environment changes inherit the parent
 * environment, then apply NAME=value overrides and explicit unsets. A zero
 * timeout is unbounded; expiry returns code 124 with wasTimedOut() true. */
class ChildProcess {
    class void validateEnvironment(Vector<string> environment,
                                   Vector<string> unsetEnvironment) {
        for item in environment {
            int split = Strings.find(item, "=", 0);
            if (split <= 0) {
                throw f"invalid environment assignment: {item}";
            }
            string name = item.substring(0, split);
            if (!ShellWords.isEnvName(name)) {
                throw f"invalid environment variable name: {name}";
            }
        }
        for name in unsetEnvironment {
            if (!ShellWords.isEnvName(name)) {
                throw f"invalid environment variable name: {name}";
            }
        }
    }

    class void closePipe(int* descriptors) {
        close(descriptors[0]);
        close(descriptors[1]);
    }

    class ExecResult failure(string command, string message) {
        return ExecResult(127, "", message, command);
    }

    class string render(string executable, Vector<string> arguments) {
        Vector<string> parts = [ShellWords.quote(executable)];
        for argument in arguments {
            parts.push(ShellWords.quote(argument));
        }
        return parts.join(" ");
    }

    class ExecResult run(string executable,
                         Vector<string> arguments,
                         string cwd = "",
                         Vector<string> environment = CommandEnvironment.empty(),
                         Vector<string> unsetEnvironment = CommandEnvironment.empty(),
                         int timeoutMilliseconds = 0) {
        if (executable.isEmpty()) {
            return ChildProcess.failure(executable, "executable cannot be empty");
        }
        if (timeoutMilliseconds < 0) {
            throw "timeoutMilliseconds cannot be negative";
        }
        ChildProcess.validateEnvironment(environment, unsetEnvironment);

        string command = ChildProcess.render(executable, arguments);
        if (arguments.len > 2147483645) {
            return ChildProcess.failure(command, "too many child arguments");
        }
        char** execArguments = (char**)calloc(arguments.len + 2, sizeof(char*));
        if (execArguments == NULL) {
            return ChildProcess.failure(command, "failed to allocate child arguments");
        }
        execArguments[0] = executable;
        for (int i = 0; i < arguments.len; i++) {
            execArguments[i + 1] = arguments.get(i);
        }
        execArguments[arguments.len + 1] = NULL;

        int stdoutPipe[2];
        int stderrPipe[2];
        if (pipe(stdoutPipe) != 0) {
            free(execArguments);
            return ChildProcess.failure(command, "failed to create stdout pipe");
        }
        if (pipe(stderrPipe) != 0) {
            ChildProcess.closePipe(stdoutPipe);
            free(execArguments);
            return ChildProcess.failure(command, "failed to create stderr pipe");
        }

        pid_t child = fork();
        if (child < (pid_t)0) {
            ChildProcess.closePipe(stdoutPipe);
            ChildProcess.closePipe(stderrPipe);
            free(execArguments);
            return ChildProcess.failure(command, "failed to fork child process");
        }

        if (child == (pid_t)0) {
            setpgid(0, 0);
            close(stdoutPipe[0]);
            close(stderrPipe[0]);
            if (dup2(stdoutPipe[1], STDOUT_FILENO) < 0
                    || dup2(stderrPipe[1], STDERR_FILENO) < 0) {
                _exit(126);
            }
            close(stdoutPipe[1]);
            close(stderrPipe[1]);

            if (!cwd.isEmpty() && chdir(cwd) != 0) {
                fprintf(stderr, "failed to enter working directory: %s\n", cwd);
                _exit(126);
            }
            for name in unsetEnvironment {
                if (unsetenv(name) != 0) {
                    fprintf(stderr, "failed to unset environment variable: %s\n", name);
                    _exit(126);
                }
            }
            for item in environment {
                int split = Strings.find(item, "=", 0);
                string name = item.substring(0, split);
                string value = item.substring(split + 1, item.len() - split - 1);
                if (setenv(name, value, 1) != 0) {
                    fprintf(stderr, "failed to set environment variable: %s\n", name);
                    _exit(126);
                }
            }
            execvp(executable, execArguments);
            fprintf(stderr, "failed to execute: %s\n", executable);
            _exit(127);
        }

        close(stdoutPipe[1]);
        close(stderrPipe[1]);
        free(execArguments);
        // Calling from both sides closes the race between fork and exec.
        setpgid(child, child);

        ChildProcessCapture output = ChildProcessCapture(stdoutPipe[0]);
        ChildProcessCapture error = ChildProcessCapture(stderrPipe[0]);
        bool exited = false;
        bool timedOut = false;
        bool captureFailed = false;
        int rawStatus = 0;
        long long deadline = timeoutMilliseconds == 0
            ? 0LL
            : ChildProcessClock.milliseconds()
                + (long long)timeoutMilliseconds;

        while (!exited || output.open || error.open) {
            if (!exited) {
                pid_t waited = waitpid(child, &rawStatus, WNOHANG);
                if (waited == child) {
                    exited = true;
                } else if (waited < (pid_t)0 && errno != EINTR) {
                    exited = true;
                    rawStatus = -1;
                }
            }

            if (!timedOut && deadline > 0LL
                    && ChildProcessClock.milliseconds() >= deadline) {
                timedOut = true;
                // The child is its own process-group leader, so descendants
                // holding capture pipes are terminated as part of the timeout.
                if (kill(-child, SIGKILL) != 0) {
                    kill(child, SIGKILL);
                }
            }

            struct pollfd streams[2];
            streams[0].fd = output.open ? output.descriptor : -1;
            streams[0].events = POLLIN;
            streams[0].revents = 0;
            streams[1].fd = error.open ? error.descriptor : -1;
            streams[1].events = POLLIN;
            streams[1].revents = 0;
            int ready = poll(streams, 2, 10);
            if (ready > 0) {
                if (output.open && streams[0].revents != 0) {
                    output.readReady();
                }
                if (error.open && streams[1].revents != 0) {
                    error.readReady();
                }
            } else if (ready < 0 && errno != EINTR) {
                captureFailed = true;
                output.closeCapture();
                error.closeCapture();
                if (!exited) {
                    if (kill(-child, SIGKILL) != 0) {
                        kill(child, SIGKILL);
                    }
                }
            }
        }

        captureFailed = captureFailed || output.failed || error.failed;

        int code = captureFailed
            ? 127
            : (timedOut ? 124 : ProcessStatus(rawStatus).code());
        string errorText = error.text();
        if (captureFailed) {
            errorText = errorText + "failed to poll child output\n";
        }
        ExecResult result = ExecResult(
            code, output.text(), errorText, command);
        result.timedOut = timedOut;
        return result;
    }
}

class Command {
    public string command;
    public Vector<string> arguments;

    public Command(string command) {
        self.command = command;
        self.arguments = [];
    }

    public Command arg(string value) {
        self.arguments.push(value);
        return self;
    }

    public Command args(Vector<string> values) {
        for value in values {
            self.arguments.push(value);
        }
        return self;
    }

    public Command flag(string name, string value) {
        self.arguments.push(name);
        self.arguments.push(value);
        return self;
    }

    public string renderEnv(string item) {
        return ShellWords.envAssignment(item);
    }

    public string render() {
        Vector<string> parts = [];
        parts.push(self.command);
        for item in self.arguments {
            parts.push(ShellWords.quote(item));
        }
        return parts.join(" ");
    }

    public string toString() {
        return self.render();
    }

}

class UnixShell {
    public bool logCommands;
    public string chrootPath;
    public int tempId;

    public UnixShell() {
        self.logCommands = false;
        self.chrootPath = "";
        self.tempId = 0;
    }

    class string quote(string raw) {
        return ShellWords.quote(raw);
    }

    class string redactText(string text, string sensitive) {
        return ShellWords.redact(text, sensitive);
    }

    class int statusCode(int rawStatus) {
        ProcessStatus status = ProcessStatus(rawStatus);
        int code = status.code();
        return code;
    }

    class void logError(string message) {
        fprintf(stderr, "%s\n", message);
    }

    public void chroot(string path) {
        self.chrootPath = path;
    }

    public void clearChroot() {
        self.chrootPath = "";
    }

    public string tempPath(string name) {
        self.tempId++;
        var base = Environment.get("TMPDIR", "/tmp");
        var separator = base.endsWith("/") ? "" : "/";
        var templatePath = f"{base}{separator}btrc-process-{Platform.pid()}-{self.tempId}.{name}.XXXXXX";
        string raw = Strings.copy(templatePath);
        int fd = mkstemp(raw);
        if (fd < 0) { return ""; }
        close(fd);
        return Strings.copy(raw);
    }

    public string renderEnv(Vector<string> env) {
        Vector<string> parts = [];
        for item in env {
            parts.push(ShellWords.envAssignment(item));
        }
        return parts.join(" ");
    }

    public string withContext(string command, string cwd, Vector<string> env, bool sudo, string chroot) {
        string rendered = command;
        string envPrefix = self.renderEnv(env);
        if (!envPrefix.isEmpty()) {
            rendered = f"{envPrefix} {rendered}";
        }
        if (sudo) {
            rendered = f"sudo {rendered}";
        }
        if (!cwd.isEmpty()) {
            rendered = f"cd {ShellWords.quote(cwd)} && {rendered}";
        }
        string root = chroot.isEmpty() ? self.chrootPath : chroot;
        if (!root.isEmpty()) {
            rendered = f"nixos-enter --root {ShellWords.quote(root)} --command {ShellWords.quote(rendered)}";
        }
        return rendered;
    }

    public string withRedirections(string rendered, string stdout, string stderr, string outFile, string errFile, string stdinFile) {
        // Group first so user-supplied redirections keep their own ordering.
        string command = f"( {rendered} )";
        if (!stdinFile.isEmpty()) {
            command = f"{command} < {ShellWords.quote(stdinFile)}";
        }
        if (stdout.equals(CommandOutput.collect())) {
            command = f"{command} > {ShellWords.quote(outFile)}";
        } else if (stdout.equals(CommandOutput.suppress())) {
            command = f"{command} > /dev/null";
        }
        if (stderr.equals(CommandOutput.combine())) {
            command = f"{command} 2>&1";
        } else if (stderr.equals(CommandOutput.collect())) {
            command = f"{command} 2> {ShellWords.quote(errFile)}";
        } else if (stderr.equals(CommandOutput.suppress())) {
            command = f"{command} 2>/dev/null";
        }
        return command;
    }

    public ExecResult run(string command,
                          string stdout = CommandOutput.collect(),
                          string stderr = CommandOutput.combine(),
                          bool logCommand = false,
                          bool logFailure = true,
                          bool throwOnFailure = false,
                          string redactSubstring = "",
                          string stdin = "",
                          string cwd = "",
                          Vector<string> env = CommandEnvironment.empty(),
                          bool sudo = false,
                          string chroot = "") {
        if (!CommandOutput.valid(stdout)) { throw f"invalid stdout mode: {stdout}"; }
        if (!CommandOutput.valid(stderr)) { throw f"invalid stderr mode: {stderr}"; }
        if (stdout.equals(CommandOutput.combine())) { throw "stdout cannot use CommandOutput.combine"; }
        if (stderr.equals(CommandOutput.combine()) && !stdout.equals(CommandOutput.collect())) {
            throw "stderr can only combine with collected stdout";
        }

        var rendered = self.withContext(command, cwd, env, sudo, chroot);
        var outFile = self.tempPath("stdout");
        if (outFile.isEmpty()) {
            throw "failed to create temporary process files";
        }
        var errFile = self.tempPath("stderr");
        if (errFile.isEmpty()) {
            unlink(outFile);
            throw "failed to create temporary process files";
        }
        var stdinFile = "";
        if (!stdin.isEmpty()) {
            stdinFile = self.tempPath("stdin");
            if (stdinFile.isEmpty()) {
                unlink(outFile);
                unlink(errFile);
                throw "failed to create temporary stdin file";
            }
            if (!Path.writeAll(stdinFile, stdin) || chmod(stdinFile, 384) != 0) {
                unlink(outFile);
                unlink(errFile);
                unlink(stdinFile);
                throw "failed to prepare temporary stdin file";
            }
        }
        var executed = self.withRedirections(rendered, stdout, stderr, outFile, errFile, stdinFile);

        if (self.logCommands || logCommand) {
            var visible = UnixShell.redactText(executed, redactSubstring);
            UnixShell.logError(f"LOG: {visible}");
        }

        var status = UnixProcess.system(executed);
        var code = status.code();
        var output = stdout.equals(CommandOutput.collect()) ? Path.readAll(outFile) : "";
        var error = stderr.equals(CommandOutput.collect()) ? Path.readAll(errFile) : "";
        unlink(outFile);
        unlink(errFile);
        if (!stdinFile.isEmpty()) {
            unlink(stdinFile);
        }

        if ((logFailure || throwOnFailure) && code != 0) {
            UnixShell.logError(f"Command failed ({code}): {UnixShell.redactText(rendered, redactSubstring)}");
        }
        if (throwOnFailure && code != 0) {
            throw f"Command failed ({code}): {UnixShell.redactText(rendered, redactSubstring)}";
        }
        return ExecResult(code, output, error, rendered);
    }

}

class PowerShell {
    public PowerShell() {
    }

    public ExecResult run(string command,
                          string stdout = CommandOutput.collect(),
                          string stderr = CommandOutput.combine(),
                          bool logCommand = false,
                          bool logFailure = true,
                          bool throwOnFailure = false,
                          string redactSubstring = "",
                          string stdin = "",
                          string cwd = "",
                          Vector<string> env = CommandEnvironment.empty(),
                          bool sudo = false,
                          string chroot = "") {
        return ExecResult(127, "", "PowerShell support is not implemented", command);
    }
}
