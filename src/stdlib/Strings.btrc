/* btrc standard library — Strings
 * String utilities that the built-in string methods do not provide.
 *
 * Built-in string methods (prefer these): .len(), .equals(), .contains(),
 * .startsWith(), .endsWith(), .indexOf(), .lastIndexOf(), .find(), .count(),
 * .charAt(), .substring(), .trim(), .lstrip(), .rstrip(), .toUpper(),
 * .toLower(), .capitalize(), .title(), .swapCase(), .replace(), .repeat(),
 * .reverse(), .padLeft(), .padRight(), .center(), .zfill(), .removePrefix(),
 * .removeSuffix(), .isEmpty(), .isBlank(), .isDigit(), .isAlpha(), .isAlnum(),
 * .isUpper(), .isLower(), .split(), .toInt(), .toFloat(), .toDouble(),
 * .toLong(), .toBool().
 *
 * Owned here: split over Vector<string>, compare/lessThan, rfind, the
 * saturating toInt, fromInt/fromFloat, the char classifiers, copy,
 * checkedLength, StringBuilder, and UTF8, the one owner of UTF-8 scalar
 * decoding, validation, boundaries and word navigation. join delegates to
 * Vector.join. repeat, replace, count and find are retained one-line
 * delegates to the built-in of the same meaning, so both spellings share one
 * implementation and one null contract; new code calls the built-ins. Every
 * other transform or classifier (capitalize, title, swapCase, padLeft,
 * padRight, lstrip, rstrip, removePrefix, isDigit, isAlpha, isBlank) is a
 * built-in string method only.
 *
 * === CONTRACT ===
 *  - ENCODING: every Strings operation is BYTE-based, not Unicode-aware. Lengths,
 *    indices, find/rfind/count offsets, and slices are all measured in bytes.
 *    The string is treated as NUL-terminated, so an embedded '\0' ends it (use
 *    Library.Bytes for binary-safe data).
 *  - WHITESPACE is ASCII: space and \t \n \v \f \r, the same set the
 *    built-ins trim and isBlank use.
 *  - CASE OPS are ASCII-ONLY; bytes >= 0x80 pass through unchanged.
 *  - NULL: a null input string behaves as "" (a null replacement deletes the
 *    matched text, as the built-in replace does).
 *  - toInt: parses an optional leading sign then consecutive ASCII digits and
 *    STOPS at the first non-digit byte (after trimming surrounding whitespace).
 *    "12ab" -> 12, "abc" -> 0, "" -> 0, "-7" -> -7. Overflow saturates at
 *    the signed 32-bit bounds instead of invoking C signed-overflow UB.
 *  - repeat(s, n): n <= 0 yields the empty string "".
 */

import Library.Vector;

class Strings {
	/* Raw C memory boundaries repeat this nonnegative postcondition locally so
	 * strict optimizing compilers can prove every signed-to-size_t conversion. */
	class int checkedLength(string s) { return __btrc_string_length(s); }

	class string copy(string s) {
		if (s == null) { s = ""; }
		int length = Strings.checkedLength(s);
		if (length < 0) { abort(); }
		char* result = (char*)__btrc_safe_realloc(NULL, (size_t)length + (size_t)1);
		memcpy(result, s, (size_t)length);
		result[length] = '\0';
		return __btrc_string_adopt(result);
	}

	class string repeat(string s, int count) { return s.repeat(count); }

	/* Vector.join owns joining; a null vector joins to "". */
	class string join(Vector<string> items, string sep) { return items == null ? "" : items.join(sep); }

	class string replace(string s, string old, string replacement) { return s.replace(old, replacement); }

	class Vector<string> split(string s, string delim) {
		Vector<string> result = [];
		if (s == null || delim == null) { return result; }
		int dlen = Strings.checkedLength(delim);
		if (dlen == 0) { return result; }
		int slen = Strings.checkedLength(s);
		string first = delim.substring(0, 1);
		int offset = 0;
		while (true) {
			/* Scan on from the offset with the lengths measured once:
			 * re-measuring per piece would make splitting a large text
			 * quadratic. strcspn skips to each candidate first byte; only a
			 * candidate is compared in full. */
			int found = -1;
			int index = offset;
			while (dlen <= slen - index) {
				index = index + (int)strcspn((char*)s + index, first);
				if (dlen > slen - index) { break; }
				if (memcmp((char*)s + index, delim, (size_t)dlen) == 0) {
					found = index;
					break;
				}
				index++;
			}
			int seglen = found >= 0 ? found - offset : slen - offset;
			char* item = (char*)__btrc_safe_realloc(NULL, (size_t)seglen + (size_t)1);
			memcpy(item, (char*)s + offset, (size_t)seglen);
			item[seglen] = '\0';
			result.push(__btrc_string_adopt(item));
			if (found < 0) { break; }
			offset = found + dlen;
		}
		return result;
	}

	class bool isDigit(char c) { return c >= '0' && c <= '9'; }

	class bool isAlpha(char c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }

	class bool isAlnum(char c) { return Strings.isAlpha(c) || Strings.isDigit(c); }

	/* ASCII whitespace: space and \t \n \v \f \r, as the runtime's built-ins. */
	class bool isSpace(char c) { return c == ' ' || (c >= '\t' && c <= '\r'); }

	/* Parses an optional leading +/- sign then consecutive ASCII digits,
     * stopping at the first non-digit byte (surrounding whitespace is trimmed
     * first). Garbage or empty input yields 0; e.g. "12ab" -> 12, "abc" -> 0.
     * Overflow saturates. See the file header CONTRACT for details. */
	class int toInt(string s) {
		if (s == null) { return 0; }
		string value = s.trim();
		if (value.isEmpty()) { return 0; }
		int sign = 1;
		int i = 0;
		if (value.startsWith("-")) {
			sign = -1;
			i = 1;
		} else if (value.startsWith("+")) {
			i = 1;
		}
		long long result = 0LL;
		long long limit = sign < 0 ? 2147483648LL : 2147483647LL;
		while (i < value.len() && Strings.isDigit(value[i])) {
			int digit = value[i] - '0';
			if (result > (limit - (long long)digit) / 10LL) {
				return sign < 0 ? -2147483647 - 1 : 2147483647;
			}
			result = result * 10LL + (long long)digit;
			i++;
		}
		if (sign < 0 && result == 2147483648LL) {
			return -2147483647 - 1;
		}
		return (int)result * sign;
	}

	/* --- String Analysis --- */

	class int count(string s, string sub) { return s.count(sub); }

	class int find(string s, string sub, int start) { return s.find(sub, start); }

	class int rfind(string s, string sub) {
		if (s == null || sub == null) { return -1; }
		int slen = Strings.checkedLength(s);
		int sublen = Strings.checkedLength(sub);
		if (sublen == 0) { return slen; }
		int i = slen - sublen;
		while (i >= 0) {
			if (strncmp((char*)s + i, sub, sublen) == 0) {
				return i;
			}
			i--;
		}
		return -1;
	}

	class int compare(string left, string right) {
		if (left == null && right == null) { return 0; }
		if (left == null) { return -1; }
		if (right == null) { return 1; }
		int i = 0;
		while (left[i] != '\0' && right[i] != '\0') {
			unsigned char leftByte = (unsigned char)left[i];
			unsigned char rightByte = (unsigned char)right[i];
			if (leftByte < rightByte) { return -1; }
			if (leftByte > rightByte) { return 1; }
			i++;
		}
		if (left[i] == '\0' && right[i] == '\0') { return 0; }
		if (left[i] == '\0') { return -1; }
		return 1;
	}

	class bool lessThan(string left, string right) { return Strings.compare(left, right) < 0; }

	/* --- Numeric Conversion --- */

	class string fromInt(int n) {
		char* buf = (char*)__btrc_safe_realloc(NULL, 32);
		snprintf(buf, 32, "%d", n);
		return __btrc_string_adopt(buf);
	}

	class string fromFloat(float f) {
		char* buf = (char*)__btrc_safe_realloc(NULL, 64);
		snprintf(buf, 64, "%g", f);
		return __btrc_string_adopt(buf);
	}
}

/* The one owner of UTF-8 scalar rules (RFC 3629). A well-formed scalar is one
 * to four bytes with no overlong form, no surrogate (U+D800..U+DFFF) and
 * nothing above U+10FFFF. Any other byte decodes as U+FFFD and advances one
 * byte, so decoding and boundary walks always make progress and agree with
 * each other. Offsets are byte offsets into data[0, length), which lets
 * binary buffers with embedded NUL share these rules; U+0000 is well-formed,
 * so callers that forbid NUL check for it themselves. */
class UTF8 {
	class bool continuation(int value) { return value >= 0x80 && value <= 0xBF; }

	/* Bytes in the well-formed scalar at offset: 1 to 4, or 0 when the bytes
	 * there are an invalid lead, a stray continuation, an overlong form, a
	 * surrogate, beyond U+10FFFF, truncated, or out of range. */
	class int width(string data, int length, int offset) {
		if (data == null || offset < 0 || offset >= length) { return 0; }
		int first = (int)(unsigned char)data[offset];
		if (first <= 0x7F) { return 1; }
		int remaining = length - offset;
		if (first >= 0xC2 && first <= 0xDF) {
			return remaining >= 2 && UTF8.continuation((int)(unsigned char)data[offset + 1]) ? 2 : 0;
		}
		if (first >= 0xE0 && first <= 0xEF) {
			if (remaining < 3) { return 0; }
			int second = (int)(unsigned char)data[offset + 1];
			int low = first == 0xE0 ? 0xA0 : 0x80;
			int high = first == 0xED ? 0x9F : 0xBF;
			return second >= low && second <= high && UTF8.continuation((int)(unsigned char)data[offset + 2]) ? 3 : 0;
		}
		if (first >= 0xF0 && first <= 0xF4) {
			if (remaining < 4) { return 0; }
			int second = (int)(unsigned char)data[offset + 1];
			int low = first == 0xF0 ? 0x90 : 0x80;
			int high = first == 0xF4 ? 0x8F : 0xBF;
			return second >= low && second <= high && UTF8.continuation((int)(unsigned char)data[offset + 2]) && UTF8.continuation((int)(unsigned char)data[offset + 3]) ? 4 : 0;
		}
		return 0;
	}

	/* The scalar at *offset, advancing *offset past it: U+FFFD for a malformed
	 * byte, which advances one byte, and -1 (with *offset at length) when
	 * *offset is outside data[0, length). */
	class int decode(string data, int length, int* offset) {
		int start = *offset;
		if (data == null || start < 0 || start >= length) {
			*offset = length;
			return -1;
		}
		int width = UTF8.width(data, length, start);
		if (width == 0) {
			*offset = start + 1;
			return 0xFFFD;
		}
		*offset = start + width;
		int first = (int)(unsigned char)data[start];
		if (width == 1) { return first; }
		int codepoint = first & (width == 2 ? 0x1F : (width == 3 ? 0x0F : 0x07));
		for (int index = 1; index < width; index++) { codepoint = (codepoint << 6) | ((int)(unsigned char)data[start + index] & 0x3F); }
		return codepoint;
	}

	/* True when data[0, length) is well-formed throughout. */
	class bool valid(string data, int length) {
		if (data == null || length < 0) { return false; }
		int offset = 0;
		while (offset < length) {
			int width = UTF8.width(data, length, offset);
			if (width == 0) { return false; }
			offset += width;
		}
		return true;
	}

	/* The boundary after the scalar at offset; a malformed byte is its own
	 * one-byte scalar. Clamped to [0, length]. */
	class int next(string data, int length, int offset) {
		if (offset >= length) { return length < 0 ? 0 : length; }
		if (offset < 0) { return 0; }
		int width = UTF8.width(data, length, offset);
		return offset + (width == 0 ? 1 : width);
	}

	/* The boundary before offset, the exact inverse of next: the start of the
	 * well-formed scalar ending at offset, else the single malformed byte
	 * before it. */
	class int previous(string data, int length, int offset) {
		int bounded = offset > length ? length : offset;
		if (data == null || bounded <= 0) { return 0; }
		int candidate = bounded - 1;
		int steps = 0;
		while (candidate > 0 && steps < 3 && UTF8.continuation((int)(unsigned char)data[candidate])) {
			candidate--;
			steps++;
		}
		return UTF8.width(data, length, candidate) == bounded - candidate ? candidate : bounded - 1;
	}

	/* Word scalars for keyboard navigation: ASCII letters, digits and '_',
	 * plus every non-ASCII scalar. */
	class bool wordScalar(string data, int length, int offset) {
		if (data == null || offset < 0 || offset >= length) { return false; }
		int code = (int)(unsigned char)data[offset];
		return code >= 0x80 || (code >= '0' && code <= '9') || (code >= 'A' && code <= 'Z') || (code >= 'a' && code <= 'z') || code == '_';
	}

	/* The start of the word at or before offset, skipping separators first. */
	class int previousWord(string data, int length, int offset) {
		int position = offset > length ? length : offset;
		while (position > 0 && !UTF8.wordScalar(data, length, UTF8.previous(data, length, position))) { position = UTF8.previous(data, length, position); }
		while (position > 0 && UTF8.wordScalar(data, length, UTF8.previous(data, length, position))) { position = UTF8.previous(data, length, position); }
		return position;
	}

	/* The end of the word at or after offset, skipping separators first. */
	class int nextWord(string data, int length, int offset) {
		int position = offset < 0 ? 0 : offset;
		while (position < length && !UTF8.wordScalar(data, length, position)) { position = UTF8.next(data, length, position); }
		while (position < length && UTF8.wordScalar(data, length, position)) { position = UTF8.next(data, length, position); }
		return position;
	}
}

/* Amortized-growth text assembly for callers that emit output incrementally.
 * The backing allocation stays private; toString() returns an independent,
 * tracked btrc string, so the builder can be cleared or destroyed afterward. */
class StringBuilder {
	private char* data;
	private int len;
	private int cap;

	public StringBuilder() {
		self.data = null;
		self.len = 0;
		self.cap = 0;
	}

	private void reserveAdditional(int count) {
		if (count < 0 || count > 2147483646 - self.len) {
			fprintf(stderr, "StringBuilder length overflow\n");
			exit(1);
		}
		int required = self.len + count;
		if (required <= self.cap) { return; }

		int nextCap = self.cap == 0 ? 64 : self.cap;
		while (nextCap < required) {
			if (nextCap > 1073741823) {
				nextCap = required;
			} else {
				nextCap = nextCap * 2;
			}
		}
		self.data = (char*)__btrc_safe_realloc(self.data, (size_t)nextCap);
		self.cap = nextCap;
	}

	public void append(string text) {
		if (text == null) { return; }
		int count = Strings.checkedLength(text);
		if (count == 0) { return; }
		self.reserveAdditional(count);
		memcpy(self.data + self.len, text, (size_t)count);
		self.len += count;
	}

	public void appendChar(char value) {
		self.reserveAdditional(1);
		self.data[self.len] = value;
		self.len++;
	}

	public void appendRepeat(char value, int count) {
		if (count <= 0) { return; }
		self.reserveAdditional(count);
		memset(self.data + self.len, (unsigned char)value, (size_t)count);
		self.len += count;
	}

	public int length() { return self.len; }

	public bool isEmpty() { return self.len == 0; }

	public void clear() { self.len = 0; }

	public string toString() {
		char* result = (char*)__btrc_safe_realloc(null, (size_t)self.len + (size_t)1);
		if (self.len > 0) {
			memcpy(result, self.data, (size_t)self.len);
		}
		result[self.len] = '\0';
		return __btrc_string_adopt(result);
	}

	public void __del__() {
		if (self.data != null) {
			free(self.data);
			self.data = null;
		}
		self.len = 0;
		self.cap = 0;
	}
}
