import Library.Array;
import Library.Bytes;

// One canonical prefix code of a DEFLATE block.
class DeflateHuffman {
	private Array<int> counts;
	private Array<int> symbols;
	// The next nine input bits select (length << 9) | symbol, or 0 for a longer code.
	public Array<int> fast;

	// lengths[start .. start + count) holds each symbol's code length; 0 leaves it unused.
	public DeflateHuffman(Bytes lengths, int start, int count, bool forLengths) {
		self.counts = new Array<int>(16);
		self.symbols = new Array<int>(count);
		self.fast = new Array<int>(512);
		for (int i = 0; i < count; i++) {
			var length = lengths.get(start + i);
			self.counts.set(length, self.counts.get(length) + 1);
		}
		self.counts.set(0, 0);
		var next = new Array<int>(16);
		int unused = 1;
		int longest = 0;
		int total = 0;
		for (int length = 1; length < 16; length++) {
			next.set(length, total);
			total += self.counts.get(length);
			unused = unused * 2 - self.counts.get(length);
			if (unused < 0) { throw "Oversubscribed DEFLATE Huffman code"; }
			if (self.counts.get(length) > 0) { longest = length; }
		}
		// Like zlib, accept an incomplete code only when it is one single-bit
		// code or none at all, and never for the code-length alphabet.
		if (unused > 0 && (forLengths || longest > 1)) { throw "Incomplete DEFLATE Huffman code"; }
		for (int i = 0; i < count; i++) {
			var length = lengths.get(start + i);
			if (length == 0) { continue; }
			self.symbols.set(next.get(length), i);
			next.set(length, next.get(length) + 1);
		}
		int code = 0;
		int index = 0;
		for (int length = 1; length <= 9; length++) {
			for (int k = 0; k < self.counts.get(length); k++) {
				// Codes are packed starting from their most significant bit.
				int reversed = 0;
				for (int bit = 0; bit < length; bit++) { reversed |= ((code >> bit) & 1) << (length - 1 - bit); }
				var entry = (length << 9) | self.symbols.get(index);
				for (int slot = reversed; slot < 512; slot += 1 << length) { self.fast.set(slot, entry); }
				code++;
				index++;
			}
			code <<= 1;
		}
	}

	// Decodes the code at the low end of `window`: (length << 9) | symbol, or 0 for none.
	public int slow(unsigned int window) {
		int code = 0;
		int first = 0;
		int index = 0;
		for (int length = 1; length < 16; length++) {
			code |= (int)((window >> (length - 1)) & 1u);
			var count = self.counts.get(length);
			if (code - count < first) { return (length << 9) | self.symbols.get(index + code - first); }
			index += count;
			first = (first + count) << 1;
			code <<= 1;
		}
		return 0;
	}
}
