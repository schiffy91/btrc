import Library.Bytes;
import Library.Vector;

import ./DeflateStream.btrc;

/* An RFC 1950 stream over the specified half-open byte ranges.
 * Reads exactly the caller's requested output, retaining 32 KiB history. */
class ZlibReader {
	private DeflateStream stream;
	private unsigned int low = 1u;
	private unsigned int high = 0u;

	public ZlibReader(Bytes input, Vector<int> ranges) {
		self.stream = DeflateStream(input, ranges);
		var method = self.stream.byte();
		var flags = self.stream.byte();
		if ((method & 15) != 8 || (method >> 4) > 7 || ((method << 8) | flags) % 31 != 0 || (flags & 32) != 0) { throw "Invalid zlib header"; }
		self.stream.reset(1 << ((method >> 4) + 8));
	}

	public void read(unsigned char* target, int count) {
		if (self.stream.readSome(target, count) != count) { throw "zlib stream is too short"; }
		int i = 0;
		while (i < count) {
			// 5552 additions cannot overflow 32 bits before the next reduction.
			var stop = count - i > 5552 ? i + 5552 : count;
			for (; i < stop; i++) {
				self.low += (unsigned int)target[i];
				self.high += self.low;
			}
			self.low %= 65521u;
			self.high %= 65521u;
		}
	}

	public void finish(bool exact = true) {
		if (!self.stream.finish(exact)) { return; }
		unsigned int check = 0u;
		for (int i = 0; i < 4; i++) { check = (check << 8) | (unsigned int)self.stream.byte(); }
		if (check != ((self.high << 16) | self.low)) { throw "zlib stream fails its Adler-32 check"; }
		if (exact && self.stream.more()) { throw "Trailing zlib input"; }
	}
}
