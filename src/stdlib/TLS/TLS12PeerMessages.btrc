/* TLS 1.2 handshake parameters are admitted only if the client actually
 * offered them. The ClientHello is shared with TLS 1.3; its original bytes
 * also supply the transcript and the client's signature input random. */
import Library.Bytes;
import Library.Vector;

import ./TLS12Keys.btrc;
import ./X509Algorithm.btrc;
import ./X509Certificate.btrc;
import ./X509ServerPath.btrc;

class TLS12Offer {
	public Bytes random;
	public Bytes session;
	public Bytes suites;
	public Bytes signatures;
	public Bytes extensionTypes;
	public bool offered13;
	public bool offeredHTTP;

	class bool contains(Bytes list, int kind) {
		for (int i = 0; i + 1 < list.length(); i += 2) { if (list.readU16BE(i) == kind) { return true; } }
		return false;
	}

	class TLS12Offer? read(Bytes message) {
		if (message == null || message.length() < 47 || message.length() > 131072 || message.get(0) != 1 || ((message.get(1) << 16) | message.readU16BE(2)) != message.length() - 4 || message.readU16BE(4) != 0x0303) { return null; }
		var offer = TLS12Offer();
		offer.random = message.slice(6, 38);
		int sessionSize = message.get(38);
		int at = 39 + sessionSize;
		if (sessionSize > 32 || at + 2 > message.length()) { return null; }
		offer.session = message.slice(39, at);
		int size = message.readU16BE(at); at += 2;
		if (size < 2 || (size & 1) != 0 || size + 4 > message.length() - at) { return null; }
		offer.suites = message.slice(at, at + size); at += size;
		if (message.get(at) != 1 || message.get(at + 1) != 0 || message.readU16BE(at + 2) != message.length() - at - 4) { return null; }
		at += 4; offer.extensionTypes = Bytes(); offer.signatures = Bytes();
		bool allows12 = true; bool offeredX25519 = false;
		while (at < message.length()) {
			if (message.length() - at < 4) { return null; }
			int kind = message.readU16BE(at); size = message.readU16BE(at + 2); at += 4;
			if (size > message.length() - at || TLS12Offer.contains(offer.extensionTypes, kind)) { return null; }
			offer.extensionTypes.appendU16BE(kind);
			if (kind == 13) {
				if (size < 4 || (size & 1) != 0 || message.readU16BE(at) != size - 2) { return null; }
				offer.signatures = message.slice(at + 2, at + size);
			} else if (kind == 10) {
				if (size < 4 || (size & 1) != 0 || message.readU16BE(at) != size - 2) { return null; }
				offeredX25519 = TLS12Offer.contains(message.slice(at + 2, at + size), 29);
			} else if (kind == 16) {
				if (size < 4 || message.readU16BE(at) != size - 2) { return null; }
				int cursor = at + 2;
				while (cursor < at + size) {
					int length = message.get(cursor++);
					if (length == 0 || length > at + size - cursor) { return null; }
					if (length == 8 && message.slice(cursor, cursor + length).equals(Bytes.fromString("http/1.1"))) { offer.offeredHTTP = true; }
					cursor += length;
				}
			} else if (kind == 43) {
				if (size < 3 || (size & 1) != 1 || message.get(at) != size - 1) { return null; }
				var versions = message.slice(at + 1, at + size);
				offer.offered13 = TLS12Offer.contains(versions, 0x0304);
				allows12 = TLS12Offer.contains(versions, 0x0303);
			} else if (kind == 23 && size != 0) { return null; }
			else if (kind == 0xff01 && (size != 1 || message.get(at) != 0)) { return null; }
			at += size;
		}
		if (!allows12 || !offeredX25519 || offer.signatures.isEmpty() || !TLS12Offer.contains(offer.extensionTypes, 23) || !TLS12Offer.contains(offer.extensionTypes, 0xff01)) { return null; }
		return offer;
	}

	public int selectSuite(Bytes hello) {
		if (hello.length() < 40 || hello.readU16BE(0) != 0x0303) { return 0; }
		if (self.offered13 && hello.slice(26, 33).equals(Bytes.fromString("DOWNGRD")) && hello.get(33) <= 1) { return -1; }
		int sessionSize = hello.get(34); int at = 35 + sessionSize;
		if (sessionSize > 32 || at + 5 > hello.length()) { return 0; }
		/* A full handshake may assign a new session ID, but must not echo a
		 * nonempty requested one (which would select session resumption). */
		if (sessionSize > 0 && hello.slice(35, at).equals(self.session)) { return 0; }
		int suite = hello.readU16BE(at);
		if (TLS12Keys.keyLength(suite) == 0 || !TLS12Offer.contains(self.suites, suite) || hello.get(at + 2) != 0 || hello.readU16BE(at + 3) != hello.length() - at - 5) { return 0; }
		at += 5;
		Bytes seen = Bytes();
		while (at < hello.length()) {
			if (hello.length() - at < 4) { return 0; }
			int kind = hello.readU16BE(at); int size = hello.readU16BE(at + 2); at += 4;
			if (size > hello.length() - at || TLS12Offer.contains(seen, kind) || !TLS12Offer.contains(self.extensionTypes, kind)) { return 0; }
			seen.appendU16BE(kind);
			if (kind == 23 || kind == 0) { if (size != 0) { return 0; } }
			else if (kind == 0xff01) { if (size != 1 || hello.get(at) != 0) { return 0; } }
			else if (kind == 11) {
				if (size < 2 || hello.get(at) != size - 1) { return 0; }
				bool uncompressed = false;
				for (int i = 1; i < size; i++) { if (hello.get(at + i) == 0) { uncompressed = true; } }
				if (!uncompressed) { return 0; }
			} else if (kind == 16) {
				if (!self.offeredHTTP || size != 11 || hello.readU16BE(at) != 9 || hello.get(at + 2) != 8 || !hello.slice(at + 3, at + 11).equals(Bytes.fromString("http/1.1"))) { return 0; }
			} else { return 0; }
			at += size;
		}
		return TLS12Offer.contains(seen, 23) && TLS12Offer.contains(seen, 0xff01) ? suite : 0;
	}
}

class TLS12PeerMessages {
	class Vector<X509Certificate>? certificates(Bytes body) {
		if (body.length() < 6 || body.length() > 1048576 || ((body.get(0) << 16) | body.readU16BE(1)) != body.length() - 3) { return null; }
		Vector<X509Certificate> peers = [];
		int at = 3;
		while (at < body.length()) {
			if (peers.len >= 10 || body.length() - at < 3) { return null; }
			int size = (body.get(at) << 16) | body.readU16BE(at + 1); at += 3;
			if (size < 1 || size > 131072 || size > body.length() - at) { return null; }
			var cert = X509Certificate.parse((unsigned char*)body.data + at, size);
			if (cert == null) { return null; }
			peers.push(cert); at += size;
		}
		return peers;
	}

	class Bytes? signedShare(TLS12Offer offer, Bytes serverRandom, int suite, X509Certificate leaf, Bytes body) {
		if (body.length() < 41 || body.get(0) != 3 || body.readU16BE(1) != 29 || body.get(3) != 32 || body.readU16BE(38) != body.length() - 40) { return null; }
		int scheme = body.readU16BE(36);
		if (!TLS12Offer.contains(offer.signatures, scheme)) { return null; }
		bool rsa = suite == 0xc02f || suite == 0xc030 || suite == 0xcca8;
		if (rsa != (leaf.key.kind == X509_RSA || leaf.key.kind == X509_RSA_PSS)) { return null; }
		Bytes input = offer.random.slice(0, 32);
		input.appendBytes(serverRandom); input.appendBytes(body.slice(0, 36));
		if (!X509ServerPath.signature(scheme, leaf, input, body.slice(40, body.length()))) { return null; }
		return body.slice(4, 36);
	}

	/* We have no client certificate. Validate the CertificateRequest vector
	 * bounds and answer it with an empty Certificate in the client flight. */
	class bool certificateRequest(Bytes body) {
		if (body.length() < 8 || body.get(0) == 0) { return false; }
		int at = 1 + body.get(0);
		if (at + 2 > body.length()) { return false; }
		int size = body.readU16BE(at); at += 2;
		if (size < 2 || (size & 1) != 0 || size > body.length() - at - 2) { return false; }
		at += size;
		if (body.readU16BE(at) != body.length() - at - 2) { return false; }
		at += 2;
		while (at < body.length()) {
			if (body.length() - at < 2) { return false; }
			size = body.readU16BE(at); at += 2;
			if (size < 1 || size > body.length() - at) { return false; }
			at += size;
		}
		return true;
	}
}
