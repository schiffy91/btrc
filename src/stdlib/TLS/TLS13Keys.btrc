/* The TLS 1.3 HKDF label encoding, RFC 8446 section 7.1. The transcript
 * digest and secret are supplied by the current handshake state. */
import Library.Crypto.Primitives.HKDF;

class TLS13Keys {
	class bool expandLabel(bool useSHA384, unsigned char* out, int length, unsigned char* secret, string label, unsigned char* context, int contextLength) {
		int size = useSHA384 ? 48 : 32;
		if (length < 0 || length > 255 * size || label == null || label.len() < 1 || label.len() > 249 || contextLength < 0 || contextLength > 255) { return false; }
		/* uint16 length; opaque label<7..255>; opaque context<0..255>. */
		unsigned char info[514];
		info[0] = (unsigned char)(length >> 8);
		info[1] = (unsigned char)(length & 255);
		info[2] = (unsigned char)(6 + label.len());
		string prefix = "tls13 ";
		for (int index = 0; index < 6; index++) { info[3 + index] = (unsigned char)prefix[index]; }
		for (int index = 0; index < label.len(); index++) { info[9 + index] = (unsigned char)label[index]; }
		int offset = 9 + label.len();
		info[offset++] = (unsigned char)contextLength;
		for (int index = 0; index < contextLength; index++) { info[offset++] = context[index]; }
		return HKDF.expand(useSHA384, out, length, secret, size, info, offset);
	}
}
