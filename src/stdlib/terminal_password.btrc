/* Interrupt-safe password input for Unix terminals.
 *
 * Signal dispositions and terminal attributes are process-wide resources. A
 * process-wide mutex therefore serializes password prompts. While a prompt is
 * active, a self-pipe turns SIGINT/SIGTERM/SIGHUP into poll wakeups; cleanup
 * restores the descriptor flags, terminal attributes, and caller dispositions
 * before replaying the first signal under the caller's policy.
 */

#include <errno.h>
#include <fcntl.h>
#include <poll.h>
#include <signal.h>
#include <stdint.h>
#include <termios.h>
#include <unistd.h>

import std.bytes;
import std.strings;

extern void flockfile(FILE* stream);
extern void funlockfile(FILE* stream);

sig_atomic_t terminalPasswordSignalState(int operation,
                                         sig_atomic_t signalNumber) {
    static volatile sig_atomic_t pending = (sig_atomic_t)0;
    if (operation == 1) {
        pending = (sig_atomic_t)0;
    } else if (operation == 2 && pending == (sig_atomic_t)0) {
        pending = signalNumber;
    }
    return pending;
}

int* terminalPasswordSignalReadSlot() {
    static int descriptor = -1;
    return &descriptor;
}

int* terminalPasswordSignalWriteSlot() {
    static int descriptor = -1;
    return &descriptor;
}

void terminalPasswordSignalHandler(int signalNumber) {
    int savedErrno = errno;
    terminalPasswordSignalState(2, (sig_atomic_t)signalNumber);
    int signalWrite = *terminalPasswordSignalWriteSlot();
    if (signalWrite >= 0) {
        char marker = 1;
        write(signalWrite, &marker, (size_t)1);
    }
    errno = savedErrno;
}

class TerminalPasswordInput {
    class bool configureSignalDescriptor(int descriptor) {
        int descriptorFlags = fcntl(descriptor, F_GETFD, 0);
        if (descriptorFlags < 0
                || fcntl(descriptor, F_SETFD,
                    descriptorFlags | FD_CLOEXEC) < 0) {
            return false;
        }
        int statusFlags = fcntl(descriptor, F_GETFL, 0);
        return statusFlags >= 0
            && fcntl(descriptor, F_SETFL,
                statusFlags | O_NONBLOCK) == 0;
    }

    class bool ensureSignalPipe() {
        int* signalRead = terminalPasswordSignalReadSlot();
        int* signalWrite = terminalPasswordSignalWriteSlot();
        if (*signalRead >= 0 && *signalWrite >= 0) {
            return true;
        }
        int descriptors[2];
        if (pipe(descriptors) != 0) { return false; }
        if (!TerminalPasswordInput.configureSignalDescriptor(descriptors[0])
                || !TerminalPasswordInput.configureSignalDescriptor(
                    descriptors[1])) {
            close(descriptors[0]);
            close(descriptors[1]);
            return false;
        }
        *signalRead = descriptors[0];
        *signalWrite = descriptors[1];
        return true;
    }

    class void drainSignalPipe() {
        int signalRead = *terminalPasswordSignalReadSlot();
        char discarded[64];
        while (true) {
            ssize_t count = read(
                signalRead, discarded, sizeof(discarded));
            if (count > (ssize_t)0) { continue; }
            if (count < (ssize_t)0 && errno == EINTR) { continue; }
            break;
        }
    }

    class bool setTerminalAttributes(int descriptor,
                                     struct termios* attributes) {
        int status = tcsetattr(descriptor, TCSANOW, attributes);
        while (status != 0 && errno == EINTR) {
            status = tcsetattr(descriptor, TCSANOW, attributes);
        }
        return status == 0;
    }

    class string readLine() {
        Bytes value = Bytes();
        while (terminalPasswordSignalState(0, (sig_atomic_t)0)
                == (sig_atomic_t)0) {
            errno = 0;
            int byte = fgetc(stdin);
            if (byte != EOF) {
                if (byte == '\n') { break; }
                value.append(byte);
                continue;
            }
            if (feof(stdin)) { break; }
            int readError = errno;
            clearerr(stdin);
            if (readError != EINTR
                    && readError != EAGAIN
                    && readError != EWOULDBLOCK) {
                break;
            }
            if (terminalPasswordSignalState(0, (sig_atomic_t)0)
                    != (sig_atomic_t)0) {
                break;
            }

            struct pollfd pending[2];
            pending[0].fd = STDIN_FILENO;
            pending[0].events = POLLIN;
            pending[0].revents = 0;
            pending[1].fd = *terminalPasswordSignalReadSlot();
            pending[1].events = POLLIN;
            pending[1].revents = 0;
            int ready = poll(pending, (nfds_t)2, -1);
            if (ready < 0 && errno == EINTR) { continue; }
            if (ready < 0) { break; }
            if (((int)pending[1].revents & (int)POLLIN) != 0) {
                TerminalPasswordInput.drainSignalPipe();
            }
            if (((int)pending[0].revents
                    & ((int)POLLERR | (int)POLLNVAL)) != 0) {
                break;
            }
        }
        return value.toStringLossy();
    }

    class int signalReadDescriptor() {
        return *terminalPasswordSignalReadSlot();
    }

    class int signalWriteDescriptor() {
        return *terminalPasswordSignalWriteSlot();
    }

    class string prompt(string label) {
        flockfile(stdin);

        string value = "";
        int replaySignal = 0;
        bool signalIntInstalled = false;
        bool signalTermInstalled = false;
        bool signalHupInstalled = false;
        bool terminalHidden = false;
        bool descriptorConfigured = false;
        int originalDescriptorFlags = -1;
        struct termios previousTerminal;
        struct sigaction previousInt;
        struct sigaction previousTerm;
        struct sigaction previousHup;

        bool ready = TerminalPasswordInput.ensureSignalPipe();
        if (ready) {
            TerminalPasswordInput.drainSignalPipe();
            terminalPasswordSignalState(1, (sig_atomic_t)0);

            struct sigaction action;
            memset(&action, 0, sizeof(action));
            action.sa_handler = terminalPasswordSignalHandler;
            ready = sigemptyset(&action.sa_mask) == 0
                && sigaddset(&action.sa_mask, SIGINT) == 0
                && sigaddset(&action.sa_mask, SIGTERM) == 0
                && sigaddset(&action.sa_mask, SIGHUP) == 0;
            if (ready && sigaction(SIGINT, &action, &previousInt) == 0) {
                signalIntInstalled = true;
            } else {
                ready = false;
            }
            if (ready && sigaction(SIGTERM, &action, &previousTerm) == 0) {
                signalTermInstalled = true;
            } else {
                ready = false;
            }
            if (ready && sigaction(SIGHUP, &action, &previousHup) == 0) {
                signalHupInstalled = true;
            } else {
                ready = false;
            }
        }

        if (ready) {
            originalDescriptorFlags = fcntl(STDIN_FILENO, F_GETFL, 0);
            descriptorConfigured = originalDescriptorFlags >= 0
                && fcntl(STDIN_FILENO, F_SETFL,
                    originalDescriptorFlags | O_NONBLOCK) == 0;
            ready = descriptorConfigured;
        }

        bool stdinIsTerminal = isatty(STDIN_FILENO) == 1;
        if (ready && stdinIsTerminal) {
            ready = tcgetattr(STDIN_FILENO, &previousTerminal) == 0;
            if (ready) {
                struct termios hidden = previousTerminal;
                hidden.c_lflag = (uintmax_t)hidden.c_lflag
                    & ~(uintmax_t)ECHO;
                terminalHidden = TerminalPasswordInput.setTerminalAttributes(
                    STDIN_FILENO, &hidden);
                ready = terminalHidden;
            }
        }

        fprintf(stderr, "%s", label == null ? "" : label);
        fflush(stderr);
        if (ready
                && terminalPasswordSignalState(0, (sig_atomic_t)0)
                    == (sig_atomic_t)0) {
            clearerr(stdin);
            value = TerminalPasswordInput.readLine();
        }

        if (terminalHidden) {
            if (!TerminalPasswordInput.setTerminalAttributes(
                    STDIN_FILENO, &previousTerminal)) {
                value = "";
            }
        }
        if (descriptorConfigured) {
            if (fcntl(STDIN_FILENO, F_SETFL,
                    originalDescriptorFlags) != 0) {
                value = "";
            }
        }
        clearerr(stdin);
        fprintf(stderr, "\n");
        fflush(stderr);

        if (signalHupInstalled) {
            sigaction(SIGHUP, &previousHup, NULL);
        }
        if (signalTermInstalled) {
            sigaction(SIGTERM, &previousTerm, NULL);
        }
        if (signalIntInstalled) {
            sigaction(SIGINT, &previousInt, NULL);
        }
        replaySignal = (int)terminalPasswordSignalState(
            0, (sig_atomic_t)0);
        funlockfile(stdin);

        if (replaySignal != 0) {
            value = "";
            raise(replaySignal);
        }
        return value;
    }
}
