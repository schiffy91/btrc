/* btrc standard library — HTTP
 *
 * A small HTTP/1.1 stack with no external dependencies:
 *   - HttpServer: a BSD-socket server (libc only). The caller owns the accept
 *     loop and routing, so it stays backend-agnostic.
 *   - HttpClient: an HTTPS-capable client that shells out to `curl` (TLS for
 *     free, which raw sockets can't do), via the process stdlib.
 *
 * Auto-included. Sockets are libc-only; the client requires `curl` on PATH.
 */
import std.bytes;
import std.fs;
import std.map;
import std.process;
import std.strings;
import std.vector;

#include <sys/types.h>
#include <sys/socket.h>
#include <netinet/in.h>
#include <arpa/inet.h>
#include <sys/time.h>
#include <unistd.h>
#include <string.h>
#include <signal.h>
#include <errno.h>

class HttpRequest {
    public string method;
    public string path;     /* path without query string */
    public string query;    /* raw query string, may be "" */
    public Map<string, string> headers;  /* header names lower-cased */
    public string body;        /* string view of the body — truncates at NUL */
    public Bytes bodyBytes;    /* binary-safe body — full bytes, NUL preserved */

    public HttpRequest() {
        self.method = "GET";
        self.path = "/";
        self.query = "";
        self.headers = {};
        self.body = "";
        self.bodyBytes = Bytes();
    }

    public string header(string name) {
        return self.headers.getOrDefault(name.toLower(), "");
    }

    /* Parse the raw query string ("a=1&b=hello%20world+x") into a map of
     * percent-decoded name -> value pairs. req.query is kept raw (so the
     * separators '&' and '=' are interpreted here, not pre-mangled by decoding);
     * each individual name and value is urlDecode'd. A bare key ("flag") maps to
     * "". Later duplicates win. */
    public Map<string, string> queryParams() {
        Map<string, string> out = {};
        if (self.query.isEmpty()) { return out; }
        for pair in Strings.split(self.query, "&") {
            if (pair.isEmpty()) { continue; }
            int eq = Strings.find(pair, "=", 0);
            if (eq < 0) {
                out.put(HttpServer.urlDecode(pair), "");
            } else {
                string k = pair.substring(0, eq);
                string v = pair.substring(eq + 1, pair.len() - (eq + 1));
                out.put(HttpServer.urlDecode(k), HttpServer.urlDecode(v));
            }
        }
        return out;
    }

    public bool isGet() { return self.method.equals("GET"); }
    public bool isPost() { return self.method.equals("POST"); }
}

class HttpResponse {
    public int status;
    public string contentType;
    public string body;
    public Vector<string> extraHeaders;

    public HttpResponse(int status, string contentType, string body) {
        self.status = status;
        self.contentType = contentType;
        self.body = body;
        self.extraHeaders = [];
    }

    public HttpResponse addHeader(string line) {
        self.extraHeaders.push(line);
        return self;
    }

    class HttpResponse text(string body) {
        return HttpResponse(200, "text/plain; charset=utf-8", body);
    }
    class HttpResponse html(string body) {
        return HttpResponse(200, "text/html; charset=utf-8", body);
    }
    class HttpResponse json(string body) {
        return HttpResponse(200, "application/json; charset=utf-8", body);
    }
    class HttpResponse js(string body) {
        return HttpResponse(200, "application/javascript; charset=utf-8", body);
    }
    class HttpResponse css(string body) {
        return HttpResponse(200, "text/css; charset=utf-8", body);
    }
    class HttpResponse notFound() {
        return HttpResponse(404, "text/plain; charset=utf-8", "Not Found");
    }
    class HttpResponse error(int code, string message) {
        return HttpResponse(code, "text/plain; charset=utf-8", message);
    }
}

class HttpServer {
    public int fd;
    public int port;
    public bool bindAny;   /* bind 0.0.0.0 instead of 127.0.0.1 */

    public HttpServer(int port) {
        self.port = port;
        self.fd = -1;
        self.bindAny = false;
    }

    public bool start() {
        signal(SIGPIPE, SIG_IGN);
        int s = socket(AF_INET, SOCK_STREAM, 0);
        if (s < 0) { return false; }
        int yes = 1;
        setsockopt(s, SOL_SOCKET, SO_REUSEADDR, &yes, sizeof(yes));
        struct sockaddr_in addr;
        memset(&addr, 0, sizeof(addr));
        addr.sin_family = AF_INET;
        addr.sin_port = htons((unsigned short)self.port);
        if (self.bindAny) {
            addr.sin_addr.s_addr = htonl(INADDR_ANY);
        } else {
            addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
        }
        if (bind(s, (struct sockaddr*)&addr, sizeof(addr)) < 0) { close(s); return false; }
        if (listen(s, 64) < 0) { close(s); return false; }
        self.fd = s;
        return true;
    }

    public int acceptConn() {
        struct sockaddr_in cli;
        socklen_t clilen = sizeof(cli);
        int c = accept(self.fd, (struct sockaddr*)&cli, &clilen);
        if (c >= 0) {
            struct timeval tv;
            tv.tv_sec = 15;
            tv.tv_usec = 0;
            setsockopt(c, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
        }
        return c;
    }

    public void closeConn(int c) {
        close(c);
    }

    class int headerContentLength(string head, int headerEnd) {
        string headerText = head.substring(0, headerEnd);
        for line in Strings.split(headerText, "\r\n") {
            int colon = Strings.find(line, ":", 0);
            if (colon <= 0) { continue; }
            string name = line.substring(0, colon).trim().toLower();
            if (!name.equals("content-length")) { continue; }
            string value = line.substring(colon + 1, line.len() - (colon + 1)).trim();
            int i = 0;
            int val = 0;
            while (i < value.len() && value[i] >= '0' && value[i] <= '9') {
                val = val * 10 + (value[i] - '0');
                i++;
            }
            return val;
        }
        return 0;
    }

    /* Binary-safe recv loop: accumulates the raw request into a Bytes buffer by
     * memcpy'ing exactly recv()'s return-count bytes. The old loop did
     * `data = data + Strings.copy(buf)`, which truncated at the first NUL and so
     * corrupted binary POST bodies. Header framing (\r\n\r\n, Content-Length) is
     * ASCII and precedes the body, so it is detected via a NUL-free string view
     * of the bytes received so far. */
    public Bytes readRequestRawBytes(int c) {
        Bytes data = Bytes();
        char buf[8192];
        bool haveHeaders = false;
        bool chunked = false;
        int headerEnd = -1;
        int contentLen = 0;
        while (true) {
            int n = (int)recv(c, buf, 8192, 0);
            if (n <= 0) { break; }
            data.appendRaw(buf, n);
            if (!haveHeaders) {
                /* The header block contains no NUL and ends before the body,
                 * so a lossy string view is sufficient for framing. */
                string view = data.toStringLossy();
                int he = Strings.find(view, "\r\n\r\n", 0);
                if (he >= 0) {
                    haveHeaders = true;
                    headerEnd = he;
                    chunked = HttpServer.isChunked(view, he);
                    if (!chunked) {
                        contentLen = HttpServer.headerContentLength(view, he);
                    }
                }
            }
            if (haveHeaders) {
                if (chunked) {
                    /* Read until the terminating "0\r\n\r\n" chunk arrives. The
                     * body region is searched from headerEnd for the end marker;
                     * decodeChunked does the actual assembly later. */
                    string view = data.toStringLossy();
                    int term = Strings.find(view, "\r\n0\r\n\r\n", headerEnd);
                    if (term >= 0) { break; }
                    int term2 = Strings.find(view, "\r\n0\r\n", headerEnd);
                    if (term2 >= 0) { break; }
                } else {
                    int bodyStart = headerEnd + 4;
                    int have = data.length() - bodyStart;
                    if (have >= contentLen) { break; }
                }
            }
        }
        return data;
    }

    /* Back-compat string accessor. Returns the raw request as a string, which
     * truncates at the first NUL — fine for text requests, lossy for binary.
     * Binary callers should use readRequestRawBytes / readRequest().bodyBytes. */
    public string readRequestRaw(int c) {
        Bytes data = self.readRequestRawBytes(c);
        string out = data.toStringLossy();
        return out;
    }

    public HttpRequest readRequest(int c) {
        return self.parseBytes(self.readRequestRawBytes(c));
    }

    /* Parse a raw request held in a Bytes buffer. Headers parse from a string
     * view (ASCII); the body is sliced from the Bytes buffer so binary bodies
     * (including embedded NUL) survive in req.bodyBytes. req.body remains the
     * string view for text callers (truncates at NUL — documented). */
    public HttpRequest parseBytes(Bytes raw) {
        string view = raw.toStringLossy();
        HttpRequest req = self.parse(view);
        int he = Strings.find(view, "\r\n\r\n", 0);
        if (he >= 0) {
            int bodyStart = he + 4;
            if (HttpServer.isChunked(view, he)) {
                /* parse() already decoded req.body; mirror the assembled text
                 * into bodyBytes (chunked support is text-only — see
                 * decodeChunked). */
                Bytes decoded = Bytes();
                decoded.appendRaw(req.body, (int)strlen(req.body));
                req.bodyBytes = decoded;
            } else {
                req.bodyBytes = raw.slice(bodyStart, raw.length());
            }
        }
        return req;
    }

    public HttpRequest parse(string raw) {
        HttpRequest req = HttpRequest();
        if (raw.len() == 0) { return req; }
        int he = Strings.find(raw, "\r\n\r\n", 0);
        string head = he >= 0 ? raw.substring(0, he) : raw;
        if (he >= 0) {
            int bodyStart = he + 4;
            string rawBody = raw.substring(bodyStart, raw.len() - bodyStart);
            /* A chunked request body is wire-encoded; decode it so callers see
             * the assembled payload in req.body (text bodies — see
             * decodeChunked limits). */
            if (HttpServer.isChunked(head, head.len())) {
                req.body = HttpServer.decodeChunked(rawBody);
            } else {
                req.body = rawBody;
            }
        }
        Vector<string> lines = Strings.split(head, "\r\n");
        if (lines.len > 0) {
            Vector<string> parts = Strings.split(lines.get(0), " ");
            if (parts.len >= 2) {
                req.method = parts.get(0);
                string target = parts.get(1);
                int q = Strings.find(target, "?", 0);
                if (q >= 0) {
                    req.path = target.substring(0, q);
                    req.query = target.substring(q + 1, target.len() - (q + 1));
                } else {
                    req.path = target;
                }
            }
        }
        for (int i = 1; i < lines.len; i++) {
            string line = lines.get(i);
            int colon = Strings.find(line, ":", 0);
            if (colon > 0) {
                string name = line.substring(0, colon).trim().toLower();
                string value = line.substring(colon + 1, line.len() - (colon + 1)).trim();
                req.headers.put(name, value);
            }
        }
        return req;
    }

    /* Standard reason phrase for a status code. Unknown codes return a generic
     * class-based phrase (so e.g. a custom 2xx still reads sensibly) rather than
     * the old buggy fall-through to "OK", which produced nonsense like
     * "302 OK". */
    /* True when the head block declares Transfer-Encoding: chunked (case- and
     * whitespace-insensitive; also matches "gzip, chunked"). headerEnd is the
     * index of the "\r\n\r\n" that ends the headers, as from Strings.find. */
    class bool isChunked(string head, int headerEnd) {
        string headerText = head.substring(0, headerEnd);
        for line in Strings.split(headerText, "\r\n") {
            int colon = Strings.find(line, ":", 0);
            if (colon <= 0) { continue; }
            string name = line.substring(0, colon).trim().toLower();
            if (!name.equals("transfer-encoding")) { continue; }
            string value = line.substring(colon + 1, line.len() - (colon + 1)).trim().toLower();
            if (value.contains("chunked")) { return true; }
        }
        return false;
    }

    /* Decode an HTTP/1.1 chunked transfer-encoded body into the assembled
     * payload. Format: a sequence of "<hex-size>[;chunk-ext]\r\n<size bytes>\r\n"
     * chunks, ending with a "0\r\n" chunk followed by optional trailers and a
     * final "\r\n".
     *
     * Coverage: single- and multi-chunk bodies, chunk extensions (";..." after
     * the size, ignored), and upper/lower-case hex sizes. Trailers after the
     * terminating zero chunk are ignored.
     *
     * Limit: operates on a `string`, so it stops at the first embedded NUL —
     * fine for text bodies. Binary chunked bodies are not supported (chunked
     * uploads from browsers/forms are text in practice). A malformed length is
     * treated as end-of-stream, returning what was decoded so far. */
    class string decodeChunked(string body) {
        if (body == null) { return ""; }
        int n = (int)strlen(body);
        char* out = (char*)malloc((size_t)(n + 1));
        int o = 0;
        int i = 0;
        while (i < n) {
            /* Read the hex chunk size up to ';' (extension) or CRLF. */
            int size = 0;
            bool sawDigit = false;
            while (i < n) {
                int hv = HttpServer.hexVal(body[i]);
                if (hv < 0) { break; }
                size = size * 16 + hv;
                sawDigit = true;
                i++;
            }
            if (!sawDigit) { break; }
            /* Skip any chunk extension (";...") up to CRLF. */
            while (i < n && body[i] != '\r' && body[i] != '\n') { i++; }
            /* Skip the CRLF after the size line. */
            if (i < n && body[i] == '\r') { i++; }
            if (i < n && body[i] == '\n') { i++; }
            if (size == 0) { break; }   /* terminating chunk */
            /* Copy `size` data bytes (clamped to what's available). */
            int avail = n - i;
            int take = size < avail ? size : avail;
            if (take > 0) {
                memcpy(out + o, body + i, (size_t)take);
                o = o + take;
                i = i + take;
            }
            /* Skip the trailing CRLF after the chunk data. */
            if (i < n && body[i] == '\r') { i++; }
            if (i < n && body[i] == '\n') { i++; }
        }
        out[o] = '\0';
        return out;
    }

    /* Map a hex digit char to its 0..15 value, or -1 if not hex. */
    class int hexVal(char ch) {
        if (ch >= '0' && ch <= '9') { return (int)(ch - '0'); }
        if (ch >= 'a' && ch <= 'f') { return (int)(ch - 'a') + 10; }
        if (ch >= 'A' && ch <= 'F') { return (int)(ch - 'A') + 10; }
        return -1;
    }

    /* Percent-decode an application/x-www-form-urlencoded token: "%XX" -> the
     * byte XX, "+" -> space, everything else passes through. A "%" not followed
     * by two hex digits is left verbatim (lenient, matches browsers). */
    class string urlDecode(string s) {
        if (s == null) { return ""; }
        int n = (int)strlen(s);
        char* out = (char*)malloc((size_t)(n + 1));
        int o = 0;
        int i = 0;
        while (i < n) {
            char ch = s[i];
            if (ch == '+') {
                out[o] = ' ';
                o++;
                i++;
            } else if (ch == '%' && i + 2 < n) {
                int hi = HttpServer.hexVal(s[i + 1]);
                int lo = HttpServer.hexVal(s[i + 2]);
                if (hi >= 0 && lo >= 0) {
                    out[o] = (char)(hi * 16 + lo);
                    o++;
                    i = i + 3;
                } else {
                    out[o] = ch;
                    o++;
                    i++;
                }
            } else {
                out[o] = ch;
                o++;
                i++;
            }
        }
        out[o] = '\0';
        return out;
    }

    /* Percent-encode a string for use in a query value. Unreserved characters
     * (RFC 3986: A-Z a-z 0-9 - _ . ~) pass through; everything else becomes
     * "%XX" with upper-case hex. Space becomes "%20" (not "+"), so the result
     * is valid in both query and path contexts. */
    class string urlEncode(string s) {
        if (s == null) { return ""; }
        int n = (int)strlen(s);
        char* out = (char*)malloc((size_t)(n * 3 + 1));
        int o = 0;
        string hexDigits = "0123456789ABCDEF";
        for (int i = 0; i < n; i++) {
            int b = (int)((unsigned char)s[i]);
            char ch = (char)b;
            bool unreserved = (ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z')
                || (ch >= '0' && ch <= '9')
                || ch == '-' || ch == '_' || ch == '.' || ch == '~';
            if (unreserved) {
                out[o] = ch;
                o++;
            } else {
                out[o] = '%';
                out[o + 1] = hexDigits[(b >> 4) & 15];
                out[o + 2] = hexDigits[b & 15];
                o = o + 3;
            }
        }
        out[o] = '\0';
        return out;
    }

    public string reason(int status) {
        if (status == 200) { return "OK"; }
        if (status == 201) { return "Created"; }
        if (status == 204) { return "No Content"; }
        if (status == 301) { return "Moved Permanently"; }
        if (status == 302) { return "Found"; }
        if (status == 304) { return "Not Modified"; }
        if (status == 400) { return "Bad Request"; }
        if (status == 401) { return "Unauthorized"; }
        if (status == 403) { return "Forbidden"; }
        if (status == 404) { return "Not Found"; }
        if (status == 405) { return "Method Not Allowed"; }
        if (status == 500) { return "Internal Server Error"; }
        if (status == 502) { return "Bad Gateway"; }
        if (status == 503) { return "Service Unavailable"; }
        /* Generic phrase by status class for any other code. */
        if (status >= 200 && status < 300) { return "OK"; }
        if (status >= 300 && status < 400) { return "Redirect"; }
        if (status >= 400 && status < 500) { return "Client Error"; }
        if (status >= 500 && status < 600) { return "Server Error"; }
        return "";
    }

    /* Write every byte of `data` to the socket, surviving short writes and
     * EINTR. A single send() may transmit fewer bytes than requested (a short
     * write) or be interrupted by a signal (EINTR / EAGAIN), both of which the
     * old loop treated as fatal — silently dropping the tail of the response.
     * We loop until all bytes are sent, retrying on EINTR/EAGAIN and only
     * bailing on a genuine error (n < 0 with another errno) or n == 0. */
    public void sendAll(int c, string data) {
        char* p = data;
        int total = (int)strlen(data);
        int sent = 0;
        while (sent < total) {
            int n = (int)send(c, p + sent, total - sent, 0);
            if (n > 0) {
                sent = sent + n;
            } else if (n < 0 && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK)) {
                continue;
            } else {
                break;
            }
        }
    }

    public void respond(int c, HttpResponse resp) {
        int blen = (int)strlen(resp.body);
        string r = self.reason(resp.status);
        string head = f"HTTP/1.1 {resp.status} {r}\r\nContent-Type: {resp.contentType}\r\nContent-Length: {blen}\r\nCache-Control: no-store\r\nConnection: close\r\n";
        for h in resp.extraHeaders {
            head = head + h + "\r\n";
        }
        head = head + "\r\n";
        self.sendAll(c, head + resp.body);
    }
}

class HttpClientResponse {
    public int status;
    public string body;
    public string error;

    public HttpClientResponse(int status, string body, string error) {
        self.status = status;
        self.body = body;
        self.error = error;
    }

    public bool ok() {
        return self.status >= 200 && self.status < 300;
    }
}

class HttpClient {
    public int timeoutSecs;

    public HttpClient() {
        self.timeoutSecs = 120;
    }

    public HttpClient timeout(int secs) {
        self.timeoutSecs = secs;
        return self;
    }

    public HttpClientResponse request(string method, string url,
                                      Vector<string> headers, string body) {
        var dir = FileSystem.tempDir("btrchttp");
        if (dir.isEmpty()) {
            return HttpClientResponse(0, "", "could not create temp dir");
        }
        /* Everything below runs inside try/finally so the temp dir is removed on
         * every exit path — normal return, early error return, or an exception
         * thrown by any step (curl/process/fs). Previously a throw left the temp
         * dir leaked. */
        int status = 0;
        string responseBody = "";
        string error = "";
        try {
            var outFile = PathTools.join(dir, "resp.bin");
            var bodyFile = PathTools.join(dir, "req.bin");
            var hasBody = !body.isEmpty();
            if (hasBody) {
                FileSystem.writeText(bodyFile, body);
            }

            var command = Command("curl -sS")
                .flag("--max-time", Strings.fromInt(self.timeoutSecs))
                .flag("-X", method)
                .flag("-o", outFile)
                .flag("-w", "%{http_code}");
            for h in headers {
                command.flag("-H", h);
            }
            if (hasBody) {
                command.flag("--data-binary", "@" + bodyFile);
            }
            command.arg(url);

            var result = UnixShell().run(command, stderr=CommandOutput.stream(), logFailure=false);
            status = Strings.toInt(result.stdout().trim());

            if (FileSystem.exists(outFile)) {
                responseBody = FileSystem.readText(outFile);
            }
            if (status == 0) {
                error = f"curl failed (exit {result.code})";
            }
        } finally {
            FileSystem.removeRecursive(dir);
        }
        return HttpClientResponse(status, responseBody, error);
    }

    public HttpClientResponse post(string url, Vector<string> headers, string body) {
        return self.request("POST", url, headers, body);
    }

    public HttpClientResponse get(string url, Vector<string> headers) {
        return self.request("GET", url, headers, "");
    }
}

class Browser {
    class void open(string url) {
        var u = UnixShell().run("uname -s", logFailure=false);
        var kernel = u.stdout().trim();
        var opener = "xdg-open";
        if (kernel.equals("Darwin")) { opener = "open"; }
        if (kernel.contains("MINGW") || kernel.contains("MSYS") || kernel.contains("CYGWIN")) {
            opener = "start";
        }
        var command = Command(opener).arg(url);
        UnixShell().run(command, stdout=CommandOutput.stream(), stderr=CommandOutput.stream(), logFailure=false);
    }
}
