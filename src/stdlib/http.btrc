/* btrc standard library — HTTP
 *
 * HTTP/1.1 is separated by responsibility:
 *   framing (wire boundaries), socket I/O, public types, server, and client.
 * Importing std.http retains the complete historical API.
 */
import std.http_client;
import std.http_framing;
import std.http_protocol;
import std.http_server;
import std.http_socket;
import std.http_types;
