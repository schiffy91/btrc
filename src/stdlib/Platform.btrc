/* btrc standard library — Platform
 * Small platform probes and constants.
 *
 * The current implementation is POSIX-first because btrc's compiler and test
 * harness currently target Unix-like systems. The API leaves room for Windows
 * support without renaming higher-level shell abstractions.
 */

import Library.Strings;

#include <errno.h>
#include <unistd.h>
#include <stdlib.h>

class Platform {
	/* The C compiler's target, not the transpiling host: 0 = other, 1 = Apple,
	 * 2 = Linux, 3 = Windows. Fixed at C compile time, so no probe or cache. */
	class bool isWindows() { return __btrc_target_platform() == 3; }

	class bool isUnix() { return !Platform.isWindows(); }

	class string pathSeparator() { return Platform.isWindows() ? "\\" : "/"; }

	class int pid() { return (int)getpid(); }

	class int euid() { return (int)geteuid(); }

	class bool isRoot() {
		/* Windows has no POSIX root identity; the compatibility getuid/euid
         * value is only a sentinel and must never grant privileges. */
		return !Platform.isWindows() && Platform.euid() == 0;
	}

	/* The process working directory, or "" when it cannot be read. The
	 * buffer doubles until getcwd fits, up to a 1 GiB bound. */
	class string currentDirectory() {
		int capacity = 256;
		char* buffer = (char*)__btrc_safe_realloc(NULL, (size_t)capacity);
		while ((char*)getcwd(buffer, (size_t)capacity) == NULL) {
			if (errno != ERANGE || capacity > 1073741823) {
				free(buffer);
				return "";
			}
			capacity = capacity * 2;
			buffer = (char*)__btrc_safe_realloc(buffer, (size_t)capacity);
		}
		return __btrc_string_adopt(buffer);
	}
}

class Environment {
	class string get(string name, string fallback) {
		char* value = getenv(name);
		if (value == NULL || value[0] == '\0') { return fallback; }
		return Strings.copy(value);
	}

	class bool has(string name) {
		char* value = getenv(name);
		return value != NULL && value[0] != '\0';
	}
}
