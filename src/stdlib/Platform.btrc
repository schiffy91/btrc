/* btrc standard library — Platform
 * Small platform probes and constants.
 *
 * The current implementation is POSIX-first because btrc's compiler and test
 * harness currently target Unix-like systems. The API leaves room for Windows
 * support without renaming higher-level shell abstractions.
 */

import Library.Strings;

#include <errno.h>
#include <fcntl.h>
#include <unistd.h>
#include <stdlib.h>
#if defined(__APPLE__)
#include <stdint.h>
#include <mach-o/dyld.h>
#endif
#if defined(_WIN32)
extern unsigned long GetModuleFileNameA(void* module, char* buffer, unsigned long size);
#endif

class Platform {
	/* The C compiler's target, not the transpiling host: 0 = other, 1 = macOS,
	 * 2 = Linux, 3 = Windows, 4 = iOS (device or simulator), 5 = Android.
	 * Fixed at C compile time, so no probe or cache. */
	class bool isWindows() { return __btrc_target_platform() == 3; }

	class bool isIOS() { return __btrc_target_platform() == 4; }

	class bool isAndroid() { return __btrc_target_platform() == 5; }

	/* macOS or iOS: the Darwin kernel and Apple's frameworks. */
	class bool isApple() { return __btrc_target_platform() == 1 || __btrc_target_platform() == 4; }

	class bool isMobile() { return Platform.isIOS() || Platform.isAndroid(); }

	class bool isUnix() { return !Platform.isWindows(); }

	class string pathSeparator() { return Platform.isWindows() ? "\\" : "/"; }

	class int pid() { return (int)getpid(); }

	class int euid() { return (int)geteuid(); }

	class bool isRoot() {
		/* Windows has no POSIX root identity; the compatibility getuid/euid
         * value is only a sentinel and must never grant privileges. */
		return !Platform.isWindows() && Platform.euid() == 0;
	}

	/* The process working directory, or "" when it cannot be read. The
	 * buffer doubles until getcwd fits, up to a 1 GiB bound. */
	class string currentDirectory() {
		int capacity = 256;
		char* buffer = (char*)__btrc_safe_realloc(NULL, (size_t)capacity);
		while ((char*)getcwd(buffer, (size_t)capacity) == NULL) {
			if (errno != ERANGE || capacity > 1073741823) {
				free(buffer);
				return "";
			}
			capacity = capacity * 2;
			buffer = (char*)__btrc_safe_realloc(buffer, (size_t)capacity);
		}
		return __btrc_string_adopt(buffer);
	}

	/* The invoked program name or executable path, or "" when unavailable. */
	class string programName() {
#if defined(__linux__)
		int fd = open("/proc/self/cmdline", (int)O_RDONLY | (int)O_CLOEXEC);
		if (fd >= 0) {
			int capacity = 256;
			int length = 0;
			char* buffer = (char*)__btrc_safe_realloc(NULL, (size_t)capacity);
			bool sawNul = false;
			while (!sawNul && capacity <= 1048576) {
				ssize_t got = read(fd, buffer + length, (size_t)(capacity - 1 - length));
				if (got < (ssize_t)0) {
					if (errno == EINTR) { continue; }
					break;
				}
				if (got == (ssize_t)0) { break; }
				int limit = length + (int)got;
				while (length < limit) {
					if (buffer[length] == '\0') {
						sawNul = true;
						break;
					}
					length = length + 1;
				}
				if (!sawNul && length >= capacity - 1) {
					capacity = capacity * 2;
					buffer = (char*)__btrc_safe_realloc(buffer, (size_t)capacity);
				}
			}
			close(fd);
			if (length > 0) {
				buffer[length] = '\0';
				return __btrc_string_adopt(buffer);
			}
			free(buffer);
		}
		int exeCap = 256;
		while (exeCap <= 1048576) {
			char* exeBuf = (char*)__btrc_safe_realloc(NULL, (size_t)exeCap);
			ssize_t exeLen = readlink("/proc/self/exe", exeBuf, (size_t)(exeCap - 1));
			if (exeLen < (ssize_t)0) {
				free(exeBuf);
				return "";
			}
			if (exeLen < (ssize_t)(exeCap - 1)) {
				exeBuf[(int)exeLen] = '\0';
				return __btrc_string_adopt(exeBuf);
			}
			free(exeBuf);
			exeCap = exeCap * 2;
		}
		return "";
#elif defined(__APPLE__)
		uint32_t size = 0;
		(void)_NSGetExecutablePath(NULL, &size);
		if (size == 0 || size > 1048576u) { return ""; }
		char* buffer = (char*)__btrc_safe_realloc(NULL, (size_t)size);
		if (_NSGetExecutablePath(buffer, &size) != 0) {
			free(buffer);
			return "";
		}
		return __btrc_string_adopt(buffer);
#elif defined(_WIN32)
		int capacity = 260;
		while (capacity <= 1048576) {
			char* buffer = (char*)__btrc_safe_realloc(NULL, (size_t)capacity);
			unsigned long len = GetModuleFileNameA(NULL, buffer, (unsigned long)capacity);
			if (len == 0UL) {
				free(buffer);
				return "";
			}
			if (len < (unsigned long)(capacity - 1)) {
				buffer[len] = '\0';
				return __btrc_string_adopt(buffer);
			}
			free(buffer);
			capacity = capacity * 2;
		}
		return "";
#else
		return "";
#endif
	}
}

class Environment {
	class string get(string name, string fallback) {
		char* value = getenv(name);
		if (value == NULL || value[0] == '\0') { return fallback; }
		return Strings.copy(value);
	}

	class bool has(string name) {
		char* value = getenv(name);
		return value != NULL && value[0] != '\0';
	}
}
