/* btrc standard library -- platform-native per-user application directories.
 *
 * This resolves generic state, cache, and configuration roots only. Callers
 * append their own application identifier and remain responsible for creating
 * directories. Environment strings are bounded before they are copied.
 */

import std.strings;
import std.vector;

#include <stdlib.h>

enum ApplicationDirectoryErrorKind {
	APP_DIRECTORY_INVALID_ARGUMENT = 0,
	APP_DIRECTORY_UNAVAILABLE = 1,
	APP_DIRECTORY_PATH_TOO_LONG = 2,
	APP_DIRECTORY_UNSUPPORTED = 3
};

class ApplicationDirectoryLimits {
	private int maximumBytes;

	public ApplicationDirectoryLimits(int maximumPathBytes) { self.maximumBytes = maximumPathBytes; }

	class ApplicationDirectoryLimits standard() { return ApplicationDirectoryLimits(32768); }

	public int maximumPathBytes() { return self.maximumBytes; }
}

class ApplicationDirectoryRoots {
	private string statePath;
	private string cachePath;
	private string configPath;

	public ApplicationDirectoryRoots(string stateRoot, string cacheRoot, string configRoot) {
		if (!self.normalizedRoot(stateRoot) || !self.normalizedRoot(cacheRoot) || !self.normalizedRoot(configRoot)) { throw "application directory roots must be absolute normalized paths"; }
		self.statePath = stateRoot;
		self.cachePath = cacheRoot;
		self.configPath = configRoot;
	}

	public string stateRoot() { return self.statePath; }

	public string cacheRoot() { return self.cachePath; }

	public string configRoot() { return self.configPath; }

	private bool normalizedRoot(string path) { return path != null && !path.isEmpty() && path[0] == '/' && (path.equals("/") || path[path.len() - 1] != '/') && !path.contains("//") && !path.contains("/./") && !path.contains("/../") && !path.endsWith("/.") && !path.endsWith("/.."); }
}

class ApplicationDirectoryError {
	private ApplicationDirectoryErrorKind errorKind;
	private int platformCode;
	private string explanation;

	public ApplicationDirectoryError(ApplicationDirectoryErrorKind kind, int nativeCode, string message) {
		if (message == null || message.isEmpty() || message.len() > 512) { throw "application directory errors require a bounded message"; }
		self.errorKind = kind;
		self.platformCode = nativeCode;
		self.explanation = message;
	}

	public ApplicationDirectoryErrorKind kind() { return self.errorKind; }

	public int nativeCode() { return self.platformCode; }

	public string message() { return self.explanation; }
}

class ApplicationDirectoryRootsOutcome {
	private ApplicationDirectoryRoots? resolvedRoots;
	private ApplicationDirectoryError? resolutionError;

	private ApplicationDirectoryRootsOutcome(ApplicationDirectoryRoots? roots, ApplicationDirectoryError? error) {
		if ((roots == null) == (error == null)) { throw "invalid application directory outcome"; }
		self.resolvedRoots = roots;
		self.resolutionError = error;
	}

	class ApplicationDirectoryRootsOutcome resolved(ApplicationDirectoryRoots roots) { return ApplicationDirectoryRootsOutcome(roots, null); }

	class ApplicationDirectoryRootsOutcome rejected(ApplicationDirectoryErrorKind kind, string message) { return ApplicationDirectoryRootsOutcome(null, ApplicationDirectoryError(kind, 0, message)); }

	public bool ok() { return self.resolvedRoots != null; }

	public ApplicationDirectoryRoots roots() {
		if (self.resolvedRoots == null) { throw "rejected application directory outcome has no roots"; }
		return self.resolvedRoots;
	}

	public ApplicationDirectoryError error() {
		if (self.resolutionError == null) { throw "resolved application directory outcome has no error"; }
		return self.resolutionError;
	}
}

class ApplicationDirectoryEnvironmentValue {
	private bool valuePresent;
	private bool valueTooLong;
	private string environmentValue;

	private ApplicationDirectoryEnvironmentValue(bool present, bool tooLong, string value) {
		self.valuePresent = present;
		self.valueTooLong = tooLong;
		self.environmentValue = value;
	}

	class ApplicationDirectoryEnvironmentValue read(string name, int maximumBytes) {
		char* raw = getenv(name);
		if (raw == NULL || raw[0] == '\0') { return ApplicationDirectoryEnvironmentValue(false, false, ""); }
		int length = 0;
		while (length <= maximumBytes && raw[length] != '\0') { length++; }
		if (length > maximumBytes) { return ApplicationDirectoryEnvironmentValue(true, true, ""); }
		return ApplicationDirectoryEnvironmentValue(true, false, Strings.copy(raw));
	}

	public bool present() { return self.valuePresent; }

	public bool tooLong() { return self.valueTooLong; }

	public string value() { return self.environmentValue; }
}

class ApplicationDirectoryResolver {
	public ApplicationDirectoryResolver() {}

	private string normalizedAbsolute(string path) {
		if (path == null || path.isEmpty() || path[0] != '/') { return ""; }
		Vector<string> stack = [];
		Vector<string> segments = Strings.split(path, "/");
		for segment in segments {
			if (segment.isEmpty() || segment.equals(".")) { continue; }
			if (segment.equals("..")) {
				if (stack.len > 0) { stack.remove(stack.len - 1); }
				continue;
			}
			stack.push(segment);
		}
		StringBuilder result = StringBuilder();
		result.append("/");
		for (int index = 0; index < stack.len; index++) {
			if (index > 0) { result.append("/"); }
			result.append(stack.get(index));
		}
		return result.toString();
	}

	private bool canAppend(string base, string suffix, int maximumBytes) {
		long long separator = base.equals("/") ? 0LL : 1LL;
		long long length = (long long)base.len() + separator + (long long)suffix.len();
		return length <= (long long)maximumBytes;
	}

	private string append(string base, string suffix) { return base.equals("/") ? "/" + suffix : base + "/" + suffix; }

	private ApplicationDirectoryRootsOutcome rejected(ApplicationDirectoryErrorKind kind, string message) { return ApplicationDirectoryRootsOutcome.rejected(kind, message); }

	private ApplicationDirectoryRootsOutcome resolveMacOS(int maximumBytes) {
		ApplicationDirectoryEnvironmentValue homeValue = ApplicationDirectoryEnvironmentValue.read("HOME", maximumBytes);
		if (homeValue.tooLong()) { return self.rejected(APP_DIRECTORY_PATH_TOO_LONG, "HOME exceeds the application directory path byte limit."); }
		string home = homeValue.present() ? self.normalizedAbsolute(homeValue.value()) : "";
		if (home.isEmpty()) { return self.rejected(APP_DIRECTORY_UNAVAILABLE, "A valid absolute HOME is required to resolve macOS application directories."); }
		string support = "Library/Application Support";
		string caches = "Library/Caches";
		if (!self.canAppend(home, support, maximumBytes) || !self.canAppend(home, caches, maximumBytes)) { return self.rejected(APP_DIRECTORY_PATH_TOO_LONG, "A macOS application directory exceeds the configured path byte limit."); }
		return ApplicationDirectoryRootsOutcome.resolved(ApplicationDirectoryRoots(self.append(home, support), self.append(home, caches), self.append(home, support)));
	}

	private ApplicationDirectoryRootsOutcome resolveLinux(int maximumBytes) {
		ApplicationDirectoryEnvironmentValue stateValue = ApplicationDirectoryEnvironmentValue.read("XDG_STATE_HOME", maximumBytes);
		ApplicationDirectoryEnvironmentValue cacheValue = ApplicationDirectoryEnvironmentValue.read("XDG_CACHE_HOME", maximumBytes);
		ApplicationDirectoryEnvironmentValue configValue = ApplicationDirectoryEnvironmentValue.read("XDG_CONFIG_HOME", maximumBytes);
		if (stateValue.tooLong() || cacheValue.tooLong() || configValue.tooLong()) { return self.rejected(APP_DIRECTORY_PATH_TOO_LONG, "An XDG application directory exceeds the configured path byte limit."); }
		string state = stateValue.present() ? self.normalizedAbsolute(stateValue.value()) : "";
		string cache = cacheValue.present() ? self.normalizedAbsolute(cacheValue.value()) : "";
		string config = configValue.present() ? self.normalizedAbsolute(configValue.value()) : "";
		if (state.isEmpty() || cache.isEmpty() || config.isEmpty()) {
			ApplicationDirectoryEnvironmentValue homeValue = ApplicationDirectoryEnvironmentValue.read("HOME", maximumBytes);
			if (homeValue.tooLong()) { return self.rejected(APP_DIRECTORY_PATH_TOO_LONG, "HOME exceeds the application directory path byte limit."); }
			string home = homeValue.present() ? self.normalizedAbsolute(homeValue.value()) : "";
			if (home.isEmpty()) { return self.rejected(APP_DIRECTORY_UNAVAILABLE, "A valid absolute HOME is required when an XDG application directory is unavailable."); }
			if (state.isEmpty()) {
				if (!self.canAppend(home, ".local/state", maximumBytes)) { return self.rejected(APP_DIRECTORY_PATH_TOO_LONG, "The default XDG state directory exceeds the configured path byte limit."); }
				state = self.append(home, ".local/state");
			}
			if (cache.isEmpty()) {
				if (!self.canAppend(home, ".cache", maximumBytes)) { return self.rejected(APP_DIRECTORY_PATH_TOO_LONG, "The default XDG cache directory exceeds the configured path byte limit."); }
				cache = self.append(home, ".cache");
			}
			if (config.isEmpty()) {
				if (!self.canAppend(home, ".config", maximumBytes)) { return self.rejected(APP_DIRECTORY_PATH_TOO_LONG, "The default XDG configuration directory exceeds the configured path byte limit."); }
				config = self.append(home, ".config");
			}
		}
		return ApplicationDirectoryRootsOutcome.resolved(ApplicationDirectoryRoots(state, cache, config));
	}

	public ApplicationDirectoryRootsOutcome resolve(ApplicationDirectoryLimits limits) {
		int maximumBytes = limits.maximumPathBytes();
		if (maximumBytes <= 0 || maximumBytes > 1048576) { return self.rejected(APP_DIRECTORY_INVALID_ARGUMENT, "Application directory path limits must be between 1 and 1048576 bytes."); }
		int platform = __btrc_application_directories_platform();
		if (platform == 1) { return self.resolveMacOS(maximumBytes); }
		if (platform == 2) { return self.resolveLinux(maximumBytes); }
		return self.rejected(APP_DIRECTORY_UNSUPPORTED, "Application directories are not supported on this platform.");
	}
}

class ApplicationDirectories {
	class ApplicationDirectoryRootsOutcome resolve(ApplicationDirectoryLimits limits) { return ApplicationDirectoryResolver().resolve(limits); }

	class ApplicationDirectoryRootsOutcome resolveStandard() { return ApplicationDirectories.resolve(ApplicationDirectoryLimits.standard()); }
}
