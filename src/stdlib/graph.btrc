/* btrc standard library — graph-based execution helpers
 *
 * This module keeps the graph mechanics generic: JSON graph parsing, CLI
 * target/arg parsing, status listing, and dependency traversal. Callers keep
 * domain-specific readiness checks and node execution in their own runners.
 */

import std.cli;
import std.console;
import std.fs;
import std.json;
import std.map;
import std.strings;
import std.vector;

class GraphNode {
    public string id;
    public string specPath;
    public Vector<string> after;
    public Map<string, string> args;

    public GraphNode() {
        self.id = "";
        self.specPath = "";
        self.after = [];
        self.args = {};
    }
}

class ExecutionGraph {
    public string name;
    public string path;
    public string baseDir;
    public string workspaceRoot;
    public Vector<string> defaults;
    public Vector<GraphNode> nodes;

    public ExecutionGraph() {
        self.name = "graph";
        self.path = "";
        self.baseDir = ".";
        self.workspaceRoot = ".";
        self.defaults = [];
        self.nodes = [];
    }

    public string resolvePath(string base, string value) {
        if (value.startsWith("/")) { return value; }
        return PathTools.join(base, value);
    }

    public string resolvedWorkspaceRoot() {
        return self.resolvePath(self.baseDir, self.workspaceRoot);
    }

    public string resolvedSpecPath(GraphNode node) {
        return self.resolvePath(self.baseDir, node.specPath);
    }

    public GraphNode node(string id) {
        for item in self.nodes {
            if (item.id.equals(id)) { return item; }
        }
        Console.error("error 0:0 Unknown graph node: " + id);
        exit(1);
        return GraphNode();
    }

    public Vector<string> defaultTargets() {
        if (!self.defaults.isEmpty()) { return self.defaults; }
        Vector<string> result = [];
        for item in self.nodes {
            result.push(item.id);
        }
        return result;
    }
}

class GraphParser {
    class GraphNode node(string objectText) {
        GraphNode node = GraphNode();
        node.id = JsonText.field(objectText, "id", "");
        node.specPath = JsonText.field(objectText, "spec", "");
        node.after = JsonText.stringArray(objectText, "after");
        node.args = JsonText.argsObject(objectText);
        if (node.id.isEmpty()) {
            Console.error("error 0:0 Graph node is missing id");
            exit(1);
        }
        if (node.specPath.isEmpty()) {
            Console.error("error 0:0 Graph node " + node.id + " is missing spec");
            exit(1);
        }
        return node;
    }

    class ExecutionGraph readFile(string path) {
        string text = Path.readAll(path);
        ExecutionGraph graph = ExecutionGraph();
        graph.path = path;
        graph.baseDir = PathTools.dirname(path);
        graph.name = JsonText.field(text, "name", graph.name);
        graph.workspaceRoot = JsonText.field(text, "workspaceRoot", graph.workspaceRoot);
        graph.defaults = JsonText.stringArray(text, "default");
        for objectText in JsonText.objectArray(text, "nodes") {
            graph.nodes.push(GraphParser.node(objectText));
        }
        if (graph.nodes.isEmpty()) {
            Console.error("error 0:0 Graph has no nodes: " + path);
            exit(1);
        }
        return graph;
    }
}

class GraphCli {
    class Map<string, string> args(CliArgs args, int startIndex) {
        Map<string, string> result = {};
        for (int i = startIndex; i < args.count(); i++) {
            string value = args.get(i);
            if (value.equals("--arg")) {
                if (i + 1 >= args.count()) {
                    Console.error("error 0:0 Expected --arg key=value");
                    exit(1);
                }
                JsonText.putArgPair(result, args.get(i + 1));
                i++;
                continue;
            }
            if (value.startsWith("--arg=")) {
                JsonText.putArgPair(result, Strings.removePrefix(value, "--arg="));
            }
        }
        return result;
    }

    class Vector<string> targets(CliArgs args, int startIndex) {
        Vector<string> result = [];
        for (int i = startIndex; i < args.count(); i++) {
            string value = args.get(i);
            if (value.equals("--arg")) {
                i++;
                continue;
            }
            if (value.startsWith("--arg=")) { continue; }
            result.push(value);
        }
        return result;
    }
}

class GraphReport {
    class void list(ExecutionGraph graph) {
        for node in graph.nodes {
            string parents = node.after.isEmpty() ? "root" : node.after.join(",");
            Console.log(node.id + " <- " + parents + " :: " + graph.resolvedSpecPath(node));
        }
    }
}

class GraphTraversal {
    public ExecutionGraph graph;
    public Vector<string> done;
    public Vector<string> visiting;
    public Vector<string> ordered;
    public string error;

    public GraphTraversal(ExecutionGraph graph) {
        self.graph = graph;
        self.done = [];
        self.visiting = [];
        self.ordered = [];
        self.error = "";
    }

    public int visit(string id) {
        if (self.done.contains(id)) { return 0; }
        if (self.visiting.contains(id)) {
            self.error = "Cycle in graph at " + id;
            return 1;
        }
        self.visiting.push(id);
        GraphNode node = self.graph.node(id);
        for parent in node.after {
            int parentResult = self.visit(parent);
            if (parentResult != 0) {
                self.visiting.removeAll(id);
                return parentResult;
            }
        }
        self.done.push(id);
        self.ordered.push(id);
        self.visiting.removeAll(id);
        return 0;
    }

    public Vector<string> order(Vector<string> targets) {
        self.done = [];
        self.visiting = [];
        self.ordered = [];
        self.error = "";
        Vector<string> selected = targets.isEmpty() ? self.graph.defaultTargets() : targets;
        for id in selected {
            int result = self.visit(id);
            if (result != 0) { return self.ordered; }
        }
        return self.ordered;
    }

    public bool ok() {
        return self.error.isEmpty();
    }
}
