/* btrc standard library — CLI argument helpers */

import std.console;
import std.map;
import std.strings;
import std.vector;

class CliArgs {
    public string program;
    public Vector<string> values;

    public CliArgs(int argc, char** argv) {
        self.program = argc > 0 ? Strings.copy(argv[0]) : "";
        self.values = [];
        for (int i = 1; i < argc; i++) {
            self.values.push(Strings.copy(argv[i]));
        }
    }

    public int count() {
        return self.values.len;
    }

    public string get(int index) {
        return self.values.get(index);
    }

    public string command() {
        if (self.values.len == 0) { return ""; }
        return self.values.get(0);
    }

    public bool has(string flag) {
        for value in self.values {
            if (value.equals(flag)) { return true; }
        }
        return false;
    }

    public string valueAfter(string flag, string fallback) {
        for (int i = 0; i < self.values.len - 1; i++) {
            if (self.values.get(i).equals(flag)) {
                return self.values.get(i + 1);
            }
        }
        return fallback;
    }

    public bool commandIs(string name) {
        return self.command().equals(name);
    }

    public string valueAfterPrefix(string prefix, string fallback) {
        for value in self.values {
            if (value.startsWith(prefix)) {
                return value.substring(prefix.len(), value.len() - prefix.len());
            }
        }
        return fallback;
    }
}

class CliCommand {
    public string name;
    public Vector<string> aliases;

    public CliCommand(string name) {
        self.name = name;
        self.aliases = [];
    }

    public void alias(string name) {
        self.aliases.push(name);
    }

    public bool matches(string value) {
        if (self.name.equals(value)) { return true; }
        for alias in self.aliases {
            if (alias.equals(value)) { return true; }
        }
        return false;
    }
}

class CliCommandLine {
    public Vector<string> operands;
    public Map<string, string> options;
    public Vector<string> optionNames;
    public Vector<string> optionValues;
    public Vector<string> errors;

    public CliCommandLine() {
        self.operands = [];
        self.options = {};
        self.optionNames = [];
        self.optionValues = [];
        self.errors = [];
    }

    class CliCommandLine parse(CliArgs args) {
        return CliCommandLine.parseFrom(args, 0);
    }

    class CliCommandLine parseFrom(CliArgs args, int startIndex) {
        CliCommandLine parsed = CliCommandLine();
        bool operandsOnly = false;
        int index = startIndex;
        while (index < args.count()) {
            string value = args.get(index);
            if (operandsOnly) {
                parsed.operands.push(value);
                index++;
                continue;
            }
            if (value.equals("--")) {
                operandsOnly = true;
                index++;
                continue;
            }
            if (value.startsWith("--")) {
                int split = Strings.find(value, "=", 0);
                if (split >= 0) {
                    string name = value.substring(0, split);
                    string optionValue = value.substring(split + 1, value.len() - split - 1);
                    parsed.addOption(name, optionValue);
                    index++;
                    continue;
                }
                if (index + 1 < args.count() && !args.get(index + 1).startsWith("-")) {
                    parsed.addOption(value, args.get(index + 1));
                    index = index + 2;
                    continue;
                }
                parsed.addOption(value, "true");
                index++;
                continue;
            }
            parsed.operands.push(value);
            index++;
        }
        return parsed;
    }

    public void addOption(string name, string value) {
        self.options.put(name, value);
        self.optionNames.push(name);
        self.optionValues.push(value);
    }

    public bool ok() {
        return self.errors.len == 0;
    }

    public int operandCount() {
        return self.operands.len;
    }

    public string operand(int index, string fallback = "") {
        if (index < 0 || index >= self.operands.len) { return fallback; }
        return self.operands.get(index);
    }

    public bool has(string name) {
        return self.options.has(name);
    }

    public string option(string name, string fallback = "") {
        return self.options.getOrDefault(name, fallback);
    }

    public bool flag(string name) {
        return self.options.getOrDefault(name, "false").equals("true");
    }

    public Vector<string> values(string name) {
        Vector<string> result = [];
        for (int i = 0; i < self.optionNames.len; i++) {
            if (self.optionNames.get(i).equals(name)) {
                result.push(self.optionValues.get(i));
            }
        }
        return result;
    }
}

class CliHelp {
    public int width;
    public Vector<string> lines;

    public CliHelp() {
        self.width = 30;
        self.lines = [];
    }

    public CliHelp withWidth(int width) {
        self.width = width;
        return self;
    }

    public string padding() {
        return Strings.repeat(" ", self.width);
    }

    public CliHelp line(string text) {
        self.lines.push(text);
        return self;
    }

    public CliHelp blank() {
        self.lines.push("");
        return self;
    }

    public CliHelp section(string title) {
        self.blank();
        self.line(f"{title}:");
        return self;
    }

    public CliHelp item(string signature, string description) {
        if (signature.len() >= self.width) {
            self.line(f"  {signature}");
            if (!description.isEmpty()) {
                string indent = self.padding();
                self.line(f"{indent}{description}");
            }
            return self;
        }
        string padded = Strings.padRight(signature, self.width, ' ');
        self.line(f"  {padded}{description}");
        return self;
    }

    public CliHelp continuation(string text) {
        string indent = self.padding();
        self.line(f"{indent}{text}");
        return self;
    }

    public string render() {
        return self.lines.join("\n");
    }

    public void print() {
        Console.log(self.render());
    }
}
