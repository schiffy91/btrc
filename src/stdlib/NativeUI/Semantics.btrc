/* Backend-neutral semantic values for Library.NativeUI. */

enum NativeUISemanticRole {
	NATIVE_UI_SEMANTIC_ROLE_AUTOMATIC = 0,
	NATIVE_UI_SEMANTIC_ROLE_GROUP = 1,
	NATIVE_UI_SEMANTIC_ROLE_TEXT = 2,
	NATIVE_UI_SEMANTIC_ROLE_IMAGE = 3,
	NATIVE_UI_SEMANTIC_ROLE_BUTTON = 4,
	NATIVE_UI_SEMANTIC_ROLE_TOGGLE_BUTTON = 5,
	NATIVE_UI_SEMANTIC_ROLE_CHECKBOX = 6,
	NATIVE_UI_SEMANTIC_ROLE_TAB = 7,
	NATIVE_UI_SEMANTIC_ROLE_TAB_LIST = 8,
	NATIVE_UI_SEMANTIC_ROLE_GRID = 9,
	NATIVE_UI_SEMANTIC_ROLE_GRID_CELL = 10,
	NATIVE_UI_SEMANTIC_ROLE_LIST = 11,
	NATIVE_UI_SEMANTIC_ROLE_LIST_ITEM = 12,
	NATIVE_UI_SEMANTIC_ROLE_HEADING = 13,
	NATIVE_UI_SEMANTIC_ROLE_STATUS = 14,
	NATIVE_UI_SEMANTIC_ROLE_ALERT = 15,
	NATIVE_UI_SEMANTIC_ROLE_SLIDER = 16,
	NATIVE_UI_SEMANTIC_ROLE_TEXT_FIELD = 17,
	NATIVE_UI_SEMANTIC_ROLE_RADIO = 18,
	NATIVE_UI_SEMANTIC_ROLE_RADIO_GROUP = 19,
	NATIVE_UI_SEMANTIC_ROLE_TOOLBAR = 20,
	NATIVE_UI_SEMANTIC_ROLE_NAVIGATION = 21,
	NATIVE_UI_SEMANTIC_ROLE_MAIN = 22,
	NATIVE_UI_SEMANTIC_ROLE_SEPARATOR = 23,
	NATIVE_UI_SEMANTIC_ROLE_PROGRESS = 24,
	NATIVE_UI_SEMANTIC_ROLE_COMBO_BOX = 25
};

enum NativeUISemanticLiveMode {
	NATIVE_UI_SEMANTIC_LIVE_OFF = 0,
	NATIVE_UI_SEMANTIC_LIVE_POLITE = 1,
	NATIVE_UI_SEMANTIC_LIVE_ASSERTIVE = 2
};

enum NativeUISemanticToggleState {
	NATIVE_UI_SEMANTIC_TOGGLE_UNSET = 0,
	NATIVE_UI_SEMANTIC_TOGGLE_OFF = 1,
	NATIVE_UI_SEMANTIC_TOGGLE_ON = 2,
	NATIVE_UI_SEMANTIC_TOGGLE_MIXED = 3
};

enum NativeUISemanticExpansionState {
	NATIVE_UI_SEMANTIC_EXPANSION_UNSET = 0,
	NATIVE_UI_SEMANTIC_EXPANSION_OFF = 1,
	NATIVE_UI_SEMANTIC_EXPANSION_ON = 2
};

class NativeUISemanticText {
	class int byteAt(string value, int index) { return (int)(unsigned char)value[index]; }

	class bool continuation(int value) { return value >= 0x80 && value <= 0xBF; }

	class int scalarWidth(string value, int index) {
		if (value == null || index < 0 || index >= value.len()) { return 0; }
		int remaining = value.len() - index;
		int first = NativeUISemanticText.byteAt(value, index);
		if (first == 0) { return 0; }
		if (first <= 0x7F) { return 1; }
		if (first >= 0xC2 && first <= 0xDF && remaining >= 2 && NativeUISemanticText.continuation(NativeUISemanticText.byteAt(value, index + 1))) { return 2; }
		if (remaining >= 3) {
			int second = NativeUISemanticText.byteAt(value, index + 1);
			int third = NativeUISemanticText.byteAt(value, index + 2);
			bool validSecond = (first == 0xE0 && second >= 0xA0 && second <= 0xBF) || (first >= 0xE1 && first <= 0xEC && NativeUISemanticText.continuation(second)) || (first == 0xED && second >= 0x80 && second <= 0x9F) || (first >= 0xEE && first <= 0xEF && NativeUISemanticText.continuation(second));
			if (validSecond && NativeUISemanticText.continuation(third)) { return 3; }
		}
		if (remaining >= 4) {
			int second = NativeUISemanticText.byteAt(value, index + 1);
			int third = NativeUISemanticText.byteAt(value, index + 2);
			int fourth = NativeUISemanticText.byteAt(value, index + 3);
			bool validSecond = (first == 0xF0 && second >= 0x90 && second <= 0xBF) || (first >= 0xF1 && first <= 0xF3 && NativeUISemanticText.continuation(second)) || (first == 0xF4 && second >= 0x80 && second <= 0x8F);
			if (validSecond && NativeUISemanticText.continuation(third) && NativeUISemanticText.continuation(fourth)) { return 4; }
		}
		return 0;
	}

	class bool valid(string value, int maximumBytes) {
		if (value == null || value.len() > maximumBytes) { return false; }
		int index = 0;
		while (index < value.len()) {
			int width = NativeUISemanticText.scalarWidth(value, index);
			if (width == 0) { return false; }
			index += width;
		}
		return true;
	}
}

class NativeUISemantics {
	private NativeUISemanticRole roleValue;
	private string labelValue;
	private string hintValue;
	private string semanticValue;
	private NativeUISemanticLiveMode liveValue;
	private NativeUISemanticToggleState checkedValue;
	private NativeUISemanticToggleState pressedValue;
	private NativeUISemanticExpansionState expandedValue;
	private bool busyValue;
	private bool readOnlyValue;

	public NativeUISemantics(NativeUISemanticRole role = NATIVE_UI_SEMANTIC_ROLE_AUTOMATIC, string label = "", string hint = "", string value = "", NativeUISemanticLiveMode live = NATIVE_UI_SEMANTIC_LIVE_OFF) {
		self.roleValue = role;
		self.labelValue = label;
		self.hintValue = hint;
		self.semanticValue = value;
		self.liveValue = live;
		self.checkedValue = NATIVE_UI_SEMANTIC_TOGGLE_UNSET;
		self.pressedValue = NATIVE_UI_SEMANTIC_TOGGLE_UNSET;
		self.expandedValue = NATIVE_UI_SEMANTIC_EXPANSION_UNSET;
		self.busyValue = false;
		self.readOnlyValue = false;
	}

	public NativeUISemantics checked(NativeUISemanticToggleState state) {
		self.checkedValue = state;
		return self;
	}

	public NativeUISemantics pressed(NativeUISemanticToggleState state) {
		self.pressedValue = state;
		return self;
	}

	public NativeUISemantics expanded(NativeUISemanticExpansionState state) {
		self.expandedValue = state;
		return self;
	}

	public NativeUISemantics busy(bool value) {
		self.busyValue = value;
		return self;
	}

	public NativeUISemantics readOnly(bool value) {
		self.readOnlyValue = value;
		return self;
	}

	public NativeUISemanticRole role() { return self.roleValue; }

	public string label() { return self.labelValue; }

	public string hint() { return self.hintValue; }

	public string value() { return self.semanticValue; }

	public NativeUISemanticLiveMode live() { return self.liveValue; }

	public NativeUISemanticToggleState checkedState() { return self.checkedValue; }

	public NativeUISemanticToggleState pressedState() { return self.pressedValue; }

	public NativeUISemanticExpansionState expansionState() { return self.expandedValue; }

	public bool isBusy() { return self.busyValue; }

	public bool isReadOnly() { return self.readOnlyValue; }

	private bool validRole() { return self.roleValue >= NATIVE_UI_SEMANTIC_ROLE_AUTOMATIC && self.roleValue <= NATIVE_UI_SEMANTIC_ROLE_COMBO_BOX; }

	private bool validLive() { return self.liveValue >= NATIVE_UI_SEMANTIC_LIVE_OFF && self.liveValue <= NATIVE_UI_SEMANTIC_LIVE_ASSERTIVE; }

	private bool validToggle(NativeUISemanticToggleState state) { return state >= NATIVE_UI_SEMANTIC_TOGGLE_UNSET && state <= NATIVE_UI_SEMANTIC_TOGGLE_MIXED; }

	private bool validExpansion() { return self.expandedValue >= NATIVE_UI_SEMANTIC_EXPANSION_UNSET && self.expandedValue <= NATIVE_UI_SEMANTIC_EXPANSION_ON; }

	public bool valid() {
		if (!self.validRole() || !self.validLive() || !self.validToggle(self.checkedValue) || !self.validToggle(self.pressedValue) || !self.validExpansion()) { return false; }
		return NativeUISemanticText.valid(self.labelValue, 512) && NativeUISemanticText.valid(self.hintValue, 512) && NativeUISemanticText.valid(self.semanticValue, 512);
	}
}

class NativeUIResolvedSemantics {
	private NativeUISemanticRole roleValue;
	private string labelValue;
	private string hintValue;
	private string semanticValue;
	private NativeUISemanticLiveMode liveValue;
	private NativeUISemanticToggleState checkedValue;
	private NativeUISemanticToggleState pressedValue;
	private NativeUISemanticExpansionState expandedValue;
	private bool enabledValue;
	private bool selectedValue;
	private bool focusableValue;
	private bool focusedValue;
	private bool busyValue;
	private bool readOnlyValue;

	public NativeUIResolvedSemantics(NativeUISemanticRole role, string label, string hint, string value, NativeUISemanticLiveMode live, NativeUISemanticToggleState checked, NativeUISemanticToggleState pressed, NativeUISemanticExpansionState expanded, bool enabled, bool selected, bool focusable, bool focused, bool busy, bool readOnly) {
		self.roleValue = role;
		self.labelValue = label;
		self.hintValue = hint;
		self.semanticValue = value;
		self.liveValue = live;
		self.checkedValue = checked;
		self.pressedValue = pressed;
		self.expandedValue = expanded;
		self.enabledValue = enabled;
		self.selectedValue = selected;
		self.focusableValue = focusable;
		self.focusedValue = focused;
		self.busyValue = busy;
		self.readOnlyValue = readOnly;
	}

	public NativeUISemanticRole role() { return self.roleValue; }

	public string label() { return self.labelValue; }

	public string hint() { return self.hintValue; }

	public string value() { return self.semanticValue; }

	public NativeUISemanticLiveMode live() { return self.liveValue; }

	public NativeUISemanticToggleState checkedState() { return self.checkedValue; }

	public NativeUISemanticToggleState pressedState() { return self.pressedValue; }

	public NativeUISemanticExpansionState expansionState() { return self.expandedValue; }

	public bool enabled() { return self.enabledValue; }

	public bool selected() { return self.selectedValue; }

	public bool focusable() { return self.focusableValue; }

	public bool focused() { return self.focusedValue; }

	public bool isBusy() { return self.busyValue; }

	public bool isReadOnly() { return self.readOnlyValue; }
}
