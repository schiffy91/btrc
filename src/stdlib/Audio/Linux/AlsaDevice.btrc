/* Direct ALSA provider for Library.Audio.AudioDevice.
 *
 * PCM names stay selectable independently for input and output. Each session
 * owns one worker thread that reads capture periods, runs the realtime
 * program on interleaved selected channels and writes playback periods in
 * lock step, so both spans share one frame domain of bufferFrames. Xruns are
 * recovered in place and reported as discontinuities; a failed recovery,
 * prefill or start latches the stream's fault and ends the worker, which
 * drain() then reports. Every wait on the device is bounded, so suspend and
 * drain never hang on a stalled PCM. A provider and all its sessions belong to
 * one control thread; the provider outlives them.
 */

import Library.Audio.AudioDevice;
import Library.Audio.RealtimeAudio;
import Library.Console;
import Library.Datetime;
import Library.Math;
import Library.OwnedBuffer;
import Library.Strings;
import Library.Vector;

AudioDeviceStatus alsaStatus(int error) {
	if (error >= 0) { return AUDIO_DEVICE_OK; }
	if (error == -EINVAL) { return AUDIO_DEVICE_UNSUPPORTED_FORMAT; }
	if (error == -ENOENT || error == -ENODEV) { return AUDIO_DEVICE_NOT_FOUND; }
	if (error == -EACCES || error == -EPERM) { return AUDIO_DEVICE_PERMISSION_DENIED; }
	if (error == -EBUSY) { return AUDIO_DEVICE_BUSY; }
	if (error == -ENOMEM) { return AUDIO_DEVICE_FAILED; }
	return AUDIO_DEVICE_UNAVAILABLE;
}

/* A running stream's fault, reported by drain() after its barrier completed. */
AudioDeviceStatus alsaFaultStatus(int error) {
	if (error == -ENOENT || error == -ENODEV) { return AUDIO_DEVICE_NOT_FOUND; }
	if (error == -EACCES || error == -EPERM) { return AUDIO_DEVICE_PERMISSION_DENIED; }
	if (error == -ENOMEM) { return AUDIO_DEVICE_FAILED; }
	return AUDIO_DEVICE_UNAVAILABLE;
}

/* Probed once per inventory refresh. Descriptors carry BTRC values only. */
class AlsaHardwareDevice {
	private string _name;
	private string _description;
	private int _inputChannels;
	private int _outputChannels;
	private AudioStreamCapability _capability;

	public AlsaHardwareDevice(string name, string description, int inputChannels, int outputChannels, AudioStreamCapability capability) {
		self._name = name;
		self._description = description;
		self._inputChannels = inputChannels;
		self._outputChannels = outputChannels;
		self._capability = capability;
	}

	public string name() { return self._name; }

	public int inputChannels() { return self._inputChannels; }

	public int outputChannels() { return self._outputChannels; }

	public AudioDeviceDescriptor descriptor(bool defaultInput, bool defaultOutput) { return AudioDeviceDescriptor(self._name, self._description, self._inputChannels, self._outputChannels, defaultInput && self._inputChannels > 0, defaultOutput && self._outputChannels > 0, self._capability); }

	/* Open one direction to read what the PCM can do; null when it cannot open. */
	class AlsaProbe? probe(string name, bool capture) {
		snd_pcm_t* pcm = null;
		if (btrcAlsaOpen(name, capture ? 1 : 0, 1, &pcm) != 0 || pcm == null) { return null; }
		snd_pcm_hw_params_t* params = null;
		AlsaProbe? result = null;
		if (snd_pcm_hw_params_malloc(&params) == 0 && params != null) {
			if (snd_pcm_hw_params_any(pcm, params) >= 0) {
				unsigned int channelsMax = 0u;
				unsigned int rateMin = 0u;
				unsigned int rateMax = 0u;
				snd_pcm_uframes_t periodMin = 0UL;
				snd_pcm_uframes_t periodMax = 0UL;
				int direction = 0;
				snd_pcm_hw_params_get_channels_max(params, &channelsMax);
				snd_pcm_hw_params_get_rate_min(params, &rateMin, &direction);
				snd_pcm_hw_params_get_rate_max(params, &rateMax, &direction);
				snd_pcm_hw_params_get_period_size_min(params, &periodMin, &direction);
				snd_pcm_hw_params_get_period_size_max(params, &periodMax, &direction);
				result = AlsaProbe((int)(channelsMax > 256u ? 256u : channelsMax), (int)rateMin, (int)(rateMax > 768000u ? 768000u : rateMax), (int)(periodMin > 65536UL ? 65536UL : periodMin), (int)(periodMax > 65536UL ? 65536UL : periodMax));
			}
			snd_pcm_hw_params_free(params);
		}
		snd_pcm_close(pcm);
		return result;
	}

	class AlsaHardwareDevice? describe(string name, string description) {
		var playback = AlsaHardwareDevice.probe(name, false);
		var capture = AlsaHardwareDevice.probe(name, true);
		if (playback == null && capture == null) { return null; }
		int outputChannels = playback == null ? 0 : playback.channels;
		int inputChannels = capture == null ? 0 : capture.channels;
		if (outputChannels == 0 && inputChannels == 0) { return null; }
		var reference = playback == null ? capture : playback;
		if (reference == null) { return null; }
		return AlsaHardwareDevice(name, description, inputChannels, outputChannels, reference.capability());
	}
}

class AlsaProbe {
	public int channels;
	public int rateMin;
	public int rateMax;
	public int periodMin;
	public int periodMax;

	public AlsaProbe(int channels, int rateMin, int rateMax, int periodMin, int periodMax) {
		self.channels = channels;
		self.rateMin = rateMin;
		self.rateMax = rateMax;
		self.periodMin = periodMin;
		self.periodMax = periodMax;
	}

	public AudioStreamCapability capability() {
		int minimumRate = self.rateMin < 8000 ? 8000 : self.rateMin;
		int maximumRate = self.rateMax > 768000 ? 768000 : self.rateMax;
		int minimumPeriod = self.periodMin < 1 ? 1 : self.periodMin;
		int maximumPeriod = self.periodMax > 65536 ? 65536 : self.periodMax;
		if (minimumRate > maximumRate || minimumPeriod > maximumPeriod) { return AudioStreamCapability.unknown(); }
		int currentRate = 48000 >= minimumRate && 48000 <= maximumRate ? 48000 : (44100 >= minimumRate && 44100 <= maximumRate ? 44100 : minimumRate);
		int currentPeriod = 256 >= minimumPeriod && 256 <= maximumPeriod ? 256 : minimumPeriod;
		Vector<AudioSampleRateRange> ranges = [];
		ranges.push(AudioSampleRateRange(minimumRate, maximumRate));
		return AudioStreamCapability.available(ranges, currentRate, minimumPeriod, maximumPeriod, currentPeriod);
	}
}

/* Enumerates ALSA PCM hints, keeping the shared server entry points and the
 * per-card devices; `default` is the default in both directions. */
class AlsaHardwareInventory {
	private unsigned long long _generation = 0ULL;
	private Vector<AlsaHardwareDevice> _devices = [];
	private Vector<AudioDeviceDescriptor> _published = [];

	class bool selectable(string name) {
		if (name == "default" || name == "pipewire" || name == "pulse" || name == "jack") { return true; }
		return name.startsWith("sysdefault:") || name.startsWith("hw:") || name.startsWith("plughw:");
	}

	class string firstLine(string text) {
		int newline = text.indexOf("\n");
		return newline < 0 ? text : text.substring(0, newline);
	}

	public AlsaHardwareDevice? find(string id) {
		for device in self._devices { if (device.name() == id) { return device; } }
		return null;
	}

	/* `held` names the PCMs an open session owns. A hw: device admits one
	 * opener, so probing it would fail with EBUSY and drop it from the
	 * inventory; its last probe is reused instead. */
	public AudioDeviceInventoryOutcome refresh(Vector<string> held) {
		btrcAlsaQuietErrors();
		var hints = btrcAlsaHints();
		if (hints == null) { return AudioDeviceInventoryOutcome.failed(AUDIO_DEVICE_UNAVAILABLE, "ALSA device enumeration failed"); }
		Vector<AlsaHardwareDevice> devices = [];
		Vector<string> seen = [];
		int count = btrcAlsaHintCount(hints);
		for (int index = 0; index < count && devices.len < 256; index++) {
			var rawName = btrcAlsaHintValue(hints, index, "NAME");
			if (rawName == null) { continue; }
			string name = Strings.copy(rawName);
			btrcAlsaFreeText(rawName);
			if (name.isEmpty() || name.len() > 511 || !AlsaHardwareInventory.selectable(name) || seen.contains(name)) { continue; }
			seen.push(name);
			var cached = held.contains(name) ? self.find(name) : null;
			if (cached != null) {
				devices.push(cached);
				continue;
			}
			string description = name;
			var rawDescription = btrcAlsaHintValue(hints, index, "DESC");
			if (rawDescription != null) {
				string text = AlsaHardwareInventory.firstLine(Strings.copy(rawDescription));
				btrcAlsaFreeText(rawDescription);
				if (!text.isEmpty() && text.len() <= 511) { description = text; }
			}
			var device = AlsaHardwareDevice.describe(name, description);
			if (device != null) { devices.push(device); }
		}
		btrcAlsaHintsFree(hints);
		if (devices.isEmpty()) { return AudioDeviceInventoryOutcome.failed(AUDIO_DEVICE_UNAVAILABLE, "no ALSA PCM device could be opened"); }
		string defaultName = "";
		for device in devices { if (device.name() == "default") { defaultName = "default"; } }
		if (defaultName.isEmpty()) { for device in devices { if (device.name() == "pipewire") { defaultName = "pipewire"; } } }
		if (defaultName.isEmpty()) { defaultName = devices.get(0).name(); }
		Vector<AudioDeviceDescriptor> published = [];
		bool inputAssigned = false;
		bool outputAssigned = false;
		for device in devices {
			bool isDefault = device.name() == defaultName;
			bool defaultInput = isDefault && !inputAssigned && device.inputChannels() > 0;
			bool defaultOutput = isDefault && !outputAssigned && device.outputChannels() > 0;
			if (defaultInput) { inputAssigned = true; }
			if (defaultOutput) { outputAssigned = true; }
			published.push(device.descriptor(defaultInput, defaultOutput));
		}
		if (!inputAssigned) { for (int index = 0; index < published.len && !inputAssigned; index++) { var entry = published.get(index); if (entry.inputChannels() > 0) { published.set(index, AudioDeviceDescriptor(entry.id(), entry.name(), entry.inputChannels(), entry.outputChannels(), true, entry.isDefaultOutput(), entry.streamCapability())); inputAssigned = true; } } }
		if (!outputAssigned) { for (int index = 0; index < published.len && !outputAssigned; index++) { var entry = published.get(index); if (entry.outputChannels() > 0) { published.set(index, AudioDeviceDescriptor(entry.id(), entry.name(), entry.inputChannels(), entry.outputChannels(), entry.isDefaultInput(), true, entry.streamCapability())); outputAssigned = true; } } }
		unsigned long long generation = AudioDeviceInventory.nextGeneration(self._generation, !AudioDeviceInventory.sameDevices(published, self._published));
		if (generation == 0ULL) { return AudioDeviceInventoryOutcome.failed(AUDIO_DEVICE_FAILED, "audio device inventory generation is exhausted"); }
		self._generation = generation;
		self._devices = devices;
		self._published = published;
		return AudioDeviceInventoryOutcome.available(AudioDeviceInventory(self._generation, published));
	}
}

/* POD shared with the worker thread; the stream retains every backing buffer
 * until the worker has joined. `fault` holds a latched negative errno, negated. */
struct AlsaRenderState {
	RealtimeAudioProcess process;
	void* processContext;
	Atomic<uint>* admission;
	Atomic<uint>* stopping;
	Atomic<uint>* exited;
	Atomic<uint>* fault;
	int inputCount;
	int outputCount;
	int physicalInputCount;
	int physicalOutputCount;
	int* inputChannels;
	int* outputChannels;
	int blockFrames;
	float* physicalInput;
	float* physicalOutput;
	float* selectedInput;
	float* selectedOutput;
	unsigned long long epoch;
	unsigned long long inputFrame;
	unsigned long long outputFrame;
	snd_pcm_t* capture;
	snd_pcm_t* playback;
};

struct AlsaWorkerContext {
	AlsaStream stream;
};

int alsaWorkerRun(void* raw) {
	struct AlsaWorkerContext* context = (struct AlsaWorkerContext*)raw;
	AlsaStream stream = context->stream;
	return stream.workLoop();
}

void* alsaWorkerEntry(void* raw) {
	int result = 1;
	if (__btrc_native_thread_invoke(alsaWorkerRun, raw, &result) != 0) { return raw; }
	return result == 0 ? null : raw;
}

enum AlsaStreamState { ALSA_STREAM_READY, ALSA_STREAM_RUNNING, ALSA_STREAM_SUSPENDED, ALSA_STREAM_DRAINED, ALSA_STREAM_CLOSED, ALSA_STREAM_INDETERMINATE };

/* One duplex ALSA stream and its worker. */
class AlsaStream implements AudioSessionBackend {
	private OwnedBuffer<AlsaRenderState> _render;
	private AtomicBuffer<uint> _counters;
	private OwnedBuffer<int>? _inputChannels = null;
	private OwnedBuffer<int>? _outputChannels = null;
	private OwnedBuffer<float>? _physicalInput = null;
	private OwnedBuffer<float>? _physicalOutput = null;
	private OwnedBuffer<float>? _selectedInput = null;
	private OwnedBuffer<float>? _selectedOutput = null;
	private RealtimeAudioProgram? _program = null;
	private struct AlsaWorkerContext* _context = null;
	private pthread_t _thread;
	private bool _threadStarted = false;
	private bool _threadJoined = false;
	private AlsaStreamState _state = ALSA_STREAM_READY;
	private bool _attempted = false;
	private string _inputName = "";
	private string _outputName = "";

	public AlsaStream() {
		self._render = OwnedBuffer((size_t)1);
		self._counters = AtomicBuffer((size_t)4);
		if (self._counters.opened()) {
			var counters = self._counters.borrow();
			for (int index = 0; index < 4; index++) { counters[index].init(0u); }
		}
		if (self._render.opened() && self._counters.opened()) {
			var render = self._render.borrow();
			render->admission = self._counters.borrow();
			render->stopping = self._counters.borrow() + 1;
			render->exited = self._counters.borrow() + 2;
			render->fault = self._counters.borrow() + 3;
		}
	}

	/* The worker re-checks `stopping` at least this often while a PCM is not ready. */
	class int waitMilliseconds() { return 100; }

	/* drain() waits this long for the worker to leave the device before reporting BUSY. */
	class unsigned long long drainNanoseconds() { return 5000000000ULL; }

	/* At least `channels`, the nearest count above when the device fixes a larger one. */
	private AudioDeviceStatus configure(snd_pcm_t* pcm, int channels, int rate, int periodFrames, int* actualChannels, int* actualPeriod) {
		snd_pcm_hw_params_t* params = null;
		if (snd_pcm_hw_params_malloc(&params) != 0 || params == null) { return AUDIO_DEVICE_FAILED; }
		AudioDeviceStatus status = AUDIO_DEVICE_OK;
		int error = snd_pcm_hw_params_any(pcm, params);
		if (error >= 0) { error = btrcAlsaSetInterleavedFloat(pcm, params); }
		unsigned int minimumChannels = (unsigned int)channels;
		if (error >= 0) { error = snd_pcm_hw_params_set_channels_min(pcm, params, &minimumChannels); }
		unsigned int nearestChannels = (unsigned int)channels;
		if (error >= 0) { error = snd_pcm_hw_params_set_channels_near(pcm, params, &nearestChannels); }
		if (error >= 0) { error = snd_pcm_hw_params_set_rate(pcm, params, (unsigned int)rate, 0); }
		snd_pcm_uframes_t period = (snd_pcm_uframes_t)periodFrames;
		int direction = 0;
		if (error >= 0) { error = snd_pcm_hw_params_set_period_size_near(pcm, params, &period, &direction); }
		unsigned int periods = 2u;
		if (error >= 0) { error = snd_pcm_hw_params_set_periods_near(pcm, params, &periods, &direction); }
		if (error >= 0) { error = snd_pcm_hw_params(pcm, params); }
		if (error < 0) { status = alsaStatus(error); }
		else {
			unsigned int actual = 0u;
			snd_pcm_hw_params_get_channels(params, &actual);
			*actualChannels = (int)actual;
			*actualPeriod = (int)period;
		}
		snd_pcm_hw_params_free(params);
		if (status != AUDIO_DEVICE_OK) { return status; }
		snd_pcm_sw_params_t* software = null;
		if (snd_pcm_sw_params_malloc(&software) != 0 || software == null) { return AUDIO_DEVICE_FAILED; }
		error = snd_pcm_sw_params_current(pcm, software);
		if (error >= 0) { error = snd_pcm_sw_params_set_avail_min(pcm, software, period); }
		if (error >= 0) { error = snd_pcm_sw_params_set_start_threshold(pcm, software, period); }
		if (error >= 0) { error = snd_pcm_sw_params(pcm, software); }
		snd_pcm_sw_params_free(software);
		return error < 0 ? alsaStatus(error) : AUDIO_DEVICE_OK;
	}

	public AudioDeviceStatus prepare(AlsaHardwareDevice? input, AlsaHardwareDevice output, DuplexAudioOpenRequest request, RealtimeAudioProgram program) {
		if (self._attempted || self._state != ALSA_STREAM_READY) { return AUDIO_DEVICE_WRONG_STATE; }
		self._attempted = true;
		if (!self._render.opened() || !self._counters.opened()) { return AUDIO_DEVICE_FAILED; }
		var stream = request.stream();
		int inputCount = request.hasInput() ? request.inputChannels().count() : 0;
		int outputCount = request.outputChannels().count();
		int availableInput = input == null ? 0 : input.inputChannels();
		int availableOutput = output.outputChannels();
		if ((inputCount > 0 && availableInput <= 0) || availableOutput <= 0) { return AUDIO_DEVICE_UNSUPPORTED_FORMAT; }
		int physicalInput = inputCount > 0 ? request.inputChannels().at(inputCount - 1) + 1 : 0;
		int physicalOutput = request.outputChannels().at(outputCount - 1) + 1;
		if (physicalInput > availableInput || physicalOutput > availableOutput) { return AUDIO_DEVICE_UNSUPPORTED_FORMAT; }
		if (physicalOutput < 2 && availableOutput >= 2) { physicalOutput = 2; }
		if (physicalInput == 1 && availableInput >= 2) { physicalInput = 2; }
		self._program = program;
		var render = self._render.borrow();
		render->process = program.invokePointer();
		render->processContext = program.context();
		render->inputCount = inputCount;
		render->outputCount = outputCount;
		render->blockFrames = stream.bufferFrames();
		snd_pcm_t* playback = null;
		int error = btrcAlsaOpen(request.outputDeviceId(), 0, 0, &playback);
		if (error != 0 || playback == null) { return alsaStatus(error); }
		render->playback = playback;
		self._outputName = request.outputDeviceId();
		int actualChannels = 0;
		int actualPeriod = 0;
		var status = self.configure(playback, physicalOutput, stream.sampleRate(), stream.bufferFrames(), &actualChannels, &actualPeriod);
		if (status != AUDIO_DEVICE_OK) { return status; }
		if (actualChannels < physicalOutput || actualChannels > 256 || actualPeriod != stream.bufferFrames()) { return AUDIO_DEVICE_UNSUPPORTED_FORMAT; }
		render->physicalOutputCount = actualChannels;
		if (inputCount > 0 && input != null) {
			snd_pcm_t* capture = null;
			error = btrcAlsaOpen(request.inputDeviceId(), 1, 0, &capture);
			if (error != 0 || capture == null) { return alsaStatus(error); }
			render->capture = capture;
			self._inputName = request.inputDeviceId();
			status = self.configure(capture, physicalInput, stream.sampleRate(), stream.bufferFrames(), &actualChannels, &actualPeriod);
			if (status != AUDIO_DEVICE_OK) { return status; }
			if (actualChannels < physicalInput || actualChannels > 256 || actualPeriod != stream.bufferFrames()) { return AUDIO_DEVICE_UNSUPPORTED_FORMAT; }
			render->physicalInputCount = actualChannels;
		}
		var inputChannels = new OwnedBuffer<int>((size_t)(inputCount > 0 ? inputCount : 1));
		var outputChannels = new OwnedBuffer<int>((size_t)outputCount);
		var physicalOutputSamples = new OwnedBuffer<float>((size_t)render->blockFrames * (size_t)render->physicalOutputCount);
		var selectedOutput = new OwnedBuffer<float>((size_t)render->blockFrames * (size_t)outputCount);
		if (!inputChannels.opened() || !outputChannels.opened() || !physicalOutputSamples.opened() || !selectedOutput.opened()) { return AUDIO_DEVICE_FAILED; }
		for (int index = 0; index < inputCount; index++) { inputChannels.set((size_t)index, request.inputChannels().at(index)); }
		for (int index = 0; index < outputCount; index++) { outputChannels.set((size_t)index, request.outputChannels().at(index)); }
		self._inputChannels = inputChannels;
		self._outputChannels = outputChannels;
		self._physicalOutput = physicalOutputSamples;
		self._selectedOutput = selectedOutput;
		render->inputChannels = inputChannels.borrow();
		render->outputChannels = outputChannels.borrow();
		render->physicalOutput = physicalOutputSamples.borrow();
		render->selectedOutput = selectedOutput.borrow();
		if (inputCount > 0) {
			var physicalInputSamples = new OwnedBuffer<float>((size_t)render->blockFrames * (size_t)render->physicalInputCount);
			var selectedInput = new OwnedBuffer<float>((size_t)render->blockFrames * (size_t)inputCount);
			if (!physicalInputSamples.opened() || !selectedInput.opened()) { return AUDIO_DEVICE_FAILED; }
			self._physicalInput = physicalInputSamples;
			self._selectedInput = selectedInput;
			render->physicalInput = physicalInputSamples.borrow();
			render->selectedInput = selectedInput.borrow();
		}
		return AUDIO_DEVICE_OK;
	}

	/* The PCM names this stream still holds open. */
	public Vector<string> heldDeviceNames() {
		Vector<string> names = [];
		if (!self._render.opened()) { return names; }
		var render = self._render.borrow();
		if (render->playback != null) { names.push(self._outputName); }
		if (render->capture != null && !names.contains(self._inputName)) { names.push(self._inputName); }
		return names;
	}

	/* One block: select input channels, run the program, scatter output channels. */
	class @realtime void process(AlsaRenderState* state, int frames, unsigned long long host, uint flags) {
		int inputCount = state->inputCount;
		int outputCount = state->outputCount;
		size_t selectedInputSamples = (size_t)frames * (size_t)inputCount;
		size_t selectedOutputSamples = (size_t)frames * (size_t)outputCount;
		size_t physicalOutputSamples = (size_t)frames * (size_t)state->physicalOutputCount;
		if (inputCount > 0) { RealtimeAudioSamples.gather(Span((const float*)state->physicalInput, (size_t)frames * (size_t)state->physicalInputCount), state->physicalInputCount, Span((const int*)state->inputChannels, (size_t)inputCount), Span(state->selectedInput, selectedInputSamples), frames); }
		RealtimeAudioSamples.silence(Span(state->selectedOutput, selectedOutputSamples));
		struct AudioBlockView block = {inputCount, outputCount, frames, state->inputFrame, state->outputFrame, state->epoch, host, flags};
		state->process(state->processContext, block, Span(inputCount > 0 ? (const float*)state->selectedInput : (const float*)null, selectedInputSamples), Span(state->selectedOutput, selectedOutputSamples));
		RealtimeAudioSamples.silence(Span(state->physicalOutput, physicalOutputSamples));
		RealtimeAudioSamples.scatter(Span((const float*)state->selectedOutput, selectedOutputSamples), Span((const int*)state->outputChannels, (size_t)outputCount), Span(state->physicalOutput, physicalOutputSamples), state->physicalOutputCount, frames);
	}

	/* 1 when the PCM can transfer a period, 0 when a stop was requested first,
	 * or the PCM's negative error. */
	class int waitReady(AlsaRenderState* state, snd_pcm_t* pcm) {
		while (state->stopping->load(MemoryOrder.ACQUIRE) == 0u) {
			int ready = snd_pcm_wait(pcm, AlsaStream.waitMilliseconds());
			if (ready != 0) { return ready < 0 ? ready : 1; }
		}
		return 0;
	}

	/* Writes one playback period: 1 written, 0 stopping, or an unrecoverable error. */
	class int writePeriod(AlsaRenderState* state, uint* flags) {
		int frames = state->blockFrames;
		int ready = AlsaStream.waitReady(state, state->playback);
		if (ready == 0) { return 0; }
		snd_pcm_sframes_t written = ready < 0 ? (snd_pcm_sframes_t)ready : snd_pcm_writei(state->playback, state->physicalOutput, (snd_pcm_uframes_t)frames);
		if (written < 0L) {
			int recovered = snd_pcm_recover(state->playback, (int)written, 1);
			if (recovered < 0) { return recovered; }
			*flags |= (uint)AUDIO_BLOCK_OUTPUT_DISCONTINUITY;
		} else if ((int)written < frames) { *flags |= (uint)AUDIO_BLOCK_OUTPUT_DISCONTINUITY; }
		return 1;
	}

	/* Reads one capture period: 1 read, 0 stopping, or an unrecoverable error. */
	class int readPeriod(AlsaRenderState* state, uint* flags) {
		int frames = state->blockFrames;
		size_t physicalSamples = (size_t)frames * (size_t)state->physicalInputCount;
		int ready = AlsaStream.waitReady(state, state->capture);
		if (ready == 0) { return 0; }
		snd_pcm_sframes_t read = ready < 0 ? (snd_pcm_sframes_t)ready : snd_pcm_readi(state->capture, state->physicalInput, (snd_pcm_uframes_t)frames);
		if (read < 0L) {
			int recovered = snd_pcm_recover(state->capture, (int)read, 1);
			if (recovered < 0) { return recovered; }
			/* An overrun recovers to PREPARED, where capture never becomes ready on its
			 * own; a resumed suspend is already RUNNING and an interrupted read is
			 * unchanged, and starting either would fail with -EBADFD. */
			int restarted = btrcAlsaStartIfPrepared(state->capture);
			if (restarted < 0) { return restarted; }
			RealtimeAudioSamples.silence(Span(state->physicalInput, physicalSamples));
			*flags |= (uint)AUDIO_BLOCK_INPUT_DISCONTINUITY;
		} else if ((int)read < frames) {
			size_t kept = (size_t)read * (size_t)state->physicalInputCount;
			RealtimeAudioSamples.silence(Span(state->physicalInput + kept, physicalSamples - kept));
			*flags |= (uint)AUDIO_BLOCK_INPUT_DISCONTINUITY;
		}
		return 1;
	}

	/* Prefill, start capture, then run blocks until stopped: 0, or the fault. */
	class int run(AlsaRenderState* state) {
		int frames = state->blockFrames;
		size_t physicalOutputSamples = (size_t)frames * (size_t)state->physicalOutputCount;
		uint flags = 0u;
		RealtimeAudioSamples.silence(Span(state->physicalOutput, physicalOutputSamples));
		for (int prefill = 0; prefill < 2; prefill++) {
			int written = AlsaStream.writePeriod(state, &flags);
			if (written <= 0) { return written; }
		}
		if (state->capture != null) {
			int started = snd_pcm_start(state->capture);
			if (started < 0) { return started; }
		}
		flags = (uint)AUDIO_BLOCK_INPUT_DISCONTINUITY | (uint)AUDIO_BLOCK_OUTPUT_DISCONTINUITY;
		while (state->stopping->load(MemoryOrder.ACQUIRE) == 0u) {
			if (state->capture != null) {
				int read = AlsaStream.readPeriod(state, &flags);
				if (read <= 0) { return read; }
			}
			unsigned long long host = btrcAlsaHostNanoseconds();
			if (state->admission->load(MemoryOrder.ACQUIRE) != 0u) { AlsaStream.process(state, frames, host, flags); }
			else { RealtimeAudioSamples.silence(Span(state->physicalOutput, physicalOutputSamples)); }
			flags = 0u;
			state->inputFrame += (unsigned long long)frames;
			state->outputFrame += (unsigned long long)frames;
			int written = AlsaStream.writePeriod(state, &flags);
			if (written <= 0) { return written; }
		}
		return 0;
	}

	/* The worker: period reads and writes drive the clock. */
	public int workLoop() {
		var render = self._render.borrow();
		btrcAlsaRealtimePriority();
		int fault = AlsaStream.run(render);
		if (fault < 0) { render->fault->store((uint)(-fault), MemoryOrder.RELEASE); }
		snd_pcm_drop(render->playback);
		if (render->capture != null) { snd_pcm_drop(render->capture); }
		render->exited->store(1u, MemoryOrder.RELEASE);
		return 0;
	}

	public unsigned long long epoch() { return self._render.opened() ? self._render.borrow()->epoch : 0ULL; }

	public AudioDeviceStatus start() {
		if (self._state != ALSA_STREAM_READY || self._program == null) { return AUDIO_DEVICE_WRONG_STATE; }
		var render = self._render.borrow();
		render->epoch = btrcAlsaHostNanoseconds();
		if (render->epoch == 0ULL) { render->epoch = 1ULL; }
		render->inputFrame = 0ULL;
		render->outputFrame = 0ULL;
		render->stopping->store(0u, MemoryOrder.RELEASE);
		render->exited->store(0u, MemoryOrder.RELEASE);
		render->fault->store(0u, MemoryOrder.RELEASE);
		render->admission->store(1u, MemoryOrder.RELEASE);
		int prepared = snd_pcm_prepare(render->playback);
		if (prepared < 0) { render->admission->store(0u, MemoryOrder.RELEASE); return alsaStatus(prepared); }
		if (render->capture != null) {
			prepared = snd_pcm_prepare(render->capture);
			if (prepared < 0) { render->admission->store(0u, MemoryOrder.RELEASE); return alsaStatus(prepared); }
		}
		var context = (struct AlsaWorkerContext*)calloc(1, sizeof(struct AlsaWorkerContext));
		if (context == null) { render->admission->store(0u, MemoryOrder.RELEASE); return AUDIO_DEVICE_FAILED; }
		AlsaStream owner = self;
		keep owner;
		context->stream = owner;
		self._context = context;
		pthread_t handle = (pthread_t)0;
		if (pthread_create(&handle, null, alsaWorkerEntry, context) != 0) {
			render->admission->store(0u, MemoryOrder.RELEASE);
			release context->stream;
			free(context);
			self._context = null;
			return AUDIO_DEVICE_FAILED;
		}
		self._thread = handle;
		self._threadStarted = true;
		self._threadJoined = false;
		self._state = ALSA_STREAM_RUNNING;
		return AUDIO_DEVICE_OK;
	}

	public AudioDeviceStatus suspend() {
		if (self._state != ALSA_STREAM_RUNNING) { return AUDIO_DEVICE_WRONG_STATE; }
		var render = self._render.borrow();
		render->admission->store(0u, MemoryOrder.RELEASE);
		render->stopping->store(1u, MemoryOrder.RELEASE);
		self._state = ALSA_STREAM_SUSPENDED;
		return AUDIO_DEVICE_OK;
	}

	private AudioDeviceStatus joinWorker() {
		if (!self._threadStarted || self._threadJoined) { return AUDIO_DEVICE_OK; }
		void* result = null;
		if (pthread_join(self._thread, &result) != 0) { self._state = ALSA_STREAM_INDETERMINATE; return AUDIO_DEVICE_INDETERMINATE; }
		self._threadJoined = true;
		var context = self._context;
		if (context != null) { release context->stream; free(context); self._context = null; }
		return result == null ? AUDIO_DEVICE_OK : AUDIO_DEVICE_FAILED;
	}

	/* Waits a bounded time for the worker to leave the device, joins it, and
	 * reports any fault that ended the stream early. BUSY leaves the stream
	 * suspended for a retry. */
	public AudioDeviceStatus drain() {
		if (self._state != ALSA_STREAM_SUSPENDED) { return AUDIO_DEVICE_WRONG_STATE; }
		var render = self._render.borrow();
		if (self._threadStarted && !self._threadJoined) {
			unsigned long long started = btrcAlsaHostNanoseconds();
			while (render->exited->load(MemoryOrder.ACQUIRE) == 0u) {
				if (btrcAlsaHostNanoseconds() - started >= AlsaStream.drainNanoseconds()) { return AUDIO_DEVICE_BUSY; }
				Timer.sleepMillis(1);
			}
		}
		var joined = self.joinWorker();
		if (joined == AUDIO_DEVICE_INDETERMINATE) { return joined; }
		self._state = ALSA_STREAM_DRAINED;
		uint fault = render->fault->load(MemoryOrder.ACQUIRE);
		if (fault != 0u) { return alsaFaultStatus(-(int)fault); }
		return joined;
	}

	/* Stops then closes one PCM. A failed stop keeps the handle for a retry;
	 * alsa-lib frees the handle even when close fails, so that state is unknowable. */
	private AudioDeviceStatus releasePcm(bool capture) {
		var render = self._render.borrow();
		snd_pcm_t* pcm = capture ? render->capture : render->playback;
		if (pcm == null) { return AUDIO_DEVICE_OK; }
		if (btrcAlsaNeedsDrop(pcm) != 0) {
			int dropped = snd_pcm_drop(pcm);
			if (dropped < 0) { return dropped == -EBUSY ? AUDIO_DEVICE_BUSY : AUDIO_DEVICE_UNAVAILABLE; }
		}
		if (capture) { render->capture = null; } else { render->playback = null; }
		if (snd_pcm_close(pcm) < 0) { self._state = ALSA_STREAM_INDETERMINATE; return AUDIO_DEVICE_INDETERMINATE; }
		return AUDIO_DEVICE_OK;
	}

	public AudioDeviceStatus close() {
		if (self._state == ALSA_STREAM_CLOSED) { return AUDIO_DEVICE_OK; }
		if (self._state == ALSA_STREAM_INDETERMINATE) { return AUDIO_DEVICE_INDETERMINATE; }
		if (self._state != ALSA_STREAM_READY && self._state != ALSA_STREAM_DRAINED) { return AUDIO_DEVICE_WRONG_STATE; }
		if (self._render.opened()) {
			var released = self.releasePcm(false);
			if (released != AUDIO_DEVICE_OK) { return released; }
			released = self.releasePcm(true);
			if (released != AUDIO_DEVICE_OK) { return released; }
		}
		self._selectedOutput = null;
		self._selectedInput = null;
		self._physicalInput = null;
		self._physicalOutput = null;
		self._inputChannels = null;
		self._outputChannels = null;
		self._render.close();
		self._counters.close();
		self._program = null;
		self._state = ALSA_STREAM_CLOSED;
		return AUDIO_DEVICE_OK;
	}

	public void __del__() {
		if (self._state == ALSA_STREAM_RUNNING) { self.suspend(); }
		if (self._state == ALSA_STREAM_SUSPENDED) { self.drain(); }
		if (self.close() != AUDIO_DEVICE_OK) { Console.fatal("ALSA stream destroyed before its native cleanup completed"); }
	}
}

/* Spelled for callers that named the ALSA provider's own outcome. */
typedef AudioDeviceProviderOpenOutcome AlsaDeviceProviderOpenOutcome;

/* ALSA's half of PlatformAudioDeviceProvider. Setup changes no device setting
 * another client observes, so a prepared session reports the generation its
 * request was validated against. */
class AlsaPlatform implements AudioDevicePlatform {
	private AlsaHardwareInventory _inventory = AlsaHardwareInventory();
	private AlsaStream? _stream = null;

	public string name() { return "ALSA"; }

	public AudioDeviceInventoryOutcome inventory() { return self._inventory.refresh(self._stream != null ? self._stream.heldDeviceNames() : []); }

	public AudioSessionSetup prepare(DuplexAudioOpenRequest request, RealtimeAudioProgram program, AudioDeviceInventory inventory) {
		var output = self._inventory.find(request.outputDeviceId());
		var input = request.hasInput() ? self._inventory.find(request.inputDeviceId()) : null;
		if (output == null || (request.hasInput() && input == null)) { return AudioSessionSetup.failed(AUDIO_DEVICE_NOT_FOUND, null); }
		var stream = AlsaStream();
		self._stream = stream;
		var status = stream.prepare(input, output, request, program);
		if (status != AUDIO_DEVICE_OK) { return AudioSessionSetup.failed(status, stream); }
		return AudioSessionSetup.prepared(stream, inventory.generation());
	}
}

class AlsaDeviceProvider {
	class AudioDeviceProviderOpenOutcome open() { return PlatformAudioDeviceProvider.open(AlsaPlatform()); }
}
