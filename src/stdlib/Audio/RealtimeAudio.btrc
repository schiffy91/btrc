/* Platform-neutral, non-owning realtime audio callback contract.
 *
 * RealtimeAudioProgram is the managed object exchanged between a prepared
 * processor and an audio-device provider. The producer owns its context until
 * the provider's suspend barrier drains. Only native/provider seams extract
 * the raw pair. AudioBlockView contains clocks and dimensions by value; input
 * and output samples arrive as nonescaping interleaved Span<T> borrows whose
 * storage cannot be retained in BTRC fields, globals, returns, or aggregates.
 */

import Library.Callback;

enum AudioBlockFlags {
	AUDIO_BLOCK_CONTINUOUS = 0,
	AUDIO_BLOCK_INPUT_DISCONTINUITY = 1,
	AUDIO_BLOCK_OUTPUT_DISCONTINUITY = 2
};

struct AudioBlockView {
	int inputChannelCount;
	int outputChannelCount;
	int frameCount;
	/* Device frames identify the first input/output sample and remain monotonic
	 * within streamEpoch. An epoch change invalidates prior frame mappings; the
	 * corresponding discontinuity flag marks a non-contiguous first block. */
	unsigned long long inputDeviceFrame;
	unsigned long long outputDeviceFrame;
	unsigned long long streamEpoch;
	unsigned long long hostTimeNanoseconds;
	uint flags;
};

typedef Span<const float> RealtimeAudioInputSamples;
typedef Span<float> RealtimeAudioOutputSamples;
typedef RealtimeFunction< void, void*, struct AudioBlockView, RealtimeAudioInputSamples, RealtimeAudioOutputSamples > RealtimeAudioProcess;

class RealtimeAudioFormat {
	private int _sampleRate;
	private int _channels;

	public RealtimeAudioFormat(int sampleRate, int channels) {
		if (sampleRate <= 0 || sampleRate > 768000 || channels <= 0 || channels > 256) { throw "invalid realtime audio format"; }
		self._sampleRate = sampleRate;
		self._channels = channels;
	}

	public int sampleRate() { return self._sampleRate; }

	public int channels() { return self._channels; }

	public bool equals(RealtimeAudioFormat other) { return other != null && self._sampleRate == other._sampleRate && self._channels == other._channels; }
}

class RealtimeAudioProgram {
	private RealtimeAudioProcess _process;
	private void* _context;

	public RealtimeAudioProgram(RealtimeAudioProcess process, void* context) {
		if (process == null) {
			throw "realtime audio program requires a process callback";
		}
		self._process = process;
		self._context = context;
	}

	public RealtimeAudioProcess invokePointer() { return self._process; }

	public void* context() { return self._context; }
}

/* Allocation-free block helpers shared by providers and composing programs.
 * Blocks are interleaved: frame f of channel c is at f * channels + c. Each
 * helper checks its extents through the spans and stops at the first sample
 * that would fall outside them. */
class RealtimeAudioSamples {
	class @realtime void silence(Span<float> samples) {
		size_t count = samples.length();
		for (size_t index = 0u; index < count; index++) { samples.trySet(index, 0.0f); }
	}

	/* Copies the physical channels named by `channels` into a dense block of
	 * channels.length() channels, in that order. */
	class @realtime void gather(Span<const float> physical, int physicalChannels, Span<const int> channels, Span<float> selected, int frames) {
		size_t selectedChannels = channels.length();
		if (physicalChannels <= 0 || frames <= 0) { return; }
		size_t stride = (size_t)physicalChannels;
		size_t frameCount = (size_t)frames;
		for (size_t frame = 0u; frame < frameCount; frame++) {
			for (size_t channel = 0u; channel < selectedChannels; channel++) {
				int source = 0;
				float sample = 0.0f;
				if (!channels.tryGet(channel, &source) || source < 0 || source >= physicalChannels || !physical.tryGet(frame * stride + (size_t)source, &sample) || !selected.trySet(frame * selectedChannels + channel, sample)) { return; }
			}
		}
	}

	/* Writes a dense block of channels.length() channels into the physical
	 * channels named by `channels`; other physical channels keep their samples. */
	class @realtime void scatter(Span<const float> selected, Span<const int> channels, Span<float> physical, int physicalChannels, int frames) {
		size_t selectedChannels = channels.length();
		if (physicalChannels <= 0 || frames <= 0) { return; }
		size_t stride = (size_t)physicalChannels;
		size_t frameCount = (size_t)frames;
		for (size_t frame = 0u; frame < frameCount; frame++) {
			for (size_t channel = 0u; channel < selectedChannels; channel++) {
				int destination = 0;
				float sample = 0.0f;
				if (!channels.tryGet(channel, &destination) || destination < 0 || destination >= physicalChannels || !selected.tryGet(frame * selectedChannels + channel, &sample) || !physical.trySet(frame * stride + (size_t)destination, sample)) { return; }
			}
		}
	}
}
