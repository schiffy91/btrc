/* btrc standard library — daemon specs and capability-based Unix supervision
 * The stdlib keeps daemon intent declarative. Platform-specific service
 * managers can consume DaemonSpec without changing app code.
 */

import Library.FileSystem;
import Library.Daemon.DaemonControl;
import Library.Daemon.DaemonControlFiles;
import Library.Daemon.DaemonControlProtocol;
import Library.Process;
import Library.Vector;

class DaemonSpec {
	public string name;
	public Command command;
	public string controlFile;
	public string logFile;
	public string workingDirectory;
	public bool autoRestart;

	public DaemonSpec(string name, Command command) {
		self.name = name;
		self.command = command;
		string state = DaemonControlPaths.defaultDirectory();
		self.controlFile = PathTools.join(state, f"{name}.control");
		self.logFile = PathTools.join(state, f"{name}.log");
		self.workingDirectory = "";
		self.autoRestart = false;
	}

	public DaemonSpec control(string path) {
		self.controlFile = path;
		return self;
	}

	public DaemonSpec log(string path) {
		self.logFile = path;
		return self;
	}

	public DaemonSpec cwd(string path) {
		self.workingDirectory = path;
		return self;
	}

	public DaemonSpec restart(bool enabled) {
		self.autoRestart = enabled;
		return self;
	}

	private string supervisorScript() {
		/* Noninteractive Linux shells may accept `set -m` while leaving children
		 * in the supervisor's process group. Prefer setsid where available and
		 * wait for the new group before using it as the stop capability. */
		string setup = "token=$1; command=$2; pid_file=$3; stop_file=$4; " + "probe_prefix=$5; restart=$6; workdir=$7; " + "if [ -n \"$workdir\" ]; then cd \"$workdir\" || exit 126; fi; " + "use_setsid=0; if command -v setsid >/dev/null 2>&1; then use_setsid=1; else set -m || exit 125; fi; " + "record=$(printf 'btrc-daemon-v1\\n%s\\n%s' \"$token\" \"$$\") || exit 125; " + "if ! (set -C; umask 077; printf '%s\\n' \"$record\" > \"$pid_file\") 2>/dev/null; then exit 125; fi; ";
		string cleanup = "cleanup() { current=$(cat \"$pid_file\" 2>/dev/null) || return; " + "if [ \"$current\" = \"$record\" ]; then " + "rm -f \"$stop_file\" \"$probe_prefix\".*; rm -f \"$pid_file\"; fi; }; ";
		string capabilities = "service_probe() { for probe_file in \"$probe_prefix\".*; do " + "[ -f \"$probe_file\" ] || continue; case \"$probe_file\" in *.ack) continue ;; esac; " + "probe_value=$(cat \"$probe_file\" 2>/dev/null) || probe_value=; " + "if [ \"$probe_value\" = \"$token\" ]; then ack_file=$probe_file.ack; " + "(set -C; umask 077; printf '%s\\n' \"$token\" > \"$ack_file\") 2>/dev/null || :; fi; " + "rm -f \"$probe_file\"; done; }; " + "stop_requested() { [ -f \"$stop_file\" ] || return 1; " + "stop_value=$(cat \"$stop_file\" 2>/dev/null) || return 1; [ \"$stop_value\" = \"$token\" ]; }; ";
		/* A group member whose parent died is reparented to init and stays a
		 * zombie until init reaps it, which a container's init may do late or
		 * never. kill -0 still reaches a zombie, so a group holding only zombies
		 * has finished: group_running asks ps for a member in any other state
		 * once the reaped leader is gone, and stays conservative without ps. */
		string groups = "child_alive() { kill -0 \"-$child\" 2>/dev/null; }; " + "group_has_runner() { listing=$(ps -A -o pgid= -o stat= 2>/dev/null) || return 0; " + "[ -n \"$listing\" ] || return 0; printf '%s\\n' \"$listing\" | { " + "while read -r member_group member_state; do [ \"$member_group\" = \"$child\" ] || continue; " + "case \"$member_state\" in Z*) ;; *) exit 0 ;; esac; done; exit 1; }; }; " + "group_running() { child_alive || return 1; kill -0 \"$child\" 2>/dev/null && return 0; group_has_runner; }; ";
		string launch = "while :; do service_probe; if stop_requested; then cleanup; exit 0; fi; " + "if [ \"$use_setsid\" = 1 ]; then setsid /bin/sh -c \"$command\" & child=$!; else /bin/sh -c \"$command\" & child=$!; fi; " + "group_attempts=100; while ! child_alive && kill -0 \"$child\" 2>/dev/null && [ \"$group_attempts\" -gt 0 ]; do " + "sleep 0.01; group_attempts=$((group_attempts - 1)); done; " + "if ! child_alive && kill -0 \"$child\" 2>/dev/null; then " + "kill \"$child\" 2>/dev/null || :; wait \"$child\" 2>/dev/null || :; cleanup; exit 125; fi; ";
		string supervise = "while group_running; do service_probe; " + "if stop_requested; then kill -TERM \"-$child\" 2>/dev/null || :; " + "remaining=20; while group_running && [ \"$remaining\" -gt 0 ]; do service_probe; " + "sleep 0.05; remaining=$((remaining - 1)); done; " + "if group_running; then kill -KILL \"-$child\" 2>/dev/null || :; fi; " + "wait \"$child\" 2>/dev/null || :; while group_running; do service_probe; sleep 0.05; done; " + "cleanup; exit 0; fi; sleep 0.05; done; child_status=0; " + "wait \"$child\" || child_status=$?; service_probe; " + "if stop_requested; then cleanup; exit 0; fi; " + "if [ \"$restart\" != 1 ]; then cleanup; exit \"$child_status\"; fi; sleep 0.1; done";
		return setup + cleanup + capabilities + groups + launch + supervise;
	}

	/* This renders the controller's local supervisor for the canonical control
	 * and log paths its caller prepared; it never rewrites the spec. Platform
	 * service managers may continue to consume the declarative fields
	 * directly. A path that is not already canonical, a control record that
	 * exists, or an unsafe log renders a command that fails with 125. */
	public string renderStartCommand(string controlFile, string logFile) {
		if (!DaemonControlPaths.validDaemonName(self.name) || self.command == null || self.command.command == null || self.command.command.isEmpty()) {
			return "exit 125";
		}
		if (controlFile == null || logFile == null || controlFile.isEmpty() || logFile.isEmpty() || controlFile.equals(logFile)) {
			return "exit 125";
		}
		if (!controlFile.equals(DaemonControlFiles.canonicalFilePath(controlFile)) || !logFile.equals(DaemonControlFiles.canonicalFilePath(logFile))) {
			return "exit 125";
		}
		if (!DaemonControlFiles.absent(controlFile) || !DaemonControlFiles.safeLogPath(logFile)) {
			return "exit 125";
		}
		string token = DaemonControlProtocol.randomToken();
		if (token.isEmpty()) { return "exit 125"; }
		string stop = DaemonControlPaths.stop(controlFile, token);
		string probePrefix = DaemonControlPaths.probePrefix(controlFile, token);
		string restart = self.autoRestart ? "1" : "0";
		return "umask 077; nohup /bin/sh -c " + ShellWords.quote(self.supervisorScript()) + " btrc-daemon-supervisor " + ShellWords.quote(token) + " " + ShellWords.quote(self.command.render()) + " " + ShellWords.quote(controlFile) + " " + ShellWords.quote(stop) + " " + ShellWords.quote(probePrefix) + " " + restart + " " + ShellWords.quote(self.workingDirectory) + " </dev/null >> " + ShellWords.quote(logFile) + " 2>&1 &";
	}
}

class DaemonController {
	public UnixShell shell;

	public DaemonController() { self.shell = UnixShell(); }

	public ExecResult start(DaemonSpec spec) {
		string operation = "daemon start";
		if (!self.wellFormed(spec) || !DaemonControlFiles.prepareParent(spec.controlFile) || !DaemonControlFiles.prepareParent(spec.logFile)) {
			return self.result(125, "unsafe daemon specification", operation);
		}
		string controlFile = self.canonicalControlFile(spec);
		if (controlFile.isEmpty()) {
			return self.result(125, "unsafe daemon specification", operation);
		}
		if (!DaemonControlFiles.absent(controlFile)) {
			return self.result(1, "daemon control record already exists", operation);
		}
		string logFile = DaemonControlFiles.canonicalFilePath(spec.logFile);
		if (!DaemonControlFiles.prepareLog(logFile)) {
			return self.result(125, "unsafe daemon log file", operation);
		}
		ExecResult launched = self.shell.run(spec.renderStartCommand(controlFile, logFile), logFailure=false, timeoutMilliseconds=3000);
		if (!launched.ok()) {
			return self.result(launched.code, "failed to launch daemon supervisor", operation);
		}
		if (!DaemonControlProtocol.waitForRecord(controlFile, 2500)) {
			return self.result(125, "daemon supervisor did not publish control state", operation);
		}
		DaemonControlRecord record = DaemonControlProtocol.record(controlFile);
		if (!record.valid || !DaemonControlProtocol.probe(controlFile, record, 2500)) {
			return self.result(125, "daemon supervisor failed its liveness handshake", operation);
		}
		return self.result(0, "", operation);
	}

	private ExecResult result(int code, string message, string command) { return ExecResult(code, "", message, command); }

	/* A spec whose state directory was never created names no daemon; any
	 * other unresolvable spec is unsafe. */
	private ExecResult unresolved(DaemonSpec spec, string operation) {
		if (self.wellFormed(spec) && DaemonControlFiles.absent(PathTools.dirname(spec.controlFile))) {
			return self.result(1, "daemon supervisor is not responding", operation);
		}
		return self.result(125, "unsafe daemon specification", operation);
	}

	private bool wellFormed(DaemonSpec spec) { return spec != null && DaemonControlPaths.validDaemonName(spec.name) && spec.command != null && spec.command.command != null && !spec.command.command.isEmpty() && spec.controlFile != null && spec.logFile != null; }

	/* The canonical control-record path, or empty when the spec is unsafe.
	 * Pure: it neither creates directories nor rewrites the spec. */
	private string canonicalControlFile(DaemonSpec spec) {
		if (!self.wellFormed(spec)) { return ""; }
		string controlFile = DaemonControlFiles.canonicalFilePath(spec.controlFile);
		string logFile = DaemonControlFiles.canonicalFilePath(spec.logFile);
		if (controlFile.isEmpty() || logFile.isEmpty() || controlFile.equals(logFile)) {
			return "";
		}
		return controlFile;
	}

	public ExecResult stop(DaemonSpec spec, int timeoutMilliseconds = 7500) {
		string operation = "daemon stop";
		string controlFile = self.canonicalControlFile(spec);
		if (controlFile.isEmpty()) {
			return self.unresolved(spec, operation);
		}
		if (timeoutMilliseconds <= 0) {
			return self.result(125, "invalid daemon stop timeout", operation);
		}
		DaemonControlRecord record = DaemonControlProtocol.record(controlFile);
		if (!record.valid) {
			return self.result(1, "daemon supervisor is not responding", operation);
		}
		string stop = DaemonControlPaths.stop(controlFile, record.token);
		if (!DaemonControlFiles.absent(stop)) {
			/* An earlier stop's request is reused. The supervisor deletes it as
			 * it exits, so a request that vanished during the read is a stop
			 * already under way, not a forged one. */
			if (!DaemonControlFiles.read(stop).equals(record.token + "\n") && !DaemonControlFiles.absent(stop)) {
				return self.result(125, "unsafe daemon stop capability", operation);
			}
		} else if (!DaemonControlFiles.create(stop, record.token + "\n")) {
			return self.result(125, "failed to create daemon stop capability", operation);
		}
		if (!DaemonControlProtocol.waitForRemoval(controlFile, record, timeoutMilliseconds)) {
			return self.result(124, "daemon did not confirm termination before the deadline", operation);
		}
		return self.result(0, "", operation);
	}

	public ExecResult status(DaemonSpec spec) {
		string operation = "daemon status";
		string controlFile = self.canonicalControlFile(spec);
		if (controlFile.isEmpty()) {
			return self.unresolved(spec, operation);
		}
		DaemonControlRecord record = DaemonControlProtocol.record(controlFile);
		if (!record.valid || !DaemonControlProtocol.probe(controlFile, record, 1500)) {
			return self.result(1, "daemon supervisor is not responding", operation);
		}
		return self.result(0, "", operation);
	}
}
