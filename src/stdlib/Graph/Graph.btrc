/* btrc standard library — graph-based execution helpers
 *
 * This module keeps the graph mechanics generic: JSONValue graph parsing, CLI
 * target/arg parsing, status listing, and dependency traversal. Callers keep
 * domain-specific readiness checks and node execution in their own runners.
 */

import Library.IO;
import Library.CLI;
import Library.Console;
import Library.FileSystem;
import Library.JSON;
import Library.Map;
import Library.Set;
import Library.Vector;

class GraphNode {
	public string id;
	public string specPath;
	public Vector<string> after;
	public Map<string, string> args;

	public GraphNode() {
		self.id = "";
		self.specPath = "";
		self.after = [];
		self.args = {};
	}
}

class ExecutionGraph {
	public string name;
	public string path;
	public string baseDir;
	public string workspaceRoot;
	public Vector<string> defaults;
	public Vector<string> required;
	public Vector<GraphNode> nodes;

	public ExecutionGraph() {
		self.name = "graph";
		self.path = "";
		self.baseDir = ".";
		self.workspaceRoot = ".";
		self.defaults = [];
		self.required = [];
		self.nodes = [];
	}

	public string resolvePath(string base, string value) {
		if (value.startsWith("/")) { return value; }
		return PathTools.join(base, value);
	}

	public string resolvedWorkspaceRoot() { return self.resolvePath(self.baseDir, self.workspaceRoot); }

	public string resolvedSpecPath(GraphNode node) { return self.resolvePath(self.baseDir, node.specPath); }

	/* Looks up a node by id. Unknown ids are a DATA error (the graph came from
     * user JSON), so this throws a catchable message instead of aborting the
     * whole process. Wrap in try/catch, or pre-validate with valid() /
     * validationError() / GraphValidation.nodeIds(). */
	public GraphNode node(string id) {
		for item in self.nodes {
			if (item.id.equals(id)) { return item; }
		}
		throw f"Unknown graph node: {id}";
	}

	public bool hasNode(string id) {
		if (id == null) { return false; }
		for item in self.nodes {
			if (item.id.equals(id)) { return true; }
		}
		return false;
	}

	public Vector<string> defaultTargets() {
		if (!self.defaults.isEmpty()) { return self.defaults; }
		Vector<string> result = [];
		for item in self.nodes {
			result.push(item.id);
		}
		return result;
	}

	public string validationError() { return GraphValidation.error(self); }

	public bool valid() { return self.validationError().isEmpty(); }
}

class GraphCLI {
	/* Each --arg must be key=value with a non-empty key. A malformed pair is
	 * user input, so it throws a catchable message instead of exiting. */
	class Map<string, string> args(CLIArgs args, int startIndex) {
		Map<string, string> result = {};
		CLICommandLine parsed = CLICommandLine.parseFrom(args, startIndex);
		for value in parsed.values("--arg") {
			int split = value.find("=", 0);
			if (split <= 0) { throw f"Expected --arg key=value, got: {value}"; }
			result.put(value.substring(0, split), value.substring(split + 1, value.len() - split - 1));
		}
		return result;
	}

	class Vector<string> targets(CLIArgs args, int startIndex) {
		CLICommandLine parsed = CLICommandLine.parseFrom(args, startIndex);
		return parsed.operands;
	}
}

class GraphReport {
	class void list(ExecutionGraph graph) {
		for node in graph.nodes {
			var parents = node.after.isEmpty() ? "root" : node.after.join(",");
			Console.log(f"{node.id} <- {parents} :: {graph.resolvedSpecPath(node)}");
		}
	}
}

class GraphTraversal {
	public ExecutionGraph graph;
	public Set<string> done;
	public Set<string> visiting;
	public Vector<string> ordered;
	public string error;
	private Map<string, GraphNode> index;

	public GraphTraversal(ExecutionGraph graph) {
		self.graph = graph;
		self.done = {};
		self.visiting = {};
		self.ordered = [];
		self.error = "";
		self.index = {};
	}

	/* One id -> node index per order() or visit() call keeps traversal
	 * O(V + E). The first node with an id wins, matching ExecutionGraph.node(). */
	private void indexNodes() {
		self.index = {};
		for node in self.graph.nodes {
			if (!self.index.has(node.id)) { self.index.put(node.id, node); }
		}
	}

	/* Visits id and its dependencies against the current graph: 0, or 1 with
	 * error set. Nodes already done in this traversal are not visited again. */
	public int visit(string id) {
		self.indexNodes();
		return self.visitIndexed(id);
	}

	private int visitIndexed(string id) {
		if (id != null && self.done.contains(id)) { return 0; }
		if (id == null || !self.index.has(id)) {
			self.error = "Unknown graph node: " + (id == null ? "" : id);
			return 1;
		}

		/* Explicit DFS frames avoid overflowing the C call stack on deep
         * dependency chains. nextParent parallels stack and records which
         * dependency of each frame should be visited next. */
		Vector<string> stack = [];
		Vector<int> nextParent = [];
		stack.push(id);
		nextParent.push(0);
		self.visiting.add(id);

		while (!stack.isEmpty()) {
			int top = stack.len - 1;
			string current = stack.get(top);
			GraphNode node = self.index.get(current);
			int position = nextParent.get(top);
			if (position < node.after.len) {
				string parent = node.after.get(position);
				nextParent.set(top, position + 1);
				if (self.done.contains(parent)) { continue; }
				if (!self.index.has(parent)) {
					self.error = "Unknown graph node: " + parent;
					return 1;
				}
				if (self.visiting.contains(parent)) {
					self.error = "Cycle in graph at " + parent;
					return 1;
				}
				self.visiting.add(parent);
				stack.push(parent);
				nextParent.push(0);
				continue;
			}

			self.done.add(current);
			self.ordered.push(current);
			self.visiting.remove(current);
			stack.pop();
			nextParent.pop();
		}
		return 0;
	}

	public Vector<string> order(Vector<string> targets) {
		self.done = {};
		self.visiting = {};
		self.ordered = [];
		self.error = "";
		self.indexNodes();
		Vector<string> selected = targets.isEmpty() ? self.graph.defaultTargets() : targets;
		for id in selected {
			int result = self.visitIndexed(id);
			if (result != 0) { return self.ordered; }
		}
		return self.ordered;
	}

	public bool ok() { return self.error.isEmpty(); }
}

class GraphValidation {
	class Vector<string> nodeIds(ExecutionGraph graph) {
		Vector<string> result = [];
		for node in graph.nodes {
			result.push(node.id);
		}
		return result;
	}

	class string error(ExecutionGraph graph) {
		if (graph.nodes.isEmpty()) {
			return f"Graph has no nodes: {graph.path}";
		}
		Set<string> seen = {};
		for node in graph.nodes {
			if (node.id.isEmpty()) { return "Graph node is missing id"; }
			if (node.specPath.isEmpty()) { return f"Graph node {node.id} is missing spec"; }
			if (seen.contains(node.id)) { return f"Duplicate graph node id: {node.id}"; }
			seen.add(node.id);
		}
		for node in graph.nodes {
			for parent in node.after {
				if (!seen.contains(parent)) {
					return f"Graph node {node.id} depends on missing node: {parent}";
				}
			}
		}
		for target in graph.defaults {
			if (!seen.contains(target)) { return f"Graph default target is missing: {target}"; }
		}
		for target in graph.required {
			if (!seen.contains(target)) { return f"Graph required target is missing: {target}"; }
		}

		var traversal = GraphTraversal(graph);
		traversal.order(GraphValidation.nodeIds(graph));
		if (!traversal.ok()) { return traversal.error; }
		return "";
	}
}

class GraphParser {
	class string stringField(JSONValue object, string key, string fallback) {
		JSONValue value = object.get(key);
		if (value.isNull()) { return fallback; }
		if (!value.isString()) { throw f"Graph field {key} must be a string"; }
		return value.asString();
	}

	class Vector<string> stringArray(JSONValue object, string key) {
		Vector<string> result = [];
		JSONValue value = object.get(key);
		if (value.isNull()) { return result; }
		if (!value.isArray()) { throw f"Graph field {key} must be an array of strings"; }
		for (int i = 0; i < value.size(); i++) {
			JSONValue item = value.at(i);
			if (!item.isString()) { throw f"Graph field {key} must be an array of strings"; }
			result.push(item.asString());
		}
		return result;
	}

	/* args values are template text: strings are used as decoded, and any
	 * other JSON value as its compact JSON text. */
	class Map<string, string> args(JSONValue object) {
		Map<string, string> result = {};
		JSONValue value = object.get("args");
		if (value.isNull()) { return result; }
		if (!value.isObject()) { throw "Graph field args must be an object"; }
		for key in value.keys() {
			JSONValue item = value.get(key);
			result.put(key, item.isString() ? item.asString() : item.stringify());
		}
		return result;
	}

	class GraphNode node(JSONValue object) {
		if (!object.isObject()) { throw "Graph node must be an object"; }
		var node = GraphNode();
		node.id = GraphParser.stringField(object, "id", "");
		node.specPath = GraphParser.stringField(object, "spec", "");
		node.after = GraphParser.stringArray(object, "after");
		node.args = GraphParser.args(object);
		/* Missing id/spec is a DATA error in the source JSON, not an internal
         * invariant — throw a catchable message instead of aborting. (readFile
         * also surfaces these via the recoverable validationError() path.) */
		if (node.id.isEmpty()) {
			throw "Graph node is missing id";
		}
		if (node.specPath.isEmpty()) {
			throw f"Graph node {node.id} is missing spec";
		}
		return node;
	}

	class ExecutionGraph parse(string text, string path) {
		JSONValue document = JSONValue.parse(text);
		if (document.isError()) { throw f"Graph file is not valid JSON: {path}"; }
		if (!document.isObject()) { throw f"Graph file must hold a JSON object: {path}"; }
		var graph = ExecutionGraph();
		graph.path = path;
		graph.baseDir = PathTools.dirname(path);
		graph.name = GraphParser.stringField(document, "name", graph.name);
		graph.workspaceRoot = GraphParser.stringField(document, "workspaceRoot", graph.workspaceRoot);
		graph.defaults = GraphParser.stringArray(document, "default");
		graph.required = GraphParser.stringArray(document, "required");
		JSONValue nodes = document.get("nodes");
		if (!nodes.isNull() && !nodes.isArray()) { throw "Graph field nodes must be an array"; }
		for (int i = 0; i < nodes.size(); i++) {
			graph.nodes.push(GraphParser.node(nodes.at(i)));
		}
		/* Validation failures are DATA errors (bad graph JSON), so throw a
         * catchable message rather than aborting the process. Callers that want
         * to inspect without throwing can build the graph and call
         * validationError() / valid() directly. */
		var error = graph.validationError();
		if (!error.isEmpty()) {
			throw error;
		}
		return graph;
	}

	/* An unreadable file is an I/O error, reported as such rather than as an
	 * empty graph. */
	class ExecutionGraph readFile(string path) {
		var file = File(path, "r");
		if (!file.ok()) { throw f"Cannot open graph file: {path}"; }
		string text = file.read();
		bool closed = file.close();
		if (file.failed() || !closed) { throw f"Cannot read graph file: {path}"; }
		return GraphParser.parse(text, path);
	}
}
