/* Forked worker processes behind the IWorkerPool contract: the linux and
 * macOS provider of HostWorkerPools.
 *
 * Each worker is a fork of the owner taken when the pool opens, so it starts
 * with everything the owner had built, shared copy-on-write. Owner and worker
 * talk over one AF_UNIX stream socket pair; a frame is 16 lowercase hex digits
 * giving the payload length, then the payload. A worker answers one request at
 * a time and the owner sends only to idle workers, reading every reply whole,
 * so neither side can block the other on a full socket. Every frame is written
 * with send(MSG_NOSIGNAL), so a peer that died surfaces as a failed write or an
 * end of input on either side without touching the process's SIGPIPE
 * disposition. Workers leave through _exit, so they never run the owner's exit
 * handlers or flush its stdio buffers a second time. */
import Library.BackgroundJobs.WorkerPools;
import Library.Bytes;
import Library.Vector;

#include <errno.h>
#include <poll.h>
#include <signal.h>
#include <stdio.h>
#include <sys/socket.h>
#include <sys/wait.h>
#include <unistd.h>

/* One decoded frame, or the reason there is none. */
class ProcessWorkerFrame {
	public bool complete;
	public string payload;
	public string error;

	public ProcessWorkerFrame(bool complete, string payload, string error) {
		self.complete = complete;
		self.payload = payload;
		self.error = error;
	}
}

/* Frame encoding shared by the owner and its workers. */
class ProcessWorkerFrames {
	class string header(int length) {
		string digits = "0123456789abcdef";
		string text = "";
		int value = length;
		for (int index = 0; index < 16; index++) {
			text = digits.substring(value % 16, 1) + text;
			value = value / 16;
		}
		return text;
	}

	/* The payload length of the frame starting `buffer`: -1 while the header
	 * is incomplete, -2 when it is malformed. */
	class int payloadLength(Bytes buffer) {
		if (buffer.len < 16) { return -1; }
		long long value = 0LL;
		for (int index = 0; index < 16; index++) {
			int c = buffer.get(index);
			int digit = -1;
			if (c >= '0' && c <= '9') { digit = c - '0'; }
			else if (c >= 'a' && c <= 'f') { digit = c - 'a' + 10; }
			if (digit < 0) { return -2; }
			value = value * 16LL + (long long)digit;
			if (value > 2147483000LL) { return -2; }
		}
		return (int)value;
	}

	/* The complete frame at the start of `buffer`, consuming it; null when
	 * more bytes are needed. A malformed or oversized frame is an error. */
	class ProcessWorkerFrame? take(Bytes buffer) {
		int length = ProcessWorkerFrames.payloadLength(buffer);
		if (length == -2) { return ProcessWorkerFrame(false, "", "malformed worker frame"); }
		if (length < 0 || buffer.len < 16 + length) { return null; }
		if (buffer.len != 16 + length) { return ProcessWorkerFrame(false, "", "unexpected bytes after a worker frame"); }
		Bytes payload = buffer.slice(16, 16 + length);
		string text = payload.toStringLossy();
		buffer.len = 0;
		return ProcessWorkerFrame(true, text, "");
	}

	/* Write one whole frame; false if the socket failed or its peer is gone. */
	class bool writeFrame(int descriptor, string payload) {
		string framed = ProcessWorkerFrames.header(payload.length()) + payload;
		int total = framed.length();
		int offset = 0;
		while (offset < total) {
			ssize_t written = send(descriptor, (char*)framed + offset, (size_t)(total - offset), MSG_NOSIGNAL);
			if (written < (ssize_t)0) {
				if (errno == EINTR) { continue; }
				return false;
			}
			offset = offset + (int)written;
		}
		return true;
	}

	/* Append what a readable descriptor offers: the byte count, 0 at end of
	 * input, or -1 on failure. */
	class int readInto(int descriptor, Bytes buffer) {
		char chunk[65536];
		while (true) {
			ssize_t count = read(descriptor, chunk, 65536);
			if (count < (ssize_t)0 && errno == EINTR) { continue; }
			if (count < (ssize_t)0) { return -1; }
			if (count > (ssize_t)0) { buffer.appendRaw(chunk, (int)count); }
			return (int)count;
		}
		return -1;
	}
}

/* The owner's record of one worker. */
class ProcessWorkerState {
	public pid_t pid;
	/* The owner's end of the worker's socket pair. */
	public int channel;
	public bool busy = false;
	public bool reaped = false;
	public bool requestsClosed = false;
	public string exit = "";
	public Bytes buffer = Bytes();

	public ProcessWorkerState(pid_t pid, int channel) {
		self.pid = pid;
		self.channel = channel;
	}

	/* End of input for the worker: it finishes and exits. */
	public void closeRequests() {
		if (self.channel >= 0 && !self.requestsClosed) {
			shutdown(self.channel, SHUT_WR);
			self.requestsClosed = true;
		}
	}

	public void closeChannel() {
		if (self.channel >= 0) {
			close(self.channel);
			self.channel = -1;
		}
	}

	/* The one wait for this worker: reaps it once and records how it ended.
	 * True when it exited with status 0. */
	private bool waitStatus() {
		if (self.reaped) { return self.exit.isEmpty(); }
		int status = 0;
		while (true) {
			pid_t waited = waitpid(self.pid, &status, 0);
			if (waited == self.pid) { break; }
			if (waited < (pid_t)0 && errno == EINTR) { continue; }
			self.reaped = true;
			self.exit = "worker could not be reaped";
			return false;
		}
		self.reaped = true;
		if (WIFEXITED(status) && WEXITSTATUS(status) == 0) { return true; }
		if (WIFEXITED(status)) { self.exit = f"worker exited with status {WEXITSTATUS(status)}"; }
		else if (WIFSIGNALED(status)) { self.exit = f"worker killed by signal {WTERMSIG(status)}"; }
		else { self.exit = "worker ended abnormally"; }
		return false;
	}

	/* Wait for the worker to exit; true when it exited with status 0. */
	public bool reap() { return self.waitStatus(); }

	/* How the worker ended, for a failure message; reaps it. */
	public string describeExit() {
		if (self.waitStatus()) { return "worker ended"; }
		return self.exit;
	}
}

class ForkedWorkerPool implements IWorkerPool {
	private Vector<ProcessWorkerState> workers = [];
	private bool failed = false;
	private bool closed = false;

	public ForkedWorkerPool() {}

	/* Fork `count` workers running `handler`; null if any could not start. */
	class ForkedWorkerPool? start(int count, IWorkerRequestHandler handler) {
		if (count < 1 || count > 64) { return null; }
		ForkedWorkerPool pool = ForkedWorkerPool();
		/* Buffered output would otherwise be written once by each process. */
		fflush(stdout);
		fflush(stderr);
		for (int index = 0; index < count; index++) {
			int channel[2];
			channel[0] = -1;
			channel[1] = -1;
			if (socketpair((int)AF_UNIX, (int)SOCK_STREAM, 0, channel) != 0) {
				pool.terminate();
				return null;
			}
			pid_t child = fork();
			if (child < (pid_t)0) {
				close(channel[0]);
				close(channel[1]);
				pool.terminate();
				return null;
			}
			if (child == (pid_t)0) {
				close(channel[0]);
				/* Earlier workers' owner-side ends: holding them open would keep
				 * those workers from ever seeing their end of input. */
				for earlier in pool.workers { earlier.closeChannel(); }
				ForkedWorkerPool.serve(channel[1], handler);
			}
			close(channel[1]);
			pool.workers.push(ProcessWorkerState(child, channel[0]));
		}
		return pool;
	}

	/* A worker's whole life: answer frames until end of input. */
	class void serve(int channel, IWorkerRequestHandler handler) {
		Bytes buffer = Bytes();
		while (true) {
			ProcessWorkerFrame? frame = ProcessWorkerFrames.take(buffer);
			if (frame == null) {
				int count = ProcessWorkerFrames.readInto(channel, buffer);
				if (count == 0 && buffer.len == 0) {
					fflush(stdout);
					fflush(stderr);
					_exit(0);
				}
				if (count <= 0) { _exit(70); }
				continue;
			}
			if (!frame.complete) { _exit(71); }
			string reply = "";
			try { reply = handler.handle(frame.payload); }
			catch (string error) {
				fprintf(stderr, "worker request failed: %s\n", error);
				fflush(stderr);
				_exit(72);
			}
			if (!ProcessWorkerFrames.writeFrame(channel, reply)) { _exit(73); }
		}
	}

	public int size() { return self.workers.len; }

	public bool idle(int worker) { return worker >= 0 && worker < self.workers.len && !self.failed && !self.closed && !self.workers.get(worker).busy; }

	public bool send(int worker, string request) {
		if (!self.idle(worker)) { return false; }
		ProcessWorkerState state = self.workers.get(worker);
		state.busy = true;
		if (!ProcessWorkerFrames.writeFrame(state.channel, request)) {
			self.fail();
			return false;
		}
		return true;
	}

	public WorkerReply awaitReply(int timeoutMilliseconds = -1) {
		if (self.failed || self.closed) { return WorkerReply(WorkerReplyKind.WORKER_REPLY_FAILED, -1, "", "worker pool is not open"); }
		while (true) {
			struct pollfd ready[64];
			int watched[64];
			int count = 0;
			for (int index = 0; index < self.workers.len; index++) {
				ProcessWorkerState state = self.workers.get(index);
				if (!state.busy) { continue; }
				ready[count].fd = state.channel;
				ready[count].events = POLLIN;
				ready[count].revents = 0;
				watched[count] = index;
				count = count + 1;
			}
			if (count == 0) { return WorkerReply(WorkerReplyKind.WORKER_REPLY_EMPTY, -1, "", ""); }
			/* An interrupted wait restarts with the whole timeout: the bound is
			 * on quiet time, which suits a caller deciding a worker is stuck. */
			int polled = poll(ready, (nfds_t)count, timeoutMilliseconds < 0 ? -1 : timeoutMilliseconds);
			if (polled < 0) {
				if (errno == EINTR) { continue; }
				self.fail();
				return WorkerReply(WorkerReplyKind.WORKER_REPLY_FAILED, -1, "", "polling workers failed");
			}
			if (polled == 0) { return WorkerReply(WorkerReplyKind.WORKER_REPLY_TIMEOUT, -1, "", "no worker replied before the timeout"); }
			for (int slot = 0; slot < count; slot++) {
				if (ready[slot].revents == 0) { continue; }
				int index = watched[slot];
				ProcessWorkerState state = self.workers.get(index);
				int received = ProcessWorkerFrames.readInto(state.channel, state.buffer);
				if (received <= 0) {
					string reason = received == 0 ? state.describeExit() : "reading a worker reply failed";
					self.fail();
					return WorkerReply(WorkerReplyKind.WORKER_REPLY_FAILED, index, "", reason);
				}
				ProcessWorkerFrame? frame = ProcessWorkerFrames.take(state.buffer);
				if (frame == null) { continue; }
				if (!frame.complete) {
					self.fail();
					return WorkerReply(WorkerReplyKind.WORKER_REPLY_FAILED, index, "", frame.error);
				}
				state.busy = false;
				return WorkerReply(WorkerReplyKind.WORKER_REPLY_READY, index, frame.payload, "");
			}
		}
		return WorkerReply(WorkerReplyKind.WORKER_REPLY_FAILED, -1, "", "unreachable");
	}

	public bool close() {
		if (self.closed) { return !self.failed; }
		for state in self.workers {
			if (state.busy) {
				self.fail();
				return false;
			}
		}
		self.closed = true;
		bool clean = true;
		for state in self.workers { state.closeRequests(); }
		for state in self.workers {
			if (!state.reap()) { clean = false; }
			state.closeChannel();
		}
		return clean;
	}

	public void terminate() {
		for state in self.workers {
			if (!state.reaped) { kill(state.pid, SIGKILL); }
		}
		for state in self.workers {
			state.closeChannel();
			state.reap();
		}
		self.closed = true;
	}

	private void fail() {
		self.failed = true;
		self.terminate();
	}
}

/* HostWorkerPools' linux and macOS provider: pools of forked workers. */
class WorkerPoolProvider {
	class IWorkerPool? open(int workers, IWorkerRequestHandler handler) {
		ForkedWorkerPool? pool = ForkedWorkerPool.start(workers, handler);
		if (pool == null) { return null; }
		return pool;
	}

	/* One worker per online CPU, at most four: past four, measured compiles
	 * gained little and each worker adds its own memory. */
	class int suggestedWorkers() {
		long online = sysconf(_SC_NPROCESSORS_ONLN);
		if (online < 1L) { return 1; }
		return online > 4L ? 4 : (int)online;
	}
}
