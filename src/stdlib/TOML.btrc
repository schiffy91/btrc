/* btrc standard library — small TOML helpers.
 * Covers common app config shapes: sections, arrays of tables, and quoted
 * scalar key/value fields. Full TOML type coverage can grow here over time.
 */

import Library.Map;
import Library.Strings;
import Library.Vector;

class TOML {
	class int unquotedPosition(string line, char target) {
		if (line == null) { return -1; }
		bool inString = false;
		bool escaped = false;
		char quote = (char)0;
		int length = line.len();
		for (int i = 0; i < length; i++) {
			char c = line[i];
			if (inString) {
				if (quote == (char)39) {
					if (c == quote) { inString = false; }
					continue;
				}
				if (!escaped && c == quote) { inString = false; }
				escaped = !escaped && c == '\\';
				if (c != '\\') { escaped = false; }
				continue;
			}
			if (c == (char)34 || c == (char)39) {
				inString = true;
				escaped = false;
				quote = c;
				continue;
			}
			if (c == target) { return i; }
		}
		return -1;
	}

	class string stripInlineComment(string raw) {
		if (raw == null) { return ""; }
		int comment = TOML.unquotedPosition(raw, '#');
		if (comment >= 0) { return raw.substring(0, comment).trim(); }
		if (TOML.isTrimmed(raw)) { return raw; }
		return raw.trim();
	}

	/* A line with no surrounding whitespace is its own trimmed form; the
	 * parsers below strip each line once and then re-examine it many times. */
	class bool isTrimmed(string raw) {
		int length = raw.len();
		if (length == 0) { return true; }
		return !TOML.isSpace(raw[0]) && !TOML.isSpace(raw[length - 1]);
	}

	class bool isSpace(char c) { return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == (char)11 || c == (char)12; }

	class string unquote(string raw) {
		string value = raw.trim();
		if (value.startsWith("\"") && value.endsWith("\"") && value.len() >= 2) {
			return TOML.unescapeBasic(value.substring(1, value.len() - 2));
		}
		if (value.startsWith("'") && value.endsWith("'") && value.len() >= 2) {
			return value.substring(1, value.len() - 2);
		}
		return value;
	}

	/* Decode the body of a TOML basic string. Recognized escapes are \b \t
	 * \n \f \r \" \\ \uXXXX and \UXXXXXXXX; a literal tab is allowed, and any
	 * other escape, control character, surrogate or NUL is a format error. */
	class string unescapeBasic(string body) {
		StringBuilder output = StringBuilder();
		int length = body.len();
		int i = 0;
		while (i < length) {
			char c = body[i];
			if (c != '\\') {
				/* Unsigned, so a byte at or above 0x80 (UTF-8) is never a control
				 * character, wherever plain char is signed or unsigned. */
				int code = (int)(unsigned char)c;
				if ((code < 0x20 && c != '\t') || code == 0x7f) {
					throw "TOML basic string contains a control character";
				}
				output.appendChar(c);
				i++;
				continue;
			}
			if (i + 1 >= length) { throw "TOML basic string ends inside an escape"; }
			char escape = body[i + 1];
			i = i + 2;
			if (escape == 'b') { output.appendChar((char)8); }
			else if (escape == 't') { output.appendChar('\t'); }
			else if (escape == 'n') { output.appendChar('\n'); }
			else if (escape == 'f') { output.appendChar((char)12); }
			else if (escape == 'r') { output.appendChar('\r'); }
			else if (escape == '"') { output.appendChar('"'); }
			else if (escape == '\\') { output.appendChar('\\'); }
			else if (escape == 'u' || escape == 'U') {
				int digits = escape == 'u' ? 4 : 8;
				if (i + digits > length) { throw "TOML unicode escape is truncated"; }
				int codePoint = 0;
				for (int index = 0; index < digits; index++) {
					int digit = TOML.hexDigit(body[i + index]);
					if (digit < 0) { throw "TOML unicode escape has a non-hex digit"; }
					if (codePoint > 0x10FFFF) { throw "TOML unicode escape is not a Unicode scalar value"; }
					codePoint = codePoint * 16 + digit;
				}
				i = i + digits;
				TOML.appendUtf8(output, codePoint);
			} else {
				throw f"TOML basic string has an invalid escape: \\{escape}";
			}
		}
		return output.toString();
	}

	class int hexDigit(char c) {
		if (c >= '0' && c <= '9') { return c - '0'; }
		if (c >= 'a' && c <= 'f') { return c - 'a' + 10; }
		if (c >= 'A' && c <= 'F') { return c - 'A' + 10; }
		return -1;
	}

	class void appendUtf8(StringBuilder output, int codePoint) {
		if (codePoint <= 0 || codePoint > 0x10FFFF || (codePoint >= 0xD800 && codePoint <= 0xDFFF)) {
			throw "TOML unicode escape is not a non-NUL Unicode scalar value";
		}
		if (codePoint < 0x80) {
			output.appendChar((char)codePoint);
		} else if (codePoint < 0x800) {
			output.appendChar((char)(0xC0 | (codePoint >> 6)));
			output.appendChar((char)(0x80 | (codePoint & 0x3F)));
		} else if (codePoint < 0x10000) {
			output.appendChar((char)(0xE0 | (codePoint >> 12)));
			output.appendChar((char)(0x80 | ((codePoint >> 6) & 0x3F)));
			output.appendChar((char)(0x80 | (codePoint & 0x3F)));
		} else {
			output.appendChar((char)(0xF0 | (codePoint >> 18)));
			output.appendChar((char)(0x80 | ((codePoint >> 12) & 0x3F)));
			output.appendChar((char)(0x80 | ((codePoint >> 6) & 0x3F)));
			output.appendChar((char)(0x80 | (codePoint & 0x3F)));
		}
	}

	class string key(string line) {
		string cleaned = TOML.stripInlineComment(line);
		int pos = TOML.unquotedPosition(cleaned, '=');
		if (pos < 0) { return ""; }
		return TOML.unquote(cleaned.substring(0, pos).trim());
	}

	class string value(string line) {
		string cleaned = TOML.stripInlineComment(line);
		int pos = TOML.unquotedPosition(cleaned, '=');
		if (pos < 0) { return ""; }
		return TOML.unquote(cleaned.substring(pos + 1, cleaned.len() - pos - 1).trim());
	}

	class string sectionName(string line) {
		string cleaned = TOML.stripInlineComment(line);
		if (!cleaned.startsWith("[") || !cleaned.endsWith("]")) { return ""; }
		if (cleaned.startsWith("[[")) { return ""; }
		return cleaned.substring(1, cleaned.len() - 2).trim();
	}

	class string tableArrayName(string line) {
		string cleaned = TOML.stripInlineComment(line);
		if (!cleaned.startsWith("[[") || !cleaned.endsWith("]]")) { return ""; }
		return cleaned.substring(2, cleaned.len() - 4).trim();
	}

	class Map<string, string> rootMap(string content) {
		Map<string, string> result = {};
		for line in Strings.split(content, "\n") {
			string trimmed = line.trim();
			if (!TOML.sectionName(trimmed).isEmpty() || !TOML.tableArrayName(trimmed).isEmpty()) { break; }
			string field = TOML.key(trimmed);
			if (!field.isEmpty()) { result.put(field, TOML.value(trimmed)); }
		}
		return result;
	}

	/* Every key/value line inside [section] collected into a map. Scanning stops
     * at the next [section] or [[array-of-tables]] header. Missing keys are
     * simply absent — read them with map.getOrDefault(key, fallback). */
	class Map<string, string> sectionMap(string content, string section) {
		Map<string, string> result = {};
		bool inSection = false;
		for line in Strings.split(content, "\n") {
			string trimmed = line.trim();
			string name = TOML.sectionName(trimmed);
			if (name.equals(section)) { inSection = true; continue; }
			if (!name.isEmpty() || !TOML.tableArrayName(trimmed).isEmpty()) { inSection = false; continue; }
			if (!inSection) { continue; }
			string field = TOML.key(trimmed);
			if (!field.isEmpty()) { result.put(field, TOML.value(trimmed)); }
		}
		return result;
	}

	/* Each [[table]] occurrence as one key/value map, in document order. A fresh
     * [[table]] header, any [section], or a different [[array-of-tables]] closes
     * the current block. Empty blocks are kept; the caller decides what counts. */
	class Vector<Map<string, string>> tableArrayBlocks(string content, string table) {
		Vector<Map<string, string>> blocks = [];
		Map<string, string> current = {};
		bool inTable = false;
		for line in Strings.split(content, "\n") {
			string trimmed = line.trim();
			string name = TOML.tableArrayName(trimmed);
			if (name.equals(table)) {
				if (inTable) { blocks.push(current); }
				current = {};
				inTable = true;
				continue;
			}
			if (!TOML.sectionName(trimmed).isEmpty() || !name.isEmpty()) {
				if (inTable) { blocks.push(current); }
				inTable = false;
				continue;
			}
			if (!inTable) { continue; }
			string field = TOML.key(trimmed);
			if (!field.isEmpty()) { current.put(field, TOML.value(trimmed)); }
		}
		if (inTable) { blocks.push(current); }
		return blocks;
	}
}
