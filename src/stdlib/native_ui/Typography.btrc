/* Bounded typography contract shared by native UI layout and presenters.
 *
 * The deterministic provider keeps proof rasters and tests platform-neutral.
 * Platform providers can implement this same session-owned contract without
 * introducing ambient font state or changing application element trees.
 */

enum NativeUiTextAlignment {
	NATIVE_UI_TEXT_ALIGN_LEFT = 0,
	NATIVE_UI_TEXT_ALIGN_CENTER = 1,
	NATIVE_UI_TEXT_ALIGN_RIGHT = 2
};

/* How a row places children shorter than itself: `align-items`. */
enum NativeUiCrossAlignment {
	NATIVE_UI_ALIGN_START = 0,
	NATIVE_UI_ALIGN_CENTER = 1,
	NATIVE_UI_ALIGN_END = 2
};

typedef CFunction<int, unsigned long long, string, int, int, int, int*, int*, int*, int*, int*> NativeUiTypographyMeasure;

/* Platform raster of one text run: provider, text, fontSize, lineHeight,
 * fontWeight, backingScale, widthOut, heightOut, pixelsOut (tightly packed
 * RGBA8, white glyphs with straight-alpha coverage), byteCountOut. Returns
 * non-zero on success; the caller releases the pixels through the matching
 * release callback. */
typedef CFunction<int, unsigned long long, string, int, int, int, float, int*, int*, void**, unsigned long long*> NativeUiTypographyRasterize;

typedef CFunction<void, void*> NativeUiTypographyRelease;

/* Next line's consumed UTF-8 bytes, including its break. Platform providers
 * own linguistic/cluster boundaries; zero rejects a nonempty run. */
typedef CFunction<int, unsigned long long, string, int, int, int, int> NativeUiTypographyLineBreak;

class NativeUiTextLine {
	private string textValue;
	private NativeUiTextMetrics metricsValue;
	private int topValue;

	public NativeUiTextLine(string text, NativeUiTextMetrics metrics, int top) {
		self.textValue = text;
		self.metricsValue = metrics;
		self.topValue = top;
	}

	public string text() { return self.textValue; }

	public NativeUiTextMetrics metrics() { return self.metricsValue; }

	public int top() { return self.topValue; }
}

/* Immutable measurement shared by layout, CPU paint and native composition. */
class NativeUiTextLayout {
	private Vector<NativeUiTextLine> linesValue = [];
	private int widthValue = 0;
	private int heightValue = 0;
	private long long metadataBytesValue = 0LL;

	public NativeUiTextLayout(Vector<NativeUiTextLine> lines) {
		for line in lines {
			self.linesValue.push(line);
			if (line.metrics().width() > self.widthValue) { self.widthValue = line.metrics().width(); }
			self.heightValue = line.top() + line.metrics().height();
			self.metadataBytesValue += 96LL + (long long)line.text().len();
		}
	}

	public int lineCount() { return self.linesValue.len; }

	public NativeUiTextLine lineAt(int index) { return self.linesValue.get(index); }

	public int width() { return self.widthValue; }

	public int height() { return self.heightValue; }

	public long long metadataBytes() { return self.metadataBytesValue; }
}

class NativeUiTextMetrics {
	private int widthValue;
	private int heightValue;
	private int ascentValue;
	private int descentValue;
	private int advanceValue;

	public NativeUiTextMetrics(int width, int height, int ascent, int descent, int advance) {
		if (width < 0 || width > 1000000000 || height < 1 || height > 4096 || ascent < 1 || ascent > height || descent < 0 || descent > height || ascent + descent > height || advance < 1 || advance > 4096) { throw "invalid native UI text metrics"; }
		self.widthValue = width;
		self.heightValue = height;
		self.ascentValue = ascent;
		self.descentValue = descent;
		self.advanceValue = advance;
	}

	public int width() { return self.widthValue; }

	public int height() { return self.heightValue; }

	public int ascent() { return self.ascentValue; }

	public int descent() { return self.descentValue; }

	public int advance() { return self.advanceValue; }
}

class NativeUiTypography {
	private Map<string, NativeUiTextMetrics> measurements;
	private Vector<string> measurementKeys = [];
	private int nextMeasurementEviction = 0;
	private unsigned long long providerIdentityValue;
	private NativeUiTypographyMeasure providerMeasureValue;
	private NativeUiTypographyRasterize providerRasterizeValue;
	private NativeUiTypographyRelease providerReleaseValue;
	private NativeUiTypographyLineBreak providerLineBreakValue;

	public NativeUiTypography(unsigned long long providerIdentity = 0ULL, NativeUiTypographyMeasure providerMeasure = (NativeUiTypographyMeasure)null, NativeUiTypographyRasterize providerRasterize = (NativeUiTypographyRasterize)null, NativeUiTypographyRelease providerRelease = (NativeUiTypographyRelease)null, NativeUiTypographyLineBreak providerLineBreak = (NativeUiTypographyLineBreak)null) {
		self.measurements = new Map<string, NativeUiTextMetrics>();
		if ((providerIdentity == 0ULL) != (providerMeasure == null)) { throw "invalid native UI typography provider"; }
		if ((providerRasterize == null) != (providerRelease == null) || (providerRasterize != null && providerMeasure == null)) { throw "invalid native UI typography raster provider"; }
		self.providerIdentityValue = providerIdentity;
		self.providerMeasureValue = providerMeasure;
		self.providerRasterizeValue = providerRasterize;
		self.providerReleaseValue = providerRelease;
		if (providerLineBreak != null && providerMeasure == null) { throw "native UI line breaking requires its measurement provider"; }
		self.providerLineBreakValue = providerLineBreak;
	}

	class NativeUiTypography platform(unsigned long long providerIdentity, NativeUiTypographyMeasure providerMeasure, NativeUiTypographyRasterize providerRasterize = (NativeUiTypographyRasterize)null, NativeUiTypographyRelease providerRelease = (NativeUiTypographyRelease)null, NativeUiTypographyLineBreak providerLineBreak = (NativeUiTypographyLineBreak)null) { return NativeUiTypography(providerIdentity, providerMeasure, providerRasterize, providerRelease, providerLineBreak); }

	private int lineBreak(string text, int fontSize, int lineHeight, int fontWeight, int width) {
		if (self.platformBacked()) {
			if (self.providerLineBreakValue == null) { throw "native UI typography provider does not support text wrapping"; }
			int end = self.providerLineBreakValue(self.providerIdentityValue, text, fontSize, lineHeight, fontWeight, width);
			if (end < 1 || end > text.len() || !NativeUiTextInput.validUtf8(text.substring(0, end))) { throw "native UI typography provider rejected line breaking"; }
			return end;
		}
		/* The deterministic test font has one cell per scalar, not linguistic
		 * shaping. Real system typography supplies its own line breaker. */
		int end = 0;
		int word = 0;
		int cells = 0;
		while (end < text.len()) {
			char value = text[end];
			if (value == '\n') { return end + 1; }
			if (value == '\r') { return end + (end + 1 < text.len() && text[end + 1] == '\n' ? 2 : 1); }
			if (value == ' ' || value == '\t') { word = end + 1; }
			if (cells > 0 && (cells + 1) * self.advance(fontSize) > width) { return word > 0 ? word : end; }
			end = NativeUiTextInput.nextBoundary(text, end);
			cells++;
		}
		return end;
	}

	public NativeUiTextLayout wrap(string value, int fontSize, int lineHeight, int fontWeight, int width) {
		if (value == null || value.len() > 4096 || width < 1 || width > 1000000000) { throw "invalid native UI wrapped text bounds"; }
		self.measure("", fontSize, lineHeight, fontWeight);
		if (!NativeUiTextInput.validUtf8(value)) { throw "invalid native UI wrapped UTF-8"; }
		Vector<NativeUiTextLine> lines = [];
		int start = 0;
		int top = 0;
		while (start < value.len()) {
			string remaining = value.substring(start, value.len() - start);
			int consumed = self.lineBreak(remaining, fontSize, lineHeight, fontWeight, width);
			int end = consumed;
			while (end > 0 && (remaining[end - 1] == ' ' || remaining[end - 1] == '\t' || remaining[end - 1] == '\r' || remaining[end - 1] == '\n')) { end--; }
			string run = remaining.substring(0, end);
			NativeUiTextMetrics metrics = self.measure(run, fontSize, lineHeight, fontWeight);
			lines.push(NativeUiTextLine(run, metrics, top));
			top += metrics.height();
			start += consumed;
			while (start < value.len() && (value[start] == ' ' || value[start] == '\t')) { start++; }
		}
		if (lines.len == 0 || value.endsWith("\n") || value.endsWith("\r")) { lines.push(NativeUiTextLine("", self.measure("", fontSize, lineHeight, fontWeight), top)); }
		return NativeUiTextLayout(lines);
	}

	/* End ellipsis is measured with the same font provider as the displayed run.
	 * Keep the original element text; this is only its width-dependent layout. */
	public NativeUiTextLayout ellipsize(string value, int fontSize, int lineHeight, int fontWeight, int width) {
		if (value == null || value.len() > 4096 || width < 0 || width > 1000000000) { throw "invalid native UI ellipsis bounds"; }
		NativeUiTextMetrics full = self.measure(value, fontSize, lineHeight, fontWeight);
		if (full.width() <= width) { return NativeUiTextLayout([NativeUiTextLine(value, full, 0)]); }
		string suffix = "…";
		if (self.measure(suffix, fontSize, lineHeight, fontWeight).width() > width) { return NativeUiTextLayout([NativeUiTextLine("", self.measure("", fontSize, lineHeight, fontWeight), 0)]); }
		int low = 0;
		int high = value.len() > 4093 ? NativeUiTextViewport.boundary(value, 4093) : value.len();
		while (low < high) {
			int middle = NativeUiTextViewport.boundary(value, low + (high - low + 1) / 2);
			if (middle == low) { middle = NativeUiTextInput.nextBoundary(value, low); }
			string candidate = value.substring(0, middle) + suffix;
			if (self.measure(candidate, fontSize, lineHeight, fontWeight).width() <= width) { low = middle; }
			else { high = NativeUiTextInput.previousBoundary(value, middle); }
		}
		string fitted = value.substring(0, low) + suffix;
		return NativeUiTextLayout([NativeUiTextLine(fitted, self.measure(fitted, fontSize, lineHeight, fontWeight), 0)]);
	}

	public bool platformBacked() { return self.providerIdentityValue != 0ULL && self.providerMeasureValue != null; }

	public bool platformRasterizes() { return self.platformBacked() && self.providerRasterizeValue != null; }

	/* White, straight-alpha raster of one run from the platform provider, in
	 * backing pixels. null when the provider is absent or rejects the run;
	 * the empty run is Image.empty(). */
	public Image? platformRaster(string value, int fontSize, int lineHeight, int fontWeight, float backingScale) {
		self.measure(value, fontSize, lineHeight, fontWeight);
		if (value.isEmpty()) { return Image.empty(); }
		if (!self.platformRasterizes() || backingScale < 0.5f || backingScale > 4.0f) { return null; }
		int width = 0;
		int height = 0;
		void* pixels = null;
		unsigned long long pixelBytes = 0ULL;
		if (self.providerRasterizeValue(self.providerIdentityValue, value, fontSize, lineHeight, fontWeight, backingScale, &width, &height, &pixels, &pixelBytes) == 0) { return null; }
		if (pixels == null || !Image.validDimensions((long long)width, (long long)height) || pixelBytes != (unsigned long long)width * (unsigned long long)height * 4ULL) {
			self.providerReleaseValue(pixels);
			return null;
		}
		Image image = Image(width, height);
		bool copied = image.tryCopyPackedRgba(pixels, pixelBytes);
		self.providerReleaseValue(pixels);
		return copied ? image : null;
	}

	public int glyphWidth(int fontSize) {
		int width = fontSize * 5 / 7;
		return width < 1 ? 1 : width;
	}

	public int glyphHeight(int fontSize) { return fontSize; }

	public int advance(int fontSize) {
		int value = fontSize * 6 / 7;
		return value < 1 ? 1 : value;
	}

	public int cachedMeasurementCount() { return self.measurementKeys.len; }

	/* Metrics are immutable and belong to this provider's lifetime. Cap both
	 * entries and retained text; no pixel rasters are kept here. */
	public NativeUiTextMetrics measure(string value, int fontSize, int lineHeight, int fontWeight = 400) {
		if (value == null || value.len() > 4096) { return self.measureUncached(value, fontSize, lineHeight, fontWeight); }
		string key = f"{fontSize}:{lineHeight}:{fontWeight}:{value}";
		if (self.measurements.has(key)) { return self.measurements.get(key); }
		NativeUiTextMetrics measured = self.measureUncached(value, fontSize, lineHeight, fontWeight);
		if (self.measurementKeys.len == 512) {
			self.measurements.remove(self.measurementKeys.get(self.nextMeasurementEviction));
			self.measurementKeys.set(self.nextMeasurementEviction, key);
			self.nextMeasurementEviction = (self.nextMeasurementEviction + 1) % 512;
		} else { self.measurementKeys.push(key); }
		self.measurements.put(key, measured);
		return measured;
	}

	private NativeUiTextMetrics measureUncached(string value, int fontSize, int lineHeight, int fontWeight) {
		if (value == null || fontSize < 8 || fontSize > 256 || lineHeight < fontSize || lineHeight > 512 || (fontWeight != 400 && fontWeight != 500 && fontWeight != 600 && fontWeight != 700) || !NativeUiTextInput.validUtf8(value)) { throw "invalid native UI text measurement"; }
		if (self.platformBacked()) {
			int width = 0;
			int height = 0;
			int ascent = 0;
			int descent = 0;
			int advance = 0;
			if (self.providerMeasureValue(self.providerIdentityValue, value, fontSize, lineHeight, fontWeight, &width, &height, &ascent, &descent, &advance) == 0) { throw "native UI typography provider rejected measurement"; }
			return NativeUiTextMetrics(width, height, ascent, descent, advance);
		}
		int scalarCount = NativeUiTextInput.scalarCount(value, value.len());
		int advance = self.advance(fontSize);
		long long width = (long long)scalarCount * (long long)advance;
		if (width > 1000000000LL) { throw "native UI text measurement exceeds its bound"; }
		int ascent = fontSize * 4 / 5;
		if (ascent < 1) { ascent = 1; }
		int descent = fontSize - ascent;
		return NativeUiTextMetrics((int)width, lineHeight, ascent, descent, advance);
	}

	public int alignedX(int outerX, int outerWidth, int padding, int textWidth, NativeUiTextAlignment alignment) {
		int innerWidth = outerWidth - padding * 2;
		if (innerWidth < 0) { innerWidth = 0; }
		int visibleWidth = textWidth < innerWidth ? textWidth : innerWidth;
		if (alignment == NATIVE_UI_TEXT_ALIGN_CENTER) { return outerX + padding + (innerWidth - visibleWidth) / 2; }
		if (alignment == NATIVE_UI_TEXT_ALIGN_RIGHT) { return outerX + padding + innerWidth - visibleWidth; }
		return outerX + padding;
	}

	public unsigned long long glyph(char raw) {
		char value = raw >= 'a' && raw <= 'z' ? raw - 'a' + 'A' : raw;
		switch (value) {
			case '0': return 0x3a33ae62eULL;
			case '1': return 0x3884210c4ULL;
			case '2': return 0x7c444422eULL;
			case '3': return 0x3e107420fULL;
			case '4': return 0x211f4a988ULL;
			case '5': return 0x3e107843fULL;
			case '6': return 0x3a317842eULL;
			case '7': return 0x8422221fULL;
			case '8': return 0x3a317462eULL;
			case '9': return 0x3a10f462eULL;
			case 'A': return 0x4631fc62eULL;
			case 'B': return 0x3e317c62fULL;
			case 'C': return 0x78210843eULL;
			case 'D': return 0x3e318c62fULL;
			case 'E': return 0x7c217843fULL;
			case 'F': return 0x4217843fULL;
			case 'G': return 0x7a31e843eULL;
			case 'H': return 0x4631fc631ULL;
			case 'I': return 0x7c842109fULL;
			case 'J': return 0x19294211cULL;
			case 'K': return 0x452519531ULL;
			case 'L': return 0x7c2108421ULL;
			case 'M': return 0x4631ad771ULL;
			case 'N': return 0x4631cd671ULL;
			case 'O': return 0x3a318c62eULL;
			case 'P': return 0x4217c62fULL;
			case 'Q': return 0x59358c62eULL;
			case 'R': return 0x45257c62fULL;
			case 'S': return 0x3e107043eULL;
			case 'T': return 0x10842109fULL;
			case 'U': return 0x3a318c631ULL;
			case 'V': return 0x11518c631ULL;
			case 'W': return 0x2ab5ac631ULL;
			case 'X': return 0x462a22a31ULL;
			case 'Y': return 0x108422a31ULL;
			case 'Z': return 0x7c222221fULL;
			case '-': return 0x00003e000ULL;
			case '.': return 0x300000000ULL;
			case ':': return 0x018000180ULL;
			default: return value == ' ' ? 0ULL : 0x2318c62a2ULL;
		}
	}
}
