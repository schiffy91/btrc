/* btrc standard library — Unix terminal helpers */

#include <termios.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <sys/resource.h>
#include <poll.h>
#include <pwd.h>
#include <signal.h>
#include <fcntl.h>
#include <limits.h>
#include <stdint.h>
#include <unistd.h>
#include <time.h>
#include <errno.h>

import std.bytes;
import std.strings;
import std.terminal_clock;
import std.terminal_password;
import std.terminal_password_exchange;

extern pid_t forkpty(int* amaster, char* name, void* termp, void* winp);

class Terminal {
    class string readLine() {
        Bytes value = Bytes();
        int byte = fgetc(stdin);
        while (byte != EOF && byte != '\n') {
            value.append(byte);
            byte = fgetc(stdin);
        }
        return value.toStringLossy();
    }

    class string prompt(string label) {
        fprintf(stderr, "%s", label == null ? "" : label);
        fflush(stderr);
        return Terminal.readLine();
    }

    class string promptPassword(string label) {
        return TerminalPasswordInput.prompt(label);
    }
}

class UnixPamPassword {
    class bool safeSecret(string value) {
        return value != null
            && value.len() <= 4096
            && !value.contains("\n")
            && !value.contains("\r");
    }

    class string passwdExecutable() {
        if (access("/run/wrappers/bin/passwd", X_OK) == 0) {
            return "/run/wrappers/bin/passwd";
        }
        if (access("/run/current-system/sw/bin/passwd", X_OK) == 0) {
            return "/run/current-system/sw/bin/passwd";
        }
        if (access("/usr/bin/passwd", X_OK) == 0) {
            return "/usr/bin/passwd";
        }
        if (access("/bin/passwd", X_OK) == 0) { return "/bin/passwd"; }
        return "";
    }

    /* Root may select a target account and is not asked for its current
     * password. An unprivileged caller may only change its own account. */
    class int responseCountFor(uid_t effectiveUser, uid_t targetUser) {
        if (effectiveUser == (uid_t)0) { return 2; }
        return effectiveUser == targetUser ? 3 : 0;
    }

    class bool maySendResponse(int sent, int selected, bool promptSeen) {
        return promptSeen && sent >= 0 && selected > 0 && sent < selected;
    }

    class size_t initialAccountBufferSize() {
        long suggested = sysconf(_SC_GETPW_R_SIZE_MAX);
        if (suggested < 1024L) { return (size_t)16384; }
        if (suggested > 1048576L) { return (size_t)1048576; }
        return (size_t)suggested;
    }

    class int descriptorCloseBound() {
        struct rlimit limit;
        if (getrlimit(RLIMIT_NOFILE, &limit) != 0) { return -1; }
        uintmax_t bound = (uintmax_t)limit.rlim_cur;
        if (bound == (uintmax_t)RLIM_INFINITY
                || bound < (uintmax_t)3
                || bound > (uintmax_t)1048576) {
            return -1;
        }
        return (int)bound;
    }

    /* Called only in the post-fork child. close() and integer iteration are
     * async-signal-safe; every unrelated descriptor is gone before execve. */
    class void closeDescriptorsForExec(int bound) {
        for (int descriptor = 3; descriptor < bound; descriptor++) {
            close(descriptor);
        }
    }

    class bool configureMaster(int fd) {
        if (fd < 0) { return false; }
        int descriptorFlags = fcntl(fd, F_GETFD, 0);
        if (descriptorFlags < 0
                || fcntl(fd, F_SETFD, descriptorFlags | FD_CLOEXEC) < 0) {
            return false;
        }
        int statusFlags = fcntl(fd, F_GETFL, 0);
        return statusFlags >= 0
            && fcntl(fd, F_SETFL, statusFlags | O_NONBLOCK) == 0;
    }

    /* Return poll revents, zero for a slice/deadline timeout, or -1 on error. */
    class int pollUntil(int fd, short events, long long deadline,
                        int maxWaitMillis) {
        return UnixPasswdPromptExchange.pollUntil(
            fd, events, deadline, maxWaitMillis);
    }

    class bool writeBytesUntil(int fd, char* bytes, size_t length,
                               long long deadline) {
        return UnixPasswdPromptExchange.writeBytesUntil(
            fd, bytes, length, deadline);
    }

    class bool writeResponseUntil(int fd, string value,
                                  long long deadline) {
        if (fd < 0 || !UnixPamPassword.safeSecret(value)) { return false; }
        return UnixPasswdPromptExchange.writeResponseUntil(
            fd, value, deadline);
    }

    class bool passwordInputHidden(int fd) {
        return UnixPasswdPromptExchange.passwordInputHidden(fd);
    }

    class bool answerPasswordPrompts(int fd, char** responses,
                                     int responseCount,
                                     long long deadline) {
        return UnixPasswdPromptExchange.answer(
            fd, responses, responseCount, deadline);
    }

    /* Back-compatible standalone helper with the same bounded secret contract. */
    class bool writeResponse(int fd, string value) {
        return UnixPamPassword.writeResponseUntil(
            fd, value, TerminalClock.deadlineAfter(30000));
    }

    /* SIGKILL normally makes the following wait immediate.  We deliberately
     * prefer guaranteed child cleanup over returning at the deadline while a
     * live child or zombie remains. A dedicated reaper would be required to
     * promise both a hard return bound and guaranteed cleanup. */
    class int killAndReap(pid_t processId) {
        if (processId <= (pid_t)0) { return -1; }
        kill(processId, SIGKILL);
        int status = 0;
        pid_t waited = waitpid(processId, &status, 0);
        while (waited < (pid_t)0 && errno == EINTR) {
            waited = waitpid(processId, &status, 0);
        }
        return -1;
    }

    /* forkpty establishes the child as a session/process-group leader. Stop
     * that group first so a PAM helper cannot outlive a timed-out passwd, then
     * always target and reap the leader as the portable fallback. */
    class int killPtyAndReap(pid_t processId) {
        if (processId <= (pid_t)0) { return -1; }
        kill(-processId, SIGKILL);
        return UnixPamPassword.killAndReap(processId);
    }

    /* Wait against the caller's absolute deadline.  A backend that accepts
     * every prompt and then stalls must not escape the password-change bound. */
    class int waitForExitUntil(pid_t processId, long long deadline) {
        if (processId <= (pid_t)0) { return -1; }
        int status = 0;
        while (true) {
            pid_t waited = waitpid(processId, &status, WNOHANG);
            if (waited == processId) { return status; }
            if (waited < (pid_t)0 && errno != EINTR) { return -1; }
            if (TerminalClock.milliseconds() >= deadline) {
                return UnixPamPassword.killAndReap(processId);
            }
            poll(NULL, 0, 10);
        }
        return -1;
    }

    /* Keep the PTY alive until passwd exits: closing its last master first can
     * deliver SIGHUP to the slave's foreground process group. Drain output so a
     * verbose backend cannot fill the PTY and deadlock before exit. */
    class int waitForPtyExitUntil(pid_t processId, int fd,
                                  long long deadline) {
        if (processId <= (pid_t)0 || fd < 0) { return -1; }
        int status = 0;
        char output[4096];
        while (true) {
            pid_t waited = waitpid(processId, &status, WNOHANG);
            if (waited == processId) { return status; }
            if (waited < (pid_t)0 && errno != EINTR) { return -1; }
            if (TerminalClock.milliseconds() >= deadline) {
                return UnixPamPassword.killPtyAndReap(processId);
            }
            int events = UnixPamPassword.pollUntil(
                fd, POLLIN, deadline, 50);
            if (events < 0) {
                return UnixPamPassword.killPtyAndReap(processId);
            }
            if ((events & POLLIN) != 0) {
                int reads = 0;
                while (reads < 16) {
                    ssize_t count = read(fd, output, sizeof(output));
                    if (count > (ssize_t)0) {
                        reads++;
                        continue;
                    }
                    if (count < (ssize_t)0 && errno == EINTR) { continue; }
                    break;
                }
            } else if (events != 0) {
                poll(NULL, 0, 10);
            }
        }
        return -1;
    }

    class bool change(string user, string oldPassword, string newPassword) {
        if (user == null || user.isEmpty()
                || !UnixPamPassword.safeSecret(oldPassword)
                || !UnixPamPassword.safeSecret(newPassword)) {
            return false;
        }
        /* getpwnam_r never exposes a partial record: ERANGE grows a
         * caller-owned buffer up to a documented 1 MiB ceiling, then fails
         * closed if the NSS record still cannot be represented. */
        struct passwd account;
        struct passwd* pw = NULL;
        size_t accountCapacity = UnixPamPassword.initialAccountBufferSize();
        char* accountBuffer = (char*)malloc(accountCapacity);
        if (accountBuffer == NULL) { return false; }
        int lookup = ERANGE;
        while (true) {
            pw = NULL;
            lookup = getpwnam_r(
                user, &account, accountBuffer, accountCapacity, &pw);
            if (lookup != ERANGE || accountCapacity >= (size_t)1048576) {
                break;
            }
            size_t nextCapacity = accountCapacity * (size_t)2;
            if (nextCapacity > (size_t)1048576) {
                nextCapacity = (size_t)1048576;
            }
            char* grown = (char*)realloc(accountBuffer, nextCapacity);
            if (grown == NULL) {
                free(accountBuffer);
                return false;
            }
            accountBuffer = grown;
            accountCapacity = nextCapacity;
        }
        if (lookup != 0 || pw == NULL) {
            free(accountBuffer);
            return false;
        }
        uid_t targetUser = pw->pw_uid;
        string homeDirectory = pw->pw_dir == NULL
            ? "/" : Strings.copy(pw->pw_dir);
        free(accountBuffer);

        string executable = UnixPamPassword.passwdExecutable();
        int responseCount = UnixPamPassword.responseCountFor(
            geteuid(), targetUser);
        if (executable.isEmpty() || responseCount == 0) { return false; }

        /* Everything the child will consume is materialized before forkpty.
         * The child branch performs only execve/_exit, preserving the immediate
         * exec boundary required by multithreaded callers. */
        char* childArguments[3];
        childArguments[0] = executable;
        childArguments[1] = NULL;
        childArguments[2] = NULL;
        /* Root executes `passwd user`; non-root self-service leaves argv[1]
         * null and therefore executes plain `passwd`. */
        if (responseCount == 2) { childArguments[1] = user; }

        string homeEnvironment = "HOME=" + homeDirectory;
        string userEnvironment = "USER=" + user;
        string lognameEnvironment = "LOGNAME=" + user;
        char* childEnvironment[7];
        childEnvironment[0] = (char*)"PATH=/run/wrappers/bin:/run/current-system/sw/bin:/usr/bin:/bin";
        childEnvironment[1] = (char*)"LC_ALL=C";
        childEnvironment[2] = (char*)"LANG=C";
        childEnvironment[3] = homeEnvironment;
        childEnvironment[4] = userEnvironment;
        childEnvironment[5] = lognameEnvironment;
        childEnvironment[6] = NULL;

        /* RLIMIT_NOFILE's current finite limit is the allocation ceiling for
         * new descriptors. Reject unsupported limits instead of silently
         * leaking a caller descriptor into the privileged executable. */
        int descriptorBound = UnixPamPassword.descriptorCloseBound();
        if (descriptorBound < 3) { return false; }

        int fd = -1;
        pid_t pid = forkpty(&fd, NULL, NULL, NULL);
        if (pid < (pid_t)0) { return false; }

        if (pid == (pid_t)0) {
            UnixPamPassword.closeDescriptorsForExec(descriptorBound);
            execve(executable, childArguments, childEnvironment);
            _exit(127);
        }

        if (!UnixPamPassword.configureMaster(fd)) {
            UnixPamPassword.killPtyAndReap(pid);
            if (fd >= 0) { close(fd); }
            return false;
        }

        char* responses[3];
        responses[0] = responseCount == 2 ? newPassword : oldPassword;
        responses[1] = newPassword;
        responses[2] = newPassword;
        long long deadline = TerminalClock.deadlineAfter(30000);
        bool answered = UnixPamPassword.answerPasswordPrompts(
            fd, responses, responseCount, deadline);
        if (!answered) {
            UnixPamPassword.killPtyAndReap(pid);
            close(fd);
            return false;
        }
        int status = UnixPamPassword.waitForPtyExitUntil(pid, fd, deadline);
        close(fd);
        return answered && status >= 0
            && WIFEXITED(status) && WEXITSTATUS(status) == 0;
    }
}
