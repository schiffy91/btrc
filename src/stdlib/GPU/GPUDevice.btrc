import Library.Callback;
import Library.GPU.GPUCompletionPump;
import Library.GPU.WebGPU;

enum GPUDeviceState {
	GPU_DEVICE_REQUESTING_ADAPTER,
	GPU_DEVICE_REQUESTING_DEVICE,
	GPU_DEVICE_READY,
	GPU_DEVICE_FAILED,
	GPU_DEVICE_CLOSING,
	GPU_DEVICE_CLOSED
};

/* Native completions never retain the domain owner or perform another SDK call.
 * Generated bindings own the callback context and adopt its resource claim. */
class GPUAdapterCompletion implements IGPUAdapterCompletion {
	public WGPUAdapter? value;
	public int status = 0;
	public string message = "";
	public bool delivered = false;
	public void invoke(WGPURequestAdapterStatus status, WGPUAdapter? adapter, string message) {
		self.status = (int)status;
		self.message = message;
		self.value = adapter;
		self.delivered = true;
	}
}

class GPUDeviceCompletion implements IGPUDeviceCompletion {
	public WGPUDevice? value;
	public int status = 0;
	public string message = "";
	public bool delivered = false;
	public void invoke(WGPURequestDeviceStatus status, WGPUDevice? device, string message) {
		self.status = (int)status;
		self.message = message;
		self.value = device;
		self.delivered = true;
	}
}

/* The creating thread owns setup and nonblocking shutdown. A pending close
 * keeps the instance alive: continue poll() until CLOSED before releasing this
 * owner or stopping its executor. Cancellation abandons delivery, not native work. */
class GPUDevice {
	private WGPUAdapter? _adapter;
	private WGPUDevice? _device;
	private WGPUQueue? _queue;
	private GPUCompletionPump _pump;
	private GPUAdapterCompletion? _adapterCompletion;
	private GPUDeviceCompletion? _deviceCompletion;
	private GPUDeviceState _state = GPU_DEVICE_REQUESTING_ADAPTER;
	private string _error = "";
	public GPUDevice(WGPUInstance instance, WGPUSurface surface) {
		if (instance == null || surface == null) { throw "GPU device requires an open instance and surface"; }
		self._pump = GPUCompletionPump(instance);
		GPUAdapterCompletion adapterCompletion = GPUAdapterCompletion();
		self._adapterCompletion = adapterCompletion;
		var options = WGPURequestAdapterOptionsInput();
		options.compatibleSurface = surface;
		var callback = WGPURequestAdapterCallbackInfoInput();
		callback.mode = WGPUCallbackMode_AllowProcessEvents;
		callback.callback = adapterCompletion;
		wgpuInstanceRequestAdapter(instance, options, callback, self._pump.scope());
	}

	private void requireExecutor() { self._pump.requireExecutor(); }

	public GPUDeviceState state() { self.requireExecutor(); return self._state; }

	public string error() { self.requireExecutor(); return self._error; }

	private void requireReady() { self.requireExecutor(); if (self._state != GPU_DEVICE_READY) { throw "GPU device is not ready"; } }

	public WGPUInstance nativeInstance() { self.requireReady(); return self._pump.nativeInstance(); }

	public WGPUDevice nativeDevice() {
		self.requireReady();
		WGPUDevice? device = self._device;
		if (device == null) { throw "GPU device is not ready"; }
		return device;
	}

	public WGPUAdapter nativeAdapter() {
		self.requireReady();
		WGPUAdapter? adapter = self._adapter;
		if (adapter == null) { throw "GPU device is not ready"; }
		return adapter;
	}

	public WGPUQueue nativeQueue() {
		self.requireReady();
		WGPUQueue? queue = self._queue;
		if (queue == null) { throw "GPU device is not ready"; }
		return queue;
	}

	private void fail(string error) { self.close(); self._error = error; self._state = GPU_DEVICE_FAILED; }

	public GPUDeviceState poll() {
		self.requireExecutor();
		if (self._state == GPU_DEVICE_CLOSED || self._state == GPU_DEVICE_READY) { return self._state; }
		self._pump.pump();
		if (self._state == GPU_DEVICE_CLOSING || self._state == GPU_DEVICE_FAILED) {
			if (self._pump.drained() && self._state == GPU_DEVICE_CLOSING) { self._state = GPU_DEVICE_CLOSED; }
			return self._state;
		}
		if (self._state == GPU_DEVICE_REQUESTING_ADAPTER) {
			var completion = self._adapterCompletion;
			if (completion == null) { self.fail("Missing GPU adapter completion"); return self._state; }
			if (!completion.delivered) { return self._state; }
			self._adapter = completion.value;
			self._adapterCompletion = null;
			if (completion.status != (int)WGPURequestAdapterStatus_Success || self._adapter == null) { self.fail(f"GPU adapter request failed ({completion.status}): {completion.message}"); return self._state; }
			self._state = GPU_DEVICE_REQUESTING_DEVICE;
			GPUDeviceCompletion deviceCompletion = GPUDeviceCompletion();
			self._deviceCompletion = deviceCompletion;
			var callback = WGPURequestDeviceCallbackInfoInput();
			callback.mode = WGPUCallbackMode_AllowProcessEvents;
			callback.callback = deviceCompletion;
			wgpuAdapterRequestDevice(self._adapter, null, callback, self._pump.scope());
		} else {
			var completion = self._deviceCompletion;
			if (completion == null) { self.fail("Missing GPU device completion"); return self._state; }
			if (!completion.delivered) { return self._state; }
			self._device = completion.value;
			self._deviceCompletion = null;
			if (completion.status != (int)WGPURequestDeviceStatus_Success || self._device == null) { self.fail(f"GPU device request failed ({completion.status}): {completion.message}"); return self._state; }
			self._queue = wgpuDeviceGetQueue(self._device);
			if (self._queue == null) { self.fail("Cannot obtain GPU device queue"); return self._state; }
			self._state = GPU_DEVICE_READY;
		}
		return self._state;
	}

	public CallbackCancellation close() {
		var result = self._pump == null ? CALLBACK_CANCELLATION_COMPLETE : self._pump.cancel();
		self._adapterCompletion = null;
		self._deviceCompletion = null;
		self._queue = null;
		self._device = null;
		self._adapter = null;
		self._state = result == CALLBACK_CANCELLATION_COMPLETE ? GPU_DEVICE_CLOSED : GPU_DEVICE_CLOSING;
		return result;
	}

	public void __del__() { self.close(); }
}
