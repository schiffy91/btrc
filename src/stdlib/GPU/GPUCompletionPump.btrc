import Library.Callback;
import Library.GPU.WebGPU;

/* The completion lifecycle every asynchronous GPU owner shares: one callback
 * scope bound to the owner's thread, the instance retained until every native
 * completion has drained, and a pump that delivers completions without
 * waiting. Cancellation abandons delivery, not native work, so an owner whose
 * cancel() is not Complete keeps pumping until drained(). */
class GPUCompletionPump {
	private CallbackScope _scope;
	private WGPUInstance? _instance;

	public GPUCompletionPump(WGPUInstance instance) {
		self._scope = CallbackScope();
		self._instance = instance;
	}

	public CallbackScope scope() { return self._scope; }

	public void requireExecutor() { self._scope.requireExecutor(); }

	public bool isOpen() { return self._scope.isOpen(); }

	public WGPUInstance nativeInstance() {
		var instance = self._instance;
		if (instance == null) { throw "GPU completions have drained"; }
		return instance;
	}

	/* Process native events, then deliver whatever completed. Never waits. */
	public void pump() {
		self.requireExecutor();
		if (self._instance != null) { wgpuInstanceProcessEvents(self._instance); }
		self._scope.pollCompletion();
	}

	/* After cancellation: true, releasing the instance, once nothing is pending. */
	public bool drained() {
		if (self._scope.pendingCount() != 0) { return false; }
		self._instance = null;
		return true;
	}

	public CallbackCancellation cancel() {
		var result = self._scope.cancel();
		if (result == CallbackCancellation.Complete) { self._instance = null; }
		return result;
	}

	/* ICallbackRegistration.pollCompletion for an owner a parent scope tracks:
	 * an open owner has nothing to report; a cancelled one reports drainage
	 * after its own poll has pumped. */
	public CallbackCancellation completion() { return self._scope.pendingCount() == 0 ? CallbackCancellation.Complete : CallbackCancellation.Pending; }
}
