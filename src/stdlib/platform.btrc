/* btrc standard library — Platform
 * Small platform probes and constants.
 *
 * The current implementation is POSIX-first because btrc's compiler and test
 * harness currently target Unix-like systems. The API leaves room for Windows
 * support without renaming higher-level shell abstractions.
 */

import std.strings;

#include <unistd.h>
#include <errno.h>
#include <stdlib.h>

class UnixPlatform {
    class int pid() {
        return (int)getpid();
    }

    class int euid() {
        return (int)geteuid();
    }
}

class Platform {
    class bool isUnix() {
        return !Platform.isWindows();
    }

    class bool isWindows() {
        /* MinGW's getcwd() returns either a drive-rooted path (C:\\...) or
         * a UNC path.  Detect that shape at runtime so cross-compiled programs
         * do not bake the transpiler host's platform into their output. */
        int capacity = 256;
        char* cwd = (char*)__btrc_safe_realloc(NULL, (size_t)capacity);
        while ((char*)getcwd(cwd, (size_t)capacity) == NULL) {
            if (errno != ERANGE || capacity > 1073741823) {
                free(cwd);
                return false;
            }
            capacity = capacity * 2;
            cwd = (char*)__btrc_safe_realloc(cwd, (size_t)capacity);
        }
        int length = Strings.checkedLength(cwd);
        bool driveRooted = length >= 3
            && ((cwd[0] >= 'A' && cwd[0] <= 'Z')
                || (cwd[0] >= 'a' && cwd[0] <= 'z'))
            && cwd[1] == ':'
            && (cwd[2] == '/' || cwd[2] == '\\');
        bool uncRooted = length >= 2 && cwd[0] == '\\' && cwd[1] == '\\';
        free(cwd);
        return driveRooted || uncRooted;
    }

    class string pathSeparator() {
        return Platform.isWindows() ? "\\" : "/";
    }

    class int pid() {
        return UnixPlatform.pid();
    }

    class int euid() {
        return UnixPlatform.euid();
    }

    class bool isRoot() {
        /* Windows has no POSIX root identity; the compatibility getuid/euid
         * value is only a sentinel and must never grant privileges. */
        return !Platform.isWindows() && Platform.euid() == 0;
    }
}

class Environment {
    class string get(string name, string fallback) {
        string value = getenv(name);
        if (value == null || value.isEmpty()) { return fallback; }
        return Strings.copy(value);
    }

    class bool has(string name) {
        string value = getenv(name);
        return value != null && !value.isEmpty();
    }
}
