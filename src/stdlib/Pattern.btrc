/* btrc standard library — Pattern matching */

import Library.Vector;

#include <fnmatch.h>

class Pattern {
	class bool matches(string pattern, string text) {
		if (pattern == null || text == null) { return false; }
		return fnmatch(pattern, text, 0) == 0;
	}

	class bool anyMatches(Vector<string> patterns, string text) {
		for pattern in patterns {
			if (Pattern.matches(pattern, text)) { return true; }
		}
		return false;
	}
}
