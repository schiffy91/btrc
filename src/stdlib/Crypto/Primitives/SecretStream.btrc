/* A stream of authenticated, encrypted messages under one key: libsodium's
 * `crypto_secretstream_xchacha20poly1305`, byte for byte, so either end may
 * be libsodium.
 *
 * Each message is sealed with ChaCha20-Poly1305 under a nonce made of a
 * message counter and eight bytes that every message's tag is folded into.
 * A message that was altered, repeated, dropped or reordered therefore fails
 * to open, and the receiver's state does not move.
 *
 * The 52 bytes of state are the layout libsodium keeps: the 32-byte key, the
 * 4-byte little-endian counter, the 8 chained nonce bytes and 8 zero bytes.
 * A sealed message is one enciphered tag byte, the ciphertext and a 16-byte
 * authenticator: 17 bytes longer than the message. */

import Library.Crypto.Primitives.ChaCha20;
import Library.Crypto.Primitives.ConstantTime;
import Library.Crypto.Primitives.Poly1305;

enum SecretStreamTag {
	SECRET_STREAM_MESSAGE = 0,
	SECRET_STREAM_PUSH = 1,
	SECRET_STREAM_REKEY = 2,
	SECRET_STREAM_FINAL = 3
};

class SecretStream {
	/* Key a direction from its 24-byte header: HChaCha20 of the first 16
	 * bytes gives the stream key, and the last 8 start the chained nonce.
	 * The sender picks the header at random and sends it in the clear. */
	class void begin(unsigned char* state, unsigned char* header, unsigned char* key) {
		ChaCha20.subkey(state, header, key);
		SecretStream.resetCounter(state);
		for (int index = 0; index < 8; index++) {
			state[36 + index] = header[16 + index];
			state[44 + index] = (unsigned char)0;
		}
	}

	class void resetCounter(unsigned char* state) {
		state[32] = (unsigned char)1;
		state[33] = (unsigned char)0;
		state[34] = (unsigned char)0;
		state[35] = (unsigned char)0;
	}

	/* Replace the key and chained nonce with keystream of themselves, so
	 * the old key cannot be recovered from the new state. */
	class void rekey(unsigned char* state) {
		unsigned char fresh[40];
		for (int index = 0; index < 32; index++) { fresh[index] = state[index]; }
		for (int index = 0; index < 8; index++) { fresh[32 + index] = state[36 + index]; }
		ChaCha20.xorKeystream(fresh, fresh, 40, state + 32, 0U, state);
		for (int index = 0; index < 32; index++) { state[index] = fresh[index]; }
		for (int index = 0; index < 8; index++) { state[36 + index] = fresh[32 + index]; }
		SecretStream.resetCounter(state);
		ConstantTime.wipe(fresh, 40);
	}

	/* The authenticator of one sealed message: Poly1305, keyed by the first
	 * keystream block, over the enciphered tag block, the ciphertext, zero
	 * padding and both lengths. The padding length is libsodium's, which is
	 * `length mod 16` rather than the distance to the next multiple of 16;
	 * a peer has to compute the same thing. */
	class void authenticate(unsigned char* out, unsigned char* state, unsigned char* tagBlock, unsigned char* ciphertext, int length) {
		unsigned char block[64];
		unsigned char zeros[16];
		unsigned char lengths[16];
		ChaCha20.keystream(block, 64, state + 32, 0U, state);
		Poly1305 mac = Poly1305(block);
		ConstantTime.wipe(block, 64);
		mac.update(tagBlock, 64);
		mac.update(ciphertext, length);
		for (int index = 0; index < 16; index++) {
			zeros[index] = (unsigned char)0;
			lengths[index] = (unsigned char)0;
		}
		mac.update(zeros, length & 15);
		/* No additional data, then 64 + length, both as 64-bit little-endian. */
		unsigned long long total = 64ULL + (unsigned long long)length;
		for (int index = 0; index < 8; index++) { lengths[8 + index] = (unsigned char)((total >> (8 * index)) & 0xffULL); }
		mac.update(lengths, 16);
		mac.finish(out);
	}

	/* Fold the message's authenticator into the nonce and count the
	 * message; rekey when asked to or when the counter wraps. */
	class void advance(unsigned char* state, unsigned char* authenticator, int tag) {
		for (int index = 0; index < 8; index++) { state[36 + index] ^= authenticator[index]; }
		unsigned int carry = 1U;
		for (int index = 0; index < 4; index++) {
			carry += (unsigned int)state[32 + index];
			state[32 + index] = (unsigned char)(carry & 0xffU);
			carry >>= 8;
		}
		if ((tag & SECRET_STREAM_REKEY) != 0 || ConstantTime.isZero(state + 32, 4)) { SecretStream.rekey(state); }
	}

	/* Seal `length` bytes of `message` into `sealed`, which needs
	 * `length + 17` bytes and must not overlap the message. Returns the
	 * sealed length. */
	class int seal(unsigned char* state, unsigned char* sealed, unsigned char* message, int length, int tag) {
		unsigned char block[64];
		if (length < 0) { return -1; }
		for (int index = 0; index < 64; index++) { block[index] = (unsigned char)0; }
		block[0] = (unsigned char)(tag & 0xff);
		ChaCha20.xorKeystream(block, block, 64, state + 32, 1U, state);
		sealed[0] = block[0];
		ChaCha20.xorKeystream(sealed + 1, message, length, state + 32, 2U, state);
		SecretStream.authenticate(sealed + 1 + length, state, block, sealed + 1, length);
		SecretStream.advance(state, sealed + 1 + length, tag);
		ConstantTime.wipe(block, 64);
		return length + 17;
	}

	/* Open the next sealed message of the stream into `message`, which
	 * needs `length - 17` bytes. Returns the message length and stores the
	 * sender's tag in `tag[0]`; returns -1, leaving the state and the
	 * output untouched, when the bytes are not the next message this
	 * stream's sender sealed. */
	class int open(unsigned char* state, unsigned char* message, unsigned char* tag, unsigned char* sealed, int length) {
		unsigned char block[64];
		unsigned char authenticator[16];
		if (length < 17) { return -1; }
		int messageLength = length - 17;
		for (int index = 0; index < 64; index++) { block[index] = (unsigned char)0; }
		block[0] = sealed[0];
		ChaCha20.xorKeystream(block, block, 64, state + 32, 1U, state);
		int sentTag = (int)block[0];
		block[0] = sealed[0];
		SecretStream.authenticate(authenticator, state, block, sealed + 1, messageLength);
		ConstantTime.wipe(block, 64);
		if (!ConstantTime.equal(authenticator, sealed + 1 + messageLength, 16)) {
			ConstantTime.wipe(authenticator, 16);
			return -1;
		}
		ChaCha20.xorKeystream(message, sealed + 1, messageLength, state + 32, 2U, state);
		SecretStream.advance(state, authenticator, sentTag);
		tag[0] = (unsigned char)sentTag;
		return messageLength;
	}
}
