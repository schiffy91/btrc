/* Bounded passwd prompt/response exchange over a PTY. Classification cannot
 * authenticate output: callers must trust the locally installed executable at
 * UnixPamPassword's fixed system path and the PAM stack it loads (normally
 * administrator/root-owned). A quiet interval handles ordinary PTY chunking;
 * timing cannot prove that a candidate has no later diagnostic suffix. */

import std.strings;
import std.terminal_clock;
import std.terminal_password_prompts;
import std.vector;

#include <errno.h>
#include <limits.h>
#include <poll.h>
#include <stdint.h>
#include <string.h>
#include <termios.h>
#include <unistd.h>

class UnixPasswdPromptExchange {
	/* Long enough to cover routine PTY chunking without making each expected
     * password prompt noticeably slow. This is a bound, not authentication. */
	class int quietIntervalMilliseconds() { return 250; }

	/* Return poll revents, zero for a slice/deadline timeout, or -1 on error. */
	class int pollUntil(int fd, short events, long long deadline, int maxWaitMillis) {
		while (true) {
			long long now = TerminalClock.milliseconds();
			if (deadline <= now) { return 0; }
			long long remaining = deadline - now;
			int waitMillis = remaining > (long long)INT_MAX ? INT_MAX : (int)remaining;
			if (maxWaitMillis > 0 && waitMillis > maxWaitMillis) {
				waitMillis = maxWaitMillis;
			}
			struct pollfd pending;
			pending.fd = fd;
			pending.events = events;
			pending.revents = 0;
			int ready = poll(&pending, (nfds_t)1, waitMillis);
			if (ready < 0 && errno == EINTR) { continue; }
			if (ready < 0) { return -1; }
			return ready == 0 ? 0 : (int)pending.revents;
		}
		return -1;
	}

	class bool passwordInputHidden(int fd) {
		if (fd < 0) { return false; }
		struct termios attributes;
		int status = tcgetattr(fd, &attributes);
		while (status != 0 && errno == EINTR) {
			status = tcgetattr(fd, &attributes);
		}
		return status == 0 && (((uintmax_t)attributes.c_lflag & (uintmax_t)ECHO) == (uintmax_t)0);
	}

	class bool safeResponse(string value) { return value != null && value.len() <= 4096 && !value.contains("\n") && !value.contains("\r"); }

	class bool writeBytesUntil(int fd, char* bytes, size_t length, long long deadline) {
		size_t offset = 0;
		while (offset < length) {
			int events = UnixPasswdPromptExchange.pollUntil(fd, POLLOUT, deadline, INT_MAX);
			if (events <= 0 || (events & POLLOUT) == 0) { return false; }
			ssize_t written = write(fd, bytes + offset, length - offset);
			if (written > (ssize_t)0) {
				offset += (size_t)written;
			} else if (written < (ssize_t)0 && errno == EINTR) {
				continue;
			} else if (written < (ssize_t)0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
				continue;
			} else {
				return false;
			}
		}
		return true;
	}

	class bool writeResponseUntil(int fd, string value, long long deadline) {
		if (fd < 0 || !UnixPasswdPromptExchange.safeResponse(value)) {
			return false;
		}
		if (!UnixPasswdPromptExchange.writeBytesUntil(fd, (char*)value, strlen(value), deadline)) {
			return false;
		}
		return UnixPasswdPromptExchange.writeBytesUntil(fd, (char*)"\n", (size_t)1, deadline);
	}

	/* Consume exactly two (root) or three (self-service) ordered prompts.
     * Secrets are sent only after the complete classifier state is quiet and
     * tcgetattr proves the PTY slave currently has ECHO disabled. */
	class bool answer(int fd, Vector<string> responses, int responseCount, long long deadline) {
		if (fd < 0 || responses == null || responses.len < responseCount || (responseCount != 2 && responseCount != 3)) {
			return false;
		}
		for (int i = 0; i < responseCount; i++) {
			if (!UnixPasswdPromptExchange.safeResponse(responses.get(i))) {
				return false;
			}
		}

		UnixPasswdPromptClassifier classifier = UnixPasswdPromptClassifier(responseCount);
		int response = 0;
		char buffer[4096];
		while (TerminalClock.milliseconds() < deadline && response < responseCount) {
			int ready = UnixPasswdPromptExchange.pollUntil(fd, POLLIN, deadline, 1000);
			if (ready <= 0) {
				if (ready < 0) { return false; }
				continue;
			}
			if ((ready & POLLIN) == 0) { return false; }
			ssize_t count = read(fd, buffer, sizeof(buffer));
			if (count < (ssize_t)0 && errno == EINTR) { continue; }
			if (count < (ssize_t)0 && (errno == EAGAIN || errno == EWOULDBLOCK)) {
				continue;
			}
			if (count <= (ssize_t)0) { return false; }

			bool prompt = false;
			bool completeCandidate = classifier.feedRaw(buffer, (int)count);
			if (completeCandidate || classifier.incompleteCandidate()) {
				int trailing = UnixPasswdPromptExchange.pollUntil(fd, POLLIN, deadline, UnixPasswdPromptExchange.quietIntervalMilliseconds());
				if (trailing < 0) { return false; }
				if (trailing == 0) {
					if (!completeCandidate) { return false; }
					if (!UnixPasswdPromptExchange.passwordInputHidden(fd)) {
						return false;
					}
					prompt = classifier.acceptPending();
				} else if ((trailing & POLLIN) == 0) {
					return false;
				} else {
					continue;
				}
			}
			if (prompt) {
				if (!UnixPasswdPromptExchange.writeResponseUntil(fd, responses.get(response), deadline)) {
					return false;
				}
				response++;
			}
		}
		return response == responseCount && classifier.complete();
	}
}
