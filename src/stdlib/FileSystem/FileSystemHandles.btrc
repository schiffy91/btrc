/* Owned, exact filesystem handles.
 *
 * Operations expose copied BTRC values and typed outcomes. Native descriptors
 * remain private, each read or directory advance performs bounded work, and
 * callers retain ownership of traversal, byte, and cancellation budgets.
 */

import Library.Bytes;
import Library.IO;
import Library.Platform;
import Library.Strings;

#include <dirent.h>
#include <errno.h>
#include <fcntl.h>
#include <limits.h>
#include <stdlib.h>
#include <string.h>
#include <sys/file.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <time.h>
#include <unistd.h>

/* Counts only the long-lived exact filesystem handle capabilities
 * owned by this generated program. It never probes native descriptor tables,
 * so the diagnostic has identical semantics on every supported platform.
 * Static Atomic<T> storage is zero-initialized before program entry. */
static Atomic<int> btrcOwnedExactFileSystemHandles;

static void btrcOwnExactFileSystemHandle() {
	int previous = btrcOwnedExactFileSystemHandles.fetchAdd(1, MemoryOrder.RELAXED);
	if (previous < 0) {
		fprintf(stderr, "filesystem handle inventory overflowed\n");
		abort();
	}
}

static void btrcReleaseExactFileSystemHandle() {
	int previous = btrcOwnedExactFileSystemHandles.fetchSub(1, MemoryOrder.RELAXED);
	if (previous <= 0) {
		fprintf(stderr, "filesystem handle inventory underflowed\n");
		abort();
	}
}

enum FileSystemErrorKind {
	FS_INVALID_ARGUMENT = 0,
	FS_NOT_FOUND = 1,
	FS_ACCESS_DENIED = 2,
	FS_SYMLINK = 3,
	FS_WRONG_TYPE = 4,
	FS_CHANGED = 5,
	FS_RESOURCE_EXHAUSTED = 6,
	FS_IO = 7,
	FS_CLOSED = 8,
	FS_UNSUPPORTED = 9
};

enum FileReadKind {
	FILE_READ_DATA = 0,
	FILE_READ_END = 1,
	FILE_READ_FAILED = 2
};

enum DirectoryStepKind {
	DIRECTORY_STEP_ENTRY = 0,
	DIRECTORY_STEP_END = 1,
	DIRECTORY_STEP_FAILED = 2
};

enum FileSystemCloseKind {
	FS_CLOSED_NOW = 0,
	FS_ALREADY_CLOSED = 1,
	FS_CLOSE_FAILED = 2
};

enum PrivateFileReadKind {
	PRIVATE_FILE_DATA = 0,
	PRIVATE_FILE_MISSING = 1,
	PRIVATE_FILE_READ_FAILED = 2
};

enum DurableReplaceKind {
	DURABLE_REPLACE_COMMITTED = 0,
	DURABLE_REPLACE_FAILED = 1,
	DURABLE_REPLACE_DURABILITY_UNCERTAIN = 2
};

class FileSystemError {
	private FileSystemErrorKind _kind;
	private string _operation;
	private string _path;
	private int _nativeCode;
	private string _message;

	public FileSystemError(FileSystemErrorKind kind, string operation, string path, int nativeCode, string message) {
		self._kind = kind;
		self._operation = operation == null ? "" : operation;
		self._path = path == null ? "" : path;
		self._nativeCode = nativeCode;
		self._message = message == null ? "" : message;
	}

	class FileSystemError invalid(string operation, string path) { return FileSystemError(FS_INVALID_ARGUMENT, operation, path, 0, "filesystem argument is invalid"); }

	class FileSystemError closed(string operation, string path) { return FileSystemError(FS_CLOSED, operation, path, 0, "filesystem handle is closed"); }

	class FileSystemError unsupported(string operation, string path) { return FileSystemError(FS_UNSUPPORTED, operation, path, 0, "exact filesystem handles are unsupported"); }

	class FileSystemError changed(string operation, string path, int nativeCode = 0) { return FileSystemError(FS_CHANGED, operation, path, nativeCode, "filesystem entry changed during the operation"); }

	class FileSystemError symlink(string operation, string path) { return FileSystemError(FS_SYMLINK, operation, path, ELOOP, "filesystem operation refuses a symbolic link"); }

	class FileSystemError wrongType(string operation, string path) { return FileSystemError(FS_WRONG_TYPE, operation, path, 0, "filesystem entry has the wrong type"); }

	class FileSystemError fromNative(string operation, string path, int nativeCode) {
		FileSystemErrorKind kind = FS_IO;
		if (nativeCode == EINVAL || nativeCode == ENAMETOOLONG) {
			kind = FS_INVALID_ARGUMENT;
		} else if (nativeCode == ENOENT) {
			kind = FS_NOT_FOUND;
		} else if (nativeCode == EACCES || nativeCode == EPERM) {
			kind = FS_ACCESS_DENIED;
		} else if (nativeCode == ELOOP) {
			kind = FS_SYMLINK;
		} else if (nativeCode == ENOTDIR || nativeCode == EISDIR) {
			kind = FS_WRONG_TYPE;
		} else if (nativeCode == EMFILE || nativeCode == ENFILE || nativeCode == ENOMEM || nativeCode == EOVERFLOW || nativeCode == EAGAIN || nativeCode == ENOSPC || nativeCode == EFBIG) {
			kind = FS_RESOURCE_EXHAUSTED;
		} else if (nativeCode == ENOSYS || nativeCode == ENOTSUP) {
			kind = FS_UNSUPPORTED;
		}
		return FileSystemError(kind, operation, path, nativeCode, Strings.copy(strerror(nativeCode)));
	}

	/* A target that vanished, became a symlink or changed type while an
	 * operation held its earlier identity is a change, not an absence. */
	public FileSystemError asChange(string operation, string path) {
		if (self._kind == FS_NOT_FOUND || self._kind == FS_SYMLINK || self._kind == FS_WRONG_TYPE) {
			return FileSystemError.changed(operation, path, self._nativeCode);
		}
		return self;
	}

	public FileSystemErrorKind kind() { return self._kind; }

	public string operation() { return self._operation; }

	public string path() { return self._path; }

	public int nativeCode() { return self._nativeCode; }

	public string message() { return self._message; }
}

/* The one value-or-error outcome of every FileSystem open, read, snapshot and
 * resolution: FileSystemOutcome<FileHandle>, <DirectoryHandle>, <Bytes> and so
 * on. A producer passes exactly one of a value and an error, so ok() is true
 * when no error was recorded. Outcomes with a third, non-error terminal state
 * (end of data, a missing file, an already closed handle) keep their own
 * kinded types; see the package README. */
class FileSystemOutcome<T> {
	private T _value;
	private FileSystemError? _error;

	public FileSystemOutcome(T value, FileSystemError? error) {
		self._value = value;
		self._error = error;
	}

	public bool ok() { return self._error == null; }

	public T value() {
		if (self._error != null) { throw "failed filesystem outcome has no value"; }
		return self._value;
	}

	public FileSystemError error() {
		if (self._error == null) { throw "successful filesystem outcome has no error"; }
		return self._error;
	}
}

class FileReadOutcome {
	private FileReadKind _kind;
	private Bytes? _bytes;
	private FileSystemError? _error;

	private FileReadOutcome(FileReadKind kind, Bytes? bytes, FileSystemError? error) {
		self._kind = kind;
		self._bytes = bytes;
		self._error = error;
	}

	class FileReadOutcome data(Bytes bytes) {
		if (bytes == null || bytes.isEmpty()) {
			throw "filesystem data read must contain bytes";
		}
		return FileReadOutcome(FILE_READ_DATA, bytes, null);
	}

	class FileReadOutcome end() { return FileReadOutcome(FILE_READ_END, null, null); }

	class FileReadOutcome failed(FileSystemError error) {
		if (error == null) { throw "file read error is null"; }
		return FileReadOutcome(FILE_READ_FAILED, null, error);
	}

	public FileReadKind kind() { return self._kind; }

	public bool ok() { return self._kind != FILE_READ_FAILED; }

	public Bytes bytes() {
		if (self._bytes == null) { throw "file read has no data"; }
		return self._bytes;
	}

	public FileSystemError error() {
		if (self._error == null) { throw "file read has no error"; }
		return self._error;
	}
}

class DirectoryEntry {
	private DirectoryHandle _owner;
	private string _name;
	private string _path;
	private FileSnapshot _snapshot;

	public DirectoryEntry(DirectoryHandle owner, string name, string path, FileSnapshot snapshot) {
		if (owner == null || name == null || name.isEmpty() || path == null || path.isEmpty() || snapshot == null) {
			throw "invalid directory entry";
		}
		self._owner = owner;
		self._name = name;
		self._path = path;
		self._snapshot = snapshot;
	}

	public string name() { return self._name; }

	public string path() { return self._path; }

	public FileSnapshot snapshot() { return self._snapshot; }

	public bool belongsTo(DirectoryHandle directory) { return directory != null && self._owner == directory; }
}

class DirectoryStepOutcome {
	private DirectoryStepKind _kind;
	private DirectoryEntry? _entry;
	private FileSystemError? _error;

	private DirectoryStepOutcome(DirectoryStepKind kind, DirectoryEntry? entry, FileSystemError? error) {
		self._kind = kind;
		self._entry = entry;
		self._error = error;
	}

	class DirectoryStepOutcome withEntry(DirectoryEntry entry) {
		if (entry == null) { throw "directory step entry is null"; }
		return DirectoryStepOutcome(DIRECTORY_STEP_ENTRY, entry, null);
	}

	class DirectoryStepOutcome end() { return DirectoryStepOutcome(DIRECTORY_STEP_END, null, null); }

	class DirectoryStepOutcome failed(FileSystemError error) {
		if (error == null) { throw "directory step error is null"; }
		return DirectoryStepOutcome(DIRECTORY_STEP_FAILED, null, error);
	}

	public DirectoryStepKind kind() { return self._kind; }

	public bool ok() { return self._kind != DIRECTORY_STEP_FAILED; }

	public DirectoryEntry entry() {
		if (self._entry == null) { throw "directory step has no entry"; }
		return self._entry;
	}

	public FileSystemError error() {
		if (self._error == null) { throw "directory step has no error"; }
		return self._error;
	}
}

class FileSystemCloseOutcome {
	private FileSystemCloseKind _kind;
	private FileSystemError? _error;

	private FileSystemCloseOutcome(FileSystemCloseKind kind, FileSystemError? error) {
		self._kind = kind;
		self._error = error;
	}

	class FileSystemCloseOutcome closed() { return FileSystemCloseOutcome(FS_CLOSED_NOW, null); }

	class FileSystemCloseOutcome alreadyClosed() { return FileSystemCloseOutcome(FS_ALREADY_CLOSED, null); }

	class FileSystemCloseOutcome failed(FileSystemError error) {
		if (error == null) { throw "filesystem close error is null"; }
		return FileSystemCloseOutcome(FS_CLOSE_FAILED, error);
	}

	public FileSystemCloseKind kind() { return self._kind; }

	public bool ok() { return self._kind != FS_CLOSE_FAILED; }

	public FileSystemError error() {
		if (self._error == null) { throw "filesystem close has no error"; }
		return self._error;
	}
}

/* An immutable process-local diagnostic value for the exact file and
 * directory handles owned by BTRC's typed filesystem API: each open
 * FileHandle, DirectoryHandle, PrivateDirectory, ExclusiveFileLease and
 * AdvisoryFileLock counts once. Wrappers such as TemporaryDirectory and
 * RegularFileSnapshot are represented by the exact DirectoryHandle or
 * FileHandle they own. Native descriptors used transiently inside an
 * operation and resources owned by unrelated libraries are excluded.
 */
class FileSystemHandleInventory {
	private int _openCount;

	public FileSystemHandleInventory(int openCount) {
		if (openCount < 0) {
			throw "filesystem handle inventory cannot be negative";
		}
		self._openCount = openCount;
	}

	public int openCount() { return self._openCount; }

	public bool sameAs(FileSystemHandleInventory other) { return other != null && self._openCount == other._openCount; }
}

class FileSystemDiagnostics {
	class FileSystemHandleInventory ownedHandleInventory() {
		int count = btrcOwnedExactFileSystemHandles.load(MemoryOrder.RELAXED);
		if (count < 0) {
			fprintf(stderr, "filesystem handle inventory is negative\n");
			abort();
		}
		return FileSystemHandleInventory(count);
	}
}

class FileHandle {
	private int _descriptor;
	private string _path;
	private FileSnapshot? _openedSnapshot;

	private FileHandle(int descriptor, string path, FileSnapshot openedSnapshot) {
		self._descriptor = descriptor;
		self._path = path;
		self._openedSnapshot = openedSnapshot;
		btrcOwnExactFileSystemHandle();
	}

	class FileSystemOutcome<FileSnapshot> inspectExact(string path) {
		if (path == null || path.isEmpty()) {
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.invalid("inspect", path));
		}
		struct stat status;
		errno = 0;
		if (lstat(path, &status) != 0) {
			int nativeCode = errno;
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.fromNative("inspect", path, nativeCode));
		}
		return new FileSystemOutcome<FileSnapshot>(FileSnapshot.fromStatus(&status), null);
	}

	class FileSystemOutcome<FileHandle> openExact(string path) {
		if (path == null || path.isEmpty()) {
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.invalid("open file", path));
		}
		struct stat before;
		errno = 0;
		if (lstat(path, &before) != 0) {
			int nativeCode = errno;
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.fromNative("open file", path, nativeCode));
		}
		if (S_ISLNK(before.st_mode)) {
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.symlink("open file", path));
		}
		if (!S_ISREG(before.st_mode)) {
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.wrongType("open file", path));
		}

		errno = 0;
		int descriptor = open(path, (int)O_RDONLY | (int)O_CLOEXEC | (int)O_NOFOLLOW | (int)O_NONBLOCK);
		if (descriptor < 0) {
			int nativeCode = errno;
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.fromNative("open file", path, nativeCode));
		}

		struct stat opened;
		struct stat after;
		errno = 0;
		if (fstat(descriptor, &opened) != 0) {
			int nativeCode = errno;
			close(descriptor);
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.fromNative("inspect opened file", path, nativeCode));
		}
		if (!S_ISREG(opened.st_mode)) {
			close(descriptor);
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.wrongType("open file", path));
		}
		FileSnapshot beforeSnapshot = FileSnapshot.fromStatus(&before);
		FileSnapshot openedSnapshot = FileSnapshot.fromStatus(&opened);
		if (!openedSnapshot.sameVersion(beforeSnapshot)) {
			close(descriptor);
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.changed("open file", path));
		}
		errno = 0;
		if (lstat(path, &after) != 0) {
			int nativeCode = errno;
			close(descriptor);
			return new FileSystemOutcome<FileHandle>(null, nativeCode == ENOENT ? FileSystemError.changed("validate opened file", path, nativeCode) : FileSystemError.fromNative("validate opened file", path, nativeCode));
		}
		if (!openedSnapshot.sameVersion(FileSnapshot.fromStatus(&after))) {
			close(descriptor);
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.changed("validate opened file", path));
		}
		return new FileSystemOutcome<FileHandle>(FileHandle(descriptor, Strings.copy(path), openedSnapshot), null);
	}

	public bool isOpen() { return self._descriptor >= 0; }

	public string path() { return self._path; }

	public FileSnapshot openedSnapshot() {
		if (self._openedSnapshot == null) {
			throw "file handle has no opened snapshot";
		}
		return self._openedSnapshot;
	}

	public FileSystemOutcome<FileSnapshot> snapshot() {
		if (!self.isOpen()) {
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.closed("inspect open file", self._path));
		}
		struct stat status;
		errno = 0;
		if (fstat(self._descriptor, &status) != 0) {
			int nativeCode = errno;
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.fromNative("inspect open file", self._path, nativeCode));
		}
		return new FileSystemOutcome<FileSnapshot>(FileSnapshot.fromStatus(&status), null);
	}

	public FileReadOutcome readAt(long long offset, int maximumBytes) {
		if (offset < 0LL || maximumBytes <= 0) {
			return FileReadOutcome.failed(FileSystemError.invalid("read file", self._path));
		}
		if (!self.isOpen()) {
			return FileReadOutcome.failed(FileSystemError.closed("read file", self._path));
		}
		off_t nativeOffset = (off_t)offset;
		if ((long long)nativeOffset != offset) {
			return FileReadOutcome.failed(FileSystemError.invalid("read file", self._path));
		}
		char* buffer = (char*)malloc((size_t)maximumBytes);
		if (buffer == null) {
			return FileReadOutcome.failed(FileSystemError(FS_RESOURCE_EXHAUSTED, "read file", self._path, ENOMEM, "filesystem read buffer allocation failed"));
		}
		errno = 0;
		ssize_t length = pread(self._descriptor, buffer, (size_t)maximumBytes, nativeOffset);
		if (length < (ssize_t)0) {
			int nativeCode = errno;
			free(buffer);
			return FileReadOutcome.failed(FileSystemError.fromNative("read file", self._path, nativeCode));
		}
		if (length == (ssize_t)0) {
			free(buffer);
			return FileReadOutcome.end();
		}
		Bytes bytes = Bytes.fromRaw(buffer, (int)length);
		free(buffer);
		return FileReadOutcome.data(bytes);
	}

	public FileSystemCloseOutcome close() {
		if (!self.isOpen()) {
			return FileSystemCloseOutcome.alreadyClosed();
		}
		int descriptor = self._descriptor;
		self._descriptor = -1;
		btrcReleaseExactFileSystemHandle();
		errno = 0;
		if (close(descriptor) != 0) {
			int nativeCode = errno;
			return FileSystemCloseOutcome.failed(FileSystemError.fromNative("close file", self._path, nativeCode));
		}
		return FileSystemCloseOutcome.closed();
	}

	public void __del__() { self.close(); }
}

/* Immutable-version, read-only regular-file capability for format packages.
 * maximumBytes is fixed at open. Every successful read is exact-length and,
 * in the POSIX backend, is correlated with both the pinned descriptor and the
 * named path before and after I/O. Native descriptors never cross this API.
 */
/* Validate both a held object and the path that originally selected it. */
class ExactFileSnapshot {
	class FileSystemError? validate(FileSnapshot expected, FileSystemOutcome<FileSnapshot> held, string path, string operation) {
		if (expected == null || held == null || path == null || path.isEmpty() || operation == null || operation.isEmpty()) {
			return FileSystemError.invalid(operation, path);
		}
		if (!held.ok()) { return held.error(); }
		if (!expected.sameVersion(held.value())) {
			return FileSystemError.changed(operation, path);
		}
		FileSystemOutcome<FileSnapshot> named = FileHandle.inspectExact(path);
		if (!named.ok()) { return named.error().asChange(operation, path); }
		if (!expected.sameVersion(named.value())) {
			return FileSystemError.changed(operation, path);
		}
		return null;
	}
}

class RegularFileSnapshot {
	private FileHandle? _file;
	private FileSnapshot? _revision;
	private string _path;
	private long long _maximumBytes;
	private int _generation;
	private int _openGeneration;

	private RegularFileSnapshot(FileHandle file, FileSnapshot revision, string path, long long maximumBytes) {
		if (file == null || revision == null || path == null || path.isEmpty() || maximumBytes < 0LL) {
			throw "invalid regular file snapshot";
		}
		self._file = file;
		self._revision = revision;
		self._path = path;
		self._maximumBytes = maximumBytes;
		self._generation = 1;
		self._openGeneration = 1;
	}

	class FileSystemOutcome<RegularFileSnapshot> open(string path, long long maximumBytes) {
		if (path == null || path.isEmpty() || maximumBytes < 0LL) {
			return new FileSystemOutcome<RegularFileSnapshot>(null, FileSystemError.invalid("open regular file snapshot", path));
		}
		if (Platform.isWindows()) {
			return new FileSystemOutcome<RegularFileSnapshot>(null, FileSystemError.unsupported("open regular file snapshot", path));
		}
		FileSystemOutcome<FileHandle> opened = FileHandle.openExact(path);
		if (!opened.ok()) {
			return new FileSystemOutcome<RegularFileSnapshot>(null, opened.error());
		}
		FileHandle file = opened.value();
		FileSnapshot revision = file.openedSnapshot();
		if (revision.size() < 0LL || revision.size() > maximumBytes) {
			file.close();
			return new FileSystemOutcome<RegularFileSnapshot>(null, FileSystemError(FS_RESOURCE_EXHAUSTED, "open regular file snapshot", path, EFBIG, "regular file exceeds the caller's open budget"));
		}
		RegularFileSnapshot snapshot = RegularFileSnapshot(file, revision, Strings.copy(path), maximumBytes);
		FileSystemError? validation = snapshot.currentVersionError("validate regular file snapshot");
		if (validation != null) {
			snapshot.close();
			return new FileSystemOutcome<RegularFileSnapshot>(null, validation);
		}
		return new FileSystemOutcome<RegularFileSnapshot>(snapshot, null);
	}

	public bool isOpen() { return self._file != null && self._generation == self._openGeneration && self._file.isOpen(); }

	public string path() { return self._path; }

	public long long size() {
		if (self._revision == null) {
			throw "regular file snapshot has no revision";
		}
		return self._revision.size();
	}

	/* FileSnapshot is immutable; cacheToken() returns fresh opaque bytes when
     * a package needs a persistent or hashed revision representation. */
	public FileSnapshot revision() {
		if (self._revision == null) {
			throw "regular file snapshot has no revision";
		}
		return self._revision;
	}

	private FileSystemError? currentVersionError(string operation) {
		if (!self.isOpen() || self._file == null || self._revision == null) {
			return FileSystemError.closed(operation, self._path);
		}
		return ExactFileSnapshot.validate(self.revision(), self._file.snapshot(), self._path, operation);
	}

	/* An exact positional read has only a byte value or a typed failure.
	 * Empty Bytes are a valid value when byteCount is zero; short reads never
	 * escape as partial success. */
	public FileSystemOutcome<Bytes> readExactAt(long long offset, int byteCount) {
		if (offset < 0LL || byteCount < 0) {
			return new FileSystemOutcome<Bytes>(null, FileSystemError.invalid("read regular file snapshot", self._path));
		}
		if (!self.isOpen()) {
			return new FileSystemOutcome<Bytes>(null, FileSystemError.closed("read regular file snapshot", self._path));
		}
		long long exactLength = (long long)byteCount;
		long long snapshotSize = self.size();
		if (offset > snapshotSize || exactLength > snapshotSize - offset || snapshotSize > self._maximumBytes) {
			return new FileSystemOutcome<Bytes>(null, FileSystemError.invalid("read regular file snapshot", self._path));
		}
		FileSystemError? before = self.currentVersionError("validate regular file snapshot before read");
		if (before != null) {
			return new FileSystemOutcome<Bytes>(null, before);
		}

		Bytes result = Bytes();
		long long cursor = offset;
		int remaining = byteCount;
		while (remaining > 0) {
			if (self._file == null) {
				return new FileSystemOutcome<Bytes>(null, FileSystemError.closed("read regular file snapshot", self._path));
			}
			FileReadOutcome part = self._file.readAt(cursor, remaining);
			if (!part.ok()) {
				FileSystemError? afterFailure = self.currentVersionError("validate regular file snapshot after failed read");
				return new FileSystemOutcome<Bytes>(null, afterFailure == null ? part.error() : afterFailure);
			}
			if (part.kind() == FILE_READ_END) {
				FileSystemError? afterEnd = self.currentVersionError("validate regular file snapshot after short read");
				return new FileSystemOutcome<Bytes>(null, afterEnd == null ? FileSystemError.changed("read regular file snapshot", self._path) : afterEnd);
			}
			Bytes bytes = part.bytes();
			int length = bytes.length();
			if (length <= 0 || length > remaining) {
				return new FileSystemOutcome<Bytes>(null, FileSystemError(FS_IO, "read regular file snapshot", self._path, EIO, "regular file returned an invalid partial read"));
			}
			result.appendBytes(bytes);
			remaining = remaining - length;
			cursor = cursor + (long long)length;
		}

		FileSystemError? after = self.currentVersionError("validate regular file snapshot after read");
		if (after != null) {
			return new FileSystemOutcome<Bytes>(null, after);
		}
		return new FileSystemOutcome<Bytes>(result, null);
	}

	public FileSystemCloseOutcome close() {
		if (!self.isOpen()) {
			return FileSystemCloseOutcome.alreadyClosed();
		}
		self._generation++;
		if (self._file == null) {
			return FileSystemCloseOutcome.alreadyClosed();
		}
		return self._file.close();
	}

	public void __del__() { self.close(); }
}

class DirectoryHandle {
	private DIR* _directory;
	private string _path;
	private FileSnapshot? _openedSnapshot;

	private DirectoryHandle(DIR* directory, string path, FileSnapshot openedSnapshot) {
		self._directory = directory;
		self._path = path;
		self._openedSnapshot = openedSnapshot;
		btrcOwnExactFileSystemHandle();
	}

	class FileSystemOutcome<DirectoryHandle> openExact(string path) {
		if (path == null || path.isEmpty()) {
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.invalid("open directory", path));
		}
		struct stat before;
		errno = 0;
		if (lstat(path, &before) != 0) {
			int nativeCode = errno;
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.fromNative("open directory", path, nativeCode));
		}
		if (S_ISLNK(before.st_mode)) {
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.symlink("open directory", path));
		}
		if (!S_ISDIR(before.st_mode)) {
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.wrongType("open directory", path));
		}

		errno = 0;
		int descriptor = open(path, (int)O_RDONLY | (int)O_DIRECTORY | (int)O_CLOEXEC | (int)O_NOFOLLOW | (int)O_NONBLOCK);
		if (descriptor < 0) {
			int nativeCode = errno;
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.fromNative("open directory", path, nativeCode));
		}

		struct stat opened;
		struct stat after;
		errno = 0;
		if (fstat(descriptor, &opened) != 0) {
			int nativeCode = errno;
			close(descriptor);
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.fromNative("inspect opened directory", path, nativeCode));
		}
		if (!S_ISDIR(opened.st_mode)) {
			close(descriptor);
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.wrongType("open directory", path));
		}
		FileSnapshot beforeSnapshot = FileSnapshot.fromStatus(&before);
		FileSnapshot openedSnapshot = FileSnapshot.fromStatus(&opened);
		if (!openedSnapshot.sameVersion(beforeSnapshot)) {
			close(descriptor);
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.changed("open directory", path));
		}
		errno = 0;
		if (lstat(path, &after) != 0) {
			int nativeCode = errno;
			close(descriptor);
			return new FileSystemOutcome<DirectoryHandle>(null, nativeCode == ENOENT ? FileSystemError.changed("validate opened directory", path, nativeCode) : FileSystemError.fromNative("validate opened directory", path, nativeCode));
		}
		if (!openedSnapshot.sameVersion(FileSnapshot.fromStatus(&after))) {
			close(descriptor);
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.changed("validate opened directory", path));
		}
		errno = 0;
		DIR* directory = fdopendir(descriptor);
		if (directory == null) {
			int nativeCode = errno;
			close(descriptor);
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.fromNative("stream directory", path, nativeCode));
		}
		return new FileSystemOutcome<DirectoryHandle>(DirectoryHandle(directory, Strings.copy(path), openedSnapshot), null);
	}

	public bool isOpen() { return self._directory != null; }

	public string path() { return self._path; }

	public FileSnapshot openedSnapshot() {
		if (self._openedSnapshot == null) {
			throw "directory handle has no opened snapshot";
		}
		return self._openedSnapshot;
	}

	private bool validEntry(DirectoryEntry entry) { return entry != null && entry.belongsTo(self) && !entry.name().isEmpty() && !entry.name().equals(".") && !entry.name().equals("..") && !entry.name().contains("/"); }

	private string entryPath(DirectoryEntry entry) { return self._path.endsWith("/") ? self._path + entry.name() : self._path + "/" + entry.name(); }

	public FileSystemOutcome<FileSnapshot> snapshot() {
		if (!self.isOpen()) {
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.closed("inspect open directory", self._path));
		}
		struct stat status;
		errno = 0;
		if (fstat(dirfd(self._directory), &status) != 0) {
			int nativeCode = errno;
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.fromNative("inspect open directory", self._path, nativeCode));
		}
		return new FileSystemOutcome<FileSnapshot>(FileSnapshot.fromStatus(&status), null);
	}

	public DirectoryStepOutcome next() {
		if (!self.isOpen()) {
			return DirectoryStepOutcome.failed(FileSystemError.closed("read directory", self._path));
		}
		int skipped = 0;
		while (skipped <= 2) {
			errno = 0;
			struct dirent* nativeEntry = readdir(self._directory);
			if (nativeEntry == null) {
				int nativeCode = errno;
				if (nativeCode == 0) { return DirectoryStepOutcome.end(); }
				return DirectoryStepOutcome.failed(FileSystemError.fromNative("read directory", self._path, nativeCode));
			}
			string borrowedName = nativeEntry->d_name;
			if (borrowedName.equals(".") || borrowedName.equals("..")) {
				skipped++;
				continue;
			}
			string name = Strings.copy(borrowedName);
			string childPath = self._path.endsWith("/") ? self._path + name : self._path + "/" + name;
			struct stat status;
			errno = 0;
			if (fstatat(dirfd(self._directory), name, &status, AT_SYMLINK_NOFOLLOW) != 0) {
				int nativeCode = errno;
				return DirectoryStepOutcome.failed(nativeCode == ENOENT ? FileSystemError.changed("inspect directory entry", childPath, nativeCode) : FileSystemError.fromNative("inspect directory entry", childPath, nativeCode));
			}
			return DirectoryStepOutcome.withEntry(DirectoryEntry(self, name, childPath, FileSnapshot.fromStatus(&status)));
		}
		return DirectoryStepOutcome.failed(FileSystemError(FS_IO, "read directory", self._path, EIO, "directory returned too many dot entries"));
	}

	public FileSystemOutcome<FileSnapshot> inspect(DirectoryEntry entry) {
		if (!self.validEntry(entry)) {
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.invalid("inspect directory entry", self._path));
		}
		if (!self.isOpen()) {
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.closed("inspect directory entry", entry.path()));
		}
		struct stat status;
		errno = 0;
		if (fstatat(dirfd(self._directory), entry.name(), &status, AT_SYMLINK_NOFOLLOW) != 0) {
			int nativeCode = errno;
			return new FileSystemOutcome<FileSnapshot>(null, nativeCode == ENOENT ? FileSystemError.changed("inspect directory entry", entry.path(), nativeCode) : FileSystemError.fromNative("inspect directory entry", entry.path(), nativeCode));
		}
		FileSnapshot current = FileSnapshot.fromStatus(&status);
		if (!current.sameVersion(entry.snapshot())) {
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.changed("inspect directory entry", entry.path()));
		}
		return new FileSystemOutcome<FileSnapshot>(current, null);
	}

	public FileSystemOutcome<FileHandle> openFile(DirectoryEntry entry) {
		if (!self.validEntry(entry)) {
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.invalid("open directory file", self._path));
		}
		if (!self.isOpen()) {
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.closed("open directory file", entry.path()));
		}
		if (entry.snapshot().kind() != FILE_REGULAR) {
			return new FileSystemOutcome<FileHandle>(null, entry.snapshot().kind() == FILE_SYMLINK ? FileSystemError.symlink("open directory file", entry.path()) : FileSystemError.wrongType("open directory file", entry.path()));
		}
		FileSystemOutcome<FileSnapshot> validation = self.inspect(entry);
		if (!validation.ok()) {
			return new FileSystemOutcome<FileHandle>(null, validation.error());
		}
		string childPath = self.entryPath(entry);
		FileSystemOutcome<FileHandle> opened = FileHandle.openExact(childPath);
		if (!opened.ok()) {
			return new FileSystemOutcome<FileHandle>(null, opened.error().asChange("open directory file", childPath));
		}
		FileHandle file = opened.value();
		if (!file.openedSnapshot().sameVersion(entry.snapshot())) {
			file.close();
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.changed("open directory file", entry.path()));
		}
		return opened;
	}

	public FileSystemOutcome<DirectoryHandle> openDirectory(DirectoryEntry entry) {
		if (!self.validEntry(entry)) {
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.invalid("open child directory", self._path));
		}
		if (!self.isOpen()) {
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.closed("open child directory", entry.path()));
		}
		if (entry.snapshot().kind() != FILE_DIRECTORY) {
			return new FileSystemOutcome<DirectoryHandle>(null, entry.snapshot().kind() == FILE_SYMLINK ? FileSystemError.symlink("open child directory", entry.path()) : FileSystemError.wrongType("open child directory", entry.path()));
		}
		FileSystemOutcome<FileSnapshot> validation = self.inspect(entry);
		if (!validation.ok()) {
			return new FileSystemOutcome<DirectoryHandle>(null, validation.error());
		}
		string childPath = self.entryPath(entry);
		FileSystemOutcome<DirectoryHandle> opened = DirectoryHandle.openExact(childPath);
		if (!opened.ok()) {
			return new FileSystemOutcome<DirectoryHandle>(null, opened.error().asChange("open child directory", childPath));
		}
		DirectoryHandle directory = opened.value();
		if (!directory.openedSnapshot().sameVersion(entry.snapshot())) {
			directory.close();
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.changed("open child directory", entry.path()));
		}
		return opened;
	}

	public FileSystemCloseOutcome close() {
		if (!self.isOpen()) {
			return FileSystemCloseOutcome.alreadyClosed();
		}
		DIR* directory = self._directory;
		self._directory = null;
		btrcReleaseExactFileSystemHandle();
		errno = 0;
		if (closedir(directory) != 0) {
			int nativeCode = errno;
			return FileSystemCloseOutcome.failed(FileSystemError.fromNative("close directory", self._path, nativeCode));
		}
		return FileSystemCloseOutcome.closed();
	}

	public void __del__() { self.close(); }
}

/* The one descriptor-relative recursive delete behind both
 * TemporaryDirectory.close() and FileSystem.removeRecursive(). POSIX has no
 * unlink-by-descriptor operation, so a caller that needs stronger
 * concurrent-rename guarantees serializes mutations in the parent; a caller
 * holding an open lease on the root additionally prevents inode reuse. */
class DirectoryTreeRemoval {
	/* Remove `name` below an open directory: 0 when it is gone (or was never
	 * there), -2 when it is not `expected` or changed during removal, -1 on
	 * any other failure. Each directory is opened without following its final
	 * component, its root identity is refused, and it gains owner write and
	 * search permission so its own entries can be unlinked. Its identity is
	 * revalidated immediately before unlinkat(). */
	class int removeAt(int parentDescriptor, string name, FileSnapshot? expected) {
		struct stat named;
		errno = 0;
		if (fstatat(parentDescriptor, name, &named, AT_SYMLINK_NOFOLLOW) != 0) {
			return errno == ENOENT ? 0 : -1;
		}
		FileSnapshot namedSnapshot = FileSnapshot.fromStatus(&named);
		if (expected != null && !namedSnapshot.sameObject(expected)) {
			return -2;
		}
		if (!S_ISDIR(named.st_mode)) {
			return unlinkat(parentDescriptor, name, 0) == 0 ? 0 : -1;
		}

		errno = 0;
		int descriptor = openat(parentDescriptor, name, (int)O_RDONLY | (int)O_DIRECTORY | (int)O_CLOEXEC | (int)O_NOFOLLOW | (int)O_NONBLOCK);
		if (descriptor < 0) { return -1; }
		struct stat opened;
		struct stat root;
		if (fstat(descriptor, &opened) != 0 || stat("/", &root) != 0 || !S_ISDIR(opened.st_mode) || opened.st_dev != named.st_dev || opened.st_ino != named.st_ino || (opened.st_dev == root.st_dev && opened.st_ino == root.st_ino)) {
			close(descriptor);
			return -2;
		}
		mode_t required = (mode_t)S_IWUSR | (mode_t)S_IXUSR;
		if ((((mode_t)opened.st_mode) & required) != required && fchmod(descriptor, ((mode_t)opened.st_mode) | required) != 0) {
			close(descriptor);
			return -1;
		}
		DIR* directory = fdopendir(descriptor);
		if (directory == null) {
			close(descriptor);
			return -1;
		}

		int result = 0;
		while (true) {
			errno = 0;
			struct dirent* entry = readdir(directory);
			if (entry == null) {
				if (errno != 0) { result = -1; }
				break;
			}
			string borrowedName = entry->d_name;
			if (borrowedName.equals(".") || borrowedName.equals("..")) {
				continue;
			}
			string childName = Strings.copy(borrowedName);
			result = DirectoryTreeRemoval.removeAt(dirfd(directory), childName, null);
			if (result != 0) { break; }
		}
		if (closedir(directory) != 0 && result == 0) { result = -1; }
		if (result != 0) { return result; }

		struct stat finalStatus;
		if (fstatat(parentDescriptor, name, &finalStatus, AT_SYMLINK_NOFOLLOW) != 0 || !S_ISDIR(finalStatus.st_mode) || finalStatus.st_dev != opened.st_dev || finalStatus.st_ino != opened.st_ino) {
			return -2;
		}
		return unlinkat(parentDescriptor, name, AT_REMOVEDIR) == 0 ? 0 : -1;
	}
}

class TemporaryDirectory {
	private string _path;
	private bool _open;
	private DirectoryHandle _lease;

	private TemporaryDirectory(string path, DirectoryHandle lease) {
		self._path = path;
		self._open = true;
		self._lease = lease;
	}

	/* A prefix names one leaf: never empty, a dot entry or a separator. */
	class bool validPrefix(string prefix) { return prefix != null && !prefix.isEmpty() && !prefix.equals(".") && !prefix.equals("..") && !prefix.contains("/") && !prefix.contains("\\") && !prefix.contains(":"); }

	class string templatePath(string prefix) {
		string base = Environment.get("TMPDIR", "/tmp");
		return base.endsWith("/") ? base + prefix + ".XXXXXX" : base + "/" + prefix + ".XXXXXX";
	}

	/* Create a fresh private directory from a mkdtemp template and return its
	 * canonical path. On failure nothing is left behind, errno holds the
	 * cause and the result is empty. FileSystem.tempDir uses this too, so both
	 * creators fail the same way when the new directory cannot be resolved. */
	class string reservePath(string templatePath) {
		size_t length = strlen(templatePath);
		char* raw = (char*)malloc(length + (size_t)1);
		if (raw == null) {
			errno = ENOMEM;
			return "";
		}
		memcpy(raw, templatePath, length + (size_t)1);
		errno = 0;
		if (mkdtemp(raw) == null) {
			int nativeCode = errno;
			free(raw);
			errno = nativeCode;
			return "";
		}
		errno = 0;
		char* canonical = realpath(raw, null);
		if (canonical == null) {
			int nativeCode = errno;
			rmdir(raw);
			free(raw);
			errno = nativeCode;
			return "";
		}
		free(raw);
		return __btrc_string_adopt(canonical);
	}

	class FileSystemOutcome<TemporaryDirectory> create(string prefix) {
		if (!TemporaryDirectory.validPrefix(prefix)) {
			return new FileSystemOutcome<TemporaryDirectory>(null, FileSystemError.invalid("create temporary directory", prefix));
		}
		string templatePath = TemporaryDirectory.templatePath(prefix);
		string path = TemporaryDirectory.reservePath(templatePath);
		if (path.isEmpty()) {
			int nativeCode = errno;
			return new FileSystemOutcome<TemporaryDirectory>(null, FileSystemError.fromNative("create temporary directory", templatePath, nativeCode));
		}
		FileSystemOutcome<DirectoryHandle> opened = DirectoryHandle.openExact(path);
		if (!opened.ok()) {
			rmdir(path);
			return new FileSystemOutcome<TemporaryDirectory>(null, opened.error());
		}
		return new FileSystemOutcome<TemporaryDirectory>(TemporaryDirectory(path, opened.value()), null);
	}

	public bool isOpen() { return self._open; }

	public string path() { return self._path; }

	private string parentPath() {
		int separator = self._path.lastIndexOf("/");
		if (separator < 0) { return "."; }
		if (separator == 0) { return "/"; }
		return self._path.substring(0, separator);
	}

	private string baseName() {
		int separator = self._path.lastIndexOf("/");
		if (separator < 0) { return Strings.copy(self._path); }
		return self._path.substring(separator + 1, self._path.len() - separator - 1);
	}

	public FileSystemCloseOutcome close() {
		if (!self._open) { return FileSystemCloseOutcome.alreadyClosed(); }
		self._open = false;
		struct stat named;
		errno = 0;
		if (lstat(self._path, &named) != 0) {
			int nativeCode = errno;
			FileSystemCloseOutcome leaseClose = self._lease.close();
			if (nativeCode == ENOENT && leaseClose.ok()) {
				return FileSystemCloseOutcome.closed();
			}
			if (!leaseClose.ok()) { return leaseClose; }
			return FileSystemCloseOutcome.failed(FileSystemError.fromNative("remove temporary directory", self._path, nativeCode));
		}
		FileSnapshot current = FileSnapshot.fromStatus(&named);
		if (!S_ISDIR(named.st_mode) || !current.sameObject(self._lease.openedSnapshot())) {
			self._lease.close();
			return FileSystemCloseOutcome.failed(FileSystemError.changed("remove temporary directory", self._path));
		}
		string parent = self.parentPath();
		string name = self.baseName();
		errno = 0;
		int parentDescriptor = open(parent, (int)O_RDONLY | (int)O_DIRECTORY | (int)O_CLOEXEC | (int)O_NOFOLLOW | (int)O_NONBLOCK);
		if (parentDescriptor < 0) {
			int nativeCode = errno;
			self._lease.close();
			return FileSystemCloseOutcome.failed(FileSystemError.fromNative("open temporary directory parent", parent, nativeCode));
		}
		int removed = DirectoryTreeRemoval.removeAt(parentDescriptor, name, self._lease.openedSnapshot());
		int nativeCode = errno;
		close(parentDescriptor);
		FileSystemCloseOutcome leaseClose = self._lease.close();
		if (removed == -2) {
			return FileSystemCloseOutcome.failed(FileSystemError.changed("remove temporary directory", self._path, nativeCode));
		}
		if (removed != 0) {
			return FileSystemCloseOutcome.failed(FileSystemError(FS_IO, "remove temporary directory", self._path, nativeCode, "temporary directory cleanup failed"));
		}
		if (!leaseClose.ok()) { return leaseClose; }
		return FileSystemCloseOutcome.closed();
	}

	public void __del__() { self.close(); }
}

class PrivateFileReadOutcome {
	private PrivateFileReadKind _kind;
	private Bytes? _bytes;
	private FileSystemError? _error;

	private PrivateFileReadOutcome(PrivateFileReadKind kind, Bytes? bytes, FileSystemError? error) {
		self._kind = kind;
		self._bytes = bytes;
		self._error = error;
	}

	class PrivateFileReadOutcome data(Bytes bytes) {
		if (bytes == null) { throw "private file bytes are null"; }
		return PrivateFileReadOutcome(PRIVATE_FILE_DATA, bytes, null);
	}

	class PrivateFileReadOutcome missing() { return PrivateFileReadOutcome(PRIVATE_FILE_MISSING, null, null); }

	class PrivateFileReadOutcome failed(FileSystemError error) {
		if (error == null) { throw "private file read error is null"; }
		return PrivateFileReadOutcome(PRIVATE_FILE_READ_FAILED, null, error);
	}

	public PrivateFileReadKind kind() { return self._kind; }

	public bool ok() { return self._kind != PRIVATE_FILE_READ_FAILED; }

	public bool found() { return self._kind == PRIVATE_FILE_DATA; }

	public Bytes bytes() {
		if (self._bytes == null) { throw "private file read has no data"; }
		return self._bytes;
	}

	public FileSystemError error() {
		if (self._error == null) { throw "private file read has no error"; }
		return self._error;
	}
}

class DurableReplaceOutcome {
	private DurableReplaceKind _kind;
	private FileSystemError? _error;

	private DurableReplaceOutcome(DurableReplaceKind kind, FileSystemError? error) {
		self._kind = kind;
		self._error = error;
	}

	class DurableReplaceOutcome succeeded() { return DurableReplaceOutcome(DURABLE_REPLACE_COMMITTED, null); }

	class DurableReplaceOutcome failed(FileSystemError error) {
		if (error == null) { throw "durable replace error is null"; }
		return DurableReplaceOutcome(DURABLE_REPLACE_FAILED, error);
	}

	class DurableReplaceOutcome durabilityUncertain(FileSystemError error) {
		if (error == null) { throw "durable replace error is null"; }
		return DurableReplaceOutcome(DURABLE_REPLACE_DURABILITY_UNCERTAIN, error);
	}

	public DurableReplaceKind kind() { return self._kind; }

	public bool committed() { return self._kind == DURABLE_REPLACE_COMMITTED; }

	public bool mayHaveCommitted() { return self._kind != DURABLE_REPLACE_FAILED; }

	public FileSystemError error() {
		if (self._error == null) { throw "durable replace has no error"; }
		return self._error;
	}
}

/* A descriptor-pinned absolute directory owned by the current user with mode
 * 0700. Opening may create the final leaf only; every existing ancestor is
 * traversed without following links. The handle remains bound to the opened
 * directory even if its pathname is subsequently replaced.
 */
class PrivateDirectory {
	private int _descriptor;
	private int _leaseDirectoryDescriptor;
	private int _leaseLockDescriptor;
	private int _leaseGeneration;
	private string _leaseName;
	private string _path;

	private PrivateDirectory(int descriptor, string path) {
		self._descriptor = descriptor;
		self._leaseDirectoryDescriptor = -1;
		self._leaseLockDescriptor = -1;
		self._leaseGeneration = 0;
		self._leaseName = "";
		self._path = path;
		btrcOwnExactFileSystemHandle();
	}

	/* The last component of `absolutePath`, named `component` inside the open
	 * directory `parent`: created 0700 when missing, never a symlink, and
	 * owned by the current user with mode 0700. `closeParent` hands `parent`
	 * over to be closed on every path out. */
	class FileSystemOutcome<PrivateDirectory> openLeafAt(int parent, string component, string absolutePath, bool closeParent) {
		bool created = false;
		struct stat named;
		errno = 0;
		if (fstatat(parent, component, &named, AT_SYMLINK_NOFOLLOW) != 0) {
			int inspectCode = errno;
			if (inspectCode != ENOENT) {
				if (closeParent) { close(parent); }
				return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.fromNative("inspect private directory", absolutePath, inspectCode));
			}
			errno = 0;
			if (mkdirat(parent, component, (mode_t)0700) == 0) {
				created = true;
			} else if (errno != EEXIST) {
				int nativeCode = errno;
				if (closeParent) { close(parent); }
				return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.fromNative("create private directory", absolutePath, nativeCode));
			}
			errno = 0;
			if (fstatat(parent, component, &named, AT_SYMLINK_NOFOLLOW) != 0) {
				int nativeCode = errno;
				if (closeParent) { close(parent); }
				return new FileSystemOutcome<PrivateDirectory>(null, nativeCode == ENOENT ? FileSystemError.changed("inspect created private directory", absolutePath, nativeCode) : FileSystemError.fromNative("inspect created private directory", absolutePath, nativeCode));
			}
		}
		if (S_ISLNK(named.st_mode)) {
			if (closeParent) { close(parent); }
			return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.symlink("open private directory", absolutePath));
		}
		if (!S_ISDIR(named.st_mode)) {
			if (closeParent) { close(parent); }
			return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.wrongType("open private directory", absolutePath));
		}

		errno = 0;
		int descriptor = openat(parent, component, (int)O_RDONLY | (int)O_DIRECTORY | (int)O_CLOEXEC | (int)O_NOFOLLOW);
		if (descriptor < 0) {
			int nativeCode = errno;
			if (closeParent) { close(parent); }
			return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.fromNative("open private directory", absolutePath, nativeCode));
		}
		struct stat openedLeaf;
		struct stat currentLeaf;
		errno = 0;
		if (fstat(descriptor, &openedLeaf) != 0 || fstatat(parent, component, &currentLeaf, AT_SYMLINK_NOFOLLOW) != 0) {
			int nativeCode = errno;
			close(descriptor);
			if (closeParent) { close(parent); }
			return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.fromNative("validate private directory", absolutePath, nativeCode));
		}
		if (!S_ISDIR(openedLeaf.st_mode) || !S_ISDIR(currentLeaf.st_mode) || openedLeaf.st_dev != named.st_dev || openedLeaf.st_ino != named.st_ino || openedLeaf.st_dev != currentLeaf.st_dev || openedLeaf.st_ino != currentLeaf.st_ino) {
			close(descriptor);
			if (closeParent) { close(parent); }
			return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.changed("validate private directory", absolutePath));
		}
		if (created) {
			errno = 0;
			if (fchmod(descriptor, (mode_t)0700) != 0) {
				int nativeCode = errno;
				close(descriptor);
				if (closeParent) { close(parent); }
				return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.fromNative("secure private directory", absolutePath, nativeCode));
			}
			errno = 0;
			if (fstat(descriptor, &openedLeaf) != 0) {
				int nativeCode = errno;
				close(descriptor);
				if (closeParent) { close(parent); }
				return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.fromNative("validate private directory permissions", absolutePath, nativeCode));
			}
		}
		if ((unsigned long long)openedLeaf.st_uid != (unsigned long long)geteuid() || (openedLeaf.st_mode & (mode_t)0777) != (mode_t)0700) {
			close(descriptor);
			if (closeParent) { close(parent); }
			return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError(FS_ACCESS_DENIED, "validate private directory permissions", absolutePath, EPERM, "private directory must be owned by the current user with mode 0700"));
		}
		errno = 0;
		if (closeParent && close(parent) != 0) {
			int nativeCode = errno;
			close(descriptor);
			return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.fromNative("close private directory parent", absolutePath, nativeCode));
		}
		return new FileSystemOutcome<PrivateDirectory>(PrivateDirectory(descriptor, Strings.copy(absolutePath)), null);
	}

	class FileSystemOutcome<PrivateDirectory> openAbsoluteLeaf(string absolutePath) {
		if (absolutePath == null || absolutePath.isEmpty() || !absolutePath.startsWith("/")) {
			return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.invalid("open private directory", absolutePath));
		}
		if (Platform.isWindows()) {
			return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.unsupported("open private directory", absolutePath));
		}
		int length = Strings.checkedLength(absolutePath);
		if (length < 2 || absolutePath[length - 1] == '/') {
			return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.invalid("open private directory", absolutePath));
		}

		errno = 0;
		int parent = open("/", (int)O_RDONLY | (int)O_DIRECTORY | (int)O_CLOEXEC | (int)O_NOFOLLOW);
		if (parent < 0) {
			int nativeCode = errno;
			return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.fromNative("open private directory root", absolutePath, nativeCode));
		}

		int start = 1;
		while (start < length) {
			int end = start;
			while (end < length && absolutePath[end] != '/') { end++; }
			if (end == start) {
				close(parent);
				return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.invalid("open private directory", absolutePath));
			}
			string component = absolutePath.substring(start, end - start);
			if (component.equals(".") || component.equals("..")) {
				close(parent);
				return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.invalid("open private directory", absolutePath));
			}

			bool leaf = end == length;
			if (!leaf) {
				struct stat before;
				errno = 0;
				if (fstatat(parent, component, &before, AT_SYMLINK_NOFOLLOW) != 0) {
					int nativeCode = errno;
					close(parent);
					return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.fromNative("inspect private directory ancestor", absolutePath, nativeCode));
				}
				if (S_ISLNK(before.st_mode)) {
					close(parent);
					return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.symlink("open private directory ancestor", absolutePath));
				}
				if (!S_ISDIR(before.st_mode)) {
					close(parent);
					return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.wrongType("open private directory ancestor", absolutePath));
				}

				errno = 0;
				int next = openat(parent, component, (int)O_RDONLY | (int)O_DIRECTORY | (int)O_CLOEXEC | (int)O_NOFOLLOW);
				if (next < 0) {
					int nativeCode = errno;
					close(parent);
					return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.fromNative("open private directory ancestor", absolutePath, nativeCode));
				}
				struct stat opened;
				struct stat after;
				errno = 0;
				if (fstat(next, &opened) != 0 || fstatat(parent, component, &after, AT_SYMLINK_NOFOLLOW) != 0) {
					int nativeCode = errno;
					close(next);
					close(parent);
					return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.fromNative("validate private directory ancestor", absolutePath, nativeCode));
				}
				if (!S_ISDIR(opened.st_mode) || !S_ISDIR(after.st_mode)) {
					close(next);
					close(parent);
					return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.changed("validate private directory ancestor", absolutePath));
				}
				if (opened.st_dev != before.st_dev || opened.st_ino != before.st_ino || opened.st_dev != after.st_dev || opened.st_ino != after.st_ino) {
					close(next);
					close(parent);
					return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.changed("validate private directory ancestor", absolutePath));
				}
				errno = 0;
				if (close(parent) != 0) {
					int nativeCode = errno;
					close(next);
					return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.fromNative("close private directory ancestor", absolutePath, nativeCode));
				}
				parent = next;
				start = end + 1;
				continue;
			}

			return PrivateDirectory.openLeafAt(parent, component, absolutePath, true);
		}

		close(parent);
		return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.invalid("open private directory", absolutePath));
	}

	/* A private child directory of this one, created when missing, with the
	 * checks `openAbsoluteLeaf` makes of its last component; one open where a
	 * fresh absolute open walks every ancestor again. */
	public FileSystemOutcome<PrivateDirectory> openChildDirectory(string name) {
		string path = self._path + "/" + (name == null ? "" : name);
		if (name == null || name.isEmpty() || name.indexOf("/") >= 0 || name.equals(".") || name.equals("..")) {
			return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.invalid("open private directory", path));
		}
		if (!self.isOpen()) {
			return new FileSystemOutcome<PrivateDirectory>(null, FileSystemError.closed("open private directory", path));
		}
		return PrivateDirectory.openLeafAt(self._descriptor, name, path, false);
	}

	public bool isOpen() { return self._descriptor >= 0; }

	public string path() { return self._path; }

	/* A lease deliberately keeps the original directory alive across renames.
	 * Callers whose authority also depends on its public name can revalidate
	 * that binding and private permissions after waiting or before mutation. */
	public FileSystemOutcome<FileSnapshot> validatePath() {
		if (!self.isOpen()) { return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.closed("validate private directory", self._path)); }
		struct stat opened;
		struct stat current;
		errno = 0;
		if (fstat(self._descriptor, &opened) != 0 || lstat(self._path, &current) != 0) {
			int nativeCode = errno;
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.fromNative("validate private directory", self._path, nativeCode));
		}
		if (!S_ISDIR(opened.st_mode) || !S_ISDIR(current.st_mode) || opened.st_dev != current.st_dev || opened.st_ino != current.st_ino) {
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.changed("validate private directory", self._path));
		}
		if ((unsigned long long)opened.st_uid != (unsigned long long)geteuid() || (unsigned long long)current.st_uid != (unsigned long long)geteuid() || (opened.st_mode & (mode_t)0777) != (mode_t)0700 || (current.st_mode & (mode_t)0777) != (mode_t)0700) {
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError(FS_ACCESS_DENIED, "validate private directory", self._path, EPERM, "private directory must remain owned by the current user with mode 0700"));
		}
		return new FileSystemOutcome<FileSnapshot>(FileSnapshot.fromStatus(&opened), null);
	}

	/* Nonblocking by default. wait=true is for command-line owners that share
     * a persistent flock with other processes, never UI/realtime executors.
     * A second live lease on this handle always reports resource exhaustion. */
	public FileSystemOutcome<ExclusiveFileLease> acquireExclusiveLease(string childName, bool wait = false) {
		if (!self.isOpen()) {
			return new FileSystemOutcome<ExclusiveFileLease>(null, FileSystemError.closed("acquire exclusive file lease", self._path));
		}
		if (!self.validChildName(childName)) {
			return new FileSystemOutcome<ExclusiveFileLease>(null, FileSystemError.invalid("acquire exclusive file lease", childName));
		}
		if (self._leaseLockDescriptor >= 0) {
			return new FileSystemOutcome<ExclusiveFileLease>(null, FileSystemError(FS_RESOURCE_EXHAUSTED, "acquire exclusive file lease", self._path + "/" + childName, EAGAIN, "this private directory already owns an exclusive file lease"));
		}
		string childPath = self._path + "/" + childName;
		struct stat before;
		bool existed = false;
		errno = 0;
		if (fstatat(self._descriptor, childName, &before, AT_SYMLINK_NOFOLLOW) == 0) {
			existed = true;
			if (S_ISLNK(before.st_mode)) {
				return new FileSystemOutcome<ExclusiveFileLease>(null, FileSystemError.symlink("open exclusive lease file", childPath));
			}
			if (!S_ISREG(before.st_mode)) {
				return new FileSystemOutcome<ExclusiveFileLease>(null, FileSystemError.wrongType("open exclusive lease file", childPath));
			}
			if (!self.secureRegular(&before)) {
				return new FileSystemOutcome<ExclusiveFileLease>(null, self.insecureRegular("validate exclusive lease file", childPath));
			}
		} else if (errno != ENOENT) {
			int nativeCode = errno;
			return new FileSystemOutcome<ExclusiveFileLease>(null, FileSystemError.fromNative("inspect exclusive lease file", childPath, nativeCode));
		}

		errno = 0;
		int directoryDescriptor = dup(self._descriptor);
		if (directoryDescriptor < 0) {
			int nativeCode = errno;
			return new FileSystemOutcome<ExclusiveFileLease>(null, FileSystemError.fromNative("retain private directory", childPath, nativeCode));
		}
		errno = 0;
		if (fcntl(directoryDescriptor, F_SETFD, FD_CLOEXEC) != 0) {
			int nativeCode = errno;
			close(directoryDescriptor);
			return new FileSystemOutcome<ExclusiveFileLease>(null, FileSystemError.fromNative("retain private directory", childPath, nativeCode));
		}

		bool created = false;
		int lockDescriptor = -1;
		if (!existed) {
			errno = 0;
			lockDescriptor = openat(directoryDescriptor, childName, (int)O_RDWR | (int)O_CREAT | (int)O_EXCL | (int)O_CLOEXEC | (int)O_NOFOLLOW, (mode_t)0600);
			if (lockDescriptor >= 0) {
				created = true;
			} else if (errno == EEXIST) {
				errno = 0;
				if (fstatat(directoryDescriptor, childName, &before, AT_SYMLINK_NOFOLLOW) != 0) {
					int nativeCode = errno;
					close(directoryDescriptor);
					return new FileSystemOutcome<ExclusiveFileLease>(null, FileSystemError.fromNative("inspect raced exclusive lease file", childPath, nativeCode));
				}
				existed = true;
				if (S_ISLNK(before.st_mode)) {
					close(directoryDescriptor);
					return new FileSystemOutcome<ExclusiveFileLease>(null, FileSystemError.symlink("open exclusive lease file", childPath));
				}
				if (!S_ISREG(before.st_mode)) {
					close(directoryDescriptor);
					return new FileSystemOutcome<ExclusiveFileLease>(null, FileSystemError.wrongType("open exclusive lease file", childPath));
				}
				if (!self.secureRegular(&before)) {
					close(directoryDescriptor);
					return new FileSystemOutcome<ExclusiveFileLease>(null, self.insecureRegular("validate exclusive lease file", childPath));
				}
			} else {
				int nativeCode = errno;
				close(directoryDescriptor);
				return new FileSystemOutcome<ExclusiveFileLease>(null, FileSystemError.fromNative("create exclusive lease file", childPath, nativeCode));
			}
		}
		if (lockDescriptor < 0) {
			errno = 0;
			lockDescriptor = openat(directoryDescriptor, childName, (int)O_RDWR | (int)O_CLOEXEC | (int)O_NOFOLLOW);
			if (lockDescriptor < 0) {
				int nativeCode = errno;
				close(directoryDescriptor);
				return new FileSystemOutcome<ExclusiveFileLease>(null, FileSystemError.fromNative("open exclusive lease file", childPath, nativeCode));
			}
		}
		if (created) {
			errno = 0;
			if (fchmod(lockDescriptor, (mode_t)0600) != 0) {
				int nativeCode = errno;
				close(lockDescriptor);
				close(directoryDescriptor);
				return new FileSystemOutcome<ExclusiveFileLease>(null, FileSystemError.fromNative("secure exclusive lease file", childPath, nativeCode));
			}
		}

		struct stat opened;
		struct stat current;
		errno = 0;
		if (fstat(lockDescriptor, &opened) != 0 || fstatat(directoryDescriptor, childName, &current, AT_SYMLINK_NOFOLLOW) != 0) {
			int nativeCode = errno;
			close(lockDescriptor);
			close(directoryDescriptor);
			return new FileSystemOutcome<ExclusiveFileLease>(null, FileSystemError.fromNative("validate exclusive lease file", childPath, nativeCode));
		}
		if (!self.secureRegular(&opened) || !self.secureRegular(&current)) {
			close(lockDescriptor);
			close(directoryDescriptor);
			return new FileSystemOutcome<ExclusiveFileLease>(null, self.insecureRegular("validate exclusive lease file", childPath));
		}
		if (opened.st_dev != current.st_dev || opened.st_ino != current.st_ino || (existed && (opened.st_dev != before.st_dev || opened.st_ino != before.st_ino))) {
			close(lockDescriptor);
			close(directoryDescriptor);
			return new FileSystemOutcome<ExclusiveFileLease>(null, FileSystemError.changed("validate exclusive lease file", childPath));
		}

		int lockResult = -1;
		do {
			errno = 0;
			lockResult = flock(lockDescriptor, wait ? (int)LOCK_EX : ((int)LOCK_EX | (int)LOCK_NB));
		} while (lockResult != 0 && errno == EINTR);
		if (lockResult != 0) {
			int nativeCode = errno;
			close(lockDescriptor);
			close(directoryDescriptor);
			if (nativeCode == EAGAIN) {
				return new FileSystemOutcome<ExclusiveFileLease>(null, FileSystemError(FS_RESOURCE_EXHAUSTED, "acquire exclusive file lease", childPath, nativeCode, "exclusive file lease is already held"));
			}
			return new FileSystemOutcome<ExclusiveFileLease>(null, FileSystemError.fromNative("acquire exclusive file lease", childPath, nativeCode));
		}

		errno = 0;
		if (fstatat(directoryDescriptor, childName, &current, AT_SYMLINK_NOFOLLOW) != 0) {
			int nativeCode = errno;
			flock(lockDescriptor, (int)LOCK_UN);
			close(lockDescriptor);
			close(directoryDescriptor);
			return new FileSystemOutcome<ExclusiveFileLease>(null, nativeCode == ENOENT ? FileSystemError.changed("validate acquired exclusive file lease", childPath, nativeCode) : FileSystemError.fromNative("validate acquired exclusive file lease", childPath, nativeCode));
		}
		if (!self.secureRegular(&current) || opened.st_dev != current.st_dev || opened.st_ino != current.st_ino) {
			flock(lockDescriptor, (int)LOCK_UN);
			close(lockDescriptor);
			close(directoryDescriptor);
			return new FileSystemOutcome<ExclusiveFileLease>(null, FileSystemError.changed("validate acquired exclusive file lease", childPath));
		}
		self._leaseGeneration++;
		if (self._leaseGeneration <= 0) { self._leaseGeneration = 1; }
		self._leaseDirectoryDescriptor = directoryDescriptor;
		self._leaseLockDescriptor = lockDescriptor;
		self._leaseName = Strings.copy(childName);
		btrcOwnExactFileSystemHandle();
		return new FileSystemOutcome<ExclusiveFileLease>(ExclusiveFileLease(self, self._leaseGeneration, Strings.copy(childName)), null);
	}

	public FileSystemCloseOutcome close() {
		if (!self.isOpen()) {
			return FileSystemCloseOutcome.alreadyClosed();
		}
		if (self._leaseLockDescriptor >= 0) {
			return FileSystemCloseOutcome.failed(FileSystemError(FS_RESOURCE_EXHAUSTED, "close private directory", self._path, EAGAIN, "private directory still owns an exclusive file lease"));
		}
		int descriptor = self._descriptor;
		self._descriptor = -1;
		btrcReleaseExactFileSystemHandle();
		errno = 0;
		if (close(descriptor) != 0) {
			int nativeCode = errno;
			return FileSystemCloseOutcome.failed(FileSystemError.fromNative("close private directory", self._path, nativeCode));
		}
		return FileSystemCloseOutcome.closed();
	}

	private bool validChildName(string childName) { return childName != null && !childName.isEmpty() && !childName.equals(".") && !childName.equals("..") && !childName.contains("/") && !childName.contains("\\"); }

	private bool secureRegular(struct stat* status) { return S_ISREG(status->st_mode) && (unsigned long long)status->st_uid == (unsigned long long)geteuid() && status->st_nlink == 1 && (status->st_mode & (mode_t)0777) == (mode_t)0600; }

	private FileSystemError insecureRegular(string operation, string path) { return FileSystemError(FS_ACCESS_DENIED, operation, path, EPERM, "private file must be owned by the current user, have one link, and use mode 0600"); }

	public PrivateFileReadOutcome readRegularChildForLease(int generation, string lockName, string childName, int maximumBytes) {
		if (!self.leaseActive(generation, lockName)) {
			return PrivateFileReadOutcome.failed(FileSystemError.closed("read private file", self._path));
		}
		if (!self.validDataChildNameForLease(childName, lockName) || maximumBytes < 0) {
			return PrivateFileReadOutcome.failed(FileSystemError.invalid("read private file", childName));
		}
		string childPath = self._path + "/" + childName;
		struct stat before;
		errno = 0;
		if (fstatat(self._leaseDirectoryDescriptor, childName, &before, AT_SYMLINK_NOFOLLOW) != 0) {
			int nativeCode = errno;
			if (nativeCode == ENOENT) {
				return PrivateFileReadOutcome.missing();
			}
			return PrivateFileReadOutcome.failed(FileSystemError.fromNative("inspect private file", childPath, nativeCode));
		}
		if (S_ISLNK(before.st_mode)) {
			return PrivateFileReadOutcome.failed(FileSystemError.symlink("read private file", childPath));
		}
		if (!S_ISREG(before.st_mode)) {
			return PrivateFileReadOutcome.failed(FileSystemError.wrongType("read private file", childPath));
		}
		if (!self.secureRegular(&before)) {
			return PrivateFileReadOutcome.failed(self.insecureRegular("validate private file", childPath));
		}
		long long byteCount = (long long)before.st_size;
		if (byteCount < 0LL || byteCount > (long long)maximumBytes || byteCount > 2147483646LL) {
			return PrivateFileReadOutcome.failed(FileSystemError(FS_RESOURCE_EXHAUSTED, "read private file", childPath, EFBIG, "private file exceeds the caller's byte budget"));
		}

		errno = 0;
		int descriptor = openat(self._leaseDirectoryDescriptor, childName, (int)O_RDONLY | (int)O_CLOEXEC | (int)O_NOFOLLOW | (int)O_NONBLOCK);
		if (descriptor < 0) {
			int nativeCode = errno;
			return PrivateFileReadOutcome.failed(FileSystemError.fromNative("open private file", childPath, nativeCode));
		}
		struct stat opened;
		errno = 0;
		if (fstat(descriptor, &opened) != 0) {
			int nativeCode = errno;
			close(descriptor);
			return PrivateFileReadOutcome.failed(FileSystemError.fromNative("validate opened private file", childPath, nativeCode));
		}
		if (!self.secureRegular(&opened)) {
			close(descriptor);
			return PrivateFileReadOutcome.failed(self.insecureRegular("validate opened private file", childPath));
		}
		if (!self.sameVersion(&before, &opened)) {
			close(descriptor);
			return PrivateFileReadOutcome.failed(FileSystemError.changed("validate opened private file", childPath));
		}

		int count = (int)byteCount;
		char* buffer = null;
		if (count > 0) {
			buffer = (char*)malloc((size_t)count);
			if (buffer == null) {
				close(descriptor);
				return PrivateFileReadOutcome.failed(FileSystemError(FS_RESOURCE_EXHAUSTED, "read private file", childPath, ENOMEM, "private file read buffer allocation failed"));
			}
		}
		int offset = 0;
		while (offset < count) {
			errno = 0;
			ssize_t received = read(descriptor, buffer + offset, (size_t)(count - offset));
			if (received > (ssize_t)0) {
				offset = offset + (int)received;
				continue;
			}
			if (received < (ssize_t)0 && errno == EINTR) { continue; }
			if (buffer != null) { free(buffer); }
			if (received == (ssize_t)0) {
				close(descriptor);
				return PrivateFileReadOutcome.failed(FileSystemError.changed("read private file", childPath));
			}
			int nativeCode = errno;
			close(descriptor);
			return PrivateFileReadOutcome.failed(FileSystemError.fromNative("read private file", childPath, nativeCode));
		}

		char trailing = '\0';
		ssize_t extra = -1;
		do {
			errno = 0;
			extra = read(descriptor, &trailing, (size_t)1);
		} while (extra < (ssize_t)0 && errno == EINTR);
		if (extra != (ssize_t)0) {
			int nativeCode = errno;
			if (buffer != null) { free(buffer); }
			close(descriptor);
			return PrivateFileReadOutcome.failed(extra > (ssize_t)0 ? FileSystemError.changed("read private file", childPath) : FileSystemError.fromNative("read private file", childPath, nativeCode));
		}

		struct stat openedAfter;
		struct stat namedAfter;
		errno = 0;
		if (fstat(descriptor, &openedAfter) != 0 || fstatat(self._leaseDirectoryDescriptor, childName, &namedAfter, AT_SYMLINK_NOFOLLOW) != 0) {
			int nativeCode = errno;
			if (buffer != null) { free(buffer); }
			close(descriptor);
			return PrivateFileReadOutcome.failed(nativeCode == ENOENT ? FileSystemError.changed("validate read private file", childPath, nativeCode) : FileSystemError.fromNative("validate read private file", childPath, nativeCode));
		}
		if (!self.sameVersion(&before, &openedAfter) || !self.sameVersion(&before, &namedAfter)) {
			if (buffer != null) { free(buffer); }
			close(descriptor);
			return PrivateFileReadOutcome.failed(FileSystemError.changed("validate read private file", childPath));
		}
		errno = 0;
		if (close(descriptor) != 0) {
			int nativeCode = errno;
			if (buffer != null) { free(buffer); }
			return PrivateFileReadOutcome.failed(FileSystemError.fromNative("close private file", childPath, nativeCode));
		}
		Bytes bytes = count == 0 ? Bytes() : Bytes.fromRaw(buffer, count);
		if (buffer != null) { free(buffer); }
		return PrivateFileReadOutcome.data(bytes);
	}

	public DurableReplaceOutcome replaceRegularChildDurablyForLease(int generation, string lockName, string childName, Bytes content) {
		if (!self.leaseActive(generation, lockName)) {
			return DurableReplaceOutcome.failed(FileSystemError.closed("replace private file", self._path));
		}
		if (!self.validDataChildNameForLease(childName, lockName) || content == null) {
			return DurableReplaceOutcome.failed(FileSystemError.invalid("replace private file", childName));
		}
		string childPath = self._path + "/" + childName;
		struct stat expected;
		bool expectedPresent = false;
		errno = 0;
		if (fstatat(self._leaseDirectoryDescriptor, childName, &expected, AT_SYMLINK_NOFOLLOW) == 0) {
			expectedPresent = true;
			if (S_ISLNK(expected.st_mode)) {
				return DurableReplaceOutcome.failed(FileSystemError.symlink("replace private file", childPath));
			}
			if (!S_ISREG(expected.st_mode)) {
				return DurableReplaceOutcome.failed(FileSystemError.wrongType("replace private file", childPath));
			}
			if (!self.secureRegular(&expected)) {
				return DurableReplaceOutcome.failed(self.insecureRegular("validate replaced private file", childPath));
			}
		} else if (errno != ENOENT) {
			int nativeCode = errno;
			return DurableReplaceOutcome.failed(FileSystemError.fromNative("inspect replaced private file", childPath, nativeCode));
		}

		struct timespec now;
		int seed = 0;
		if (clock_gettime(CLOCK_MONOTONIC, &now) == 0) {
			seed = (int)now.tv_nsec;
		}
		int temporaryDescriptor = -1;
		string temporaryName = "";
		for attempt in range(128) {
			string candidate = ".btrc-tmp-" + Strings.fromInt((int)getpid()) + "-" + Strings.fromInt(seed) + "-" + Strings.fromInt(attempt);
			if (candidate.equals(childName)) { continue; }
			errno = 0;
			int candidateDescriptor = openat(self._leaseDirectoryDescriptor, candidate, (int)O_WRONLY | (int)O_CREAT | (int)O_EXCL | (int)O_CLOEXEC | (int)O_NOFOLLOW, (mode_t)0600);
			if (candidateDescriptor >= 0) {
				temporaryDescriptor = candidateDescriptor;
				temporaryName = Strings.copy(candidate);
				break;
			}
			if (errno != EEXIST) {
				int nativeCode = errno;
				return DurableReplaceOutcome.failed(FileSystemError.fromNative("create durable replacement", childPath, nativeCode));
			}
		}
		if (temporaryDescriptor < 0) {
			return DurableReplaceOutcome.failed(FileSystemError(FS_RESOURCE_EXHAUSTED, "create durable replacement", childPath, EEXIST, "durable replacement temporary-name budget was exhausted"));
		}

		errno = 0;
		if (fchmod(temporaryDescriptor, (mode_t)0600) != 0) {
			int nativeCode = errno;
			return self.abandonTemporary(temporaryDescriptor, temporaryName, FileSystemError.fromNative("secure durable replacement", childPath, nativeCode));
		}
		struct stat temporaryStatus;
		struct stat namedTemporary;
		errno = 0;
		if (fstat(temporaryDescriptor, &temporaryStatus) != 0 || fstatat(self._leaseDirectoryDescriptor, temporaryName, &namedTemporary, AT_SYMLINK_NOFOLLOW) != 0) {
			int nativeCode = errno;
			return self.abandonTemporary(temporaryDescriptor, temporaryName, FileSystemError.fromNative("validate durable replacement", childPath, nativeCode));
		}
		if (!self.secureRegular(&temporaryStatus) || !self.secureRegular(&namedTemporary)) {
			return self.abandonTemporary(temporaryDescriptor, temporaryName, self.insecureRegular("validate durable replacement", childPath));
		}
		if (temporaryStatus.st_dev != namedTemporary.st_dev || temporaryStatus.st_ino != namedTemporary.st_ino) {
			return self.abandonTemporary(temporaryDescriptor, temporaryName, FileSystemError.changed("validate durable replacement", childPath));
		}

		int contentLength = content.length();
		int written = 0;
		while (written < contentLength) {
			errno = 0;
			ssize_t step = write(temporaryDescriptor, content.data + written, (size_t)(contentLength - written));
			if (step > (ssize_t)0) {
				written = written + (int)step;
				continue;
			}
			if (step < (ssize_t)0 && errno == EINTR) { continue; }
			int nativeCode = step == (ssize_t)0 ? EIO : errno;
			return self.abandonTemporary(temporaryDescriptor, temporaryName, FileSystemError.fromNative("write durable replacement", childPath, nativeCode));
		}
		errno = 0;
		if (!self.syncDescriptor(temporaryDescriptor)) {
			int nativeCode = errno;
			return self.abandonTemporary(temporaryDescriptor, temporaryName, FileSystemError.fromNative("sync durable replacement", childPath, nativeCode));
		}
		errno = 0;
		if (close(temporaryDescriptor) != 0) {
			int nativeCode = errno;
			return self.abandonTemporary(-1, temporaryName, FileSystemError.fromNative("close durable replacement", childPath, nativeCode));
		}
		temporaryDescriptor = -1;

		struct stat current;
		errno = 0;
		int targetInspect = fstatat(self._leaseDirectoryDescriptor, childName, &current, AT_SYMLINK_NOFOLLOW);
		if (expectedPresent) {
			if (targetInspect != 0) {
				int nativeCode = errno;
				return self.abandonTemporary(-1, temporaryName, nativeCode == ENOENT ? FileSystemError.changed("validate durable replacement target", childPath, nativeCode) : FileSystemError.fromNative("validate durable replacement target", childPath, nativeCode));
			}
			if (!self.sameVersion(&expected, &current)) {
				return self.abandonTemporary(-1, temporaryName, FileSystemError.changed("validate durable replacement target", childPath));
			}
		} else if (targetInspect == 0) {
			return self.abandonTemporary(-1, temporaryName, FileSystemError.changed("validate durable replacement target", childPath));
		} else if (errno != ENOENT) {
			int nativeCode = errno;
			return self.abandonTemporary(-1, temporaryName, FileSystemError.fromNative("validate durable replacement target", childPath, nativeCode));
		}

		errno = 0;
		if (renameat(self._leaseDirectoryDescriptor, temporaryName, self._leaseDirectoryDescriptor, childName) != 0) {
			int nativeCode = errno;
			return self.abandonTemporary(-1, temporaryName, FileSystemError.fromNative("publish durable replacement", childPath, nativeCode));
		}
		errno = 0;
		if (!self.syncDescriptor(self._leaseDirectoryDescriptor)) {
			int nativeCode = errno;
			return DurableReplaceOutcome.durabilityUncertain(FileSystemError.fromNative("sync durable replacement directory", childPath, nativeCode));
		}
		return DurableReplaceOutcome.succeeded();
	}

	/* Retire authority relative to the pinned lease directory. An uncertain
	 * directory flush is retryable even when the child name is already gone. */
	public DurableReplaceOutcome removeRegularChildDurablyForLease(int generation, string lockName, string childName) {
		if (!self.leaseActive(generation, lockName)) { return DurableReplaceOutcome.failed(FileSystemError.closed("remove private file", self._path)); }
		if (!self.validDataChildNameForLease(childName, lockName)) { return DurableReplaceOutcome.failed(FileSystemError.invalid("remove private file", childName)); }
		string path = self._path + "/" + childName;
		struct stat status;
		errno = 0;
		if (fstatat(self._leaseDirectoryDescriptor, childName, &status, AT_SYMLINK_NOFOLLOW) == 0) {
			if (S_ISLNK(status.st_mode)) { return DurableReplaceOutcome.failed(FileSystemError.symlink("remove private file", path)); }
			if (!S_ISREG(status.st_mode)) { return DurableReplaceOutcome.failed(FileSystemError.wrongType("remove private file", path)); }
			if (!self.secureRegular(&status)) { return DurableReplaceOutcome.failed(self.insecureRegular("remove private file", path)); }
			if (unlinkat(self._leaseDirectoryDescriptor, childName, 0) != 0) { return DurableReplaceOutcome.failed(FileSystemError.fromNative("remove private file", path, errno)); }
		} else if (errno != ENOENT) { return DurableReplaceOutcome.failed(FileSystemError.fromNative("inspect removed private file", path, errno)); }
		if (!self.syncDescriptor(self._leaseDirectoryDescriptor)) { return DurableReplaceOutcome.durabilityUncertain(FileSystemError.fromNative("sync removed private file", path, errno)); }
		return DurableReplaceOutcome.succeeded();
	}

	public FileSystemOutcome<FileSnapshot> validateLeaseFor(int generation, string lockName) {
		if (!self.leaseActive(generation, lockName)) { return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.closed("validate exclusive lease", self._path)); }
		string path = self._path + "/" + lockName;
		struct stat opened;
		struct stat current;
		errno = 0;
		if (fstat(self._leaseLockDescriptor, &opened) != 0 || fstatat(self._leaseDirectoryDescriptor, lockName, &current, AT_SYMLINK_NOFOLLOW) != 0) {
			int nativeCode = errno;
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.fromNative("validate exclusive lease", path, nativeCode));
		}
		if (!self.secureRegular(&opened) || !self.secureRegular(&current) || opened.st_dev != current.st_dev || opened.st_ino != current.st_ino) {
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.changed("validate exclusive lease", path));
		}
		return new FileSystemOutcome<FileSnapshot>(FileSnapshot.fromStatus(&opened), null);
	}

	public bool leaseActive(int generation, string lockName) { return self.isOpen() && self._leaseDirectoryDescriptor >= 0 && self._leaseLockDescriptor >= 0 && generation == self._leaseGeneration && lockName != null && lockName.equals(self._leaseName); }

	public FileSystemCloseOutcome releaseExclusiveLease(int generation, string lockName) {
		if (!self.leaseActive(generation, lockName)) {
			return FileSystemCloseOutcome.alreadyClosed();
		}
		int directoryDescriptor = self._leaseDirectoryDescriptor;
		int lockDescriptor = self._leaseLockDescriptor;
		self._leaseDirectoryDescriptor = -1;
		self._leaseLockDescriptor = -1;
		self._leaseName = "";
		btrcReleaseExactFileSystemHandle();
		int firstError = 0;
		int unlockResult = -1;
		do {
			errno = 0;
			unlockResult = flock(lockDescriptor, (int)LOCK_UN);
		} while (unlockResult != 0 && errno == EINTR);
		if (unlockResult != 0) { firstError = errno; }
		errno = 0;
		if (close(lockDescriptor) != 0 && firstError == 0) {
			firstError = errno;
		}
		errno = 0;
		if (close(directoryDescriptor) != 0 && firstError == 0) {
			firstError = errno;
		}
		if (firstError != 0) {
			return FileSystemCloseOutcome.failed(FileSystemError.fromNative("close exclusive file lease", self._path + "/" + lockName, firstError));
		}
		return FileSystemCloseOutcome.closed();
	}

	private bool validDataChildNameForLease(string childName, string lockName) { return childName != null && !childName.isEmpty() && !childName.equals(".") && !childName.equals("..") && !childName.contains("/") && !childName.contains("\\") && lockName != null && !childName.equals(lockName); }

	private bool sameVersion(struct stat* left, struct stat* right) {
		FileSnapshot expected = FileSnapshot.fromStatus(left);
		FileSnapshot actual = FileSnapshot.fromStatus(right);
		return expected.sameVersion(actual);
	}

	private bool syncDescriptor(int descriptor) {
		int result = -1;
		do {
			errno = 0;
			result = fsync(descriptor);
		} while (result != 0 && errno == EINTR);
		return result == 0;
	}

	private DurableReplaceOutcome abandonTemporary(int descriptor, string temporaryName, FileSystemError error) {
		if (descriptor >= 0) { close(descriptor); }
		if (temporaryName != null && !temporaryName.isEmpty()) {
			unlinkat(self._leaseDirectoryDescriptor, temporaryName, 0);
		}
		return DurableReplaceOutcome.failed(error);
	}

	public void __del__() { self.close(); }
}

/* An exclusive lease over one owner-only 0600 lock child. Reads and durable
 * replacements are relative to the pinned directory, reject links and unsafe
 * files, and are generation-checked against this lease. A read's maximumBytes
 * is a hard caller-owned bound. Durable replacement reports uncertainty only
 * when rename succeeded but the subsequent directory sync failed. close() is
 * idempotent and releases both the advisory lock and retained directory.
 */
class ExclusiveFileLease {
	private PrivateDirectory _owner;
	private int _generation;
	private string _lockName;
	private bool _open;

	public ExclusiveFileLease(PrivateDirectory owner, int generation, string lockName) {
		if (owner == null || lockName == null || lockName.isEmpty()) {
			throw "invalid exclusive file lease";
		}
		self._owner = owner;
		self._generation = generation;
		self._lockName = lockName;
		self._open = true;
	}

	public bool isOpen() { return self._open && self._owner.leaseActive(self._generation, self._lockName); }

	/* A persistent lease file must keep its inode and private permissions. */
	public FileSystemOutcome<FileSnapshot> validate() {
		if (!self.isOpen()) { return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.closed("validate exclusive lease", self._owner.path())); }
		return self._owner.validateLeaseFor(self._generation, self._lockName);
	}

	public PrivateFileReadOutcome readRegularChild(string childName, int maximumBytes) {
		if (!self.isOpen()) {
			return PrivateFileReadOutcome.failed(FileSystemError.closed("read private file", self._owner.path()));
		}
		return self._owner.readRegularChildForLease(self._generation, self._lockName, childName, maximumBytes);
	}

	public DurableReplaceOutcome removeRegularChildDurably(string childName) {
		if (!self.isOpen() || self._owner == null) { return DurableReplaceOutcome.failed(FileSystemError.closed("remove private file", childName)); }
		return self._owner.removeRegularChildDurablyForLease(self._generation, self._lockName, childName);
	}

	public DurableReplaceOutcome replaceRegularChildDurably(string childName, Bytes content) {
		if (!self.isOpen()) {
			return DurableReplaceOutcome.failed(FileSystemError.closed("replace private file", self._owner.path()));
		}
		return self._owner.replaceRegularChildDurablyForLease(self._generation, self._lockName, childName, content);
	}

	public FileSystemCloseOutcome close() {
		if (!self._open) {
			return FileSystemCloseOutcome.alreadyClosed();
		}
		self._open = false;
		return self._owner.releaseExclusiveLease(self._generation, self._lockName);
	}

	public void __del__() { self.close(); }
}


/* A persistent coordination file, never the data file a caller will replace.
 * POSIX flock interoperates with other processes using the same inode. The
 * default attempt is nonblocking; wait=true is for blocking command-line
 * owners, not UI/realtime executors. Closing releases ownership but never
 * unlinks the coordination file. Aliases observe the same closed state.
 * A lock is advisory, not authorization to modify files or a transaction. */
class AdvisoryFileLock {
	private int _descriptor;
	private string _path;
	private FileSnapshot _identity;

	private AdvisoryFileLock(int descriptor, string path, FileSnapshot identity) {
		self._descriptor = descriptor;
		self._path = path;
		self._identity = identity;
		btrcOwnExactFileSystemHandle();
	}

	class FileSystemOutcome<AdvisoryFileLock> acquire(string path, bool wait = false) {
		if (path == null || path.isEmpty()) { return new FileSystemOutcome<AdvisoryFileLock>(null, FileSystemError.invalid("acquire advisory lock", path)); }
		if (Platform.isWindows()) { return new FileSystemOutcome<AdvisoryFileLock>(null, FileSystemError.unsupported("acquire advisory lock", path)); }
		struct stat before;
		errno = 0;
		bool existed = lstat(path, &before) == 0;
		if (!existed && errno != ENOENT) { return new FileSystemOutcome<AdvisoryFileLock>(null, FileSystemError.fromNative("inspect advisory lock", path, errno)); }
		if (existed && S_ISLNK(before.st_mode)) { return new FileSystemOutcome<AdvisoryFileLock>(null, FileSystemError.symlink("acquire advisory lock", path)); }
		if (existed && (!S_ISREG(before.st_mode) || before.st_nlink != 1)) { return new FileSystemOutcome<AdvisoryFileLock>(null, FileSystemError.wrongType("acquire advisory lock", path)); }
		errno = 0;
		int descriptor = open(path, (int)O_RDWR | (int)O_CREAT | (int)O_CLOEXEC | (int)O_NOFOLLOW | (int)O_NONBLOCK, (mode_t)0600);
		if (descriptor < 0) { return new FileSystemOutcome<AdvisoryFileLock>(null, FileSystemError.fromNative("open advisory lock", path, errno)); }
		struct stat opened;
		struct stat current;
		errno = 0;
		if (fstat(descriptor, &opened) != 0 || lstat(path, &current) != 0) {
			int nativeCode = errno;
			close(descriptor);
			return new FileSystemOutcome<AdvisoryFileLock>(null, FileSystemError.fromNative("validate advisory lock", path, nativeCode));
		}
		if (!S_ISREG(opened.st_mode) || !S_ISREG(current.st_mode) || opened.st_nlink != 1 || current.st_nlink != 1 || opened.st_dev != current.st_dev || opened.st_ino != current.st_ino || (existed && (opened.st_dev != before.st_dev || opened.st_ino != before.st_ino))) {
			close(descriptor);
			return new FileSystemOutcome<AdvisoryFileLock>(null, FileSystemError.changed("validate advisory lock", path));
		}
		int flags = wait ? (int)LOCK_EX : ((int)LOCK_EX | (int)LOCK_NB);
		int locked = -1;
		do { errno = 0; locked = flock(descriptor, flags); } while (locked != 0 && errno == EINTR);
		if (locked != 0) {
			int nativeCode = errno;
			close(descriptor);
			return new FileSystemOutcome<AdvisoryFileLock>(null, FileSystemError.fromNative("acquire advisory lock", path, nativeCode));
		}
		var owner = AdvisoryFileLock(descriptor, Strings.copy(path), FileSnapshot.fromStatus(&opened));
		var checked = owner.validate();
		if (!checked.ok()) { owner.close(); return new FileSystemOutcome<AdvisoryFileLock>(null, checked.error()); }
		return new FileSystemOutcome<AdvisoryFileLock>(owner, null);
	}

	public bool isOpen() { return self._descriptor >= 0; }

	/* Recheck after a wait and before protected work. This detects replacement;
	 * cooperating users must retain the file to keep one shared lock identity. */
	public FileSystemOutcome<FileSnapshot> validate() {
		if (!self.isOpen()) { return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.closed("validate advisory lock", self._path)); }
		struct stat opened;
		struct stat current;
		errno = 0;
		if (fstat(self._descriptor, &opened) != 0 || lstat(self._path, &current) != 0) {
			int nativeCode = errno;
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.fromNative("validate advisory lock", self._path, nativeCode));
		}
		if (!S_ISREG(opened.st_mode) || !S_ISREG(current.st_mode) || opened.st_nlink != 1 || current.st_nlink != 1 || !self._identity.sameObject(FileSnapshot.fromStatus(&opened)) || !self._identity.sameObject(FileSnapshot.fromStatus(&current))) {
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.changed("validate advisory lock", self._path));
		}
		return new FileSystemOutcome<FileSnapshot>(FileSnapshot.fromStatus(&current), null);
	}

	public FileSystemCloseOutcome close() {
		if (!self.isOpen()) { return FileSystemCloseOutcome.alreadyClosed(); }
		int descriptor = self._descriptor;
		self._descriptor = -1;
		int unlocked = -1;
		do { errno = 0; unlocked = flock(descriptor, (int)LOCK_UN); } while (unlocked != 0 && errno == EINTR);
		int unlockError = unlocked == 0 ? 0 : errno;
		errno = 0;
		int closed = close(descriptor);
		int closeError = closed == 0 ? 0 : errno;
		btrcReleaseExactFileSystemHandle();
		if (unlockError != 0 || closeError != 0) { return FileSystemCloseOutcome.failed(FileSystemError.fromNative("close advisory lock", self._path, unlockError != 0 ? unlockError : closeError)); }
		return FileSystemCloseOutcome.closed();
	}

	public void __del__() { self.close(); }
}
