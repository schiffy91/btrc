/* Owned, exact filesystem handles.
 *
 * Operations expose copied BTRC values and typed outcomes. Native descriptors
 * remain private, each read or directory advance performs bounded work, and
 * callers retain ownership of traversal, byte, and cancellation budgets.
 */

import Library.Bytes;
import Library.IO;
import Library.Platform;
import Library.Strings;

#include <dirent.h>
#include <errno.h>
#include <fcntl.h>
#include <limits.h>
#include <stdlib.h>
#include <string.h>
#include <sys/file.h>
#include <sys/stat.h>
#include <sys/types.h>
#include <time.h>
#include <unistd.h>

/* Counts only the long-lived exact filesystem handle capabilities
 * owned by this generated program. It never probes native descriptor tables,
 * so the diagnostic has identical semantics on every supported platform.
 * Static Atomic<T> storage is zero-initialized before program entry. */
static Atomic<int> btrcOwnedExactFileSystemHandles;

static void btrcOwnExactFileSystemHandle() {
	int previous = btrcOwnedExactFileSystemHandles.fetchAdd(1, MemoryOrder.RELAXED);
	if (previous < 0) {
		fprintf(stderr, "filesystem handle inventory overflowed\n");
		abort();
	}
}

static void btrcReleaseExactFileSystemHandle() {
	int previous = btrcOwnedExactFileSystemHandles.fetchSub(1, MemoryOrder.RELAXED);
	if (previous <= 0) {
		fprintf(stderr, "filesystem handle inventory underflowed\n");
		abort();
	}
}

enum FileSystemErrorKind {
	FS_INVALID_ARGUMENT = 0,
	FS_NOT_FOUND = 1,
	FS_ACCESS_DENIED = 2,
	FS_SYMLINK = 3,
	FS_WRONG_TYPE = 4,
	FS_CHANGED = 5,
	FS_RESOURCE_EXHAUSTED = 6,
	FS_IO = 7,
	FS_CLOSED = 8,
	FS_UNSUPPORTED = 9
};

enum FileReadKind {
	FILE_READ_DATA = 0,
	FILE_READ_END = 1,
	FILE_READ_FAILED = 2
};

enum DirectoryStepKind {
	DIRECTORY_STEP_ENTRY = 0,
	DIRECTORY_STEP_END = 1,
	DIRECTORY_STEP_FAILED = 2
};

enum FileSystemCloseKind {
	FS_CLOSED_NOW = 0,
	FS_ALREADY_CLOSED = 1,
	FS_CLOSE_FAILED = 2
};

enum PrivateFileReadKind {
	PRIVATE_FILE_DATA = 0,
	PRIVATE_FILE_MISSING = 1,
	PRIVATE_FILE_READ_FAILED = 2
};

enum DurableReplaceKind {
	DURABLE_REPLACE_COMMITTED = 0,
	DURABLE_REPLACE_FAILED = 1,
	DURABLE_REPLACE_DURABILITY_UNCERTAIN = 2
};

class FileSystemError {
	private FileSystemErrorKind _kind;
	private string _operation;
	private string _path;
	private int _nativeCode;
	private string _message;

	public FileSystemError(FileSystemErrorKind kind, string operation, string path, int nativeCode, string message) {
		self._kind = kind;
		self._operation = operation == null ? "" : operation;
		self._path = path == null ? "" : path;
		self._nativeCode = nativeCode;
		self._message = message == null ? "" : message;
	}

	class FileSystemError invalid(string operation, string path) { return FileSystemError(FS_INVALID_ARGUMENT, operation, path, 0, "filesystem argument is invalid"); }

	class FileSystemError closed(string operation, string path) { return FileSystemError(FS_CLOSED, operation, path, 0, "filesystem handle is closed"); }

	class FileSystemError unsupported(string operation, string path) { return FileSystemError(FS_UNSUPPORTED, operation, path, 0, "exact filesystem handles are unsupported"); }

	class FileSystemError changed(string operation, string path, int nativeCode = 0) { return FileSystemError(FS_CHANGED, operation, path, nativeCode, "filesystem entry changed during the operation"); }

	class FileSystemError symlink(string operation, string path) { return FileSystemError(FS_SYMLINK, operation, path, ELOOP, "filesystem operation refuses a symbolic link"); }

	class FileSystemError wrongType(string operation, string path) { return FileSystemError(FS_WRONG_TYPE, operation, path, 0, "filesystem entry has the wrong type"); }

	class FileSystemError fromNative(string operation, string path, int nativeCode) {
		FileSystemErrorKind kind = FS_IO;
		if (nativeCode == EINVAL || nativeCode == ENAMETOOLONG) {
			kind = FS_INVALID_ARGUMENT;
		} else if (nativeCode == ENOENT) {
			kind = FS_NOT_FOUND;
		} else if (nativeCode == EACCES || nativeCode == EPERM) {
			kind = FS_ACCESS_DENIED;
		} else if (nativeCode == ELOOP) {
			kind = FS_SYMLINK;
		} else if (nativeCode == ENOTDIR || nativeCode == EISDIR) {
			kind = FS_WRONG_TYPE;
		} else if (nativeCode == EMFILE || nativeCode == ENFILE || nativeCode == ENOMEM || nativeCode == EOVERFLOW || nativeCode == EAGAIN || nativeCode == ENOSPC || nativeCode == EFBIG) {
			kind = FS_RESOURCE_EXHAUSTED;
		} else if (nativeCode == ENOSYS || nativeCode == ENOTSUP) {
			kind = FS_UNSUPPORTED;
		}
		return FileSystemError(kind, operation, path, nativeCode, Strings.copy(strerror(nativeCode)));
	}
#if defined(_WIN32)

	/* A Win32 error code, or a negative WindowsFileStatus, from the Windows
	 * provider (Windows/Win32FileSystemProvider.btrc). The code and the system's
	 * text are kept; the kind follows windows-os-services.md's table. Callers
	 * classify ERROR_LOCK_VIOLATION from a contended LockFileEx themselves. */
	class FileSystemError fromWindows(string operation, string path, int nativeCode) {
		if (nativeCode == -1) { return FileSystemError(FS_INVALID_ARGUMENT, operation, path, nativeCode, "filesystem argument is not a name or path Windows can address"); }
		if (nativeCode == -2) { return FileSystemError(FS_UNSUPPORTED, operation, path, nativeCode, "this Windows file system does not support the operation"); }
		if (nativeCode == -3) { return FileSystemError(FS_WRONG_TYPE, operation, path, nativeCode, "filesystem entry has the wrong type"); }
		if (nativeCode == -4) { return FileSystemError(FS_ACCESS_DENIED, operation, path, nativeCode, "filesystem entry is not private to the current user"); }
		FileSystemErrorKind kind = FS_IO;
		if (nativeCode == 2 || nativeCode == 3) {
			kind = FS_NOT_FOUND;
		} else if (nativeCode == 5 || nativeCode == 19 || nativeCode == 32 || nativeCode == 33 || nativeCode == 1314) {
			kind = FS_ACCESS_DENIED;
		} else if (nativeCode == 87 || nativeCode == 123 || nativeCode == 161 || nativeCode == 206 || nativeCode == 1113) {
			kind = FS_INVALID_ARGUMENT;
		} else if (nativeCode == 4 || nativeCode == 8 || nativeCode == 14 || nativeCode == 39 || nativeCode == 112) {
			kind = FS_RESOURCE_EXHAUSTED;
		} else if (nativeCode == 1 || nativeCode == 50 || nativeCode == 120) {
			kind = FS_UNSUPPORTED;
		} else if (nativeCode == 267) {
			kind = FS_WRONG_TYPE;
		}
		return FileSystemError(kind, operation, path, nativeCode, __btrc_string_adopt(btrcWinMessage(nativeCode)));
	}
#endif

	/* A target that vanished, became a symlink or changed type while an
	 * operation held its earlier identity is a change, not an absence. */
	public FileSystemError asChange(string operation, string path) {
		if (self._kind == FS_NOT_FOUND || self._kind == FS_SYMLINK || self._kind == FS_WRONG_TYPE) {
			return FileSystemError.changed(operation, path, self._nativeCode);
		}
		return self;
	}

	public FileSystemErrorKind kind() { return self._kind; }

	public string operation() { return self._operation; }

	public string path() { return self._path; }

	public int nativeCode() { return self._nativeCode; }

	public string message() { return self._message; }
}

/* The one value-or-error outcome of every FileSystem open, read, snapshot and
 * resolution: FileSystemOutcome<FileHandle>, <DirectoryHandle>, <Bytes> and so
 * on. A producer passes exactly one of a value and an error, so ok() is true
 * when no error was recorded. Outcomes with a third, non-error terminal state
 * (end of data, a missing file, an already closed handle) keep their own
 * kinded types; see the package README. */
class FileSystemOutcome<T> {
	private T _value;
	private FileSystemError? _error;

	public FileSystemOutcome(T value, FileSystemError? error) {
		self._value = value;
		self._error = error;
	}

	public bool ok() { return self._error == null; }

	public T value() {
		if (self._error != null) { throw "failed filesystem outcome has no value"; }
		return self._value;
	}

	public FileSystemError error() {
		if (self._error == null) { throw "successful filesystem outcome has no error"; }
		return self._error;
	}
}

class FileReadOutcome {
	private FileReadKind _kind;
	private Bytes? _bytes;
	private FileSystemError? _error;

	private FileReadOutcome(FileReadKind kind, Bytes? bytes, FileSystemError? error) {
		self._kind = kind;
		self._bytes = bytes;
		self._error = error;
	}

	class FileReadOutcome data(Bytes bytes) {
		if (bytes == null || bytes.isEmpty()) {
			throw "filesystem data read must contain bytes";
		}
		return FileReadOutcome(FILE_READ_DATA, bytes, null);
	}

	class FileReadOutcome end() { return FileReadOutcome(FILE_READ_END, null, null); }

	class FileReadOutcome failed(FileSystemError error) {
		if (error == null) { throw "file read error is null"; }
		return FileReadOutcome(FILE_READ_FAILED, null, error);
	}

	public FileReadKind kind() { return self._kind; }

	public bool ok() { return self._kind != FILE_READ_FAILED; }

	public Bytes bytes() {
		if (self._bytes == null) { throw "file read has no data"; }
		return self._bytes;
	}

	public FileSystemError error() {
		if (self._error == null) { throw "file read has no error"; }
		return self._error;
	}
}

class DirectoryEntry {
	private DirectoryHandle _owner;
	private string _name;
	private string _path;
	private FileSnapshot _snapshot;

	public DirectoryEntry(DirectoryHandle owner, string name, string path, FileSnapshot snapshot) {
		if (owner == null || name == null || name.isEmpty() || path == null || path.isEmpty() || snapshot == null) {
			throw "invalid directory entry";
		}
		self._owner = owner;
		self._name = name;
		self._path = path;
		self._snapshot = snapshot;
	}

	public string name() { return self._name; }

	public string path() { return self._path; }

	public FileSnapshot snapshot() { return self._snapshot; }

	public bool belongsTo(DirectoryHandle directory) { return directory != null && self._owner == directory; }
}

class DirectoryStepOutcome {
	private DirectoryStepKind _kind;
	private DirectoryEntry? _entry;
	private FileSystemError? _error;

	private DirectoryStepOutcome(DirectoryStepKind kind, DirectoryEntry? entry, FileSystemError? error) {
		self._kind = kind;
		self._entry = entry;
		self._error = error;
	}

	class DirectoryStepOutcome withEntry(DirectoryEntry entry) {
		if (entry == null) { throw "directory step entry is null"; }
		return DirectoryStepOutcome(DIRECTORY_STEP_ENTRY, entry, null);
	}

	class DirectoryStepOutcome end() { return DirectoryStepOutcome(DIRECTORY_STEP_END, null, null); }

	class DirectoryStepOutcome failed(FileSystemError error) {
		if (error == null) { throw "directory step error is null"; }
		return DirectoryStepOutcome(DIRECTORY_STEP_FAILED, null, error);
	}

	public DirectoryStepKind kind() { return self._kind; }

	public bool ok() { return self._kind != DIRECTORY_STEP_FAILED; }

	public DirectoryEntry entry() {
		if (self._entry == null) { throw "directory step has no entry"; }
		return self._entry;
	}

	public FileSystemError error() {
		if (self._error == null) { throw "directory step has no error"; }
		return self._error;
	}
}

class FileSystemCloseOutcome {
	private FileSystemCloseKind _kind;
	private FileSystemError? _error;

	private FileSystemCloseOutcome(FileSystemCloseKind kind, FileSystemError? error) {
		self._kind = kind;
		self._error = error;
	}

	class FileSystemCloseOutcome closed() { return FileSystemCloseOutcome(FS_CLOSED_NOW, null); }

	class FileSystemCloseOutcome alreadyClosed() { return FileSystemCloseOutcome(FS_ALREADY_CLOSED, null); }

	class FileSystemCloseOutcome failed(FileSystemError error) {
		if (error == null) { throw "filesystem close error is null"; }
		return FileSystemCloseOutcome(FS_CLOSE_FAILED, error);
	}

	public FileSystemCloseKind kind() { return self._kind; }

	public bool ok() { return self._kind != FS_CLOSE_FAILED; }

	public FileSystemError error() {
		if (self._error == null) { throw "filesystem close has no error"; }
		return self._error;
	}
}

/* An immutable process-local diagnostic value for the exact file and
 * directory handles owned by BTRC's typed filesystem API: each open
 * FileHandle, DirectoryHandle, PrivateDirectory, ExclusiveFileLease and
 * AdvisoryFileLock counts once. Wrappers such as TemporaryDirectory and
 * RegularFileSnapshot are represented by the exact DirectoryHandle or
 * FileHandle they own. Native descriptors used transiently inside an
 * operation and resources owned by unrelated libraries are excluded.
 */
class FileSystemHandleInventory {
	private int _openCount;

	public FileSystemHandleInventory(int openCount) {
		if (openCount < 0) {
			throw "filesystem handle inventory cannot be negative";
		}
		self._openCount = openCount;
	}

	public int openCount() { return self._openCount; }

	public bool sameAs(FileSystemHandleInventory other) { return other != null && self._openCount == other._openCount; }
}

class FileSystemDiagnostics {
	class FileSystemHandleInventory ownedHandleInventory() {
		int count = btrcOwnedExactFileSystemHandles.load(MemoryOrder.RELAXED);
		if (count < 0) {
			fprintf(stderr, "filesystem handle inventory is negative\n");
			abort();
		}
		return FileSystemHandleInventory(count);
	}
}

#if defined(_WIN32)
/* The handle owners on windows rows.
 *
 * When the target is Windows, each POSIX handle owner below is replaced by its
 * Windows twin (`#if defined(_WIN32)`), which keeps the public methods, outcome
 * kinds and operation names. The native steps are Windows/Win32FileSystem.c's,
 * declared by Windows/Win32FileSystemProvider.btrc, the provider the package
 * manifest selects for windows rows. This region holds what the twins share.
 *
 * Windows adaptations, each pinned by a Windows test
 * (src/tests/native/filesystem_windows/):
 * - Exact opens never follow the final component. A name surrogate (symbolic
 *   link, junction or volume mount point) is FS_SYMLINK, as a POSIX symlink is.
 * - A directory's entries, a private directory's ancestors and every removal
 *   are opened relative to the held parent directory's handle, so a junction
 *   swapped in mid-walk is opened as itself and refused; it is never entered.
 * - Identity is the 64-bit volume serial number and file ID. A 128-bit file ID
 *   (ReFS) does not fit FileSnapshot and is refused as FS_UNSUPPORTED.
 * - A private directory or file is owned by the current user and has a DACL
 *   that allows only that user (protected, for directories) instead of mode
 *   0700 or 0600; one that grants anyone else access is FS_ACCESS_DENIED.
 * - Locks are LockFileEx over the whole file. They are mandatory: while one is
 *   held, other handles cannot read or write the locked file.
 * - Names compare as NTFS compares them, ordinally and ignoring case, and a
 *   name Windows paths cannot address (CON, a trailing dot, a ':' stream) is
 *   FS_INVALID_ARGUMENT.
 * - Durable replacement writes and flushes an owner-only temporary file, then
 *   renames it over the target by handle, relative to the held directory
 *   (FileRenameInformationEx, POSIX semantics). Windows has no directory
 *   fsync: the renamed file is flushed again through its handle, which
 *   commits the volume's metadata log as MOVEFILE_WRITE_THROUGH does, and a
 *   durable removal flushes the lease's lock file for the same reason.
 * - Paths are UTF-8, converted strictly to UTF-16, and used in their \\?\ form,
 *   so long and UNC paths work and MAX_PATH never applies. A relative path is
 *   resolved against the working directory read in UTF-16. */

/* Statuses Win32FileSystem.c reports beside Win32's positive error codes;
 * WINDOWS_FILE_CHANGED is DirectoryTreeRemoval's own. */
enum WindowsFileStatus {
	WINDOWS_FILE_OK = 0,
	WINDOWS_FILE_INVALID = -1,
	WINDOWS_FILE_UNSUPPORTED = -2,
	WINDOWS_FILE_WRONG_TYPE = -3,
	WINDOWS_FILE_INSECURE = -4,
	WINDOWS_FILE_CHANGED = -5
};

/* The open purposes and shapes Win32FileSystem.c defines. */
enum WindowsOpenPurpose {
	WINDOWS_OPEN_INSPECT = 0,
	WINDOWS_OPEN_READ = 1,
	WINDOWS_OPEN_LIST = 2,
	WINDOWS_OPEN_REMOVE = 3,
	WINDOWS_OPEN_LOCK = 4,
	WINDOWS_OPEN_WRITE = 5,
	WINDOWS_OPEN_PRIVATE_DIRECTORY = 6
};

enum WindowsOpenShape {
	WINDOWS_SHAPE_ANY = 0,
	WINDOWS_SHAPE_DIRECTORY = 1,
	WINDOWS_SHAPE_FILE = 2
};

/* Win32 error codes this file tests by value (winerror.h). */
enum WindowsErrorCode {
	WINDOWS_ERROR_FILE_NOT_FOUND = 2,
	WINDOWS_ERROR_PATH_NOT_FOUND = 3,
	WINDOWS_ERROR_NOT_ENOUGH_MEMORY = 8,
	WINDOWS_ERROR_LOCK_VIOLATION = 33,
	WINDOWS_ERROR_FILE_EXISTS = 80,
	WINDOWS_ERROR_ALREADY_EXISTS = 183
};

/* One owned Win32 handle, closed exactly once. */
class WindowsNativeHandle {
	private void* _value;

	public WindowsNativeHandle(void* value) { self._value = value; }

	public bool isOpen() { return self._value != null; }

	public void* value() { return self._value; }

	/* Hand the handle to a new owner; this one no longer closes it. */
	public void* transfer() {
		void* value = self._value;
		self._value = null;
		return value;
	}

	public int close() {
		if (self._value == null) { return 0; }
		void* value = self._value;
		self._value = null;
		return btrcWinClose(value);
	}

	public void __del__() { self.close(); }
}

/* What a held handle shows beyond its FileSnapshot. */
class WindowsEntry {
	private FileSnapshot _snapshot;
	private int _links;

	public WindowsEntry(FileSnapshot snapshot, int links) {
		self._snapshot = snapshot;
		self._links = links;
	}

	public FileSnapshot snapshot() { return self._snapshot; }

	public int links() { return self._links; }
}

/* The Windows seam FileSystem.btrc and ApplicationDirectories.btrc reach
 * through this module: descriptions of held handles, the no-follow walk, links,
 * tree removal and the user's folders. */
class WindowsFileSystem {
	/* Describe a held handle; a 128-bit file ID that the snapshot's 64-bit
	 * identity cannot carry is refused rather than truncated. */
	class FileSystemOutcome<WindowsEntry> describe(void* handle, string operation, string path) {
		long long fields[14];
		int status = btrcWinDescribeHandle(handle, fields);
		if (status != 0) { return new FileSystemOutcome<WindowsEntry>(null, FileSystemError.fromWindows(operation, path, status)); }
		if (fields[12] != 0LL) { return new FileSystemOutcome<WindowsEntry>(null, FileSystemError(FS_UNSUPPORTED, operation, path, 0, "the file's 128-bit identity does not fit a FileSnapshot")); }
		return new FileSystemOutcome<WindowsEntry>(WindowsEntry(FileSnapshot.fromWindowsFields(fields), (int)fields[11]), null);
	}

	/* Describe the object a path names without following its final component. */
	class FileSystemOutcome<WindowsEntry> inspectPath(string path, string operation) {
		void* handle = null;
		int status = btrcWinOpenPath(path, WINDOWS_OPEN_INSPECT, 0, null, &handle);
		if (status != 0) { return new FileSystemOutcome<WindowsEntry>(null, FileSystemError.fromWindows(operation, path, status)); }
		WindowsNativeHandle owner = WindowsNativeHandle(handle);
		return WindowsFileSystem.describe(owner.value(), operation, path);
	}

	/* Describe the entry `name` of a held directory, relative to its handle. */
	class FileSystemOutcome<WindowsEntry> inspectAt(void* directory, string name, string path, string operation) {
		void* handle = null;
		int status = btrcWinOpenAt(directory, name, WINDOWS_OPEN_INSPECT, 0, WINDOWS_SHAPE_ANY, null, &handle);
		if (status != 0) { return new FileSystemOutcome<WindowsEntry>(null, FileSystemError.fromWindows(operation, path, status)); }
		WindowsNativeHandle owner = WindowsNativeHandle(handle);
		return WindowsFileSystem.describe(owner.value(), operation, path);
	}

	/* A regular file with one link whose owner and DACL admit only the current
	 * user, as POSIX's private files are owned by the user with mode 0600. */
	class bool privateFile(void* handle, WindowsEntry entry) { return entry.snapshot().kind() == FILE_REGULAR && entry.links() == 1 && btrcWinCheckPrivate(handle, 0) == 0; }

	class bool separator(char value) { return value == '\\' || value == '/'; }

	/* The bytes of `path` naming its volume root ("C:\" is 3), 0 when the path
	 * is not drive- or UNC-absolute. */
	class int rootLength(string path) { return path == null ? 0 : btrcWinRootLength(path); }

	/* The name after a path's last separator, ignoring trailing separators. */
	class string lastComponent(string path) {
		int end = path.len();
		while (end > 0 && WindowsFileSystem.separator(path[end - 1])) { end--; }
		int start = end;
		while (start > 0 && !WindowsFileSystem.separator(path[start - 1])) { start--; }
		return path.substring(start, end - start);
	}

	/* The directory part of an absolute path, keeping a volume root's own
	 * separator ("C:\", "\\server\share\"). */
	class string parentOf(string path) {
		int end = path.len();
		while (end > 0 && WindowsFileSystem.separator(path[end - 1])) { end--; }
		while (end > 0 && !WindowsFileSystem.separator(path[end - 1])) { end--; }
		int separatorStart = end;
		while (separatorStart > 0 && WindowsFileSystem.separator(path[separatorStart - 1])) { separatorStart--; }
		string parent = path.substring(0, separatorStart);
		int root = btrcWinRootLength(path);
		return separatorStart < root ? path.substring(0, root) : parent;
	}

	class string join(string directory, string name) {
		if (directory.isEmpty()) { return Strings.copy(name); }
		return WindowsFileSystem.separator(directory[directory.len() - 1]) ? directory + name : directory + "\\" + name;
	}

	/* An absolute form of `path`: drive and UNC paths as given, anything else
	 * against the current directory, as Win32 resolves it. */
	/* A relative, root-relative or drive-relative path is resolved against the
	 * current directory in UTF-16, so a non-ASCII working directory survives. */
	class string absolute(string path) {
		if (btrcWinRootLength(path) > 0) { return Strings.copy(path); }
		char* full = null;
		if (btrcWinFullPath(path, &full) != 0 || full == null) { return ""; }
		return __btrc_string_adopt(full);
	}

	/* The directory that contains the last component of an absolute path,
	 * reached from its volume root one component at a time, relative to each
	 * held parent, never following a reparse point. `strict` refuses empty and
	 * "." components (a private directory's path must be normalized); otherwise
	 * they are skipped, as POSIX path resolution skips them. ".." is always
	 * refused: the walk never crosses one implicitly. */
	class FileSystemOutcome<WindowsNativeHandle> openParent(string absolutePath, string operation, bool strict) {
		void* root = null;
		int consumed = 0;
		int status = btrcWinOpenRoot(absolutePath, &root, &consumed);
		if (status != 0) { return new FileSystemOutcome<WindowsNativeHandle>(null, FileSystemError.fromWindows(operation + " root", absolutePath, status)); }
		WindowsNativeHandle parent = WindowsNativeHandle(root);
		int length = absolutePath.len();
		int end = length;
		while (end > consumed && WindowsFileSystem.separator(absolutePath[end - 1])) { end--; }
		int last = end;
		while (last > consumed && !WindowsFileSystem.separator(absolutePath[last - 1])) { last--; }
		int start = consumed;
		while (start < last) {
			int stop = start;
			while (stop < last && !WindowsFileSystem.separator(absolutePath[stop])) { stop++; }
			string component = absolutePath.substring(start, stop - start);
			start = stop + 1;
			if (component.isEmpty() || component.equals(".")) {
				if (strict) { return new FileSystemOutcome<WindowsNativeHandle>(null, FileSystemError.invalid(operation, absolutePath)); }
				continue;
			}
			if (component.equals("..")) { return new FileSystemOutcome<WindowsNativeHandle>(null, FileSystemError.invalid(operation, absolutePath)); }
			void* next = null;
			status = btrcWinOpenAt(parent.value(), component, WINDOWS_OPEN_PRIVATE_DIRECTORY, 0, WINDOWS_SHAPE_DIRECTORY, null, &next);
			if (status == WINDOWS_FILE_WRONG_TYPE) {
				var named = WindowsFileSystem.inspectAt(parent.value(), component, absolutePath, "inspect " + operation + " ancestor");
				if (named.ok() && named.value().snapshot().kind() == FILE_SYMLINK) { return new FileSystemOutcome<WindowsNativeHandle>(null, FileSystemError.symlink(operation + " ancestor", absolutePath)); }
				return new FileSystemOutcome<WindowsNativeHandle>(null, FileSystemError.wrongType(operation + " ancestor", absolutePath));
			}
			if (status != 0) { return new FileSystemOutcome<WindowsNativeHandle>(null, FileSystemError.fromWindows("open " + operation + " ancestor", absolutePath, status)); }
			WindowsNativeHandle opened = WindowsNativeHandle(next);
			var described = WindowsFileSystem.describe(opened.value(), "inspect " + operation + " ancestor", absolutePath);
			if (!described.ok()) { return new FileSystemOutcome<WindowsNativeHandle>(null, described.error()); }
			FileKind kind = described.value().snapshot().kind();
			if (kind == FILE_SYMLINK) { return new FileSystemOutcome<WindowsNativeHandle>(null, FileSystemError.symlink(operation + " ancestor", absolutePath)); }
			if (kind != FILE_DIRECTORY) { return new FileSystemOutcome<WindowsNativeHandle>(null, FileSystemError.wrongType(operation + " ancestor", absolutePath)); }
			parent.close();
			parent = opened;
		}
		return new FileSystemOutcome<WindowsNativeHandle>(parent, null);
	}

	/* Whether removeRecursive may delete what `path` names: its absolute form
	 * ends in a name Windows can address, never a volume root, "." or "..". */
	class bool removable(string path) {
		string absolutePath = WindowsFileSystem.absolute(path);
		if (absolutePath.isEmpty() || absolutePath.len() <= btrcWinRootLength(absolutePath)) { return false; }
		string name = WindowsFileSystem.lastComponent(absolutePath);
		return !name.isEmpty() && !name.equals(".") && !name.equals("..") && btrcWinValidComponent(name) != 0;
	}

	/* FileSystem.removeRecursive on Windows: the parent is reached without
	 * following any reparse point and the tree is removed relative to it. */
	class int removeTree(string path) {
		string absolutePath = WindowsFileSystem.absolute(path);
		if (absolutePath.isEmpty()) { return -1; }
		string name = WindowsFileSystem.lastComponent(absolutePath);
		if (name.isEmpty() || name.equals(".") || name.equals("..") || btrcWinValidComponent(name) == 0) { return -1; }
		var parent = WindowsFileSystem.openParent(absolutePath, "remove directory tree", false);
		if (!parent.ok()) { return -1; }
		WindowsNativeHandle owner = parent.value();
		int removed = WindowsFileSystem.removeTreeAt(owner.value(), name, null);
		owner.close();
		return removed == 0 ? 0 : -1;
	}

	/* The one handle-relative recursive delete behind TemporaryDirectory.close()
	 * and FileSystem.removeRecursive() on Windows: remove `name` below a held
	 * directory. Every entry is opened relative to its held parent without
	 * following it and deleted by its own handle, so a link or junction is
	 * removed itself and its target is never enumerated. Returns 0 when the
	 * name is gone (or was never there), WINDOWS_FILE_CHANGED when it is not
	 * `expected`, or the Win32 (or WindowsFileStatus) code of any other
	 * failure. Read-only entries are removed, as the POSIX removal grants
	 * itself write permission. */
	class int removeTreeAt(void* parent, string name, FileSnapshot? expected) {
		void* handle = null;
		int status = btrcWinOpenAt(parent, name, WINDOWS_OPEN_REMOVE, 0, WINDOWS_SHAPE_ANY, null, &handle);
		if (status == WINDOWS_ERROR_FILE_NOT_FOUND || status == WINDOWS_ERROR_PATH_NOT_FOUND) { return 0; }
		if (status != 0) { return status; }
		WindowsNativeHandle owner = WindowsNativeHandle(handle);
		long long fields[14];
		status = btrcWinDescribeHandle(owner.value(), fields);
		if (status != 0) { return status; }
		if (expected != null && (fields[12] != 0LL || !FileSnapshot.fromWindowsFields(fields).sameObject(expected))) { return WINDOWS_FILE_CHANGED; }
		if (fields[0] == 1LL) {
			void* cursor = btrcWinDirectoryOpen(owner.value());
			if (cursor == null) { return WINDOWS_ERROR_NOT_ENOUGH_MEMORY; }
			int result = 0;
			while (result == 0) {
				char* raw = null;
				result = btrcWinDirectoryNext(cursor, &raw);
				if (result != 0 || raw == null) { break; }
				string childName = __btrc_string_adopt(raw);
				result = WindowsFileSystem.removeTreeAt(owner.value(), childName, null);
			}
			btrcWinDirectoryClose(cursor);
			if (result != 0) { return result; }
		}
		status = btrcWinDelete(owner.value(), 1);
		int closed = owner.close();
		if (status != 0) { return status; }
		return closed;
	}

	class int symlink(string target, string link) { return btrcWinCreateSymlink(target, link) == 0 ? 0 : -1; }

	class string readLink(string path) {
		char* target = null;
		if (btrcWinReadLink(path, &target) != 0 || target == null) { return ""; }
		return __btrc_string_adopt(target);
	}

	/* The user's temporary directory: TMP, TEMP, or the profile's Temp. */
	class string temporaryRoot() {
		char* root = null;
		if (btrcWinTemporaryRoot(&root) != 0 || root == null) { return ""; }
		return __btrc_string_adopt(root);
	}

	/* FOLDERID_LocalAppData (0) or FOLDERID_RoamingAppData (1), "" when the
	 * shell cannot say; *status holds why. */
	class string knownFolder(int which, int* status) {
		char* folder = null;
		*status = btrcWinKnownFolder(which, &folder);
		if (*status != 0 || folder == null) { return ""; }
		return __btrc_string_adopt(folder);
	}
}
#endif

/* The POSIX handle owners below (FileHandle, DirectoryHandle,
 * DirectoryTreeRemoval, TemporaryDirectory, PrivateDirectory and
 * AdvisoryFileLock) compile on every row but Windows; each is followed by
 * its Windows twin, which keeps its public methods and outcome kinds. */
#if !defined(_WIN32)
class FileHandle {
	private int _descriptor;
	private string _path;
	private FileSnapshot? _openedSnapshot;

	private FileHandle(int descriptor, string path, FileSnapshot openedSnapshot) {
		self._descriptor = descriptor;
		self._path = path;
		self._openedSnapshot = openedSnapshot;
		btrcOwnExactFileSystemHandle();
	}

	class FileSystemOutcome<FileSnapshot> inspectExact(string path) {
		if (path == null || path.isEmpty()) {
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.invalid("inspect", path));
		}
		struct stat status;
		errno = 0;
		if (lstat(path, &status) != 0) {
			int nativeCode = errno;
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.fromNative("inspect", path, nativeCode));
		}
		return new FileSystemOutcome<FileSnapshot>(FileSnapshot.fromStatus(&status), null);
	}

	class FileSystemOutcome<FileHandle> openExact(string path) {
		if (path == null || path.isEmpty()) {
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.invalid("open file", path));
		}
		struct stat before;
		errno = 0;
		if (lstat(path, &before) != 0) {
			int nativeCode = errno;
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.fromNative("open file", path, nativeCode));
		}
		if (S_ISLNK(before.st_mode)) {
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.symlink("open file", path));
		}
		if (!S_ISREG(before.st_mode)) {
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.wrongType("open file", path));
		}

		errno = 0;
		int descriptor = open(path, (int)O_RDONLY | (int)O_CLOEXEC | (int)O_NOFOLLOW | (int)O_NONBLOCK);
		if (descriptor < 0) {
			int nativeCode = errno;
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.fromNative("open file", path, nativeCode));
		}

		struct stat opened;
		struct stat after;
		errno = 0;
		if (fstat(descriptor, &opened) != 0) {
			int nativeCode = errno;
			close(descriptor);
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.fromNative("inspect opened file", path, nativeCode));
		}
		if (!S_ISREG(opened.st_mode)) {
			close(descriptor);
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.wrongType("open file", path));
		}
		FileSnapshot beforeSnapshot = FileSnapshot.fromStatus(&before);
		FileSnapshot openedSnapshot = FileSnapshot.fromStatus(&opened);
		if (!openedSnapshot.sameVersion(beforeSnapshot)) {
			close(descriptor);
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.changed("open file", path));
		}
		errno = 0;
		if (lstat(path, &after) != 0) {
			int nativeCode = errno;
			close(descriptor);
			return new FileSystemOutcome<FileHandle>(null, nativeCode == ENOENT ? FileSystemError.changed("validate opened file", path, nativeCode) : FileSystemError.fromNative("validate opened file", path, nativeCode));
		}
		if (!openedSnapshot.sameVersion(FileSnapshot.fromStatus(&after))) {
			close(descriptor);
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.changed("validate opened file", path));
		}
		return new FileSystemOutcome<FileHandle>(FileHandle(descriptor, Strings.copy(path), openedSnapshot), null);
	}

	public bool isOpen() { return self._descriptor >= 0; }

	public string path() { return self._path; }

	public FileSnapshot openedSnapshot() {
		if (self._openedSnapshot == null) {
			throw "file handle has no opened snapshot";
		}
		return self._openedSnapshot;
	}

	public FileSystemOutcome<FileSnapshot> snapshot() {
		if (!self.isOpen()) {
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.closed("inspect open file", self._path));
		}
		struct stat status;
		errno = 0;
		if (fstat(self._descriptor, &status) != 0) {
			int nativeCode = errno;
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.fromNative("inspect open file", self._path, nativeCode));
		}
		return new FileSystemOutcome<FileSnapshot>(FileSnapshot.fromStatus(&status), null);
	}

	public FileReadOutcome readAt(long long offset, int maximumBytes) {
		if (offset < 0LL || maximumBytes <= 0) {
			return FileReadOutcome.failed(FileSystemError.invalid("read file", self._path));
		}
		if (!self.isOpen()) {
			return FileReadOutcome.failed(FileSystemError.closed("read file", self._path));
		}
		off_t nativeOffset = (off_t)offset;
		if ((long long)nativeOffset != offset) {
			return FileReadOutcome.failed(FileSystemError.invalid("read file", self._path));
		}
		char* buffer = (char*)malloc((size_t)maximumBytes);
		if (buffer == null) {
			return FileReadOutcome.failed(FileSystemError(FS_RESOURCE_EXHAUSTED, "read file", self._path, ENOMEM, "filesystem read buffer allocation failed"));
		}
		errno = 0;
		ssize_t length = pread(self._descriptor, buffer, (size_t)maximumBytes, nativeOffset);
		if (length < (ssize_t)0) {
			int nativeCode = errno;
			free(buffer);
			return FileReadOutcome.failed(FileSystemError.fromNative("read file", self._path, nativeCode));
		}
		if (length == (ssize_t)0) {
			free(buffer);
			return FileReadOutcome.end();
		}
		Bytes bytes = Bytes.fromRaw(buffer, (int)length);
		free(buffer);
		return FileReadOutcome.data(bytes);
	}

	public FileSystemCloseOutcome close() {
		if (!self.isOpen()) {
			return FileSystemCloseOutcome.alreadyClosed();
		}
		int descriptor = self._descriptor;
		self._descriptor = -1;
		btrcReleaseExactFileSystemHandle();
		errno = 0;
		if (close(descriptor) != 0) {
			int nativeCode = errno;
			return FileSystemCloseOutcome.failed(FileSystemError.fromNative("close file", self._path, nativeCode));
		}
		return FileSystemCloseOutcome.closed();
	}

	public void __del__() { self.close(); }
}
#else
class FileHandle {
	private void* _handle;
	private string _path;
	private FileSnapshot? _openedSnapshot;

	private FileHandle(void* handle, string path, FileSnapshot openedSnapshot) {
		self._handle = handle;
		self._path = path;
		self._openedSnapshot = openedSnapshot;
		btrcOwnExactFileSystemHandle();
	}

	/* For this package's Windows owners only: adopt a handle they opened
	 * exactly and described as `openedSnapshot`. */
	class FileHandle adoptNativeHandle(void* handle, string path, FileSnapshot openedSnapshot) { return FileHandle(handle, path, openedSnapshot); }

	class FileSystemOutcome<FileSnapshot> inspectExact(string path) {
		if (path == null || path.isEmpty()) {
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.invalid("inspect", path));
		}
		var inspected = WindowsFileSystem.inspectPath(path, "inspect");
		if (!inspected.ok()) { return new FileSystemOutcome<FileSnapshot>(null, inspected.error()); }
		return new FileSystemOutcome<FileSnapshot>(inspected.value().snapshot(), null);
	}

	class FileSystemOutcome<FileHandle> openExact(string path) {
		if (path == null || path.isEmpty()) {
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.invalid("open file", path));
		}
		var before = WindowsFileSystem.inspectPath(path, "open file");
		if (!before.ok()) { return new FileSystemOutcome<FileHandle>(null, before.error()); }
		FileSnapshot beforeSnapshot = before.value().snapshot();
		if (beforeSnapshot.kind() == FILE_SYMLINK) {
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.symlink("open file", path));
		}
		if (beforeSnapshot.kind() != FILE_REGULAR) {
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.wrongType("open file", path));
		}
		void* handle = null;
		int status = btrcWinOpenPath(path, WINDOWS_OPEN_READ, 0, null, &handle);
		if (status != 0) { return new FileSystemOutcome<FileHandle>(null, FileSystemError.fromWindows("open file", path, status)); }
		WindowsNativeHandle owner = WindowsNativeHandle(handle);
		var opened = WindowsFileSystem.describe(owner.value(), "inspect opened file", path);
		if (!opened.ok()) { return new FileSystemOutcome<FileHandle>(null, opened.error()); }
		FileSnapshot openedSnapshot = opened.value().snapshot();
		if (openedSnapshot.kind() != FILE_REGULAR) {
			return new FileSystemOutcome<FileHandle>(null, openedSnapshot.kind() == FILE_SYMLINK ? FileSystemError.changed("open file", path) : FileSystemError.wrongType("open file", path));
		}
		if (!openedSnapshot.sameVersion(beforeSnapshot)) {
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.changed("open file", path));
		}
		var after = WindowsFileSystem.inspectPath(path, "validate opened file");
		if (!after.ok()) { return new FileSystemOutcome<FileHandle>(null, after.error().asChange("validate opened file", path)); }
		if (!openedSnapshot.sameVersion(after.value().snapshot())) {
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.changed("validate opened file", path));
		}
		return new FileSystemOutcome<FileHandle>(FileHandle(owner.transfer(), Strings.copy(path), openedSnapshot), null);
	}

	public bool isOpen() { return self._handle != null; }

	public string path() { return self._path; }

	public FileSnapshot openedSnapshot() {
		if (self._openedSnapshot == null) {
			throw "file handle has no opened snapshot";
		}
		return self._openedSnapshot;
	}

	public FileSystemOutcome<FileSnapshot> snapshot() {
		if (!self.isOpen()) {
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.closed("inspect open file", self._path));
		}
		var described = WindowsFileSystem.describe(self._handle, "inspect open file", self._path);
		if (!described.ok()) { return new FileSystemOutcome<FileSnapshot>(null, described.error()); }
		return new FileSystemOutcome<FileSnapshot>(described.value().snapshot(), null);
	}

	public FileReadOutcome readAt(long long offset, int maximumBytes) {
		if (offset < 0LL || maximumBytes <= 0) {
			return FileReadOutcome.failed(FileSystemError.invalid("read file", self._path));
		}
		if (!self.isOpen()) {
			return FileReadOutcome.failed(FileSystemError.closed("read file", self._path));
		}
		char* buffer = (char*)malloc((size_t)maximumBytes);
		if (buffer == null) {
			return FileReadOutcome.failed(FileSystemError(FS_RESOURCE_EXHAUSTED, "read file", self._path, ENOMEM, "filesystem read buffer allocation failed"));
		}
		int received = 0;
		int status = btrcWinReadAt(self._handle, offset, buffer, maximumBytes, &received);
		if (status != 0) {
			free(buffer);
			return FileReadOutcome.failed(FileSystemError.fromWindows("read file", self._path, status));
		}
		if (received == 0) {
			free(buffer);
			return FileReadOutcome.end();
		}
		Bytes bytes = Bytes.fromRaw(buffer, received);
		free(buffer);
		return FileReadOutcome.data(bytes);
	}

	public FileSystemCloseOutcome close() {
		if (!self.isOpen()) {
			return FileSystemCloseOutcome.alreadyClosed();
		}
		void* handle = self._handle;
		self._handle = null;
		btrcReleaseExactFileSystemHandle();
		int status = btrcWinClose(handle);
		if (status != 0) {
			return FileSystemCloseOutcome.failed(FileSystemError.fromWindows("close file", self._path, status));
		}
		return FileSystemCloseOutcome.closed();
	}

	public void __del__() { self.close(); }
}
#endif

/* Immutable-version, read-only regular-file capability for format packages.
 * maximumBytes is fixed at open. Every successful read is exact-length and,
 * in the POSIX backend, is correlated with both the pinned descriptor and the
 * named path before and after I/O. Native descriptors never cross this API.
 */
/* Validate both a held object and the path that originally selected it. */
class ExactFileSnapshot {
	class FileSystemError? validate(FileSnapshot expected, FileSystemOutcome<FileSnapshot> held, string path, string operation) {
		if (expected == null || held == null || path == null || path.isEmpty() || operation == null || operation.isEmpty()) {
			return FileSystemError.invalid(operation, path);
		}
		if (!held.ok()) { return held.error(); }
		if (!expected.sameVersion(held.value())) {
			return FileSystemError.changed(operation, path);
		}
		FileSystemOutcome<FileSnapshot> named = FileHandle.inspectExact(path);
		if (!named.ok()) { return named.error().asChange(operation, path); }
		if (!expected.sameVersion(named.value())) {
			return FileSystemError.changed(operation, path);
		}
		return null;
	}
}

class RegularFileSnapshot {
	private FileHandle? _file;
	private FileSnapshot? _revision;
	private string _path;
	private long long _maximumBytes;
	private int _generation;
	private int _openGeneration;

	private RegularFileSnapshot(FileHandle file, FileSnapshot revision, string path, long long maximumBytes) {
		if (file == null || revision == null || path == null || path.isEmpty() || maximumBytes < 0LL) {
			throw "invalid regular file snapshot";
		}
		self._file = file;
		self._revision = revision;
		self._path = path;
		self._maximumBytes = maximumBytes;
		self._generation = 1;
		self._openGeneration = 1;
	}

	class FileSystemOutcome<RegularFileSnapshot> open(string path, long long maximumBytes) {
		if (path == null || path.isEmpty() || maximumBytes < 0LL) {
			return new FileSystemOutcome<RegularFileSnapshot>(null, FileSystemError.invalid("open regular file snapshot", path));
		}
#if !defined(_WIN32)
		if (Platform.isWindows()) {
			return new FileSystemOutcome<RegularFileSnapshot>(null, FileSystemError.unsupported("open regular file snapshot", path));
		}
#endif
		FileSystemOutcome<FileHandle> opened = FileHandle.openExact(path);
		if (!opened.ok()) {
			return new FileSystemOutcome<RegularFileSnapshot>(null, opened.error());
		}
		FileHandle file = opened.value();
		FileSnapshot revision = file.openedSnapshot();
		if (revision.size() < 0LL || revision.size() > maximumBytes) {
			file.close();
			return new FileSystemOutcome<RegularFileSnapshot>(null, FileSystemError(FS_RESOURCE_EXHAUSTED, "open regular file snapshot", path, EFBIG, "regular file exceeds the caller's open budget"));
		}
		RegularFileSnapshot snapshot = RegularFileSnapshot(file, revision, Strings.copy(path), maximumBytes);
		FileSystemError? validation = snapshot.currentVersionError("validate regular file snapshot");
		if (validation != null) {
			snapshot.close();
			return new FileSystemOutcome<RegularFileSnapshot>(null, validation);
		}
		return new FileSystemOutcome<RegularFileSnapshot>(snapshot, null);
	}

	public bool isOpen() { return self._file != null && self._generation == self._openGeneration && self._file.isOpen(); }

	public string path() { return self._path; }

	public long long size() {
		if (self._revision == null) {
			throw "regular file snapshot has no revision";
		}
		return self._revision.size();
	}

	/* FileSnapshot is immutable; cacheToken() returns fresh opaque bytes when
     * a package needs a persistent or hashed revision representation. */
	public FileSnapshot revision() {
		if (self._revision == null) {
			throw "regular file snapshot has no revision";
		}
		return self._revision;
	}

	private FileSystemError? currentVersionError(string operation) {
		if (!self.isOpen() || self._file == null || self._revision == null) {
			return FileSystemError.closed(operation, self._path);
		}
		return ExactFileSnapshot.validate(self.revision(), self._file.snapshot(), self._path, operation);
	}

	/* An exact positional read has only a byte value or a typed failure.
	 * Empty Bytes are a valid value when byteCount is zero; short reads never
	 * escape as partial success. */
	public FileSystemOutcome<Bytes> readExactAt(long long offset, int byteCount) {
		if (offset < 0LL || byteCount < 0) {
			return new FileSystemOutcome<Bytes>(null, FileSystemError.invalid("read regular file snapshot", self._path));
		}
		if (!self.isOpen()) {
			return new FileSystemOutcome<Bytes>(null, FileSystemError.closed("read regular file snapshot", self._path));
		}
		long long exactLength = (long long)byteCount;
		long long snapshotSize = self.size();
		if (offset > snapshotSize || exactLength > snapshotSize - offset || snapshotSize > self._maximumBytes) {
			return new FileSystemOutcome<Bytes>(null, FileSystemError.invalid("read regular file snapshot", self._path));
		}
		FileSystemError? before = self.currentVersionError("validate regular file snapshot before read");
		if (before != null) {
			return new FileSystemOutcome<Bytes>(null, before);
		}

		Bytes result = Bytes();
		long long cursor = offset;
		int remaining = byteCount;
		while (remaining > 0) {
			if (self._file == null) {
				return new FileSystemOutcome<Bytes>(null, FileSystemError.closed("read regular file snapshot", self._path));
			}
			FileReadOutcome part = self._file.readAt(cursor, remaining);
			if (!part.ok()) {
				FileSystemError? afterFailure = self.currentVersionError("validate regular file snapshot after failed read");
				return new FileSystemOutcome<Bytes>(null, afterFailure == null ? part.error() : afterFailure);
			}
			if (part.kind() == FILE_READ_END) {
				FileSystemError? afterEnd = self.currentVersionError("validate regular file snapshot after short read");
				return new FileSystemOutcome<Bytes>(null, afterEnd == null ? FileSystemError.changed("read regular file snapshot", self._path) : afterEnd);
			}
			Bytes bytes = part.bytes();
			int length = bytes.length();
			if (length <= 0 || length > remaining) {
				return new FileSystemOutcome<Bytes>(null, FileSystemError(FS_IO, "read regular file snapshot", self._path, EIO, "regular file returned an invalid partial read"));
			}
			result.appendBytes(bytes);
			remaining = remaining - length;
			cursor = cursor + (long long)length;
		}

		FileSystemError? after = self.currentVersionError("validate regular file snapshot after read");
		if (after != null) {
			return new FileSystemOutcome<Bytes>(null, after);
		}
		return new FileSystemOutcome<Bytes>(result, null);
	}

	public FileSystemCloseOutcome close() {
		if (!self.isOpen()) {
			return FileSystemCloseOutcome.alreadyClosed();
		}
		self._generation++;
		if (self._file == null) {
			return FileSystemCloseOutcome.alreadyClosed();
		}
		return self._file.close();
	}

	public void __del__() { self.close(); }
}

#if !defined(_WIN32)
class DirectoryHandle {
	private DIR* _directory;
	private string _path;
	private FileSnapshot? _openedSnapshot;

	private DirectoryHandle(DIR* directory, string path, FileSnapshot openedSnapshot) {
		self._directory = directory;
		self._path = path;
		self._openedSnapshot = openedSnapshot;
		btrcOwnExactFileSystemHandle();
	}

	class FileSystemOutcome<DirectoryHandle> openExact(string path) {
		if (path == null || path.isEmpty()) {
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.invalid("open directory", path));
		}
		struct stat before;
		errno = 0;
		if (lstat(path, &before) != 0) {
			int nativeCode = errno;
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.fromNative("open directory", path, nativeCode));
		}
		if (S_ISLNK(before.st_mode)) {
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.symlink("open directory", path));
		}
		if (!S_ISDIR(before.st_mode)) {
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.wrongType("open directory", path));
		}

		errno = 0;
		int descriptor = open(path, (int)O_RDONLY | (int)O_DIRECTORY | (int)O_CLOEXEC | (int)O_NOFOLLOW | (int)O_NONBLOCK);
		if (descriptor < 0) {
			int nativeCode = errno;
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.fromNative("open directory", path, nativeCode));
		}

		struct stat opened;
		struct stat after;
		errno = 0;
		if (fstat(descriptor, &opened) != 0) {
			int nativeCode = errno;
			close(descriptor);
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.fromNative("inspect opened directory", path, nativeCode));
		}
		if (!S_ISDIR(opened.st_mode)) {
			close(descriptor);
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.wrongType("open directory", path));
		}
		FileSnapshot beforeSnapshot = FileSnapshot.fromStatus(&before);
		FileSnapshot openedSnapshot = FileSnapshot.fromStatus(&opened);
		if (!openedSnapshot.sameVersion(beforeSnapshot)) {
			close(descriptor);
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.changed("open directory", path));
		}
		errno = 0;
		if (lstat(path, &after) != 0) {
			int nativeCode = errno;
			close(descriptor);
			return new FileSystemOutcome<DirectoryHandle>(null, nativeCode == ENOENT ? FileSystemError.changed("validate opened directory", path, nativeCode) : FileSystemError.fromNative("validate opened directory", path, nativeCode));
		}
		if (!openedSnapshot.sameVersion(FileSnapshot.fromStatus(&after))) {
			close(descriptor);
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.changed("validate opened directory", path));
		}
		errno = 0;
		DIR* directory = fdopendir(descriptor);
		if (directory == null) {
			int nativeCode = errno;
			close(descriptor);
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.fromNative("stream directory", path, nativeCode));
		}
		return new FileSystemOutcome<DirectoryHandle>(DirectoryHandle(directory, Strings.copy(path), openedSnapshot), null);
	}

	public bool isOpen() { return self._directory != null; }

	public string path() { return self._path; }

	public FileSnapshot openedSnapshot() {
		if (self._openedSnapshot == null) {
			throw "directory handle has no opened snapshot";
		}
		return self._openedSnapshot;
	}

	private bool validEntry(DirectoryEntry entry) { return entry != null && entry.belongsTo(self) && !entry.name().isEmpty() && !entry.name().equals(".") && !entry.name().equals("..") && !entry.name().contains("/"); }

	private string entryPath(DirectoryEntry entry) { return self._path.endsWith("/") ? self._path + entry.name() : self._path + "/" + entry.name(); }

	public FileSystemOutcome<FileSnapshot> snapshot() {
		if (!self.isOpen()) {
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.closed("inspect open directory", self._path));
		}
		struct stat status;
		errno = 0;
		if (fstat(dirfd(self._directory), &status) != 0) {
			int nativeCode = errno;
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.fromNative("inspect open directory", self._path, nativeCode));
		}
		return new FileSystemOutcome<FileSnapshot>(FileSnapshot.fromStatus(&status), null);
	}

	public DirectoryStepOutcome next() {
		if (!self.isOpen()) {
			return DirectoryStepOutcome.failed(FileSystemError.closed("read directory", self._path));
		}
		int skipped = 0;
		while (skipped <= 2) {
			errno = 0;
			struct dirent* nativeEntry = readdir(self._directory);
			if (nativeEntry == null) {
				int nativeCode = errno;
				if (nativeCode == 0) { return DirectoryStepOutcome.end(); }
				return DirectoryStepOutcome.failed(FileSystemError.fromNative("read directory", self._path, nativeCode));
			}
			string borrowedName = nativeEntry->d_name;
			if (borrowedName.equals(".") || borrowedName.equals("..")) {
				skipped++;
				continue;
			}
			string name = Strings.copy(borrowedName);
			string childPath = self._path.endsWith("/") ? self._path + name : self._path + "/" + name;
			struct stat status;
			errno = 0;
			if (fstatat(dirfd(self._directory), name, &status, AT_SYMLINK_NOFOLLOW) != 0) {
				int nativeCode = errno;
				return DirectoryStepOutcome.failed(nativeCode == ENOENT ? FileSystemError.changed("inspect directory entry", childPath, nativeCode) : FileSystemError.fromNative("inspect directory entry", childPath, nativeCode));
			}
			return DirectoryStepOutcome.withEntry(DirectoryEntry(self, name, childPath, FileSnapshot.fromStatus(&status)));
		}
		return DirectoryStepOutcome.failed(FileSystemError(FS_IO, "read directory", self._path, EIO, "directory returned too many dot entries"));
	}

	public FileSystemOutcome<FileSnapshot> inspect(DirectoryEntry entry) {
		if (!self.validEntry(entry)) {
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.invalid("inspect directory entry", self._path));
		}
		if (!self.isOpen()) {
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.closed("inspect directory entry", entry.path()));
		}
		struct stat status;
		errno = 0;
		if (fstatat(dirfd(self._directory), entry.name(), &status, AT_SYMLINK_NOFOLLOW) != 0) {
			int nativeCode = errno;
			return new FileSystemOutcome<FileSnapshot>(null, nativeCode == ENOENT ? FileSystemError.changed("inspect directory entry", entry.path(), nativeCode) : FileSystemError.fromNative("inspect directory entry", entry.path(), nativeCode));
		}
		FileSnapshot current = FileSnapshot.fromStatus(&status);
		if (!current.sameVersion(entry.snapshot())) {
			return new FileSystemOutcome<FileSnapshot>(null, FileSystemError.changed("inspect directory entry", entry.path()));
		}
		return new FileSystemOutcome<FileSnapshot>(current, null);
	}

	public FileSystemOutcome<FileHandle> openFile(DirectoryEntry entry) {
		if (!self.validEntry(entry)) {
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.invalid("open directory file", self._path));
		}
		if (!self.isOpen()) {
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.closed("open directory file", entry.path()));
		}
		if (entry.snapshot().kind() != FILE_REGULAR) {
			return new FileSystemOutcome<FileHandle>(null, entry.snapshot().kind() == FILE_SYMLINK ? FileSystemError.symlink("open directory file", entry.path()) : FileSystemError.wrongType("open directory file", entry.path()));
		}
		FileSystemOutcome<FileSnapshot> validation = self.inspect(entry);
		if (!validation.ok()) {
			return new FileSystemOutcome<FileHandle>(null, validation.error());
		}
		string childPath = self.entryPath(entry);
		FileSystemOutcome<FileHandle> opened = FileHandle.openExact(childPath);
		if (!opened.ok()) {
			return new FileSystemOutcome<FileHandle>(null, opened.error().asChange("open directory file", childPath));
		}
		FileHandle file = opened.value();
		if (!file.openedSnapshot().sameVersion(entry.snapshot())) {
			file.close();
			return new FileSystemOutcome<FileHandle>(null, FileSystemError.changed("open directory file", entry.path()));
		}
		return opened;
	}

	public FileSystemOutcome<DirectoryHandle> openDirectory(DirectoryEntry entry) {
		if (!self.validEntry(entry)) {
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.invalid("open child directory", self._path));
		}
		if (!self.isOpen()) {
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.closed("open child directory", entry.path()));
		}
		if (entry.snapshot().kind() != FILE_DIRECTORY) {
			return new FileSystemOutcome<DirectoryHandle>(null, entry.snapshot().kind() == FILE_SYMLINK ? FileSystemError.symlink("open child directory", entry.path()) : FileSystemError.wrongType("open child directory", entry.path()));
		}
		FileSystemOutcome<FileSnapshot> validation = self.inspect(entry);
		if (!validation.ok()) {
			return new FileSystemOutcome<DirectoryHandle>(null, validation.error());
		}
		string childPath = self.entryPath(entry);
		FileSystemOutcome<DirectoryHandle> opened = DirectoryHandle.openExact(childPath);
		if (!opened.ok()) {
			return new FileSystemOutcome<DirectoryHandle>(null, opened.error().asChange("open child directory", childPath));
		}
		DirectoryHandle directory = opened.value();
		if (!directory.openedSnapshot().sameVersion(entry.snapshot())) {
			directory.close();
			return new FileSystemOutcome<DirectoryHandle>(null, FileSystemError.changed("open child directory", entry.path()));
		}
		return opened;
	}

	public FileSystemCloseOutcome close() {
		if (!self.isOpen()) {
			return FileSystemCloseOutcome.alreadyClosed();
		}
		DIR* directory = self._directory;
		self._directory = null;
		btrcReleaseExactFileSystemHandle();
		errno = 0;
		if (closedir(directory) != 0) {
			int nativeCode = errno;
			return FileSystemCloseOutcome.failed(FileSystemError.fromNative("close directory", self._path, nativeCode));
		}
		return FileSystemCloseOutcome.closed();
	}

	public void __del__() { self.close(); }
}

/* The one descriptor-relative recursive delete behind both
 * TemporaryDirectory.close() and FileSystem.removeRecursive(). POSIX has no
 * unlink-by-descriptor operation, so a caller that needs stronger
 * concurrent-rename guarantees serializes mutations in the parent; a caller
 * holding an open lease on the root additionally prevents inode reuse. */
class DirectoryTreeRemoval {
	/* Remove `name` below an open directory: 0 when it is gone (or was never
	 * there), -2 when it is not `expected` or changed during removal, -1 on
	 * any other failure. Each directory is opened without following its final
	 * component, its root identity is refused, and it gains owner write and
	 * search permission so its own entries can be unlinked. Its identity is
	 * revalidated immediately before unlinkat(). */
	class int removeAt(int parentDescriptor, string name, FileSnapshot? expected) {
		struct stat named;
		errno = 0;
		if (fstatat(parentDescriptor, name, &named, AT_SYMLINK_NOFOLLOW) != 0) {
			return errno == ENOENT ? 0 : -1;
		}
		FileSnapshot namedSnapshot = FileSnapshot.fromStatus(&named);
		if (expected != null && !namedSnapshot.sameObject(expected)) {
			return -2;
		}
		if (!S_ISDIR(named.st_mode)) {
			return unlinkat(parentDescriptor, name, 0) == 0 ? 0 : -1;
		}

		errno = 0;
		int descriptor = openat(parentDescriptor, name, (int)O_RDONLY | (int)O_DIRECTORY | (int)O_CLOEXEC | (int)O_NOFOLLOW | (int)O_NONBLOCK);
		if (descriptor < 0) { return -1; }
		struct stat opened;
		struct stat root;
		if (fstat(descriptor, &opened) != 0 || stat("/", &root) != 0 || !S_ISDIR(opened.st_mode) || opened.st_dev != named.st_dev || opened.st_ino != named.st_ino || (opened.st_dev == root.st_dev && opened.st_ino == root.st_ino)) {
			close(descriptor);
			return -2;
		}
		mode_t required = (mode_t)S_IWUSR | (mode_t)S_IXUSR;
		if ((((mode_t)opened.st_mode) & required) != required && fchmod(descriptor, ((mode_t)opened.st_mode) | required) != 0) {
			close(descriptor);
			return -1;
		}
		DIR* directory = fdopendir(descriptor);
		if (directory == null) {
			close(descriptor);
			return -1;
		}

		int result = 0;
		while (true) {
			errno = 0;
			struct dirent* entry = readdir(directory);
			if (entry == null) {
				if (errno != 0) { result = -1; }
				break;
			}
			string borrowedName = entry->d_name;
			if (borrowedName.equals(".") || borrowedName.equals("..")) {
				continue;
			}
			string childName = Strings.copy(borrowedName);
			result = DirectoryTreeRemoval.removeAt(dirfd(directory), childName, null);
			if (result != 0) { break; }
		}
		if (closedir(directory) != 0 && result == 0) { result = -1; }
		if (result != 0) { return result; }

		struct stat finalStatus;
		if (fstatat(parentDescriptor, name, &finalStatus, AT_SYMLINK_NOFOLLOW) != 0 || !S_ISDIR(finalStatus.st_mode) || finalStatus.st_dev != opened.st_dev || finalStatus.st_ino != opened.st_ino) {
			return -2;
		}
		return unlinkat(parentDescriptor, name, AT_REMOVEDIR) == 0 ? 0 : -1;
	}
}

class TemporaryDirectory {
	private string _path;
	private bool _open;
	private DirectoryHandle _lease;

	private TemporaryDirectory(string path, DirectoryHandle lease) {
		self._path = path;
		self._open = true;
		self._lease = lease;
	}

	/* A prefix names one leaf: never empty, a dot entry or a separator. */
	class bool validPrefix(string prefix) { return prefix != null && !prefix.isEmpty() && !prefix.equals(".") && !prefix.equals("..") && !prefix.contains("/") && !prefix.contains("\\") && !prefix.contains(":"); }

	class string templatePath(string prefix) {
		string base = Environment.get("TMPDIR", "/tmp");
		return base.endsWith("/") ? base + prefix + ".XXXXXX" : base + "/" + prefix + ".XXXXXX";
	}

	/* Create a fresh private directory from a mkdtemp template and return its
	 * canonical path. On failure nothing is left behind, errno holds the
	 * cause and the result is empty. FileSystem.tempDir uses this too, so both
	 * creators fail the same way when the new directory cannot be resolved. */
	class string reservePath(string templatePath) {
		size_t length = strlen(templatePath);
		char* raw = (char*)malloc(length + (size_t)1);
		if (raw == null) {
			errno = ENOMEM;
			return "";
		}
		memcpy(raw, templatePath, length + (size_t)1);
		errno = 0;
		if (mkdtemp(raw) == null) {
			int nativeCode = errno;
			free(raw);
			errno = nativeCode;
			return "";
		}
		errno = 0;
		char* canonical = realpath(raw, null);
		if (canonical == null) {
			int nativeCode = errno;
			rmdir(raw);
			free(raw);
			errno = nativeCode;
			return "";
		}
		free(raw);
		return __btrc_string_adopt(canonical);
	}

	class FileSystemOutcome<TemporaryDirectory> create(string prefix) {
		if (!TemporaryDirectory.validPrefix(prefix)) {
			return new FileSystemOutcome<TemporaryDirectory>(null, FileSystemError.invalid("create temporary directory", prefix));
		}
		string templatePath = TemporaryDirectory.templatePath(prefix);
		string path = TemporaryDirectory.reservePath(templatePath);
		if (path.isEmpty()) {
			int nativeCode = errno;
			return new FileSystemOutcome<TemporaryDirectory>(null, FileSystemError.fromNative("create temporary directory", templatePath, nativeCode));
		}
		FileSystemOutcome<DirectoryHandle> opened = DirectoryHandle.openExact(path);
		if (!opened.ok()) {
			rmdir(path);
			return new FileSystemOutcome<TemporaryDirectory>(null, opened.error());
		}
		return new FileSystemOutcome<TemporaryDirectory>(TemporaryDirectory(path, opened.value()), null);
	}

	public bool isOpen() { return self._open; }

	public string path() { return self._path; }

	private string parentPath() {
		int separator = self._path.lastIndexOf("/");
		if (separator < 0) { return "."; }
		if (separator == 0) { return "/"; }
		return self._path.substring(0, separator);
	}

	private string baseName() {
		int separator = self._path.lastIndexOf("/");
		if (separator < 0) { return Strings.copy(self._path); }
		return self._path.substring(separator + 1, self._path.len() - separator - 1);
	}

	public FileSystemCloseOutcome close() {
		if (!self._open) { return FileSystemCloseOutcome.alreadyClosed(); }
		self._open = false;
		struct stat named;
		errno = 0;
		if (lstat(self._path, &named) != 0) {
			int nativeCode = errno;
			FileSystemCloseOutcome leaseClose = self._lease.close();
			if (nativeCode == ENOENT && leaseClose.ok()) {
				return FileSystemCloseOutcome.closed();
			}
			if (!leaseClose.ok()) { return leaseClose; }
			return FileSystemCloseOutcome.failed(FileSystemError.fromNative("remove temporary directory", self._path, nativeCode));
		}
		FileSnapshot current = FileSnapshot.fromStatus(&named);
		if (!S_ISDIR(named.st_mode) || !current.sameObject(self._lease.openedSnapshot())) {
			self._lease.close();
			return FileSystemCloseOutcome.failed(FileSystemError.changed("remove temporary directory", self._path));
		}
		string parent = self.parentPath();
		string name = self.baseName();
		errno = 0;
		int parentDescriptor = open(parent, (int)O_RDONLY | (int)O_DIRECTORY | (int)O_CLOEXEC | (int)O_NOFOLLOW | (int)O_NONBLOCK);
		if (parentDescriptor < 0) {
			int nativeCode = errno;
			self._lease.close();
			return FileSystemCloseOutcome.failed(FileSystemError.fromNative("open temporary directory parent", parent, nativeCode));
		}
		int removed = DirectoryTreeRemoval.removeAt(parentDescriptor, name, self._lease.openedSnapshot());
		int nativeCode = errno;
		close(parentDescriptor);
		FileSystemCloseOutcome leaseClose = self._lease.close();
		if (removed == -2) {
			return FileSystemCloseOutcome.failed(FileSystemError.changed("remove temporary directory", self._path, nativeCode));
		}
		if (removed != 0) {
			return FileSystemCloseOutcome.failed(FileSystemError(FS_IO, "remove temporary directory", self._path, nativeCode, "temporary directory cleanup failed"));
		}
		if (!leaseClose.ok()) { return leaseClose; }
		return FileSystemCloseOutcome.closed();
	}

	public void __del__() { self.close(); }
}
