/* btrc standard library — declarative UI
 * Portable model first: build a UI tree, render HTML/CSS, then hand it to a
 * platform backend. Native GTK/AppKit/WinUI backends can share this model.
 */

import Library.FileSystem;
import Library.Process;
import Library.Strings;
import Library.Vector;

class HTML {
	class string escape(string raw) {
		string text = Strings.replace(raw, "&", "&amp;");
		text = Strings.replace(text, "\"", "&quot;");
		text = Strings.replace(text, "'", "&#39;");
		text = Strings.replace(text, "<", "&lt;");
		text = Strings.replace(text, ">", "&gt;");
		return text;
	}
}

class UINode {
	public string tag;
	public string textContent;
	public bool rawText;
	public Vector<string> attributes;
	public Vector<UINode> children;

	public UINode(string tag) {
		self.tag = tag;
		self.textContent = "";
		self.rawText = false;
		self.attributes = [];
		self.children = [];
	}

	public UINode text(string value) {
		self.textContent = value;
		self.rawText = false;
		return self;
	}

	public UINode raw(string value) {
		self.textContent = value;
		self.rawText = true;
		return self;
	}

	public UINode attr(string name, string value) {
		self.attributes.push(f"{name}=\"{HTML.escape(value)}\"");
		return self;
	}

	public UINode id(string value) { return self.attr("id", value); }

	public UINode className(string value) { return self.attr("class", value); }

	public UINode style(string value) { return self.attr("style", value); }

	public UINode child(UINode node) {
		self.children.push(node);
		return self;
	}

	public UINode childrenFrom(Vector<UINode> nodes) {
		for node in nodes {
			self.children.push(node);
		}
		return self;
	}

	public string renderAttributes() {
		if (self.attributes.len == 0) { return ""; }
		return " " + self.attributes.join(" ");
	}

	public bool isVoidElement() { return self.tag.equals("br") || self.tag.equals("hr") || self.tag.equals("img") || self.tag.equals("input") || self.tag.equals("link") || self.tag.equals("meta"); }

	public string renderHtml() {
		string attrs = self.renderAttributes();
		if (self.isVoidElement()) {
			return f"<{self.tag}{attrs}>";
		}

		string body = "";
		if (!self.textContent.isEmpty()) {
			body = self.rawText ? self.textContent : HTML.escape(self.textContent);
		}
		for node in self.children {
			body = f"{body}{node.renderHtml()}";
		}
		return f"<{self.tag}{attrs}>{body}</{self.tag}>";
	}
}

class UIDocument {
	public string title;
	public string css;
	public UINode body;

	public UIDocument(string title, UINode body) {
		self.title = title;
		self.css = "";
		self.body = body;
	}

	public UIDocument style(string css) {
		self.css = css;
		return self;
	}

	public string renderHtml() {
		string cssBlock = self.css.isEmpty() ? "" : f"<style>{self.css}</style>";
		return f"<!doctype html><html><head><meta charset=\"utf-8\"><title>{HTML.escape(self.title)}</title>{cssBlock}</head><body>{self.body.renderHtml()}</body></html>";
	}

	public void writeHtml(string path) { FileSystem.writeText(path, self.renderHtml()); }
}

class HTMLView {
	public UIDocument document;

	public HTMLView(UIDocument document) { self.document = document; }

	public string render() { return self.document.renderHtml(); }

	public void write(string path) { self.document.writeHtml(path); }
}

class NativeView {
	public UINode root;

	public NativeView(UINode root) { self.root = root; }
}

class Window {
	public string title;
	public int width;
	public int height;
	public HTMLView html;

	public Window(string title, int width, int height, HTMLView html) {
		self.title = title;
		self.width = width;
		self.height = height;
		self.html = html;
	}
}

class TrayItem {
	public string label;
	public string command;
	public bool enabled;
	public string stateCommand;  /* non-empty: exit 0 renders a checkmark */

	public TrayItem(string label, string command) {
		self.label = label;
		self.command = command;
		self.enabled = true;
		self.stateCommand = "";
	}

	public TrayItem disabled() {
		self.enabled = false;
		return self;
	}

	public string renderLabel() { return self.enabled ? self.label : f"{self.label} (disabled)"; }
}

class Tray {
	public string title;
	public string tooltip;
	public string iconPath;
	public Vector<TrayItem> items;

	public Tray(string title) {
		self.title = title;
		self.tooltip = title;
		self.iconPath = "";
		self.items = [];
	}

	public Tray icon(string path) {
		self.iconPath = path;
		return self;
	}

	public Tray tip(string text) {
		self.tooltip = text;
		return self;
	}

	public Tray item(string label, string command) {
		self.items.push(TrayItem(label, command));
		return self;
	}

	/* A checkable item: the mark mirrors stateCommand's exit status (0 = on),
     * probed when the menu is realized and again after each activation. */
	public Tray checkItem(string label, string command, string stateCommand) {
		TrayItem entry = TrayItem(label, command);
		entry.stateCommand = stateCommand;
		self.items.push(entry);
		return self;
	}

	public Tray add(TrayItem item) {
		self.items.push(item);
		return self;
	}
}

class HTMLUIBackend {
	public string opener;

	public HTMLUIBackend(string opener) { self.opener = opener; }

	public Command openCommand(string path) { return Command(self.opener).arg(path); }

	public ExecResult openFile(string path) {
		var shell = UnixShell();
		return shell.run(self.openCommand(path), stdout=CommandOutput.stream(), stderr=CommandOutput.stream(), logFailure=false);
	}

	public ExecResult openWindow(Window window, string path) {
		window.html.write(path);
		return self.openFile(path);
	}
}

class NativeUIBackend {
	public string name;
	public HTMLUIBackend htmlBackend;

	public NativeUIBackend(string name, HTMLUIBackend htmlBackend) {
		self.name = name;
		self.htmlBackend = htmlBackend;
	}

	public bool isMac() { return self.name.equals("macos"); }

	public bool isLinux() { return self.name.equals("linux"); }

	public bool isWindows() { return self.name.equals("windows"); }

	public Command unsupportedWindowsCommand(string feature) { return Command("powershell -NoProfile -Command").arg(f"Write-Error 'Native {feature} are not implemented for Windows'"); }

	public Command notifyCommand(string title, string body) {
		if (self.isMac()) {
			string script = "display notification " + NativeUI.applescriptString(body) + " with title " + NativeUI.applescriptString(title);
			return Command("osascript -e").arg(script);
		}
		if (self.isLinux()) {
			return Command("notify-send").arg(title).arg(body);
		}
		return self.unsupportedWindowsCommand("notifications");
	}

	public Command alertCommand(string title, string body) {
		if (self.isMac()) {
			string script = "display dialog " + NativeUI.applescriptString(body) + " with title " + NativeUI.applescriptString(title) + " buttons {\"OK\"} default button \"OK\"";
			return Command("osascript -e").arg(script);
		}
		if (self.isLinux()) {
			return Command("zenity --info").flag("--title", title).flag("--text", body);
		}
		return self.unsupportedWindowsCommand("dialogs");
	}

	public ExecResult notify(string title, string body) { return UnixShell().run(self.notifyCommand(title, body), stdout=CommandOutput.stream(), stderr=CommandOutput.stream(), logFailure=false); }

	public ExecResult alert(string title, string body) { return UnixShell().run(self.alertCommand(title, body), stdout=CommandOutput.stream(), stderr=CommandOutput.stream(), logFailure=false); }

	public ExecResult openFile(string path) { return self.htmlBackend.openFile(path); }

	public ExecResult openWindow(Window window, string path) { return self.htmlBackend.openWindow(window, path); }
}

class LinuxUIBuilder {
	class HTMLUIBackend html() { return HTMLUIBackend("xdg-open"); }

	class NativeUIBackend native() { return NativeUIBackend("linux", LinuxUIBuilder.html()); }
}

class MacUIBuilder {
	class HTMLUIBackend html() { return HTMLUIBackend("open"); }

	class NativeUIBackend native() { return NativeUIBackend("macos", MacUIBuilder.html()); }
}

class WindowsUIBuilder {
	class HTMLUIBackend html() { return HTMLUIBackend("powershell"); }

	class NativeUIBackend native() { return NativeUIBackend("windows", WindowsUIBuilder.html()); }
}

class UI {
	class UINode node(string tag) { return UINode(tag); }

	class UINode text(string value) { return UINode("span").text(value); }

	class UINode rawHtml(string value) { return UINode("div").raw(value); }

	class UINode div() { return UINode("div"); }

	class UINode button(string label) { return UINode("button").text(label); }

	class UINode input(string name, string value) { return UINode("input").attr("name", name).attr("value", value); }

	class UIDocument document(string title, UINode body) { return UIDocument(title, body); }
}

class NativeUI {
	class string applescriptString(string raw) {
		string escaped = Strings.replace(raw, "\\", "\\\\");
		escaped = Strings.replace(escaped, "\"", "\\\"");
		return "\"" + escaped + "\"";
	}

	class NativeUIBackend detect() {
		var result = UnixShell().run("uname -s", logFailure=false);
		string kernel = result.stdout().trim();
		if (kernel.equals("Darwin")) { return MacUIBuilder.native(); }
		if (kernel.contains("MINGW") || kernel.contains("MSYS") || kernel.contains("CYGWIN")) {
			return WindowsUIBuilder.native();
		}
		return LinuxUIBuilder.native();
	}
}

class UIRuntime {
	class Thread<int> runCommandAsync(Command command) {
		return spawn(() => {
				var result = UnixShell().run(command);
				return result.code;
			});
	}

	class Thread<int> notifyAsync(NativeUIBackend backend, string title, string body) {
		return spawn(() => {
				ExecResult result = backend.notify(title, body);
				return result.code;
			});
	}
}

class State<T> {
	public T value;
	public int version;

	public State(T value) {
		self.value = value;
		self.version = 0;
	}

	public T get() { return self.value; }

	public State<T> set(T value) {
		self.value = value;
		self.version++;
		return self;
	}

	public bool changedSince(int seenVersion) { return self.version != seenVersion; }
}

class Signal {
	public Vector<string> events;

	public Signal() { self.events = []; }

	public Signal emit(string value) {
		self.events.push(value);
		return self;
	}

	public bool hasEvents() { return self.events.len > 0; }

	public string latest() { return self.events.last(); }

	public void clear() { self.events.clear(); }
}
