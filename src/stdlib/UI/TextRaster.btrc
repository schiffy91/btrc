/* Text runs as transparent Library.Image rasters.
 *
 * Painters that compose their own images (rulers, meters, note charts) draw
 * labels through here so on-screen text is the platform's system font when
 * the session's typography carries a raster provider, and the deterministic
 * 5x7 glyph painter otherwise. Both paths produce tightly packed RGBA8 with
 * straight alpha: background (0, 0, 0, 0), glyphs tinted with the colour.
 */

import Library.Image;
import Library.UI.Render;
import Library.UI.Text;
import Library.UI.Typography;

class UITextRaster {
	class int maximumBytes() { return UITypography.rasterMaximumBytes(); }

	/* Cut a run at a scalar boundary so it fits the provider's byte bound; a
	 * malformed byte ends the run there. */
	class string bounded(string value) { return UIText.prefix(value, UITextRaster.maximumBytes()); }

	/* Tint a white straight-alpha raster in place: rgb from the colour, alpha
	 * scaled by the colour's alpha. */
	class void tint(Image image, UIColor color) { image.tintCoverage(color.rgba()); }

	/* The platform raster, tinted, in backing pixels; null without a provider
	 * or when it rejects the run. */
	class Image? tryPlatformRasterize(UITypography typography, string value, int fontSize, int lineHeight, int fontWeight, UIColor color, float backingScale = 1.0f) { return typography.tintedPlatformRaster(value, fontSize, lineHeight, fontWeight, color.rgba(), backingScale); }

	/* The deterministic raster: the 5x7 glyph run's own width (one advance per
	 * scalar at the scaled size) by the scaled line height, so the raster
	 * fits its glyphs even when the typography measures natively. measure()
	 * still validates the run. */
	class Image deterministic(UITypography typography, string value, int fontSize, int lineHeight, int fontWeight, UIColor color, float backingScale = 1.0f) {
		string run = UITextRaster.bounded(value);
		typography.measure(run, fontSize, lineHeight, fontWeight);
		if (run.isEmpty()) { return Image.empty(); }
		float scale = backingScale < 0.5f ? 0.5f : (backingScale > 4.0f ? 4.0f : backingScale);
		int scaledFont = (int)((float)fontSize * scale + 0.5f);
		int scaledLine = (int)((float)lineHeight * scale + 0.5f);
		if (scaledFont < 8) { scaledFont = 8; }
		if (scaledFont > 256) { scaledFont = 256; }
		if (scaledLine < scaledFont) { scaledLine = scaledFont; }
		if (scaledLine > 512) { scaledLine = 512; }
		long long width = (long long)UIText.scalarCount(run, run.len()) * (long long)typography.advance(scaledFont);
		if (width < 1LL) { width = 1LL; }
		if (width > 4096LL) { width = 4096LL; }
		Image image = Image((int)width, scaledLine);
		UIRaster.glyphRun(image, 0, 0, run, color, scaledFont, scaledLine, fontWeight, typography, false);
		return image;
	}

	/* Platform text when available, the deterministic painter otherwise. */
	class Image rasterize(UITypography typography, string value, int fontSize, int lineHeight, int fontWeight, UIColor color, float backingScale = 1.0f) {
		Image? platform = UITextRaster.tryPlatformRasterize(typography, value, fontSize, lineHeight, fontWeight, color, backingScale);
		if (platform != null) { return platform; }
		return UITextRaster.deterministic(typography, value, fontSize, lineHeight, fontWeight, color, backingScale);
	}

	/* Straight-alpha "over" of a raster onto a canvas; keeps the canvas's own
	 * transparency, unlike the frame compositor. */
	class void blit(Image target, Image source, int left, int top) { target.compositeImage(source, left, top); }
}
