/* UTF-8 scalar boundaries for Library.UI, built on the root UTF8 rules that
 * semantics validation, text input, typography and text rasters share.
 * Offsets are byte offsets; a boundary never splits a scalar. */

import Library.Strings;

class UIText {
	/* Non-null, at most maximumBytes, and well-formed throughout. */
	class bool valid(string value, int maximumBytes = 2147483647) {
		if (value == null) { return false; }
		int length = value.len();
		return length <= maximumBytes && UTF8.valid(value, length);
	}

	class int previousBoundary(string value, int offset) { return value == null ? 0 : UTF8.previous(value, value.len(), offset); }

	/* Unlike UTF8.next, a malformed byte is not stepped over: text input only
	 * ever holds validated values, and prefix stops at the first malformed byte. */
	class int nextBoundary(string value, int offset) {
		if (value == null) { return 0; }
		int length = value.len();
		if (offset >= length) { return length; }
		int bounded = offset < 0 ? 0 : offset;
		return bounded + UTF8.width(value, length, bounded);
	}

	/* The boundary at or before offset: the start of the scalar that offset
	 * falls inside, else offset itself. */
	class int floorBoundary(string value, int offset) {
		int length = value.len();
		if (offset <= 0 || offset >= length) { return offset; }
		int candidate = offset;
		int steps = 0;
		while (candidate > 0 && steps < 3 && UTF8.continuation((int)(unsigned char)value[candidate])) {
			candidate--;
			steps++;
		}
		return UTF8.width(value, length, candidate) > offset - candidate ? candidate : offset;
	}

	class int scalarCount(string value, int endOffset) {
		if (value == null) { return 0; }
		int end = endOffset < value.len() ? endOffset : value.len();
		if (end < 0) { end = 0; }
		int index = 0;
		int count = 0;
		while (index < end) {
			int next = UIText.nextBoundary(value, index);
			if (next <= index || next > end) { break; }
			index = next;
			count++;
		}
		return count;
	}

	/* The longest scalar-boundary prefix within maximumBytes; a malformed
	 * byte ends it there, since nextBoundary cannot advance past one. */
	class string prefix(string value, int maximumBytes) {
		if (value.len() <= maximumBytes) { return value; }
		int cut = 0;
		while (cut < value.len()) {
			int next = UIText.nextBoundary(value, cut);
			if (next <= cut || next > maximumBytes) { break; }
			cut = next;
		}
		return value.substring(0, cut);
	}
}
