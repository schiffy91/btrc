/* Bounded deterministic typography shared by UI layout and presenters.
 *
 * One cell per Unicode scalar keeps proof rasters and tests platform-neutral.
 * System text is shaped and rasterized by Library.GUI (GUI.rasterizeText),
 * not through this type.
 */

import Library.Image;
import Library.Map;
import Library.Vector;
import Library.UI.Text;

enum UITextAlignment {
	UI_TEXT_ALIGN_LEFT = 0,
	UI_TEXT_ALIGN_CENTER = 1,
	UI_TEXT_ALIGN_RIGHT = 2
};

/* How a row places children shorter than itself: `align-items`. */
enum UICrossAlignment {
	UI_ALIGN_START = 0,
	UI_ALIGN_CENTER = 1,
	UI_ALIGN_END = 2
};

class UITextLine {
	private string textValue;
	private UITextMetrics metricsValue;
	private int topValue;

	public UITextLine(string text, UITextMetrics metrics, int top) {
		self.textValue = text;
		self.metricsValue = metrics;
		self.topValue = top;
	}

	public string text() { return self.textValue; }

	public UITextMetrics metrics() { return self.metricsValue; }

	public int top() { return self.topValue; }
}

/* Immutable measurement shared by layout, CPU paint and native composition. */
class UITextLayout {
	private Vector<UITextLine> linesValue = [];
	private int widthValue = 0;
	private int heightValue = 0;
	private long long metadataBytesValue = 0LL;

	public UITextLayout(Vector<UITextLine> lines) {
		for line in lines {
			self.linesValue.push(line);
			if (line.metrics().width() > self.widthValue) { self.widthValue = line.metrics().width(); }
			self.heightValue = line.top() + line.metrics().height();
			self.metadataBytesValue += 96LL + (long long)line.text().len();
		}
	}

	public int lineCount() { return self.linesValue.len; }

	public UITextLine lineAt(int index) { return self.linesValue.get(index); }

	public int width() { return self.widthValue; }

	public int height() { return self.heightValue; }

	public long long metadataBytes() { return self.metadataBytesValue; }
}

class UITextMetrics {
	private int widthValue;
	private int heightValue;
	private int ascentValue;
	private int descentValue;
	private int advanceValue;

	public UITextMetrics(int width, int height, int ascent, int descent, int advance) {
		if (width < 0 || width > 1000000000 || height < 1 || height > 4096 || ascent < 1 || ascent > height || descent < 0 || descent > height || ascent + descent > height || advance < 1 || advance > 4096) { throw "invalid UI text metrics"; }
		self.widthValue = width;
		self.heightValue = height;
		self.ascentValue = ascent;
		self.descentValue = descent;
		self.advanceValue = advance;
	}

	public int width() { return self.widthValue; }

	public int height() { return self.heightValue; }

	public int ascent() { return self.ascentValue; }

	public int descent() { return self.descentValue; }

	public int advance() { return self.advanceValue; }
}

class UITypography {
	private Map<string, UITextMetrics> measurements = {};
	private Vector<string> measurementKeys = [];
	private int nextMeasurementEviction = 0;

	private int lineBreak(string text, int fontSize, int lineHeight, int fontWeight, int width) {
		/* The deterministic font has one cell per scalar, not linguistic
		 * shaping; system text runs are measured and broken by Library.GUI. */
		int end = 0;
		int word = 0;
		int cells = 0;
		while (end < text.len()) {
			char value = text[end];
			if (value == '\n') { return end + 1; }
			if (value == '\r') { return end + (end + 1 < text.len() && text[end + 1] == '\n' ? 2 : 1); }
			if (value == ' ' || value == '\t') { word = end + 1; }
			if (cells > 0 && (cells + 1) * self.advance(fontSize) > width) { return word > 0 ? word : end; }
			end = UIText.nextBoundary(text, end);
			cells++;
		}
		return end;
	}

	public UITextLayout wrap(string value, int fontSize, int lineHeight, int fontWeight, int width) {
		if (value == null || value.len() > 4096 || width < 1 || width > 1000000000) { throw "invalid UI wrapped text bounds"; }
		self.measure("", fontSize, lineHeight, fontWeight);
		if (!UIText.valid(value)) { throw "invalid UI wrapped UTF-8"; }
		Vector<UITextLine> lines = [];
		int start = 0;
		int top = 0;
		while (start < value.len()) {
			string remaining = value.substring(start, value.len() - start);
			int consumed = self.lineBreak(remaining, fontSize, lineHeight, fontWeight, width);
			int end = consumed;
			while (end > 0 && (remaining[end - 1] == ' ' || remaining[end - 1] == '\t' || remaining[end - 1] == '\r' || remaining[end - 1] == '\n')) { end--; }
			string run = remaining.substring(0, end);
			UITextMetrics metrics = self.measure(run, fontSize, lineHeight, fontWeight);
			lines.push(UITextLine(run, metrics, top));
			top += metrics.height();
			start += consumed;
			while (start < value.len() && (value[start] == ' ' || value[start] == '\t')) { start++; }
		}
		if (lines.len == 0 || value.endsWith("\n") || value.endsWith("\r")) { lines.push(UITextLine("", self.measure("", fontSize, lineHeight, fontWeight), top)); }
		return UITextLayout(lines);
	}

	/* End ellipsis is measured with the same font provider as the displayed run.
	 * Keep the original element text; this is only its width-dependent layout. */
	public UITextLayout ellipsize(string value, int fontSize, int lineHeight, int fontWeight, int width) {
		if (value == null || value.len() > 4096 || width < 0 || width > 1000000000) { throw "invalid UI ellipsis bounds"; }
		UITextMetrics full = self.measure(value, fontSize, lineHeight, fontWeight);
		if (full.width() <= width) { return UITextLayout([UITextLine(value, full, 0)]); }
		string suffix = "…";
		if (self.measure(suffix, fontSize, lineHeight, fontWeight).width() > width) { return UITextLayout([UITextLine("", self.measure("", fontSize, lineHeight, fontWeight), 0)]); }
		int low = 0;
		int high = value.len() > 4093 ? UIText.floorBoundary(value, 4093) : value.len();
		while (low < high) {
			int middle = UIText.floorBoundary(value, low + (high - low + 1) / 2);
			if (middle == low) { middle = UIText.nextBoundary(value, low); }
			string candidate = value.substring(0, middle) + suffix;
			if (self.measure(candidate, fontSize, lineHeight, fontWeight).width() <= width) { low = middle; }
			else { high = UIText.previousBoundary(value, middle); }
		}
		string fitted = value.substring(0, low) + suffix;
		return UITextLayout([UITextLine(fitted, self.measure(fitted, fontSize, lineHeight, fontWeight), 0)]);
	}

	/* Bytes of one run a text raster accepts. */
	class int rasterMaximumBytes() { return 4096; }

	public int glyphWidth(int fontSize) {
		int width = fontSize * 5 / 7;
		return width < 1 ? 1 : width;
	}

	public int glyphHeight(int fontSize) { return fontSize; }

	public int advance(int fontSize) {
		int value = fontSize * 6 / 7;
		return value < 1 ? 1 : value;
	}

	public int cachedMeasurementCount() { return self.measurementKeys.len; }

	/* Metrics are immutable and belong to this provider's lifetime. Cap both
	 * entries and retained text; no pixel rasters are kept here. */
	public UITextMetrics measure(string value, int fontSize, int lineHeight, int fontWeight = 400) {
		if (value == null || value.len() > 4096) { return self.measureUncached(value, fontSize, lineHeight, fontWeight); }
		string key = f"{fontSize}:{lineHeight}:{fontWeight}:{value}";
		if (self.measurements.has(key)) { return self.measurements.get(key); }
		UITextMetrics measured = self.measureUncached(value, fontSize, lineHeight, fontWeight);
		if (self.measurementKeys.len == 512) {
			self.measurements.remove(self.measurementKeys.get(self.nextMeasurementEviction));
			self.measurementKeys.set(self.nextMeasurementEviction, key);
			self.nextMeasurementEviction = (self.nextMeasurementEviction + 1) % 512;
		} else { self.measurementKeys.push(key); }
		self.measurements.put(key, measured);
		return measured;
	}

	private UITextMetrics measureUncached(string value, int fontSize, int lineHeight, int fontWeight) {
		if (value == null || fontSize < 8 || fontSize > 256 || lineHeight < fontSize || lineHeight > 512 || (fontWeight != 400 && fontWeight != 500 && fontWeight != 600 && fontWeight != 700) || !UIText.valid(value)) { throw "invalid UI text measurement"; }
		int scalarCount = UIText.scalarCount(value, value.len());
		int advance = self.advance(fontSize);
		long long width = (long long)scalarCount * (long long)advance;
		if (width > 1000000000LL) { throw "UI text measurement exceeds its bound"; }
		int ascent = fontSize * 4 / 5;
		if (ascent < 1) { ascent = 1; }
		int descent = fontSize - ascent;
		return UITextMetrics((int)width, lineHeight, ascent, descent, advance);
	}

	public int alignedX(int outerX, int outerWidth, int padding, int textWidth, UITextAlignment alignment) {
		int innerWidth = outerWidth - padding * 2;
		if (innerWidth < 0) { innerWidth = 0; }
		int visibleWidth = textWidth < innerWidth ? textWidth : innerWidth;
		if (alignment == UI_TEXT_ALIGN_CENTER) { return outerX + padding + (innerWidth - visibleWidth) / 2; }
		if (alignment == UI_TEXT_ALIGN_RIGHT) { return outerX + padding + innerWidth - visibleWidth; }
		return outerX + padding;
	}

	public unsigned long long glyph(char raw) {
		char value = raw >= 'a' && raw <= 'z' ? raw - 'a' + 'A' : raw;
		switch (value) {
			case '0': return 0x3a33ae62eULL;
			case '1': return 0x3884210c4ULL;
			case '2': return 0x7c444422eULL;
			case '3': return 0x3e107420fULL;
			case '4': return 0x211f4a988ULL;
			case '5': return 0x3e107843fULL;
			case '6': return 0x3a317842eULL;
			case '7': return 0x8422221fULL;
			case '8': return 0x3a317462eULL;
			case '9': return 0x3a10f462eULL;
			case 'A': return 0x4631fc62eULL;
			case 'B': return 0x3e317c62fULL;
			case 'C': return 0x78210843eULL;
			case 'D': return 0x3e318c62fULL;
			case 'E': return 0x7c217843fULL;
			case 'F': return 0x4217843fULL;
			case 'G': return 0x7a31e843eULL;
			case 'H': return 0x4631fc631ULL;
			case 'I': return 0x7c842109fULL;
			case 'J': return 0x19294211cULL;
			case 'K': return 0x452519531ULL;
			case 'L': return 0x7c2108421ULL;
			case 'M': return 0x4631ad771ULL;
			case 'N': return 0x4631cd671ULL;
			case 'O': return 0x3a318c62eULL;
			case 'P': return 0x4217c62fULL;
			case 'Q': return 0x59358c62eULL;
			case 'R': return 0x45257c62fULL;
			case 'S': return 0x3e107043eULL;
			case 'T': return 0x10842109fULL;
			case 'U': return 0x3a318c631ULL;
			case 'V': return 0x11518c631ULL;
			case 'W': return 0x2ab5ac631ULL;
			case 'X': return 0x462a22a31ULL;
			case 'Y': return 0x108422a31ULL;
			case 'Z': return 0x7c222221fULL;
			case '-': return 0x00003e000ULL;
			case '.': return 0x300000000ULL;
			case ':': return 0x018000180ULL;
			default: return value == ' ' ? 0ULL : 0x2318c62a2ULL;
		}
	}
}
