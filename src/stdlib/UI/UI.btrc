/* btrc standard library -- native declarative UI values.
 *
 * This is the portable tree and event boundary for the renderer owned by
 * Library.App.  It deliberately contains no HTML, browser, GPU, or platform
 * handles.  Element identities are supplied by the application and remain
 * unchanged for the lifetime of the value tree.  A className is selector
 * metadata: it affects rendering only through an explicit UIStyleSheet;
 * there is no ambient browser-style cascade.
 */

import Library.Image;
import Library.Map;
import Library.Math;
import Library.Set;
import Library.Strings;
import Library.Vector;

#include "UI/Semantics.btrc"

enum UIElementKind {
	UI_COLUMN = 0,
	UI_GRID = 1,
	UI_TEXT = 2,
	UI_IMAGE = 3,
	UI_BUTTON = 4,
	UI_VIRTUAL_GRID = 5,
	UI_TEXT_INPUT = 6,
	UI_SELECT = 7,
	UI_ROW = 8
};

enum UIEventKind {
	UI_CLICKED = 0,
	UI_HOVER_ENTERED = 1,
	UI_HOVER_LEFT = 2,
	UI_SCROLLED = 3,
	UI_VIEWPORT_CHANGED = 4,
	UI_VALUE_CHANGED = 5,
	UI_RANGE_POINTER_PRESSED = 6,
	UI_RANGE_POINTER_MOVED = 7,
	UI_RANGE_POINTER_RELEASED = 8,
	UI_RANGE_POINTER_CANCELLED = 9,
	UI_RANGE_WHEEL = 10,
	UI_RANGE_ADJUSTED = 11,
	UI_SELECTION_CHANGED = 12,
	UI_NAVIGATE_BACK = 13,
	UI_NAVIGATE_FORWARD = 14
};

enum UIRangeAxis {
	UI_RANGE_HORIZONTAL = 0,
	UI_RANGE_VERTICAL = 1
};

enum UIRangeAdjustment {
	UI_RANGE_ADJUST_NONE = 0,
	UI_RANGE_ADJUST_SMALL_DECREMENT = 1,
	UI_RANGE_ADJUST_SMALL_INCREMENT = 2,
	UI_RANGE_ADJUST_LARGE_DECREMENT = 3,
	UI_RANGE_ADJUST_LARGE_INCREMENT = 4,
	UI_RANGE_ADJUST_MINIMUM = 5,
	UI_RANGE_ADJUST_MAXIMUM = 6
};

class UISemanticRange {
	private UIRangeAxis axisValue;
	private string labelValue;
	private long long minimumValue;
	private long long maximumValue;
	private long long currentValue;
	private long long smallStepValue;
	private long long largeStepValue;

	private UISemanticRange(UIRangeAxis axis, string label, long long minimum, long long maximum, long long value, long long smallStep, long long largeStep) {
		self.axisValue = axis;
		self.labelValue = label;
		self.minimumValue = minimum;
		self.maximumValue = maximum;
		self.currentValue = value;
		self.smallStepValue = smallStep;
		self.largeStepValue = largeStep;
	}

	class UISemanticRange horizontal(string label, long long minimum, long long maximum, long long value, long long smallStep = 1LL, long long largeStep = 10LL) { return UISemanticRange(UI_RANGE_HORIZONTAL, label, minimum, maximum, value, smallStep, largeStep); }

	class UISemanticRange vertical(string label, long long minimum, long long maximum, long long value, long long smallStep = 1LL, long long largeStep = 10LL) { return UISemanticRange(UI_RANGE_VERTICAL, label, minimum, maximum, value, smallStep, largeStep); }

	public UIRangeAxis axis() { return self.axisValue; }

	public string label() { return self.labelValue; }

	public long long minimum() { return self.minimumValue; }

	public long long maximum() { return self.maximumValue; }

	public long long value() { return self.currentValue; }

	public long long smallStep() { return self.smallStepValue; }

	public long long largeStep() { return self.largeStepValue; }

	public bool valid() { return self.labelValue != null && !self.labelValue.isEmpty() && self.labelValue.len() <= 512 && self.minimumValue <= self.maximumValue && self.currentValue >= self.minimumValue && self.currentValue <= self.maximumValue && self.smallStepValue > 0LL && self.largeStepValue > 0LL; }

	private long long incremented(long long step) {
		if (self.currentValue >= self.maximumValue) { return self.maximumValue; }
		if (self.currentValue > 9223372036854775807LL - step) { return self.maximumValue; }
		long long candidate = self.currentValue + step;
		return candidate > self.maximumValue ? self.maximumValue : candidate;
	}

	private long long decremented(long long step) {
		if (self.currentValue <= self.minimumValue) { return self.minimumValue; }
		if (self.currentValue < (-9223372036854775807LL - 1LL) + step) { return self.minimumValue; }
		long long candidate = self.currentValue - step;
		return candidate < self.minimumValue ? self.minimumValue : candidate;
	}

	public long long adjustedValue(UIRangeAdjustment adjustment) {
		if (!self.valid() || adjustment == UI_RANGE_ADJUST_NONE) { return self.currentValue; }
		if (adjustment == UI_RANGE_ADJUST_MINIMUM) { return self.minimumValue; }
		if (adjustment == UI_RANGE_ADJUST_MAXIMUM) { return self.maximumValue; }
		if (adjustment == UI_RANGE_ADJUST_SMALL_DECREMENT) { return self.decremented(self.smallStepValue); }
		if (adjustment == UI_RANGE_ADJUST_SMALL_INCREMENT) { return self.incremented(self.smallStepValue); }
		if (adjustment == UI_RANGE_ADJUST_LARGE_DECREMENT) { return self.decremented(self.largeStepValue); }
		if (adjustment == UI_RANGE_ADJUST_LARGE_INCREMENT) { return self.incremented(self.largeStepValue); }
		return self.currentValue;
	}
}

enum UIStyleErrorCode {
	UI_STYLE_VALID = 0,
	UI_STYLE_INVALID_DECLARATION = 1,
	UI_STYLE_UNSUPPORTED_PROPERTY = 2,
	UI_STYLE_INVALID_VALUE = 3,
	UI_STYLE_INVALID_SELECTOR = 4,
	UI_STYLE_DUPLICATE_RULE = 5,
	UI_STYLE_LIMIT_EXCEEDED = 6
};

enum UIVirtualGridErrorCode {
	UI_VIRTUAL_GRID_VALID = 0,
	UI_VIRTUAL_GRID_INVALID_TOTAL_COUNT = 1,
	UI_VIRTUAL_GRID_INVALID_COLUMNS = 2,
	UI_VIRTUAL_GRID_INVALID_ROW_HEIGHT = 3,
	UI_VIRTUAL_GRID_INVALID_FIRST_INDEX = 4
};

class UIStyleError {
	private UIStyleErrorCode errorCode;
	private string propertyName;
	private string errorMessage;

	public UIStyleError(UIStyleErrorCode code, string property, string message) {
		self.errorCode = code;
		self.propertyName = property;
		self.errorMessage = message;
	}

	class UIStyleError valid() { return UIStyleError(UI_STYLE_VALID, "", ""); }

	public UIStyleErrorCode code() { return self.errorCode; }

	public string property() { return self.propertyName; }

	public string message() { return self.errorMessage; }

	public bool ok() { return self.errorCode == UI_STYLE_VALID; }
}

class UIStyle {
	class bool decimal(string value, bool allowZero) {
		if (value == null || value.isEmpty()) { return false; }
		for (int index = 0; index < value.len(); index++) {
			char digit = value[index];
			if (digit < '0' || digit > '9') { return false; }
		}
		return allowZero || Strings.toInt(value) > 0;
	}

	class bool pixels(string value, bool allowZero) {
		if (value == null || value.len() <= 2 || !value.endsWith("px")) {
			return false;
		}
		string digits = value.substring(0, value.len() - 2);
		return digits.len() <= 4 && UIStyle.decimal(digits, allowZero) && Strings.toInt(digits) <= 4096;
	}

	class bool hexDigit(char value) { return (value >= '0' && value <= '9') || (value >= 'a' && value <= 'f') || (value >= 'A' && value <= 'F'); }

	class bool color(string value) {
		if (value == null || (value.len() != 7 && value.len() != 9) || value[0] != '#') {
			return false;
		}
		for (int index = 1; index < value.len(); index++) {
			if (!UIStyle.hexDigit(value[index])) { return false; }
		}
		return true;
	}

	class Vector<string> gradientColors(string value) {
		Vector<string> empty = [];
		if (!value.startsWith("linear-gradient(") || !value.endsWith(")")) { return empty; }
		Vector<string> colors = Strings.split(value.substring(16, value.len() - 17), ",");
		if (colors.len != 2 || !UIStyle.color(colors.get(0).trim()) || !UIStyle.color(colors.get(1).trim())) { return empty; }
		return [colors.get(0).trim(), colors.get(1).trim()];
	}

	class UIStyleError validate(string css) {
		if (css == null || css.trim().isEmpty()) {
			return UIStyleError.valid();
		}
		Vector<string> declarations = Strings.split(css, ";");
		for declarationValue in declarations {
			string declaration = declarationValue.trim();
			if (declaration.isEmpty()) { continue; }
			int separator = declaration.indexOf(":");
			if (separator <= 0 || separator >= declaration.len() - 1) {
				return UIStyleError(UI_STYLE_INVALID_DECLARATION, "", f"invalid native UI style declaration: {declaration}");
			}
			string property = declaration.substring(0, separator).trim().toLower();
			string value = declaration.substring(separator + 1, declaration.len() - separator - 1).trim();
			if (property.equals("gap") || property.equals("padding") || property.equals("padding-top") || property.equals("padding-right") || property.equals("padding-bottom") || property.equals("padding-left") || property.equals("border-radius")) {
				if (!UIStyle.pixels(value, true)) {
					return UIStyleError(UI_STYLE_INVALID_VALUE, property, f"{property} requires a non-negative px value");
				}
			} else if (property.equals("width") && value == "fit") {
				continue;
			} else if (property.equals("width") || property.equals("height")) {
				if (!UIStyle.pixels(value, false)) {
					return UIStyleError(UI_STYLE_INVALID_VALUE, property, f"{property} requires a positive px value");
				}
			} else if (property.equals("font-size")) {
				if (!UIStyle.pixels(value, false) || Strings.toInt(value.substring(0, value.len() - 2)) < 8 || Strings.toInt(value.substring(0, value.len() - 2)) > 256) {
					return UIStyleError(UI_STYLE_INVALID_VALUE, property, "font-size requires 8px..256px");
				}
			} else if (property.equals("line-height")) {
				if (!UIStyle.pixels(value, false) || Strings.toInt(value.substring(0, value.len() - 2)) < 8 || Strings.toInt(value.substring(0, value.len() - 2)) > 512) {
					return UIStyleError(UI_STYLE_INVALID_VALUE, property, "line-height requires 8px..512px");
				}
			} else if (property.equals("font-weight")) {
				if (value != "400" && value != "500" && value != "600" && value != "700") {
					return UIStyleError(UI_STYLE_INVALID_VALUE, property, "font-weight requires 400, 500, 600, or 700");
				}
			} else if (property.equals("text-wrap")) {
				if (value != "wrap" && value != "nowrap") { return UIStyleError(UI_STYLE_INVALID_VALUE, property, "text-wrap requires wrap or nowrap"); }
			} else if (property.equals("text-overflow")) {
				if (value != "clip" && value != "ellipsis") { return UIStyleError(UI_STYLE_INVALID_VALUE, property, "text-overflow requires clip or ellipsis"); }
			} else if (property.equals("text-align")) {
				if (value != "left" && value != "center" && value != "right") {
					return UIStyleError(UI_STYLE_INVALID_VALUE, property, "text-align requires left, center, or right");
				}
			} else if (property.equals("align-items")) {
				if (value != "start" && value != "center" && value != "end") {
					return UIStyleError(UI_STYLE_INVALID_VALUE, property, "align-items requires start, center, or end");
				}
			} else if (property.equals("background-image")) {
				if (value != "none" && UIStyle.gradientColors(value).len != 2) { return UIStyleError(UI_STYLE_INVALID_VALUE, property, "background-image requires none or linear-gradient(#RRGGBB[AA], #RRGGBB[AA])"); }
			} else if (property.equals("background-color") || property.equals("color") || property.equals("border-color") || property.equals("marker-color")) {
				if (!UIStyle.color(value)) {
					return UIStyleError(UI_STYLE_INVALID_VALUE, property, f"{property} requires #RRGGBB or #RRGGBBAA");
				}
			} else {
				return UIStyleError(UI_STYLE_UNSUPPORTED_PROPERTY, property, f"unsupported native UI style property: {property}");
			}
		}
		return UIStyleError.valid();
	}

	class UIStyleError validateClassName(string value) {
		if (value == null || value.isEmpty() || value.len() > 128) {
			return UIStyleError(UI_STYLE_INVALID_SELECTOR, "className", "native UI class names must contain 1..128 bytes");
		}
		for (int index = 0; index < value.len(); index++) {
			char character = value[index];
			bool valid = (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') || (character >= '0' && character <= '9') || character == '-' || character == '_';
			if (!valid) {
				return UIStyleError(UI_STYLE_INVALID_SELECTOR, "className", "native UI class names use letters, digits, '-' and '_'");
			}
		}
		return UIStyleError.valid();
	}
}

class UIStyleSheet {
	private Vector<string> selectors;
	private Vector<string> rules;
	private Vector<string> kindRules;
	private UIStyleError issueValue;
	private int ruleBytes;
	private long long revisionValue = 0LL;

	public UIStyleSheet() {
		self.selectors = [];
		self.rules = [];
		self.kindRules = [];
		for (int kind = 0; kind < 9; kind++) { self.kindRules.push(""); }
		self.issueValue = UIStyleError.valid();
		self.ruleBytes = 0;
	}

	/* An independent copy, so an app can take a base sheet and override it. */
	public UIStyleSheet copy() {
		UIStyleSheet copied = UIStyleSheet();
		copied.selectors = self.selectors.copy();
		copied.rules = self.rules.copy();
		copied.kindRules = self.kindRules.copy();
		copied.issueValue = self.issueValue;
		copied.ruleBytes = self.ruleBytes;
		copied.revisionValue = self.revisionValue;
		return copied;
	}

	public long long revision() { return self.revisionValue; }

	private void changed() {
		if (self.revisionValue == 9223372036854775807LL) { throw "native UI stylesheet revision exhausted"; }
		self.revisionValue++;
	}

	/* A rule for every element of one kind, applied after the kind defaults
	 * and before class rules. */
	public UIStyleSheet kindRule(UIElementKind kind, string css) {
		if (!self.issueValue.ok()) { return self; }
		UIStyleError ruleIssue = UIStyle.validate(css);
		if (!ruleIssue.ok()) {
			self.issueValue = ruleIssue;
			return self;
		}
		int index = (int)kind;
		if (index < 0 || index >= self.kindRules.len) { return self; }
		if ((long long)self.ruleBytes + (long long)css.len() > 65536LL) {
			self.issueValue = UIStyleError(UI_STYLE_LIMIT_EXCEEDED, "styleSheet", "native UI style sheets allow 256 rules and 64 KiB");
			return self;
		}
		self.ruleBytes += css.len() - self.kindRules.get(index).len();
		self.kindRules.set(index, css);
		self.changed();
		return self;
	}

	public string kindCssFor(UIElementKind kind) {
		int index = (int)kind;
		return index < 0 || index >= self.kindRules.len ? "" : self.kindRules.get(index);
	}

	/* Merge `css` into a class rule: existing declarations stay, the new ones
	 * follow and win per property. Creates the rule when absent. */
	public UIStyleSheet extend(string className, string css) {
		if (!self.issueValue.ok()) { return self; }
		for (int index = 0; index < self.selectors.len; index++) {
			if (!self.selectors.get(index).equals(className)) { continue; }
			UIStyleError ruleIssue = UIStyle.validate(css);
			if (!ruleIssue.ok()) {
				self.issueValue = ruleIssue;
				return self;
			}
			string merged = self.rules.get(index).trim().isEmpty() ? css : self.rules.get(index) + "; " + css;
			if ((long long)self.ruleBytes + (long long)css.len() + 2LL > 65536LL) {
				self.issueValue = UIStyleError(UI_STYLE_LIMIT_EXCEEDED, "styleSheet", "native UI style sheets allow 256 rules and 64 KiB");
				return self;
			}
			self.ruleBytes += merged.len() - self.rules.get(index).len();
			self.rules.set(index, merged);
			self.changed();
			return self;
		}
		return self.rule(className, css);
	}

	public UIStyleSheet rule(string className, string css) {
		if (!self.issueValue.ok()) { return self; }
		UIStyleError selectorIssue = UIStyle.validateClassName(className);
		if (!selectorIssue.ok()) {
			self.issueValue = selectorIssue;
			return self;
		}
		UIStyleError ruleIssue = UIStyle.validate(css);
		if (!ruleIssue.ok()) {
			self.issueValue = ruleIssue;
			return self;
		}
		if (self.selectors.len >= 256 || (long long)self.ruleBytes + (long long)className.len() + (long long)css.len() > 65536LL) {
			self.issueValue = UIStyleError(UI_STYLE_LIMIT_EXCEEDED, "styleSheet", "native UI style sheets allow 256 rules and 64 KiB");
			return self;
		}
		for selector in self.selectors {
			if (selector.equals(className)) {
				self.issueValue = UIStyleError(UI_STYLE_DUPLICATE_RULE, className, f"duplicate native UI class rule: {className}");
				return self;
			}
		}
		self.selectors.push(className);
		self.rules.push(css);
		self.ruleBytes += className.len() + css.len();
		self.changed();
		return self;
	}

	public bool ok() { return self.issueValue.ok(); }

	public UIStyleError issue() { return self.issueValue; }

	public int ruleCount() { return self.selectors.len; }

	public string classNameAt(int index) { return self.selectors.get(index); }

	public string cssAt(int index) { return self.rules.get(index); }

	public string cssFor(string className) {
		for (int index = 0; index < self.selectors.len; index++) {
			if (self.selectors.get(index).equals(className)) {
				return self.rules.get(index);
			}
		}
		return "";
	}
}

class UIVirtualGridError {
	private UIVirtualGridErrorCode errorCode;
	private string errorMessage;

	public UIVirtualGridError(UIVirtualGridErrorCode code, string message) {
		self.errorCode = code;
		self.errorMessage = message;
	}

	public UIVirtualGridErrorCode code() { return self.errorCode; }

	public string message() { return self.errorMessage; }

	public bool ok() { return self.errorCode == UI_VIRTUAL_GRID_VALID; }
}

class UIVirtualGrid {
	private int totalCountValue;
	private int columnsValue;
	private int rowHeightValue;
	private int firstIndexValue;
	private UIVirtualGridError issueValue;

	public UIVirtualGrid(int totalCount, int columns, int rowHeight, int firstDataIndex) {
		self.totalCountValue = totalCount;
		self.columnsValue = columns;
		self.rowHeightValue = rowHeight;
		self.firstIndexValue = firstDataIndex;
		self.issueValue = UIVirtualGridError(UI_VIRTUAL_GRID_VALID, "");
		if (totalCount < 0) {
			self.issueValue = UIVirtualGridError(UI_VIRTUAL_GRID_INVALID_TOTAL_COUNT, "virtual grid totalCount must be non-negative");
		} else if (columns <= 0) {
			self.issueValue = UIVirtualGridError(UI_VIRTUAL_GRID_INVALID_COLUMNS, "virtual grid columns must be positive");
		} else if (rowHeight <= 0) {
			self.issueValue = UIVirtualGridError(UI_VIRTUAL_GRID_INVALID_ROW_HEIGHT, "virtual grid rowHeight must be positive");
		} else if (firstDataIndex < 0 || firstDataIndex > totalCount) {
			self.issueValue = UIVirtualGridError(UI_VIRTUAL_GRID_INVALID_FIRST_INDEX, "virtual grid firstDataIndex must be within totalCount");
		}
	}

	public int totalCount() { return self.totalCountValue; }

	public int columns() { return self.columnsValue; }

	public int rowHeight() { return self.rowHeightValue; }

	public int firstDataIndex() { return self.firstIndexValue; }

	public UIVirtualGridError issue() { return self.issueValue; }

	public bool ok() { return self.issueValue.ok(); }
}

class UISelectOption {
	private string stableValue;
	private string labelValue;
	private bool enabledValue;

	public UISelectOption(string value, string label, bool enabled = true) {
		self.stableValue = value;
		self.labelValue = label;
		self.enabledValue = enabled;
	}

	public string value() { return self.stableValue; }

	public string label() { return self.labelValue; }

	public bool enabled() { return self.enabledValue; }

	public bool valid() { return UISemanticText.valid(self.stableValue, 512) && !self.stableValue.isEmpty() && UISemanticText.valid(self.labelValue, 512) && !self.labelValue.isEmpty(); }
}

class UISelect {
	private Vector<UISelectOption> optionValues;
	private string selectedStableValue;

	public UISelect(Vector<UISelectOption> options, string selectedValue) {
		self.optionValues = [];
		for option in options { self.optionValues.push(option); }
		self.selectedStableValue = selectedValue;
	}

	public int optionCount() { return self.optionValues.len; }

	public UISelectOption optionAt(int index) { return self.optionValues.get(index); }

	public string selectedValue() { return self.selectedStableValue; }

	public int indexOfValue(string value) {
		if (value == null) { return -1; }
		for (int index = 0; index < self.optionValues.len; index++) {
			UISelectOption option = self.optionValues.get(index);
			if (option != null && option.value().equals(value)) { return index; }
		}
		return -1;
	}

	public int selectedIndex() { return self.indexOfValue(self.selectedStableValue); }

	public string selectedLabel() {
		int index = self.selectedIndex();
		return index < 0 ? "" : self.optionValues.get(index).label();
	}

	public long long metadataBytes() {
		long long total = (long long)self.selectedStableValue.len();
		for option in self.optionValues { total += (long long)option.value().len() + (long long)option.label().len(); }
		return total;
	}

	public bool valid() {
		if (self.optionValues.len < 1 || self.optionValues.len > 128 || !UISemanticText.valid(self.selectedStableValue, 512) || self.selectedStableValue.isEmpty()) { return false; }
		for (int index = 0; index < self.optionValues.len; index++) {
			UISelectOption option = self.optionValues.get(index);
			if (option == null || !option.valid()) { return false; }
			for (int prior = 0; prior < index; prior++) {
				if (self.optionValues.get(prior).value().equals(option.value())) { return false; }
			}
		}
		return self.selectedIndex() >= 0 && self.metadataBytes() <= 131072LL;
	}
}

class UIViewportMetrics {
	private int metricWidth;
	private int metricHeight;
	private int metricScrollX;
	private int metricScrollY;

	public UIViewportMetrics(int width, int height, int scrollX, int scrollY) {
		self.metricWidth = width;
		self.metricHeight = height;
		self.metricScrollX = scrollX;
		self.metricScrollY = scrollY;
	}

	public int width() { return self.metricWidth; }

	public int height() { return self.metricHeight; }

	public int scrollX() { return self.metricScrollX; }

	public int scrollY() { return self.metricScrollY; }
}

class UIScrollDelta {
	private int deltaX;
	private int deltaY;

	public UIScrollDelta(int x, int y) {
		self.deltaX = x;
		self.deltaY = y;
	}

	public int x() { return self.deltaX; }

	public int y() { return self.deltaY; }
}

class UIPointerSample {
	private int coordinateValue;
	private int extentValue;

	public UIPointerSample(int coordinate, int extent) {
		self.coordinateValue = coordinate;
		self.extentValue = extent;
	}

	public int coordinate() { return self.coordinateValue; }

	public int extent() { return self.extentValue; }
}

class UIVirtualGridViewport {
	private string gridIdentity;
	private int totalCountValue;
	private int columnsValue;
	private int rowHeightValue;
	private int rowPitchValue;
	private int contentOffsetYValue;
	private int contentLocalScrollYValue;
	private int firstVisibleIndexValue;
	private int visibleCountValue;

	public UIVirtualGridViewport(string gridId, int totalCount, int columns, int rowHeight, int rowPitch, int contentOffsetY, int contentLocalScrollY, int firstVisibleDataIndex, int visibleDataCount) {
		self.gridIdentity = gridId;
		self.totalCountValue = totalCount;
		self.columnsValue = columns;
		self.rowHeightValue = rowHeight;
		self.rowPitchValue = rowPitch;
		self.contentOffsetYValue = contentOffsetY;
		self.contentLocalScrollYValue = contentLocalScrollY;
		self.firstVisibleIndexValue = firstVisibleDataIndex;
		self.visibleCountValue = visibleDataCount;
	}

	public string gridId() { return self.gridIdentity; }

	public int totalCount() { return self.totalCountValue; }

	public int columns() { return self.columnsValue; }

	public int rowHeight() { return self.rowHeightValue; }

	public int rowPitch() { return self.rowPitchValue; }

	public int contentOffsetY() { return self.contentOffsetYValue; }

	public int contentLocalScrollY() { return self.contentLocalScrollYValue; }

	public int firstVisibleDataIndex() { return self.firstVisibleIndexValue; }

	public int visibleDataCount() { return self.visibleCountValue; }
}

class UIEvent {
	private UIEventKind eventKind;
	private string targetIdentity;
	private UIViewportMetrics viewportValue;
	private UIScrollDelta scrollValue;
	private UIVirtualGridViewport? virtualGridViewportValue;
	private string inputValue;
	private UIPointerSample? pointerValue;
	private UIRangeAdjustment rangeAdjustmentValue;
	private long long resultingRangeValue;

	private UIEvent(UIEventKind kind, string elementId, UIViewportMetrics viewport, UIScrollDelta scroll, UIVirtualGridViewport? virtualGridViewport, string value, UIPointerSample? pointer, UIRangeAdjustment rangeAdjustment, long long rangeValue) {
		self.eventKind = kind;
		self.targetIdentity = elementId;
		self.viewportValue = viewport;
		self.scrollValue = scroll;
		self.virtualGridViewportValue = virtualGridViewport;
		self.inputValue = value;
		self.pointerValue = pointer;
		self.rangeAdjustmentValue = rangeAdjustment;
		self.resultingRangeValue = rangeValue;
	}

	class UIEvent clicked(string elementId) { return UIEvent(UI_CLICKED, elementId, UIViewportMetrics(0, 0, 0, 0), UIScrollDelta(0, 0), null, "", null, UI_RANGE_ADJUST_NONE, 0LL); }

	class UIEvent navigate(bool forward) { return UIEvent(forward ? UI_NAVIGATE_FORWARD : UI_NAVIGATE_BACK, "", UIViewportMetrics(0, 0, 0, 0), UIScrollDelta(0, 0), null, "", null, UI_RANGE_ADJUST_NONE, 0LL); }

	class UIEvent hoverEntered(string elementId) { return UIEvent(UI_HOVER_ENTERED, elementId, UIViewportMetrics(0, 0, 0, 0), UIScrollDelta(0, 0), null, "", null, UI_RANGE_ADJUST_NONE, 0LL); }

	class UIEvent hoverLeft(string elementId) { return UIEvent(UI_HOVER_LEFT, elementId, UIViewportMetrics(0, 0, 0, 0), UIScrollDelta(0, 0), null, "", null, UI_RANGE_ADJUST_NONE, 0LL); }

	class UIEvent scrolled(string elementId, UIViewportMetrics resultingViewport, UIScrollDelta delta, UIVirtualGridViewport? virtualGridViewport = null) { return UIEvent(UI_SCROLLED, elementId, resultingViewport, delta, virtualGridViewport, "", null, UI_RANGE_ADJUST_NONE, 0LL); }

	class UIEvent viewportChanged(string elementId, UIViewportMetrics metrics, UIVirtualGridViewport? virtualGridViewport = null) { return UIEvent(UI_VIEWPORT_CHANGED, elementId, metrics, UIScrollDelta(0, 0), virtualGridViewport, "", null, UI_RANGE_ADJUST_NONE, 0LL); }

	class UIEvent valueChanged(string elementId, string value) { return UIEvent(UI_VALUE_CHANGED, elementId, UIViewportMetrics(0, 0, 0, 0), UIScrollDelta(0, 0), null, value, null, UI_RANGE_ADJUST_NONE, 0LL); }

	class UIEvent selectionChanged(string elementId, string value) { return UIEvent(UI_SELECTION_CHANGED, elementId, UIViewportMetrics(0, 0, 0, 0), UIScrollDelta(0, 0), null, value, null, UI_RANGE_ADJUST_NONE, 0LL); }

	class UIEvent rangePointerPressed(string elementId, UIPointerSample pointer) { return UIEvent(UI_RANGE_POINTER_PRESSED, elementId, UIViewportMetrics(0, 0, 0, 0), UIScrollDelta(0, 0), null, "", pointer, UI_RANGE_ADJUST_NONE, 0LL); }

	class UIEvent rangePointerMoved(string elementId, UIPointerSample pointer) { return UIEvent(UI_RANGE_POINTER_MOVED, elementId, UIViewportMetrics(0, 0, 0, 0), UIScrollDelta(0, 0), null, "", pointer, UI_RANGE_ADJUST_NONE, 0LL); }

	class UIEvent rangePointerReleased(string elementId, UIPointerSample pointer) { return UIEvent(UI_RANGE_POINTER_RELEASED, elementId, UIViewportMetrics(0, 0, 0, 0), UIScrollDelta(0, 0), null, "", pointer, UI_RANGE_ADJUST_NONE, 0LL); }

	class UIEvent rangePointerCancelled(string elementId, UIPointerSample pointer) { return UIEvent(UI_RANGE_POINTER_CANCELLED, elementId, UIViewportMetrics(0, 0, 0, 0), UIScrollDelta(0, 0), null, "", pointer, UI_RANGE_ADJUST_NONE, 0LL); }

	class UIEvent rangeWheel(string elementId, UIScrollDelta delta, UIRangeAdjustment adjustment, long long resultingValue) { return UIEvent(UI_RANGE_WHEEL, elementId, UIViewportMetrics(0, 0, 0, 0), delta, null, "", null, adjustment, resultingValue); }

	class UIEvent rangeAdjusted(string elementId, UIRangeAdjustment adjustment, long long resultingValue) { return UIEvent(UI_RANGE_ADJUSTED, elementId, UIViewportMetrics(0, 0, 0, 0), UIScrollDelta(0, 0), null, "", null, adjustment, resultingValue); }

	public UIEventKind kind() { return self.eventKind; }

	public string elementId() { return self.targetIdentity; }

	public UIViewportMetrics viewport() { return self.viewportValue; }

	public UIScrollDelta scroll() { return self.scrollValue; }

	public UIVirtualGridViewport? virtualGridViewport() { return self.virtualGridViewportValue; }

	public string value() { return self.inputValue; }

	public UIPointerSample? pointer() { return self.pointerValue; }

	public UIRangeAdjustment rangeAdjustment() { return self.rangeAdjustmentValue; }

	public long long rangeValue() { return self.resultingRangeValue; }
}

/* Normalized, immutable source rectangle. It changes sampling only, never
 * layout, hit testing or the source image's revision/cache identity. */
class UIImageRegion {
	private double leftValue;
	private double topValue;
	private double widthValue;
	private double heightValue;

	public UIImageRegion(double left, double top, double width, double height) {
		if (!Math.isFinite(left) || !Math.isFinite(top) || !Math.isFinite(width) || !Math.isFinite(height) || left < 0.0 || top < 0.0 || width <= 0.0 || height <= 0.0 || left + width > 1.0 || top + height > 1.0) { throw "invalid native UI image region"; }
		self.leftValue = left;
		self.topValue = top;
		self.widthValue = width;
		self.heightValue = height;
	}

	public double left() { return self.leftValue; }

	public double top() { return self.topValue; }

	public double width() { return self.widthValue; }

	public double height() { return self.heightValue; }
}

class UIElement {
	private UIElementKind elementKind;
	private string elementIdentity;
	private string classValue;
	private string styleValue;
	private string textValue;
	private Image? imageValue;
	private unsigned long long imageRevisionValue;
	private UIImageRegion? imageRegionValue;
	private int leadingIconWidthValue = 0;
	private int leadingIconHeightValue = 0;
	private int leadingIconGapValue = 0;
	private string altValue;
	private Vector<UIElement> childValues;
	private UIStyleError styleErrorValue;
	private UIVirtualGrid? virtualGridValue;
	private UISelect? selectValue;
	private string placeholderValue;
	private int textInputMaxBytesValue;
	private UISemanticRange? semanticRangeValue;
	private UISemantics semanticsValue;
	private bool enabledValue;
	private bool selectedValue;
	private bool hasFocusableOverrideValue;
	private bool focusableOverrideValue;
	private bool floatingValue;
	private bool pinnedTopValue = false;
	private int floatingXValue;
	private int floatingYValue;

	private UIElement(UIElementKind kind, string id, string text, Image? image, string alt) {
		self.elementKind = kind;
		self.elementIdentity = id;
		self.classValue = "";
		self.styleValue = "";
		self.textValue = text;
		self.imageValue = image;
		self.imageRevisionValue = 0ULL;
		self.imageRegionValue = null;
		self.altValue = alt;
		self.childValues = [];
		self.styleErrorValue = UIStyleError.valid();
		self.virtualGridValue = null;
		self.selectValue = null;
		self.placeholderValue = "";
		self.textInputMaxBytesValue = 0;
		self.semanticRangeValue = null;
		self.semanticsValue = UISemantics();
		self.enabledValue = true;
		self.selectedValue = false;
		self.hasFocusableOverrideValue = false;
		self.focusableOverrideValue = false;
		self.floatingValue = false;
		self.floatingXValue = 0;
		self.floatingYValue = 0;
	}

	class UIElement column(string id) { return UIElement(UI_COLUMN, id, "", null, ""); }

	/* Children flow left to right. A child with an explicit `width` keeps it;
	 * the others share what remains equally. Height is the tallest child. */
	class UIElement row(string id) { return UIElement(UI_ROW, id, "", null, ""); }

	class UIElement grid(string id) { return UIElement(UI_GRID, id, "", null, ""); }

	class UIElement virtualGrid(string id, UIVirtualGrid descriptor) {
		UIElement element = UIElement(UI_VIRTUAL_GRID, id, "", null, "");
		element.virtualGridValue = descriptor;
		return element;
	}

	class UIElement text(string id, string text) { return UIElement(UI_TEXT, id, text, null, ""); }

	class UIElement image(string id, Image image, string alt) { return UIElement(UI_IMAGE, id, "", image, alt); }

	class UIElement button(string id, string label) { return UIElement(UI_BUTTON, id, label, null, ""); }

	class UIElement textInput(string id, string value, string placeholder = "", int maxBytes = 4096) {
		UIElement element = UIElement(UI_TEXT_INPUT, id, value, null, "");
		element.placeholderValue = placeholder;
		element.textInputMaxBytesValue = maxBytes;
		return element;
	}

	class UIElement select(string id, UISelect descriptor) {
		UIElement element = UIElement(UI_SELECT, id, descriptor == null ? "" : descriptor.selectedLabel(), null, "");
		element.selectValue = descriptor;
		return element;
	}

	public UIElement className(string value) {
		self.classValue = value;
		return self;
	}

	public UIElement style(string css) {
		self.styleValue = css;
		self.styleErrorValue = UIStyle.validate(css);
		return self;
	}

	/* Increment when mutating/replacing pixels under the same stable ID. */
	public UIElement imageRevision(unsigned long long revision) {
		self.imageRevisionValue = revision;
		return self;
	}

	/* Decorative pixels belong to the text field's one focus/hit target.
	 * Dimensions are logical pixels; the image may have a Retina backing. */
	public UIElement leadingIcon(Image image, int width, int height, int gap = 8) {
		if (self.elementKind != UI_TEXT_INPUT || image == null || image.isEmpty() || width < 1 || width > 256 || height < 1 || height > 256 || gap < 0 || gap > 256) { throw "native UI leading icons require a text input, image, 1..256px dimensions and 0..256px gap"; }
		self.imageValue = image;
		self.leadingIconWidthValue = width;
		self.leadingIconHeightValue = height;
		self.leadingIconGapValue = gap;
		return self;
	}

	public int leadingIconWidth() { return self.leadingIconWidthValue; }

	public int leadingIconHeight() { return self.leadingIconHeightValue; }

	public int leadingIconInset() { return self.leadingIconWidthValue + self.leadingIconGapValue; }

	public UIElement imageRegion(UIImageRegion? region) {
		if (self.elementKind != UI_IMAGE) { throw "native UI image regions require an image element"; }
		self.imageRegionValue = region;
		return self;
	}

	public UIElement semanticRange(UISemanticRange descriptor) {
		self.semanticRangeValue = descriptor;
		return self;
	}

	public UIElement enabled(bool value) {
		self.enabledValue = value;
		return self;
	}

	public UIElement selected(bool value) {
		self.selectedValue = value;
		return self;
	}

	public UIElement focusable(bool value) {
		self.hasFocusableOverrideValue = true;
		self.focusableOverrideValue = value;
		return self;
	}

	public UIElement semantics(UISemantics descriptor) {
		self.semanticsValue = descriptor;
		return self;
	}

	public UIElement child(UIElement value) {
		self.childValues.push(value);
		return self;
	}

	/* Same bounds contract as childAt. Copy before replacing a child of a
	 * published immutable tree; untouched children can then stay shared. */
	public UIElement replaceChild(int index, UIElement value) {
		self.childValues.set(index, value);
		return self;
	}

	/* Independent element/child list; child elements and descriptors remain
	 * shared. Useful for publishing a new container around retained children. */
	public UIElement copy() {
		UIElement copied = UIElement(self.elementKind, self.elementIdentity, self.textValue, self.imageValue, self.altValue);
		copied.classValue = self.classValue;
		copied.styleValue = self.styleValue;
		copied.imageRevisionValue = self.imageRevisionValue;
		copied.imageRegionValue = self.imageRegionValue;
		copied.leadingIconWidthValue = self.leadingIconWidthValue;
		copied.leadingIconHeightValue = self.leadingIconHeightValue;
		copied.leadingIconGapValue = self.leadingIconGapValue;
		copied.childValues = self.childValues.copy();
		copied.styleErrorValue = self.styleErrorValue;
		copied.virtualGridValue = self.virtualGridValue;
		copied.selectValue = self.selectValue;
		copied.placeholderValue = self.placeholderValue;
		copied.textInputMaxBytesValue = self.textInputMaxBytesValue;
		copied.semanticRangeValue = self.semanticRangeValue;
		copied.semanticsValue = self.semanticsValue;
		copied.enabledValue = self.enabledValue;
		copied.selectedValue = self.selectedValue;
		copied.hasFocusableOverrideValue = self.hasFocusableOverrideValue;
		copied.focusableOverrideValue = self.focusableOverrideValue;
		copied.floatingValue = self.floatingValue;
		copied.pinnedTopValue = self.pinnedTopValue;
		copied.floatingXValue = self.floatingXValue;
		copied.floatingYValue = self.floatingYValue;
		return copied;
	}

	/* Out of flow, relative to the parent's outer origin. Painted after its
	 * flowing siblings, in declaration order; overflow clips at the viewport. */
	public UIElement floating(int x, int y) {
		self.floatingValue = true;
		self.floatingXValue = x;
		self.floatingYValue = y;
		return self;
	}

	public bool isFloating() { return self.floatingValue; }

	/* A leading root child stays above scrolling content, including its children. */
	public UIElement pinnedTop() { self.pinnedTopValue = true; return self; }

	public bool isPinnedTop() { return self.pinnedTopValue; }

	public int floatingX() { return self.floatingXValue; }

	public int floatingY() { return self.floatingYValue; }

	public UIElementKind kind() { return self.elementKind; }

	public string id() { return self.elementIdentity; }

	public string cssClass() { return self.classValue; }

	public string inlineStyle() { return self.styleValue; }

	public string contentText() { return self.textValue; }

	public Image? contentImage() { return self.imageValue; }

	public unsigned long long contentImageRevision() { return self.imageRevisionValue; }

	public UIImageRegion? contentImageRegion() { return self.imageRegionValue; }

	public string imageAlt() { return self.altValue; }

	public UIStyleError styleError() { return self.styleErrorValue; }

	public UIVirtualGrid? virtualGridDescriptor() { return self.virtualGridValue; }

	public UISelect? selectDescriptor() { return self.selectValue; }

	public string placeholderText() { return self.placeholderValue; }

	public int textInputMaxBytes() { return self.textInputMaxBytesValue; }

	public UISemanticRange? semanticRangeDescriptor() { return self.semanticRangeValue; }

	public UISemantics semanticDescriptor() { return self.semanticsValue; }

	public bool isEnabled() { return self.enabledValue; }

	public bool isSelected() { return self.selectedValue; }

	public bool hasFocusableOverride() { return self.hasFocusableOverrideValue; }

	public bool focusableOverride() { return self.focusableOverrideValue; }

	public UISemanticRole effectiveSemanticRole() {
		UISemanticRole declared = self.semanticsValue.role();
		if (declared != UI_SEMANTIC_ROLE_AUTOMATIC) { return declared; }
		if (self.semanticRangeValue != null) { return UI_SEMANTIC_ROLE_SLIDER; }
		if (self.elementKind == UI_COLUMN || self.elementKind == UI_ROW) { return UI_SEMANTIC_ROLE_GROUP; }
		if (self.elementKind == UI_GRID || self.elementKind == UI_VIRTUAL_GRID) { return UI_SEMANTIC_ROLE_GRID; }
		if (self.elementKind == UI_TEXT) { return UI_SEMANTIC_ROLE_TEXT; }
		if (self.elementKind == UI_IMAGE) { return UI_SEMANTIC_ROLE_IMAGE; }
		if (self.elementKind == UI_BUTTON) { return UI_SEMANTIC_ROLE_BUTTON; }
		if (self.elementKind == UI_SELECT) { return UI_SEMANTIC_ROLE_COMBO_BOX; }
		return UI_SEMANTIC_ROLE_TEXT_FIELD;
	}

	public bool isFocusable() {
		if (!self.enabledValue) { return false; }
		if (self.hasFocusableOverrideValue) { return self.focusableOverrideValue; }
		UISemanticRole role = self.effectiveSemanticRole();
		return role == UI_SEMANTIC_ROLE_BUTTON || role == UI_SEMANTIC_ROLE_TOGGLE_BUTTON || role == UI_SEMANTIC_ROLE_CHECKBOX || role == UI_SEMANTIC_ROLE_TAB || role == UI_SEMANTIC_ROLE_SLIDER || role == UI_SEMANTIC_ROLE_TEXT_FIELD || role == UI_SEMANTIC_ROLE_RADIO || role == UI_SEMANTIC_ROLE_COMBO_BOX;
	}

	public int childCount() { return self.childValues.len; }

	public UIElement childAt(int index) { return self.childValues.get(index); }
}

#include "UI/Render.btrc"
#include "UI/TextRaster.btrc"
