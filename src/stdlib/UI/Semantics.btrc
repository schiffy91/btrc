/* Backend-neutral semantic values for Library.UI. */

enum UISemanticRole {
	UI_SEMANTIC_ROLE_AUTOMATIC = 0,
	UI_SEMANTIC_ROLE_GROUP = 1,
	UI_SEMANTIC_ROLE_TEXT = 2,
	UI_SEMANTIC_ROLE_IMAGE = 3,
	UI_SEMANTIC_ROLE_BUTTON = 4,
	UI_SEMANTIC_ROLE_TOGGLE_BUTTON = 5,
	UI_SEMANTIC_ROLE_CHECKBOX = 6,
	UI_SEMANTIC_ROLE_TAB = 7,
	UI_SEMANTIC_ROLE_TAB_LIST = 8,
	UI_SEMANTIC_ROLE_GRID = 9,
	UI_SEMANTIC_ROLE_GRID_CELL = 10,
	UI_SEMANTIC_ROLE_LIST = 11,
	UI_SEMANTIC_ROLE_LIST_ITEM = 12,
	UI_SEMANTIC_ROLE_HEADING = 13,
	UI_SEMANTIC_ROLE_STATUS = 14,
	UI_SEMANTIC_ROLE_ALERT = 15,
	UI_SEMANTIC_ROLE_SLIDER = 16,
	UI_SEMANTIC_ROLE_TEXT_FIELD = 17,
	UI_SEMANTIC_ROLE_RADIO = 18,
	UI_SEMANTIC_ROLE_RADIO_GROUP = 19,
	UI_SEMANTIC_ROLE_TOOLBAR = 20,
	UI_SEMANTIC_ROLE_NAVIGATION = 21,
	UI_SEMANTIC_ROLE_MAIN = 22,
	UI_SEMANTIC_ROLE_SEPARATOR = 23,
	UI_SEMANTIC_ROLE_PROGRESS = 24,
	UI_SEMANTIC_ROLE_COMBO_BOX = 25
};

enum UISemanticLiveMode {
	UI_SEMANTIC_LIVE_OFF = 0,
	UI_SEMANTIC_LIVE_POLITE = 1,
	UI_SEMANTIC_LIVE_ASSERTIVE = 2
};

enum UISemanticToggleState {
	UI_SEMANTIC_TOGGLE_UNSET = 0,
	UI_SEMANTIC_TOGGLE_OFF = 1,
	UI_SEMANTIC_TOGGLE_ON = 2,
	UI_SEMANTIC_TOGGLE_MIXED = 3
};

enum UISemanticExpansionState {
	UI_SEMANTIC_EXPANSION_UNSET = 0,
	UI_SEMANTIC_EXPANSION_OFF = 1,
	UI_SEMANTIC_EXPANSION_ON = 2
};

class UISemanticText {
	class int byteAt(string value, int index) { return (int)(unsigned char)value[index]; }

	class bool continuation(int value) { return value >= 0x80 && value <= 0xBF; }

	class int scalarWidth(string value, int index) {
		if (value == null || index < 0 || index >= value.len()) { return 0; }
		int remaining = value.len() - index;
		int first = UISemanticText.byteAt(value, index);
		if (first == 0) { return 0; }
		if (first <= 0x7F) { return 1; }
		if (first >= 0xC2 && first <= 0xDF && remaining >= 2 && UISemanticText.continuation(UISemanticText.byteAt(value, index + 1))) { return 2; }
		if (remaining >= 3) {
			int second = UISemanticText.byteAt(value, index + 1);
			int third = UISemanticText.byteAt(value, index + 2);
			bool validSecond = (first == 0xE0 && second >= 0xA0 && second <= 0xBF) || (first >= 0xE1 && first <= 0xEC && UISemanticText.continuation(second)) || (first == 0xED && second >= 0x80 && second <= 0x9F) || (first >= 0xEE && first <= 0xEF && UISemanticText.continuation(second));
			if (validSecond && UISemanticText.continuation(third)) { return 3; }
		}
		if (remaining >= 4) {
			int second = UISemanticText.byteAt(value, index + 1);
			int third = UISemanticText.byteAt(value, index + 2);
			int fourth = UISemanticText.byteAt(value, index + 3);
			bool validSecond = (first == 0xF0 && second >= 0x90 && second <= 0xBF) || (first >= 0xF1 && first <= 0xF3 && UISemanticText.continuation(second)) || (first == 0xF4 && second >= 0x80 && second <= 0x8F);
			if (validSecond && UISemanticText.continuation(third) && UISemanticText.continuation(fourth)) { return 4; }
		}
		return 0;
	}

	class bool valid(string value, int maximumBytes) {
		if (value == null || value.len() > maximumBytes) { return false; }
		int index = 0;
		while (index < value.len()) {
			int width = UISemanticText.scalarWidth(value, index);
			if (width == 0) { return false; }
			index += width;
		}
		return true;
	}
}

class UISemantics {
	private UISemanticRole roleValue;
	private string labelValue;
	private string hintValue;
	private string semanticValue;
	private UISemanticLiveMode liveValue;
	private UISemanticToggleState checkedValue;
	private UISemanticToggleState pressedValue;
	private UISemanticExpansionState expandedValue;
	private bool busyValue;
	private bool readOnlyValue;

	public UISemantics(UISemanticRole role = UI_SEMANTIC_ROLE_AUTOMATIC, string label = "", string hint = "", string value = "", UISemanticLiveMode live = UI_SEMANTIC_LIVE_OFF) {
		self.roleValue = role;
		self.labelValue = label;
		self.hintValue = hint;
		self.semanticValue = value;
		self.liveValue = live;
		self.checkedValue = UI_SEMANTIC_TOGGLE_UNSET;
		self.pressedValue = UI_SEMANTIC_TOGGLE_UNSET;
		self.expandedValue = UI_SEMANTIC_EXPANSION_UNSET;
		self.busyValue = false;
		self.readOnlyValue = false;
	}

	public UISemantics checked(UISemanticToggleState state) {
		self.checkedValue = state;
		return self;
	}

	public UISemantics pressed(UISemanticToggleState state) {
		self.pressedValue = state;
		return self;
	}

	public UISemantics expanded(UISemanticExpansionState state) {
		self.expandedValue = state;
		return self;
	}

	public UISemantics busy(bool value) {
		self.busyValue = value;
		return self;
	}

	public UISemantics readOnly(bool value) {
		self.readOnlyValue = value;
		return self;
	}

	public UISemanticRole role() { return self.roleValue; }

	public string label() { return self.labelValue; }

	public string hint() { return self.hintValue; }

	public string value() { return self.semanticValue; }

	public UISemanticLiveMode live() { return self.liveValue; }

	public UISemanticToggleState checkedState() { return self.checkedValue; }

	public UISemanticToggleState pressedState() { return self.pressedValue; }

	public UISemanticExpansionState expansionState() { return self.expandedValue; }

	public bool isBusy() { return self.busyValue; }

	public bool isReadOnly() { return self.readOnlyValue; }

	private bool validRole() { return self.roleValue >= UI_SEMANTIC_ROLE_AUTOMATIC && self.roleValue <= UI_SEMANTIC_ROLE_COMBO_BOX; }

	private bool validLive() { return self.liveValue >= UI_SEMANTIC_LIVE_OFF && self.liveValue <= UI_SEMANTIC_LIVE_ASSERTIVE; }

	private bool validToggle(UISemanticToggleState state) { return state >= UI_SEMANTIC_TOGGLE_UNSET && state <= UI_SEMANTIC_TOGGLE_MIXED; }

	private bool validExpansion() { return self.expandedValue >= UI_SEMANTIC_EXPANSION_UNSET && self.expandedValue <= UI_SEMANTIC_EXPANSION_ON; }

	public bool valid() {
		if (!self.validRole() || !self.validLive() || !self.validToggle(self.checkedValue) || !self.validToggle(self.pressedValue) || !self.validExpansion()) { return false; }
		return UISemanticText.valid(self.labelValue, 512) && UISemanticText.valid(self.hintValue, 512) && UISemanticText.valid(self.semanticValue, 512);
	}
}

class UIResolvedSemantics {
	private UISemanticRole roleValue;
	private string labelValue;
	private string hintValue;
	private string semanticValue;
	private UISemanticLiveMode liveValue;
	private UISemanticToggleState checkedValue;
	private UISemanticToggleState pressedValue;
	private UISemanticExpansionState expandedValue;
	private bool enabledValue;
	private bool selectedValue;
	private bool focusableValue;
	private bool focusedValue;
	private bool busyValue;
	private bool readOnlyValue;

	public UIResolvedSemantics(UISemanticRole role, string label, string hint, string value, UISemanticLiveMode live, UISemanticToggleState checked, UISemanticToggleState pressed, UISemanticExpansionState expanded, bool enabled, bool selected, bool focusable, bool focused, bool busy, bool readOnly) {
		self.roleValue = role;
		self.labelValue = label;
		self.hintValue = hint;
		self.semanticValue = value;
		self.liveValue = live;
		self.checkedValue = checked;
		self.pressedValue = pressed;
		self.expandedValue = expanded;
		self.enabledValue = enabled;
		self.selectedValue = selected;
		self.focusableValue = focusable;
		self.focusedValue = focused;
		self.busyValue = busy;
		self.readOnlyValue = readOnly;
	}

	public UISemanticRole role() { return self.roleValue; }

	public string label() { return self.labelValue; }

	public string hint() { return self.hintValue; }

	public string value() { return self.semanticValue; }

	public UISemanticLiveMode live() { return self.liveValue; }

	public UISemanticToggleState checkedState() { return self.checkedValue; }

	public UISemanticToggleState pressedState() { return self.pressedValue; }

	public UISemanticExpansionState expansionState() { return self.expandedValue; }

	public bool enabled() { return self.enabledValue; }

	public bool selected() { return self.selectedValue; }

	public bool focusable() { return self.focusableValue; }

	public bool focused() { return self.focusedValue; }

	public bool isBusy() { return self.busyValue; }

	public bool isReadOnly() { return self.readOnlyValue; }
}
