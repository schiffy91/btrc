/* btrc standard library — digests.
 *
 * Importing Library.Digest selects the whole group: Fnv1a32, a compact
 * deterministic change detector, and SHA256, the portable cryptographic
 * digest. NativeSHA256 stays an explicit import because it selects the
 * target's SDK-backed provider.
 */
import Library.Digest.Fnv1a32;
import Library.Digest.SHA256;
