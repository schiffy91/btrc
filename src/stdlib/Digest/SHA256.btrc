/* btrc standard library — SHA-256
 *
 * Incremental byte-oriented hashing with bounded retained storage. appendBytes
 * and appendText borrow their input only for the call. finish is idempotent;
 * appending after finish throws. Each instance belongs to one caller/thread.
 * Static digest/digestBytes preserve the one-shot API and null-as-empty rule.
 * Digests are 64-character lowercase hexadecimal strings. */

import Library.Bytes;

/* One-shot SHA-256 providers return owned lowercase hexadecimal text and
 * borrow their input only for the call. Null inputs denote empty messages. */
interface ISHA256Digest {
	string digest(string text);
	string digestBytes(Bytes bytes);
}

/* A binary digest borrows each input until update returns. finish writes
 * the algorithm's output and clears the state. */
interface IBinaryDigest {
	void update(unsigned char* data, int length);
	void finish(unsigned char* out);
}

struct SHA256Buffers {
	unsigned int hashState[8];
	unsigned int words[64];
	unsigned char pending[64];
};

class SHA256State implements IBinaryDigest {
	private struct SHA256Buffers buffers;
	private unsigned int constants[64];
	private int pendingLength = 0;
	private unsigned long long byteCount = 0ULL;
	private bool finished = false;

	public SHA256State() {
		unsigned int initialHash[8] = {
			0x6a09e667U, 0xbb67ae85U, 0x3c6ef372U, 0xa54ff53aU,
			0x510e527fU, 0x9b05688cU, 0x1f83d9abU, 0x5be0cd19U
		};
		unsigned int initialConstants[64] = {
			0x428a2f98U, 0x71374491U, 0xb5c0fbcfU, 0xe9b5dba5U,
			0x3956c25bU, 0x59f111f1U, 0x923f82a4U, 0xab1c5ed5U,
			0xd807aa98U, 0x12835b01U, 0x243185beU, 0x550c7dc3U,
			0x72be5d74U, 0x80deb1feU, 0x9bdc06a7U, 0xc19bf174U,
			0xe49b69c1U, 0xefbe4786U, 0x0fc19dc6U, 0x240ca1ccU,
			0x2de92c6fU, 0x4a7484aaU, 0x5cb0a9dcU, 0x76f988daU,
			0x983e5152U, 0xa831c66dU, 0xb00327c8U, 0xbf597fc7U,
			0xc6e00bf3U, 0xd5a79147U, 0x06ca6351U, 0x14292967U,
			0x27b70a85U, 0x2e1b2138U, 0x4d2c6dfcU, 0x53380d13U,
			0x650a7354U, 0x766a0abbU, 0x81c2c92eU, 0x92722c85U,
			0xa2bfe8a1U, 0xa81a664bU, 0xc24b8b70U, 0xc76c51a3U,
			0xd192e819U, 0xd6990624U, 0xf40e3585U, 0x106aa070U,
			0x19a4c116U, 0x1e376c08U, 0x2748774cU, 0x34b0bcb5U,
			0x391c0cb3U, 0x4ed8aa4aU, 0x5b9cca4fU, 0x682e6ff3U,
			0x748f82eeU, 0x78a5636fU, 0x84c87814U, 0x8cc70208U,
			0x90befffaU, 0xa4506cebU, 0xbef9a3f7U, 0xc67178f2U
		};
		for (int index = 0; index < 8; index++) { self.buffers.hashState[index] = initialHash[index]; }
		for (int index = 0; index < 64; index++) { self.constants[index] = initialConstants[index]; }
	}

	private unsigned int rotateRight(unsigned int value, int count) { return (value >> count) | (value << (32 - count)); }

	/* Complete blocks are consumed directly; no input pointer survives this call. */
	private void compress(unsigned char* source) {
		for (int index = 0; index < 16; index++) {
			int base = index * 4;
			unsigned int value = ((unsigned int)(unsigned char)source[base] << 24) | ((unsigned int)(unsigned char)source[base + 1] << 16) | ((unsigned int)(unsigned char)source[base + 2] << 8) | (unsigned int)(unsigned char)source[base + 3];
			self.buffers.words[index] = value;
		}
		for (int index = 16; index < 64; index++) {
			unsigned int previous15 = self.buffers.words[index - 15];
			unsigned int previous2 = self.buffers.words[index - 2];
			unsigned int sigma0 = self.rotateRight(previous15, 7) ^ self.rotateRight(previous15, 18) ^ (previous15 >> 3);
			unsigned int sigma1 = self.rotateRight(previous2, 17) ^ self.rotateRight(previous2, 19) ^ (previous2 >> 10);
			self.buffers.words[index] = self.buffers.words[index - 16] + sigma0 + self.buffers.words[index - 7] + sigma1;
		}
		unsigned int a = self.buffers.hashState[0];
		unsigned int b = self.buffers.hashState[1];
		unsigned int c = self.buffers.hashState[2];
		unsigned int d = self.buffers.hashState[3];
		unsigned int e = self.buffers.hashState[4];
		unsigned int f = self.buffers.hashState[5];
		unsigned int g = self.buffers.hashState[6];
		unsigned int h = self.buffers.hashState[7];
		int round = 0;
		while (round < 64) {
			unsigned int sum1 = self.rotateRight(e, 6) ^ self.rotateRight(e, 11) ^ self.rotateRight(e, 25);
			unsigned int choice = (e & f) ^ ((~e) & g);
			unsigned int temporary1 = h + sum1 + choice + self.constants[round] + self.buffers.words[round];
			unsigned int sum0 = self.rotateRight(a, 2) ^ self.rotateRight(a, 13) ^ self.rotateRight(a, 22);
			unsigned int majority = (a & b) ^ (a & c) ^ (b & c);
			unsigned int temporary2 = sum0 + majority;
			h = g;
			g = f;
			f = e;
			e = d + temporary1;
			d = c;
			c = b;
			b = a;
			a = temporary1 + temporary2;
			round++;
		}
		self.buffers.hashState[0] = self.buffers.hashState[0] + a;
		self.buffers.hashState[1] = self.buffers.hashState[1] + b;
		self.buffers.hashState[2] = self.buffers.hashState[2] + c;
		self.buffers.hashState[3] = self.buffers.hashState[3] + d;
		self.buffers.hashState[4] = self.buffers.hashState[4] + e;
		self.buffers.hashState[5] = self.buffers.hashState[5] + f;
		self.buffers.hashState[6] = self.buffers.hashState[6] + g;
		self.buffers.hashState[7] = self.buffers.hashState[7] + h;
	}

	/* Incremental binary digest for keyed hashes. The fixed message buffer
	 * avoids leaving key pads in discarded heap allocations. */
	public void update(unsigned char* source, int count) {
		if (self.finished) { throw "SHA256 is finalized"; }
		if (count < 0 || (unsigned long long)count > 2305843009213693951ULL - self.byteCount) { throw "SHA256 message is too large"; }
		self.byteCount = self.byteCount + (unsigned long long)count;
		int offset = 0;
		if (self.pendingLength > 0) {
			while (offset < count && self.pendingLength < 64) { self.buffers.pending[self.pendingLength++] = source[offset++]; }
			if (self.pendingLength == 64) { self.compress(self.buffers.pending); self.pendingLength = 0; }
		}
		while (count - offset >= 64) { self.compress(source + offset); offset += 64; }
		while (offset < count) { self.buffers.pending[self.pendingLength++] = source[offset++]; }
	}

	public void finish(unsigned char* out) {
		if (self.finished) { throw "SHA256 is finalized"; }
		self.finished = true;
		unsigned long long bits = self.byteCount * 8ULL;
		self.buffers.pending[self.pendingLength++] = (unsigned char)0x80;
		if (self.pendingLength > 56) {
			while (self.pendingLength < 64) { self.buffers.pending[self.pendingLength++] = (unsigned char)0; }
			self.compress(self.buffers.pending);
			self.pendingLength = 0;
		}
		while (self.pendingLength < 56) { self.buffers.pending[self.pendingLength++] = (unsigned char)0; }
		for (int index = 0; index < 8; index++) { self.buffers.pending[56 + index] = (unsigned char)(bits >> (56 - 8 * index)); }
		self.compress(self.buffers.pending);
		for (int index = 0; index < 32; index++) { out[index] = (unsigned char)(self.buffers.hashState[index / 4] >> (24 - 8 * (index % 4))); }
		/* Volatile writes also survive optimization when the owner dies here. */
		self.wipe(self.buffers.pending, 64);
		self.wipe((unsigned char*)self.buffers.words, (int)sizeof(self.buffers.words));
		self.wipe((unsigned char*)self.buffers.hashState, (int)sizeof(self.buffers.hashState));
	}

	public void __del__() {
		self.wipe(self.buffers.pending, 64);
		self.wipe((unsigned char*)self.buffers.words, (int)sizeof(self.buffers.words));
		self.wipe((unsigned char*)self.buffers.hashState, (int)sizeof(self.buffers.hashState));
	}

	private void wipe(volatile unsigned char* data, int length) {
		for (int index = 0; index < length; index++) { data[index] = (unsigned char)0; }
	}
}

class SHA256 {
	private SHA256State state = SHA256State();
	private string finalizedDigest = "";

	public SHA256() {}

	public void appendBytes(Bytes bytes) {
		if (bytes == null) { self.state.update(null, 0); }
		else { self.state.update((unsigned char*)bytes.data, bytes.length()); }
	}

	public void appendText(string text) { self.state.update((unsigned char*)text, text == null ? 0 : text.length()); }

	public string finish() {
		if (self.finalizedDigest.isEmpty()) {
			Bytes digest = Bytes.zeros(32);
			self.state.finish((unsigned char*)digest.data);
			self.finalizedDigest = digest.toHex();
		}
		return self.finalizedDigest;
	}

	class string digest(string text) { var hash = SHA256(); hash.appendText(text); return hash.finish(); }

	class string digestBytes(Bytes bytes) { var hash = SHA256(); hash.appendBytes(bytes); return hash.finish(); }
}
