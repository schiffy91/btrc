/* btrc standard library — SHA-256
 *
 * Incremental byte-oriented hashing with bounded retained storage. appendBytes
 * and appendText borrow their input only for the call. finish is idempotent;
 * appending after finish throws. Each instance belongs to one caller/thread.
 * Static digest/digestBytes preserve the one-shot API and null-as-empty rule.
 * Digests are 64-character lowercase hexadecimal strings. */

import Library.Bytes;
import Library.Strings;

/* One-shot SHA-256 providers return owned lowercase hexadecimal text and
 * borrow their input only for the call. Null inputs denote empty messages. */
interface ISHA256Digest {
	string digest(string text);
	string digestBytes(Bytes bytes);
}

class SHA256 {
	/* Fixed SHA-256 state and schedule stay embedded in this owner. */
	private unsigned int hashState[8];
	private unsigned int constants[64];
	private unsigned int words[64];
	private Bytes pending = Bytes();
	private unsigned long long byteCount = 0ULL;
	private string finalizedDigest = "";

	public SHA256() {
		unsigned int initialHash[8] = {
			0x6a09e667U, 0xbb67ae85U, 0x3c6ef372U, 0xa54ff53aU,
			0x510e527fU, 0x9b05688cU, 0x1f83d9abU, 0x5be0cd19U
		};
		unsigned int initialConstants[64] = {
			0x428a2f98U, 0x71374491U, 0xb5c0fbcfU, 0xe9b5dba5U,
			0x3956c25bU, 0x59f111f1U, 0x923f82a4U, 0xab1c5ed5U,
			0xd807aa98U, 0x12835b01U, 0x243185beU, 0x550c7dc3U,
			0x72be5d74U, 0x80deb1feU, 0x9bdc06a7U, 0xc19bf174U,
			0xe49b69c1U, 0xefbe4786U, 0x0fc19dc6U, 0x240ca1ccU,
			0x2de92c6fU, 0x4a7484aaU, 0x5cb0a9dcU, 0x76f988daU,
			0x983e5152U, 0xa831c66dU, 0xb00327c8U, 0xbf597fc7U,
			0xc6e00bf3U, 0xd5a79147U, 0x06ca6351U, 0x14292967U,
			0x27b70a85U, 0x2e1b2138U, 0x4d2c6dfcU, 0x53380d13U,
			0x650a7354U, 0x766a0abbU, 0x81c2c92eU, 0x92722c85U,
			0xa2bfe8a1U, 0xa81a664bU, 0xc24b8b70U, 0xc76c51a3U,
			0xd192e819U, 0xd6990624U, 0xf40e3585U, 0x106aa070U,
			0x19a4c116U, 0x1e376c08U, 0x2748774cU, 0x34b0bcb5U,
			0x391c0cb3U, 0x4ed8aa4aU, 0x5b9cca4fU, 0x682e6ff3U,
			0x748f82eeU, 0x78a5636fU, 0x84c87814U, 0x8cc70208U,
			0x90befffaU, 0xa4506cebU, 0xbef9a3f7U, 0xc67178f2U
		};
		for (int index = 0; index < 8; index++) { self.hashState[index] = initialHash[index]; }
		for (int index = 0; index < 64; index++) { self.constants[index] = initialConstants[index]; }
	}

	private unsigned int rotateRight(unsigned int value, int count) { return (value >> count) | (value << (32 - count)); }

	/* Complete blocks are consumed directly; no input pointer survives this call. */
	private void compress(char* source) {
		for (int index = 0; index < 16; index++) {
			int base = index * 4;
			unsigned int value = ((unsigned int)(unsigned char)source[base] << 24) | ((unsigned int)(unsigned char)source[base + 1] << 16) | ((unsigned int)(unsigned char)source[base + 2] << 8) | (unsigned int)(unsigned char)source[base + 3];
			self.words[index] = value;
		}
		for (int index = 16; index < 64; index++) {
			unsigned int previous15 = self.words[index - 15];
			unsigned int previous2 = self.words[index - 2];
			unsigned int sigma0 = self.rotateRight(previous15, 7) ^ self.rotateRight(previous15, 18) ^ (previous15 >> 3);
			unsigned int sigma1 = self.rotateRight(previous2, 17) ^ self.rotateRight(previous2, 19) ^ (previous2 >> 10);
			self.words[index] = self.words[index - 16] + sigma0 + self.words[index - 7] + sigma1;
		}
		unsigned int a = self.hashState[0];
		unsigned int b = self.hashState[1];
		unsigned int c = self.hashState[2];
		unsigned int d = self.hashState[3];
		unsigned int e = self.hashState[4];
		unsigned int f = self.hashState[5];
		unsigned int g = self.hashState[6];
		unsigned int h = self.hashState[7];
		int round = 0;
		while (round < 64) {
			unsigned int sum1 = self.rotateRight(e, 6) ^ self.rotateRight(e, 11) ^ self.rotateRight(e, 25);
			unsigned int choice = (e & f) ^ ((~e) & g);
			unsigned int temporary1 = h + sum1 + choice + self.constants[round] + self.words[round];
			unsigned int sum0 = self.rotateRight(a, 2) ^ self.rotateRight(a, 13) ^ self.rotateRight(a, 22);
			unsigned int majority = (a & b) ^ (a & c) ^ (b & c);
			unsigned int temporary2 = sum0 + majority;
			h = g;
			g = f;
			f = e;
			e = d + temporary1;
			d = c;
			c = b;
			b = a;
			a = temporary1 + temporary2;
			round++;
		}
		self.hashState[0] = self.hashState[0] + a;
		self.hashState[1] = self.hashState[1] + b;
		self.hashState[2] = self.hashState[2] + c;
		self.hashState[3] = self.hashState[3] + d;
		self.hashState[4] = self.hashState[4] + e;
		self.hashState[5] = self.hashState[5] + f;
		self.hashState[6] = self.hashState[6] + g;
		self.hashState[7] = self.hashState[7] + h;
	}

	private void append(char* source, int count) {
		if (!self.finalizedDigest.isEmpty()) { throw "SHA256 is finalized"; }
		/* SHA-256 encodes a message length strictly below 2^64 bits. */
		if ((unsigned long long)count > 2305843009213693951ULL - self.byteCount) { throw "SHA256 message is too large"; }
		self.byteCount = self.byteCount + (unsigned long long)count;
		int offset = 0;
		if (self.pending.len > 0) {
			while (offset < count && self.pending.len < 64) { self.pending.append((int)(unsigned char)source[offset]); offset++; }
			if (self.pending.len == 64) { self.compress(self.pending.data); self.pending.len = 0; }
		}
		while (count - offset >= 64) { self.compress(source + offset); offset = offset + 64; }
		while (offset < count) { self.pending.append((int)(unsigned char)source[offset]); offset++; }
	}

	public void appendBytes(Bytes bytes) {
		if (bytes == null) { self.append(null, 0); }
		else { self.append(bytes.data, bytes.length()); }
	}

	public void appendText(string text) { self.append((char*)text, text == null ? 0 : text.length()); }

	public string finish() {
		if (!self.finalizedDigest.isEmpty()) { return self.finalizedDigest; }
		unsigned long long bitLength = self.byteCount * 8ULL;
		self.pending.append(0x80);
		if (self.pending.len > 56) {
			while (self.pending.len < 64) { self.pending.append(0); }
			self.compress(self.pending.data);
			self.pending.len = 0;
		}
		while (self.pending.len < 56) { self.pending.append(0); }
		for (int shift = 56; shift >= 0; shift = shift - 8) { self.pending.append((int)((bitLength >> shift) & 0xffULL)); }
		self.compress(self.pending.data);
		self.pending.len = 0;
		string digits = "0123456789abcdef";
		var output = StringBuilder();
		for (int index = 0; index < 8; index++) {
			for (int shift = 28; shift >= 0; shift = shift - 4) {
				int nibble = (int)((self.hashState[index] >> shift) & 0x0fU);
				output.appendChar(digits[nibble]);
			}
		}
		self.finalizedDigest = output.toString();
		return self.finalizedDigest;
	}

	class string digest(string text) { var hash = SHA256(); hash.appendText(text); return hash.finish(); }

	class string digestBytes(Bytes bytes) { var hash = SHA256(); hash.appendBytes(bytes); return hash.finish(); }
}
