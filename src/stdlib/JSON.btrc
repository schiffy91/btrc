import Library.IO;
import Library.Map;
import Library.Math;
import Library.Strings;
import Library.Vector;

#include <locale.h>

extern struct lconv* localeconv();

enum JSONKind {
	JSON_NULL = 0,
	JSON_BOOL = 1,
	JSON_NUMBER = 2,
	JSON_STRING = 3,
	JSON_ARRAY = 4,
	JSON_OBJECT = 5,
	JSON_ERROR = 6
};

/* ---------------------------------------------------------------------------
 * JSONValue: a real recursive JSON tree.
 *
 * A JSONValue is exactly one of: null, bool, number, string, array, object.
 * The active variant is kind(), a JSONKind:
 *     JSON_NULL JSON_BOOL JSON_NUMBER JSON_STRING JSON_ARRAY JSON_OBJECT JSON_ERROR
 * whose values are 0 through 6, so comparisons against those integers hold.
 * ERROR is the sentinel returned by parse() on malformed input; it answers
 * true to isNull() (so callers that only check isNull stay safe) but can be
 * distinguished with isError().
 *
 * Private payload fields (only the ones relevant to the kind are meaningful):
 *     boolVal   : BOOL
 *     numVal    : NUMBER, stored as a C double; numIsInt records whether the
 *                 source token had no fraction/exponent (so isInt()/asInt()
 *                 round-trip integers losslessly within double's 2^53 range).
 *     strVal    : STRING (decoded — escapes already resolved)
 *     arr       : ARRAY elements, in order
 *     objKeys   : OBJECT keys, in insertion order (decoded)
 *     objVals   : OBJECT values, parallel to objKeys
 *     keyIndex  : OBJECT key -> position, built once an object outgrows a
 *                 short linear scan, so lookups and parsing stay linear
 *
 * ARC: arr / objVals are Vector<JSONValue> fields, so when a JSONValue is
 * destroyed the framework releases the vectors, which release every child
 * JSONValue — the whole tree tears down recursively with no manual walk.
 * The collections are always allocated in the constructor so release is
 * well-defined regardless of tag.
 * --------------------------------------------------------------------------- */
class JSONValue {
	private JSONKind tag;
	private bool boolVal;
	private double numVal;
	private bool numIsInt;
	private string strVal;
	private Vector<JSONValue> arr;
	private Vector<string> objKeys;
	private Vector<JSONValue> objVals;
	private Map<string, int>? keyIndex;

	public JSONValue() {
		self.tag = JSON_NULL;
		self.boolVal = false;
		self.numVal = 0.0;
		self.numIsInt = true;
		self.strVal = "";
		self.arr = [];
		self.objKeys = [];
		self.objVals = [];
		self.keyIndex = null;
	}

	public void __del__() {
		/* arr / objVals (Vector<JSONValue>) release their children here. */
	}

	/* ---- Factories ------------------------------------------------------ */

	class JSONValue makeNull() {
		var v = JSONValue();
		v.tag = JSON_NULL;
		return v;
	}

	class JSONValue makeError() {
		var v = JSONValue();
		v.tag = JSON_ERROR;
		return v;
	}

	class JSONValue makeBool(bool b) {
		var v = JSONValue();
		v.tag = JSON_BOOL;
		v.boolVal = b;
		return v;
	}

	class JSONValue makeInt(int n) {
		var v = JSONValue();
		v.tag = JSON_NUMBER;
		v.numVal = (double)n;
		v.numIsInt = true;
		return v;
	}

	class JSONValue makeFloat(double d) {
		if (!Math.isFinite(d)) { return JSONValue.makeError(); }
		var v = JSONValue();
		v.tag = JSON_NUMBER;
		v.numVal = d;
		v.numIsInt = false;
		return v;
	}

	/* An integral number outside int's range, kept exactly as a double. */
	class JSONValue makeIntegral(double d) {
		if (!Math.isFinite(d)) { return JSONValue.makeError(); }
		var v = JSONValue();
		v.tag = JSON_NUMBER;
		v.numVal = d;
		v.numIsInt = true;
		return v;
	}

	class JSONValue makeString(string s) {
		var v = JSONValue();
		v.tag = JSON_STRING;
		v.strVal = (s == null) ? "" : s;
		return v;
	}

	class JSONValue makeArray() {
		var v = JSONValue();
		v.tag = JSON_ARRAY;
		return v;
	}

	class JSONValue makeObject() {
		var v = JSONValue();
		v.tag = JSON_OBJECT;
		return v;
	}

	/* ---- Builders (for constructing trees in code) --------------------- */

	public void push(JSONValue child) { self.arr.push(child); }

	public void set(string key, JSONValue value) {
		int position = self.keyPosition(key);
		if (position >= 0) {
			self.objVals.set(position, value);
			return;
		}
		self.objKeys.push(key);
		self.objVals.push(value);
		if (self.keyIndex != null) {
			self.keyIndex.put(key, self.objKeys.len - 1);
		} else if (self.objKeys.len > 8) {
			Map<string, int> index = {};
			for (int i = 0; i < self.objKeys.len; i++) {
				index.put(self.objKeys.get(i), i);
			}
			self.keyIndex = index;
		}
	}

	/* Position of key among objKeys, or -1. Small objects scan; larger ones
	 * consult keyIndex. */
	private int keyPosition(string key) {
		if (key == null) { return -1; }
		if (self.keyIndex != null) { return self.keyIndex.getOrDefault(key, -1); }
		for (int i = 0; i < self.objKeys.len; i++) {
			if (self.objKeys.get(i).equals(key)) { return i; }
		}
		return -1;
	}

	/* ---- Kind predicates ---------------------------------------------- */

	public JSONKind kind() { return self.tag; }

	public bool isNull() { return self.tag == JSON_NULL || self.tag == JSON_ERROR; }

	public bool isError() { return self.tag == JSON_ERROR; }

	public bool isBool() { return self.tag == JSON_BOOL; }

	public bool isNumber() { return self.tag == JSON_NUMBER; }

	public bool isString() { return self.tag == JSON_STRING; }

	public bool isArray() { return self.tag == JSON_ARRAY; }

	public bool isObject() { return self.tag == JSON_OBJECT; }

	public bool isInt() { return self.tag == JSON_NUMBER && self.numIsInt; }

	/* ---- Accessors with safe defaults --------------------------------- */

	public bool asBool() {
		if (self.tag == JSON_BOOL) { return self.boolVal; }
		return false;
	}

	public int asInt() {
		if (self.tag == JSON_NUMBER && self.numVal >= -2147483648.0 && self.numVal < 2147483648.0) {
			return (int)self.numVal;
		}
		return 0;
	}

	public double asFloat() {
		if (self.tag == JSON_NUMBER) { return self.numVal; }
		return 0.0;
	}

	public string asString() {
		if (self.tag == JSON_STRING) { return self.strVal; }
		return "";
	}

	/* size(): element count for arrays, key count for objects, else 0. */
	public int size() {
		if (self.tag == JSON_ARRAY) { return self.arr.len; }
		if (self.tag == JSON_OBJECT) { return self.objKeys.len; }
		return 0;
	}

	/* at(i): array element, or a null JSONValue if out of range / not array. */
	public JSONValue at(int i) {
		if (self.tag == JSON_ARRAY && i >= 0 && i < self.arr.len) {
			return self.arr.get(i);
		}
		return JSONValue.makeNull();
	}

	/* get(key): object member, or a null JSONValue if absent / not object. */
	public JSONValue get(string key) {
		if (self.tag == JSON_OBJECT) {
			int position = self.keyPosition(key);
			if (position >= 0) { return self.objVals.get(position); }
		}
		return JSONValue.makeNull();
	}

	public bool has(string key) { return self.tag == JSON_OBJECT && self.keyPosition(key) >= 0; }

	/* elements(): a fresh Vector of array elements (empty if not an array). */
	public Vector<JSONValue> elements() {
		Vector<JSONValue> result = [];
		if (self.tag == JSON_ARRAY) {
			for (int i = 0; i < self.arr.len; i++) {
				result.push(self.arr.get(i));
			}
		}
		return result;
	}

	/* keys(): a fresh Vector<string> of object keys (empty if not an object). */
	public Vector<string> keys() {
		Vector<string> result = [];
		if (self.tag == JSON_OBJECT) {
			for (int i = 0; i < self.objKeys.len; i++) {
				result.push(self.objKeys.get(i));
			}
		}
		return result;
	}

	/* ---- Parsing ------------------------------------------------------- */

	/* Full recursive-descent parse. Returns an ERROR sentinel JSONValue on
     * malformed input (never crashes). Trailing non-whitespace is rejected. */
	class JSONValue parse(string text) {
		if (text == null) { return JSONValue.makeError(); }
		var p = JSONParser(text);
		var value = p.parseValue();
		if (!p.ok) { return JSONValue.makeError(); }
		p.skipWs();
		if (p.pos < p.len) { return JSONValue.makeError(); }
		return value;
	}

	class JSONValue readFile(string path) { return JSONValue.parse(Path.readAll(path)); }

	/* ---- Stringify ----------------------------------------------------- */

	public string stringify() {
		var output = StringBuilder();
		self.writeJson(output, 0, false, 0);
		return output.toString();
	}

	/* Human-readable JSON with deterministic insertion order and no trailing
     * newline. Negative indentation widths are treated as zero. */
	public string stringifyPretty(int indentWidth = 2) {
		if (indentWidth < 0) { indentWidth = 0; }
		var output = StringBuilder();
		self.writeJson(output, 0, true, indentWidth);
		return output.toString();
	}

	/* Canonical file form: stringifyPretty(indentWidth) plus one newline. */
	public string document(int indentWidth = 2) {
		if (indentWidth < 0) { indentWidth = 0; }
		var output = StringBuilder();
		self.writeJson(output, 0, true, indentWidth);
		output.appendChar('\n');
		return output.toString();
	}

	private void writeIndent(StringBuilder output, int depth, int indentWidth) {
		if (depth <= 0 || indentWidth <= 0) { return; }
		long long count = (long long)depth * (long long)indentWidth;
		if (count > 2147483646LL) {
			throw "JSON indentation overflow";
		}
		output.appendRepeat(' ', (int)count);
	}

	private void writeJson(StringBuilder output, int depth, bool pretty, int indentWidth) {
		if (depth >= 512 && (self.tag == JSON_ARRAY || self.tag == JSON_OBJECT)) {
			throw "JSON nesting exceeds 512 levels";
		}
		if (self.tag == JSON_NULL || self.tag == JSON_ERROR) {
			output.append("null");
			return;
		}
		if (self.tag == JSON_BOOL) {
			output.append(self.boolVal ? "true" : "false");
			return;
		}
		if (self.tag == JSON_NUMBER) {
			output.append(JSONNum.format(self.numVal, self.numIsInt));
			return;
		}
		if (self.tag == JSON_STRING) {
			output.appendChar((char)34);
			JSONValue.appendEncodedString(output, self.strVal);
			output.appendChar((char)34);
			return;
		}
		if (self.tag == JSON_ARRAY) {
			output.appendChar('[');
			if (self.arr.len == 0) {
				output.appendChar(']');
				return;
			}
			if (pretty) { output.appendChar('\n'); }
			for (int i = 0; i < self.arr.len; i++) {
				if (i > 0) {
					output.appendChar(',');
					if (pretty) { output.appendChar('\n'); }
				}
				if (pretty) {
					self.writeIndent(output, depth + 1, indentWidth);
				}
				self.arr.get(i).writeJson(output, depth + 1, pretty, indentWidth);
			}
			if (pretty) {
				output.appendChar('\n');
				self.writeIndent(output, depth, indentWidth);
			}
			output.appendChar(']');
			return;
		}
		if (self.tag == JSON_OBJECT) {
			output.appendChar('{');
			if (self.objKeys.len == 0) {
				output.appendChar('}');
				return;
			}
			if (pretty) { output.appendChar('\n'); }
			for (int i = 0; i < self.objKeys.len; i++) {
				if (i > 0) {
					output.appendChar(',');
					if (pretty) { output.appendChar('\n'); }
				}
				if (pretty) {
					self.writeIndent(output, depth + 1, indentWidth);
				}
				output.appendChar((char)34);
				JSONValue.appendEncodedString(output, self.objKeys.get(i));
				output.append(pretty ? "\": " : "\":");
				self.objVals.get(i).writeJson(output, depth + 1, pretty, indentWidth);
			}
			if (pretty) {
				output.appendChar('\n');
				self.writeIndent(output, depth, indentWidth);
			}
			output.appendChar('}');
			return;
		}
		output.append("null");
	}

	/* Escape a string for JSON output, including all control chars < 0x20
     * (emitted as \uXXXX) and malformed UTF-8. */
	class string encodeString(string text) {
		var output = StringBuilder();
		JSONValue.appendEncodedString(output, text);
		return output.toString();
	}

	/* Append encoded content without surrounding quotes. Valid UTF-8 scalar
     * sequences are preserved byte-for-byte. Each rejected byte emits one
     * U+FFFD, then validation resumes at the following byte. */
	class void appendEncodedString(StringBuilder output, string text) {
		if (output == null || text == null) { return; }
		string hex = "0123456789abcdef";
		var n = text.len();
		int i = 0;
		while (i < n) {
			char c = text[i];
			int code = (int)((unsigned char)c);
			if (code < 0x80) {
				if (c == (char)34) { output.append("\\\""); }
				else if (c == '\\') { output.append("\\\\"); }
				else if (c == '\n') { output.append("\\n"); }
				else if (c == '\r') { output.append("\\r"); }
				else if (c == '\t') { output.append("\\t"); }
				else if (code == 8) { output.append("\\b"); }
				else if (code == 12) { output.append("\\f"); }
				else if (code < 32) {
					output.append("\\u00");
					output.appendChar(hex[(code >> 4) & 15]);
					output.appendChar(hex[code & 15]);
				} else {
					output.appendChar(c);
				}
				i++;
				continue;
			}

			int width = 0;
			if (code >= 0xc2 && code <= 0xdf) {
				width = 2;
			} else if (code >= 0xe0 && code <= 0xef) {
				width = 3;
			} else if (code >= 0xf0 && code <= 0xf4) {
				width = 4;
			}

			bool valid = width > 0 && width <= n - i;
			for (int offset = 1; valid && offset < width; offset++) {
				int continuation = (int)((unsigned char)text[i + offset]);
				if ((continuation & 0xc0) != 0x80) {
					valid = false;
				}
			}

			if (valid && width == 3) {
				int second = (int)((unsigned char)text[i + 1]);
				if ((code == 0xe0 && second < 0xa0) || (code == 0xed && second > 0x9f)) {
					valid = false;
				}
			} else if (valid && width == 4) {
				int second = (int)((unsigned char)text[i + 1]);
				if ((code == 0xf0 && second < 0x90) || (code == 0xf4 && second > 0x8f)) {
					valid = false;
				}
			}

			if (!valid) {
				output.append("\xef\xbf\xbd");
				i++;
				continue;
			}

			for (int offset = 0; offset < width; offset++) {
				output.appendChar(text[i + offset]);
			}
			i += width;
		}
	}
}

/* Stateful recursive-descent cursor over the source text. On any malformed
 * token it sets ok=false and stops; callers check ok. */
class JSONParser {
	public string text;
	public int pos;
	public int len;
	public bool ok;
	public int depth;

	public JSONParser(string text) {
		self.text = text;
		self.pos = 0;
		self.len = text.len();
		self.ok = true;
		self.depth = 0;
	}

	public void skipWs() {
		while (self.pos < self.len) {
			char c = self.text[self.pos];
			if (c == ' ' || c == '\n' || c == '\t' || c == '\r') { self.pos++; }
			else { break; }
		}
	}

	public JSONValue parseValue() {
		self.skipWs();
		if (self.pos >= self.len) { self.ok = false; return JSONValue.makeError(); }
		char c = self.text[self.pos];
		if (c == '{') {
			if (self.depth >= 512) { self.ok = false; return JSONValue.makeError(); }
			self.depth++;
			var objectValue = self.parseObject();
			self.depth--;
			return objectValue;
		}
		if (c == '[') {
			if (self.depth >= 512) { self.ok = false; return JSONValue.makeError(); }
			self.depth++;
			var arrayValue = self.parseArray();
			self.depth--;
			return arrayValue;
		}
		if (c == (char)34) { return self.parseStringValue(); }
		if (c == 't' || c == 'f') { return self.parseBool(); }
		if (c == 'n') { return self.parseNull(); }
		if (c == '-' || (c >= '0' && c <= '9')) { return self.parseNumber(); }
		self.ok = false;
		return JSONValue.makeError();
	}

	public JSONValue parseObject() {
		var obj = JSONValue.makeObject();
		self.pos++;  /* consume '{' */
		self.skipWs();
		if (self.pos < self.len && self.text[self.pos] == '}') {
			self.pos++;
			return obj;
		}
		while (true) {
			self.skipWs();
			if (self.pos >= self.len || self.text[self.pos] != (char)34) {
				self.ok = false; return obj;
			}
			var key = self.readString();
			if (!self.ok) { return obj; }
			if (obj.has(key)) {
				self.ok = false;
				return obj;
			}
			self.skipWs();
			if (self.pos >= self.len || self.text[self.pos] != ':') {
				self.ok = false; return obj;
			}
			self.pos++;  /* consume ':' */
			var value = self.parseValue();
			if (!self.ok) { return obj; }
			obj.set(key, value);
			self.skipWs();
			if (self.pos >= self.len) { self.ok = false; return obj; }
			char d = self.text[self.pos];
			if (d == ',') { self.pos++; continue; }
			if (d == '}') { self.pos++; return obj; }
			self.ok = false; return obj;
		}
		return obj;
	}

	public JSONValue parseArray() {
		var arr = JSONValue.makeArray();
		self.pos++;  /* consume '[' */
		self.skipWs();
		if (self.pos < self.len && self.text[self.pos] == ']') {
			self.pos++;
			return arr;
		}
		while (true) {
			var value = self.parseValue();
			if (!self.ok) { return arr; }
			arr.push(value);
			self.skipWs();
			if (self.pos >= self.len) { self.ok = false; return arr; }
			char d = self.text[self.pos];
			if (d == ',') { self.pos++; continue; }
			if (d == ']') { self.pos++; return arr; }
			self.ok = false; return arr;
		}
		return arr;
	}

	public JSONValue parseStringValue() {
		var s = self.readString();
		if (!self.ok) { return JSONValue.makeError(); }
		return JSONValue.makeString(s);
	}

	/* Read a quoted string at self.pos, decoding escapes; advances past the
     * closing quote. Sets ok=false on an unterminated or invalid escape. */
	public string readString() {
		self.pos++;  /* consume opening '"' */
		var output = StringBuilder();
		while (self.pos < self.len) {
			char c = self.text[self.pos];
			if (c == (char)34) {
				self.pos++;
				return output.toString();
			}
			if (c == '\\') {
				self.pos++;
				if (self.pos >= self.len) {
					self.ok = false;
					return output.toString();
				}
				char e = self.text[self.pos];
				if (e == (char)34) { output.appendChar((char)34); }
				else if (e == '\\') { output.appendChar('\\'); }
				else if (e == '/') { output.appendChar('/'); }
				else if (e == 'n') { output.appendChar('\n'); }
				else if (e == 'r') { output.appendChar('\r'); }
				else if (e == 't') { output.appendChar('\t'); }
				else if (e == 'b') { output.appendChar((char)8); }
				else if (e == 'f') { output.appendChar((char)12); }
				else if (e == 'u') {
					var cp = self.readHex4();
					if (!self.ok) { return output.toString(); }
					/* High surrogate: combine with a following \uXXXX low
                     * surrogate into one code point (BMP-pair → astral). */
					/* A high surrogate not followed by a low one is replaced
                     * alone; the escape after it gets its own chance to start
                     * a pair, so a high surrogate before a valid pair is U+FFFD and the pair. */
					while (cp >= 0xD800 && cp <= 0xDBFF) {
						if (!(self.pos + 2 < self.len && self.text[self.pos + 1] == '\\' && self.text[self.pos + 2] == 'u')) {
							cp = 0xFFFD;  /* lone high surrogate */
							break;
						}
						self.pos += 2;
						var lo = self.readHex4();
						if (!self.ok) { return output.toString(); }
						if (lo >= 0xDC00 && lo <= 0xDFFF) {
							cp = 0x10000 + ((cp - 0xD800) * 0x400) + (lo - 0xDC00);
						} else {
							output.append(JSONNum.utf8(0xFFFD));
							cp = lo;
						}
					}
					if (cp >= 0xDC00 && cp <= 0xDFFF) {
						cp = 0xFFFD;  /* lone low surrogate */
					}
					output.append(JSONNum.utf8(cp));
				} else {
					self.ok = false;
					return output.toString();
				}
				self.pos++;
				continue;
			}
			if ((int)((unsigned char)c) < 32) {
				self.ok = false;
				return output.toString();
			}
			output.appendChar(c);
			self.pos++;
		}
		self.ok = false;  /* unterminated */
		return output.toString();
	}

	/* Read exactly 4 hex digits starting just after the 'u'; leaves self.pos
     * on the last hex digit so the caller's pos++ moves past it. */
	public int readHex4() {
		var value = 0;
		for (int k = 0; k < 4; k++) {
			self.pos++;
			if (self.pos >= self.len) { self.ok = false; return 0; }
			char h = self.text[self.pos];
			var digit = -1;
			if (h >= '0' && h <= '9') { digit = (int)(h - '0'); }
			else if (h >= 'a' && h <= 'f') { digit = (int)(h - 'a') + 10; }
			else if (h >= 'A' && h <= 'F') { digit = (int)(h - 'A') + 10; }
			else { self.ok = false; return 0; }
			value = value * 16 + digit;
		}
		return value;
	}

	public JSONValue parseBool() {
		if (self.matchLiteral("true")) { return JSONValue.makeBool(true); }
		if (self.matchLiteral("false")) { return JSONValue.makeBool(false); }
		self.ok = false; return JSONValue.makeError();
	}

	public JSONValue parseNull() {
		if (self.matchLiteral("null")) { return JSONValue.makeNull(); }
		self.ok = false; return JSONValue.makeError();
	}

	public bool matchLiteral(string word) {
		var n = word.len();
		if (self.pos + n > self.len) { return false; }
		for (int k = 0; k < n; k++) {
			if (self.text[self.pos + k] != word[k]) { return false; }
		}
		self.pos += n;
		return true;
	}

	public JSONValue parseNumber() {
		var start = self.pos;
		var isFloat = false;
		if (self.pos < self.len && self.text[self.pos] == '-') { self.pos++; }
		/* integer part */
		if (self.pos >= self.len) { self.ok = false; return JSONValue.makeError(); }
		if (self.text[self.pos] == '0') {
			self.pos++;
		} else if (self.text[self.pos] >= '1' && self.text[self.pos] <= '9') {
			while (self.pos < self.len && self.text[self.pos] >= '0' && self.text[self.pos] <= '9') {
				self.pos++;
			}
		} else {
			self.ok = false; return JSONValue.makeError();
		}
		/* fraction */
		if (self.pos < self.len && self.text[self.pos] == '.') {
			isFloat = true;
			self.pos++;
			if (self.pos >= self.len || self.text[self.pos] < '0' || self.text[self.pos] > '9') {
				self.ok = false; return JSONValue.makeError();
			}
			while (self.pos < self.len && self.text[self.pos] >= '0' && self.text[self.pos] <= '9') {
				self.pos++;
			}
		}
		/* exponent */
		if (self.pos < self.len && (self.text[self.pos] == 'e' || self.text[self.pos] == 'E')) {
			isFloat = true;
			self.pos++;
			if (self.pos < self.len && (self.text[self.pos] == '+' || self.text[self.pos] == '-')) {
				self.pos++;
			}
			if (self.pos >= self.len || self.text[self.pos] < '0' || self.text[self.pos] > '9') {
				self.ok = false; return JSONValue.makeError();
			}
			while (self.pos < self.len && self.text[self.pos] >= '0' && self.text[self.pos] <= '9') {
				self.pos++;
			}
		}
		var token = self.text.substring(start, self.pos - start);
		var d = JSONNum.toDouble(token);
		if (!Math.isFinite(d)) {
			self.ok = false;
			return JSONValue.makeError();
		}
		if (isFloat) { return JSONValue.makeFloat(d); }
		return JSONValue.makeIntegral(d);
	}
}

/* Numeric / byte helpers kept apart from the tree so the tree stays focused. */
class JSONNum {
	/* Parse a JSON numeric token without changing the process locale. */
	class double toDouble(string token) {
		string localized = token;
		struct lconv* convention = localeconv();
		if (convention != NULL && convention->decimal_point != NULL) {
			string decimalPoint = Strings.copy(convention->decimal_point);
			if (!decimalPoint.isEmpty() && !decimalPoint.equals(".")) {
				localized = Strings.replace(token, ".", decimalPoint);
			}
		}
		return strtod(localized, NULL);
	}

	/* Format a number for JSON output. Signed-64-bit integers print without a
     * decimal point; larger integral doubles and floats use %.17g, which
     * guarantees parse(stringify(v)) == v for the stored IEEE double value. */
	class string format(double value, bool isInt) {
		if (!Math.isFinite(value)) { return "null"; }
		if (isInt && value >= -9223372036854775808.0 && value < 9223372036854775808.0) {
			char* buf = (char*)__btrc_safe_realloc(null, (size_t)32);
			snprintf(buf, 32, "%lld", (long long)value);
			return __btrc_str_track(buf);
		}
		char* buf = (char*)__btrc_safe_realloc(null, (size_t)40);
		snprintf(buf, 40, "%.17g", value);
		string formatted = __btrc_str_track(buf);

		/* C formatting follows LC_NUMERIC; JSON always uses '.'. */
		struct lconv* convention = localeconv();
		if (convention != NULL && convention->decimal_point != NULL) {
			string decimalPoint = Strings.copy(convention->decimal_point);
			if (!decimalPoint.isEmpty() && !decimalPoint.equals(".")) {
				return Strings.replace(formatted, decimalPoint, ".");
			}
		}
		return formatted;
	}

	/* Encode a Unicode code point as a UTF-8 byte string. */
	class string utf8(int cp) {
		if (cp < 0 || cp > 0x10FFFF || (cp >= 0xD800 && cp <= 0xDFFF)) {
			cp = 0xFFFD;
		}
		if (cp < 0x80) {
			char* b = (char*)__btrc_safe_realloc(null, (size_t)2);
			b[0] = (char)cp;
			b[1] = (char)0;
			return __btrc_str_track(b);
		}
		if (cp < 0x800) {
			char* b = (char*)__btrc_safe_realloc(null, (size_t)3);
			b[0] = (char)(0xC0 | (cp >> 6));
			b[1] = (char)(0x80 | (cp & 0x3F));
			b[2] = (char)0;
			return __btrc_str_track(b);
		}
		if (cp < 0x10000) {
			char* b = (char*)__btrc_safe_realloc(null, (size_t)4);
			b[0] = (char)(0xE0 | (cp >> 12));
			b[1] = (char)(0x80 | ((cp >> 6) & 0x3F));
			b[2] = (char)(0x80 | (cp & 0x3F));
			b[3] = (char)0;
			return __btrc_str_track(b);
		}
		char* b = (char*)__btrc_safe_realloc(null, (size_t)5);
		b[0] = (char)(0xF0 | (cp >> 18));
		b[1] = (char)(0x80 | ((cp >> 12) & 0x3F));
		b[2] = (char)(0x80 | ((cp >> 6) & 0x3F));
		b[3] = (char)(0x80 | (cp & 0x3F));
		b[4] = (char)0;
		return __btrc_str_track(b);
	}
}
