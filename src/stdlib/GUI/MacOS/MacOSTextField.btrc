import Library.Callback;
import Library.Math;
import Library.GUI.ITextField;
import Library.GUI.MacOS.AppKitText;
import Library.GUI.MacOS.MacOSView;

/* Main-thread owner of an actual AppKit text field, not a painted imitation.
 * MacOSView owns attachment, input and teardown; this owner adds editing and
 * ends any active field-editor session before the view closes. AppKit owns
 * selection, IME and field editing. */
class MacOSTextField implements ITextField, IMacOSView {
	private NSTextField? _control;
	private MacOSView _view;

	public MacOSTextField(string text = "", string placeholder = "") {
		self._control = null;
		self.requireMainThread();
		var control = NSTextField.textFieldWithString(AppKitText.nativeValue(text));
		if (control == null) { throw "Cannot create native text field"; }
		self._control = control;
		self._view = MacOSView(control);
		/* Rounded bezels center their text vertically and share the native
		 * control heights buttons use, so mixed toolbars align without padding hacks. */
		control.setBezelStyle(NSTextFieldRoundedBezel);
		self.setPlaceholder(placeholder);
	}

	private void requireMainThread() {
		if (!NSThread.isMainThread()) { throw "AppKit text fields require the main thread"; }
	}

	public NSTextField nativeControl() {
		self.requireMainThread();
		if (self._control == null || !self._view.isOpen()) { throw "Text field is closed"; }
		return self._control;
	}

	public bool isOpen() { self.requireMainThread(); return self._control != null && self._view.isOpen(); }

	public NSView nativeView() { return self.nativeControl(); }

	public void attachTo(NSView parent) { self.nativeControl(); self._view.attachTo(parent); }

	public void detachFrom(NSView parent) { self.nativeControl(); self._view.detachFrom(parent); }

	public double fittingWidth() { self.nativeControl(); return self._view.fittingWidth(); }

	public double fittingHeight() { self.nativeControl(); return self._view.fittingHeight(); }

	public bool isVisible() { self.nativeControl(); return self._view.isVisible(); }

	public ICallbackRegistration onPointer(IViewPointerHandler handler, CallbackScope owner) { self.nativeControl(); return self._view.onPointer(handler, owner); }

	public ICallbackRegistration onScroll(IViewScrollHandler handler, CallbackScope owner) { self.nativeControl(); return self._view.onScroll(handler, owner); }

	public void cancelPointerCapture() { self._view.cancelPointerCapture(); }

	public void setVisible(bool visible) { self.nativeControl(); self._view.setVisible(visible); }

	public void arrange(double x, double y, double width, double height) { self.nativeControl(); self._view.arrange(x, y, width, height); }

	public string text() {
		var control = self.nativeControl();
		control.validateEditing();
		return AppKitText.ownedValue(control.stringValue());
	}

	/* Re-publishing unchanged application state must not reset selection or
	 * the active input-method composition. */
	public void setText(string text) {
		var control = self.nativeControl();
		if (self.text().equals(text)) { return; }
		control.setStringValue(AppKitText.nativeValue(text));
	}

	public void setPlaceholder(string text) { self.nativeControl().setPlaceholderString(AppKitText.nativeValue(text)); }

	public void setEnabled(bool enabled) { self.nativeControl().setEnabled(enabled); }

	public void setFont(double size) {
		if (!Math.isFinite(size) || size <= 0.0 || size > 512.0) { throw "Invalid native text field font size"; }
		var control = self.nativeControl();
		control.setControlSize(size > 13.0 ? NSControlSizeLarge : NSControlSizeRegular);
		control.setFont(NSFont.systemFontOfSize(size));
	}

	public bool isEnabled() { return self.nativeControl().isEnabled(); }

	/* AppKit frame coordinates are logical points in the parent view. */
	public void setFrame(double x, double y, double width, double height) {
		if (!Math.isFinite(x) || !Math.isFinite(y) || !Math.isFinite(width) || !Math.isFinite(height) || width < 0.0 || height < 0.0) { throw "Invalid text field frame"; }
		var control = self.nativeControl();
		var frame = control.frame();
		frame.origin.x = x;
		frame.origin.y = y;
		frame.size.width = width;
		frame.size.height = height;
		control.setFrame(frame);
	}

	public CallbackCancellation pollClose() {
		self.requireMainThread();
		var state = self._view.pollClose();
		if (state == CALLBACK_CANCELLATION_COMPLETE) { self._control = null; }
		return state;
	}

	public CallbackCancellation close() {
		self.requireMainThread();
		var control = self._control;
		if (control == null) { return CALLBACK_CANCELLATION_COMPLETE; }
		if (self._view.isOpen()) {
			self._view.requireDetached();
			// End any field-editor session while the control is still in its window.
			control.abortEditing();
		}
		var state = self._view.close();
		if (state == CALLBACK_CANCELLATION_COMPLETE) { self._control = null; }
		return state;
	}
}
