import Library.GUI.ApplicationSlot;
import Library.GUI.IWebView;
import Library.GUI.MacOS.MacOSApplication;
import Library.GUI.MacOS.MacOSWebView;

/* Private package implementation for macOS: the web view behind the WebView
 * facade, a WKWebView among the application's other views. */
class WebViewProvider {
	class IWebView create() {
		var application = (IMacOSApplication?)GUIApplicationSlot.require();
		if (application == null) { throw "The macOS web view needs the macOS GUI application"; }
		var view = MacOSWebView();
		application.adopt(view);
		return view;
	}
}
