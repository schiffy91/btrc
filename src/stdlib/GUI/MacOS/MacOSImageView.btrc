import Library.Image;
import Library.Callback;
import Library.GUI.IImageView;
import Library.GUI.IImageHandle;
import Library.GUI.MacOS.MacOSView;
import Library.GUI.MacOS.MacOSImageHandle;

/* Native artwork presentation. Decode once when the source changes; resizing
 * does not re-encode it or create a new control. Aspect ratio is preserved. */
class MacOSImageView implements IImageView, IMacOSView {
	private NSImageView? _imageView;
	private MacOSView _view;

	public MacOSImageView() {
		if (!NSThread.isMainThread()) { throw "Native images require the main thread"; }
		var view = NSImageView.new();
		if (view == null) { throw "Cannot create native image view"; }
		self._imageView = view;
		self._view = MacOSView(view);
		view.setImageScaling(NSImageScaleProportionallyUpOrDown);
	}

	public NSView nativeView() { return self._view.nativeView(); }

	public void attachTo(NSView parent) { self._view.attachTo(parent); }

	public void detachFrom(NSView parent) { self._view.detachFrom(parent); }

	public bool isOpen() { return self._view.isOpen(); }

	public double fittingWidth() { return self._view.fittingWidth(); }

	public double fittingHeight() { return self._view.fittingHeight(); }

	public void arrange(double x, double y, double width, double height) { self._view.arrange(x, y, width, height); }

	public bool isVisible() { return self._view.isVisible(); }

	public ICallbackRegistration onPointer(IViewPointerHandler handler, CallbackScope owner) { return self._view.onPointer(handler, owner); }

	public ICallbackRegistration onScroll(IViewScrollHandler handler, CallbackScope owner) { return self._view.onScroll(handler, owner); }

	public void cancelPointerCapture() { self._view.cancelPointerCapture(); }

	public void setVisible(bool visible) { self._view.setVisible(visible); }

	public CallbackCancellation pollClose() { return self._view.pollClose(); }

	public void setImage(Image? pixels, int maximumPixels = 16777216) {
		self.nativeView();
		var view = self._imageView;
		if (view == null) { throw "Native image view is closed"; }
		if (pixels == null) { view.setImage(null); return; }
		if (maximumPixels <= 0 || maximumPixels > 16777216 || pixels.isEmpty() || (long long)pixels.width * (long long)pixels.height > (long long)maximumPixels) { throw "Native artwork exceeds image limits"; }
		var encoded = ImageIO.encodeBmp(pixels);
		var data = NSData.dataWithBytes(encoded.data, (unsigned long)encoded.length());
		if (data == null) { throw "Cannot allocate native image data"; }
		var representation = NSBitmapImageRep.imageRepWithData(data);
		if (representation == null) { throw "Cannot decode native image"; }
		var image = NSImage.new();
		if (image == null) { throw "Cannot allocate native image"; }
		image.addRepresentation(representation);
		view.setImage(image);
	}

	public void setImageHandle(IImageHandle? handle) {
		self.nativeView();
		var view = self._imageView;
		if (view == null) { throw "Native image view is closed"; }
		if (handle == null) { view.setImage(null); return; }
		IMacOSImageHandle? native = (IMacOSImageHandle?)handle;
		if (native == null) { throw "Native image view requires a macOS image handle"; }
		view.setImage(native.nativeImage());
	}

	public void setFrame(double x, double y, double width, double height) { self._view.setFrame(x, y, width, height); }

	public void setHidden(bool hidden) { self._view.setHidden(hidden); }

	public CallbackCancellation close() { var state = self._view.close(); self._imageView = null; return state; }
}
