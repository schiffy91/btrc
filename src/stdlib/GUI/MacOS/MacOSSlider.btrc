import Library.GUI.MacOS.MacOSViewState;
import Library.Math;
import Library.GUI.SliderInteraction;
import Library.GUI.MacOS.AppKitEvents;
import Library.GUI.MacOS.MacOSViewInput;
import Library.UI.Element;
import Library.GUI.ControlEvents;
import Library.Callback;
import Library.GUI.ISlider;
import Library.GUI.MacOS.AppKitText;
import Library.GUI.MacOS.MacOSView;

class MacOSSliderFocus implements IAppKitNotificationObserver {
	private MacOSSlider _slider;
	public MacOSSliderFocus(MacOSSlider slider) { self._slider = slider; }

	public void invoke(NSNotification notification) { self._slider.focusLost(notification); }
}

/* The instantiated native adapter can outlive the public control. Its scoped
 * receiver drops the owner after admitted accessibility calls have returned. */
class MacOSSliderAccessibility implements IAppKitSliderAccessibility, ICallbackRegistration {
	private MacOSSlider? _owner;
	private bool _open = true;
	private int _inFlight = 0;
	public void bind(MacOSSlider owner) {
		if (!self._open || self._owner != null) { throw "Slider accessibility receiver is already bound or closed"; }
		self._owner = owner;
	}

	private bool adjust(UIRangeAdjustment adjustment) {
		if (!NSThread.isMainThread()) { throw "Native slider accessibility requires the main thread"; }
		if (!self._open || self._owner == null) { return false; }
		if (self._inFlight == 2147483647) { throw "Slider accessibility entry count exhausted"; }
		bool accepted = false; self._inFlight++;
		try { var owner = self._owner; if (owner != null) { accepted = owner.adjustAccessibility(adjustment); } }
		finally { self._inFlight--; if (!self._open && self._inFlight == 0) { self._owner = null; } }
		return accepted;
	}

	public void setAccessibilityValue(id? value) {
		if (!NSThread.isMainThread()) { throw "Native slider accessibility requires the main thread"; }
		if (!self._open || self._owner == null) { return; }
		var number = (NSNumber?)value; if (number == null) { return; }
		double absolute = number.doubleValue(); if (!Math.isFinite(absolute)) { return; }
		if (self._inFlight == 2147483647) { throw "Slider accessibility entry count exhausted"; }
		self._inFlight++;
		try { var owner = self._owner; if (owner != null) { owner.setAccessibilityValue(absolute); } }
		finally { self._inFlight--; if (!self._open && self._inFlight == 0) { self._owner = null; } }
	}

	public bool accessibilityPerformIncrement() { return self.adjust(UI_RANGE_ADJUST_SMALL_INCREMENT); }

	public bool accessibilityPerformDecrement() { return self.adjust(UI_RANGE_ADJUST_SMALL_DECREMENT); }

	public bool isOpen() { return self._open; }

	public CallbackCancellation cancel() { self._open = false; return self.pollCompletion(); }

	public CallbackCancellation pollCompletion() {
		if (self._open) { return CALLBACK_CANCELLATION_NOT_REQUESTED; }
		if (self._inFlight > 0) { return CALLBACK_CANCELLATION_PENDING; }
		self._owner = null; return CALLBACK_CANCELLATION_COMPLETE;
	}
}

class MacOSSliderAccessibilityFactory implements IAppKitSliderAccessibilityFactory {
	private MacOSSliderAccessibility _receiver;
	public MacOSSliderAccessibilityFactory(MacOSSliderAccessibility receiver) { self._receiver = receiver; }

	public IAppKitSliderAccessibility create() { return self._receiver; }
}

/* AppKit draws the native control; the shared model owns value and tracking.
 * Consuming slider presses prevents NSSliderCell from entering a nested loop. */
class MacOSSlider implements ISlider, IMacOSView, IMacOSViewEligibility, IAppKitEventMonitor, IMacOSNativeSettlement {
	private NSSlider? _slider;
	private MacOSView _view;
	private SliderInteraction _interaction;
	private CallbackScope _native = CallbackScope();
	private bool _closing = false;
	private MacOSNativeSettlementRegistration? _settlement;
	private NSWindow? _trackingWindow;
	private long long _trackingSerial = 0LL;
	private long long _pendingTerminal = 0LL;
	private bool _pendingCommit = false;
	private double _pendingValue = 0.0;
	private ControlOrigin _pendingOrigin = CONTROL_ORIGIN_SYSTEM;
	private ControlCancelReason _pendingReason = CONTROL_CANCEL_NONE;

	public MacOSSlider(double minimum, double maximum, int intervals = 0) {
		if (!NSThread.isMainThread()) { throw "Native sliders require the main thread"; }
		self._interaction = SliderInteraction(minimum, maximum, intervals);
		var accessibility = MacOSSliderAccessibility(); CGRect frame = {{0.0, 0.0}, {0.0, 0.0}};
		var slider = NSSlider.initWithFrame(MacOSSliderAccessibilityFactory(accessibility), frame);
		if (slider == null) { throw "Cannot create native slider"; }
		self._slider = slider;
		self._view = MacOSView(slider);
		self._view.bindEligibility(self);
		slider.setAllowsTickMarkValuesOnly(false);
		slider.setContinuous(false);
		self.project();
		try {
			self._native.track(accessibility); accessibility.bind(self);
			NSEvent.addLocalMonitorForEventsMatchingMask(NSEventMaskLeftMouseDown | NSEventMaskLeftMouseDragged | NSEventMaskLeftMouseUp | NSEventMaskKeyDown, self, self._native);
			var focus = MacOSSliderFocus(self);
			NSNotificationCenter.defaultCenter().addObserverForName(NSWindowDidResignKeyNotification, null, null, focus, self._native);
			NSNotificationCenter.defaultCenter().addObserverForName(NSApplicationDidResignActiveNotification, null, null, focus, self._native);
		} catch (string error) { self._native.cancel(); self._view.close(); self._slider = null; throw error; }
	}

	private NSSlider control() {
		self._view.nativeView();
		if (self._slider == null) { throw "Native slider is closed"; }
		return self._slider;
	}

	public MacOSViewState stateNode() { return self._view.stateNode(); }

	public ViewInteractionState interactionState() { return self._view.interactionState(); }

	public ICallbackRegistration onInteractionStateChanged(IViewInteractionStateHandler handler, CallbackScope owner) { return self._view.onInteractionStateChanged(handler, owner); }

	public NSView nativeView() { return self._view.nativeView(); }

	public void attachTo(NSView parent) { self._view.attachTo(parent); }

	public void detachFrom(NSView parent) { self._view.detachFrom(parent); }

	public bool isOpen() { return self._view.isOpen(); }

	public double fittingWidth() { return self._view.fittingWidth(); }

	public double fittingHeight() { return self._view.fittingHeight(); }

	public void arrange(double x, double y, double width, double height) { self._view.arrange(x, y, width, height); }

	public bool isVisible() { return self._view.isVisible(); }

	public ICallbackRegistration onPointer(IViewPointerHandler handler, CallbackScope owner) { return self._view.onPointer(handler, owner); }

	public ICallbackRegistration onScroll(IViewScrollHandler handler, CallbackScope owner) { return self._view.onScroll(handler, owner); }

	public void cancelPointerCapture() { self._view.cancelPointerCapture(); }

	public void setVisible(bool visible) { self._view.setVisible(visible); }

	public CallbackCancellation pollClose() {
		if (!NSThread.isMainThread()) { throw "Native sliders require the main thread"; }
		if (!self._closing) { return CALLBACK_CANCELLATION_NOT_REQUESTED; }
		var native = self._native.pollCompletion(); if (native != CALLBACK_CANCELLATION_COMPLETE) { return native; }
		var state = self._view.pollClose(); if (state == CALLBACK_CANCELLATION_COMPLETE) { self._slider = null; self._settlement = null; self._trackingWindow = null; } return state;
	}

	public SliderRange range() { self.control(); return self._interaction.range(); }

	public double value() { self.control(); return self._interaction.value(); }

	private void project() {
		var slider = self._slider; if (slider == null) { return; } var range = self._interaction.range();
		slider.setMinValue(range.minimum); slider.setMaxValue(range.maximum);
		double ticks = range.step > 0.0 ? (range.maximum - range.minimum) / range.step : 0.0;
		slider.setNumberOfTickMarks(ticks >= 1.0 && ticks <= 64.0 ? (int)Math.floorDouble(ticks) + 1 : 0);
		slider.setDoubleValue(self._interaction.value());
	}

	public void setRange(double minimum, double maximum, double step) {
		self.stateNode().requireMutation(); self.control(); self.settleNative();
		if (self._interaction.setRange(minimum, maximum, step)) { self.project(); }
	}

	public void setRangeValue(SliderRange range, double value) {
		self.stateNode().requireMutation(); self.control();
		if (range == null) { throw "Slider range is missing"; } self.settleNative();
		if (self._interaction.setRangeValue(range.minimum, range.maximum, range.step, value)) { self.project(); }
	}

	public void setValue(double value) {
		self.stateNode().requireMutation(); self.control(); self.settleNative();
		if (self._interaction.setValue(value)) { self.project(); }
	}

	private void reserveSettlement() {
		if (self._settlement != null) { return; }
		var context = self.stateNode().context(); if (context == null) { throw "Native slider interactions require an application context"; }
		self._settlement = context.registerNativeSettlement(self, self._native);
	}

	/* A dequeued terminal survives a finite tree transaction in the settlement
	 * already owned by this interaction. The first terminal wins. */
	private void deferTerminal(bool commit, double value, ControlOrigin origin, ControlCancelReason reason) {
		if (self._pendingTerminal == self._trackingSerial) { return; }
		self._pendingTerminal = self._trackingSerial; self._pendingCommit = commit; self._pendingValue = value; self._pendingOrigin = origin; self._pendingReason = reason;
		var settlement = self._settlement; if (settlement == null) { throw "Slider terminal settlement was not reserved"; } settlement.request();
	}

	public void settleNative() {
		long long pending = self._pendingTerminal; bool commit = self._pendingCommit; double value = self._pendingValue;
		var origin = self._pendingOrigin; var reason = self._pendingReason; self._pendingTerminal = 0LL;
		if (pending > 0LL && pending == self._trackingSerial && self._interaction.active()) {
			if (commit) { self._interaction.commitValue(value); self.project(); }
			else { self.cancelTracking(origin, reason); }
		}
	}

	private bool nativeInputAllowed() {
		var context = self.stateNode().context();
		return context != null && !context.treeMutationActive() && !context.nativeFailed();
	}

	public void setAccessibilityValue(double value) {
		try {
			if (self.nativeInputAllowed()) { self.settleNative(); }
			var state = self.stateNode(); var context = state.context();
			if (!self._closing && state.effectiveEligible() && context != null && self.nativeInputAllowed() && !self._interaction.inert()) {
				var range = self._interaction.range();
				if (value >= range.minimum && value <= range.maximum) { self.reserveSettlement(); if (!self._interaction.assistiveValue(state.generation(), value)) { throw "Native slider capture capacity exceeded"; } self.project(); }
			}
		} catch (string error) { var context = self.stateNode().context(); if (context != null) { context.recordNativeFailure(error); } }
	}

	public bool adjustAccessibility(UIRangeAdjustment adjustment) {
		bool accepted = false;
		try {
			if (self.nativeInputAllowed()) { self.settleNative(); }
			var state = self.stateNode(); var context = state.context();
			if (!self._closing && state.effectiveEligible() && context != null && self.nativeInputAllowed() && !self._interaction.inert()) {
				self.reserveSettlement(); accepted = self._interaction.adjust(state.generation(), adjustment, 1); if (!accepted) { throw "Native slider capture capacity exceeded"; } self.project();
			}
		} catch (string error) { var context = self.stateNode().context(); if (context != null) { context.recordNativeFailure(error); } }
		return accepted;
	}

	public ICallbackRegistration onPreview(ISliderControlEventHandler receiver, CallbackScope owner) {
		var state = self.stateNode(); state.requireMutation(); self.reserveSettlement();
		var channel = self._interaction.onPreview(state.events(), state, receiver, owner); state.ownChannel(channel); return channel;
	}

	public ICallbackRegistration onCommit(ISliderControlEventHandler receiver, CallbackScope owner) {
		var state = self.stateNode(); state.requireMutation(); self.reserveSettlement();
		var channel = self._interaction.onCommit(state.events(), state, receiver, owner); state.ownChannel(channel); return channel;
	}

	public ICallbackRegistration onCancel(ISliderControlEventHandler receiver, CallbackScope owner) {
		var state = self.stateNode(); state.requireMutation(); self.reserveSettlement();
		var channel = self._interaction.onCancel(state.events(), state, receiver, owner); state.ownChannel(channel); return channel;
	}

	public void eligibilityLost() {
		try { self.cancelTracking(CONTROL_ORIGIN_SYSTEM, CONTROL_CANCEL_ELIGIBILITY_LOSS); }
		catch (string error) { var context = self.stateNode().context(); if (context != null) { context.recordNativeFailure(error); } }
	}

	private void cancelTracking(ControlOrigin origin, ControlCancelReason reason) {
		self.settleNative();
		try { self._interaction.cancel(origin, reason); } finally { self.project(); }
	}

	public void focusLost(NSNotification notification) {
		try { self.cancelForFocus(notification); }
		catch (string error) {
			var context = self.stateNode().context(); if (context != null) { context.recordNativeFailure(error); }
		}
	}

	private void cancelForFocus(NSNotification notification) {
		if (self._closing || !self._interaction.active()) { return; }
		id? window = self._trackingWindow;
		if (notification.name() == NSApplicationDidResignActiveNotification || notification.object() == window) {
			var context = self.stateNode().context();
			if (context != null && context.treeMutationActive()) {
				self.deferTerminal(false, 0.0, CONTROL_ORIGIN_SYSTEM, CONTROL_CANCEL_CAPTURE_LOSS);
			} else { self.cancelTracking(CONTROL_ORIGIN_SYSTEM, CONTROL_CANCEL_CAPTURE_LOSS); }
		}
	}

	private double valueAt(NSEvent event) {
		var slider = self.control(); var cell = (NSSliderCell?)slider.cell();
		if (cell == null) { throw "Native slider cell is unavailable"; }
		NSView view = slider; var bar = cell.barRectFlipped(view.isFlipped());
		double radius = cell.knobThickness() * 0.5;
		double width = Math.maxDouble(1.0, bar.size.width - radius * 2.0);
		double x = view.convertPoint(event.locationInWindow(), null).x;
		double fraction = Math.maxDouble(0.0, Math.minDouble(1.0, (x - bar.origin.x - radius) / width));
		var range = self._interaction.range();
		double value = fraction == 0.0 ? range.minimum : fraction == 1.0 ? range.maximum : range.minimum + fraction * (range.maximum - range.minimum);
		return value;
	}

	public NSEvent? invoke(NSEvent event) {
		NSEvent? result = null;
		try { result = self.input(event); }
		catch (string error) {
			var context = self.stateNode().context();
			if (context != null) { context.recordNativeFailure(error); }
		}
		return result;
	}

	private NSEvent? input(NSEvent event) {
		if (self.nativeInputAllowed()) { self.settleNative(); }
		var slider = self._slider;
		if (self._closing || slider == null || !self.stateNode().effectiveEligible()) { return event; }
		NSView view = slider; var window = view.window();
		if (window == null || event.window() != window) { return event; }
		var type = event.type();
		if (type == NSEventTypeKeyDown) {
			NSResponder responder = slider;
			if (window.firstResponder() != responder && !self._interaction.active()) { return event; }
			var key = event.keyCode();
			if (key == kVK_Escape && self._interaction.active()) {
				var context = self.stateNode().context();
				if (context != null && !context.nativeFailed()) {
					if (context.treeMutationActive()) { self.deferTerminal(false, 0.0, CONTROL_ORIGIN_USER, CONTROL_CANCEL_ESCAPE); }
					else { self.cancelTracking(CONTROL_ORIGIN_USER, CONTROL_CANCEL_ESCAPE); }
				} return null;
			}
			UIRangeAdjustment adjustment = UI_RANGE_ADJUST_NONE;
			if (key == kVK_LeftArrow || key == kVK_DownArrow) { adjustment = UI_RANGE_ADJUST_SMALL_DECREMENT; }
			else if (key == kVK_RightArrow || key == kVK_UpArrow) { adjustment = UI_RANGE_ADJUST_SMALL_INCREMENT; }
			else if (key == kVK_PageUp) { adjustment = UI_RANGE_ADJUST_LARGE_INCREMENT; }
			else if (key == kVK_PageDown) { adjustment = UI_RANGE_ADJUST_LARGE_DECREMENT; }
			else if (key == kVK_Home) { adjustment = UI_RANGE_ADJUST_MINIMUM; }
			else if (key == kVK_End) { adjustment = UI_RANGE_ADJUST_MAXIMUM; }
			if (adjustment != UI_RANGE_ADJUST_NONE) {
				if (!self.nativeInputAllowed() || self._interaction.inert()) { return null; }
				self.reserveSettlement(); if (!self._interaction.adjust(self.stateNode().generation(), adjustment, 1)) { throw "Native slider capture capacity exceeded"; } self.project(); return null;
			}
			return event;
		}
		if (type == NSEventTypeLeftMouseDown) {
			var content = window.contentView(); if (content == null) { return event; }
			var hit = content.hitTest(content.convertPoint(event.locationInWindow(), null));
			if (hit != view && (hit == null || !hit.isDescendantOf(view))) { return event; }
			if (!self.nativeInputAllowed() || self._interaction.active() || self._interaction.inert()) { return null; }
			self.reserveSettlement();
			if (self._trackingSerial == 9223372036854775807LL) { throw "Slider tracking identities exhausted"; }
			if (!self._interaction.begin(self.stateNode().generation())) { throw "Native slider capture capacity exceeded"; }
			self._trackingSerial++; self._trackingWindow = window; window.makeFirstResponder(slider);
			if (!self._interaction.preview(self.valueAt(event))) { throw "Native slider preview capacity exceeded"; } self.project();
			return null;
		}
		if (type == NSEventTypeLeftMouseDragged && self._interaction.active()) { if (self.nativeInputAllowed()) { if (!self._interaction.preview(self.valueAt(event))) { throw "Native slider preview capacity exceeded"; } self.project(); } return null; }
		if (type == NSEventTypeLeftMouseUp && self._interaction.active()) {
			var context = self.stateNode().context();
			if (context != null && !context.nativeFailed()) {
				double value = self.valueAt(event);
				if (context.treeMutationActive()) { self.deferTerminal(true, value, CONTROL_ORIGIN_USER, CONTROL_CANCEL_NONE); }
				else { self._interaction.commitValue(value); self.project(); }
			} return null;
		}
		return event;
	}

	public void setEnabled(bool enabled) {
		var state = self._view.stateNode(); state.requireMutation(); var control = self.control(); bool previous = control.isEnabled();
		state.setEnabled(enabled); try { control.setEnabled(enabled); } catch (string error) { state.setEnabled(previous); throw error; }
	}

	public bool isEnabled() { return self.control().isEnabled(); }

	public void setToolTip(string text) { NSView view = self.control(); view.setToolTip(AppKitText.nativeValue(text)); }

	public string toolTip() {
		NSView view = self.control();
		NSString? text = view.toolTip();
		return text == null ? "" : AppKitText.ownedValue(text);
	}

	public CallbackCancellation close() {
		self._view.requireDetached();
		if (!self._closing) {
			self._closing = true;
			try { self.cancelTracking(CONTROL_ORIGIN_SYSTEM, CONTROL_CANCEL_SOURCE_CLOSING); }
			catch (string error) { var context = self.stateNode().context(); if (context != null) { context.recordNativeFailure(error); } }
			self._native.cancel(); self._view.close();
		}
		return self.pollClose();
	}
}
