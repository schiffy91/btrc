import Library.GUI.MacOS.MacOSViewState;
import Library.GUI.ControlEventQueue;
import Library.Math;
import Library.Vector;
import Library.Callback;
import Library.Console;
import Library.GUI.IWindow;
import Library.GUI.IView;
import Library.GUI.MacOS.AppKitText;
import Library.GUI.MacOS.AppKitEvents;
import Library.GUI.MacOS.MacOSView;
import Library.GUI.MacOS.MacOSRunLoop;

/* Native dispatch records state only. It must not retain the window owner or
 * destroy the view tree while AppKit is still closing the native window. */
class MacOSWindowEvents implements IAppKitWindowEvents {
	public bool closed = false;
	public bool closeRequested = false;
	public bool interceptClose = false;
	private MacOSRunLoopSignal? _signal;
	private MacOSViewContext? _context;
	private string _failure = "";
	public MacOSWindowEvents(MacOSRunLoopSignal? signal, MacOSViewContext? context) { self._signal = signal; self._context = context; }

	public void check() {
		if (self._failure != "") { throw self._failure; }
		if (self._context != null) { self._context.checkNativeFailure(); }
	}

	public void recordFailure(string error) {
		if (self._failure == "") { self._failure = error; }
		if (self._context != null) { self._context.recordNativeFailure(self._failure); }
		else if (self._signal != null) { try { self._signal.wake(); } catch (string ignored) {} }
	}

	public void wake() {
		if (self._context != null) { if (!self._context.wake.requestTurn()) { throw "Window semantic wake failed"; } }
		else if (self._signal != null) { self._signal.wake(); }
	}

	private void captured() {
		try { self.wake(); }
		catch (string error) { self.recordFailure(error); }
	}

	public bool windowShouldClose(NSWindow sender) {
		if (!self.interceptClose && (self._context == null || !self._context.nativeQuitPending())) { return true; }
		self.closeRequested = true; self.captured(); return false;
	}

	public void windowWillClose(NSNotification notification) { self.closed = true; self.captured(); }

	public void windowDidResize(NSNotification notification) { self.captured(); }

	public void windowDidBecomeKey(NSNotification notification) { self.captured(); }

	public void windowDidResignKey(NSNotification notification) { self.captured(); }

	public void windowDidMiniaturize(NSNotification notification) { self.captured(); }

	public void windowDidDeminiaturize(NSNotification notification) { self.captured(); }

	public void windowDidChangeBackingProperties(NSNotification notification) { self.captured(); }

	public void windowDidChangeOcclusionState(NSNotification notification) { self.captured(); }

	public void windowDidChangeScreen(NSNotification notification) { self.captured(); }
}

class MacOSWindowKeys implements IAppKitEventMonitor {
	private NSWindow _window;
	private IWindowKeyHandler _handler;
	private MacOSWindowEvents _events;

	public MacOSWindowKeys(NSWindow window, IWindowKeyHandler handler, MacOSWindowEvents events) { self._window = window; self._handler = handler; self._events = events; }

	private AppKeyCode keyCode(unsigned short code) {
		if (code == kVK_Space) { return APP_KEY_SPACE; }
		if (code == kVK_Escape) { return APP_KEY_ESCAPE; }
		if (code == kVK_Return) { return APP_KEY_ENTER; }
		if (code == kVK_LeftArrow) { return APP_KEY_LEFT; }
		if (code == kVK_RightArrow) { return APP_KEY_RIGHT; }
		if (code == kVK_UpArrow) { return APP_KEY_UP; }
		if (code == kVK_DownArrow) { return APP_KEY_DOWN; }
		if (code == kVK_Tab) { return APP_KEY_TAB; }
		if (code == kVK_Delete) { return APP_KEY_BACKSPACE; }
		if (code == kVK_ForwardDelete) { return APP_KEY_DELETE; }
		if (code == kVK_Home) { return APP_KEY_HOME; }
		if (code == kVK_End) { return APP_KEY_END; }
		if (code == kVK_ANSI_A) { return APP_KEY_A; }
		if (code == kVK_ANSI_D) { return APP_KEY_D; }
		if (code == kVK_ANSI_S) { return APP_KEY_S; }
		if (code == kVK_ANSI_W) { return APP_KEY_W; }
		if (code == kVK_ANSI_C) { return APP_KEY_C; }
		if (code == kVK_ANSI_V) { return APP_KEY_V; }
		if (code == kVK_ANSI_X) { return APP_KEY_X; }
		if (code == kVK_ANSI_Z) { return APP_KEY_Z; }
		if (code == kVK_ANSI_Q) { return APP_KEY_Q; }
		if (code == kVK_ANSI_LeftBracket) { return APP_KEY_LEFT_BRACKET; }
		if (code == kVK_ANSI_RightBracket) { return APP_KEY_RIGHT_BRACKET; }
		if (code == kVK_Option) { return APP_KEY_LEFT_ALT; }
		if (code == kVK_RightOption) { return APP_KEY_RIGHT_ALT; }
		if (code == kVK_Shift) { return APP_KEY_LEFT_SHIFT; }
		if (code == kVK_RightShift) { return APP_KEY_RIGHT_SHIFT; }
		return APP_KEY_UNKNOWN;
	}

	public NSEvent? invoke(NSEvent native) {
		if (native.window() != self._window) { return native; }
		NSEvent? result = null;
		try { self._events.check(); result = self.dispatchNative(native); }
		catch (string error) { self._events.recordFailure(error); }
		return result;
	}

	private NSEvent? dispatchNative(NSEvent native) {
		var key = self.keyCode(native.keyCode());
		if (key == APP_KEY_UNKNOWN) { return native; }
		var type = native.type();
		var flags = native.modifierFlags();
		bool down = type == NSEventTypeKeyDown;
		if (type == NSEventTypeFlagsChanged) {
			unsigned long mask = 0UL;
			if (key == APP_KEY_LEFT_ALT) { mask = (unsigned long)NX_DEVICELALTKEYMASK; }
			else if (key == APP_KEY_RIGHT_ALT) { mask = (unsigned long)NX_DEVICERALTKEYMASK; }
			else if (key == APP_KEY_LEFT_SHIFT) { mask = (unsigned long)NX_DEVICELSHIFTKEYMASK; }
			else if (key == APP_KEY_RIGHT_SHIFT) { mask = (unsigned long)NX_DEVICERSHIFTKEYMASK; }
			else { return native; }
			down = (flags & mask) != 0UL;
		}
		AppKeyAction action = down ? APP_KEY_PRESSED : APP_KEY_RELEASED;
		if (type == NSEventTypeKeyDown && native.isARepeat()) { action = APP_KEY_REPEATED; }
		var modifiers = AppKeyModifiers((flags & NSEventModifierFlagShift) != 0UL, (flags & NSEventModifierFlagControl) != 0UL, (flags & NSEventModifierFlagOption) != 0UL, (flags & NSEventModifierFlagCommand) != 0UL);
		return self._handler.key(AppKeyboardEvent(action, key, modifiers)) ? null : native;
	}
}

/* Main-thread native window owner. attachRoot is the only mounting path: the
 * attached root transfers its subtree's lifecycle to the window. */
class MacOSWindow implements IWindow, IControlEventTarget, IMacOSNativeSettlement {
	private MacOSViewContext? _viewContext;
	private ControlEventQueue? _semantic;
	private bool _rootStateAttached = false;
	private ApplicationActivity _activity = APPLICATION_ACTIVITY_UNKNOWN;
	private NSWindow? _window;
	private IView? _root;
	private unsigned long _rootMask = 0UL;
	private bool _closing = false;
	private bool _mutating = false;
	private bool _rootClosing = false;
	private string _closeFailure = "";
	private MacOSWindowEvents _events;
	private CallbackScope _callbacks;
	private bool _requestedVisible = false;
	private WindowState? _state;
	private WindowState? _pendingState;
	private ControlEventChannel<IWindowStateHandler, WindowState>? _stateChannel;
	private MacOSNativeSettlementRegistration? _stateSettlement;
	private ControlEventChannel<MacOSWindowCloseReceiver, IWindowCloseTransaction>? _closeChannel;
	private MacOSWindowCloseRegistration? _closeRegistration;
	private MacOSWindowCloseTransaction? _transaction;
	private long long _nextCloseInteraction = 1LL;
	private long long _nextSaveAttempt = 1LL;
	private long long _closeHandlerGeneration = 0LL;
	private bool _quitHeld = false;
	private bool _quitHoldCancelled = false;

	public MacOSWindow(string title, double width, double height, MacOSRunLoopSignal? signal = null, MacOSViewContext? context = null) {
		self._window = null;
		self.requireMainThread();
		self.requireSize(width, height);
		self._viewContext = context; if (context != null) { self._semantic = context.createQueue(); }
		self._events = MacOSWindowEvents(signal, context);
		self._callbacks = CallbackScope();
		var nativeTitle = AppKitText.nativeValue(title);
		var window = NSWindow.new();
		if (window == null) { throw "Cannot create native window"; }
		window.setReleasedWhenClosed(false);
		self._window = window;
		try {
			window.setStyleMask(NSWindowStyleMaskTitled | NSWindowStyleMaskClosable | NSWindowStyleMaskMiniaturizable | NSWindowStyleMaskResizable);
			window.setTitle(nativeTitle);
			self.setContentSize(width, height);
			window.setDelegate(self._events, self._callbacks);
			self.refreshWindowState();
		} catch (string error) {
			self.close();
			throw error;
		}
	}

	private void requireMainThread() {
		if (!NSThread.isMainThread()) { throw "AppKit windows require the main thread"; }
	}

	private void requireSize(double width, double height) {
		if (!Math.isFinite(width) || !Math.isFinite(height) || width <= 0.0 || height <= 0.0) { throw "Invalid window content size"; }
	}

	public NSWindow nativeWindow() {
		self.requireMainThread();
		if (self._window == null) { throw "Window is closed"; }
		if (self._closing || self._events.closed) { throw "Window shutdown has started"; }
		return self._window;
	}

	private NSWindow mutationWindow() {
		var window = self.nativeWindow();
		if (self._mutating) { throw "Window root mutation is already active"; }
		return window;
	}

	private IMacOSView projection(IView view) {
		if (view == null) { throw "Cannot attach a missing root"; }
		IMacOSView? native = (IMacOSView?)view;
		if (native == null) { throw "Root has no macOS implementation"; }
		return native;
	}

	private MacOSViewContext semanticContext() { var context = self._viewContext; if (context == null) { throw "Window observation requires an application context"; } return context; }

	public ControlEventDisposition admission(long long generation) { return self.isOpen() ? CONTROL_EVENT_DELIVERED : CONTROL_EVENT_CLOSED; }

	class WindowState copyState(WindowState current) {
		var state = WindowState(); state.width = current.width; state.height = current.height; state.backingScale = current.backingScale;
		state.requestedVisible = current.requestedVisible; state.nativeVisible = current.nativeVisible; state.minimized = current.minimized;
		state.windowActive = current.windowActive; state.applicationActivity = current.applicationActivity; state.exposure = current.exposure;
		state.notExposedReason = current.notExposedReason; state.presentable = current.presentable; state.stateRevision = current.stateRevision; return state;
	}

	class void deliverState(IWindowStateHandler receiver, WindowState state) { receiver.stateChanged(MacOSWindow.copyState(state)); }

	private void refreshWindowState() {
		self.requireMainThread();
		if (self._viewContext != null && self._viewContext.treeMutationActive()) { return; }
		var old = self._state; var next = WindowState(); var window = self._window;
		next.width = old == null ? 0.0 : old.width; next.height = old == null ? 0.0 : old.height;
		next.backingScale = old == null ? 1.0 : old.backingScale;
		if (window != null) {
			var content = window.contentView(); if (content != null) { var bounds = content.bounds(); next.width = bounds.size.width; next.height = bounds.size.height; }
			next.backingScale = window.backingScaleFactor();
		}
		next.requestedVisible = self._requestedVisible;
		next.nativeVisible = self.isOpen() && window != null && window.isVisible();
		next.minimized = window != null && window.isMiniaturized();
		next.windowActive = self.isOpen() && window != null && window.isKeyWindow(); next.applicationActivity = self._activity;
		next.exposure = WINDOW_EXPOSURE_UNKNOWN; next.notExposedReason = WINDOW_EXPOSURE_REASON_NONE;
		if (next.minimized) { next.exposure = WINDOW_EXPOSURE_NOT_EXPOSED; next.notExposedReason = WINDOW_EXPOSURE_REASON_MINIMIZED; }
		else if (!next.nativeVisible) { next.exposure = WINDOW_EXPOSURE_NOT_EXPOSED; next.notExposedReason = WINDOW_EXPOSURE_REASON_HIDDEN; }
		else if (window != null) {
			if ((window.occlusionState() & NSWindowOcclusionStateVisible) != 0UL) { next.exposure = WINDOW_EXPOSURE_EXPOSED; }
			else { next.exposure = WINDOW_EXPOSURE_NOT_EXPOSED; next.notExposedReason = WINDOW_EXPOSURE_REASON_OCCLUDED; }
		}
		next.presentable = self.isOpen() && next.nativeVisible && !next.minimized && next.exposure != WINDOW_EXPOSURE_NOT_EXPOSED && self._activity != APPLICATION_ACTIVITY_SUSPENDED && next.width > 0.0 && next.height > 0.0 && next.backingScale > 0.0;
		if (old != null && old.width == next.width && old.height == next.height && old.backingScale == next.backingScale && old.requestedVisible == next.requestedVisible && old.nativeVisible == next.nativeVisible && old.minimized == next.minimized && old.windowActive == next.windowActive && old.applicationActivity == next.applicationActivity && old.exposure == next.exposure && old.notExposedReason == next.notExposedReason && old.presentable == next.presentable) { return; }
		if (old != null && old.stateRevision == 9223372036854775807LL) { throw "Window state revisions exhausted"; }
		next.stateRevision = old == null ? 1LL : old.stateRevision + 1LL; self._state = next; self._pendingState = next; self.publishState();
	}

	private void publishState() {
		var channel = self._stateChannel; var state = self._pendingState;
		if (state == null) { return; }
		if (channel == null || !channel.isOpen() || !self.isOpen()) { self._pendingState = null; return; }
		var context = self.semanticContext(); context.checkNativeFailure(); var queue = self._semantic;
		if (queue == null || !queue.canCapture(0)) { throw "Window state semantic source is unavailable"; }
		if (channel.publish(state, 1LL, 0LL, 1LL)) { self._pendingState = null; }
		else { if (self._stateSettlement == null) { throw "Window state settlement is unavailable"; } self._stateSettlement.request(); }
	}

	public void settleNative() { self.publishState(); }

	public WindowState state() { self.refreshWindowState(); var state = self._state; if (state == null) { throw "Window state unavailable"; } return MacOSWindow.copyState(state); }

	public ICallbackRegistration onStateChanged(IWindowStateHandler receiver, CallbackScope owner) {
		self.nativeWindow(); var context = self.semanticContext(); context.requireMutationAllowed();
		if (self._stateChannel != null && self._stateChannel.pollCompletion() != CALLBACK_CANCELLATION_COMPLETE) { throw "Cancel the existing window state handler first"; }
		self.refreshWindowState(); self._pendingState = null;
		if (self._stateSettlement == null) { self._stateSettlement = context.registerNativeSettlement(self, self._callbacks); }
		var channel = new ControlEventChannel<IWindowStateHandler, WindowState>(self._semantic, self, receiver, MacOSWindow.deliverState, owner);
		try {
			self._callbacks.track(channel); self._stateChannel = channel;
		} catch (string error) { channel.cancel(); throw error; }
		return channel;
	}

	public ICallbackRegistration onCloseRequested(IWindowCloseRequestHandler handler, CallbackScope owner) {
		if (handler == null || owner == null) { throw "Window close handler and owner are required"; }
		self.nativeWindow(); var context = self.semanticContext(); context.requireMutationAllowed();
		var previous = self._closeRegistration;
		if (previous != null && previous.pollCompletion() != CALLBACK_CANCELLATION_COMPLETE) { throw "Cancel and drain the existing close handler first"; }
		if (self._closeHandlerGeneration == 9223372036854775807LL) { throw "Window close handler generations exhausted"; }
		var receiver = MacOSWindowCloseReceiver(self, handler);
		var channel = new ControlEventChannel<MacOSWindowCloseReceiver, IWindowCloseTransaction>(self._semantic, self, receiver, MacOSWindowCloseReceiver.deliver, self._callbacks);
		var registration = MacOSWindowCloseRegistration(self, channel);
		try { owner.track(registration); self._callbacks.track(registration); }
		catch (string error) { registration.cancel(); throw error; }
		self._closeChannel = channel; self._closeRegistration = registration; self._closeHandlerGeneration++; self._events.interceptClose = true;
		return registration;
	}

	public WindowCloseRequestOutcome requestClose(WindowCloseReason reason) { return self.beginClose(reason, false); }

	public WindowCloseRequestOutcome requestCoordinatedClose() {
		self.nativeWindow(); self._quitHeld = true; self._events.interceptClose = true;
		WindowCloseRequestOutcome result;
		try { result = self.beginClose(WINDOW_CLOSE_APPLICATION_QUIT, true); }
		catch (string error) { self.releaseQuitHold(); throw error; }
		return result;
	}

	private WindowCloseRequestOutcome beginClose(WindowCloseReason reason, bool coordinated) {
		self.requireMainThread(); if (self._viewContext != null) { self._viewContext.requireMutationAllowed(); }
		if (reason != WINDOW_CLOSE_NATIVE_REQUEST && reason != WINDOW_CLOSE_APPLICATION_QUIT && reason != WINDOW_CLOSE_PROGRAM_REQUEST) { throw "Invalid window close reason"; }
		var result = WindowCloseRequestOutcome();
		if (self._window == null) { result.kind = WINDOW_CLOSE_REQUEST_CLOSED; return result; }
		if (self._closing || self._events.closed) { result.kind = WINDOW_CLOSE_REQUEST_CLOSING; return result; }
		var pending = self._transaction;
		if (pending != null && pending.pending()) { if (coordinated) { pending.holdForQuit(); } result.kind = WINDOW_CLOSE_REQUEST_ALREADY_PENDING; result.transaction = pending; return result; }
		var channel = self._closeChannel; var registration = self._closeRegistration;
		if (registration == null || !registration.isOpen() || channel == null || !channel.isOpen()) { result.kind = WINDOW_CLOSE_REQUEST_AUTHORIZED_NO_HANDLER; if (!self._quitHeld && (self._viewContext == null || !self._viewContext.nativeQuitPending())) { self.close(); } return result; }
		if (self._nextCloseInteraction == 9223372036854775807LL) { throw "Window close interaction identities exhausted"; }
		var ticket = channel.beginInteraction(); if (ticket == null) { throw "Window close handler is no longer live"; }
		var transaction = MacOSWindowCloseTransaction(self, self.semanticContext(), coordinated || self._quitHeld); long long interaction = self._nextCloseInteraction++;
		try { channel.publishTerminal(transaction, 1LL, interaction, ticket); }
		catch (string error) { ticket.retire(); transaction.resolve(WINDOW_CLOSE_CANCELLED); throw error; }
		self._transaction = transaction; result.kind = WINDOW_CLOSE_REQUEST_PENDING; result.transaction = transaction; return result;
	}

	public bool currentCloseRequest(IWindowCloseTransaction transaction) {
		self.requireMainThread(); IWindowCloseTransaction? current = self._transaction;
		return self.isOpen() && current == transaction && self._transaction != null && self._transaction.pending();
	}

	public bool isPendingClose(MacOSWindowCloseTransaction transaction) { self.requireMainThread(); return self._transaction == transaction && self.isOpen(); }

	public long long nextCloseSaveAttempt() { self.requireMainThread(); if (self._nextSaveAttempt == 9223372036854775807LL) { throw "Window save attempts exhausted"; } return self._nextSaveAttempt++; }

	public void retireCloseTransaction(MacOSWindowCloseTransaction transaction) {
		self.requireMainThread(); if (self._transaction == transaction) { if (self._quitHeld) { self._quitHoldCancelled = true; } self._transaction = null; } self.wakeCloseCoordinator();
	}

	public void wakeCloseCoordinator() { self.requireMainThread(); self._events.wake(); }

	public void consumeCloseAuthorization(MacOSWindowCloseTransaction transaction) {
		self.requireMainThread(); if (!self.isPendingClose(transaction) || transaction.state() != WINDOW_CLOSE_AUTHORIZED) { throw "Window close authorization is stale"; }
		transaction.resolve(WINDOW_CLOSE_CLOSING); self._transaction = null; self.close();
	}

	public void closeHandlerCancelled(MacOSWindowCloseRegistration registration) {
		self.requireMainThread(); if (self._closeRegistration != registration) { return; }
		if (self._quitHeld) { self._quitHoldCancelled = true; }
		self._events.interceptClose = self._quitHeld; self._events.closeRequested = false;
		var pending = self._transaction;
		if (pending != null) { pending.resolve(self._closing || self._events.closed ? WINDOW_CLOSE_OWNER_LOST : WINDOW_CLOSE_CANCELLED); self._transaction = null; }
		if (self._quitHeld && self.isOpen()) { self._events.wake(); }
	}

	public MacOSWindowCloseTransaction? coordinatedTransaction() { self.requireMainThread(); return self._transaction; }

	public long long closeHandlerGeneration() { self.requireMainThread(); return self._closeHandlerGeneration; }

	public bool hasCloseHandler() { self.requireMainThread(); return self._closeRegistration != null && self._closeRegistration.isOpen() && self._closeChannel != null && self._closeChannel.isOpen(); }

	/* Native quit capture only marks ownership; decision admission is deferred. */
	public void captureQuitHold() {
		self.requireMainThread(); if (!self.isOpen()) { throw "Cannot hold a closing window for native quit"; }
		self._quitHeld = true; self._events.interceptClose = true;
		var transaction = self._transaction; if (transaction != null && transaction.pending()) { transaction.holdForQuit(); }
	}

	public bool quitHoldCancelled() { self.requireMainThread(); return self._quitHoldCancelled; }

	public void releaseQuitHold() { self.requireMainThread(); self._quitHeld = false; self._quitHoldCancelled = false; self._events.interceptClose = self.hasCloseHandler(); self._events.closeRequested = false; }

	public bool validatesCloseAuthorization(MacOSWindowCloseTransaction transaction, long long generation, long long revision) {
		self.requireMainThread(); return self._quitHeld && self.isPendingClose(transaction) && self.hasCloseHandler() && self._closeHandlerGeneration == generation && transaction.coordinatedAuthorization() && transaction.acknowledgedRevision() == revision;
	}

	public void cancelCoordinatedClose(MacOSWindowCloseTransaction? transaction) {
		self.requireMainThread(); if (transaction != null && self._transaction == transaction) { transaction.resolve(WINDOW_CLOSE_CANCELLED); self._transaction = null; } self.releaseQuitHold();
	}

	public void commitCoordinatedClose(MacOSWindowCloseTransaction transaction) {
		self.requireMainThread(); if (!self._quitHeld || !self.isPendingClose(transaction) || !transaction.coordinatedAuthorization()) { throw "Coordinated window close authorization is stale"; }
		transaction.resolve(WINDOW_CLOSE_CLOSING); self._transaction = null; self.releaseQuitHold();
	}

	public void enterCloseDecision() { self.semanticContext().enterCloseDecision(); }

	public void leaveCloseDecision() { self.semanticContext().leaveCloseDecision(); }

	public bool isOpen() { self.requireMainThread(); return self._window != null && !self._closing && !self._events.closed; }

	public void dispatchPendingEvents() {
		self.requireMainThread();
		self._events.check();
		if (self._viewContext != null && self._viewContext.treeMutationActive()) { return; }
		if (self._window != null && self._events.closed) { self.close(); }
		else {
			if (self._events.closeRequested) { self._events.closeRequested = false; self.requestClose(WINDOW_CLOSE_NATIVE_REQUEST); }
			self.refreshViewState();
		}
	}

	public IView? root() { self.requireMainThread(); return self._root; }

	public void attachRoot(IView view) {
		self.mutationWindow();
		if (self._root != null) { throw "Detach the existing window root before replacing it"; }
		var parent = self.contentView();
		self._mutating = true;
		try { self.mountRoot(view, parent); } catch (string error) { self._mutating = false; throw error; }
		self._mutating = false;
	}

	private void mountRoot(IView view, NSView parent) {
		var native = self.projection(view);
		var child = native.nativeView();
		MacOSView.validateAttachment(child, parent);
		var context = self._viewContext; var semantic = self._semantic;
		if (context != null && semantic != null) { native.stateNode().configure(context); native.stateNode().validateWindow(semantic); }
		var previousFrame = child.frame();
		self._rootMask = child.autoresizingMask();
		self._root = view;
		try {
			native.attachTo(parent);
			child.setAutoresizingMask(NSViewWidthSizable | NSViewHeightSizable);
			var bounds = parent.bounds();
			view.arrange(0.0, 0.0, bounds.size.width, bounds.size.height);
			if (semantic != null) { self._rootStateAttached = true; native.stateNode().attachWindow(semantic, self.inputEligible(), self.viewExposure()); }
		} catch (string error) {
			try {
				if (self._rootStateAttached) { native.stateNode().detachWindow(); self._rootStateAttached = false; }
				child.setAutoresizingMask(self._rootMask);
				child.setFrame(previousFrame);
				if (child.superview() == parent) { native.detachFrom(parent); }
				self._root = null;
			} catch (string rollbackError) {
				self._closing = true;
				self._closeFailure = rollbackError;
				throw rollbackError;
			}
			throw error;
		}
	}

	public IView? detachRoot() {
		self.mutationWindow();
		var root = self._root;
		if (root == null) { return null; }
		var parent = self.contentView();
		self._mutating = true;
		try {
			var native = self.projection(root);
			var child = native.nativeView();
			// Keep alias-close admission reserved until native state is restored.
			child.setAutoresizingMask(self._rootMask);
			if (self._rootStateAttached) { native.stateNode().detachWindow(); self._rootStateAttached = false; }
			native.detachFrom(parent);
			self._root = null;
		} catch (string error) {
			self._closing = true;
			self._closeFailure = error;
			self._mutating = false;
			throw error;
		}
		self._mutating = false;
		return root;
	}

	public NSView contentView() {
		var content = self.nativeWindow().contentView();
		if (content == null) { throw "Window has no content view"; }
		return content;
	}

	public void setContentSize(double width, double height) {
		self.requireSize(width, height);
		var window = self.mutationWindow();
		var frame = window.frame();
		frame.size.width = width;
		frame.size.height = height;
		self._mutating = true;
		try { window.setContentSize(frame.size); } catch (string error) { self._mutating = false; throw error; }
		self._mutating = false; self.refreshViewState();
	}

	public double contentWidth() { return self.contentView().bounds().size.width; }

	public double contentHeight() { return self.contentView().bounds().size.height; }

	public string title() { return AppKitText.ownedValue(self.nativeWindow().title()); }

	public void setTitle(string title) { self.nativeWindow().setTitle(AppKitText.nativeValue(title)); }

	public void show() { self.nativeWindow().makeKeyAndOrderFront(null); self._requestedVisible = true; self.refreshViewState(); }

	public void hide() { self.nativeWindow().orderOut(null); self._requestedVisible = false; self.refreshViewState(); }

	private bool inputEligible() { var window = self._window; return window != null && self.isOpen() && window.isVisible() && !window.isMiniaturized() && self._activity != APPLICATION_ACTIVITY_SUSPENDED; }

	private WindowExposure viewExposure() { var state = self._state; return state == null ? WINDOW_EXPOSURE_UNKNOWN : state.exposure; }

	private void refreshViewState() { self.refreshWindowState(); var root = self._root; if (self._rootStateAttached && root != null && root.isOpen()) { self.projection(root).stateNode().windowChanged(self.inputEligible(), self.viewExposure()); } }

	public void applicationActivity(ApplicationActivity activity) { self.requireMainThread(); self._activity = activity; self.refreshViewState(); }

	public bool isVisible() { return self.isOpen() && self.nativeWindow().isVisible(); }

	public bool isFocused() { return self.isOpen() && self.nativeWindow().isKeyWindow(); }

	public ICallbackRegistration onKey(IWindowKeyHandler handler, CallbackScope owner) {
		var receiver = MacOSWindowKeys(self.nativeWindow(), handler, self._events);
		var registration = NSEvent.addLocalMonitorForEventsMatchingMask(NSEventMaskKeyDown | NSEventMaskKeyUp | NSEventMaskFlagsChanged, receiver, self._callbacks);
		try { owner.track(registration); } catch (string error) { registration.cancel(); throw error; }
		return registration;
	}

	public void setMinimumContentSize(double width, double height) {
		self.requireSize(width, height);
		var size = self.contentView().bounds().size;
		size.width = width;
		size.height = height;
		self.nativeWindow().setContentMinSize(size);
	}

	public void showAlert(string title, string message) {
		self.nativeWindow();
		if (self._viewContext != null) { self._viewContext.requireModalAllowed(); }
		var alert = NSAlert.new();
		if (alert == null) { throw "Cannot create native alert"; }
		alert.setMessageText(AppKitText.nativeValue(title));
		alert.setInformativeText(AppKitText.nativeValue(message));
		alert.addButtonWithTitle(AppKitText.nativeValue("OK"));
		alert.runModal();
	}

	public CallbackCancellation close() {
		self.requireMainThread();
		var window = self._window;
		if (window == null) { return CALLBACK_CANCELLATION_COMPLETE; }
		if (self._closeFailure != "") { throw self._closeFailure; }
		if (self._mutating) { throw "Window root mutation is already active"; }
		if (!self._closing) {
			self._closing = true; self._events.interceptClose = false;
			if (self._transaction != null) { self._transaction.resolve(WINDOW_CLOSE_OWNER_LOST); self._transaction = null; }
			self.refreshViewState();
			// Programmatic close may precede native close by an asynchronous
			// subtree drain. Wake its owner even without an NSWindow event.
			self._events.wake();
		}
		return self.pollClose();
	}

	public CallbackCancellation pollClose() {
		self.requireMainThread();
		var window = self._window;
		if (window == null) { return CALLBACK_CANCELLATION_COMPLETE; }
		if (!self._closing) { return CALLBACK_CANCELLATION_NOT_REQUESTED; }
		if (self._closeFailure != "") { throw self._closeFailure; }
		if (self._mutating) { throw "Window root mutation is already active"; }
		self._mutating = true;
		CallbackCancellation result = CALLBACK_CANCELLATION_COMPLETE;
		try {
			result = self._callbacks.cancel();
			if (result != CALLBACK_CANCELLATION_COMPLETE && result != CALLBACK_CANCELLATION_PENDING) { throw "Window callback shutdown failed"; }
			var root = self._root;
			if (result == CALLBACK_CANCELLATION_COMPLETE && root != null) {
				if (!self._rootClosing) {
					// End native editing while controls still belong to this window.
					window.endEditingFor(null);
					var parent = window.contentView();
					if (parent == null) { throw "Window has no content view"; }
					if (self._rootStateAttached) { self.projection(root).stateNode().detachWindow(); self._rootStateAttached = false; }
					self.projection(root).detachFrom(parent);
					self._rootClosing = true;
					result = root.close();
				} else { result = root.pollClose(); }
				if (result == CALLBACK_CANCELLATION_COMPLETE) { self._root = null; }
			}
			if (result == CALLBACK_CANCELLATION_COMPLETE) {
				if (!self._events.closed) { window.close(); }
				self._window = null;
				if (self._viewContext != null && self._semantic != null) { self._viewContext.retireQueue(self._semantic); self._semantic = null; }
			}
		} catch (string error) {
			self._closeFailure = error;
		} finally { self._mutating = false; }
		if (self._closeFailure != "") { throw self._closeFailure; }
		return result;
	}

	public void __del__() { if (self.close() != CALLBACK_CANCELLATION_COMPLETE) { Console.fatal("Native window destroyed before subtree cleanup completed"); } }
}

class MacOSWindowCloseTransaction implements IWindowCloseTransaction {
	private MacOSViewContext _context;
	private MacOSWindow? _owner;
	private WindowCloseState _state = WINDOW_CLOSE_AWAITING_DECISION;
	private long long _revision = 0LL;
	private bool _hasRevision = false;
	private long long _attempt = 0LL;
	private bool _coordinated;

	public MacOSWindowCloseTransaction(MacOSWindow owner, MacOSViewContext context, bool coordinated) {
		context.requireUI(); self._context = context; self._owner = owner; self._coordinated = coordinated;
	}

	private WindowCloseOutcome outcome(WindowCloseOutcomeKind kind) {
		var result = WindowCloseOutcome(); result.kind = kind; result.state = self._state; result.attempt = self._attempt; return result;
	}

	public WindowCloseState state() { self._context.requireUI(); return self._state; }

	public bool pending() { self._context.requireUI(); return self._state == WINDOW_CLOSE_AWAITING_DECISION || self._state == WINDOW_CLOSE_SAVING || self._state == WINDOW_CLOSE_AUTHORIZED; }

	public void holdForQuit() { self._context.requireUI(); if (!self.pending()) { throw "Close transaction is not pending"; } self._coordinated = true; }

	public long long acknowledgedRevision() { self._context.requireUI(); return self._revision; }

	public bool coordinatedAuthorization() { self._context.requireUI(); return self._coordinated && self._state == WINDOW_CLOSE_AUTHORIZED; }

	/* Cancellation seals the existing registration first; already admitted
	 * callbacks may finish, but their later decisions cannot revive this owner. */
	public void resolve(WindowCloseState state) {
		self._context.requireUI();
		if (!self.pending()) { return; }
		if (state != WINDOW_CLOSE_CANCELLED && state != WINDOW_CLOSE_OWNER_LOST && state != WINDOW_CLOSE_CLOSING) { throw "Invalid close transaction retirement"; }
		self._state = state; self._attempt = 0LL; self._owner = null;
	}

	private WindowCloseOutcome authorize(MacOSWindow owner) {
		self._state = WINDOW_CLOSE_AUTHORIZED; self._attempt = 0LL;
		if (!self._coordinated) { owner.consumeCloseAuthorization(self); } else { owner.wakeCloseCoordinator(); }
		return self.outcome(WINDOW_CLOSE_OUTCOME_APPLIED);
	}

	public WindowCloseOutcome decide(WindowCloseDecision decision, long long documentRevision) {
		self._context.requireUI();
		var owner = self._owner;
		if (owner == null || !self.pending() || !owner.isPendingClose(self)) { return self.outcome(WINDOW_CLOSE_OUTCOME_NOT_PENDING); }
		if (self._hasRevision && documentRevision < self._revision) { return self.outcome(WINDOW_CLOSE_OUTCOME_STALE_REVISION); }
		if (decision != WINDOW_CLOSE_DECISION_SAVE && decision != WINDOW_CLOSE_DECISION_DISCARD && decision != WINDOW_CLOSE_DECISION_CANCEL) { throw "Invalid close decision"; }
		// Held permission can be replaced only by a fresh explicit owner decision.
		if (self._state == WINDOW_CLOSE_AUTHORIZED && !self._coordinated) { throw "Close authorization is already consumed"; }
		if (decision == WINDOW_CLOSE_DECISION_CANCEL) {
			self._revision = documentRevision; self._hasRevision = true; self.resolve(WINDOW_CLOSE_CANCELLED); owner.retireCloseTransaction(self);
			return self.outcome(WINDOW_CLOSE_OUTCOME_APPLIED);
		}
		if (self._state == WINDOW_CLOSE_SAVING) {
			if (decision != WINDOW_CLOSE_DECISION_SAVE || documentRevision <= self._revision) { throw "Only a newer document revision may update an active save"; }
			self._revision = documentRevision; self._hasRevision = true; return self.outcome(WINDOW_CLOSE_OUTCOME_APPLIED);
		}
		if (decision == WINDOW_CLOSE_DECISION_DISCARD) { self._revision = documentRevision; self._hasRevision = true; return self.authorize(owner); }
		/* Exhaustion fails before changing the transaction's revision/state. */
		long long attempt = owner.nextCloseSaveAttempt();
		self._revision = documentRevision; self._hasRevision = true; self._attempt = attempt; self._state = WINDOW_CLOSE_SAVING; if (self._coordinated) { owner.wakeCloseCoordinator(); }
		return self.outcome(WINDOW_CLOSE_OUTCOME_APPLIED);
	}

	public WindowCloseOutcome completeSave(long long attempt, long long savedRevision, bool succeeded, string error) {
		self._context.requireUI();
		var owner = self._owner;
		if (owner == null || !self.pending() || !owner.isPendingClose(self)) { return self.outcome(WINDOW_CLOSE_OUTCOME_NOT_PENDING); }
		if (attempt <= 0LL || attempt != self._attempt) { return self.outcome(WINDOW_CLOSE_OUTCOME_STALE_ATTEMPT); }
		if (self._state != WINDOW_CLOSE_SAVING) { throw "No matching save is active"; }
		if (!succeeded) { self._state = WINDOW_CLOSE_AWAITING_DECISION; self._attempt = 0LL; return self.outcome(WINDOW_CLOSE_OUTCOME_APPLIED); }
		if (!self._hasRevision || savedRevision > self._revision) { throw "Save completion revision was not acknowledged"; }
		if (savedRevision < self._revision) { self._state = WINDOW_CLOSE_AWAITING_DECISION; self._attempt = 0LL; return self.outcome(WINDOW_CLOSE_OUTCOME_STALE_REVISION); }
		return self.authorize(owner);
	}
}

/* This adaptor does not own a second callback gate. The semantic channel owns
 * receiver entry and drain; cancellation additionally resolves the Window's
 * pending transaction, including cancellation through either owning scope. */
class MacOSWindowCloseRegistration implements ICallbackRegistration {
	private MacOSWindow? _owner;
	private ICallbackRegistration _channel;
	public MacOSWindowCloseRegistration(MacOSWindow owner, ICallbackRegistration channel) { self._owner = owner; self._channel = channel; }

	public bool isOpen() { return self._channel.isOpen(); }

	public CallbackCancellation cancel() {
		var owner = self._owner;
		var result = self._channel.cancel();
		if (owner != null) { owner.closeHandlerCancelled(self); }
		if (result == CALLBACK_CANCELLATION_COMPLETE) { self._owner = null; }
		return result;
	}

	public CallbackCancellation pollCompletion() {
		var result = self._channel.pollCompletion();
		if (result == CALLBACK_CANCELLATION_COMPLETE) { self._owner = null; }
		return result;
	}
}

class MacOSWindowCloseReceiver {
	private MacOSWindow _owner;
	private IWindowCloseRequestHandler _handler;
	public MacOSWindowCloseReceiver(MacOSWindow owner, IWindowCloseRequestHandler handler) { self._owner = owner; self._handler = handler; }

	class void deliver(MacOSWindowCloseReceiver receiver, IWindowCloseTransaction transaction) {
		if (!receiver._owner.currentCloseRequest(transaction)) { return; }
		receiver._owner.enterCloseDecision();
		try { receiver._handler.closeRequested(transaction); }
		finally { receiver._owner.leaveCloseDecision(); }
	}
}

/* A group keeps no-handler windows open too. Membership or handler changes
 * cancel the group; a fresh native request obtains fresh consent. Document
 * owners publish edits on the UI executor before treating them as committed.
 * A held authorization can be updated by an explicit new SAVE/DISCARD, or
 * cancelled when the newer revision has no decision yet. */
class MacOSWindowQuitMember {
	public MacOSWindow window;
	public MacOSWindowCloseTransaction? transaction;
	public long long handlerGeneration;
	public bool hasHandler;
	public long long revision = 0LL;
	public MacOSWindowQuitMember(MacOSWindow window) {
		self.window = window; self.handlerGeneration = window.closeHandlerGeneration();
		self.hasHandler = window.hasCloseHandler(); self.transaction = window.coordinatedTransaction();
	}
}

class MacOSWindowQuitCoordinator {
	private Vector<MacOSWindow> _windows;
	private Vector<MacOSWindowQuitMember> _members = [];
	private MacOSViewContext _context;
	private bool _cancelled = false;
	private bool _committed = false;
	public MacOSWindowQuitCoordinator(Vector<MacOSWindow> windows, MacOSViewContext context) {
		context.requireUI(); self._windows = windows; self._context = context; context.setNativeQuitPending(true);
		try {
			for window in windows {
				if (window.isOpen()) {
					// Retain the captured identity before changing its private hold.
					self._members.push(MacOSWindowQuitMember(window)); window.captureQuitHold();
				}
			}
		} catch (string error) { self.cancel(); throw error; }
	}

	public bool cancelled() { self._context.requireUI(); return self._cancelled; }

	public void cancel() {
		self._context.requireUI(); if (self._cancelled || self._committed) { return; }
		self._cancelled = true;
		for member in self._members { member.window.cancelCoordinatedClose(member.window.coordinatedTransaction()); }
		self._context.setNativeQuitPending(false);
	}

	public bool advance() {
		self._context.requireUI(); if (self._cancelled || self._committed) { return false; }
		int open = 0;
		for window in self._windows {
			if (window.isOpen()) { open++; bool found = false; for member in self._members { if (member.window == window) { found = true; } } if (!found) { self.cancel(); return false; } }
		}
		if (open != self._members.len) { self.cancel(); return false; }
		// Validate every captured member before publishing any new decision.
		for member in self._members {
			if (!member.window.isOpen() || member.window.closeHandlerGeneration() != member.handlerGeneration || member.window.hasCloseHandler() != member.hasHandler || member.window.quitHoldCancelled()) { self.cancel(); return false; }
			var current = member.window.coordinatedTransaction();
			if ((member.transaction != null && member.transaction != current) || (current != null && !current.pending())) { self.cancel(); return false; }
			if (member.transaction == null) { member.transaction = current; }
		}
		try {
			for member in self._members {
				if (member.hasHandler && member.transaction == null) {
					var request = member.window.requestCoordinatedClose();
					if (request.kind != WINDOW_CLOSE_REQUEST_PENDING && request.kind != WINDOW_CLOSE_REQUEST_ALREADY_PENDING) { throw "Native quit decision admission changed after capture"; }
					member.transaction = member.window.coordinatedTransaction();
					if (member.transaction == null) { throw "Native quit transaction is unavailable"; }
				}
			}
		} catch (string error) { self.cancel(); throw error; }
		bool ready = true;
		for member in self._members {
			var transaction = member.transaction;
			if (transaction != null) {
				if (transaction.state() != WINDOW_CLOSE_AUTHORIZED) { ready = false; }
				member.revision = transaction.acknowledgedRevision();
			}
		}
		if (!ready) { return false; }
		for member in self._members { var transaction = member.transaction; if (transaction != null && !member.window.validatesCloseAuthorization(transaction, member.handlerGeneration, member.revision)) { self.cancel(); return false; } }
		return true;
	}

	/* This final validation and the caller's requestQuit run in one UI turn,
	 * with no application callback between authorization and consumption. */
	public void commit() {
		self._context.requireUI(); if (!self.advance()) { throw "Native quit group is not authorized"; }
		for member in self._members { var transaction = member.transaction; if (transaction != null) { member.window.commitCoordinatedClose(transaction); } else { member.window.releaseQuitHold(); } }
		self._committed = true; self._context.setNativeQuitPending(false);
	}
}
