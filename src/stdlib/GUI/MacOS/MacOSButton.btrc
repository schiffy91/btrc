import Library.Math;
import Library.Callback;
import Library.GUI.IButton;
import Library.GUI.MacOS.AppKitText;
import Library.GUI.MacOS.MacOSView;
import Library.GUI.MacOS.MacOSActionQueue;

class MacOSButton implements IButton, IMacOSView {
	private NSButton? _button;
	private MacOSView _view;
	private MacOSActionQueue? _actions;
	private IMacOSAction? _action;
	private bool _selectable = false;
	private bool _bordered = true;
	private bool _symbol = false;
	private double _fontSize = 13.0;

	public MacOSButton(string title, MacOSActionQueue? actions = null) {
		if (!NSThread.isMainThread()) { throw "Native buttons require the main thread"; }
		var button = NSButton.new();
		if (button == null) { throw "Cannot create native button"; }
		self._button = button;
		self._view = MacOSView(button);
		self._actions = actions;
		button.setTitle(AppKitText.nativeValue(title));
		button.setButtonType(NSButtonTypeMomentaryPushIn);
		button.setBezelStyle(NSBezelStyleRounded);
		button.setContinuous(false);
		if (actions != null) { self._action = actions.bind(button); }
	}

	private NSButton control() {
		self._view.nativeView();
		if (self._button == null) { throw "Native button is closed"; }
		return self._button;
	}

	public NSView nativeView() { return self._view.nativeView(); }

	public void attachTo(NSView parent) { self._view.attachTo(parent); }

	public void detachFrom(NSView parent) { self._view.detachFrom(parent); }

	public bool isOpen() { return self._view.isOpen(); }

	public double fittingWidth() { return self._view.fittingWidth(); }

	public double fittingHeight() { return self._view.fittingHeight(); }

	public void arrange(double x, double y, double width, double height) { self._view.arrange(x, y, width, height); }

	public bool isVisible() { return self._view.isVisible(); }

	public ICallbackRegistration onPointer(IViewPointerHandler handler, CallbackScope owner) { return self._view.onPointer(handler, owner); }

	public ICallbackRegistration onScroll(IViewScrollHandler handler, CallbackScope owner) { return self._view.onScroll(handler, owner); }

	public void cancelPointerCapture() { self._view.cancelPointerCapture(); }

	public void setVisible(bool visible) { self._view.setVisible(visible); }

	public string title() { return AppKitText.ownedValue(self.control().title()); }

	public void setFrame(double x, double y, double width, double height) { self._view.setFrame(x, y, width, height); }

	public void setTitle(string title) { self.control().setTitle(AppKitText.nativeValue(title)); self.placeSymbol(); }

	public void setEnabled(bool enabled) { self.control().setEnabled(enabled); }

	/* AppKit still tracks and dispatches a transparent button. Its parent owns
	 * custom content, such as an artwork card, rather than a second painted bezel. */
	public void setTransparent(bool transparent) { self.control().setTransparent(transparent); }

	public void setBordered(bool bordered) {
		var button = self.control();
		if (bordered && self._fontSize > 20.0) { throw "Native bordered buttons support font sizes up to 20 points"; }
		button.setBordered(bordered);
		self._bordered = bordered;
	}

	public void setCentered(bool centered) { self.control().setAlignment(centered ? NSTextAlignmentCenter : NSTextAlignmentLeft); }

	public void cancelPendingActions() { var control = self.control(); if (self._actions != null) { self._actions.discard(control); } }

	public void setFont(double size) {
		if (!Math.isFinite(size) || size <= 0.0 || size > 512.0) { throw "Invalid native button font size"; }
		var button = self.control();
		if (self._bordered && size > 20.0) { throw "Native bordered buttons support font sizes up to 20 points"; }
		/* Rounded bezels keep a fixed native height even in a taller frame. */
		button.setControlSize(size > 13.0 ? NSControlSizeLarge : NSControlSizeRegular);
		button.setFont(NSFont.systemFontOfSize(size));
		self._fontSize = size;
	}

	/* Selectable navigation buttons retain AppKit's toggle/highlight behavior;
	 * the application republishes selection from its authoritative model. */
	public void setSelected(bool selected) {
		var button = self.control();
		if (!self._selectable) { button.setButtonType(NSButtonTypePushOnPushOff); self._selectable = true; }
		var state = selected ? NSControlStateValueOn : NSControlStateValueOff;
		if (button.state() != state) { button.setState(state); }
	}

	public bool isSelected() { return self.control().state() == NSControlStateValueOn; }

	public void setSystemSymbol(string name) {
		var button = self.control();
		var image = NSImage.imageWithSystemSymbolName(AppKitText.nativeValue(name), null);
		if (image == null) { throw "Native button system symbol is unavailable"; }
		button.setImage(image);
		self._symbol = true;
		self.placeSymbol();
	}

	/* A symbol without a title is the whole control: center it instead of
	 * hugging an empty leading title, which leaves the glyph off-center. */
	private void placeSymbol() {
		var button = self.control();
		if (!self._symbol) { return; }
		bool titled = !self.title().isEmpty();
		button.setImagePosition(titled ? NSImageLeading : NSImageOnly);
		button.setImageHugsTitle(titled);
		button.setAlignment(titled ? NSTextAlignmentLeft : NSTextAlignmentCenter);
	}

	public bool isEnabled() { return self.control().isEnabled(); }

	public bool matches(IMacOSAction? action) { self.control(); return action != null && self._action == action; }

	public bool activate() {
		var control = self.control();
		if (!control.isEnabled()) { return false; }
		control.performClick(null);
		return true;
	}

	public ICallbackRegistration onAction(IButtonAction action, CallbackScope scope) {
		var control = self.control();
		if (self._actions == null) { throw "Button actions require native application dispatch"; }
		return self._actions.onAction(control, action, scope);
	}

	public CallbackCancellation pollClose() { return self._view.pollClose(); }

	public CallbackCancellation close() {
		if (!NSThread.isMainThread()) { throw "Native buttons require the main thread"; }
		if (self._button == null) { return self._view.pollClose(); }
		self._view.requireDetached();
		if (self._actions != null) { self._actions.unbind(self._button); }
		var state = self._view.close();
		self._button = null;
		return state;
	}
}
