import Library.Callback;
import Library.Console;
import Library.Vector;
import Library.GUI.IButton;
import Library.GUI.ActionMailbox;
import Library.GUI.MacOS.MacOSViewState;
import Library.GUI.MacOS.MacOSRunLoop;

/* The provider's projection of a queued action, compared by identity. */
interface IMacOSAction extends IQueuedAction { void discard(); long long ineligibleCount(); }

/* Every entered activation owns one reservation until its native target
 * captures the action. Nested clicks during mouse tracking reserve separately. */
class MacOSButtonEntry {
	public ActionMailboxReservation? reservation;
	public void retire() { if (self.reservation != null) { self.reservation.retire(); } }

	public void __del__() { self.retire(); }
}

class MacOSAction implements IMacOSAction, IAppKitButtonAction, IAppKitButtonAdmission, IMacOSViewEligibility {
	private MacOSActionMailbox _mailbox;
	private int _generation = 0;
	private bool _open = true;
	private MacOSViewState? _state;
	private long long _ineligible = 0LL;
	private CallbackContext<IButtonAction, MacOSAction>? _handler;
	private CallbackContext<IButtonAction, MacOSAction>? _closingHandler;
	private bool _admitted = false;
	private Vector<MacOSButtonEntry> _entries = [];

	public MacOSAction(MacOSActionMailbox mailbox, MacOSViewState? state = null, bool admitted = false) { mailbox.requireMainThread(); self._mailbox = mailbox; self._state = state; self._admitted = admitted; }

	public void attachState(MacOSViewState state) { self._mailbox.requireMainThread(); if (self._state != null || state == null) { throw "Native action state is already bound or missing"; } self._state = state; }

	private void failed(string error) {
		self._mailbox.recordFailure(error);
		var state = self._state; if (state != null) { var context = state.context(); if (context != null) { context.recordNativeFailure(error); } }
	}

	private bool beginNative() {
		self._mailbox.requireMainThread();
		var entry = MacOSButtonEntry(); self._entries.push(entry);
		bool admitted = false;
		try {
			var state = self._state; var context = state == null ? null : state.context();
			if (self._open && !self._mailbox.failed() && (context == null || !context.nativeFailed())) {
				entry.reservation = self._mailbox.reserve(self, self._generation);
				admitted = entry.reservation != null;
				if (!admitted) { self.failed("Native action capacity exceeded before button activation"); }
			}
		} catch (string error) { self.failed(error); }
		return admitted;
	}

	private void endNative(bool nativeFailed) {
		try {
			if (self._entries.len == 0) { throw "Native button admission entry is missing"; }
			var entry = self._entries.get(self._entries.len - 1); self._entries.remove(self._entries.len - 1); entry.retire();
			if (nativeFailed) { self.failed("Native button activation failed"); }
		} catch (string error) { self.failed(error); }
	}

	public bool beforePerformClick(id? sender) { return self.beginNative(); }

	public void afterPerformClick(bool invokedSuper, bool nativeFailed) { self.endNative(nativeFailed); }

	public bool beforeAccessibilityPress() { return self.beginNative(); }

	public void afterAccessibilityPress(bool invokedSuper, bool nativeFailed) { self.endNative(nativeFailed); }

	public bool beforeMouseDown(NSEvent event) { return self.beginNative(); }

	public void afterMouseDown(bool invokedSuper, bool nativeFailed) { self.endNative(nativeFailed); }

	/* Manual provider queues expose action identities without a domain receiver.
	 * A subscribed action always rechecks its view before user delivery. */
	private bool eligible() { var state = self._state; return self._handler == null || state == null || state.effectiveEligible(); }

	public long long ineligibleCount() { self._mailbox.requireMainThread(); return self._ineligible; }

	public void eligibilityLost() { self._mailbox.requireMainThread(); self._mailbox.prune(); }

	public bool accepts(int generation) {
		self._mailbox.requireMainThread();
		if (!self._open || self._generation != generation) { return false; }
		if (!self.eligible()) { self._ineligible++; return false; }
		return true;
	}

	public void invoke() {
		self._mailbox.requireMainThread(); if (!self._open) { return; }
		if (!self._admitted) { self._mailbox.enqueue(self, self._generation); return; }
		try {
			if (self._entries.len == 0) { throw "Native button action has no admitted activation"; }
			var entry = self._entries.get(self._entries.len - 1); var reservation = entry.reservation;
			if (reservation == null || !reservation.isOpen()) { throw "Native button activation has no action reservation"; }
			self._mailbox.enqueueReserved(reservation);
		} catch (string error) { self.failed(error); }
	}

	public ICallbackRegistration onAction(IButtonAction receiver, CallbackScope scope) {
		self._mailbox.requireMainThread();
		if (!self._open) { throw "Native action is closed"; }
		if (self._handler != null) { throw "Cancel the existing button action before replacing it"; }
		self.discard();
		var handler = new CallbackContext<IButtonAction, MacOSAction>(receiver, MacOSAction.unregisterHandler);
		handler.activate(scope);
		self._handler = handler;
		handler.publish(self);
		return handler;
	}

	class bool unregisterHandler(MacOSAction action) {
		action.discard();
		action._handler = null;
		return true;
	}

	public void deliver() {
		self._mailbox.requireMainThread();
		if (!self._open) { return; }
		if (!self.eligible()) { self._ineligible++; return; }
		var handler = self._handler;
		if (handler == null) { return; }
		var receiver = handler.enter();
		if (receiver == null) { return; }
		try { receiver.invoke(); }
		finally { handler.leave(); handler.pollCompletion(); }
	}

	public void discard() {
		self._mailbox.requireMainThread();
		if (self._generation == 2147483647) { throw "Native action generation is exhausted"; }
		self._generation++;
		self._mailbox.prune();
	}

	public void close() {
		self._mailbox.requireMainThread();
		self._open = false;
		string failure = "";
		try { self._mailbox.prune(); } catch (string error) { failure = error; }
		for entry in self._entries { try { entry.retire(); } catch (string error) { if (failure.isEmpty()) { failure = error; } } }
		var handler = self._handler;
		if (handler != null) { self._closingHandler = handler; try { handler.cancel(); } catch (string error) { if (failure.isEmpty()) { failure = error; } } }
		if (!failure.isEmpty()) { throw failure; }
	}

	public CallbackCancellation pollClose() {
		self._mailbox.requireMainThread(); if (self._open) { return CALLBACK_CANCELLATION_NOT_REQUESTED; }
		var handler = self._closingHandler; if (handler == null) { return CALLBACK_CANCELLATION_COMPLETE; }
		var result = handler.pollCompletion(); if (result == CALLBACK_CANCELLATION_COMPLETE) { self._closingHandler = null; } return result;
	}
}

/* The portable ring confined to AppKit's main thread. Only the run-loop
 * wakeup is provider-specific; overflow stays latched in the ring for the
 * consumer to report after native dispatch, since throwing from an AppKit
 * callback would terminate the process. */
class MacOSActionMailbox {
	private ActionMailbox _ring;
	private MacOSRunLoopSignal? _signal;
	private MacOSNativeFailure _failure = MacOSNativeFailure();

	public MacOSActionMailbox(int capacity, MacOSRunLoopSignal? signal) {
		self.requireMainThread();
		self._ring = ActionMailbox(capacity);
		self._signal = signal;
	}

	public void requireMainThread() { if (!NSThread.isMainThread()) { throw "Native actions require the main thread"; } }

	public bool automaticDispatch() { self.requireMainThread(); return self._signal != null; }

	public void stopDispatch() { self.requireMainThread(); self._signal = null; }

	public int pendingCount() { self.requireMainThread(); return self._ring.pendingCount(); }

	public void wake() {
		self.requireMainThread();
		var signal = self._signal;
		if (signal != null && self._ring.hasPending()) { signal.wake(); }
	}

	public void prune() { self.requireMainThread(); self._ring.prune(); }

	public void recordFailure(string error) { self.requireMainThread(); self._failure.record(error); try { self.wake(); } catch (string ignored) {} }

	public bool failed() { self.requireMainThread(); return self._failure.failed(); }

	public ActionMailboxReservation? reserve(MacOSAction action, int generation) { self.requireMainThread(); return self._failure.failed() ? null : self._ring.reserve(action, generation); }

	public void enqueueReserved(ActionMailboxReservation reservation) { self.requireMainThread(); if (self._ring.enqueueReserved(reservation)) { self.wake(); } }

	public void enqueue(MacOSAction action, int generation) {
		self.requireMainThread();
		// Only the wakeup coalesces. Every ordered click stays in the ring.
		if (self._ring.enqueue(action, generation)) { self.wake(); }
	}

	public IMacOSAction? take() {
		self.requireMainThread();
		self._failure.check(); var action = self._ring.take();
		if (action == null) { return null; }
		return (IMacOSAction?)action;
	}
}

/* Cancellation is owned independently of the callback receiver. Native holders
 * retain the action/mailbox, never this binding or its scope. */
class MacOSActionBinding {
	private NSButton? _control;
	private MacOSAction _action;
	private CallbackScope _scope;
	private bool _closing = false;

	public MacOSActionBinding(NSButton? existing, MacOSActionMailbox mailbox, MacOSViewState? state) {
		NSButton? control = existing;
		self._action = MacOSAction(mailbox, state, control == null);
		self._scope = CallbackScope();
		try {
			if (control == null) { CGRect frame = {{0.0, 0.0}, {0.0, 0.0}}; control = NSButton.initWithFrame(self._action, self._scope, frame); }
			if (control == null) { throw "Cannot create native button"; }
			self._control = control; control.setTarget(self._action, self._scope);
		} catch (string error) { self.close(); throw error; }
	}

	public bool matches(NSButton control) { return self._control == control; }

	public NSButton control() { var control = self._control; if (control == null || self._closing) { throw "Native action binding is closed"; } return control; }

	public MacOSAction action() { return self._action; }

	public CallbackCancellation pollClose() {
		if (!self._closing) { return CALLBACK_CANCELLATION_NOT_REQUESTED; }
		var native = self._scope.pollCompletion(); var action = self._action.pollClose();
		if (native == CALLBACK_CANCELLATION_FAILED || action == CALLBACK_CANCELLATION_FAILED) { return CALLBACK_CANCELLATION_FAILED; }
		if (native == CALLBACK_CANCELLATION_RETRYABLE_FAILURE || action == CALLBACK_CANCELLATION_RETRYABLE_FAILURE) { return CALLBACK_CANCELLATION_RETRYABLE_FAILURE; }
		if (native != CALLBACK_CANCELLATION_COMPLETE || action != CALLBACK_CANCELLATION_COMPLETE) { return CALLBACK_CANCELLATION_PENDING; }
		self._control = null; return CALLBACK_CANCELLATION_COMPLETE;
	}

	public CallbackCancellation close() {
		string failure = "";
		if (!self._closing) {
			self._closing = true;
			try { self._action.close(); } catch (string error) { failure = error; }
			try { self._scope.cancel(); } catch (string error) { if (failure.isEmpty()) { failure = error; } }
		}
		var result = self.pollClose(); if (!failure.isEmpty()) { throw failure; } return result;
	}

	public void __del__() { if (self.close() != CALLBACK_CANCELLATION_COMPLETE) { Console.fatal("Native action binding destroyed before callback drain"); } }
}

class MacOSActionQueue {
	private MacOSActionMailbox _mailbox;
	private Vector<MacOSActionBinding> _bindings = [];
	private bool _closed = false;

	public MacOSActionQueue(int capacity = 256, MacOSRunLoopSignal? signal = null) {
		self.requireMainThread();
		self._mailbox = MacOSActionMailbox(capacity, signal);
	}

	private void requireMainThread() { if (!NSThread.isMainThread()) { throw "Native actions require the main thread"; } }

	private void requireOpen() {
		self.requireMainThread();
		if (self._closed) { throw "Native action queue is closed"; }
	}

	private int indexOf(NSButton control) {
		for (int index = 0; index < self._bindings.len; index++) { if (self._bindings.get(index).matches(control)) { return index; } }
		return -1;
	}

	public MacOSActionBinding createButton() {
		self.requireOpen(); var binding = MacOSActionBinding(null, self._mailbox, null); self._bindings.push(binding); return binding;
	}

	public MacOSAction bind(NSButton control, MacOSViewState? state = null) {
		self.requireOpen();
		if (self.indexOf(control) >= 0) { throw "Native control is already bound"; }
		var binding = MacOSActionBinding(control, self._mailbox, state);
		self._bindings.push(binding);
		return binding.action();
	}

	public ICallbackRegistration onAction(NSButton control, IButtonAction receiver, CallbackScope scope) {
		self.requireOpen();
		if (!self._mailbox.automaticDispatch()) { throw "Button actions require native application dispatch"; }
		int index = self.indexOf(control);
		if (index < 0) { throw "Native control is not bound"; }
		return self._bindings.get(index).action().onAction(receiver, scope);
	}

	public int pendingCount() { self.requireOpen(); return self._mailbox.pendingCount(); }

	public void wake() { self.requireOpen(); self._mailbox.wake(); }

	public void dispatchOne() {
		self.requireOpen();
		var action = self._mailbox.take();
		if (action != null) { action.deliver(); }
	}

	public CallbackCancellation unbind(NSButton control) {
		self.requireOpen();
		int index = self.indexOf(control);
		if (index < 0) { return CALLBACK_CANCELLATION_COMPLETE; }
		var binding = self._bindings.get(index); CallbackCancellation result = CALLBACK_CANCELLATION_PENDING;
		bool raised = false; string failure = "";
		try { result = binding.close(); } catch (string error) { raised = true; failure = error; result = binding.pollClose(); }
		if (result == CALLBACK_CANCELLATION_COMPLETE) { self._bindings.remove(index); }
		if (raised) { throw failure; } return result;
	}

	public IMacOSAction? take() { self.requireOpen(); return self._mailbox.take(); }

	public void discard(NSButton control) {
		self.requireOpen();
		int index = self.indexOf(control);
		if (index < 0) { throw "Native control is not bound"; }
		self._bindings.get(index).action().discard();
	}

	public void close() {
		self.requireMainThread();
		if (self._closed) { return; }
		if (self._bindings.len != 0) { throw "Close native controls before their action queue"; }
		self._mailbox.stopDispatch();
		self._closed = true;
	}
}
