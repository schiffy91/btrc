import Library.GUI.IContainer;
import Library.Vector;
import Library.GUI.ControlEventQueue;
import Library.GUI.ControlEvents;
import Library.GUI.MacOS.MacOSRunLoop;
import Library.GUI.MacOS.MacOSControlEvents;
import Library.Math;
import Library.Callback;
import Library.Console;
import Library.GUI.IScrollView;
import Library.GUI.IView;
import Library.GUI.MacOS.MacOSContainer;
import Library.GUI.MacOS.MacOSView;

#include <limits.h>

/* Native two-axis viewport. AppKit owns clipping, wheel/momentum handling and
 * overlay scrollers. Public offsets count logical points down from the top;
 * native document children use AppKit's unflipped coordinates. */
class MacOSScrollLayout implements IMacOSContainerLayout {
	private NSScrollView? _scroll;

	public MacOSScrollLayout() {
		self._scroll = null;
		self.requireMainThread();
		var scroll = NSScrollView.new();
		var document = NSView.new();
		if (scroll == null || document == null) { throw "Cannot create native scroll view"; }
		scroll.setBorderType(NSNoBorder);
		scroll.setDrawsBackground(false);
		scroll.setHasVerticalScroller(true);
		scroll.setHasHorizontalScroller(true);
		scroll.setAutohidesScrollers(true);
		scroll.setScrollerStyle(NSScrollerStyleOverlay);
		scroll.setDocumentView(document);
		self._scroll = scroll;
	}

	private void requireMainThread() {
		if (!NSThread.isMainThread()) { throw "AppKit scroll views require the main thread"; }
	}

	public NSScrollView nativeControl() {
		self.requireMainThread();
		var scroll = self._scroll;
		if (scroll == null) { throw "Scroll view is closed"; }
		return scroll;
	}

	public NSView documentView() {
		var document = self.nativeControl().documentView();
		if (document == null) { throw "Scroll view has no document"; }
		return document;
	}

	public NSView nativeView() { return self.nativeControl(); }

	public NSView childParent() { return self.documentView(); }

	public void arrangeChild(NSView child) {}

	public void forgetChild(NSView child) {}

	private double clamp(double value, double maximum) { return value < 0.0 ? 0.0 : (value > maximum ? maximum : value); }

	public ScrollOffset offset() {
		var bounds = self.nativeControl().contentView().bounds();
		var frame = self.documentView().frame();
		double maximumX = Math.maxDouble(0.0, frame.size.width - bounds.size.width);
		double maximumY = Math.maxDouble(0.0, frame.size.height - bounds.size.height);
		var result = ScrollOffset();
		result.x = self.clamp(bounds.origin.x, maximumX); result.y = self.clamp(maximumY - bounds.origin.y, maximumY);
		return result;
	}

	public ScrollRect visibleRect() {
		var offset = self.offset();
		var bounds = self.nativeControl().contentView().bounds();
		var frame = self.documentView().frame();
		var result = ScrollRect(); result.x = offset.x; result.y = offset.y;
		result.width = Math.maxDouble(0.0, Math.minDouble(bounds.size.width, frame.size.width - offset.x));
		result.height = Math.maxDouble(0.0, Math.minDouble(bounds.size.height, frame.size.height - offset.y));
		return result;
	}

	public void scrollToOffset(ScrollOffset offset) {
		if (offset == null || !Math.isFinite(offset.x) || !Math.isFinite(offset.y)) { throw "Invalid scroll offset"; }
		var scroll = self.nativeControl();
		var clip = scroll.contentView();
		var bounds = clip.bounds();
		var frame = self.documentView().frame();
		double maximumX = Math.maxDouble(0.0, frame.size.width - bounds.size.width);
		double maximumY = Math.maxDouble(0.0, frame.size.height - bounds.size.height);
		bounds.origin.x = self.clamp(offset.x, maximumX);
		bounds.origin.y = maximumY - self.clamp(offset.y, maximumY);
		clip.scrollToPoint(bounds.origin);
		scroll.reflectScrolledClipView(clip);
	}

	public void setContentSize(double width, double height) {
		if (!Math.isFinite(width) || !Math.isFinite(height) || width < 0.0 || height < 0.0) { throw "Invalid scroll content size"; }
		var offset = self.offset();
		var document = self.documentView();
		var frame = document.frame();
		frame.size.width = width; frame.size.height = height;
		document.setFrame(frame); self.nativeControl().tile(); self.scrollToOffset(offset);
	}

	public void close() {
		self.requireMainThread();
		var scroll = self._scroll;
		if (scroll == null) { return; }
		scroll.setDocumentView(null);
		scroll.removeFromSuperview();
		self._scroll = null;
	}
}

/* The native registration owns this receiver only until the scroll owner's
 * native scope is cancelled and drained. It never dispatches user code. */
class MacOSScrollObserver implements IAppKitNotificationObserver {
	private MacOSScrollView _owner;
	private bool _user;
	public MacOSScrollObserver(MacOSScrollView owner, bool user) { self._owner = owner; self._user = user; }

	public void invoke(NSNotification notification) { self._owner.nativeGeometryChanged(self._user); }
}

class MacOSScrollView implements IScrollView, IMacOSView {
	private MacOSContainer _container;
	private MacOSScrollLayout _layout;
	private CallbackScope _native = CallbackScope();
	private ControlEventChannel<IScrollControlEventHandler, ScrollControlEvent>? _observations;
	private ScrollRect _last = ScrollRect();
	private double _viewportWidth = 0.0;
	private double _viewportHeight = 0.0;
	private double _documentWidth = 0.0;
	private double _documentHeight = 0.0;
	private long long _sequence = 0LL;
	private int _changing = 0;
	private bool _closing = false;

	public MacOSScrollView(MacOSControlContext? context = null) {
		self._layout = MacOSScrollLayout();
		try {
			self._container = MacOSContainer(self._layout, context);
			self.rememberGeometry();
			var scroll = self._layout.nativeControl(); var clip = scroll.contentView();
			clip.setPostsBoundsChangedNotifications(true);
			clip.setPostsFrameChangedNotifications(true);
			self._layout.documentView().setPostsFrameChangedNotifications(true);
			var center = NSNotificationCenter.defaultCenter();
			center.addObserverForName(BTRCMacOSScrollNotifications.didLiveScroll(), scroll, null, MacOSScrollObserver(self, true), self._native);
			center.addObserverForName(BTRCMacOSScrollNotifications.boundsChanged(), clip, null, MacOSScrollObserver(self, false), self._native);
			center.addObserverForName(BTRCMacOSScrollNotifications.frameChanged(), clip, null, MacOSScrollObserver(self, false), self._native);
			center.addObserverForName(BTRCMacOSScrollNotifications.frameChanged(), self._layout.documentView(), null, MacOSScrollObserver(self, false), self._native);
		} catch (string error) { self.close(); throw error; }
	}

	private void rememberGeometry() {
		self._last = self._layout.visibleRect();
		var bounds = self._layout.nativeControl().contentView().bounds();
		self._viewportWidth = bounds.size.width; self._viewportHeight = bounds.size.height;
		var frame = self._layout.documentView().frame();
		self._documentWidth = frame.size.width; self._documentHeight = frame.size.height;
	}

	private void capture(ControlOrigin origin) {
		var rect = self._layout.visibleRect(); var old = self._last;
		self.rememberGeometry();
		if (rect.x == old.x && rect.y == old.y && rect.width == old.width && rect.height == old.height) { return; }
		if (self._sequence == LLONG_MAX) { throw "Scroll observation sequence exhausted"; }
		self._sequence++;
		var channel = self._observations;
		if (channel != null && channel.isOpen()) {
			var state = self.interactionOwner();
			var event = ScrollControlEvent(); var context = ControlEventContext();
			context.generation = state.generation(); context.interaction = 0LL; context.sequence = self._sequence;
			context.modelRevision = 0LL; context.origin = origin;
			var offset = ScrollOffset(); offset.x = rect.x; offset.y = rect.y;
			event.context = context; event.offset = offset; event.visibleRect = rect;
			if (!channel.publish(event, state.generation(), 0LL, 1LL)) { throw "Scroll observation queue is full or its native source failed"; }
		}
	}

	/* DidLiveScroll follows bounds-origin notification even for legacy mice.
	 * Origin-only bounds notifications must not consume that USER observation.
	 * SYSTEM capture is restricted to actual viewport/document size changes. */
	public void nativeGeometryChanged(bool user) {
		if (self._closing) { return; }
		try {
			var context = self.interactionOwner().context();
			if (!context.isOpen()) { return; }
			if (user) {
				/* The native change already occurred. Preserve its observation,
				 * but make unexpected transaction input fail at the existing
				 * barrier; no receiver enters intermediate ownership. */
				context.admitNativeInput();
				if (self._changing != 0) { throw "Native user scroll entered an active provider geometry mutation"; }
				self.capture(CONTROL_ORIGIN_USER);
			}
			else if (self._changing == 0) {
				var bounds = self._layout.nativeControl().contentView().bounds();
				var frame = self._layout.documentView().frame();
				if (bounds.size.width != self._viewportWidth || bounds.size.height != self._viewportHeight || frame.size.width != self._documentWidth || frame.size.height != self._documentHeight) {
					self._changing++;
					try { var offset = ScrollOffset(); offset.x = self._last.x; offset.y = self._last.y; self._layout.scrollToOffset(offset); }
					finally { self._changing--; }
					self.capture(CONTROL_ORIGIN_SYSTEM);
				}
			}
		} catch (string error) { self.interactionOwner().context().recordNativeFailure(error); }
	}

	class void deliverOffset(IScrollControlEventHandler receiver, ScrollControlEvent event) { receiver.scrollEvent(event); }

	public ICallbackRegistration onOffsetChanged(IScrollControlEventHandler handler, CallbackScope owner) {
		self.nativeView(); var state = self.interactionOwner(); state.context().requireMutationAllowed();
		var previous = self._observations;
		if (previous != null && previous.pollCompletion() != CALLBACK_CANCELLATION_COMPLETE) { throw "Cancel the previous scroll observation and await completion before replacing it"; }
		var channel = new ControlEventChannel<IScrollControlEventHandler, ScrollControlEvent>(state.events(), MacOSStateObservation(state), handler, MacOSScrollView.deliverOffset, owner);
		try { state.own(channel); } catch (string error) { channel.cancel(); throw error; }
		self._observations = channel; self.rememberGeometry(); return channel;
	}

	public ScrollOffset offset() { self.nativeView(); return self._layout.offset(); }

	public ScrollRect visibleRect() { self.nativeView(); return self._layout.visibleRect(); }

	public void scrollToOffset(ScrollOffset offset) {
		if (offset == null || !Math.isFinite(offset.x) || !Math.isFinite(offset.y)) { throw "Invalid scroll offset"; }
		self.nativeView(); self.interactionOwner().context().requireMutationAllowed();
		self._changing++;
		try { self._layout.scrollToOffset(offset); } finally { self._changing--; }
		self.capture(CONTROL_ORIGIN_MODEL);
	}

	public NSView nativeView() { return self._container.nativeView(); }

	public NSScrollView nativeControl() { self.nativeView(); return self._layout.nativeControl(); }

	public NSView documentView() { self.nativeView(); return self._layout.documentView(); }

	public void attachTo(NSView parent) { self._container.attachTo(parent); }

	public void reconcileAttachment(NSView? parent) { self._container.reconcileAttachment(parent); }

	public void detachFrom(NSView parent) { self._container.detachFrom(parent); }

	public bool isOpen() { return self._container.isOpen(); }

	public void insert(IView child, int index) { self._container.insert(child, index); }

	public void move(IView child, int destinationIndex) { self._container.move(child, destinationIndex); }

	public ContainerBatchResult applyBatch(long long expectedTreeRevision, Vector<ContainerEdit> edits) { return self._container.applyBatch(expectedTreeRevision, edits); }

	public long long treeRevision() { return self._container.treeRevision(); }

	public void attach(IView child) { self._container.attach(child); }

	public IView detach(IView child) { return self._container.detach(child); }

	public int childCount() { return self._container.childCount(); }

	public IView childAt(int index) { return self._container.childAt(index); }

	public double fittingWidth() { return self._container.fittingWidth(); }

	public double fittingHeight() { return self._container.fittingHeight(); }

	public void arrange(double x, double y, double width, double height) {
		var offset = self.offset();
		self.interactionOwner().context().requireMutationAllowed(); self._changing++;
		try { self._container.arrange(x, y, width, height); self.nativeControl().tile(); self._layout.scrollToOffset(offset); }
		finally { self._changing--; }
		self.capture(CONTROL_ORIGIN_SYSTEM);
	}

	public MacOSViewState interactionOwner() { return self._container.interactionOwner(); }

	public void markInteraction(bool inherited, WindowExposure exposure, ControlEventQueue? events) { self._container.markInteraction(inherited, exposure, events); }

	public void settleInteraction() { self._container.settleInteraction(); }

	public void publishInteraction() { self._container.publishInteraction(); }

	public ViewInteractionState interactionState() { return self._container.interactionState(); }

	public ICallbackRegistration onInteractionStateChanged(IViewInteractionStateHandler handler, CallbackScope owner) { return self._container.onInteractionStateChanged(handler, owner); }

	public bool isVisible() { return self._container.isVisible(); }

	public ICallbackRegistration onPointer(IViewPointerHandler handler, CallbackScope owner) { return self._container.onPointer(handler, owner); }

	public ICallbackRegistration onScroll(IViewScrollHandler handler, CallbackScope owner) { return self._container.onScroll(handler, owner); }

	public void cancelPointerCapture() { self._container.cancelPointerCapture(); }

	public void setVisible(bool visible) { self._container.setVisible(visible); }

	public void setContentSize(double width, double height) {
		if (!Math.isFinite(width) || !Math.isFinite(height) || width < 0.0 || height < 0.0) { throw "Invalid scroll content size"; }
		self.nativeView(); self.interactionOwner().context().requireMutationAllowed(); self._changing++;
		try { self._layout.setContentSize(width, height); } finally { self._changing--; }
		self.capture(CONTROL_ORIGIN_SYSTEM);
	}

	public double scrollOffset() { self.nativeView(); return self._layout.offset().y; }

	public void scrollTo(double offset) {
		var position = ScrollOffset(); position.x = self.offset().x; position.y = offset; self.scrollToOffset(position);
	}

	public CallbackCancellation close() {
		if (!NSThread.isMainThread()) { throw "AppKit scroll views require the main thread"; }
		bool wasClosing = self._closing; self._closing = true;
		CallbackCancellation state = CALLBACK_CANCELLATION_COMPLETE;
		try { if (self._container != null) { state = self._container.close(); } }
		catch (string error) {
			/* Attached/reentrant close rejection must leave capture subscribed.
			 * A partially closed container instead remains guarded for retry. */
			self._closing = wasClosing || (self._container != null && !self._container.isOpen());
			throw error;
		}
		var native = self._native.cancel();
		if (native != CALLBACK_CANCELLATION_COMPLETE) { return native; }
		if (state == CALLBACK_CANCELLATION_COMPLETE && self._layout != null) { self._layout.close(); }
		return state;
	}

	public CallbackCancellation pollClose() {
		if (!NSThread.isMainThread()) { throw "AppKit scroll views require the main thread"; }
		if (!self._closing) { return CALLBACK_CANCELLATION_NOT_REQUESTED; }
		var native = self._native.pollCompletion();
		var state = self._container == null ? CALLBACK_CANCELLATION_COMPLETE : self._container.pollClose();
		if (native != CALLBACK_CANCELLATION_COMPLETE) { return native; }
		if (state == CALLBACK_CANCELLATION_COMPLETE && self._layout != null) { self._layout.close(); }
		return state;
	}

	public void __del__() { if (self.close() != CALLBACK_CANCELLATION_COMPLETE) { Console.fatal("Native scroll view destroyed before subtree cleanup completed"); } }
}
