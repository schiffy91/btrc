import Library.Callback;
import Library.Console;
import Library.Vector;
import Library.GUI.IApplication;
import Library.GUI.ControlEventQueue;
import Library.GUI.ApplicationPublisher;
import Library.GUI.ApplicationScheduler;
import Library.GUI.MacOS.MacOSRunLoop;
import Library.GUI.MacOS.MacOSViewState;

/* AppKit's main-thread work owner. The application calls one bounded turn
 * from its common-mode source; native input and window teardown stay with
 * their existing owners. Publishers retain the source through worker drain. */
class MacOSApplicationExecutor implements IControlEventWake {
	private ApplicationScheduler _scheduler;
	private MacOSRunLoopSignal _signal;
	private MacOSNativeFailure _failure;
	private Vector<ApplicationPublisher> _publishers = [];
	private int _publisherUsed = 0;
	private int _publisherCursor = 0;
	private bool _publisherFirst = false;
	private bool _servicing = false;
	private bool _suspended = false;
	private bool _closing = false;
	private bool _closed = false;
	private IApplicationHost? _host;

	public MacOSApplicationExecutor(int capacity, MacOSRunLoopSignal signal, MacOSNativeFailure? failure = null) {
		self.requireMainThread(); self._scheduler = ApplicationScheduler(capacity); self._signal = signal; self._failure = failure == null ? MacOSNativeFailure() : failure;
	}

	private void requireMainThread() { if (!NSThread.isMainThread()) { throw "Application work requires the main thread"; } }

	class unsigned long long now() { return MacOSRunLoopSignal.now(); }

	public ScheduleOutcome schedule(IApplicationWork work, double delaySeconds, WorkSuspensionPolicy policy, long long replacementKey) {
		self.requireMainThread();
		if (self._failure.failed()) { var closed = ScheduleOutcome(); closed.kind = SCHEDULE_CLOSED; closed.registration = null; return closed; }
		var result = self._scheduler.schedule(work, MacOSApplicationExecutor.now(), delaySeconds, policy, replacementKey);
		if (result.kind == SCHEDULE_ACCEPTED || result.kind == SCHEDULE_REPLACED) { self.updateDeadline(); if (!self.requestTurn()) { throw "Application wake failed"; } }
		return result;
	}

	public ApplicationPublisherOutcome createPublisher(int capacity, IApplicationPublicationHandler handler, CallbackScope owner) {
		self.requireMainThread();
		if (capacity <= 0 || capacity > 65536 || handler == null || owner == null) { throw "Publisher requires bounded capacity, receiver and owner"; }
		var result = ApplicationPublisherOutcome(); result.publisher = null; result.registration = null;
		if (self._closing || self._failure.failed()) { result.kind = APPLICATION_PUBLISHER_CLOSED; return result; }
		self.prunePublishers();
		if (capacity > 65536 - self._publisherUsed) { result.kind = APPLICATION_PUBLISHER_BUDGET_EXHAUSTED; return result; }
		var publisher = ApplicationPublisher(capacity, self._signal, self._host);
		if (!publisher.initialized()) { result.kind = APPLICATION_PUBLISHER_RESOURCE_FAILED; return result; }
		publisher.activate(handler, owner); publisher.suspend(self._suspended);
		self._publishers.push(publisher); self._publisherUsed += capacity;
		result.kind = APPLICATION_PUBLISHER_CREATED; result.publisher = publisher; result.registration = publisher; return result;
	}

	private void prunePublishers() {
		for (int index = self._publishers.len - 1; index >= 0; index--) {
			var publisher = self._publishers.get(index);
			if (publisher.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE) {
				self._publisherUsed -= publisher.capacity(); self._publishers.remove(index);
				if (index < self._publisherCursor) { self._publisherCursor--; }
			}
		}
	}

	/* The caller installs its scoped host attachment before committing this
	 * route. A racing worker refuses the change without replacing any route. */
	public bool installHost(IApplicationHost host) {
		self.requireMainThread();
		if (host == null || self._closing || self._host != null || self._servicing) { return false; }
		int locked = 0;
		while (locked < self._publishers.len && self._publishers.get(locked).beginHostChange()) { locked++; }
		if (locked != self._publishers.len) {
			for (int index = 0; index < locked; index++) { self._publishers.get(index).endHostChange(); }
			return false;
		}
		self._host = host;
		for publisher in self._publishers { publisher.setHostLocked(host); publisher.endHostChange(); }
		return true;
	}

	/* Publishers seal admission before checking their admitted notifications.
	 * Their host route stays retained until finishCancellation proves drain. */
	private void sealFailedWork() {
		self._closing = true; self._scheduler.close();
		for publisher in self._publishers { publisher.cancel(); }
	}

	private void recordFailure(string error) { self._failure.record(error); self.sealFailedWork(); }

	public bool requestTurn() {
		self.requireMainThread();
		if (self._failure.failed()) { self.sealFailedWork(); return self._signal.requestTurn(); }
		if (!self._signal.requestTurn()) { self.recordFailure("Application native wake failed"); return false; }
		var host = self._host; if (host == null) { return true; }
		try { if (host.requestTurn()) { return true; } self.recordFailure("Application host wake failed"); }
		catch (string error) { self.recordFailure(error); }
		return false;
	}

	public void updateDeadline() {
		self.requireMainThread();
		unsigned long long deadline = self._scheduler.nextDeadline();
		self._signal.scheduleDeadline(deadline);
		if (self._failure.failed()) { self.sealFailedWork(); return; }
		var host = self._host;
		if (host != null) {
			try { host.scheduleTurn(deadline); }
			catch (string error) { self.recordFailure(error); throw error; }
		}
	}

	public void suspend(bool suspended) {
		self.requireMainThread(); if (self._closing) { return; }
		self._suspended = suspended; self._scheduler.suspend(suspended);
		for publisher in self._publishers { publisher.suspend(suspended); }
		self.updateDeadline(); if (!self.requestTurn()) { throw "Application wake failed"; }
	}

	private void runScheduled() {
		unsigned long long start = MacOSApplicationExecutor.now();
		for (int count = 0; count < 64 && !self._closing && MacOSApplicationExecutor.now() - start < 2000000ULL; count++) {
			self._failure.check(); bool ran = self._scheduler.runOne(MacOSApplicationExecutor.now()); self._failure.check();
			if (!ran) { break; }
		}
	}

	private void runPublishers() {
		int count = self._publishers.len;
		unsigned long long start = MacOSApplicationExecutor.now();
		for (int index = 0; index < count && index < 64 && !self._closing && MacOSApplicationExecutor.now() - start < 2000000ULL; index++) {
			if (self._publisherCursor >= self._publishers.len) { self._publisherCursor = 0; }
			self._failure.check(); self._publishers.get(self._publisherCursor++).deliverOne(); self._failure.check();
		}
		self.prunePublishers();
	}

	public void serviceTurn() {
		self.requireMainThread();
		if (self._servicing) { throw "Application work dispatch cannot re-enter"; }
		if (self._closing) { return; }
		self._failure.check(); self._servicing = true;
		try {
			self._scheduler.beginRound();
			if (self._publisherFirst) { self.runPublishers(); self.runScheduled(); }
			else { self.runScheduled(); self.runPublishers(); }
			self._publisherFirst = !self._publisherFirst;
		} finally { self._servicing = false; }
		self.updateDeadline(); if (self.runnable() && !self.requestTurn()) { throw "Application wake failed"; }
	}

	public bool runnable() {
		self.requireMainThread(); if (self._closing || self._failure.failed()) { return false; }
		if (self._scheduler.runnable(MacOSApplicationExecutor.now())) { return true; }
		for publisher in self._publishers { if (publisher.pending()) { return true; } }
		return false;
	}

	public bool servicing() { self.requireMainThread(); return self._servicing; }

	public int pendingWork() { self.requireMainThread(); return self._scheduler.pendingCount(); }

	public CallbackCancellation close() {
		self.requireMainThread(); if (self._closed) { return CALLBACK_CANCELLATION_COMPLETE; }
		self._closing = true; self._scheduler.close();
		for publisher in self._publishers { publisher.cancel(); }
		try { self.updateDeadline(); } catch (string error) { self.recordFailure(error); }
		return self.pollClose();
	}

	public CallbackCancellation pollClose() {
		self.requireMainThread(); if (self._closed) { return CALLBACK_CANCELLATION_COMPLETE; }
		if (!self._closing) { return CALLBACK_CANCELLATION_NOT_REQUESTED; }
		if (self._servicing || self._scheduler.pollClose() != CALLBACK_CANCELLATION_COMPLETE) { return CALLBACK_CANCELLATION_PENDING; }
		for publisher in self._publishers {
			var result = publisher.pollCompletion(); if (result != CALLBACK_CANCELLATION_COMPLETE) { return result; }
		}
		self._publishers.clear(); self._publisherUsed = 0; self._host = null; self._closed = true;
		return CALLBACK_CANCELLATION_COMPLETE;
	}

	public void __del__() { if (self.close() != CALLBACK_CANCELLATION_COMPLETE) { Console.fatal("Application executor destroyed before callback drain"); } }
}
