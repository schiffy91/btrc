import Library.Callback;
import Library.Console;
import Library.Math;
import Library.Vector;
import Library.GUI.IApplication;
import Library.GUI.ControlEventQueue;
import Library.GUI.MacOS.MacOSRunLoop;

#include <errno.h>

/* UI-only admitted work. The queue retains this record while a receiver is
 * entered, so a callback cannot evade capacity by posting its replacement. */
class MacOSScheduledWork implements ICallbackRegistration {
	public unsigned long long deadline;
	public long long sequence;
	public long long key;
	public WorkSuspensionPolicy policy;
	private CallbackContext<IApplicationWork, MacOSScheduledWork> _callback;
	private IControlEventWake _wake;
	private bool _cancelled = false;
	private bool _executing = false;
	private ControlEventDisposition _disposition = CONTROL_EVENT_CANCELLED;

	public MacOSScheduledWork(IApplicationWork work, CallbackScope owner, IControlEventWake wake, unsigned long long deadline, long long sequence, WorkSuspensionPolicy policy, long long key) {
		self._wake = wake; self.deadline = deadline; self.sequence = sequence; self.policy = policy; self.key = key;
		self._callback = new CallbackContext<IApplicationWork, MacOSScheduledWork>(work, MacOSScheduledWork.unregister);
		self._callback.activate(owner);
		self._callback.publish(self);
	}

	class bool unregister(MacOSScheduledWork work) { work._cancelled = true; work._wake.requestTurn(); return true; }

	public bool isOpen() { return !self._cancelled && self._callback.isOpen(); }

	public bool executing() { return self._executing; }

	public ControlEventDisposition disposition() { return self._disposition; }

	public CallbackCancellation cancel() { return self._callback.cancel(); }

	public CallbackCancellation pollCompletion() { return self._callback.pollCompletion(); }

	public void retireAs(ControlEventDisposition disposition) {
		if (self._executing) { self.cancel(); return; }
		self._disposition = disposition;
		self.cancel();
	}

	public void invoke() {
		var receiver = self._callback.enter();
		if (receiver == null) { return; }
		self._executing = true;
		self._disposition = CONTROL_EVENT_FAILED;
		try { receiver.run(); self._disposition = CONTROL_EVENT_DELIVERED; }
		finally {
			self._executing = false;
			self._callback.leave();
			self._callback.cancel();
			self._callback.pollCompletion();
		}
	}
}

/* Immediate work and future timers share one admission budget. A round takes
 * a sequence watermark; work posted from a handler is never part of that
 * round. The executor checks its time/count budgets before serviceOne. */
class MacOSWorkQueue implements IControlEventWake {
	private int _capacity;
	private bool _open = true;
	private bool _suspended = false;
	private bool _dispatching = false;
	private bool _failed = false;
	private long long _sequence = 0LL;
	private CallbackScope _scope = CallbackScope();
	private MacOSRunLoopSignal _signal;
	private IControlEventWake? _wake;
	private Vector<MacOSScheduledWork> _entries = [];
	private Vector<long long> _retired = [];

	public MacOSWorkQueue(int capacity, MacOSRunLoopSignal signal, IControlEventWake? wake = null) {
		self.requireUI();
		if (capacity <= 0 || capacity > 65536 || signal == null) { throw "Invalid application work queue capacity"; }
		self._capacity = capacity; self._signal = signal; self._wake = wake;
		for (int index = 0; index < 7; index++) { self._retired.push(0LL); }
	}

	private void requireUI() { if (!NSThread.isMainThread()) { throw "Native application work requires the main thread"; } }

	private void countRetired(ControlEventDisposition disposition) {
		long long count = self._retired.get((int)disposition);
		if (count == 9223372036854775807LL) { throw "Application work receipt counters exhausted"; }
		self._retired.set((int)disposition, count + 1LL);
	}

	private void prune() {
		for (int index = self._entries.len - 1; index >= 0; index--) {
			var entry = self._entries.get(index);
			if (!entry.isOpen() && !entry.executing() && entry.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE) {
				self._entries.remove(index); self.countRetired(entry.disposition());
			}
		}
		self._scope.pollCompletion();
	}

	public long long retired(ControlEventDisposition disposition) { self.requireUI(); self.prune(); return self._retired.get((int)disposition); }

	public bool failed() { self.requireUI(); return self._failed; }

	public int pendingCount() { self.requireUI(); self.prune(); return self._entries.len; }

	public long long beginRound() { self.requireUI(); self.prune(); return self._sequence; }

	private unsigned long long deadline(double delaySeconds) {
		if (!Math.isFinite(delaySeconds) || delaySeconds < 0.0) { throw "Application work requires a finite nonnegative delay"; }
		unsigned long long now = MacOSRunLoopSignal.monotonicNowNs();
		if (delaySeconds >= (double)(18446744073709551615ULL - now) / 1000000000.0) { throw "Application work deadline is not representable"; }
		return now + (unsigned long long)(delaySeconds * 1000000000.0);
	}

	public bool requestTurn() {
		self.requireUI();
		if (!self._open) { return !self._failed; }
		bool accepted = false;
		try {
			var wake = self._wake;
			if (wake != null) { accepted = wake.requestTurn(); }
			else { accepted = self._signal.tryWake(); }
		} catch (string error) { accepted = false; }
		if (!accepted) { self._failed = true; self._open = false; }
		return accepted;
	}

	private void wake() {
		if (self.requestTurn()) { return; }
		/* Admission already committed. Never turn this into a rejection that
		 * invites duplicate resubmission; retain failed receipt accounting. */
		self._failed = true; self._open = false;
		for entry in self._entries { if (entry.isOpen()) { entry.retireAs(CONTROL_EVENT_FAILED); } }
		self.prune();
	}

	public ScheduleOutcome schedule(IApplicationWork work, double delaySeconds, WorkSuspensionPolicy policy, long long replacementKey) {
		self.requireUI();
		if (work == null || policy < WORK_SUSPENSION_CANCEL || policy > WORK_SUSPENSION_REPLACE || replacementKey < 0LL || (policy == WORK_SUSPENSION_REPLACE && replacementKey == 0LL)) { throw "Invalid scheduled application work"; }
		unsigned long long due = self.deadline(delaySeconds);
		var result = ScheduleOutcome();
		result.registration = null;
		if (!self._open) { result.kind = SCHEDULE_CLOSED; return result; }
		if (self._suspended && policy == WORK_SUSPENSION_CANCEL) { result.kind = SCHEDULE_CANCELLED; return result; }
		self.prune();
		int replacement = -1;
		if (replacementKey > 0LL) {
			for (int index = self._entries.len - 1; index >= 0; index--) {
				var previous = self._entries.get(index);
				if (previous.key == 0LL || previous.executing()) { break; }
				if (previous.key == replacementKey) { replacement = index; break; }
			}
		}
		if (replacement < 0 && self._entries.len == self._capacity) { result.kind = SCHEDULE_FULL; return result; }
		if (self._sequence == 9223372036854775807LL) { throw "Application work identities exhausted"; }
		var entry = MacOSScheduledWork(work, self._scope, self, due, self._sequence + 1LL, policy, replacementKey);
		self._sequence++;
		if (replacement >= 0) {
			var previous = self._entries.get(replacement);
			previous.retireAs(CONTROL_EVENT_SUPERSEDED);
			if (previous.pollCompletion() != CALLBACK_CANCELLATION_COMPLETE) { entry.cancel(); throw "Queued replacement unexpectedly has an entered receiver"; }
			self.countRetired(previous.disposition());
			self._entries.set(replacement, entry);
			result.kind = SCHEDULE_REPLACED;
		} else { self._entries.push(entry); result.kind = SCHEDULE_ACCEPTED; }
		result.registration = entry;
		self.wake();
		return result;
	}

	public void post(IApplicationWork work) {
		var result = self.schedule(work, 0.0, WORK_SUSPENSION_DEFER, 0LL);
		if (result.kind == SCHEDULE_FULL) { throw "Application work capacity exceeded"; }
		if (result.kind != SCHEDULE_ACCEPTED) { throw "Application shutdown has started"; }
	}

	public ICallbackRegistration postAfter(double delaySeconds, IApplicationWork work) {
		var result = self.schedule(work, delaySeconds, WORK_SUSPENSION_DEFER, 0LL);
		if (result.kind == SCHEDULE_FULL) { throw "Application work capacity exceeded"; }
		if (result.kind != SCHEDULE_ACCEPTED || result.registration == null) { throw "Application shutdown has started"; }
		return result.registration;
	}

	public void suspend(bool suspended) {
		self.requireUI();
		if (self._suspended == suspended) { return; }
		self._suspended = suspended;
		if (suspended) {
			for entry in self._entries { if (entry.policy == WORK_SUSPENSION_CANCEL && entry.isOpen()) { entry.cancel(); } }
			self.prune();
		} else if (self._open) { self.wake(); }
	}

	/* Zero disarms the host timer. Suspended/future work retains its original
	 * deadline; overdue work becomes runnable once after resume. */
	public unsigned long long nextDeadline() {
		self.requireUI(); self.prune();
		if (!self._open || self._suspended) { return 0ULL; }
		unsigned long long next = 0ULL;
		for entry in self._entries {
			if (entry.isOpen() && !entry.executing() && (next == 0ULL || entry.deadline < next)) { next = entry.deadline; }
		}
		return next;
	}

	public bool serviceOne(long long round) {
		self.requireUI();
		if (self._dispatching) { throw "Application work cannot re-enter its scheduling round"; }
		if (self._failed) { throw "Application work native wake failed"; }
		self.prune();
		if (!self._open || self._suspended) { return false; }
		unsigned long long now = MacOSRunLoopSignal.monotonicNowNs();
		for entry in self._entries {
			if (!entry.isOpen() || entry.sequence > round || entry.deadline > now) { continue; }
			self._dispatching = true;
			try { entry.invoke(); }
			finally { self._dispatching = false; self.prune(); }
			return true;
		}
		return false;
	}

	/* Admission-only sealing never retires a receiver. Application seals every
	 * ingress before cancellation can release user-owned work. */
	public void seal() { self.requireUI(); self._open = false; }

	public CallbackCancellation cancel() {
		self.seal();
		for entry in self._entries { if (entry.isOpen()) { entry.retireAs(CONTROL_EVENT_CLOSED); } }
		return self.pollCompletion();
	}

	public CallbackCancellation pollCompletion() {
		self.requireUI();
		if (self._open) { return CALLBACK_CANCELLATION_NOT_REQUESTED; }
		self.prune();
		return self._entries.isEmpty() && !self._dispatching ? CALLBACK_CANCELLATION_COMPLETE : CALLBACK_CANCELLATION_PENDING;
	}

	public void __del__() { if (self.cancel() != CALLBACK_CANCELLATION_COMPLETE) { Console.fatal("Application work queue destroyed before receiver drain"); } }
}

struct MacOSPublicationRecord {
	long long generation;
	long long sequence;
	long long key;
	long long payload;
	int policy;
	bool cancelled;
};

struct MacOSPublicationReceipt {
	long long generation;
	long long sequence;
};

/* Producer-reachable mutable storage is plain data guarded by one native
 * mutex. Atomic seal/notification fields on the retained class allow UI cancellation
 * without waiting for a producer or releasing its host route prematurely. */
struct MacOSPublisherState {
	pthread_mutex_t mutex;
	struct MacOSPublicationRecord* slots;
	struct MacOSPublicationReceipt* receipts;
	long long retired[7];
	int capacity;
	int head;
	int count;
	int receiptHead;
	int receiptCount;
	bool open;
	bool suspended;
	bool executing;
	struct MacOSPublicationRecord current;
	long long generation;
	long long sequence;
	long long accepted;
};

class MacOSPublisher implements IApplicationPublisher, ICallbackRegistration {
	private Atomic<bool> _sealed;
	private Atomic<bool> _failed;
	private Atomic<uint> _notifying;
	private struct MacOSPublisherState* _state = null;
	private bool _initialized = false;
	private MacOSRunLoopSignal _signal;
	private IApplicationHost? _host;
	private CallbackScope _scope = CallbackScope();
	private CallbackContext<IApplicationPublicationHandler, MacOSPublisher>? _handler;
	private CallbackCancellation _cancellation = CALLBACK_CANCELLATION_NOT_REQUESTED;

	public MacOSPublisher(int capacity, MacOSRunLoopSignal signal, IApplicationHost? host = null) {
		self.requireUI();
		if (capacity <= 0 || capacity > 65536 || signal == null) { throw "Invalid native publisher capacity"; }
		self._sealed.init(false); self._failed.init(false); self._notifying.init(0u);
		self._signal = signal; self._host = host;
		self._state = (struct MacOSPublisherState*)calloc(1, sizeof(struct MacOSPublisherState));
		if (self._state == null) { return; }
		self._state->capacity = capacity;
		self._state->slots = (struct MacOSPublicationRecord*)calloc((size_t)capacity, sizeof(struct MacOSPublicationRecord));
		self._state->receipts = (struct MacOSPublicationReceipt*)calloc((size_t)capacity, sizeof(struct MacOSPublicationReceipt));
		if (self._state->slots == null || self._state->receipts == null || pthread_mutex_init(&self._state->mutex, null) != 0) { return; }
		self._initialized = true; self._state->open = true;
	}

	private void requireUI() { if (!NSThread.isMainThread()) { throw "Native publisher ownership requires the main thread"; } }

	public bool initialized() { self.requireUI(); return self._initialized; }

	public int capacity() { self.requireUI(); return self._state == null ? 0 : self._state->capacity; }

	public void activate(IApplicationPublicationHandler receiver, CallbackScope owner) {
		self.requireUI();
		if (!self._initialized || self._handler != null || receiver == null) { throw "Publisher activation requires storage and a receiver"; }
		var handler = new CallbackContext<IApplicationPublicationHandler, MacOSPublisher>(receiver, MacOSPublisher.unregister);
		handler.activate(self._scope); self._handler = handler;
		try { owner.track(self); }
		catch (string error) { handler.abortActivation(); self._handler = null; throw error; }
		handler.publish(self);
	}

	class bool unregister(MacOSPublisher publisher) { return true; }

	/* Called only with the POD mutex held, on either producer or UI executor.
	 * The bounded recent-receipt ledger distinguishes a known terminal receipt
	 * from an unaccepted sequence gap; an evicted identity is conservatively stale. */
	private void retireRecord(struct MacOSPublicationRecord record, ControlEventDisposition disposition) {
		self._state->retired[(int)disposition]++;
		int position = (self._state->receiptHead + self._state->receiptCount) % self._state->capacity;
		if (self._state->receiptCount == self._state->capacity) {
			position = self._state->receiptHead;
			self._state->receiptHead = (self._state->receiptHead + 1) % self._state->capacity;
		} else { self._state->receiptCount++; }
		self._state->receipts[position].generation = record.generation;
		self._state->receipts[position].sequence = record.sequence;
	}

	private struct MacOSPublicationRecord pop() {
		struct MacOSPublicationRecord record = self._state->slots[self._state->head];
		self._state->head = (self._state->head + 1) % self._state->capacity; self._state->count--;
		return record;
	}

	private void clear(ControlEventDisposition disposition) {
		while (self._state->count > 0) {
			struct MacOSPublicationRecord record = self.pop();
			self.retireRecord(record, record.cancelled ? CONTROL_EVENT_CANCELLED : disposition);
		}
	}

	public PublishOutcome tryPublish(long long generation, long long sequence, WorkSuspensionPolicy suspension, long long replacementKey, long long payload) {
		if (generation <= 0LL || sequence <= 0LL || replacementKey < 0LL || suspension < WORK_SUSPENSION_CANCEL || suspension > WORK_SUSPENSION_REPLACE || (suspension == WORK_SUSPENSION_REPLACE && replacementKey == 0LL)) { return PUBLISH_INVALID; }
		if (!self._initialized || pthread_mutex_lock(&self._state->mutex) != 0) { return PUBLISH_RESOURCE_FAILED; }
		if (!self._state->open || self._sealed.load(MemoryOrder.ACQUIRE)) { pthread_mutex_unlock(&self._state->mutex); return PUBLISH_CLOSED; }
		if (generation < self._state->generation || (generation == self._state->generation && sequence <= self._state->sequence)) { pthread_mutex_unlock(&self._state->mutex); return PUBLISH_STALE; }
		if (self._state->suspended && suspension == WORK_SUSPENSION_CANCEL) { pthread_mutex_unlock(&self._state->mutex); return PUBLISH_CANCELLED; }
		if (self._state->accepted == 9223372036854775807LL || self._notifying.load(MemoryOrder.ACQUIRE) == 4294967295u) { pthread_mutex_unlock(&self._state->mutex); return PUBLISH_RESOURCE_FAILED; }
		bool fresh = generation > self._state->generation;
		int replacement = -1;
		if (!fresh && replacementKey > 0LL) {
			for (int offset = self._state->count - 1; offset >= 0; offset--) {
				int index = (self._state->head + offset) % self._state->capacity;
				if (self._state->slots[index].key == 0LL) { break; }
				if (!self._state->slots[index].cancelled && self._state->slots[index].key == replacementKey) { replacement = index; break; }
			}
		}
		int executing = self._state->executing ? 1 : 0;
		if (replacement < 0 && ((!fresh && self._state->count + executing >= self._state->capacity) || (fresh && executing >= self._state->capacity))) { pthread_mutex_unlock(&self._state->mutex); return PUBLISH_FULL; }
		/* Source signalling cannot invoke a receiver inline. Its wake cannot
		 * observe this record until the same mutex publishes it below. */
		if (!self._signal.tryWake()) {
			self._failed.store(true, MemoryOrder.RELEASE); self._sealed.store(true, MemoryOrder.RELEASE);
			pthread_mutex_unlock(&self._state->mutex); return PUBLISH_WAKE_FAILED;
		}
		if (fresh) { self.clear(CONTROL_EVENT_STALE_GENERATION); self._state->generation = generation; }
		if (replacement >= 0) { self.retireRecord(self._state->slots[replacement], CONTROL_EVENT_SUPERSEDED); }
		int slot = replacement;
		if (slot < 0) { slot = (self._state->head + self._state->count) % self._state->capacity; self._state->count++; }
		self._state->slots[slot].generation = generation; self._state->slots[slot].sequence = sequence;
		self._state->slots[slot].key = replacementKey; self._state->slots[slot].payload = payload;
		self._state->slots[slot].policy = (int)suspension; self._state->slots[slot].cancelled = false;
		self._state->sequence = sequence; self._state->accepted++;
		self._notifying.fetchAdd(1u, MemoryOrder.ACQ_REL);
		pthread_mutex_unlock(&self._state->mutex);
		self.notifyHost();
		return replacement >= 0 ? PUBLISH_REPLACED : PUBLISH_ACCEPTED;
	}

	private void notifyHost() {
		/* UI ownership retains this host field until all notifying claims end.
		 * Producers never create/release a managed local copy. A post-commit
		 * failure seals ingress, but does not invite duplicate resubmission. */
		bool signalled = false;
		try { signalled = self._host == null || self._host.requestTurn(); }
		catch (string error) { signalled = false; }
		finally {
			if (!signalled) { self._failed.store(true, MemoryOrder.RELEASE); self._sealed.store(true, MemoryOrder.RELEASE); }
			self._notifying.fetchSub(1u, MemoryOrder.RELEASE);
		}
	}

	public PublishCancelOutcome requestCancel(long long generation, long long sequence) {
		if (!self._initialized || pthread_mutex_lock(&self._state->mutex) != 0) { return PUBLISH_CANCEL_CLOSED; }
		if (!self._state->open || self._sealed.load(MemoryOrder.ACQUIRE)) { pthread_mutex_unlock(&self._state->mutex); return PUBLISH_CANCEL_CLOSED; }
		if (generation != self._state->generation || sequence <= 0LL) { pthread_mutex_unlock(&self._state->mutex); return PUBLISH_CANCEL_STALE; }
		bool found = false;
		for (int offset = 0; offset < self._state->count; offset++) {
			int index = (self._state->head + offset) % self._state->capacity;
			if (self._state->slots[index].sequence == sequence) { self._state->slots[index].cancelled = true; found = true; break; }
		}
		if (self._state->executing && self._state->current.generation == generation && self._state->current.sequence == sequence) { self._state->current.cancelled = true; found = true; }
		if (found) {
			/* Cancellation is already committed; a failed wake is observable at
			 * service/cleanup, not disguised as a retryable rejection. */
			if (!self._signal.tryWake()) { self._failed.store(true, MemoryOrder.RELEASE); self._sealed.store(true, MemoryOrder.RELEASE); }
			bool notify = self._notifying.load(MemoryOrder.ACQUIRE) < 4294967295u;
			if (notify) { self._notifying.fetchAdd(1u, MemoryOrder.ACQ_REL); }
			else { self._failed.store(true, MemoryOrder.RELEASE); self._sealed.store(true, MemoryOrder.RELEASE); }
			pthread_mutex_unlock(&self._state->mutex);
			if (notify) { self.notifyHost(); }
			return PUBLISH_CANCEL_REQUESTED;
		}
		for (int offset = 0; offset < self._state->receiptCount; offset++) {
			int index = (self._state->receiptHead + offset) % self._state->capacity;
			if (self._state->receipts[index].generation == generation && self._state->receipts[index].sequence == sequence) { pthread_mutex_unlock(&self._state->mutex); return PUBLISH_CANCEL_ALREADY_TERMINAL; }
		}
		pthread_mutex_unlock(&self._state->mutex); return PUBLISH_CANCEL_STALE;
	}

	/* Attachment changes no route while a producer has borrowed it. The
	 * application holds every publisher's successful lock before committing
	 * a multi-publisher host transition, then releases all of them. */
	public bool beginHostChange() {
		self.requireUI();
		if (!self._initialized || pthread_mutex_trylock(&self._state->mutex) != 0) { return false; }
		if (self._notifying.load(MemoryOrder.ACQUIRE) != 0u) { pthread_mutex_unlock(&self._state->mutex); return false; }
		return true;
	}

	public void setHostLocked(IApplicationHost? host) { self.requireUI(); self._host = host; }

	public void endHostChange() { self.requireUI(); pthread_mutex_unlock(&self._state->mutex); }

	public void suspend(bool suspended) {
		self.requireUI();
		if (pthread_mutex_lock(&self._state->mutex) != 0) { throw "Native publisher synchronization failed"; }
		self._state->suspended = suspended;
		if (suspended) {
			for (int offset = 0; offset < self._state->count; offset++) {
				int index = (self._state->head + offset) % self._state->capacity;
				if (self._state->slots[index].policy == (int)WORK_SUSPENSION_CANCEL) { self._state->slots[index].cancelled = true; }
			}
		}
		pthread_mutex_unlock(&self._state->mutex);
		if (!self._signal.tryWake()) { self._failed.store(true, MemoryOrder.RELEASE); self._sealed.store(true, MemoryOrder.RELEASE); }
	}

	public bool failed() { self.requireUI(); return self._state != null && self._failed.load(MemoryOrder.ACQUIRE); }

	public bool pending() {
		self.requireUI();
		if (pthread_mutex_lock(&self._state->mutex) != 0) { throw "Native publisher synchronization failed"; }
		bool pending = self._failed.load(MemoryOrder.ACQUIRE) || (!self._state->suspended && self._state->count > 0);
		if (!pending) {
			for (int offset = 0; offset < self._state->count; offset++) { if (self._state->slots[(self._state->head + offset) % self._state->capacity].cancelled) { pending = true; break; } }
		}
		pthread_mutex_unlock(&self._state->mutex); return pending;
	}

	public long long acceptedCount() { self.requireUI(); if (pthread_mutex_lock(&self._state->mutex) != 0) { throw "Native publisher synchronization failed"; } long long value = self._state->accepted; pthread_mutex_unlock(&self._state->mutex); return value; }

	public long long retired(ControlEventDisposition disposition) { self.requireUI(); if (pthread_mutex_lock(&self._state->mutex) != 0) { throw "Native publisher synchronization failed"; } long long value = self._state->retired[(int)disposition]; pthread_mutex_unlock(&self._state->mutex); return value; }

	public int pendingCount() { self.requireUI(); if (pthread_mutex_lock(&self._state->mutex) != 0) { throw "Native publisher synchronization failed"; } int value = self._state->count + (self._state->executing ? 1 : 0); pthread_mutex_unlock(&self._state->mutex); return value; }

	public bool deliverOne() {
		self.requireUI();
		if (pthread_mutex_lock(&self._state->mutex) != 0) { throw "Native publisher synchronization failed"; }
		if (self._failed.load(MemoryOrder.ACQUIRE)) { pthread_mutex_unlock(&self._state->mutex); throw "Native publisher wake failed"; }
		if (self._state->executing) { pthread_mutex_unlock(&self._state->mutex); throw "Native publisher delivery cannot re-enter"; }
		if (self._state->count == 0) { pthread_mutex_unlock(&self._state->mutex); return false; }
		int selected = 0;
		if (self._state->suspended) {
			selected = -1;
			for (int offset = 0; offset < self._state->count; offset++) {
				if (self._state->slots[(self._state->head + offset) % self._state->capacity].cancelled) { selected = offset; break; }
			}
			if (selected < 0) { pthread_mutex_unlock(&self._state->mutex); return false; }
		}
		struct MacOSPublicationRecord record = self._state->slots[(self._state->head + selected) % self._state->capacity];
		if (selected == 0) { record = self.pop(); }
		else {
			/* Retire cancelled control work behind suspended deferred work
			 * without changing the order of any surviving domain record. */
			for (int offset = selected; offset + 1 < self._state->count; offset++) {
				self._state->slots[(self._state->head + offset) % self._state->capacity] = self._state->slots[(self._state->head + offset + 1) % self._state->capacity];
			}
			self._state->count--;
		}
		if (record.cancelled || !self._state->open || self._sealed.load(MemoryOrder.ACQUIRE) || record.generation != self._state->generation) {
			ControlEventDisposition disposition = CONTROL_EVENT_CANCELLED;
			if (!record.cancelled) { disposition = record.generation != self._state->generation ? CONTROL_EVENT_STALE_GENERATION : CONTROL_EVENT_CLOSED; }
			self.retireRecord(record, disposition); pthread_mutex_unlock(&self._state->mutex); return true;
		}
		var handler = self._handler;
		/* Validation, dequeue and entry pinning share one linearization point.
		 * New generations may arrive after entry, but cannot revoke that call. */
		if (handler == null) { self.retireRecord(record, CONTROL_EVENT_CANCELLED); pthread_mutex_unlock(&self._state->mutex); return true; }
		var receiver = handler.enter();
		if (receiver == null) { self.retireRecord(record, CONTROL_EVENT_CANCELLED); pthread_mutex_unlock(&self._state->mutex); return true; }
		self._state->executing = true; self._state->current = record;
		pthread_mutex_unlock(&self._state->mutex);
		ControlEventDisposition disposition = CONTROL_EVENT_FAILED;
		try {
			var publication = ApplicationPublication(); publication.generation = record.generation; publication.sequence = record.sequence;
			publication.replacementKey = record.key; publication.payload = record.payload;
			receiver.deliver(publication); disposition = CONTROL_EVENT_DELIVERED;
		} finally {
			handler.leave(); handler.pollCompletion();
			if (pthread_mutex_lock(&self._state->mutex) != 0) { Console.fatal("Native publisher receipt retirement synchronization failed"); }
			self._state->executing = false; self.retireRecord(record, disposition);
			pthread_mutex_unlock(&self._state->mutex);
		}
		return true;
	}

	public bool isOpen() { self.requireUI(); return self._initialized && !self._sealed.load(MemoryOrder.ACQUIRE) && self._handler != null && self._handler.isOpen(); }

	private CallbackCancellation finishCancellation() {
		if (!self._initialized) { return CALLBACK_CANCELLATION_COMPLETE; }
		int locked = pthread_mutex_trylock(&self._state->mutex);
		if (locked == EBUSY) { return CALLBACK_CANCELLATION_PENDING; }
		if (locked != 0) { return CALLBACK_CANCELLATION_RETRYABLE_FAILURE; }
		self._state->open = false;
		self.clear(self._failed.load(MemoryOrder.ACQUIRE) ? CONTROL_EVENT_FAILED : CONTROL_EVENT_CLOSED);
		bool notifying = self._notifying.load(MemoryOrder.ACQUIRE) != 0u;
		bool executing = self._state->executing;
		pthread_mutex_unlock(&self._state->mutex);
		if (notifying) { return CALLBACK_CANCELLATION_PENDING; }
		self._host = null;
		var handler = self._handler;
		var state = handler == null ? CALLBACK_CANCELLATION_COMPLETE : handler.cancel();
		return state == CALLBACK_CANCELLATION_COMPLETE && executing ? CALLBACK_CANCELLATION_PENDING : state;
	}

	public void seal() {
		self.requireUI();
		if (self._state != null) { self._sealed.store(true, MemoryOrder.RELEASE); }
	}

	public CallbackCancellation cancel() {
		self.seal();
		if (self._cancellation == CALLBACK_CANCELLATION_COMPLETE || self._cancellation == CALLBACK_CANCELLATION_FAILED) { return self._cancellation; }
		self._cancellation = self.finishCancellation(); return self._cancellation;
	}

	public CallbackCancellation pollCompletion() {
		self.requireUI();
		if (self._cancellation == CALLBACK_CANCELLATION_PENDING) { self._cancellation = self.finishCancellation(); }
		return self._cancellation;
	}

	public void __del__() {
		self.requireUI();
		if (self.cancel() != CALLBACK_CANCELLATION_COMPLETE) { Console.fatal("Native publisher destroyed before producer and callback drain"); }
		self._scope.cancel();
		if (self._state == null) { return; }
		if (self._initialized && pthread_mutex_destroy(&self._state->mutex) != 0) { Console.fatal("Native publisher destroyed during publication"); }
		free(self._state->slots); free(self._state->receipts); free(self._state); self._state = null;
	}
}
