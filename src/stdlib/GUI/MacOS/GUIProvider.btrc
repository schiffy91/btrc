import Library.GUI.MacOS.MacOSApplication;
import Library.GUI.MacOS.MacOSGPUView;
import Library.GUI.MacOS.MacOSComposedCapture;
import Library.GUI.MacOS.MacOSSystemText;
import Library.GUI.MacOS.MacOSImageHandle;
import Library.GUI.IImageHandle;
import Library.GUI.Capture;
import Library.GUI.MacOS.MacOSDirectoryPicker;
import Library.Image.MacOS.MacOSEncodedImageDecoder;

/* Private package implementation. The static slot is the application owner,
 * not a widget registry or a second native lifetime mechanism. */
class GUIProvider {
	class MacOSApplication? active = null;

	class void requireMainThread() { if (!NSThread.isMainThread()) { throw "GUI requires the main thread"; } }

	class void initialize(int workCapacity) {
		GUIProvider.requireMainThread();
		if (GUIProvider.active != null) { throw "GUI is already initialized"; }
		if (workCapacity <= 0 || workCapacity > 65536) { throw "Application work capacity must be between 1 and 65536"; }
		GUIProvider.active = MacOSApplication(workCapacity);
	}

	class MacOSApplication application() {
		GUIProvider.requireMainThread();
		var application = GUIProvider.active;
		if (application == null) { throw "Initialize GUI before creating views or running work"; }
		return application;
	}

	class DirectoryPickerOutcome chooseDirectory(DirectoryPickerRequest request) { GUIProvider.application(); return MacOSDirectoryPicker().chooseDirectory(request); }

	/* Conversion may run on a worker; it needs no initialized application. */
	class IImageHandle createImageHandle(Image pixels, int maximumPixels) { return MacOSImageHandle.create(pixels, maximumPixels); }

	class void rasterizeText(TextRasterization request) { GUIProvider.requireMainThread(); MacOSSystemText.rasterize(request); }

	class Image rasterText(TextRun run) { GUIProvider.requireMainThread(); return MacOSSystemText.raster(run); }

	class Image capture(IView root, Vector<GUICaptureLayer> layers) {
		GUIProvider.application();
		var native = (IMacOSView?)root;
		if (native == null) { throw "Capture root belongs to another GUI provider"; }
		Vector<MacOSCaptureLayer> nativeLayers = [];
		for layer in layers {
			var gpu = (IMacOSGPUView?)layer.view;
			if (gpu == null) { throw "Capture layer belongs to another GPU provider"; }
			nativeLayers.push(MacOSCaptureLayer(gpu.captureSurface(), layer.pixels));
		}
		var encoded = MacOSComposedCapture.captureTiff(native.nativeView(), nativeLayers);
		var decoded = MacOSEncodedImageDecoder().decode(encoded, EncodedImageDecodeLimits(134217728, 16384, 16384, 16777216LL));
		if (!decoded.succeeded()) { throw "Cannot decode composed native capture"; }
		return decoded.image();
	}

	class void run() {
		var application = GUIProvider.application();
		if (application.isRunning()) { throw "GUI is already running"; }
		try { application.run(); } finally { GUIProvider.close(); }
	}

	class CallbackCancellation close() {
		GUIProvider.requireMainThread();
		var application = GUIProvider.active;
		if (application == null) { return CallbackCancellation.Complete; }
		var result = application.close();
		if (result == CallbackCancellation.Complete) { GUIProvider.active = null; }
		return result;
	}
}
