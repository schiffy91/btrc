/* Native quit captures a reversible group. Returning Cancel keeps AppKit
 * from exiting before the ordinary UI turn resolves it and runs shutdown. */
class MacOSApplicationEvents implements IAppKitApplicationEvents, IAppKitNotificationObserver {
	public bool quitRequested = false;
	private MacOSApplicationExecutor _executor;
	private MacOSViewContext _viewContext;
	private MacOSActionQueue _actions;
	private Vector<MacOSWindow> _windows;
	private Vector<IView> _views;
	private Vector<IView> _closingRoots = [];
	private bool _viewsClosing = false;
	private string _viewCloseFailure = "";
	private CallbackScope _shutdown;
	private ICallbackRegistration? _shutdownTick;
	private bool _dispatchingEvents = false;
	private MacOSWindowQuitCoordinator? _quitCoordinator;
	private Timer _shutdownClock = Timer();
	private bool _shutdownTimed = false;

	public MacOSApplicationEvents(MacOSApplicationExecutor executor, MacOSViewContext viewContext, MacOSActionQueue actions, Vector<MacOSWindow> windows, Vector<IView> views, CallbackScope shutdown) {
		self._executor = executor; self._viewContext = viewContext;
		self._actions = actions;
		self._windows = windows;
		self._views = views;
		self._shutdown = shutdown;
	}

	public void invoke(NSNotification notification) { self.serviceTurn(); }

	public void serviceTurn() {
		if (self.quitRequested || self._dispatchingEvents || self._viewContext.treeMutationActive()) { return; }
		self._dispatchingEvents = true;
		try {
			self._viewContext.checkNativeFailure();
			self.serviceNativeQuit();
			self.dispatchWindowEvents();
			self._executor.serviceTurn();
			unsigned long long semanticStart = MacOSApplicationExecutor.now();
			for (int count = 0; count < 64 && !self.quitRequested && MacOSApplicationExecutor.now() - semanticStart < 2000000ULL; count++) { if (!self._viewContext.dispatchOne()) { break; } }
			unsigned long long started = MacOSApplicationExecutor.now();
			int count = self._actions.pendingCount();
			for (int index = 0; index < count && index < 64 && !self.quitRequested && MacOSApplicationExecutor.now() - started < 2000000ULL; index++) { self._viewContext.checkNativeFailure(); self._actions.dispatchOne(); self._viewContext.checkNativeFailure(); }
			self.dispatchWindowEvents();
			self.serviceNativeQuit();
		} catch (string error) { self.failWork(error); }
		finally {
			self._dispatchingEvents = false;
			if (self.quitRequested && self._executor.pendingWork() == 0) { self.stop(NSApplication.sharedApplication()); }
			else if (!self.quitRequested) { self._actions.wake(); if (self._viewContext.pending() && !self._viewContext.wake.requestTurn()) { self.failWork("Application semantic wake failed"); } }
		}
	}

	private void serviceNativeQuit() {
		if (self.quitRequested || !self._viewContext.nativeQuitPending()) { return; }
		var coordinator = self._quitCoordinator;
		if (coordinator == null) { throw "Native quit capture is unavailable"; }
		if (coordinator.advance()) { coordinator.commit(); self._quitCoordinator = null; self.requestQuit(NSApplication.sharedApplication()); }
		else if (coordinator.cancelled()) { self._quitCoordinator = null; }
	}

	public bool eventsActive() { return self._dispatchingEvents; }

	public void dispatchWindowEvents() {
		bool pending = false;
		for (int index = self._windows.len - 1; index >= 0; index--) {
			var window = self._windows.get(index);
			self._viewContext.checkNativeFailure(); window.dispatchPendingEvents(); self._viewContext.checkNativeFailure();
			if (!window.isOpen()) {
				if (window.pollClose() == CALLBACK_CANCELLATION_COMPLETE) { self._windows.remove(index); }
				else { pending = true; }
			}
		}
		if (pending && NSApplication.sharedApplication().isRunning()) { self.armShutdown(); }
	}

	public int pendingWork() { return self._executor.pendingWork(); }

	public string workFailure() { return self._viewContext.nativeFailure(); }

	public bool workFailed() { return self._viewContext.nativeFailed(); }

	public void recordFailure(string error) { self._viewContext.recordFailure(error); }

	/* run() drains a pending subtree for at most 10 seconds from this call
	 * (see shutdownExpired), then reports it and leaves the pending owners
	 * retained for a later close(). */
	public void startShutdownDeadline() {
		if (self._shutdownTimed) { return; }
		self._shutdownClock.start();
		self._shutdownTimed = true;
	}

	public bool shutdownExpired() { return self._shutdownTimed && (double)self._shutdownClock.elapsed() >= 10.0; }

	public void failWork(string error) {
		self.recordFailure(error);
		self.requestQuit(NSApplication.sharedApplication());
	}

	public void requestQuit(NSApplication application) {
		if (self.quitRequested) { return; }
		self.quitRequested = true;
		self._executor.close();
		// A modal caller may itself be admitted work. Unwind its native loop
		// before waiting for that work to return; keep owned views alive.
		if (application.modalWindow() != null) { application.stopModalWithCode(NSModalResponseAbort); }
		if (self._executor.pendingWork() == 0 && !self._dispatchingEvents) { self.stop(application); }
	}

	private void stop(NSApplication application) {
		if (application.isRunning()) { self.armShutdown(); }
	}

	public void armShutdown() {
		if (self._shutdownTick != null) { return; }
		self._shutdown.pollCompletion();
		self._shutdownTick = NSTimer.scheduledTimerWithTimeInterval(0.01, false, MacOSShutdownWork(self), self._shutdown);
	}

	public void advanceShutdown() {
		var tick = self._shutdownTick;
		self._shutdownTick = null;
		if (tick != null) { tick.cancel(); }
		try {
			if (!self.quitRequested) { self.dispatchWindowEvents(); return; }
			var work = self._executor.pollClose();
			if (work == CALLBACK_CANCELLATION_PENDING || self._dispatchingEvents) {
				self.startShutdownDeadline();
				if (self.shutdownExpired()) { throw "Application work shutdown did not complete"; }
				self.armShutdown(); return;
			}
			if (work != CALLBACK_CANCELLATION_COMPLETE) { throw "Application work shutdown failed without completion"; }
			var result = self.closeViews();
			if (result == CALLBACK_CANCELLATION_PENDING) {
				self.startShutdownDeadline();
				if (self.shutdownExpired()) { throw "Native subtree shutdown did not complete"; }
				self.armShutdown();
			}
			else if (result == CALLBACK_CANCELLATION_COMPLETE) { self.stopNative(NSApplication.sharedApplication()); }
			else { throw "Native subtree shutdown failed without completion"; }
		} catch (string error) {
			self.recordFailure(error);
			self.quitRequested = true;
			self.stopNative(NSApplication.sharedApplication());
		}
	}

	private CallbackCancellation combineClose(CallbackCancellation result, CallbackCancellation state) {
		if (result == CALLBACK_CANCELLATION_FAILED || state == CALLBACK_CANCELLATION_FAILED) { return CALLBACK_CANCELLATION_FAILED; }
		if (result == CALLBACK_CANCELLATION_RETRYABLE_FAILURE || state == CALLBACK_CANCELLATION_RETRYABLE_FAILURE) { return CALLBACK_CANCELLATION_RETRYABLE_FAILURE; }
		return result == CALLBACK_CANCELLATION_COMPLETE && state == CALLBACK_CANCELLATION_COMPLETE ? CALLBACK_CANCELLATION_COMPLETE : CALLBACK_CANCELLATION_PENDING;
	}

	public CallbackCancellation closeViews() {
		CallbackCancellation result = CALLBACK_CANCELLATION_COMPLETE;
		for (int index = self._windows.len - 1; index >= 0; index--) {
			try {
				var state = self._windows.get(index).close();
				if (state == CALLBACK_CANCELLATION_COMPLETE) { self._windows.remove(index); }
				else { result = self.combineClose(result, state); }
			} catch (string error) { if (self._viewCloseFailure.isEmpty()) { self._viewCloseFailure = error; } }
		}
		if (!self._viewsClosing) {
			self._viewsClosing = true;
			for view in self._views {
				try {
					if (!view.isOpen()) {
						if (view.pollClose() != CALLBACK_CANCELLATION_COMPLETE) { self._closingRoots.push(view); }
						continue;
					}
					var native = (IMacOSView?)view;
					if (native == null) { throw "GUI view belongs to another provider"; }
					if (native.nativeView().superview() == null) { self._closingRoots.push(view); }
				} catch (string error) { if (self._viewCloseFailure.isEmpty()) { self._viewCloseFailure = error; } }
			}
		}
		for (int index = self._closingRoots.len - 1; index >= 0; index--) {
			try {
				var view = self._closingRoots.get(index);
				var state = view.isOpen() ? view.close() : view.pollClose();
				if (state == CALLBACK_CANCELLATION_COMPLETE) { self._closingRoots.remove(index); }
				else { result = self.combineClose(result, state); }
			} catch (string error) {
				// _views still owns this root. Remove only its progress entry:
				// an unknown close result must not trigger another native attempt.
				self._closingRoots.remove(index);
				if (self._viewCloseFailure.isEmpty()) { self._viewCloseFailure = error; }
			}
		}
		if (!self._viewCloseFailure.isEmpty()) { throw self._viewCloseFailure; }
		if (result == CALLBACK_CANCELLATION_COMPLETE) {
			for view in self._views { if (view.isOpen()) { throw "GUI view remains attached outside application ownership"; } }
			self._views.clear(); self._quitCoordinator = null; self._viewContext.setNativeQuitPending(false);
		}
		return result;
	}

	private void stopNative(NSApplication application) {
		if (!MacOSRunLoopSignal.stopApplication(application)) { throw "Cannot wake the native application for shutdown"; }
	}

	public unsigned long applicationShouldTerminate(NSApplication sender) {
		// Capture identities and hold existing transactions before returning to
		// native dispatch. Decision callbacks remain on the ordinary UI turn.
		if (!self.quitRequested) {
			try {
				if (self._quitCoordinator == null) { self._quitCoordinator = MacOSWindowQuitCoordinator(self._windows, self._viewContext); }
				if (!self._viewContext.wake.requestTurn()) { throw "Native quit wake failed"; }
			} catch (string error) { self._viewContext.recordNativeFailure(error); }
		}
		return NSTerminateCancel;
	}
}

/* Shutdown polling is native, bounded and separate from cancelable domain work.
 * Its application-owned scope outlives pending subtrees and the timer receiver. */
class MacOSShutdownWork implements IAppKitDelayedWork {
	private MacOSApplicationEvents _events;

	public MacOSShutdownWork(MacOSApplicationEvents events) { self._events = events; }

	public void invoke(NSTimer timer) { self._events.advanceShutdown(); }
}

/* The scope owns physical detach; the public attachment keeps the work result.
 * FAILED is not proof that native sources and entered callbacks have drained. */
class MacOSHostOwnerRegistration implements ICallbackRegistration {
	private MacOSHostAttachment _attachment;
	public MacOSHostOwnerRegistration(MacOSHostAttachment attachment) { self._attachment = attachment; }

	public bool isOpen() { return self._attachment.isOpen(); }

	public CallbackCancellation cancel() { self._attachment.cancel(); return self._attachment.ownerCompletion(); }

	public CallbackCancellation pollCompletion() { return self._attachment.ownerCompletion(); }
}

/* A host runs bounded turns through the same AppKit source and work owner. */
class MacOSHostAttachment implements IApplicationHostAttachment {
	private MacOSApplication? _application;
	private bool _closing = false;
	private CallbackCancellation _result = CALLBACK_CANCELLATION_NOT_REQUESTED;
	private bool _detached = false;
	public MacOSHostAttachment(MacOSApplication application) { self._application = application; }

	public void abort() { self._application = null; self._closing = true; self._detached = true; self._result = CALLBACK_CANCELLATION_COMPLETE; }

	public void applicationClosed(bool failed) { self._application = null; self._closing = true; self._detached = true; self._result = failed ? CALLBACK_CANCELLATION_FAILED : CALLBACK_CANCELLATION_COMPLETE; }

	public bool isOpen() { return !self._closing && self._application != null; }

	public void serviceTurn() {
		var application = self._application; if (application == null) { return; }
		try {
			application.serviceHostTurn();
			if (self._closing || application.quitRequested()) { self._closing = true; self.pollCompletion(); }
		} catch (string error) {
			application.recordHostFailure(error); self._closing = true;
			try { self.pollCompletion(); }
			catch (string shutdownError) { application.recordHostFailure(shutdownError); self._result = CALLBACK_CANCELLATION_FAILED; }
		}
	}

	public void transition(ApplicationActivity activity) { var application = self._application; if (application == null || self._closing) { throw "Application host is detached"; } application.transition(activity); }

	public CallbackCancellation cancel() { self._closing = true; var application = self._application; if (application != null) { application.requestQuit(); } return self.pollCompletion(); }

	public CallbackCancellation pollCompletion() {
		if (!self._closing) { return CALLBACK_CANCELLATION_NOT_REQUESTED; }
		var application = self._application; if (application == null) { return self._result; }
		self._result = application.finishHostClose();
		return self._result;
	}

	public CallbackCancellation ownerCompletion() { var result = self.pollCompletion(); return self._detached ? CALLBACK_CANCELLATION_COMPLETE : result; }
}

/* One application owner on the main thread. Desktop run() configures AppKit;
 * attachHost() preserves the host's delegate and existing native loop. */
class MacOSApplication implements IApplication {
	private ApplicationActivity _activity = APPLICATION_ACTIVITY_UNKNOWN;
	private NSApplication _application;
	private bool _running = false;
	private bool _desktopConfigured = false;
	private MacOSApplicationEvents _events;
	private CallbackScope _callbacks;
	private MacOSApplicationExecutor _executor;
	private MacOSViewContext _viewContext;
	private MacOSHostAttachment? _attachment;
	private CallbackScope _shutdown;
	private MacOSActionQueue _actions;
	private MacOSRunLoopSignal _signal;
	private Vector<MacOSWindow> _windows = [];
	private Vector<IView> _views = [];
	private bool _closing = false;
	private bool _closed = false;
	private string _closeFailure = "";

	public MacOSApplication(int workCapacity = 256) {
		self.requireMainThread();
		self._application = NSApplication.sharedApplication();
		self._signal = MacOSRunLoopSignal();
		self._actions = MacOSActionQueue(workCapacity, self._signal);
		self._shutdown = CallbackScope();
		var failure = MacOSNativeFailure();
		self._executor = MacOSApplicationExecutor(workCapacity, self._signal, failure);
		self._viewContext = MacOSViewContext(self._executor, workCapacity, failure, 16384);
		self._events = MacOSApplicationEvents(self._executor, self._viewContext, self._actions, self._windows, self._views, self._shutdown);
		self._callbacks = CallbackScope();
		try {
			self._signal.subscribe(self._events, self._callbacks);

		} catch (string error) { self.close(); throw error; }
	}

	private void configureDesktop() {
		if (self._desktopConfigured) { return; }
		self._application.setDelegate(self._events, self._callbacks);
		// Unbundled executables otherwise cannot receive keyboard focus. A
		// background session (BTRC_GUI_BACKGROUND, set by local test runs on
		// a desktop someone is using) asks for an accessory app instead: it
		// shows no Dock icon and macOS does not bring it to the front when
		// it launches, so it never takes the user's focus.
		var policy = Environment.has("BTRC_GUI_BACKGROUND") ? NSApplicationActivationPolicyAccessory : NSApplicationActivationPolicyRegular;
		if (self._application.activationPolicy() != policy && !self._application.setActivationPolicy(policy)) { throw "Cannot enable native application activation"; }
		self._application.finishLaunching();
		self._desktopConfigured = true;
	}

	private void requireMainThread() {
		if (!NSThread.isMainThread()) { throw "AppKit application dispatch requires the main thread"; }
	}

	private void requireIdle() {
		self.requireMainThread();
		if (self._closing || self._closed) { throw "Application shutdown has started"; }
	}

	public bool isRunning() { self.requireMainThread(); return self._running || self._attachment != null; }

	public void run() {
		self.requireMainThread();
		if (self._running || self._attachment != null) { throw "Native application loop is already active or host-attached"; }
		if (self._closed) { throw "Application shutdown has completed"; }
		self.configureDesktop();
		while (true) {
			if (self._events.quitRequested && self._events.pendingWork() == 0) {
				var result = self.close();
				if (result == CALLBACK_CANCELLATION_COMPLETE) { break; }
				if (result != CALLBACK_CANCELLATION_PENDING) { throw "Native subtree shutdown failed without completion"; }
				self._events.startShutdownDeadline();
				if (self._events.shutdownExpired()) {
					self._events.recordFailure("Native subtree shutdown did not complete");
					throw self._events.workFailure();
				}
			}
			if (self._events.quitRequested) { self._events.armShutdown(); }
			self._running = true;
			try { self._application.run(); } catch (string error) {
				self._running = false;
				self.close();
				throw error;
			}
			self._running = false;
			self._events.requestQuit(self._application);
		}
		if (self._events.workFailed()) { throw self._events.workFailure(); }
	}

	public ScheduleOutcome schedule(IApplicationWork work, double delaySeconds, WorkSuspensionPolicy policy, long long replacementKey) {
		self.requireMainThread(); return self._executor.schedule(work, delaySeconds, policy, replacementKey);
	}

	public ApplicationPublisherOutcome createPublisher(int capacity, IApplicationPublicationHandler handler, CallbackScope owner) {
		self.requireMainThread(); return self._executor.createPublisher(capacity, handler, owner);
	}

	public void post(IApplicationWork work) {
		var result = self.schedule(work, 0.0, WORK_SUSPENSION_DEFER, 0LL);
		if (result.kind != SCHEDULE_ACCEPTED) { throw "Application work admission failed"; }
	}

	public ICallbackRegistration postAfter(double delaySeconds, IApplicationWork work) {
		var result = self.schedule(work, delaySeconds, WORK_SUSPENSION_DEFER, 0LL);
		if (result.kind != SCHEDULE_ACCEPTED || result.registration == null) { throw "Application delayed work admission failed"; }
		return result.registration;
	}

	public ApplicationHostAttachOutcome attachHost(IApplicationHost host, CallbackScope owner) {
		self.requireMainThread();
		if (host == null || owner == null) { throw "Application host and owner are required"; }
		var result = ApplicationHostAttachOutcome(); result.attachment = null; result.error = "";
		if (self._closing || self._closed || self._events.quitRequested) { result.kind = APPLICATION_HOST_APPLICATION_CLOSED; return result; }
		if (self._attachment != null) { result.kind = APPLICATION_HOST_ALREADY_ATTACHED; return result; }
		if (self._running || self._events.eventsActive()) { result.kind = APPLICATION_HOST_APPLICATION_RUNNING; return result; }
		var attachment = MacOSHostAttachment(self);
		try { owner.track(MacOSHostOwnerRegistration(attachment)); }
		catch (string error) { attachment.abort(); result.kind = APPLICATION_HOST_ATTACH_FAILED; result.error = error; return result; }
		if (!self._executor.installHost(host)) { attachment.abort(); result.kind = APPLICATION_HOST_ATTACH_FAILED; result.error = "Publisher wake transition is busy"; return result; }
		self._attachment = attachment; result.kind = APPLICATION_HOST_ATTACHED; result.attachment = attachment;
		try { self._executor.updateDeadline(); if (!self._executor.requestTurn()) { throw "Application host wake failed"; } }
		catch (string error) { self._events.failWork(error); }
		return result;
	}

	public bool quitRequested() { self.requireMainThread(); return self._events.quitRequested; }

	public void transition(ApplicationActivity activity) {
		self.requireMainThread();
		if (activity < APPLICATION_ACTIVITY_ACTIVE || activity > APPLICATION_ACTIVITY_UNKNOWN) { throw "Invalid application activity"; }
		self._activity = activity;
		self._executor.suspend(activity == APPLICATION_ACTIVITY_SUSPENDED);
		for window in self._windows { window.applicationActivity(activity); }
	}

	public string workFailure() { self.requireMainThread(); return self._events.workFailure(); }

	public void recordHostFailure(string error) {
		self.requireMainThread(); self._events.recordFailure(error);
		try { self._events.requestQuit(self._application); } catch (string shutdownError) { self._events.recordFailure(shutdownError); }
	}

	public void serviceHostTurn() {
		self.requireMainThread(); if (self._closed || self._events.eventsActive()) { return; }
		try { self._events.serviceTurn(); } catch (string error) { self.recordHostFailure(error); }
	}

	public CallbackCancellation finishHostClose() {
		self.requireMainThread(); if (self._events.eventsActive()) { return CALLBACK_CANCELLATION_PENDING; }
		var result = self.close();
		if (result == CALLBACK_CANCELLATION_COMPLETE) { self._attachment = null; return self._events.workFailed() ? CALLBACK_CANCELLATION_FAILED : result; }
		return result;
	}

	public void requestQuit() {
		self.requireMainThread();
		if (self._closed || self._events.quitRequested) { return; }
		self._events.requestQuit(self._application);
	}

	public IWindow createWindow(string title, double width, double height) {
		self.requireCreation();
		var window = MacOSWindow(title, width, height, self._signal, self._viewContext);
		window.applicationActivity(self._activity);
		self._windows.push(window);
		return window;
	}

	private void requireCreation() {
		self.requireIdle();
		if (self._events.quitRequested) { throw "Application quit has been requested"; }
	}

	private void rememberView(IView view) {
		var native = (IMacOSView?)view;
		if (native == null) { throw "GUI view belongs to another provider"; }
		native.stateNode().configure(self._viewContext);
		for (int index = self._views.len - 1; index >= 0; index--) {
			var previous = self._views.get(index);
			if (!previous.isOpen() && previous.pollClose() == CALLBACK_CANCELLATION_COMPLETE) { self._views.remove(index); }
		}
		self._views.push(view);
	}

	public IButton createButton(string title) { self.requireCreation(); var button = MacOSButton(title, self._actions); self.rememberView(button); return button; }

	public ITextField createTextField(string text, string placeholder) { self.requireCreation(); var field = MacOSTextField(text, placeholder); self.rememberView(field); return field; }

	public IContainer createContainer() { self.requireCreation(); var container = MacOSContainer(); self.rememberView(container); return container; }

	public IStack createRow(double spacing) { self.requireCreation(); var row = MacOSStack(false, spacing); self.rememberView(row); return row; }

	public IStack createColumn(double spacing) { self.requireCreation(); var column = MacOSStack(true, spacing); self.rememberView(column); return column; }

	public IGPUView createGPUView(bool capture) { self.requireCreation(); var view = MacOSGPUView(capture); self.rememberView(view); return view; }

	public ILabel createLabel(string text) { self.requireCreation(); var view = MacOSLabel(text); self.rememberView(view); return view; }

	public IImageView createImageView() { self.requireCreation(); var view = MacOSImageView(); self.rememberView(view); return view; }

	public IPanel createPanel(RGBA fill, double radius) { self.requireCreation(); var view = MacOSPanel(fill, radius); self.rememberView(view); return view; }

	public IProgressIndicator createProgressIndicator() { self.requireCreation(); var view = MacOSProgressIndicator(); self.rememberView(view); return view; }

	public ILevelIndicator createLevelIndicator(double warning, double critical) { self.requireCreation(); var view = MacOSLevelIndicator(warning, critical); self.rememberView(view); return view; }

	public ISlider createSlider(double minimum, double maximum, int intervals) { self.requireCreation(); var view = MacOSSlider(minimum, maximum, intervals); self.rememberView(view); return view; }

	public ISelect createSelect() { self.requireCreation(); var view = MacOSSelect(); self.rememberView(view); return view; }

	public IScrollView createScrollView() { self.requireCreation(); var view = MacOSScrollView(); self.rememberView(view); return view; }

	public IGrid createGrid(int columns, int rows, double columnSpacing, double rowSpacing) { self.requireCreation(); var view = MacOSGrid(columns, rows, columnSpacing, rowSpacing); self.rememberView(view); return view; }

	public CallbackCancellation pollClose() {
		self.requireMainThread();
		return self._closed ? CALLBACK_CANCELLATION_COMPLETE : (self._closing ? self.close() : CALLBACK_CANCELLATION_NOT_REQUESTED);
	}

	public CallbackCancellation close() {
		self.requireMainThread();
		if (self._closed) { return CALLBACK_CANCELLATION_COMPLETE; }
		if (self._closeFailure != "") { throw self._closeFailure; }
		self._closing = true;
		self._events.requestQuit(self._application);
		if (self._running || self._events.eventsActive()) { return CALLBACK_CANCELLATION_PENDING; }
		var work = self._executor.close();
		if (work != CALLBACK_CANCELLATION_COMPLETE) { return work; }
		var views = self._events.closeViews();
		if (views != CALLBACK_CANCELLATION_COMPLETE) { return views; }
		if (!self._signal.close()) { return CALLBACK_CANCELLATION_PENDING; }
		try {
			if (self._shutdown.cancel() != CALLBACK_CANCELLATION_COMPLETE) { throw "Native subtree completions must drain before shutdown"; }
			if (self._callbacks.cancel() != CALLBACK_CANCELLATION_COMPLETE) { throw "Application callbacks must drain before shutdown"; }
		} catch (string error) { self._closeFailure = error; throw error; }
		release self._views;
		self._actions.close(); self._viewContext.close();
		self._closed = true;
		var attachment = self._attachment; self._attachment = null;
		if (attachment != null) { attachment.applicationClosed(self._events.workFailed()); }
		return CALLBACK_CANCELLATION_COMPLETE;
	}

	public void __del__() { if (self.close() != CALLBACK_CANCELLATION_COMPLETE) { Console.fatal("Native application destroyed before subtree cleanup completed"); } }
}
