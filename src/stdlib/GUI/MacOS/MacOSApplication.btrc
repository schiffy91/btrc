/* The external host owns its event loop and delegate. This registration owns
 * only this application's service admission; cancellation never nests a pump. */
class MacOSHostAttachment implements IApplicationHostAttachment {
	private MacOSApplication? _application;
	private bool _committed = false;
	private bool _cancelled = false;
	private bool _workFailed = false;
	public MacOSHostAttachment(MacOSApplication application) { self._application = application; }

	public void commit() { self._committed = true; }

	public bool isOpen() { var application = self._application; return self._committed && !self._cancelled && application != null && application.acceptingHost(); }

	public void serviceTurn() { var application = self._application; if (self._committed && application != null) { application.serviceHostTurn(); } }

	public void transition(ApplicationActivity activity) { var application = self._application; if (self.isOpen() && application != null) { application.transitionHost(activity); } }

	/* The one lifecycle owner separates drained resources from the sticky
	 * operation outcome. A native cleanup failure never becomes COMPLETE. */
	public CallbackCancellation drain(bool cancel) {
		if (cancel) { self._cancelled = true; }
		if (!self._committed) { self._application = null; return CALLBACK_CANCELLATION_COMPLETE; }
		var application = self._application;
		if (application == null) { return CALLBACK_CANCELLATION_COMPLETE; }
		CallbackCancellation result = CALLBACK_CANCELLATION_NOT_REQUESTED;
		if (cancel) { result = application.close(); } else { result = application.pollClose(); }
		if (result == CALLBACK_CANCELLATION_COMPLETE) { self._workFailed = application.hostWorkFailed(); self._application = null; }
		return result;
	}

	public CallbackCancellation cancel() { var result = self.drain(true); if (result == CALLBACK_CANCELLATION_COMPLETE && self._workFailed) { return CALLBACK_CANCELLATION_FAILED; } return result; }

	public CallbackCancellation pollCompletion() { var result = self.drain(false); if (result == CALLBACK_CANCELLATION_COMPLETE && self._workFailed) { return CALLBACK_CANCELLATION_FAILED; } return result; }
}

/* CallbackScope owns resource cleanup, not the public work outcome. This
 * projection stores no lifecycle state and delegates to the same attachment. */
class MacOSHostCleanup implements ICallbackRegistration {
	private MacOSHostAttachment _attachment;
	public MacOSHostCleanup(MacOSHostAttachment attachment) { self._attachment = attachment; }

	public bool isOpen() { return self._attachment.isOpen(); }

	public CallbackCancellation cancel() { return self._attachment.drain(true); }

	public CallbackCancellation pollCompletion() { return self._attachment.drain(false); }
}

/* The internal loop is one host of the same executor, not a second work lane. */
class MacOSApplicationHost implements IApplicationHost {
	private MacOSRunLoopSignal _signal;
	public MacOSApplicationHost(MacOSRunLoopSignal signal) { self._signal = signal; }

	public bool requestTurn() { return self._signal.tryWake(); }

	public void scheduleTurn(unsigned long long deadline) { self._signal.scheduleTurn(deadline); }
}

class MacOSApplication implements IApplication, IAppKitNotificationObserver, IAppKitApplicationEvents {
	private bool _initialized = false;
	private NSApplication _application;
	private CallbackScope _callbacks = CallbackScope();
	private CallbackScope _runCallbacks = CallbackScope();
	private CallbackScope _runOwner = CallbackScope();
	private MacOSActionQueue _actions;
	private MacOSRunLoopSignal _signal;
	private MacOSWorkQueue _workQueue;
	private MacOSControlContext? _context;
	private Vector<MacOSWindow> _windows = [];
	private bool _nativeQuitPending = false;
	private Vector<MacOSWindowQuitAuthorization> _nativeQuitMembers = [];
	private Vector<IView> _views = [];
	private Vector<IView> _closingRoots = [];
	private Vector<MacOSPublisher> _publishers = [];
	private bool _viewsClosing = false;
	private string _viewCloseFailure = "";
	private IApplicationHost? _host;
	private MacOSHostAttachment? _attachment;
	private bool _running = false;
	private bool _standalone = false;
	private bool _turnActive = false;
	private bool _closeAdvancing = false;
	private bool _turnRequested = false;
	private bool _closing = false;
	private bool _closed = false;
	private bool _failed = false;
	private string _failure = "";
	private ApplicationActivity _activity = APPLICATION_ACTIVITY_UNKNOWN;
	private int _publisherSlots = 0;
	private int _publisherCursor = 0;
	private int _windowCursor = 0;
	private int _classCursor = 0;
	private Timer _shutdownClock = Timer();
	private bool _shutdownTimed = false;

	public MacOSApplication(int workCapacity = 256) {
		self.requireMainThread();
		self._application = NSApplication.sharedApplication();
		self._signal = MacOSRunLoopSignal(false);
		self._actions = MacOSActionQueue(workCapacity, self._signal);
		var context = MacOSControlContext(workCapacity, self._signal);
		self._context = context;
		self._workQueue = MacOSWorkQueue(workCapacity, self._signal, context.wake);
		self._initialized = true;
	}

	private void requireMainThread() { if (!NSThread.isMainThread()) { throw "AppKit application dispatch requires the main thread"; } }

	public void requireNoCloseDecision() { self.controlContext().requireNoCloseDecision(); }

	private void requireIdle() { self.requireMainThread(); if (self._closing || self._closed) { throw "Application shutdown has started"; } }

	public bool acceptingHost() { self.requireMainThread(); return !self._closing && !self._closed && self._attachment != null; }

	public bool isRunning() { self.requireMainThread(); return !self._closed && (self._running || self._attachment != null); }

	public ApplicationHostAttachOutcome attachHost(IApplicationHost host, CallbackScope owner) {
		self.requireMainThread();
		var result = ApplicationHostAttachOutcome(); result.attachment = null; result.error = "";
		if (self._closed || self._closing) { result.kind = APPLICATION_HOST_APPLICATION_CLOSED; return result; }
		if (self._running) { result.kind = APPLICATION_HOST_APPLICATION_RUNNING; return result; }
		if (self._attachment != null) { result.kind = APPLICATION_HOST_ALREADY_ATTACHED; return result; }
		result.kind = APPLICATION_HOST_ATTACH_FAILED;
		var attachment = MacOSHostAttachment(self);
		int locked = 0;
		bool committed = false;
		try {
			if (host == null || !owner.isOpen()) { throw "Host attachment requires a host and an open owner"; }
			/* The host promises non-inline, nonblocking wake admission. Do this
			 * before native publication and without borrowing a publisher lock. */
			if (!host.requestTurn()) { throw "Application host rejected attachment wake"; }
			for publisher in self._publishers {
				if (!publisher.beginHostChange()) { throw "Application publisher is notifying its existing host"; }
				locked++;
			}
			owner.track(MacOSHostCleanup(attachment));
			self._signal.subscribe(self, self._callbacks);
			for publisher in self._publishers { publisher.setHostLocked(host); }
			self.controlContext().wake.host = host;
			self._host = host; self._attachment = attachment;
			attachment.commit(); committed = true;
			result.kind = APPLICATION_HOST_ATTACHED; result.attachment = attachment;
		} catch (string error) { result.error = error; }
		finally { for (int index = locked - 1; index >= 0; index--) { self._publishers.get(index).endHostChange(); } }
		if (!committed) { attachment.cancel(); }
		return result;
	}

	private void prunePublishers() {
		for (int index = self._publishers.len - 1; index >= 0; index--) {
			var publisher = self._publishers.get(index);
			if (!publisher.isOpen() && publisher.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE) {
				self._publisherSlots -= publisher.capacity(); self._publishers.remove(index);
			}
		}
	}

	/* A separately declared bounded ingress budget: at most 4096 POD slots
	 * and 256 live producer channels, independent of workCapacity. */
	public ApplicationPublisherOutcome createPublisher(int capacity, IApplicationPublicationHandler handler, CallbackScope owner) {
		self.requireMainThread();
		if (capacity <= 0 || capacity > 65536 || handler == null) { throw "Invalid application publisher"; }
		var result = ApplicationPublisherOutcome(); result.publisher = null; result.registration = null;
		if (self._closing || self._closed) { result.kind = APPLICATION_PUBLISHER_CLOSED; return result; }
		self.prunePublishers();
		if (capacity > 4096 - self._publisherSlots || self._publishers.len >= 256) { result.kind = APPLICATION_PUBLISHER_BUDGET_EXHAUSTED; return result; }
		var publisher = MacOSPublisher(capacity, self._signal, self._host);
		if (!publisher.initialized()) { result.kind = APPLICATION_PUBLISHER_RESOURCE_FAILED; return result; }
		publisher.activate(handler, owner);
		publisher.suspend(self._activity == APPLICATION_ACTIVITY_SUSPENDED);
		self._publishers.push(publisher); self._publisherSlots += capacity;
		result.kind = APPLICATION_PUBLISHER_CREATED; result.publisher = publisher; result.registration = publisher;
		return result;
	}

	public ScheduleOutcome schedule(IApplicationWork work, double delaySeconds, WorkSuspensionPolicy policy, long long replacementKey) { self.requireMainThread(); return self._workQueue.schedule(work, delaySeconds, policy, replacementKey); }

	public void post(IApplicationWork work) { self.requireIdle(); self._workQueue.post(work); }

	public ICallbackRegistration postAfter(double delaySeconds, IApplicationWork work) { self.requireIdle(); return self._workQueue.postAfter(delaySeconds, work); }

	public bool hostWorkFailed() { self.requireMainThread(); return self._failed; }

	private void recordFailure(string error) {
		if (!self._failed) { self._failed = true; self._failure = error; Console.error(error); }
	}

	private void failHost(string error) {
		self.recordFailure(error);
		try { self.requestQuit(); } catch (string closeError) { self.recordFailure(closeError); }
		if (self._running) { MacOSRunLoopSignal.stopApplication(self._application); }
	}

	private void requestHostTurn() {
		var host = self._host;
		if (host == null || self._closed) { return; }
		if (!host.requestTurn()) { throw "Application host rejected service wake"; }
	}

	/* Native dispatch requests a host turn. Only the standalone host services
	 * from this CF source; external hosts retain control of service timing. */
	public void invoke(NSNotification notification) {
		try {
			if (self._standalone) { self.serviceHostTurn(); }
			else { self.requestHostTurn(); }
		} catch (string error) { self.failHost(error); }
	}

	public void transitionHost(ApplicationActivity activity) {
		self.requireMainThread();
		if (activity < APPLICATION_ACTIVITY_ACTIVE || activity > APPLICATION_ACTIVITY_UNKNOWN) { self.recordFailure("Invalid host application activity"); self.requestQuit(); return; }
		if (self._closing || self._closed) { return; }
		try {
			self._activity = activity;
			bool suspended = activity == APPLICATION_ACTIVITY_SUSPENDED;
			self._workQueue.suspend(suspended);
			for publisher in self._publishers { publisher.suspend(suspended); }
			for window in self._windows { window.setApplicationActivity(activity); }
			self.requestHostTurn();
		} catch (string error) { self.failHost(error); }
	}

	/* Five provider classes rotate under 64 dequeue opportunities and a 2ms
	 * monotonic budget. A posted work item cannot enter its posting round. */
	public void serviceHostTurn() {
		self.requireMainThread();
		if (self._closed || self._host == null) { return; }
		if (self._turnActive || self._closeAdvancing) { self._turnRequested = true; return; }
		var context = self._context;
		if (context == null) { return; }
		if (context.mutating() || context.deliveryActive()) { self._turnRequested = true; context.deferService(); return; }
		self._turnActive = true;
		self._turnRequested = false;
		try {
			if (!self._closing) {
				self.advanceNativeQuit();
			}
			if (!self._closing) {
				self.prunePublishers();
				long long round = self._workQueue.beginRound();
				int actions = self._actions.pendingCount();
				int windows = self._windows.len;
				Vector<MacOSPublisher> roundPublishers = [];
				Vector<int> publications = [];
				for publisher in self._publishers {
					roundPublishers.push(publisher);
					int pending = 0; if (publisher.pending()) { pending = publisher.pendingCount(); }
					publications.push(pending);
				}
				int publisherVisits = publications.len;
				unsigned long long started = MacOSRunLoopSignal.monotonicNowNs();
				int idle = 0;
				for (int count = 0; count < 64 && !self._closing && idle < 5; count++) {
					if (MacOSRunLoopSignal.monotonicNowNs() - started >= 2000000ULL) { self._turnRequested = true; break; }
					int lane = self._classCursor; self._classCursor = (lane + 1) % 5;
					bool delivered = false;
					if (lane == 0) { delivered = self._workQueue.serviceOne(round); }
					else if (lane == 1 && publications.len > 0 && publisherVisits > 0) {
						int index = self._publisherCursor % publications.len; self._publisherCursor = (index + 1) % publications.len;
						publisherVisits--; delivered = true;
						if (publications.get(index) > 0) {
							publications.set(index, publications.get(index) - 1); roundPublishers.get(index).deliverOne();
							if (publications.get(index) > 0) { publisherVisits++; }
						}
					}
					else if (lane == 2 && windows > 0 && self._windows.len > 0) {
						int index = self._windowCursor % self._windows.len; self._windowCursor = (index + 1) % self._windows.len; windows--;
						var window = self._windows.get(index);
						if (!self._standalone) { window.setApplicationActivity(self._activity); }
						window.dispatchPendingEvents(); delivered = true;
						if (!window.isOpen() && window.pollClose() == CALLBACK_CANCELLATION_COMPLETE) { self._windows.remove(index); self._windowCursor = index; }
						else if (window.pendingEvents()) { self._turnRequested = true; }
					}
					else if (lane == 3) { delivered = context.dispatchOne(context.detachedEvents); }
					else if (lane == 4 && actions > 0 && self._activity != APPLICATION_ACTIVITY_SUSPENDED) { actions--; self._actions.dispatchOne(); delivered = true; }
					if (delivered) { idle = 0; } else { idle++; }
					/* A decision may cancel its whole group. Resolve peers before
					 * another queued decision can enter its receiver. */
					self.advanceNativeQuit();
				}
				if (self._workQueue.failed()) { throw "Application work wake failed"; }
				for publisher in self._publishers { if (publisher.failed()) { throw "Application publication wake failed"; } if (publisher.pending()) { self._turnRequested = true; } }
				self.advanceNativeQuit();
				if (windows > 0 || publisherVisits > 0 || context.pendingInput() > 0 || context.detachedEvents.pendingCount() > 0 || (self._activity != APPLICATION_ACTIVITY_SUSPENDED && self._actions.pendingCount() > 0)) { self._turnRequested = true; }
			}
		} catch (string error) { self.failHost(error); }
		finally { self._turnActive = false; }
		try {
			if (self._closing) { self.advanceClose(); }
			else {
				var host = self._host;
				if (host != null) { host.scheduleTurn(self._workQueue.nextDeadline()); }
				if (self._turnRequested) { self.requestHostTurn(); }
			}
		} catch (string error) { self.failHost(error); }
	}

	/* Native ingress only holds existing authority and schedules an executor
	 * turn. In particular, a pending save cannot consume its authorization
	 * after terminate returns but before the calling receiver unwinds. */
	private void captureNativeQuit() {
		self.requireMainThread();
		if (self._closing || self._closed) { return; }
		self._nativeQuitPending = true;
		for window in self._windows { window.holdNativeQuit(); }
		/* Unwind a modal receiver without closing any window. Its outer host
		 * turn must return before the executor can deliver quit decisions. */
		if (self._standalone && self._application.modalWindow() != null) { self._application.stopModalWithCode(NSModalResponseAbort); }
		if (!self._signal.tryWake()) { throw "Native application quit wake failed"; }
	}

	private void cancelNativeQuit() {
		self._nativeQuitPending = false;
		/* Retain member/registration identities until every held transaction
		 * has been cancelled. Normal work/publication ingress remains open. */
		for window in self._windows { window.cancelNativeQuit(); }
		for member in self._nativeQuitMembers { member.window.cancelNativeQuit(); }
		self._nativeQuitMembers = [];
	}

	private void admitNativeQuit() {
		Vector<MacOSWindowQuitAuthorization> members = [];
		for window in self._windows {
			if (!window.isOpen()) { continue; }
			MacOSWindowQuitAuthorization? previous = null;
			for member in self._nativeQuitMembers { if (member.window == window) { previous = member; break; } }
			if (previous != null && window.matchesNativeQuit(previous)) { members.push(previous); }
			else { members.push(window.prepareNativeQuit()); }
		}
		self._nativeQuitMembers = members;
	}

	private void advanceNativeQuit() {
		if (!self._nativeQuitPending || self._closing) { return; }
		var context = self._context;
		if (context == null || context.mutating() || context.deliveryActive()) { return; }
		for member in self._nativeQuitMembers {
			if (member.window.nativeQuitCancelled() || !member.window.isOpen()) { self.cancelNativeQuit(); return; }
		}
		for window in self._windows { if (window.nativeQuitCancelled()) { self.cancelNativeQuit(); return; } }
		/* Admission may reserve/publish existing channel terminals. If any
		 * admission fails, retire all partial group responsibility before the
		 * existing host failure policy handles the error. */
		try { self.admitNativeQuit(); }
		catch (string error) { self.cancelNativeQuit(); throw error; }
		for member in self._nativeQuitMembers {
			if (member.transaction.state() != WINDOW_CLOSE_AUTHORIZED) { return; }
			member.revision = member.transaction.reportedRevision();
		}
		/* Allocate/retain the ingress snapshot before validation. Neither the
		 * checks, scalar consumption nor sealQuit's admission prefix invokes
		 * callbacks, drops user-owned references or pumps native events. */
		Vector<MacOSPublisher> publishers = [];
		for publisher in self._publishers { publishers.push(publisher); }
		int index = 0;
		for window in self._windows {
			if (!window.isOpen()) { continue; }
			if (index >= self._nativeQuitMembers.len) { throw "Native quit membership changed during validation"; }
			var member = self._nativeQuitMembers.get(index++);
			if (member.window != window || !window.matchesNativeQuit(member) || member.transaction.state() != WINDOW_CLOSE_AUTHORIZED || member.transaction.reportedRevision() != member.revision) { throw "Native quit authority changed during validation"; }
		}
		if (index != self._nativeQuitMembers.len) { throw "Native quit membership changed during validation"; }
		for member in self._nativeQuitMembers { member.transaction.consumeHeldAuthorization(); }
		self.sealQuit(publishers);
	}

	/* The retained publisher and window member snapshots survive this entire
	 * prefix. Seal all ingress before any cancel/prune can run user finalizers. */
	private void sealQuit(Vector<MacOSPublisher> publishers) {
		self._closing = true; self._nativeQuitPending = false;
		self._workQueue.seal();
		for publisher in publishers { publisher.seal(); }
		bool advancing = self._closeAdvancing; self._closeAdvancing = true;
		try {
			for window in self._windows { window.sealNativeQuit(); }
			if (self._workQueue.failed()) { self.recordFailure("Application work wake failed"); }
			for publisher in publishers { if (publisher.failed()) { self.recordFailure("Application publication wake failed"); } }
			self.cancelIngress(publishers);
			self._nativeQuitMembers = [];
			if (self._standalone && self._application.modalWindow() != null) { self._application.stopModalWithCode(NSModalResponseAbort); }
			/* Wake only after sealing all ingress; producer cancellation retains
			 * its borrowed host until that producer leaves. */
			self._signal.tryWake();
			var host = self._host;
			if (host != null) { try { if (!host.requestTurn()) { self.recordFailure("Application host rejected shutdown wake"); } } catch (string error) { self.recordFailure(error); } }
		} finally { self._closeAdvancing = advancing; }
	}

	public void requestQuit() {
		self.requireMainThread();
		if (self._closed || self._closing) { return; }
		Vector<MacOSPublisher> publishers = [];
		for publisher in self._publishers { publishers.push(publisher); }
		self.sealQuit(publishers);
	}

	public unsigned long applicationShouldTerminate(NSApplication sender) { try { self.captureNativeQuit(); } catch (string error) { self.failHost(error); } return NSTerminateCancel; }

	public void run() {
		self.requireIdle();
		if (self._running || self._attachment != null) { throw "Native application loop is already active"; }
		/* The scoped native setter rejects an occupied delegate before publication.
		 * Admit it before the run/teardown transaction so rejection leaves this owner open. */
		self._application.setDelegate(self, self._runCallbacks);
		bool failed = false; string failure = "";
		try {
			if (self._application.activationPolicy() != NSApplicationActivationPolicyRegular && !self._application.setActivationPolicy(NSApplicationActivationPolicyRegular)) { throw "Cannot enable native application activation"; }
			self._application.finishLaunching();
			var attached = self.attachHost(MacOSApplicationHost(self._signal), self._runOwner);
			if (attached.kind != APPLICATION_HOST_ATTACHED) { throw attached.error; }
			self._standalone = true; self._running = true;
			self._application.run();
		} catch (string error) { failed = true; failure = error; }
		finally { self._running = false; }
		self.requestQuit();
		var result = self.close();
		if (result != CALLBACK_CANCELLATION_COMPLETE) { throw "Native application shutdown remains pending"; }
		if (failed) { throw failure; }
		if (self._failed) { throw self._failure; }
	}

	public IWindow createWindow(string title, double width, double height) {
		self.requireCreation();
		var window = MacOSWindow(title, width, height, self._signal, self.controlContext());
		if (self._attachment != null && !self._standalone) { window.setApplicationActivity(self._activity); }
		if (self._nativeQuitPending) { window.holdNativeQuit(); }
		self._windows.push(window);
		return window;
	}

	private void requireCreation() { self.requireIdle(); }

	/* Every application factory passes this explicit owner. Standalone native
	 * constructors may use their compatibility context, but never determine an
	 * application's semantic pool or its lifetime. */
	private MacOSControlContext controlContext() {
		self.requireCreation();
		var context = self._context;
		if (context == null) { throw "Application semantic ownership is unavailable"; }
		return context;
	}

	private void rememberView(IView view) {
		for (int index = self._views.len - 1; index >= 0; index--) {
			var previous = self._views.get(index);
			if (!previous.isOpen() && previous.pollClose() == CALLBACK_CANCELLATION_COMPLETE) { self._views.remove(index); }
		}
		self._views.push(view);
	}

	public IButton createButton(string title) { self.requireCreation(); var button = MacOSButton(title, self._actions, self.controlContext()); self.rememberView(button); return button; }

	public ITextField createTextField(string text, string placeholder) { self.requireCreation(); var field = MacOSTextField(text, placeholder, self.controlContext()); self.rememberView(field); return field; }

	public IContainer createContainer() { self.requireCreation(); var container = MacOSContainer(null, self.controlContext()); self.rememberView(container); return container; }

	public IStack createRow(double spacing) { self.requireCreation(); var row = MacOSStack(false, spacing, self.controlContext()); self.rememberView(row); return row; }

	public IStack createColumn(double spacing) { self.requireCreation(); var column = MacOSStack(true, spacing, self.controlContext()); self.rememberView(column); return column; }

	public IGPUView createGPUView(bool capture) { self.requireCreation(); var view = MacOSGPUView(capture, self.controlContext()); self.rememberView(view); return view; }

	public ILabel createLabel(string text) { self.requireCreation(); var view = MacOSLabel(text, self.controlContext()); self.rememberView(view); return view; }

	public IImageView createImageView() { self.requireCreation(); var view = MacOSImageView(self.controlContext()); self.rememberView(view); return view; }

	public IPanel createPanel(RGBA fill, double radius) { self.requireCreation(); var view = MacOSPanel(fill, radius, self.controlContext()); self.rememberView(view); return view; }

	public IProgressIndicator createProgressIndicator() { self.requireCreation(); var view = MacOSProgressIndicator(self.controlContext()); self.rememberView(view); return view; }

	public ILevelIndicator createLevelIndicator(double warning, double critical) { self.requireCreation(); var view = MacOSLevelIndicator(warning, critical, self.controlContext()); self.rememberView(view); return view; }

	public ISlider createSlider(double minimum, double maximum, int intervals) { self.requireCreation(); var view = MacOSSlider(minimum, maximum, intervals, self.controlContext()); self.rememberView(view); return view; }

	public ISelect createSelect() { self.requireCreation(); var view = MacOSSelect(self.controlContext()); self.rememberView(view); return view; }

	public IScrollView createScrollView() { self.requireCreation(); var view = MacOSScrollView(self.controlContext()); self.rememberView(view); return view; }

	public IGrid createGrid(int columns, int rows, double columnSpacing, double rowSpacing) { self.requireCreation(); var view = MacOSGrid(columns, rows, columnSpacing, rowSpacing, self.controlContext()); self.rememberView(view); return view; }

	private CallbackCancellation combineClose(CallbackCancellation result, CallbackCancellation state) {
		if (result == CALLBACK_CANCELLATION_FAILED || state == CALLBACK_CANCELLATION_FAILED) { return CALLBACK_CANCELLATION_FAILED; }
		if (result == CALLBACK_CANCELLATION_RETRYABLE_FAILURE || state == CALLBACK_CANCELLATION_RETRYABLE_FAILURE) { return CALLBACK_CANCELLATION_RETRYABLE_FAILURE; }
		return result == CALLBACK_CANCELLATION_COMPLETE && state == CALLBACK_CANCELLATION_COMPLETE ? CALLBACK_CANCELLATION_COMPLETE : CALLBACK_CANCELLATION_PENDING;
	}

	public CallbackCancellation closeViews() {
		CallbackCancellation result = CALLBACK_CANCELLATION_COMPLETE;
		for (int index = self._windows.len - 1; index >= 0; index--) {
			try {
				var state = self._windows.get(index).close();
				if (state == CALLBACK_CANCELLATION_COMPLETE) { self._windows.remove(index); }
				else { result = self.combineClose(result, state); }
			} catch (string error) { if (self._viewCloseFailure.isEmpty()) { self._viewCloseFailure = error; } }
		}
		if (!self._viewsClosing) {
			self._viewsClosing = true;
			for view in self._views {
				try {
					if (!view.isOpen()) {
						if (view.pollClose() != CALLBACK_CANCELLATION_COMPLETE) { self._closingRoots.push(view); }
						continue;
					}
					var native = (IMacOSView?)view;
					if (native == null) { throw "GUI view belongs to another provider"; }
					if (native.nativeView().superview() == null) { self._closingRoots.push(view); }
				} catch (string error) { if (self._viewCloseFailure.isEmpty()) { self._viewCloseFailure = error; } }
			}
		}
		for (int index = self._closingRoots.len - 1; index >= 0; index--) {
			try {
				var view = self._closingRoots.get(index);
				var state = view.isOpen() ? view.close() : view.pollClose();
				if (state == CALLBACK_CANCELLATION_COMPLETE) { self._closingRoots.remove(index); }
				else { result = self.combineClose(result, state); }
			} catch (string error) {
				// _views still owns this root. Remove only its progress entry:
				// an unknown close result must not trigger another native attempt.
				self._closingRoots.remove(index);
				if (self._viewCloseFailure.isEmpty()) { self._viewCloseFailure = error; }
			}
		}
		if (!self._viewCloseFailure.isEmpty()) { throw self._viewCloseFailure; }
		if (result == CALLBACK_CANCELLATION_COMPLETE) {
			for view in self._views { if (view.isOpen()) { throw "GUI view remains attached outside application ownership"; } }
			self._views.clear();
		}
		return result;
	}

	/* Retry the existing owners, including untouched admissions after an
	 * earlier exception. Attempt every producer while preserving first error. */
	private CallbackCancellation cancelIngress(Vector<MacOSPublisher> publishers) {
		CallbackCancellation result = CALLBACK_CANCELLATION_COMPLETE;
		bool failed = false; string failure = "";
		try { result = self._workQueue.cancel(); }
		catch (string error) { failed = true; failure = error; }
		for publisher in publishers {
			try { result = self.combineClose(result, publisher.cancel()); }
			catch (string error) { if (!failed) { failed = true; failure = error; } }
		}
		if (failed) { throw failure; }
		return result;
	}

	private CallbackCancellation advanceClose() {
		if (self._turnActive || self._closeAdvancing) { return CALLBACK_CANCELLATION_PENDING; }
		var activeContext = self._context;
		if (activeContext != null && (activeContext.mutating() || activeContext.deliveryActive())) { activeContext.deferService(); return CALLBACK_CANCELLATION_PENDING; }
		self._closeAdvancing = true;
		CallbackCancellation result = CALLBACK_CANCELLATION_PENDING;
		try { result = self.drainClose(); }
		finally { self._closeAdvancing = false; }
		return result;
	}

	private CallbackCancellation drainClose() {
		var ingress = self.cancelIngress(self._publishers);
		if (ingress != CALLBACK_CANCELLATION_COMPLETE) { return ingress; }
		self._nativeQuitMembers = [];
		var views = self.closeViews();
		if (views != CALLBACK_CANCELLATION_COMPLETE) {
			if (self._running) {
				if (!self._shutdownTimed) { self._shutdownClock.start(); self._shutdownTimed = true; }
				if ((double)self._shutdownClock.elapsed() >= 10.0) { MacOSRunLoopSignal.stopApplication(self._application); throw "Native subtree shutdown did not complete"; }
				self._signal.scheduleTurn(MacOSRunLoopSignal.monotonicNowNs() + 10000000ULL);
			}
			return views;
		}
		if (self._running) { if (!MacOSRunLoopSignal.stopApplication(self._application)) { throw "Cannot wake the native application for shutdown"; } return CALLBACK_CANCELLATION_PENDING; }
		var host = self._host;
		if (host != null) { try { host.scheduleTurn(0ULL); } catch (string error) { self.recordFailure(error); } }
		if (self._signal.requestClose() != CALLBACK_CANCELLATION_COMPLETE) { return CALLBACK_CANCELLATION_PENDING; }
		if (self._callbacks.cancel() != CALLBACK_CANCELLATION_COMPLETE || self._runCallbacks.cancel() != CALLBACK_CANCELLATION_COMPLETE) { return CALLBACK_CANCELLATION_PENDING; }
		self._actions.close();
		var context = self._context;
		if (context != null) { context.close(); self._context = null; }
		self._publishers.clear(); self._publisherSlots = 0;
		self._host = null; self._closed = true; self._attachment = null;
		self._runOwner.pollCompletion();
		return CALLBACK_CANCELLATION_COMPLETE;
	}

	public CallbackCancellation pollClose() { self.requireMainThread(); if (self._closed) { return CALLBACK_CANCELLATION_COMPLETE; } if (!self._closing) { return CALLBACK_CANCELLATION_NOT_REQUESTED; } return self.advanceClose(); }

	public CallbackCancellation close() {
		self.requireMainThread();
		if (self._closed) { return CALLBACK_CANCELLATION_COMPLETE; }
		var context = self._context;
		if (context != null && context.mutating()) { throw "Cannot close application during native mutation"; }
		self.requestQuit();
		return self.advanceClose();
	}

	public void __del__() { if (self._initialized && self.close() != CALLBACK_CANCELLATION_COMPLETE) { Console.fatal("Native application destroyed before subtree cleanup completed"); } }
}
