/* One interaction retains its prospective draft and both terminal outcomes.
 * Completion transfers this owner out before a queue wake can reenter. */
class MacOSSelectAdmission {
	public ControlEventPublication<ISelectionControlEventHandler, SelectionControlEvent>? changed;
	public ControlEventTicket? commit;
	public ControlEventTicket? cancel;
	public void retire() {
		var changed = self.changed;
		if (changed != null) { changed.abort(); self.changed = null; }
		var commit = self.commit;
		if (commit != null && !commit.queued()) { commit.retire(); }
		var cancel = self.cancel;
		if (cancel != null && !cancel.queued()) { cancel.retire(); }
		self.commit = null; self.cancel = null;
	}

	public void __del__() { self.retire(); }
}

class MacOSSelectEntry {
