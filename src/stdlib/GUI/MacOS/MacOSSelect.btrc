}

class MacOSSelectItemFactory implements IAppKitSelectItemAccessibilityFactory {
	private MacOSSelectItem _receiver;
	public MacOSSelectItemFactory(MacOSSelectItem receiver) { self._receiver = receiver; }

	public IAppKitSelectItemAccessibility create() { return self._receiver; }
}

