	public bool beforeAction(long index) { return self._owner.beforeMenuAction(self._revision, index); }

	public void afterAction(bool invokedSuper, bool nativeFailed) { self._owner.afterNative(nativeFailed); }

	public bool beforeKey(NSEvent event) { return self._owner.beforeMenuKey(self._revision); }

	public void afterKey(bool invokedSuper, bool nativeFailed) { self._owner.afterNative(nativeFailed); }
