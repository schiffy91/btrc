		if (model == null || model.options == null || model.statusText == null) { throw "Selection model has missing required data"; }
		if (model.availability != SELECT_AVAILABILITY_READY && model.availability != SELECT_AVAILABILITY_EMPTY && model.availability != SELECT_AVAILABILITY_LOADING && model.availability != SELECT_AVAILABILITY_ERROR) { throw "Unknown selection availability"; }
		if ((model.availability == SELECT_AVAILABILITY_EMPTY && (model.options.len != 0 || model.selectedKey != null)) || (model.availability == SELECT_AVAILABILITY_READY && model.options.len == 0)) { throw "Selection availability conflicts with its options"; }
		Vector<string> keys = []; Vector<string> titles = []; Vector<bool> enabled = []; var seen = new Set<string>(); int selected = -1;
		int index = 0;
		bool identical = model.availability == self._availability && model.statusText.equals(self._statusText) && MacOSSelect.sameKey(model.selectedKey, self.keyAt(self._selected)) && model.options.len == self._keys.len;
		for option in model.options {
			if (option == null || option.key == null || option.key.isEmpty() || option.title == null || seen.contains(option.key)) { throw "Selection option has an invalid or duplicate key or title"; }
			seen.add(option.key); keys.push(option.key); titles.push(option.title); enabled.push(option.enabled);
			if (MacOSSelect.sameKey(option.key, model.selectedKey)) { selected = index; }
			if (identical && (!self._keys.get(index).equals(option.key) || !self._titles.get(index).equals(option.title) || self._enabledItems.get(index) != option.enabled)) { identical = false; }
			index++;
		}
		if (model.selectedKey != null && selected < 0) { throw "Selection key is missing from options"; }
		if (identical) { return; }
		if (self._modelRevision == 9223372036854775807LL) { throw "Selection model revisions exhausted"; }
		var callbacks = CallbackScope();
		var menu = NSMenu.initWithTitle(MacOSSelectMenu(self, self._modelRevision + 1LL), callbacks, AppKitText.nativeValue("")); if (menu == null) { throw "Cannot create native selection menu"; }
		menu.setAutoenablesItems(false);
		for (int itemIndex = 0; itemIndex < titles.len; itemIndex++) {
			var receiver = MacOSSelectItem(self, self._modelRevision + 1LL, itemIndex); callbacks.track(receiver);
			var item = NSMenuItem.initWithTitle(MacOSSelectItemFactory(receiver), AppKitText.nativeValue(titles.get(itemIndex)), null, AppKitText.nativeValue("")); if (item == null) { throw "Cannot create native selection item"; }
			item.setEnabled(enabled.get(itemIndex) && model.availability == SELECT_AVAILABILITY_READY); menu.addItem(item);
		}
		var presentation = NSMenuItem.new(); if (presentation == null) { throw "Cannot create selection status presentation"; }
		presentation.setTitle(AppKitText.nativeValue(selected < 0 ? model.statusText : titles.get(selected)));
		var cell = self.cell();
		menu.setDelegate(self, callbacks);
		self._publishingModel = true;
		try {
			try {
				self.cancelMenu(CONTROL_ORIGIN_MODEL, CONTROL_CANCEL_MODEL_REPLACEMENT);
				self.control().setMenu(menu); self.control().selectItemAtIndex(selected);
				cell.setUsesItemFromMenu(false); cell.setMenuItem(presentation);
			} catch (string error) {
				bool restored = false;
				try { self.control().setMenu(self._menu); self.control().selectItemAtIndex(self._selected); cell.setMenuItem(self._presentation); restored = true; }
				catch (string rollback) {
					self._failedMenu = menu; self._failedMenuCallbacks = callbacks;
					self.stateNode().quarantine(); self.nativeFailure(rollback);
				}
				if (restored) { callbacks.cancel(); }
				throw error;
			}
			self._menuCallbacks.cancel(); self._menuCallbacks = callbacks; self._menu = menu; self._presentation = presentation;
			self._keys = keys; self._titles = titles; self._enabledItems = enabled; self._selected = selected;
			self._availability = model.availability; self._statusText = model.statusText; self._modelRevision++; self._highlight = selected;
		} finally { self._publishingModel = false; }
	}

	public void setSelectedKey(string? key) {
		self.stateNode().requireMutation(); self.control(); if (MacOSSelect.sameKey(key, self.keyAt(self._selected))) { return; }
		var model = self.optionsState(); model.selectedKey = key; self.setOptions(model);
	}

	/* Each index replacement starts a fresh reserved-key session. Titles never
	 * define identity, even when two rows display exactly the same text. */
	public void setItems(Vector<string> titles, int selectedIndex) {
		self.stateNode().requireMutation(); self.control(); if (titles == null) { throw "Native selection items are missing"; } self.validateSelection(titles.len, selectedIndex);
		if (self._legacyRevision == 9223372036854775807LL) { throw "Legacy selection replacements exhausted"; }
		long long revision = self._legacyRevision + 1LL; var model = SelectModel(); model.options = []; model.selectedKey = null; model.availability = titles.len == 0 ? SELECT_AVAILABILITY_EMPTY : SELECT_AVAILABILITY_READY; model.statusText = "";
		for (int index = 0; index < titles.len; index++) { var option = SelectOption(); option.key = f"btrc:legacy:{revision}:{index}"; option.title = titles.get(index); option.enabled = true; model.options.push(option); if (index == selectedIndex) { model.selectedKey = option.key; } }
		self.setOptions(model); self._legacyRevision = revision;
	}

	public int itemCount() { self.control(); return self._titles.len; }

	public int selectedIndex() { self.control(); return self._selected; }

	private void requireItem(int index) { if (index < 0 || index >= self._titles.len) { throw "Native selection item is out of range"; } }

	public void setItemEnabled(int index, bool enabled) { self.stateNode().requireMutation(); self.control(); self.requireItem(index); if (self._enabledItems.get(index) == enabled) { return; } var model = self.optionsState(); model.options.get(index).enabled = enabled; self.setOptions(model); }

	public bool isItemEnabled(int index) { self.control(); self.requireItem(index); return self._enabledItems.get(index); }

	public void setSelectedIndex(int index) {
		self.stateNode().requireMutation(); self.control(); if (index < -1 || index >= self._keys.len) { throw "Native selection index is out of range"; }
		self.setSelectedKey(self.keyAt(index));
	}

	public string selectedTitle() { self.control(); return self._selected >= 0 && self._selected < self._titles.len ? self._titles.get(self._selected) : ""; }

	public void setEnabled(bool enabled) {
		var state = self._view.stateNode(); state.requireMutation(); var control = self.control(); bool previous = control.isEnabled();
		state.setEnabled(enabled); try { control.setEnabled(enabled); } catch (string error) { state.setEnabled(previous); throw error; }
	}

	public void setFont(double size) {
		if (!Math.isFinite(size) || size <= 0.0 || size > 512.0) { throw "Invalid native selection font size"; }
		var button = self.control();
		/* A larger outer frame does not grow AppKit's popup bezel. */
		if (size > SelectTypography.maximumSize()) { throw "Native selections support font sizes up to 20 points"; }
		button.setControlSize(size > 13.0 ? NSControlSizeLarge : NSControlSizeRegular);
		button.setFont(NSFont.systemFontOfSize(size));
	}

	public bool isEnabled() { return self.control().isEnabled(); }

	public CallbackCancellation close() {
		self._view.requireDetached();
		if (!self._closing) {
			self._closing = true;
			try { self.cancelMenu(CONTROL_ORIGIN_SYSTEM, CONTROL_CANCEL_SOURCE_CLOSING); } catch (string error) { self.nativeFailure(error); }
			self._menuCallbacks.cancel();
			if (self._failedMenuCallbacks != null) { self._failedMenuCallbacks.cancel(); }
			self._native.cancel(); self._view.close();
		}
		return self.pollClose();
	}
}
