/* AppKit's default item AX action mutates the cell before its deferred menu
 * action. This receiver admits synchronously and uses that public menu action. */
class MacOSSelectItem implements IAppKitSelectItemAccessibility, ICallbackRegistration {
	private MacOSSelect? _owner;
	private long long _revision;
	private int _index;
	private bool _open = true;
	private int _inFlight = 0;
	public MacOSSelectItem(MacOSSelect owner, long long revision, int index) { self._owner = owner; self._revision = revision; self._index = index; }

	private bool deliver(bool cancel) {
		if (!NSThread.isMainThread()) { throw "Native selection accessibility requires the main thread"; }
		if (!self._open || self._owner == null) { return false; }
		if (self._inFlight == 2147483647) { throw "Selection accessibility entry count exhausted"; }
		bool accepted = false; self._inFlight++;
		try {
			var owner = self._owner;
			if (owner != null) {
				if (cancel) { accepted = owner.cancelItem(self._revision); }
				else { accepted = owner.activateItem(self._revision, self._index); }
			}
		} finally { self._inFlight--; if (!self._open && self._inFlight == 0) { self._owner = null; } }
		return accepted;
	}

	public bool accessibilityPerformPress() { return self.deliver(false); }

	public bool accessibilityPerformPick() { return self.deliver(false); }

	public bool accessibilityPerformCancel() { return self.deliver(true); }

	public void accessibilityPerformAction(NSString action) {
		if (action.isEqualToString(NSAccessibilityPressAction) || action.isEqualToString(NSAccessibilityPickAction)) { self.deliver(false); }
		else if (action.isEqualToString(NSAccessibilityCancelAction)) { self.deliver(true); }
	}

	public bool isOpen() { return self._open; }

	public CallbackCancellation cancel() { self._open = false; return self.pollCompletion(); }

	public CallbackCancellation pollCompletion() {
		if (self._open) { return CALLBACK_CANCELLATION_NOT_REQUESTED; }
		if (self._inFlight > 0) { return CALLBACK_CANCELLATION_PENDING; }
		self._owner = null; return CALLBACK_CANCELLATION_COMPLETE;
