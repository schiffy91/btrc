import Library.Math;
import Library.Callback;
import Library.Console;
import Library.GUI.IGrid;
import Library.GUI.IView;
import Library.GUI.MacOS.MacOSContainer;
import Library.GUI.MacOS.MacOSView;

/* AppKit owns cell layout and intrinsic sizing. Children may themselves be
 * containers; their BTRC owners remain responsible for their lifecycle. */
class MacOSGridLayout implements IMacOSContainerLayout {
	private NSGridView? _grid;
	private int _column = 0;
	private int _row = 0;

	public MacOSGridLayout(int columns, int rows, double columnSpacing, double rowSpacing) {
		if (!NSThread.isMainThread()) { throw "Native grids require the main thread"; }
		if (columns <= 0 || rows <= 0) { throw "Native grid dimensions must be positive"; }
		self.validateSpacing(columnSpacing, rowSpacing);
		var grid = NSGridView.gridViewWithNumberOfColumns(columns, rows);
		if (grid == null) { throw "Cannot create native grid"; }
		self._grid = grid;
		grid.setXPlacement(NSGridCellPlacementFill);
		grid.setYPlacement(NSGridCellPlacementCenter);
		grid.setColumnSpacing(columnSpacing);
		grid.setRowSpacing(rowSpacing);
	}

	private NSGridView control() {
		if (!NSThread.isMainThread()) { throw "Native grids require the main thread"; }
		if (self._grid == null) { throw "Native grid is closed"; }
		return self._grid;
	}

	private void validateSpacing(double columnSpacing, double rowSpacing) {
		if (!Math.isFinite(columnSpacing) || !Math.isFinite(rowSpacing) || columnSpacing < 0.0 || rowSpacing < 0.0) { throw "Invalid native grid spacing"; }
	}

	public NSView nativeView() { return self.control(); }

	public NSView childParent() { return self.control(); }

	public void prepareCell(int column, int row) { self.nativeChild(column, row); self._column = column; self._row = row; }

	public void arrangeChild(NSView child) { self.control().cellAtColumnIndex(self._column, self._row).setContentView(child); }

	public void forgetChild(NSView child) {
		var grid = self.control();
		for (int row = 0; row < grid.numberOfRows(); row++) {
			for (int column = 0; column < grid.numberOfColumns(); column++) {
				var cell = grid.cellAtColumnIndex(column, row);
				if (cell.contentView() == child) { cell.setContentView(null); }
			}
		}
	}

	public int columnCount() { return (int)self.control().numberOfColumns(); }

	public int rowCount() { return (int)self.control().numberOfRows(); }

	public NSView? nativeChild(int column, int row) {
		var grid = self.control();
		if (column < 0 || column >= grid.numberOfColumns() || row < 0 || row >= grid.numberOfRows()) { throw "Native grid cell is out of bounds"; }
		return grid.cellAtColumnIndex(column, row).contentView();
	}

	public void setSpacing(double columnSpacing, double rowSpacing) {
		self.validateSpacing(columnSpacing, rowSpacing);
		var grid = self.control();
		grid.setColumnSpacing(columnSpacing);
		grid.setRowSpacing(rowSpacing);
	}

	public void setColumnWidth(int column, double width) {
		var grid = self.control();
		if (column < 0 || column >= grid.numberOfColumns()) { throw "Native grid column is out of bounds"; }
		if (!Math.isFinite(width) || width < 0.0) { throw "Invalid native grid column width"; }
		grid.columnAtIndex(column).setWidth(width);
	}

	public void fitColumn(int column) {
		var grid = self.control();
		if (column < 0 || column >= grid.numberOfColumns()) { throw "Native grid column is out of bounds"; }
		grid.columnAtIndex(column).setWidth(NSGridViewSizeForContent);
	}

	public void setRowHeight(int row, double height) {
		var grid = self.control();
		if (row < 0 || row >= grid.numberOfRows()) { throw "Native grid row is out of bounds"; }
		if (!Math.isFinite(height) || height < 0.0) { throw "Invalid native grid row height"; }
		grid.rowAtIndex(row).setHeight(height);
	}

	public void fitRow(int row) {
		var grid = self.control();
		if (row < 0 || row >= grid.numberOfRows()) { throw "Native grid row is out of bounds"; }
		grid.rowAtIndex(row).setHeight(NSGridViewSizeForContent);
	}

	public void setRowHidden(int row, bool hidden) {
		var grid = self.control();
		if (row < 0 || row >= grid.numberOfRows()) { throw "Native grid row is out of bounds"; }
		grid.rowAtIndex(row).setHidden(hidden);
	}

	public void setColumnHidden(int column, bool hidden) {
		var grid = self.control();
		if (column < 0 || column >= grid.numberOfColumns()) { throw "Native grid column is out of bounds"; }
		grid.columnAtIndex(column).setHidden(hidden);
	}

	public void layout() { self.nativeView().layoutSubtreeIfNeeded(); }

	public double fittingHeight() { return self.nativeView().fittingSize().height; }

	public void close() {
		if (!NSThread.isMainThread()) { throw "Native grids require the main thread"; }
		self._grid = null;
	}
}

class MacOSGrid implements IGrid, IMacOSView {
	private MacOSContainer _container;
	private MacOSGridLayout _layout;

	public MacOSGrid(int columns, int rows, double columnSpacing = 0.0, double rowSpacing = 0.0) { self._layout = MacOSGridLayout(columns, rows, columnSpacing, rowSpacing); self._container = MacOSContainer(self._layout); }

	public NSView nativeView() { return self._container.nativeView(); }

	public void attachTo(NSView parent) { self._container.attachTo(parent); }

	public void detachFrom(NSView parent) { self._container.detachFrom(parent); }

	public bool isOpen() { return self._container.isOpen(); }

	public double fittingWidth() { return self._container.fittingWidth(); }

	public double fittingHeight() { return self._container.fittingHeight(); }

	public void arrange(double x, double y, double width, double height) { self._container.arrange(x, y, width, height); }

	public bool isVisible() { return self._container.isVisible(); }

	public void setVisible(bool visible) { self._container.setVisible(visible); }

	public int columnCount() { self.nativeView(); return self._layout.columnCount(); }

	public int rowCount() { self.nativeView(); return self._layout.rowCount(); }

	public IView? childAt(int column, int row) {
		self.nativeView();
		var target = self._layout.nativeChild(column, row);
		if (target == null) { return null; }
		for (int index = 0; index < self._container.childCount(); index++) {
			var child = self._container.childAt(index);
			IMacOSView? native = (IMacOSView?)child;
			if (native != null && native.nativeView() == target) { return child; }
		}
		throw "Native grid cell has no owning child";
	}

	public void setChild(int column, int row, IView? child) {
		var parent = self.nativeView();
		var previous = self.childAt(column, row);
		if (previous == child) { return; }
		if (child != null) {
			IMacOSView? native = (IMacOSView?)child;
			if (native == null) { throw "View has no macOS implementation"; }
			MacOSView.validateAttachment(native.nativeView(), parent);
		}
		if (previous != null) { self._container.detach(previous); }
		if (child == null) { return; }
		self._layout.prepareCell(column, row);
		try { self._container.attach(child); } catch (string error) {
			if (previous != null && self._container.isOpen()) {
				self._layout.prepareCell(column, row);
				self._container.attach(previous);
			}
			throw error;
		}
	}

	public void setSpacing(double columnSpacing, double rowSpacing) { self.nativeView(); self._layout.setSpacing(columnSpacing, rowSpacing); }

	public void setColumnWidth(int column, double width) { self.nativeView(); self._layout.setColumnWidth(column, width); }

	public void fitColumn(int column) { self.nativeView(); self._layout.fitColumn(column); }

	public void setRowHeight(int row, double height) { self.nativeView(); self._layout.setRowHeight(row, height); }

	public void fitRow(int row) { self.nativeView(); self._layout.fitRow(row); }

	public void setRowHidden(int row, bool hidden) { self.nativeView(); self._layout.setRowHidden(row, hidden); }

	public void setColumnHidden(int column, bool hidden) { self.nativeView(); self._layout.setColumnHidden(column, hidden); }

	public void setFrame(double x, double y, double width, double height) {
		if (!Math.isFinite(x) || !Math.isFinite(y) || !Math.isFinite(width) || !Math.isFinite(height) || width < 0.0 || height < 0.0) { throw "Invalid native grid frame"; }
		var view = self.nativeView();
		var frame = view.frame();
		frame.origin.x = x; frame.origin.y = y; frame.size.width = width; frame.size.height = height;
		view.setFrame(frame);
	}

	public void layout() { self.nativeView(); self._layout.layout(); }

	public CallbackCancellation close() {
		var state = self._container == null ? CallbackCancellation.Complete : self._container.close();
		if (state == CallbackCancellation.Complete && self._layout != null) { self._layout.close(); }
		return state;
	}

	public CallbackCancellation pollClose() {
		var state = self._container == null ? CallbackCancellation.Complete : self._container.pollClose();
		if (state == CallbackCancellation.Complete && self._layout != null) { self._layout.close(); }
		return state;
	}

	public void __del__() { if (self.close() != CallbackCancellation.Complete) { Console.fatal("Native grid destroyed before subtree cleanup completed"); } }
}
