import Library.Callback;
import Library.Vector;
import Library.Math;
import Library.GUI.IView;
import Library.GUI.MacOS.MacOSViewInput;
import Library.GUI.MacOS.MacOSControlEvents;
import Library.GUI.ControlEventQueue;

/* Provider-only projection for composition. Querying it aliases the existing
 * receiver, without exposing native handles on the portable IView contract. */
interface IMacOSView extends IView {
	MacOSViewState interactionOwner();
	void markInteraction(bool inherited, WindowExposure exposure, ControlEventQueue? events);
	void settleInteraction();
	void publishInteraction();
	NSView nativeView();
	void attachTo(NSView parent);
	void detachFrom(NSView parent);
	void cancelPointerCapture();
}

/* Main-thread view ownership shared by native leaf controls and containers.
 * Managed attachment reserves close for the owning container. */
class MacOSView implements IMacOSView {
	private NSView? _view;
	private bool _attached = false;
	private bool _closing = false;
	private CallbackScope _input = CallbackScope();
	private Vector<MacOSViewInput> _inputs = [];
	private MacOSViewState? _interaction;
	private bool _inherited = false;
	private bool _lostEligibility = false;
	private ControlEventQueue? _nextEvents;
	private bool _routePending = false;
	private WindowExposure _exposure = WINDOW_EXPOSURE_UNKNOWN;

	public MacOSView(NSView? view = null, MacOSControlContext? context = null) {
		if (!NSThread.isMainThread()) { throw "Native views require the main thread"; }
		self._view = view == null ? NSView.new() : view;
		if (self._view == null) { throw "Cannot create native view"; }
		var semanticContext = context;
		if (semanticContext == null) { semanticContext = MacOSControlContext.defaultContext(); }
		self._interaction = MacOSViewState(semanticContext);
		self.refreshInteraction(false, WINDOW_EXPOSURE_UNKNOWN);
	}

	public MacOSViewState interactionOwner() {
		if (!NSThread.isMainThread()) { throw "Native views require the main thread"; }
		var state = self._interaction;
		if (state == null) { throw "Native view interaction state is unavailable"; }
		return state;
	}

	public ViewInteractionState interactionState() {
		if (!NSThread.isMainThread()) { throw "Native views require the main thread"; }
		if (self._view == null || self._closing) { throw "Native view is closed"; }
		return self.interactionOwner().interactionState();
	}

	public ICallbackRegistration onInteractionStateChanged(IViewInteractionStateHandler handler, CallbackScope owner) { self.nativeView(); return self.interactionOwner().onInteractionStateChanged(handler, owner); }

	/* Containers/windows provide copied inherited facts. This does not retain
	 * their native or BTRC owners; same-window route changes are no-ops. */
	public void markInteraction(bool inherited, WindowExposure exposure, ControlEventQueue? events = null) {
		var view = self.nativeView(); var state = self.interactionOwner();
		self._inherited = inherited; self._exposure = exposure;
		if (state.update(!view.isHidden(), state.interactionState().localEnabled, inherited, self._attached, exposure, false)) { self._lostEligibility = true; }
		self._nextEvents = events; self._routePending = true;
	}

	public void settleInteraction() {
		if (!NSThread.isMainThread()) { throw "Native views require the main thread"; }
		if (self._lostEligibility) { self._lostEligibility = false; self.cancelPointerCapture(); }
	}

	public void publishInteraction() {
		var state = self.interactionOwner(); if (self._closing) { return; }
		if (self._routePending) {
			if (self._nextEvents == null) { state.rebindDetached(); } else { state.rebind(self._nextEvents); }
			self._routePending = false;
		}
		state.publish();
	}

	/* Only leaves use this combined convenience. A container invokes each
	 * phase across its entire subtree before beginning the next phase. */
	public void refreshInteraction(bool inherited, WindowExposure exposure, ControlEventQueue? events = null) {
		self.markInteraction(inherited, exposure, events);
		self.settleInteraction(); self.publishInteraction();
	}

	/* A control calls this after changing its actual native enabled flag. The
	 * snapshot is observation data; the control's getter remains authoritative. */
	public void localEnabledChanged(bool enabled) {
		var view = self.nativeView(); var state = self.interactionOwner();
		if (state.update(!view.isHidden(), enabled, self._inherited, self._attached, self._exposure, false)) { self._lostEligibility = true; }
		self.settleInteraction(); self.publishInteraction();
	}

	public NSView nativeView() {
		if (!NSThread.isMainThread()) { throw "Native views require the main thread"; }
		if (self._view == null || self._closing) { throw "Native view is closed"; }
		var interaction = self._interaction;
		if (interaction != null && (!interaction.isOpen() || interaction.faulted())) { throw "Native view is quarantined"; }
		return self._view;
	}

	public bool isOpen() {
		if (!NSThread.isMainThread()) { throw "Native views require the main thread"; }
		return self._view != null && !self._closing;
	}

	public void requireDetached() {
		if (!NSThread.isMainThread()) { throw "Native views require the main thread"; }
		if (self._attached) { throw "Detach the view from its container before closing it"; }
	}

	class void validateAttachment(NSView child, NSView parent) {
		if (!NSThread.isMainThread()) { throw "Native views require the main thread"; }
		if (parent == null || child == null || child.superview() != null || parent.isDescendantOf(child)) { throw "Native child is already attached or creates a cycle"; }
	}

	class void attachNative(NSView child, NSView parent) {
		MacOSView.validateAttachment(child, parent);
		try {
			parent.addSubview(child);
			var window = child.window();
			if (window != null) { window.setAcceptsMouseMovedEvents(true); }
		} catch (string error) {
			if (child.superview() == parent) { child.removeFromSuperview(); }
			throw error;
		}
	}

	class void detachNative(NSView child, NSView parent) {
		if (!NSThread.isMainThread()) { throw "Native views require the main thread"; }
		if (parent == null || child == null || child.superview() != parent) { throw "View does not belong to this native parent"; }
		child.removeFromSuperview();
	}

	public void attachTo(NSView parent) {
		self.requireDetached();
		var view = self.nativeView();
		MacOSView.validateAttachment(view, parent);
		self._attached = true;
		try { MacOSView.attachNative(view, parent); } catch (string error) {
			self._attached = view.superview() == parent;
			throw error;
		}
		self.refreshInteraction(self._inherited, self._exposure);
	}

	public void detachFrom(NSView parent) {
		var view = self.nativeView();
		if (!self._attached) { throw "View has no container attachment"; }
		/* Native detach may synchronously end editing. Seal eligibility first,
		 * while terminal reservations still belong to their original queue. */
		self.markInteraction(false, WINDOW_EXPOSURE_UNKNOWN);
		try {
			self.settleInteraction();
			MacOSView.detachNative(view, parent);
			self._attached = false;
			self.publishInteraction();
		} catch (string error) { self.quarantineInteraction(error); throw error; }
	}

	public double fittingWidth() { return self.nativeView().fittingSize().width; }

	public double fittingHeight() { return self.nativeView().fittingSize().height; }

	public bool isVisible() { return !self.nativeView().isHidden(); }

	public ICallbackRegistration onPointer(IViewPointerHandler handler, CallbackScope owner) { return MacOSViewInput.subscribe(self.nativeView(), handler, null, self._input, owner, self._inputs); }

	public ICallbackRegistration onScroll(IViewScrollHandler handler, CallbackScope owner) { return MacOSViewInput.subscribe(self.nativeView(), null, handler, self._input, owner, self._inputs); }

	public void cancelPointerCapture() { MacOSViewInput.detached(self._inputs); }

	/* GPU owners close admission before draining native work, while retaining
	 * their view/layer until the existing native teardown barrier completes. */
	public CallbackCancellation cancelInput() { return self._input.cancel(); }

	public void setVisible(bool visible) { self.setHidden(!visible); }

	public void arrange(double x, double y, double width, double height) { MacOSView.arrangeNative(self.nativeView(), x, y, width, height); }

	/* Provider-only projection shared by controls that already own an NSView
	 * subtype. It does not allocate another BTRC owner for the same native view. */
	class void arrangeNative(NSView view, double x, double y, double width, double height) {
		if (!NSThread.isMainThread()) { throw "Native views require the main thread"; }
		if (!Math.isFinite(x) || !Math.isFinite(y) || !Math.isFinite(width) || !Math.isFinite(height) || width < 0.0 || height < 0.0) { throw "Invalid native view frame"; }
		var parent = view.superview();
		if (parent == null) { throw "Attach a native view before arranging it"; }
		var bounds = parent.bounds();
		double nativeX = bounds.origin.x + x;
		double nativeY = parent.isFlipped() ? bounds.origin.y + y : bounds.origin.y + bounds.size.height - y - height;
		if (!Math.isFinite(nativeX) || !Math.isFinite(nativeY)) { throw "Invalid native view frame"; }
		var frame = view.frame();
		frame.origin.x = nativeX;
		frame.origin.y = nativeY;
		frame.size.width = width;
		frame.size.height = height;
		view.setFrame(frame);
	}

	private void quarantineInteraction(string failure) {
		if (self._closing || self._view == null) { return; }
		var state = self.interactionOwner();
		if (!state.isOpen()) { self._input.cancel(); return; }
		state.update(!self._view.isHidden(), state.interactionState().localEnabled, false, self._attached, self._exposure, true);
		try { self._input.cancel(); state.publish(); }
		catch (string cleanup) { throw f"Native interaction failed: {failure}; quarantine failed: {cleanup}"; }
	}

	public void setHidden(bool hidden) {
		var view = self.nativeView();
		if (view.isHidden() == hidden) { return; }
		var state = self.interactionOwner();
		bool enabled = state.interactionState().localEnabled;
		if (state.update(!hidden, enabled, self._inherited, self._attached, self._exposure, false)) { self._lostEligibility = true; }
		try {
			/* A synchronous cancellation observer must already see input sealed. */
			self.settleInteraction();
			if (self._closing) { return; }
			view.setHidden(hidden);
			self.publishInteraction();
		} catch (string error) { self.quarantineInteraction(error); throw error; }
	}

	public CallbackCancellation pollClose() {
		if (!NSThread.isMainThread()) { throw "Native views require the main thread"; }
		var view = self._view;
		if (view == null) { return CALLBACK_CANCELLATION_COMPLETE; }
		if (!self._closing) { return CALLBACK_CANCELLATION_NOT_REQUESTED; }
		var state = self._input.pollCompletion();
		if (state != CALLBACK_CANCELLATION_COMPLETE) { return state; }
		var semantic = self.interactionOwner().pollClose();
		if (semantic != CALLBACK_CANCELLATION_COMPLETE) { return semantic; }
		view.removeFromSuperview();
		self._view = null;
		return CALLBACK_CANCELLATION_COMPLETE;
	}

	public CallbackCancellation close() {
		self.requireDetached();
		var view = self._view;
		if (view == null) { return CALLBACK_CANCELLATION_COMPLETE; }
		if (!self._closing) { self._closing = true; self.interactionOwner().close(); self._input.cancel(); }
		return self.pollClose();
	}
}
