import Library.Callback;
import Library.Vector;
import Library.Math;
import Library.GUI.IView;
import Library.GUI.MacOS.MacOSViewInput;
import Library.GUI.MacOS.MacOSViewState;

/* Provider-only projection for composition. Querying it aliases the existing
 * receiver, without exposing native handles on the portable IView contract. */
interface IMacOSView extends IView {
	MacOSViewState stateNode();
	NSView nativeView();
	void attachTo(NSView parent);
	void detachFrom(NSView parent);
	void cancelPointerCapture();
}

/* Main-thread view ownership shared by native leaf controls and containers.
 * Managed attachment reserves close for the owning container. */
class MacOSView implements IMacOSView, IMacOSViewEligibility {
	private MacOSViewState _state;
	private IMacOSViewEligibility? _controlEligibility;
	private NSView? _view;
	private bool _attached = false;
	private bool _closing = false;
	private CallbackScope _input = CallbackScope();
	private Vector<MacOSViewInput> _inputs = [];

	public MacOSView(NSView? view = null) {
		if (!NSThread.isMainThread()) { throw "Native views require the main thread"; }
		self._view = view == null ? NSView.new() : view;
		if (self._view == null) { throw "Cannot create native view"; }
		self._state = MacOSViewState(self);
	}

	public MacOSViewState stateNode() { return self._state; }

	public ViewInteractionState interactionState() { return self._state.snapshot(); }

	public ICallbackRegistration onInteractionStateChanged(IViewInteractionStateHandler handler, CallbackScope owner) { return self._state.observe(handler, owner); }

	public void bindEligibility(IMacOSViewEligibility receiver) { self._state.requireMutation(); if (self._controlEligibility != null || receiver == null) { throw "Native view eligibility receiver is already bound or missing"; } self._controlEligibility = receiver; }

	public void eligibilityLost() { self.cancelPointerCapture(); var receiver = self._controlEligibility; if (receiver != null) { receiver.eligibilityLost(); } }

	public NSView nativeView() {
		if (!NSThread.isMainThread()) { throw "Native views require the main thread"; }
		if (self._view == null || self._closing) { throw "Native view is closed"; }
		return self._view;
	}

	public bool isOpen() {
		if (!NSThread.isMainThread()) { throw "Native views require the main thread"; }
		return self._view != null && !self._closing;
	}

	public void requireDetached() {
		if (!NSThread.isMainThread()) { throw "Native views require the main thread"; }
		if (self._attached) { throw "Detach the view from its container before closing it"; }
	}

	class void validateAttachment(NSView child, NSView parent) {
		if (!NSThread.isMainThread()) { throw "Native views require the main thread"; }
		if (parent == null || child == null || child.superview() != null || parent.isDescendantOf(child)) { throw "Native child is already attached or creates a cycle"; }
	}

	class void attachNative(NSView child, NSView parent) {
		MacOSView.validateAttachment(child, parent);
		try {
			parent.addSubview(child, NSWindowAbove, null);
			var window = child.window();
			if (window != null) { window.setAcceptsMouseMovedEvents(true); }
		} catch (string error) {
			if (child.superview() == parent) { child.removeFromSuperview(); }
			throw error;
		}
	}

	class void detachNative(NSView child, NSView parent) {
		if (!NSThread.isMainThread()) { throw "Native views require the main thread"; }
		if (parent == null || child == null || child.superview() != parent) { throw "View does not belong to this native parent"; }
		child.removeFromSuperview();
	}

	/* Reinsert within the same native parent. Removing first ends field editing
	 * and loses marked text even when the logical owner has not changed. */
	class void moveNative(NSView child, NSView parent, NSView? sibling, bool after) {
		if (!NSThread.isMainThread()) { throw "Native views require the main thread"; }
		if (parent == null || child == null || child.superview() != parent) { throw "View does not belong to this native parent"; }
		if (sibling != null && (sibling == child || sibling.superview() != parent)) { throw "Native ordering requires a different sibling in the same parent"; }
		parent.addSubview(child, after ? NSWindowAbove : NSWindowBelow, sibling);
	}

	public void attachTo(NSView parent) {
		self.requireDetached();
		var view = self.nativeView();
		MacOSView.validateAttachment(view, parent);
		self._attached = true;
		try { MacOSView.attachNative(view, parent); } catch (string error) {
			self._attached = view.superview() == parent;
			throw error;
		}
	}

	public void detachFrom(NSView parent) {
		var view = self.nativeView();
		if (!self._attached) { throw "View has no container attachment"; }
		self.cancelPointerCapture();
		try { MacOSView.detachNative(view, parent); } catch (string error) {
			self._attached = view.superview() != null;
			throw error;
		}
		self._attached = false;
	}

	public double fittingWidth() { return self.nativeView().fittingSize().width; }

	public double fittingHeight() { return self.nativeView().fittingSize().height; }

	public bool isVisible() { return !self.nativeView().isHidden(); }

	public ICallbackRegistration onPointer(IViewPointerHandler handler, CallbackScope owner) { return MacOSViewInput.subscribe(self.nativeView(), handler, null, self._input, owner, self._inputs, self._state); }

	public ICallbackRegistration onScroll(IViewScrollHandler handler, CallbackScope owner) { return MacOSViewInput.subscribe(self.nativeView(), null, handler, self._input, owner, self._inputs, self._state); }

	public void cancelPointerCapture() { MacOSViewInput.detached(self._inputs); }

	/* GPU owners close admission before draining native work, while retaining
	 * their view/layer until the existing native teardown barrier completes. */
	public CallbackCancellation cancelInput() { var semantic = self._state.close(); var input = self._input.cancel(); return semantic != CALLBACK_CANCELLATION_COMPLETE ? semantic : input; }

	public void setVisible(bool visible) { self.setHidden(!visible); }

	public void arrange(double x, double y, double width, double height) { self._state.requireMutation(); MacOSView.arrangeNative(self.nativeView(), x, y, width, height); }

	/* Provider-only projection shared by controls that already own an NSView
	 * subtype. It does not allocate another BTRC owner for the same native view. */
	class void arrangeNative(NSView view, double x, double y, double width, double height) {
		if (!NSThread.isMainThread()) { throw "Native views require the main thread"; }
		if (!Math.isFinite(x) || !Math.isFinite(y) || !Math.isFinite(width) || !Math.isFinite(height) || width < 0.0 || height < 0.0) { throw "Invalid native view frame"; }
		var parent = view.superview();
		if (parent == null) { throw "Attach a native view before arranging it"; }
		var bounds = parent.bounds();
		double nativeX = bounds.origin.x + x;
		double nativeY = parent.isFlipped() ? bounds.origin.y + y : bounds.origin.y + bounds.size.height - y - height;
		if (!Math.isFinite(nativeX) || !Math.isFinite(nativeY)) { throw "Invalid native view frame"; }
		var frame = view.frame();
		frame.origin.x = nativeX;
		frame.origin.y = nativeY;
		frame.size.width = width;
		frame.size.height = height;
		view.setFrame(frame);
	}

	public void setHidden(bool hidden) { self._state.requireMutation(); var view = self.nativeView(); bool previous = !view.isHidden(); self._state.setVisible(!hidden); try { view.setHidden(hidden); } catch (string error) { self._state.setVisible(previous); throw error; } }

	public CallbackCancellation pollClose() {
		if (!NSThread.isMainThread()) { throw "Native views require the main thread"; }
		var view = self._view;
		if (view == null) { return CALLBACK_CANCELLATION_COMPLETE; }
		if (!self._closing) { return CALLBACK_CANCELLATION_NOT_REQUESTED; }
		var semantic = self._state.pollClose();
		if (semantic != CALLBACK_CANCELLATION_COMPLETE) { return semantic; }
		var state = self._input.pollCompletion();
		if (state != CALLBACK_CANCELLATION_COMPLETE) { return state; }
		view.removeFromSuperview();
		self._view = null; self._controlEligibility = null;
		return CALLBACK_CANCELLATION_COMPLETE;
	}

	public CallbackCancellation close() {
		self.requireDetached();
		var view = self._view;
		if (view == null) { return CALLBACK_CANCELLATION_COMPLETE; }
		if (!self._closing) { self._closing = true; self._state.close(); self._input.cancel(); }
		return self.pollClose();
	}
}
