import Library.Callback;
import Library.Console;
import Library.OwnedBuffer;
import Library.GUI.MacOS.AppKitText;
import Library.GUI.IApplicationNativeWake;
import Library.GUI.MacOS.CoreFoundation;

/* One common-mode source coalesces wakeups. This owner keeps its immutable
 * UTF-8 context alive until source invalidation; managed receivers stay in the
 * scoped notification adapter. Workers touch only the raw source and gate. */
class MacOSRunLoopSignal implements IApplicationNativeWake {
	private CFRunLoopSourceRef _source = null;
	private CFRunLoopTimerRef _timer = null;
	private unsigned long long _deadline = 0ULL;
	private NSString? _name;
	private OwnedBuffer<char>? _context;
	private Atomic<uint>* _gate = null;
	private bool _subscribed = false;

	public MacOSRunLoopSignal() {
		self.requireMainThread();
		self._gate = (Atomic<uint>*)malloc(sizeof(Atomic<uint>));
		if (self._gate == null) { throw "Cannot allocate native run-loop admission gate"; }
		self._gate->init(1u);
		var identity = NSUUID.UUID();
		var name = identity.UUIDString();
		string text = AppKitText.ownedValue(name);
		var context = new OwnedBuffer<char>((size_t)text.len() + (size_t)1);
		if (!context.opened()) { throw "Cannot allocate native run-loop wake name"; }
		strcpy(context.borrow(), text);
		self._name = name;
		self._context = context;
		self._source = MacOSRunLoopSignal.createSource(context.borrow());
		if (self._source == null) { throw "Cannot create native run-loop source"; }
		CFRunLoopAddSource(CFRunLoopGetMain(), self._source, kCFRunLoopCommonModes);
		self._gate->store(0u, MemoryOrder.RELEASE);
	}

	class CFRunLoopSourceRef createSource(char* name) {
		CFRunLoopSourceContext context = {};
		context.info = (void*)name;
		context.perform = MacOSRunLoopSignal.perform;
		return CFRunLoopSourceCreate(null, 0, &context);
	}

	private void requireMainThread() { if (!NSThread.isMainThread()) { throw "Native run-loop ownership requires the main thread"; } }

	class void perform(void* raw) {
		try {
			/* Copy before dispatch: a notification receiver may close this source
			 * and free its context while postNotificationName is still entered. */
			var name = NSString.stringWithUTF8String((char*)raw);
			if (name == null) { throw "Cannot read native run-loop wake name"; }
			NSNotificationCenter.defaultCenter().postNotificationName(name, null);
		} catch (string error) { Console.fatal(error); }
	}

	public void subscribe(IAppKitNotificationObserver receiver, CallbackScope scope) {
		self.requireMainThread();
		var name = self._name;
		if (self._source == null || name == null || (self._gate->load(MemoryOrder.ACQUIRE) & 1u) != 0u) { throw "Native run-loop signal is closed"; }
		if (self._subscribed) { throw "Native run-loop signal already has a subscriber"; }
		NSNotificationCenter.defaultCenter().addObserverForName(name, null, null, receiver, scope);
		self._subscribed = true;
	}

	/* The application retains this owner until every publisher has drained.
	 * The shared gate prevents invalidation while an admitted worker signals. */
	public bool requestTurn() {
		if (!callbackGateTryEnter(self._gate)) { return false; }
		CFRunLoopSourceSignal(self._source); CFRunLoopWakeUp(CFRunLoopGetMain());
		callbackGateLeave(self._gate); return true;
	}

	class unsigned long long now() {
		double nanoseconds = CACurrentMediaTime() * 1000000000.0;
		if (!(nanoseconds >= 0.0) || nanoseconds >= 18446744073709551616.0) { throw "Cannot read native run-loop deadline clock"; }
		return (unsigned long long)nanoseconds;
	}

	/* The timer borrows the source. Both callbacks run on the main thread, and
	 * every timer is invalidated and released before the source is released. */
	class CFRunLoopTimerRef createTimer(CFRunLoopSourceRef source, double delay) {
		CFRunLoopTimerContext context = {};
		context.info = (void*)source;
		return CFRunLoopTimerCreate(null, CFAbsoluteTimeGetCurrent() + delay, 0.0, 0UL, 0L, MacOSRunLoopSignal.timerFired, &context);
	}

	class void timerFired(CFRunLoopTimerRef timer, void* raw) {
		CFRunLoopSourceSignal((CFRunLoopSourceRef)raw); CFRunLoopWakeUp(CFRunLoopGetMain());
	}

	/* Deadlines use CACurrentMediaTime in nanoseconds, excluding sleep. A
  * callback consumer rechecks that clock before executing delayed work. */
	public void scheduleDeadline(unsigned long long deadline) {
		self.requireMainThread();
		if (self._source == null || (self._gate->load(MemoryOrder.ACQUIRE) & 1u) != 0u) { throw "Native run-loop signal is closed"; }
		if (deadline == self._deadline && (deadline == 0ULL || (self._timer != null && CFRunLoopTimerIsValid(self._timer) != (Boolean)0))) { return; }
		CFRunLoopTimerRef replacement = null;
		if (deadline != 0ULL) {
			unsigned long long now = MacOSRunLoopSignal.now();
			double delay = deadline > now ? (double)(deadline - now) / 1000000000.0 : 0.0;
			replacement = MacOSRunLoopSignal.createTimer(self._source, delay);
			if (replacement == null) { throw "Cannot create native run-loop deadline timer"; }
			CFRunLoopAddTimer(CFRunLoopGetMain(), replacement, kCFRunLoopCommonModes);
		}
		if (self._timer != null) { CFRunLoopTimerInvalidate(self._timer); CFRelease(self._timer); }
		self._timer = replacement; self._deadline = deadline;
	}

	public void wake() { if (!self.requestTurn()) { throw "Native run-loop source is closing"; } }

	/* Stop a running AppKit loop. stop: is observed only after an NSEvent, not
	 * after a timer or notification callback, so an application-defined event
	 * wakes the loop. False, with the loop still running, when that event
	 * cannot be created. */
	class bool stopApplication(NSApplication application) {
		if (!application.isRunning()) { return true; }
		CGPoint location;
		location.x = 0.0;
		location.y = 0.0;
		var wake = NSEvent.otherEventWithType(NSEventTypeApplicationDefined, location, 0UL, 0.0, 0L, null, (short)0, 0L, 0L);
		if (wake == null) { return false; }
		application.stop(null);
		application.postEvent(wake, false);
		return true;
	}

	public bool close() {
		self.requireMainThread(); if (self._gate == null) { return true; } callbackGateCloseAdmission(self._gate);
		if (self._gate->load(MemoryOrder.ACQUIRE) != 1u) { return false; }
		if (self._timer != null) { CFRunLoopTimerInvalidate(self._timer); CFRelease(self._timer); self._timer = null; self._deadline = 0ULL; }
		if (self._source != null) { CFRunLoopSourceInvalidate(self._source); CFRelease(self._source); self._source = null; }
		if (self._context != null) { self._context.close(); self._context = null; }
		self._name = null; return true;
	}

	public void __del__() { if (self._gate != null) { if (!self.close()) { Console.fatal("Native run-loop source destroyed before worker drain"); } free(self._gate); self._gate = null; } }
}
