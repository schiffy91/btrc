import Library.Callback;
import Library.Console;
import Library.Vector;
import Library.GUI.IApplicationNativeWake;
import Library.GUI.IView;
import Library.GUI.ControlEventQueue;
import Library.GUI.MacOS.MacOSRunLoop;

class MacOSSemanticWake implements IControlEventWake {
	private IApplicationNativeWake _signal;
	public MacOSSemanticWake(IApplicationNativeWake signal) { self._signal = signal; }

	public bool requestTurn() { return self._signal.requestTurn(); }
}

/* Shared first-error state has no back-reference to either execution owner. */
class MacOSNativeFailure {
	private bool _failed = false;
	private string _error = "";
	private void requireMainThread() { if (!NSThread.isMainThread()) { throw "Native failure state requires the main thread"; } }

	public bool record(string error) { self.requireMainThread(); if (self._failed) { return false; } self._failed = true; self._error = error; return true; }

	public bool failed() { self.requireMainThread(); return self._failed; }

	public string error() { self.requireMainThread(); return self._error; }

	public void check() { self.requireMainThread(); if (self._failed) { throw self._error; } }
}

interface IMacOSNativeSettlement { void settleNative(); }

/* One reserved native completion, owned by the context and the control's
 * scope. Repeated requests coalesce without allocating inside AppKit. */
class MacOSNativeSettlementRegistration implements ICallbackRegistration {
	private IMacOSNativeSettlement? _receiver;
	private IControlEventWake _wake;
	private MacOSViewContext _context;
	private bool _open = true;
	private bool _pending = false;
	private bool _entered = false;
	public MacOSNativeSettlementRegistration(IMacOSNativeSettlement receiver, IControlEventWake wake, MacOSViewContext context) { self._receiver = receiver; self._wake = wake; self._context = context; }

	private void requireMainThread() { if (!NSThread.isMainThread()) { throw "Native settlement requires the main thread"; } }

	public void request() {
		self.requireMainThread(); self._context.checkNativeFailure(); if (!self._open) { throw "Native settlement is closed"; }
		if (self._pending) { return; }
		self._pending = true;
		try { if (!self._wake.requestTurn()) { throw "Native settlement wake failed"; } }
		catch (string error) { self._pending = false; throw error; }
	}

	public bool pending() { self.requireMainThread(); return self._open && self._pending; }

	public bool dispatch() {
		self.requireMainThread(); if (!self._open || !self._pending || self._entered) { return false; }
		self._pending = false; self._entered = true;
		try { var receiver = self._receiver; if (receiver != null) { receiver.settleNative(); } }
		finally { self._entered = false; if (!self._open) { self._receiver = null; } }
		return true;
	}

	public bool isOpen() { self.requireMainThread(); return self._open; }

	public CallbackCancellation cancel() { self.requireMainThread(); self._open = false; self._pending = false; return self.pollCompletion(); }

	public CallbackCancellation pollCompletion() {
		self.requireMainThread(); if (self._open) { return CALLBACK_CANCELLATION_NOT_REQUESTED; }
		if (self._entered) { return CALLBACK_CANCELLATION_PENDING; }
		self._receiver = null; return CALLBACK_CANCELLATION_COMPLETE;
	}
}

/* Application-owned terminal credits and one semantic stream per window.
 * Detached controls use the same pool, so attachment never changes credits. */
class MacOSViewContext {
	public ControlEventQueue detachedEvents;
	public IControlEventWake wake;
	private ControlEventTerminalPool _pool;
	private Vector<ControlEventQueue> _queues = [];
	private int _capacity;
	private int _captureCapacity;
	private int _cursor = 0;
	private bool _closed = false;
	private bool _dispatching = false;
	private bool _treeMutation = false;
	private int _routePreparations = 0;
	private int _closeDecisionDepth = 0;
	private bool _nativeQuitPending = false;
	private Vector<MacOSNativeSettlementRegistration> _settlements = [];
	private int _settlementCursor = 0;
	private bool _nativeTurn = true;
	private MacOSNativeFailure _failure;
	private bool _failureSealed = false;
	public MacOSViewContext(IControlEventWake wake, int capacity = 256, MacOSNativeFailure? failure = null, int captureCapacity = 0) {
		self.requireMainThread(); if (captureCapacity < 0 || captureCapacity > 65536) { throw "Invalid native capture capacity"; } self._captureCapacity = captureCapacity; self._failure = failure == null ? MacOSNativeFailure() : failure; self._capacity = capacity; self._pool = ControlEventTerminalPool(65536);
		self.wake = wake; self.detachedEvents = self.createQueue();
	}

	private void requireMainThread() { if (!NSThread.isMainThread()) { throw "Native view state requires the main thread"; } }

	public ControlEventQueue createQueue() {
		self.requireMainThread(); self.checkNativeFailure(); if (self._closed) { throw "Native view context is closed"; }
		// Zero keeps legacy providers disabled. Adoption uses an explicit 16,384
		// credit policy independent of native work capacity, not a measured limit.
		ControlEventCaptureOwner? capture = self._captureCapacity == 0 ? null : ControlEventCaptureOwner(self._captureCapacity, self._pool);
		var queue = ControlEventQueue(self._capacity, self._pool, 0, capture); queue.setWake(self.wake); self._queues.push(queue); return queue;
	}

	public void retireQueue(ControlEventQueue queue) {
		self.requireMainThread(); if (queue == self.detachedEvents) { throw "Detached semantic stream belongs to the application"; }
		for (int index = 0; index < self._queues.len; index++) {
			if (self._queues.get(index) == queue) { queue.close(); self._queues.remove(index); if (index < self._cursor) { self._cursor--; } return; }
		}
	}

	public MacOSNativeSettlementRegistration registerNativeSettlement(IMacOSNativeSettlement receiver, CallbackScope owner) {
		self.requireMainThread(); self.checkNativeFailure(); if (self._closed || receiver == null || owner == null) { throw "Native settlement owner is closed or missing"; }
		for (int index = self._settlements.len - 1; index >= 0; index--) {
			if (self._settlements.get(index).pollCompletion() == CALLBACK_CANCELLATION_COMPLETE) { self._settlements.remove(index); if (index < self._settlementCursor) { self._settlementCursor--; } }
		}
		var registration = MacOSNativeSettlementRegistration(receiver, self.wake, self);
		try { owner.track(registration); self._settlements.push(registration); }
		catch (string error) { registration.cancel(); throw error; }
		return registration;
	}

	/* Shared failure recording seals semantic admission without notifying a host. */
	public void recordFailure(string error) {
		self.requireMainThread(); self._failure.record(error);
		if (!self._failureSealed) { self._failureSealed = true; for queue in self._queues { queue.sealNativeSource(); } }
	}

	public string nativeFailure() { return self._failure.error(); }

	/* Native callbacks catch their exception before calling this method. Wake
	 * failure cannot replace the first error or escape back through the ABI. */
	public void recordNativeFailure(string error) {
		self.recordFailure(error);
		if (!self._closed) { try { self.wake.requestTurn(); } catch (string ignored) {} }
	}

	public bool nativeFailed() { return self._failure.failed(); }

	public void checkNativeFailure() { self._failure.check(); }

	private bool dispatchSettlement() {
		for (int examined = 0; examined < self._settlements.len; examined++) {
			if (self._settlementCursor >= self._settlements.len) { self._settlementCursor = 0; }
			var registration = self._settlements.get(self._settlementCursor++);
			try { if (registration.dispatch()) { return true; } }
			catch (string error) { self.recordNativeFailure(error); throw error; }
		}
		return false;
	}

	public bool dispatchOne() {
		self.requireMainThread(); if (self._dispatching) { throw "Semantic delivery cannot re-enter"; } if (self._closed || self._treeMutation) { return false; }
		self.checkNativeFailure();
		self._dispatching = true;
		bool delivered = false;
		try {
			if (self._nativeTurn) { delivered = self.dispatchSettlement(); if (delivered) { self._nativeTurn = false; } }
			for (int examined = 0; examined < self._queues.len && !delivered; examined++) {
				if (self._cursor >= self._queues.len) { self._cursor = 0; }
				delivered = self._queues.get(self._cursor++).dispatchOne(); if (delivered) { self._nativeTurn = true; }
			}
			if (!delivered) { delivered = self.dispatchSettlement(); if (delivered) { self._nativeTurn = false; } }
		} finally { self._dispatching = false; }
		return delivered;
	}

	public bool pending() { self.requireMainThread(); if (self._closed) { return false; } if (self._failure.failed()) { return true; } for registration in self._settlements { if (registration.pending()) { return true; } } for queue in self._queues { if (queue.pendingCount() > 0) { return true; } } return false; }

	public bool nativeQuitPending() { self.requireMainThread(); return self._nativeQuitPending; }

	public void setNativeQuitPending(bool pending) { self.requireMainThread(); self._nativeQuitPending = pending; }

	public void requireUI() { self.requireMainThread(); }

	public void requireMutationAllowed() { self.requireMainThread(); self.checkNativeFailure(); if (self._treeMutation) { throw "Native tree mutation is already active"; } }

	public void requireSemanticRegistration() { self.requireMutationAllowed(); if (self._routePreparations != 0) { throw "Native route preparation excludes new semantic registrations"; } }

	public void beginRoutePreparation() { self.requireMainThread(); if (self._routePreparations == 2147483647) { throw "Native route preparation depth exhausted"; } self._routePreparations++; }

	public void endRoutePreparation() { self.requireMainThread(); if (self._routePreparations <= 0) { throw "Native route preparation depth underflow"; } self._routePreparations--; }

	public void enterCloseDecision() { self.requireMainThread(); self._closeDecisionDepth++; }

	public void leaveCloseDecision() { self.requireMainThread(); if (self._closeDecisionDepth <= 0) { throw "Close decision entry underflow"; } self._closeDecisionDepth--; }

	public void requireModalAllowed() { self.requireMainThread(); if (self._closeDecisionDepth != 0) { throw "Modal alerts are forbidden inside close decision handlers"; } }

	public bool treeMutationActive() { self.requireMainThread(); return self._treeMutation; }

	public void beginTreeMutation() {
		self.requireMainThread(); self.checkNativeFailure();
		if (self._closed) { throw "Native view context is closed"; }
		if (self._treeMutation) { throw "Native tree mutation is already active"; }
		self._treeMutation = true;
	}

	/* A container releases delivery only after it has a coherent result. A wake
	 * serviced during mutation may have consumed the original queue signal. */
	public void endTreeMutation() {
		self.requireMainThread(); if (!self._treeMutation) { throw "Native tree mutation is not active"; }
		self._treeMutation = false;
		if (!self.wake.requestTurn()) { throw "Native tree mutation cannot resume delivery"; }
	}

	public void close() { self.requireMainThread(); if (self._treeMutation || self._routePreparations != 0) { throw "Native tree mutation is already active"; } if (self._closed) { return; } self._closed = true; for registration in self._settlements { registration.cancel(); } self._settlements.clear(); for queue in self._queues { queue.close(); } self._queues.clear(); }
}

interface IMacOSViewEligibility { void eligibilityLost(); }
class MacOSViewObservation implements IControlEventTarget {
	private MacOSViewState _state;
	public MacOSViewObservation(MacOSViewState state) { self._state = state; }

	public ControlEventDisposition admission(long long generation) { return self._state.observationAdmission(generation); }
}

/* The native owners supply visibility, enabled preferences and window facts.
 * Marking reaches the whole subtree before any cancellation callback runs. */
/* Alternative subtree destinations stay unexposed through native rollback.
 * Only reconciled destinations commit; snapshots retire after every generation. */
class MacOSViewRoute {
	public MacOSViewState root;
	public ControlEventQueue? destination;
	public ControlEventRebindBatch batch = ControlEventRebindBatch();
	public bool selected = false;
	public MacOSViewRoute(MacOSViewState root, ControlEventQueue? destination) { self.root = root; self.destination = destination; root.prepareRouteInto(self.batch, destination); }
}

class MacOSViewRoutes {
	private MacOSViewContext? _context;
	private Vector<MacOSViewRoute> _routes = [];
	private bool _committed = false;
	private bool _finished = false;
	public MacOSViewRoutes(MacOSViewContext? context) { self._context = context; if (context != null) { context.beginRoutePreparation(); } }

	public void prepare(MacOSViewState root, ControlEventQueue? destination) {
		for route in self._routes { if (route.root == root && route.destination == destination) { return; } }
		self._routes.push(MacOSViewRoute(root, destination));
	}

	public void select(MacOSViewState root, ControlEventQueue? destination) {
		if (root.routedTo(destination)) { return; }
		for route in self._routes { if (route.root == root && route.destination == destination) { route.selected = true; return; } }
		throw "Native route was not prepared before mutation";
	}

	public void validate() { for route in self._routes { if (route.selected) { route.batch.validate(); } } }

	public void commitRoutes() {
		self.validate();
		for route in self._routes { if (!route.selected) { route.batch.abort(); } }
		self._committed = true;
		for route in self._routes { if (route.selected) { route.batch.commitRoutes(); } }
		for route in self._routes { if (route.selected) { route.root.commitRouteMetadata(route.destination); } }
	}

	public void finish() {
		if (self._finished) { return; } self._finished = true; string failure = "";
		var context = self._context; self._context = null; if (context != null) { context.endRoutePreparation(); }
		for route in self._routes { try { if (self._committed && route.selected) { route.batch.finish(); } else { route.batch.abort(); } } catch (string error) { if (failure.isEmpty()) { failure = error; } } }
		self._routes.clear(); if (!failure.isEmpty()) { throw failure; }
	}

	public void __del__() { self.finish(); }
}

class MacOSViewState implements IControlEventTarget {
	private MacOSViewContext? _context;
	private ControlEventQueue? _queue;
	private IMacOSViewEligibility? _owner;
	private Vector<MacOSViewState> _children = [];
	private CallbackScope _callbacks = CallbackScope();
	private Vector<IControlEventChannel> _channels = [];
	private ControlEventChannel<IViewInteractionStateHandler, ViewInteractionState>? _observation;
	private ViewInteractionState _state = ViewInteractionState();
	private long long _generation = 1LL;
	private bool _parented = false;
	private bool _inherited = false;
	private bool _closing = false;
	private bool _closed = false;
	private bool _changed = false;
	private bool _lost = false;
	public MacOSViewState(IMacOSViewEligibility owner) {
		self.requireMainThread(); self._owner = owner;
		self._state.localVisible = true; self._state.localEnabled = true; self._state.layoutParticipating = true;
		self._state.exposure = WINDOW_EXPOSURE_UNKNOWN; self._state.stateRevision = 1LL;
	}

	private void requireMainThread() { if (!NSThread.isMainThread()) { throw "Native view state requires the main thread"; } }

	private void requireOpen() { self.requireMainThread(); if (self._closing || self._closed) { throw "Native view state is closing or closed"; } if (self._state.faulted) { throw "Native view is quarantined"; } }

	private void validateContext(MacOSViewContext context) {
		if (context == null || (self._context != null && self._context != context)) { throw "Native views cannot cross application contexts"; }
		for child in self._children { child.validateContext(context); }
	}

	public void configure(MacOSViewContext context) {
		self.requireOpen(); self.validateContext(context); self._context = context;
		if (self._queue == null) { self._queue = context.detachedEvents; }
		for child in self._children { child.configure(context); }
	}

	public void requireMutation() { self.requireOpen(); }

	public MacOSViewContext? context() { return self._context; }

	public ControlEventQueue events() { self.requireMainThread(); if (self._queue == null) { throw "Native semantic callbacks require an application context"; } return self._queue; }

	public long long generation() { return self._generation; }

	public bool effectiveEligible() { return !self._closing && !self._closed && (self._context == null || !self._context.nativeFailed()) && self._state.effectiveEligible; }

	public ControlEventDisposition observationAdmission(long long generation) { return self._closing || self._closed ? CONTROL_EVENT_CLOSED : generation != self._generation ? CONTROL_EVENT_STALE_GENERATION : CONTROL_EVENT_DELIVERED; }

	public ControlEventDisposition admission(long long generation) { var status = self.observationAdmission(generation); return status == CONTROL_EVENT_DELIVERED && !self.effectiveEligible() ? CONTROL_EVENT_INELIGIBLE : status; }

	public ViewInteractionState snapshot() {
		self.requireMainThread(); if (self._closing || self._closed) { throw "Native view state is closing or closed"; }
		var result = ViewInteractionState(); var state = self._state;
		result.localVisible = state.localVisible; result.localEnabled = state.localEnabled; result.inheritedEligible = state.inheritedEligible;
		result.effectiveEligible = state.effectiveEligible; result.layoutParticipating = state.layoutParticipating; result.exposure = state.exposure;
		result.faulted = state.faulted; result.stateRevision = state.stateRevision; return result;
	}

	class void deliverState(IViewInteractionStateHandler receiver, ViewInteractionState state) { receiver.interactionChanged(state); }

	public ICallbackRegistration observe(IViewInteractionStateHandler receiver, CallbackScope owner) {
		self.requireOpen(); if (self._context != null) { self._context.requireSemanticRegistration(); } self._callbacks.pollCompletion();
		for (int index = self._channels.len - 1; index >= 0; index--) { if (self._channels.get(index).pollCompletion() == CALLBACK_CANCELLATION_COMPLETE) { self._channels.remove(index); } }
		if (self._observation != null && self._observation.pollCompletion() != CALLBACK_CANCELLATION_COMPLETE) { throw "Cancel the existing interaction state handler first"; }
		var channel = new ControlEventChannel<IViewInteractionStateHandler, ViewInteractionState>(self.events(), MacOSViewObservation(self), receiver, MacOSViewState.deliverState, self._callbacks, self.events().captureEnabled() ? CONTROL_CAPTURE_OBSERVER : CONTROL_CAPTURE_LEGACY);
		try { owner.track(channel); } catch (string error) { channel.cancel(); throw error; }
		self._observation = channel; self._channels.push(channel); return channel;
	}

	public void ownChannel(IControlEventChannel channel) {
		try { self.requireOpen(); if (self._context != null) { self._context.requireSemanticRegistration(); } self._callbacks.pollCompletion(); self._callbacks.track(channel); }
		catch (string error) { channel.cancel(); throw error; }
		self._channels.push(channel);
	}

	private void revision() { if (self._state.stateRevision == 9223372036854775807LL) { throw "Native interaction revisions exhausted"; } self._state.stateRevision++; self._changed = true; }

	private void mark(bool inherited, WindowExposure exposure) {
		self._inherited = inherited;
		bool eligible = !self._closing && !self._closed && !self._state.faulted && self._parented && inherited && self._state.localVisible && self._state.localEnabled;
		if (self._state.inheritedEligible != inherited || self._state.effectiveEligible != eligible || self._state.exposure != exposure) {
			if (self._state.effectiveEligible && !eligible) { self._lost = true; }
			self.revision(); self._state.inheritedEligible = inherited; self._state.effectiveEligible = eligible; self._state.exposure = exposure;
		}
		for child in self._children { child.mark(eligible, exposure); }
	}

	private void settle() {
		string failure = "";
		if (self._lost) { self._lost = false; var owner = self._owner; if (owner != null) { try { owner.eligibilityLost(); } catch (string error) { failure = error; } } }
		for child in self._children { try { child.settle(); } catch (string error) { if (failure.isEmpty()) { failure = error; } } }
		if (!failure.isEmpty()) { throw failure; }
	}

	public bool routedTo(ControlEventQueue? queue) { return self._queue == queue; }

	public void prepareRouteInto(ControlEventRebindBatch batch, ControlEventQueue? queue) {
		self.requireMainThread();
		if (self._queue != queue) {
			if (self._generation == 9223372036854775807LL) { throw "Native view generations exhausted"; }
			for channel in self._channels { if (channel.isOpen()) { if (queue == null || !batch.prepare(channel, queue)) { throw "Native subtree capture capacity unavailable"; } } }
		}
		for child in self._children { child.prepareRouteInto(batch, queue); }
	}

	public void commitRouteMetadata(ControlEventQueue? queue) {
		if (self._queue != queue) { self._generation++; self._queue = queue; }
		for child in self._children { child.commitRouteMetadata(queue); }
	}

	public void prepareAttachment(MacOSViewState child, MacOSViewRoutes routes) {
		var context = self._context; if (context != null && child._context == null) { child.configure(context); }
		routes.prepare(child, self._queue);
	}

	public void prepareDetachment(MacOSViewState child, MacOSViewRoutes routes) { routes.prepare(child, child._context == null ? null : child._context.detachedEvents); }

	private void publish() {
		if (self._changed) {
			self._changed = false; var channel = self._observation;
			if (!self._closing && !self._closed && (self._context == null || !self._context.nativeFailed()) && channel != null && channel.isOpen() && !channel.publish(self.snapshot(), self._generation, 0LL, 1LL)) { throw "Interaction state semantic source is unavailable"; }
		}
		for child in self._children { child.publish(); }
	}

	private void refresh() { self.mark(self._inherited, self._state.exposure); self.settle(); self.publish(); }

	public void setVisible(bool visible) { self.requireOpen(); if (self._state.localVisible == visible) { return; } self.revision(); self._state.localVisible = visible; self.refresh(); }

	public void setEnabled(bool enabled) { self.requireOpen(); if (self._state.localEnabled == enabled) { return; } self.revision(); self._state.localEnabled = enabled; self.refresh(); }

	public void setLayoutParticipating(bool participating) { self.requireOpen(); if (self._state.layoutParticipating == participating) { return; } self.revision(); self._state.layoutParticipating = participating; self.publish(); }

	public void treeChanged() { self.requireOpen(); self.revision(); self.publish(); }

	public void quarantine() { self.requireOpen(); self.revision(); self._state.faulted = true; self.refresh(); }

	private bool contains(MacOSViewState node) { if (self == node) { return true; } for child in self._children { if (child.contains(node)) { return true; } } return false; }

	public bool hasChild(MacOSViewState child) { for entry in self._children { if (entry == child) { return true; } } return false; }

	public bool hasChildrenInOrder(Vector<MacOSViewState> children) {
		self.requireMainThread(); if (self._children.len != children.len) { return false; }
		for (int index = 0; index < children.len; index++) { if (self._children.get(index) != children.get(index)) { return false; } } return true;
	}

	public void validateChild(MacOSViewState child) {
		self.requireOpen(); child.requireOpen();
		if (child._parented || child.contains(self)) { throw "Native view already has a parent or creates a cycle"; }
		var context = self._context;
		if (context != null) { child.validateContext(context); }
		else if (child._context != null) { throw "Native views cannot cross application contexts"; }
	}

	public void addChild(MacOSViewState child) { self.validateChild(child); var children = self._children.copy(); children.push(child); self.replaceChildren(children); }

	/* Commit membership before any settlement callback. Reordering retained
	 * children preserves their route, generation and interaction revision. */
	public void replaceChildren(Vector<MacOSViewState> children, MacOSViewRoutes? prepared = null) {
		self.requireOpen();
		Vector<MacOSViewState> next = []; Vector<MacOSViewState> removed = [];
		for child in children {
			if (child == null) { throw "Native child state is missing"; }
			child.requireOpen();
			for previous in next { if (previous == child) { throw "Native child state is duplicated"; } }
			if (!self.hasChild(child)) { self.validateChild(child); }
			next.push(child);
		}
		for child in self._children {
			bool retained = false; for candidate in next { if (candidate == child) { retained = true; break; } }
			if (!retained) { removed.push(child); }
		}
		var routes = prepared == null ? MacOSViewRoutes(self._context) : prepared;
		if (prepared == null) { for child in removed { self.prepareDetachment(child, routes); } for child in next { self.prepareAttachment(child, routes); } }
		for child in removed { routes.select(child, child._context == null ? null : child._context.detachedEvents); }
		for child in next { routes.select(child, self._queue); }
		routes.validate();
		var context = self._context;
		for child in next { if (context != null && child._context == null) { child.configure(context); } }
		self._children = next;
		for child in removed {
			child._parented = false;
			child.mark(false, WINDOW_EXPOSURE_UNKNOWN);
		}
		for child in next { child._parented = true; child.mark(self.effectiveEligible(), self._state.exposure); }
		string failure = "";
		for child in removed { try { child.settle(); } catch (string error) { if (failure.isEmpty()) { failure = error; } } }
		for child in next { try { child.settle(); } catch (string error) { if (failure.isEmpty()) { failure = error; } } }
		routes.commitRoutes();
		if (prepared == null) { try { routes.finish(); } catch (string error) { if (failure.isEmpty()) { failure = error; } } }
		for child in removed { child.publish(); }
		for child in next { child.publish(); }
		if (!failure.isEmpty()) { throw failure; }
	}

	private void cancelSemanticTree() {
		string failure = "";
		try { self._callbacks.cancel(); } catch (string error) { failure = error; }
		for child in self._children { try { child.cancelSemanticTree(); } catch (string error) { if (failure.isEmpty()) { failure = error; } } }
		if (!failure.isEmpty()) { throw failure; }
	}

	/* Failed and closing forests have no usable destination stream. Retire
	 * their callbacks on the old route without acquiring new capture credits. */
	private void retireDetachment() {
		self._parented = false; string failure = "";
		try { self.mark(false, WINDOW_EXPOSURE_UNKNOWN); self.settle(); } catch (string error) { failure = error; }
		try { self.cancelSemanticTree(); } catch (string error) { if (failure.isEmpty()) { failure = error; } }
		if (!failure.isEmpty()) { throw failure; }
	}

	public void removeChild(MacOSViewState child) {
		self.requireMainThread(); int found = -1;
		for (int index = 0; index < self._children.len; index++) { if (self._children.get(index) == child) { found = index; break; } }
		if (found < 0) { throw "View state does not belong to this parent"; }
		if (self._closing || self._closed || (self._context != null && self._context.nativeFailed())) {
			self._children.remove(found); child.retireDetachment(); return;
		}
		var children = self._children.copy(); children.remove(found); self.replaceChildren(children);
	}

	public void validateWindow(ControlEventQueue queue) { self.requireOpen(); if (self._parented || self._context == null || queue.terminalPool() != self._context.detachedEvents.terminalPool()) { throw "Window root has no matching application context or is already attached"; } }

	public void attachWindow(ControlEventQueue queue, bool eligible, WindowExposure exposure, MacOSViewRoutes? prepared = null) {
		self.validateWindow(queue);
		var routes = prepared == null ? MacOSViewRoutes(self._context) : prepared; if (prepared == null) { routes.prepare(self, queue); } routes.select(self, queue); routes.validate();
		self._parented = true; self.mark(eligible, exposure); self.settle(); routes.commitRoutes(); if (prepared == null) { routes.finish(); } self.publish();
	}

	public void windowChanged(bool eligible, WindowExposure exposure) { self.requireOpen(); self.mark(eligible, exposure); self.settle(); self.publish(); }

	public void detachWindow(MacOSViewRoutes? prepared = null) {
		self.requireMainThread(); if (!self._parented || self._context == null) { throw "View has no window attachment"; }
		var context = self._context; if (context == null) { throw "View has no application context"; }
		if (self._closing || self._closed || context.nativeFailed()) { self.retireDetachment(); return; }
		var routes = prepared == null ? MacOSViewRoutes(self._context) : prepared; if (prepared == null) { routes.prepare(self, context.detachedEvents); } routes.select(self, context.detachedEvents); routes.validate();
		self._parented = false; self.mark(false, WINDOW_EXPOSURE_UNKNOWN); self.settle(); routes.commitRoutes(); if (prepared == null) { routes.finish(); } self.publish();
	}

	public CallbackCancellation close() {
		self.requireMainThread(); if (self._closed) { return CALLBACK_CANCELLATION_COMPLETE; }
		if (!self._closing) { self._closing = true; try { self.mark(false, self._state.exposure); self.settle(); } finally { self._callbacks.cancel(); } }
		return self.pollClose();
	}

	public CallbackCancellation pollClose() {
		self.requireMainThread(); if (self._closed) { return CALLBACK_CANCELLATION_COMPLETE; }
		if (!self._closing) { return CALLBACK_CANCELLATION_NOT_REQUESTED; }
		var result = self._callbacks.pollCompletion(); if (result != CALLBACK_CANCELLATION_COMPLETE) { return result; }
		self._closed = true; self._owner = null; self._observation = null; self._channels.clear(); return result;
	}

	public void __del__() { if (self.close() != CALLBACK_CANCELLATION_COMPLETE) { Console.fatal("View state destroyed before callback drain"); } }
}
