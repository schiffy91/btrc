import Library.GUI.MacOS.MacOSViewState;
import Library.Math;
import Library.Console;
import Library.Callback;
import Library.Vector;
import Library.GUI.IContainer;
import Library.GUI.IStack;
import Library.GUI.IView;
import Library.GUI.MacOS.MacOSContainer;
import Library.GUI.MacOS.MacOSView;

/* NSStackView applies its edge insets on the near side of the cross axis
 * only: under end or centre alignment the far inset is ignored. Padding is
 * therefore the host's: the stack is pinned inside a plain view by four
 * constraints whose constants are the padding. */
class MacOSStackLayout implements IMacOSContainerLayout {
	private NSView? _host;
	private NSStackView? _stack;
	private NSLayoutConstraint? _top;
	private NSLayoutConstraint? _right;
	private NSLayoutConstraint? _bottom;
	private NSLayoutConstraint? _left;
	private bool _vertical;
	private StackAlignment _alignment = STACK_ALIGN_START;
	private double _horizontalPadding = 0.0;
	private double _verticalPadding = 0.0;

	public MacOSStackLayout(bool vertical, double spacing) {
		if (!NSThread.isMainThread()) { throw "Native stacks require the main thread"; }
		self.validateLength(spacing);
		self._vertical = vertical;
		self._host = NSView.new();
		self._stack = NSStackView.new();
		if (self._host == null || self._stack == null) { throw "Cannot create native stack"; }
		var host = self.nativeView();
		var stack = self.control();
		NSView pinned = stack;
		pinned.setTranslatesAutoresizingMaskIntoConstraints(false);
		host.addSubview(pinned, NSWindowAbove, null);
		self._top = self.pin(pinned, NSLayoutAttributeTop, host, NSLayoutAttributeTop);
		self._left = self.pin(pinned, NSLayoutAttributeLeft, host, NSLayoutAttributeLeft);
		self._bottom = self.pin(host, NSLayoutAttributeBottom, pinned, NSLayoutAttributeBottom);
		self._right = self.pin(host, NSLayoutAttributeRight, pinned, NSLayoutAttributeRight);
		stack.setOrientation(vertical ? NSUserInterfaceLayoutOrientationVertical : NSUserInterfaceLayoutOrientationHorizontal);
		stack.setDetachesHiddenViews(false);
		stack.setSpacing(spacing);
		self.setAlignment(STACK_ALIGN_START);
	}

	private NSStackView control() {
		if (!NSThread.isMainThread()) { throw "Native stacks require the main thread"; }
		if (self._stack == null) { throw "Native stack is closed"; }
		return self._stack;
	}

	/* first.attribute == second.attribute + constant, the constant set later. */
	private NSLayoutConstraint pin(NSView first, long firstAttribute, NSView second, long secondAttribute) {
		var constraint = NSLayoutConstraint.constraintWithItem(first, firstAttribute, NSLayoutRelationEqual, second, secondAttribute, 1.0, 0.0);
		if (constraint == null) { throw "Cannot pin native stack"; }
		constraint.setActive(true);
		return constraint;
	}

	private void validateLength(double value) { if (!Math.isFinite(value) || value < 0.0) { throw "Stack spacing and padding must be finite and nonnegative"; } }

	public NSView nativeView() {
		if (!NSThread.isMainThread()) { throw "Native stacks require the main thread"; }
		if (self._host == null) { throw "Native stack is closed"; }
		return self._host;
	}

	public NSView childParent() { return self.control(); }

	public MacOSContainerPlacement captureChild(NSView child) {
		var placement = MacOSContainerPlacement(); var children = self.control().arrangedSubviews();
		unsigned long index = children.indexOfObjectIdenticalTo(child); placement.present = index < children.count(); placement.index = placement.present ? (int)index : -1; return placement;
	}

	public MacOSContainerPlacement insertionPlacement(int index) { var placement = MacOSContainerPlacement(); placement.index = index; return placement; }

	public void placeChild(NSView child, int index, MacOSContainerPlacement placement) { self.control().insertArrangedSubview(child, index); }

	public void forgetChild(NSView child) { self.control().removeArrangedSubview(child); }

	public double spacing() { return self.control().spacing(); }

	public void setSpacing(double spacing) { self.validateLength(spacing); self.control().setSpacing(spacing); }

	public StackAlignment alignment() { self.control(); return self._alignment; }

	public void setAlignment(StackAlignment alignment) {
		var stack = self.control();
		if (alignment == STACK_ALIGN_START) { stack.setAlignment(self._vertical ? NSLayoutAttributeLeading : NSLayoutAttributeTop); }
		else if (alignment == STACK_ALIGN_CENTER) { stack.setAlignment(self._vertical ? NSLayoutAttributeCenterX : NSLayoutAttributeCenterY); }
		else if (alignment == STACK_ALIGN_END) { stack.setAlignment(self._vertical ? NSLayoutAttributeTrailing : NSLayoutAttributeBottom); }
		else { throw "Unknown stack alignment"; }
		self._alignment = alignment;
	}

	public void setPadding(double top, double right, double bottom, double left) {
		self.validateLength(top); self.validateLength(right); self.validateLength(bottom); self.validateLength(left);
		self.validateLength(top + bottom); self.validateLength(left + right);
		self.control();
		var pinTop = self._top; var pinRight = self._right; var pinBottom = self._bottom; var pinLeft = self._left;
		if (pinTop == null || pinRight == null || pinBottom == null || pinLeft == null) { throw "Native stack is closed"; }
		pinTop.setConstant(top); pinRight.setConstant(right); pinBottom.setConstant(bottom); pinLeft.setConstant(left);
		self._horizontalPadding = left + right; self._verticalPadding = top + bottom;
	}

	public bool vertical() { return self._vertical; }

	/* Both edges' padding along one axis. */
	public double padding(bool horizontal) { return horizontal ? self._horizontalPadding : self._verticalPadding; }

	public void layout() { self.nativeView().layoutSubtreeIfNeeded(); }

	public void close() {
		if (!NSThread.isMainThread()) { throw "Native stacks require the main thread"; }
		self._top = null; self._right = null; self._bottom = null; self._left = null;
		self._stack = null; self._host = null;
	}
}

/* The existing container owns attachment transactions and descendants; the
 * layout policy owns only native arrangement. Neither has a backreference. */
class MacOSStack implements IStack, IMacOSView {
	private MacOSContainer _container;
	private MacOSStackLayout _layout;

	public MacOSStack(bool vertical, double spacing) { self._layout = MacOSStackLayout(vertical, spacing); self._container = MacOSContainer(self._layout); }

	public MacOSViewState stateNode() { return self._container.stateNode(); }

	public ViewInteractionState interactionState() { return self._container.interactionState(); }

	public ICallbackRegistration onInteractionStateChanged(IViewInteractionStateHandler handler, CallbackScope owner) { return self._container.onInteractionStateChanged(handler, owner); }

	public NSView nativeView() { return self._container.nativeView(); }

	public void attachTo(NSView parent) { self._container.attachTo(parent); }

	public void detachFrom(NSView parent) { self._container.detachFrom(parent); }

	public bool isOpen() { return self._container.isOpen(); }

	public long long treeRevision() { return self._container.treeRevision(); }

	public ContainerBatchResult applyBatch(long long revision, Vector<ContainerEdit> edits) { return self._container.applyBatch(revision, edits); }

	public void insert(IView child, int index) { self._container.insert(child, index); }

	public void move(IView child, int destinationIndex) { self._container.move(child, destinationIndex); }

	public void attach(IView child) { self._container.attach(child); }

	public IView detach(IView child) { return self._container.detach(child); }

	public int childCount() { return self._container.childCount(); }

	public IView childAt(int index) { return self._container.childAt(index); }

	/* AppKit packs a stack by its children's alignment rectangles, and a
	 * control's frame may be larger than its own: a push button's was, by its
	 * bezel, before macOS 26. A stack fits the frames it holds, with its
	 * spacing between them and its padding around them. */
	private double framesExtent(bool horizontal) {
		bool along = horizontal != self._layout.vertical();
		int count = self._container.childCount();
		double extent = 0.0;
		for (int index = 0; index < count; index++) {
			var child = self._container.childAt(index);
			double size = horizontal ? child.fittingWidth() : child.fittingHeight();
			if (along) { extent += size; } else if (size > extent) { extent = size; }
		}
		if (along && count > 1) { extent += self._layout.spacing() * (double)(count - 1); }
		return extent + self._layout.padding(horizontal);
	}

	public double fittingWidth() {
		double native = self._container.fittingWidth();
		double frames = self.framesExtent(true);
		return frames > native ? frames : native;
	}

	public double fittingHeight() {
		double native = self._container.fittingHeight();
		double frames = self.framesExtent(false);
		return frames > native ? frames : native;
	}

	public void arrange(double x, double y, double width, double height) { self._container.arrange(x, y, width, height); }

	public bool isVisible() { return self._container.isVisible(); }

	public ICallbackRegistration onPointer(IViewPointerHandler handler, CallbackScope owner) { return self._container.onPointer(handler, owner); }

	public ICallbackRegistration onScroll(IViewScrollHandler handler, CallbackScope owner) { return self._container.onScroll(handler, owner); }

	public ICallbackRegistration onMagnify(IViewMagnifyHandler handler, CallbackScope owner) { return self._container.onMagnify(handler, owner); }

	public void cancelPointerCapture() { self._container.cancelPointerCapture(); }

	public void setVisible(bool visible) { self._container.setVisible(visible); }

	public double spacing() { self.nativeView(); return self._layout.spacing(); }

	public void setSpacing(double spacing) { self.stateNode().requireMutation(); self.nativeView(); self._layout.setSpacing(spacing); }

	public StackAlignment alignment() { self.nativeView(); return self._layout.alignment(); }

	public void setAlignment(StackAlignment alignment) { self.stateNode().requireMutation(); self.nativeView(); self._layout.setAlignment(alignment); }

	public void setPadding(double top, double right, double bottom, double left) { self.stateNode().requireMutation(); self.nativeView(); self._layout.setPadding(top, right, bottom, left); }

	public void layout() { self.stateNode().requireMutation(); self.nativeView(); self._layout.layout(); }

	public CallbackCancellation close() {
		// A constructor can fail before either managed field is initialized.
		var state = self._container == null ? CALLBACK_CANCELLATION_COMPLETE : self._container.close();
		if (state == CALLBACK_CANCELLATION_COMPLETE && self._layout != null) { self._layout.close(); }
		return state;
	}

	public CallbackCancellation pollClose() {
		var state = self._container == null ? CALLBACK_CANCELLATION_COMPLETE : self._container.pollClose();
		if (state == CALLBACK_CANCELLATION_COMPLETE && self._layout != null) { self._layout.close(); }
		return state;
	}

	public void __del__() { if (self.close() != CALLBACK_CANCELLATION_COMPLETE) { Console.fatal("Native stack destroyed before subtree cleanup completed"); } }
}
