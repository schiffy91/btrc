import Library.Callback;
import Library.Vector;
import Library.Console;
import Library.GUI.IContainer;
import Library.GUI.IView;
import Library.GUI.ControlEventQueue;
import Library.GUI.MacOS.MacOSControlEvents;
import Library.GUI.MacOS.MacOSView;
import Library.GUI.MacOS.MacOSViewInput;

/* Layout metadata is separate from physical parentage and subtree ownership.
 * forgetChild is idempotent; it removes layout participation, not the view.
 * Neither policy nor child may retain this container owner. */
interface IMacOSContainerLayout {
	NSView nativeView();
	NSView childParent();
	void arrangeChild(NSView child);
	void forgetChild(NSView child);
}

class MacOSContainerChild {
	public IView view;
	public bool translatesAutoresizing;
	public bool closing = false;
	public bool failed = false;
	public bool pinned = false;
	public unsigned long autoresizingMask = 0UL;

	public MacOSContainerChild(IView view, bool translatesAutoresizing) { self.view = view; self.translatesAutoresizing = translatesAutoresizing; }
}

/* A native grouping view with BTRC-owned children, not an OS-handle registry.
 * Native parents are queried when needed; children never retain BTRC parents. */
class MacOSContainer implements IContainer, IMacOSView {
	private NSView? _view;
	private Vector<MacOSContainerChild> _children = [];
	private IMacOSContainerLayout? _layout;
	private bool _attached = false;
	private bool _closing = false;
	private CallbackScope _input = CallbackScope();
	private Vector<MacOSViewInput> _inputs = [];
	private bool _mutating = false;
	private string _closeFailure = "";
	private MacOSViewState? _interaction;
	private bool _inherited = false;
	private bool _lostEligibility = false;
	private WindowExposure _exposure = WINDOW_EXPOSURE_UNKNOWN;
	private ControlEventQueue? _windowEvents;
	private bool _routePending = false;

	public MacOSContainer(IMacOSContainerLayout? layout = null, MacOSControlContext? context = null) {
		self.requireMainThread();
		self._layout = layout;
		self._view = layout == null ? NSView.new() : layout.nativeView();
		if (self._view == null) { throw "Cannot create native container"; }
		var semanticContext = context;
		if (semanticContext == null) { semanticContext = MacOSControlContext.defaultContext(); }
		self._interaction = MacOSViewState(semanticContext);
	}

	private void requireMainThread() {
		if (!NSThread.isMainThread()) { throw "Native containers require the main thread"; }
	}

	public MacOSViewState interactionOwner() {
		self.requireMainThread(); var state = self._interaction;
		if (state == null) { throw "Native container interaction state is unavailable"; }
		return state;
	}

	public ViewInteractionState interactionState() {
		self.requireMainThread();
		if (self._view == null || self._closing) { throw "Native container is closed"; }
		return self.interactionOwner().interactionState();
	}

	public ICallbackRegistration onInteractionStateChanged(IViewInteractionStateHandler handler, CallbackScope owner) { self.nativeView(); return self.interactionOwner().onInteractionStateChanged(handler, owner); }

	public void markInteraction(bool inherited, WindowExposure exposure, ControlEventQueue? events) {
		var view = self.nativeView(); var state = self.interactionOwner();
		self._inherited = inherited; self._exposure = exposure; self._windowEvents = events;
		if (state.update(!view.isHidden(), true, inherited, self._attached, exposure, false)) { self._lostEligibility = true; }
		self._routePending = true;
		bool eligible = state.interactionState().effectiveEligible;
		for child in self._children { if (!child.closing) { self.projection(child.view).markInteraction(eligible, exposure, events); } }
	}

	public void settleInteraction() {
		self.requireMainThread();
		if (self._lostEligibility) { self._lostEligibility = false; MacOSViewInput.detached(self._inputs); }
		for child in self._children { if (!child.closing && child.view.isOpen()) { self.projection(child.view).settleInteraction(); } }
	}

	public void publishInteraction() {
		self.requireMainThread(); if (self._closing) { return; }
		var state = self.interactionOwner();
		if (self._routePending) {
			if (self._windowEvents == null) { state.rebindDetached(); } else { state.rebind(self._windowEvents); }
			self._routePending = false;
		}
		state.publish();
		for child in self._children { if (!child.closing && child.view.isOpen()) { self.projection(child.view).publishInteraction(); } }
	}

	private void refreshInteraction() {
		self.markInteraction(self._inherited, self._exposure, self._windowEvents);
		self.settleInteraction(); self.publishInteraction();
	}

	public NSView nativeView() {
		self.requireMainThread();
		if (self._view == null) { throw "Native container is closed"; }
		if (self._closing) { throw "Native container shutdown has started"; }
		var interaction = self._interaction;
		if (interaction != null && (!interaction.isOpen() || interaction.faulted())) { throw "Native container is quarantined"; }
		return self._view;
	}

	private IMacOSView projection(IView child) {
		if (child == null) { throw "Cannot attach a missing view"; }
		IMacOSView? native = (IMacOSView?)child;
		if (native == null) { throw "View has no macOS implementation"; }
		return native;
	}

	private NSView mutationView() {
		var view = self.nativeView();
		if (self._mutating) { throw "Native container mutation is already active"; }
		return view;
	}

	private int childIndex(IView child) {
		for (int index = 0; index < self._children.len; index++) {
			if (self._children.get(index).view == child) { return index; }
		}
		throw "View does not belong to this container";
	}

	public bool isOpen() { self.requireMainThread(); return self._view != null && !self._closing; }

	public int childCount() { self.requireMainThread(); return self._children.len; }

	public IView childAt(int index) {
		self.requireMainThread();
		if (index < 0 || index >= self._children.len) { throw "Container child index is out of bounds"; }
		return self._children.get(index).view;
	}

	public void attach(IView child) {
		var parent = self.mutationView();
		self._mutating = true;
		try { self.attachChild(child, parent); self.refreshInteraction(); } catch (string error) { self._mutating = false; throw error; }
		self._mutating = false;
	}

	private void attachChild(IView child, NSView parent) {
		var childParent = self._layout == null ? parent : self._layout.childParent();
		var native = self.projection(child);
		self.interactionOwner().requireSameContext(native.interactionOwner());
		var childView = native.nativeView();
		MacOSView.validateAttachment(childView, childParent);
		// Retain before publishing to AppKit, so allocation cannot fail after
		// native attachment has transferred the child's lifecycle to this tree.
		var entry = MacOSContainerChild(child, childView.translatesAutoresizingMaskIntoConstraints());
		self._children.push(entry);
		bool attached = false;
		try {
			native.attachTo(childParent);
			attached = true;
			if (self._layout != null) { self._layout.arrangeChild(childView); }
			MacOSContainer.pinTop(entry, childView, childParent);
		} catch (string error) {
			if (attached) {
				try { self.detachChild(entry, parent); }
				catch (string rollback) { entry.failed = true; self._closing = true; self._closeFailure = rollback; throw rollback; }
			}
			if (childView.superview() == childParent) {
				entry.failed = true;
				self._closeFailure = error;
				self._closing = true;
			} else {
				self._children.pop();
			}
			throw error;
		}
	}

	/* arrange() converts the top-left contract to an origin once. A child the
	 * layout left frame-positioned keeps that top distance when its parent
	 * resizes; Auto Layout children are positioned by their constraints. */
	class void pinTop(MacOSContainerChild entry, NSView child, NSView parent) {
		if (!child.translatesAutoresizingMaskIntoConstraints()) { return; }
		entry.autoresizingMask = child.autoresizingMask();
		entry.pinned = true;
		unsigned long vertical = NSViewMinYMargin | NSViewMaxYMargin | NSViewHeightSizable;
		child.setAutoresizingMask((entry.autoresizingMask & ~vertical) | (parent.isFlipped() ? NSViewMaxYMargin : NSViewMinYMargin));
	}

	private void detachChild(MacOSContainerChild entry, NSView parent) {
		var childParent = self._layout == null ? parent : self._layout.childParent();
		var native = self.projection(entry.view);
		var child = native.nativeView();
		if (self._layout != null) { self._layout.forgetChild(child); }
		native.detachFrom(childParent);
		if (entry.pinned) { child.setAutoresizingMask(entry.autoresizingMask); entry.pinned = false; }
		child.setTranslatesAutoresizingMaskIntoConstraints(entry.translatesAutoresizing);
	}

	public IView detach(IView child) {
		var parent = self.mutationView();
		int index = self.childIndex(child);
		self._mutating = true;
		try {
			self.detachChild(self._children.get(index), parent);
			self._children.remove(index);
		} catch (string error) {
			self._mutating = false;
			self._children.get(index).failed = true;
			self._closeFailure = error;
			self._closing = true;
			throw error;
		}
		self._mutating = false;
		self.refreshInteraction();
		return child;
	}

	public void attachTo(NSView parent) {
		var view = self.mutationView();
		if (self._attached) { throw "View already belongs to a container"; }
		MacOSView.validateAttachment(view, parent);
		self._attached = true;
		self._mutating = true;
		try { MacOSView.attachNative(view, parent); } catch (string error) {
			self._mutating = false;
			self._attached = view.superview() == parent;
			throw error;
		}
		self._mutating = false;
	}

	public void detachFrom(NSView parent) {
		var view = self.mutationView();
		if (!self._attached) { throw "View has no container attachment"; }
		self._mutating = true;
		try {
			self.markInteraction(false, WINDOW_EXPOSURE_UNKNOWN, null);
			self.settleInteraction();
			MacOSView.detachNative(view, parent);
			self._attached = false;
			self.publishInteraction();
		} catch (string error) { self.quarantineInteraction(error); throw error; }
		finally { self._mutating = false; }
	}

	public double fittingWidth() { return self.nativeView().fittingSize().width; }

	public double fittingHeight() { return self.nativeView().fittingSize().height; }

	public void arrange(double x, double y, double width, double height) { MacOSView.arrangeNative(self.nativeView(), x, y, width, height); }

	public bool isVisible() { return !self.nativeView().isHidden(); }

	public ICallbackRegistration onPointer(IViewPointerHandler handler, CallbackScope owner) { return MacOSViewInput.subscribe(self.nativeView(), handler, null, self._input, owner, self._inputs); }

	public ICallbackRegistration onScroll(IViewScrollHandler handler, CallbackScope owner) { return MacOSViewInput.subscribe(self.nativeView(), null, handler, self._input, owner, self._inputs); }

	public void cancelPointerCapture() {
		MacOSViewInput.detached(self._inputs);
		for child in self._children { if (!child.closing) { self.projection(child.view).cancelPointerCapture(); } }
	}

	private void quarantineInteraction(string failure) {
		var state = self.interactionOwner(); var view = self._view;
		if (view == null || self._closing) { return; }
		if (!state.isOpen()) { self._input.cancel(); return; }
		state.update(!view.isHidden(), true, false, self._attached, self._exposure, true);
		/* Every child is marked before cancellation can enter user code. The
		 * tree and native owners remain inspectable until explicit close. */
		for child in self._children { if (!child.closing) { self.projection(child.view).markInteraction(false, self._exposure, self._windowEvents); } }
		try { self._input.cancel(); self.settleInteraction(); state.publish(); }
		catch (string cleanup) { throw f"Native interaction failed: {failure}; quarantine failed: {cleanup}"; }
	}

	public void setVisible(bool visible) {
		var view = self.mutationView();
		if (view.isHidden() == !visible) { return; }
		var state = self.interactionOwner();
		self._mutating = true;
		try {
			if (state.update(visible, true, self._inherited, self._attached, self._exposure, false)) { self._lostEligibility = true; }
			bool eligible = state.interactionState().effectiveEligible;
			for child in self._children { if (!child.closing) { self.projection(child.view).markInteraction(eligible, self._exposure, self._windowEvents); } }
			self.settleInteraction();
			view.setHidden(!visible);
			self.publishInteraction();
		} catch (string error) { self.quarantineInteraction(error); throw error; }
		finally { self._mutating = false; }
	}

	public CallbackCancellation close() {
		self.requireMainThread();
		if (self._view == null) { return CALLBACK_CANCELLATION_COMPLETE; }
		if (self._mutating) { throw "Native container mutation is already active"; }
		if (self._attached) { throw "Detach the view from its container before closing it"; }
		if (!self._closing) { self._closing = true; self.interactionOwner().close(); self._input.cancel(); }
		return self.pollClose();
	}

	public CallbackCancellation pollClose() {
		self.requireMainThread();
		if (self._mutating) { throw "Native container mutation is already active"; }
		var view = self._view;
		if (view == null) { return CALLBACK_CANCELLATION_COMPLETE; }
		if (!self._closing) { return CALLBACK_CANCELLATION_NOT_REQUESTED; }
		var input = self._input.pollCompletion();
		if (input != CALLBACK_CANCELLATION_COMPLETE) { return input; }
		var semantic = self.interactionOwner().pollClose();
		if (semantic != CALLBACK_CANCELLATION_COMPLETE) { return semantic; }
		self._mutating = true;
		CallbackCancellation result = CALLBACK_CANCELLATION_COMPLETE;
		try {
			for (int index = self._children.len - 1; index >= 0; index--) {
				var child = self._children.get(index);
				if (child.failed) { continue; }
				try {
					CallbackCancellation state = CALLBACK_CANCELLATION_PENDING;
					if (!child.closing) {
						self.detachChild(child, view);
						child.closing = true;
						state = child.view.close();
					} else { state = child.view.pollClose(); }
					if (state == CALLBACK_CANCELLATION_COMPLETE) { self._children.remove(index); }
					else if (state == CALLBACK_CANCELLATION_FAILED) { result = state; }
					else if (result != CALLBACK_CANCELLATION_FAILED) {
						if (state == CALLBACK_CANCELLATION_RETRYABLE_FAILURE) { result = state; }
						else if (result != CALLBACK_CANCELLATION_RETRYABLE_FAILURE) { result = CALLBACK_CANCELLATION_PENDING; }
					}
				} catch (string error) {
					child.failed = true;
					if (self._closeFailure.isEmpty()) { self._closeFailure = error; }
				}
			}
			if (self._closeFailure.isEmpty() && self._children.len == 0) {
				try { view.removeFromSuperview(); self._view = null; }
				catch (string error) { self._closeFailure = error; }
			}
		} finally { self._mutating = false; }
		if (!self._closeFailure.isEmpty()) { throw self._closeFailure; }
		return result;
	}

	public void __del__() { if (self.close() != CALLBACK_CANCELLATION_COMPLETE) { Console.fatal("Native container destroyed before subtree cleanup completed"); } }
}
