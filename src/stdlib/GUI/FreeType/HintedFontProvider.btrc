import Library.GUI.IFontFace;

import ./FreeTypeFace.btrc;
import ../OpenType/HintedTrueTypeFace.btrc;

/* The gate covers both rendering and a transition to the SDK. Keep the
 * font's original bytes so fallback still works after the path changes. */
class HintedFontProvider implements IFontFace {
	private HintedTrueTypeFace? reader;
	private FontMetrics lineMetrics;
	private FreeTypeFace? nativeFace = null;
	private int pixels;
	private Atomic<uint> gate;

	public HintedFontProvider(HintedTrueTypeFace reader, int pixels) {
		self.reader = reader;
		self.lineMetrics = reader.metrics();
		self.pixels = pixels;
		self.gate.init(0u);
	}

	public FontMetrics metrics() { return self.lineMetrics; }

	private bool claimGlyph() {
		uint expected = 0u;
		return self.gate.compareExchangeStrong(&expected, 1u, MemoryOrder.ACQ_REL, MemoryOrder.ACQUIRE);
	}

	public FontGlyph? glyph(int code, bool render) {
		if (!self.claimGlyph()) { throw "FreeType face is already loading a glyph"; }
		try {
			var portable = self.reader;
			if (portable != null) {
				var glyph = portable.glyph(code, render);
				if (glyph != null) { return glyph; }
				self.nativeFace = new FreeTypeFace("", self.pixels, portable.source);
				self.reader = null;
			}
			return self.nativeFace.glyph(code, render);
		} finally { self.gate.store(0u, MemoryOrder.RELEASE); }
	}
}
