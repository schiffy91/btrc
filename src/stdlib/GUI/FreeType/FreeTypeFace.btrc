import Library.Bytes;
import Library.GUI.IFontFace;
import Library.OwnedBuffer;

/* Private FreeType face behind Library.GUI.FreeType's FreeType.load; this
 * module is not exported, and Font and Raster stay SDK-free.
 *
 * Setup is FT_Init_FreeType, FT_New_Face with face index zero, then
 * FT_Set_Pixel_Sizes(face, 0, pixelSize); any failure throws instead of
 * falling back to the bitmap font. The library and face are unique native
 * owners (see the FreeType binding in GUI/btrc.toml): no raw handle crosses
 * this class, and the destructor closes the face before its library. The
 * release policy relies on a freshly created valid claim having reference
 * count one, so FT_Done_Face and FT_Done_FreeType consume it; this provider
 * imports no FT_Reference_* function.
 *
 * Face metrics (size.metrics ascender and height, signed 26.6) are copied
 * once at construction. Each glyph call claims the gate below, runs
 * FT_Load_Char and copies everything it needs through the generated
 * record-path snapshots before the gate opens again: the glyph slot is
 * mutable face state, so retaining the face does not stabilize its buffer.
 * An overlapping call on the same face throws rather than waits. A rendered
 * glyph copies abs(pitch) * rows bitmap bytes, preserving signed pitch and
 * row padding, under an explicit 64 MiB bound; dimensions are validated
 * before narrowing to BTRC ints. Unsupported pixel modes keep their advance
 * and carry no ink. Allocation fault injection and overlapping native-thread
 * admission are not qualified. */
class FreeTypeFace implements IFontFace {
	private FT_Library? library = null;
	private FT_Face? face = null;
	private FontMetrics faceMetrics;
	private Atomic<uint> gate;

	public FreeTypeFace(string path, int pixelSize) {
		self.gate.init(0u);
		if (path == null || path.isEmpty() || pixelSize < 1) { throw "FreeType requires a font path and positive pixel size"; }
		var initialized = FT_Init_FreeType();
		self.library = initialized.value;
		if (initialized.status != 0 || self.library == null) { throw "Cannot initialize FreeType library"; }
		var loaded = FT_New_Face(self.library, path, 0L);
		self.face = loaded.value;
		if (loaded.status != 0 || self.face == null) { throw "Cannot load FreeType face"; }
		if (FT_Set_Pixel_Sizes(self.face, 0U, (unsigned int)pixelSize) != 0) { throw "Cannot set FreeType pixel size"; }
		var metrics = copyFreeTypeMetrics(self.face);
		if (metrics == null) { throw "Cannot copy FreeType face metrics"; }
		self.faceMetrics = new FontMetrics((long long)metrics.ascender, (long long)metrics.height);
	}

	public FontMetrics metrics() { return self.faceMetrics; }

	private bool claimGlyph() {
		uint expected = 0u;
		return self.gate.compareExchangeStrong(&expected, 1u, MemoryOrder.ACQ_REL, MemoryOrder.ACQUIRE);
	}

	public FontGlyph? glyph(int codepoint, bool render) {
		if (codepoint < 0 || codepoint > 0x10ffff || (codepoint >= 0xd800 && codepoint <= 0xdfff)) { throw "Invalid font Unicode scalar"; }
		if (!self.claimGlyph()) { throw "FreeType face is already loading a glyph"; }
		FontGlyph? result = null;
		try { result = self.loadGlyph(codepoint, render); }
		finally { self.gate.store(0u, MemoryOrder.RELEASE); }
		return result;
	}

	private FontGlyph? loadGlyph(int codepoint, bool render) {
		if (FT_Load_Char(self.face, (unsigned long)codepoint, render ? FT_LOAD_RENDER : FT_LOAD_DEFAULT) != 0) { return null; }
		if (!render) {
			var advance = copyFreeTypeAdvance(self.face);
			if (advance == null) { throw "Cannot copy FreeType glyph advance"; }
			return new FontGlyph((long long)advance.advanceX, 0, 0, 0, 0, 0, FONT_PIXEL_UNSUPPORTED, 0, new Bytes());
		}
		/* Explicit allocation limit for one raster glyph, not an unchecked
			 * native length. Null reports invalid metadata/oversized storage. */
		var snapshot = copyFreeTypeGlyph(self.face, 64 * 1024 * 1024);
		if (snapshot == null || snapshot.width > 2147483647U || snapshot.rows > 2147483647U) { throw "Cannot copy bounded FreeType glyph bitmap"; }
		FontPixelMode mode = FONT_PIXEL_UNSUPPORTED;
		if (snapshot.pixelMode == FT_PIXEL_MODE_MONO) { mode = FONT_PIXEL_MONO; }
		else if (snapshot.pixelMode == FT_PIXEL_MODE_GRAY) { mode = FONT_PIXEL_GRAY; }
		return new FontGlyph((long long)snapshot.advanceX, snapshot.left, snapshot.top, (int)snapshot.width, (int)snapshot.rows, snapshot.pitch, mode, (int)snapshot.numGrays, snapshot.bitmap);
	}

	/* Valid library and face claims are private, so no consumer can reference,
	 * close or mutate their native handles independently of this dependency. */
	public void __del__() {
		if (self.face != null) { self.face.close(); }
		if (self.library != null) { self.library.close(); }
	}
}
