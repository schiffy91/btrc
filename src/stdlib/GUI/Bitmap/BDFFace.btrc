import Library.Bytes;
import Library.GUI.IFontFace;
import Library.Strings;
import Library.Vector;

/* Adobe BDF 2.1 / 2.2 monochrome strikes. */
class BDFReader {
	private Bytes source;
	private int offset = 0;

	public BDFReader(Bytes source) { self.source = source; }

	public bool atEnd() { return self.offset >= self.source.length(); }

	public string line() {
		int start = self.offset;
		int end = start;
		while (end < self.source.length() && self.source.get(end) != 10) {
			if (self.source.get(end) == 0 || end - start >= 65536) { throw "Invalid BDF line"; }
			end++;
		}
		if (start >= self.source.length()) { throw "Truncated BDF font"; }
		self.offset = end < self.source.length() ? end + 1 : end;
		if (end > start && self.source.get(end - 1) == 13) { end--; }
		return self.source.slice(start, end).toString();
	}

	public string record() {
		string line = self.line();
		while (line.isEmpty() || line.startsWith("COMMENT ") || line.equals("COMMENT")) { line = self.line(); }
		return line;
	}

	public Vector<int> numbers(string record, string name, int count) {
		var raw = Strings.split(record, " ");
		Vector<string> fields = [];
		for (int i = 0; i < raw.len; i++) {
			string item = raw.get(i);
			if (!item.isEmpty()) { fields.push(item); }
		}
		if (fields.len != count + 1 || !fields.get(0).equals(name)) { throw "Unexpected BDF record"; }
		Vector<int> values = [];
		for (int i = 1; i <= count; i++) {
			string token = fields.get(i);
			string digits = token.startsWith("-") ? token.substring(1, token.len() - 1) : token;
			if (digits.isEmpty() || digits.len() > 7 || !digits.isDigit()) { throw "Invalid BDF integer"; }
			values.push(Strings.toInt(token));
		}
		return values;
	}
}

class BDFFace implements IFontFace {
	private Vector<int> codes = [];
	private Vector<FontGlyph> glyphs = [];
	private int missing = -1;
	private bool glyphIndices = false;
	private FontMetrics lineMetrics;

	public BDFFace(Bytes bytes, int pixelSize) {
		var input = new BDFReader(bytes);
		string start = input.record();
		if (!start.equals("STARTFONT 2.1") && !start.equals("STARTFONT 2.2")) { throw "Unsupported BDF version"; }
		string row = input.record();
		while (row.startsWith("CONTENTVERSION ")) { row = input.record(); }
		if (!row.startsWith("FONT ")) { throw "Missing BDF font name"; }
		var sizeInfo = input.numbers(input.record(), "SIZE", 3);
		var bbox = input.numbers(input.record(), "FONTBOUNDINGBOX", 4);
		row = input.record();
		while (row.startsWith("METRICSSET ") || row.startsWith("SWIDTH ") || row.startsWith("DWIDTH ") || row.startsWith("SWIDTH1 ") || row.startsWith("DWIDTH1 ") || row.startsWith("VVECTOR ")) {
			row = input.record();
		}
		int ascent = -1;
		int descent = -1;
		int pixels = -1;
		int defaultCode = -1;
		string registry = "";
		string encoding = "";
		if (row.startsWith("STARTPROPERTIES ")) {
			int properties = input.numbers(row, "STARTPROPERTIES", 1).get(0);
			if (properties < 0 || properties > 4096) { throw "Invalid BDF properties"; }
			for (int i = 0; i < properties; i++) {
				string prop = input.record();
				if (prop.startsWith("FONT_ASCENT ")) { ascent = input.numbers(prop, "FONT_ASCENT", 1).get(0); }
				else if (prop.startsWith("FONT_DESCENT ")) { descent = input.numbers(prop, "FONT_DESCENT", 1).get(0); }
				else if (prop.startsWith("PIXEL_SIZE ")) { pixels = input.numbers(prop, "PIXEL_SIZE", 1).get(0); }
				else if (prop.startsWith("DEFAULT_CHAR ")) { defaultCode = input.numbers(prop, "DEFAULT_CHAR", 1).get(0); }
				else if (prop.startsWith("CHARSET_REGISTRY ")) { registry = self.propertyString(prop); }
				else if (prop.startsWith("CHARSET_ENCODING ")) { encoding = self.propertyString(prop); }
			}
			if (!input.record().equals("ENDPROPERTIES")) { throw "Unterminated BDF properties"; }
			row = input.record();
		}
		if (ascent < 0 && descent < 0) {
			ascent = bbox.get(1) + bbox.get(3);
			descent = -bbox.get(3);
			if (ascent < 0) { ascent = 0; }
			if (descent < 0) { descent = 0; }
		}
		if (pixels < 0) {
			long long derived = ((long long)sizeInfo.get(0) * (long long)sizeInfo.get(2) + 36LL) / 72LL;
			pixels = derived > 0LL && derived <= 2048LL ? (int)derived : ascent + descent;
		}
		if (pixels != pixelSize || pixels < 1 || pixels > 2048) { throw "Unavailable BDF strike"; }
		self.glyphIndices = self.usesGlyphIndices(registry, encoding);
		if (ascent < 0 || ascent > 32767 || descent < 0 || descent > 32767) { throw "Invalid BDF line metrics"; }
		self.lineMetrics = new FontMetrics((long long)ascent * 64LL, (long long)(ascent + descent) * 64LL);
		int count = input.numbers(row, "CHARS", 1).get(0);
		if (count < 1 || count > 65535) { throw "Invalid BDF glyph count"; }
		for (int i = 0; i < count; i++) {
			if (!input.record().startsWith("STARTCHAR ")) { throw "Missing BDF glyph name"; }
			int code = input.numbers(input.record(), "ENCODING", 1).get(0);
			var bitmap = self.readGlyph(input);
			if (code == -1) {
				if (self.glyphIndices) {
					self.codes.push(-1);
					self.glyphs.push(bitmap);
				}
				continue;
			}
			if (code < 0 || code > 0x10ffff) { throw "Unsupported BDF encoding"; }
			if (self.glyphIndices) {
				self.codes.push(code);
				self.glyphs.push(bitmap);
				if (code == defaultCode) { self.missing = self.glyphs.len - 1; }
			} else {
				int pos = self.codes.len;
				while (pos > 0 && self.codes.get(pos - 1) > code) { pos--; }
				if (pos > 0 && self.codes.get(pos - 1) == code) {
					self.glyphs.set(pos - 1, bitmap);
				} else {
					self.codes.insert(pos, code);
					self.glyphs.insert(pos, bitmap);
					if (self.missing >= pos) { self.missing++; }
				}
				if (code == defaultCode) { self.missing = pos; }
			}
		}
		if (defaultCode < 0) { self.missing = 0; }
		if (self.glyphs.len == 0 || self.missing < 0 || !input.record().equals("ENDFONT")) { throw "Incomplete BDF font"; }
	}

	private string propertyString(string record) {
		int first = record.find("\"", 0);
		if (first < 0 || first == record.len() - 1 || !record.endsWith("\"")) { throw "Invalid BDF charset property"; }
		return record.substring(first + 1, record.len() - first - 2);
	}

	/* Unicode, Latin-1 and IRV map character codes directly. Other legacy
	 * registries use glyph indices. */
	private bool usesGlyphIndices(string registry, string encoding) {
		string upper = registry.toUpper();
		if (upper.isEmpty() && encoding.isEmpty()) { return false; }
		if (encoding.equals("1") && (upper.equals("ISO10646") || upper.equals("ISO8859"))) { return false; }
		if (encoding.equals("IRV") && upper.equals("ISO646.1991")) { return false; }
		return true;
	}

	private FontGlyph readGlyph(BDFReader input) {
		int advance = 0;
		int width = 0;
		int height = 0;
		int left = 0;
		int bottom = 0;
		bool hasBox = false;
		string row = input.record();
		while (!row.equals("BITMAP")) {
			if (row.startsWith("DWIDTH ")) {
				var device = input.numbers(row, "DWIDTH", 2);
				advance = device.get(0);
				if (advance < 0 || advance > 32767 || device.get(1) != 0) { throw "Unsupported BDF advance"; }
			} else if (row.startsWith("BBX ")) {
				var box = input.numbers(row, "BBX", 4);
				width = box.get(0);
				height = box.get(1);
				left = box.get(2);
				bottom = box.get(3);
				hasBox = true;
			}
			row = input.record();
		}
		if (!hasBox || width < 0 || width > 2048 || height < 0 || height > 2048 || left < -32768 || left > 32767 || bottom < -32768 || bottom + height > 32767) { throw "Unsupported BDF glyph bounds"; }
		int pitch = (width + 7) / 8;
		var bitmap = new Bytes();
		for (int y = 0; y < height; y++) {
			string hexRow = input.line();
			if (hexRow.len() > pitch * 2 || hexRow.len() % 2 != 0) { throw "Invalid BDF row length"; }
			var decoded = Bytes.fromHex(hexRow);
			if (decoded == null) { throw "Invalid BDF bitmap"; }
			bitmap.appendBytes(decoded);
			for (int i = decoded.length(); i < pitch; i++) { bitmap.append(0); }
		}
		if (!input.record().equals("ENDCHAR")) { throw "Unterminated BDF glyph"; }
		return new FontGlyph((long long)advance * 64LL, left, bottom + height, width, height, pitch, FONT_PIXEL_MONO, 0, bitmap);
	}

	public FontMetrics metrics() { return self.lineMetrics; }

	public FontGlyph? glyph(int code, bool render) {
		if (code < 0 || code > 0x10ffff || (code >= 0xd800 && code <= 0xdfff)) { throw "Invalid font Unicode scalar"; }
		int selected = self.missing;
		if (self.glyphIndices) {
			if (code > self.glyphs.len) { return null; }
			if (code > 0) { selected = code - 1; }
		} else {
			int lo = 0;
			int hi = self.codes.len;
			while (lo < hi) {
				int mid = lo + (hi - lo) / 2;
				if (self.codes.get(mid) < code) { lo = mid + 1; } else { hi = mid; }
			}
			if (lo < self.codes.len && self.codes.get(lo) == code) { selected = lo; }
		}
		var glyph = self.glyphs.get(selected);
		if (render) { return glyph; }
		return new FontGlyph(glyph.advanceFixed(), 0, 0, 0, 0, 0, FONT_PIXEL_UNSUPPORTED, 0, new Bytes());
	}
}
