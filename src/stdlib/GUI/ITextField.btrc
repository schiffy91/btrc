import Library.Callback;
import Library.GUI.ControlEvents;
import Library.GUI.IView;

/* The platform owns text editing, selection, input composition and undo.
 * text() returns the live draft without committing composition. setText of the
 * accepted baseline is a no-op; replacement cancels the interaction as MODEL.
 * Eligibility loss retains the draft and sends one SYSTEM cancel. Subscriptions
 * have one live receiver per channel, no initial delivery, and scope ownership. */
interface ITextField extends IView {
	ICallbackRegistration onDraftChanged(ITextControlEventHandler handler, CallbackScope owner);
	ICallbackRegistration onCommit(ITextControlEventHandler handler, CallbackScope owner);
	ICallbackRegistration onCancel(ITextControlEventHandler handler, CallbackScope owner);
	string text();
	void setText(string text);
	void setPlaceholder(string text);
	bool isEnabled();
	void setEnabled(bool enabled);
	void setFont(double size);
}

interface ITextControlEventHandler { void textEvent(TextControlEvent event); }
