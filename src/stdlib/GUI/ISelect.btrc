import Library.GUI.IView;
import Library.Vector;

/* Typography limit every provider enforces rather than clipping text. */
class SelectTypography {
	/* The largest font a selection's bezel holds. */
	class double maximumSize() { return 20.0; }
}

/* Selection uses an index so duplicate titles remain distinct. An empty list
 * selects -1. Replacing items and publishing selection do not synthesize input.
 * Fonts above SelectTypography.maximumSize() points are rejected. */
interface ISelect extends IView {
	void setItems(Vector<string> titles, int selectedIndex);
	int itemCount();
	int selectedIndex();
	void setItemEnabled(int index, bool enabled);
	bool isItemEnabled(int index);
	void setSelectedIndex(int index);
	string selectedTitle();
	void setEnabled(bool enabled);
	void setFont(double size);
	bool isEnabled();
}
