import Library.Callback;
import Library.GUI.ControlEvents;
import Library.GUI.IView;
import Library.Vector;

/* Typography limit every provider enforces rather than clipping text. */
class SelectTypography {
	/* The largest font a selection's bezel holds. */
	class double maximumSize() { return 20.0; }
}

/* Selection is keyed by an owning model snapshot; keys remain stable across
 * reordering and titles need not be unique. Index methods are the D24 shim over
 * that snapshot. An empty list selects -1. Model setters never synthesize USER
 * events; replacement ends an active interaction with one MODEL cancel.
 * Fonts above SelectTypography.maximumSize() points are rejected. */
interface ISelect extends IView {
	void setOptions(SelectModel model);
	SelectModel optionsState();
	string? selectedKey();
	void setSelectedKey(string? key);
	ICallbackRegistration onChanged(ISelectionControlEventHandler handler, CallbackScope owner);
	ICallbackRegistration onCommit(ISelectionControlEventHandler handler, CallbackScope owner);
	ICallbackRegistration onCancel(ISelectionControlEventHandler handler, CallbackScope owner);
	void setItems(Vector<string> titles, int selectedIndex);
	int itemCount();
	int selectedIndex();
	void setItemEnabled(int index, bool enabled);
	bool isItemEnabled(int index);
	void setSelectedIndex(int index);
	string selectedTitle();
	void setEnabled(bool enabled);
	void setFont(double size);
	bool isEnabled();
}

interface ISelectionControlEventHandler { void selectionEvent(SelectionControlEvent event); }
