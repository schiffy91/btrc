import Library.Callback;
import Library.Math;
import Library.GUI.IProgressIndicator;
import Library.GUI.ILevelIndicator;
import Library.GUI.Linux.LinuxView;
import Library.GUI.Linux.LinuxContext;
import Library.GUI.Linux.LinuxPainter;
import Library.GUI.Linux.GtkControls;

/* An indeterminate spinner: GTK's, which turns while it is running. */
class LinuxProgressIndicator extends LinuxNodeView implements IProgressIndicator {
	private BtrcGtkControl* _control;
	private bool _running = false;

	public LinuxProgressIndicator(LinuxContext context) {
		self.adoptNode(LinuxViewNode(context));
		self._control = btrcGtkSpinnerCreate((unsigned int)self.node().id);
		if (self._control == null) { throw "Cannot create native progress indicator"; }
	}

	private BtrcGtkControl* control() { if (self._control == null) { throw "Native progress indicator is closed"; } return self._control; }

	public void paint(LinuxPlacer painter, double x, double y) { painter.place(self.control(), x, y, self.node().width, self.node().height); }

	public double fittingWidth() { self.node().requireOpen(); return (double)btrcGtkControlNaturalWidth(self.control()); }

	public double fittingHeight() { self.node().requireOpen(); return (double)btrcGtkControlNaturalHeight(self.control()); }

	public bool isRunning() { self.node().requireOpen(); return self._running; }

	public void setRunning(bool running) { self.node().requireOpen(); if (running != self._running) { self._running = running; btrcGtkSpinnerSetRunning(self.control(), running); } }

	private void releaseNative() { if (self._control != null) { btrcGtkControlDestroy(self._control); self._control = null; } }

	public CallbackCancellation close() {
		var state = self.node().close();
		if (state == CALLBACK_CANCELLATION_COMPLETE) { self.releaseNative(); }
		return state;
	}

	public CallbackCancellation pollClose() {
		var state = self.node().pollClose();
		if (state == CALLBACK_CANCELLATION_COMPLETE) { self.releaseNative(); }
		return state;
	}

	public void __del__() { self.releaseNative(); }
}

/* A read-only capacity bar with warning and critical thresholds: GTK's level bar. */
class LinuxLevelIndicator extends LinuxNodeView implements ILevelIndicator {
	private BtrcGtkControl* _control;
	private double _value = 0.0;

	public LinuxLevelIndicator(LinuxContext context, double warning, double critical) {
		self.adoptNode(LinuxViewNode(context));
		if (!Math.isFinite(warning) || !Math.isFinite(critical) || warning < 0.0 || critical > 1.0 || warning > critical) { throw "Invalid native level thresholds"; }
		self._control = btrcGtkLevelCreate((unsigned int)self.node().id, warning, critical);
		if (self._control == null) { throw "Cannot create native level indicator"; }
	}

	private BtrcGtkControl* control() { if (self._control == null) { throw "Native level indicator is closed"; } return self._control; }

	public void paint(LinuxPlacer painter, double x, double y) { painter.place(self.control(), x, y, self.node().width, self.node().height); }

	/* GTK's level bar asks for almost no width of its own: a bar is as long as it is given. */
	public double fittingWidth() { self.node().requireOpen(); return Math.maxDouble(LinuxMetrics.levelWidth(), (double)btrcGtkControlNaturalWidth(self.control())); }

	public double fittingHeight() { self.node().requireOpen(); return (double)btrcGtkControlNaturalHeight(self.control()); }

	public void setValue(double value) {
		self.node().requireOpen();
		if (!Math.isFinite(value) || value < 0.0 || value > 1.0) { throw "Native level must be between zero and one"; }
		if (value == self._value) { return; }
		self._value = value;
		btrcGtkLevelSetValue(self.control(), value);
	}

	public double value() { self.node().requireOpen(); return self._value; }

	private void releaseNative() { if (self._control != null) { btrcGtkControlDestroy(self._control); self._control = null; } }

	public CallbackCancellation close() {
		var state = self.node().close();
		if (state == CALLBACK_CANCELLATION_COMPLETE) { self.releaseNative(); }
		return state;
	}

	public CallbackCancellation pollClose() {
		var state = self.node().pollClose();
		if (state == CALLBACK_CANCELLATION_COMPLETE) { self.releaseNative(); }
		return state;
	}

	public void __del__() { self.releaseNative(); }
}
