import Library.FileSystem;
import Library.Vector;

import ./DesktopFontSettings.btrc;
import ./InstalledFontCatalog.btrc;

/* The desktop's native font matcher consumes SFNT resources. Follow its
 * configured family order among these files, with web-format fonts available
 * when they are the only installed candidates. An explicit file selection
 * through SystemTextFont accepts every supported container directly. */
class DefaultTextFont {
	class DesktopFontSettings? settings = null;
	class InstalledFontCatalog? desktop = null;
	class InstalledFontCatalog? web = null;

	class void invalidate() {
		DefaultTextFont.settings = null;
		DefaultTextFont.desktop = null;
		DefaultTextFont.web = null;
	}

	class string path(bool bold, double logicalSize = 16.0) {
		var config = DefaultTextFont.settings;
		if (config == null) {
			config = DesktopFontSettings.system();
			DefaultTextFont.settings = config;
		}
		var families = config.forFace(bold, logicalSize);
		if (families.isEmpty()) { return ""; }
		Vector<int> latin = [32, 65];
		int weight = bold ? 700 : 400;
		var installed = DefaultTextFont.desktop;
		if (installed == null) {
			installed = InstalledFontCatalog(config.roots, INSTALLED_DESKTOP_FILES);
			DefaultTextFont.desktop = installed;
		}
		var chosen = installed.match(families, weight, false, latin);
		if (chosen == null) {
			var wrappers = DefaultTextFont.web;
			if (wrappers == null) {
				wrappers = InstalledFontCatalog(config.roots, INSTALLED_WEB_FILES);
				DefaultTextFont.web = wrappers;
			}
			chosen = wrappers.match(families, weight, false, latin);
		}
		return chosen == null || chosen.faceIndex != 0 ? "" : chosen.path;
	}
}
