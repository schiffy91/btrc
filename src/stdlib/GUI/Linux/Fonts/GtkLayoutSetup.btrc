import Library.Bytes;
import Library.Strings;

import ../../OpenType/Layout/LatinLayout.btrc;

struct GtkLayoutHandle { LatinLayout layout; };

void* gtkLayoutOpen(const unsigned char* bytes, int length) {
	if (bytes == null || length < 12 || length > 16777216) { return null; }
	try {
		var owned = Bytes.zeros(length);
		memcpy(owned.data, bytes, (size_t)length);
		var layout = LatinLayout(OpenTypeData(owned), 0, true);
		var handle = (struct GtkLayoutHandle*)calloc(1, sizeof(struct GtkLayoutHandle));
		if (handle == null) { return null; }
		keep layout;
		handle->layout = layout;
		return (void*)handle;
	} catch (string error) { return null; }
}

void gtkLayoutClose(void* opaque) {
	var handle = (struct GtkLayoutHandle*)opaque;
	if (handle != null) { release handle->layout; free(handle); }
}

/* The native caller owns capacity records of five integers each. Keep
 * them in design units until Pango's current device rounding is applied. */
int gtkLayoutShape(void* opaque, const char* text, int* em, int* records, int capacity) {
	if (opaque == null || text == null || em == null || records == null || capacity <= 0) { return -1; }
	try {
		var run = ((struct GtkLayoutHandle*)opaque)->layout.shape(Strings.copy((char*)text));
		int count = run.glyphs.size();
		// Native legacy kern splits *scaled* pairs; rescaling the two
		// font-unit halves can move an advance by a pixel.
		if (count > capacity || run.legacyPositioned) { return -1; }
		*em = run.unitsPerEm;
		for (int i = 0; i < count; i++) {
			var glyph = run.glyphs.get(i);
			records[i * 5] = glyph.id;
			records[i * 5 + 1] = glyph.cluster;
			records[i * 5 + 2] = glyph.advance;
			records[i * 5 + 3] = glyph.xOffset;
			records[i * 5 + 4] = glyph.yOffset;
		}
		return count;
	} catch (string error) { return -1; }
}

typedef CFunction<void*, const unsigned char*, int> GtkLayoutOpen;
typedef CFunction<void, void*> GtkLayoutClose;
typedef CFunction<int, void*, const char*, int*, int*, int> GtkLayoutShape;
extern void btrcGtkLayoutPublish(GtkLayoutOpen open, GtkLayoutClose close, GtkLayoutShape shape);

class ShimTextLayoutSetup {
	class void prepare() { btrcGtkLayoutPublish(gtkLayoutOpen, gtkLayoutClose, gtkLayoutShape); }
}
