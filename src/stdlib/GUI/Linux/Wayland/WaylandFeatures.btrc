import Library.GUI.Shim.ShimTextField;
import Library.GUI.ITextField;
import Library.GUI.ISelect;
import Library.GUI.Shim.ShimSelect;
import Library.GUI.Shim.ShimContext;
import Library.GUI.Shim.Shim;
import Library.GUI.Shim.DialogPump;
import Library.GUI.Shim.ShimWindow;
import Library.GUI.IDirectoryPicker;
import Library.GUI.Linux.PortalDirectoryPickerProvider;
import Library.App;
import Library.GUI.Linux.Fonts.SystemTextABI;

import ./Accessibility.btrc;

/* Linux's default GUI backend speaks native Wayland directly and installs
 * first-party text layout and AT-SPI accessibility on startup. */
extern int btrcWaylandShowAlert(BtrcShimWindow* owner, string title, string message);

class ShimFeatures {
	class bool fieldUsesWindowInput() { return true; }

	class void initialize() { SystemTextABI.install(); WaylandAccessibility.install(); }

	class ITextField createTextField(ShimContext context, string text, string placeholder) { return ShimTextField(context, text, placeholder); }

	class ISelect createSelect(ShimContext context) { return ShimSelect(context); }

	class void showAlert(BtrcShimWindow* window, string title, string message) {
		if (btrcWaylandShowAlert(window, title, message) == 0) { throw "Cannot display native Wayland alert"; }
	}

	class DirectoryPickerOutcome chooseDirectory(ShimWindow? window, IShimDialogPump pump, DirectoryPickerRequest request) { return DirectoryPickerProvider.choose(window, pump, request); }
}
