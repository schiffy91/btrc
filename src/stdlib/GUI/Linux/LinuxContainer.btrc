import Library.Callback;
import Library.Console;
import Library.GUI.IContainer;
import Library.GUI.IView;
import Library.GUI.Linux.LinuxView;
import Library.GUI.Linux.LinuxPainter;

/* Composition helpers shared by every container kind. */
class LinuxComposite {
	class ILinuxView projection(IView view) {
		if (view == null) { throw "Cannot attach a missing view"; }
		ILinuxView? native = (ILinuxView?)view;
		if (native == null) { throw "View has no Linux implementation"; }
		return native;
	}

	class void paintChildren(LinuxViewNode node, LinuxPainter painter, double x, double y) {
		if (node.clipsChildren) { painter.pushClip(x, y, node.width, node.height); }
		for child in node.children {
			var childNode = child.node();
			if (!childNode.visible || !childNode.isOpen()) { continue; }
			child.paint(painter, x + node.contentOffsetX + childNode.x, y + node.contentOffsetY + childNode.y);
		}
		if (node.clipsChildren) { painter.popClip(); }
	}
}

/* A drawn view that holds children: it paints them in order and exposes
 * them through the portable container members. Grids keep their own
 * cell-addressed children instead. */
class LinuxContainerView extends LinuxNodeView {
	public void paint(LinuxPainter painter, double x, double y) { LinuxComposite.paintChildren(self.node(), painter, x, y); }

	public void attach(IView child) { self.node().attachChild(LinuxComposite.projection(child)); }

	public IView detach(IView child) { return self.node().detachChild(LinuxComposite.projection(child)); }

	public int childCount() { self.node().requireOpen(); return self.node().children.len; }

	public IView childAt(int index) {
		var node = self.node();
		node.requireOpen();
		if (index < 0 || index >= node.children.len) { throw "Container child index is out of bounds"; }
		return node.children.get(index);
	}
}

/* A plain grouping view: children are arranged by the consumer in points
 * from this view's top-left. No native drawing of its own. */
class LinuxContainer extends LinuxContainerView implements IContainer {
	public LinuxContainer(LinuxContext context) { self.adoptNode(LinuxViewNode(context)); }

	public void __del__() { if (self.node() != null && self.close() != CALLBACK_CANCELLATION_COMPLETE) { Console.fatal("Native container destroyed before subtree cleanup completed"); } }
}
