import Library.Callback;
import Library.Console;
import Library.Vector;
import Library.GUI.IContainer;
import Library.GUI.IView;
import Library.GUI.Linux.LinuxView;
import Library.GUI.Linux.LinuxPainter;

/* Composition helpers shared by every container kind. */
class LinuxComposite {
	class ILinuxView projection(IView view) {
		if (view == null) { throw "Cannot attach a missing view"; }
		ILinuxView? native = (ILinuxView?)view;
		if (native == null) { throw "View has no Linux implementation"; }
		return native;
	}

	class void paintChildren(LinuxViewNode node, LinuxPainter painter, double x, double y) {
		if (node.clipsChildren) { painter.pushClip(x, y, node.width, node.height); }
		for child in node.children {
			var childNode = child.node();
			if (!childNode.visible || !childNode.isOpen()) { continue; }
			child.paint(painter, x + node.contentOffsetX + childNode.x, y + node.contentOffsetY + childNode.y);
		}
		if (node.clipsChildren) { painter.popClip(); }
	}
}

/* Retains every potentially affected child and its pre-mutation native route.
 * Actual attachment stays provider-owned; no user callback runs against an
 * intermediate logical sequence. */
class LinuxChildState {
	public ILinuxView child;
	public LinuxViewHost? host;
	public bool attached;
	public bool attempted = false;
	public double x;
	public double y;
	public double width;
	public double height;
	public LinuxChildState(ILinuxView child) {
		self.child = child; var node = child.node(); self.host = node.host; self.attached = node.attached;
		self.x = node.x; self.y = node.y; self.width = node.width; self.height = node.height;
	}
}

class LinuxContainerMutation {
	private ILinuxView _owner;
	private LinuxViewNode _node;
	private Vector<ILinuxView> _original;
	private Vector<LinuxChildState> _saved = [];
	private Vector<ContainerEdit> _steps = [];

	public LinuxContainerMutation(ILinuxView owner) { self._owner = owner; self._node = owner.node(); self._original = self._node.children.copy(); }

	private LinuxChildState save(ILinuxView child) {
		for saved in self._saved { if (saved.child == child) { return saved; } }
		var saved = LinuxChildState(child); self._saved.push(saved); return saved;
	}

	private int indexOf(Vector<ILinuxView> children, ILinuxView child) { for (int index = 0; index < children.len; index++) { if (children.get(index) == child) { return index; } } return -1; }

	private ContainerBatchResult result(ContainerBatchResultKind kind, int step, string error) {
		var result = ContainerBatchResult(); result.kind = kind; result.failedStep = step; result.error = error;
		result.treeRevision = self._node.treeRevision; result.detached = []; result.retained = [];
		for child in self._node.children { result.retained.push(child); }
		for saved in self._saved {
			if (self.indexOf(self._node.children, saved.child) >= 0) { continue; }
			if (kind == CONTAINER_BATCH_FAILED_QUARANTINED) { result.retained.push(saved.child); }
			else if (!saved.child.node().attached) { result.detached.push(saved.child); }
		}
		return result;
	}

	public ContainerBatchResult apply(long long expectedRevision, Vector<ContainerEdit> edits) {
		self._node.requireOpen();
		if (self._node.treeMutation || self._node.context.mutationDepth > 0) { throw "Native tree mutation cannot re-enter"; }
		if (edits == null) { throw "Native tree edit sequence is missing"; }
		if (expectedRevision != self._node.treeRevision) { return self.result(CONTAINER_BATCH_REJECTED, -1, "Container tree revision is stale"); }
		if (self._node.treeRevision == 9223372036854775807LL) { throw "Container tree revisions exhausted"; }
		var proposed = self._original.copy();
		for child in self._original { self.save(child); }
		int step = 0;
		try {
			for edit in edits {
				if (edit == null) { throw "Native tree edit is missing"; }
				var child = LinuxComposite.projection(edit.child); var childNode = child.node(); childNode.requireOpen();
				if (childNode.context != self._node.context) { throw "Native child belongs to another application"; }
				if (childNode == self._node || childNode.contains(self._node)) { throw "Native child creates a cycle"; }
				int index = self.indexOf(proposed, child);
				if (edit.kind == CONTAINER_EDIT_INSERT) {
					if (index >= 0 || (childNode.attached && self.indexOf(self._original, child) < 0)) { throw "Native child is already attached"; }
					if (edit.index < 0 || edit.index > proposed.len) { throw "Container insert index is out of bounds"; }
					proposed.insert(edit.index, child);
				} else if (edit.kind == CONTAINER_EDIT_MOVE) {
					if (index < 0 || edit.index < 0 || edit.index >= proposed.len) { throw "Container move does not name a valid direct child position"; }
					proposed.remove(index); proposed.insert(edit.index, child);
				} else if (edit.kind == CONTAINER_EDIT_DETACH) {
					if (index < 0) { throw "Container detach does not name a direct child"; } proposed.remove(index);
				} else { throw "Unknown container edit kind"; }
				self.save(child);
				var captured = ContainerEdit(); captured.kind = edit.kind; captured.child = child; captured.index = edit.index; self._steps.push(captured); step++;
			}
		} catch (string error) { return self.result(CONTAINER_BATCH_REJECTED, step, error); }

		self._node.treeMutation = true; self._node.context.mutationDepth++;
		ContainerBatchResultKind kind = CONTAINER_BATCH_COMMITTED;
		string failure = ""; int failedStep = -1;
		try {
			try {
				var actual = self._original.copy(); step = 0;
				for edit in self._steps {
					var child = LinuxComposite.projection(edit.child); var saved = self.save(child);
					int index = self.indexOf(actual, child);
					if (edit.kind == CONTAINER_EDIT_INSERT) { actual.insert(edit.index, child); saved.attempted = true; child.node().attached = true; child.attachTo(self._node.host); }
					else if (edit.kind == CONTAINER_EDIT_DETACH) { actual.remove(index); saved.attempted = true; child.node().attached = false; child.attachTo(null); }
					else { actual.remove(index); actual.insert(edit.index, child); }
					step++;
				}
				self._node.children = actual;
				self._owner.arrange(self._node.x, self._node.y, self._node.width, self._node.height);
				self._node.treeRevision++;
			} catch (string error) {
				failure = error; failedStep = step < self._steps.len ? step : self._steps.len - 1;
				self._node.children = self._original.copy(); bool restored = true;
				for (int index = self._saved.len - 1; index >= 0; index--) {
					var saved = self._saved.get(index);
					try {
						if (saved.attempted) { saved.child.node().attached = saved.attached; saved.child.attachTo(saved.host); }
						saved.child.arrange(saved.x, saved.y, saved.width, saved.height);
					} catch (string inverse) { restored = false; failure = failure + "; inverse: " + inverse; }
				}
				kind = restored ? CONTAINER_BATCH_ROLLED_BACK : CONTAINER_BATCH_FAILED_QUARANTINED;
				if (!restored) { self._node.treeRevision++; }
			}
			if (kind == CONTAINER_BATCH_FAILED_QUARANTINED) {
				Vector<ILinuxView> retained = []; for saved in self._saved { retained.push(saved.child); } self._node.quarantine(retained);
			}
			/* Mark the entire result before callbacks; settle on the old channel
			 * identities before rebind disposes records from removed routes. */
			self._node.markLocalInteraction();
			for saved in self._saved { if (self.indexOf(self._node.children, saved.child) < 0) { saved.child.node().markInteraction(false); } }
			self._node.settleInteraction();
			for saved in self._saved { if (self.indexOf(self._node.children, saved.child) < 0) { saved.child.node().settleInteraction(); } }
			self._node.finishAttachment();
			for saved in self._saved { if (self.indexOf(self._node.children, saved.child) < 0) { saved.child.node().finishAttachment(); } }
			self._node.publishInteraction();
			for saved in self._saved { if (self.indexOf(self._node.children, saved.child) < 0) { saved.child.node().publishInteraction(); } }
			self._node.invalidate();
			return self.result(kind, failedStep, failure);
		} finally { self._node.context.mutationDepth--; self._node.treeMutation = false; }
	}
}

/* A drawn view that holds children: it paints them in order and exposes
 * them through the portable container members. Grids keep their own
 * cell-addressed children instead. */
class LinuxContainerView extends LinuxNodeView {
	public void paint(LinuxPainter painter, double x, double y) { LinuxComposite.paintChildren(self.node(), painter, x, y); }

	public long long treeRevision() { self.node().requireInspection(); return self.node().treeRevision; }

	public ContainerBatchResult applyBatch(long long revision, Vector<ContainerEdit> edits) { ILinuxView owner = self; return LinuxContainerMutation(owner).apply(revision, edits); }

	public void insert(IView child, int index) {
		var edit = ContainerEdit(); edit.kind = CONTAINER_EDIT_INSERT; edit.child = child; edit.index = index; Vector<ContainerEdit> edits = [edit];
		ILinuxView owner = self; var result = LinuxContainerMutation(owner).apply(self.node().treeRevision, edits);
		if (result.kind != CONTAINER_BATCH_COMMITTED) { throw "Container insert failed: " + result.error; }
	}

	public void move(IView child, int destinationIndex) {
		var edit = ContainerEdit(); edit.kind = CONTAINER_EDIT_MOVE; edit.child = child; edit.index = destinationIndex; Vector<ContainerEdit> edits = [edit];
		ILinuxView owner = self; var result = LinuxContainerMutation(owner).apply(self.node().treeRevision, edits);
		if (result.kind != CONTAINER_BATCH_COMMITTED) { throw "Container move failed: " + result.error; }
	}

	public void attach(IView child) {
		var edit = ContainerEdit(); edit.kind = CONTAINER_EDIT_INSERT; edit.child = child; edit.index = self.node().children.len; Vector<ContainerEdit> edits = [edit];
		ILinuxView owner = self; var result = LinuxContainerMutation(owner).apply(self.node().treeRevision, edits);
		if (result.kind != CONTAINER_BATCH_COMMITTED) { throw "Container attach failed: " + result.error; }
	}

	public IView detach(IView child) {
		var edit = ContainerEdit(); edit.kind = CONTAINER_EDIT_DETACH; edit.child = child; edit.index = -1; Vector<ContainerEdit> edits = [edit];
		ILinuxView owner = self; var result = LinuxContainerMutation(owner).apply(self.node().treeRevision, edits);
		if (result.kind != CONTAINER_BATCH_COMMITTED) { throw "Container detach failed: " + result.error; } return child;
	}

	public int childCount() { self.node().requireInspection(); return self.node().children.len; }

	public IView childAt(int index) {
		var node = self.node();
		node.requireInspection();
		if (index < 0 || index >= node.children.len) { throw "Container child index is out of bounds"; }
		return node.children.get(index);
	}
}

/* A plain grouping view: children are arranged by the consumer in points
 * from this view's top-left. No native drawing of its own. */
class LinuxContainer extends LinuxContainerView implements IContainer {
	public LinuxContainer(LinuxContext context) { self.adoptNode(LinuxViewNode(context)); }

	public void __del__() { if (self.node() != null && self.close() != CALLBACK_CANCELLATION_COMPLETE) { Console.fatal("Native container destroyed before subtree cleanup completed"); } }
}
