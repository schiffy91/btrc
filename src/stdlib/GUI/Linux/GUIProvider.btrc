import Library.Strings;
import Library.Datetime;
import Library.Vector;
import Library.Image;
import Library.GUI.IView;
import Library.GUI.IApplication;
import Library.GUI.IImageHandle;
import Library.GUI.IDirectoryPicker;
import Library.GUI.Capture;
import Library.GUI.TextRun;
import Library.GUI.Linux.SDL;
import Library.GUI.Linux.LinuxApplication;
import Library.GUI.Linux.LinuxWindow;
import Library.GUI.Linux.LinuxView;
import Library.GUI.Linux.LinuxImageView;
import Library.GUI.Linux.LinuxDirectoryPicker;
import Library.GUI.Linux.LinuxSystemText;

/* Private package implementation for Linux: the native services behind the
 * GUI facade. The facade validates requests and owns the application. */
class GUIProvider {
	class bool sdlReady = false;

	class void requireUIThread() {}

	class IApplication createApplication(int workCapacity) {
		if (!GUIProvider.sdlReady) {
			if (!SDL_Init((unsigned int)SDL_INIT_VIDEO | (unsigned int)SDL_INIT_EVENTS)) { throw "Cannot initialize native windowing: " + Strings.copy((char*)SDL_GetError()); }
			GUIProvider.sdlReady = true;
		}
		return LinuxApplication(workCapacity);
	}

	class ILinuxApplication linuxApplication(IApplication? application) {
		var linux = (ILinuxApplication?)application;
		if (linux == null) { throw "GUI application belongs to another provider"; }
		return linux;
	}

	class IImageHandle createImageHandle(IApplication? application, Image pixels, int maximumPixels) {
		if (application == null) { throw "Initialize GUI before creating image handles"; }
		return LinuxImageHandle.create(GUIProvider.linuxApplication(application).context().ids, pixels, maximumPixels);
	}

	class DirectoryPickerOutcome chooseDirectory(IApplication application, DirectoryPickerRequest request) {
		var linux = GUIProvider.linuxApplication(application);
		var window = linux.firstWindow();
		var pump = (ILinuxDialogPump?)linux;
		if (pump == null) { throw "GUI application cannot run native dialogs"; }
		return LinuxDirectoryPicker(window == null ? null : window.nativeWindow(), pump).chooseDirectory(request);
	}

	class void rasterizeText(IApplication? application, TextRasterization request) {
		if (application == null) { throw "Initialize GUI before creating views or running work"; }
		LinuxSystemText.rasterize(GUIProvider.linuxApplication(application).context().fonts, request);
	}

	/* The window already composites every GPU child, so the readback is the
	 * composed capture; the caller's layers are accepted for API parity. */
	class Image capture(IApplication application, IView root, Vector<GUICaptureLayer> layers) {
		var native = (ILinuxView?)root;
		if (native == null) { throw "Capture root belongs to another GUI provider"; }
		var window = GUIProvider.linuxApplication(application).windowOwning(native);
		if (window == null) { throw "Capture root is not attached to a window"; }
		var deadline = Timer();
		deadline.start();
		while (!window.pollDevice()) {  // the device request is asynchronous; captures may precede the first loop turn
			if (deadline.elapsedMillis() > 5000.0f) { throw "Capture window has no GPU device"; }
			Timer.sleepMillis(1);
		}
		var image = window.render(true);
		if (image == null) { throw "Capture window produced no frame"; }
		return image;
	}
}
