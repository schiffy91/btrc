import Library.Map;
import Library.Math;
import Library.Strings;
import Library.GUI.IFontFace;
import Library.GUI.FreeType.FreeTypeFace;

/* A rendered glyph shared by every window: metrics in backing pixels plus the
 * owned coverage bitmap. Atlases copy the coverage into their own texture. */
class LinuxGlyph {
	public int codepoint;
	public double advance;
	public int left;
	public int top;
	public int width;
	public int rows;
	public FontGlyph? raster;

	public LinuxGlyph(int codepoint, double advance, int left, int top, int width, int rows, FontGlyph? raster) {
		self.codepoint = codepoint;
		self.advance = advance;
		self.left = left;
		self.top = top;
		self.width = width;
		self.rows = rows;
		self.raster = raster;
	}

	public int coverage(int row, int column) { var raster = self.raster; return raster == null ? 0 : raster.coverage(row, column); }
}

/* One FreeType face at a fixed backing pixel size with its glyph cache. */
class LinuxFace {
	public int key;
	public int pixelSize;
	public double ascent;
	public double descent;
	public double lineHeight;
	private FreeTypeFace _face;
	private Map<int, LinuxGlyph> _glyphs;

	public LinuxFace(int key, string path, int pixelSize) {
		self._glyphs = new Map<int, LinuxGlyph>();
		self.key = key;
		self.pixelSize = pixelSize;
		self._face = FreeTypeFace(path, pixelSize);
		var metrics = self._face.metrics();
		self.ascent = (double)metrics.ascenderFixed() / 64.0;
		self.lineHeight = (double)metrics.heightFixed() / 64.0;
		if (self.lineHeight < (double)pixelSize) { self.lineHeight = (double)pixelSize * 1.2; }
		self.descent = self.lineHeight - self.ascent;
		if (self.descent < 0.0) { self.descent = 0.0; }
	}

	public LinuxGlyph glyph(int codepoint) {
		if (self._glyphs.has(codepoint)) { return self._glyphs.get(codepoint); }
		if (self._glyphs.size() > 4096) { self._glyphs.clear(); }
		var rendered = self._face.glyph(codepoint, true);
		if (rendered == null && codepoint != 0xfffd && codepoint != 63) { rendered = self._face.glyph(63, true); }
		LinuxGlyph glyph = rendered == null ? LinuxGlyph(codepoint, (double)self.pixelSize * 0.5, 0, 0, 0, 0, null) : LinuxGlyph(codepoint, (double)rendered.advanceFixed() / 64.0, rendered.bitmapLeft(), rendered.bitmapTop(), rendered.width(), rendered.rows(), rendered);
		self._glyphs.put(codepoint, glyph);
		return glyph;
	}

	public double advance(string text) {
		double total = 0.0;
		int offset = 0;
		while (offset < text.len()) {
			int codepoint = UTF8.decode(text, text.len(), &offset);
			total += self.glyph(codepoint).advance;
		}
		return total;
	}
}

/* Application-wide font resolution and measurement. Sizes are logical points;
 * each caller passes the backing scale of the window it measures or draws
 * for, which chooses the FreeType pixel size so measurement matches what that
 * window's atlas later draws. fontconfig supplies the system sans face. */
class LinuxFonts {
	private string _regularPath = "";
	private string _boldPath = "";
	private Map<int, LinuxFace> _faces;

	public LinuxFonts() {
		self._faces = new Map<int, LinuxFace>();
		self._regularPath = LinuxFonts.resolve("sans-serif", FC_WEIGHT_REGULAR);
		self._boldPath = LinuxFonts.resolve("sans-serif", FC_WEIGHT_BOLD);
		if (self._boldPath.isEmpty()) { self._boldPath = self._regularPath; }
		if (self._regularPath.isEmpty()) { throw "No system sans-serif font is available"; }
	}

	/* The file of fontconfig's best match for a family and weight; empty when
	 * none. FcPattern is a record typedef, which the importer cannot declare as
	 * a resource (docs/design/native-interop.md), so both patterns are
	 * destroyed explicitly; nothing between creation and destruction throws. */
	class string resolve(string family, int weight) {
		if (!FcInit()) { return ""; }
		FcPattern* pattern = FcNameParse((const FcChar8*)family);
		if (pattern == null) { return ""; }
		FcPatternAddInteger(pattern, FC_WEIGHT, weight);
		FcConfigSubstitute(null, pattern, FcMatchPattern);
		FcDefaultSubstitute(pattern);
		FcResult result = FcResultNoMatch;
		FcPattern* match = FcFontMatch(null, pattern, &result);
		FcPatternDestroy(pattern);
		if (match == null) { return ""; }
		FcChar8* file = null;
		bool found = FcPatternGetString(match, FC_FILE, 0, &file) == FcResultMatch && file != null;
		string path = found ? Strings.copy((char*)file) : "";
		FcPatternDestroy(match);
		return path;
	}

	/* An unusable scale measures at one point per pixel. */
	class double backing(double scale) { return Math.isFinite(scale) && scale > 0.0 ? scale : 1.0; }

	/* Faces are keyed by pixel size, so windows of different density select different ones. */
	public int pixelSize(double points, double scale) {
		int size = (int)Math.round((float)(points * LinuxFonts.backing(scale)));
		return size < 4 ? 4 : (size > 512 ? 512 : size);
	}

	public LinuxFace face(double points, double scale, bool bold) { return self.faceForPixels(self.pixelSize(points, scale), bold); }

	public LinuxFace faceForPixels(int pixelSize, bool bold) {
		int key = pixelSize * 2 + (bold ? 1 : 0);
		if (self._faces.has(key)) { return self._faces.get(key); }
		if (self._faces.size() > 48) { self._faces.clear(); }
		var face = LinuxFace(key, bold ? self._boldPath : self._regularPath, pixelSize);
		self._faces.put(key, face);
		return face;
	}

	/* Measured in logical points at the given backing scale. */
	public double textWidth(string text, double points, double scale, bool bold) { return self.face(points, scale, bold).advance(text) / LinuxFonts.backing(scale); }

	public double lineHeight(double points, double scale, bool bold) { return self.face(points, scale, bold).lineHeight / LinuxFonts.backing(scale); }
}
