import Library.GUI.ApplicationSlot;
import Library.GUI.IWebView;
import Library.GUI.Linux.Gtk.LinuxGtkApplication;
import Library.GUI.Linux.Gtk.LinuxGtkWebView;

/* Private package implementation for Linux: the web view behind the WebView
 * facade, a WebKitGTK view among the application's other views. */
class WebViewProvider {
	class IWebView create() {
		var application = (ILinuxGtkApplication?)GUIApplicationSlot.require();
		if (application == null) { throw "The Linux web view needs the Linux GUI application"; }
		var view = LinuxGtkWebView(application.context());
		application.adopt(view);
		return view;
	}
}
