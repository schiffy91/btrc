import Library.Callback;
import Library.Console;
import Library.Image;
import Library.Math;
import Library.GUI.IPanel;
import Library.GUI.Linux.Gtk.LinuxGtkView;
import Library.GUI.Linux.Gtk.LinuxGtkContainer;
import Library.GUI.Linux.Gtk.LinuxGtkContext;
import Library.GUI.Linux.Gtk.LinuxGtkPainter;
import Library.GUI.Linux.Gtk.GtkControls;

/* A filled, optionally rounded container: GTK draws the fill, under the
 * panel's children. Children clip to the panel's rectangular bounds; the
 * corner radius shapes only the fill. setDarkAppearance selects the dark or
 * light theme the panel's drawn descendants use; GTK's own controls have one
 * colour scheme for the whole application and do not follow it. */
class LinuxGtkPanel extends LinuxGtkContainerView implements IPanel {
	private BtrcGtkControl* _control;
	private RGBA _fill;
	private double _radius;
	private int _appearance = 0;

	public LinuxGtkPanel(LinuxGtkContext context, RGBA fill, double radius) {
		self.adoptNode(LinuxGtkViewNode(context));
		self.node().clipsChildren = true;
		if (fill == null) { throw "Native panel fill is missing"; }
		self._fill = fill;
		self._control = btrcGtkFillCreate((unsigned int)self.node().id);
		if (self._control == null) { throw "Cannot create native panel"; }
		self.setCornerRadius(radius);
	}

	private BtrcGtkControl* control() { if (self._control == null) { throw "Native panel is closed"; } return self._control; }

	private void show() { btrcGtkFillSet(self.control(), self._fill.red, self._fill.green, self._fill.blue, self._fill.alpha, self._radius); }

	public void paint(LinuxGtkPainter painter, double x, double y) {
		bool pushed = self._appearance != 0;
		if (pushed) { painter.pushTheme(self._appearance == 2 ? self.node().context.darkTheme : self.node().context.lightTheme); }
		painter.place(self.control(), x, y, self.node().width, self.node().height);
		LinuxGtkComposite.paintChildren(self.node(), painter, x, y);
		if (pushed) { painter.popTheme(); }
	}

	public void setFill(RGBA fill) {
		self.node().requireOpen();
		if (fill == null) { throw "Native panel fill is missing"; }
		self._fill = fill;
		self.show();
	}

	public void setCornerRadius(double radius) {
		self.node().requireOpen();
		if (!Math.isFinite(radius) || radius < 0.0 || radius > 4096.0) { throw "Invalid native panel corner radius"; }
		self._radius = radius;
		self.show();
	}

	public void setDarkAppearance(bool dark) { self.node().requireOpen(); self._appearance = dark ? 2 : 1; self.node().invalidate(); }

	public void inheritAppearance() { self.node().requireOpen(); self._appearance = 0; self.node().invalidate(); }

	public void __del__() {
		if (self.node() != null && self.close() != CALLBACK_CANCELLATION_COMPLETE) { Console.fatal("Native panel destroyed before subtree cleanup completed"); }
		if (self._control != null) { btrcGtkControlDestroy(self._control); self._control = null; }
	}
}
