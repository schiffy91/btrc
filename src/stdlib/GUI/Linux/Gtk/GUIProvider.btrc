import Library.Strings;
import Library.Vector;
import Library.Image;
import Library.GUI.IView;
import Library.GUI.IApplication;
import Library.GUI.IImageHandle;
import Library.GUI.IDirectoryPicker;
import Library.GUI.GUICaptureLayer;
import Library.GUI.Linux.Gtk.GtkShim;
import Library.GUI.Linux.Gtk.LinuxGtkApplication;
import Library.GUI.Linux.Gtk.LinuxGtkView;
import Library.GUI.Linux.Gtk.LinuxGtkImageView;
import Library.GUI.Linux.Gtk.LinuxGtkDirectoryPicker;
import Library.GUI.Linux.Gtk.LinuxGtkSystemText;

/* Private package implementation for Linux: the native services behind the
 * GUI facade. The facade validates requests and owns the application. GTK is
 * started once and kept for the process: a later initialize reuses it and
 * its thread stays fixed, since GTK cannot be started a second time. */
class GUIProvider {
	class bool gtkReady = false;

	/* GTK's thread is the one that first started it: GUI.initialize. */
	class void requireUIThread() { if (!btrcGtkIsMainThread()) { throw "GUI requires the main thread"; } }

	class IApplication createApplication(int workCapacity) {
		if (!GUIProvider.gtkReady) {
			if (!btrcGtkInit()) { throw "Cannot initialize native windowing: " + Strings.copy((char*)btrcGtkError()); }
			GUIProvider.gtkReady = true;
		}
		return LinuxGtkApplication(workCapacity);
	}

	class ILinuxGtkApplication linuxGtkApplication(IApplication? application) {
		var linux = (ILinuxGtkApplication?)application;
		if (linux == null) { throw "GUI application belongs to another provider"; }
		return linux;
	}

	/* Worker-safe and independent of initialization: needs no application. */
	class IImageHandle createImageHandle(Image pixels, int maximumPixels) { return LinuxGtkImageHandle.create(pixels, maximumPixels); }

	class DirectoryPickerOutcome chooseDirectory(IApplication application, DirectoryPickerRequest request) {
		var linux = GUIProvider.linuxGtkApplication(application);
		linux.context().requireNoCloseDecision();
		var window = linux.firstWindow();
		var pump = (ILinuxGtkDialogPump?)linux;
		if (pump == null) { throw "GUI application cannot run native dialogs"; }
		return LinuxGtkDirectoryPicker(window == null ? null : window.nativeWindow(), pump).chooseDirectory(request);
	}

	class void rasterizeText(IApplication? application, TextRasterization request) {
		if (application == null) { throw "Initialize GUI before creating views or running work"; }
		LinuxGtkSystemText.rasterize(GUIProvider.linuxGtkApplication(application).context().fonts, request);
	}

	/* The window composites every GPU child itself, so the readback is the
	 * composed capture. Layers must name GPU views inside the root; their
	 * pixels are not needed. The device request is asynchronous, and capture
	 * fails at once rather than waiting for it on the UI thread. */
	class Image capture(IApplication application, IView root, Vector<GUICaptureLayer> layers) {
		var native = (ILinuxGtkView?)root;
		if (native == null) { throw "Capture root belongs to another GUI provider"; }
		var window = GUIProvider.linuxGtkApplication(application).windowOwning(native);
		if (window == null) { throw "Capture root is not attached to a window"; }
		if (layers == null) { throw "Capture layers are missing"; }
		for layer in layers {
			if (layer == null) { throw "Capture layer is missing"; }
			var gpu = (ILinuxGtkView?)layer.view;
			if (gpu == null) { throw "Capture layer belongs to another GPU provider"; }
			if (gpu.node() != native.node() && !native.node().contains(gpu.node())) { throw "Capture layer is outside the capture root"; }
		}
		if (!window.pollDevice()) { throw "Capture window GPU device is not ready"; }
		var image = window.render(true);
		if (image == null) { throw "Capture window produced no frame"; }
		return image;
	}
}
