import Library.Callback;
import Library.Console;
import Library.Math;
import Library.Vector;
import Library.App;
import Library.GUI.IScrollView;
import Library.GUI.IView;
import Library.GUI.Linux.LinuxView;
import Library.GUI.Linux.LinuxContainer;
import Library.GUI.Linux.LinuxContext;
import Library.GUI.Linux.LinuxPainter;

/* A vertical viewport over a document: children arrange in document points,
 * the viewport clips and offsets them, wheel input scrolls, and an overlay
 * scrollbar appears while content overflows. */
class LinuxScrollView implements IScrollView, ILinuxView {
	private LinuxViewNode _node;
	private double _contentWidth = 0.0;
	private double _contentHeight = 0.0;
	private double _offset = 0.0;
	private bool _dragging = false;
	private double _dragStartY = 0.0;
	private double _dragStartOffset = 0.0;

	public LinuxScrollView(LinuxContext context) {
		self._node = LinuxViewNode(context);
		self._node.clipsChildren = true;
	}

	public LinuxViewNode node() { return self._node; }

	public void attachTo(LinuxViewHost? host) { self._node.setHost(host); }

	private double maximumOffset() { return Math.maxDouble(0.0, self._contentHeight - self._node.height); }

	private void applyOffset(double offset) {
		double maximum = self.maximumOffset();
		double clamped = !Math.isFinite(offset) || offset < 0.0 ? 0.0 : (offset > maximum ? maximum : offset);
		if (clamped == self._offset && self._node.contentOffsetY == -clamped) { return; }
		self._offset = clamped;
		self._node.contentOffsetY = -clamped;
		self._node.invalidate();
	}

	private double trackHeight() { return Math.maxDouble(0.0, self._node.height - 4.0); }

	private double thumbHeight() {
		if (self._contentHeight <= self._node.height || self._contentHeight <= 0.0) { return 0.0; }
		return Math.maxDouble(24.0, self.trackHeight() * self._node.height / self._contentHeight);
	}

	private double thumbY() {
		double maximum = self.maximumOffset();
		double travel = self.trackHeight() - self.thumbHeight();
		return 2.0 + (maximum > 0.0 ? travel * self._offset / maximum : 0.0);
	}

	public void paint(LinuxPainter painter, double x, double y) {
		LinuxComposite.paintChildren(self._node, painter, x, y);
		double thumb = self.thumbHeight();
		if (thumb <= 0.0) { return; }
		var theme = painter.theme();
		double barX = x + self._node.width - 10.0;
		painter.fillRect(barX, y + self.thumbY(), 6.0, thumb, RGBA(theme.text.red, theme.text.green, theme.text.blue, self._dragging ? 150 : 90), 3.0);
	}

	public void paintOverlay(LinuxPainter painter, double x, double y) {}

	public bool pointer(AppPointerEvent event) {
		if (event.action == APP_POINTER_PRESSED && event.button == APP_POINTER_BUTTON_PRIMARY) {
			double thumb = self.thumbHeight();
			if (thumb > 0.0 && event.logicalX >= self._node.width - 14.0) {
				double top = self.thumbY();
				if (event.logicalY >= top && event.logicalY <= top + thumb) {
					self._dragging = true;
					self._dragStartY = event.logicalY;
					self._dragStartOffset = self._offset;
				} else {
					self.applyOffset(self._offset + (event.logicalY < top ? -self._node.height : self._node.height));
				}
				self._node.invalidate();
				return true;
			}
			return false;
		}
		if (event.action == APP_POINTER_DRAGGED && self._dragging) {
			double travel = self.trackHeight() - self.thumbHeight();
			if (travel > 0.0) { self.applyOffset(self._dragStartOffset + (event.logicalY - self._dragStartY) * self.maximumOffset() / travel); }
			return true;
		}
		if ((event.action == APP_POINTER_RELEASED || event.action == APP_POINTER_CANCELLED) && self._dragging) { self._dragging = false; self._node.invalidate(); return true; }
		return false;
	}

	public bool scroll(AppScrollEvent event) {
		if (self.maximumOffset() <= 0.0) { return false; }
		double step = event.precise ? event.deltaY : event.deltaY * 48.0;
		self.applyOffset(self._offset - step);
		return true;
	}

	public bool key(AppKeyboardEvent event) { return false; }

	public void textInput(string value) {}

	public void focus(bool focused) {}

	public bool isOpen() { return self._node.isOpen(); }

	public double fittingWidth() { self._node.requireOpen(); return 0.0; }

	public double fittingHeight() { self._node.requireOpen(); return 0.0; }

	public void arrange(double x, double y, double width, double height) { self._node.arrange(x, y, width, height); self.applyOffset(self._offset); }

	public bool isVisible() { self._node.requireOpen(); return self._node.visible; }

	public void setVisible(bool visible) { self._node.setVisible(visible); }

	public ICallbackRegistration onPointer(IViewPointerHandler handler, CallbackScope owner) { return self._node.onPointer(handler, owner); }

	public ICallbackRegistration onScroll(IViewScrollHandler handler, CallbackScope owner) { return self._node.onScroll(handler, owner); }

	public void attach(IView child) { self._node.attachChild(LinuxComposite.projection(child)); }

	public IView detach(IView child) { return self._node.detachChild(LinuxComposite.projection(child)); }

	public int childCount() { self._node.requireOpen(); return self._node.children.len; }

	public IView childAt(int index) {
		self._node.requireOpen();
		if (index < 0 || index >= self._node.children.len) { throw "Container child index is out of bounds"; }
		return self._node.children.get(index);
	}

	public void setContentSize(double width, double height) {
		self._node.requireOpen();
		if (!Math.isFinite(width) || !Math.isFinite(height) || width < 0.0 || height < 0.0) { throw "Invalid scroll content size"; }
		self._contentWidth = width;
		self._contentHeight = height;
		self.applyOffset(self._offset);
		self._node.invalidate();
	}

	public double scrollOffset() { self._node.requireOpen(); return self._offset; }

	public void scrollTo(double offset) {
		self._node.requireOpen();
		if (!Math.isFinite(offset)) { throw "Invalid scroll offset"; }
		self.applyOffset(offset);
	}

	public CallbackCancellation close() { return self._node.close(); }

	public CallbackCancellation pollClose() { return self._node.pollClose(); }

	public void __del__() { if (self._node != null && self.close() != CallbackCancellation.Complete) { Console.fatal("Native scroll view destroyed before subtree cleanup completed"); } }
}
