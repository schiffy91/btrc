import Library.Callback;
import Library.Image;
import Library.GUI.IImageView;
import Library.GUI.IImageHandle;
import Library.GUI.Linux.LinuxView;
import Library.GUI.Linux.LinuxContext;
import Library.GUI.Linux.LinuxPainter;

/* Image identities come from one process-wide counter, so any thread creates
 * a handle without reaching the application. Static Atomic<T> storage is
 * zero-initialized before program entry. */
static Atomic<int> linuxImageIdentities;

/* Decoded pixels with a stable identity. Any thread may create one; painters
 * upload it to their device on first use and cache by identity. */
interface ILinuxImageHandle extends IImageHandle {
	int identity();
	Image pixels();
}

class LinuxImageHandle implements ILinuxImageHandle {
	private Image? _pixels;
	private int _identity;
	private int _width;
	private int _height;

	private LinuxImageHandle(int identity, Image pixels) {
		self._identity = identity;
		self._pixels = pixels;
		self._width = pixels.width;
		self._height = pixels.height;
	}

	class LinuxImageHandle create(Image pixels, int maximumPixels = 16777216) {
		if (pixels == null || pixels.isEmpty() || pixels.data == null) { throw "Native image handle requires decoded pixels"; }
		if (maximumPixels <= 0 || maximumPixels > 16777216 || (long long)pixels.width * (long long)pixels.height > (long long)maximumPixels) { throw "Native artwork exceeds image limits"; }
		var copy = Image(pixels.width, pixels.height);
		memcpy(copy.data, pixels.data, (size_t)pixels.width * (size_t)pixels.height * (size_t)4);
		return LinuxImageHandle(LinuxImageHandle.nextIdentity(), copy);
	}

	class int nextIdentity() {
		int id = linuxImageIdentities.fetchAdd(1, MemoryOrder.RELAXED) + 1;
		if (id <= 0 || id == 2147483647) { throw "Native image identities are exhausted"; }
		return id;
	}

	public int identity() { return self._identity; }

	public Image pixels() { var pixels = self._pixels; if (pixels == null) { throw "Native image handle is closed"; } return pixels; }

	public int width() { return self._width; }

	public int height() { return self._height; }

	public bool isOpen() { return self._pixels != null; }

	public void close() { self._pixels = null; }

	public void __del__() { self.close(); }
}

/* Aspect-preserving presentation of one image handle. */
class LinuxImageView extends LinuxNodeView implements IImageView {
	private ILinuxImageHandle? _handle = null;

	public LinuxImageView(LinuxContext context) { self.adoptNode(LinuxViewNode(context)); }

	public void paint(LinuxPainter painter, double x, double y) {
		var handle = self._handle;
		if (handle == null || !handle.isOpen()) { return; }
		var texture = painter.imageTexture(handle.identity(), handle.pixels());
		painter.imageFit(texture, x, y, self.node().width, self.node().height, RGBA(255, 255, 255, 255));
	}

	public double fittingWidth() { self.node().requireOpen(); var handle = self._handle; return handle == null ? 0.0 : (double)handle.width(); }

	public double fittingHeight() { self.node().requireOpen(); var handle = self._handle; return handle == null ? 0.0 : (double)handle.height(); }

	public void setImage(Image? pixels, int maximumPixels = 16777216) {
		self.node().requireOpen();
		if (pixels == null) { self._handle = null; self.node().invalidate(); return; }
		self._handle = LinuxImageHandle.create(pixels, maximumPixels);
		self.node().invalidate();
	}

	public void setImageHandle(IImageHandle? handle) {
		self.node().requireOpen();
		if (handle == null) { self._handle = null; self.node().invalidate(); return; }
		ILinuxImageHandle? native = (ILinuxImageHandle?)handle;
		if (native == null) { throw "Native image view requires a Linux image handle"; }
		if (self._handle == native) { return; }
		self._handle = native;
		self.node().invalidate();
	}

	public CallbackCancellation close() { var state = self.node().close(); if (state == CallbackCancellation.Complete) { self._handle = null; } return state; }

	public CallbackCancellation pollClose() { var state = self.node().pollClose(); if (state == CallbackCancellation.Complete) { self._handle = null; } return state; }
}
