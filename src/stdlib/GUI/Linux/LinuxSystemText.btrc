import Library.Math;
import Library.Image;
import Library.GUI.TextRun;
import Library.GUI.Linux.LinuxFonts;

/* System text shaping for musical/GPU surfaces: one line rendered with the
 * fontconfig sans face at the run's pixel size into a white straight-alpha
 * image. The returned Image owns its pixels. */
class LinuxSystemText {
	class void rasterize(LinuxFonts fonts, TextRasterization request) { request.complete(LinuxSystemText.raster(fonts, request.run())); }

	class Image raster(LinuxFonts fonts, TextRun run) {
		if (run == null) { throw "System text requires a run"; }
		if (run.text().isEmpty()) { return Image.empty(); }
		var face = fonts.faceForPixels(run.fontSize(), run.weight() >= 600);
		double advance = face.advance(run.text());
		int width = (int)Math.maxDouble(1.0, Math.ceilDouble(advance + 2.0));
		int height = (int)Math.maxDouble((double)run.lineHeight(), Math.ceilDouble(face.lineHeight));
		if (width > 4096 || height > 4096) { throw "System text exceeds raster limits"; }
		var image = Image(width, height);
		double baseline = Math.floorDouble(((double)height - face.lineHeight) * 0.5 + face.ascent + 0.5);
		double penX = 1.0;
		int offset = 0;
		string text = run.text();
		while (offset < text.len()) {
			var scalar = LinuxScalar.decode(text, offset);
			offset = scalar.next;
			var glyph = face.glyph(scalar.codepoint);
			int left = (int)Math.floorDouble(penX) + glyph.left;
			int top = (int)baseline - glyph.top;
			for (int row = 0; row < glyph.rows; row++) {
				int y = top + row;
				if (y < 0 || y >= height) { continue; }
				for (int column = 0; column < glyph.width; column++) {
					int x = left + column;
					if (x < 0 || x >= width) { continue; }
					int coverage = glyph.coverage(row, column);
					if (coverage == 0) { continue; }
					int index = (y * width + x) * 4;
					int existing = (int)image.data[index + 3];
					int merged = coverage + existing - coverage * existing / 255;
					image.data[index] = 255;
					image.data[index + 1] = 255;
					image.data[index + 2] = 255;
					image.data[index + 3] = (unsigned char)(merged > 255 ? 255 : merged);
				}
			}
			penX += glyph.advance;
		}
		return image;
	}
}
