import Library.Math;
import Library.OwnedBuffer;
import Library.Vector;
import Library.GPU.GPUDevice;
import Library.GPU.GPUSurfaceRenderer;
import Library.GPU.WebGPU;
import Library.GUI.Linux.LinuxContext;
import Library.GUI.Linux.GtkControls;

/* One sampled texture with its bind group: a GPU view's target, borrowed per frame. */
class LinuxTexture {
	private GPUDevice _device;
	private WGPUTexture _texture = null;
	private WGPUTextureView _view = null;
	private WGPUBindGroup _group = null;
	private bool _ownsTexture;
	private int _width;
	private int _height;

	private LinuxTexture(GPUDevice device, int width, int height, bool ownsTexture) {
		self._device = device;
		self._width = width;
		self._height = height;
		self._ownsTexture = ownsTexture;
	}

	/* A borrowed view, for example a GPU view's offscreen target. */
	class LinuxTexture borrow(GPUDevice device, WGPUTextureView view, int width, int height, WGPUBindGroupLayout layout, WGPUSampler sampler, WGPUBuffer uniform, unsigned long long uniformBytes) {
		var texture = LinuxTexture(device, width, height, false);
		texture._view = view;
		texture.bind(layout, sampler, uniform, uniformBytes);
		return texture;
	}

	private void bind(WGPUBindGroupLayout layout, WGPUSampler sampler, WGPUBuffer uniform, unsigned long long uniformBytes) {
		WGPUBindGroupEntry entries[3];
		memset(entries, 0, sizeof(entries));
		entries[0].binding = 0u;
		entries[0].buffer = uniform;
		entries[0].size = uniformBytes;
		entries[1].binding = 1u;
		entries[1].textureView = self._view;
		entries[2].binding = 2u;
		entries[2].sampler = sampler;
		WGPUBindGroupDescriptor descriptor = {null};
		descriptor.layout = layout;
		descriptor.entryCount = (size_t)3;
		descriptor.entries = entries;
		self._group = wgpuDeviceCreateBindGroup(self._device.nativeDevice(), &descriptor);
		if (self._group == null) { self.close(); throw "Cannot bind native texture"; }
	}

	public int width() { return self._width; }

	public int height() { return self._height; }

	public bool isOpen() { return self._group != null; }

	public WGPUBindGroup nativeGroup() { if (self._group == null) { throw "Native texture is closed"; } return self._group; }

	public void close() {
		if (self._group != null) { wgpuBindGroupRelease(self._group); self._group = null; }
		if (self._ownsTexture) {
			if (self._view != null) { wgpuTextureViewRelease(self._view); }
			if (self._texture != null) { wgpuTextureRelease(self._texture); }
		}
		self._view = null;
		self._texture = null;
	}

	public void __del__() { self.close(); }
}

/* Draw-list segment: a vertex range sharing one texture and scissor. */
class LinuxDrawRun {
	public LinuxTexture texture;
	public int first;
	public int count;
	public int clipX;
	public int clipY;
	public int clipWidth;
	public int clipHeight;

	public LinuxDrawRun(LinuxTexture texture, int first, int clipX, int clipY, int clipWidth, int clipHeight) {
		self.texture = texture;
		self.first = first;
		self.count = 0;
		self.clipX = clipX;
		self.clipY = clipY;
		self.clipWidth = clipWidth;
		self.clipHeight = clipHeight;
	}
}

/* A logical-point clip rectangle on the painter's stack. */
class LinuxClip {
	public double x;
	public double y;
	public double width;
	public double height;

	public LinuxClip(double x, double y, double width, double height) { self.x = x; self.y = y; self.width = width; self.height = height; }
}

/* Where one native control goes this frame: its frame and the clip of the
 * views around it, in logical points from the window's top-left. With no
 * control it is a hole: a rectangle of drawn content (a GPU view) that shows
 * through the controls placed before it. */
class LinuxPlacement {
	public BtrcGtkControl* control;
	public double x;
	public double y;
	public double width;
	public double height;
	public LinuxClip clip;

	public LinuxPlacement(BtrcGtkControl* control, double x, double y, double width, double height, LinuxClip clip) {
		self.control = control; self.x = x; self.y = y; self.width = width; self.height = height; self.clip = clip;
	}
}

/* The per-window compositor of drawn content. Each GPU view's target is
 * recorded as one textured quad, in backing pixels, and the stream replays
 * inside the window's render pass. Coordinates arrive in logical points
 * from the window's top-left. Everything else in a window is a GTK widget. */
class LinuxPainter {
	private GPUDevice _device;
	private WGPUTextureFormat _format;
	private WGPUShaderModule _shader = null;
	private WGPUBindGroupLayout _layout = null;
	private WGPUPipelineLayout _pipelineLayout = null;
	private WGPURenderPipeline _pipeline = null;
	private WGPUSampler _sampler = null;
	private WGPUBuffer _uniform = null;
	private WGPUBuffer _vertices = null;
	private unsigned long long _vertexCapacity = 0ULL;
	private OwnedBuffer<float> _stream;
	private size_t _streamCapacity;
	private int _vertexCount = 0;
	private Vector<LinuxDrawRun> _runs = [];
	private Vector<LinuxClip> _clips = [];
	private double _scale = 1.0;
	private int _pixelWidth = 0;
	private int _pixelHeight = 0;
	private bool _closed = false;

	public LinuxPainter(GPUDevice device, WGPUTextureFormat format) {
		if (device.state() != GPU_DEVICE_READY) { throw "Native painter requires a ready device"; }
		self._device = device;
		self._format = format;
		self._streamCapacity = (size_t)(16 * 6 * 1024);
		self._stream = OwnedBuffer(self._streamCapacity);
		if (!self._stream.opened()) { throw "Cannot allocate painter stream"; }
		self.createResources();
	}

	class string shaderSource() { return "struct Uniforms { viewport: vec4<f32> };\n" + "@group(0) @binding(0) var<uniform> uniforms: Uniforms;\n" + "@group(0) @binding(1) var atlas: texture_2d<f32>;\n" + "@group(0) @binding(2) var atlasSampler: sampler;\n" + "struct VertexInput { @location(0) position: vec2<f32>, @location(1) uv: vec2<f32>, @location(2) color: vec4<f32>, @location(3) rect: vec4<f32>, @location(4) params: vec4<f32> };\n" + "struct VertexOutput { @builtin(position) clip: vec4<f32>, @location(0) uv: vec2<f32>, @location(1) color: vec4<f32>, @location(2) rect: vec4<f32>, @location(3) params: vec4<f32> };\n" + "@vertex fn vs_main(input: VertexInput) -> VertexOutput {\n" + "  var out: VertexOutput;\n" + "  out.clip = vec4<f32>(input.position.x / uniforms.viewport.x * 2.0 - 1.0, 1.0 - input.position.y / uniforms.viewport.y * 2.0, 0.0, 1.0);\n" + "  out.uv = input.uv; out.color = input.color; out.rect = input.rect; out.params = input.params;\n" + "  return out;\n" + "}\n" + "fn coverage(pixel: vec2<f32>, rect: vec4<f32>, radius: f32) -> f32 {\n" + "  let half = rect.zw * 0.5;\n" + "  let center = rect.xy + half;\n" + "  let r = min(radius, min(half.x, half.y));\n" + "  let q = abs(pixel - center) - half + vec2<f32>(r, r);\n" + "  let d = length(max(q, vec2<f32>(0.0, 0.0))) + min(max(q.x, q.y), 0.0) - r;\n" + "  return clamp(0.5 - d, 0.0, 1.0);\n" + "}\n" + "@fragment fn fs_main(input: VertexOutput) -> @location(0) vec4<f32> {\n" + "  let sampled = textureSample(atlas, atlasSampler, input.uv);\n" + "  let mode = i32(input.params.y + 0.5);\n" + "  var color = input.color;\n" + "  if (mode == 1) { color = color * sampled; }\n" + "  else if (mode == 2) { color.a = color.a * sampled.r; }\n" + "  else if (mode == 3) { color.a = color.a * coverage(input.clip.xy, input.rect, input.params.x); }\n" + "  else if (mode == 4) {\n" + "    let inset = input.params.z;\n" + "    let outer = coverage(input.clip.xy, input.rect, input.params.x);\n" + "    let inner = coverage(input.clip.xy, vec4<f32>(input.rect.x + inset, input.rect.y + inset, input.rect.z - 2.0 * inset, input.rect.w - 2.0 * inset), max(input.params.x - inset, 0.0));\n" + "    color.a = color.a * clamp(outer - inner, 0.0, 1.0);\n" + "  }\n" + "  else if (mode == 5) { color = color * sampled; color.a = color.a * coverage(input.clip.xy, input.rect, input.params.x); }\n" + "  return color;\n" + "}\n"; }

	class OwnedBuffer<char> nativeText(string value) {
		var bytes = new OwnedBuffer<char>((size_t)value.len() + (size_t)1);
		if (!bytes.opened()) { throw "Cannot allocate native painter text"; }
		strcpy(bytes.borrow(), value);
		return bytes;
	}

	private void createResources() {
		var device = self._device.nativeDevice();
		string source = LinuxPainter.shaderSource();
		var sourceBytes = LinuxPainter.nativeText(source);
		var vertexEntry = LinuxPainter.nativeText("vs_main");
		var fragmentEntry = LinuxPainter.nativeText("fs_main");
		WGPUShaderSourceWGSL wgsl;
		memset(&wgsl, 0, sizeof(WGPUShaderSourceWGSL));
		wgsl.chain.sType = WGPUSType_ShaderSourceWGSL;
		wgsl.code.data = sourceBytes.borrow();
		wgsl.code.length = (size_t)source.len();
		WGPUShaderModuleDescriptor shaderDescriptor = {null};
		shaderDescriptor.nextInChain = &wgsl.chain;
		self._shader = wgpuDeviceCreateShaderModule(device, &shaderDescriptor);
		if (self._shader == null) { throw "Cannot compile native painter shader"; }
		WGPUBindGroupLayoutEntry entries[3];
		memset(entries, 0, sizeof(entries));
		entries[0].binding = 0u;
		entries[0].visibility = WGPUShaderStage_Vertex | WGPUShaderStage_Fragment;
		entries[0].buffer.type = WGPUBufferBindingType_Uniform;
		entries[0].buffer.minBindingSize = 16ULL;
		entries[1].binding = 1u;
		entries[1].visibility = WGPUShaderStage_Fragment;
		entries[1].texture.sampleType = WGPUTextureSampleType_Float;
		entries[1].texture.viewDimension = WGPUTextureViewDimension_2D;
		entries[2].binding = 2u;
		entries[2].visibility = WGPUShaderStage_Fragment;
		entries[2].sampler.type = WGPUSamplerBindingType_Filtering;
		WGPUBindGroupLayoutDescriptor layoutDescriptor = {null};
		layoutDescriptor.entryCount = (size_t)3;
		layoutDescriptor.entries = entries;
		self._layout = wgpuDeviceCreateBindGroupLayout(device, &layoutDescriptor);
		if (self._layout == null) { throw "Cannot create native painter layout"; }
		const WGPUBindGroupLayout layout = self._layout;
		WGPUPipelineLayoutDescriptor pipelineLayoutDescriptor = {null};
		pipelineLayoutDescriptor.bindGroupLayoutCount = (size_t)1;
		pipelineLayoutDescriptor.bindGroupLayouts = &layout;
		self._pipelineLayout = wgpuDeviceCreatePipelineLayout(device, &pipelineLayoutDescriptor);
		if (self._pipelineLayout == null) { throw "Cannot create native painter pipeline layout"; }
		WGPUVertexAttribute attributes[5];
		memset(attributes, 0, sizeof(attributes));
		attributes[0].format = WGPUVertexFormat_Float32x2; attributes[0].offset = 0ULL; attributes[0].shaderLocation = 0u;
		attributes[1].format = WGPUVertexFormat_Float32x2; attributes[1].offset = 8ULL; attributes[1].shaderLocation = 1u;
		attributes[2].format = WGPUVertexFormat_Float32x4; attributes[2].offset = 16ULL; attributes[2].shaderLocation = 2u;
		attributes[3].format = WGPUVertexFormat_Float32x4; attributes[3].offset = 32ULL; attributes[3].shaderLocation = 3u;
		attributes[4].format = WGPUVertexFormat_Float32x4; attributes[4].offset = 48ULL; attributes[4].shaderLocation = 4u;
		WGPUVertexBufferLayout vertexLayout;
		memset(&vertexLayout, 0, sizeof(WGPUVertexBufferLayout));
		vertexLayout.arrayStride = 64ULL;
		vertexLayout.stepMode = WGPUVertexStepMode_Vertex;
		vertexLayout.attributeCount = (size_t)5;
		vertexLayout.attributes = attributes;
		WGPUBlendState blend;
		memset(&blend, 0, sizeof(WGPUBlendState));
		blend.color.operation = WGPUBlendOperation_Add;
		blend.color.srcFactor = WGPUBlendFactor_SrcAlpha;
		blend.color.dstFactor = WGPUBlendFactor_OneMinusSrcAlpha;
		blend.alpha.operation = WGPUBlendOperation_Add;
		blend.alpha.srcFactor = WGPUBlendFactor_One;
		blend.alpha.dstFactor = WGPUBlendFactor_OneMinusSrcAlpha;
		WGPUColorTargetState target = {null};
		target.format = self._format;
		target.writeMask = WGPUColorWriteMask_All;
		target.blend = &blend;
		WGPUFragmentState fragment = {null};
		fragment.module = self._shader;
		fragment.entryPoint.data = fragmentEntry.borrow();
		fragment.entryPoint.length = (size_t)7;
		fragment.targetCount = (size_t)1;
		fragment.targets = &target;
		WGPURenderPipelineDescriptor descriptor = {null};
		descriptor.layout = self._pipelineLayout;
		descriptor.vertex.module = self._shader;
		descriptor.vertex.entryPoint.data = vertexEntry.borrow();
		descriptor.vertex.entryPoint.length = (size_t)7;
		descriptor.vertex.bufferCount = (size_t)1;
		descriptor.vertex.buffers = &vertexLayout;
		descriptor.fragment = &fragment;
		descriptor.primitive.topology = WGPUPrimitiveTopology_TriangleList;
		descriptor.primitive.frontFace = WGPUFrontFace_CCW;
		descriptor.primitive.cullMode = WGPUCullMode_None;
		descriptor.multisample.count = 1u;
		descriptor.multisample.mask = 4294967295u;
		self._pipeline = wgpuDeviceCreateRenderPipeline(device, &descriptor);
		if (self._pipeline == null) { throw "Cannot create native painter pipeline"; }
		WGPUSamplerDescriptor samplerDescriptor = {null};
		samplerDescriptor.addressModeU = WGPUAddressMode_ClampToEdge;
		samplerDescriptor.addressModeV = WGPUAddressMode_ClampToEdge;
		samplerDescriptor.addressModeW = WGPUAddressMode_ClampToEdge;
		samplerDescriptor.magFilter = WGPUFilterMode_Linear;
		samplerDescriptor.minFilter = WGPUFilterMode_Linear;
		samplerDescriptor.mipmapFilter = WGPUMipmapFilterMode_Nearest;
		samplerDescriptor.maxAnisotropy = 1u;
		self._sampler = wgpuDeviceCreateSampler(device, &samplerDescriptor);
		if (self._sampler == null) { throw "Cannot create native painter sampler"; }
		WGPUBufferDescriptor uniformDescriptor = {null};
		uniformDescriptor.size = 16ULL;
		uniformDescriptor.usage = WGPUBufferUsage_Uniform | WGPUBufferUsage_CopyDst;
		self._uniform = wgpuDeviceCreateBuffer(device, &uniformDescriptor);
		if (self._uniform == null) { throw "Cannot allocate native painter uniform"; }
	}

	/* Wrap an external view (a GPU view's offscreen target) for sampling. */
	public LinuxTexture borrowTexture(WGPUTextureView view, int width, int height) { return LinuxTexture.borrow(self._device, view, width, height, self._layout, self._sampler, self._uniform, 16ULL); }

	public void beginFrame(int pixelWidth, int pixelHeight, double scale) {
		if (self._closed) { throw "Native painter is closed"; }
		self._pixelWidth = pixelWidth;
		self._pixelHeight = pixelHeight;
		self._scale = scale;
		self._vertexCount = 0;
		self._runs.clear();
		self._clips.clear();
		self._clips.push(LinuxClip(0.0, 0.0, (double)pixelWidth / scale, (double)pixelHeight / scale));
	}

	public void pushClip(double x, double y, double width, double height) {
		var current = self._clips.last();
		double left = Math.maxDouble(current.x, x);
		double top = Math.maxDouble(current.y, y);
		double right = Math.minDouble(current.x + current.width, x + width);
		double bottom = Math.minDouble(current.y + current.height, y + height);
		self._clips.push(LinuxClip(left, top, Math.maxDouble(0.0, right - left), Math.maxDouble(0.0, bottom - top)));
	}

	public void popClip() { if (self._clips.len > 1) { self._clips.pop(); } }

	private LinuxDrawRun run(LinuxTexture texture) {
		var clip = self._clips.last();
		int clipX = (int)Math.floorDouble(clip.x * self._scale);
		int clipY = (int)Math.floorDouble(clip.y * self._scale);
		int clipRight = (int)Math.ceilDouble((clip.x + clip.width) * self._scale);
		int clipBottom = (int)Math.ceilDouble((clip.y + clip.height) * self._scale);
		if (clipX < 0) { clipX = 0; }
		if (clipY < 0) { clipY = 0; }
		if (clipRight > self._pixelWidth) { clipRight = self._pixelWidth; }
		if (clipBottom > self._pixelHeight) { clipBottom = self._pixelHeight; }
		int clipWidth = clipRight - clipX;
		int clipHeight = clipBottom - clipY;
		if (clipWidth < 0) { clipWidth = 0; }
		if (clipHeight < 0) { clipHeight = 0; }
		if (!self._runs.isEmpty()) {
			var last = self._runs.last();
			if (last.texture == texture && last.clipX == clipX && last.clipY == clipY && last.clipWidth == clipWidth && last.clipHeight == clipHeight) { return last; }
		}
		var created = LinuxDrawRun(texture, self._vertexCount, clipX, clipY, clipWidth, clipHeight);
		self._runs.push(created);
		return created;
	}

	private void reserve(int vertices) {
		size_t needed = (size_t)(self._vertexCount + vertices) * (size_t)16;
		if (needed <= self._streamCapacity) { return; }
		size_t capacity = self._streamCapacity;
		while (capacity < needed) { capacity *= (size_t)2; }
		var grown = new OwnedBuffer<float>(capacity);
		if (!grown.opened()) { throw "Cannot grow painter stream"; }
		memcpy(grown.borrow(), self._stream.borrow(), (size_t)self._vertexCount * (size_t)16 * sizeof(float));
		self._stream = grown;
		self._streamCapacity = capacity;
	}

	private void vertex(float* stream, int index, double x, double y, double u, double v, RGBA color, double rectX, double rectY, double rectWidth, double rectHeight, double radius, int mode, double inset) {
		float* base = stream + (size_t)index * (size_t)16;
		base[0] = (float)x; base[1] = (float)y; base[2] = (float)u; base[3] = (float)v;
		base[4] = (float)color.red / 255.0f; base[5] = (float)color.green / 255.0f; base[6] = (float)color.blue / 255.0f; base[7] = (float)color.alpha / 255.0f;
		base[8] = (float)rectX; base[9] = (float)rectY; base[10] = (float)rectWidth; base[11] = (float)rectHeight;
		base[12] = (float)radius; base[13] = (float)mode; base[14] = (float)inset; base[15] = 0.0f;
	}

	/* Emit one axis-aligned quad in pixel space with the given uv rectangle. */
	private void quad(LinuxTexture texture, double px, double py, double pw, double ph, double u0, double v0, double u1, double v1, RGBA color, double radius, int mode, double inset) {
		if (pw <= 0.0 || ph <= 0.0 || color.alpha == 0) { return; }
		var clip = self._clips.last();
		if (clip.width <= 0.0 || clip.height <= 0.0) { return; }
		var run = self.run(texture);
		self.reserve(6);
		var stream = self._stream.borrow();
		int base = self._vertexCount;
		self.vertex(stream, base, px, py, u0, v0, color, px, py, pw, ph, radius, mode, inset);
		self.vertex(stream, base + 1, px + pw, py, u1, v0, color, px, py, pw, ph, radius, mode, inset);
		self.vertex(stream, base + 2, px + pw, py + ph, u1, v1, color, px, py, pw, ph, radius, mode, inset);
		self.vertex(stream, base + 3, px, py, u0, v0, color, px, py, pw, ph, radius, mode, inset);
		self.vertex(stream, base + 4, px + pw, py + ph, u1, v1, color, px, py, pw, ph, radius, mode, inset);
		self.vertex(stream, base + 5, px, py + ph, u0, v1, color, px, py, pw, ph, radius, mode, inset);
		self._vertexCount += 6;
		run.count += 6;
	}

	/* Draw a texture stretched to a logical rectangle, optionally rounded. */
	public void texture(LinuxTexture texture, double x, double y, double width, double height, RGBA tint, double radius = 0.0) {
		double s = self._scale;
		self.quad(texture, x * s, y * s, width * s, height * s, 0.0, 0.0, 1.0, 1.0, tint, radius * s, radius > 0.0 ? 5 : 1, 0.0);
	}

	/* Replay the recorded stream into the renderer's active pass. */
	public void render(GPUSurfaceRenderer renderer) {
		if (self._closed) { throw "Native painter is closed"; }
		var device = self._device.nativeDevice();
		var queue = self._device.nativeQueue();
		float viewport[4] = {(float)self._pixelWidth, (float)self._pixelHeight, 0.0f, 0.0f};
		wgpuQueueWriteBuffer(queue, self._uniform, 0ULL, viewport, (size_t)16);
		if (self._vertexCount == 0) { return; }
		unsigned long long bytes = (unsigned long long)self._vertexCount * 64ULL;
		if (self._vertices == null || bytes > self._vertexCapacity) {
			if (self._vertices != null) { wgpuBufferRelease(self._vertices); self._vertices = null; }
			unsigned long long capacity = self._vertexCapacity == 0ULL ? 65536ULL : self._vertexCapacity;
			while (capacity < bytes) { capacity *= 2ULL; }
			WGPUBufferDescriptor descriptor = {null};
			descriptor.size = capacity;
			descriptor.usage = WGPUBufferUsage_Vertex | WGPUBufferUsage_CopyDst;
			self._vertices = wgpuDeviceCreateBuffer(device, &descriptor);
			if (self._vertices == null) { throw "Cannot allocate native painter vertices"; }
			self._vertexCapacity = capacity;
		}
		wgpuQueueWriteBuffer(queue, self._vertices, 0ULL, self._stream.borrow(), (size_t)bytes);
		var pass = renderer.nativePass();
		wgpuRenderPassEncoderSetPipeline(pass, self._pipeline);
		wgpuRenderPassEncoderSetVertexBuffer(pass, 0u, self._vertices, 0ULL, bytes);
		for run in self._runs {
			if (run.count == 0 || run.clipWidth <= 0 || run.clipHeight <= 0) { continue; }
			wgpuRenderPassEncoderSetScissorRect(pass, (uint32_t)run.clipX, (uint32_t)run.clipY, (uint32_t)run.clipWidth, (uint32_t)run.clipHeight);
			wgpuRenderPassEncoderSetBindGroup(pass, 0u, run.texture.nativeGroup(), (size_t)0, null);
			wgpuRenderPassEncoderDraw(pass, (uint32_t)run.count, 1u, (uint32_t)run.first, 0u);
		}
	}

	public void close() {
		if (self._closed) { return; }
		self._closed = true;
		self._runs.clear();
		if (self._vertices != null) { wgpuBufferRelease(self._vertices); self._vertices = null; }
		if (self._uniform != null) { wgpuBufferRelease(self._uniform); self._uniform = null; }
		if (self._sampler != null) { wgpuSamplerRelease(self._sampler); self._sampler = null; }
		if (self._pipeline != null) { wgpuRenderPipelineRelease(self._pipeline); self._pipeline = null; }
		if (self._pipelineLayout != null) { wgpuPipelineLayoutRelease(self._pipelineLayout); self._pipelineLayout = null; }
		if (self._layout != null) { wgpuBindGroupLayoutRelease(self._layout); self._layout = null; }
		if (self._shader != null) { wgpuShaderModuleRelease(self._shader); self._shader = null; }
	}

	public void __del__() { self.close(); }
}

/* One pass over a window's views, back to front. Each view says where it
 * is: a native control records its frame, with the clip of the views around
 * it, for GTK to place it; a view with drawn content (a GPU view) draws it
 * through `gpu` and records a hole, the rectangle where that content shows
 * among the controls. The pass needs no GPU: without one, `gpu` is null and
 * only the controls are placed. */
class LinuxPlacer {
	private Vector<LinuxClip> _clips = [];
	private Vector<LinuxPlacement> _placements = [];
	public LinuxPainter? gpu;

	public LinuxPlacer(double width, double height, LinuxPainter? gpu) {
		self.gpu = gpu;
		self._clips.push(LinuxClip(0.0, 0.0, width, height));
	}

	public void pushClip(double x, double y, double width, double height) {
		var current = self._clips.last();
		double left = Math.maxDouble(current.x, x);
		double top = Math.maxDouble(current.y, y);
		double right = Math.minDouble(current.x + current.width, x + width);
		double bottom = Math.minDouble(current.y + current.height, y + height);
		self._clips.push(LinuxClip(left, top, Math.maxDouble(0.0, right - left), Math.maxDouble(0.0, bottom - top)));
		var gpu = self.gpu;
		if (gpu != null) { gpu.pushClip(x, y, width, height); }
	}

	public void popClip() {
		if (self._clips.len > 1) { self._clips.pop(); }
		var gpu = self.gpu;
		if (gpu != null) { gpu.popClip(); }
	}

	/* A native control is not drawn here: GTK draws it, where this says. */
	public void place(BtrcGtkControl* control, double x, double y, double width, double height) {
		var clip = self._clips.last();
		self._placements.push(LinuxPlacement(control, x, y, width, height, LinuxClip(clip.x, clip.y, clip.width, clip.height)));
	}

	/* Drawn content that must show among the native controls: what was placed
	 * before it lies under it, what is placed after lies over it. */
	public void hole(double x, double y, double width, double height) { self.place(null, x, y, width, height); }

	/* The native controls and holes of this pass, back to front. */
	public Vector<LinuxPlacement> placements() { return self._placements; }
}
