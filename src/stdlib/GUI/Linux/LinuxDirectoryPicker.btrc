import Library.App;
import Library.Strings;
import Library.GUI.IDirectoryPicker;
import Library.GUI.Linux.SDL;

/* The desktop's folder chooser through SDL's dialog API (portal or zenity).
 * The application pumps events until the dialog answers, like a modal, so a
 * picker cannot open from inside native event dispatch. */
interface ILinuxDialogPump {
	bool isDispatching();
	bool quitRequested();
	void pumpOnce(int timeoutMilliseconds);
}

class LinuxDirectoryPicker implements IDirectoryPicker {
	private SDL_Window* _parent;
	private ILinuxDialogPump _pump;

	public LinuxDirectoryPicker(SDL_Window* parent, ILinuxDialogPump pump) { self._parent = parent; self._pump = pump; }

	public DirectoryPickerOutcome chooseDirectory(DirectoryPickerRequest request) {
		if (request == null || !request.isValid()) { return DirectoryPickerOutcome.failed(AppError(APP_ERROR_INVALID_ARGUMENT, "invalid directory picker request")); }
		if (self._pump.isDispatching()) { throw "Native event dispatch is already active"; }
		if (self._pump.quitRequested()) { return DirectoryPickerOutcome.cancelled(); }
		var dialog = btrcSdlFolderDialogOpen(self._parent, request.initialDirectory, request.title);
		if (dialog == null) { return DirectoryPickerOutcome.failed(AppError(APP_ERROR_BACKEND_UNAVAILABLE, "directory picker is unavailable")); }
		DirectoryPickerOutcome outcome = DirectoryPickerOutcome.cancelled();
		try {
			int state = btrcSdlFolderDialogState(dialog);
			/* Observe completion before Quit: a result already delivered when the
			 * pump returns is terminal; accepted Quit aborts only a pending wait. */
			while (state == 0 && !self._pump.quitRequested()) {
				self._pump.pumpOnce(50);
				state = btrcSdlFolderDialogState(dialog);
			}
			if (state == 1) {
				string directory = Strings.copy((char*)btrcSdlFolderDialogPath(dialog));
				if (directory.isEmpty()) { outcome = DirectoryPickerOutcome.failed(AppError(APP_ERROR_INTERNAL, "directory picker selected an empty path")); }
				else { outcome = DirectoryPickerOutcome.selected(directory); }
			}
			else if (state != 0 && state != 2) { outcome = DirectoryPickerOutcome.failed(AppError(APP_ERROR_INTERNAL, "directory picker failed: " + Strings.copy((char*)SDL_GetError()))); }
		} finally { btrcSdlFolderDialogRelease(dialog); }
		return outcome;
	}
}
