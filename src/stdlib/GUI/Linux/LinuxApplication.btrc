/* Delayed UI-thread work: a deadline in the application's timer list. The
 * registration only records cancellation; the loop owns delivery. */
class LinuxDelayedWork implements ICallbackRegistration {
	private IApplicationWork? _work;
	private unsigned long long _deadline;
	private bool _open = true;
	public WorkSuspensionPolicy policy;
	public long long replacementKey;
	public long long round;

	public LinuxDelayedWork(IApplicationWork work, unsigned long long deadlineNanoseconds, WorkSuspensionPolicy policy, long long replacementKey, long long round) { self._work = work; self._deadline = deadlineNanoseconds; self.policy = policy; self.replacementKey = replacementKey; self.round = round; }

	public unsigned long long deadline() { return self._deadline; }

	public IApplicationWork? take() { var work = self._work; self._work = null; self._open = false; return work; }

	public bool isOpen() { return self._open; }

	public CallbackCancellation cancel() { self._open = false; self._work = null; return CALLBACK_CANCELLATION_COMPLETE; }

	public CallbackCancellation pollCompletion() { return self._open ? CALLBACK_CANCELLATION_NOT_REQUESTED : CALLBACK_CANCELLATION_COMPLETE; }
}

/* The scoped host link delegates to the same scheduler as desktop run(). */
class LinuxHostAttachment implements IApplicationHostAttachment {
	private LinuxApplication? _application;
	private bool _closing = false;
	private CallbackCancellation _result = CALLBACK_CANCELLATION_NOT_REQUESTED;
	public LinuxHostAttachment(LinuxApplication application) { self._application = application; }

	public bool isOpen() { return !self._closing && self._application != null; }

	public void serviceTurn() {
		var application = self._application;
		if (application == null) { return; }
		application.serviceHostTurn();
		if (self._closing || application.quitRequested()) { self._closing = true; self.pollCompletion(); }
	}

	public void transition(ApplicationActivity activity) { var application = self._application; if (application == null || self._closing) { throw "Application host is detached"; } application.transition(activity); }

	public CallbackCancellation cancel() { self._closing = true; var application = self._application; if (application != null) { application.requestQuit(); } return self.pollCompletion(); }

	public CallbackCancellation pollCompletion() {
		if (!self._closing) { return CALLBACK_CANCELLATION_NOT_REQUESTED; }
		var application = self._application;
		if (application == null) { return self._result; }
		self._result = application.finishHostClose();
		if (self._result == CALLBACK_CANCELLATION_COMPLETE || self._result == CALLBACK_CANCELLATION_FAILED) { self._application = null; }
		return self._result;
	}
}

/* One application owner on the UI thread. run() pumps SDL events, delivers
 * posted and delayed work, dispatches queued button actions and renders
 * every window whose content changed. Quit closes admission, drains admitted
 * work, then closes windows and detached roots before returning. */
/* Provider-only projection, so the GUI facade's IApplication slot can reach
 * the Linux services without a class downcast. */
interface ILinuxApplication extends IApplication {
	LinuxContext context();
	LinuxWindow? firstWindow();
	LinuxWindow? windowOwning(ILinuxView view);
}

class LinuxApplication implements ILinuxApplication, ILinuxDialogPump {
	private LinuxContext _context;
	private Vector<LinuxWindow> _windows = [];
	private Vector<IView> _views = [];
	private Vector<IView> _closingRoots = [];
	private Vector<LinuxDelayedWork> _delayed = [];
	private Vector<LinuxPublisher> _publishers = [];
	private int _publisherCapacity = 65536;
	private int _publisherUsed = 0;
	private int _publisherCursor = 0;
	private int _semanticCursor = 0;
	private IApplicationHost? _host = null;
	private LinuxHostAttachment? _attachment = null;
	private ApplicationActivity _activity = APPLICATION_ACTIVITY_UNKNOWN;
	private bool _turnActive = false;
	private int _rotation = 0;
	private int _timerCursor = 0;
	private int _windowCursor = 0;
	private long long _round = 0LL;
	private int _workCapacity;
	private int _pendingWork = 0;
	private bool _quitRequested = false;
	private bool _running = false;
	private bool _dispatching = false;
	private bool _closing = false;
	private bool _closed = false;
	private bool _viewsClosing = false;
	private string _workFailure = "";
	private bool _workFailed = false;
	private string _closeFailure = "";

	public LinuxApplication(int workCapacity) {
		if (workCapacity <= 0 || workCapacity > 65536) { throw "Application work capacity must be between 1 and 65536"; }
		self._workCapacity = workCapacity;
		self._context = LinuxContext(workCapacity);
	}

	public LinuxContext context() { return self._context; }

	/* SDL's main thread is the one GUI.initialize ran SDL_Init on. */
	private void requireUIThread() { if (!SDL_IsMainThread()) { throw "Native application dispatch requires the main thread"; } }

	private void requireIdle() {
		self.requireUIThread();
		if (self._dispatching) { throw "Native event dispatch is already active"; }
		if (self._closing || self._closed) { throw "Application shutdown has started"; }
	}

	private void requireCreation() {
		self.requireIdle();
		if (self._quitRequested) { throw "Application quit has been requested"; }
	}

	public bool isRunning() { self.requireUIThread(); return self._running || self._attachment != null; }

	public bool isDispatching() { return self._dispatching; }

	public bool quitRequested() { return self._quitRequested; }

	/* How long run() drains a closing subtree before reporting it stalled. */
	class double shutdownSeconds() { return 10.0; }

	public void requestQuit() {
		self.requireUIThread();
		if (self._closed || self._quitRequested) { return; }
		self._quitRequested = true;
		btrcSdlPushWake();
	}

	private void failWork(string error) {
		if (!self._workFailed) { self._workFailure = error; self._workFailed = true; }
		self.requestQuit();
	}

	private void signalTurn() {
		if (!btrcSdlPushWake()) { self.failWork("Application native wake failed"); return; }
		if (self._host != null && !self._host.requestTurn()) { self.failWork("Application host wake failed"); }
	}

	public void post(IApplicationWork work) {
		var result = self.schedule(work, 0.0, WORK_SUSPENSION_DEFER, 0LL);
		if (result.kind != SCHEDULE_ACCEPTED) { throw "Application work admission failed"; }
	}

	private void pruneDelayed() { for (int index = self._delayed.len - 1; index >= 0; index--) { if (!self._delayed.get(index).isOpen()) { self._delayed.remove(index); } } }

	public ScheduleOutcome schedule(IApplicationWork work, double delaySeconds, WorkSuspensionPolicy policy, long long replacementKey) {
		self.requireUIThread();
		if (work == null || !Math.isFinite(delaySeconds) || delaySeconds < 0.0 || replacementKey < 0LL || policy < WORK_SUSPENSION_CANCEL || policy > WORK_SUSPENSION_REPLACE || (policy == WORK_SUSPENSION_REPLACE && replacementKey == 0LL)) { throw "Invalid scheduled work"; }
		var result = ScheduleOutcome(); result.registration = null;
		if (self._closing || self._closed || self._quitRequested) { result.kind = SCHEDULE_CLOSED; return result; }
		if (self._activity == APPLICATION_ACTIVITY_SUSPENDED && policy == WORK_SUSPENSION_CANCEL) { result.kind = SCHEDULE_CANCELLED; return result; }
		self.pruneDelayed();
		LinuxDelayedWork? replaced = null;
		if (replacementKey > 0LL) {
			for (int index = self._delayed.len - 1; index >= 0; index--) {
				var previous = self._delayed.get(index);
				if (previous.replacementKey == 0LL) { break; }
				if (previous.replacementKey == replacementKey) { replaced = previous; break; }
			}
		}
		if (replaced == null && self._pendingWork + self._delayed.len >= self._workCapacity) { result.kind = SCHEDULE_FULL; return result; }
		var registration = LinuxDelayedWork(work, LinuxClock.after(delaySeconds), policy, replacementKey, self._round);
		if (replaced != null) { replaced.cancel(); self.pruneDelayed(); }
		self._delayed.push(registration); result.registration = registration;
		result.kind = replaced == null ? SCHEDULE_ACCEPTED : SCHEDULE_REPLACED;
		self.signalTurn(); self.updateHostDeadline(); return result;
	}

	public ICallbackRegistration postAfter(double delaySeconds, IApplicationWork work) {
		var result = self.schedule(work, delaySeconds, WORK_SUSPENSION_DEFER, 0LL);
		if (result.kind != SCHEDULE_ACCEPTED || result.registration == null) { throw "Application delayed work admission failed"; }
		return result.registration;
	}

	public ApplicationPublisherOutcome createPublisher(int capacity, IApplicationPublicationHandler handler, CallbackScope owner) {
		self.requireUIThread();
		if (capacity <= 0 || capacity > 65536 || handler == null || owner == null) { throw "Publisher requires bounded capacity, receiver and owner"; }
		var result = ApplicationPublisherOutcome(); result.publisher = null; result.registration = null;
		if (self._closing || self._closed || self._quitRequested) { result.kind = APPLICATION_PUBLISHER_CLOSED; return result; }
		self.prunePublishers();
		if (capacity > self._publisherCapacity - self._publisherUsed) { result.kind = APPLICATION_PUBLISHER_BUDGET_EXHAUSTED; return result; }
		var publisher = LinuxPublisher(capacity, self._host);
		if (!publisher.initialized()) { result.kind = APPLICATION_PUBLISHER_RESOURCE_FAILED; return result; }
		publisher.activate(handler, owner); publisher.suspend(self._activity == APPLICATION_ACTIVITY_SUSPENDED);
		self._publishers.push(publisher); self._publisherUsed += capacity;
		result.kind = APPLICATION_PUBLISHER_CREATED; result.publisher = publisher; result.registration = publisher; return result;
	}

	private void prunePublishers() {
		for (int index = self._publishers.len - 1; index >= 0; index--) {
			var publisher = self._publishers.get(index);
			if (publisher.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE) { self._publisherUsed -= publisher.capacity(); self._publishers.remove(index); }
		}
	}

	public ApplicationHostAttachOutcome attachHost(IApplicationHost host, CallbackScope owner) {
		self.requireUIThread();
		if (host == null || owner == null) { throw "Application host and owner are required"; }
		var result = ApplicationHostAttachOutcome(); result.attachment = null; result.error = "";
		if (self._closing || self._closed || self._quitRequested) { result.kind = APPLICATION_HOST_APPLICATION_CLOSED; return result; }
		if (self._attachment != null) { result.kind = APPLICATION_HOST_ALREADY_ATTACHED; return result; }
		if (self._running || self._turnActive) { result.kind = APPLICATION_HOST_APPLICATION_RUNNING; return result; }
		int locked = 0;
		while (locked < self._publishers.len && self._publishers.get(locked).beginHostChange()) { locked++; }
		if (locked != self._publishers.len) {
			for (int index = 0; index < locked; index++) { self._publishers.get(index).endHostChange(); }
			result.kind = APPLICATION_HOST_ATTACH_FAILED; result.error = "Publisher wake transition is busy"; return result;
		}
		var attachment = LinuxHostAttachment(self);
		try { owner.track(attachment); }
		catch (string error) {
			for (int index = 0; index < locked; index++) { self._publishers.get(index).endHostChange(); }
			result.kind = APPLICATION_HOST_ATTACH_FAILED; result.error = error; return result;
		}
		self._host = host; self._context.semanticWake.host = host; self._attachment = attachment;
		for publisher in self._publishers { publisher.setHostLocked(host); publisher.endHostChange(); }
		result.kind = APPLICATION_HOST_ATTACHED; result.attachment = attachment;
		self.updateHostDeadline(); self.signalTurn(); return result;
	}

	public void transition(ApplicationActivity activity) {
		self.requireUIThread();
		if (activity < APPLICATION_ACTIVITY_ACTIVE || activity > APPLICATION_ACTIVITY_UNKNOWN) { throw "Invalid application activity"; }
		self._activity = activity;
		bool suspended = activity == APPLICATION_ACTIVITY_SUSPENDED;
		if (suspended) { for delayed in self._delayed { if (delayed.policy == WORK_SUSPENSION_CANCEL) { delayed.cancel(); } } self.pruneDelayed(); }
		for publisher in self._publishers { publisher.suspend(suspended); }
		for window in self._windows { window.applicationActivity(activity); }
		self.signalTurn(); self.updateHostDeadline();
	}

	public void serviceHostTurn() {
		self.requireUIThread();
		if (self._closed || self._turnActive) { return; }
		try { self.pumpOnce(0); } catch (string error) { self.failWork(error); }
		self.updateHostDeadline();
	}

	public CallbackCancellation finishHostClose() {
		self.requireUIThread();
		if (self._turnActive) { return CALLBACK_CANCELLATION_PENDING; }
		var result = self.close();
		if (result == CALLBACK_CANCELLATION_COMPLETE) { self._attachment = null; self._host = null; return self._workFailed ? CALLBACK_CANCELLATION_FAILED : result; }
		return result;
	}

	/* Windows and roots created here stay owned until they close. */
	public IWindow createWindow(string title, double width, double height) {
		self.requireCreation();
		var window = LinuxWindow(self._context, title, width, height);
		window.applicationActivity(self._activity);
		self._windows.push(window);
		return window;
	}

	private void rememberView(IView view) {
		for (int index = self._views.len - 1; index >= 0; index--) {
			var previous = self._views.get(index);
			if (!previous.isOpen() && previous.pollClose() == CALLBACK_CANCELLATION_COMPLETE) { self._views.remove(index); }
		}
		self._views.push(view);
	}

	public IButton createButton(string title) { self.requireCreation(); var view = LinuxButton(self._context, title); self.rememberView(view); return view; }

	public ITextField createTextField(string text, string placeholder) { self.requireCreation(); var view = LinuxTextField(self._context, text, placeholder); self.rememberView(view); return view; }

	public IContainer createContainer() { self.requireCreation(); var view = LinuxContainer(self._context); self.rememberView(view); return view; }

	public IStack createRow(double spacing) { self.requireCreation(); var view = LinuxStack(self._context, false, spacing); self.rememberView(view); return view; }

	public IStack createColumn(double spacing) { self.requireCreation(); var view = LinuxStack(self._context, true, spacing); self.rememberView(view); return view; }

	public IGPUView createGPUView(bool capture) { self.requireCreation(); var view = LinuxGPUView(self._context, capture); self.rememberView(view); return view; }

	public ILabel createLabel(string text) { self.requireCreation(); var view = LinuxLabel(self._context, text); self.rememberView(view); return view; }

	public IImageView createImageView() { self.requireCreation(); var view = LinuxImageView(self._context); self.rememberView(view); return view; }

	public IPanel createPanel(RGBA fill, double radius) { self.requireCreation(); var view = LinuxPanel(self._context, fill, radius); self.rememberView(view); return view; }

	public IProgressIndicator createProgressIndicator() { self.requireCreation(); var view = LinuxProgressIndicator(self._context); self.rememberView(view); return view; }

	public ILevelIndicator createLevelIndicator(double warning, double critical) { self.requireCreation(); var view = LinuxLevelIndicator(self._context, warning, critical); self.rememberView(view); return view; }

	public ISlider createSlider(double minimum, double maximum, int intervals) { self.requireCreation(); var view = LinuxSlider(self._context, minimum, maximum, intervals); self.rememberView(view); return view; }

	public ISelect createSelect() { self.requireCreation(); var view = LinuxSelect(self._context); self.rememberView(view); return view; }

	public IScrollView createScrollView() { self.requireCreation(); var view = LinuxScrollView(self._context); self.rememberView(view); return view; }

	public IGrid createGrid(int columns, int rows, double columnSpacing, double rowSpacing) { self.requireCreation(); var view = LinuxGrid(self._context, columns, rows, columnSpacing, rowSpacing); self.rememberView(view); return view; }

	public LinuxWindow? firstWindow() { for window in self._windows { if (window.isOpen()) { return window; } } return null; }

	public LinuxWindow? windowOwning(ILinuxView view) {
		int id = view.node().id;
		for window in self._windows { if (window.isOpen() && window.owns(id)) { return window; } }
		return null;
	}

	private LinuxWindow? windowFor(unsigned int id) { for window in self._windows { if (window.isOpen() && window.nativeId() == id) { return window; } } return null; }

	/* Leave input beyond this turn's budget queued while work and frames progress. */
	private void pumpEvents(int timeoutMilliseconds) {
		BtrcSdlEvent event;
		bool received = (timeoutMilliseconds != 0 ? btrcSdlWaitEvent(&event, timeoutMilliseconds) : btrcSdlPollEvent(&event)) != 0;
		int dispatched = 0;
		unsigned long long deadline = SDL_GetTicksNS() + 2000000ULL;
		while (received && dispatched < 4096) {
			dispatched++;
			if (event.type == (unsigned int)SDL_EVENT_QUIT) { for window in self._windows { if (window.isOpen()) { window.requestNativeClose(); } } }
			else if (event.window != 0u) {
				var target = self.windowFor(event.window);
				if (target != null) { target.dispatch(&event); }
			}
			if (dispatched == 4096 || SDL_GetTicksNS() >= deadline) { self.signalTurn(); break; }
			received = btrcSdlPollEvent(&event) != 0;
		}
		for window in self._windows { if (window.isOpen()) { window.settle(); } }
	}

	private void runDelayed() {
		if (self._activity == APPLICATION_ACTIVITY_SUSPENDED) { return; }
		unsigned long long deadline = SDL_GetTicksNS() + 2000000ULL;
		int available = self._delayed.len; int examined = 0; int delivered = 0;
		while (!self._delayed.isEmpty() && examined < available && examined < 256 && delivered < 64 && SDL_GetTicksNS() < deadline) {
			if (self._timerCursor >= self._delayed.len) { self._timerCursor = 0; }
			var delayed = self._delayed.get(self._timerCursor); examined++;
			if (!delayed.isOpen()) { self._delayed.remove(self._timerCursor); continue; }
			if (delayed.round >= self._round || delayed.deadline() > SDL_GetTicksNS()) { self._timerCursor++; continue; }
			self._delayed.remove(self._timerCursor);
			var work = delayed.take(); delivered++;
			if (work == null || self._quitRequested) { continue; }
			self._pendingWork++;
			try { work.run(); } catch (string error) { self.failWork(error); }
			finally { self._pendingWork--; }
		}
	}

	private void dispatchSemantic() {
		unsigned long long deadline = SDL_GetTicksNS() + 2000000ULL;
		int empty = 0;
		for (int delivered = 0; delivered < 64 && !self._quitRequested && SDL_GetTicksNS() < deadline; delivered++) {
			int count = self._windows.len + 1;
			if (self._semanticCursor >= count) { self._semanticCursor = 0; }
			int source = self._semanticCursor++;
			bool progress;
			if (source == 0) { progress = self._context.detachedEvents.dispatchOne(); }
			else { progress = self._windows.get(source - 1).dispatchSemantic(); }
			if (progress) { empty = 0; } else { empty++; if (empty >= count) { break; } }
		}
	}

	private void dispatchActions() {
		unsigned long long deadline = SDL_GetTicksNS() + 2000000ULL;
		int count = self._context.actions.pendingCount();
		for (int index = 0; index < count && index < 64 && !self._quitRequested && SDL_GetTicksNS() < deadline; index++) { self._context.actions.dispatchOne(); }
	}

	private void runPublishers() {
		int count = self._publishers.len;
		unsigned long long deadline = SDL_GetTicksNS() + 2000000ULL;
		for (int index = 0; index < count && index < 64 && !self._quitRequested && SDL_GetTicksNS() < deadline; index++) {
			if (self._publisherCursor >= self._publishers.len) { self._publisherCursor = 0; }
			var publisher = self._publishers.get(self._publisherCursor++);
			try { publisher.deliverOne(); } catch (string error) { self.failWork(error); }
		}
		self.prunePublishers();
	}

	private unsigned long long nextDeadline() {
		unsigned long long deadline = 0ULL;
		if (self._activity != APPLICATION_ACTIVITY_SUSPENDED) { for delayed in self._delayed { if (delayed.isOpen() && (deadline == 0ULL || delayed.deadline() < deadline)) { deadline = delayed.deadline(); } } }
		for window in self._windows {
			if (!window.isOpen()) { continue; }
			unsigned long long wake = window.wakeAt();
			if (wake != 0ULL && (deadline == 0ULL || wake < deadline)) { deadline = wake; }
		}
		return deadline;
	}

	private bool runnable() {
		if (self._quitRequested || self._context.actions.pendingCount() > 0 || self._context.detachedEvents.pendingCount() > 0) { return true; }
		for publisher in self._publishers { if (publisher.pending()) { return true; } }
		for window in self._windows { if (window.semanticPending() > 0 || (window.isOpen() && window.needsFrame())) { return true; } }
		return false;
	}

	private int waitMilliseconds() {
		if (self.runnable()) { return 0; }
		unsigned long long now = SDL_GetTicksNS();
		unsigned long long deadline = self.nextDeadline();
		if (deadline == 0ULL) { return -1; }
		if (deadline <= now) { return 0; }
		unsigned long long milliseconds = (deadline - now) / 1000000ULL + 1ULL;
		return milliseconds > 2147483647ULL ? 2147483647 : (int)milliseconds;
	}

	private void updateHostDeadline() {
		if (self._host == null) { return; }
		self._host.scheduleTurn(self.nextDeadline());
		if (self.runnable() && !self._host.requestTurn()) { self.failWork("Application host wake failed"); }
	}

	private void renderWindows() {
		unsigned long long deadline = SDL_GetTicksNS() + 2000000ULL;
		int count = self._windows.len;
		for (int index = 0; index < count && index < 8 && SDL_GetTicksNS() < deadline; index++) {
			if (self._windowCursor >= self._windows.len) { self._windowCursor = 0; }
			var window = self._windows.get(self._windowCursor++);
			if (!window.isOpen()) { continue; }
			if (window.closeRequested()) { window.serviceNativeClose(); if (!window.isOpen()) { continue; } }
			if (!window.pollDevice()) { continue; }
			if (window.needsFrame()) { window.render(false); }
		}
		for (int index = self._windows.len - 1; index >= 0; index--) {
			var window = self._windows.get(index);
			if (!window.isOpen() && window.pollClose() == CALLBACK_CANCELLATION_COMPLETE) { self._windows.remove(index); }
		}
	}

	/* One loop turn: wait for events or the next deadline, then service everything. */
	public void pumpOnce(int timeoutMilliseconds) {
		self.requireUIThread();
		if (self._turnActive || self._context.mutationDepth > 0) { throw "Native event dispatch is already active"; }
		if (self._closed) { return; }
		if (self._round == 9223372036854775807LL) { throw "Application scheduling rounds exhausted"; }
		int readyTimeout = self.waitMilliseconds();
		if (readyTimeout == 0 || (readyTimeout > 0 && (timeoutMilliseconds < 0 || readyTimeout < timeoutMilliseconds))) { timeoutMilliseconds = readyTimeout; }
		self._round++; self._turnActive = true;
		try {
			/* Only the initial input phase may wait. Other classes rotate; each
			 * gets its own count/time slice and cleanup always gets a turn. */
			self._dispatching = true;
			try { self.pumpEvents(timeoutMilliseconds); } finally { self._dispatching = false; }
			for (int offset = 0; offset < 5; offset++) {
				int phase = (self._rotation + offset) % 5;
				if (phase == 0) { self.runDelayed(); }
				else if (phase == 1) { self.runPublishers(); }
				else if (phase == 2) { self.dispatchActions(); }
				else if (phase == 3) { self.dispatchSemantic(); }
				else { self.renderWindows(); }
			}
			self._rotation = (self._rotation + 1) % 5;
		} finally { self._turnActive = false; }
		self.updateHostDeadline();
	}

	public void run() {
		self.requireUIThread();
		if (self._running || self._dispatching || self._attachment != null) { throw "Native application loop is already active or host-attached"; }
		if (self._closed) { throw "Application shutdown has completed"; }
		self._running = true;
		try {
			while (true) {
				if (self._quitRequested && self._pendingWork == 0) { break; }
				self.pumpOnce(self.waitMilliseconds());
			}
		} catch (string error) { self._running = false; self.close(); throw error; }
		self._running = false;
		self.requestQuit();
		/* A subtree that never drains (a GPU device that never reaches CLOSED)
		 * fails the run after one deadline; its pending owners stay retained. */
		var result = self.close();
		unsigned long long deadline = LinuxClock.after(LinuxApplication.shutdownSeconds());
		while (result == CALLBACK_CANCELLATION_PENDING) {
			if (SDL_GetTicksNS() >= deadline) { throw "Native subtree shutdown did not complete"; }
			self.pumpOnce(10);
			result = self.pollClose();
		}
		if (result != CALLBACK_CANCELLATION_COMPLETE) { throw "Native subtree shutdown failed without completion"; }
		if (self._workFailed) { throw self._workFailure; }
	}

	private CallbackCancellation combine(CallbackCancellation result, CallbackCancellation state) {
		if (result == CALLBACK_CANCELLATION_FAILED || state == CALLBACK_CANCELLATION_FAILED) { return CALLBACK_CANCELLATION_FAILED; }
		if (result == CALLBACK_CANCELLATION_RETRYABLE_FAILURE || state == CALLBACK_CANCELLATION_RETRYABLE_FAILURE) { return CALLBACK_CANCELLATION_RETRYABLE_FAILURE; }
		return result == CALLBACK_CANCELLATION_COMPLETE && state == CALLBACK_CANCELLATION_COMPLETE ? CALLBACK_CANCELLATION_COMPLETE : CALLBACK_CANCELLATION_PENDING;
	}

	private CallbackCancellation closeViews() {
		CallbackCancellation result = CALLBACK_CANCELLATION_COMPLETE;
		for (int index = self._windows.len - 1; index >= 0; index--) {
			var window = self._windows.get(index);
			var state = window.isOpen() ? window.close() : window.pollClose();
			if (state == CALLBACK_CANCELLATION_COMPLETE) { self._windows.remove(index); }
			else { result = self.combine(result, state); }
		}
		if (!self._viewsClosing) {
			self._viewsClosing = true;
			for view in self._views {
				if (!view.isOpen()) { if (view.pollClose() != CALLBACK_CANCELLATION_COMPLETE) { self._closingRoots.push(view); } continue; }
				var native = (ILinuxView?)view;
				if (native == null) { throw "GUI view belongs to another provider"; }
				if (!native.node().attached) { self._closingRoots.push(view); }
			}
		}
		for (int index = self._closingRoots.len - 1; index >= 0; index--) {
			var view = self._closingRoots.get(index);
			var state = view.isOpen() ? view.close() : view.pollClose();
			if (state == CALLBACK_CANCELLATION_COMPLETE) { self._closingRoots.remove(index); }
			else { result = self.combine(result, state); }
		}
		if (result == CALLBACK_CANCELLATION_COMPLETE) {
			for view in self._views { if (view.isOpen()) { throw "GUI view remains attached outside application ownership"; } }
			self._views.clear();
		}
		return result;
	}

	public CallbackCancellation pollClose() { return self._closed ? CALLBACK_CANCELLATION_COMPLETE : (self._closing ? self.close() : CALLBACK_CANCELLATION_NOT_REQUESTED); }

	public CallbackCancellation close() {
		if (self._closed) { return CALLBACK_CANCELLATION_COMPLETE; }
		self.requireUIThread();
		if (self._closeFailure != "") { throw self._closeFailure; }
		if (self._dispatching) { throw "Native event dispatch is already active"; }
		if (self._running) { throw "Request application quit before closing a running application"; }
		if (self._turnActive) { return CALLBACK_CANCELLATION_PENDING; }
		self._quitRequested = true;
		self._closing = true;
		CallbackCancellation publishers = CALLBACK_CANCELLATION_COMPLETE;
		for publisher in self._publishers { publishers = self.combine(publishers, publisher.cancel()); }
		if (publishers != CALLBACK_CANCELLATION_COMPLETE) { return publishers; }
		self.prunePublishers();
		var views = self.closeViews();
		if (views != CALLBACK_CANCELLATION_COMPLETE) { return views; }
		try {
			self._pendingWork = 0;
			for delayed in self._delayed { delayed.cancel(); }
			self._delayed.clear();
			self._context.actions.close(); self._context.detachedEvents.close(); self._context.semanticWake.host = null;
		} catch (string error) { self._closeFailure = error; throw error; }
		self._closed = true;
		return CALLBACK_CANCELLATION_COMPLETE;
	}

	public void __del__() { if (self.close() != CALLBACK_CANCELLATION_COMPLETE) { Console.fatal("Native application destroyed before subtree cleanup completed"); } }
}
