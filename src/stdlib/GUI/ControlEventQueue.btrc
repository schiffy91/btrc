/* Private UI-executor semantic transport shared by the desktop providers.
 * Public UI2 values remain in ControlEvents; this owner never captures native
 * input, starts a loop, or transfers managed snapshots across threads. */
import Library.Callback;
import Library.Vector;
import Library.Console;

enum ControlEventDisposition {
	CONTROL_EVENT_DELIVERED,
	CONTROL_EVENT_CANCELLED,
	CONTROL_EVENT_STALE_GENERATION,
	CONTROL_EVENT_SUPERSEDED,
	CONTROL_EVENT_CLOSED,
	CONTROL_EVENT_FAILED,
	CONTROL_EVENT_INELIGIBLE
};

interface IControlEventTarget { ControlEventDisposition admission(long long generation); }
interface IControlEventWake { bool requestTurn(); }

/* Reserved COMMIT/CANCEL storage is separate from ordinary records and from
 * the provider's always-serviceable close/cancellation/cleanup control lane. */
class ControlEventTerminalPool {
	private int _capacity;
	private int _used = 0;
	private long long _nextRegistration = 1LL;
	public ControlEventTerminalPool(int capacity) { if (capacity <= 0 || capacity > 65536) { throw "Invalid control terminal capacity"; } self._capacity = capacity; }

	/* UI-only semantic callbacks have no independent native registration.
	 * CallbackContext seals its entry gate before this barrier is queried. */
	class bool unregister(ControlEventTerminalPool pool) { return true; }

	public int available() { return self._capacity - self._used; }

	public long long registrationIdentity() { if (self._nextRegistration == 9223372036854775807LL) { throw "Control registration identities exhausted"; } return self._nextRegistration++; }

	public bool reserve() { if (self._used == self._capacity) { return false; } self._used++; return true; }

	public void retire() { if (self._used <= 0) { throw "Control terminal reservation underflow"; } self._used--; }
}

/* A unique interaction ticket cannot be reused after retirement. The channel
 * holds its base credit until registration drain; overlapping interactions
 * take extra pool credits and return them as their own terminal retires. */
class ControlEventTicket {
	private ControlEventTerminalPool _pool;
	private long long _registration;
	private bool _extra;
	private bool _open = true;
	private bool _queued = false;
	private ControlEventCaptureLease? _continuation;
	private ControlEventCaptureBarrier? _capture = null;
	public ControlEventTicket(ControlEventTerminalPool pool, long long registration, bool extra, ControlEventCaptureLease? continuation = null) { self._pool = pool; self._registration = registration; self._extra = extra; self._continuation = continuation; }

	public bool isOpen() { return self._open; }

	public bool queued() { return self._queued; }

	public void validate(long long registration) { if (!self._open || self._queued || self._registration != registration) { throw "Control terminal ticket is stale or belongs to another registration"; } }

	public void commit() { if (!self._open || self._queued) { throw "Control terminal ticket is already consumed"; } self._queued = true; self._capture = null; self._continuation = null; }

	public ControlEventCaptureBarrier? prepareCapture() { if (!self._open || self._queued || self._capture != null) { throw "Control terminal capture is already consumed"; } if (self._continuation != null) { self._capture = self._continuation.commit(); } return self._capture; }

	public void requireOwner(ControlEventTerminalPool pool, long long registration) { if (self._pool != pool || self._registration != registration) { throw "Control terminal ticket belongs to another registration"; } }

	/* A producer may abandon only an uncommitted ticket. Once queued, its
	 * credit belongs to the record through callback return and retirement. */
	public void retire() { if (self._queued && self._open) { throw "Queued terminal credit belongs to its record"; } self.complete(); }

	public void complete() { if (!self._open) { return; } self._open = false; if (!self._queued) { if (self._capture != null) { self._capture.retired(); self._capture = null; } else if (self._continuation != null) { self._continuation.cancel(); } self._continuation = null; } if (self._extra) { self._pool.retire(); } }
}

/* admitted must leave accounting unchanged when it throws. A successful
 * admission is balanced exactly once, even if later validation rejects it. */
interface IControlEventInvocation {
	void admitted();
	ControlEventDisposition invoke();
	void retired();
}

/* Optional capture ownership is independent of ordinary/held scheduling.
 * Entry transfers an owning snapshot to the queue's single entered slot;
 * retirement always follows callback return, including exceptional return. */
interface IControlEventStorage { void requireOwner(ControlEventCaptureOwner owner, long long registration); void validateAdmission(bool terminal, long long key); void claim(); bool ownsEpoch(ControlEventCaptureOwner owner, ControlEventCaptureSlot slot); bool replaces(IControlEventStorage previous); void entered(); void retired(); }

class ControlEventCaptureSlot {
	public bool occupied = false;
	public bool released = false;
	public long long registration;
	public ControlEventCaptureSlot(long long registration) { self.registration = registration; }
}

class ControlEventCaptureRegistrationState {
	public long long identity;
	public bool open = true;
	public ControlEventCaptureSlot? current = null;
	public long long base = 0LL;
	public ControlEventCaptureRegistrationState(long long identity) { self.identity = identity; }
}

class ControlEventCaptureParticipant {
	public long long registration;
	public ControlEventCaptureSlot slot;
	public bool removed = false;
	public ControlEventCaptureParticipant(long long registration, ControlEventCaptureSlot slot) { self.registration = registration; self.slot = slot; }
}

class ControlEventCaptureLeaseState {
	public long long identity;
	public long long registration;
	public long long serial = 0LL;
	public bool reusable;
	public bool acquired = false;
	public bool consumed = false;
	public bool finished = false;
	public bool local;
	public Vector<ControlEventCaptureParticipant> participants = [];
	public ControlEventCaptureSlot? ordered = null;
	public ControlEventCaptureLeaseState(long long identity, long long registration, bool reusable, bool local) { self.identity = identity; self.registration = registration; self.reusable = reusable; self.local = local; }
}

/* Handles never own receivers. The owner retains only registration/lease
 * state, not these handles, so outstanding receipts do not create a cycle. */
class ControlEventCaptureRegistration {
	private ControlEventCaptureOwner _owner;
	private long long _identity;
	public ControlEventCaptureRegistration(ControlEventCaptureOwner owner, long long identity) { self._owner = owner; self._identity = identity; }

	public void __del__() { self.cancel(); }

	public long long identity() { return self._identity; }

	public void requireOwner(ControlEventCaptureOwner owner) { if (owner != self._owner) { throw "Capture registration belongs to another owner"; } }

	public void cancel() { self._owner.cancelRegistration(self); }
}

class ControlEventCaptureReceipt implements IControlEventStorage {
	private ControlEventCaptureOwner _owner;
	private ControlEventCaptureSlot? _slot;
	private bool _entered = false;
	private bool _retired = false;
	private bool _owns;
	private bool _admitted = false;
	public ControlEventCaptureReceipt(ControlEventCaptureOwner owner, ControlEventCaptureSlot slot, bool owns) { self._owner = owner; self._slot = slot; self._owns = owns; }

	public void __del__() { if (!self._admitted && !self._retired) { self.retired(); } }

	public void requireOwner(ControlEventCaptureOwner owner, long long registration) { if (self._owner != owner || self._slot == null || self._slot.registration != registration) { throw "Capture receipt belongs to another queue or registration"; } }

	public void validateAdmission(bool terminal, long long key) { if (self._retired || self._admitted || !self._owns || self._slot == null || terminal || key <= 0LL) { throw "Capture append requires a new replaceable epoch slot"; } self._owner.validateRecord(self._slot); }

	public void claim() { self._admitted = true; }

	public bool ownsEpoch(ControlEventCaptureOwner owner, ControlEventCaptureSlot slot) { return !self._retired && self._owns && self._owner == owner && self._slot == slot; }

	public bool replaces(IControlEventStorage previous) { var slot = self._slot; if (self._retired || self._owns || slot == null) { return false; } self._owner.validateRecord(slot); return previous.ownsEpoch(self._owner, slot); }

	public void entered() {
		var slot = self._slot;
		if (self._retired || !self._admitted || !self._owns || slot == null || self._entered) { throw "Capture receipt cannot enter twice"; }
		self._owner.enter(); self._entered = true;
		self._slot = null; self._owner.releaseRecord(slot);
	}

	public void retired() {
		if (self._retired) { throw "Capture receipt retired twice"; }
		self._retired = true;
		if (self._entered) { self._owner.leave(); self._entered = false; }
		var slot = self._slot; self._slot = null; if (slot != null && self._owns) { self._owner.releaseRecord(slot); }
	}
}

class ControlEventCaptureBarrier implements IControlEventStorage {
	private ControlEventCaptureOwner _owner;
	private long long _identity;
	private long long _serial;
	private bool _retired = false;
	private bool _admitted = false;
	private bool _ordinary;
	private bool _local;
	public ControlEventCaptureBarrier(ControlEventCaptureOwner owner, long long identity, long long serial, bool ordinary, bool local) { self._owner = owner; self._identity = identity; self._serial = serial; self._ordinary = ordinary; self._local = local; }

	public void __del__() { if (!self._admitted && !self._retired) { self.retired(); } }

	public void requireOwner(ControlEventCaptureOwner owner, long long registration) { if (self._owner != owner) { throw "Capture barrier belongs to another queue"; } self._owner.requireBarrierOwner(self._identity, self._serial, registration); }

	public void validateAdmission(bool terminal, long long key) { if (self._retired || self._admitted || self._local || terminal == self._ordinary || key != 0LL) { throw "Capture barrier does not reserve this record kind"; } self._owner.validateBarrier(self._identity, self._serial); }

	public void claim() { self._admitted = true; }

	public bool ownsEpoch(ControlEventCaptureOwner owner, ControlEventCaptureSlot slot) { return false; }

	public bool replaces(IControlEventStorage previous) { return false; }

	public void entered() {}

	public void retired() { if (self._retired) { throw "Capture barrier retired twice"; } self._retired = true; self._owner.finishLease(self._identity, self._serial); }
}

class ControlEventCaptureLease {
	private ControlEventCaptureOwner _owner;
	private long long _identity;
	private long long _serial;
	private bool _consumed = false;
	private bool _cancelled = false;
	public ControlEventCaptureLease(ControlEventCaptureOwner owner, long long identity, long long serial) { self._owner = owner; self._identity = identity; self._serial = serial; }

	public void __del__() { if (!self._consumed && !self._cancelled) { self.cancel(); } }

	public ControlEventCaptureBarrier commit() {
		if (self._consumed || self._cancelled) { throw "Capture lease is already consumed or cancelled"; }
		var receipt = self._owner.commitLease(self._identity, self._serial); self._consumed = true; return receipt;
	}

	public void cancel() { if (self._consumed) { throw "Consumed capture lease belongs to its record"; } if (!self._cancelled) { self._owner.abandonLease(self._identity, self._serial); self._cancelled = true; } }
}

/* Opt-in credit atom. Providers must reserve before exposing registrations,
 * changing keys or starting native operations. This owner does not enable a
 * provider, choose its capacity, admit native input or retain snapshots.
 *
 * used = charged current slots + lease participant slots + ordered slots.
 * Local leases account for K; ordered slots account for U. All unused promises
 * remain charged. Closing registrations retain occupied credits until drain.
 * An entered snapshot uses one separate slot, never another queue invocation. */
class ControlEventCaptureOwner {
	private int _capacity;
	private int _used = 0;
	private bool _sealed = false;
	private bool _entered = false;
	private long long _next = 1LL;
	private ControlEventTerminalPool _pool;
	private bool _bound = false;
	private Vector<ControlEventCaptureRegistrationState> _registrations = [];
	private Vector<ControlEventCaptureLeaseState> _leases = [];
	public ControlEventCaptureOwner(int capacity, ControlEventTerminalPool pool) { if (capacity < 0 || capacity > 65536 || pool == null) { throw "Invalid capture credit capacity"; } self._capacity = capacity; self._pool = pool; }

	public void bind(ControlEventTerminalPool pool) { if (pool != self._pool || self._bound || self._sealed) { throw "Capture owner requires one queue with its registration pool"; } self._bound = true; }

	public void validateRecord(ControlEventCaptureSlot slot) { var registration = self.findRegistration(slot.registration); if (self._sealed || slot.released || !slot.occupied || registration == null || !registration.open) { throw "Capture registration is closed"; } }

	public void requireBarrierOwner(long long identity, long long serial, long long registration) { var lease = self.requireLease(identity, serial); if (lease.registration != registration) { throw "Capture barrier belongs to another registration"; } }

	public void validateBarrier(long long identity, long long serial) { var lease = self.requireLease(identity, serial); var registration = self.findRegistration(lease.registration); if (self._sealed || !lease.consumed || lease.finished || registration == null || !registration.open) { throw "Capture barrier registration is closed"; } }

	public int used() { return self._used; }

	public int available() { return self._capacity - self._used; }

	public bool canReserveKeyChange() { return !self._sealed && self.available() > 0 && self._leases.len < self._capacity; }

	public bool entered() { return self._entered; }

	private void requireIdentities(int count) { if (count > 9223372036854775807LL - self._next) { throw "Capture identities exhausted"; } }

	private long long identity() { if (self._next == 9223372036854775807LL) { throw "Capture identities exhausted"; } return self._next++; }

	private ControlEventCaptureSlot allocate(long long registration) { if (self._used == self._capacity) { throw "Capture credit allocation exceeded reservation"; } self._used++; return ControlEventCaptureSlot(registration); }

	private void releaseSlot(ControlEventCaptureSlot slot) { if (slot.occupied || slot.released || self._used <= 0) { throw "Capture credit is not releasable"; } slot.released = true; self._used--; }

	private ControlEventCaptureRegistrationState? findRegistration(long long identity) { for registration in self._registrations { if (registration.identity == identity) { return registration; } } return null; }

	private ControlEventCaptureRegistrationState requireRegistration(ControlEventCaptureRegistration handle) {
		handle.requireOwner(self); var registration = self.findRegistration(handle.identity());
		if (self._sealed || registration == null || !registration.open) { throw "Capture registration is closed"; } return registration;
	}

	private ControlEventCaptureLeaseState? findLease(long long identity) { for lease in self._leases { if (lease.identity == identity) { return lease; } } return null; }

	private ControlEventCaptureLeaseState requireLease(long long identity, long long serial) {
		var lease = self.findLease(identity);
		if (lease == null || !lease.acquired || lease.serial != serial) { throw "Capture lease is stale"; } return lease;
	}

	private int participantCount() { int count = 0; for registration in self._registrations { if (registration.open && registration.current != null) { count++; } } return count; }

	private bool acceptsParticipant(ControlEventCaptureLeaseState lease) { return !lease.local && (lease.reusable || !lease.consumed); }

	private void addParticipants(ControlEventCaptureLeaseState lease) {
		for registration in self._registrations { if (registration.open && registration.current != null) { lease.participants.push(ControlEventCaptureParticipant(registration.identity, self.allocate(registration.identity))); } }
	}

	public ControlEventCaptureRegistration? reserveRegistration(bool captures, bool firstBarrier) {
		if (self._sealed || self._registrations.len == self._capacity || (firstBarrier && self._leases.len == self._capacity)) { return null; }
		int cost = captures ? 1 : 0;
		if (captures) { for lease in self._leases { if (self.acceptsParticipant(lease)) { cost++; } } }
		if (firstBarrier) { cost += self.participantCount() + (captures ? 1 : 0); }
		if (cost > self.available()) { return null; }
		self.requireIdentities(firstBarrier ? 1 : 0);
		var registration = ControlEventCaptureRegistrationState(self._pool.registrationIdentity());
		if (captures) {
			registration.current = self.allocate(registration.identity);
			for lease in self._leases { if (self.acceptsParticipant(lease)) { lease.participants.push(ControlEventCaptureParticipant(registration.identity, self.allocate(registration.identity))); } }
		}
		self._registrations.push(registration);
		if (firstBarrier) { var base = ControlEventCaptureLeaseState(self.identity(), registration.identity, true, false); self.addParticipants(base); self._leases.push(base); registration.base = base.identity; }
		return ControlEventCaptureRegistration(self, registration.identity);
	}

	private ControlEventCaptureLease acquire(ControlEventCaptureLeaseState lease) {
		if (lease.acquired || lease.serial == 9223372036854775807LL) { throw "Capture lease cannot be acquired"; }
		lease.acquired = true; lease.serial++; return ControlEventCaptureLease(self, lease.identity, lease.serial);
	}

	private ControlEventCaptureLease? reserve(ControlEventCaptureRegistration handle, bool ordered, bool local) {
		if (self._sealed) { return null; }
		var registration = self.requireRegistration(handle);
		if (local && registration.current == null) { throw "Key transition requires a capture registration"; }
		if (!ordered && !local && registration.base != 0LL) { var base = self.findLease(registration.base); if (base != null && !base.acquired) { return self.acquire(base); } }
		if (self._leases.len == self._capacity) { return null; }
		int cost = local ? 1 : self.participantCount() + (ordered ? 1 : 0);
		if (cost > self.available()) { return null; }
		self.requireIdentities(1);
		var lease = ControlEventCaptureLeaseState(self.identity(), registration.identity, false, local);
		if (local) { lease.participants.push(ControlEventCaptureParticipant(registration.identity, self.allocate(registration.identity))); }
		else { self.addParticipants(lease); }
		if (ordered) { lease.ordered = self.allocate(registration.identity); }
		self._leases.push(lease); return self.acquire(lease);
	}

	public ControlEventCaptureLease? reserveBarrier(ControlEventCaptureRegistration registration) { return self.reserve(registration, false, false); }

	public ControlEventCaptureLease? reserveOrdered(ControlEventCaptureRegistration registration) { return self.reserve(registration, true, false); }

	public ControlEventCaptureLease? reserveKeyChange(ControlEventCaptureRegistration registration) { return self.reserve(registration, false, true); }

	public ControlEventCaptureReceipt capture(ControlEventCaptureRegistration handle) {
		var registration = self.requireRegistration(handle); var slot = registration.current;
		if (slot == null) { throw "Registration has no capture slot"; }
		bool owns = !slot.occupied; slot.occupied = true; return ControlEventCaptureReceipt(self, slot, owns);
	}

	public ControlEventCaptureBarrier commitLease(long long identity, long long serial) {
		var lease = self.requireLease(identity, serial);
		if (self._sealed || lease.consumed || lease.finished) { throw "Capture lease cannot be committed"; }
		for participant in lease.participants {
			var registration = self.findRegistration(participant.registration);
			if (participant.removed || registration == null || !registration.open || registration.current == null || participant.slot.occupied) { throw "Capture lease has an invalid participant"; }
		}
		for participant in lease.participants {
			var registration = self.findRegistration(participant.registration);
			if (registration == null) { throw "Capture lease has an invalid participant"; }
			var previous = registration.current;
			if (previous == null) { throw "Capture lease has an invalid participant"; }
			registration.current = participant.slot; participant.slot = previous;
		}
		lease.consumed = true; var ordered = lease.ordered; if (ordered != null) { ordered.occupied = true; }
		return ControlEventCaptureBarrier(self, identity, serial, ordered != null, lease.local);
	}

	private void collect() {
		for (int index = self._leases.len - 1; index >= 0; index--) {
			var lease = self._leases.get(index); bool recovered = true;
			for (int position = lease.participants.len - 1; position >= 0; position--) {
				var participant = lease.participants.get(position);
				if (participant.removed && !participant.slot.occupied) { self.releaseSlot(participant.slot); lease.participants.remove(position); }
				else if (participant.slot.occupied) { recovered = false; }
			}
			if (!lease.finished || !recovered) { continue; }
			var ordered = lease.ordered; if (ordered != null) { if (ordered.occupied) { continue; } self.releaseSlot(ordered); lease.ordered = null; }
			if (lease.reusable) { lease.acquired = false; lease.consumed = false; lease.finished = false; }
			else { for participant in lease.participants { self.releaseSlot(participant.slot); } lease.participants.clear(); self._leases.remove(index); }
		}
		for (int index = self._registrations.len - 1; index >= 0; index--) {
			var registration = self._registrations.get(index); var current = registration.current;
			if (!registration.open && (current == null || !current.occupied)) { if (current != null) { self.releaseSlot(current); registration.current = null; } self._registrations.remove(index); }
		}
	}

	public void finishLease(long long identity, long long serial) {
		var lease = self.requireLease(identity, serial); if (!lease.consumed || lease.finished) { throw "Capture barrier is not live"; }
		lease.finished = true; var ordered = lease.ordered; if (ordered != null) { ordered.occupied = false; } self.collect();
	}

	public void abandonLease(long long identity, long long serial) {
		var lease = self.findLease(identity); if (lease == null) { return; }
		lease = self.requireLease(identity, serial); if (lease.consumed) { throw "Consumed capture lease belongs to its record"; }
		lease.finished = true; self.collect();
	}

	public void releaseRecord(ControlEventCaptureSlot slot) { if (!slot.occupied || slot.released) { throw "Capture record does not own its slot"; } slot.occupied = false; self.collect(); }

	public void enter() { if (self._entered) { throw "Capture delivery cannot re-enter"; } self._entered = true; }

	public void leave() { if (!self._entered) { throw "Capture delivery has not entered"; } self._entered = false; }

	public void cancelRegistration(ControlEventCaptureRegistration handle) {
		handle.requireOwner(self); var registration = self.findRegistration(handle.identity()); if (registration == null || !registration.open) { return; }
		registration.open = false;
		for lease in self._leases {
			for participant in lease.participants { if (participant.registration == registration.identity) { participant.removed = true; } }
			if (lease.registration == registration.identity) { lease.reusable = false; if (!lease.consumed) { lease.finished = true; } }
		}
		self.collect();
	}

	public void seal() {
		if (self._sealed) { return; } self._sealed = true;
		for registration in self._registrations { registration.open = false; }
		for lease in self._leases { lease.reusable = false; for participant in lease.participants { participant.removed = true; } if (!lease.consumed) { lease.finished = true; } }
		self.collect();
	}
}

/* Opt-in storage for observations waiting for ordinary capacity. Unpublished
 * preparations and queued held records share this fixed budget. The budget
 * outlives cancelled handles without retaining the queue or its receivers. */
class ControlEventHeldBudget {
	private int _capacity;
	private int _prepared = 0;
	private int _queued = 0;
	public ControlEventHeldBudget(int capacity) { if (capacity < 0 || capacity > 65536) { throw "Invalid held receipt capacity"; } self._capacity = capacity; }

	public int preparedCount() { return self._prepared; }

	public int queuedCount() { return self._queued; }

	public bool reserve() { if (self._prepared + self._queued == self._capacity) { return false; } self._prepared++; return true; }

	public void commit() { if (self._prepared <= 0) { throw "Held preparation underflow"; } self._prepared--; self._queued++; }

	public void retire(bool queued) { if (queued) { if (self._queued <= 0) { throw "Held receipt underflow"; } self._queued--; } else { if (self._prepared <= 0) { throw "Held preparation underflow"; } self._prepared--; } }
}

/* Only the admitting record receives this token. A retained preparation has
 * no operation that can release the record's storage after consumption. */
class ControlEventHeldReceipt {
	private ControlEventHeldBudget _budget;
	private bool _open = true;
	public ControlEventHeldReceipt(ControlEventHeldBudget budget) { self._budget = budget; budget.commit(); }

	public bool isOpen() { return self._open; }

	public void retire() { if (!self._open) { return; } self._open = false; self._budget.retire(true); }
}

/* Reserve before a model mutation. The reservation owns independent storage,
 * not an earlier snapshot or ordering position. Publication resolves the
 * current replacement epoch and transfers this credit exactly once. */
class ControlEventPreparation {
	private ControlEventHeldBudget _budget;
	private long long _registration;
	private bool _open = true;
	private ControlEventHeldReceipt? _receipt = null;
	public ControlEventPreparation(ControlEventHeldBudget budget, long long registration) { self._budget = budget; self._registration = registration; }

	public bool isOpen() { var receipt = self._receipt; if (receipt != null) { return receipt.isOpen(); } return self._open; }

	public bool queued() { return self._receipt != null; }

	public bool belongsTo(long long registration) { return self._registration == registration; }

	public void requireOwner(ControlEventHeldBudget budget, long long registration) { if (self._budget != budget || self._registration != registration) { throw "Held preparation belongs to another registration"; } }

	public void validate() { if (!self._open || self._receipt != null) { throw "Held preparation is stale or already consumed"; } }

	public ControlEventHeldReceipt consume() { self.validate(); var receipt = ControlEventHeldReceipt(self._budget); self._receipt = receipt; return receipt; }

	public void retire() { if (self._receipt != null) { if (self.isOpen()) { throw "Queued held credit belongs to its record"; } return; } if (!self._open) { return; } self._open = false; self._budget.retire(false); }
}

class ControlEventRecord {
	public long long registration;
	public long long generation;
	public long long interaction;
	public long long key;
	private IControlEventInvocation _invocation;
	private ControlEventTicket? _terminal;
	private ControlEventHeldReceipt? _held = null;
	private bool _admitted = false;
	private bool _retired = false;
	private IControlEventStorage? _storage;
	public ControlEventRecord(long long registration, long long generation, long long interaction, long long key, IControlEventInvocation invocation, ControlEventTicket? terminal, IControlEventStorage? storage = null) {
		self.registration = registration; self.generation = generation; self.interaction = interaction; self.key = key; self._invocation = invocation; self._terminal = terminal;
		self._storage = storage;
	}

	public bool terminal() { return self._terminal != null; }

	public bool held() { return self._held != null; }

	public bool captured() { return self._storage != null; }

	public void hold(ControlEventPreparation preparation) { if (self._admitted || self._held != null || self.terminal()) { throw "Semantic record cannot acquire held credit"; } self._held = preparation.consume(); }

	public void abandonHold() { if (self._admitted) { throw "Admitted held storage belongs to its record"; } var held = self._held; self._held = null; if (held != null) { held.retire(); } }

	public void promote() { var held = self._held; if (held == null) { throw "Semantic record has no held credit"; } self._held = null; held.retire(); }

	public bool replaces(ControlEventRecord previous) { return !self.terminal() && self.key > 0LL && self.registration == previous.registration && self.generation == previous.generation && self.interaction == previous.interaction && self.key == previous.key && ((self._storage == null && previous._storage == null) || (self._storage != null && previous._storage != null && self._storage.replaces(previous._storage))); }

	public bool replaceable() { return !self.terminal() && self.key > 0LL; }

	public bool transferred() { return self._admitted && self._retired; }

	public void requireOwner(ControlEventTerminalPool pool, ControlEventCaptureOwner? owner) {
		if (self._terminal != null) { self._terminal.requireOwner(pool, self.registration); }
		if (self._storage != null) { if (owner == null) { throw "Queue has no capture owner"; } self._storage.requireOwner(owner, self.registration); }
	}

	private void validateAdmission(ControlEventQueue queue) {
		queue.requireAdmission(self);
		if (self._admitted || self._retired) { throw "Semantic record admitted twice"; }
		if (self._terminal != null) { self._terminal.validate(self.registration); }
		if (self._storage != null) { self._storage.validateAdmission(self.terminal(), self.key); }
	}

	public void admit(ControlEventQueue queue) {
		self.validateAdmission(queue);
		self._invocation.admitted();
		try { self.validateAdmission(queue); }
		catch (string error) { try { self._invocation.retired(); } catch (string cleanup) {} throw error; }
		/* Claims have no callbacks or allocations after the final validation. */
		if (self._terminal != null) { self._terminal.commit(); }
		if (self._storage != null) { self._storage.claim(); }
		self._admitted = true;
	}

	public ControlEventDisposition invoke() { if (self._storage != null) { self._storage.entered(); } return self._invocation.invoke(); }

	/* Preserve the original queue position and storage charge. The fresh
	 * invocation owns its snapshot; the superseded invocation drains now. */
	private void validateReplacement(ControlEventRecord next, ControlEventQueue queue) {
		queue.requireReplacement(next);
		if (!self._admitted || self._retired || next._admitted || next._retired || !next.replaces(self)) { throw "Invalid semantic replacement"; }
		if (self._storage != null && self._storage == next._storage) { throw "Semantic records cannot share capture ownership"; }
	}

	public void replaceWith(ControlEventRecord next, ControlEventQueue queue) {
		self.validateReplacement(next, queue);
		next._invocation.admitted();
		try { self.validateReplacement(next, queue); }
		catch (string error) { try { next._invocation.retired(); } catch (string cleanup) {} throw error; }
		var previous = self._invocation; self._invocation = next._invocation;
		next._admitted = true; next._retired = true;
		/* Once transferred, failure seals the queue instead of rejecting the
		 * producer. The queued record keeps the new invocation and old charge. */
		string failure = "";
		try { previous.retired(); } catch (string error) { failure = error; }
		var candidate = next._storage; next._storage = null;
		try { if (candidate != null) { candidate.retired(); } } catch (string error) { if (failure == "") { failure = error; } }
		if (failure != "") { throw failure; }
	}

	public void retire() { if (!self._admitted || self._retired) { throw "Semantic record retired without unique admission"; } self._retired = true; if (self._terminal != null) { self._terminal.complete(); } if (self._held != null) { self._held.retire(); self._held = null; } if (self._storage != null) { self._storage.retired(); self._storage = null; } self._invocation.retired(); }
}

/* One ordered semantic stream per window/scene. Replacement never crosses an
 * ordered record from any control. Accepted/executing normal records share
 * one budget; terminal tickets are precharged to the independent pool. */
class ControlEventQueue {
	private int _capacity;
	private int _normal = 0;
	private bool _closed = false;
	private bool _dispatching = false;
	private bool _wakeFailed = false;
	private string _failure = "";
	private ControlEventCaptureOwner? _capture;
	private ControlEventTerminalPool _pool;
	private ControlEventHeldBudget _held;
	private Vector<ControlEventPreparation> _preparations = [];
	private IControlEventWake? _wake = null;
	private Vector<ControlEventRecord> _records = [];
	private Vector<long long> _retired = [];

	public ControlEventQueue(int normalCapacity, ControlEventTerminalPool pool, int heldCapacity = 0, ControlEventCaptureOwner? capture = null) {
		if (normalCapacity <= 0 || normalCapacity > 65536 || pool == null) { throw "Invalid semantic queue capacity"; }
		self._capacity = normalCapacity; self._pool = pool; self._held = ControlEventHeldBudget(heldCapacity);
		if (capture != null) { capture.bind(pool); } self._capture = capture;
		for (int index = 0; index < 7; index++) { self._retired.push(0LL); }
	}

	public bool captureEnabled() { return self._capture != null; }

	public ControlEventCaptureOwner captureOwner() { if (self._capture == null) { throw "Semantic queue has no capture owner"; } return self._capture; }

	public void requireOpen() { if (self._closed || self._wakeFailed) { throw "Semantic queue is closed"; } }

	public ControlEventTerminalPool terminalPool() { return self._pool; }

	public void setWake(IControlEventWake wake) { if (wake == null || self._closed) { throw "Semantic queue requires a live wake"; } self._wake = wake; }

	public long long registrationIdentity() { if (self._closed || self._wakeFailed) { throw "Semantic queue is closed"; } return self._pool.registrationIdentity(); }

	public int pendingCount() { return self._records.len; }

	public int normalCount() { return self._normal; }

	public int heldCount() { return self._held.queuedCount(); }

	public int preparedCount() { return self._held.preparedCount(); }

	/* Seal admission without discarding receipts owned by cancellation/close. */
	public void sealNativeSource() { self._wakeFailed = true; if (self._capture != null) { self._capture.seal(); } }

	private void fail(string error) { if (self._failure == "") { self._failure = error; } self.sealNativeSource(); }

	public void requireAdmission(ControlEventRecord record) {
		record.requireOwner(self._pool, self._capture);
		if (self._closed || self._wakeFailed) { throw "Semantic queue is closed"; }
		if (!record.terminal() && !record.held() && !record.captured() && (self._normal == self._capacity || self.heldCount() != 0)) { throw "Semantic admission capacity changed"; }
	}

	public void requireReplacement(ControlEventRecord record) { record.requireOwner(self._pool, self._capture); if (self._closed || self._wakeFailed) { throw "Semantic queue is closed"; } }

	public bool canCapture(int maximumRecords) { return !self._closed && !self._wakeFailed && maximumRecords >= 0 && (maximumRecords == 0 || (self.heldCount() == 0 && maximumRecords <= self._capacity - self._normal)); }

	public long long retired(ControlEventDisposition disposition) { return self._retired.get((int)disposition); }

	private void wake() {
		/* The receipt is already committed. Neither a false native result nor
		 * a throwing adapter may turn it into an ambiguous producer rejection.
		 * The next service turn reports failure; cancellation still drains. */
		try { if (self._wake != null && !self._wake.requestTurn()) { self.fail("Semantic queue native wake failed"); } }
		catch (string error) { self.fail(error); }
	}

	private void countRetirement(ControlEventDisposition disposition) {
		long long count = self._retired.get((int)disposition);
		if (count == 9223372036854775807LL) { throw "Semantic receipt counters exhausted"; }
		self._retired.set((int)disposition, count + 1LL);
	}

	private void retireRecord(ControlEventRecord record, ControlEventDisposition disposition) {
		self.countRetirement(disposition);
		if (!record.terminal() && !record.held() && !record.captured()) { self._normal--; }
		record.retire();
	}

	private void prunePreparations() {
		for (int index = self._preparations.len - 1; index >= 0; index--) { var preparation = self._preparations.get(index); if (!preparation.isOpen() || preparation.queued()) { self._preparations.remove(index); } }
	}

	public ControlEventPreparation? prepare(long long registration) {
		if (self._closed || self._wakeFailed) { return null; }
		self.prunePreparations();
		if (!self._held.reserve()) { return null; }
		var preparation = ControlEventPreparation(self._held, registration); self._preparations.push(preparation); return preparation;
	}

	public void requirePreparation(ControlEventPreparation preparation, long long registration) { preparation.requireOwner(self._held, registration); }

	private int replacementIndex(ControlEventRecord record) {
		int replacement = -1;
		if (record.replaceable()) {
			for (int index = self._records.len - 1; index >= 0; index--) {
				var previous = self._records.get(index);
				if (!previous.replaceable()) { break; }
				if (record.replaces(previous)) { replacement = index; break; }
			}
		}
		return replacement;
	}

	/* A held record is already ordered. Later normal producers must not spend
	 * the free capacity it needs to promote, even when a callback is executing.
	 * Captured admission remains fallible: providers must separately stop
	 * native dequeue before exhausting their configured held budget. */
	public bool enqueue(ControlEventRecord record, bool captured = false, ControlEventPreparation? prepared = null) {
		record.requireOwner(self._pool, self._capture);
		if (self._capture != null && !record.captured() && !record.replaceable()) { throw "Capture queue requires an ordered continuation lease"; }
		var preparation = prepared;
		if (preparation != null) { self.requirePreparation(preparation, record.registration); preparation.validate(); }
		if (self._closed || self._wakeFailed) { if (preparation != null) { preparation.retire(); self.prunePreparations(); } return false; }
		int replacement = self.replacementIndex(record);
		if (replacement >= 0) {
			try { self._records.get(replacement).replaceWith(record, self); }
			catch (string error) { if (!record.transferred()) { throw error; } self.fail(error); }
			try { self.countRetirement(CONTROL_EVENT_SUPERSEDED); } catch (string error) { self.fail(error); }
			if (preparation != null) { preparation.retire(); self.prunePreparations(); }
		} else {
			if (!record.terminal() && !record.captured() && (self._normal == self._capacity || self.heldCount() != 0)) {
				if (preparation == null && captured) { preparation = self.prepare(record.registration); }
				if (preparation == null) { return false; }
				record.hold(preparation);
			} else if (preparation != null) { preparation.retire(); }
			try { record.admit(self); } catch (string error) { try { record.abandonHold(); } catch (string cleanup) {} throw error; } if (!record.terminal() && !record.held() && !record.captured()) { self._normal++; }
			self._records.push(record); self.prunePreparations();
		}
		if (!self._wakeFailed) { self.wake(); } return true;
	}

	/* Rebind quarantines records until every route and generation is coherent.
	 * Their storage and pending charges remain owned through final retirement. */
	public Vector<ControlEventRecord> takeRegistration(long long registration) {
		for preparation in self._preparations { if (preparation.belongsTo(registration)) { preparation.retire(); } } self.prunePreparations();
		Vector<ControlEventRecord> records = [];
		for (int index = 0; index < self._records.len;) { var record = self._records.get(index); if (record.registration == registration) { records.push(record); self._records.remove(index); } else { index++; } }
		return records;
	}

	public void retireRebound(ControlEventRecord record) { self.retireRecord(record, CONTROL_EVENT_INELIGIBLE); }

	public void cancelRegistration(long long registration, ControlEventDisposition disposition = CONTROL_EVENT_CANCELLED) {
		for preparation in self._preparations { if (preparation.belongsTo(registration)) { preparation.retire(); } }
		self.prunePreparations();
		for (int index = self._records.len - 1; index >= 0; index--) {
			var record = self._records.get(index);
			if (record.registration == registration) { self._records.remove(index); self.retireRecord(record, disposition); }
		}
	}

	public bool dispatchOne() {
		if (self._wakeFailed) { throw self._failure != "" ? self._failure : "Semantic queue native wake failed"; }
		if (self._dispatching) { throw "Semantic delivery cannot re-enter"; }
		if (self._records.isEmpty()) { return false; }
		var record = self._records.get(0);
		if (record.held()) { if (self._normal == self._capacity) { return false; } record.promote(); self._normal++; }
		self._records.remove(0);
		self._dispatching = true;
		ControlEventDisposition disposition = CONTROL_EVENT_FAILED;
		try { disposition = record.invoke(); }
		finally { self._dispatching = false; self.retireRecord(record, disposition); }
		return true;
	}

	public void close() {
		self._closed = true; self._wake = null; if (self._capture != null) { self._capture.seal(); }
		for preparation in self._preparations { preparation.retire(); } self._preparations.clear();
		while (!self._records.isEmpty()) { var record = self._records.get(0); self._records.remove(0); self.retireRecord(record, CONTROL_EVENT_CLOSED); }
	}
}

class ControlEventInvocation<Receiver, Snapshot> implements IControlEventInvocation {
	private ControlEventChannel<Receiver, Snapshot> _channel;
	private Snapshot _snapshot;
	private long long _generation;
	public ControlEventInvocation(ControlEventChannel<Receiver, Snapshot> channel, Snapshot snapshot, long long generation) { self._channel = channel; self._snapshot = snapshot; self._generation = generation; }

	public void admitted() { self._channel.admitted(); }

	public ControlEventDisposition invoke() { return self._channel.deliver(self._snapshot, self._generation); }

	public void retired() { self._channel.retired(); }
}

/* One typed live registration. The provider owns duplicate-channel rejection;
 * CallbackScope owns this registration, which uses the existing entry gate.
 * Cancellation removes queued snapshots and waits only through polling for an
 * already-entered receiver. It never pumps, joins or blocks the UI executor. */
enum ControlEventCaptureRole { CONTROL_CAPTURE_LEGACY, CONTROL_CAPTURE_OBSERVER, CONTROL_CAPTURE_KEYED, CONTROL_CAPTURE_TERMINAL };
interface IControlEventRebind { bool isOpen(); void validate(); void commit(); void finish(); void abort(); }
interface IControlEventChannel extends ICallbackRegistration { void rebind(ControlEventQueue queue); IControlEventRebind? prepareRebind(ControlEventQueue queue); }

/* A prospective keyed intent owns its continuation until the first snapshot.
 * The channel does not retain this token; abandoning it leaves the old key. */
class ControlEventPublication<Receiver, Snapshot> {
	private ControlEventChannel<Receiver, Snapshot> _channel;
	private long long _identity;
	private ControlEventCaptureLease? _lease;
	private bool _open = true;
	public long long generation;
	public long long interaction;
	public long long key;
	public ControlEventPublication(ControlEventChannel<Receiver, Snapshot> channel, long long identity, long long generation, long long interaction, long long key, ControlEventCaptureLease lease) { self._channel = channel; self._identity = identity; self.generation = generation; self.interaction = interaction; self.key = key; self._lease = lease; }

	public bool isOpen() { return self._open && self._channel.matchesRoute(self._identity); }

	public void validate() { if (!self.isOpen()) { throw "Key publication belongs to a retired route"; } self._channel.requireRoute(self._identity); }

	public void requireOwner(ControlEventChannel<Receiver, Snapshot> channel) { if (channel != self._channel) { throw "Key publication belongs to another channel"; } self.validate(); }

	public void rotate() { self.validate(); var lease = self._lease; if (lease == null) { throw "Key publication is consumed"; } var barrier = lease.commit(); self._lease = null; self._open = false; barrier.retired(); }

	public bool commit(Snapshot snapshot) { self.validate(); return self._channel.publishKey(self, snapshot); }

	public void abort() { if (!self._open) { return; } self._open = false; var lease = self._lease; self._lease = null; if (lease != null) { lease.cancel(); } }

	public void __del__() { self.abort(); }
}

/* A forest first acquires every destination and validates every token, then
 * commits without callbacks. Source routes remain authoritative until commit. */
class ControlEventRebind<Receiver, Snapshot> implements IControlEventRebind {
	private ControlEventChannel<Receiver, Snapshot> _channel;
	private long long _source;
	private bool _open = true;
	private bool _committed = false;
	private bool _finished = false;
	private ControlEventQueue? _sourceQueue = null;
	private Vector<ControlEventRecord> _retirees = [];
	public ControlEventQueue queue;
	public long long identity;
	public ControlEventCaptureRegistration? capture;
	public bool unchanged;
	public ControlEventRebind(ControlEventChannel<Receiver, Snapshot> channel, long long source, ControlEventQueue queue, long long identity, ControlEventCaptureRegistration? capture, bool unchanged) { self._channel = channel; self._source = source; self.queue = queue; self.identity = identity; self.capture = capture; self.unchanged = unchanged; }

	public bool isOpen() { return self._open; }

	public void validate() { if (!self._open) { throw "Rebind preparation is consumed"; } if (!self._channel.isOpen()) { return; } self._channel.requireRoute(self._source); self.queue.requireOpen(); }

	public void requireOwner(ControlEventChannel<Receiver, Snapshot> channel) { if (channel != self._channel) { throw "Rebind preparation belongs to another channel"; } self.validate(); }

	public void retainRecords(ControlEventQueue queue, Vector<ControlEventRecord> records) { self._sourceQueue = queue; self._retirees = records; }

	public void commit() { self.validate(); if (!self._channel.isOpen()) { self.abort(); return; } self._channel.commitRebind(self); self.capture = null; self._open = false; self._committed = true; }

	public void finish() {
		if (!self._committed || self._finished) { return; } self._finished = true; string failure = "";
		if (!self._retirees.isEmpty()) {
			var queue = self._sourceQueue;
			if (queue == null) { throw "Rebound records have no source queue"; }
			while (!self._retirees.isEmpty()) { ControlEventRecord? record = self._retirees.get(0); self._retirees.remove(0); try { queue.retireRebound(record); record = null; } catch (string error) { if (failure == "") { failure = error; } } }
		}
		self._sourceQueue = null; if (failure != "") { throw failure; }
	}

	public void abort() { if (!self._open) { return; } self._open = false; if (self.capture != null) { self.capture.cancel(); self.capture = null; } }

	public void __del__() { if (self._committed) { self.finish(); } else { self.abort(); } }
}

/* Retain the entire batch across route swaps and generation updates. finish
 * may run snapshot destructors; it sweeps all tokens before reporting failure. */
class ControlEventRebindEntry {
	public IControlEventChannel channel;
	public ControlEventQueue queue;
	public IControlEventRebind preparation;
	public ControlEventRebindEntry(IControlEventChannel channel, ControlEventQueue queue, IControlEventRebind preparation) { self.channel = channel; self.queue = queue; self.preparation = preparation; }
}

class ControlEventRebindBatch {
	private Vector<ControlEventRebindEntry> _preparations = [];
	private bool _open = true;
	private bool _committed = false;
	private bool _finished = false;
	public bool prepare(IControlEventChannel channel, ControlEventQueue queue) {
		if (!self._open) { throw "Rebind batch is closed"; }
		try { for entry in self._preparations { if (entry.channel == channel) { if (entry.queue != queue) { throw "Channel has conflicting rebind destinations"; } return true; } } var preparation = channel.prepareRebind(queue); if (preparation == null) { self.abort(); return false; } self._preparations.push(ControlEventRebindEntry(channel, queue, preparation)); return true; }
		catch (string error) { self.abort(); throw error; }
	}

	public void validate() { if (!self._open) { throw "Rebind batch is closed"; } for entry in self._preparations { entry.preparation.validate(); } }

	public void commitRoutes() { self.validate(); self._open = false; self._committed = true; for entry in self._preparations { entry.preparation.commit(); } }

	public void finish() { if (!self._committed || self._finished) { return; } self._finished = true; string failure = ""; for entry in self._preparations { try { entry.preparation.finish(); } catch (string error) { if (failure == "") { failure = error; } } } self._preparations.clear(); if (failure != "") { throw failure; } }

	public void abort() { if (self._committed) { throw "Committed routes cannot be rolled back"; } if (!self._open) { return; } self._open = false; for entry in self._preparations { entry.preparation.abort(); } self._preparations.clear(); }

	public void __del__() { if (self._committed) { self.finish(); } else { self.abort(); } }
}

class ControlEventChannel<Receiver, Snapshot> implements IControlEventChannel {
	private ControlEventQueue _queue;
	private IControlEventTarget? _target;
	private CallbackScope _scope = CallbackScope();
	private CallbackContext<Receiver, ControlEventTerminalPool>? _handler;
	private CFunction<void, Receiver, Snapshot> _deliver;
	private long long _identity;
	private bool _reserved = false;
	private ControlEventCaptureRole _role;
	private ControlEventCaptureRegistration? _capture = null;
	private bool _hasKey = false;
	private long long _keyGeneration = 0LL;
	private long long _keyInteraction = 0LL;
	private long long _key = 0LL;
	private bool _cancelling = false;
	private int _pending = 0;
	private ControlEventTicket? _baseTicket = null;
	private Vector<ControlEventTicket> _tickets = [];
	private CallbackCancellation _cancellation = CALLBACK_CANCELLATION_NOT_REQUESTED;

	public ControlEventChannel(ControlEventQueue queue, IControlEventTarget target, Receiver receiver, CFunction<void, Receiver, Snapshot> deliver, CallbackScope owner, ControlEventCaptureRole role = CONTROL_CAPTURE_LEGACY) {
		if (queue == null || target == null || receiver == (Receiver)null || deliver == null || owner == null) { throw "Semantic subscription requires queue, target, receiver and owner"; }
		self._queue = queue; self._target = target; self._deliver = deliver; self._role = role; queue.requireOpen();
		if (role == CONTROL_CAPTURE_LEGACY) { self._identity = queue.registrationIdentity(); }
		else { self._capture = queue.captureOwner().reserveRegistration(role != CONTROL_CAPTURE_TERMINAL, role == CONTROL_CAPTURE_TERMINAL); if (self._capture == null) { throw "Control capture registration capacity exceeded"; } self._identity = self._capture.identity(); }
		if (role == CONTROL_CAPTURE_LEGACY || role == CONTROL_CAPTURE_TERMINAL) { if (!queue.terminalPool().reserve()) { if (self._capture != null) { self._capture.cancel(); self._capture = null; } throw "Control terminal reservation capacity exceeded"; } self._reserved = true; }
		var handler = new CallbackContext<Receiver, ControlEventTerminalPool>(receiver, ControlEventTerminalPool.unregister);
		handler.activate(self._scope); self._handler = handler;
		try { owner.track(self); handler.publish(queue.terminalPool()); }
		catch (string error) { handler.abortActivation(); self._cancelling = true; self._scope.cancel(); self.releaseReservation(); throw error; }
	}

	public bool isOpen() { return !self._cancelling && self._handler != null && self._handler.isOpen(); }

	public void admitted() { self._pending++; }

	public void retired() { if (self._pending <= 0) { throw "Semantic registration receipt underflow"; } self._pending--; }

	/* Same-window reorder preserves interaction state. Detach/reattach uses
	 * the application's detached queue, with the same terminal pool. Native
	 * owners settle eligibility loss before moving their channel route. */
	public bool matchesRoute(long long identity) { return self.isOpen() && self._identity == identity; }

	public void requireRoute(long long identity) { if (!self.matchesRoute(identity)) { throw "Semantic channel route is retired"; } self._queue.requireOpen(); }

	public IControlEventRebind? prepareRebind(ControlEventQueue queue) {
		if (queue == null || queue.terminalPool() != self._queue.terminalPool()) { throw "Semantic channel cannot cross application terminal pools"; }
		if (!self.isOpen()) { throw "Semantic channel is cancelled"; } queue.requireOpen();
		if (queue == self._queue) { return new ControlEventRebind<Receiver, Snapshot>(self, self._identity, queue, self._identity, null, true); }
		ControlEventCaptureRegistration? capture = null;
		long long identity = 0LL;
		if (self._role == CONTROL_CAPTURE_LEGACY) { identity = queue.registrationIdentity(); }
		else { capture = queue.captureOwner().reserveRegistration(self._role != CONTROL_CAPTURE_TERMINAL, self._role == CONTROL_CAPTURE_TERMINAL); if (capture == null) { return null; } identity = capture.identity(); }
		return new ControlEventRebind<Receiver, Snapshot>(self, self._identity, queue, identity, capture, false);
	}

	public void commitRebind(ControlEventRebind<Receiver, Snapshot> preparation) {
		preparation.requireOwner(self); if (preparation.unchanged) { return; }
		preparation.retainRecords(self._queue, self._queue.takeRegistration(self._identity));
		for ticket in self._tickets { if (!ticket.queued()) { ticket.retire(); } }
		if (self._capture != null) { self._capture.cancel(); }
		self._queue = preparation.queue; self._identity = preparation.identity; self._capture = preparation.capture; self._hasKey = false;
	}

	public void rebind(ControlEventQueue queue) { var preparation = self.prepareRebind(queue); if (preparation == null) { throw "Control capture rebind capacity exceeded"; } preparation.validate(); preparation.commit(); preparation.finish(); }

	public ControlEventPublication<Receiver, Snapshot>? prepareKey(long long generation, long long interaction, long long key) {
		if (self._role != CONTROL_CAPTURE_KEYED || generation <= 0LL || interaction < 0LL || key <= 0LL) { throw "Key preparation requires a keyed channel and valid tuple"; }
		if (!self.isOpen() || !self._queue.canCapture(0)) { return null; }
		var capture = self._capture; if (capture == null) { throw "Keyed channel has no capture registration"; }
		var lease = self._queue.captureOwner().reserveKeyChange(capture); if (lease == null) { return null; }
		return new ControlEventPublication<Receiver, Snapshot>(self, self._identity, generation, interaction, key, lease);
	}

	public bool publishKey(ControlEventPublication<Receiver, Snapshot> preparation, Snapshot snapshot) {
		preparation.requireOwner(self); if (snapshot == (Snapshot)null) { throw "Invalid semantic snapshot"; }
		preparation.rotate(); self._hasKey = true; self._keyGeneration = preparation.generation; self._keyInteraction = preparation.interaction; self._key = preparation.key;
		return self.publish(snapshot, preparation.generation, preparation.interaction, preparation.key);
	}

	public ControlEventTicket? beginInteraction() {
		if (self._role != CONTROL_CAPTURE_LEGACY && self._role != CONTROL_CAPTURE_TERMINAL) { throw "Observer and keyed channels do not publish terminals"; }
		if (!self.isOpen() || !self._queue.canCapture(0)) { return null; }
		for (int index = self._tickets.len - 1; index >= 0; index--) { if (!self._tickets.get(index).isOpen()) { self._tickets.remove(index); } }
		ControlEventCaptureLease? continuation = null;
		if (self._role == CONTROL_CAPTURE_TERMINAL) { var capture = self._capture; if (capture == null) { throw "Terminal channel has no capture registration"; } continuation = self._queue.captureOwner().reserveBarrier(capture); if (continuation == null) { return null; } }
		bool extra = self._baseTicket != null && self._baseTicket.isOpen();
		if (extra && !self._queue.terminalPool().reserve()) { if (continuation != null) { continuation.cancel(); } return null; }
		var ticket = ControlEventTicket(self._queue.terminalPool(), self._identity, extra, continuation);
		if (!extra) { self._baseTicket = ticket; }
		self._tickets.push(ticket); return ticket;
	}

	/* The provider captures a fresh owning snapshot and never mutates it
	 * after successful admission. A false return transfers no receipt. */
	public bool publish(Snapshot snapshot, long long generation, long long interaction, long long replacementKey) {
		if (!self.isOpen()) { return false; }
		if (snapshot == (Snapshot)null || generation <= 0LL || interaction < 0LL || replacementKey < 0LL) { throw "Invalid semantic snapshot identity"; }
		var invocation = new ControlEventInvocation<Receiver, Snapshot>(self, snapshot, generation);
		if (self._role == CONTROL_CAPTURE_LEGACY) { return self._queue.enqueue(ControlEventRecord(self._identity, generation, interaction, replacementKey, invocation, null)); }
		if (self._role == CONTROL_CAPTURE_TERMINAL || replacementKey <= 0LL) { throw "Capture publication requires a replaceable channel"; }
		if (self._hasKey && (generation != self._keyGeneration || interaction != self._keyInteraction || replacementKey != self._key)) { throw "Capture tuple requires a prepared key transition"; }
		if (!self._hasKey) { if (self._role == CONTROL_CAPTURE_KEYED) { throw "Keyed capture requires its first publication preparation"; } self._hasKey = true; self._keyGeneration = generation; self._keyInteraction = interaction; self._key = replacementKey; }
		if (!self._queue.canCapture(0)) { return false; }
		var capture = self._capture; if (capture == null) { throw "Replaceable channel has no capture registration"; }
		var receipt = self._queue.captureOwner().capture(capture);
		try { bool accepted = self._queue.enqueue(ControlEventRecord(self._identity, generation, interaction, replacementKey, invocation, null, receipt)); if (!accepted) { receipt.retired(); } return accepted; }
		catch (string error) { receipt.retired(); throw error; }
	}

	/* Refusal happens before a model operation changes observable state. The
	 * caller retires an unused preparation, including a failed/no-op mutation.
	 * Cancel, close and rebind also invalidate outstanding preparations. */
	public ControlEventPreparation? prepareSnapshot() { if (self._role != CONTROL_CAPTURE_LEGACY) { throw "Capture channels use their prepaid epoch or key preparation"; } if (!self.isOpen()) { return null; } return self._queue.prepare(self._identity); }

	public bool publishPrepared(Snapshot snapshot, long long generation, long long interaction, long long replacementKey, ControlEventPreparation preparation) {
		if (self._role != CONTROL_CAPTURE_LEGACY) { throw "Capture channels do not consume held preparations"; }
		if (preparation == null) { throw "Semantic model publication requires a preparation"; }
		self._queue.requirePreparation(preparation, self._identity);
		if (!self.isOpen()) { preparation.retire(); return false; }
		if (snapshot == (Snapshot)null || generation <= 0LL || interaction < 0LL || replacementKey < 0LL) { throw "Invalid semantic snapshot identity"; }
		var invocation = new ControlEventInvocation<Receiver, Snapshot>(self, snapshot, generation);
		return self._queue.enqueue(ControlEventRecord(self._identity, generation, interaction, replacementKey, invocation, null), false, preparation);
	}

	public bool publishCaptured(Snapshot snapshot, long long generation, long long interaction, long long replacementKey) {
		if (self._role != CONTROL_CAPTURE_LEGACY) { return self.publish(snapshot, generation, interaction, replacementKey); }
		if (!self.isOpen()) { return false; }
		if (snapshot == (Snapshot)null || generation <= 0LL || interaction < 0LL || replacementKey < 0LL) { throw "Invalid semantic snapshot identity"; }
		var invocation = new ControlEventInvocation<Receiver, Snapshot>(self, snapshot, generation);
		return self._queue.enqueue(ControlEventRecord(self._identity, generation, interaction, replacementKey, invocation, null), true);
	}

	public void publishTerminal(Snapshot snapshot, long long generation, long long interaction, ControlEventTicket ticket) {
		if (self._role != CONTROL_CAPTURE_LEGACY && self._role != CONTROL_CAPTURE_TERMINAL) { throw "Capture channel does not publish terminals"; }
		if (ticket != null) { ticket.requireOwner(self._queue.terminalPool(), self._identity); }
		if (!self.isOpen()) { if (ticket != null) { ticket.retire(); } return; }
		if (snapshot == (Snapshot)null || ticket == null || generation <= 0LL || interaction <= 0LL) { throw "Invalid semantic terminal snapshot"; }
		ticket.validate(self._identity);
		var invocation = new ControlEventInvocation<Receiver, Snapshot>(self, snapshot, generation);
		if (!self._queue.canCapture(0)) { ticket.retire(); throw "Control terminal queue is closed or its native source failed"; }
		var storage = ticket.prepareCapture();
		bool accepted = false;
		try { accepted = self._queue.enqueue(ControlEventRecord(self._identity, generation, interaction, 0LL, invocation, ticket, storage)); }
		catch (string error) { ticket.retire(); throw error; }
		if (!accepted) { ticket.retire(); throw "Control terminal queue is closed or its native source failed"; }
	}

	public ControlEventDisposition deliver(Snapshot snapshot, long long generation) {
		var handler = self._handler; var target = self._target;
		if (self._cancelling || handler == null || target == null) { return CONTROL_EVENT_CANCELLED; }
		ControlEventDisposition disposition = target.admission(generation);
		if (disposition != CONTROL_EVENT_DELIVERED) { return disposition; }
		var receiver = handler.enter();
		if (receiver == null) { return CONTROL_EVENT_CANCELLED; }
		try { self._deliver((Receiver)receiver, snapshot); }
		finally { handler.leave(); handler.pollCompletion(); }
		return CONTROL_EVENT_DELIVERED;
	}

	private void releaseReservation() {
		if (self._capture != null) { self._capture.cancel(); self._capture = null; }
		if (self._reserved) { self._reserved = false; self._queue.terminalPool().retire(); }
	}

	public CallbackCancellation cancel() {
		if (self._cancellation == CALLBACK_CANCELLATION_COMPLETE && !self._reserved) { return self._cancellation; }
		self._cancelling = true;
		self._queue.cancelRegistration(self._identity);
		for ticket in self._tickets { if (!ticket.queued()) { ticket.retire(); } }
		self._cancellation = self._scope.cancel();
		return self.pollCompletion();
	}

	public CallbackCancellation pollCompletion() {
		if (!self._cancelling) { return CALLBACK_CANCELLATION_NOT_REQUESTED; }
		self._cancellation = self._scope.pollCompletion();
		if (self._cancellation == CALLBACK_CANCELLATION_COMPLETE) {
			if (self._pending != 0) { return CALLBACK_CANCELLATION_PENDING; }
			self.releaseReservation(); self._tickets.clear(); self._baseTicket = null; self._target = null;
		}
		return self._cancellation;
	}

	public void __del__() { if (self._queue != null && self.cancel() != CALLBACK_CANCELLATION_COMPLETE) { Console.fatal("Semantic registration destroyed before callback drain"); } }
}
