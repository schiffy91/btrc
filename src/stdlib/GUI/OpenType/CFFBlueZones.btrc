import Library.Vector;

import ./CFFTables.btrc;
import ./OpenTypeData.btrc;

enum CFFStemFit {
	CFF_STEM_FREE,
	CFF_STEM_BOTTOM,
	CFF_STEM_TOP,
	CFF_STEM_NATIVE
};

/* Type 2 alignment zones are pairs of delta-encoded character-space
 * coordinates. A stem touching a zone needs coordinated blue alignment. */
class CFFBlueZones {
	private Vector<int> bounds = [];
	private int fuzz = 1;
	private bool usable = true;
	private bool familyZones = false;
	private Vector<bool> topZones = [];
	private double blueScale = 0.039625;

	public void read(CFFDict dictionary) {
		if (dictionary.count(265) >= 0) {
			if (dictionary.count(265) != 1) { self.usable = false; return; }
			self.blueScale = dictionary.number(265, 0);
			if (!(self.blueScale > 0.0 && self.blueScale <= 1.0)) { self.usable = false; return; }
		}
		if (dictionary.count(267) >= 0) {
			if (dictionary.count(267) != 1) { self.usable = false; return; }
			double n = dictionary.number(267, 0);
			if (!(n >= 0.0 && n <= 32767.0) || (double)(int)n != n) { self.usable = false; return; }
			self.fuzz = (int)n;
		}
		for (int key = 6; key <= 9; key++) {
			int count = dictionary.count(key);
			if (count < 0) { continue; }
			if (key >= 8 && count > 0) { self.familyZones = true; }
			if ((count & 1) != 0 || count > (key == 6 || key == 8 ? 14 : 10)) { self.usable = false; return; }
			int edge = 0;
			for (int i = 0; i < count; i++) {
				double delta = dictionary.number(key, i);
				if (!(delta >= -65535.0 && delta <= 65535.0) || (double)(int)delta != delta || ((i & 1) != 0 && delta < 0.0)) { self.usable = false; return; }
				edge += (int)delta;
				if (edge < -32768 || edge > 32767) { self.usable = false; return; }
				self.bounds.push(edge);
				// BlueValues begins with its bottom zone. Every OtherBlues
				// pair is a bottom zone, with the flat edge at the higher value.
				if ((i & 1) != 0) { self.topZones.push((key == 6 || key == 8) && i > 1); }
			}
		}
	}

	public CFFStemFit fit(int bottom, int top, bool single, long long scale) {
		if (!self.usable) { return CFF_STEM_NATIVE; }
		CFFStemFit fit = CFF_STEM_FREE;
		for (int i = 0; i < self.bounds.size(); i += 2) {
			int low = self.bounds.get(i);
			int high = self.bounds.get(i + 1);
			bool bottomHit = bottom >= low - self.fuzz && bottom <= high + self.fuzz;
			bool topHit = top >= low - self.fuzz && top <= high + self.fuzz;
			if (!bottomHit && !topHit) { continue; }
			if (!single || self.familyZones || fit != CFF_STEM_FREE || (bottomHit && topHit)) { return CFF_STEM_NATIVE; }
			bool topZone = self.topZones.get(i / 2);
			if (topZone && top == low) { fit = CFF_STEM_TOP; }
			else if (!topZone && bottom == high) { fit = CFF_STEM_BOTTOM; }
			else { return CFF_STEM_NATIVE; }

			// Below BlueScale, an outward boost of up to half a pixel
			// can change the rounded flat edge. Accept only edges whose
			// rounded destination is independent of the boost.
			if (scale <= 1LL + (long long)(self.blueScale * 65536.0)) {
				long long edge = (long long)(topZone ? top : bottom) * scale;
				long long residue = edge - OpenTypeFixed.floorDiv(edge, 65536LL) * 65536LL;
				if (topZone ? residue < 32768LL : residue >= 32768LL) { return CFF_STEM_NATIVE; }
			}
		}
		return fit;
	}
}
