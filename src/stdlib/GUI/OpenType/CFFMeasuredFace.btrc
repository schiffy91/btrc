import Library.Bytes;
import Library.GUI.IFontFace;

import ./CFFGlyphs.btrc;
import ./GlyphOutline.btrc;
import ./OpenTypeCharacterMap.btrc;
import ./OpenTypeData.btrc;
import ./OpenTypeHorizontalMetrics.btrc;
import ./OpenTypeLineMetrics.btrc;
import ./SFNTDirectory.btrc;
import ./WOFF2Font.btrc;
import ./WOFFFont.btrc;

/* First-party CFF1 OpenType reader and rasterizer supporting standalone OTF,
 * OTC collections, WOFF and WOFF2 containers. */
class CFFMeasuredFace implements IFontFace {
	private long long scale;
	private int pixels;
	private FontMetrics lineMetrics;
	private OpenTypeHorizontalMetrics horizontal;
	private OpenTypeCharacterMap characters;
	private CFFGlyphs outlines;
	private Atomic<uint> gate;

	public CFFMeasuredFace(Bytes bytes, int pixels, int faceOffset = 0) {
		self.gate.init(0u);
		if (pixels < 1 || pixels > 65535) { throw "Invalid CFF pixel size"; }
		self.pixels = pixels;
		unsigned int format = bytes.length() >= 4 ? bytes.readU32BE(0) : 0U;
		Bytes sfnt = bytes;
		if (format == 0x774f4632U) { sfnt = WOFF2Font().unpack(bytes); }
		else if (format == 0x774f4646U) { sfnt = WOFFFont().unpack(bytes); }
		var data = OpenTypeData(sfnt);
		int offset = faceOffset == 0 ? SFNTDirectory.firstFaceOffset(data) : faceOffset;
		var dir = SFNTDirectory(data, offset, true);
		var head = dir.required(0x68656164LL, 54);
		int units = data.u16(head.offset + 18);
		if (data.u32(head.offset) != 0x10000LL || data.u32(head.offset + 12) != 0x5f0f3cf5LL) { throw "Invalid OpenType font header"; }
		var maxp = dir.required(0x6d617870LL, 6);
		int count = data.u16(maxp.offset + 4);
		if (units < 16 || units > 16384 || count == 0) { throw "Invalid CFF font metrics"; }
		var hhea = dir.required(0x68686561LL, 36);
		if (data.u32(hhea.offset) != 0x10000LL || data.s16(hhea.offset + 32) != 0) { throw "Unsupported CFF horizontal metric format"; }
		int full = data.u16(hhea.offset + 34);
		if (full < 1 || full > count) { throw "Invalid CFF horizontal metrics"; }
		self.horizontal = OpenTypeHorizontalMetrics(data, dir.required(0x686d7478LL, 4 * full + 2 * (count - full)), full);
		self.scale = OpenTypeFixed.div((long long)pixels * 64LL, (long long)units);
		self.lineMetrics = OpenTypeLineMetrics.scaled(data, dir, hhea, self.scale);
		var map = dir.find(0x636d6170LL, 4);
		var mapSpan = OpenTypeSpan(0, 0);
		if (map != null) { mapSpan = map; }
		self.characters = OpenTypeCharacterMap(data, mapSpan, count);
		self.outlines = CFFGlyphs(data, dir.required(0x43464620LL, 4), units);
		if (self.outlines.glyphCount() != count) { throw "CFF charstring count disagrees with maxp"; }
	}

	public FontMetrics metrics() { return self.lineMetrics; }

	private bool claimGlyph() {
		uint expected = 0u;
		return self.gate.compareExchangeStrong(&expected, 1u, MemoryOrder.ACQ_REL, MemoryOrder.ACQUIRE);
	}

	public FontGlyph? glyph(int scalar, bool render) {
		if (scalar < 0 || scalar > 0x10ffff || (scalar >= 0xd800 && scalar <= 0xdfff)) { throw "Invalid font Unicode scalar"; }
		if (!self.claimGlyph()) { throw "FreeType face is already loading a glyph"; }
		FontGlyph? result = null;
		try {
			int glyph = self.characters.glyphIndex(scalar);
			var path = GlyphOutline();
			self.outlines.load(glyph, self.scale, path, render, self.pixels);
			long long advance = OpenTypeFixed.pixelRound(OpenTypeFixed.mul((long long)self.horizontal.advance(glyph), self.scale));
			if (render && !path.isEmpty()) { result = path.rasterize(advance, true); }
			else { result = new FontGlyph(advance, 0, 0, 0, 0, 0, render ? FONT_PIXEL_GRAY : FONT_PIXEL_UNSUPPORTED, render ? 256 : 0, new Bytes()); }
		} catch (string error) { result = null; }
		finally { self.gate.store(0u, MemoryOrder.RELEASE); }
		return result;
	}
}
