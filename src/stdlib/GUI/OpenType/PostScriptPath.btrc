import Library.Vector;

import ./CFFBlueZones.btrc;
import ./GlyphOutline.btrc;
import ./OpenTypeData.btrc;

/* Cubic outlines in both PostScript charstring formats use a relative pen
 * in 16.16 font units. Closing a contour preserves the current point. */
class PostScriptPath {
	public long long x = 0LL;
	public long long y = 0LL;
	private GlyphOutline outline;
	private long long scale;
	private bool open = false;
	private bool deviceSpace;
	private long long deviceScale;
	private Vector<int> stemEdges = [];
	private Vector<long long> fittedEdges = [];
	private Vector<long long> slopes = [];
	public bool integral = true;

	public PostScriptPath(GlyphOutline outline, long long scale, bool deviceSpace) {
		self.outline = outline;
		self.scale = scale;
		self.deviceSpace = deviceSpace;
		self.deviceScale = (scale + 32LL) / 64LL;
	}

	/* One free or baseline-anchored horizontal stem translates the outline.
	 * Snap its nearer edge to the pixel grid, preferring upward motion
	 * when equally close. An even device-space width preserves both
	 * half-widths exactly at 16.16 precision. */
	public bool alignStem(long long bottom, long long width, CFFBlueZones blues, bool single) {
		if (!self.deviceSpace || self.outline.pointCount() != 0 || width <= 0LL || bottom % 65536LL != 0LL || width % 65536LL != 0LL) { return false; }
		if (bottom < -2147483648LL || bottom + width > 2147483647LL) { return false; }
		int low = (int)(bottom / 65536LL);
		int high = low + (int)(width / 65536LL);
		if (!blues.allowsStem(low, high, single)) { return false; }
		long long a = (long long)low * self.deviceScale;
		long long b = (long long)high * self.deviceScale;
		if (((b - a) & 1LL) != 0LL) { return false; }
		long long lower = OpenTypeFixed.floorDiv(a + 32768LL, 65536LL) * 65536LL - a;
		long long upper = OpenTypeFixed.floorDiv(b + 32768LL, 65536LL) * 65536LL - b;
		long long lowerDistance = lower < 0LL ? -lower : lower;
		long long upperDistance = upper < 0LL ? -upper : upper;
		long long shift = lowerDistance < upperDistance || (lowerDistance == upperDistance && lower > upper) ? lower : upper;
		int previous = self.stemEdges.size() - 1;
		if (previous >= 0) {
			// Keep at least a full device pixel between stems before and
			// after fitting. Closer stems need coordinated counter fitting.
			if (a - (long long)self.stemEdges.get(previous) * self.deviceScale < 65536LL || a + shift - self.fittedEdges.get(previous) < 65536LL) { return false; }
		}
		self.addEdge(low, a + shift);
		self.addEdge(high, b + shift);
		return true;
	}

	private void addEdge(int design, long long position) {
		int previous = self.stemEdges.size() - 1;
		if (previous >= 0) {
			int span = design - self.stemEdges.get(previous);
			long long rise = position - self.fittedEdges.get(previous);
			self.slopes.set(previous, (rise + (long long)span / 2LL) / (long long)span);
		}
		self.stemEdges.push(design);
		self.fittedEdges.push(position);
		self.slopes.push(self.deviceScale);
	}

	private long long pixelY(int design) {
		if (self.stemEdges.size() == 0) { return (long long)design * self.deviceScale; }
		int first = 0;
		int limit = self.stemEdges.size();
		while (first < limit) {
			int middle = first + (limit - first) / 2;
			if (self.stemEdges.get(middle) <= design) { first = middle + 1; }
			else { limit = middle; }
		}
		// An edge is the exact origin of the following segment. Using the
		// preceding rounded slope at the edge can lose 1/64 of a pixel.
		int edge = first == 0 ? 0 : first - 1;
		long long slope = first == 0 ? self.deviceScale : self.slopes.get(edge);
		return self.fittedEdges.get(edge) + (long long)(design - self.stemEdges.get(edge)) * slope;
	}

	public void close() {
		if (self.open) { self.outline.closeContour(); }
		self.open = false;
	}

	private void point(GlyphPointKind kind) {
		if (self.x > 8589934592LL || self.x < -8589934592LL || self.y > 8589934592LL || self.y < -8589934592LL) { throw "PostScript outline leaves the supported coordinate range"; }
		if (self.deviceSpace) {
			// A Type 2 device transform uses a 16.16 pixel-per-unit scale.
			// Floor to 26.6 after multiplying, including negative positions.
			if (self.x % 65536LL != 0LL || self.y % 65536LL != 0LL) { self.integral = false; }
			long long dx = OpenTypeFixed.floorDiv((self.x / 65536LL) * self.deviceScale, 1024LL);
			long long dy = OpenTypeFixed.floorDiv(self.pixelY((int)(self.y / 65536LL)), 1024LL);
			self.outline.addPoint(dx, dy, kind);
		} else {
			self.outline.addPoint(OpenTypeFixed.mul(PostScriptPath.units(self.x), self.scale), OpenTypeFixed.mul(PostScriptPath.units(self.y), self.scale), kind);
		}
	}

	/* A 16.16 coordinate in whole font units: to the nearest 1/1024, then
	 * down. Outlines are drawn in whole units, as the fonts are. */
	class long long units(long long value) { return OpenTypeFixed.floorDiv(OpenTypeFixed.mul(value, 1024LL), 1024LL); }

	public void moveBy(long long dx, long long dy) {
		if (self.open) { self.outline.closeContour(); }
		self.x += dx;
		self.y += dy;
		self.point(GLYPH_POINT_ON);
		self.open = true;
	}

	private void begin() {
		if (!self.open) {
			self.point(GLYPH_POINT_ON);
			self.open = true;
		}
	}

	public void lineBy(long long dx, long long dy) {
		self.begin();
		self.x += dx;
		self.y += dy;
		self.point(GLYPH_POINT_ON);
	}

	public void curveBy(long long dx1, long long dy1, long long dx2, long long dy2, long long dx3, long long dy3) {
		self.begin();
		self.x += dx1;
		self.y += dy1;
		self.point(GLYPH_POINT_CUBIC);
		self.x += dx2;
		self.y += dy2;
		self.point(GLYPH_POINT_CUBIC);
		self.x += dx3;
		self.y += dy3;
		self.point(GLYPH_POINT_ON);
	}
}
