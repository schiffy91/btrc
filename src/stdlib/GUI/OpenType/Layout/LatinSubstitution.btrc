import Library.Vector;

import ./GlyphRun.btrc;
import ./LayoutTable.btrc;

class LatinSubstitution {
	private LayoutTable table;
	private LayoutGlyphRun run;
	private int glyphCount;
	private int work = 0;

	public LatinSubstitution(LayoutTable table, LayoutGlyphRun run, int glyphCount) {
		self.table = table;
		self.run = run;
		self.glyphCount = glyphCount;
		for lookup in table.order {
			for (int p = 0; p < run.glyphs.size();) {
				int used = self.lookupAt(lookup, p, 0);
				p += used == 0 ? 1 : used;
			}
		}
	}

	private int valid(int id) {
		if (id < 0 || id >= self.glyphCount) { throw "Invalid substituted glyph"; }
		return id;
	}

	private int lookupAt(int lookup, int p, int depth) {
		self.work++;
		if (depth > 16 || self.work > 262144) { throw "Layout substitution limit exceeded"; }
		var data = self.table.data;
		int base = self.table.lookup(lookup);
		int flags = data.u16(base + 2);
		// The caller excludes all mark glyphs. Ignoring or filtering marks
		// consequently leaves the sequence of printable Latin glyphs intact.
		if ((flags & ~0xff18) != 0) { throw "Unsupported Latin substitution flags"; }
		int count = data.u16(base + 4);
		for (int i = 0; i < count; i++) {
			int kind = data.u16(base);
			int sub = self.table.subtable(base, i);
			if (kind == 7) {
				kind = data.u16(sub + 2);
				sub = self.table.extension(sub);
			}
			int used = self.apply(kind, sub, p, depth);
			if (used != 0) { return used; }
		}
		return 0;
	}

	private int apply(int kind, int sub, int p, int depth) {
		var data = self.table.data;
		int format = data.u16(sub);
		if (kind == 6 && format == 3) { return self.chain(sub, p, depth); }
		if ((kind == 5 && format == 3) || kind < 1 || kind > 8) { throw "Unsupported Latin substitution"; }
		var glyph = self.run.glyphs.get(p);
		int index = self.table.coverage(sub + data.u16(sub + 2), glyph.id);
		if (index < 0) { return 0; }
		if (kind == 6 && format == 2) { return self.chainedClasses(sub, p, depth); }
		if (kind == 1) {
			if (format == 1) { glyph.id = self.valid((glyph.id + data.s16(sub + 4)) & 65535); }
			else if (format == 2 && index < data.u16(sub + 4)) { glyph.id = self.valid(data.u16(sub + 6 + index * 2)); }
			else { throw "Invalid Latin single substitution"; }
			return 1;
		}
		if ((kind != 2 && kind != 4) || format != 1 || index >= data.u16(sub + 4)) { throw "Unsupported Latin substitution on selected glyph"; }
		int set = sub + data.u16(sub + 6 + index * 2);
		int count = data.u16(set);
		if (kind == 2) {
			if (count < 1 || count > 16 || self.run.glyphs.size() > 8192 - count) { throw "Invalid Latin multiple substitution"; }
			glyph.id = self.valid(data.u16(set + 2));
			for (int i = 1; i < count; i++) {
				self.run.glyphs.insert(p + i, new LayoutGlyph(self.valid(data.u16(set + 2 + i * 2)), glyph.cluster));
			}
			return count;
		}
		for (int i = 0; i < count; i++) {
			int lig = set + data.u16(set + 2 + i * 2);
			int parts = data.u16(lig + 2);
			if (parts < 2 || parts > self.run.glyphs.size() - p) { continue; }
			int j = 1;
			while (j < parts && self.run.glyphs.get(p + j).id == data.u16(lig + 2 + j * 2)) { j++; }
			if (j != parts) { continue; }
			glyph.id = self.valid(data.u16(lig));
			for (int n = 1; n < parts; n++) { self.run.glyphs.remove(p + 1); }
			return 1;
		}
		return 0;
	}

	/* Format two groups glyphs into classes for each part of a rule.
	 * Backtrack classes are stored nearest first. The first input class
	 * selects the rule set and is implicit in its input sequence. */
	private int chainedClasses(int sub, int p, int depth) {
		var data = self.table.data;
		int backClasses = sub + data.u16(sub + 4);
		int inputClasses = sub + data.u16(sub + 6);
		int lookClasses = sub + data.u16(sub + 8);
		int first = LayoutTable.glyphClass(data, inputClasses, self.run.glyphs.get(p).id);
		if (first >= data.u16(sub + 10)) { return 0; }
		int setOffset = data.u16(sub + 12 + 2 * first);
		if (setOffset == 0) { return 0; }
		int set = sub + setOffset;
		int rules = data.u16(set);
		for (int i = 0; i < rules; i++) {
			self.work++;
			if (self.work > 262144) { throw "Layout substitution limit exceeded"; }
			int rule = set + data.u16(set + 2 + i * 2);
			int back = data.u16(rule);
			if (back > p || !self.classesMatch(backClasses, rule + 2, back, p - 1, -1)) { continue; }
			int at = rule + 2 + back * 2;
			int input = data.u16(at);
			if (input < 1 || input > self.run.glyphs.size() - p || !self.classesMatch(inputClasses, at + 2, input - 1, p + 1, 1)) { continue; }
			at += input * 2;
			int look = data.u16(at);
			if (look > self.run.glyphs.size() - p - input || !self.classesMatch(lookClasses, at + 2, look, p + input, 1)) { continue; }
			return self.contextRecords(at + 2 + look * 2, p, input, depth);
		}
		return 0;
	}

	private bool classesMatch(int definitions, int classes, int count, int p, int step) {
		var data = self.table.data;
		self.work += count;
		if (self.work > 262144) { throw "Layout substitution limit exceeded"; }
		for (int i = 0; i < count; i++) {
			if (LayoutTable.glyphClass(data, definitions, self.run.glyphs.get(p).id) != data.u16(classes + i * 2)) { return false; }
			p += step;
		}
		return true;
	}

	private int chain(int sub, int p, int depth) {
		var data = self.table.data;
		int back = data.u16(sub + 2);
		if (back > p) { return 0; }
		int at = sub + 4;
		for (int i = 0; i < back; i++) {
			if (self.table.coverage(sub + data.u16(at), self.run.glyphs.get(p - 1 - i).id) < 0) { return 0; }
			at += 2;
		}
		int input = data.u16(at);
		at += 2;
		if (input < 1 || input > self.run.glyphs.size() - p) { return 0; }
		for (int i = 0; i < input; i++) {
			if (self.table.coverage(sub + data.u16(at), self.run.glyphs.get(p + i).id) < 0) { return 0; }
			at += 2;
		}
		int look = data.u16(at);
		at += 2;
		if (look > self.run.glyphs.size() - p - input) { return 0; }
		for (int i = 0; i < look; i++) {
			if (self.table.coverage(sub + data.u16(at), self.run.glyphs.get(p + input + i).id) < 0) { return 0; }
			at += 2;
		}
		return self.contextRecords(at, p, input, depth);
	}

	private int contextRecords(int at, int p, int input, int depth) {
		var data = self.table.data;
		int records = data.u16(at);
		at += 2;
		int before = self.run.glyphs.size();
		for (int i = 0; i < records; i++) {
			int pos = data.u16(at);
			if (pos >= input) { throw "Invalid Latin contextual position"; }
			self.lookupAt(data.u16(at + 2), p + pos, depth + 1);
			if (self.run.glyphs.size() != before) { throw "Unsupported length-changing Latin context"; }
			at += 4;
		}
		return input;
	}
}
