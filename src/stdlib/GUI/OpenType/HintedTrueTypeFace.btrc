import Library.Bytes;
import Library.GUI.IFontFace;

import ./GlyphOutline.btrc;
import ./Hinting/Program.btrc;
import ./OpenTypeCharacterMap.btrc;
import ./OpenTypeData.btrc;
import ./OpenTypeHorizontalMetrics.btrc;
import ./OpenTypeLineMetrics.btrc;
import ./SFNTDirectory.btrc;
import ./TrueTypeGlyphs.btrc;
import ./WOFF2Font.btrc;
import ./WOFFFont.btrc;

/* First-party TrueType outline reader, bytecode interpreter and grayscale
 * rasterizer covering hinted and unhinted SFNT, TTC, WOFF and WOFF2 faces. */
class HintedTrueTypeFace implements IFontFace {
	private TrueTypeGlyphs outlines;
	private OpenTypeCharacterMap characters;
	private long long scale;
	private FontMetrics lineMetrics;
	private bool fixedCrossings = false;
	private Atomic<uint> gate;

	public HintedTrueTypeFace(Bytes bytes, int pixels, bool byGlyphIndex = false, int faceOffset = 0) {
		self.gate.init(0u);
		if (pixels < 1 || pixels > 65535) { throw "Invalid TrueType pixel size"; }
		unsigned int format = bytes.length() >= 4 ? bytes.readU32BE(0) : 0U;
		Bytes sfnt = bytes;
		if (format == 0x774f4632U) { sfnt = WOFF2Font().unpack(bytes); }
		else if (format == 0x774f4646U) { sfnt = WOFFFont().unpack(bytes); }
		var data = OpenTypeData(sfnt);
		int offset = faceOffset == 0 ? SFNTDirectory.firstFaceOffset(data) : faceOffset;
		var directory = SFNTDirectory(data, offset);
		var head = directory.required(0x68656164LL, 54);
		int units = data.u16(head.offset + 18);
		int locaFormat = data.s16(head.offset + 50);
		if (units < 16 || units > 16384 || (locaFormat != 0 && locaFormat != 1)) { throw "Unsupported TrueType size or outline locations"; }
		self.scale = OpenTypeFixed.div((long long)pixels * 64LL, (long long)units);
		var maxp = directory.required(0x6d617870LL, 6);
		int glyphs = data.u16(maxp.offset + 4);
		if (glyphs < 1) { throw "Unsupported TrueType glyph directory"; }
		var hhea = directory.required(0x68686561LL, 36);
		int full = data.u16(hhea.offset + 34);
		if (full < 1 || full > glyphs) { throw "Invalid TrueType horizontal metric count"; }
		var hmtx = directory.required(0x686d7478LL, full * 4 + (glyphs - full) * 2);
		var horizontal = OpenTypeHorizontalMetrics(data, hmtx, full);
		var loca = directory.required(0x6c6f6361LL, (glyphs + 1) * (locaFormat == 0 ? 2 : 4));
		self.outlines = TrueTypeGlyphs(data, directory.required(0x676c7966LL, 0), loca, horizontal, glyphs, locaFormat != 0);
		var cmap = directory.find(0x636d6170LL, 4);
		var cmapSpan = OpenTypeSpan(0, 0);
		if (cmap != null) { cmapSpan = cmap; }
		self.characters = OpenTypeCharacterMap(data, cmapSpan, glyphs);
		self.lineMetrics = OpenTypeLineMetrics.scaled(data, directory, hhea, self.scale);

		if (maxp.length >= 32 && data.u32(maxp.offset) == 65536LL) {
			var cvt = directory.find(0x63767420LL, 0);
			var prep = directory.find(0x70726570LL, 0);
			var functions = directory.find(0x6670676dLL, 0);
			int maxInstructions = data.u16(maxp.offset + 26);
			if (cvt != null || prep != null || functions != null || maxInstructions > 0) {
				var cvtSpan = OpenTypeSpan(0, 0);
				if (cvt != null) { cvtSpan = cvt; }
				var prepSpan = OpenTypeSpan(0, 0);
				if (prep != null) { prepSpan = prep; }
				var fpgmSpan = OpenTypeSpan(0, 0);
				if (functions != null) { fpgmSpan = functions; }
				var grid = TrueTypeProgram(data, cvtSpan, maxp, pixels, self.scale);
				bool usesVectors = grid.prepare(fpgmSpan, prepSpan, true);
				self.fixedCrossings = usesVectors && !byGlyphIndex && grid.gridFittingEnabled();
				self.outlines.prepare(grid);
			}
		}
	}

	public FontMetrics metrics() { return self.lineMetrics; }

	private bool claimGlyph() {
		uint expected = 0u;
		return self.gate.compareExchangeStrong(&expected, 1u, MemoryOrder.ACQ_REL, MemoryOrder.ACQUIRE);
	}

	public FontGlyph? glyph(int codepoint, bool render) {
		if (codepoint < 0 || codepoint > 0x10ffff || (codepoint >= 0xd800 && codepoint <= 0xdfff)) { throw "Invalid font Unicode scalar"; }
		if (!self.claimGlyph()) { throw "FreeType face is already loading a glyph"; }
		FontGlyph? result = null;
		try { result = self.glyphByIndex(self.characters.glyphIndex(codepoint), render); }
		catch (string error) { result = null; }
		finally { self.gate.store(0u, MemoryOrder.RELEASE); }
		return result;
	}

	public FontGlyph glyphByIndex(int glyph, bool render) {
		var outline = GlyphOutline();
		long long advance = OpenTypeFixed.pixelRound(self.outlines.load(glyph, self.scale, outline));
		if (!render) { return new FontGlyph(advance, 0, 0, 0, 0, 0, FONT_PIXEL_UNSUPPORTED, 0, new Bytes()); }
		if (outline.isEmpty()) { return new FontGlyph(advance, 0, 0, 0, 0, 0, FONT_PIXEL_GRAY, 256, new Bytes()); }
		return outline.rasterize(advance, self.fixedCrossings);
	}
}
