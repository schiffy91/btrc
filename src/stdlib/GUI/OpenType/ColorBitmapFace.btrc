import Library.Bytes;
import Library.GUI.IFontFace;

import ./BitmapStrike.btrc;
import ./OpenTypeCharacterMap.btrc;
import ./OpenTypeHorizontalMetrics.btrc;

/* Bitmap-only SFNTs carrying horizontal PNG strikes. Read just the offset
 * table first so ordinary outline fonts can go straight to their provider. */
class ColorBitmapFace implements IFontFace {
	private OpenTypeCharacterMap characters;
	private OpenTypeHorizontalMetrics horizontal;
	private long long scale;
	private BitmapStrike strike;
	private FontMetrics lineMetrics;
	private Atomic<uint> gate;
	private int grayCount = 0;

	class ColorBitmapFace? tryOpen(string path, int pixels) {
		if (path == null || pixels < 1 || pixels > 255) { return null; }
		string name = path.toLower();
		if (!name.endsWith(".ttf") && !name.endsWith(".otf")) { return null; }
		FILE* file = fopen(path, "rb");
		if (file == null) { return null; }
		try {
			var header = Bytes.zeros(12);
			if (fread(header.data, 1, 12, file) != (size_t)12 || header.readU32BE(0) != 0x10000U) { return null; }
			int count = header.readU16BE(4);
			if (count == 0 || count > 4096) { return null; }
			var directory = Bytes.zeros(count * 16);
			if (fread(directory.data, 1, (size_t)directory.length(), file) != (size_t)directory.length()) { return null; }
			bool color = false;
			for (int i = 0; i < count; i++) {
				unsigned int tag = directory.readU32BE(i * 16);
				if (tag == 0x43424c43U) { color = true; } // CBLC
				// Scalable outlines (glyf, CFF, CFF2), other bitmap tables
				// (sbix, EBLC, bloc), and variations (fvar) stay with the SDK.
				if (tag == 0x676c7966U || tag == 0x43464620U || tag == 0x43464632U || tag == 0x73626978U || tag == 0x45424c43U || tag == 0x626c6f63U || tag == 0x66766172U) { return null; }
			}
			if (!color || fseek(file, 0L, SEEK_END) != 0) { return null; }
			long length = ftell(file);
			if (length < 12L || length > 268435456L || fseek(file, 0L, SEEK_SET) != 0) { return null; }
			var bytes = Bytes.zeros((int)length);
			if (fread(bytes.data, 1, (size_t)length, file) != (size_t)length) { return null; }
			return new ColorBitmapFace(bytes, pixels);
		} catch (string error) { return null; }
		finally { fclose(file); }
	}

	public ColorBitmapFace(Bytes bytes, int pixels) {
		self.gate.init(0u);
		var data = OpenTypeData(bytes);
		int count = data.u16(4);
		data.need(12LL, (long long)count * 16LL);
		var head = self.table(data, count, 0x68656164LL, 54);
		int units = data.u16(head.offset + 18);
		if (units < 16 || units > 16384) { throw "Invalid bitmap font units"; }
		var maxp = self.table(data, count, 0x6d617870LL, 6);
		int glyphs = data.u16(maxp.offset + 4);
		if (glyphs == 0) { throw "Bitmap font has no glyphs"; }
		var hhea = self.table(data, count, 0x68686561LL, 36);
		int metrics = data.u16(hhea.offset + 34);
		if (metrics == 0 || metrics > glyphs) { throw "Invalid bitmap font horizontal metrics"; }
		var hmtx = self.table(data, count, 0x686d7478LL, metrics * 4 + (glyphs - metrics) * 2);
		self.horizontal = OpenTypeHorizontalMetrics(data, hmtx, metrics);
		self.scale = OpenTypeFixed.div((long long)pixels * 64LL, (long long)units);
		var cmap = self.table(data, count, 0x636d6170LL, 4);
		self.characters = OpenTypeCharacterMap(data, cmap, glyphs);
		if (!self.characters.unambiguousUnicodeMap(cmap)) { throw "No supported bitmap character map"; }
		var locations = self.table(data, count, 0x43424c43LL, 8);
		var images = self.table(data, count, 0x43424454LL, 4);
		var strike = BitmapStrike.select(data, locations, images, pixels);
		if (strike == null) { throw "No supported color bitmap strike at the requested size"; }
		self.strike = strike;
		self.lineMetrics = new FontMetrics((long long)strike.ascender * 64LL, (long long)strike.height * 64LL);
	}

	private OpenTypeSpan table(OpenTypeData data, int count, long long tag, int minimum) {
		for (int i = 0; i < count; i++) {
			int at = 12 + i * 16;
			if (data.u32(at) != tag) { continue; }
			long long offset = data.u32(at + 8);
			long long length = data.u32(at + 12);
			data.need(offset, length);
			if (length < (long long)minimum) { throw "Truncated bitmap font table"; }
			return OpenTypeSpan((int)offset, (int)length);
		}
		throw "Missing bitmap font table";
	}

	public FontMetrics metrics() { return self.lineMetrics; }

	private bool claimGlyph() {
		uint expected = 0u;
		return self.gate.compareExchangeStrong(&expected, 1u, MemoryOrder.ACQ_REL, MemoryOrder.ACQUIRE);
	}

	public FontGlyph? glyph(int code, bool render) {
		if (code < 0 || code > 0x10ffff || (code >= 0xd800 && code <= 0xdfff)) { throw "Invalid font Unicode scalar"; }
		if (!self.claimGlyph()) { throw "FreeType face is already loading a glyph"; }
		try { return self.loadGlyph(code, render); }
		finally { self.gate.store(0u, MemoryOrder.RELEASE); }
	}

	private FontGlyph? loadGlyph(int code, bool render) {
		int id = self.characters.glyphIndex(code);
		try {
			var glyph = self.strike.glyph(id, render);
			if (glyph != null) {
				// The native bitmap slot retains its gray count on empty glyphs,
				// including after a measurement-only load of a color glyph.
				self.grayCount = 256;
				return glyph;
			}
			long long advance = OpenTypeFixed.mul((long long)self.horizontal.advance(id), self.scale);
			return new FontGlyph(advance, 0, 0, 0, 0, 0, render ? FONT_PIXEL_MONO : FONT_PIXEL_UNSUPPORTED, render ? self.grayCount : 0, new Bytes());
		} catch (string error) { return null; }
	}
}
