import Library.Bytes;
import Library.GUI.IFontFace;

import ./BitmapStrike.btrc;
import ./OpenTypeCharacterMap.btrc;
import ./OpenTypeData.btrc;
import ./OpenTypeHorizontalMetrics.btrc;
import ./SFNTDirectory.btrc;

/* Bitmap-only SFNTs carrying horizontal CBLC/CBDT color PNG strikes or
 * EBLC/EBDT / bloc/bdat monochrome and grayscale strikes. */
class ColorBitmapFace implements IFontFace {
	private OpenTypeCharacterMap characters;
	private OpenTypeHorizontalMetrics horizontal;
	private long long scale;
	private BitmapStrike strike;
	private FontMetrics lineMetrics;
	private Atomic<uint> gate;
	private int grayCount = 0;

	public ColorBitmapFace(Bytes bytes, int pixels, int faceOffset = 0) {
		self.gate.init(0u);
		if (pixels < 1 || pixels > 255) { throw "Invalid bitmap strike pixel size"; }
		var data = OpenTypeData(bytes);
		int offset = faceOffset == 0 ? SFNTDirectory.firstFaceOffset(data) : faceOffset;
		var directory = SFNTDirectory(data, offset, true);
		var head = directory.required(0x68656164LL, 54);
		int units = data.u16(head.offset + 18);
		if (units < 16 || units > 16384) { throw "Invalid bitmap font units"; }
		var maxp = directory.required(0x6d617870LL, 6);
		int glyphs = data.u16(maxp.offset + 4);
		if (glyphs == 0) { throw "Bitmap font has no glyphs"; }
		var hhea = directory.required(0x68686561LL, 36);
		int metrics = data.u16(hhea.offset + 34);
		if (metrics == 0 || metrics > glyphs) { throw "Invalid bitmap font horizontal metrics"; }
		var hmtx = directory.required(0x686d7478LL, metrics * 4 + (glyphs - metrics) * 2);
		self.horizontal = OpenTypeHorizontalMetrics(data, hmtx, metrics);
		self.scale = OpenTypeFixed.div((long long)pixels * 64LL, (long long)units);
		var cmap = directory.find(0x636d6170LL, 4);
		var cmapSpan = OpenTypeSpan(0, 0);
		if (cmap != null) { cmapSpan = cmap; }
		self.characters = OpenTypeCharacterMap(data, cmapSpan, glyphs);

		BitmapStrike? selected = null;
		var cblc = directory.find(0x43424c43LL, 8);
		var cbdt = directory.find(0x43424454LL, 4);
		if (cblc != null && cbdt != null) {
			selected = BitmapStrike.select(data, cblc, cbdt, pixels, true);
		}
		if (selected == null) {
			var eblc = directory.find(0x45424c43LL, 8);
			var ebdt = directory.find(0x45424454LL, 4);
			if (eblc != null && ebdt != null) {
				selected = BitmapStrike.select(data, eblc, ebdt, pixels, false);
			}
		}
		if (selected == null) {
			var bloc = directory.find(0x626c6f63LL, 8);
			var bdat = directory.find(0x62646174LL, 4);
			if (bloc != null && bdat != null) {
				selected = BitmapStrike.select(data, bloc, bdat, pixels, false);
			}
		}
		if (selected == null) { throw "No supported bitmap strike at the requested size"; }
		self.strike = selected;
		self.lineMetrics = new FontMetrics((long long)selected.ascender * 64LL, (long long)selected.height * 64LL);
	}

	public FontMetrics metrics() { return self.lineMetrics; }

	private bool claimGlyph() {
		uint expected = 0u;
		return self.gate.compareExchangeStrong(&expected, 1u, MemoryOrder.ACQ_REL, MemoryOrder.ACQUIRE);
	}

	public FontGlyph? glyph(int code, bool render) {
		if (code < 0 || code > 0x10ffff || (code >= 0xd800 && code <= 0xdfff)) { throw "Invalid font Unicode scalar"; }
		if (!self.claimGlyph()) { throw "FreeType face is already loading a glyph"; }
		try { return self.loadGlyph(code, render); }
		finally { self.gate.store(0u, MemoryOrder.RELEASE); }
	}

	private FontGlyph? loadGlyph(int code, bool render) {
		int id = self.characters.glyphIndex(code);
		try {
			var glyph = self.strike.glyph(id, render);
			if (glyph != null) {
				self.grayCount = 256;
				return glyph;
			}
			long long advance = OpenTypeFixed.mul((long long)self.horizontal.advance(id), self.scale);
			return new FontGlyph(advance, 0, 0, 0, 0, 0, render ? FONT_PIXEL_MONO : FONT_PIXEL_UNSUPPORTED, render ? self.grayCount : 0, new Bytes());
		} catch (string error) { return null; }
	}
}
