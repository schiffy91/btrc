import Library.Array;
import Library.Vector;

import ../OpenTypeData.btrc;
import ./Zone.btrc;

/* A normalized TrueType 2.14 direction. Vectors from two outline
 * points preserve their sign, including when rotated by 90 degrees. */
class HintDirection {
	public int x = 16384;
	public int y = 0;

	public void set(long long x, long long y) {
		if (y == 0LL) { self.x = x < 0LL ? -16384 : 16384; self.y = 0; return; }
		if (x == 0LL) { self.x = 0; self.y = y < 0LL ? -16384 : 16384; return; }
		double factor = 16384.0 / sqrt((double)x * (double)x + (double)y * (double)y);
		self.x = (int)round((double)x * factor);
		self.y = (int)round((double)y * factor);
	}

	public long long project(long long x, long long y) {
		long long dot = (long long)self.x * x + (long long)self.y * y;
		return dot < 0LL ? -((-dot + 8192LL) / 16384LL) : (dot + 8192LL) / 16384LL;
	}
}

class TrueTypeSettings {
	public int roundPeriod = 64;
	public int roundPhase = 0;
	public int roundThreshold = 32;
	public int deltaBase = 9;
	public int deltaShift = 3;
	public int cutIn = 68;
	public int minimumDistance = 64;

	public void copyFrom(TrueTypeSettings other) {
		self.roundPeriod = other.roundPeriod;
		self.roundPhase = other.roundPhase;
		self.roundThreshold = other.roundThreshold;
		self.deltaBase = other.deltaBase;
		self.deltaShift = other.deltaShift;
		self.cutIn = other.cutIn;
		self.minimumDistance = other.minimumDistance;
	}
}

/* A size-specific TrueType instruction context. Program addresses are
 * spans of the checked font data. Control-flow scans skip complete PUSH
 * instructions so an operand byte can never be mistaken for ELSE/ENDF.
 * Calls and instructions share one work budget per execution. */
class TrueTypeProgram {
	private OpenTypeData data;
	private long long scale;
	private int ppem;
	private Array<int> storage;
	private Array<int> cvt;
	private TrueTypeZone twilight;
	private TrueTypeZone points;
	private Vector<int> stack = [];
	private Vector<int> functionIds = [];
	private Vector<OpenTypeSpan> functions = [];
	private int budget = 0;
	private int stackLimit;
	private int functionsLimit;
	private int zp0 = 1;
	private int zp1 = 1;
	private int zp2 = 1;
	private int rp0 = 0;
	private int rp1 = 0;
	private int rp2 = 0;
	private int loopCount = 1;
	private int interpolatedAxes = 0;
	private bool compositeGlyph = false;
	private bool projectX = true;
	private bool freedomX = true;
	private HintDirection projection = HintDirection();
	private HintDirection freedom = HintDirection();
	private HintDirection dual = HintDirection();
	private TrueTypeSettings settings;
	private TrueTypeSettings preparedSettings;
	private Array<int> preparedStorage;
	private Array<int> preparedCVT;
	private TrueTypeZone preparedTwilight;
	private bool enabled = true;
	private bool preparing = true;
	private bool generalVectors = false;

	public TrueTypeProgram(OpenTypeData data, OpenTypeSpan cvt, OpenTypeSpan maxp, int ppem, long long scale) {
		self.data = data;
		self.settings = TrueTypeSettings();
		self.preparedSettings = TrueTypeSettings();
		self.ppem = ppem;
		self.scale = scale;
		if (maxp.length < 32) { throw "Missing TrueType interpreter limits"; }
		self.storage = new Array<int>(data.u16(maxp.offset + 18));
		self.cvt = new Array<int>(cvt.length / 2);
		for (int i = 0; i < self.cvt.len; i++) {
			self.cvt.set(i, (int)OpenTypeFixed.mul((long long)data.s16(cvt.offset + i * 2), scale));
		}
		self.twilight = TrueTypeZone(data.u16(maxp.offset + 16) + 4);
		self.points = TrueTypeZone(0);
		self.preparedTwilight = TrueTypeZone(self.twilight.count);
		self.preparedStorage = new Array<int>(self.storage.len);
		self.preparedCVT = new Array<int>(self.cvt.len);
		self.stackLimit = data.u16(maxp.offset + 24) + 32;
		self.functionsLimit = data.u16(maxp.offset + 20);
	}

	private int pop() {
		if (self.stack.size() == 0) { throw "TrueType instruction stack underflow"; }
		return self.stack.pop();
	}

	private void push(long long value) {
		if (self.stack.size() >= self.stackLimit) { throw "TrueType instruction stack overflow"; }
		self.stack.push((int)(unsigned int)value);
	}

	private int operandCount(int op, int pc, int end) {
		if (op >= 0xb0 && op <= 0xbf) { return ((op & 7) + 1) * (op >= 0xb8 ? 2 : 1); }
		if (op != 0x40 && op != 0x41) { return 0; }
		if (pc >= end) { throw "Truncated TrueType push count"; }
		return 1 + self.data.u8(pc) * (op == 0x41 ? 2 : 1);
	}

	private void charge(int work) {
		if (work > self.budget) { throw "TrueType instruction budget exceeded"; }
		self.budget -= work;
	}

	private int skip(int pc, int end, bool definition, bool seekElse) {
		int nested = 0;
		while (pc < end) {
			self.charge(1);
			int op = self.data.u8(pc);
			pc++;
			if (definition && op == 0x2d) { return pc; }
			if (!definition) {
				if (op == 0x58) { nested++; }
				if (op == 0x1b && nested == 0 && seekElse) { return pc; }
				if (op == 0x59) {
					if (nested == 0) { return pc; }
					nested--;
				}
			}
			int length = self.operandCount(op, pc, end);
			if (length > end - pc) { throw "Truncated TrueType push data"; }
			pc += length;
		}
		throw "Unterminated TrueType conditional or definition";
	}

	private void call(int id, int depth, int repetitions) {
		int index = self.functionIds.indexOf(id);
		if (index < 0 || repetitions < 0 || repetitions > self.budget || depth >= 64) { throw "Invalid TrueType function call"; }
		var body = self.functions.get(index);
		for (int i = 0; i < repetitions; i++) {
			self.charge(1);
			self.execute(body, depth + 1);
		}
	}

	private int off(int pc, int delta, OpenTypeSpan code) {
		long long target = (long long)pc - 1LL + (long long)delta;
		if (target < (long long)code.offset || target > (long long)code.end()) { throw "TrueType jump outside program"; }
		return (int)target;
	}

	private void calculate(int op) {
		long long b = (long long)self.pop();
		if (op == 0x5c) { self.push(b == 0LL ? 1LL : 0LL); return; }
		if (op == 0x64) { self.push(b < 0LL ? -b : b); return; }
		if (op == 0x65) { self.push(-b); return; }
		if (op == 0x66) { self.push(OpenTypeFixed.pixelFloor(b)); return; }
		if (op == 0x67) { self.push(OpenTypeFixed.pixelCeil(b)); return; }
		long long a = (long long)self.pop();
		if (op == 0x50) { self.push(a < b ? 1LL : 0LL); }
		else if (op == 0x51) { self.push(a <= b ? 1LL : 0LL); }
		else if (op == 0x52) { self.push(a > b ? 1LL : 0LL); }
		else if (op == 0x53) { self.push(a >= b ? 1LL : 0LL); }
		else if (op == 0x54) { self.push(a == b ? 1LL : 0LL); }
		else if (op == 0x55) { self.push(a != b ? 1LL : 0LL); }
		else if (op == 0x5a) { self.push(a != 0LL && b != 0LL ? 1LL : 0LL); }
		else if (op == 0x5b) { self.push(a != 0LL || b != 0LL ? 1LL : 0LL); }
		else if (op == 0x60) { self.push(a + b); }
		else if (op == 0x61) { self.push(a - b); }
		else if (op == 0x62) {
			if (b == 0LL) { throw "Division by zero in TrueType program"; }
			self.push((a * 64LL) / b);
		} else if (op == 0x63) {
			long long product = a * b;
			self.push(product < 0LL ? -((-product + 32LL) / 64LL) : (product + 32LL) / 64LL);
		} else if (op == 0x8b) { self.push(a > b ? a : b); }
		else { self.push(a < b ? a : b); }
	}

	private int round(int value) {
		if (self.settings.roundPeriod == 0) { return value; }
		long long distance = value < 0 ? -(long long)value : (long long)value;
		long long rounded = OpenTypeFixed.floorDiv(distance - (long long)self.settings.roundPhase + (long long)self.settings.roundThreshold, (long long)self.settings.roundPeriod) * (long long)self.settings.roundPeriod + (long long)self.settings.roundPhase;
		if (rounded < 0LL) { rounded = (long long)self.settings.roundPhase; }
		return (int)(value < 0 ? -rounded : rounded);
	}

	private TrueTypeZone zone(int zone) {
		if (zone == 0) { return self.twilight; }
		if (zone == 1) { return self.points; }
		throw "Invalid TrueType zone";
	}

	private void move(TrueTypeZone zone, int point, long long distance) {
		if (self.generalVectors) {
			if (!self.preparing && zone == self.points && self.interpolatedAxes == 3) { zone.need(point); return; }
			long long dot = (long long)self.projection.x * self.freedom.x + (long long)self.projection.y * self.freedom.y;
			if (llabs(dot) < 67108864LL) { dot = 268435456LL; }
			if (self.freedom.x != 0) { zone.move(point, true, 0LL, true); }
			if (self.freedom.y != 0) { zone.move(point, false, self.scaledRatio(distance, (long long)self.freedom.y * 16384LL, dot), true); }
			return;
		}
		if (self.freedomX && distance != 0LL) { throw "Unsupported horizontal TrueType move"; }
		if (self.projectX != self.freedomX) { throw "Unsupported perpendicular TrueType vectors"; }
		zone.move(point, self.freedomX, distance, true);
	}

	private int cv(int index) {
		if (index < 0 || index >= self.cvt.len) { throw "Invalid TrueType control value index"; }
		return self.cvt.get(index);
	}

	private void writeCV(int index, int value) { self.cv(index); self.cvt.set(index, value); }

	private void delta(int op) {
		int count = self.pop();
		if (count < 0 || count > self.stack.size() / 2) { throw "Invalid TrueType delta count"; }
		int segment = op == 0x5d || op == 0x73 ? 0 : (op == 0x71 || op == 0x74 ? 16 : 32);
		for (int i = 0; i < count; i++) {
			int point = self.pop();
			int arg = self.pop();
			if (self.settings.deltaBase + segment + ((arg >> 4) & 15) != self.ppem) { continue; }
			int steps = (arg & 15) - 8;
			if (steps >= 0) { steps++; }
			int delta = steps * (64 >> self.settings.deltaShift);
			if (op >= 0x73) { self.writeCV(point, (int)((unsigned int)self.cv(point) + (unsigned int)delta)); }
			else {
				var zone = self.zone(self.zp0);
				zone.need(point);
				// The modern grayscale interpreter applies a simple glyph's
				// delta only to points the program has already fitted vertically.
				if (self.preparing || self.zp0 == 0 || (self.interpolatedAxes != 3 && (self.compositeGlyph || (zone.touched.get(point) & 2) != 0))) {
					self.move(zone, point, delta);
				}
			}
		}
	}

	private long long scaledRatio(long long value, long long numerator, long long denominator) {
		if (denominator == 0LL) { throw "Invalid TrueType distance ratio"; }
		if (denominator < 0LL) { denominator = -denominator; numerator = -numerator; }
		if (value != 0LL && llabs(numerator) > (9223372036854775807LL - denominator / 2LL) / llabs(value)) { throw "TrueType distance ratio exceeds the coordinate range"; }
		long long product = value * numerator;
		return product < 0LL ? -((-product + denominator / 2LL) / denominator) : (product + denominator / 2LL) / denominator;
	}

	private long long distance(TrueTypeZone to, int a, TrueTypeZone from, int b, bool original) {
		to.need(a);
		from.need(b);
		var direction = original ? self.dual : self.projection;
		long long x = (long long)to.coord(a, true, original) - (long long)from.coord(b, true, original);
		long long y = (long long)to.coord(a, false, original) - (long long)from.coord(b, false, original);
		return direction.project(x, y);
	}

	private void vectorFromLine(HintDirection vector, TrueTypeZone start, int a, TrueTypeZone end, int b, bool original, bool rotate) {
		long long x = (long long)end.coord(b, true, original) - (long long)start.coord(a, true, original);
		long long y = (long long)end.coord(b, false, original) - (long long)start.coord(a, false, original);
		if (x == 0LL && y == 0LL) { vector.set(1LL, 0LL); }
		else { vector.set(rotate ? -y : x, rotate ? x : y); }
	}

	private void relativePoint(int op, TrueTypeZone from, TrueTypeZone to) {
		bool indirect = op >= 0xe0;
		int cv = indirect ? self.pop() : 0;
		int point = self.pop();
		if (self.zp0 == 0 || self.zp1 == 0) { throw "Unsupported relative twilight point"; }
		long long original = !indirect && !self.compositeGlyph ? OpenTypeFixed.mul(self.originalDistance(to, point, from, self.rp0, true), self.scale) : self.distance(to, point, from, self.rp0, true);
		long long current = self.distance(to, point, from, self.rp0, false);
		long long requested = indirect ? (cv < 0 ? 0LL : (long long)self.cv(cv)) : original;
		if (indirect && ((original < 0LL) != (requested < 0LL))) { requested = -requested; }
		if ((op & 4) != 0) {
			if (indirect && self.zp0 == self.zp1 && llabs(requested - original) > self.settings.cutIn) { requested = original; }
			requested = self.round(requested);
		}
		if ((op & 8) != 0 && llabs(requested) < self.settings.minimumDistance) { requested = original < 0LL ? -self.settings.minimumDistance : self.settings.minimumDistance; }
		self.move(to, point, requested - current);
		self.rp1 = self.rp0;
		self.rp2 = point;
		if ((op & 16) != 0) { self.rp0 = point; }
	}

	private long long originalDistance(TrueTypeZone to, int a, TrueTypeZone from, int b, bool inUnits) {
		if (!inUnits) { return self.distance(to, a, from, b, true); }
		to.need(a);
		from.need(b);
		return self.dual.project((long long)to.unitsX.get(a) - (long long)from.unitsX.get(b), (long long)to.unitsY.get(a) - (long long)from.unitsY.get(b));
	}

	private void interpolatePoints(TrueTypeZone first, TrueTypeZone last, TrueTypeZone targets) {
		bool inUnits = !self.compositeGlyph && self.zp0 != 0 && self.zp1 != 0 && self.zp2 != 0;
		long long oldRange = self.originalDistance(last, self.rp2, first, self.rp1, inUnits);
		long long newRange = self.distance(last, self.rp2, first, self.rp1, false);
		if (self.loopCount > self.stack.size()) { throw "Invalid TrueType interpolation loop"; }
		for (int i = 0; i < self.loopCount; i++) {
			int p = self.pop();
			long long old = self.originalDistance(targets, p, first, self.rp1, inUnits);
			long long fitted = oldRange == 0LL ? (inUnits ? OpenTypeFixed.mul(old, self.scale) : old) : self.scaledRatio(old, newRange, oldRange);
			self.move(targets, p, fitted - self.distance(targets, p, first, self.rp1, false));
		}
		self.loopCount = 1;
	}

	/* ISECT writes both coordinates directly, including after IUP. A nearly
	 * parallel pair cannot provide a stable intersection. */
	private void intersectLines(TrueTypeZone zone) {
		if (self.zp0 != 1 || self.zp1 != 1 || self.zp2 != 1) { throw "Unsupported twilight line intersection"; }
		int b1 = self.pop();
		int b0 = self.pop();
		int a1 = self.pop();
		int a0 = self.pop();
		int target = self.pop();
		long long x = zone.coord(a0, true, false);
		long long y = zone.coord(a0, false, false);
		long long ax = (long long)zone.coord(a1, true, false) - x;
		long long ay = (long long)zone.coord(a1, false, false) - y;
		long long bx = (long long)zone.coord(b1, true, false) - zone.coord(b0, true, false);
		long long by = (long long)zone.coord(b1, false, false) - zone.coord(b0, false, false);
		long long cx = (long long)zone.coord(b0, true, false) - x;
		long long cy = (long long)zone.coord(b0, false, false) - y;
		long long cross = ax * by - ay * bx;
		long long dot = ax * bx + ay * by;
		if (llabs(cross) <= llabs(dot) / 19LL) { throw "Near-parallel TrueType lines"; }
		long long numerator = cx * by - cy * bx;
		zone.move(target, true, x + self.scaledRatio(ax, numerator, cross) - zone.coord(target, true, false), true);
		zone.move(target, false, y + self.scaledRatio(ay, numerator, cross) - zone.coord(target, false, false), true);
	}

	private void geometry(int op) {
		var z0 = self.zone(self.zp0);
		var z1 = self.zone(self.zp1);
		var z2 = self.zone(self.zp2);
		if (self.generalVectors && op == 0x0f) { self.intersectLines(z2); return; }
		if (self.generalVectors && op >= 0xc0) { self.relativePoint(op, z0, z1); return; }
		if (self.generalVectors && op == 0x39) { self.interpolatePoints(z0, z1, z2); return; }
		if (self.generalVectors && (op == 0x32 || op == 0x33)) {
			var reference = op == 0x32 ? z1 : z0;
			int point = op == 0x32 ? self.rp2 : self.rp1;
			long long shift = self.projection.project((long long)reference.coord(point, true, false) - reference.coord(point, true, true), (long long)reference.coord(point, false, false) - reference.coord(point, false, true));
			if (self.loopCount > self.stack.size()) { throw "Invalid TrueType shift loop"; }
			for (int i = 0; i < self.loopCount; i++) { self.move(z2, self.pop(), shift); }
			self.loopCount = 1;
			return;
		}
		if (self.generalVectors && (op == 0x36 || op == 0x37)) {
			var reference = op == 0x36 ? z1 : z0;
			int anchor = op == 0x36 ? self.rp2 : self.rp1;
			int which = self.pop();
			var targets = self.zone(which);
			int count = which == 0 ? targets.count : targets.count - 4;
			long long shift = self.projection.project((long long)reference.coord(anchor, true, false) - reference.coord(anchor, true, true), (long long)reference.coord(anchor, false, false) - reference.coord(anchor, false, true));
			self.charge(count);
			for (int i = 0; i < count; i++) { if (targets != reference || i != anchor) { self.move(targets, i, shift); } }
			return;
		}
		if (op == 0x30 || op == 0x31) {
			self.charge(self.points.count);
			self.points.interpolate(op == 0x31);
			self.interpolatedAxes |= op == 0x31 ? 1 : 2;
			return;
		}
		if (op == 0x2e || op == 0x2f) {
			int p = self.pop();
			int v = z0.coord(p, self.projectX, false);
			self.move(z0, p, op == 0x2e ? 0 : self.round(v) - v);
			self.rp0 = p;
			self.rp1 = p;
		} else if (op == 0x3e || op == 0x3f) {
			int cv = self.cv(self.pop());
			int p = self.pop();
			if (self.zp0 == 0) { z0.place(p, self.freedomX ? cv : 0, self.freedomX ? 0 : cv); }
			int current = z0.coord(p, self.projectX, false);
			int target = cv;
			if (op == 0x3f) {
				if (self.zp0 != 0 && ((long long)current - (long long)cv > (long long)self.settings.cutIn || (long long)cv - (long long)current > (long long)self.settings.cutIn)) { target = current; }
				target = self.round(target);
			}
			self.move(z0, p, (long long)target - (long long)current);
			self.rp0 = p;
			self.rp1 = p;
		} else if (op == 0x46 || op == 0x47) { self.push((long long)z2.coord(self.pop(), self.projectX, op == 0x47)); }
		else if (op == 0x49 || op == 0x4a) {
			int b = self.pop();
			int a = self.pop();
			self.push((long long)z0.coord(a, self.projectX, op == 0x4a) - (long long)z1.coord(b, self.projectX, op == 0x4a));
		} else if (op == 0x38 || op == 0x3c) {
			int delta = op == 0x38 ? self.pop() : 0;
			if (self.loopCount > self.stack.size()) { throw "Invalid TrueType point loop"; }
			for (int i = 0; i < self.loopCount; i++) {
				int p = self.pop();
				if (op == 0x38) {
					z2.need(p);
					// In the modern grayscale interpreter a simple glyph can shift
					// a point already fitted vertically, until both axes have run IUP.
					bool vertical = !self.freedomX && self.interpolatedAxes != 3 && (self.compositeGlyph || (z2.touched.get(p) & 2) != 0);
					if (self.zp2 == 0 || vertical) { z2.move(p, self.freedomX, (long long)delta, true); }
				}
				else { self.move(z1, p, z0.coord(self.rp0, self.projectX, false) - z1.coord(p, self.projectX, false)); }
			}
			self.loopCount = 1;
		} else if (op == 0x34 || op == 0x35) {
			var reference = op == 0x34 ? z1 : z0;
			int p = op == 0x34 ? self.rp2 : self.rp1;
			int delta = reference.coord(p, self.projectX, false) - reference.coord(p, self.projectX, true);
			int contour = self.pop();
			if (contour < 0 || contour >= z2.ends.size()) { throw "Invalid TrueType contour"; }
			int first = contour == 0 ? 0 : z2.ends.get(contour - 1) + 1;
			self.charge(z2.ends.get(contour) - first + 1);
			for (int i = first; i <= z2.ends.get(contour); i++) {
				if (reference != z2 || i != p) { self.move(z2, i, delta); }
			}
		} else { throw "Unsupported TrueType positioning instruction"; }
	}

	public void run(OpenTypeSpan code) {
		self.budget = 500000;
		self.stack.clear();
		self.execute(code, 0);
	}

	/* Inspect declarations as well as executed branches. The public font
	 * loader decides whether it needs a fallback before the file can be
	 * unlinked. A shaped run can instead decline an individual glyph. */
	private bool hasGeneralDirections(OpenTypeSpan code) {
		int pc = code.offset;
		int end = code.end();
		while (pc < end) {
			int op = self.data.u8(pc);
			pc++;
			if ((op >= 0x06 && op <= 0x0e) || op == 0x86 || op == 0x87) { return true; }
			int bytes = self.operandCount(op, pc, end);
			if (bytes > end - pc) { throw "Truncated TrueType push"; }
			pc += bytes;
		}
		return false;
	}

	/* The pre-program runs once per size. Each glyph starts with its own
	 * copies of this prepared state, including twilight coordinates. A
	 * failed glyph therefore cannot disturb a subsequent glyph. */
	public bool prepare(OpenTypeSpan functions, OpenTypeSpan prep, bool allowGeneralVectors = false) {
		self.generalVectors = self.hasGeneralDirections(functions) || self.hasGeneralDirections(prep);
		if (self.generalVectors && !allowGeneralVectors) { throw "TrueType font requires general vector instructions"; }
		self.run(functions);
		self.run(prep);
		self.preparing = false;
		self.preparedSettings.copyFrom(self.settings);
		self.preparedTwilight.copyFrom(self.twilight);
		for (int i = 0; i < self.storage.len; i++) { self.preparedStorage.set(i, self.storage.get(i)); }
		for (int i = 0; i < self.cvt.len; i++) { self.preparedCVT.set(i, self.cvt.get(i)); }
		return self.generalVectors;
	}

	public bool gridFittingEnabled() { return self.enabled; }

	public void glyph(OpenTypeSpan code, TrueTypeZone points, bool composite = false) {
		self.compositeGlyph = composite;
		self.interpolatedAxes = 0;
		self.points = points;
		self.settings.copyFrom(self.preparedSettings);
		self.twilight.copyFrom(self.preparedTwilight);
		for (int i = 0; i < self.storage.len; i++) { self.storage.set(i, self.preparedStorage.get(i)); }
		for (int i = 0; i < self.cvt.len; i++) { self.cvt.set(i, self.preparedCVT.get(i)); }
		self.rp0 = 0;
		self.rp1 = 0;
		self.rp2 = 0;
		self.zp0 = 1;
		self.zp1 = 1;
		self.zp2 = 1;
		self.projectX = true;
		self.freedomX = true;
		self.projection.set(1LL, 0LL);
		self.freedom.set(1LL, 0LL);
		self.dual.set(1LL, 0LL);
		self.loopCount = 1;
		if (self.enabled) { self.run(code); }
	}

	private void execute(OpenTypeSpan code, int depth) {
		int pc = code.offset;
		int end = code.end();
		while (pc < end) {
			self.charge(1);
			int op = self.data.u8(pc);
			pc++;
			if ((op >= 0xb0 && op <= 0xbf) || op == 0x40 || op == 0x41) {
				int bytes = self.operandCount(op, pc, end);
				if (bytes > end - pc) { throw "Truncated TrueType push"; }
				int next = pc + bytes;
				if (op == 0x40 || op == 0x41) { pc++; }
				bool words = op == 0x41 || op >= 0xb8;
				while (pc < next) {
					self.push((long long)(words ? self.data.s16(pc) : self.data.u8(pc)));
					pc += words ? 2 : 1;
				}
			} else if (op == 0x2c) {
				int id = self.pop();
				int next = self.skip(pc, end, true, false);
				if (!self.preparing || id < 0 || self.functionIds.size() >= self.functionsLimit || self.functionIds.indexOf(id) >= 0) { throw "Invalid TrueType function definition"; }
				self.functionIds.push(id);
				self.functions.push(OpenTypeSpan(pc, next - pc - 1));
				pc = next;
			} else if (op == 0x2b || op == 0x2a) {
				int id = self.pop();
				int repeats = op == 0x2a ? self.pop() : 1;
				self.call(id, depth, repeats);
			} else if (op == 0x58) {
				if (self.pop() == 0) { pc = self.skip(pc, end, false, true); }
			} else if (op == 0x1b) { pc = self.skip(pc, end, false, false); }
			else if (op == 0x59) { continue; }
			else if (op == 0x1c) { pc = self.off(pc, self.pop(), code); }
			else if (op == 0x78 || op == 0x79) {
				int condition = self.pop();
				int delta = self.pop();
				if ((condition != 0) == (op == 0x78)) { pc = self.off(pc, delta, code); }
			} else if (op == 0x20 || op == 0x25 || op == 0x26) {
				int depth = op == 0x20 ? 1 : self.pop();
				int index = self.stack.size() - depth;
				if (depth < 1 || index < 0) { throw "Invalid TrueType stack index"; }
				int value = self.stack.get(index);
				if (op == 0x26) { self.stack.remove(index); }
				self.push((long long)value);
			} else if (op == 0x21) { self.pop(); }
			else if (op == 0x22) { self.stack.clear(); }
			else if (op == 0x24) { self.push((long long)self.stack.size()); }
			else if (op == 0x23 || op == 0x8a) {
				int c = self.pop();
				int b = self.pop();
				if (op == 0x23) { self.push((long long)c); self.push((long long)b); }
				else {
					int a = self.pop();
					self.push((long long)b); self.push((long long)c); self.push((long long)a);
				}
			} else if ((op >= 0x50 && op <= 0x55) || (op >= 0x5a && op <= 0x5c) || (op >= 0x60 && op <= 0x67) || op == 0x8b || op == 0x8c) { self.calculate(op); }
			else if (op == 0x42 || op == 0x43) {
				int value = op == 0x42 ? self.pop() : 0;
				int index = self.pop();
				if (index < 0 || index >= self.storage.len) { throw "Invalid TrueType storage index"; }
				if (op == 0x42) { self.storage.set(index, value); }
				else { self.push((long long)self.storage.get(index)); }
			} else if (op == 0x44 || op == 0x70) {
				int value = self.pop();
				self.writeCV(self.pop(), op == 0x70 ? (int)OpenTypeFixed.mul((long long)value, self.scale) : value);
			} else if (op == 0x45) { self.push((long long)self.cv(self.pop())); }
			else if (op == 0x4b || op == 0x4c) { self.push((long long)self.ppem); }
			else if (op == 0x88) {
				int requested = self.pop();
				int result = (requested & 1) != 0 ? 40 : 0;
				// These capability bits describe the version-40 interpreter used
				// for normal glyph rendering. Result bits sit seven above their selectors.
				result |= (requested & (64 | 1024 | 2048 | 4096)) << 7;
				self.push((long long)result);
			} else if (op == 0x8e) {
				if (!self.preparing) { throw "TrueType instruction control outside size preparation"; }
				int selector = self.pop();
				int value = self.pop();
				if (selector == 1) { self.enabled = value == 0; }
				else if (value != 0) { throw "Unsupported TrueType instruction control"; }
			} else if (op <= 5) {
				bool x = (op & 1) != 0;
				if (op <= 3) { self.projectX = x; self.projection.set(x ? 1LL : 0LL, x ? 0LL : 1LL); self.dual.set(x ? 1LL : 0LL, x ? 0LL : 1LL); }
				if (op <= 1 || op >= 4) { self.freedomX = x; self.freedom.set(x ? 1LL : 0LL, x ? 0LL : 1LL); }
			} else if (self.generalVectors && ((op >= 6 && op <= 9) || op == 0x86 || op == 0x87)) {
				int a = self.pop();
				int b = self.pop();
				var start = self.zone(self.zp2);
				var end = self.zone(self.zp1);
				bool rotate = (op & 1) != 0;
				if (op == 8 || op == 9) {
					self.vectorFromLine(self.freedom, start, a, end, b, false, rotate);
					self.freedomX = self.freedom.y == 0;
				} else {
					self.vectorFromLine(self.projection, start, a, end, b, false, rotate);
					self.vectorFromLine(self.dual, start, a, end, b, op >= 0x86, rotate);
					self.projectX = self.projection.y == 0;
				}
			} else if (self.generalVectors && op == 0x0e) {
				self.freedom.x = self.projection.x;
				self.freedom.y = self.projection.y;
				self.freedomX = self.projection.y == 0;
			} else if (op >= 0x10 && op <= 0x16) {
				int value = self.pop();
				if (op == 0x10) { self.rp0 = value; }
				else if (op == 0x11) { self.rp1 = value; }
				else if (op == 0x12) { self.rp2 = value; }
				else {
					self.zone(value);
					if (op == 0x13 || op == 0x16) { self.zp0 = value; }
					if (op == 0x14 || op == 0x16) { self.zp1 = value; }
					if (op == 0x15 || op == 0x16) { self.zp2 = value; }
				}
			} else if (op == 0x17) {
				self.loopCount = self.pop();
				if (self.loopCount < 0 || self.loopCount > self.stackLimit) { throw "Invalid TrueType loop count"; }
			} else if (op == 0x18 || op == 0x19 || op == 0x3d || op == 0x7a || op == 0x7c || op == 0x7d) {
				self.settings.roundPeriod = op == 0x7a ? 0 : (op == 0x3d ? 32 : 64);
				self.settings.roundPhase = op == 0x19 ? 32 : 0;
				self.settings.roundThreshold = op == 0x7d ? 0 : (op == 0x7c ? 63 : self.settings.roundPeriod / 2);
			} else if (op == 0x1a) { self.settings.minimumDistance = self.pop(); }
			else if (op == 0x1d) { self.settings.cutIn = self.pop(); }
			else if (op == 0x85 || op == 0x8d) { self.pop(); }
			else if (op == 0x5e) {
				self.settings.deltaBase = self.pop();
				if (self.settings.deltaBase < 0 || self.settings.deltaBase > 65535) { throw "Invalid TrueType delta base"; }
			}
			else if (op == 0x5f) {
				self.settings.deltaShift = self.pop();
				if (self.settings.deltaShift < 0 || self.settings.deltaShift > 6) { throw "Invalid TrueType delta shift"; }
			} else if (op == 0x5d || (op >= 0x71 && op <= 0x75)) { self.delta(op); }
			else if (op >= 0x68 && op <= 0x6b) { self.push((long long)self.round(self.pop())); }
			else { self.geometry(op); }
		}
	}
}
