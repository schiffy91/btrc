/* Portable directory-picker contract. Applications call
 * GUI.chooseDirectory(request) on the UI thread of an initialized GUI; the
 * target's GUI provider builds its picker (MacOSDirectoryPicker over
 * NSOpenPanel, LinuxDirectoryPicker over SDL's portal/zenity folder dialog)
 * and runs it modally. A picker owns its modal resources and reports an
 * invalid request, an unavailable dialog or a native failure as a failed
 * outcome; a user dismissal, or an application Quit that aborts the modal,
 * is a cancelled outcome. The Linux picker pumps application events until
 * the dialog answers, so it throws when opened from inside native event
 * dispatch. Windows has no provider. */

import Library.App;

class DirectoryPickerRequest {
	public string title;
	public string initialDirectory;

	public DirectoryPickerRequest(string title, string initialDirectory = "") {
		self.title = title;
		self.initialDirectory = initialDirectory;
	}

	public bool isValid() { return !self.title.isEmpty(); }
}

enum DirectoryPickerKind {
	DIRECTORY_PICKER_SELECTED = 1,
	DIRECTORY_PICKER_CANCELLED = 2,
	DIRECTORY_PICKER_FAILED = 3
};

class DirectoryPickerOutcome {
	public DirectoryPickerKind kind;
	public string directory;
	public AppError? error;

	private DirectoryPickerOutcome(DirectoryPickerKind kind, string directory, AppError? error) {
		self.kind = kind;
		self.directory = directory;
		self.error = error;
	}

	class DirectoryPickerOutcome selected(string directory) { return new DirectoryPickerOutcome(DIRECTORY_PICKER_SELECTED, directory, null); }

	class DirectoryPickerOutcome cancelled() { return new DirectoryPickerOutcome(DIRECTORY_PICKER_CANCELLED, "", null); }

	class DirectoryPickerOutcome failed(AppError error) { return new DirectoryPickerOutcome(DIRECTORY_PICKER_FAILED, "", error); }
}

interface IDirectoryPicker {
	DirectoryPickerOutcome chooseDirectory(DirectoryPickerRequest request);
}
