import Library.GUI.IView;
import Library.Callback;

interface IButtonAction { void invoke(); }

/* Typography limits every provider enforces rather than clipping text. */
class ButtonTypography {
	/* The largest font a bordered button's bezel holds. */
	class double borderedMaximumSize() { return 20.0; }

	/* The largest font any button accepts. */
	class double maximumSize() { return 512.0; }
}

/* Setters publish model state without synthesizing user actions. activate()
 * uses native control tracking and returns false when the control is disabled.
 * onAction registers one queued receiver in an independently owned scope.
 * Cancel before replacement; cancellation/close discards queued old actions.
 * Delivery follows its native callback on the application UI executor, which
 * rechecks effective eligibility. A queued click for an ineligible target is
 * discarded with the ineligible disposition and is never replayed or cancelled.
 * Providers reject unsupported typography rather than clipping it: bordered
 * buttons support up to ButtonTypography.borderedMaximumSize() points and
 * borderless buttons up to ButtonTypography.maximumSize().
 * setSystemSymbol takes an SF Symbols name. The portable vocabulary every
 * provider draws is gearshape, chevron.left, chevron.right, play.fill,
 * pause.fill, stop.fill, waveform, folder, paintbrush, metronome, repeat,
 * speaker.wave.2.fill, speedometer, line.3.horizontal.decrease, xmark,
 * magnifyingglass, tuningfork and quote.bubble; a name the provider cannot
 * draw throws "Native button system symbol is unavailable". */
interface IButton extends IView {
	string title();
	void setTitle(string title);
	bool isEnabled();
	void setEnabled(bool enabled);
	void setFont(double size);
	void setCentered(bool centered);
	void setSystemSymbol(string name);
	/* Native hover help; an empty string removes it. */
	void setToolTip(string text);

	/* The hover help text last set; empty when none. */
	string toolTip();
	void setSelected(bool selected);
	bool isSelected();
	void setTransparent(bool transparent);
	void setBordered(bool bordered);
	void cancelPendingActions();
	bool activate();
	ICallbackRegistration onAction(IButtonAction action, CallbackScope scope);
}
