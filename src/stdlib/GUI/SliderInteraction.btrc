/* Private slider interaction owner shared by desktop projections. Native
 * providers supply admission and generation, then dispatch the queued events. */
import Library.Callback;
import Library.Math;
import Library.UI.Element;
import Library.GUI.ControlEvents;
import Library.GUI.ControlEventQueue;
import Library.GUI.ISlider;
import Library.GUI.SliderValue;

class SliderInteraction {
	private SliderValue _model;
	private bool _active = false;
	private double _start;
	private long long _startRevision;
	private long long _generation;
	private long long _interaction = 0LL;
	private long long _sequence = 0LL;
	private ControlEventChannel<ISliderControlEventHandler, SliderControlEvent>? _preview;
	private ControlEventChannel<ISliderControlEventHandler, SliderControlEvent>? _commit;
	private ControlEventChannel<ISliderControlEventHandler, SliderControlEvent>? _cancel;
	private ControlEventTicket? _commitTicket;
	private ControlEventTicket? _cancelTicket;

	public SliderInteraction(double minimum, double maximum, int intervals) { self._model = SliderValue.fromIntervals(minimum, maximum, intervals); }

	public double value() { return self._model.value(); }

	public SliderRange range() { return self._model.range(); }

	public bool active() { return self._active; }

	public bool inert() { return self._model.inert(); }

	class void deliver(ISliderControlEventHandler receiver, SliderControlEvent event) { receiver.sliderEvent(event); }

	public ControlEventChannel<ISliderControlEventHandler, SliderControlEvent> onPreview(ControlEventQueue queue, IControlEventTarget target, ISliderControlEventHandler receiver, CallbackScope owner) {
		if (self._preview != null && self._preview.pollCompletion() != CALLBACK_CANCELLATION_COMPLETE) { throw "Cancel the existing slider preview handler first"; }
		self._preview = new ControlEventChannel<ISliderControlEventHandler, SliderControlEvent>(queue, target, receiver, SliderInteraction.deliver, owner); return self._preview;
	}

	public ControlEventChannel<ISliderControlEventHandler, SliderControlEvent> onCommit(ControlEventQueue queue, IControlEventTarget target, ISliderControlEventHandler receiver, CallbackScope owner) {
		if (self._commit != null && self._commit.pollCompletion() != CALLBACK_CANCELLATION_COMPLETE) { throw "Cancel the existing slider commit handler first"; }
		var channel = new ControlEventChannel<ISliderControlEventHandler, SliderControlEvent>(queue, target, receiver, SliderInteraction.deliver, owner);
		try { if (self._active) { self._commitTicket = channel.beginInteraction(); if (self._commitTicket == null) { throw "Slider commit reservation unavailable"; } } }
		catch (string error) { channel.cancel(); throw error; }
		self._commit = channel; return channel;
	}

	public ControlEventChannel<ISliderControlEventHandler, SliderControlEvent> onCancel(ControlEventQueue queue, IControlEventTarget target, ISliderControlEventHandler receiver, CallbackScope owner) {
		if (self._cancel != null && self._cancel.pollCompletion() != CALLBACK_CANCELLATION_COMPLETE) { throw "Cancel the existing slider cancel handler first"; }
		var channel = new ControlEventChannel<ISliderControlEventHandler, SliderControlEvent>(queue, target, receiver, SliderInteraction.deliver, owner);
		try { if (self._active) { self._cancelTicket = channel.beginInteraction(); if (self._cancelTicket == null) { throw "Slider cancel reservation unavailable"; } } }
		catch (string error) { channel.cancel(); throw error; }
		self._cancel = channel; return channel;
	}

	private void releaseTickets() {
		if (self._commitTicket != null && !self._commitTicket.queued()) { self._commitTicket.retire(); }
		if (self._cancelTicket != null && !self._cancelTicket.queued()) { self._cancelTicket.retire(); }
		self._commitTicket = null; self._cancelTicket = null;
	}

	public bool begin(long long generation) {
		if (self._active || self._model.inert()) { return false; }
		if (generation <= 0LL || self._interaction == 9223372036854775807LL) { throw "Invalid slider interaction identity"; }
		try {
			if (self._commit != null && self._commit.isOpen()) { self._commitTicket = self._commit.beginInteraction(); if (self._commitTicket == null) { self.releaseTickets(); return false; } }
			if (self._cancel != null && self._cancel.isOpen()) { self._cancelTicket = self._cancel.beginInteraction(); if (self._cancelTicket == null) { self.releaseTickets(); return false; } }
		} catch (string error) { self.releaseTickets(); throw error; }
		self._generation = generation; self._interaction++; self._start = self._model.value(); self._startRevision = self._model.modelRevision(); self._active = true; return true;
	}

	private SliderControlEvent snapshot(ControlPhase phase, ControlOrigin origin, ControlCancelReason reason, SliderInputKind input, UIRangeAdjustment adjustment, int count) {
		if (self._sequence == 9223372036854775807LL) { throw "Slider event sequences exhausted"; }
		var context = ControlEventContext(); context.generation = self._generation; context.interaction = self._interaction;
		context.sequence = ++self._sequence; context.modelRevision = self._model.modelRevision(); context.origin = origin;
		var event = SliderControlEvent(); event.context = context; event.phase = phase; event.value = self._model.value(); event.rangeRevision = self._model.rangeRevision();
		event.input = input; event.adjustment = adjustment; event.count = count; event.cancelReason = reason; return event;
	}

	/* Rejection leaves the last admitted projection in place. The native
	 * owner must service queue pressure before consuming more pointer input. */
	public bool preview(double value) {
		if (!self._active) { return false; }
		double previous = self._model.value();
		if (!self._model.setUserValue(value)) { return true; }
		try {
			var channel = self._preview;
			if (channel != null && channel.isOpen()) {
				var event = self.snapshot(CONTROL_PHASE_PREVIEW, CONTROL_ORIGIN_USER, CONTROL_CANCEL_NONE, SLIDER_INPUT_ABSOLUTE_POINTER, UI_RANGE_ADJUST_NONE, 0);
				if (!channel.publish(event, self._generation, self._interaction, self._model.rangeRevision())) { self._model.setUserValue(previous); return false; }
			}
		} catch (string error) { self._model.setUserValue(previous); throw error; }
		return true;
	}

	private void finish(SliderInputKind input, UIRangeAdjustment adjustment, int count) {
		if (!self._active) { return; }
		try {
			var channel = self._commit; var ticket = self._commitTicket;
			if (channel != null && channel.isOpen() && ticket != null) { var event = self.snapshot(CONTROL_PHASE_COMMIT, CONTROL_ORIGIN_USER, CONTROL_CANCEL_NONE, input, adjustment, count); channel.publishTerminal(event, self._generation, self._interaction, ticket); }
		} finally { self._active = false; self.releaseTickets(); }
	}

	public void commit() { self.finish(SLIDER_INPUT_ABSOLUTE_POINTER, UI_RANGE_ADJUST_NONE, 0); }

	private void cancelInteraction(ControlOrigin origin, ControlCancelReason reason, bool restore) {
		if (!self._active) { return; }
		try {
			if (restore && self._model.modelRevision() == self._startRevision) { self._model.setUserValue(self._start); }
			var channel = self._cancel; var ticket = self._cancelTicket;
			if (channel != null && channel.isOpen() && ticket != null) { var event = self.snapshot(CONTROL_PHASE_CANCEL, origin, reason, SLIDER_INPUT_ABSOLUTE_POINTER, UI_RANGE_ADJUST_NONE, 0); channel.publishTerminal(event, self._generation, self._interaction, ticket); }
		} finally { self._active = false; self.releaseTickets(); }
	}

	public void cancel(ControlOrigin origin, ControlCancelReason reason) { self.cancelInteraction(origin, reason, true); }

	public bool setRangeValue(double minimum, double maximum, double step, double value) {
		SliderValue.validate(minimum, maximum, step); SliderValue.validateValue(minimum, maximum, value);
		double next = SliderValue.snap(minimum, maximum, step, value); var previous = self._model.range();
		if (previous.minimum == minimum && previous.maximum == maximum && previous.step == step && next == self._model.value()) { return false; }
		self.cancelInteraction(CONTROL_ORIGIN_MODEL, CONTROL_CANCEL_MODEL_REPLACEMENT, false);
		self._model.setRangeValue(minimum, maximum, step, next); return true;
	}

	public bool setRange(double minimum, double maximum, double step) {
		SliderValue.validate(minimum, maximum, step);
		return self.setRangeValue(minimum, maximum, step, Math.maxDouble(minimum, Math.minDouble(maximum, self._model.value())));
	}

	public bool setValue(double value) { var range = self._model.range(); return self.setRangeValue(range.minimum, range.maximum, range.step, value); }

	public bool adjust(long long generation, UIRangeAdjustment adjustment, int count) {
		if (count < 1 || adjustment < UI_RANGE_ADJUST_SMALL_DECREMENT || adjustment > UI_RANGE_ADJUST_MAXIMUM) { throw "Invalid slider adjustment"; }
		if (self._model.inert()) { return false; }
		self.cancel(CONTROL_ORIGIN_SYSTEM, CONTROL_CANCEL_PLATFORM_INTERRUPTION);
		if (!self.begin(generation)) { return false; }
		var range = self._model.range(); double next = self._model.value();
		if (adjustment == UI_RANGE_ADJUST_MINIMUM) { next = range.minimum; }
		else if (adjustment == UI_RANGE_ADJUST_MAXIMUM) { next = range.maximum; }
		else {
			double step = range.step > 0.0 ? range.step : (range.maximum - range.minimum) / 100.0;
			bool large = adjustment == UI_RANGE_ADJUST_LARGE_INCREMENT || adjustment == UI_RANGE_ADJUST_LARGE_DECREMENT;
			bool increase = adjustment == UI_RANGE_ADJUST_SMALL_INCREMENT || adjustment == UI_RANGE_ADJUST_LARGE_INCREMENT;
			double amount = step * (double)count * (large ? 10.0 : 1.0);
			double room = increase ? range.maximum - next : next - range.minimum;
			next = amount >= room ? (increase ? range.maximum : range.minimum) : (increase ? next + amount : next - amount);
		}
		self._model.setUserValue(next); self.finish(SLIDER_INPUT_RELATIVE_ADJUSTMENT, adjustment, count); return true;
	}

	public bool assistiveValue(long long generation, double value) {
		var range = self._model.range(); SliderValue.validateValue(range.minimum, range.maximum, value);
		if (self._model.inert()) { return false; }
		self.cancel(CONTROL_ORIGIN_SYSTEM, CONTROL_CANCEL_PLATFORM_INTERRUPTION);
		if (!self.begin(generation)) { return false; }
		self._model.setUserValue(value); self.finish(SLIDER_INPUT_ABSOLUTE_ASSISTIVE, UI_RANGE_ADJUST_NONE, 0); return true;
	}
}
