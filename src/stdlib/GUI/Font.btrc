import Library.GUI.FontFace;

/* A scalable raster font owns a face, never a process-global activation.
 * Select it explicitly with surface.setFont(font). The surface retains the
 * font; replacing selection cannot destroy a snapshot already being drawn.
 * Native GUI controls continue to use their platform system fonts. */
class Font {
	private IFontFace face;

	public Font(IFontFace face) { self.face = face; }

	public FontMetrics metrics() { return self.face.metrics(); }

	public FontGlyph? glyph(int codepoint, bool render) { return self.face.glyph(codepoint, render); }
}
