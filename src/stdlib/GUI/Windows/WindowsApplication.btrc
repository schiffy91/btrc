import Library.Callback;
import Library.Console;
import Library.Math;
import Library.Timer;
import Library.Vector;
import Library.Image;
import Library.GUI.IApplication;
import Library.GUI.IWindow;
import Library.GUI.IView;
import Library.GUI.IButton;
import Library.GUI.ITextField;
import Library.GUI.IContainer;
import Library.GUI.IStack;
import Library.GUI.IGPUView;
import Library.GUI.ILabel;
import Library.GUI.IImageView;
import Library.GUI.IPanel;
import Library.GUI.IProgressIndicator;
import Library.GUI.ILevelIndicator;
import Library.GUI.ISlider;
import Library.GUI.ISelect;
import Library.GUI.IScrollView;
import Library.GUI.IGrid;
import Library.GUI.Windows.Win32;
import Library.GUI.Windows.WindowsContext;
import Library.GUI.Windows.WindowsView;
import Library.GUI.Windows.WindowsWindow;
import Library.GUI.Windows.WindowsContainer;
import Library.GUI.Windows.WindowsScrollView;
import Library.GUI.Windows.WindowsLabel;
import Library.GUI.Windows.WindowsButton;
import Library.GUI.Windows.WindowsTextField;
import Library.GUI.Windows.WindowsGPUView;

/* Delayed UI-thread work: a deadline in the application's timer list. The
 * registration only records cancellation; the loop owns delivery. */
class WindowsDelayedWork implements ICallbackRegistration {
	private IApplicationWork? _work;
	private long long _deadline;
	private bool _open = true;

	public WindowsDelayedWork(IApplicationWork work, long long deadlineNanoseconds) { self._work = work; self._deadline = deadlineNanoseconds; }

	public long long deadline() { return self._deadline; }

	public IApplicationWork? take() { var work = self._work; self._work = null; self._open = false; return work; }

	public bool isOpen() { return self._open; }

	public CallbackCancellation cancel() { self._open = false; self._work = null; return CALLBACK_CANCELLATION_COMPLETE; }

	public CallbackCancellation pollCompletion() { return self._open ? CALLBACK_CANCELLATION_NOT_REQUESTED : CALLBACK_CANCELLATION_COMPLETE; }
}

/* The monotonic clock the loop's deadlines use, in nanoseconds. */
class WindowsClock {
	class long long now() {
		long long now = MonotonicClock.nanoseconds();
		if (now < 0LL) { throw "The monotonic clock is unavailable"; }
		return now;
	}

	class long long after(double seconds) {
		double nanoseconds = seconds * 1000000000.0;
		long long now = WindowsClock.now();
		if (nanoseconds >= 9.0e18 - (double)now) { return 9000000000000000000LL; }
		return now + (long long)nanoseconds;
	}
}

/* Provider-only projection, so the GUI facade's IApplication slot can reach
 * the Windows services without a class downcast. */
interface IWindowsApplication extends IApplication {
	WindowsContext context();
}

/* One application owner on its UI thread. run() waits in
 * MsgWaitForMultipleObjectsEx for queued input, the wake event or the next
 * deadline, dispatches a bounded batch of messages, then delivers delayed and
 * posted work, queued button actions and close requests. Quit closes
 * admission, drains admitted work, then closes windows and detached roots. */
class WindowsApplication implements IWindowsApplication {
	private WindowsContext _context;
	private Vector<WindowsWindow> _windows = [];
	private Vector<IView> _views = [];
	private Vector<IView> _closingRoots = [];
	private Vector<IApplicationWork> _work = [];
	private Vector<WindowsDelayedWork> _delayed = [];
	private int _workCapacity;
	private int _pendingWork = 0;
	private bool _quitRequested = false;
	private bool _running = false;
	private bool _dispatching = false;
	private bool _closing = false;
	private bool _closed = false;
	private bool _viewsClosing = false;
	private string _workFailure = "";
	private bool _workFailed = false;
	private string _closeFailure = "";

	public WindowsApplication(int workCapacity) {
		if (workCapacity <= 0 || workCapacity > 65536) { throw "Application work capacity must be between 1 and 65536"; }
		self._workCapacity = workCapacity;
		self._context = WindowsContext(workCapacity);
	}

	public WindowsContext context() { return self._context; }

	private void requireIdle() {
		if (self._dispatching) { throw "Native message dispatch is already active"; }
		if (self._closing || self._closed) { throw "Application shutdown has started"; }
	}

	private void requireCreation() {
		self.requireIdle();
		if (self._quitRequested) { throw "Application quit has been requested"; }
	}

	public bool isRunning() { return self._running; }

	/* How long run() drains a closing subtree before reporting it stalled. */
	class double shutdownSeconds() { return 10.0; }

	public void requestQuit() {
		if (self._closed || self._quitRequested) { return; }
		self._quitRequested = true;
		self._context.wakeLoop();
	}

	private void failWork(string error) {
		if (!self._workFailed) { self._workFailure = error; self._workFailed = true; }
		self.requestQuit();
	}

	private void pruneDelayed() { for (int index = self._delayed.len - 1; index >= 0; index--) { if (!self._delayed.get(index).isOpen()) { self._delayed.remove(index); } } }

	public void post(IApplicationWork work) {
		if (self._closing || self._closed) { throw "Application shutdown has started"; }
		if (work == null) { throw "Application work is required"; }
		if (self._quitRequested) { throw "Application quit has been requested"; }
		self.pruneDelayed();
		if (self._pendingWork + self._delayed.len >= self._workCapacity) { throw "Application work capacity exceeded"; }
		self._work.push(work);
		self._pendingWork++;
		self._context.wakeLoop();
	}

	public ICallbackRegistration postAfter(double delaySeconds, IApplicationWork work) {
		if (self._closing || self._closed) { throw "Application shutdown has started"; }
		if (work == null || !Math.isFinite(delaySeconds) || delaySeconds < 0.0) { throw "Delayed work requires a finite nonnegative delay and a receiver"; }
		if (self._quitRequested) { throw "Application quit has been requested"; }
		self.pruneDelayed();
		if (self._pendingWork + self._delayed.len >= self._workCapacity) { throw "Application work capacity exceeded"; }
		var registration = WindowsDelayedWork(work, WindowsClock.after(delaySeconds));
		self._delayed.push(registration);
		return registration;
	}

	/* Windows and roots created here stay owned until they close. */
	public IWindow createWindow(string title, double width, double height) {
		self.requireCreation();
		var window = WindowsWindow(self._context, title, width, height);
		self._windows.push(window);
		return window;
	}

	private void rememberView(IView view) {
		for (int index = self._views.len - 1; index >= 0; index--) {
			var previous = self._views.get(index);
			if (!previous.isOpen() && previous.pollClose() == CALLBACK_CANCELLATION_COMPLETE) { self._views.remove(index); }
		}
		self._views.push(view);
	}

	public IButton createButton(string title) { self.requireCreation(); var view = WindowsButton(self._context, title); self.rememberView(view); return view; }

	public ITextField createTextField(string text, string placeholder) { self.requireCreation(); var view = WindowsTextField(self._context, text, placeholder); self.rememberView(view); return view; }

	public IContainer createContainer() { self.requireCreation(); var view = WindowsContainer(self._context); self.rememberView(view); return view; }

	public IStack createRow(double spacing) { self.requireCreation(); throw WindowsUnsupported.error("IApplication.createRow"); }

	public IStack createColumn(double spacing) { self.requireCreation(); throw WindowsUnsupported.error("IApplication.createColumn"); }

	public IGPUView createGPUView(bool capture) { self.requireCreation(); var view = WindowsGPUView(self._context, capture); self.rememberView(view); return view; }

	public ILabel createLabel(string text) { self.requireCreation(); var view = WindowsLabel(self._context, text); self.rememberView(view); return view; }

	public IImageView createImageView() { self.requireCreation(); throw WindowsUnsupported.error("IApplication.createImageView"); }

	public IPanel createPanel(RGBA fill, double radius) { self.requireCreation(); throw WindowsUnsupported.error("IApplication.createPanel"); }

	public IProgressIndicator createProgressIndicator() { self.requireCreation(); throw WindowsUnsupported.error("IApplication.createProgressIndicator"); }

	public ILevelIndicator createLevelIndicator(double warning, double critical) { self.requireCreation(); throw WindowsUnsupported.error("IApplication.createLevelIndicator"); }

	public ISlider createSlider(double minimum, double maximum, int intervals) { self.requireCreation(); throw WindowsUnsupported.error("IApplication.createSlider"); }

	public ISelect createSelect() { self.requireCreation(); throw WindowsUnsupported.error("IApplication.createSelect"); }

	public IScrollView createScrollView() { self.requireCreation(); var view = WindowsScrollView(self._context); self.rememberView(view); return view; }

	public IGrid createGrid(int columns, int rows, double columnSpacing, double rowSpacing) { self.requireCreation(); throw WindowsUnsupported.error("IApplication.createGrid"); }

	/* Leave messages beyond this turn's budget queued while work progresses;
	 * MWMO_INPUTAVAILABLE wakes the next wait for them at once. WM_QUIT,
	 * posted by anything in the process, is a terminal request to quit. */
	private void pumpMessages(int timeoutMilliseconds) {
		btrcWin32WaitForInput(self._context.wake, (DWORD)timeoutMilliseconds);
		MSG message;
		int dispatched = 0;
		while (dispatched < 4096 && PeekMessageW(&message, null, (UINT)0, (UINT)0, (UINT)PM_REMOVE) != 0) {
			dispatched++;
			if (message.message == (UINT)WM_QUIT) { self.requestQuit(); continue; }
			TranslateMessage(&message);
			DispatchMessageW(&message);
		}
	}

	private void runWork() {
		if (self._work.isEmpty()) { return; }
		var batch = self._work;
		self._work = [];
		for work in batch {
			try { if (!self._quitRequested) { work.run(); } }
			catch (string error) { self.failWork(error); }
			finally { self._pendingWork--; }
		}
	}

	private void runDelayed() {
		long long now = WindowsClock.now();
		for (int index = 0; index < self._delayed.len; index++) {
			var delayed = self._delayed.get(index);
			if (!delayed.isOpen() || delayed.deadline() > now) { continue; }
			var work = delayed.take();
			if (work == null || self._quitRequested) { continue; }
			try { work.run(); } catch (string error) { self.failWork(error); }
		}
		self.pruneDelayed();
	}

	private void dispatchActions() {
		int count = self._context.actions.pendingCount();
		for (int index = 0; index < count && !self._quitRequested; index++) { self._context.actions.dispatchOne(); }
	}

	private int waitMilliseconds() {
		if (self._quitRequested || !self._work.isEmpty()) { return 0; }
		for window in self._windows { if (window.closeRequested()) { return 0; } }
		long long now = WindowsClock.now();
		long long deadline = now + 250000000LL;
		for delayed in self._delayed { if (delayed.isOpen() && delayed.deadline() < deadline) { deadline = delayed.deadline(); } }
		if (deadline <= now) { return 0; }
		return (int)((deadline - now) / 1000000LL) + 1;
	}

	/* A close request recorded during dispatch closes its window here, after
	 * dispatch, so the subtree is never torn down inside its own message. */
	private void closeRequestedWindows() {
		for (int index = self._windows.len - 1; index >= 0; index--) {
			var window = self._windows.get(index);
			if (window.closeRequested()) { window.close(); }
			if (!window.isOpen() && window.pollClose() == CALLBACK_CANCELLATION_COMPLETE) { self._windows.remove(index); }
		}
	}

	/* One loop turn: wait for messages or the next deadline, then service everything. */
	public void pumpOnce(int timeoutMilliseconds) {
		if (self._dispatching) { throw "Native message dispatch is already active"; }
		self._dispatching = true;
		try { self.pumpMessages(timeoutMilliseconds); }
		finally { self._dispatching = false; }
		self.runDelayed();
		self.runWork();
		self.dispatchActions();
		self.closeRequestedWindows();
	}

	public void run() {
		if (self._running || self._dispatching) { throw "Native application loop is already active"; }
		if (self._closed) { throw "Application shutdown has completed"; }
		self._running = true;
		try {
			while (true) {
				if (self._quitRequested && self._pendingWork == 0) { break; }
				self.pumpOnce(self.waitMilliseconds());
			}
		} catch (string error) { self._running = false; self.close(); throw error; }
		self._running = false;
		self.requestQuit();
		/* A subtree that never drains (a GPU device that never reaches CLOSED)
		 * fails the run after one deadline; its pending owners stay retained. */
		var result = self.close();
		long long deadline = WindowsClock.after(WindowsApplication.shutdownSeconds());
		while (result == CALLBACK_CANCELLATION_PENDING) {
			if (WindowsClock.now() >= deadline) { throw "Native subtree shutdown did not complete"; }
			self.pumpOnce(10);
			result = self.pollClose();
		}
		if (result != CALLBACK_CANCELLATION_COMPLETE) { throw "Native subtree shutdown failed without completion"; }
		if (self._workFailed) { throw self._workFailure; }
	}

	private CallbackCancellation combine(CallbackCancellation result, CallbackCancellation state) {
		if (result == CALLBACK_CANCELLATION_FAILED || state == CALLBACK_CANCELLATION_FAILED) { return CALLBACK_CANCELLATION_FAILED; }
		if (result == CALLBACK_CANCELLATION_RETRYABLE_FAILURE || state == CALLBACK_CANCELLATION_RETRYABLE_FAILURE) { return CALLBACK_CANCELLATION_RETRYABLE_FAILURE; }
		return result == CALLBACK_CANCELLATION_COMPLETE && state == CALLBACK_CANCELLATION_COMPLETE ? CALLBACK_CANCELLATION_COMPLETE : CALLBACK_CANCELLATION_PENDING;
	}

	private CallbackCancellation closeViews() {
		CallbackCancellation result = CALLBACK_CANCELLATION_COMPLETE;
		for (int index = self._windows.len - 1; index >= 0; index--) {
			var window = self._windows.get(index);
			var state = window.isOpen() ? window.close() : window.pollClose();
			if (state == CALLBACK_CANCELLATION_COMPLETE) { self._windows.remove(index); }
			else { result = self.combine(result, state); }
		}
		if (!self._viewsClosing) {
			self._viewsClosing = true;
			for view in self._views {
				if (!view.isOpen()) { if (view.pollClose() != CALLBACK_CANCELLATION_COMPLETE) { self._closingRoots.push(view); } continue; }
				var native = (IWindowsView?)view;
				if (native == null) { throw "GUI view belongs to another provider"; }
				// A view no container holds is still parked: its owner is this application.
				if (GetParent(native.nativeHandle()) == self._context.parking) { self._closingRoots.push(view); }
			}
		}
		for (int index = self._closingRoots.len - 1; index >= 0; index--) {
			var view = self._closingRoots.get(index);
			var state = view.isOpen() ? view.close() : view.pollClose();
			if (state == CALLBACK_CANCELLATION_COMPLETE) { self._closingRoots.remove(index); }
			else { result = self.combine(result, state); }
		}
		if (result == CALLBACK_CANCELLATION_COMPLETE) {
			for view in self._views { if (view.isOpen()) { throw "GUI view remains attached outside application ownership"; } }
			self._views.clear();
		}
		return result;
	}

	public CallbackCancellation pollClose() { return self._closed ? CALLBACK_CANCELLATION_COMPLETE : (self._closing ? self.close() : CALLBACK_CANCELLATION_NOT_REQUESTED); }

	public CallbackCancellation close() {
		if (self._closed) { return CALLBACK_CANCELLATION_COMPLETE; }
		if (self._closeFailure != "") { throw self._closeFailure; }
		if (self._dispatching) { throw "Native message dispatch is already active"; }
		if (self._running) { throw "Request application quit before closing a running application"; }
		if (self._pendingWork > 0 && !self._quitRequested) { throw "Run the application to drain pending work before closing"; }
		self._quitRequested = true;
		self._closing = true;
		var views = self.closeViews();
		if (views != CALLBACK_CANCELLATION_COMPLETE) { return views; }
		try {
			self._work.clear();
			self._pendingWork = 0;
			for delayed in self._delayed { delayed.cancel(); }
			self._delayed.clear();
			self._context.close();
		} catch (string error) { self._closeFailure = error; throw error; }
		self._closed = true;
		return CALLBACK_CANCELLATION_COMPLETE;
	}

	public void __del__() { if (self.close() != CALLBACK_CANCELLATION_COMPLETE) { Console.fatal("Native application destroyed before subtree cleanup completed"); } }
}
