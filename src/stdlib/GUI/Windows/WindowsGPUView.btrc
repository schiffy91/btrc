import Library.GUI.IView;
import Library.Callback;
import Library.Console;
import Library.GPU.GPUDevice;
import Library.GPU.GPUSurfaceRenderer;
import Library.GPU.GPUProgram;
import Library.GPU.GPUReadback;
import Library.GUI.IGPUView;
import Library.GUI.Windows.Win32;
import Library.GUI.Windows.WebGPUSurface;
import Library.GUI.Windows.WindowsContext;
import Library.GUI.Windows.WindowsView;

#include <string.h>

/* One child HWND's WebGPU surface (WGPUSurfaceSourceWindowsHWND). Renderers
 * borrow the handles; the owner releases them after every dependent frame
 * resource and before the HWND is destroyed. Backing size is the client area
 * in device pixels; the scale is the window's DPI. */
class WindowsGPUSurface {
	private HWND _window;
	private WGPUInstance? _instance;
	private WGPUSurface? _surface;
	private int _pixelWidth = 0;
	private int _pixelHeight = 0;
	private double _backingScale = 1.0;

	public WindowsGPUSurface(HWND window, HINSTANCE module) {
		if (window == null) { throw "GPU surface requires a native window"; }
		self._window = window;
		self._instance = wgpuCreateInstance(null);
		if (self._instance == null) { throw "Cannot create WebGPU instance"; }
		WGPUSurfaceDescriptor descriptor;
		memset(&descriptor, 0, sizeof(WGPUSurfaceDescriptor));
		WGPUSurfaceSourceWindowsHWND source;
		memset(&source, 0, sizeof(WGPUSurfaceSourceWindowsHWND));
		source.chain.sType = WGPUSType_SurfaceSourceWindowsHWND;
		source.hinstance = (void*)module;
		source.hwnd = (void*)window;
		descriptor.nextInChain = &source.chain;
		self._surface = wgpuInstanceCreateSurface(self._instance, &descriptor);
		if (self._surface == null) { self.close(); throw "Cannot create native WebGPU surface"; }
		self.refreshBackingSize();
	}

	private HWND window() {
		var window = self._window;
		if (window == null) { throw "GPU surface is closed"; }
		return window;
	}

	public WGPUInstance nativeInstance() {
		self.window();
		var instance = self._instance;
		if (instance == null) { throw "GPU surface is closed"; }
		return instance;
	}

	public WGPUSurface nativeSurface() {
		self.window();
		var surface = self._surface;
		if (surface == null) { throw "GPU surface is closed"; }
		return surface;
	}

	public int pixelWidth() { self.window(); return self._pixelWidth; }

	public int pixelHeight() { self.window(); return self._pixelHeight; }

	public double backingScale() { self.window(); return self._backingScale; }

	public void refreshBackingSize() {
		var window = self.window();
		RECT client;
		if (GetClientRect(window, &client) == 0) { throw "Cannot read GPU backing size"; }
		self._pixelWidth = client.right - client.left;
		self._pixelHeight = client.bottom - client.top;
		self._backingScale = WindowsMetrics.scale(window);
	}

	public void close() {
		self._surface = null;
		self._instance = null;
		self._window = null;
		self._pixelWidth = 0;
		self._pixelHeight = 0;
		self._backingScale = 1.0;
	}

	public void __del__() { self.close(); }
}

/* A WebGPU child HWND with its own device and surface, as on macOS.
 * Construction publishes no asynchronous work; poll() requests the adapter and
 * device without blocking. The view's CallbackScope owns programs and
 * readbacks, and the subtree retains this view until the device has closed. */
class WindowsGPUView implements IGPUView, IWindowsView {
	public ViewInteractionState interactionState() { return self._view.interactionState(); }

	public ICallbackRegistration onInteractionStateChanged(IViewInteractionStateHandler handler, CallbackScope owner) { return self._view.onInteractionStateChanged(handler, owner); }

	private WindowsView _view;
	private WindowsGPUSurface? _target;
	private GPUDevice? _device;
	private GPUSurfaceRenderer? _renderer;
	private CallbackScope _work = CallbackScope();
	private bool _capture;
	private bool _captureRequestPending = false;
	private bool _closing = false;
	private bool _deviceClosing = false;
	private bool _closed = false;
	private bool _closeFailed = false;
	private string _error = "";

	public WindowsGPUView(WindowsContext context, bool capture) {
		self._view = WindowsView(context, WindowsClasses.viewName(), (DWORD)WS_CLIPCHILDREN, (DWORD)0, "");
		self._capture = capture;
		self._target = WindowsGPUSurface(self._view.nativeHandle(), context.instance);
	}

	private void requireExecutor() { self._work.isOpen(); }

	private void requireOpen() { self.requireExecutor(); if (self._closing || self._closed) { throw "GPU view is closing or closed"; } }

	private WindowsGPUSurface target() {
		var target = self._target;
		if (target == null) { throw "GPU view is closed"; }
		return target;
	}

	public HWND nativeHandle() { self.requireOpen(); return self._view.nativeHandle(); }

	public void attachTo(HWND parent) { self.requireOpen(); self._view.attachTo(parent); }

	public void detachFrom(HWND parent) { self.requireOpen(); self._view.detachFrom(parent); }

	public bool isOpen() { self.requireExecutor(); return !self._closing && !self._closed; }

	public double fittingWidth() { self.requireOpen(); return self._view.fittingWidth(); }

	public double fittingHeight() { self.requireOpen(); return self._view.fittingHeight(); }

	public void arrange(double x, double y, double width, double height) { self.requireOpen(); self._view.arrange(x, y, width, height); }

	public bool isVisible() { self.requireOpen(); return self._view.isVisible(); }

	public void setVisible(bool visible) { self.requireOpen(); self._view.setVisible(visible); }

	public ICallbackRegistration onPointer(IViewPointerHandler handler, CallbackScope owner) { self.requireOpen(); return self._view.onPointer(handler, owner); }

	public ICallbackRegistration onScroll(IViewScrollHandler handler, CallbackScope owner) { self.requireOpen(); return self._view.onScroll(handler, owner); }

	public double backingScale() { self.requireOpen(); var target = self.target(); target.refreshBackingSize(); return target.backingScale(); }

	public int pixelWidth() { self.requireOpen(); var target = self.target(); target.refreshBackingSize(); return target.pixelWidth(); }

	public int pixelHeight() { self.requireOpen(); var target = self.target(); target.refreshBackingSize(); return target.pixelHeight(); }

	public string error() { self.requireExecutor(); return self._error; }

	public bool poll() {
		self.requireOpen();
		if (!self._error.isEmpty()) { return false; }
		self._work.pollCompletion();
		try {
			var target = self.target();
			if (self._device == null) { self._device = GPUDevice(target.nativeInstance(), target.nativeSurface()); }
			var device = self._device;
			if (device == null) { throw "GPU device construction returned no owner"; }
			var state = device.poll();
			if (state == GPU_DEVICE_FAILED) { self._error = device.error(); return false; }
			if (state != GPU_DEVICE_READY) { return false; }
			if (self._renderer == null) {
				var renderer = GPUSurfaceRenderer(device, target.nativeSurface(), self._capture);
				self._renderer = renderer;
				if (self._captureRequestPending) { self._captureRequestPending = false; renderer.requestCapture(); }
			}
		} catch (string error) { self._error = error; return false; }
		return true;
	}

	public GPUSurfaceRenderer frameRenderer() {
		self.requireOpen();
		if (self._renderer == null) { throw "GPU view is not ready"; }
		return self._renderer;
	}

	public GPUFrameAvailability beginFrame(double red, double green, double blue, double alpha = 1.0) {
		var renderer = self.frameRenderer();
		var target = self.target();
		target.refreshBackingSize();
		bool visible = IsWindowVisible(self._view.nativeHandle()) != 0;
		renderer.resize(visible ? target.pixelWidth() : 0, visible ? target.pixelHeight() : 0);
		return renderer.beginFrame(red, green, blue, alpha);
	}

	public GPUProgram createProgram(string source, int uniformFloatCount, bool textured = true, bool sourceOver = true, string vertexEntry = "vs_main", string fragmentEntry = "fs_main") {
		var renderer = self.frameRenderer();
		return GPUProgram.create(renderer.device(), renderer.nativeFormat(), source, uniformFloatCount, textured, sourceOver, vertexEntry, fragmentEntry, self._work);
	}

	public void requestCapture() {
		self.requireOpen();
		var renderer = self._renderer;
		if (renderer == null) { self._captureRequestPending = true; return; }
		renderer.requestCapture();
	}

	public GPUReadback readback(int maximumPixels = 16777216) { return GPUReadback.create(self.frameRenderer(), maximumPixels, self._work); }

	public CallbackCancellation close() {
		self.requireExecutor();
		if (self._closed) { return CALLBACK_CANCELLATION_COMPLETE; }
		if (!self._closing) {
			self._view.requireDetached();
			self._closing = true;
			try {
				if (self._renderer != null) { self._renderer.close(); }
				self._work.cancel();
			} catch (string error) { self._error = error; self._closeFailed = true; }
		}
		return self.pollClose();
	}

	/* The device closes and the surface is released before the HWND it
	 * borrows is destroyed. */
	public CallbackCancellation pollClose() {
		self.requireExecutor();
		if (self._closed) { return CALLBACK_CANCELLATION_COMPLETE; }
		if (!self._closing) { return CALLBACK_CANCELLATION_NOT_REQUESTED; }
		if (self._closeFailed) { return CALLBACK_CANCELLATION_FAILED; }
		try {
			var work = self._work.pollCompletion();
			if (work != CALLBACK_CANCELLATION_COMPLETE) { return work; }
			var device = self._device;
			if (device != null) {
				if (!self._deviceClosing) { self._deviceClosing = true; device.close(); }
				if (device.poll() != GPU_DEVICE_CLOSED) { return CALLBACK_CANCELLATION_PENDING; }
			}
			self._renderer = null;
			self._device = null;
			var target = self._target;
			if (target != null) { target.close(); }
			self._target = null;
			var view = self._view.close();
			if (view != CALLBACK_CANCELLATION_COMPLETE) { return view; }
			self._closed = true;
		} catch (string error) { self._error = error; self._closeFailed = true; return CALLBACK_CANCELLATION_FAILED; }
		return CALLBACK_CANCELLATION_COMPLETE;
	}

	public void __del__() {
		if (self._view == null) { if (self._target != null) { self._target.close(); } return; }
		if (self.close() != CALLBACK_CANCELLATION_COMPLETE) { Console.fatal("GPU view destroyed before native work drained"); }
	}
}
