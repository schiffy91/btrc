import Library.Callback;
import Library.App;

enum WindowExposure {
	WINDOW_EXPOSURE_EXPOSED,
	WINDOW_EXPOSURE_NOT_EXPOSED,
	WINDOW_EXPOSURE_UNKNOWN
};

enum WindowExposureReason {
	WINDOW_EXPOSURE_REASON_NONE,
	WINDOW_EXPOSURE_REASON_HIDDEN,
	WINDOW_EXPOSURE_REASON_MINIMIZED,
	WINDOW_EXPOSURE_REASON_OCCLUDED
};

class ViewInteractionState {
	public bool localVisible;
	public bool localEnabled;
	public bool inheritedEligible;
	public bool effectiveEligible;
	public bool layoutParticipating;
	public WindowExposure exposure;
	public bool faulted;
	public long long stateRevision;
}

/* Synchronous native input. True consumes the event; false leaves normal
 * platform dispatch intact. Coordinates are view-local top-left logical points.
 * A consumed press captures its matching drag/release, including outside the
 * view. Subscribe after attaching to a window. Detaching cancels current capture
 * but preserves the subscription for reattachment. Capture also ends on release,
 * focus loss, registration cancellation or close. */
interface IViewPointerHandler { bool pointer(AppPointerEvent event); }
interface IViewScrollHandler { bool scroll(AppScrollEvent event); }

/* Native view contract. Layout uses logical points from the parent's top-left.
 * Fitting sizes are native minima: an unconstrained dimension may be zero.
 * Measure before arranging; attachment and subtree ownership belong to the
 * container. Visibility is the view's own flag, not a promise of on-screen
 * exposure. Interface aliases refer to the same view and observe its close.
 * An attached view must be detached before an alias can close it; its owning
 * container closes it during subtree shutdown. close() starts shutdown once;
 * Pending retains ownership and requires pollClose() on the UI executor.
 * Polling never starts shutdown or retries a failed native operation.
 * Hiding preserves the local flag but ends effective input eligibility; no
 * subscription replays initial state. State revisions let a subscriber discard
 * observations no newer than its getter snapshot. Occlusion alone does not
 * cancel editing. COMPLETE forbids further callback entry. */
interface IView {
	ViewInteractionState interactionState();
	ICallbackRegistration onInteractionStateChanged(IViewInteractionStateHandler handler, CallbackScope owner);
	bool isOpen();
	double fittingWidth();
	double fittingHeight();
	void arrange(double x, double y, double width, double height);
	bool isVisible();
	void setVisible(bool visible);
	ICallbackRegistration onPointer(IViewPointerHandler handler, CallbackScope owner);
	ICallbackRegistration onScroll(IViewScrollHandler handler, CallbackScope owner);
	CallbackCancellation close();
	CallbackCancellation pollClose();
}

interface IViewInteractionStateHandler { void interactionChanged(ViewInteractionState state); }
