/* btrc standard library — GUI raster surfaces (software-rendered)
 *
 * Surface owns pixels, resizing, fills and readback in BTRC, including
 * scalable text drawn from owned font glyph snapshots. Native windows and
 * controls use Library.GUI.GUI; painted widget trees use Library.UI. Raster
 * surfaces remain independent offscreen image buffers.
 *
 * NOT auto-included. Use: import Library.GUI.Raster;
 * No native raster archive is needed. Optional FreeType uses its package plan.
 *
 *   var surface = Surface(480, 320);
 *   surface.clear(RGBA(250, 248, 245));
 *   surface.text(16, 16, "Hello", RGBA(43, 38, 34), 2);
 */

import Library.OwnedBuffer;
import Library.Image;
import Library.GUI.Font;
import Library.GUI.FontFace;
import Library.GUI.Geometry;

/* Borrowed pixels for one synchronous raster operation, packed as uint32
 * in 0xRRGGBBAA order. Never retain this view. */
struct GUIRasterPixels {
	int width;
	int height;
	unsigned int* pixels;
};

class GUIRaster {
	/* One byte per glyph row, top row in the low byte; bit zero is leftmost. */
	class unsigned long long glyph(int codepoint) {
		if (codepoint >= 97 && codepoint <= 122) { codepoint -= 32; }
		switch (codepoint) {
			case 32: return 0ULL;
			case 33: return 0x0004000404040404ULL;
			case 34: return 0x00000000000a0a0aULL;
			case 35: return 0x000a0a1f0a1f0a0aULL;
			case 39: return 0x0000000000040404ULL;
			case 40: return 0x0004020101010204ULL;
			case 41: return 0x0004081010100804ULL;
			case 42: return 0x00000a041f040a00ULL;
			case 43: return 0x000004041f040400ULL;
			case 44: return 0x0002060600000000ULL;
			case 45: return 0x000000001f000000ULL;
			case 46: return 0x0006060000000000ULL;
			case 47: return 0x0001020204080810ULL;
			case 48: return 0x000e11131519110eULL;
			case 49: return 0x000e040404040604ULL;
			case 50: return 0x001f02040810110eULL;
			case 51: return 0x000e11100c10110eULL;
			case 52: return 0x0008081f090a0c08ULL;
			case 53: return 0x000e1110100f011fULL;
			case 54: return 0x000e11110f01020cULL;
			case 55: return 0x000202020408101fULL;
			case 56: return 0x000e11110e11110eULL;
			case 57: return 0x000608101e11110eULL;
			case 58: return 0x0000060600060600ULL;
			case 59: return 0x0002060600060600ULL;
			case 60: return 0x0010080402040810ULL;
			case 61: return 0x0000001f001f0000ULL;
			case 62: return 0x0001020408040201ULL;
			case 63: return 0x000400040408110eULL;
			case 65: return 0x001111111f11110eULL;
			case 66: return 0x000f11110f11110fULL;
			case 67: return 0x000e11010101110eULL;
			case 68: return 0x000f11111111110fULL;
			case 69: return 0x001f01010f01011fULL;
			case 70: return 0x000101010f01011fULL;
			case 71: return 0x000e11111d01110eULL;
			case 72: return 0x001111111f111111ULL;
			case 73: return 0x000e04040404040eULL;
			case 74: return 0x000609090808081cULL;
			case 75: return 0x0011090503050911ULL;
			case 76: return 0x001f010101010101ULL;
			case 77: return 0x0011111115151b11ULL;
			case 78: return 0x0011111915131111ULL;
			case 79: return 0x000e11111111110eULL;
			case 80: return 0x000101010f11110fULL;
			case 81: return 0x001609151111110eULL;
			case 82: return 0x001109050f11110fULL;
			case 83: return 0x000f10100e01011eULL;
			case 84: return 0x000404040404041fULL;
			case 85: return 0x000e111111111111ULL;
			case 86: return 0x00040a1111111111ULL;
			case 87: return 0x00111b1515111111ULL;
			case 88: return 0x0011110a040a1111ULL;
			case 89: return 0x00040404040a1111ULL;
			case 90: return 0x001f01020408101fULL;
			case 91: return 0x000e02020202020eULL;
			case 92: return 0x0010080804020201ULL;
			case 93: return 0x000e08080808080eULL;
			case 95: return 0x001f000000000000ULL;
			default: return 0x001F11111111111FULL;
		}
	}

	class int nextCodepoint(string text, int length, int* offset) {
		int start = *offset;
		if (start >= length) { return -1; }
		*offset = start + 1;
		int first = (int)(unsigned char)text[start];
		if (first < 128) { return first; }
		int count = 0;
		int minimum = 0;
		int codepoint = 0;
		if ((first & 224) == 192) { count = 2; minimum = 128; codepoint = first & 31; }
		else if ((first & 240) == 224) { count = 3; minimum = 2048; codepoint = first & 15; }
		else if ((first & 248) == 240) { count = 4; minimum = 65536; codepoint = first & 7; }
		else { return 65533; }
		if (count > length - start) { return 65533; }
		for (int index = 1; index < count; index++) {
			int next = (int)(unsigned char)text[start + index];
			if ((next & 192) != 128) { return 65533; }
			codepoint = (codepoint << 6) | (next & 63);
		}
		if (codepoint < minimum || codepoint > 1114111 || (codepoint >= 55296 && codepoint <= 57343)) { return 65533; }
		*offset = start + count;
		return codepoint;
	}

	class unsigned int packed(RGBA color) { return ((unsigned int)color.red << 24) | ((unsigned int)color.green << 16) | ((unsigned int)color.blue << 8) | (unsigned int)color.alpha; }

	class long long advance(long long position, long long distance) { return position > 9223372036854775807LL - distance ? 9223372036854775807LL : position + distance; }

	class unsigned int blendChannel(unsigned int source, unsigned int sourceAlpha, unsigned int destination, unsigned int destinationAlpha, unsigned int alphaNumerator) {
		if (alphaNumerator == 0U) { return 0U; }
		unsigned int numerator = source * sourceAlpha * 255U + destination * destinationAlpha * (255U - sourceAlpha);
		return (numerator + alphaNumerator / 2U) / alphaNumerator;
	}

	/* The pixel view is borrowed only for this synchronous raster operation. */
	class void blendPixel(struct GUIRasterPixels* pixels, int x, int y, unsigned int rgba) {
		if (pixels == null || pixels->pixels == null || x < 0 || y < 0 || x >= pixels->width || y >= pixels->height) { return; }
		size_t index = (size_t)y * (size_t)pixels->width + (size_t)x;
		unsigned int destination = pixels->pixels[index];
		unsigned int sourceAlpha = rgba & 255U;
		unsigned int destinationAlpha = destination & 255U;
		unsigned int alphaNumerator = sourceAlpha * 255U + destinationAlpha * (255U - sourceAlpha);
		unsigned int red = GUIRaster.blendChannel((rgba >> 24) & 255U, sourceAlpha, (destination >> 24) & 255U, destinationAlpha, alphaNumerator);
		unsigned int green = GUIRaster.blendChannel((rgba >> 16) & 255U, sourceAlpha, (destination >> 16) & 255U, destinationAlpha, alphaNumerator);
		unsigned int blue = GUIRaster.blendChannel((rgba >> 8) & 255U, sourceAlpha, (destination >> 8) & 255U, destinationAlpha, alphaNumerator);
		pixels->pixels[index] = (red << 24) | (green << 16) | (blue << 8) | ((alphaNumerator + 127U) / 255U);
	}

	class void rectangle(struct GUIRasterPixels* pixels, long long x, long long y, long long width, long long height, unsigned int rgba, bool blend) {
		if (pixels == null || pixels->pixels == null || width <= 0LL || height <= 0LL) { return; }
		long long left = x < 0LL ? 0LL : x;
		long long top = y < 0LL ? 0LL : y;
		long long right = GUIRaster.advance(x, width);
		long long bottom = GUIRaster.advance(y, height);
		if (right > (long long)pixels->width) { right = (long long)pixels->width; }
		if (bottom > (long long)pixels->height) { bottom = (long long)pixels->height; }
		for (long long row = top; row < bottom; row++) {
			for (long long column = left; column < right; column++) {
				if (blend) { GUIRaster.blendPixel(pixels, (int)column, (int)row, rgba); }
				else { pixels->pixels[(size_t)row * (size_t)pixels->width + (size_t)column] = rgba; }
			}
		}
	}

	class void bitmapText(struct GUIRasterPixels* pixels, int x, int y, string text, unsigned int rgba, int scale) {
		if (text == null) { return; }
		if (scale < 1) { scale = 1; }
		int offset = 0;
		int length = text.len();
		long long penX = (long long)x;
		long long penY = (long long)y;
		long long advance = 8LL * (long long)scale;
		while (offset < length) {
			int codepoint = GUIRaster.nextCodepoint(text, length, &offset);
			if (codepoint == 10) { penX = (long long)x; penY = GUIRaster.advance(penY, advance); continue; }
			unsigned long long glyph = GUIRaster.glyph(codepoint);
			for (int row = 0; row < 8; row++) {
				unsigned int bits = (unsigned int)((glyph >> (row * 8)) & 255ULL);
				for (int column = 0; column < 8; column++) {
					if (((bits >> column) & 1U) != 0U) {
						GUIRaster.rectangle(pixels, GUIRaster.advance(penX, (long long)column * (long long)scale), GUIRaster.advance(penY, (long long)row * (long long)scale), (long long)scale, (long long)scale, rgba, false);
					}
				}
			}
			penX = GUIRaster.advance(penX, advance);
		}
	}

	class int textWidth(string text, int scale) {
		if (text == null) { return 0; }
		if (scale < 1) { scale = 1; }
		int offset = 0;
		int length = text.len();
		int current = 0;
		int maximum = 0;
		while (offset < length) {
			int codepoint = GUIRaster.nextCodepoint(text, length, &offset);
			if (codepoint == 10) { if (current > maximum) { maximum = current; } current = 0; }
			else { current = GUIInt.clamp((long long)current + 8LL * (long long)scale); }
		}
		return current > maximum ? current : maximum;
	}

	class int textHeight(int scale) { return GUIInt.clamp(8LL * (long long)(scale < 1 ? 1 : scale)); }

	class long long signedAdvance(long long position, long long distance) {
		if (distance > 0LL && position > 9223372036854775807LL - distance) { return 9223372036854775807LL; }
		if (distance < 0LL && position < (-9223372036854775807LL - 1LL) - distance) { return -9223372036854775807LL - 1LL; }
		return position + distance;
	}

	class int fontPixels(long long fixedPoint) { return GUIInt.clamp(fixedPoint / 64LL); }

	class int fontWidth(Font font, string text) {
		if (text == null) { return 0; }
		int offset = 0;
		int length = text.len();
		int current = 0;
		int maximum = 0;
		while (offset < length) {
			int codepoint = GUIRaster.nextCodepoint(text, length, &offset);
			if (codepoint == 10) { if (current > maximum) { maximum = current; } current = 0; continue; }
			var glyph = font.glyph(codepoint, false);
			if (glyph == null) { continue; }
			int advance = GUIRaster.fontPixels(glyph.advanceX26_6());
			if (advance > 0) { current = GUIInt.clamp((long long)current + (long long)advance); }
		}
		return current > maximum ? current : maximum;
	}

	class void fontText(struct GUIRasterPixels* pixels, Font font, int x, int y, string text, unsigned int rgba) {
		var metrics = font.metrics();
		long long penX = (long long)x;
		long long baseline = GUIRaster.signedAdvance((long long)y, (long long)GUIRaster.fontPixels(metrics.ascenderFixed()));
		int lineHeight = GUIRaster.fontPixels(metrics.heightFixed());
		int offset = 0;
		int length = text.len();
		while (offset < length) {
			int codepoint = GUIRaster.nextCodepoint(text, length, &offset);
			if (codepoint == 10) { penX = (long long)x; baseline = GUIRaster.signedAdvance(baseline, (long long)lineHeight); continue; }
			var glyph = font.glyph(codepoint, true);
			if (glyph == null) { continue; }
			if (glyph.pixelMode() != FONT_PIXEL_UNSUPPORTED) {
				for (int row = 0; row < glyph.rows(); row++) {
					for (int column = 0; column < glyph.width(); column++) {
						int coverage = glyph.coverage(row, column);
						if (coverage == 0) { continue; }
						long long px = GUIRaster.signedAdvance(GUIRaster.signedAdvance(penX, (long long)glyph.bitmapLeft()), (long long)column);
						long long py = GUIRaster.signedAdvance(GUIRaster.signedAdvance(baseline, -(long long)glyph.bitmapTop()), (long long)row);
						if (px < -2147483648LL || px > 2147483647LL || py < -2147483648LL || py > 2147483647LL) { continue; }
						unsigned int alpha = ((rgba & 255U) * (unsigned int)coverage + 127U) / 255U;
						GUIRaster.blendPixel(pixels, (int)px, (int)py, (rgba & 4294967040U) | alpha);
					}
				}
			}
			penX = GUIRaster.signedAdvance(penX, (long long)GUIRaster.fontPixels(glyph.advanceX26_6()));
		}
	}
}

class Surface {
	private OwnedBuffer<unsigned int>? storage;
	private int pixelWidth;
	private int pixelHeight;
	private Font? selectedFont;

	public Surface(int width, int height) {
		self.storage = null;
		self.pixelWidth = 0;
		self.pixelHeight = 0;
		self.selectedFont = null;
		self.resize(width, height);
	}

	public bool opened() { return self.storage != null; }

	public int width() { return self.pixelWidth; }

	public int height() { return self.pixelHeight; }

	/* Null explicitly selects the built-in bitmap font. Like pixel mutation,
	 * selection changes belong to this surface's synchronous owner. */
	public void setFont(Font? font) { self.selectedFont = font; }

	public int textWidth(string text, int scale = 1) {
		var font = self.selectedFont;
		return font == null ? GUIRaster.textWidth(text, scale) : GUIRaster.fontWidth(font, text);
	}

	public int textHeight(int scale = 1) {
		var font = self.selectedFont;
		if (font == null) { return GUIRaster.textHeight(scale); }
		int height = GUIRaster.fontPixels(font.metrics().heightFixed());
		return height > 0 ? height : 0;
	}

	/* Synchronous native consumers borrow pixels only until their call returns.
	 * Resizing replaces storage; callers must never retain this address. */
	public unsigned int* pixels() { return self.storage == null ? null : self.storage.borrow(); }

	public void resize(int width, int height) {
		if (width <= 0 || height <= 0 || (width == self.pixelWidth && height == self.pixelHeight)) { return; }
		if ((size_t)width > (size_t)(-1) / (size_t)height / sizeof(unsigned int)) { return; }
		var replacement = new OwnedBuffer<unsigned int>((size_t)width * (size_t)height);
		if (!replacement.opened()) { return; }
		int copyWidth = self.pixelWidth < width ? self.pixelWidth : width;
		int copyHeight = self.pixelHeight < height ? self.pixelHeight : height;
		for (int row = 0; row < copyHeight; row++) {
			memcpy(replacement.borrow() + (size_t)row * (size_t)width, self.pixels() + (size_t)row * (size_t)self.pixelWidth, (size_t)copyWidth * sizeof(unsigned int));
		}
		self.storage = replacement;
		self.pixelWidth = width;
		self.pixelHeight = height;
	}

	public void clear(RGBA color) {
		if (!self.opened()) { return; }
		unsigned int rgba = GUIRaster.packed(color);
		unsigned int* pixels = self.pixels();
		size_t count = (size_t)self.pixelWidth * (size_t)self.pixelHeight;
		for (size_t index = (size_t)0; index < count; index++) { pixels[index] = rgba; }
	}

	public void fillRect(int x, int y, int width, int height, RGBA color) {
		if (!self.opened() || width <= 0 || height <= 0) { return; }
		long long left = x < 0 ? 0LL : (long long)x;
		long long top = y < 0 ? 0LL : (long long)y;
		long long right = (long long)x + (long long)width;
		long long bottom = (long long)y + (long long)height;
		if (right > (long long)self.pixelWidth) { right = (long long)self.pixelWidth; }
		if (bottom > (long long)self.pixelHeight) { bottom = (long long)self.pixelHeight; }
		unsigned int rgba = GUIRaster.packed(color);
		unsigned int* pixels = self.pixels();
		for (long long row = top; row < bottom; row++) {
			for (long long column = left; column < right; column++) { pixels[(size_t)row * (size_t)self.pixelWidth + (size_t)column] = rgba; }
		}
	}

	public void blendRect(int x, int y, int width, int height, RGBA color) {
		if (!self.opened()) { return; }
		struct GUIRasterPixels view;
		view.width = self.pixelWidth;
		view.height = self.pixelHeight;
		view.pixels = self.pixels();
		GUIRaster.rectangle(&view, (long long)x, (long long)y, (long long)width, (long long)height, GUIRaster.packed(color), true);
	}

	public void text(int x, int y, string text, RGBA color, int scale) {
		if (!self.opened()) { return; }
		struct GUIRasterPixels view;
		view.width = self.pixelWidth;
		view.height = self.pixelHeight;
		view.pixels = self.pixels();
		if (text == null) { return; }
		unsigned int rgba = GUIRaster.packed(color);
		var font = self.selectedFont;
		if (font == null) { GUIRaster.bitmapText(&view, x, y, text, rgba, scale); }
		else { GUIRaster.fontText(&view, font, x, y, text, rgba); }
	}

	public unsigned int pixel(int x, int y) {
		if (x < 0 || y < 0 || x >= self.pixelWidth || y >= self.pixelHeight) { return 0U; }
		return self.pixels()[(size_t)y * (size_t)self.pixelWidth + (size_t)x];
	}

	public bool savePpm(string path) {
		if (!self.opened() || path == null) { return false; }
		FILE* output = fopen(path, "wb");
		if (output == null) { return false; }
		bool written = fprintf(output, "P6\n%d %d\n255\n", self.pixelWidth, self.pixelHeight) >= 0;
		size_t count = (size_t)self.pixelWidth * (size_t)self.pixelHeight;
		unsigned int* pixels = self.pixels();
		unsigned char rgb[3];
		for (size_t index = (size_t)0; written && index < count; index++) {
			unsigned int pixel = pixels[index];
			rgb[0] = (unsigned char)(pixel >> 24);
			rgb[1] = (unsigned char)(pixel >> 16);
			rgb[2] = (unsigned char)(pixel >> 8);
			written = fwrite(rgb, (size_t)1, (size_t)3, output) == (size_t)3;
		}
		if (fclose(output) != 0) { written = false; }
		return written;
	}
}
