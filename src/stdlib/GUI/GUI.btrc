import Library.Callback;
import Library.GUI.IApplication;
import Library.GUI.ApplicationSlot;
import Library.GUI.IWindow;
import Library.GUI.IDirectoryPicker;
import Library.GUI.IButton;
import Library.GUI.ITextField;
import Library.GUI.IContainer;
import Library.GUI.IStack;
import Library.GUI.IGPUView;
import Library.GUI.ILabel;
import Library.GUI.IImageView;
import Library.GUI.IImageHandle;
import Library.GUI.IPanel;
import Library.GUI.IProgressIndicator;
import Library.GUI.ILevelIndicator;
import Library.GUI.ISlider;
import Library.GUI.ISelect;
import Library.GUI.IScrollView;
import Library.GUI.IGrid;
import Library.GUI.GUICaptureLayer;
import Library.GUI.TextRun;
import Library.App;
import Library.Image;
import Library.Vector;

/* One application owner; the package chooses its provider for the target.
 * initialize/run/close stay on the UI thread. run closes before returning,
 * including work failures; explicit close covers setup without loop entry.
 * Providers supply the application and the native services below; the
 * facade owns validation and the application's lifetime. */
class GUI {
	class void initialize(int workCapacity = 256) {
		GUIProvider.requireUIThread();
		if (GUIApplicationSlot.active != null) { throw "GUI is already initialized"; }
		if (workCapacity <= 0 || workCapacity > 65536) { throw "Application work capacity must be between 1 and 65536"; }
		GUIApplicationSlot.active = GUIProvider.createApplication(workCapacity);
	}

	class IWindow createWindow(string title, double width, double height) { GUIProvider.requireUIThread(); return GUIApplicationSlot.require().createWindow(title, width, height); }

	class IButton createButton(string title) { GUIProvider.requireUIThread(); return GUIApplicationSlot.require().createButton(title); }

	class ITextField createTextField(string text = "", string placeholder = "") { GUIProvider.requireUIThread(); return GUIApplicationSlot.require().createTextField(text, placeholder); }

	class IContainer createContainer() { GUIProvider.requireUIThread(); return GUIApplicationSlot.require().createContainer(); }

	class IStack createRow(double spacing = 8.0) { GUIProvider.requireUIThread(); return GUIApplicationSlot.require().createRow(spacing); }

	class IStack createColumn(double spacing = 8.0) { GUIProvider.requireUIThread(); return GUIApplicationSlot.require().createColumn(spacing); }

	class IGPUView createGPUView(bool capture = false) { GUIProvider.requireUIThread(); return GUIApplicationSlot.require().createGPUView(capture); }

	class ILabel createLabel(string text = "") { GUIProvider.requireUIThread(); return GUIApplicationSlot.require().createLabel(text); }

	class IImageView createImageView() { GUIProvider.requireUIThread(); return GUIApplicationSlot.require().createImageView(); }

	/* Convert decoded pixels to the platform image on the calling thread, which
	 * may be a worker; it needs no initialized application (see IImageHandle). */
	class IImageHandle createImageHandle(Image pixels, int maximumPixels = 16777216) { return GUIProvider.createImageHandle(pixels, maximumPixels); }

	class IPanel createPanel(RGBA fill, double radius = 0.0) { GUIProvider.requireUIThread(); return GUIApplicationSlot.require().createPanel(fill, radius); }

	class IProgressIndicator createProgressIndicator() { GUIProvider.requireUIThread(); return GUIApplicationSlot.require().createProgressIndicator(); }

	class ILevelIndicator createLevelIndicator(double warning, double critical) { GUIProvider.requireUIThread(); return GUIApplicationSlot.require().createLevelIndicator(warning, critical); }

	class ISlider createSlider(double minimum, double maximum, int intervals = 0) { GUIProvider.requireUIThread(); return GUIApplicationSlot.require().createSlider(minimum, maximum, intervals); }

	class ISelect createSelect() { GUIProvider.requireUIThread(); return GUIApplicationSlot.require().createSelect(); }

	class IScrollView createScrollView() { GUIProvider.requireUIThread(); return GUIApplicationSlot.require().createScrollView(); }

	class IGrid createGrid(int columns, int rows, double columnSpacing = 0.0, double rowSpacing = 0.0) { GUIProvider.requireUIThread(); return GUIApplicationSlot.require().createGrid(columns, rows, columnSpacing, rowSpacing); }

	/* Legacy nested loop: excluded from executor fairness and forbidden inside
	 * close-decision handlers. */
	class DirectoryPickerOutcome chooseDirectory(DirectoryPickerRequest request) { GUIProvider.requireUIThread(); return GUIProvider.chooseDirectory(GUIApplicationSlot.require(), request); }

	class void rasterizeText(TextRasterization request) { GUIProvider.requireUIThread(); GUIProvider.rasterizeText(GUIApplicationSlot.active, request); }

	class Image capture(IView root, Vector<GUICaptureLayer> layers) { GUIProvider.requireUIThread(); return GUIProvider.capture(GUIApplicationSlot.require(), root, layers); }

	class void post(IApplicationWork work) { GUIProvider.requireUIThread(); GUIApplicationSlot.require().post(work); }

	class ICallbackRegistration postAfter(double delaySeconds, IApplicationWork work) { GUIProvider.requireUIThread(); return GUIApplicationSlot.require().postAfter(delaySeconds, work); }

	class ApplicationPublisherOutcome createPublisher(int capacity, IApplicationPublicationHandler handler, CallbackScope owner) {
		GUIProvider.requireUIThread();
		return GUIApplicationSlot.require().createPublisher(capacity, handler, owner);
	}

	class ScheduleOutcome schedule(IApplicationWork work, double delaySeconds, WorkSuspensionPolicy policy, long long replacementKey) {
		GUIProvider.requireUIThread();
		return GUIApplicationSlot.require().schedule(work, delaySeconds, policy, replacementKey);
	}

	/* The facade owns slot cleanup even when the host, not run(), drives turns. */
	class ApplicationHostAttachOutcome attachHost(IApplicationHost host, CallbackScope owner) {
		GUIProvider.requireUIThread();
		if (owner == null) { throw "Application host requires a callback scope"; }
		owner.requireExecutor();
		if (!owner.isOpen()) { throw "Application host callback scope is closing"; }
		var application = GUIApplicationSlot.require();
		var attachmentScope = CallbackScope();
		var attachment = GUIHostAttachment(application, attachmentScope);
		/* Scope admission precedes native publication, so a rejecting owner can
		 * never strand an attached host whose cancellation is still pending. */
		owner.track(attachment);
		var result = application.attachHost(host, attachmentScope);
		if (result.kind == APPLICATION_HOST_ATTACHED && result.attachment != null) {
			attachment.activate(result.attachment);
			result.attachment = attachment;
		}
		return result;
	}

	class void requestQuit() { GUIProvider.requireUIThread(); GUIApplicationSlot.require().requestQuit(); }

	class void run() {
		GUIProvider.requireUIThread();
		var application = GUIApplicationSlot.require();
		if (application.isRunning()) { throw "GUI is already running"; }
		try { application.run(); } finally { GUI.close(); }
	}

	class CallbackCancellation close() {
		GUIProvider.requireUIThread();
		var application = GUIApplicationSlot.active;
		if (application == null) { return CALLBACK_CANCELLATION_COMPLETE; }
		var result = application.close();
		if (result == CALLBACK_CANCELLATION_COMPLETE) { GUIApplicationSlot.active = null; }
		return result;
	}
}

/* Package-private lifecycle adapter; provider attachment state stays native.
 * Scope cancellation and host-driven terminal turns both finish facade ownership. */
class GUIHostAttachment implements IApplicationHostAttachment {
	private IApplication application;
	private IApplicationHostAttachment? attachment;
	private CallbackScope scope;

	public GUIHostAttachment(IApplication application, CallbackScope scope) {
		self.application = application;
		self.attachment = null;
		self.scope = scope;
	}

	public void activate(IApplicationHostAttachment attachment) { self.attachment = attachment; }

	private CallbackCancellation finish(CallbackCancellation status) {
		if (status != CALLBACK_CANCELLATION_COMPLETE) { return status; }
		status = self.application.close();
		if (status == CALLBACK_CANCELLATION_COMPLETE && GUIApplicationSlot.active == self.application) { GUIApplicationSlot.active = null; }
		return status;
	}

	public bool isOpen() { GUIProvider.requireUIThread(); return self.attachment != null && self.attachment.isOpen(); }

	public CallbackCancellation cancel() { GUIProvider.requireUIThread(); if (self.attachment == null) { return self.scope.cancel(); } return self.finish(self.scope.cancel()); }

	public CallbackCancellation pollCompletion() {
		GUIProvider.requireUIThread();
		if (self.attachment == null) { return self.scope.cancel(); }
		var status = self.attachment.pollCompletion();
		if (status == CALLBACK_CANCELLATION_COMPLETE) { return self.finish(self.scope.cancel()); }
		return status;
	}

	public void serviceTurn() {
		GUIProvider.requireUIThread();
		if (self.attachment == null) { throw "Application host is not attached"; }
		self.attachment.serviceTurn();
		self.pollCompletion();
	}

	public void transition(ApplicationActivity activity) {
		GUIProvider.requireUIThread();
		if (self.attachment == null) { throw "Application host is not attached"; }
		self.attachment.transition(activity);
		self.pollCompletion();
	}
}
