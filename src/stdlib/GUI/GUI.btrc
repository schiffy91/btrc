import Library.Callback;
import Library.GUI.IApplication;
import Library.GUI.IWindow;
import Library.GUI.IButton;
import Library.GUI.ITextField;
import Library.GUI.IContainer;
import Library.GUI.IStack;

/* One application owner; the package chooses its provider for the target.
 * initialize/run/close stay on the UI thread. run closes before returning,
 * including work failures; explicit close covers setup without loop entry. */
class GUI {
	class void initialize(int workCapacity = 256) { GUIProvider.initialize(workCapacity); }

	class IWindow createWindow(string title, double width, double height) { return GUIProvider.application().createWindow(title, width, height); }

	class IButton createButton(string title) { return GUIProvider.application().createButton(title); }

	class ITextField createTextField(string text = "", string placeholder = "") { return GUIProvider.application().createTextField(text, placeholder); }

	class IContainer createContainer() { return GUIProvider.application().createContainer(); }

	class IStack createRow(double spacing = 8.0) { return GUIProvider.application().createRow(spacing); }

	class IStack createColumn(double spacing = 8.0) { return GUIProvider.application().createColumn(spacing); }

	class void post(IApplicationWork work) { GUIProvider.application().post(work); }

	class ICallbackRegistration postAfter(double delaySeconds, IApplicationWork work) { return GUIProvider.application().postAfter(delaySeconds, work); }

	class void requestQuit() { GUIProvider.application().requestQuit(); }

	class void run() { GUIProvider.run(); }

	class CallbackCancellation close() { return GUIProvider.close(); }
}
