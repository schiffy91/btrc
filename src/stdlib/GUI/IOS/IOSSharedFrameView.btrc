import Library.Callback;
import Library.Strings;
import Library.GUI.ISharedFrameView;
import Library.GUI.Shim.ShimView;
import Library.GUI.Shim.ShimContext;
import Library.GUI.Shim.ShimPainter;
import Library.GUI.Shim.ShimControls;

class IOSSharedFrameView extends ShimNodeView implements ISharedFrameView {
	private BtrcShimControl* _picture;

	public IOSSharedFrameView(ShimContext context) {
		self.adoptNode(ShimViewNode(context));
		self._picture = btrcUIKitFrameCreate((unsigned int)self.node().id);
		if (self._picture == null) { throw "Cannot create iOS shared frame view"; }
	}

	public SharedFrameEndpoint listen(int producerPid) {
		self.node().requireOpen();
		var address = btrcUIKitFrameListen(self._picture, producerPid);
		if (address == null) { throw "Cannot listen for IOSurface frames from that process"; }
		self.node().invalidate();
		return SharedFrameEndpoint("iosurface-xpc", Strings.copy((char*)address));
	}

	public void disconnect() {
		self.node().requireOpen();
		btrcUIKitFrameDisconnect(self._picture);
		self.node().invalidate();
	}

	public bool presentPending() {
		self.node().requireOpen();
		if (!btrcUIKitFramePresent(self._picture)) { return false; }
		self.node().invalidate();
		return true;
	}

	public int frameWidth() { self.node().requireOpen(); return btrcUIKitFrameWidth(self._picture); }

	public int frameHeight() { self.node().requireOpen(); return btrcUIKitFrameHeight(self._picture); }

	public double fittingWidth() { return (double)self.frameWidth(); }

	public double fittingHeight() { return (double)self.frameHeight(); }

	public void paint(ShimPlacer painter, double x, double y) { painter.place(self._picture, x, y, self.node().width, self.node().height); }

	private void releaseNative() {
		if (self._picture != null) {
			btrcUIKitFrameDisconnect(self._picture);
			btrcShimControlDestroy(self._picture);
			self._picture = null;
		}
	}

	public CallbackCancellation close() { var state = self.node().close(); if (state == CALLBACK_CANCELLATION_COMPLETE) { self.releaseNative(); } return state; }

	public CallbackCancellation pollClose() { var state = self.node().pollClose(); if (state == CALLBACK_CANCELLATION_COMPLETE) { self.releaseNative(); } return state; }

	public void __del__() { self.releaseNative(); }
}
