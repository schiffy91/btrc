import Library.Math;
import Library.App;
import Library.Callback;
import Library.UI.Element;
import Library.GUI.ControlEvents;
import Library.GUI.SliderInteraction;
import Library.GUI.ISlider;
import Library.GUI.Shim.ShimView;
import Library.GUI.Shim.ShimContext;
import Library.GUI.Shim.ShimPainter;
import Library.GUI.Shim.Shim;
import Library.GUI.Shim.ShimControls;

/* A GTK scale over the shared double model and interaction owner. The model
 * is the authority: the scale never changes its own value. What a person
 * asks of it arrives as events, the model answers, and the scale is then
 * shown the model's value. */
class ShimSlider extends ShimNodeView implements ISlider {
	private BtrcShimControl* _control;
	private SliderInteraction _interaction;
	private bool _enabled = true;

	public ShimSlider(ShimContext context, double minimum, double maximum, int intervals) {
		self.adoptNode(ShimViewNode(context));
		self._interaction = SliderInteraction(minimum, maximum, intervals);
		self.node().focusable = true;
		self._control = btrcShimSliderCreate((unsigned int)self.node().id);
		if (self._control == null) { throw "Cannot create native slider"; }
		self.show();
	}

	private BtrcShimControl* control() { if (self._control == null) { throw "Native slider is closed"; } return self._control; }

	/* Show the model's range and value; a slider with nowhere to go takes no input. */
	private void show() {
		if (self._control == null) { return; }
		var range = self._interaction.range();
		btrcShimSliderSet(self._control, range.minimum, range.maximum, range.step, self._interaction.value());
		btrcShimControlSetEnabled(self._control, self._enabled && !self._interaction.inert());
	}

	public void paint(ShimPlacer painter, double x, double y) { painter.place(self.control(), x, y, self.node().width, self.node().height); }

	public void controlEvent(BtrcShimEvent* event) {
		if (!self._enabled || !self.node().effectiveEligible() || self._interaction.inert()) { return; }
		unsigned int type = event->type;
		if (type == (unsigned int)BTRC_SHIM_EVENT_CONTROL_SLIDER_PRESSED) {
			if (self._interaction.active()) { return; }
			if (!self._interaction.begin(self.node().generation())) { throw "Slider interaction admission unavailable"; }
			self.node().requestFocus();
		} else if (type == (unsigned int)BTRC_SHIM_EVENT_CONTROL_SLIDER_RELEASED) {
			if (self._interaction.active()) { self._interaction.commit(); }
		} else if (type == (unsigned int)BTRC_SHIM_EVENT_CONTROL_SLIDER_CANCELLED) {
			if (self._interaction.active()) { self._interaction.cancel(CONTROL_ORIGIN_USER, CONTROL_CANCEL_ESCAPE); }
		} else if (type == (unsigned int)BTRC_SHIM_EVENT_CONTROL_SLIDER_CHANGED) {
			self.changed(event->data1, event->value);
		}
		self.show();
	}

	/* A jump while the pointer is down previews the value under it. Anything
	 * else is one relative adjustment: a key, the wheel, a click beside the knob. */
	private void changed(int change, double value) {
		if (change == (int)BTRC_SHIM_SLIDER_JUMP && self._interaction.active()) {
			if (!self._interaction.preview(value)) { throw "Slider preview queue cannot admit native input"; }
			return;
		}
		UIRangeAdjustment adjustment = UI_RANGE_ADJUST_NONE;
		if (change == (int)BTRC_SHIM_SLIDER_STEP_BACKWARD || change == (int)BTRC_SHIM_SLIDER_PAGE_BACKWARD) { adjustment = UI_RANGE_ADJUST_SMALL_DECREMENT; }
		else if (change == (int)BTRC_SHIM_SLIDER_STEP_FORWARD || change == (int)BTRC_SHIM_SLIDER_PAGE_FORWARD) { adjustment = UI_RANGE_ADJUST_SMALL_INCREMENT; }
		else if (change == (int)BTRC_SHIM_SLIDER_START) { adjustment = UI_RANGE_ADJUST_MINIMUM; }
		else if (change == (int)BTRC_SHIM_SLIDER_END) { adjustment = UI_RANGE_ADJUST_MAXIMUM; }
		if (adjustment == UI_RANGE_ADJUST_NONE || self._interaction.active()) { return; }
		if (!self._interaction.adjust(self.node().generation(), adjustment, 1)) { throw "Slider adjustment admission unavailable"; }
	}

	public void focus(bool focused) { if (!focused) { self._interaction.cancel(CONTROL_ORIGIN_SYSTEM, CONTROL_CANCEL_PLATFORM_INTERRUPTION); self.show(); } }

	public ICallbackRegistration onPreview(ISliderControlEventHandler receiver, CallbackScope owner) {
		self.node().requireOpen(); self.node().context.requireSemanticRegistration(); var channel = self._interaction.onPreview(self.node().events(), self.node(), receiver, owner);
		try { self.node().ownSemantic(channel); } catch (string error) { channel.cancel(); throw error; } return channel;
	}

	public ICallbackRegistration onCommit(ISliderControlEventHandler receiver, CallbackScope owner) {
		self.node().requireOpen(); self.node().context.requireSemanticRegistration(); var channel = self._interaction.onCommit(self.node().events(), self.node(), receiver, owner);
		try { self.node().ownSemantic(channel); } catch (string error) { channel.cancel(); throw error; } return channel;
	}

	public ICallbackRegistration onCancel(ISliderControlEventHandler receiver, CallbackScope owner) {
		self.node().requireOpen(); self.node().context.requireSemanticRegistration(); var channel = self._interaction.onCancel(self.node().events(), self.node(), receiver, owner);
		try { self.node().ownSemantic(channel); } catch (string error) { channel.cancel(); throw error; } return channel;
	}

	public SliderRange range() { self.node().requireOpen(); return self._interaction.range(); }

	private void modelChanged() { self.show(); }

	public void setRange(double minimum, double maximum, double step) { self.node().requireOpen(); if (self._interaction.setRange(minimum, maximum, step)) { self.modelChanged(); } }

	public void setRangeValue(SliderRange range, double value) {
		self.node().requireOpen(); if (range == null) { throw "Slider range is missing"; }
		if (self._interaction.setRangeValue(range.minimum, range.maximum, range.step, value)) { self.modelChanged(); }
	}

	/* A GTK scale asks for almost no width of its own: a slider is as long as it is given. */
	public double fittingWidth() { self.node().requireOpen(); return Math.maxDouble(ShimMetrics.sliderWidth(), (double)btrcShimControlNaturalWidth(self.control())); }

	public double fittingHeight() { self.node().requireOpen(); return (double)btrcShimControlNaturalHeight(self.control()); }

	public double value() { self.node().requireOpen(); return self._interaction.value(); }

	public void setValue(double value) { self.node().requireOpen(); if (self._interaction.setValue(value)) { self.modelChanged(); } }

	public void setEnabled(bool enabled) { self.node().requireOpen(); if (enabled != self._enabled) { self._enabled = enabled; self.node().localEligibilityChanged(); self.show(); } }

	public bool locallyEnabled() { return self._enabled; }

	public void eligibilityLost() { self._interaction.cancel(CONTROL_ORIGIN_SYSTEM, CONTROL_CANCEL_ELIGIBILITY_LOSS); self.show(); }

	private void releaseNative() { if (self._control != null) { btrcShimControlDestroy(self._control); self._control = null; } }

	public CallbackCancellation close() {
		self._interaction.cancel(CONTROL_ORIGIN_SYSTEM, CONTROL_CANCEL_SOURCE_CLOSING);
		var state = self.node().close();
		if (state == CALLBACK_CANCELLATION_COMPLETE) { self.releaseNative(); }
		return state;
	}

	public CallbackCancellation pollClose() {
		var state = self.node().pollClose();
		if (state == CALLBACK_CANCELLATION_COMPLETE) { self.releaseNative(); }
		return state;
	}

	public void __del__() { self.releaseNative(); }

	public bool isEnabled() { self.node().requireOpen(); return self._enabled; }

	public void setToolTip(string text) { self.node().requireOpen(); self.node().toolTip = text == null ? "" : text; btrcShimControlSetToolTip(self.control(), self.node().toolTip); }

	public string toolTip() { self.node().requireOpen(); return self.node().toolTip; }
}
