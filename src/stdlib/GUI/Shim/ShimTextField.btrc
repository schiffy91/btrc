import Library.GUI.Shim.Features;
import Library.Callback;
import Library.GUI.ControlEvents;
import Library.GUI.ControlEventQueue;
import Library.Math;
import Library.Strings;
import Library.Bytes;
import Library.App;
import Library.GUI.ITextField;
import Library.GUI.Shim.ShimView;
import Library.GUI.Shim.ShimContext;
import Library.GUI.Shim.ShimPainter;
import Library.GUI.Shim.Shim;
import Library.GUI.Shim.ShimControls;

/* A GTK entry. GTK owns the editing, the selection, the composition, the
 * clipboard and undo; this keeps what the contract adds: the accepted text,
 * and an interaction that ends in one commit or one cancel. */
class ShimTextField extends ShimNodeView implements ITextField, IShimTextTarget {
	private BtrcShimControl* _control;
	/* The text as the entry reads, with a composition in progress included. */
	private string _text;
	private string _acceptedText;
	private bool _composing = false;
	private bool _interacting = false;
	private bool _focusPrepared = false;
	private long long _interaction = 0LL;
	private long long _sequence = 0LL;
	private long long _modelRevision = 1LL;
	private ControlEventChannel<ITextControlEventHandler, TextControlEvent>? _draft;
	private ControlEventChannel<ITextControlEventHandler, TextControlEvent>? _commit;
	private ControlEventChannel<ITextControlEventHandler, TextControlEvent>? _cancel;
	private ControlEventPublication<ITextControlEventHandler, TextControlEvent>? _publication;
	private ControlEventTicket? _commitTicket;
	private ControlEventTicket? _cancelTicket;
	private bool _enabled = true;
	private bool _focused = false;

	public ShimTextField(ShimContext context, string text, string placeholder) {
		self.adoptNode(ShimViewNode(context));
		self.node().focusable = true;
		if (text == null || placeholder == null) { throw "Native text field text is missing"; }
		self._text = text; self._acceptedText = text;
		self._control = btrcShimTextCreate((unsigned int)self.node().id, text, placeholder);
		if (self._control == null) { throw "Cannot create native text field"; }
		btrcShimControlSetFont(self._control, 13.0, false);
	}

	private BtrcShimControl* control() { if (self._control == null) { throw "Native text field is closed"; } return self._control; }

	class void deliverText(ITextControlEventHandler receiver, TextControlEvent event) { receiver.textEvent(event); }

	private ControlEventChannel<ITextControlEventHandler, TextControlEvent> subscribe(ITextControlEventHandler receiver, CallbackScope owner, ControlEventCaptureRole role) {
		self.node().requireOpen(); self.node().context.requireSemanticRegistration();
		var channel = new ControlEventChannel<ITextControlEventHandler, TextControlEvent>(self.node().events(), self.node(), receiver, ShimTextField.deliverText, owner, self.node().context.eventRole(role));
		try { self.node().ownSemantic(channel); } catch (string error) { channel.cancel(); throw error; }
		return channel;
	}

	public ICallbackRegistration onDraftChanged(ITextControlEventHandler receiver, CallbackScope owner) {
		if (self._draft != null && self._draft.pollCompletion() != CALLBACK_CANCELLATION_COMPLETE) { throw "Cancel the existing draft handler first"; }
		var channel = self.subscribe(receiver, owner, CONTROL_CAPTURE_KEYED);
		try {
			if ((self._interacting || self._focusPrepared) && self.node().context.captureEnabled()) {
				self._publication = channel.prepareKey(self.node().generation(), self._interacting ? self._interaction : self._interaction + 1LL, 1LL);
				if (self._publication == null) { throw "Control key reservation unavailable"; }
			}
		} catch (string error) { channel.cancel(); throw error; }
		self._draft = channel; return channel;
	}

	public ICallbackRegistration onCommit(ITextControlEventHandler receiver, CallbackScope owner) {
		if (self._commit != null && self._commit.pollCompletion() != CALLBACK_CANCELLATION_COMPLETE) { throw "Cancel the existing commit handler first"; }
		var channel = self.subscribe(receiver, owner, CONTROL_CAPTURE_TERMINAL);
		try { if (self._interacting || self._focusPrepared) { self._commitTicket = channel.beginInteraction(); if (self._commitTicket == null) { throw "Text commit reservation unavailable"; } } }
		catch (string error) { channel.cancel(); throw error; }
		self._commit = channel; return channel;
	}

	public ICallbackRegistration onCancel(ITextControlEventHandler receiver, CallbackScope owner) {
		if (self._cancel != null && self._cancel.pollCompletion() != CALLBACK_CANCELLATION_COMPLETE) { throw "Cancel the existing cancel handler first"; }
		var channel = self.subscribe(receiver, owner, CONTROL_CAPTURE_TERMINAL);
		try { if (self._interacting || self._focusPrepared) { self._cancelTicket = channel.beginInteraction(); if (self._cancelTicket == null) { throw "Text cancel reservation unavailable"; } } }
		catch (string error) { channel.cancel(); throw error; }
		self._cancel = channel; return channel;
	}

	private void releaseTickets() {
		self._focusPrepared = false;
		var publication = self._publication; self._publication = null; if (publication != null) { publication.abort(); }
		var commit = self._commitTicket; if (commit != null && !commit.queued()) { commit.retire(); }
		var cancel = self._cancelTicket; if (cancel != null && !cancel.queued()) { cancel.retire(); }
		self._commitTicket = null; self._cancelTicket = null;
	}

	public void prepareFocus() {
		if (self._interacting || self._focusPrepared) { return; }
		if (self._interaction == 9223372036854775807LL) { throw "Text interaction identities exhausted"; }
		try {
			var draft = self._draft;
			if (draft != null && draft.isOpen() && self.node().context.captureEnabled()) { self._publication = draft.prepareKey(self.node().generation(), self._interaction + 1LL, 1LL); if (self._publication == null) { throw "Text draft key reservation unavailable"; } }
			var commit = self._commit; if (commit != null && commit.isOpen()) { self._commitTicket = commit.beginInteraction(); if (self._commitTicket == null) { throw "Text commit reservation unavailable"; } }
			var cancel = self._cancel; if (cancel != null && cancel.isOpen()) { self._cancelTicket = cancel.beginInteraction(); if (self._cancelTicket == null) { throw "Text cancel reservation unavailable"; } }
		} catch (string error) { self.releaseTickets(); throw error; }
		self._focusPrepared = true;
	}

	public void discardFocusPreparation() { if (self._focusPrepared) { self.releaseTickets(); } }

	private void beginInteraction() {
		if (self._interacting) { return; }
		self.prepareFocus();
		try {
			var publication = self._publication; var draft = self._draft;
			if (publication != null) {
				if (draft == null || !draft.isOpen()) { publication.abort(); self._publication = null; }
				else { publication.validate(); }
			}
		} catch (string error) { self.releaseTickets(); throw error; }
		self._focusPrepared = false;
		self._interaction++; self._interacting = true;
	}

	private TextControlEvent snapshot(ControlPhase phase, ControlOrigin origin, ControlCancelReason reason) {
		if (self._sequence == 9223372036854775807LL) { throw "Text event sequences exhausted"; }
		var context = ControlEventContext(); context.generation = self.node().generation(); context.interaction = self._interaction;
		context.sequence = ++self._sequence; context.modelRevision = self._modelRevision; context.origin = origin;
		var event = TextControlEvent(); event.context = context; event.phase = phase; event.cancelReason = reason;
		event.text = self._text; event.composing = self._composing; return event;
	}

	private void publishDraft() {
		var channel = self._draft;
		if (channel != null && channel.isOpen()) {
			var event = self.snapshot(CONTROL_PHASE_DRAFT, CONTROL_ORIGIN_USER, CONTROL_CANCEL_NONE);
			var publication = self._publication;
			bool accepted = false;
			if (publication != null) { accepted = publication.commit(event); }
			else { accepted = channel.publish(event, event.context.generation, self._interaction, 1LL); }
			self._publication = null;
			if (!accepted) { throw "Text draft queue cannot admit native input"; }
		}
	}

	private void commitInteraction() {
		if (!self._interacting || self._composing) { return; }
		bool dirty = !self._text.equals(self._acceptedText);
		self._interacting = false;
		try {
			if (dirty) {
				var event = self.snapshot(CONTROL_PHASE_COMMIT, CONTROL_ORIGIN_USER, CONTROL_CANCEL_NONE);
				self._acceptedText = self._text;
				var channel = self._commit; var ticket = self._commitTicket;
				if (channel != null && channel.isOpen() && ticket != null) { channel.publishTerminal(event, event.context.generation, self._interaction, ticket); }
			}
		} finally { self.releaseTickets(); }
	}

	private void cancelInteraction(ControlOrigin origin, ControlCancelReason reason, bool restore) {
		if (!self._interacting && !self._composing) { if (self._focusPrepared) { self.releaseTickets(); } return; }
		self._composing = false;
		if (restore) { self._text = self._acceptedText; btrcShimTextSet(self.control(), self._text); }
		self._interacting = false;
		try {
			var channel = self._cancel; var ticket = self._cancelTicket;
			if (channel != null && channel.isOpen() && ticket != null) {
				var event = self.snapshot(CONTROL_PHASE_CANCEL, origin, reason);
				channel.publishTerminal(event, event.context.generation, self._interaction, ticket);
			}
		} finally { self.releaseTickets(); }
	}

	public void paint(ShimPlacer painter, double x, double y) { painter.place(self.control(), x, y, self.node().width, self.node().height); }

	public void controlEvent(BtrcShimEvent* event) {
		if (!self._enabled || !self.node().effectiveEligible()) { return; }
		unsigned int type = event->type;
		if (type == (unsigned int)BTRC_SHIM_EVENT_CONTROL_TEXT_CHANGED) {
			if (event->text == null) { return; }
			string value = Strings.copy((char*)event->text);
			bool composing = event->data1 != 0;
			if (value.equals(self._text) && composing == self._composing) { return; }
			self.beginInteraction();
			self._text = value; self._composing = composing;
			self.publishDraft();
		} else if (type == (unsigned int)BTRC_SHIM_EVENT_CONTROL_TEXT_ACTIVATED) {
			self.commitInteraction();
		} else if (type == (unsigned int)BTRC_SHIM_EVENT_CONTROL_TEXT_ESCAPED) {
			self.cancelInteraction(CONTROL_ORIGIN_USER, CONTROL_CANCEL_ESCAPE, true);
		}
	}

	/* Native text-change events include the composed draft. */
	public void textEditing(string value, int start, int length) {}

	public void textInputArea(ShimViewHost host, double x, double y) { host.requestTextInput(ShimFeatures.fieldUsesWindowInput(), x, y, self.node().width, self.node().height); }

	/* Taking the keyboard begins an interaction; giving it up commits what
	 * was typed, unless a composition was still in progress. */
	public void focus(bool focused) {
		if (focused == self._focused) { return; }
		if (focused) { self.beginInteraction(); }
		else if (self._composing) { self.cancelInteraction(CONTROL_ORIGIN_SYSTEM, CONTROL_CANCEL_PLATFORM_INTERRUPTION, false); }
		else { self.commitInteraction(); }
		self._focused = focused;
	}

	public double fittingWidth() { self.node().requireOpen(); return Math.maxDouble(96.0, (double)btrcShimControlNaturalWidth(self.control())); }

	public double fittingHeight() { self.node().requireOpen(); return (double)btrcShimControlNaturalHeight(self.control()); }

	public string text() { self.node().requireOpen(); return self._text; }

	/* Re-publishing unchanged state must not disturb caret or selection. */
	public void setText(string text) {
		self.node().requireOpen();
		if (text == null) { throw "Native text field text is missing"; }
		if (self._acceptedText.equals(text)) { return; }
		if (self._modelRevision == 9223372036854775807LL) { throw "Text model revisions exhausted"; }
		self.cancelInteraction(CONTROL_ORIGIN_MODEL, CONTROL_CANCEL_MODEL_REPLACEMENT, false);
		self._text = text; self._acceptedText = text; self._modelRevision++;
		btrcShimTextSet(self.control(), text);
	}

	public void setPlaceholder(string text) { self.node().requireOpen(); btrcShimTextSetPlaceholder(self.control(), text == null ? "" : text); }

	public bool locallyEnabled() { return self._enabled; }

	public void eligibilityLost() { self.cancelInteraction(CONTROL_ORIGIN_SYSTEM, CONTROL_CANCEL_ELIGIBILITY_LOSS, false); self.focus(false); }

	public bool isEnabled() { self.node().requireOpen(); return self._enabled; }

	public void setEnabled(bool enabled) { self.node().requireOpen(); if (enabled != self._enabled) { self._enabled = enabled; self.node().localEligibilityChanged(); btrcShimControlSetEnabled(self.control(), enabled); } }

	public void setFont(double size) {
		self.node().requireOpen();
		if (!Math.isFinite(size) || size <= 0.0 || size > 512.0) { throw "Invalid native text field font size"; }
		btrcShimControlSetFont(self.control(), size, false);
		self.node().invalidate();
	}

	private void releaseNative() { if (self._control != null) { btrcShimControlDestroy(self._control); self._control = null; } }

	public CallbackCancellation close() {
		var state = self.node().close();
		if (state == CALLBACK_CANCELLATION_COMPLETE) { self.releaseNative(); }
		return state;
	}

	public CallbackCancellation pollClose() {
		var state = self.node().pollClose();
		if (state == CALLBACK_CANCELLATION_COMPLETE) { self.releaseNative(); }
		return state;
	}

	public void __del__() { self.releaseNative(); }
}
