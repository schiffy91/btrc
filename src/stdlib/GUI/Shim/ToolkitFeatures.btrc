import Library.GUI.ITextField;
import Library.GUI.ISelect;
import Library.GUI.Shim.ShimContext;
import Library.GUI.Shim.Shim;
import Library.GUI.Shim.DialogPump;
import Library.GUI.Shim.ShimWindow;
import Library.GUI.Shim.ShimDirectoryPicker;
import Library.GUI.IDirectoryPicker;
import Library.GUI.TextRun;
import Library.Image;
import Library.GUI.Shim.ShimTextField;
import Library.GUI.Shim.ShimSelect;
import Library.Strings;

class ShimFeatures {
	class bool fieldUsesWindowInput() { return false; }

	class void initialize() {}

	class ITextField createTextField(ShimContext context, string text, string placeholder) { return ShimTextField(context, text, placeholder); }

	class ISelect createSelect(ShimContext context) { return ShimSelect(context); }

	class void showAlert(BtrcShimWindow* window, string title, string message) { btrcShimWindowShowMessage(window, title, message); }

	class DirectoryPickerOutcome chooseDirectory(ShimWindow? window, IShimDialogPump pump, DirectoryPickerRequest request) { return ShimDirectoryPicker.modal(window, pump, request); }

	/* The shim's picture of a run, copied into an image the caller owns. */
	class Image rasterized(TextRun run) {
		int width = 0;
		int height = 0;
		unsigned char* pixels = btrcShimRasterizeText(run.text(), (double)run.fontSize(), run.weight() >= 600, run.lineHeight(), &width, &height);
		if (pixels == null) { throw "System text cannot be drawn: " + Strings.copy((char*)btrcShimError()); }
		if (width <= 0 || height <= 0 || width > 4096 || height > 4096) { btrcShimFreePixels(pixels); throw "System text exceeds raster limits"; }
		var image = Image(width, height);
		memcpy(image.data, pixels, (size_t)width * (size_t)height * (size_t)4);
		btrcShimFreePixels(pixels);
		return image;
	}
}
