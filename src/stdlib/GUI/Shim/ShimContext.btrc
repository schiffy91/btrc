import Library.Math;
import Library.Image;
import Library.GUI.ControlEventQueue;
import Library.GUI.IApplication;
import Library.GUI.ApplicationNativeWake;
import Library.GUI.Shim.Shim;
import Library.GUI.Shim.ShimActionQueue;

/* A monotonically increasing revision a window compares against its last
 * frame. Its views bump it on every visible mutation; nothing retains them. */
class ShimInvalidation {
	private unsigned long long _revision = 1ULL;

	public void mark() { self._revision++; }

	public unsigned long long revision() { return self._revision; }
}

/* Stable identities for focus, capture and hover so no owner needs a back
 * reference to the view it names. Views are created on the UI thread. */
class ShimIds {
	private int _next = 1;

	public int next() {
		int id = self._next;
		if (id <= 0 || id == 2147483647) { throw "Native view identities are exhausted"; }
		self._next++;
		return id;
	}
}

/* The least width a control that has no natural one is given, in logical points. */
class ShimMetrics {
	class double sliderWidth() { return 120.0; }

	class double levelWidth() { return 100.0; }
}

/* UI-only semantic wakes share the current application host route. The
 * queue owns post-admission failure accounting; this adapter never retries. */
class ShimSemanticWake implements IControlEventWake {
	public IApplicationHost? host = null;
	public bool requestTurn() { if (!btrcShimPushWake()) { return false; } return self.host == null || self.host.requestTurn(); }
}

/* Application-wide services every drawn view shares. Views retain it; it
 * retains no view. */
class ShimContext implements IApplicationNativeWake {
	public bool requestTurn() { return btrcShimPushWake(); }

	private bool _nativeQuitPending = false;
	public bool nativeQuitPending() { self.requireUI(); return self._nativeQuitPending; }

	public void setNativeQuitPending(bool pending) { self.requireUI(); self._nativeQuitPending = pending; }

	public int mutationDepth = 0;
	private int _routePreparations = 0;
	public void enterRoutePreparation() { self.requireUI(); self._routePreparations++; }

	public void leaveRoutePreparation() { self.requireUI(); if (self._routePreparations <= 0) { throw "Native route preparation underflow"; } self._routePreparations--; }

	public void requireSemanticRegistration() { self.requireUI(); if (self.mutationDepth > 0 || self._routePreparations > 0) { throw "Cannot register semantic input during native tree mutation"; } }
	private int _closeDecisions = 0;

	public void requireUI() { if (!btrcShimIsMainThread()) { throw "Native window operations require the UI thread"; } }

	public void requireMutationAllowed() { self.requireUI(); if (self.mutationDepth > 0) { throw "Cannot admit window close during native tree mutation"; } }

	public void enterCloseDecision() {
		self.requireUI();
		if (self._closeDecisions == 2147483647) { throw "Close decision callback admission is exhausted"; }
		self._closeDecisions++;
	}

	public void leaveCloseDecision() {
		self.requireUI();
		if (self._closeDecisions <= 0) { throw "Close decision callback admission underflow"; }
		self._closeDecisions--;
	}

	public void requireNoCloseDecision() {
		self.requireUI();
		if (self._closeDecisions != 0) { throw "Nested modal operations are forbidden inside close-decision callbacks"; }
	}
	public ControlEventTerminalPool terminalPool;
	public ControlEventQueue detachedEvents;
	public ShimSemanticWake semanticWake;
	private int _semanticCapacity;
	private int _captureCapacity;
	public ShimIds ids;
	public ShimActionQueue actions;

	public bool captureEnabled() { return self._captureCapacity != 0; }

	public ControlEventCaptureRole eventRole(ControlEventCaptureRole role) { return self.captureEnabled() ? role : CONTROL_CAPTURE_LEGACY; }

	/* Drain admitted records before taking more input when continuation credits
	 * are tight. With no pending receipt, existing gestures and observations
	 * still have prepaid storage; only a new intent may be refused at its
	 * synchronous begin hook, before its native/model state changes. */
	public bool canCaptureInput(ControlEventQueue queue) {
		if (!self.captureEnabled()) { return queue.canCapture(1); }
		return queue.canCapture(0) && (queue.pendingCount() == 0 || queue.captureOwner().canReserveKeyChange());
	}

	public ControlEventQueue createSemanticQueue() {
		ControlEventCaptureOwner? capture = self.captureEnabled() ? ControlEventCaptureOwner(self._captureCapacity, self.terminalPool) : null;
		var queue = ControlEventQueue(self._semanticCapacity, self.terminalPool, 0, capture); queue.setWake(self.semanticWake); return queue;
	}

	/* Capture credits are an explicit count policy, independent of ordinary
	 * work capacity. Tests may inject tiny budgets or select legacy mode with zero. */
	public ShimContext(int workCapacity, int captureCapacity = 16384) {
		if (captureCapacity < 0 || captureCapacity > 65536) { throw "Invalid capture credit capacity"; }
		self._semanticCapacity = workCapacity; self._captureCapacity = captureCapacity;
		self.terminalPool = ControlEventTerminalPool(16384);
		self.semanticWake = ShimSemanticWake();
		self.detachedEvents = self.createSemanticQueue();
		self.ids = ShimIds();
		self.actions = ShimActionQueue(workCapacity);
	}
}
