import Library.Callback;
import Library.Console;
import Library.Timer;
import Library.Math;
import Library.Strings;
import Library.Vector;
import Library.App;
import Library.Image;
import Library.GUI.IWindow;
import Library.GUI.IView;
import Library.GUI.ControlEventQueue;
import Library.GUI.Shim.Shim;
import Library.GUI.Shim.ShimControls;
import Library.GUI.Shim.ShimView;
import Library.GUI.Shim.ShimContext;
import Library.GUI.Shim.ShimContainer;
import Library.GUI.Shim.ShimGPUSurface;
import Library.GUI.Shim.ShimPainter;
import Library.GPU.GPUDevice;
import Library.GPU.GPUSurfaceRenderer;
import Library.GPU.GPUOffscreenTarget;
import Library.GPU.GPUReadback;

/* One synchronous key subscription; the window and the caller's scope share
 * its cancellation, so late cancellation never reaches a closed handler. */
class ShimWindowKeys implements ICallbackRegistration {
	private IWindowKeyHandler? _handler;
	private CallbackContext<ShimWindowKeys, ShimWindowKeys>? _context;
	private bool _open = true;

	public ShimWindowKeys(IWindowKeyHandler handler) { self._handler = handler; }

	public void activate(CallbackScope windowScope, CallbackScope owner) {
		var context = new CallbackContext<ShimWindowKeys, ShimWindowKeys>(self, ShimWindowKeys.unregister);
		context.activate(windowScope);
		self._context = context;
		try { owner.track(context); }
		catch (string error) { context.abortActivation(); self._context = null; self._open = false; throw error; }
		context.publish(self);
	}

	class bool unregister(ShimWindowKeys keys) { keys._open = false; keys._handler = null; return true; }

	public bool deliver(AppKeyboardEvent event) {
		var context = self._context;
		var handler = self._handler;
		if (context == null || handler == null || !self._open) { return false; }
		if (context.enter() == null) { return false; }
		bool consumed = false;
		try { consumed = handler.key(event); }
		finally { context.leave(); context.pollCompletion(); }
		return consumed;
	}

	public bool isOpen() { return self._open; }

	public CallbackCancellation cancel() { var context = self._context; return context == null ? CALLBACK_CANCELLATION_COMPLETE : context.cancel(); }

	public CallbackCancellation pollCompletion() { var context = self._context; return context == null ? CALLBACK_CANCELLATION_COMPLETE : context.pollCompletion(); }
}

/* Translates the shim's key and modifier codes into portable events. */
class ShimKeys {
	class AppKeyCode keyCode(unsigned int key, unsigned int scancode) {
		if (key == (unsigned int)BTRC_SHIM_KEY_ESCAPE) { return APP_KEY_ESCAPE; }
		if (key == (unsigned int)BTRC_SHIM_KEY_RETURN || key == (unsigned int)BTRC_SHIM_KEY_KP_ENTER) { return APP_KEY_ENTER; }
		if (key == (unsigned int)BTRC_SHIM_KEY_SPACE) { return APP_KEY_SPACE; }
		if (key == (unsigned int)BTRC_SHIM_KEY_LEFT) { return APP_KEY_LEFT; }
		if (key == (unsigned int)BTRC_SHIM_KEY_RIGHT) { return APP_KEY_RIGHT; }
		if (key == (unsigned int)BTRC_SHIM_KEY_UP) { return APP_KEY_UP; }
		if (key == (unsigned int)BTRC_SHIM_KEY_DOWN) { return APP_KEY_DOWN; }
		if (key == (unsigned int)BTRC_SHIM_KEY_TAB) { return APP_KEY_TAB; }
		if (key == (unsigned int)BTRC_SHIM_KEY_BACKSPACE) { return APP_KEY_BACKSPACE; }
		if (key == (unsigned int)BTRC_SHIM_KEY_DELETE) { return APP_KEY_DELETE; }
		if (key == (unsigned int)BTRC_SHIM_KEY_HOME) { return APP_KEY_HOME; }
		if (key == (unsigned int)BTRC_SHIM_KEY_END) { return APP_KEY_END; }
		if (key == (unsigned int)BTRC_SHIM_KEY_LSHIFT) { return APP_KEY_LEFT_SHIFT; }
		if (key == (unsigned int)BTRC_SHIM_KEY_RSHIFT) { return APP_KEY_RIGHT_SHIFT; }
		if (key == (unsigned int)BTRC_SHIM_KEY_LALT) { return APP_KEY_LEFT_ALT; }
		if (key == (unsigned int)BTRC_SHIM_KEY_RALT) { return APP_KEY_RIGHT_ALT; }
		if (scancode == (unsigned int)BTRC_SHIM_SCANCODE_A) { return APP_KEY_A; }
		if (scancode == (unsigned int)BTRC_SHIM_SCANCODE_D) { return APP_KEY_D; }
		if (scancode == (unsigned int)BTRC_SHIM_SCANCODE_S) { return APP_KEY_S; }
		if (scancode == (unsigned int)BTRC_SHIM_SCANCODE_W) { return APP_KEY_W; }
		if (scancode == (unsigned int)BTRC_SHIM_SCANCODE_C) { return APP_KEY_C; }
		if (scancode == (unsigned int)BTRC_SHIM_SCANCODE_V) { return APP_KEY_V; }
		if (scancode == (unsigned int)BTRC_SHIM_SCANCODE_X) { return APP_KEY_X; }
		if (scancode == (unsigned int)BTRC_SHIM_SCANCODE_Z) { return APP_KEY_Z; }
		if (scancode == (unsigned int)BTRC_SHIM_SCANCODE_Q) { return APP_KEY_Q; }
		if (scancode == (unsigned int)BTRC_SHIM_SCANCODE_LEFTBRACKET) { return APP_KEY_LEFT_BRACKET; }
		if (scancode == (unsigned int)BTRC_SHIM_SCANCODE_RIGHTBRACKET) { return APP_KEY_RIGHT_BRACKET; }
		return APP_KEY_UNKNOWN;
	}

	class AppKeyModifiers modifiers(unsigned int mod) { return AppKeyModifiers((mod & (unsigned int)BTRC_SHIM_MOD_SHIFT) != 0u, (mod & (unsigned int)BTRC_SHIM_MOD_CTRL) != 0u, (mod & (unsigned int)BTRC_SHIM_MOD_ALT) != 0u, (mod & (unsigned int)BTRC_SHIM_MOD_GUI) != 0u); }

	class AppPointerButton button(unsigned int button) {
		if (button == 1u) { return APP_POINTER_BUTTON_PRIMARY; }
		if (button == 3u) { return APP_POINTER_BUTTON_SECONDARY; }
		if (button == 2u) { return APP_POINTER_BUTTON_MIDDLE; }
		if (button == 4u) { return APP_POINTER_BUTTON_BACK; }
		if (button == 5u) { return APP_POINTER_BUTTON_FORWARD; }
		return APP_POINTER_BUTTON_OTHER;
	}
}

/* Provider-only projection: the native window identity synthetic input names. */
interface IShimWindow extends IWindow {
	unsigned int nativeId();
}

/* A GTK window whose whole content is one WebGPU surface below it. The root view
 * tree is painted by the window's painter, pointer input is routed by
 * hit-testing that tree, and keyboard input goes to window subscriptions,
 * then the focused control. Closing drains the subtree, then the GPU
 * resources, then the native window, in that order. */
class ShimWindow implements IShimWindow, IShimDevicePoller, IControlEventTarget {
	private BtrcShimWindow* _window;
	private unsigned int _id = 0u;
	private ShimContext _context;
	private ShimViewHost _host;
	private ShimGPUSurface? _surface = null;
	private GPUDevice? _device = null;
	private GPUOffscreenTarget? _captureTarget = null;
	private GPUSurfaceRenderer? _captureRenderer = null;
	private GPUSurfaceRenderer? _renderer = null;
	private ShimPainter? _painter = null;
	private IShimView? _root = null;
	private CallbackScope _callbacks = CallbackScope();
	private Vector<ShimWindowKeys> _keys = [];
	private string _title;
	private bool _visible = false;
	private bool _requestedVisible = false;
	private bool _focusObserved = false;
	private ApplicationActivity _activity = APPLICATION_ACTIVITY_UNKNOWN;
	private WindowState? _state;
	private ControlEventChannel<IWindowStateHandler, WindowState>? _stateChannel;
	private bool _callbacksClosing = false;
	private bool _focused = false;
	private bool _suspended = false;
	private bool _closeRequested = false;
	private ControlEventChannel<ShimWindowCloseReceiver, IWindowCloseTransaction>? _closeChannel;
	private ShimWindowCloseRegistration? _closeRegistration;
	private ShimWindowCloseTransaction? _transaction;
	private long long _nextCloseInteraction = 1LL;
	private long long _nextSaveAttempt = 1LL;
	private long long _closeHandlerGeneration = 0LL;
	private bool _quitHeld = false;
	private bool _closing = false;
	private bool _closed = false;
	private bool _rootClosing = false;
	private bool _deviceClosing = false;
	private string _closeFailure = "";
	private unsigned long long _paintedRevision = 0ULL;
	private unsigned long long _placedRevision = 0ULL;
	private unsigned long long _wakeAt = 0ULL;
	private int _frameFailures = 0;
	private double _pointerX = 0.0;
	private double _pointerY = 0.0;
	private AppKeyModifiers _modifiers = AppKeyModifiers(false, false, false, false);
	private int _captureViewId = 0;
	private int _captureInputViewId = 0;
	private int _captureInputIndex = -1;
	private AppPointerButton _captureButton = APP_POINTER_BUTTON_NONE;
	private Vector<int> _hoveredViews = [];
	private bool _pointerInside = false;
	private bool _dark = true;
	private int _hoverTopId = 0;
	private unsigned long long _hoverStart = 0ULL;
	private int _cursorKind = 0;

	public ShimWindow(ShimContext context, string title, double width, double height) {
		if (!Math.isFinite(width) || !Math.isFinite(height) || width <= 0.0 || height <= 0.0) { throw "Invalid window content size"; }
		if (title == null) { throw "Native window title is missing"; }
		self._context = context;
		self._title = title;
		self._window = btrcShimWindowCreate(title, (int)Math.ceilDouble(width), (int)Math.ceilDouble(height));
		if (self._window == null) { throw "Cannot create native window: " + Strings.copy((char*)btrcShimError()); }
		self._id = btrcShimWindowId(self._window);
		btrcShimSetDarkAppearance(self._dark);
		self._host = ShimViewHost(self._window, context);
		self._host.poller = self;  // released in destroyNative
		try {
			var surface = ShimGPUSurface(self._window);
			self._surface = surface;
			self._host.scale = surface.backingScale();
			self._device = GPUDevice(surface.nativeInstance(), surface.nativeSurface());
			self._host.width = width;
			self._host.height = height; self.refreshWindowState();
		} catch (string error) { self.destroyNative(); throw error; }
	}

	class void deliverState(IWindowStateHandler receiver, WindowState state) { receiver.stateChanged(ShimWindow.copyState(state)); }

	public ControlEventDisposition admission(long long generation) { return self.isOpen() ? CONTROL_EVENT_DELIVERED : CONTROL_EVENT_CLOSED; }

	class WindowState copyState(WindowState current) {
		var state = WindowState(); state.width = current.width; state.height = current.height; state.backingScale = current.backingScale;
		state.requestedVisible = current.requestedVisible; state.nativeVisible = current.nativeVisible; state.minimized = current.minimized;
		state.windowActive = current.windowActive; state.applicationActivity = current.applicationActivity; state.exposure = current.exposure;
		state.notExposedReason = current.notExposedReason; state.presentable = current.presentable; state.stateRevision = current.stateRevision; return state;
	}

	private void refreshWindowState() {
		var old = self._state; var next = WindowState();
		next.width = old == null ? self._host.width : old.width; next.height = old == null ? self._host.height : old.height;
		next.backingScale = old == null ? self._host.scale : old.backingScale;
		bool hidden = true; bool minimized = false; int pixelWidth = 0; int pixelHeight = 0;
		if (self._window != null) {
			next.width = (double)btrcShimWindowWidth(self._window); next.height = (double)btrcShimWindowHeight(self._window); next.backingScale = btrcShimWindowPixelDensity(self._window);
			pixelWidth = btrcShimWindowPixelWidth(self._window); pixelHeight = btrcShimWindowPixelHeight(self._window);
			hidden = btrcShimWindowIsHidden(self._window); minimized = btrcShimWindowIsMinimized(self._window);
		}
		next.requestedVisible = self._requestedVisible;
		next.nativeVisible = self.isOpen() && !hidden;
		next.minimized = minimized;
		next.windowActive = self.isOpen() && self._focused; next.applicationActivity = self._activity;
		next.exposure = WINDOW_EXPOSURE_UNKNOWN; next.notExposedReason = WINDOW_EXPOSURE_REASON_NONE;
		if (!next.nativeVisible) { next.exposure = WINDOW_EXPOSURE_NOT_EXPOSED; next.notExposedReason = WINDOW_EXPOSURE_REASON_HIDDEN; }
		else if (next.minimized) { next.exposure = WINDOW_EXPOSURE_NOT_EXPOSED; next.notExposedReason = WINDOW_EXPOSURE_REASON_MINIMIZED; }
		next.presentable = next.nativeVisible && !next.minimized && !self._suspended && pixelWidth > 0 && pixelHeight > 0;
		if (old != null && old.width == next.width && old.height == next.height && old.backingScale == next.backingScale && old.requestedVisible == next.requestedVisible && old.nativeVisible == next.nativeVisible && old.minimized == next.minimized && old.windowActive == next.windowActive && old.applicationActivity == next.applicationActivity && old.exposure == next.exposure && old.notExposedReason == next.notExposedReason && old.presentable == next.presentable) { return; }
		if (old != null && old.stateRevision == 9223372036854775807LL) { throw "Window state revisions exhausted"; }
		next.stateRevision = old == null ? 1LL : old.stateRevision + 1LL; self._state = next;
		var channel = self._stateChannel;
		if (channel != null && channel.isOpen() && !channel.publish(next, 1LL, 0LL, 1LL)) { throw "Window state semantic source is unavailable"; }
	}

	public WindowState state() { self.refreshWindowState(); var state = self._state; if (state == null) { throw "Window state unavailable"; } return ShimWindow.copyState(state); }

	public ICallbackRegistration onStateChanged(IWindowStateHandler receiver, CallbackScope owner) {
		self.requireOpen(); self._context.requireSemanticRegistration();
		if (self._stateChannel != null && self._stateChannel.pollCompletion() != CALLBACK_CANCELLATION_COMPLETE) { throw "Cancel the existing window state handler first"; }
		self.refreshWindowState();
		var channel = new ControlEventChannel<IWindowStateHandler, WindowState>(self._host.events, self, receiver, ShimWindow.deliverState, owner, self._context.eventRole(CONTROL_CAPTURE_OBSERVER));
		try { self._callbacks.track(channel); } catch (string error) { channel.cancel(); throw error; }
		self._stateChannel = channel; return channel;
	}

	public ICallbackRegistration onCloseRequested(IWindowCloseRequestHandler handler, CallbackScope owner) {
		if (handler == null || owner == null) { throw "Window close handler and owner are required"; }
		self.requireOpen(); self._context.requireMutationAllowed(); self._context.requireSemanticRegistration();
		var previous = self._closeRegistration;
		if (previous != null && previous.pollCompletion() != CALLBACK_CANCELLATION_COMPLETE) { throw "Cancel and drain the existing close handler first"; }
		if (self._closeHandlerGeneration == 9223372036854775807LL) { throw "Window close handler generations exhausted"; }
		var receiver = ShimWindowCloseReceiver(self, handler);
		var channel = new ControlEventChannel<ShimWindowCloseReceiver, IWindowCloseTransaction>(self._host.events, self, receiver, ShimWindowCloseReceiver.deliver, self._callbacks, self._context.eventRole(CONTROL_CAPTURE_TERMINAL));
		var registration = ShimWindowCloseRegistration(self, channel);
		try { owner.track(registration); self._callbacks.track(registration); }
		catch (string error) { registration.cancel(); throw error; }
		self._closeChannel = channel; self._closeRegistration = registration; self._closeHandlerGeneration++;
		return registration;
	}

	public WindowCloseRequestOutcome requestClose(WindowCloseReason reason) { return self.beginClose(reason, false); }

	public WindowCloseRequestOutcome requestCoordinatedClose() {
		self.requireOpen(); self._quitHeld = true;
		WindowCloseRequestOutcome result;
		try { result = self.beginClose(WINDOW_CLOSE_APPLICATION_QUIT, true); }
		catch (string error) { self.releaseQuitHold(); throw error; }
		return result;
	}

	private WindowCloseRequestOutcome beginClose(WindowCloseReason reason, bool coordinated) {
		self._context.requireUI(); self._context.requireMutationAllowed();
		if (reason != WINDOW_CLOSE_NATIVE_REQUEST && reason != WINDOW_CLOSE_APPLICATION_QUIT && reason != WINDOW_CLOSE_PROGRAM_REQUEST) { throw "Invalid window close reason"; }
		var result = WindowCloseRequestOutcome();
		if (self._window == null) { result.kind = WINDOW_CLOSE_REQUEST_CLOSED; return result; }
		if (self._closing || self._closed) { result.kind = WINDOW_CLOSE_REQUEST_CLOSING; return result; }
		var pending = self._transaction;
		if (pending != null && pending.pending()) { if (coordinated) { pending.holdForQuit(); } result.kind = WINDOW_CLOSE_REQUEST_ALREADY_PENDING; result.transaction = pending; return result; }
		var channel = self._closeChannel; var registration = self._closeRegistration;
		if (registration == null || !registration.isOpen() || channel == null || !channel.isOpen()) {
			result.kind = WINDOW_CLOSE_REQUEST_AUTHORIZED_NO_HANDLER; if (!self._quitHeld && !self._context.nativeQuitPending()) { self.close(); } return result;
		}
		if (self._nextCloseInteraction == 9223372036854775807LL) { throw "Window close interaction identities exhausted"; }
		var ticket = channel.beginInteraction();
		if (ticket == null) { throw "Window close handler is no longer live"; }
		var transaction = ShimWindowCloseTransaction(self, self._context, coordinated);
		long long interaction = self._nextCloseInteraction++;
		try { channel.publishTerminal(transaction, 1LL, interaction, ticket); }
		catch (string error) { ticket.retire(); transaction.resolve(WINDOW_CLOSE_CANCELLED); throw error; }
		/* requestTurn never services inline: publish identity only after the
		 * terminal has a committed queue receipt. Failed admission leaves no pending request. */
		self._transaction = transaction;
		result.kind = WINDOW_CLOSE_REQUEST_PENDING; result.transaction = transaction; return result;
	}

	public bool currentCloseRequest(IWindowCloseTransaction transaction) {
		self._context.requireUI(); var pending = self._transaction; IWindowCloseTransaction? current = pending;
		return self.isOpen() && current == transaction && pending != null && pending.pending();
	}

	public bool isPendingClose(ShimWindowCloseTransaction transaction) { self._context.requireUI(); return self._transaction == transaction && self.isOpen(); }

	public long long nextCloseSaveAttempt() {
		self._context.requireUI();
		if (self._nextSaveAttempt == 9223372036854775807LL) { throw "Window save attempts exhausted"; }
		return self._nextSaveAttempt++;
	}

	public void retireCloseTransaction(ShimWindowCloseTransaction transaction) {
		self._context.requireUI(); if (self._transaction == transaction) { self._transaction = null; } self.wakeCloseCoordinator();
	}

	public void consumeCloseAuthorization(ShimWindowCloseTransaction transaction) {
		self._context.requireUI();
		if (!self.isPendingClose(transaction) || transaction.state() != WINDOW_CLOSE_AUTHORIZED) { throw "Window close authorization is stale"; }
		transaction.resolve(WINDOW_CLOSE_CLOSING); self._transaction = null; self.close();
	}

	public void closeHandlerCancelled(ShimWindowCloseRegistration registration) {
		self._context.requireUI(); if (self._closeRegistration != registration) { return; }
		var pending = self._transaction;
		if (pending != null) {
			if (self._closing || self._closed) { pending.resolve(WINDOW_CLOSE_OWNER_LOST); }
			else { pending.resolve(WINDOW_CLOSE_CANCELLED); }
			self._transaction = null;
		}
		self._closeRequested = false; if (self._quitHeld && self.isOpen()) { self.wakeCloseCoordinator(); }
	}

	public ShimWindowCloseTransaction? coordinatedTransaction() { self._context.requireUI(); return self._transaction; }

	public long long closeHandlerGeneration() { self._context.requireUI(); return self._closeHandlerGeneration; }

	public bool hasCloseHandler() { self._context.requireUI(); return self._closeRegistration != null && self._closeRegistration.isOpen() && self._closeChannel != null && self._closeChannel.isOpen(); }

	public void releaseQuitHold() { self._context.requireUI(); self._quitHeld = false; self._closeRequested = false; }

	public bool validatesCloseAuthorization(ShimWindowCloseTransaction transaction, long long generation, long long revision) {
		self._context.requireUI(); return self._quitHeld && self.isPendingClose(transaction) && self.hasCloseHandler() && self._closeHandlerGeneration == generation && transaction.coordinatedAuthorization() && transaction.acknowledgedRevision() == revision;
	}

	public void cancelCoordinatedClose(ShimWindowCloseTransaction? transaction) {
		self._context.requireUI(); if (transaction != null && self._transaction == transaction) { transaction.resolve(WINDOW_CLOSE_CANCELLED); self._transaction = null; } self.releaseQuitHold();
	}

	public void commitCoordinatedClose(ShimWindowCloseTransaction transaction) {
		self._context.requireUI(); if (!self._quitHeld || !self.isPendingClose(transaction) || !transaction.coordinatedAuthorization()) { throw "Coordinated window close authorization is stale"; }
		transaction.resolve(WINDOW_CLOSE_CLOSING); self._transaction = null; self.releaseQuitHold();
	}

	public void wakeCloseCoordinator() {
		self._context.requireUI(); if (!self._context.semanticWake.requestTurn()) { throw "Native quit wake failed"; }
	}

	public void enterCloseDecision() { self._context.enterCloseDecision(); }

	public void leaveCloseDecision() { self._context.leaveCloseDecision(); }

	public bool focusObserved() { return self._focusObserved; }

	public void applicationActivity(ApplicationActivity activity) { self._activity = activity; self._suspended = activity == APPLICATION_ACTIVITY_SUSPENDED; self.refreshInteraction(); }

	public unsigned int nativeId() { return self._id; }

	public BtrcShimWindow* nativeWindow() { self.requireOpen(); return self._window; }

	public bool canCaptureInput() { return self._context.canCaptureInput(self._host.events); }

	public int semanticPending() { return self._host.events.pendingCount() + (self._closeRequested ? 1 : 0); }

	public bool dispatchSemantic() {
		self._context.requireUI();
		if (self._context.mutationDepth > 0) { return false; }
		bool requested = self.serviceNativeClose();
		bool delivered = self._host.events.dispatchOne();
		return requested || delivered;
	}

	/* Capture only records readiness. Transaction admission and user delivery
	 * belong to the ordinary bounded semantic turn, never event dispatch. */
	public bool serviceNativeClose() {
		self._context.requireMutationAllowed();
		if (!self._closeRequested) { return false; }
		self._closeRequested = false;
		self.requestClose(WINDOW_CLOSE_NATIVE_REQUEST); return true;
	}

	public void suspendInput(bool suspended) { self._suspended = suspended; self.refreshInteraction(); }

	private void refreshInteraction() {
		bool visible = self.isVisible();
		bool minimized = self._window != null && btrcShimWindowIsMinimized(self._window);
		self._host.eligible = self.isOpen() && visible && !minimized && !self._suspended;
		self._host.exposure = !visible || minimized ? WINDOW_EXPOSURE_NOT_EXPOSED : WINDOW_EXPOSURE_UNKNOWN;
		if (self._root != null) { self._root.node().refreshInteraction(self._host.eligible); }
		if (!self._host.eligible) { self.cancelCapture(); if (self._host.focusedId != 0) { self.moveFocus(0); } }
		self.refreshWindowState();
	}

	public bool owns(int viewId) { return self.locate(viewId) != null; }

	/* A capture is of the view it was asked for: that view's own part of the
	 * window's picture, at the picture's scale. */
	public Image pictureOf(IShimView view, Image picture) {
		var hit = self.locate(view.node().id);
		if (hit == null) { throw "Capture root is not attached to this window"; }
		double scale = self._host.scale;
		var node = view.node();
		int left = Math.clamp((int)Math.floorDouble(hit.originX * scale + 0.5), 0, picture.width);
		int top = Math.clamp((int)Math.floorDouble(hit.originY * scale + 0.5), 0, picture.height);
		int right = Math.clamp((int)Math.floorDouble((hit.originX + node.width) * scale + 0.5), left, picture.width);
		int bottom = Math.clamp((int)Math.floorDouble((hit.originY + node.height) * scale + 0.5), top, picture.height);
		if (left == 0 && top == 0 && right == picture.width && bottom == picture.height) { return picture; }
		return picture.crop(left, top, right - left, bottom - top);
	}

	private void requireOpen() { if (self._window == null || self._closing || self._closed) { throw "Window shutdown has started"; } }

	public bool isOpen() { return self._window != null && !self._closing && !self._closed; }

	public bool closeRequested() { return self._closeRequested; }

	public void requestNativeClose() { self._closeRequested = true; self._host.invalidation.mark(); }

	/* Advance device creation; true once frames can render. */
	public bool pollDevice() {
		if (self._closing || self._closed) { return false; }
		var device = self._device;
		var surface = self._surface;
		if (device == null || surface == null) { return false; }
		if (self._renderer != null) { return true; }
		var state = device.poll();
		if (state == GPU_DEVICE_FAILED) { throw "GPU device unavailable for the native window: " + device.error(); }
		if (state != GPU_DEVICE_READY) { return false; }
		var renderer = GPUSurfaceRenderer(device, surface.nativeSurface(), false);
		self._renderer = renderer;
		self._painter = ShimPainter(device, renderer.nativeFormat());
		self._host.device = device;
		self._host.format = renderer.nativeFormat();
		self._host.invalidation.mark();
		return true;
	}

	/* Hidden windows present nothing, so they never keep the loop awake. */
	public bool needsFrame() {
		if (self._suspended || !self.isVisible() || btrcShimWindowIsMinimized(self._window)) { return false; }
		unsigned long long revision = self._host.invalidation.revision();
		/* Without a painter yet, a frame is only the placing of the controls. */
		if (self._painter == null) { return revision != self._placedRevision; }
		return revision != self._paintedRevision || (self._wakeAt != 0ULL && btrcShimTicksNS() >= self._wakeAt);
	}

	/* When a painted view asked to be redrawn (a caret blink, a spinner); zero for none. */
	public unsigned long long wakeAt() { return !self._suspended && self.isVisible() && !btrcShimWindowIsMinimized(self._window) ? self._wakeAt : 0ULL; }

	private RGBA background() { return self._dark ? RGBA(30, 30, 33, 255) : RGBA(238, 238, 240, 255); }

	/* Captures paint into an offscreen target: no mapped surface is needed, so
	 * a window captures before it is shown and never disturbs presentation. */
	private GPUSurfaceRenderer captureRenderer(GPUDevice device, WGPUTextureFormat format) {
		var renderer = self._captureRenderer;
		if (renderer != null) { return renderer; }
		var target = GPUOffscreenTarget(device, format);
		self._captureTarget = target;
		var created = GPUSurfaceRenderer.offscreen(device, target, true);
		self._captureRenderer = created;
		return created;
	}

	/* Paint one frame; with capture the frame is read back instead of presented. */
	public Image? render(bool capture) {
		var presenter = self._renderer;
		var painter = self._painter;
		var surface = self._surface;
		var device = self._device;
		if (self._closing || self._closed || (!capture && !self.isVisible())) { return null; }
		/* Until the GPU device is ready there is nothing to draw, and the
		 * native controls are placed all the same. */
		if (presenter == null || painter == null || surface == null || device == null) { self.place(null); return null; }
		surface.refreshBackingSize();
		double scale = surface.backingScale();
		self._host.scale = scale;
		/* Where frames cannot be presented under the window's controls (X11),
		 * every frame is drawn off screen and handed to GTK as a picture. */
		bool pictured = btrcShimWindowShowsPictures(self._window);
		bool offscreen = capture || pictured;
		var renderer = offscreen ? self.captureRenderer(device, presenter.nativeFormat()) : presenter;
		renderer.resize(surface.pixelWidth(), surface.pixelHeight());
		var background = self.background();
		var availability = renderer.beginFrame((double)background.red / 255.0, (double)background.green / 255.0, (double)background.blue / 255.0, 1.0);
		if (availability == GPU_SURFACE_FRAME_UNAVAILABLE) {
			self._frameFailures++;
			if (offscreen || self._frameFailures > 120) { throw "Cannot render native window: " + renderer.error(); }
			return null;
		}
		self._frameFailures = 0;
		if (availability != GPU_SURFACE_FRAME_READY) { return null; }
		self._host.wakeSeconds = -1.0;
		self._paintedRevision = self._host.invalidation.revision();
		painter.beginFrame(surface.pixelWidth(), surface.pixelHeight(), scale);
		self.place(painter);
		self._wakeAt = self._host.wakeSeconds >= 0.0 ? ShimClock.after(self._host.wakeSeconds) : 0ULL;
		painter.render(renderer);
		if (!offscreen) { renderer.present(); return null; }
		renderer.finishDrawing();
		var readback = GPUReadback.create(renderer, 268435200, null);
		if (!readback.submit()) { throw "Cannot submit native capture: " + readback.error(); }
		var deadline = Timer();
		deadline.start();
		while (readback.poll() != GPU_READBACK_READY) {
			if (readback.state() == GPU_READBACK_FAILED) { throw "Native capture failed: " + readback.error(); }
			if (deadline.elapsedMillis() > 5000.0) { readback.close(); throw "Native capture timed out"; }
			Timer.sleepMillis(1);
		}
		var image = readback.takeImage();
		if (!capture) { btrcShimWindowShowPicture(self._window, image.data, image.width, image.height); return null; }
		/* A capture is what a person sees: the drawn content with GTK's controls over it. */
		if (!btrcShimWindowDrawControls(self._window, image.data, image.width, image.height)) { throw "Cannot draw the window's native controls into a capture"; }
		return image;
	}

	/* One pass over the views: every native control is handed to GTK with its
	 * frame, back to front, and with `gpu` the drawn content is composed. */
	private void place(ShimPainter? gpu) {
		if (self._window == null) { return; }
		var placer = ShimPlacer(self._host.width, self._host.height, gpu);
		var root = self._root;
		if (root != null && root.node().visible) { root.paint(placer, root.node().x, root.node().y); }
		btrcShimWindowBeginPlacement(self._window);
		for placement in placer.placements() {
			var clip = placement.clip;
			if (placement.control == null) { btrcShimWindowPlaceHole(self._window, placement.x, placement.y, placement.width, placement.height, clip.x, clip.y, clip.width, clip.height); }
			else { btrcShimWindowPlace(self._window, placement.control, placement.x, placement.y, placement.width, placement.height, clip.x, clip.y, clip.width, clip.height); }
		}
		btrcShimWindowEndPlacement(self._window);
		self._placedRevision = self._host.invalidation.revision();
	}

	public void setDarkAppearance(bool dark) { self._dark = dark; btrcShimSetDarkAppearance(dark); self._host.invalidation.mark(); }

	/* Find a view by identity with its absolute origin. */
	private ShimHit? locate(int id) {
		var root = self._root;
		if (root == null) { return null; }
		return self.locateIn(root, root.node().x, root.node().y, id);
	}

	private ShimHit? locateIn(IShimView view, double originX, double originY, int id) {
		var node = view.node();
		if (node.id == id) { return ShimHit(view, originX, originY); }
		for child in node.children {
			var childNode = child.node();
			var found = self.locateIn(child, originX + node.contentOffsetX + childNode.x, originY + node.contentOffsetY + childNode.y, id);
			if (found != null) { return found; }
		}
		return null;
	}

	/* The visible views under a window point, root first. */
	private Vector<ShimHit> hitPath(double x, double y) {
		Vector<ShimHit> path = [];
		var root = self._root;
		if (root == null) { return path; }
		var node = root.node();
		if (!node.effectiveEligible() || x < node.x || y < node.y || x >= node.x + node.width || y >= node.y + node.height) { return path; }
		IShimView current = root;
		double originX = node.x;
		double originY = node.y;
		path.push(ShimHit(current, originX, originY));
		while (true) {
			var currentNode = current.node();
			IShimView? next = null;
			double nextX = 0.0;
			double nextY = 0.0;
			if (currentNode.clipsChildren && (x < originX || y < originY || x >= originX + currentNode.width || y >= originY + currentNode.height)) { break; }
			for (int index = currentNode.children.len - 1; index >= 0; index--) {
				var child = currentNode.children.get(index);
				var childNode = child.node();
				if (!childNode.effectiveEligible()) { continue; }
				double childX = originX + currentNode.contentOffsetX + childNode.x;
				double childY = originY + currentNode.contentOffsetY + childNode.y;
				if (x >= childX && y >= childY && x < childX + childNode.width && y < childY + childNode.height) { next = child; nextX = childX; nextY = childY; break; }
			}
			if (next == null) { break; }
			current = next;
			originX = nextX;
			originY = nextY;
			path.push(ShimHit(current, originX, originY));
		}
		return path;
	}

	private AppPointerEvent localEvent(AppPointerAction action, AppPointerButton button, int clicks, double originX, double originY) { return AppPointerEvent(action, button, self._pointerX - originX, self._pointerY - originY, self._modifiers, clicks); }

	/* Enter/exit bookkeeping for subscriptions and controls along the path. */
	private void updateHover(Vector<ShimHit> path) {
		Vector<int> current = [];
		for hit in path { current.push(hit.view.node().id); }
		for (int index = self._hoveredViews.len - 1; index >= 0; index--) {
			int id = self._hoveredViews.get(index);
			if (current.contains(id)) { continue; }
			var located = self.locate(id);
			if (located != null) {
				var event = self.localEvent(APP_POINTER_EXITED, APP_POINTER_BUTTON_NONE, 0, located.originX, located.originY);
				for input in located.view.node().inputs() { if (input.inside) { input.inside = false; input.deliverPointer(event); } }
				located.view.pointer(event);
			}
		}
		for hit in path {
			int id = hit.view.node().id;
			if (self._hoveredViews.contains(id)) { continue; }
			var event = self.localEvent(APP_POINTER_ENTERED, APP_POINTER_BUTTON_NONE, 0, hit.originX, hit.originY);
			for input in hit.view.node().inputs() { if (input.handlesPointer() && input.isOpen()) { input.inside = true; input.deliverPointer(event); } }
			hit.view.pointer(event);
		}
		self._hoveredViews = current;
		int top = path.isEmpty() ? 0 : path.last().view.node().id;
		if (top != self._hoverTopId) {
			self._hoverTopId = top;
			self._hoverStart = btrcShimTicksNS();
			self.applyCursor(path.isEmpty() ? 0 : path.last().view.node().cursor);
			self._host.invalidation.mark();
		}
	}

	private void applyCursor(int kind) {
		if (kind == self._cursorKind || self._window == null) { return; }
		self._cursorKind = kind;
		btrcShimWindowSetCursor(self._window, kind == 1 ? (int)BTRC_SHIM_CURSOR_TEXT : (int)BTRC_SHIM_CURSOR_DEFAULT);
	}

	private void clearHover() {
		for (int index = self._hoveredViews.len - 1; index >= 0; index--) {
			var located = self.locate(self._hoveredViews.get(index));
			if (located == null) { continue; }
			var event = self.localEvent(APP_POINTER_EXITED, APP_POINTER_BUTTON_NONE, 0, located.originX, located.originY);
			for input in located.view.node().inputs() { if (input.inside) { input.inside = false; input.deliverPointer(event); } }
			located.view.pointer(event);
		}
		self._hoveredViews.clear();
		self._hoverTopId = 0;
		self.applyCursor(0);
	}

	private void forgetCapture() {
		self._captureViewId = 0;
		self._captureInputViewId = 0;
		self._captureInputIndex = -1;
		self._captureButton = APP_POINTER_BUTTON_NONE;
	}

	private void cancelCapture() {
		if (self._captureInputViewId != 0) {
			var located = self.locate(self._captureInputViewId);
			if (located != null) {
				var inputs = located.view.node().inputs();
				if (self._captureInputIndex >= 0 && self._captureInputIndex < inputs.len) { inputs.get(self._captureInputIndex).cancelCapture(self._pointerX - located.originX, self._pointerY - located.originY); }
			}
		}
		if (self._captureViewId != 0) {
			var located = self.locate(self._captureViewId);
			if (located != null) { located.view.pointer(self.localEvent(APP_POINTER_CANCELLED, self._captureButton, 0, located.originX, located.originY)); }
		}
		self.forgetCapture();
	}

	private void deliverPointer(AppPointerAction action, AppPointerButton button, int clicks) {
		var path = self.hitPath(self._pointerX, self._pointerY);
		bool captured = self._captureButton != APP_POINTER_BUTTON_NONE && (self._captureViewId != 0 || self._captureInputViewId != 0);
		if (action == APP_POINTER_MOVED || (action == APP_POINTER_PRESSED && !captured)) { self.updateHover(path); }
		if (captured && (action == APP_POINTER_DRAGGED || action == APP_POINTER_RELEASED)) {
			bool releasing = action == APP_POINTER_RELEASED && button == self._captureButton;
			if (self._captureInputViewId != 0) {
				var located = self.locate(self._captureInputViewId);
				if (located != null) {
					var inputs = located.view.node().inputs();
					if (self._captureInputIndex >= 0 && self._captureInputIndex < inputs.len) {
						var input = inputs.get(self._captureInputIndex);
						input.deliverPointer(self.localEvent(action, button, clicks, located.originX, located.originY));
						if (releasing) { input.captured = APP_POINTER_BUTTON_NONE; }
					}
				}
			} else if (self._captureViewId != 0) {
				var located = self.locate(self._captureViewId);
				if (located != null) { located.view.pointer(self.localEvent(action, button, clicks, located.originX, located.originY)); }
			}
			if (releasing) { self.forgetCapture(); self.updateHover(path); }
			return;
		}
		for (int index = path.len - 1; index >= 0; index--) {
			var hit = path.get(index);
			var inputs = hit.view.node().inputs();
			for (int inputIndex = 0; inputIndex < inputs.len; inputIndex++) {
				var input = inputs.get(inputIndex);
				if (!input.handlesPointer() || !input.isOpen()) { continue; }
				if (input.deliverPointer(self.localEvent(action, button, clicks, hit.originX, hit.originY))) {
					if (action == APP_POINTER_PRESSED && self._captureButton == APP_POINTER_BUTTON_NONE) { input.captured = button; self._captureInputViewId = hit.view.node().id; self._captureInputIndex = inputIndex; self._captureButton = button; }
					return;
				}
			}
		}
		for (int index = path.len - 1; index >= 0; index--) {
			var hit = path.get(index);
			if (hit.view.pointer(self.localEvent(action, button, clicks, hit.originX, hit.originY))) {
				if (action == APP_POINTER_PRESSED && self._captureButton == APP_POINTER_BUTTON_NONE) { self._captureViewId = hit.view.node().id; self._captureButton = button; }
				return;
			}
		}
	}

	/* `precise` deltas are a touchpad's points; the others are wheel notches. */
	private void deliverScroll(double deltaX, double deltaY, bool precise) {
		var event = AppScrollEvent(deltaX, deltaY, 0.0, 0.0, precise, APP_SCROLL_NONE, APP_SCROLL_NONE, self._modifiers);
		var path = self.hitPath(self._pointerX, self._pointerY);
		for (int index = path.len - 1; index >= 0; index--) {
			var hit = path.get(index);
			var local = AppScrollEvent(deltaX, deltaY, self._pointerX - hit.originX, self._pointerY - hit.originY, precise, APP_SCROLL_NONE, APP_SCROLL_NONE, self._modifiers);
			for input in hit.view.node().inputs() { if (input.handlesScroll() && input.isOpen() && input.deliverScroll(local)) { return; } }
		}
		for (int index = path.len - 1; index >= 0; index--) {
			var hit = path.get(index);
			if (hit.view.scroll(AppScrollEvent(deltaX, deltaY, self._pointerX - hit.originX, self._pointerY - hit.originY, precise, APP_SCROLL_NONE, APP_SCROLL_NONE, self._modifiers))) { return; }
		}
	}

	private void deliverKey(AppKeyboardEvent event) {
		for (int index = self._keys.len - 1; index >= 0; index--) {
			var keys = self._keys.get(index);
			if (!keys.isOpen()) { self._keys.remove(index); continue; }
			if (keys.deliver(event)) { return; }
		}
		if (self._host.focusedId != 0) {
			var focused = self.locate(self._host.focusedId);
			if (focused != null && focused.view.node().effectiveEligible()) { focused.view.key(event); }
		}
	}

	private void applyFocus() {
		int request = self._host.focusRequest;
		self._host.focusRequest = 0;
		if (request == 0 || request == self._host.focusedId) { return; }
		self.moveFocus(request);
	}

	private void moveFocus(int id) {
		if (id != 0) { var candidate = self.locate(id); if (candidate == null || !candidate.view.node().effectiveEligible()) { id = 0; } }
		int previous = self._host.focusedId;
		if (previous == id) { return; }
		IShimTextTarget? prepared = null;
		if (id != 0) { var candidate = self.locate(id); if (candidate != null) { prepared = (IShimTextTarget?)candidate.view; if (prepared != null) { prepared.prepareFocus(); } } }
		try {
			self._host.focusedId = id;
			if (previous != 0) { var old = self.locate(previous); if (old != null) { old.view.focus(false); } }
			self._host.requestTextInput(false, 0.0, 0.0, 0.0, 0.0);
			if (id != 0) {
				var next = self.locate(id);
				if (next != null) {
					next.view.focus(true);
					IShimTextTarget? field = (IShimTextTarget?)next.view;
					if (field != null) { field.textInputArea(self._host, next.originX, next.originY); }
				}
			}
			self.syncTextInput(); self._host.invalidation.mark();
		} finally { if (prepared != null) { prepared.discardFocusPreparation(); } }
	}

	private void syncTextInput() {
		if (self._window == null) { return; }
		if (self._host.textInputWanted) {
			btrcShimWindowSetTextInputArea(self._window, (int)self._host.textInputX, (int)self._host.textInputY, (int)Math.maxDouble(1.0, self._host.textInputWidth), (int)Math.maxDouble(1.0, self._host.textInputHeight));
			if (!btrcShimWindowTextInputActive(self._window)) { btrcShimWindowStartTextInput(self._window); }
		} else if (btrcShimWindowTextInputActive(self._window)) { btrcShimWindowStopTextInput(self._window); }
	}

	/* Route one of the shim's events that names this window. */
	public void dispatch(BtrcShimEvent* event) {
		if (self._window == null || self._closing || self._closed || event == null) { return; }
		unsigned int type = event->type;
		if (type == (unsigned int)BTRC_SHIM_EVENT_WINDOW_CLOSE_REQUESTED) { self._closeRequested = true; self._host.invalidation.mark(); return; }
		if (type == (unsigned int)BTRC_SHIM_EVENT_WINDOW_RESIZED || type == (unsigned int)BTRC_SHIM_EVENT_WINDOW_PIXEL_SIZE_CHANGED || type == (unsigned int)BTRC_SHIM_EVENT_WINDOW_DISPLAY_SCALE_CHANGED || type == (unsigned int)BTRC_SHIM_EVENT_WINDOW_EXPOSED) {
			self.layoutRoot(); self.refreshWindowState();
			self._host.invalidation.mark();
			return;
		}
		if (type == (unsigned int)BTRC_SHIM_EVENT_WINDOW_FOCUS_GAINED) { self._focused = true; self._focusObserved = true; self.refreshWindowState(); self._host.invalidation.mark(); return; }
		if (type == (unsigned int)BTRC_SHIM_EVENT_WINDOW_FOCUS_LOST) { self._focused = false; self._focusObserved = true; self.cancelCapture(); self.refreshWindowState(); self._host.invalidation.mark(); return; }
		if (type == (unsigned int)BTRC_SHIM_EVENT_WINDOW_MOUSE_LEAVE) { self._pointerInside = false; if (self._captureButton == APP_POINTER_BUTTON_NONE) { self.clearHover(); } return; }
		if (type == (unsigned int)BTRC_SHIM_EVENT_WINDOW_MOUSE_ENTER) { self._pointerInside = true; return; }
		if (type == (unsigned int)BTRC_SHIM_EVENT_WINDOW_SHOWN) { self._visible = true; self.refreshInteraction(); self.layoutRoot(); self._host.invalidation.mark(); return; }
		if (type == (unsigned int)BTRC_SHIM_EVENT_WINDOW_HIDDEN) { self._visible = false; self.refreshInteraction(); return; }
		if (type == (unsigned int)BTRC_SHIM_EVENT_WINDOW_MINIMIZED || type == (unsigned int)BTRC_SHIM_EVENT_WINDOW_RESTORED) { self.refreshInteraction(); self._host.invalidation.mark(); return; }
		if (!self._host.eligible) { return; }
		if (event->control != 0u) {
			int id = (int)event->control;
			/* GTK gave a native control the keyboard, or took it away: the
			 * provider's own focus follows, so keys GTK leaves alone find it. */
			if (type == (unsigned int)BTRC_SHIM_EVENT_CONTROL_FOCUS_GAINED) { self._host.requestFocus(id); self.applyFocus(); return; }
			if (type == (unsigned int)BTRC_SHIM_EVENT_CONTROL_FOCUS_LOST) { if (self._host.focusedId == id) { self.moveFocus(0); } return; }
			var located = self.locate(id);
			if (located != null) { located.view.controlEvent(event); }
			return;
		}
		if (type == (unsigned int)BTRC_SHIM_EVENT_MOUSE_MOTION) {
			self._pointerX = (double)event->x;
			self._pointerY = (double)event->y;
			self._modifiers = ShimKeys.modifiers((unsigned int)btrcShimModState());
			bool dragging = self._captureButton != APP_POINTER_BUTTON_NONE && (self._captureViewId != 0 || self._captureInputViewId != 0);
			self.deliverPointer(dragging ? APP_POINTER_DRAGGED : APP_POINTER_MOVED, dragging ? self._captureButton : APP_POINTER_BUTTON_NONE, 0);
			return;
		}
		if (type == (unsigned int)BTRC_SHIM_EVENT_MOUSE_BUTTON_DOWN || type == (unsigned int)BTRC_SHIM_EVENT_MOUSE_BUTTON_UP) {
			self._pointerX = (double)event->x;
			self._pointerY = (double)event->y;
			self._modifiers = ShimKeys.modifiers((unsigned int)btrcShimModState());
			var button = ShimKeys.button(event->button);
			bool down = event->down != 0;
			if (down && self._captureButton != APP_POINTER_BUTTON_NONE) { return; }
			self.deliverPointer(down ? APP_POINTER_PRESSED : APP_POINTER_RELEASED, button, (int)event->clicks);
			self.applyFocus();
			return;
		}
		if (type == (unsigned int)BTRC_SHIM_EVENT_MOUSE_WHEEL) {
			self._pointerX = (double)event->x;
			self._pointerY = (double)event->y;
			self.deliverScroll((double)event->wheelX, (double)event->wheelY, event->data1 != 0);
			return;
		}
		if (type == (unsigned int)BTRC_SHIM_EVENT_KEY_DOWN || type == (unsigned int)BTRC_SHIM_EVENT_KEY_UP) {
			self._modifiers = ShimKeys.modifiers(event->modifiers);
			var code = ShimKeys.keyCode(event->key, event->scancode);
			AppKeyAction action = event->down != 0 ? (event->repeat != 0 ? APP_KEY_REPEATED : APP_KEY_PRESSED) : APP_KEY_RELEASED;
			self.deliverKey(AppKeyboardEvent(action, code, self._modifiers));
			self.applyFocus();
			return;
		}
		if (type == (unsigned int)BTRC_SHIM_EVENT_TEXT_EDITING) {
			if (event->text != null && self._host.focusedId != 0) {
				var focused = self.locate(self._host.focusedId);
				if (focused != null && focused.view.node().effectiveEligible()) {
					var target = (IShimTextTarget?)focused.view;
					if (target != null) { target.textEditing(Strings.copy((char*)event->text), event->data1, event->data2); }
				}
			}
			return;
		}
		if (type == (unsigned int)BTRC_SHIM_EVENT_TEXT_INPUT) {
			if (event->text != null && self._host.focusedId != 0) {
				var focused = self.locate(self._host.focusedId);
				if (focused != null && focused.view.node().effectiveEligible()) { focused.view.textInput(Strings.copy((char*)event->text)); }
			}
			return;
		}
	}

	/* Called by the application after dispatch so focus moves settle. */
	public void settle() {
		if (self._host.focusInvalidated) { self._host.focusInvalidated = false; self.syncTextInput(); }
		self.applyFocus();
		if (self._host.focusedId != 0) { var focused = self.locate(self._host.focusedId); if (focused == null || !focused.view.node().effectiveEligible()) { self.moveFocus(0); } }
	}

	private void layoutRoot() {
		var root = self._root;
		if (root == null || self._window == null) { return; }
		int width = btrcShimWindowWidth(self._window);
		int height = btrcShimWindowHeight(self._window);
		self._host.width = (double)width;
		self._host.height = (double)height;
		root.arrange(0.0, 0.0, (double)width, (double)height);
	}

	public string title() { self.requireOpen(); return self._title; }

	public void setTitle(string title) {
		self.requireOpen();
		if (title == null) { throw "Native window title is missing"; }
		self._title = title;
		btrcShimWindowSetTitle(self._window, title);
	}

	public double contentWidth() { self.requireOpen(); return (double)btrcShimWindowWidth(self._window); }

	public double contentHeight() { self.requireOpen(); return (double)btrcShimWindowHeight(self._window); }

	public void setContentSize(double width, double height) {
		self.requireOpen();
		if (!Math.isFinite(width) || !Math.isFinite(height) || width <= 0.0 || height <= 0.0) { throw "Invalid window content size"; }
		btrcShimWindowSetSize(self._window, (int)Math.ceilDouble(width), (int)Math.ceilDouble(height));
		self._host.width = width;
		self._host.height = height;
		self.layoutRoot(); self.refreshWindowState();
	}

	public void setMinimumContentSize(double width, double height) {
		self.requireOpen();
		if (!Math.isFinite(width) || !Math.isFinite(height) || width <= 0.0 || height <= 0.0) { throw "Invalid window content size"; }
		btrcShimWindowSetMinimumSize(self._window, (int)Math.ceilDouble(width), (int)Math.ceilDouble(height));
	}

	public IView? root() { return self._root; }

	public void attachRoot(IView view) {
		self.requireOpen();
		if (self._root != null) { throw "Detach the existing window root before replacing it"; }
		var native = ShimComposite.projection(view);
		var node = native.node();
		node.requireOpen();
		if (node.attached) { throw "View already belongs to a container"; }
		var transition = ShimAttachmentTransition();
		if (!transition.prepare(node, self._host)) { throw "Native root attachment capture capacity unavailable"; }
		node.attached = true; self._root = native;
		try {
			native.attachTo(self._host); self.layoutRoot();
			node.markInteraction(self._host.eligible); node.settleInteraction();
		} catch (string error) {
			try { native.attachTo(null); node.attached = false; self._root = null; node.markInteraction(false); node.settleInteraction(); }
			catch (string inverse) { node.faulted = true; node.markInteraction(false); try { node.settleInteraction(); } catch (string cleanup) { } try { node.cancelSemanticForest(); } catch (string cleanup) { } throw error + "; inverse: " + inverse; }
			throw error;
		}
		transition.commit(); self.refreshInteraction(); self._host.invalidation.mark(); transition.finish();
	}

	public IView? detachRoot() {
		self.requireOpen();
		var root = self._root;
		if (root == null) { return null; }
		IShimView detaching = root;
		var transition = ShimAttachmentTransition();
		if (!transition.prepare(detaching.node(), null)) { throw "Native root detach capture capacity unavailable"; }
		/* End editing while the old route and native composition host remain
		 * valid, before focus departure can authorize an ordinary blur commit. */
		detaching.node().attached = false;
		detaching.node().markInteraction(false); detaching.node().settleInteraction();
		self.cancelCapture();
		self.clearHover();
		if (self._host.focusedId != 0) { self.moveFocus(0); }
		try { detaching.attachTo(null); detaching.node().markInteraction(false); }
		catch (string error) {
			transition.abort();
			try { detaching.attachTo(self._host); detaching.node().attached = true; detaching.node().markInteraction(self._host.eligible); detaching.node().settleInteraction(); detaching.node().publishInteraction(); }
			catch (string inverse) { detaching.node().faulted = true; detaching.node().markInteraction(false); try { detaching.node().settleInteraction(); } catch (string cleanup) { } try { detaching.node().cancelSemanticForest(); } catch (string cleanup) { } throw error + "; inverse: " + inverse; }
			throw error;
		}
		transition.commit(); self._root = null;
		detaching.node().publishInteraction(); self._host.invalidation.mark(); transition.finish();
		return root;
	}

	/* A shown window has its controls: they are placed at once, not at the
	 * first frame, so that what a person can see they can also click. */
	public void show() { self.requireOpen(); if (!btrcShimWindowShow(self._window)) { throw "Cannot show native window"; } self._requestedVisible = true; self._visible = true; self.refreshInteraction(); self.layoutRoot(); self.place(null); self._host.invalidation.mark(); }

	public void hide() { self.requireOpen(); if (!btrcShimWindowHide(self._window)) { throw "Cannot hide native window"; } self._requestedVisible = false; self._visible = false; self.refreshInteraction(); }

	public bool isVisible() { return self.isOpen() && self._visible && !btrcShimWindowIsHidden(self._window); }

	public bool isFocused() { return self.isOpen() && self._focused; }

	public void showAlert(string title, string message) {
		self.requireOpen(); self._context.requireNoCloseDecision();
		btrcShimWindowShowMessage(self._window, title, message);
	}

	public ICallbackRegistration onKey(IWindowKeyHandler handler, CallbackScope owner) {
		self.requireOpen();
		if (handler == null) { throw "Window key handler is required"; }
		var keys = ShimWindowKeys(handler);
		keys.activate(self._callbacks, owner);
		self._keys.push(keys);
		return keys;
	}

	public CallbackCancellation close() {
		self._context.requireUI();
		if (self._context.mutationDepth > 0) { throw "Cannot close a window during native tree mutation"; }
		if (self._closed) { return CALLBACK_CANCELLATION_COMPLETE; }
		if (self._closeFailure != "") { throw self._closeFailure; }
		if (!self._closing) {
			self._closing = true; self._closeRequested = false;
			var pending = self._transaction;
			if (pending != null) { pending.resolve(WINDOW_CLOSE_OWNER_LOST); self._transaction = null; }
			self.refreshInteraction(); self._host.invalidation.mark();
		}
		return self.pollClose();
	}

	private void destroyNative() {
		self._host.poller = null; self._host.events.close();
		self._painter = null;
		self._captureRenderer = null;
		self._captureTarget = null;
		self._renderer = null;
		self._device = null;
		var surface = self._surface;
		if (surface != null) { surface.close(); }
		self._surface = null;
		if (self._window != null) { btrcShimWindowDestroy(self._window); self._window = null; }
	}

	public CallbackCancellation pollClose() {
		if (self._closed) { return CALLBACK_CANCELLATION_COMPLETE; }
		if (!self._closing) { return CALLBACK_CANCELLATION_NOT_REQUESTED; }
		if (self._closeFailure != "") { throw self._closeFailure; }
		CallbackCancellation result = CALLBACK_CANCELLATION_COMPLETE;
		try {
			CallbackCancellation callbacks = CALLBACK_CANCELLATION_NOT_REQUESTED;
			if (!self._callbacksClosing) { self._callbacksClosing = true; callbacks = self._callbacks.cancel(); }
			else { callbacks = self._callbacks.pollCompletion(); }
			if (callbacks != CALLBACK_CANCELLATION_COMPLETE) { return callbacks; }
			self._keys.clear();
			var root = self._root;
			if (root != null) {
				IShimView closingRoot = root;
				if (!self._rootClosing) {
					self.cancelCapture();
					closingRoot.node().attached = false;
					closingRoot.attachTo(null);
					self._rootClosing = true;
					result = closingRoot.close();
				} else { result = closingRoot.pollClose(); }
				if (result == CALLBACK_CANCELLATION_COMPLETE) { self._root = null; }
			}
			if (result != CALLBACK_CANCELLATION_COMPLETE) { return result; }
			var painter = self._painter;
			if (painter != null) { painter.close(); self._painter = null; }
			var renderer = self._renderer;
			if (renderer != null) { renderer.close(); self._renderer = null; }
			var captureRenderer = self._captureRenderer;
			if (captureRenderer != null) { captureRenderer.close(); self._captureRenderer = null; }
			var captureTarget = self._captureTarget;
			if (captureTarget != null) { captureTarget.close(); self._captureTarget = null; }
			var device = self._device;
			if (device != null) {
				if (!self._deviceClosing) { self._deviceClosing = true; device.close(); }
				if (device.poll() != GPU_DEVICE_CLOSED) { return CALLBACK_CANCELLATION_PENDING; }
			}
			self._device = null;
			self._host.device = null;
			self.destroyNative();
			self._closed = true; self.refreshWindowState();
		} catch (string error) { self._closeFailure = error; throw error; }
		return CALLBACK_CANCELLATION_COMPLETE;
	}

	public void __del__() { if (self._window != null && self.close() != CALLBACK_CANCELLATION_COMPLETE) { Console.fatal("Native window destroyed before subtree cleanup completed"); } }
}

class ShimWindowCloseTransaction implements IWindowCloseTransaction {
	private ShimContext _context;
	private ShimWindow? _owner;
	private WindowCloseState _state = WINDOW_CLOSE_AWAITING_DECISION;
	private long long _revision = 0LL;
	private bool _hasRevision = false;
	private long long _attempt = 0LL;
	private bool _coordinated;

	public ShimWindowCloseTransaction(ShimWindow owner, ShimContext context, bool coordinated) {
		context.requireUI(); self._context = context; self._owner = owner; self._coordinated = coordinated;
	}

	private WindowCloseOutcome outcome(WindowCloseOutcomeKind kind) {
		var result = WindowCloseOutcome(); result.kind = kind; result.state = self._state; result.attempt = self._attempt; return result;
	}

	public WindowCloseState state() { self._context.requireUI(); return self._state; }

	public bool pending() { self._context.requireUI(); return self._state == WINDOW_CLOSE_AWAITING_DECISION || self._state == WINDOW_CLOSE_SAVING || self._state == WINDOW_CLOSE_AUTHORIZED; }

	public void holdForQuit() { self._context.requireUI(); if (!self.pending()) { throw "Close transaction is not pending"; } self._coordinated = true; }

	public long long acknowledgedRevision() { self._context.requireUI(); return self._revision; }

	public bool coordinatedAuthorization() { self._context.requireUI(); return self._coordinated && self._state == WINDOW_CLOSE_AUTHORIZED; }

	/* Cancellation seals the existing registration first; already admitted
	 * callbacks may finish, but their later decisions cannot revive this owner. */
	public void resolve(WindowCloseState state) {
		self._context.requireUI();
		if (!self.pending()) { return; }
		if (state != WINDOW_CLOSE_CANCELLED && state != WINDOW_CLOSE_OWNER_LOST && state != WINDOW_CLOSE_CLOSING) { throw "Invalid close transaction retirement"; }
		self._state = state; self._attempt = 0LL; self._owner = null;
	}

	private WindowCloseOutcome authorize(ShimWindow owner) {
		self._state = WINDOW_CLOSE_AUTHORIZED; self._attempt = 0LL;
		if (!self._coordinated) { owner.consumeCloseAuthorization(self); } else { owner.wakeCloseCoordinator(); }
		return self.outcome(WINDOW_CLOSE_OUTCOME_APPLIED);
	}

	public WindowCloseOutcome decide(WindowCloseDecision decision, long long documentRevision) {
		self._context.requireUI();
		var owner = self._owner;
		if (owner == null || !self.pending() || !owner.isPendingClose(self)) { return self.outcome(WINDOW_CLOSE_OUTCOME_NOT_PENDING); }
		if (self._hasRevision && documentRevision < self._revision) { return self.outcome(WINDOW_CLOSE_OUTCOME_STALE_REVISION); }
		if (decision != WINDOW_CLOSE_DECISION_SAVE && decision != WINDOW_CLOSE_DECISION_DISCARD && decision != WINDOW_CLOSE_DECISION_CANCEL) { throw "Invalid close decision"; }
		// Held permission can be replaced only by a fresh explicit owner decision.
		if (self._state == WINDOW_CLOSE_AUTHORIZED && !self._coordinated) { throw "Close authorization is already consumed"; }
		if (decision == WINDOW_CLOSE_DECISION_CANCEL) {
			self._revision = documentRevision; self._hasRevision = true; self.resolve(WINDOW_CLOSE_CANCELLED); owner.retireCloseTransaction(self);
			return self.outcome(WINDOW_CLOSE_OUTCOME_APPLIED);
		}
		if (self._state == WINDOW_CLOSE_SAVING) {
			if (decision != WINDOW_CLOSE_DECISION_SAVE || documentRevision <= self._revision) { throw "Only a newer document revision may update an active save"; }
			self._revision = documentRevision; self._hasRevision = true; return self.outcome(WINDOW_CLOSE_OUTCOME_APPLIED);
		}
		if (decision == WINDOW_CLOSE_DECISION_DISCARD) { self._revision = documentRevision; self._hasRevision = true; return self.authorize(owner); }
		/* Exhaustion fails before changing the transaction's revision/state. */
		long long attempt = owner.nextCloseSaveAttempt();
		self._revision = documentRevision; self._hasRevision = true; self._attempt = attempt; self._state = WINDOW_CLOSE_SAVING; if (self._coordinated) { owner.wakeCloseCoordinator(); }
		return self.outcome(WINDOW_CLOSE_OUTCOME_APPLIED);
	}

	public WindowCloseOutcome completeSave(long long attempt, long long savedRevision, bool succeeded, string error) {
		self._context.requireUI();
		var owner = self._owner;
		if (owner == null || !self.pending() || !owner.isPendingClose(self)) { return self.outcome(WINDOW_CLOSE_OUTCOME_NOT_PENDING); }
		if (attempt <= 0LL || attempt != self._attempt) { return self.outcome(WINDOW_CLOSE_OUTCOME_STALE_ATTEMPT); }
		if (self._state != WINDOW_CLOSE_SAVING) { throw "No matching save is active"; }
		if (!succeeded) { self._state = WINDOW_CLOSE_AWAITING_DECISION; self._attempt = 0LL; return self.outcome(WINDOW_CLOSE_OUTCOME_APPLIED); }
		if (!self._hasRevision || savedRevision > self._revision) { throw "Save completion revision was not acknowledged"; }
		if (savedRevision < self._revision) { self._state = WINDOW_CLOSE_AWAITING_DECISION; self._attempt = 0LL; return self.outcome(WINDOW_CLOSE_OUTCOME_STALE_REVISION); }
		return self.authorize(owner);
	}
}

/* This adaptor does not own a second callback gate. The semantic channel owns
 * receiver entry and drain; cancellation additionally resolves the Window's
 * pending transaction, including cancellation through either owning scope. */
class ShimWindowCloseRegistration implements ICallbackRegistration {
	private ShimWindow? _owner;
	private ICallbackRegistration _channel;
	public ShimWindowCloseRegistration(ShimWindow owner, ICallbackRegistration channel) { self._owner = owner; self._channel = channel; }

	public bool isOpen() { return self._channel.isOpen(); }

	public CallbackCancellation cancel() {
		var owner = self._owner;
		var result = self._channel.cancel();
		if (owner != null) { owner.closeHandlerCancelled(self); }
		if (result == CALLBACK_CANCELLATION_COMPLETE) { self._owner = null; }
		return result;
	}

	public CallbackCancellation pollCompletion() {
		var result = self._channel.pollCompletion();
		if (result == CALLBACK_CANCELLATION_COMPLETE) { self._owner = null; }
		return result;
	}
}

class ShimWindowCloseReceiver {
	private ShimWindow _owner;
	private IWindowCloseRequestHandler _handler;
	public ShimWindowCloseReceiver(ShimWindow owner, IWindowCloseRequestHandler handler) { self._owner = owner; self._handler = handler; }

	class void deliver(ShimWindowCloseReceiver receiver, IWindowCloseTransaction transaction) {
		if (!receiver._owner.currentCloseRequest(transaction)) { return; }
		receiver._owner.enterCloseDecision();
		try { receiver._handler.closeRequested(transaction); }
		finally { receiver._owner.leaveCloseDecision(); }
	}
}

class ShimWindowQuitMember {
	public ShimWindow window;
	public ShimWindowCloseTransaction? transaction;
	public long long handlerGeneration;
	public long long revision = 0LL;
	public ShimWindowQuitMember(ShimWindow window, WindowCloseRequestOutcome request) {
		self.window = window; self.handlerGeneration = window.closeHandlerGeneration(); self.transaction = window.coordinatedTransaction();
		if (request.kind != WINDOW_CLOSE_REQUEST_PENDING && request.kind != WINDOW_CLOSE_REQUEST_ALREADY_PENDING && request.kind != WINDOW_CLOSE_REQUEST_AUTHORIZED_NO_HANDLER) { throw "Cannot include a closing window in native quit"; }
		if ((request.kind == WINDOW_CLOSE_REQUEST_AUTHORIZED_NO_HANDLER) != (self.transaction == null)) { throw "Native quit transaction identity is inconsistent"; }
	}
}

class ShimWindowQuitCoordinator {
	private Vector<ShimWindow> _windows;
	private Vector<ShimWindowQuitMember> _members = [];
	private ShimContext _context;
	private bool _started = false;
	private bool _cancelled = false;
	private bool _committed = false;
	public ShimWindowQuitCoordinator(Vector<ShimWindow> windows, ShimContext context) { context.requireUI(); self._windows = windows; self._context = context; context.setNativeQuitPending(true); }

	public bool cancelled() { self._context.requireUI(); return self._cancelled; }

	public void cancel() {
		self._context.requireUI(); if (self._cancelled || self._committed) { return; }
		self._cancelled = true;
		for member in self._members { member.window.cancelCoordinatedClose(member.transaction); }
		self._context.setNativeQuitPending(false);
	}

	public bool advance() {
		self._context.requireUI(); if (self._cancelled || self._committed) { return false; }
		if (!self._started) {
			self._started = true;
			try { for window in self._windows { if (window.isOpen()) { self._members.push(ShimWindowQuitMember(window, window.requestCoordinatedClose())); } } }
			catch (string error) { self.cancel(); throw error; }
		}
		int open = 0;
		for window in self._windows {
			if (window.isOpen()) { open++; bool found = false; for member in self._members { if (member.window == window) { found = true; } } if (!found) { self.cancel(); return false; } }
		}
		if (open != self._members.len) { self.cancel(); return false; }
		bool ready = true;
		for member in self._members {
			if (!member.window.isOpen() || member.window.closeHandlerGeneration() != member.handlerGeneration) { self.cancel(); return false; }
			var transaction = member.transaction;
			if (transaction == null) { if (member.window.hasCloseHandler()) { self.cancel(); return false; } }
			else {
				var state = transaction.state();
				if (state == WINDOW_CLOSE_CANCELLED || state == WINDOW_CLOSE_OWNER_LOST || state == WINDOW_CLOSE_CLOSING || !member.window.hasCloseHandler()) { self.cancel(); return false; }
				if (state != WINDOW_CLOSE_AUTHORIZED) { ready = false; }
				member.revision = transaction.acknowledgedRevision();
			}
		}
		if (!ready) { return false; }
		for member in self._members { var transaction = member.transaction; if (transaction != null && !member.window.validatesCloseAuthorization(transaction, member.handlerGeneration, member.revision)) { self.cancel(); return false; } }
		return true;
	}

	/* This final validation and the caller's requestQuit run in one UI turn,
	 * with no application callback between authorization and consumption. */
	public void commit() {
		self._context.requireUI(); if (!self.advance()) { throw "Native quit group is not authorized"; }
		for member in self._members { var transaction = member.transaction; if (transaction != null) { member.window.commitCoordinatedClose(transaction); } else { member.window.releaseQuitHold(); } }
		self._committed = true; self._context.setNativeQuitPending(false);
	}
}
