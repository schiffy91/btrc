import Library.App;
import Library.Strings;
import Library.GUI.IDirectoryPicker;
import Library.GUI.Shim.Shim;
import Library.GUI.Shim.ShimWindow;
import Library.GUI.Shim.DialogPump;

/* The toolkit picker remains available when the Linux desktop has no portal
 * supporting directory requests. Keep the window object alive across portal
 * startup: by the time fallback is needed a queued event may have closed it. */
class ShimDirectoryPicker implements IDirectoryPicker {
	private ShimWindow? _parent;
	private IShimDialogPump _pump;

	public ShimDirectoryPicker(ShimWindow? parent, IShimDialogPump pump) { self._parent = parent; self._pump = pump; }

	class DirectoryPickerOutcome modal(ShimWindow? parent, IShimDialogPump pump, DirectoryPickerRequest request) {
		if (request == null || !request.isValid()) { return DirectoryPickerOutcome.failed(AppError(APP_ERROR_INVALID_ARGUMENT, "invalid directory picker request")); }
		if (pump.isDispatching()) { throw "Native event dispatch is already active"; }
		return DirectoryPickerProvider.choose(parent, pump, request, ShimDirectoryPicker(parent, pump));
	}

	public DirectoryPickerOutcome chooseDirectory(DirectoryPickerRequest request) {
		if (request == null || !request.isValid()) { return DirectoryPickerOutcome.failed(AppError(APP_ERROR_INVALID_ARGUMENT, "invalid directory picker request")); }
		if (self._pump.isDispatching()) { throw "Native event dispatch is already active"; }
		var parent = self._parent;
		if (parent != null && !parent.isOpen()) { return DirectoryPickerOutcome.cancelled(); }
		var dialog = btrcShimFolderDialogOpen(parent == null ? null : parent.nativeWindow(), request.initialDirectory, request.title);
		if (dialog == null) { return DirectoryPickerOutcome.failed(AppError(APP_ERROR_BACKEND_UNAVAILABLE, "directory picker is unavailable")); }
		DirectoryPickerOutcome outcome = DirectoryPickerOutcome.cancelled();
		try {
			while (btrcShimFolderDialogState(dialog) == 0) { self._pump.pumpOnce(50); }
			int state = btrcShimFolderDialogState(dialog);
			string directory = Strings.copy((char*)btrcShimFolderDialogPath(dialog));
			if (state == 1 && directory.isEmpty()) { outcome = DirectoryPickerOutcome.failed(AppError(APP_ERROR_INTERNAL, "directory picker selected an empty path")); }
			else if (state == 1) { outcome = DirectoryPickerOutcome.selected(directory); }
			else if (state != 2) { outcome = DirectoryPickerOutcome.failed(AppError(APP_ERROR_INTERNAL, "directory picker failed: " + Strings.copy((char*)btrcShimError()))); }
		} finally { btrcShimFolderDialogRelease(dialog); }
		return outcome;
	}
}
