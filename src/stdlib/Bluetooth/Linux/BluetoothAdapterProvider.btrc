/* BluetoothAdapter on Linux: BlueZ's daemon, over the system bus. The
 * adapter's settings are properties of its object, the service record is a
 * profile registered with the daemon, and pairing requests arrive as calls
 * on an agent object this connection serves. The bus is spoken to by the
 * stdlib's own D-Bus client (Library.DBus); no D-Bus library is linked. */

import Library.Bluetooth.BluetoothAddress;
import Library.Bluetooth.BluetoothPairing;
import Library.DBus.DBusConnection;
import Library.DBus.DBusMessage;
import Library.Strings;

#include <poll.h>

class BluetoothAdapterProvider {
	private DBusConnection connection;
	private bool open = false;
	private string name;
	private string path;
	private IBluetoothPairing policy;
	private bool agent = false;
	private bool profile = false;

	class bool supported() { return true; }

	class string service() { return "org.bluez"; }

	/* Connect to the daemon and find the adapter, or throw why not. */
	public BluetoothAdapterProvider(string name, IBluetoothPairing policy) {
		/* The name becomes part of an object path, which admits only these
		 * characters. */
		bool named = !name.isEmpty();
		for (int at = 0; at < name.len(); at++) {
			char letter = name.charAt(at);
			if (!((letter >= 'a' && letter <= 'z') || (letter >= 'A' && letter <= 'Z') || (letter >= '0' && letter <= '9') || letter == '_')) { named = false; }
		}
		if (!named) { throw f"No Bluetooth adapter can be named '{name}'"; }
		self.name = name;
		self.path = f"/org/bluez/{name}";
		self.policy = policy;
		DBusConnection? system = DBusConnection.system();
		if (system == null) { throw "Cannot reach the system bus (is D-Bus running?)"; }
		self.connection = system;
		self.open = true;
		if (self.text("Address").isEmpty()) {
			self.close();
			throw f"No Bluetooth adapter {name} (is bluetoothd running?)";
		}
	}

	private string agentPath() { return f"/org/btrc/bluetooth/{self.name}/agent"; }

	private string profilePath() { return f"/org/btrc/bluetooth/{self.name}/profile"; }

	/* Send a call, wait for it and drop the reply. */
	private bool send(DBusMessage request) { return self.connection.call(request, 5000) != null; }

	/* The reply to Properties.Get of `property` on the object at `path`. */
	private DBusMessage? getter(string path, string iface, string property) {
		DBusMessage request = DBusMessage.methodCall(BluetoothAdapterProvider.service(), path, "org.freedesktop.DBus.Properties", "Get");
		DBusWriter arguments = request.writer();
		arguments.appendString(iface);
		arguments.appendString(property);
		return self.connection.call(request, 5000);
	}

	/* A string property of the adapter; empty when it cannot be read. */
	public string text(string property) {
		if (!self.open) { return ""; }
		DBusMessage? reply = self.getter(self.path, "org.bluez.Adapter1", property);
		if (reply == null) { return ""; }
		DBusMessage answer = reply;
		DBusReader arguments = answer.reader();
		if (arguments.type() != DBUS_TYPE_VARIANT) { return ""; }
		return arguments.recurse().readText();
	}

	private bool flagOf(string path, string iface, string property) {
		DBusMessage? reply = self.getter(path, iface, property);
		if (reply == null) { return false; }
		DBusMessage answer = reply;
		DBusReader arguments = answer.reader();
		return arguments.type() == DBUS_TYPE_VARIANT && arguments.recurse().readBool();
	}

	/* A boolean property of the adapter; false when it cannot be read. */
	public bool flag(string property) { return self.open && self.flagOf(self.path, "org.bluez.Adapter1", property); }

	/* A boolean property of a device the daemon knows, such as "Bonded";
	 * false when it has no such device. */
	public bool deviceFlag(BluetoothAddress peer, string property) { return self.open && self.flagOf(self.devicePath(peer), "org.bluez.Device1", property); }

	/* Properties.Set of an adapter property, awaiting its variant. */
	private DBusMessage setter(string property) {
		DBusMessage request = DBusMessage.methodCall(BluetoothAdapterProvider.service(), self.path, "org.freedesktop.DBus.Properties", "Set");
		DBusWriter arguments = request.writer();
		arguments.appendString("org.bluez.Adapter1");
		arguments.appendString(property);
		return request;
	}

	public bool setFlag(string property, bool value) {
		if (!self.open) { return false; }
		DBusMessage request = self.setter(property);
		request.writer().variantBool(value);
		return self.send(request);
	}

	public bool setNumber(string property, int value) {
		if (!self.open) { return false; }
		DBusMessage request = self.setter(property);
		request.writer().variantUInt32((unsigned int)value);
		return self.send(request);
	}

	public bool setText(string property, string value) {
		if (!self.open) { return false; }
		DBusMessage request = self.setter(property);
		request.writer().variantString(value);
		return self.send(request);
	}

	/* Publish a service record under a profile UUID. The daemon only lists
	 * it; the program serves the channels the record names. */
	public bool publish(string uuid, string record) {
		if (!self.open) { return false; }
		if (self.profile) { self.withdraw(); }
		DBusMessage request = DBusMessage.methodCall(BluetoothAdapterProvider.service(), "/org/bluez", "org.bluez.ProfileManager1", "RegisterProfile");
		DBusWriter arguments = request.writer();
		arguments.appendObjectPath(self.profilePath());
		arguments.appendString(uuid);
		DBusWriter options = arguments.openArray("{sv}");
		options.dictString("ServiceRecord", record);
		options.dictString("Role", "server");
		options.dictBool("RequireAuthentication", false);
		options.dictBool("RequireAuthorization", false);
		options.dictBool("AutoConnect", false);
		options.close();
		self.profile = self.send(request);
		return self.profile;
	}

	private bool manager(string iface, string member, string path, string extra) {
		DBusMessage request = DBusMessage.methodCall(BluetoothAdapterProvider.service(), "/org/bluez", iface, member);
		DBusWriter arguments = request.writer();
		arguments.appendObjectPath(path);
		if (!extra.isEmpty()) { arguments.appendString(extra); }
		return self.send(request);
	}

	public void withdraw() {
		if (self.open && self.profile) { self.manager("org.bluez.ProfileManager1", "UnregisterProfile", self.profilePath(), ""); }
		self.profile = false;
	}

	/* Become the system's pairing agent: its questions about devices that
	 * pair with a code or a confirmation are answered with the policy. The
	 * daemon lets devices pair while it has an agent. */
	public bool arbitrate() {
		if (!self.open) { return false; }
		if (self.agent) { return true; }
		self.agent = self.manager("org.bluez.AgentManager1", "RegisterAgent", self.agentPath(), "NoInputNoOutput") && self.manager("org.bluez.AgentManager1", "RequestDefaultAgent", self.agentPath(), "");
		return self.agent;
	}

	/* Stop being the pairing agent. With no agent left, the daemon stops
	 * letting devices pair. */
	public void dismiss() {
		if (self.open && self.agent) { self.manager("org.bluez.AgentManager1", "UnregisterAgent", self.agentPath(), ""); }
		self.agent = false;
	}

	/* "/org/bluez/hci0/dev_AA_BB_CC_DD_EE_FF" names the device AA:BB:... */
	class BluetoothAddress? deviceOf(string path) {
		int at = path.lastIndexOf("/dev_");
		if (at < 0 || path.length() != at + 22) { return null; }
		return BluetoothAddress.parse(path.substring(at + 5, 17).replace("_", ":"));
	}

	private string devicePath(BluetoothAddress peer) {
		string place = peer.toString().replace(":", "_");
		return f"{self.path}/dev_{place}";
	}

	/* Drop a device's pairing. */
	public bool forget(BluetoothAddress peer) {
		if (!self.open) { return false; }
		DBusMessage request = DBusMessage.methodCall(BluetoothAdapterProvider.service(), self.path, "org.bluez.Adapter1", "RemoveDevice");
		request.writer().appendObjectPath(self.devicePath(peer));
		return self.send(request);
	}

	private bool allowed(DBusMessage message) {
		DBusReader arguments = message.reader();
		if (arguments.type() == DBUS_TYPE_INVALID) { return false; }
		BluetoothAddress? peer = BluetoothAdapterProvider.deviceOf(arguments.readText());
		if (peer == null) { return false; }
		return self.policy.accept(peer);
	}

	/* One call on the agent: the daemon asks whether a device may pair or
	 * use a service. A refusal is the error BlueZ expects. */
	private DBusMessage agentReply(DBusMessage message, string member) {
		bool asks = member.equals("RequestConfirmation") || member.equals("RequestAuthorization") || member.equals("AuthorizeService") || member.equals("RequestPinCode") || member.equals("RequestPasskey");
		if (asks && !self.allowed(message)) { return DBusMessage.error(message, "org.bluez.Error.Rejected", "Pairing is not open"); }
		DBusMessage reply = DBusMessage.methodReturn(message);
		if (member.equals("RequestPinCode")) { reply.writer().appendString("0000"); }
		else if (member.equals("RequestPasskey")) { reply.writer().appendUInt32(0u); }
		return reply;
	}

	private DBusMessage answer(DBusMessage message) {
		string path = message.path();
		string iface = message.interfaceName();
		if (path.equals(self.agentPath()) && iface.equals("org.bluez.Agent1")) { return self.agentReply(message, message.member()); }
		if (path.equals(self.profilePath()) && iface.equals("org.bluez.Profile1")) { return DBusMessage.methodReturn(message); }
		return DBusMessage.error(message, "org.freedesktop.DBus.Error.UnknownMethod", "Unknown method");
	}

	private void handle(DBusMessage message) {
		if (message.type() != DBUS_MESSAGE_TYPE_METHOD_CALL) { return; }
		DBusMessage reply = self.answer(message);
		if (!message.noReply()) { self.connection.send(reply); }
	}

	/* The descriptor to wait on: the bus connection. */
	public int watch(struct pollfd* descriptors, int capacity) {
		if (capacity < 1 || !self.open) { return 0; }
		int descriptor = self.connection.descriptor();
		if (descriptor < 0) { return 0; }
		descriptors[0].fd = descriptor;
		descriptors[0].events = POLLIN;
		descriptors[0].revents = 0;
		return 1;
	}

	/* Answer what the daemon has asked. False when the bus went away. */
	public bool step() {
		if (!self.open) { return false; }
		if (!self.connection.readWrite(0)) { return false; }
		DBusMessage? message = self.connection.popMessage();
		while (message != null) {
			DBusMessage arrived = message;
			self.handle(arrived);
			message = self.connection.popMessage();
		}
		return true;
	}

	public void close() {
		if (!self.open) { return; }
		self.withdraw();
		self.dismiss();
		self.open = false;
		self.connection.close();
	}
}
