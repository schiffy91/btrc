/* Unified std.app/std.gpu presenter for std.native_ui.
 *
 * The session borrows an existing ApplicationWindow and GPU. Its native batch
 * is a child render resource of that GPU and records into the GPU's active
 * pass; it cannot create a window, surface, adapter, device, or present path.
 */

import std.app;
import std.datetime;
import std.gpu;
import std.native_ui;
import std.vector;

#include <btrc_gpu.h>

int std_gpu_native_ui_create(unsigned long long gpu, unsigned long long* compositorOut, unsigned long long* ownerReceiptOut);
int std_gpu_native_ui_begin(unsigned long long compositor, int logicalWidth, int logicalHeight);
int std_gpu_native_ui_add_rect(unsigned long long compositor, float x, float y, float width, float height, float red, float green, float blue, float alpha, float radius);
int std_gpu_native_ui_add_gradient_rect(unsigned long long compositor, float x, float y, float width, float height, unsigned int topRgba, unsigned int bottomRgba, float radius);
int std_gpu_native_ui_add_chevron(unsigned long long compositor, float x, float y, float width, float height, float red, float green, float blue, float alpha, int expanded);
int std_gpu_native_ui_add_glyph(unsigned long long compositor, float x, float y, float width, float height, float red, float green, float blue, float alpha, unsigned long long glyphBits);
int std_gpu_native_ui_system_typography_available(unsigned long long compositor);
int std_gpu_native_ui_text_line_break(unsigned long long compositor, string text, int fontSize, int lineHeight, int fontWeight, int width);
int std_gpu_native_ui_measure_text(unsigned long long compositor, string text, int fontSize, int lineHeight, int fontWeight, int* widthOut, int* heightOut, int* ascentOut, int* descentOut, int* advanceOut);
int std_gpu_native_ui_rasterize_text(unsigned long long compositor, string text, int fontSize, int lineHeight, int fontWeight, float backingScale, int* widthOut, int* heightOut, void** pixelsOut, unsigned long long* pixelBytesOut);
void std_gpu_native_ui_release_text_bitmap(void* pixels);
int std_gpu_native_ui_add_text(unsigned long long compositor, string text, float x, float y, int fontSize, int lineHeight, int fontWeight, float backingScale, float red, float green, float blue, float alpha);
int std_gpu_native_ui_add_image(unsigned long long compositor, string identity, unsigned char* rgba, int sourceWidth, int sourceHeight, unsigned long long sourceRevision, float x, float y, float width, float height);
int std_gpu_native_ui_add_image_region(unsigned long long compositor, string identity, unsigned char* rgba, int sourceWidth, int sourceHeight, unsigned long long sourceRevision, float x, float y, float width, float height, float left, float top, float sourceSpanX, float sourceSpanY);
int std_gpu_native_ui_draw(unsigned long long gpu, unsigned long long compositor);
int std_gpu_native_ui_draw_range(unsigned long long gpu, unsigned long long compositor, int first, int count);
int std_gpu_native_ui_order_count(unsigned long long compositor);
int std_gpu_native_ui_destroy(unsigned long long compositor, unsigned long long ownerReceipt);
void std_gpu_native_ui_finalize(unsigned long long compositor, unsigned long long ownerReceipt);
int std_gpu_native_ui_command_count(unsigned long long compositor);
int std_gpu_native_ui_image_count(unsigned long long compositor);

int nativeUiPlatformMeasure(unsigned long long compositor, string text, int fontSize, int lineHeight, int fontWeight, int* widthOut, int* heightOut, int* ascentOut, int* descentOut, int* advanceOut) { return std_gpu_native_ui_measure_text(compositor, text, fontSize, lineHeight, fontWeight, widthOut, heightOut, ascentOut, descentOut, advanceOut) == GPU_RESOURCE_READY ? 1 : 0; }

int nativeUiPlatformLineBreak(unsigned long long compositor, string text, int fontSize, int lineHeight, int fontWeight, int width) { return std_gpu_native_ui_text_line_break(compositor, text, fontSize, lineHeight, fontWeight, width); }

enum NativeUiAppAttachKind {
	NATIVE_UI_APP_ATTACHED = 0,
	NATIVE_UI_APP_ATTACH_REJECTED = 1
};

enum NativeUiPrepareKind {
	NATIVE_UI_PREPARED = 0,
	NATIVE_UI_PREPARE_LAYOUT_REJECTED = 1,
	NATIVE_UI_PREPARE_DISPLAY_LIST_REJECTED = 2,
	NATIVE_UI_PREPARE_CLOSED = 3
};

enum NativeUiPresentKind {
	NATIVE_UI_PRESENTED = 0,
	NATIVE_UI_PRESENT_DEFERRED = 1,
	NATIVE_UI_PRESENT_PREPARE_REJECTED = 2,
	NATIVE_UI_PRESENT_GPU_REJECTED = 3,
	NATIVE_UI_PRESENT_CLOSED = 4
};

class NativeUiAppAttachOutcome {
	public NativeUiAppAttachKind kind;
	public NativeUiAppSession? session;
	public string error;

	public NativeUiAppAttachOutcome(NativeUiAppAttachKind kind, NativeUiAppSession? session, string error) {
		self.kind = kind;
		self.session = session;
		self.error = error;
	}
}

int nativeUiPlatformRasterize(unsigned long long compositor, string text, int fontSize, int lineHeight, int fontWeight, float backingScale, int* widthOut, int* heightOut, void** pixelsOut, unsigned long long* pixelBytesOut) {
	int status = std_gpu_native_ui_rasterize_text(compositor, text, fontSize, lineHeight, fontWeight, backingScale, widthOut, heightOut, pixelsOut, pixelBytesOut);
	return status == GPU_RESOURCE_READY ? 1 : 0;
}

void nativeUiPlatformRelease(void* pixels) { std_gpu_native_ui_release_text_bitmap(pixels); }

class NativeUiPrepareOutcome {
	public NativeUiPrepareKind kind;
	public NativeUiFrame frame;
	public string error;
	public float layoutMilliseconds;
	public float displayListMilliseconds;
	public int measuredNodes;
	public int reusedNodes;

	public NativeUiPrepareOutcome(NativeUiPrepareKind kind, NativeUiFrame frame, string error, float layoutMilliseconds = 0.0f, float displayListMilliseconds = 0.0f, int measuredNodes = 0, int reusedNodes = 0) {
		self.kind = kind;
		self.frame = frame;
		self.error = error;
		self.layoutMilliseconds = layoutMilliseconds;
		self.displayListMilliseconds = displayListMilliseconds;
		self.measuredNodes = measuredNodes;
		self.reusedNodes = reusedNodes;
	}
}

class NativeUiPresentOutcome {
	public NativeUiPresentKind kind;
	public NativeUiFrame frame;
	public GPUFrameKind gpuFrame;
	public string error;

	public NativeUiPresentOutcome(NativeUiPresentKind kind, NativeUiFrame frame, GPUFrameKind gpuFrame, string error) {
		self.kind = kind;
		self.frame = frame;
		self.gpuFrame = gpuFrame;
		self.error = error;
	}
}

class NativeUiAppSession {
	private ApplicationWindow window;
	private GPU gpu;
	private NativeUiRenderer renderer;
	private NativeUiTheme theme;
	private NativeUiTypography typographyValue;
	private unsigned long long compositorIdentity;
	private unsigned long long ownerReceipt;
	private bool prepared;
	private int contentOrderCount = 0;
	private int totalOrderCount = 0;

	private NativeUiAppSession(ApplicationWindow window, GPU gpu, NativeUiStyleSheet styleSheet, NativeUiTheme theme, NativeUiTypography typography, unsigned long long compositorIdentity, unsigned long long ownerReceipt) {
		self.window = window;
		self.gpu = gpu;
		self.renderer = NativeUiRenderer(theme, styleSheet, typography);
		self.theme = theme;
		self.typographyValue = typography;
		self.compositorIdentity = compositorIdentity;
		self.ownerReceipt = ownerReceipt;
		self.prepared = false;
	}

	class NativeUiAppAttachOutcome attach(ApplicationWindow window, GPU gpu, NativeUiStyleSheet? styleSheet = null, NativeUiTheme? theme = null, NativeUiTypography? typography = null) {
		if (window == null || gpu == null || !window.isOpen() || !gpu.isOpen()) {
			return NativeUiAppAttachOutcome(NATIVE_UI_APP_ATTACH_REJECTED, null, "native UI requires an open std.app window and std.gpu");
		}
		NativeUiStyleSheet resolvedSheet = styleSheet == null ? NativeUiStyleSheet() : styleSheet;
		NativeUiTheme resolvedTheme = theme == null ? NativeUiTheme.nativeDefault() : theme;
		NativeUiTypography resolvedTypography = typography == null ? NativeUiTypography() : typography;
		if (!resolvedSheet.ok()) {
			return NativeUiAppAttachOutcome(NATIVE_UI_APP_ATTACH_REJECTED, null, resolvedSheet.issue().message());
		}
		unsigned long long compositor = 0ULL;
		unsigned long long receipt = 0ULL;
		int status = std_gpu_native_ui_create(gpu.gpuIdentity(), &compositor, &receipt);
		if (status != GPU_RESOURCE_READY || compositor == 0ULL || receipt == 0ULL) {
			if (compositor != 0ULL && receipt != 0ULL) {
				std_gpu_native_ui_destroy(compositor, receipt);
			}
			return NativeUiAppAttachOutcome(NATIVE_UI_APP_ATTACH_REJECTED, null, std_gpu_status_message(status));
		}
		if (typography == null && std_gpu_native_ui_system_typography_available(compositor) != 0) {
			resolvedTypography = NativeUiTypography.platform(compositor, nativeUiPlatformMeasure, nativeUiPlatformRasterize, nativeUiPlatformRelease, nativeUiPlatformLineBreak);
		}
		return NativeUiAppAttachOutcome(NATIVE_UI_APP_ATTACHED, NativeUiAppSession(window, gpu, resolvedSheet, resolvedTheme, resolvedTypography, compositor, receipt), "");
	}

	public bool isOpen() { return self.compositorIdentity != 0ULL && self.ownerReceipt != 0ULL && self.window.isOpen() && self.gpu.isOpen(); }

	public NativeUiRenderer input() { return self.renderer; }

	public AppSurfaceMetrics metrics() { return self.window.metrics(); }

	/* The session's typography, for painters that rasterize their own text. */
	public NativeUiTypography typography() { return self.typographyValue; }

	/* Backing pixels per logical pixel of the window, the scale the
	 * compositor rasterizes text at. */
	public float backingScale() {
		AppSurfaceMetrics metrics = self.window.metrics();
		float scale = metrics.scaleX > metrics.scaleY ? metrics.scaleX : metrics.scaleY;
		return scale < 0.5f ? 1.0f : (scale > 4.0f ? 4.0f : scale);
	}

	public int commandCount() { return self.isOpen() ? std_gpu_native_ui_command_count(self.compositorIdentity) : 0; }

	public int cachedImageCount() { return self.isOpen() ? std_gpu_native_ui_image_count(self.compositorIdentity) : 0; }

	private float channel(int value) { return (float)value / 255.0f; }

	private unsigned int packedColor(NativeUiColor value) { return ((unsigned int)value.red << 24) | ((unsigned int)value.green << 16) | ((unsigned int)value.blue << 8) | (unsigned int)value.alpha; }

	private GPUResourceOutcome addRect(float x, float y, float width, float height, NativeUiColor color, float radius) {
		int status = std_gpu_native_ui_add_rect(self.compositorIdentity, x, y, width, height, self.channel(color.red), self.channel(color.green), self.channel(color.blue), self.channel(color.alpha), radius);
		GPUResourceKind kind = status >= GPU_RESOURCE_READY && status <= GPU_RESOURCE_INTERNAL_ERROR ? (GPUResourceKind)status : GPU_RESOURCE_INTERNAL_ERROR;
		return GPUResourceOutcome(kind, kind == GPU_RESOURCE_READY ? "" : std_gpu_status_message(status));
	}

	private GPUResourceOutcome addText(string text, float x, float y, NativeUiColor color, int viewportWidth, NativeUiResolvedStyle style) {
		if (self.typographyValue.platformBacked()) {
			AppSurfaceMetrics metrics = self.window.metrics();
			float backingScale = metrics.scaleX > metrics.scaleY ? metrics.scaleX : metrics.scaleY;
			int status = std_gpu_native_ui_add_text(self.compositorIdentity, text, x, y, style.fontSize(), style.lineHeight(), style.fontWeight(), backingScale, self.channel(color.red), self.channel(color.green), self.channel(color.blue), self.channel(color.alpha));
			GPUResourceKind kind = status >= GPU_RESOURCE_READY && status <= GPU_RESOURCE_INTERNAL_ERROR ? (GPUResourceKind)status : GPU_RESOURCE_INTERNAL_ERROR;
			return GPUResourceOutcome(kind, kind == GPU_RESOURCE_READY ? "" : std_gpu_status_message(status));
		}
		float cursor = x;
		float glyphWidth = (float)self.typographyValue.glyphWidth(style.fontSize());
		float glyphHeight = (float)self.typographyValue.glyphHeight(style.fontSize());
		float glyphY = y + (float)(style.lineHeight() - self.typographyValue.glyphHeight(style.fontSize())) / 2.0f;
		float advance = (float)self.typographyValue.advance(style.fontSize());
		int index = 0;
		while (index < text.len()) {
			if (cursor >= (float)viewportWidth) { break; }
			unsigned long long glyph = self.typographyValue.glyph(text[index]);
			if (glyph != 0ULL) {
				int status = std_gpu_native_ui_add_glyph(self.compositorIdentity, cursor, glyphY, glyphWidth, glyphHeight, self.channel(color.red), self.channel(color.green), self.channel(color.blue), self.channel(color.alpha), glyph);
				if (status != GPU_RESOURCE_READY) {
					return GPUResourceOutcome((GPUResourceKind)status, std_gpu_status_message(status));
				}
				if (style.fontWeight() >= 600 && cursor + 1.0f < (float)viewportWidth) {
					int boldStatus = std_gpu_native_ui_add_glyph(self.compositorIdentity, cursor + 1.0f, glyphY, glyphWidth, glyphHeight, self.channel(color.red), self.channel(color.green), self.channel(color.blue), self.channel(color.alpha), glyph);
					if (boldStatus != GPU_RESOURCE_READY) { return GPUResourceOutcome((GPUResourceKind)boldStatus, std_gpu_status_message(boldStatus)); }
				}
			}
			index = NativeUiTextInput.nextBoundary(text, index);
			cursor += advance;
		}
		return GPUResourceOutcome(GPU_RESOURCE_READY, "");
	}

	private GPUResourceOutcome addPanel(int x, int y, int width, int height, NativeUiColor fill, NativeUiResolvedStyle style, NativeUiLinearGradient? gradient) {
		if (!style.hasBorder()) { return self.addFill(x, y, width, height, fill, style.radius(), gradient); }
		GPUResourceOutcome outer = self.addRect((float)x, (float)y, (float)width, (float)height, style.border(), (float)style.radius());
		if (outer.kind != GPU_RESOURCE_READY || !style.hasBorder() || width <= 2 || height <= 2) { return outer; }
		return self.addFill(x + 1, y + 1, width - 2, height - 2, fill, style.radius() > 0 ? style.radius() - 1 : 0, gradient);
	}

	private GPUResourceOutcome addFill(int x, int y, int width, int height, NativeUiColor fill, int radius, NativeUiLinearGradient? gradient) {
		GPUResourceOutcome base = self.addRect((float)x, (float)y, (float)width, (float)height, fill, (float)radius);
		if (base.kind != GPU_RESOURCE_READY || gradient == null) { return base; }
		NativeUiColor top = gradient.top();
		NativeUiColor bottom = gradient.bottom();
		int status = std_gpu_native_ui_add_gradient_rect(self.compositorIdentity, (float)x, (float)y, (float)width, (float)height, self.packedColor(top), self.packedColor(bottom), (float)radius);
		return GPUResourceOutcome((GPUResourceKind)status, status == GPU_RESOURCE_READY ? "" : std_gpu_status_message(status));
	}

	private bool visible(NativeUiLayoutBox box, NativeUiViewportMetrics viewport) {
		int screenX = box.bounds.x - viewport.scrollX();
		int screenY = box.bounds.y - viewport.scrollY();
		return screenX < viewport.width() && screenY < viewport.height() && screenX + box.bounds.width > 0 && screenY + box.bounds.height > 0;
	}

	private GPUResourceOutcome buildSelectPopup(NativeUiFrame frame) {
		NativeUiSelectPopup popup = self.renderer.selectPopup();
		if (!popup.visible()) { return GPUResourceOutcome(GPU_RESOURCE_READY, ""); }
		NativeUiLayoutBox? optionalBox = frame.boxFor(popup.ownerId());
		if (optionalBox == null) { return GPUResourceOutcome(GPU_RESOURCE_INTERNAL_ERROR, "native UI select popup owner is missing"); }
		NativeUiSelect? optionalSelect = optionalBox.element.selectDescriptor();
		if (optionalSelect == null) { return GPUResourceOutcome(GPU_RESOURCE_INTERNAL_ERROR, "native UI select popup descriptor is missing"); }
		NativeUiLayoutBox box = optionalBox;
		NativeUiSelect descriptor = optionalSelect;
		NativeUiRect popupBounds = popup.bounds();
		NativeUiResolvedStyle textStyle = NativeUiSelectPopup.textStyle(box.style);
		GPUResourceOutcome border = self.addRect((float)popupBounds.x, (float)popupBounds.y, (float)popupBounds.width, (float)popupBounds.height, self.theme.border, (float)NativeUiSelectPopup.radius());
		if (border.kind != GPU_RESOURCE_READY) { return border; }
		if (popupBounds.width > 2 && popupBounds.height > 2) {
			GPUResourceOutcome background = self.addRect((float)(popupBounds.x + 1), (float)(popupBounds.y + 1), (float)(popupBounds.width - 2), (float)(popupBounds.height - 2), self.theme.panel, (float)(NativeUiSelectPopup.radius() - 1));
			if (background.kind != GPU_RESOURCE_READY) { return background; }
		}
		for (int index = popup.firstOptionIndex(); index < popup.firstOptionIndex() + popup.visibleOptionCount(); index++) {
			NativeUiSelectOption option = descriptor.optionAt(index);
			NativeUiRect row = popup.optionBounds(index);
			bool highlighted = option.enabled() && index == self.renderer.highlightedSelectIndex();
			if (highlighted) {
				GPUResourceOutcome highlight = self.addRect((float)row.x, (float)row.y, (float)row.width, (float)row.height, self.theme.accent, (float)NativeUiSelectPopup.rowRadius());
				if (highlight.kind != GPU_RESOURCE_READY) { return highlight; }
			} else if (index == descriptor.selectedIndex()) {
				GPUResourceOutcome selected = self.addRect((float)row.x, (float)row.y, 3.0f, (float)row.height, self.theme.accent, 0.0f);
				if (selected.kind != GPU_RESOURCE_READY) { return selected; }
			}
			NativeUiColor color = !option.enabled() ? self.theme.mutedText : (highlighted ? self.theme.accentText : (box.style.hasForeground() ? box.style.foreground() : self.theme.text));
			GPUResourceOutcome label = self.addText(option.label(), (float)(row.x + NativeUiSelectPopup.labelInset()), (float)(row.y + (row.height - textStyle.lineHeight()) / 2), color, frame.viewport.width(), textStyle);
			if (label.kind != GPU_RESOURCE_READY) { return label; }
		}
		return GPUResourceOutcome(GPU_RESOURCE_READY, "");
	}

	private GPUResourceOutcome buildDisplayList(NativeUiFrame frame) {
		int status = std_gpu_native_ui_begin(self.compositorIdentity, frame.viewport.width(), frame.viewport.height());
		if (status != GPU_RESOURCE_READY) {
			return GPUResourceOutcome((GPUResourceKind)status, std_gpu_status_message(status));
		}
		string hovered = self.renderer.hoveredId();
		string pressed = self.renderer.pressedId();
		string focused = self.renderer.focusedId();
		for box in frame.boxes {
			if (!self.visible(box, frame.viewport)) { continue; }
			int x = box.bounds.x - frame.viewport.scrollX();
			int y = box.bounds.y - frame.viewport.scrollY();
			NativeUiResolvedStyle style = box.style;
			bool highlighted = box.id().equals(hovered) || box.id().equals(pressed);
			if (box.kind() == NATIVE_UI_TEXT_INPUT) {
				bool hasFocus = box.id().equals(focused);
				GPUResourceOutcome border = self.addRect((float)x, (float)y, (float)box.bounds.width, (float)box.bounds.height, hasFocus ? self.theme.accent : (style.hasBorder() ? style.border() : self.theme.border), (float)style.radius());
				if (border.kind != GPU_RESOURCE_READY) { return border; }
				if (box.bounds.width > 2 && box.bounds.height > 2) {
					GPUResourceOutcome field = self.addFill(x + 1, y + 1, box.bounds.width - 2, box.bounds.height - 2, style.hasBackground() ? style.background() : self.theme.panel, style.radius() > 0 ? style.radius() - 1 : 0, style.backgroundGradient());
					if (field.kind != GPU_RESOURCE_READY) { return field; }
				}
				Image? icon = box.element.contentImage();
				NativeUiRect iconBounds = NativeUiTextInput.iconBounds(box);
				if (icon != null && !icon.isEmpty() && iconBounds.width > 0 && iconBounds.height > 0) {
					int iconStatus = std_gpu_native_ui_add_image(self.compositorIdentity, box.id(), icon.data, icon.width, icon.height, box.element.contentImageRevision(), (float)(iconBounds.x - frame.viewport.scrollX()), (float)(iconBounds.y - frame.viewport.scrollY()), (float)iconBounds.width, (float)iconBounds.height);
					if (iconStatus != GPU_RESOURCE_READY) { return GPUResourceOutcome((GPUResourceKind)iconStatus, std_gpu_status_message(iconStatus)); }
				}
				string value = self.renderer.displayValue(box.element);
				bool placeholder = value.isEmpty();
				string visibleValue = placeholder ? box.element.placeholderText() : value;
				NativeUiTextViewport run = NativeUiTextViewport(visibleValue, box.bounds.width - style.horizontalPadding(), hasFocus && !placeholder ? self.renderer.focusedCaret() : -1, hasFocus && !placeholder ? (self.renderer.selectionStart() == self.renderer.focusedCaret() ? self.renderer.selectionEnd() : self.renderer.selectionStart()) : -1, self.typographyValue, style);
				int textX = x + style.paddingLeft();
				int textY = y + style.paddingTop() + (box.bounds.height - style.verticalPadding() - style.lineHeight()) / 2;
				if (hasFocus && run.selectionWidth > 0) {
					GPUResourceOutcome selection = self.addRect((float)(textX + run.selectionX), (float)textY, (float)run.selectionWidth, (float)style.lineHeight(), self.theme.textSelection, 0.0f);
					if (selection.kind != GPU_RESOURCE_READY) { return selection; }
				}
				GPUResourceOutcome text = self.addText(run.text, (float)textX, (float)textY, placeholder ? self.theme.mutedText : (style.hasForeground() ? style.foreground() : self.theme.text), frame.viewport.width(), style);
				if (text.kind != GPU_RESOURCE_READY) { return text; }
				if (hasFocus && self.renderer.caretVisible()) {
					int caretX = textX + (placeholder ? 0 : run.caretX);
					if (caretX >= x + style.paddingLeft() && caretX < x + box.bounds.width - style.paddingRight() + 1) {
						NativeUiRect bounds = NativeUiTextViewport.caretBounds(caretX, textY, style);
						GPUResourceOutcome caret = self.addRect((float)bounds.x, (float)bounds.y, (float)bounds.width, (float)bounds.height, style.hasForeground() ? style.foreground() : self.theme.text, 0.0f);
						if (caret.kind != GPU_RESOURCE_READY) {
							return caret;
						}
					}
				}
			} else if (box.kind() == NATIVE_UI_SELECT) {
				NativeUiSelectPopup popup = self.renderer.selectPopup();
				bool hasFocus = box.id().equals(focused);
				bool expanded = popup.visible() && popup.ownerId().equals(box.id());
				GPUResourceOutcome border = self.addRect((float)x, (float)y, (float)box.bounds.width, (float)box.bounds.height, hasFocus || expanded ? self.theme.accent : (style.hasBorder() ? style.border() : self.theme.border), (float)style.radius());
				if (border.kind != GPU_RESOURCE_READY) { return border; }
				if (box.bounds.width > 2 && box.bounds.height > 2) {
					GPUResourceOutcome field = self.addFill(x + 1, y + 1, box.bounds.width - 2, box.bounds.height - 2, style.hasBackground() ? style.background() : self.theme.panel, style.radius() > 0 ? style.radius() - 1 : 0, style.backgroundGradient());
					if (field.kind != GPU_RESOURCE_READY) { return field; }
				}
				NativeUiSelect? optionalSelect = box.element.selectDescriptor();
				if (optionalSelect != null) {
					NativeUiSelect descriptor = optionalSelect;
					NativeUiColor labelColor = box.enabled() ? (style.hasForeground() ? style.foreground() : self.theme.text) : self.theme.mutedText;
					GPUResourceOutcome label = self.addText(descriptor.selectedLabel(), (float)(x + style.paddingLeft()), (float)(y + style.paddingTop() + (box.bounds.height - style.verticalPadding() - style.lineHeight()) / 2), labelColor, frame.viewport.width(), style);
					if (label.kind != GPU_RESOURCE_READY) { return label; }
					NativeUiRect marker = NativeUiSelectIndicator.bounds(box, frame.viewport.scrollX(), frame.viewport.scrollY());
					NativeUiColor markerColor = NativeUiSelectIndicator.color(box, self.theme);
					if (marker.width >= 4 && marker.height >= 4) {
						int arrow = std_gpu_native_ui_add_chevron(self.compositorIdentity, (float)marker.x, (float)marker.y, (float)marker.width, (float)marker.height, self.channel(markerColor.red), self.channel(markerColor.green), self.channel(markerColor.blue), self.channel(markerColor.alpha), expanded ? 1 : 0);
						if (arrow != GPU_RESOURCE_READY) { return GPUResourceOutcome((GPUResourceKind)arrow, std_gpu_status_message(arrow)); }
					}
				}
			} else if (box.kind() == NATIVE_UI_BUTTON) {
				NativeUiColor fill = self.theme.buttonFill(style, box.enabled() && highlighted, box.enabled() && box.id().equals(pressed));
				GPUResourceOutcome rectangle = self.addPanel(x, y, box.bounds.width, box.bounds.height, fill, style, self.theme.buttonGradient(style, box.enabled() && highlighted, box.enabled() && box.id().equals(pressed)));
				if (rectangle.kind != GPU_RESOURCE_READY) {
					return rectangle;
				}
				NativeUiColor label = self.theme.buttonText(style, box.enabled(), highlighted);
				NativeUiTextMetrics metrics = self.typographyValue.measure(box.displayText(), style.fontSize(), style.lineHeight(), style.fontWeight());
				int textX = self.typographyValue.alignedX(x + style.paddingLeft(), box.bounds.width - style.horizontalPadding(), 0, metrics.width(), style.textAlignment());
				GPUResourceOutcome text = self.addText(box.displayText(), (float)textX, (float)(y + style.paddingTop()), label, frame.viewport.width(), style);
				if (text.kind != GPU_RESOURCE_READY) { return text; }
			} else {
				if (style.hasBackground() || style.hasBorder() || style.backgroundGradient() != null) {
					GPUResourceOutcome background = self.addPanel(x, y, box.bounds.width, box.bounds.height, style.hasBackground() ? style.background() : (style.backgroundGradient() != null ? NativeUiColor(0, 0, 0, 0) : self.theme.panel), style, style.backgroundGradient());
					if (background.kind != GPU_RESOURCE_READY) {
						return background;
					}
				}
				if (box.kind() == NATIVE_UI_TEXT) {
					NativeUiTextLayout? layout = box.textLayout();
					int count = layout == null ? 1 : layout.lineCount();
					for (int index = 0; index < count; index++) {
						string value = layout == null ? box.element.contentText() : layout.lineAt(index).text();
						NativeUiTextMetrics metrics = layout == null ? self.typographyValue.measure(value, style.fontSize(), style.lineHeight(), style.fontWeight()) : layout.lineAt(index).metrics();
						int textY = y + style.paddingTop() + (layout == null ? 0 : layout.lineAt(index).top());
						if (textY >= frame.viewport.height() || textY + metrics.height() <= 0) { continue; }
						int textX = self.typographyValue.alignedX(x + style.paddingLeft(), box.bounds.width - style.horizontalPadding(), 0, metrics.width(), style.textAlignment());
						GPUResourceOutcome text = self.addText(value, (float)textX, (float)textY, style.hasForeground() ? style.foreground() : self.theme.text, frame.viewport.width(), style);
						if (text.kind != GPU_RESOURCE_READY) { return text; }
					}
				} else if (box.kind() == NATIVE_UI_IMAGE) {
					int imageWidth = box.bounds.width - style.horizontalPadding();
					int imageHeight = box.bounds.height - style.verticalPadding();
					Image? optionalImage = box.element.contentImage();
					if (optionalImage != null && !optionalImage.isEmpty() && imageWidth > 0 && imageHeight > 0) {
						Image image = optionalImage;
						NativeUiImageRegion? region = box.element.contentImageRegion();
						int imageStatus = region == null ? std_gpu_native_ui_add_image(self.compositorIdentity, box.id(), image.data, image.width, image.height, box.element.contentImageRevision(), (float)(x + style.paddingLeft()), (float)(y + style.paddingTop()), (float)imageWidth, (float)imageHeight) : std_gpu_native_ui_add_image_region(self.compositorIdentity, box.id(), image.data, image.width, image.height, box.element.contentImageRevision(), (float)(x + style.paddingLeft()), (float)(y + style.paddingTop()), (float)imageWidth, (float)imageHeight, (float)region.left(), (float)region.top(), (float)region.width(), (float)region.height());
						if (imageStatus != GPU_RESOURCE_READY) {
							return GPUResourceOutcome((GPUResourceKind)imageStatus, std_gpu_status_message(imageStatus));
						}
					} else {
						GPUResourceOutcome placeholder = self.addRect((float)x, (float)y, (float)box.bounds.width, (float)box.bounds.height, self.theme.border, (float)style.radius());
						if (placeholder.kind != GPU_RESOURCE_READY) {
							return placeholder;
						}
					}
				}
			}
		}
		NativeUiScrollbar scrollbar = self.renderer.verticalScrollbar();
		if (scrollbar.visible()) {
			NativeUiRect thumb = scrollbar.thumb();
			GPUResourceOutcome scroller = self.addRect((float)thumb.x, (float)thumb.y, (float)thumb.width, (float)thumb.height, scrollbar.color(self.theme), 4.0f);
			if (scroller.kind != GPU_RESOURCE_READY) { return scroller; }
		}
		self.contentOrderCount = std_gpu_native_ui_order_count(self.compositorIdentity);
		GPUResourceOutcome popup = self.buildSelectPopup(frame);
		if (popup.kind != GPU_RESOURCE_READY) { return popup; }
		GPUResourceOutcome menu = self.buildTextMenu(frame);
		self.totalOrderCount = std_gpu_native_ui_order_count(self.compositorIdentity);
		return menu;
	}

	private GPUResourceOutcome buildTextMenu(NativeUiFrame frame) {
		NativeUiTextMenu? menu = self.renderer.textMenu();
		if (menu == null) { return GPUResourceOutcome(GPU_RESOURCE_READY, ""); }
		NativeUiRect bounds = menu.geometry.bounds();
		GPUResourceOutcome border = self.addRect((float)bounds.x, (float)bounds.y, (float)bounds.width, (float)bounds.height, self.theme.border, (float)NativeUiSelectPopup.radius());
		if (border.kind != GPU_RESOURCE_READY) { return border; }
		GPUResourceOutcome fill = self.addRect((float)(bounds.x + 1), (float)(bounds.y + 1), (float)(bounds.width - 2), (float)(bounds.height - 2), self.theme.panel, (float)(NativeUiSelectPopup.radius() - 1));
		if (fill.kind != GPU_RESOURCE_READY) { return fill; }
		for (int index = 0; index < 4; index++) {
			NativeUiRect row = menu.geometry.optionBounds(index);
			bool highlighted = menu.enabled(index) && index == menu.highlighted;
			if (highlighted) {
				GPUResourceOutcome highlight = self.addRect((float)row.x, (float)row.y, (float)row.width, (float)row.height, self.theme.accent, (float)NativeUiSelectPopup.rowRadius());
				if (highlight.kind != GPU_RESOURCE_READY) { return highlight; }
			}
			NativeUiColor color = !menu.enabled(index) ? self.theme.mutedText : (highlighted ? self.theme.accentText : self.theme.text);
			GPUResourceOutcome label = self.addText(NativeUiTextMenu.label(index), (float)(row.x + NativeUiSelectPopup.labelInset()), (float)(row.y + (row.height - menu.style.lineHeight()) / 2), color, frame.viewport.width(), menu.style);
			if (label.kind != GPU_RESOURCE_READY) { return label; }
		}
		return GPUResourceOutcome(GPU_RESOURCE_READY, "");
	}

	public NativeUiPrepareOutcome prepare(NativeUiElement root, bool profile = false) { return self.prepareRoot(root, profile, false); }

	/* Retain measurements only for caller-owned immutable published trees. */
	public NativeUiPrepareOutcome prepareImmutable(NativeUiElement root, bool profile = false) { return self.prepareRoot(root, profile, true); }

	private NativeUiPrepareOutcome prepareRoot(NativeUiElement root, bool profile, bool immutableRoot) {
		self.prepared = false;
		if (!self.isOpen()) {
			return NativeUiPrepareOutcome(NATIVE_UI_PREPARE_CLOSED, self.renderer.currentFrame(), "native UI application session is closed");
		}
		AppSurfaceMetrics metrics = self.window.metrics();
		Timer? timer = profile ? Timer() : null;
		if (timer != null) { timer.start(); }
		NativeUiFrame frame = immutableRoot ? self.renderer.layoutImmutable(root, metrics.logicalWidth, metrics.logicalHeight) : self.renderer.layout(root, metrics.logicalWidth, metrics.logicalHeight);
		if (!frame.ok()) {
			return NativeUiPrepareOutcome(NATIVE_UI_PREPARE_LAYOUT_REJECTED, frame, frame.error);
		}
		float layoutMilliseconds = timer == null ? 0.0f : timer.elapsedMillis();
		return self.prepareFrame(frame, profile, layoutMilliseconds, self.renderer.measuredNodeCount(), self.renderer.reusedNodeCount());
	}

	/* Rebuild paint commands from the last published layout (after scrolling
	 * or hover). Call prepare(root) instead after any source-tree mutation. */
	public NativeUiPrepareOutcome prepareCurrent(bool profile = false) {
		self.prepared = false;
		NativeUiFrame frame = self.renderer.currentFrame();
		if (!self.isOpen()) { return NativeUiPrepareOutcome(NATIVE_UI_PREPARE_CLOSED, frame, "native UI application session is closed"); }
		AppSurfaceMetrics metrics = self.window.metrics();
		if (!frame.ok() || frame.viewport.width() != metrics.logicalWidth || frame.viewport.height() != metrics.logicalHeight) { return NativeUiPrepareOutcome(NATIVE_UI_PREPARE_LAYOUT_REJECTED, frame, "native UI requires a current layout before repainting"); }
		return self.prepareFrame(frame, profile, 0.0f);
	}

	private NativeUiPrepareOutcome prepareFrame(NativeUiFrame frame, bool profile, float layoutMilliseconds, int measuredNodes = 0, int reusedNodes = 0) {
		Timer? timer = profile ? Timer() : null;
		if (timer != null) { timer.start(); }
		GPUResourceOutcome displayList = self.buildDisplayList(frame);
		if (displayList.kind != GPU_RESOURCE_READY) {
			return NativeUiPrepareOutcome(NATIVE_UI_PREPARE_DISPLAY_LIST_REJECTED, frame, displayList.error);
		}
		self.prepared = true;
		return NativeUiPrepareOutcome(NATIVE_UI_PREPARED, frame, "", layoutMilliseconds, timer == null ? 0.0f : timer.elapsedMillis(), measuredNodes, reusedNodes);
	}

	/* Record into a frame begun by this app's existing GPU owner. */
	public GPUDrawOutcome recordPrepared() {
		if (!self.isOpen() || !self.prepared) {
			return GPUDrawOutcome(GPU_DRAW_INVALID_DESCRIPTOR, "native UI has no prepared display list");
		}
		int status = std_gpu_native_ui_draw(self.gpu.gpuIdentity(), self.compositorIdentity);
		GPUDrawKind kind = status >= GPU_DRAW_RECORDED && status <= GPU_DRAW_BACKEND_FAILURE ? (GPUDrawKind)status : GPU_DRAW_BACKEND_FAILURE;
		return GPUDrawOutcome(kind, kind == GPU_DRAW_RECORDED ? "" : std_gpu_status_message(status));
	}

	private GPUDrawOutcome recordRange(int first, int count) {
		if (!self.isOpen() || !self.prepared) { return GPUDrawOutcome(GPU_DRAW_INVALID_DESCRIPTOR, "native UI has no prepared display list"); }
		int status = std_gpu_native_ui_draw_range(self.gpu.gpuIdentity(), self.compositorIdentity, first, count);
		GPUDrawKind kind = status >= GPU_DRAW_RECORDED && status <= GPU_DRAW_BACKEND_FAILURE ? (GPUDrawKind)status : GPU_DRAW_BACKEND_FAILURE;
		return GPUDrawOutcome(kind, kind == GPU_DRAW_RECORDED ? "" : std_gpu_status_message(status));
	}

	/* Custom GPU content belongs between these passes. Popup pixels and hit
	 * testing still use the same prepared tree, compositor, and lifecycle. */
	public GPUDrawOutcome recordPreparedContent() { return self.recordRange(0, self.contentOrderCount); }

	public GPUDrawOutcome recordPreparedOverlays() { return self.recordRange(self.contentOrderCount, self.totalOrderCount - self.contentOrderCount); }

	public NativeUiPresentOutcome present(NativeUiElement root) {
		NativeUiPrepareOutcome prepared = self.prepare(root);
		if (prepared.kind != NATIVE_UI_PREPARED) {
			return NativeUiPresentOutcome(prepared.kind == NATIVE_UI_PREPARE_CLOSED ? NATIVE_UI_PRESENT_CLOSED : NATIVE_UI_PRESENT_PREPARE_REJECTED, prepared.frame, GPU_FRAME_REJECTED, prepared.error);
		}
		GPUFrameOutcome begun = self.gpu.beginFrame(self.channel(self.theme.background.red), self.channel(self.theme.background.green), self.channel(self.theme.background.blue));
		if (begun.kind == GPU_FRAME_TIMEOUT || begun.kind == GPU_FRAME_OUTDATED) {
			return NativeUiPresentOutcome(NATIVE_UI_PRESENT_DEFERRED, prepared.frame, begun.kind, begun.error);
		}
		if (begun.kind != GPU_FRAME_READY) {
			return NativeUiPresentOutcome(NATIVE_UI_PRESENT_GPU_REJECTED, prepared.frame, begun.kind, begun.error);
		}
		GPUDrawOutcome drawn = self.recordPrepared();
		GPUFrameOutcome ended = self.gpu.endFrame();
		if (drawn.kind != GPU_DRAW_RECORDED) {
			return NativeUiPresentOutcome(NATIVE_UI_PRESENT_GPU_REJECTED, prepared.frame, ended.kind, drawn.error);
		}
		return NativeUiPresentOutcome(ended.kind == GPU_FRAME_PRESENTED ? NATIVE_UI_PRESENTED : NATIVE_UI_PRESENT_GPU_REJECTED, prepared.frame, ended.kind, ended.error);
	}

	private NativeUiEventBatch noEvents() {
		Vector<NativeUiEvent> events = [];
		return NativeUiEventBatch(self.renderer.currentFrame(), events);
	}

	private NativeUiRangeAdjustment rangeAdjustment(AppKeyboardEvent keyboard) {
		if (self.renderer.focusedId().isEmpty()) { return NATIVE_UI_RANGE_ADJUST_NONE; }
		NativeUiLayoutBox? optionalBox = self.renderer.currentFrame().boxFor(self.renderer.focusedId());
		if (optionalBox == null) { return NATIVE_UI_RANGE_ADJUST_NONE; }
		NativeUiSemanticRange? optionalDescriptor = optionalBox.element.semanticRangeDescriptor();
		if (optionalDescriptor == null) { return NATIVE_UI_RANGE_ADJUST_NONE; }
		NativeUiSemanticRange descriptor = optionalDescriptor;
		bool decrement = (descriptor.axis() == NATIVE_UI_RANGE_HORIZONTAL && keyboard.key == APP_KEY_LEFT) || (descriptor.axis() == NATIVE_UI_RANGE_VERTICAL && keyboard.key == APP_KEY_DOWN);
		bool increment = (descriptor.axis() == NATIVE_UI_RANGE_HORIZONTAL && keyboard.key == APP_KEY_RIGHT) || (descriptor.axis() == NATIVE_UI_RANGE_VERTICAL && keyboard.key == APP_KEY_UP);
		if (!decrement && !increment) { return NATIVE_UI_RANGE_ADJUST_NONE; }
		if (keyboard.modifiers.control || keyboard.modifiers.command) {
			return decrement ? NATIVE_UI_RANGE_ADJUST_MINIMUM : NATIVE_UI_RANGE_ADJUST_MAXIMUM;
		}
		if (keyboard.modifiers.shift) {
			return decrement ? NATIVE_UI_RANGE_ADJUST_LARGE_DECREMENT : NATIVE_UI_RANGE_ADJUST_LARGE_INCREMENT;
		}
		return decrement ? NATIVE_UI_RANGE_ADJUST_SMALL_DECREMENT : NATIVE_UI_RANGE_ADJUST_SMALL_INCREMENT;
	}

	private NativeUiEventBatch editText(NativeUiTextEditAction action) {
		self.renderer.closeTextMenu();
		if (!self.renderer.editingText()) { return self.noEvents(); }
		if (action == NATIVE_UI_TEXT_EDIT_SELECT_ALL) { return self.renderer.selectAllText(); }
		if (action == NATIVE_UI_TEXT_EDIT_CUT || action == NATIVE_UI_TEXT_EDIT_COPY) {
			string selected = self.renderer.selectedText();
			if (selected.isEmpty() || self.window.setClipboardText(selected) != null) { return self.noEvents(); }
			return action == NATIVE_UI_TEXT_EDIT_CUT ? self.renderer.textEntered("") : self.noEvents();
		}
		if (action == NATIVE_UI_TEXT_EDIT_PASTE) {
			AppClipboardText clipboard = self.window.clipboardText();
			return clipboard.error == null ? self.renderer.textEntered(clipboard.text) : self.noEvents();
		}
		return self.noEvents();
	}

	public NativeUiEventBatch dispatch(AppWindowEvent event) {
		if (event == null) { return self.noEvents(); }
		if (event.kind == APP_EVENT_POINTER && event.pointer != null) {
			AppPointerEvent pointer = event.pointer;
			int x = (int)pointer.logicalX;
			int y = (int)pointer.logicalY;
			if (pointer.button == APP_POINTER_BUTTON_BACK || pointer.button == APP_POINTER_BUTTON_FORWARD) {
				if (pointer.action != APP_POINTER_PRESSED) { return self.noEvents(); }
				NativeUiEventBatch cancelled = self.renderer.pointerCancelled();
				self.renderer.blur();
				cancelled.events.push(NativeUiEvent.navigate(pointer.button == APP_POINTER_BUTTON_FORWARD));
				return NativeUiEventBatch(self.renderer.currentFrame(), cancelled.events);
			}
			if (pointer.action == APP_POINTER_MOVED) {
				return self.renderer.pointerMoved(x, y);
			}
			if ((pointer.button == APP_POINTER_BUTTON_SECONDARY || (pointer.button == APP_POINTER_BUTTON_PRIMARY && pointer.modifiers.control)) && pointer.action == APP_POINTER_PRESSED) {
				AppClipboardText clipboard = self.window.clipboardText();
				return self.renderer.openTextMenu(x, y, clipboard.error == null && !clipboard.text.isEmpty());
			}
			if (pointer.button == APP_POINTER_BUTTON_PRIMARY && pointer.action == APP_POINTER_PRESSED) {
				return self.renderer.pointerPressed(x, y, pointer.modifiers.shift, pointer.clickCount);
			}
			if (pointer.button == APP_POINTER_BUTTON_PRIMARY && pointer.action == APP_POINTER_RELEASED) {
				if (pointer.modifiers.control) { return self.noEvents(); }
				if (self.renderer.textMenu() != null) { return self.editText(self.renderer.releaseTextMenu(x, y)); }
				return self.renderer.pointerReleased(x, y);
			}
			return self.noEvents();
		}
		if (event.kind == APP_EVENT_SCROLLED && event.scroll != null) {
			AppScrollEvent scroll = event.scroll;
			return self.renderer.wheelBy((int)(-scroll.deltaX * 40.0f), (int)(-scroll.deltaY * 40.0f));
		}
		if (event.kind == APP_EVENT_TEXT) {
			if (self.renderer.textMenu() != null) { return self.noEvents(); }
			return self.renderer.textEntered(event.text);
		}
		if (event.kind == APP_EVENT_KEYBOARD && event.keyboard != null) {
			AppKeyboardEvent keyboard = event.keyboard;
			bool active = keyboard.action == APP_KEY_PRESSED || keyboard.action == APP_KEY_REPEATED;
			if (!active) { return self.noEvents(); }
			NativeUiTextMenu? menu = self.renderer.textMenu();
			if (menu != null) {
				if (keyboard.key == APP_KEY_ESCAPE) { return self.renderer.dismiss(); }
				if (keyboard.key == APP_KEY_UP || keyboard.key == APP_KEY_DOWN) { return self.renderer.navigateTextMenu(keyboard.key == APP_KEY_UP ? -1 : 1); }
				if (keyboard.key == APP_KEY_ENTER || keyboard.key == APP_KEY_SPACE) { return menu.enabled(menu.highlighted) ? self.editText((NativeUiTextEditAction)menu.highlighted) : self.noEvents(); }
				self.renderer.closeTextMenu();
			}
			if (self.renderer.editingText()) {
				bool shortcut = keyboard.modifiers.command || keyboard.modifiers.control;
				bool word = keyboard.modifiers.alt || keyboard.modifiers.control;
				bool line = keyboard.modifiers.command;
				if (shortcut && keyboard.key == APP_KEY_A) { return self.editText(NATIVE_UI_TEXT_EDIT_SELECT_ALL); }
				if (shortcut && keyboard.key == APP_KEY_C) { return self.editText(NATIVE_UI_TEXT_EDIT_COPY); }
				if (shortcut && keyboard.key == APP_KEY_X) { return self.editText(NATIVE_UI_TEXT_EDIT_CUT); }
				if (shortcut && keyboard.key == APP_KEY_V) { return self.editText(NATIVE_UI_TEXT_EDIT_PASTE); }
				if (keyboard.key == APP_KEY_BACKSPACE) { return self.renderer.backspace(word, line); }
				if (keyboard.key == APP_KEY_DELETE) { return self.renderer.deleteForward(word, line); }
				if (keyboard.key == APP_KEY_LEFT || keyboard.key == APP_KEY_HOME) { return self.renderer.moveCaretLeft(keyboard.modifiers.shift, word, line || keyboard.key == APP_KEY_HOME); }
				if (keyboard.key == APP_KEY_RIGHT || keyboard.key == APP_KEY_END) { return self.renderer.moveCaretRight(keyboard.modifiers.shift, word, line || keyboard.key == APP_KEY_END); }
			}
			NativeUiRangeAdjustment adjustment = self.rangeAdjustment(keyboard);
			if (adjustment != NATIVE_UI_RANGE_ADJUST_NONE) {
				return self.renderer.adjustFocusedRange(adjustment);
			}
			if (keyboard.key == APP_KEY_UP) {
				return self.renderer.navigateFocusedSelect(-1);
			}
			if (keyboard.key == APP_KEY_DOWN) {
				return self.renderer.navigateFocusedSelect(1);
			}
			if (keyboard.key == APP_KEY_BACKSPACE) {
				return self.renderer.backspace();
			}
			if (keyboard.key == APP_KEY_LEFT) {
				return self.renderer.moveCaretLeft();
			}
			if (keyboard.key == APP_KEY_RIGHT) {
				return self.renderer.moveCaretRight();
			}
			if (keyboard.key == APP_KEY_TAB && keyboard.action == APP_KEY_PRESSED) {
				return self.renderer.focusNext(keyboard.modifiers.shift);
			}
			if ((keyboard.key == APP_KEY_ENTER || keyboard.key == APP_KEY_SPACE) && keyboard.action == APP_KEY_PRESSED) {
				return self.renderer.activate(self.renderer.focusedId());
			}
			if (keyboard.key == APP_KEY_ESCAPE && keyboard.action == APP_KEY_PRESSED) {
				return self.renderer.dismiss();
			}
			return self.noEvents();
		}
		if ((event.kind == APP_EVENT_RESIZED || event.kind == APP_EVENT_DPI_CHANGED) && event.surface != null) {
			AppSurfaceMetrics metrics = event.surface;
			return self.renderer.viewportChanged(metrics.logicalWidth, metrics.logicalHeight);
		}
		if (event.kind == APP_EVENT_CLOSE_REQUESTED || event.kind == APP_EVENT_CLOSED || event.kind == APP_EVENT_FAILED) {
			return self.renderer.pointerCancelled();
		}
		if (event.kind == APP_EVENT_FOCUS_LOST) { self.renderer.pointerCancelled(); return self.renderer.blur(); }
		return self.noEvents();
	}

	public GPUCloseOutcome close() {
		self.prepared = false;
		if (self.compositorIdentity == 0ULL) {
			return GPUCloseOutcome(GPU_ALREADY_CLOSED, "");
		}
		int status = std_gpu_native_ui_destroy(self.compositorIdentity, self.ownerReceipt);
		if (status != GPU_CLOSED) {
			return GPUCloseOutcome(GPU_CLOSE_REJECTED, std_gpu_status_message(status));
		}
		self.compositorIdentity = 0ULL;
		self.ownerReceipt = 0ULL;
		return GPUCloseOutcome(GPU_CLOSED, "");
	}

	public void __del__() {
		if (self.compositorIdentity != 0ULL && self.ownerReceipt != 0ULL) {
			std_gpu_native_ui_finalize(self.compositorIdentity, self.ownerReceipt);
		}
	}
}
