/* Linux peer credentials: SO_PEERCRED reports the peer's credentials as of
 * connect() or socketpair(). */
#include <errno.h>
#include <sys/socket.h>
#include <sys/types.h>

class LocalPeerCredentialsProvider {
	class int peerUser(int descriptor, uid_t* user) {
		struct ucred credentials;
		socklen_t size = sizeof(credentials);
		if (getsockopt(descriptor, SOL_SOCKET, SO_PEERCRED, &credentials, &size) != 0) { return -1; }
		if ((size_t)size != sizeof(credentials)) {
			errno = EIO;
			return -1;
		}
		*user = credentials.uid;
		return 0;
	}
}
