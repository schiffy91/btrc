/* The user a connected local socket's peer runs as. `[[package.providers]]`
 * selects the SDK call: getpeereid on macOS, getsockopt(SO_PEERCRED) on
 * Linux. A Windows provider arrives with Windows channel support. */
class LocalPeerCredentials {
	/* 0 with `user` set, or -1 with errno set. The descriptor stays the
	 * caller's. */
	class int peerUser(int descriptor, uid_t* user) { return LocalPeerCredentialsProvider.peerUser(descriptor, user); }
}
