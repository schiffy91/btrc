/* Console password input on Windows.
 *
 * A prompt on a console is a serialized session: it saves the input mode,
 * clears ENABLE_ECHO_INPUT while keeping ENABLE_LINE_INPUT and
 * ENABLE_PROCESSED_INPUT, reads one line with ReadConsoleW and restores the
 * saved mode on success, overflow, failure and interruption alike. The
 * 4096-byte limit and the empty result for a longer line match Unix, and no
 * input is ever echoed or logged.
 *
 * Ctrl-C. Windows has no signal to replay, so the order differs from Unix,
 * where the prompt restores the terminal first and then raises the signal
 * under the caller's disposition. Here Windows starts a thread that calls the
 * console control handlers, most recently registered first, while the
 * pending ReadConsoleW completes with no characters and
 * ERROR_OPERATION_ABORTED. That read is an interruption: the prompt restores
 * the mode and returns "". The control handler below must run before any
 * other, so that the mode is back before a caller's handler or Windows'
 * default ExitProcess sees the event; each prompt therefore re-registers it
 * at its start, which moves it to the front of the list even when the caller
 * registered handlers after an earlier prompt. The handler restores the
 * saved mode itself, under the session lock, cancels a read the event did
 * not end (Ctrl-Break, closing the console), and returns FALSE so the chain
 * continues: a caller's handler that returns TRUE lets the program go on and
 * the prompt return "", and otherwise the default handler ends the process
 * with the echo already restored. It never allocates, throws or calls
 * user code, it stays registered for the life of the process, and it never
 * generates or rebroadcasts an event.
 *
 * Every field the handler and the prompt share is guarded by one SRW lock.
 * A handler that must cancel a read pins the session and holds the duplicated
 * thread handle only while pinned; the prompt detaches the session, waits for
 * the pins to drain, and only then closes that handle and lets another prompt
 * start, so a late or repeated Ctrl-C never touches a finished session.
 * Failing to restore the mode is fatal: the process stops rather than return
 * with the console's echo off.
 *
 * Redirected input (a pipe or a file) has no echo to hide and is read with
 * the same bounds as on Unix. */

import Library.Bytes;
import Library.Terminal.Windows.ConsoleInput;

#include <stdio.h>
#include <stdlib.h>

/* The state one console password session shares with the control handler,
 * kept for the life of the process. */
struct TerminalConsoleSession {
	SRWLOCK lock;
	/* A prompt has hidden the echo on `input`. */
	int active;
	/* A control event arrived during the session. */
	int interrupted;
	/* 0 while `saved` is not back on `input`, 1 once it is, -1 if the
	 * handler's restore failed. */
	int restored;
	/* The prompt's thread is inside, or about to enter, ReadConsoleW. */
	int reading;
	/* Control handlers still using `reader`. */
	int pins;
	/* Distinguishes this session from the next one. */
	unsigned int generation;
	HANDLE input;
	/* The prompt's thread, for CancelSynchronousIo. */
	HANDLE reader;
	DWORD saved;
};

TerminalConsoleSession* terminalConsoleSession() {
	static TerminalConsoleSession session;
	return &session;
}

/* The console control handler. Windows calls it on a thread of its own. */
BOOL terminalConsoleControl(DWORD event) {
	TerminalConsoleSession* session = terminalConsoleSession();
	AcquireSRWLockExclusive(&session->lock);
	bool pinned = session->active != 0;
	unsigned int generation = session->generation;
	HANDLE reader = session->reader;
	if (pinned) {
		session->interrupted = 1;
		if (session->restored == 0) { session->restored = SetConsoleMode(session->input, session->saved) != 0 ? 1 : -1; }
		session->pins = session->pins + 1;
	}
	ReleaseSRWLockExclusive(&session->lock);
	if (!pinned) { return FALSE; }
	/* Ctrl-C ends the read itself; Ctrl-Break and a closing console may not.
	 * Cancel until the prompt's thread is out of ReadConsoleW, retrying in
	 * case it was between its check and the call: at most about a second. */
	for (int attempt = 0; attempt < 200; attempt++) {
		AcquireSRWLockExclusive(&session->lock);
		bool waiting = session->generation == generation && session->reading != 0;
		ReleaseSRWLockExclusive(&session->lock);
		if (!waiting) { break; }
		CancelSynchronousIo(reader);
		Sleep((DWORD)5);
	}
	AcquireSRWLockExclusive(&session->lock);
	session->pins = session->pins - 1;
	ReleaseSRWLockExclusive(&session->lock);
	return FALSE;
}

/* Admits each ReadConsoleW of a session that no control event has ended. */
class TerminalConsoleSessionGate implements IConsoleReadGate {
	public bool enterRead() {
		TerminalConsoleSession* session = terminalConsoleSession();
		AcquireSRWLockExclusive(&session->lock);
		bool open = session->interrupted == 0;
		if (open) { session->reading = 1; }
		ReleaseSRWLockExclusive(&session->lock);
		return open;
	}

	public void leaveRead() {
		TerminalConsoleSession* session = terminalConsoleSession();
		AcquireSRWLockExclusive(&session->lock);
		session->reading = 0;
		ReleaseSRWLockExclusive(&session->lock);
	}
}

class TerminalPasswordInputProvider {
	/* The longest password a prompt accepts. A longer line is consumed to its
	 * end and rejected as empty rather than truncated into a different secret. */
	class int maxPasswordBytes() { return 4096; }

	/* Windows needs no signal self-pipe. */
	class int signalReadDescriptor() { return -1; }

	class int signalWriteDescriptor() { return -1; }

	class void showLabel(string label) {
		fprintf(stderr, "%s", label == null ? "" : label);
		fflush(stderr);
	}

	/* A pipe or a file: one bounded line, as on Unix. */
	class string readStream() {
		Bytes value = Bytes();
		bool overflowed = false;
		int limit = TerminalPasswordInputProvider.maxPasswordBytes();
		int byte = fgetc(stdin);
		while (byte != EOF && byte != '\n') {
			if (value.len < limit) {
				value.append(byte);
			} else {
				overflowed = true;
			}
			byte = fgetc(stdin);
		}
		clearerr(stdin);
		if (overflowed) { return ""; }
		return value.toStringLossy();
	}

	class void fail(string message) {
		fprintf(stderr, "TerminalPasswordInput: %s\n", message);
		fflush(stderr);
		abort();
	}

	class string readConsole(HANDLE input, string label) {
		DWORD saved = (DWORD)0;
		if (GetConsoleMode(input, &saved) == 0) {
			TerminalPasswordInputProvider.showLabel(label);
			return "";
		}
		/* First among the control handlers: see the file comment. */
		SetConsoleCtrlHandler(terminalConsoleControl, FALSE);
		if (SetConsoleCtrlHandler(terminalConsoleControl, TRUE) == 0) {
			TerminalPasswordInputProvider.showLabel(label);
			return "";
		}
		HANDLE process = GetCurrentProcess();
		HANDLE reader = null;
		if (DuplicateHandle(process, GetCurrentThread(), process, &reader, (DWORD)0, FALSE, (DWORD)DUPLICATE_SAME_ACCESS) == 0) {
			TerminalPasswordInputProvider.showLabel(label);
			return "";
		}
		DWORD hidden = (saved & ~(DWORD)ENABLE_ECHO_INPUT) | (DWORD)ENABLE_LINE_INPUT | (DWORD)ENABLE_PROCESSED_INPUT;

		/* Hide the echo and open the session in one step, so a control event
		 * sees either the saved mode or an open session that restores it. */
		TerminalConsoleSession* session = terminalConsoleSession();
		AcquireSRWLockExclusive(&session->lock);
		bool opened = SetConsoleMode(input, hidden) != 0;
		if (opened) {
			session->active = 1;
			session->interrupted = 0;
			session->restored = 0;
			session->reading = 0;
			session->generation = session->generation + (unsigned int)1;
			session->input = input;
			session->reader = reader;
			session->saved = saved;
		}
		ReleaseSRWLockExclusive(&session->lock);
		if (!opened) {
			CloseHandle(reader);
			TerminalPasswordInputProvider.showLabel(label);
			return "";
		}

		TerminalPasswordInputProvider.showLabel(label);
		ConsoleLine line = ConsoleInput.readLine(input, TerminalPasswordInputProvider.maxPasswordBytes(), TerminalConsoleSessionGate());

		/* Detach, restoring the mode unless the handler already did. */
		AcquireSRWLockExclusive(&session->lock);
		session->active = 0;
		if (session->restored == 0) { session->restored = SetConsoleMode(input, saved) != 0 ? 1 : -1; }
		bool restored = session->restored == 1;
		bool interrupted = session->interrupted != 0;
		ReleaseSRWLockExclusive(&session->lock);
		/* A handler still cancelling holds `reader`; it lets go within about a
		 * second. */
		while (true) {
			AcquireSRWLockExclusive(&session->lock);
			int pins = session->pins;
			ReleaseSRWLockExclusive(&session->lock);
			if (pins == 0) { break; }
			Sleep((DWORD)1);
		}
		CloseHandle(reader);
		if (!restored) {
			/* One more attempt before giving up. */
			if (SetConsoleMode(input, saved) == 0) { TerminalPasswordInputProvider.fail("the console's echo could not be restored"); }
		}
		if (interrupted || line.interrupted || line.overflowed || line.ended) { return ""; }
		return line.text;
	}

	class string prompt(string label) {
		_lock_file(stdin);
		string value = "";
		HANDLE console = ConsoleInput.standardInput();
		if (console == null) {
			TerminalPasswordInputProvider.showLabel(label);
			value = TerminalPasswordInputProvider.readStream();
		} else {
			value = TerminalPasswordInputProvider.readConsole(console, label);
		}
		fprintf(stderr, "\n");
		fflush(stderr);
		_unlock_file(stdin);
		return value;
	}
}
