/* btrc standard library — Unix terminal helpers */

import Library.Bytes;
import Library.Terminal.TerminalPassword;

#include <stdio.h>

class Terminal {
	/* One line from stdin without its newline. At most `maxBytes` bytes are
	 * kept; the rest of a longer line is consumed and dropped, so memory stays
	 * bounded and the next read starts on the following line. */
	class string readLine(int maxBytes = 1048576) {
		Bytes value = Bytes();
		int limit = maxBytes > 0 ? maxBytes : 0;
		int byte = fgetc(stdin);
		while (byte != EOF && byte != '\n') {
			if (value.len < limit) { value.append(byte); }
			byte = fgetc(stdin);
		}
		return value.toStringLossy();
	}

	class string prompt(string label) {
		fprintf(stderr, "%s", label == null ? "" : label);
		fflush(stderr);
		return Terminal.readLine();
	}

	class string promptPassword(string label) { return TerminalPasswordInput.prompt(label); }
}
