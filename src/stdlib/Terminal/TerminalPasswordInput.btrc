/* Interrupt-safe hidden password input.
 *
 * `[[package.providers]]` selects the host's session. On Unix
 * (Unix/TerminalPasswordInputProvider.btrc) termios hides the echo and a
 * signal self-pipe turns SIGINT, SIGTERM and SIGHUP into wakeups, replayed
 * under the caller's disposition once the terminal is restored. On Windows
 * (Windows/TerminalPasswordInputProvider.btrc) a console mode without
 * ENABLE_ECHO_INPUT hides it and a console control handler, registered ahead
 * of the caller's, restores the mode before any handler or the default
 * termination sees Ctrl-C. Redirected input is read the same bounded way on
 * both, and a prompt is never echoed or logged. */

class TerminalPasswordInput {
	/* The longest password a prompt accepts. A longer line is consumed to its
	 * end and rejected as empty rather than truncated into a different secret. */
	class int maxPasswordBytes() { return TerminalPasswordInputProvider.maxPasswordBytes(); }

	/* Show `label` on stderr and read one line from stdin without echoing
	 * it. An interrupted prompt returns "". */
	class string prompt(string label) { return TerminalPasswordInputProvider.prompt(label); }

	/* The Unix self-pipe's descriptors once a prompt has run, else -1;
	 * always -1 on Windows, whose console control handler needs none. */
	class int signalReadDescriptor() { return TerminalPasswordInputProvider.signalReadDescriptor(); }

	class int signalWriteDescriptor() { return TerminalPasswordInputProvider.signalWriteDescriptor(); }
}
