/* btrc standard library — exact borrowed/owned callback closures and registration gate
 *
 * CFunction<...> is one noncapturing C function-pointer word. BorrowedClosure
 * names the non-owning invoke/context pair passed through managed interfaces.
 * OwnedClosure adds the context's one terminal destroy operation.
 * CallbackRegistration adds the admission, unregister, in-flight drain, and
 * destruction order required by C APIs that store that pair.
 *
 * Invoke is intentionally the complete trampoline signature, including its
 * void* context parameter.  Callers extract both values and pass the context
 * at the position required by that C API; no hidden ABI rewriting occurs.
 */

import Library.OwnedBuffer;
import Library.Vector;

#include <pthread.h>

/* A typed, non-owning callback lease. The producer owns the context and must
 * keep it alive until every consumer-specific stop or unregister barrier has
 * drained. Native/package seams may extract the exact pair; product interfaces
 * should pass this object without unpacking and repacking it. */
class BorrowedClosure<Invoke> {
	private Invoke _invoke;
	private void* _context;

	public BorrowedClosure(Invoke invoke, void* context) {
		if (invoke == (Invoke)null) {
			fprintf(stderr, "BorrowedClosure requires a nonnull invoke callback\n");
			abort();
		}
		self._invoke = invoke;
		self._context = context;
	}

	public Invoke invokePointer() { return self._invoke; }

	public void* context() { return self._context; }
}

/* The low bit closes admission; every admitted callback owns two units. A
 * bounded CAS loop makes successful entry its own linearization point and
 * fails closed on saturation instead of allowing uint wrap to reopen the gate.
 * Contention exhaustion may conservatively drop one callback. These two
 * operations are the only gate surface used by a stored callback trampoline. */
@realtime bool callbackGateTryEnter(Atomic<uint>* state) {
	if (state == null) { return false; }
	uint observed = state->load(MemoryOrder.ACQUIRE);
	for (uint attempt = 0u; attempt < 64u; attempt++) {
		if ((observed & 1u) != 0u || observed >= 4294967294u) {
			return false;
		}
		uint desired = observed + 2u;
		if (state->compareExchangeStrong(&observed, desired, MemoryOrder.ACQ_REL, MemoryOrder.ACQUIRE)) {
			return true;
		}
	}
	return false;
}

@realtime void callbackGateLeave(Atomic<uint>* state) {
	if (state == null) { return; }
	state->fetchSub(2u, MemoryOrder.RELEASE);
}

void callbackGateCloseAdmission(Atomic<uint>* state) { state->fetchOr(1u, MemoryOrder.ACQ_REL); }

void callbackGateDrain(Atomic<uint>* state) {
	while (state->load(MemoryOrder.ACQUIRE) != 1u) {}
}

/* Internal context protocol: registration owns this object until the native
 * entry barrier and admitted calls have drained. Managed implementations keep
 * their receivers in ordinary fields visible to BTRC's cycle collector. */
interface ICallbackContext {
	bool unregister();
	bool close();
}

class OwnedClosure<Invoke> implements ICallbackContext {
	private Invoke _invoke;
	private void* _context;
	private CFunction<void, void*> _destroy;
	private CFunction<bool, void*> _unregister;
	private void* _unregisterContext;
	private Atomic<uint> _state;
	private Atomic<bool> _closingThreadReady;
	private pthread_t _closingThread;

	public OwnedClosure(Invoke invoke, void* context, CFunction<void, void*> destroy, CFunction<bool, void*> unregister = (CFunction<bool, void*>)null, void* unregisterContext = null) {
		if (invoke == (Invoke)null) {
			fprintf(stderr, "OwnedClosure requires a nonnull invoke callback\n");
			abort();
		}
		if (destroy == null) {
			fprintf(stderr, "OwnedClosure requires a destroy callback\n");
			abort();
		}
		self._invoke = invoke;
		self._context = context;
		self._destroy = destroy;
		self._unregister = unregister;
		self._unregisterContext = unregisterContext;
		self._state.init(0u);
		self._closingThreadReady.init(false);
	}

	public Invoke invokePointer() { return self._invoke; }

	public void* context() { return self._context; }

	public bool isOpen() { return self._state.load(MemoryOrder.ACQUIRE) == 0u; }

	public bool unregister() {
		if (self._unregister == null) { throw "OwnedClosure has no native unregister operation"; }
		return self._unregister(self._unregisterContext);
	}

	private uint beginClose() {
		uint expected = 0u;
		if (self._state.compareExchangeStrong(&expected, 1u, MemoryOrder.ACQ_REL, MemoryOrder.ACQUIRE)) {
			return 0u;
		}
		return expected;
	}

	public bool close() {
		uint observed = self.beginClose();
		if (observed != 0u) {
			if (observed == 1u) {
				while (!self._closingThreadReady.load(MemoryOrder.ACQUIRE)) {
					if (self._state.load(MemoryOrder.ACQUIRE) != 1u) {
						return self._state.load(MemoryOrder.ACQUIRE) == 2u;
					}
				}
				if (pthread_equal(self._closingThread, pthread_self()) != 0) {
					fprintf(stderr, "OwnedClosure.close cannot re-enter its destroy callback\n");
					abort();
				}
				while (self._state.load(MemoryOrder.ACQUIRE) == 1u) {}
			}
			return self._state.load(MemoryOrder.ACQUIRE) == 2u;
		}

		self._closingThread = pthread_self();
		self._closingThreadReady.store(true, MemoryOrder.RELEASE);
		void* context = self._context;
		self._context = null;
		bool destroyed = false;
		try {
			self._destroy(context);
			destroyed = true;
		} finally {
			self._state.store(destroyed ? 2u : 4u, MemoryOrder.RELEASE);
			self._closingThreadReady.store(false, MemoryOrder.RELEASE);
		}
		return destroyed;
	}

	public void __del__() {
		if (!self.close()) {
			fprintf(stderr, "OwnedClosure destroy did not complete\n");
			abort();
		}
	}
}

enum CallbackCancellation { NotRequested, Pending, Complete, RetryableFailure, Failed };

interface ICallbackRegistration {
	bool isOpen();
	CallbackCancellation cancel();
	CallbackCancellation pollCompletion();
}

/* Shared state for one stored callback registration. `unregister` must provide an entry
 * barrier: when it returns, no callback can later execute its first gate
 * atomic unless that callback already published an in-flight count. This is
 * stronger than merely promising that no new callback will be scheduled.
 *
 * Activation initializes every lifetime guard before native publication.
 * finishActivation(false) is valid only when nothing was published. The owning
 * component scope must cancel before releasing a cyclic context: collection
 * detaches managed fields before user destructors, so a receiver destructor is
 * not a replacement for scope-owned cancellation.
 *
 * cancel/pollCompletion never wait for admitted callbacks. For executor use,
 * unregister must itself be a nonblocking entry barrier and destroy must be
 * bounded; these methods cannot make a blocking foreign operation asynchronous.
 * Keep the registration in its component scope until completion, polling on
 * the required cleanup executor. close/destruction remain blocking worker APIs.
 * A false/throwing unregister promises that retry is safe, with context intact.
 * APIs with indeterminate failure or asynchronous unregister need a different
 * checked mapping, not an adapter that reports a premature successful barrier.
 */
class CallbackState implements ICallbackRegistration {
	private ICallbackContext _context;
	private AtomicBuffer<uint> _gateState;
	private Atomic<uint> _state;
	private pthread_mutex_t _closingThreadMutex;
	private bool _closingThreadReady;
	private pthread_t _closingThread;

	public CallbackState(ICallbackContext context) {
		self._context = context;
		self._gateState = new AtomicBuffer<uint>((size_t)1);
		if (!self._gateState.opened()) { throw "CallbackRegistration cannot allocate its gate"; }
		self._gateState.borrow()->init(0u);
		self._state.init(6u);
		self._closingThread = pthread_self();
		self._closingThreadReady = true;
		if (pthread_mutex_init(&self._closingThreadMutex, null) != 0) {
			fprintf(stderr, "CallbackRegistration cannot initialize its operation guard\n");
			abort();
		}
	}

	/* Activation owns the sole publication path. Cancellation during an inline
	 * callback closes admission immediately and defers unregister until native
	 * activation has returned. Existing stable atomic storage owns the native
	 * borrow until the entry barrier and every admitted callback have drained. */
	public Atomic<uint>* activationGate() { return self._gateState.borrow(); }

	public void finishActivation(bool published) {
		if (self._state.load(MemoryOrder.ACQUIRE) != 6u) { throw "Callback activation already finished"; }
		if (published) {
			self.endOperation(0u);
			if ((self._gateState.borrow()->load(MemoryOrder.ACQUIRE) & 1u) != 0u) { self.cancel(); }
			return;
		}
		callbackGateCloseAdmission(self._gateState.borrow());
		if (self._gateState.borrow()->load(MemoryOrder.ACQUIRE) != 1u) {
			throw "Unpublished callback activation still has admitted calls";
		}
		self._state.store(1u, MemoryOrder.RELEASE);
		bool destroyed = false;
		try {
			destroyed = self._context.close();
			if (destroyed) { self._context = null; }
		}
		finally { self.endOperation(destroyed ? 2u : 4u); }
	}

	public bool isOpen() { return self._state.load(MemoryOrder.ACQUIRE) == 0u; }

	private bool claimOperation(uint observed) { return self._state.compareExchangeStrong(&observed, 1u, MemoryOrder.ACQ_REL, MemoryOrder.ACQUIRE); }

	/* Only thread identity is protected here. Never hold this guard across an
	 * adapter call or drain: reentrant cancellation must be able to return. */
	private void beginOperation() {
		pthread_mutex_lock(&self._closingThreadMutex);
		self._closingThread = pthread_self();
		self._closingThreadReady = true;
		pthread_mutex_unlock(&self._closingThreadMutex);
	}

	private void endOperation(uint state) {
		pthread_mutex_lock(&self._closingThreadMutex);
		self._closingThreadReady = false;
		self._state.store(state, MemoryOrder.RELEASE);
		pthread_mutex_unlock(&self._closingThreadMutex);
	}

	private void rejectReentrantClose() {
		pthread_mutex_lock(&self._closingThreadMutex);
		bool reentrant = self._closingThreadReady && pthread_equal(self._closingThread, pthread_self()) != 0;
		pthread_mutex_unlock(&self._closingThreadMutex);
		if (reentrant) {
			fprintf(stderr, "CallbackRegistration.close cannot re-enter unregister or destroy\n");
			abort();
		}
	}

	public CallbackCancellation cancel() {
		uint observed = self._state.load(MemoryOrder.ACQUIRE);
		if (observed != 2u && observed != 4u) { callbackGateCloseAdmission(self._gateState.borrow()); }
		observed = self._state.load(MemoryOrder.ACQUIRE);
		if (observed != 0u && observed != 3u) { return self.pollCompletion(); }
		if (!self.claimOperation(observed)) { return CallbackCancellation.Pending; }
		self.beginOperation();
		bool barrier = false;
		try {
			barrier = self._context.unregister();
		} finally {
			self.endOperation(barrier ? 5u : 3u);
		}
		if (!barrier) { return CallbackCancellation.RetryableFailure; }
		return self.pollCompletion();
	}

	public CallbackCancellation pollCompletion() {
		uint observed = self._state.load(MemoryOrder.ACQUIRE);
		if (observed == 0u) { return CallbackCancellation.NotRequested; }
		if (observed == 2u) { return CallbackCancellation.Complete; }
		if (observed == 3u) { return CallbackCancellation.RetryableFailure; }
		if (observed == 4u) { return CallbackCancellation.Failed; }
		if (observed != 5u || self._gateState.borrow()->load(MemoryOrder.ACQUIRE) != 1u) { return CallbackCancellation.Pending; }
		if (!self.claimOperation(observed)) { return CallbackCancellation.Pending; }
		self.beginOperation();
		bool destroyed = false;
		try {
			destroyed = self._context.close();
			// Break the terminal context/backreference cycle on the cleanup
			// executor, not during a later collection on an unrelated worker.
			if (destroyed) { self._context = null; }
		} finally {
			self.endOperation(destroyed ? 2u : 4u);
		}
		return destroyed ? CallbackCancellation.Complete : CallbackCancellation.Failed;
	}

	public bool close() {
		CallbackCancellation result = self.cancel();
		while (result == CallbackCancellation.Pending) {
			self.rejectReentrantClose();
			result = self.pollCompletion();
		}
		return result == CallbackCancellation.Complete;
	}

	public void __del__() {
		uint observed = self._state.load(MemoryOrder.ACQUIRE);
		if (observed != 2u && observed != 4u && (self._context == null || self._gateState == null)) {
			fprintf(stderr, "CallbackRegistration collected before its owning scope cancelled it\n");
			abort();
		}
		if (!self.close()) {
			fprintf(stderr, "CallbackRegistration destruction did not complete\n");
			abort();
		}
		pthread_mutex_destroy(&self._closingThreadMutex);
	}
}

/* Application/component cancellation owner. Create here before native
 * publication. track() retains an existing cancellation owner without copying
 * its state or changing its native identity. Aliases join the same cancellation.
 * The application keeps this owner alive until pendingCount reaches zero.
 * cancel/pollCompletion never call the blocking CallbackState.close path.
 * An independent application/component must own cancellation; a captured
 * receiver cannot be its sole lifecycle owner. Generated bindings still need
 * to enforce that boundary. */
class CallbackScope implements ICallbackRegistration {
	private Vector<ICallbackRegistration> _registrations = [];
	private pthread_t _executor;
	private bool _closing = false;
	private bool _dispatching = false;
	private int _retained = 0;

	public CallbackScope() { self._executor = pthread_self(); }

	private void requireExecutor() {
		if (pthread_equal(self._executor, pthread_self()) == 0) { throw "Callback scope requires its creating thread"; }
	}

	private void requireAdmission() {
		self.requireExecutor();
		if (self._closing) { throw "Callback scope is closing"; }
		if (self._dispatching) { throw "Callback scope is dispatching cancellation"; }
	}

	public void track(ICallbackRegistration registration) {
		self.requireAdmission();
		ICallbackRegistration owner = self;
		if (registration == null || registration == owner) { throw "Callback scope requires an independent cancellation owner"; }
		for entry in self._registrations { if (entry == registration) { throw "Callback owner is already tracked"; } }
		self._registrations.push(registration);
		self._retained++;
	}

	public CallbackState create(ICallbackContext context) {
		self.requireAdmission();
		if (context == null) { throw "Callback scope requires a context"; }
		var registration = CallbackState(context);
		self._registrations.push(registration);
		self._retained++;
		return registration;
	}

	public bool isOpen() { self.requireExecutor(); return !self._closing; }

	public int pendingCount() { self.requireExecutor(); return self._retained; }

	private CallbackCancellation advance(bool cancel) {
		self.requireExecutor();
		if (cancel) { self._closing = true; }
		if (self._dispatching) { return CallbackCancellation.Pending; }
		self._dispatching = true;
		CallbackCancellation result = CallbackCancellation.Complete;
		string firstError = "";
		bool raised = false;
		try {
			int index = 0;
			while (index < self._registrations.len) {
				var registration = self._registrations.get(index);
				CallbackCancellation status = CallbackCancellation.Pending;
				try {
					status = cancel ? registration.cancel() : registration.pollCompletion();
					if (self._closing && status == CallbackCancellation.NotRequested) { status = registration.cancel(); }
				}
				catch (string error) {
					if (!raised) { firstError = error; raised = true; }
					try { status = registration.pollCompletion(); }
					catch (string unavailable) { status = CallbackCancellation.Pending; }
				}
				if (status == CallbackCancellation.Complete) {
					self._registrations.remove(index);
					self._retained--;
					continue;
				}
				if (status == CallbackCancellation.Failed) { result = status; }
				else if (result != CallbackCancellation.Failed) {
					if (status == CallbackCancellation.RetryableFailure) { result = status; }
					else if (result != CallbackCancellation.RetryableFailure) { result = CallbackCancellation.Pending; }
				}
				index++;
			}
		} finally { self._dispatching = false; }
		if (raised) { throw firstError; }
		return self._closing ? result : CallbackCancellation.NotRequested;
	}

	public CallbackCancellation cancel() { return self.advance(true); }

	public CallbackCancellation pollCompletion() { return self.advance(false); }

	public void __del__() {
		if (pthread_equal(self._executor, pthread_self()) == 0) {
			fprintf(stderr, "Callback scope destruction requires its creating thread\n");
			abort();
		}
		if (self._retained == 0) { return; }
		/* The scalar count survives cycle-edge detachment; an abandoned owning
		 * cycle must not masquerade as an empty, successfully drained scope. */
		if (self._registrations == null || self._registrations.len != self._retained) {
			fprintf(stderr, "Callback scope collected before independent cancellation\n");
			abort();
		}
		CallbackCancellation result = CallbackCancellation.Failed;
		try { result = self.cancel(); }
		catch (string error) { fprintf(stderr, "Callback scope cancellation failed: %s\n", error); }
		if (result != CallbackCancellation.Complete) {
			fprintf(stderr, "Callback scope released before cancellation completed\n");
			abort();
		}
	}
}

/* Internal cancellation identity for APIs that unregister through their source
 * object rather than through the returned token. Both claims use ordinary ARC. */
class CallbackToken<TSource, TValue> {
	private TSource _source;
	private TValue _value;
	public CallbackToken(TSource source) { self._source = source; }

	public void publish(TValue value) {
		if (self._value != (TValue)null || value == (TValue)null) { throw "Callback cancellation token cannot publish"; }
		self._value = value;
	}

	public TSource source() { return self._source; }

	public TValue value() { return self._value; }
}

/* Managed storage for generated caller-executor registrations. Receiver and
 * token remain ordinary ARC fields; only generated ABI thunks expose the
 * context to native code. Construction does not publish self. The binding
 * activates in an independent scope before calling the native factory, then
 * installs its token before completing activation (which may cancel inline).
 * This is not a realtime context and does not establish native retention by
 * itself: the adapter must hold a normal external ARC claim until release. */
class CallbackContext<TReceiver, TToken> implements ICallbackContext, ICallbackRegistration {
	private TReceiver? _receiver;
	private TToken _token;
	private CFunction<bool, TToken> _unregister;
	private CallbackState _registration;
	private pthread_t _executor;
	private bool _activated = false;
	private bool _published = false;
	private bool _barrier = false;
	private bool _closed = false;
	private bool _cleaned = false;

	public CallbackContext(TReceiver receiver, CFunction<bool, TToken> unregister) {
		self._executor = pthread_self();
		if (receiver == (TReceiver)null || unregister == null) { throw "Callback context requires a receiver and unregister operation"; }
		self._receiver = receiver;
		self._unregister = unregister;
	}

	private void requireExecutor() {
		if (pthread_equal(self._executor, pthread_self()) == 0) { throw "Callback context requires its creating thread"; }
	}

	public void activate(CallbackScope scope) {
		self.requireExecutor();
		if (self._activated || self._closed) { throw "Callback context activation already started"; }
		self._registration = scope.create(self);
		self._activated = true;
	}

	public void publish(TToken token) {
		self.requireExecutor();
		if (!self._activated || self._published || self._closed || self._barrier) { throw "Callback context cannot publish"; }
		if (token == (TToken)null) { throw "Callback context requires a cancellation token"; }
		self._token = token;
		self._published = true;
		self._registration.finishActivation(true);
	}

	public void abortActivation() {
		self.requireExecutor();
		if (!self._activated || self._published || self._closed) { throw "Callback context cannot abort activation"; }
		self._barrier = true;
		self._registration.finishActivation(false);
	}

	public TReceiver? enter() {
		self.requireExecutor();
		if (!self._activated || self._closed || !callbackGateTryEnter(self._registration.activationGate())) { return null; }
		return self._receiver;
	}

	public void leave() {
		self.requireExecutor();
		if (!self._activated || self._closed || self._registration.activationGate()->load(MemoryOrder.ACQUIRE) < 2u) {
			throw "Callback context has no admitted call";
		}
		callbackGateLeave(self._registration.activationGate());
	}

	public bool isOpen() { self.requireExecutor(); return self._activated && self._registration.isOpen(); }

	public CallbackCancellation cancel() {
		self.requireExecutor();
		if (!self._activated) { throw "Callback context is not activated"; }
		return self._registration.cancel();
	}

	public CallbackCancellation pollCompletion() {
		self.requireExecutor();
		if (!self._activated) { throw "Callback context is not activated"; }
		return self._registration.pollCompletion();
	}

	public bool unregister() {
		self.requireExecutor();
		if (self._barrier) { return true; }
		if (!self._published || self._closed || (self._registration.activationGate()->load(MemoryOrder.ACQUIRE) & 1u) == 0u) {
			throw "Callback context must cancel before unregistering";
		}
		self._barrier = self._unregister(self._token);
		return self._barrier;
	}

	public bool close() {
		self.requireExecutor();
		if (self._closed) { return self._cleaned; }
		if (self._activated && (!self._barrier || self._registration.activationGate()->load(MemoryOrder.ACQUIRE) != 1u)) {
			throw "Callback context must unregister and drain before closing";
		}
		self._closed = true;
		try { self._receiver = null; }
		finally { self._token = (TToken)null; }
		self._cleaned = true;
		return true;
	}

	public void __del__() {
		if (pthread_equal(self._executor, pthread_self()) == 0) {
			fprintf(stderr, "Callback context destruction requires its creating thread\n");
			abort();
		}
		if (self._activated && !self._cleaned) {
			fprintf(stderr, "Callback context released before cancellation completed\n");
			abort();
		}
	}
}

/* One-shot caller-executor context for generated adapters. The native request
 * owns one gate admission from activation through terminal completion. Consumer
 * cancellation closes admission but cannot revoke that outstanding native lease.
 * There is no synthetic native token or unregister operation. The copied native
 * holder must additionally retain this ordinary managed object until release.
 * A callback-completion binding promises exactly one terminal callback; a timeout
 * or native block disposal is not completion. */
/* A native value and its request need owning storage; language tuples are
 * shallow borrowed aggregates. All ownership here is ordinary class-field ARC. */
class CallbackResult<TValue, TRequest> {
	public TValue value;
	public TRequest request;
	public CallbackResult(TRequest request) { self.request = request; }
}

class CallbackRequest<TReceiver> implements ICallbackContext, ICallbackRegistration {
	private TReceiver? _receiver;
	private CallbackState _registration;
	private pthread_t _executor;
	private bool _activated = false;
	private bool _published = false;
	private bool _nativePending = false;
	private bool _delivered = false;
	private bool _entered = false;
	private bool _barrier = false;
	private bool _closed = false;
	private bool _cleaned = false;

	public CallbackRequest(TReceiver receiver) {
		self._executor = pthread_self();
		if (receiver == (TReceiver)null) { throw "Callback request requires a receiver"; }
		self._receiver = receiver;
	}

	private void requireExecutor() {
		if (pthread_equal(self._executor, pthread_self()) == 0) { throw "Callback request requires its creating thread"; }
	}

	public void activate(CallbackScope scope) {
		self.requireExecutor();
		if (self._activated || self._closed) { throw "Callback request activation already started"; }
		self._registration = scope.create(self);
		self._activated = true;
		self._nativePending = callbackGateTryEnter(self._registration.activationGate());
		if (!self._nativePending) {
			self.abortActivation();
			throw "Callback request cannot acquire its native lease";
		}
	}

	public void publish() {
		self.requireExecutor();
		if (!self._activated || self._published || self._closed || self._barrier) { throw "Callback request cannot publish"; }
		self._published = true;
		self._registration.finishActivation(true);
	}

	private void finishNative() {
		self._nativePending = false;
		callbackGateLeave(self._registration.activationGate());
	}

	public void abortActivation() {
		self.requireExecutor();
		if (!self._activated || self._published || self._closed) { throw "Callback request cannot abort activation"; }
		self._barrier = true;
		if (self._nativePending) { self.finishNative(); }
		self._registration.finishActivation(false);
	}

	public TReceiver? enter() {
		self.requireExecutor();
		if (self._delivered) { throw "Callback request cannot deliver twice"; }
		if (!self._nativePending || self._closed) { return null; }
		self._delivered = true;
		self._entered = callbackGateTryEnter(self._registration.activationGate());
		return self._entered ? self._receiver : null;
	}

	public void leave() {
		self.requireExecutor();
		if (!self._entered) { throw "Callback request has no admitted call"; }
		self._entered = false;
		callbackGateLeave(self._registration.activationGate());
	}

	public CallbackCancellation complete() {
		self.requireExecutor();
		if (!self._nativePending || self._closed) { throw "Callback request has no outstanding native work"; }
		self.finishNative();
		return self._registration.cancel();
	}

	public bool isOpen() { self.requireExecutor(); return self._activated && self._registration.isOpen(); }

	public CallbackCancellation cancel() {
		self.requireExecutor();
		if (!self._activated) { throw "Callback request is not activated"; }
		return self._registration.cancel();
	}

	public CallbackCancellation pollCompletion() {
		self.requireExecutor();
		if (!self._activated) { throw "Callback request is not activated"; }
		return self._registration.pollCompletion();
	}

	public bool unregister() {
		self.requireExecutor();
		if (self._barrier) { return true; }
		if (!self._published || self._closed || (self._registration.activationGate()->load(MemoryOrder.ACQUIRE) & 1u) == 0u) {
			throw "Callback request must cancel before abandoning delivery";
		}
		/* Native entry is already protected by the outstanding admission, even
		 * before delivery begins. Shared drain cannot finish until complete(). */
		self._barrier = true;
		return true;
	}

	public bool close() {
		self.requireExecutor();
		if (self._closed) { return self._cleaned; }
		if (self._activated && (!self._barrier || self._nativePending || self._entered || self._registration.activationGate()->load(MemoryOrder.ACQUIRE) != 1u)) {
			throw "Callback request must complete and drain before closing";
		}
		self._closed = true;
		self._receiver = null;
		self._cleaned = true;
		return true;
	}

	public void __del__() {
		if (pthread_equal(self._executor, pthread_self()) == 0) {
			fprintf(stderr, "Callback request destruction requires its creating thread\n");
			abort();
		}
		if (self._activated && !self._cleaned) {
			fprintf(stderr, "Callback request released before native completion\n");
			abort();
		}
	}
}

/* Raw realtime seam retained for existing native audio providers. Typed native
 * imports will construct CallbackState with a generated managed context; both
 * paths share exactly the same cancellation and drain implementation. */
class CallbackRegistration<Invoke> implements ICallbackRegistration {
	private CallbackState _state;

	public CallbackRegistration(Invoke invoke, void* context, CFunction<void, void*> destroy, CFunction<bool, Invoke, void*, Atomic<uint>*, void*> activate, void* activationContext, CFunction<bool, void*> unregister, void* unregisterContext) {
		if (activate == null) {
			fprintf(stderr, "CallbackRegistration requires activate\n");
			abort();
		}
		if (unregister == null) {
			fprintf(stderr, "CallbackRegistration requires unregister\n");
			abort();
		}
		var closure = new OwnedClosure<Invoke>(invoke, context, destroy, unregister, unregisterContext);
		self._state = CallbackState(closure);
		bool activated = false;
		try { activated = activate(closure.invokePointer(), closure.context(), self._state.activationGate(), activationContext); }
		finally { self._state.finishActivation(activated); }
		if (!activated) {
			fprintf(stderr, "CallbackRegistration activation failed before publication\n");
			abort();
		}
	}

	public bool isOpen() { return self._state.isOpen(); }

	public CallbackCancellation cancel() { return self._state.cancel(); }

	public CallbackCancellation pollCompletion() { return self._state.pollCompletion(); }

	public bool close() { return self._state.close(); }
}
