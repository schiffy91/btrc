/* btrc standard library — IO
 * Object-oriented file I/O inspired by Python's open() and file objects.
 */

import std.bytes;
import std.strings;
import std.vector;

#include <sys/stat.h>

class File {
    private FILE* handle;
    private string path;
    private string mode;
    private bool is_open;

    public File(string path, string mode = "r") {
        self.path = path;
        self.mode = mode;
        self.handle = fopen(path, mode);
        self.is_open = self.handle != NULL;
    }

    public bool ok() {
        return self.is_open;
    }

    /* Reads everything from the current position to EOF.
     * Chunked, so it works on non-seekable streams (pipes via setHandle)
     * as well as regular files. */
    public string read() {
        if (!self.is_open) { return ""; }
        int cap = 4096;
        int len = 0;
        char* buffer = (char*)malloc(cap);
        if (buffer == NULL) { fprintf(stderr, "File.read: out of memory\n"); exit(1); }
        int ch = fgetc(self.handle);
        while (ch != EOF) {
            if (len + 2 >= cap) {
                cap = cap * 2;
                char* grown = (char*)realloc(buffer, cap);
                if (grown == NULL) { fprintf(stderr, "File.read: out of memory\n"); exit(1); }
                buffer = grown;
            }
            buffer[len] = (char)ch;
            len++;
            ch = fgetc(self.handle);
        }
        buffer[len] = '\0';
        return buffer;
    }

    public string readLine() {
        if (!self.is_open) { return ""; }
        char buf[4096];
        if (fgets(buf, 4096, self.handle) != NULL) {
            int len = (int)strlen(buf);
            if (len > 0 && buf[len - 1] == '\n') {
                buf[len - 1] = '\0';
            }
            return Strings.copy(buf);
        }
        return "";
    }

    public Vector<string> readLines() {
        Vector<string> lines = [];
        if (!self.is_open) { return lines; }
        char buf[4096];
        while (fgets(buf, 4096, self.handle) != NULL) {
            int len = (int)strlen(buf);
            if (len > 0 && buf[len - 1] == '\n') {
                buf[len - 1] = '\0';
            }
            lines.push(Strings.copy(buf));
        }
        return lines;
    }

    /* Binary-safe read: returns the entire file (from the current position to
     * EOF) as a Bytes buffer. Uses fread with the real byte count, so embedded
     * NUL bytes are preserved — unlike read()/readLine() which return a
     * NUL-terminated `string` and truncate at the first '\0'. */
    public Bytes readBytes() {
        Bytes out = Bytes();
        if (!self.is_open) { return out; }
        char chunk[8192];
        size_t n = fread(chunk, 1, 8192, self.handle);
        while (n > 0) {
            out.appendRaw(chunk, (int)n);
            n = fread(chunk, 1, 8192, self.handle);
        }
        return out;
    }

    /* Binary-safe write: writes exactly b.len bytes via fwrite (NOT fputs,
     * which would stop at the first embedded NUL). Returns true when every
     * byte was written. */
    public bool writeBytes(Bytes b) {
        if (!self.is_open || b == null) { return false; }
        if (b.len == 0) { return true; }
        size_t wrote = fwrite(b.data, 1, (size_t)b.len, self.handle);
        return (int)wrote == b.len;
    }

    public void setHandle(FILE* h) {
        self.handle = h;
        self.is_open = true;
    }

    /* Writes text to the stream. Returns true on success, false if the file is
     * not open or the write failed (e.g. disk full / unwritable handle). Callers
     * that ignore the result keep the old fire-and-forget behavior. */
    public bool write(string text) {
        if (!self.is_open) { return false; }
        return fputs(text, self.handle) != EOF;
    }

    /* Writes text followed by a newline. Returns true only when both the text
     * and the newline were written successfully. */
    public bool writeLine(string text) {
        if (!self.is_open) { return false; }
        if (fputs(text, self.handle) == EOF) { return false; }
        return fputc('\n', self.handle) != EOF;
    }

    public void __del__() {
        self.close();
    }

    public void close() {
        if (self.is_open) {
            /* Don't close handles we don't own (stdout, stderr) */
            if (self.path.len() > 0) {
                fclose(self.handle);
            }
            self.is_open = false;
        }
    }

    public bool eof() {
        if (!self.is_open) { return true; }
        return feof(self.handle) != 0;
    }

    public void flush() {
        if (self.is_open) {
            fflush(self.handle);
        }
    }
}

class Path {
    /* Stat-based existence check. Delegates to FileSystem.exists so Path and
     * FileSystem agree on every case: directories count as existing, and a file
     * that exists but is unreadable still reports true. (The old fopen("r")
     * probe returned false for unreadable-but-existing files and depended on
     * read permission — a silent inconsistency with FileSystem.exists.) */
    class bool exists(string path) {
        struct stat st;
        return stat(path, &st) == 0;
    }

    class string readAll(string path) {
        var f = File(path, "r");
        if (!f.ok()) { return ""; }
        string content = f.read();
        f.close();
        return content;
    }

    /* Writes content to path, truncating any existing file. Returns true on
     * success, false if the file could not be opened or the write failed —
     * no more silent data loss. Existing callers that ignore the result keep
     * working; new callers can branch on the bool. */
    class bool writeAll(string path, string content) {
        var f = File(path, "w");
        if (!f.ok()) {
            fprintf(stderr, "Path.writeAll: cannot open '%s' for writing\n", path);
            return false;
        }
        bool wrote = f.write(content);
        f.close();
        if (!wrote) {
            fprintf(stderr, "Path.writeAll: write to '%s' failed\n", path);
        }
        return wrote;
    }
}
