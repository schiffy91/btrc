/* btrc standard library — the process's Java VM
 *
 * A host program, such as a test or a desktop tool, creates the VM here. A
 * library that a running VM loads -- an Android application's, or one a host
 * `java` process loads with System.load -- adopts that VM instead: its
 * JNI_OnLoad calls btrcJavaAdopt (JNI.h) before any BTRC code runs. Generated
 * Java class owners count their global references against the VM either way,
 * and threads that call Java attach as daemons on first use and detach when
 * they exit. Destroying a created VM while a reference is alive, or while such
 * a thread runs, terminates; an adopted VM belongs to its host and is never
 * destroyed.
 */
import Library.Vector;

class JavaVirtualMachine {
	/* Starts the host VM with `options`, such as "-Xcheck:jni" or
	 * "-Djava.class.path=classes". A process runs at most one VM, so this
	 * terminates once a VM is running, created or adopted. */
	class void createHost(Vector<string> options) {
		for option in options { btrcJavaAddOption(option); }
		int status = btrcJavaCreateHost();
		if (status != 0) { throw f"JavaVirtualMachine: JNI_CreateJavaVM failed with status {status}"; }
	}

	class bool running() { return btrcJavaRunning() != 0; }

	/* Whether the running VM is the host's, adopted at JNI_OnLoad, rather than
	 * one createHost started. */
	class bool adopted() { return btrcJavaAdopted() != 0; }

	/* Global references held by live Java class owners. */
	class long long liveClaims() { return btrcJavaLiveClaims(); }

	/* Threads this library attached that have not exited yet. */
	class int attachedThreads() { return btrcJavaAttachedThreads(); }

	/* Shuts a created VM down from the thread that created it, after every
	 * owner has been released and every attached thread has exited. An
	 * adopted VM is never shut down here: this terminates. */
	class void shutdown() { btrcJavaDestroy(); }
}
