/* The Android application owns ART and supplies its VM at JNI_OnLoad. */
class JavaVirtualMachine {
	class bool running() { return btrcJavaRunning() != 0; }

	/* Whether JNI_OnLoad has adopted the application VM. */
	class bool adopted() { return btrcJavaAdopted() != 0; }

	/* Global references held by live Java class and array owners. */
	class long long liveClaims() { return btrcJavaLiveClaims(); }

	/* Weak global references held by live JavaWeak owners. */
	class long long liveWeaks() { return btrcJavaLiveWeaks(); }

	/* Threads this library attached that have not exited yet. */
	class int attachedThreads() { return btrcJavaAttachedThreads(); }

	/* Java natives registrations whose holder is not freed yet: live ones,
	 * and cancelled ones a running call still pins. */
	class int liveNatives() { return btrcJavaLiveNatives(); }

	/* ART owns its VM. Calling shutdown on the adopted VM terminates. */
	class void shutdown() { btrcJavaDestroy(); }
}
