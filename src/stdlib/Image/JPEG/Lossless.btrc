import ./Component.btrc;

// ITU-T T.81 Annex H. Each Huffman symbol describes the difference from
// a neighboring sample in the reduced-precision plane. Restart intervals
// begin on MCU row boundaries and repeat the first-row prediction rules.
class JPEGLossless {
	private JPEGBits input;
	private int precision;
	private int selection;
	private int shift;

	public JPEGLossless(JPEGBits input, int precision, int selection, int shift) {
		self.input = input;
		self.precision = precision;
		self.selection = selection;
		self.shift = shift;
	}

	private int predict(JPEGComponent plane, int x, int y, int firstRow) {
		if (y == firstRow) { return x == 0 ? 1 << (self.precision - self.shift - 1) : plane.sample(x - 1, y) >> self.shift; }
		var above = plane.sample(x, y - 1) >> self.shift;
		if (x == 0 || self.selection == 2) { return above; }
		var left = plane.sample(x - 1, y) >> self.shift;
		if (self.selection == 1) { return left; }
		if (self.selection == 7) { return (left + above) >> 1; }
		var corner = plane.sample(x - 1, y - 1) >> self.shift;
		if (self.selection == 3) { return corner; }
		if (self.selection == 4) { return left + above - corner; }
		if (self.selection == 5) { return left + ((above - corner) >> 1); }
		return above + ((left - corner) >> 1);
	}

	public void decode(Vector<JPEGComponent> planes, int columns, int rows, int restart) {
		if (restart % columns != 0) { throw "Invalid lossless JPEG restart interval"; }
		int interval = 0;
		int sequence = 0;
		int firstRow = 0;
		var mask = (1 << (self.precision - self.shift)) - 1;
		for (int y = 0; y < rows; y++) {
			if (restart > 0 && interval == restart) {
				if (self.input.marker() != 0xd0 + sequence) { throw "Invalid JPEG restart"; }
				sequence = (sequence + 1) & 7;
				firstRow = y;
				interval = 0;
			}
			for (int x = 0; x < columns; x++) {
				for plane in planes {
					var h = planes.length == 1 ? 1 : plane.h;
					var v = planes.length == 1 ? 1 : plane.v;
					for (int dy = 0; dy < v; dy++) {
						for (int dx = 0; dx < h; dx++) {
							var px = x * h + dx;
							var py = y * v + dy;
							var size = plane.dc.read(self.input);
							if (size > 16) { throw "Invalid JPEG lossless difference"; }
							var difference = size == 16 ? 32768 : self.input.signedBits(size);
							var reduced = (self.predict(plane, px, py, firstRow * v) + difference) & mask;
							plane.setLossless(px, py, reduced << self.shift);
						}
					}
				}
				interval++;
			}
		}
	}
}

/* ITU-T T.81 Annex H lossless JPEG encoder (2..16 bit, 1..4 interleaved components,
 * predictor 1) for building deterministic lossless-JPEG / DNG raw tiles. */
class JPEGLosslessWriter {
	class int categoryOf(int diff) {
		if (diff == 0) { return 0; }
		if (diff == -32768 || diff == 32768) { return 16; }
		int mag = diff < 0 ? -diff : diff;
		int cat = 0;
		while (mag > 0) {
			mag >>= 1;
			cat++;
		}
		return cat;
	}

	class Bytes encode16(int width, int height, int components, int precision, Array<unsigned short> samples) {
		if (width <= 0 || height <= 0 || components < 1 || components > 4 || precision < 2 || precision > 16) {
			throw "Invalid lossless JPEG encode parameters";
		}
		if ((long long)width * (long long)height * (long long)components > (long long)samples.length) {
			throw "Lossless JPEG sample buffer is too small";
		}
		// Canonical Huffman table covering all 17 categories (0..16):
		// 1-bit: 0 (0)
		// 2-bit: 1 (10)
		// 3-bit: 2 (110)
		// 4-bit: 3 (1110)
		// 5-bit: 4, 5 (11110, 11111... wait: use flat 5-bit for 1..16 -> 16 symbols = 2^4 -> 1+4=5 bits!)
		// Clean prefix-free canonical code for 17 symbols (0..16):
		//   lengths: 1 symbol of len 1 (cat 0 -> code 0),
		//            16 symbols of len 5 (cats 1..16 -> codes 10000..11111)!
		// Verify Kraft sum: 1/2 + 16/32 = 1.0 exact!
		Bytes counts = Bytes();
		for (int i = 0; i < 16; i++) {
			if (i == 0) { counts.append(1); }
			else if (i == 4) { counts.append(15); }
			else if (i == 5) { counts.append(1); }
			else { counts.append(0); }
		}
		Bytes symbols = Bytes();
		for (int i = 0; i < 17; i++) { symbols.append(i); }
		JPEGHuffman huff = JPEGHuffman(counts, symbols);
		JPEGOutput out = JPEGOutput();
		out.bytes.appendU16BE(0xffd8);

		// SOF3 (Lossless Huffman)
		Bytes sof = Bytes();
		sof.append(precision);
		sof.appendU16BE(height);
		sof.appendU16BE(width);
		sof.append(components);
		for (int c = 0; c < components; c++) {
			sof.append(c + 1);
			sof.append(0x11); // 1x1 sampling
			sof.append(0);
		}
		out.segment(0xc3, sof);

		// DHT (DC table 0)
		Bytes dht = Bytes();
		dht.append(0);
		dht.appendBytes(counts);
		dht.appendBytes(symbols);
		out.segment(0xc4, dht);

		// SOS (predictor 1, point transform 0)
		Bytes sos = Bytes();
		sos.append(components);
		for (int c = 0; c < components; c++) {
			sos.append(c + 1);
			sos.append(0); // DC table 0
		}
		sos.append(1); // Ss = selection 1 (left, top on col 0)
		sos.append(0); // Se = 0
		sos.append(0); // Al = 0
		out.segment(0xda, sos);
		int modulus = 1 << precision;
		int halfMod = 1 << (precision - 1);
		for (int y = 0; y < height; y++) {
			for (int x = 0; x < width; x++) {
				for (int c = 0; c < components; c++) {
					int actual = (int)samples.get((y * width + x) * components + c) & (modulus - 1);
					int pred = halfMod;
					if (y == 0) {
						if (x > 0) { pred = (int)samples.get((y * width + (x - 1)) * components + c) & (modulus - 1); }
					} else if (x == 0) {
						pred = (int)samples.get(((y - 1) * width + x) * components + c) & (modulus - 1);
					} else {
						pred = (int)samples.get((y * width + (x - 1)) * components + c) & (modulus - 1);
					}
					int diff = (actual - pred) & (modulus - 1);
					if (diff > halfMod) { diff -= modulus; }
					if (diff == halfMod && precision < 16) { diff -= modulus; }
					int cat = JPEGLosslessWriter.categoryOf(diff);
					huff.write(out, cat);
					if (cat > 0 && cat < 16) {
						int extra = diff < 0 ? diff + (1 << cat) - 1 : diff;
						out.bits(extra, cat);
					}
				}
			}
		}
		out.finish();
		out.bytes.appendU16BE(0xffd9);
		return out.bytes;
	}
}
