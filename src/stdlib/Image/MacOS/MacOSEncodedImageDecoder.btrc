/* Bounded, synchronous ImageIO decoding. Apple headers own ABI declarations;
 * this module owns the ImageIO calls and the lifetime of each SDK resource.
 * EncodedImageDispatch owns admission, sniffing and DDS. Beyond the portable
 * PNG/JPEG set, ImageIO also decodes GIF and TIFF: a documented macOS
 * extension (view captures arrive as TIFF). */

import Library.Bytes;
import Library.Image.EncodedImage;
import Library.Image.EncodedImageDispatch;
import Library.Image.Pixels;

class MacOSEncodedImageDecoder implements IEncodedImageDecoder, IEncodedImageFormatDecoder {
	public MacOSEncodedImageDecoder() {}

	public EncodedImageDecodeOutcome decode(Bytes encoded, EncodedImageDecodeLimits limits) { return EncodedImageDispatch.decode(encoded, limits, self); }

	public EncodedImageDecodeOutcome decodeFormat(EncodedImageFormat format, Bytes encoded, EncodedImageDecodeLimits limits) {
		string type = MacOSEncodedImageDecoder.contentType(format);
		if (type == "") { return EncodedImageDecodeOutcome.rejected(ENCODED_IMAGE_DECODE_UNSUPPORTED, encoded.length()); }
		return ImageIODecodeSession.run(encoded, type, limits);
	}

	class string contentType(EncodedImageFormat format) {
		if (format == ENCODED_IMAGE_FORMAT_PNG) { return "public.png"; }
		if (format == ENCODED_IMAGE_FORMAT_JPEG) { return "public.jpeg"; }
		if (format == ENCODED_IMAGE_FORMAT_GIF) { return "com.compuserve.gif"; }
		if (format == ENCODED_IMAGE_FORMAT_TIFF) { return "public.tiff"; }
		return "";
	}
}

/* One decode transaction. Handles never escape, including borrowed property
 * values. The input and destination remain alive until the SDK borrowers are
 * released in __del__; a successful outcome retains only the BTRC Image. */
class ImageIODecodeSession {
	private Bytes _encoded;
	private Image? _pixels;
	private CFDataRef? _data;
	private CFMutableDictionaryRef? _options;
	private CGImageSourceRef? _source;
	private CFDictionaryRef? _properties;
	private CGImageRef? _image;
	private CGColorSpaceRef? _colorSpace;
	private CGContextRef? _context;

	private ImageIODecodeSession(Bytes encoded) {
		self._encoded = encoded;
		self._pixels = null;
		self._data = null;
		self._options = null;
		self._source = null;
		self._properties = null;
		self._image = null;
		self._colorSpace = null;
		self._context = null;
	}

	public void __del__() {
		self._context = null;
		self._colorSpace = null;
		self._image = null;
		self._properties = null;
		self._source = null;
		self._options = null;
		self._data = null;
	}

	class EncodedImageDecodeOutcome run(Bytes encoded, string format, EncodedImageDecodeLimits limits) { return ImageIODecodeSession(encoded).decode(format, limits); }

	private EncodedImageDecodeOutcome decode(string format, EncodedImageDecodeLimits limits) {
		var data = CFDataCreateWithBytesNoCopy(kCFAllocatorDefault, (const unsigned char*)self._encoded.data, self._encoded.length(), kCFAllocatorNull);
		if (data == null) { return self.rejected(ENCODED_IMAGE_DECODE_OUT_OF_MEMORY); }
		self._data = data;
		var options = CFDictionaryCreateMutable(kCFAllocatorDefault, 1, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
		if (options == null) { return self.rejected(ENCODED_IMAGE_DECODE_OUT_OF_MEMORY); }
		self._options = options;
		CFDictionarySetValue(options, kCGImageSourceShouldCache, kCFBooleanFalse);
		var source = CGImageSourceCreateWithData(data, options);
		if (source == null) { return self.rejected(ENCODED_IMAGE_DECODE_CORRUPT); }
		self._source = source;
		if (!ImageIODecodeSession.typeMatches(source, format) || CGImageSourceGetCount(source) == 0) { return self.rejected(ENCODED_IMAGE_DECODE_CORRUPT); }
		var properties = CGImageSourceCopyPropertiesAtIndex(source, 0, options);
		if (properties == null) { return self.rejected(ENCODED_IMAGE_DECODE_CORRUPT); }
		self._properties = properties;
		long long width = ImageIODecodeSession.dimension(properties, kCGImagePropertyPixelWidth);
		long long height = ImageIODecodeSession.dimension(properties, kCGImagePropertyPixelHeight);
		if (width <= 0 || height <= 0) { return self.rejected(ENCODED_IMAGE_DECODE_CORRUPT); }
		if (!Image.validDimensions(width, height) || !limits.allowsDimensions((int)width, (int)height)) { return self.rejected(ENCODED_IMAGE_DECODE_LIMIT_EXCEEDED); }
		var image = CGImageSourceCreateImageAtIndex(source, 0, options);
		if (image == null) { return self.rejected(ENCODED_IMAGE_DECODE_CORRUPT); }
		self._image = image;
		if (CGImageGetWidth(image) != (size_t)width || CGImageGetHeight(image) != (size_t)height) { return self.rejected(ENCODED_IMAGE_DECODE_CORRUPT); }
		var pixels = Image.tryCreate((int)width, (int)height);
		if (pixels == null) { return self.rejected(ENCODED_IMAGE_DECODE_OUT_OF_MEMORY); }
		self._pixels = pixels;
		var colorSpace = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
		if (colorSpace == null) { return self.rejected(ENCODED_IMAGE_DECODE_OUT_OF_MEMORY); }
		self._colorSpace = colorSpace;
		if (!self.draw(image, colorSpace, pixels, width, height)) { return self.rejected(ENCODED_IMAGE_DECODE_FAILED); }
		if (!pixels.tryCopyPremultipliedRgba(pixels.data, (unsigned long long)width * (unsigned long long)height * 4ULL)) { return self.rejected(ENCODED_IMAGE_DECODE_FAILED); }
		return EncodedImageDecodeOutcome.decoded(pixels, self._encoded.length());
	}

	/* The bitmap context is released before the pixels are read. */
	private bool draw(CGImageRef image, CGColorSpaceRef colorSpace, Image pixels, long long width, long long height) {
		var context = CGBitmapContextCreate(pixels.data, (size_t)width, (size_t)height, 8, (size_t)width * 4, colorSpace, kCGImageAlphaPremultipliedLast | kCGBitmapByteOrder32Big);
		if (context == null) { return false; }
		self._context = context;
		CGContextSetBlendMode(context, kCGBlendModeCopy);
		CGContextDrawImage(context, CGRectMake(0.0, 0.0, (double)width, (double)height), image);
		self._context = null;
		return true;
	}

	class bool typeMatches(CGImageSourceRef source, string expected) {
		var type = CGImageSourceGetType(source);
		if (type == null) { return false; }
		char name[32];
		return CFStringGetCString(type, name, 32, kCFStringEncodingUTF8) != 0 && strcmp(name, expected) == 0;
	}

	class long long dimension(CFDictionaryRef properties, CFStringRef? key) {
		if (key == null) { return 0LL; }
		var value = CFDictionaryGetValue(properties, key);
		if (value == null) { return 0LL; }
		var number = (CFNumberRef?)value;
		if (number == null) { return 0LL; }
		long long dimension = 0LL;
		if (CFNumberGetValue(number, kCFNumberLongLongType, &dimension) == 0) { return 0LL; }
		return dimension;
	}

	private EncodedImageDecodeOutcome rejected(EncodedImageDecodeStatus status) { return EncodedImageDecodeOutcome.rejected(status, self._encoded.length()); }
}
