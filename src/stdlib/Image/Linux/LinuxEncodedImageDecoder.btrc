import Library.Bytes;
import Library.Image.EncodedImage;
import Library.Image.EncodedImageDispatch;
import Library.Image.Pixels;

/* Bounded, synchronous decoding through libpng and libjpeg-turbo: the portable
 * PNG/JPEG set. The SDK owns its decoders; this module owns the codec calls
 * and every handle's lifetime. EncodedImageDispatch owns admission, sniffing
 * and DDS; GIF and TIFF are a macOS extension and stay UNSUPPORTED here. */
class LinuxEncodedImageDecoder implements IEncodedImageDecoder, IEncodedImageFormatDecoder {
	public LinuxEncodedImageDecoder() {}

	public EncodedImageDecodeOutcome decode(Bytes encoded, EncodedImageDecodeLimits limits) { return EncodedImageDispatch.decode(encoded, limits, self); }

	public EncodedImageDecodeOutcome decodeFormat(EncodedImageFormat format, Bytes encoded, EncodedImageDecodeLimits limits) {
		if (format == ENCODED_IMAGE_FORMAT_PNG) { return self.decodePng(encoded, limits); }
		if (format == ENCODED_IMAGE_FORMAT_JPEG) { return self.decodeJpeg(encoded, limits); }
		return EncodedImageDecodeOutcome.rejected(ENCODED_IMAGE_DECODE_UNSUPPORTED, encoded.length());
	}

	private EncodedImageDecodeOutcome decodePng(Bytes encoded, EncodedImageDecodeLimits limits) {
		unsigned int width = 0u;
		unsigned int height = 0u;
		if (btrcPngHeader((const unsigned char*)encoded.data, (size_t)encoded.length(), &width, &height) == 0) { return EncodedImageDecodeOutcome.rejected(ENCODED_IMAGE_DECODE_CORRUPT, encoded.length()); }
		if (!Image.validDimensions((long long)width, (long long)height) || !limits.allowsDimensions((int)width, (int)height)) { return EncodedImageDecodeOutcome.rejected(ENCODED_IMAGE_DECODE_LIMIT_EXCEEDED, encoded.length()); }
		var image = Image.tryCreate((int)width, (int)height);
		if (image == null) { return EncodedImageDecodeOutcome.rejected(ENCODED_IMAGE_DECODE_OUT_OF_MEMORY, encoded.length()); }
		if (btrcPngDecode((const unsigned char*)encoded.data, (size_t)encoded.length(), image.data, width, height) == 0) { return EncodedImageDecodeOutcome.rejected(ENCODED_IMAGE_DECODE_CORRUPT, encoded.length()); }
		return EncodedImageDecodeOutcome.decoded(image, encoded.length());
	}

	/* tjhandle is `void*`, which the importer cannot declare as a resource
	 * (native-interop.md, "Unmanaged void-pointer handles"), so this one
	 * handle is released by hand: every path below reaches the single
	 * tj3Destroy, and nothing between init and destroy can throw. */
	private EncodedImageDecodeOutcome decodeJpeg(Bytes encoded, EncodedImageDecodeLimits limits) {
		var handle = tj3Init(TJINIT_DECOMPRESS);
		if (handle == null) { return EncodedImageDecodeOutcome.rejected(ENCODED_IMAGE_DECODE_OUT_OF_MEMORY, encoded.length()); }
		EncodedImageDecodeStatus status = ENCODED_IMAGE_DECODE_OK;
		Image? image = null;
		if (tj3DecompressHeader(handle, (const unsigned char*)encoded.data, (size_t)encoded.length()) != 0) { status = ENCODED_IMAGE_DECODE_CORRUPT; }
		else {
			int width = tj3Get(handle, TJPARAM_JPEGWIDTH);
			int height = tj3Get(handle, TJPARAM_JPEGHEIGHT);
			if (width <= 0 || height <= 0) { status = ENCODED_IMAGE_DECODE_CORRUPT; }
			else if (!Image.validDimensions((long long)width, (long long)height) || !limits.allowsDimensions(width, height)) { status = ENCODED_IMAGE_DECODE_LIMIT_EXCEEDED; }
			else {
				image = Image.tryCreate(width, height);
				if (image == null) { status = ENCODED_IMAGE_DECODE_OUT_OF_MEMORY; }
				else if (tj3Decompress8(handle, (const unsigned char*)encoded.data, (size_t)encoded.length(), image.data, width * 4, TJPF_RGBA) != 0) { status = ENCODED_IMAGE_DECODE_CORRUPT; image = null; }
			}
		}
		tj3Destroy(handle);
		if (status != ENCODED_IMAGE_DECODE_OK || image == null) { return EncodedImageDecodeOutcome.rejected(status == ENCODED_IMAGE_DECODE_OK ? ENCODED_IMAGE_DECODE_FAILED : status, encoded.length()); }
		return EncodedImageDecodeOutcome.decoded(image, encoded.length());
	}
}
