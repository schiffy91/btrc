/* Stateful parser for the ordered English prompts emitted by passwd/PAM when
 * the child is launched with LC_ALL=C. Prompt output is not newline-terminated,
 * so callers feed arbitrary PTY chunks and accept only an exact prompt at a
 * separately established boundary. Unknown controls invalidate the line. */

import std.bytes;

class UnixPasswdPromptClassifier {
	private int selectedResponses;
	private int matched;
	private Bytes line;
	private bool lineInvalid;
	private bool promptPending;
	private int rawLineLength;
	/* 0=text, 1=after ESC, 2=CSI-SGR parameters. */
	private int escapeState;
	private int escapeLength;
	private bool escapeHasDigit;
	private bool escapeNeedsDigit;

	public UnixPasswdPromptClassifier(int selectedResponses) {
		self.selectedResponses = selectedResponses;
		self.matched = 0;
		self.line = Bytes();
		self.lineInvalid = false;
		self.promptPending = false;
		self.rawLineLength = 0;
		self.escapeState = 0;
		self.escapeLength = 0;
		self.escapeHasDigit = false;
		self.escapeNeedsDigit = false;
	}

	private bool isHorizontalSpace(char value) { return value == ' ' || value == '\t'; }

	private void resetEscape() {
		self.escapeState = 0;
		self.escapeLength = 0;
		self.escapeHasDigit = false;
		self.escapeNeedsDigit = false;
	}

	private void resetLine() {
		self.line.len = 0;
		self.lineInvalid = false;
		self.promptPending = false;
		self.rawLineLength = 0;
		self.resetEscape();
	}

	private void invalidateLine() {
		self.lineInvalid = true;
		self.promptPending = false;
		self.resetEscape();
	}

	/* Prompt spellings are exact. Only trailing horizontal whitespace, which
     * passwd commonly emits before reading, is ignored. */
	private bool lineMatches(string expected) {
		if (self.lineInvalid || expected == null) { return false; }
		int end = self.line.len;
		while (end > 0 && self.isHorizontalSpace(self.line.data[end - 1])) {
			end--;
		}
		int expectedLength = expected.len();
		if (end != expectedLength) { return false; }
		for (int i = 0; i < end; i++) {
			if (self.line.data[i] != expected[i]) { return false; }
		}
		return true;
	}

	private bool currentPasswordPrompt() { return self.lineMatches("Current password:") || self.lineMatches("(current) UNIX password:") || self.lineMatches("Old password:") || self.lineMatches("Old Password:"); }

	private bool newPasswordPrompt() { return self.lineMatches("New password:") || self.lineMatches("New Password:") || self.lineMatches("Enter new UNIX password:"); }

	private bool retypePasswordPrompt() { return self.lineMatches("Retype new password:") || self.lineMatches("Retype New Password:") || self.lineMatches("Retype new UNIX password:") || self.lineMatches("Re-enter new password:") || self.lineMatches("Retype password:"); }

	private bool expectedPrompt() {
		if (self.selectedResponses == 2) {
			if (self.matched == 0) { return self.newPasswordPrompt(); }
			if (self.matched == 1) { return self.retypePasswordPrompt(); }
			return false;
		}
		if (self.selectedResponses == 3) {
			if (self.matched == 0) { return self.currentPasswordPrompt(); }
			if (self.matched == 1) { return self.newPasswordPrompt(); }
			if (self.matched == 2) { return self.retypePasswordPrompt(); }
		}
		return false;
	}

	/* Permit only a bounded numeric CSI Select Graphic Rendition sequence:
     * ESC '[' digit+ (';' digit+)* 'm'. OSC and every other escape/control
     * form invalidate the entire current line. */
	private void consumeEscapeByte(unsigned char value) {
		if (self.escapeState == 1) {
			if (value == (unsigned char)'[') {
				self.escapeState = 2;
				self.escapeLength = 0;
				self.escapeHasDigit = false;
				self.escapeNeedsDigit = true;
			} else {
				self.invalidateLine();
			}
			return;
		}

		self.escapeLength++;
		if (self.escapeLength > 16) {
			self.invalidateLine();
		} else if (value >= (unsigned char)'0' && value <= (unsigned char)'9') {
			self.escapeHasDigit = true;
			self.escapeNeedsDigit = false;
		} else if (value == (unsigned char)';' && self.escapeHasDigit && !self.escapeNeedsDigit) {
			self.escapeNeedsDigit = true;
		} else if (value == (unsigned char)'m' && self.escapeHasDigit && !self.escapeNeedsDigit) {
			self.resetEscape();
		} else {
			self.invalidateLine();
		}
	}

	/* True means this chunk ends at an exact candidate plus optional
     * horizontal whitespace and complete SGR decoration. State is bounded to
     * 128 visible bytes, 192 total raw bytes, and 16 escape-parameter bytes. */
	public bool feedRaw(char* bytes, int length) {
		if (bytes == null || length <= 0 || self.complete()) { return false; }
		for (int i = 0; i < length; i++) {
			unsigned char value = (unsigned char)bytes[i];
			if (value == (unsigned char)'\r' || value == (unsigned char)'\n') {
				self.resetLine();
				continue;
			}
			self.rawLineLength++;
			if (self.rawLineLength > 192) {
				self.invalidateLine();
				continue;
			}
			if (self.escapeState != 0) {
				self.consumeEscapeByte(value);
				continue;
			}
			if (value == (unsigned char)0x1b) {
				if (self.lineInvalid) { continue; }
				self.escapeState = 1;
				continue;
			}
			if ((value < (unsigned char)0x20 && value != (unsigned char)'\t') || value == (unsigned char)0x7f) {
				self.invalidateLine();
				continue;
			}
			if (self.lineInvalid) { continue; }
			if (self.line.len >= 128) {
				self.invalidateLine();
				continue;
			}
			if (self.promptPending && !self.isHorizontalSpace((char)value)) {
				self.promptPending = false;
			}
			self.line.append((int)value);
			if (value == (unsigned char)':' && self.expectedPrompt()) {
				self.promptPending = true;
			}
		}
		return self.promptPending && !self.lineInvalid && self.escapeState == 0 && self.expectedPrompt();
	}

	public bool acceptPending() {
		if (self.complete() || !self.promptPending || self.lineInvalid || self.escapeState != 0 || !self.expectedPrompt()) {
			return false;
		}
		self.matched++;
		self.resetLine();
		return true;
	}

	public bool feedText(string text) {
		if (!self.feedChunk(text)) {
			return false;
		}
		return self.acceptPending();
	}

	public bool feedChunk(string text) { return text != null && self.feedRaw((char*)text, text.len()); }

	public int matchedResponses() { return self.matched; }

	public bool incompleteCandidate() { return self.promptPending && !self.lineInvalid && self.escapeState != 0 && self.expectedPrompt(); }

	public bool complete() { return (self.selectedResponses == 2 || self.selectedResponses == 3) && self.matched == self.selectedResponses; }
}
