/* Portable application event and directory-picker values. Native application
 * lifecycle and windows are owned by Library.GUI.GUI. */

import Library.Strings;

enum AppErrorCode {
	APP_ERROR_NONE = 0,
	APP_ERROR_INVALID_ARGUMENT = 1,
	APP_ERROR_NOT_MAIN_THREAD = 2,
	APP_ERROR_ALREADY_RUNNING = 3,
	APP_ERROR_BACKEND_UNAVAILABLE = 4,
	APP_ERROR_NOT_OPEN = 5,
	APP_ERROR_WINDOW_ALREADY_OPEN = 6,
	APP_ERROR_WINDOW_CREATE_FAILED = 7,
	APP_ERROR_EVENT_QUEUE_OVERFLOW = 8,
	APP_ERROR_RESOURCE_BUSY = 9,
	APP_ERROR_STALE_SURFACE = 10,
	APP_ERROR_SURFACE_ALREADY_CREATED = 11,
	APP_ERROR_CLOSED = 12,
	APP_ERROR_SURFACE_ALREADY_ATTACHED = 13,
	APP_ERROR_INTERNAL = 14
};

class AppError {
	public AppErrorCode code;
	public string message;

	public AppError(AppErrorCode code, string message) {
		self.code = code;
		self.message = message;
	}
}

class AppClipboardText {
	public string text;
	public AppError? error;

	public AppClipboardText(string text, AppError? error = null) { self.text = text; self.error = error; }
}

enum AppTitlebarStyle {
	APP_TITLEBAR_STANDARD = 0,
	APP_TITLEBAR_OVERLAY = 1
};

class AppWindowDescriptor {
	public string title;
	public int logicalWidth;
	public int logicalHeight;

	public AppWindowDescriptor(string title, int logicalWidth, int logicalHeight) {
		self.title = title;
		self.logicalWidth = logicalWidth;
		self.logicalHeight = logicalHeight;
	}

	public bool isValid() { return !self.title.isEmpty() && self.logicalWidth > 0 && self.logicalHeight > 0; }
}

class AppSurfaceMetrics {
	public int logicalWidth;
	public int logicalHeight;
	public int framebufferWidth;
	public int framebufferHeight;
	public float scaleX;
	public float scaleY;

	public AppSurfaceMetrics(int logicalWidth, int logicalHeight, int framebufferWidth, int framebufferHeight, float scaleX, float scaleY) {
		self.logicalWidth = logicalWidth;
		self.logicalHeight = logicalHeight;
		self.framebufferWidth = framebufferWidth;
		self.framebufferHeight = framebufferHeight;
		self.scaleX = scaleX;
		self.scaleY = scaleY;
	}

	public bool isValid() { return self.logicalWidth > 0 && self.logicalHeight > 0 && self.framebufferWidth >= 0 && self.framebufferHeight >= 0 && self.scaleX > 0.0f && self.scaleY > 0.0f; }
}

class AppKeyModifiers {
	public bool shift;
	public bool control;
	public bool alt;
	public bool command;

	public AppKeyModifiers(bool shift, bool control, bool alt, bool command) {
		self.shift = shift;
		self.control = control;
		self.alt = alt;
		self.command = command;
	}
}

enum AppPointerAction {
	APP_POINTER_MOVED = 0,
	APP_POINTER_PRESSED = 1,
	APP_POINTER_RELEASED = 2,
	APP_POINTER_ENTERED = 3,
	APP_POINTER_EXITED = 4,
	APP_POINTER_DRAGGED = 5,
	APP_POINTER_CANCELLED = 6
};

enum AppPointerButton {
	APP_POINTER_BUTTON_NONE = 0,
	APP_POINTER_BUTTON_PRIMARY = 1,
	APP_POINTER_BUTTON_SECONDARY = 2,
	APP_POINTER_BUTTON_MIDDLE = 3,
	APP_POINTER_BUTTON_OTHER = 4,
	APP_POINTER_BUTTON_BACK = 5,
	APP_POINTER_BUTTON_FORWARD = 6
};

class AppPointerEvent {
	public AppPointerAction action;
	public AppPointerButton button;
	public double logicalX;
	public double logicalY;
	public AppKeyModifiers modifiers;
	public int clickCount;

	public AppPointerEvent(AppPointerAction action, AppPointerButton button, double logicalX, double logicalY, AppKeyModifiers modifiers, int clickCount = 1) {
		self.action = action;
		self.button = button;
		self.logicalX = logicalX;
		self.logicalY = logicalY;
		self.modifiers = modifiers;
		bool clicking = action == APP_POINTER_PRESSED || action == APP_POINTER_RELEASED || action == APP_POINTER_DRAGGED;
		self.clickCount = clicking ? (clickCount < 1 ? 1 : clickCount) : 0;
	}
}

enum AppScrollPhase { APP_SCROLL_NONE, APP_SCROLL_BEGAN, APP_SCROLL_CHANGED, APP_SCROLL_ENDED, APP_SCROLL_CANCELLED, APP_SCROLL_MAY_BEGIN, APP_SCROLL_STATIONARY };

class AppScrollEvent {
	public double deltaX;
	public double deltaY;
	public double logicalX;
	public double logicalY;
	public bool precise;
	public AppScrollPhase phase;
	public AppScrollPhase momentumPhase;
	public AppKeyModifiers modifiers;

	public AppScrollEvent(double deltaX, double deltaY, double logicalX = 0.0, double logicalY = 0.0, bool precise = false, AppScrollPhase phase = APP_SCROLL_NONE, AppScrollPhase momentumPhase = APP_SCROLL_NONE, AppKeyModifiers? modifiers = null) {
		self.deltaX = deltaX;
		self.deltaY = deltaY;
		self.logicalX = logicalX;
		self.logicalY = logicalY;
		self.precise = precise;
		self.phase = phase;
		self.momentumPhase = momentumPhase;
		self.modifiers = modifiers == null ? AppKeyModifiers(false, false, false, false) : modifiers;
	}
}

enum AppKeyAction {
	APP_KEY_PRESSED = 0,
	APP_KEY_REPEATED = 1,
	APP_KEY_RELEASED = 2
};

enum AppKeyCode {
	APP_KEY_UNKNOWN = 0,
	APP_KEY_ESCAPE = 1,
	APP_KEY_ENTER = 2,
	APP_KEY_SPACE = 3,
	APP_KEY_LEFT = 4,
	APP_KEY_RIGHT = 5,
	APP_KEY_UP = 6,
	APP_KEY_DOWN = 7,
	APP_KEY_TAB = 8,
	APP_KEY_BACKSPACE = 9,
	APP_KEY_A = 10,
	APP_KEY_D = 11,
	APP_KEY_S = 12,
	APP_KEY_W = 13,
	APP_KEY_LEFT_SHIFT = 14,
	APP_KEY_RIGHT_SHIFT = 15,
	APP_KEY_LEFT_ALT = 16,
	APP_KEY_RIGHT_ALT = 17,
	APP_KEY_C = 18,
	APP_KEY_V = 19,
	APP_KEY_X = 20,
	APP_KEY_HOME = 21,
	APP_KEY_END = 22,
	APP_KEY_DELETE = 23,
	APP_KEY_Z = 24,
	APP_KEY_Q = 25,
	APP_KEY_LEFT_BRACKET = 26,
	APP_KEY_RIGHT_BRACKET = 27
};

class AppKeyboardEvent {
	public AppKeyAction action;
	public AppKeyCode key;
	public AppKeyModifiers modifiers;

	public AppKeyboardEvent(AppKeyAction action, AppKeyCode key, AppKeyModifiers modifiers) {
		self.action = action;
		self.key = key;
		self.modifiers = modifiers;
	}
}

enum AppWindowEventKind {
	APP_EVENT_IDLE = 0,
	APP_EVENT_POINTER = 1,
	APP_EVENT_KEYBOARD = 2,
	APP_EVENT_TEXT = 3,
	APP_EVENT_RESIZED = 4,
	APP_EVENT_DPI_CHANGED = 5,
	APP_EVENT_CLOSE_REQUESTED = 6,
	APP_EVENT_CLOSED = 7,
	APP_EVENT_FAILED = 8,
	APP_EVENT_SCROLLED = 9,
	APP_EVENT_FOCUS_LOST = 10
};

class AppWindowEvent {
	public AppWindowEventKind kind;
	public AppPointerEvent? pointer;
	public AppScrollEvent? scroll;
	public AppKeyboardEvent? keyboard;
	public AppSurfaceMetrics? surface;
	public string text;
	public AppError? error;

	public AppWindowEvent(AppWindowEventKind kind) {
		self.kind = kind;
		self.pointer = null;
		self.scroll = null;
		self.keyboard = null;
		self.surface = null;
		self.text = "";
		self.error = null;
	}
}
