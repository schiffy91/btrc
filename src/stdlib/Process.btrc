class Command {
	public string command;
	public Vector<string> arguments;

	public Command(string command) {
		self.command = command;
		self.arguments = [];
	}

	public Command arg(string value) {
		self.arguments.push(value);
		return self;
	}

	public Command args(Vector<string> values) {
		for value in values {
			self.arguments.push(value);
		}
		return self;
	}

	public Command flag(string name, string value) {
		self.arguments.push(name);
		self.arguments.push(value);
		return self;
	}

	/* command is argv[0], quoted like every argument, so the rendered text
	 * runs exactly the argv that ChildProcess.run would receive. */
	public string render() { return ChildProcess.render(self.command, self.arguments); }

	public string toString() { return self.render(); }
}

/* Runs a POSIX shell command line through /bin/sh -c. cwd and env reach the
 * shell process itself, so they hold for every command in the line. Unlike
 * ChildProcess.run, the shell inherits the caller's stdin unless stdin text
 * is supplied, because command lines are often interactive. */
