			int raw = 0;
			while (waitpid((pid_t)self.childPid, &raw, 0) < (pid_t)0 && errno == EINTR) {}
			self.exitStatus = ProcessStatus(raw);
#endif
		}
	}
}

/* Unified process facade for direct argv execution, shell pipelines, streaming
 * pipes, background children, and current-process exec handoff. */
class Process {
	class ExecResult run(string executable, Vector<string> arguments = [], string cwd = "", Vector<string> environment = [], Vector<string> unsetEnvironment = [], int timeoutMilliseconds = 0, int maxStdoutBytes = 8388608, int maxStderrBytes = 8388608, string stdinData = "", Bytes? stdinBytes = null, CommandOutput stdout = COMMAND_OUTPUT_COLLECT, CommandOutput stderr = COMMAND_OUTPUT_COLLECT, bool foreground = false, ChildStdin stdinMode = CHILD_STDIN_NULL, bool check = false) { return ChildProcess.run(executable, arguments, cwd=cwd, environment=environment, unsetEnvironment=unsetEnvironment, timeoutMilliseconds=timeoutMilliseconds, maxStdoutBytes=maxStdoutBytes, maxStderrBytes=maxStderrBytes, stdinData=stdinData, stdout=stdout, stderr=stderr, foreground=foreground, stdinMode=stdinMode, stdinBytes=stdinBytes, check=check); }

	class ExecResult shell(string command, CommandOutput stdout = COMMAND_OUTPUT_COLLECT, CommandOutput stderr = COMMAND_OUTPUT_COMBINE, bool logCommand = false, bool logFailure = false, bool check = false, string redactSubstring = "", string stdin = "", Bytes? stdinBytes = null, string cwd = "", Vector<string> env = [], int timeoutMilliseconds = 0, int maxStdoutBytes = 8388608, int maxStderrBytes = 8388608, bool foreground = false) { return UnixShell().run(command, stdout=stdout, stderr=stderr, logCommand=logCommand, logFailure=logFailure, throwOnFailure=check, redactSubstring=redactSubstring, stdin=stdin, cwd=cwd, env=env, timeoutMilliseconds=timeoutMilliseconds, maxStdoutBytes=maxStdoutBytes, maxStderrBytes=maxStderrBytes, foreground=foreground, stdinBytes=stdinBytes); }

	class BackgroundProcess start(string executable, Vector<string> arguments = [], Vector<string> environment = [], Vector<string> unsetEnvironment = [], string cwd = "", CommandOutput stdout = COMMAND_OUTPUT_STREAM, CommandOutput stderr = COMMAND_OUTPUT_STREAM, ChildStdin stdinMode = CHILD_STDIN_INHERIT, bool killOnDrop = false) { return BackgroundProcess.start(executable, arguments, environment=environment, unsetEnvironment=unsetEnvironment, cwd=cwd, stdout=stdout, stderr=stderr, stdinMode=stdinMode, killOnDrop=killOnDrop); }

	class PipeProcess pipe(string executable, Vector<string> arguments = [], string errorLog = "", string cwd = "", Vector<string> environment = [], Vector<string> unsetEnvironment = []) { return PipeProcess(executable, arguments, errorLog=errorLog, cwd=cwd, environment=environment, unsetEnvironment=unsetEnvironment); }

	class void exec(Vector<string> command, string argv0 = "", Vector<string> environment = [], Vector<string> unsetEnvironment = []) {
		if (command == null || command.len == 0) {
			throw "Process.exec requires a non-empty command vector";
		}
		ChildProcess.validateArguments(command);
		string program = command.get(0);
		if (program.isEmpty()) {
			throw "Process.exec executable cannot be empty";
		}
#if defined(_WIN32)
		ProcessHostProvider.validateEnvironment(environment, unsetEnvironment);
		if (argv0 == null) {}
		throw "Process.exec is unavailable on Windows";
#else
		ChildProcess.validateEnvironment(environment, unsetEnvironment);
		string resolved = ChildProcessExecutable.resolve(program, "", environment, unsetEnvironment);
		if (resolved.isEmpty()) {
			throw f"Cannot execute: {program}";
		}
		string invokedName = argv0 != null && !argv0.isEmpty() ? argv0 : program;
		Vector<string> tail = command.slice(1, command.len);
		char** execArguments = ChildProcessArguments.build(invokedName, tail);
		char** execEnvironment = ChildProcessEnvironment.build(environment, unsetEnvironment);
		if (execArguments == NULL || execEnvironment == NULL) {
			CStringArray.freeAll(execArguments);
			CStringArray.freeAll(execEnvironment);
			throw "Cannot allocate exec arguments";
		}
		execve(resolved, execArguments, execEnvironment);
		int savedErrno = errno;
		CStringArray.freeAll(execArguments);
		CStringArray.freeAll(execEnvironment);
		throw f"Cannot execute {program}: {Strings.copy(strerror(savedErrno))}";
#endif
	}
}
