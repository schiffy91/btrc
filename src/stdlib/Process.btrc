/* btrc standard library — Process execution
 * ChildProcess runs an executable with a structured argv; UnixShell runs a
 * POSIX shell command line through /bin/sh. `[[package.providers]]` in the
 * root btrc.toml selects the host seam: Windows/ProcessHostProvider launches
 * through the runtime's CreateProcessW and job-object seam on windows rows,
 * and the bodies below serve every other row (Unix/ProcessHostProvider is
 * their selection-only shell). Windows refuses UnixShell, descriptor-backed
 * launches and foreground handoff with the platform-adaptations diagnostics
 * (docs/design/windows-os-services.md, "Process and shell").
 */

import Library.Bytes;
import Library.Timer;
import Library.IO;
import Library.Platform;
import Library.Strings;
import Library.Vector;

#include <errno.h>
#include <fcntl.h>
#include <limits.h>
#include <signal.h>
#include <stdint.h>
#include <sys/stat.h>
#if !defined(_WIN32)
#include <poll.h>
#endif
#include <sys/wait.h>
#include <time.h>
#include <unistd.h>

/* Only the POSIX bodies read environ; the Windows provider merges the native
 * environment block in the runtime. */
#if !defined(_WIN32)
extern char** environ;
#endif

class ProcessStatus {
	public int raw;

	public ProcessStatus(int raw) { self.raw = raw; }

	public int code() {
#if defined(_WIN32)
		/* A Windows exit code is the child's own DWORD, bit for bit; there is
		 * no wait status to decode. */
		return self.raw;
#else
		if (self.raw == -1) { return 127; }
		if (WIFEXITED(self.raw)) { return WEXITSTATUS(self.raw); }
		if (WIFSIGNALED(self.raw)) { return 128 + WTERMSIG(self.raw); }
		return self.raw;
#endif
	}

	/* The signal that ended the process, or 0 when it exited: code() alone
	 * cannot tell signal N from an exit status of 128 + N. */
	public int terminatingSignal() {
		if (self.raw == -1 || !WIFSIGNALED(self.raw)) { return 0; }
		return WTERMSIG(self.raw);
	}

	public bool ok() { return self.code() == 0; }
}

class ShellWords {
	class bool isEnvNameStart(char c) {
		if (c >= 'a' && c <= 'z') { return true; }
		if (c >= 'A' && c <= 'Z') { return true; }
		return c == '_';
	}

	class bool isEnvNameChar(char c) { return ShellWords.isEnvNameStart(c) || (c >= '0' && c <= '9'); }

	class bool isEnvName(string name) {
		if (name == null || name.isEmpty()) { return false; }
		if (!ShellWords.isEnvNameStart(name[0])) { return false; }
		for ch in name {
			if (!ShellWords.isEnvNameChar(ch)) { return false; }
		}
		return true;
	}

	class bool isSafeArgChar(char c) {
		if (c >= 'a' && c <= 'z') { return true; }
		if (c >= 'A' && c <= 'Z') { return true; }
		if (c >= '0' && c <= '9') { return true; }
		return c == '_' || c == '-' || c == '.' || c == '/' || c == ':' || c == '=' || c == ',' || c == '+';
	}

	class bool isSafeArg(string raw) {
		int len = raw.len();
		if (len == 0) { return false; }
		for ch in raw {
			if (!ShellWords.isSafeArgChar(ch)) { return false; }
		}
		return true;
	}

	class string quote(string raw) {
		if (ShellWords.isSafeArg(raw)) { return Strings.copy(raw); }
		string escaped = raw.replace("'", "'\\''");
		return "'" + escaped + "'";
	}

	class string redact(string text, string sensitive) {
		if (sensitive.isEmpty()) { return text; }
		string result = Strings.copy(text);
		string quoted = ShellWords.quote(sensitive);
		string escaped = sensitive.replace("'", "'\\''");
		string quotedTwice = ShellWords.quote(quoted);
		string escapedTwice = escaped.replace("'", "'\\''");
		/* Shell quoting can split one secret across adjacent quoted and
         * escaped fragments. Redact those rendered forms before the raw form
         * so diagnostics cannot reconstruct a secret from shell syntax. */
		if (!quotedTwice.equals(quoted)) {
			result = result.replace(quotedTwice, "***");
		}
		if (!escapedTwice.equals(escaped)) {
			result = result.replace(escapedTwice, "***");
		}
		if (!quoted.equals(sensitive)) {
			result = result.replace(quoted, "***");
		}
		if (!escaped.equals(sensitive)) {
			result = result.replace(escaped, "***");
		}
		return result.replace(sensitive, "***");
	}
}

/* Where a child's stdout or stderr goes. COMBINE is valid only for stderr,
 * and only when stdout is collected. */
enum CommandOutput {
	COMMAND_OUTPUT_COLLECT = 0,
	COMMAND_OUTPUT_STREAM = 1,
	COMMAND_OUTPUT_COMBINE = 2,
	COMMAND_OUTPUT_SUPPRESS = 3
};

/* What a child reads when no stdinData is supplied: /dev/null, or the
 * parent's own stdin. Supplied stdinData always wins, and supplying it
 * together with CHILD_STDIN_INHERIT is a caller error. A foreground child
 * without stdinData always inherits stdin, since the terminal handoff it
 * exists for is interactive. */
enum ChildStdin {
	CHILD_STDIN_NULL = 0,
	CHILD_STDIN_INHERIT = 1
};

class ChildDescriptorMapping {
	public int sourceDescriptor;
	public int childDescriptor;

	public ChildDescriptorMapping(int sourceDescriptor, int childDescriptor) {
		self.sourceDescriptor = sourceDescriptor;
		self.childDescriptor = childDescriptor;
	}
}

class ExecResult {
	public int code;
	public string out;
	public string err;
	public Bytes outBytes;
	public Bytes errBytes;
	public string command;
	public bool timedOut;
	/* A committed daemon may exist; callers must reconcile before retrying start. */
	public bool startIndeterminate;
	/* Bytes retained from each capture pipe, before NUL-terminated text access
	 * or appended process diagnostics. Combined output counts under stdout;
	 * streamed/suppressed output and synthetic results have no captured bytes. */
	public int capturedStdoutBytes;
	public int capturedStderrBytes;
	/* A capture limit was exceeded (code 125) or a capture could not be read
	 * (code 127); each also appends a diagnostic line to err. */
	public bool captureExceeded;
	public bool captureFailed;
	/* The signal that ended the child (code is then 128 + it), or 0. A child
	 * this API killed for its timeout or capture limit reports 0. */
	public int terminatingSignal;

	public ExecResult(int code, string out, string err, string command, int capturedStdoutBytes = 0, int capturedStderrBytes = 0) {
		self.code = code;
		self.out = out;
		self.err = err;
		self.outBytes = Bytes();
		self.errBytes = Bytes();
		self.command = command;
		self.timedOut = false;
		self.startIndeterminate = false;
		self.terminatingSignal = 0;
		self.capturedStdoutBytes = capturedStdoutBytes;
		self.capturedStderrBytes = capturedStderrBytes;
		self.captureExceeded = false;
		self.captureFailed = false;
	}

	public bool ok() { return self.code == 0; }

	public string stdout() { return self.out; }

	public Bytes stdoutBytes() { return self.outBytes.slice(0, self.outBytes.len); }

	// Captured stdout with surrounding whitespace removed, the common
	// "run a command and read one value" idiom.
	public string trimmed() { return self.out.trim(); }

	public string stderr() { return self.err; }

	public Bytes stderrBytes() { return self.errBytes.slice(0, self.errBytes.len); }

	public bool wasTimedOut() { return self.timedOut; }

	public ExecResult check() {
		if (!self.ok()) {
			string detail = self.err.trim();
			if (detail.isEmpty()) {
				throw f"Command failed ({self.code}): {self.command}";
			}
			throw f"Command failed ({self.code}): {self.command}: {detail}";
		}
		return self;
	}
}

/* One captured child stream. The parent only reads after poll(2) marks the
 * descriptor ready, so stdout and stderr can both fill without deadlocking. */
class ChildProcessCapture {
	public int descriptor;
	public int limit;
	public bool open;
	public bool failed;
	public bool exceeded;
	public Bytes buffer;

	public ChildProcessCapture(int descriptor, int limit = 8388608) {
		self.descriptor = descriptor;
		self.limit = limit < 0 ? 0 : (limit > 2147483646 ? 2147483646 : limit);
		self.open = descriptor >= 0;
		self.failed = false;
		self.exceeded = false;
		self.buffer = Bytes();
	}

	public void readReady() {
		if (!self.open) { return; }
		char buffer[4097];
		ssize_t count = read(self.descriptor, buffer, 4096);
		if (count > (ssize_t)0) {
			int remaining = self.limit - self.buffer.len;
			if (remaining > 0) {
				int retained = (int)count < remaining ? (int)count : remaining;
				self.buffer.appendRaw(buffer, retained);
			}
			if ((int)count > remaining) { self.exceeded = true; }
			return;
		}
		if (count < (ssize_t)0 && errno == EINTR) { return; }
		if (count < (ssize_t)0) { self.failed = true; }
		close(self.descriptor);
		self.descriptor = -1;
		self.open = false;
	}

	public string text() { return self.buffer.toStringLossy(); }

	public void closeCapture() {
		if (self.open) {
			close(self.descriptor);
			self.descriptor = -1;
			self.open = false;
		}
	}
}

/* Thread-local SIGPIPE-safe pipe writing for child stdin feeds and sessions.
 * Never mutates process-wide signal handlers. */
class ChildProcessPipe {
	class void suppressSigpipe(int descriptor) {
#if defined(__APPLE__)
		if (descriptor >= 0) { fcntl(descriptor, F_SETNOSIGPIPE, 1); }
#else
		if (descriptor < 0) { return; }
#endif
	}

	class ssize_t writeNoSigpipe(int descriptor, char* data, size_t count) {
#if defined(_WIN32)
		if (descriptor < 0 || data == NULL || count == (size_t)0) { return (ssize_t)(-1); }
		return (ssize_t)(-1);
#elif defined(__APPLE__)
		return write(descriptor, data, count);
#else
		int pipeSignal = (int)SIGPIPE;
		int blockHow = (int)SIG_BLOCK;
		int setHow = (int)SIG_SETMASK;
		int pipeError = (int)EPIPE;
		sigset_t pipeMask;
		sigset_t previousMask;
		sigset_t pendingBefore;
		sigemptyset(&pipeMask);
		sigaddset(&pipeMask, pipeSignal);
		bool wasPending = false;
		if (sigpending(&pendingBefore) == 0) {
			wasPending = sigismember(&pendingBefore, pipeSignal) == 1;
		}
		bool masked = pthread_sigmask(blockHow, &pipeMask, &previousMask) == 0;
		ssize_t written = write(descriptor, data, count);
		int savedErrno = errno;
		if (written < (ssize_t)0 && savedErrno == pipeError && !wasPending) {
			sigset_t pendingAfter;
			if (sigpending(&pendingAfter) == 0) {
				if (sigismember(&pendingAfter, pipeSignal) == 1) {
					int consumed = 0;
					sigwait(&pipeMask, &consumed);
				}
			}
		}
		if (masked) {
			pthread_sigmask(setHow, &previousMask, NULL);
		}
		errno = savedErrno;
		return written;
#endif
	}
}

/* Nonblocking in-memory stdin pipe writer multiplexed with stdout and stderr
 * captures so supplied input never touches /tmp or deadlocks large outputs. */
class ChildProcessInput {
	public int descriptor;
	public Bytes payload;
	public int offset;
	public bool open;

	public ChildProcessInput(int descriptor, Bytes payload) {
		self.descriptor = descriptor;
		self.payload = payload;
		self.offset = 0;
		self.open = descriptor >= 0;
		if (self.open) {
			ChildProcessPipe.suppressSigpipe(descriptor);
			if (payload == null || payload.len == 0) {
				self.closeInput();
			}
		}
	}

	public void writeReady() {
		if (!self.open) { return; }
#if !defined(_WIN32)
		if (self.offset >= self.payload.len) {
			self.closeInput();
			return;
		}
		int remaining = self.payload.len - self.offset;
		int chunk = remaining > 65536 ? 65536 : remaining;
		ssize_t count = ChildProcessPipe.writeNoSigpipe(self.descriptor, self.payload.data + self.offset, (size_t)chunk);
		if (count > (ssize_t)0) {
			self.offset = self.offset + (int)count;
			if (self.offset >= self.payload.len) {
				self.closeInput();
			}
			return;
		}
		if (count < (ssize_t)0 && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK)) {
			return;
		}
#endif
		self.closeInput();
	}

	public void closeInput() {
		if (self.open) {
			close(self.descriptor);
			self.descriptor = -1;
			self.open = false;
		}
	}
}

/* A NULL-terminated array of independently malloc'd C strings, the raw
 * argv/envp shape exec consumes. The parent builds and releases it; the
 * child after fork only reads it. */
class CStringArray {
	/* A raw copy of value, or NULL for a null value or a failed allocation. */
	class char* copyEntry(string value) {
		if (value == null) { return NULL; }
		size_t length = strlen(value);
		if (length == (size_t)(-1)) { return NULL; }
		char* result = (char*)malloc(length + (size_t)1);
		if (result == NULL) { return NULL; }
		memcpy(result, value, length + (size_t)1);
		return result;
	}

	/* Free every entry up to the terminating NULL, then the array itself. */
	class void freeAll(char** entries) {
		if (entries == NULL) { return; }
		int index = 0;
		while (entries[index] != NULL) {
			free(entries[index]);
			index++;
		}
		free(entries);
	}
}

/* Build the complete envp in the parent from independent raw copies. No
 * allocator, string helper, or environment mutation runs after fork. */
class ChildProcessEnvironment {
	class bool assignmentHasName(string assignment, string name) {
		int nameLength = Strings.checkedLength(name);
		int assignmentLength = Strings.checkedLength(assignment);
		return assignmentLength > nameLength && assignment[nameLength] == '=' && strncmp(assignment, name, (size_t)nameLength) == 0;
	}

	class bool assignmentsShareName(string left, string right) {
		int split = right.find("=", 0);
		if (split <= 0) { return false; }
		string name = right.substring(0, split);
		return ChildProcessEnvironment.assignmentHasName(left, name);
	}

	class bool replaced(string inherited, Vector<string> environment, Vector<string> unsetEnvironment) {
		for item in environment {
			if (ChildProcessEnvironment.assignmentsShareName(inherited, item)) { return true; }
		}
		for name in unsetEnvironment {
			if (ChildProcessEnvironment.assignmentHasName(inherited, name)) { return true; }
		}
		return false;
	}

	/* POSIX only: the Windows provider merges the native block in the
	 * runtime, so there this never builds an envp. */
	class char** build(Vector<string> environment, Vector<string> unsetEnvironment) {
#if defined(_WIN32)
		return NULL;
#else
		if (environ == NULL || environment == null || unsetEnvironment == null || environment.len < 0 || unsetEnvironment.len < 0) { return NULL; }
		int inheritedCount = 0;
		while (environ[inheritedCount] != NULL) {
			if (inheritedCount == 2147483646) { return NULL; }
			inheritedCount++;
		}
		if (environment.len > 2147483646 - inheritedCount) {
			return NULL;
		}
		int capacity = inheritedCount + environment.len + 1;
		if ((size_t)capacity > (size_t)(-1) / sizeof(char*)) {
			return NULL;
		}
		char** result = (char**)calloc((size_t)capacity, sizeof(char*));
		if (result == NULL) { return NULL; }
		int count = 0;
		for (int i = 0; i < inheritedCount; i++) {
			char* inherited = environ[i];
			if (!ChildProcessEnvironment.replaced(inherited, environment, unsetEnvironment)) {
				result[count] = CStringArray.copyEntry(inherited);
				if (result[count] == NULL) {
					CStringArray.freeAll(result);
					return NULL;
				}
				count++;
			}
		}
		for item in environment {
			result[count] = CStringArray.copyEntry(item);
			if (result[count] == NULL) {
				CStringArray.freeAll(result);
				return NULL;
			}
			count++;
		}
		result[count] = NULL;
		return result;
#endif
	}
}

/* Materialize argv as an independently owned raw snapshot in the parent. COW
 * already protects inherited managed strings after fork; this explicit
 * ownership instead keeps the post-fork child independent of managed-runtime
 * representation and gives every pre-fork failure one uniform cleanup path. */
class ChildProcessArguments {
	class char** build(string executable, Vector<string> arguments) {
		if (executable == null || arguments == null || arguments.len < 0) { return NULL; }
		size_t length = (size_t)arguments.len;
		size_t maximumCount = (size_t)(-1) / sizeof(char*);
		if (maximumCount < (size_t)2 || length > maximumCount - (size_t)2) { return NULL; }
		char** result = (char**)calloc(length + (size_t)2, sizeof(char*));
		if (result == NULL) { return NULL; }
		result[0] = CStringArray.copyEntry(executable);
		if (result[0] == NULL) {
			CStringArray.freeAll(result);
			return NULL;
		}
		for (int index = 0; index < arguments.len; index++) {
			result[index + 1] = CStringArray.copyEntry(arguments.get(index));
			if (result[index + 1] == NULL) {
				CStringArray.freeAll(result);
				return NULL;
			}
		}
		result[arguments.len + 1] = NULL;
		return result;
	}
}

class ChildProcessExecutable {
	class string join(string left, string right) {
		if (left.isEmpty()) { return Strings.copy(right); }
		if (left.endsWith("/")) { return left + right; }
		return left + "/" + right;
	}

	class string workingDirectory(string cwd) {
		if (cwd == null || cwd.isEmpty()) {
			return Platform.currentDirectory();
		}
		if (cwd[0] == '/') { return Strings.copy(cwd); }
		string current = Platform.currentDirectory();
		if (current.isEmpty()) { return ""; }
		return ChildProcessExecutable.join(current, cwd);
	}

	class string searchPath(Vector<string> environment, Vector<string> unsetEnvironment) {
		/* Environment.get copies getenv(3)'s borrowed storage before later
         * allocation or environment mutation can invalidate it. */
		string result = Environment.get("PATH", "/usr/bin:/bin");
		if (result.isEmpty()) { result = "/usr/bin:/bin"; }
		for name in unsetEnvironment {
			if (name.equals("PATH")) { result = "/usr/bin:/bin"; }
		}
		for item in environment {
			if (ChildProcessEnvironment.assignmentHasName(item, "PATH")) {
				int split = item.find("=", 0);
				result = item.substring(split + 1, item.len() - split - 1);
			}
		}
		return result;
	}

	class string resolve(string executable, string cwd, Vector<string> environment, Vector<string> unsetEnvironment) {
		string working = ChildProcessExecutable.workingDirectory(cwd);
		if (working.isEmpty()) { return ""; }
		if (executable.contains("/")) {
			return executable[0] == '/' ? Strings.copy(executable) : ChildProcessExecutable.join(working, executable);
		}
		Vector<string> directories = Strings.split(ChildProcessExecutable.searchPath(environment, unsetEnvironment), ":");
		for directory in directories {
			string base = directory.isEmpty() ? working : directory;
			if (base[0] != '/') {
				base = ChildProcessExecutable.join(working, base);
			}
			string candidate = ChildProcessExecutable.join(base, executable);
			if (access(candidate, X_OK) == 0) { return candidate; }
		}
		return "";
	}
}

/* Direct child execution for structured automation. Unlike UnixShell, this
 * API never parses or renders shell syntax: executable and arguments reach
 * execve(2) as distinct argv entries. Environment changes inherit the parent
 * environment, then apply NAME=value overrides and explicit unsets. A zero
 * timeout is unbounded; expiry returns code 124 with wasTimedOut() true.
 * executableDescriptor borrows a readable regular executable; when supplied,
 * executable is only argv[0] and the diagnostic label, never an execution path.
 * Explicit descriptor mappings and descriptor-backed cwd are native-Linux
 * capabilities and fail closed everywhere else without a pathname fallback. */
class ChildProcess {
	class int descriptorCloseBound() { return __btrc_descriptor_close_bound(); }

	/* Called only after fork. The runtime helper uses close_range(2) or a BSD
     * closefrom(3) where available and a precomputed hard-bound loop
     * everywhere else. */
	class int closeDescriptorsForExec(int bound) { return __btrc_close_descriptors_from(bound); }

	class bool inheritsOnExec(int descriptor) {
		int flags = fcntl(descriptor, F_GETFD, 0);
		return flags >= 0 && (flags & FD_CLOEXEC) == 0;
	}

	class void validateArguments(Vector<string> arguments) {
		if (arguments == null || arguments.len < 0) {
			throw "child arguments must be a valid vector";
		}
		if (arguments.len > 2147483645) {
			throw "too many child arguments";
		}
		for argument in arguments {
			if (argument == null) {
				throw "child arguments cannot contain null";
			}
		}
	}

	/* Keep every descriptor used as a dup2(2) source outside 0/1/2. Apart
     * from making identity mappings harmless, this prevents one remap from
     * overwriting a descriptor that a later remap still needs. */
	class int moveOutsideStandardStreams(int* descriptor) { return __btrc_move_descriptor_outside_stdio(descriptor); }

	/* A descriptor owned by a FILE remains attached to that FILE, so retain
     * the original for fclose(3) and give the child a distinct safe source. */
	class int childSourceOutsideStandardStreams(int descriptor) {
		if (descriptor < 0 || descriptor > STDERR_FILENO) {
			return descriptor;
		}
		return fcntl(descriptor, F_DUPFD_CLOEXEC, 3);
	}

	class void closeLeasedDescriptors(int* descriptors, int count) {
		if (descriptors == NULL) { return; }
		for (int index = 0; index < count; index++) {
			if (descriptors[index] >= 0) { close(descriptors[index]); }
		}
	}

	class void validateEnvironment(Vector<string> environment, Vector<string> unsetEnvironment) {
		if (environment == null || unsetEnvironment == null || environment.len < 0 || unsetEnvironment.len < 0) {
			throw "child environment vectors must be valid vectors";
		}
		for item in environment {
			if (item == null) {
				throw "child environment overrides cannot contain null";
			}
			int split = item.find("=", 0);
			if (split <= 0) {
				throw f"invalid environment assignment: {item}";
			}
			string name = item.substring(0, split);
			if (!ShellWords.isEnvName(name)) {
				throw f"invalid environment variable name: {name}";
			}
		}
		for item in environment {
			for name in unsetEnvironment {
				if (ChildProcessEnvironment.assignmentHasName(item, name)) {
					throw "child environment variable cannot be both set and unset";
				}
			}
		}
		for (int left = 0; left < environment.len; left++) {
			for (int right = left + 1; right < environment.len; right++) {
				if (ChildProcessEnvironment.assignmentsShareName(environment.get(left), environment.get(right))) {
					throw "duplicate child environment override";
				}
			}
		}
		for name in unsetEnvironment {
			if (name == null) {
				throw "child environment unsets cannot contain null";
			}
			if (!ShellWords.isEnvName(name)) {
				throw f"invalid environment variable name: {name}";
			}
		}
	}

	class void closePipe(int* descriptors) {
		if (descriptors[0] >= 0) { close(descriptors[0]); }
		if (descriptors[1] >= 0) { close(descriptors[1]); }
		descriptors[0] = -1;
		descriptors[1] = -1;
	}

	class int openPipe(int* descriptors) {
		descriptors[0] = -1;
		descriptors[1] = -1;
		if (pipe(descriptors) != 0) { return -1; }
		int readDescriptor = descriptors[0];
		int readMoved = ChildProcess.moveOutsideStandardStreams(&readDescriptor);
		descriptors[0] = readDescriptor;
		if (readMoved != 0) {
			ChildProcess.closePipe(descriptors);
			return -1;
		}
		int writeDescriptor = descriptors[1];
		int writeMoved = ChildProcess.moveOutsideStandardStreams(&writeDescriptor);
		descriptors[1] = writeDescriptor;
		if (writeMoved != 0) {
			ChildProcess.closePipe(descriptors);
			return -1;
		}
		if (!DescriptorFlags.closeOnExec(descriptors[0]) || !DescriptorFlags.closeOnExec(descriptors[1])) {
			ChildProcess.closePipe(descriptors);
			return -1;
		}
		return 0;
	}

	/* A failure result reports an operating-system or platform condition met
