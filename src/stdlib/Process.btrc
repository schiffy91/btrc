	public UnixShell() {}

	class void logError(string message) { fprintf(stderr, "%s\n", __btrc_string_or_empty(message)); }

	public ExecResult run(string command, CommandOutput stdout = COMMAND_OUTPUT_COLLECT, CommandOutput stderr = COMMAND_OUTPUT_COMBINE, bool logCommand = false, bool logFailure = true, bool throwOnFailure = false, string redactSubstring = "", string stdin = "", string cwd = "", Vector<string> env = [], int timeoutMilliseconds = 0, int maxStdoutBytes = 8388608, int maxStderrBytes = 8388608, bool foreground = false, Bytes? stdinBytes = null) {
		if (command == null) { throw "shell command cannot be null"; }
		string visible = ShellWords.redact(command, redactSubstring == null ? "" : redactSubstring);
		if (logCommand) {
			UnixShell.logError(f"LOG: {visible}");
		}

#if defined(_WIN32)
		Vector<string> noUnsets = [];
		ChildProcess.validateEnvironment(env, noUnsets);
		var child = ChildProcess.failure(visible, "UnixShell.run is unavailable on Windows: there is no POSIX /bin/sh; use ChildProcess.run with an argument vector\n");
#else
		bool hasStdin = (stdin != null && !stdin.isEmpty()) || stdinBytes != null;
		var child = ChildProcess.run("/bin/sh", ["-c", command], cwd=cwd, environment=env, timeoutMilliseconds=timeoutMilliseconds, maxStdoutBytes=maxStdoutBytes, maxStderrBytes=maxStderrBytes, stdinData=stdin, stdout=stdout, stderr=stderr, foreground=foreground, stdinMode=hasStdin ? CHILD_STDIN_NULL : CHILD_STDIN_INHERIT, stdinBytes=stdinBytes);
#endif
		var code = child.code;

		if ((logFailure || throwOnFailure) && code != 0) {
			UnixShell.logError(f"Command failed ({code}): {visible}");
		}
		if (throwOnFailure && code != 0) {
			throw f"Command failed ({code}): {visible}";
		}
		ExecResult result = ExecResult(code, child.out, child.err, visible, child.capturedStdoutBytes, child.capturedStderrBytes);
		result.outBytes = child.outBytes;
		result.errBytes = child.errBytes;
		result.timedOut = child.timedOut;
		result.captureExceeded = child.captureExceeded;
		result.captureFailed = child.captureFailed;
		result.terminatingSignal = child.terminatingSignal;
		return result;
	}
}

