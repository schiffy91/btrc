	public int pid() { return self.childPid; }

	public int code() {
		ProcessStatus? st = self.exitStatus;
		return st == null ? -1 : st.code();
	}

	private bool reap(int flags) {
		if (self.exitStatus != null) { return true; }
#if defined(_WIN32)
		if (flags != 0) {}
		return true;
#else
		int raw = 0;
		pid_t result = waitpid((pid_t)self.childPid, &raw, flags);
		while (result < (pid_t)0 && errno == EINTR) {
			result = waitpid((pid_t)self.childPid, &raw, flags);
		}
		if (result == (pid_t)0) { return false; }
		if (result < (pid_t)0) {
			throw f"Cannot wait for child {self.childPid}: {Strings.copy(strerror(errno))}";
		}
		self.exitStatus = ProcessStatus(raw);
		return true;
#endif
	}

	public bool running() {
#if defined(_WIN32)
		return false;
#else
		return !self.reap(WNOHANG);
#endif
	}

	public bool isRunning() { return self.running(); }

	public ProcessStatus? tryWait() {
#if !defined(_WIN32)
		self.reap(WNOHANG);
#endif
		return self.exitStatus;
	}

	public int wait() {
		self.reap(0);
		return self.code();
	}

	public bool waitUntil(long long deadline) {
		while (self.running()) {
			if (!MonotonicClock.before(deadline)) { return false; }
			Timer.sleepMillis(10);
		}
		return true;
	}

	private void sendSignal(int number) {
#if !defined(_WIN32)
		if (kill((pid_t)self.childPid, number) != 0 && errno != ESRCH) {
			throw f"Cannot signal child {self.childPid}: {Strings.copy(strerror(errno))}";
		}
#else
		if (number != 0) {}
#endif
	}

	public void terminate() {
#if !defined(_WIN32)
		if (!self.running()) { return; }
		self.sendSignal(SIGTERM);
#endif
	}

	public void kill() {
#if !defined(_WIN32)
		if (!self.running()) { return; }
		self.sendSignal(SIGKILL);
#endif
	}

	public void stop(int graceMilliseconds = 2000) {
#if !defined(_WIN32)
		if (!self.running()) { return; }
		self.sendSignal(SIGTERM);
		if (self.waitUntil(MonotonicClock.deadlineAfter((long long)graceMilliseconds))) { return; }
