/* btrc standard library — daemon specs and simple Unix supervision
 * The stdlib keeps daemon intent declarative. Platform-specific service
 * managers can consume DaemonSpec without changing app code.
 */

import std.process;

class DaemonSpec {
    public string name;
    public Command command;
    public string pidFile;
    public string logFile;
    public string workingDirectory;
    public bool autoRestart;

    public DaemonSpec(string name, Command command) {
        self.name = name;
        self.command = command;
        self.pidFile = f"/tmp/{name}.pid";
        self.logFile = f"/tmp/{name}.log";
        self.workingDirectory = "";
        self.autoRestart = false;
    }

    public DaemonSpec pid(string path) {
        self.pidFile = path;
        return self;
    }

    public DaemonSpec log(string path) {
        self.logFile = path;
        return self;
    }

    public DaemonSpec cwd(string path) {
        self.workingDirectory = path;
        return self;
    }

    public DaemonSpec restart(bool enabled) {
        self.autoRestart = enabled;
        return self;
    }

    public string renderStartCommand() {
        string changeDirectory = self.workingDirectory.isEmpty()
            ? ""
            : f"cd {UnixShell.quote(self.workingDirectory)} || exit 1; ";
        string log = UnixShell.quote(self.logFile);
        string pid = UnixShell.quote(self.pidFile);
        /* noclobber makes PID-file creation atomic: an existing file or
         * symlink fails the start instead of being silently overwritten. */
        return f"umask 077; {changeDirectory}: >> {log} || exit 1; "
            + f"nohup {self.command} >> {log} 2>&1 & daemon_pid=$!; "
            + f"if (set -C; printf '%s\\n' \"$daemon_pid\" > {pid}) 2>/dev/null; "
            + "then :; else kill -KILL \"$daemon_pid\" 2>/dev/null; "
            + "wait \"$daemon_pid\" 2>/dev/null; exit 1; fi";
    }
}

class DaemonController {
    public UnixShell shell;

    public DaemonController() {
        self.shell = UnixShell();
    }

    public ExecResult start(DaemonSpec spec) {
        return self.shell.run(spec.renderStartCommand());
    }

    private string validatedPid(DaemonSpec spec) {
        string pidFile = UnixShell.quote(spec.pidFile);
        return f"test -f {pidFile} || exit 1; "
            + f"pid=$(cat {pidFile}) || exit 1; "
            + "case \"$pid\" in ''|*[!0-9]*) exit 1 ;; esac; "
            + "test \"$pid\" -gt 1 2>/dev/null || exit 1; ";
    }

    public ExecResult stop(DaemonSpec spec) {
        string pidFile = UnixShell.quote(spec.pidFile);
        string command = self.validatedPid(spec)
            + "if kill \"$pid\"; then "
            + f"rm -f {pidFile}; else rm -f {pidFile}; exit 1; fi";
        return self.shell.run(command, logFailure=false);
    }

    public ExecResult status(DaemonSpec spec) {
        string command = self.validatedPid(spec) + "kill -0 \"$pid\"";
        return self.shell.run(command, logFailure=false);
    }
}

class AppSpec {
    public string name;
    public string version;

    public AppSpec(string name) {
        self.name = name;
        self.version = "0.0.0";
    }

    public AppSpec withVersion(string version) {
        self.version = version;
        return self;
    }
}

class DaemonApp extends AppSpec {
    public DaemonSpec daemon;

    public DaemonApp(string name, DaemonSpec daemon) {
        self.name = name;
        self.version = "0.0.0";
        self.daemon = daemon;
    }
}
