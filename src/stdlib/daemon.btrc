/* btrc standard library — daemon specs and capability-based Unix supervision
 * The stdlib keeps daemon intent declarative. Platform-specific service
 * managers can consume DaemonSpec without changing app code.
 */

import std.fs;
import std.daemon_control;
import std.daemon_control_files;
import std.daemon_control_protocol;
import std.process;
import std.vector;

class DaemonSpec {
    public string name;
    public Command command;
    public string pidFile;
    public string logFile;
    public string workingDirectory;
    public bool autoRestart;

    public DaemonSpec(string name, Command command) {
        self.name = name;
        self.command = command;
        string state = DaemonControlPaths.defaultDirectory();
        self.pidFile = PathTools.join(state, f"{name}.control");
        self.logFile = PathTools.join(state, f"{name}.log");
        self.workingDirectory = "";
        self.autoRestart = false;
    }

    public DaemonSpec pid(string path) {
        self.pidFile = path;
        return self;
    }

    public DaemonSpec log(string path) {
        self.logFile = path;
        return self;
    }

    public DaemonSpec cwd(string path) {
        self.workingDirectory = path;
        return self;
    }

    public DaemonSpec restart(bool enabled) {
        self.autoRestart = enabled;
        return self;
    }

    private string renderedCommand() {
        Vector<string> parts = [ShellWords.quote(self.command.command)];
        for argument in self.command.arguments {
            parts.push(ShellWords.quote(argument));
        }
        return parts.join(" ");
    }

    private string supervisorScript() {
        return "token=$1; command=$2; pid_file=$3; stop_file=$4; "
            + "probe_prefix=$5; restart=$6; workdir=$7; "
            + "if [ -n \"$workdir\" ]; then cd \"$workdir\" || exit 126; fi; "
            + "set -m || exit 125; "
            + "record=$(printf 'btrc-daemon-v1\\n%s\\n%s' \"$token\" \"$$\") "
            + "|| exit 125; "
            + "if ! (set -C; umask 077; printf '%s\\n' \"$record\" "
            + "> \"$pid_file\") 2>/dev/null; then exit 125; fi; "
            + "cleanup() { current=$(cat \"$pid_file\" 2>/dev/null) || return; "
            + "if [ \"$current\" = \"$record\" ]; then "
            + "rm -f \"$stop_file\" \"$probe_prefix\".*; "
            + "rm -f \"$pid_file\"; fi; }; "
            + "service_probe() { for probe_file in \"$probe_prefix\".*; do "
            + "[ -f \"$probe_file\" ] || continue; "
            + "case \"$probe_file\" in *.ack) continue ;; esac; "
            + "probe_value=$(cat \"$probe_file\" 2>/dev/null) || probe_value=; "
            + "if [ \"$probe_value\" = \"$token\" ]; then "
            + "ack_file=$probe_file.ack; "
            + "(set -C; umask 077; printf '%s\\n' \"$token\" "
            + "> \"$ack_file\") 2>/dev/null || :; fi; "
            + "rm -f \"$probe_file\"; done; }; "
            + "stop_requested() { [ -f \"$stop_file\" ] || return 1; "
            + "stop_value=$(cat \"$stop_file\" 2>/dev/null) || return 1; "
            + "[ \"$stop_value\" = \"$token\" ]; }; "
            + "child_alive() { kill -0 \"-$child\" 2>/dev/null; }; "
            + "while :; do service_probe; "
            + "if stop_requested; then cleanup; exit 0; fi; "
            + "/bin/sh -c \"$command\" & child=$!; "
            + "while child_alive; do service_probe; "
            + "if stop_requested; then kill -TERM \"-$child\" 2>/dev/null || :; "
            + "remaining=20; while child_alive "
            + "&& [ \"$remaining\" -gt 0 ]; do service_probe; "
            + "sleep 0.05; remaining=$((remaining - 1)); done; "
            + "if child_alive; then "
            + "kill -KILL \"-$child\" 2>/dev/null || :; fi; "
            + "wait \"$child\" 2>/dev/null || :; "
            + "while child_alive; do service_probe; sleep 0.05; done; "
            + "cleanup; exit 0; fi; "
            + "sleep 0.05; done; child_status=0; "
            + "wait \"$child\" || child_status=$?; service_probe; "
            + "if stop_requested; then cleanup; exit 0; fi; "
            + "if [ \"$restart\" != 1 ]; then cleanup; exit \"$child_status\"; fi; "
            + "sleep 0.1; done";
    }

    /* This renders the controller's local supervisor. Platform service
     * managers may continue to consume the declarative fields directly. */
    public string renderStartCommand() {
        if (!DaemonControlPaths.validDaemonName(self.name)
                || self.command == null || self.command.command == null
                || self.command.command.isEmpty()) {
            return "exit 125";
        }
        string pidFile = DaemonControlFiles.canonicalFilePath(self.pidFile);
        string logFile = DaemonControlFiles.canonicalFilePath(self.logFile);
        if (pidFile.isEmpty() || logFile.isEmpty()
                || pidFile.equals(logFile)
                || !DaemonControlFiles.absent(pidFile)
                || !DaemonControlFiles.safeLogPath(logFile)) {
            return "exit 125";
        }
        self.pidFile = pidFile;
        self.logFile = logFile;
        string token = DaemonControlProtocol.randomToken();
        if (token.isEmpty()) { return "exit 125"; }
        string stop = DaemonControlPaths.stop(self.pidFile, token);
        string probePrefix = DaemonControlPaths.probePrefix(
            self.pidFile, token);
        string restart = self.autoRestart ? "1" : "0";
        return "umask 077; nohup /bin/sh -c "
            + ShellWords.quote(self.supervisorScript())
            + " btrc-daemon-supervisor "
            + ShellWords.quote(token) + " "
            + ShellWords.quote(self.renderedCommand()) + " "
            + ShellWords.quote(self.pidFile) + " "
            + ShellWords.quote(stop) + " "
            + ShellWords.quote(probePrefix) + " "
            + restart + " "
            + ShellWords.quote(self.workingDirectory)
            + " </dev/null >> " + ShellWords.quote(self.logFile)
            + " 2>&1 &";
    }
}

class DaemonController {
    public UnixShell shell;

    public DaemonController() {
        self.shell = UnixShell();
    }

    public ExecResult start(DaemonSpec spec) {
        string operation = "daemon start";
        if (!self.validSpec(spec)) {
            return self.result(125, "unsafe daemon specification", operation);
        }
        if (!DaemonControlFiles.absent(spec.pidFile)) {
            return self.result(1, "daemon control record already exists",
                operation);
        }
        if (!DaemonControlFiles.prepareLog(spec.logFile)) {
            return self.result(125, "unsafe daemon log file", operation);
        }
        ExecResult launched = self.shell.run(spec.renderStartCommand(),
            logFailure=false, timeoutMilliseconds=3000);
        if (!launched.ok()) {
            return self.result(launched.code, "failed to launch daemon supervisor",
                operation);
        }
        if (!DaemonControlProtocol.waitForRecord(spec.pidFile, 2500)) {
            return self.result(125, "daemon supervisor did not publish control state",
                operation);
        }
        DaemonControlRecord record = DaemonControlProtocol.record(spec.pidFile);
        if (!record.valid || !DaemonControlProtocol.probe(
                spec.pidFile, record, 2500)) {
            return self.result(125, "daemon supervisor failed its liveness handshake",
                operation);
        }
        return self.result(0, "", operation);
    }

    private ExecResult result(int code, string message, string command) {
        return ExecResult(code, "", message, command);
    }

    private bool validSpec(DaemonSpec spec) {
        if (spec == null || !DaemonControlPaths.validDaemonName(spec.name)
                || spec.command == null || spec.command.command == null
                || spec.command.command.isEmpty()
                || spec.pidFile == null || spec.logFile == null) {
            return false;
        }
        string pidFile = DaemonControlFiles.canonicalFilePath(spec.pidFile);
        string logFile = DaemonControlFiles.canonicalFilePath(spec.logFile);
        if (pidFile.isEmpty() || logFile.isEmpty()
                || pidFile.equals(logFile)) {
            return false;
        }
        spec.pidFile = pidFile;
        spec.logFile = logFile;
        return true;
    }

    public ExecResult stop(DaemonSpec spec,
                           int timeoutMilliseconds = 7500) {
        string operation = "daemon stop";
        if (!self.validSpec(spec)) {
            return self.result(125, "unsafe daemon specification", operation);
        }
        if (timeoutMilliseconds <= 0) {
            return self.result(125, "invalid daemon stop timeout", operation);
        }
        DaemonControlRecord record = DaemonControlProtocol.record(spec.pidFile);
        if (!record.valid) {
            return self.result(1, "daemon supervisor is not responding", operation);
        }
        string stop = DaemonControlPaths.stop(spec.pidFile, record.token);
        if (!DaemonControlFiles.absent(stop)) {
            if (!DaemonControlFiles.read(stop).equals(record.token + "\n")) {
                return self.result(125, "unsafe daemon stop capability", operation);
            }
        } else if (!DaemonControlFiles.create(stop, record.token + "\n")) {
            return self.result(125, "failed to create daemon stop capability",
                operation);
        }
        if (!DaemonControlProtocol.waitForRemoval(
                spec.pidFile, record, timeoutMilliseconds)) {
            return self.result(124,
                "daemon did not confirm termination before the deadline",
                operation);
        }
        return self.result(0, "", operation);
    }

    public ExecResult status(DaemonSpec spec) {
        string operation = "daemon status";
        if (!self.validSpec(spec)) {
            return self.result(125, "unsafe daemon specification", operation);
        }
        DaemonControlRecord record = DaemonControlProtocol.record(spec.pidFile);
        if (!record.valid || !DaemonControlProtocol.probe(
                spec.pidFile, record, 1500)) {
            return self.result(1, "daemon supervisor is not responding", operation);
        }
        return self.result(0, "", operation);
    }
}

class AppSpec {
    public string name;
    public string version;

    public AppSpec(string name) {
        self.name = name;
        self.version = "0.0.0";
    }

    public AppSpec withVersion(string version) {
        self.version = version;
        return self;
    }
}

class DaemonApp extends AppSpec {
    public DaemonSpec daemon;

    public DaemonApp(string name, DaemonSpec daemon) {
        self.name = name;
        self.version = "0.0.0";
        self.daemon = daemon;
    }
}
