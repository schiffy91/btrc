import Library.DBus.DBusConnection;
import Library.DBus.DBusMessage;
import Library.FileSystem;
import Library.Platform;
import Library.Process;
import Library.Strings;
import Library.Timer;
import Library.Vector;
import Library.Tray.ITray;
import Library.Tray.TrayModel;

/* The two property values with a shape of their own. */
class TrayVariant {
	class void stringArray(DBusWriter parent) {
		DBusWriter variant = parent.openVariant("as");
		DBusWriter array = variant.openArray("s");
		array.close();
		variant.close();
	}

	/* ToolTip is (icon name, icon pixmaps, title, description). */
	class void toolTip(DBusWriter parent, string icon, string title, string description) {
		DBusWriter variant = parent.openVariant("(sa(iiay)ss)");
		DBusWriter tooltip = variant.openStruct();
		tooltip.appendString(icon);
		DBusWriter pixmaps = tooltip.openArray("(iiay)");
		pixmaps.close();
		tooltip.appendString(title);
		tooltip.appendString(description);
		tooltip.close();
		variant.close();
	}
}

/* StatusNotifierItem plus com.canonical.dbusmenu served over a private
 * session-bus connection of the stdlib's own D-Bus client (Library.DBus):
 * no D-Bus library is linked. The connection is pumped by pull: pump() reads
 * the socket and answers every queued method call itself, so no callback is
 * involved and activations run on the caller's thread after their reply has
 * left. Losing the bus or failing to re-register with a restarted watcher is
 * terminal: pump() and run() throw that failure, as the macOS tray throws its
 * own. */
class LinuxTray implements ITray {
	private Tray _model;
	private DBusConnection _connection;
	private bool _open = false;
	private string _busName;
	private string _iconName;
	private UnixShell _shell;
	private Vector<bool> _checked = [];
	private Vector<string> _texts = [];  /* what each status line's command last printed */
	private bool _attention = false;
	private string _attentionIconName = "";
	private long long _attentionDeadline = 0LL;  /* when the attention commands are asked next */
	private Vector<string> _pendingCommands = [];
	private Vector<int> _pendingProbes = [];  /* submenus shown since the last reply */
	private unsigned int _revision = 1u;
	private bool _quitRequested = false;
	private string _failure = "";

	class string itemPath() { return "/StatusNotifierItem"; }

	/* Menus draw a submenu's arrow right after the widest label; two em spaces keep it off short labels. */
	class string displayLabel(TrayItem entry) { return entry.isSubmenu ? entry.label + "  " : entry.label; }

	class string menuPath() { return "/MenuBar"; }

	class string itemInterface() { return "org.kde.StatusNotifierItem"; }

	class string menuInterface() { return "com.canonical.dbusmenu"; }

	class string watcherName() { return "org.kde.StatusNotifierWatcher"; }

	public LinuxTray(Tray model) {
		self._model = model;
		self._iconName = LinuxTray.resolveIcon(model.iconPath);
		self._shell = UnixShell();
		for entry in model.items {
			self._checked.push(false);
			self._texts.push("");
		}
		if (!model.attentionIconPath.isEmpty()) { self._attentionIconName = LinuxTray.resolveIcon(model.attentionIconPath); }
		DBusConnection? session = DBusConnection.session();
		if (session == null) { throw "No D-Bus session bus"; }
		self._connection = session;
		self._open = true;
		try {
			self._busName = "org.kde.StatusNotifierItem-" + Strings.fromInt(Platform.pid()) + "-" + self.connectionSerial();
			if (!self._connection.ownName(self._busName)) { throw "Cannot own " + self._busName + " on the session bus"; }
			self.probeCheckItems();
			self._attention = self.probeAttention();
			self._attentionDeadline = self.nextAttention();
			/* Listen first: a watcher that is replaced between the registration and this would never be heard of,
			 * and the item would stay off the tray while the process runs on. */
			self.watchWatcher();
			if (!self.registerWithWatcher()) { throw "No StatusNotifierWatcher on the session bus"; }
		} catch (string error) { self.close(); throw error; }
	}

	/* SNI IconName is a theme name or an absolute path; a host resolves a
	 * relative path against its own directory, and a missing file shows
	 * nothing. Resolve against this process, else use the generic icon. */
	class string resolveIcon(string path) {
		string fallback = "application-x-executable";
		if (path == null || path.isEmpty()) { return fallback; }
		string resolved = FileSystem.realPath(path);
		return resolved.isEmpty() ? fallback : resolved;
	}

	/* ":1.54" -> "54": unique per connection, so a closed and reopened tray
	 * never races the bus daemon for the name its old connection still holds. */
	private string connectionSerial() {
		string unique = self._connection.uniqueName();
		int dot = Strings.rfind(unique, ".");
		return dot < 0 ? "1" : unique.substring(dot + 1, unique.len() - dot - 1);
	}

	private bool registerWithWatcher() {
		DBusMessage request = DBusMessage.methodCall(LinuxTray.watcherName(), "/StatusNotifierWatcher", LinuxTray.watcherName(), "RegisterStatusNotifierItem");
		request.writer().appendString(self._busName);
		return self._connection.call(request, 2000) != null;
	}

	/* A restarted watcher (kded/plasmashell crash recovery) forgets every item;
	 * the spec has items re-register when the well-known name changes owner. */
	private void watchWatcher() {
		string rule = "type='signal',sender='org.freedesktop.DBus',interface='org.freedesktop.DBus',member='NameOwnerChanged',arg0='" + LinuxTray.watcherName() + "'";
		if (!self._connection.addMatch(rule)) { throw "Cannot watch the StatusNotifierWatcher"; }
	}

	private void handleWatcherOwnerChange(DBusMessage message) {
		DBusReader arguments = message.reader();
		if (arguments.type() == DBUS_TYPE_INVALID || !arguments.next() || !arguments.next()) { return; }
		string newOwner = arguments.readString();
		if (!newOwner.isEmpty() && !self.registerWithWatcher()) { self.fail("Cannot re-register with the restarted StatusNotifierWatcher"); }
	}

	/* The first line of what a status command printed, without the space around it and
	 * no longer than a menu line should be. A cut never splits a UTF-8 character: the
	 * bus drops a connection that sends it one. */
	class string firstLine(string output) {
		string line = output;
		int end = line.indexOf("\n");
		if (end >= 0) { line = line.substring(0, end); }
		line = line.trim();
		int limit = 120;
		if (line.length() <= limit) { return line; }
		while (limit > 0) {
			int unit = (int)(unsigned char)line[limit];
			if ((unit & 0xC0) != 0x80) { break; }
			limit--;
		}
		return line.substring(0, limit);
	}

	/* What a menu shows for an item: a status line is its label and what its command printed. */
	private string shownLabel(int index) {
		TrayItem entry = self._model.items.get(index);
		string text = self._texts.get(index);
		if (entry.textCommand.isEmpty() || text.isEmpty()) { return LinuxTray.displayLabel(entry); }
		return f"{entry.label}: {text}";
	}

	/* Runs the state and status commands of one menu's items (parent = its dbusmenu id; -1
	 * for every item) and returns the indices whose checkmark or text changed. */
	private Vector<int> probeCheckItems(int parent = -1) {
		Vector<int> changed = [];
		int index = 0;
		for entry in self._model.items {
			bool shown = parent < 0 || entry.parentId == parent;
			if (!entry.stateCommand.isEmpty() && shown) {
				bool checked = self._shell.run(entry.stateCommand, logFailure=false).ok();
				if (checked != self._checked.get(index)) { self._checked.set(index, checked); changed.push(index); }
				if (self._open) { self.drain(0); }  /* a request waits on one command at most */
			}
			if (!entry.textCommand.isEmpty() && shown) {
				string text = LinuxTray.firstLine(self._shell.run(entry.textCommand, logFailure=false).stdout());
				if (!text.equals(self._texts.get(index))) {
					self._texts.set(index, text);
					if (!changed.contains(index)) { changed.push(index); }
				}
				if (self._open) { self.drain(0); }
			}
			index++;
		}
		return changed;
	}

	/* SNI's word for what the icon wants of the user. */
	private string status() { return self._attention ? "NeedsAttention" : "Active"; }

	/* Without an attention icon of its own the tray keeps its icon, and the host marks it. */
	private string attentionIcon() { return self._attentionIconName.isEmpty() ? self._iconName : self._attentionIconName; }

	private long long nextAttention() { return MonotonicClock.deadlineAfter((long long)(self._model.attentionSeconds > 0 ? self._model.attentionSeconds : 1) * 1000LL); }

	/* Whether any attention command exits 0 now. */
	private bool probeAttention() {
		bool asked = false;
		for command in self._model.attentionCommands {
			if (!asked) { asked = self._shell.run(command, logFailure=false).ok(); }
			if (self._open) { self.drain(0); }
		}
		return asked;
	}

	/* Ask the attention commands again and tell the host when the answer changed. */
	private void refreshAttention() {
		if (self._model.attentionCommands.len == 0 || !self._open) { return; }
		self._attentionDeadline = self.nextAttention();
		bool asked = self.probeAttention();
		if (asked == self._attention) { return; }
		self._attention = asked;
		DBusMessage signal = DBusMessage.signal(LinuxTray.itemPath(), LinuxTray.itemInterface(), "NewStatus");
		signal.writer().appendString(self.status());
		self._connection.send(signal);
	}

	public void refreshCheckItems() {
		if (!self._open) { return; }
		self.announceCheckItems(self.probeCheckItems());
	}

	/* ItemsPropertiesUpdated changes checkmarks and status lines in place; a LayoutUpdated
	 * would make the host rebuild, and close, a submenu that is opening. */
	private void announceCheckItems(Vector<int> indices) {
		if (indices.len == 0) { return; }
		DBusMessage signal = DBusMessage.signal(LinuxTray.menuPath(), LinuxTray.menuInterface(), "ItemsPropertiesUpdated");
		DBusWriter arguments = signal.writer();
		DBusWriter updated = arguments.openArray("(ia{sv})");
		for index in indices {
			DBusWriter item = updated.openStruct();
			item.appendInt32(index + 1);
			DBusWriter properties = item.openArray("{sv}");
			TrayItem entry = self._model.items.get(index);
			if (!entry.stateCommand.isEmpty()) { properties.dictInt32("toggle-state", self._checked.get(index) ? 1 : 0); }
			if (!entry.textCommand.isEmpty()) { properties.dictString("label", self.shownLabel(index)); }
			properties.close();
			item.close();
		}
		updated.close();
		DBusWriter removed = arguments.openArray("(ias)");
		removed.close();
		self._connection.send(signal);
	}

	/* A host reads the item's properties once and again only when told they changed. */
	private void announce(string member) {
		if (!self._open) { return; }
		self._connection.send(DBusMessage.signal(LinuxTray.itemPath(), LinuxTray.itemInterface(), member));
	}

	public void setIcon(string path) {
		string resolved = LinuxTray.resolveIcon(path);
		if (resolved.equals(self._iconName)) { return; }
		self._iconName = resolved;
		self.announce("NewIcon");
		if (self._attentionIconName.isEmpty()) { self.announce("NewAttentionIcon"); }
		self.announce("NewToolTip");  /* the tooltip carries the icon too */
	}

	public void setTip(string text) {
		self._model.tooltip = text;
		self.announce("NewToolTip");
	}

	public void quit() { self._quitRequested = true; }

	private void fail(string error) {
		if (self._failure.isEmpty()) { self._failure = error; }
		throw self._failure;
	}

	public bool pump(int timeoutMs) {
		if (!self._failure.isEmpty()) { throw self._failure; }
		if (!self._open || self._quitRequested) { return false; }
		/* A tray that watches for attention wakes when its commands are due, however long it may wait. */
		bool watching = self._model.attentionCommands.len > 0;
		int wait = timeoutMs;
		if (watching) {
			long long due = MonotonicClock.remaining(self._attentionDeadline);
			if (wait < 0 || (long long)wait > due) { wait = (int)due; }
		}
		self.drain(wait);
		/* Work runs after the replies left, so the host never waits on a command. */
		while (self._pendingCommands.len > 0 && !self._quitRequested) {
			string command = self._pendingCommands.get(0);
			self._pendingCommands.remove(0);
			self.activate(command);
		}
		while (self._pendingProbes.len > 0 && !self._quitRequested) {
			int parent = self._pendingProbes.get(0);
			self._pendingProbes.remove(0);
			self.announceCheckItems(self.probeCheckItems(parent));
			/* What stands behind a line may be what the icon asks about: both are fresh when a menu opens. */
			if (self._pendingProbes.len == 0) { self._attentionDeadline = 0LL; }
		}
		if (watching && !self._quitRequested && !MonotonicClock.before(self._attentionDeadline)) { self.refreshAttention(); }
		return !self._quitRequested;
	}

	public void run() {
		if (!self._failure.isEmpty()) { throw self._failure; }
		if (!self._open) { throw "Native tray is closed"; }
		while (self.pump(-1)) {}
	}

	public void close() {
		if (!self._open) { return; }
		self._open = false;
		self._connection.close();
	}

	public void __del__() { self.close(); }

	private void handle(DBusMessage message) {
		if (message.isSignal("org.freedesktop.DBus", "NameOwnerChanged")) { self.handleWatcherOwnerChange(message); return; }
		if (message.type() != DBUS_MESSAGE_TYPE_METHOD_CALL) { return; }
		string path = message.path();
		string iface = message.interfaceName();
		string member = message.member();
		DBusMessage? reply = null;
		if (iface.equals("org.freedesktop.DBus.Introspectable") && member.equals("Introspect")) {
			reply = self.introspectReply(message, path);
		} else if (iface.equals("org.freedesktop.DBus.Properties")) {
			reply = self.propertiesReply(message, path, member);
		} else if (path.equals(LinuxTray.itemPath()) && iface.equals(LinuxTray.itemInterface())) {
			/* ContextMenu and Scroll: the host shows the menu itself. Activate is the click on the icon. */
			if (member.equals("Activate") && !self._model.clickCommand.isEmpty()) { self._pendingCommands.push(self._model.clickCommand); }
			reply = DBusMessage.methodReturn(message);
		} else if (path.equals(LinuxTray.menuPath()) && iface.equals(LinuxTray.menuInterface())) {
			reply = self.menuReply(message, member);
		}
		if (reply == null) { reply = DBusMessage.error(message, "org.freedesktop.DBus.Error.UnknownMethod", "Unknown method on the native tray"); }
		if (!message.noReply()) { self._connection.send(reply); }
	}

	/* Answers whatever arrived without blocking; replies only queue commands and probes. */
	private void drain(int timeoutMs) {
		if (!self._connection.readWrite(timeoutMs)) { self.fail("The D-Bus session bus disconnected"); }
		DBusMessage? message = self._connection.popMessage();
		while (message != null && !self._quitRequested) {
			DBusMessage arrived = message;
			self.handle(arrived);
			message = self._connection.popMessage();
		}
	}

	private void activate(string command) {
		if (command.equals(TraySignal.quit())) { self.quit(); return; }
		self._shell.run(command, stdout=COMMAND_OUTPUT_STREAM, stderr=COMMAND_OUTPUT_STREAM, logFailure=false);
		self.refreshCheckItems();
		self.refreshAttention();
	}

	private DBusMessage introspectReply(DBusMessage message, string path) {
		string body = "";
		if (path.equals(LinuxTray.itemPath())) {
			body = "<interface name=\"org.kde.StatusNotifierItem\">" + "<property name=\"Category\" type=\"s\" access=\"read\"/><property name=\"Id\" type=\"s\" access=\"read\"/>" + "<property name=\"Title\" type=\"s\" access=\"read\"/><property name=\"Status\" type=\"s\" access=\"read\"/>" + "<property name=\"IconName\" type=\"s\" access=\"read\"/><property name=\"AttentionIconName\" type=\"s\" access=\"read\"/><property name=\"IconThemePath\" type=\"s\" access=\"read\"/>" + "<property name=\"ToolTip\" type=\"(sa(iiay)ss)\" access=\"read\"/><property name=\"ItemIsMenu\" type=\"b\" access=\"read\"/>" + "<property name=\"Menu\" type=\"o\" access=\"read\"/>" + "<method name=\"Activate\"><arg name=\"x\" type=\"i\" direction=\"in\"/><arg name=\"y\" type=\"i\" direction=\"in\"/></method>" + "<method name=\"SecondaryActivate\"><arg name=\"x\" type=\"i\" direction=\"in\"/><arg name=\"y\" type=\"i\" direction=\"in\"/></method>" + "<method name=\"ContextMenu\"><arg name=\"x\" type=\"i\" direction=\"in\"/><arg name=\"y\" type=\"i\" direction=\"in\"/></method>" + "<method name=\"Scroll\"><arg name=\"delta\" type=\"i\" direction=\"in\"/><arg name=\"orientation\" type=\"s\" direction=\"in\"/></method>" + "<signal name=\"NewIcon\"/><signal name=\"NewAttentionIcon\"/><signal name=\"NewToolTip\"/><signal name=\"NewStatus\"><arg name=\"status\" type=\"s\"/></signal>" + "</interface>";
		} else if (path.equals(LinuxTray.menuPath())) {
			body = "<interface name=\"com.canonical.dbusmenu\">" + "<property name=\"Version\" type=\"u\" access=\"read\"/><property name=\"Status\" type=\"s\" access=\"read\"/>" + "<property name=\"TextDirection\" type=\"s\" access=\"read\"/><property name=\"IconThemePath\" type=\"as\" access=\"read\"/>" + "<method name=\"GetLayout\"><arg name=\"parentId\" type=\"i\" direction=\"in\"/><arg name=\"recursionDepth\" type=\"i\" direction=\"in\"/>" + "<arg name=\"propertyNames\" type=\"as\" direction=\"in\"/><arg name=\"revision\" type=\"u\" direction=\"out\"/><arg name=\"layout\" type=\"(ia{sv}av)\" direction=\"out\"/></method>" + "<method name=\"GetGroupProperties\"><arg name=\"ids\" type=\"ai\" direction=\"in\"/><arg name=\"propertyNames\" type=\"as\" direction=\"in\"/><arg name=\"properties\" type=\"a(ia{sv})\" direction=\"out\"/></method>" + "<method name=\"GetProperty\"><arg name=\"id\" type=\"i\" direction=\"in\"/><arg name=\"name\" type=\"s\" direction=\"in\"/><arg name=\"value\" type=\"v\" direction=\"out\"/></method>" + "<method name=\"Event\"><arg name=\"id\" type=\"i\" direction=\"in\"/><arg name=\"eventId\" type=\"s\" direction=\"in\"/><arg name=\"data\" type=\"v\" direction=\"in\"/><arg name=\"timestamp\" type=\"u\" direction=\"in\"/></method>" + "<method name=\"EventGroup\"><arg name=\"events\" type=\"a(isvu)\" direction=\"in\"/><arg name=\"idErrors\" type=\"ai\" direction=\"out\"/></method>" + "<method name=\"AboutToShow\"><arg name=\"id\" type=\"i\" direction=\"in\"/><arg name=\"needUpdate\" type=\"b\" direction=\"out\"/></method>" + "<signal name=\"LayoutUpdated\"><arg name=\"revision\" type=\"u\"/><arg name=\"parent\" type=\"i\"/></signal>" + "<signal name=\"ItemsPropertiesUpdated\"><arg name=\"updatedProps\" type=\"a(ia{sv})\"/><arg name=\"removedProps\" type=\"a(ias)\"/></signal>" + "</interface>";
		}
		string xml = "<!DOCTYPE node PUBLIC \"-//freedesktop//DTD D-BUS Object Introspection 1.0//EN\" \"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd\">" + "<node>" + body + "<interface name=\"org.freedesktop.DBus.Introspectable\"><method name=\"Introspect\"><arg name=\"data\" type=\"s\" direction=\"out\"/></method></interface>" + "<interface name=\"org.freedesktop.DBus.Properties\"><method name=\"Get\"><arg type=\"s\" direction=\"in\"/><arg type=\"s\" direction=\"in\"/><arg type=\"v\" direction=\"out\"/></method>" + "<method name=\"GetAll\"><arg type=\"s\" direction=\"in\"/><arg type=\"a{sv}\" direction=\"out\"/></method></interface>" + "</node>";
		DBusMessage reply = DBusMessage.methodReturn(message);
		reply.writer().appendString(xml);
		return reply;
	}

	private DBusMessage? propertiesReply(DBusMessage message, string path, string member) {
		bool item = path.equals(LinuxTray.itemPath());
		bool menu = path.equals(LinuxTray.menuPath());
		if (!item && !menu) { return null; }
		if (member.equals("GetAll")) {
			DBusMessage reply = DBusMessage.methodReturn(message);
			DBusWriter dictionary = reply.writer().openArray("{sv}");
			if (item) {
				dictionary.dictString("Category", "ApplicationStatus");
				dictionary.dictString("Id", self._model.title);
				dictionary.dictString("Title", self._model.title);
				dictionary.dictString("Status", self.status());
				dictionary.dictString("IconName", self._iconName);
				dictionary.dictString("AttentionIconName", self.attentionIcon());
				dictionary.dictString("IconThemePath", "");
				DBusWriter entry = dictionary.openEntry("ToolTip");
				TrayVariant.toolTip(entry, self._iconName, self._model.title, self._model.tooltip);
				entry.close();
				dictionary.dictBool("ItemIsMenu", self._model.clickCommand.isEmpty());
				dictionary.dictObjectPath("Menu", LinuxTray.menuPath());
			} else {
				dictionary.dictUInt32("Version", 3u);
				dictionary.dictString("Status", "normal");
				dictionary.dictString("TextDirection", "ltr");
				DBusWriter entry = dictionary.openEntry("IconThemePath");
				TrayVariant.stringArray(entry);
				entry.close();
			}
			dictionary.close();
			return reply;
		}
		if (!member.equals("Get")) { return null; }
		DBusReader request = message.reader();
		string name = "";
		if (request.type() != DBUS_TYPE_INVALID && request.next()) { name = request.readString(); }
		DBusMessage reply = DBusMessage.methodReturn(message);
		DBusWriter arguments = reply.writer();
		bool known = true;
		if (item) {
			if (name.equals("Category")) { arguments.variantString("ApplicationStatus"); }
			else if (name.equals("Id") || name.equals("Title")) { arguments.variantString(self._model.title); }
			else if (name.equals("Status")) { arguments.variantString(self.status()); }
			else if (name.equals("IconName")) { arguments.variantString(self._iconName); }
			else if (name.equals("AttentionIconName")) { arguments.variantString(self.attentionIcon()); }
			else if (name.equals("IconThemePath")) { arguments.variantString(""); }
			else if (name.equals("ToolTip")) { TrayVariant.toolTip(arguments, self._iconName, self._model.title, self._model.tooltip); }
			else if (name.equals("ItemIsMenu")) { arguments.variantBool(self._model.clickCommand.isEmpty()); }
			else if (name.equals("Menu")) { arguments.variantObjectPath(LinuxTray.menuPath()); }
			else { known = false; }
		} else {
			if (name.equals("Version")) { arguments.variantUInt32(3u); }
			else if (name.equals("Status")) { arguments.variantString("normal"); }
			else if (name.equals("TextDirection")) { arguments.variantString("ltr"); }
			else if (name.equals("IconThemePath")) { TrayVariant.stringArray(arguments); }
			else { known = false; }
		}
		if (known) { return reply; }
		return DBusMessage.error(message, "org.freedesktop.DBus.Error.UnknownProperty", "Unknown property on the native tray");
	}

	/* dbusmenu ids: 0 is the root; items are 1-based in model order. */
	private void appendItemProperties(DBusWriter node, int index) {
		TrayItem entry = self._model.items.get(index);
		DBusWriter properties = node.openArray("{sv}");
		properties.dictString("label", self.shownLabel(index));
		properties.dictBool("enabled", entry.enabled);
		properties.dictBool("visible", true);
		if (entry.isSubmenu) { properties.dictString("children-display", "submenu"); }
		if (!entry.stateCommand.isEmpty()) {
			properties.dictString("toggle-type", entry.isRadio ? "radio" : "checkmark");
			properties.dictInt32("toggle-state", self._checked.get(index) ? 1 : 0);
		}
		properties.close();
	}

	/* Root and nested nodes use the same stable, one-based model ids. */
	private void appendLayoutNode(DBusWriter parent, int id, int depth) {
		DBusWriter node = parent.openStruct();
		node.appendInt32(id);
		if (id == 0) {
			DBusWriter properties = node.openArray("{sv}");
			properties.dictString("children-display", "submenu");
			properties.close();
		} else { self.appendItemProperties(node, id - 1); }
		DBusWriter children = node.openArray("v");
		if (depth != 0) {
			for (int index = 0; index < self._model.items.len; index++) {
				if (self._model.items.get(index).parentId != id) { continue; }
				DBusWriter variant = children.openVariant("(ia{sv}av)");
				self.appendLayoutNode(variant, index + 1, depth < 0 ? -1 : depth - 1);
				variant.close();
			}
		}
		children.close();
		node.close();
	}

	private DBusMessage? layoutReply(DBusMessage message) {
		DBusReader request = message.reader();
		if (request.type() == DBUS_TYPE_INVALID) { return null; }
		int id = request.readInt32();
		if (!request.next()) { return null; }
		int depth = request.readInt32();
		if (id < 0 || id > self._model.items.len) {
			return DBusMessage.error(message, "com.canonical.dbusmenu.Error.InvalidMenuItem", "Unknown menu node");
		}
		DBusMessage reply = DBusMessage.methodReturn(message);
		DBusWriter arguments = reply.writer();
		arguments.appendUInt32(self._revision);
		self.appendLayoutNode(arguments, id, depth);
		return reply;
	}

	private DBusMessage groupPropertiesReply(DBusMessage message) {
		DBusMessage reply = DBusMessage.methodReturn(message);
		DBusWriter array = reply.writer().openArray("(ia{sv})");
		for (int index = 0; index < self._model.items.len; index++) {
			DBusWriter node = array.openStruct();
			node.appendInt32(index + 1);
			self.appendItemProperties(node, index);
			node.close();
		}
		array.close();
		return reply;
	}

	/* One (id, eventId) event: "clicked" on an enabled item queues its
	 * command. False when the id names no menu node. */
	private bool recordEvent(int id, string event) {
		if (id == 0) { return true; }
		int index = id - 1;
		if (index < 0 || index >= self._model.items.len) { return false; }
		TrayItem entry = self._model.items.get(index);
		if (event.equals("clicked") && entry.enabled && !entry.isSubmenu) { self._pendingCommands.push(entry.command); }
		return true;
	}

	/* Event(id, eventId, data, timestamp). */
	private DBusMessage? eventReply(DBusMessage message) {
		DBusReader request = message.reader();
		if (request.type() == DBUS_TYPE_INVALID) { return null; }
		int id = request.readInt32();
		if (!request.next()) { return null; }
		self.recordEvent(id, request.readString());
		return DBusMessage.methodReturn(message);
	}

	/* EventGroup(a(isvu) events) -> ai idErrors: libdbusmenu hosts send
	 * clicks here and fall back to Event only on UnknownMethod. */
	private DBusMessage? eventGroupReply(DBusMessage message) {
		DBusReader request = message.reader();
		if (request.type() != DBUS_TYPE_ARRAY) { return null; }
		Vector<int> unknown = [];
		DBusReader events = request.recurse();
		while (events.type() == DBUS_TYPE_STRUCT) {
			DBusReader event = events.recurse();
			int id = event.readInt32();
			string name = event.next() ? event.readString() : "";
			if (!self.recordEvent(id, name)) { unknown.push(id); }
			events.next();
		}
		DBusMessage reply = DBusMessage.methodReturn(message);
		DBusWriter errors = reply.writer().openArray("i");
		for id in unknown { errors.appendInt32(id); }
		errors.close();
		return reply;
	}

	/* GetProperty(id, name) -> v, typed as GetLayout reports the same property. */
	private DBusMessage propertyReply(DBusMessage message) {
		DBusReader request = message.reader();
		int id = -1;
		string name = "";
		if (request.type() != DBUS_TYPE_INVALID) {
			id = request.readInt32();
			if (request.next()) { name = request.readString(); }
		}
		DBusMessage reply = DBusMessage.methodReturn(message);
		if (self.appendMenuProperty(reply.writer(), id, name)) { return reply; }
		return DBusMessage.error(message, "org.freedesktop.DBus.Error.UnknownProperty", "Unknown menu property on the native tray");
	}

	private bool appendMenuProperty(DBusWriter arguments, int id, string name) {
		if (id == 0) {
			if (!name.equals("children-display")) { return false; }
			arguments.variantString("submenu");
			return true;
		}
		int index = id - 1;
		if (index < 0 || index >= self._model.items.len) { return false; }
		TrayItem entry = self._model.items.get(index);
		bool checkable = !entry.stateCommand.isEmpty();
		if (name.equals("label")) { arguments.variantString(self.shownLabel(index)); }
		else if (name.equals("enabled")) { arguments.variantBool(entry.enabled); }
		else if (name.equals("visible")) { arguments.variantBool(true); }
		else if (name.equals("children-display") && entry.isSubmenu) { arguments.variantString("submenu"); }
		else if (name.equals("toggle-type") && checkable) { arguments.variantString(entry.isRadio ? "radio" : "checkmark"); }
		else if (name.equals("toggle-state") && checkable) { arguments.variantInt32(self._checked.get(index) ? 1 : 0); }
		else { return false; }
		return true;
	}

	private DBusMessage? menuReply(DBusMessage message, string member) {
		if (member.equals("GetLayout")) { return self.layoutReply(message); }
		if (member.equals("GetGroupProperties")) { return self.groupPropertiesReply(message); }
		if (member.equals("Event")) { return self.eventReply(message); }
		if (member.equals("EventGroup")) { return self.eventGroupReply(message); }
		if (member.equals("GetProperty")) { return self.propertyReply(message); }
		if (member.equals("AboutToShow")) {
			/* Answer at once from the cached states: hosts drop a submenu whose AboutToShow is
			 * slow, then open it only on the next pointer move. Its states refresh after the reply. */
			DBusReader request = message.reader();
			if (request.type() != DBUS_TYPE_INVALID) {
				int id = request.readInt32();
				if (!self._pendingProbes.contains(id)) { self._pendingProbes.push(id); }
			}
			DBusMessage reply = DBusMessage.methodReturn(message);
			reply.writer().appendBool(false);
			return reply;
		}
		return null;
	}
}
