/* btrc standard library — Tray
 *
 * SystemTray builds the portable TrayModel and shows it through the ITray the
 * package selects for the compilation target (TrayProvider).
 */

import Library.Tray.ITray;
import Library.Tray.TrayModel;

class SystemTray {
	public Tray model;
	private ITray? _provider;

	public SystemTray(string title) { self.model = Tray(title); }

	class SystemTray fromTray(Tray tray) { var result = SystemTray(tray.title); result.model = tray; return result; }

	public SystemTray icon(string path) { self.model.icon(path); return self; }

	public SystemTray tip(string text) { self.model.tip(text); return self; }

	public SystemTray item(string label, string command) { self.model.item(label, command); return self; }

	public SystemTray checkItem(string label, string command, string stateCommand) { self.model.checkItem(label, command, stateCommand); return self; }

	public SystemTray add(TrayItem item) { self.model.add(item); return self; }

	public bool available() { return self._provider != null; }

	/* Create the native item and menu once; native failure throws. */
	public void show() { if (self._provider == null) { self._provider = TrayProvider.create(self.model); } }

	public bool pump(int timeoutMs) { return self._provider != null && self._provider.pump(timeoutMs); }

	public void refreshCheckItems() { if (self._provider != null) { self._provider.refreshCheckItems(); } }

	public void run() { self.show(); if (self._provider != null) { self._provider.run(); } }

	public void quit() { if (self._provider != null) { self._provider.quit(); } }

	public void close() { if (self._provider != null) { self._provider.close(); self._provider = null; } }

	public void __del__() { self.close(); }
}
