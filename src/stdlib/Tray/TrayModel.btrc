/* The declarative tray model every platform tray renders. */

import Library.Vector;

class TrayItem {
	public string label;
	public string command;
	public bool enabled;
	public int parentId;
	public bool isSubmenu;
	public bool isRadio;
	public string stateCommand;  /* non-empty: exit 0 renders a checkmark */
	public string textCommand;  /* non-empty: the text is the label and the first line this prints */

	public TrayItem(string label, string command) {
		self.label = label;
		self.command = command;
		self.enabled = true;
		self.parentId = 0;
		self.isSubmenu = false;
		self.isRadio = false;
		self.stateCommand = "";
		self.textCommand = "";
	}

	public TrayItem disabled() {
		self.enabled = false;
		return self;
	}
}

class Tray {
	public string title;
	public string tooltip;
	public string iconPath;
	public string clickCommand;
	public Vector<TrayItem> items;
	public Vector<string> attentionCommands;  /* the icon asks for attention while any of these exits 0 */
	public string attentionIconPath;  /* what it shows then; empty keeps the icon */
	public int attentionSeconds;  /* how often the commands are asked while the tray runs */

	public Tray(string title) {
		self.title = title;
		self.tooltip = title;
		self.iconPath = "";
		self.clickCommand = "";
		self.items = [];
		self.attentionCommands = [];
		self.attentionIconPath = "";
		self.attentionSeconds = 5;
	}

	public Tray icon(string path) {
		self.iconPath = path;
		return self;
	}

	public Tray tip(string text) {
		self.tooltip = text;
		return self;
	}

	/* What a click on the icon itself runs. With one, a host that tells the two clicks apart
	 * (Linux) opens the menu on the secondary click only. macOS opens a status item's menu on
	 * every click, so the command is not used there: give it a menu item as well. */
	public Tray onClick(string command) {
		self.clickCommand = command;
		return self;
	}

	public Tray item(string label, string command) {
		self.items.push(TrayItem(label, command));
		return self;
	}

	/* A checkable item: the mark mirrors stateCommand's exit status (0 = on),
     * probed when the menu is realized and again after each activation. */
	public Tray checkItem(string label, string command, string stateCommand, bool radio = false) {
		TrayItem entry = TrayItem(label, command);
		entry.stateCommand = stateCommand;
		entry.isRadio = radio;
		self.items.push(entry);
		return self;
	}

	/* Radio state is supplied by one mutually exclusive external setting. */
	public Tray radioItem(string label, string command, string stateCommand) { return self.checkItem(label, command, stateCommand, radio=true); }

	/* A line of status: `label: ` and the first line `command` prints, or the
	 * label alone when it prints nothing. The command runs when the tray is
	 * shown and again each time the menu that holds the line opens; choosing
	 * the line does nothing. With an attentionCommand the icon also asks for
	 * attention while that command exits 0 (see attention). */
	public Tray status(string label, string command, string attentionCommand = "") {
		TrayItem entry = TrayItem(label, "");
		entry.textCommand = command;
		entry.enabled = false;
		self.items.push(entry);
		if (!attentionCommand.isEmpty()) { self.attentionCommands.push(attentionCommand); }
		return self;
	}

	/* The icon asks for attention while `command` exits 0, and stops when it
	 * no longer does. Every such command of the tray is asked when the tray
	 * is shown, every attentionSeconds while it runs, when a menu opens and
	 * after an item is chosen; one that exits 0 is enough. */
	public Tray attention(string command) {
		if (!command.isEmpty()) { self.attentionCommands.push(command); }
		return self;
	}

	/* The icon to show while the tray asks for attention. */
	public Tray attentionIcon(string path) {
		self.attentionIconPath = path;
		return self;
	}

	public Tray add(TrayItem item) {
		self.items.push(item);
		return self;
	}

	public Tray submenu(string label, Tray menu) {
		int parentId = self.items.len + 1;
		var parent = TrayItem(label, "");
		parent.isSubmenu = true;
		self.items.push(parent);
		for entry in menu.items {
			var child = TrayItem(entry.label, entry.command);
			child.enabled = entry.enabled;
			child.stateCommand = entry.stateCommand;
			child.textCommand = entry.textCommand;
			child.isSubmenu = entry.isSubmenu;
			child.isRadio = entry.isRadio;
			child.parentId = parentId + entry.parentId;
			self.items.push(child);
		}
		/* A status line in a submenu asks for the same icon's attention. */
		for command in menu.attentionCommands { self.attentionCommands.push(command); }
		return self;
	}
}

class TraySignal {
	class string quit() { return "__quit__"; }
}
