import std.io;
import std.map;
import std.strings;
import std.vector;

class JsonObject {
    public Map<string, string> values;
    public Map<string, bool> quoted;

    public JsonObject() {
        self.values = {};
        self.quoted = {};
    }

    class string escape(string text) {
        if (text == null) { return ""; }
        var escaped = Strings.replace(text, "\\", "\\\\");
        escaped = Strings.replace(escaped, "\"", "\\\"");
        escaped = Strings.replace(escaped, "\n", "\\n");
        escaped = Strings.replace(escaped, "\r", "\\r");
        escaped = Strings.replace(escaped, "\t", "\\t");
        return escaped;
    }

    class string unescape(string text) {
        return JsonText.unescape(text);
    }

    public void setString(string key, string value) {
        self.values.put(key, value);
        self.quoted.put(key, true);
    }

    public void setRaw(string key, string value) {
        self.values.put(key, value);
        self.quoted.put(key, false);
    }

    public void setBool(string key, bool value) {
        self.values.put(key, value ? "true" : "false");
        self.quoted.put(key, false);
    }

    public void setInt(string key, int value) {
        self.values.put(key, Strings.fromInt(value));
        self.quoted.put(key, false);
    }

    public bool has(string key) {
        return self.values.has(key);
    }

    public string getString(string key, string fallback) {
        if (!self.values.has(key)) { return fallback; }
        return self.values.get(key);
    }

    public bool getBool(string key, bool fallback) {
        if (!self.values.has(key)) { return fallback; }
        var value = self.values.get(key);
        if (value.equals("true")) { return true; }
        if (value.equals("false")) { return false; }
        return fallback;
    }

    public int getInt(string key, int fallback) {
        if (!self.values.has(key)) { return fallback; }
        var raw = self.values.get(key);
        if (!JsonText.isInt(raw)) { return fallback; }
        return Strings.toInt(raw);
    }

    public string stringify() {
        Vector<string> fields = [];
        for key, value in self.values {
            var escapedKey = JsonObject.escape(key);
            var field = "\"" + escapedKey + "\":";
            if (self.quoted.getOrDefault(key, true)) {
                var escapedValue = JsonObject.escape(value);
                field += "\"" + escapedValue + "\"";
            } else {
                field += value;
            }
            fields.push(field);
        }
        return "{" + fields.join(",") + "}";
    }

    class int skipSpaces(string text, int i) {
        return JsonText.skipSpaces(text, i);
    }

    class bool isInt(string text) {
        return JsonText.isInt(text);
    }

    class string slice(string text, int start, int end) {
        return JsonText.slice(text, start, end);
    }

    class int stringEnd(string text, int start) {
        return JsonText.stringEnd(text, start);
    }

    /* Depth-aware single-level parse: only depth-1 strings followed by ':'
     * become keys; nested objects/arrays are captured whole as raw values
     * (re-parse them with JsonObject.parse or query via JsonText). */
    class JsonObject parse(string text) {
        var json = JsonObject();
        var len = text.len();
        var depth = 0;
        var i = 0;
        while (i < len) {
            i = JsonText.skipSpaces(text, i);
            if (i >= len) { break; }
            char c = text[i];
            if (c == '{' || c == '[') {
                depth++;
                i++;
                continue;
            }
            if (c == '}' || c == ']') {
                depth--;
                i++;
                continue;
            }
            if (c != (char)34 || depth != 1) {
                i++;
                continue;
            }
            var keyStart = i + 1;
            var keyEnd = JsonText.stringEnd(text, keyStart);
            var afterKey = JsonText.skipSpaces(text, keyEnd + 1);
            if (afterKey >= len || text[afterKey] != ':') {
                i = keyEnd + 1;
                continue;
            }
            var key = JsonText.unescape(JsonText.slice(text, keyStart, keyEnd));
            i = JsonText.skipSpaces(text, afterKey + 1);
            if (i >= len) { break; }
            if (text[i] == (char)34) {
                var valueStart = i + 1;
                var valueEnd = JsonText.stringEnd(text, valueStart);
                json.setString(key, JsonText.unescape(JsonText.slice(text, valueStart, valueEnd)));
                i = valueEnd + 1;
            } else if (text[i] == '{' || text[i] == '[') {
                var valueEnd = JsonText.balancedEnd(text, i);
                json.setRaw(key, JsonText.slice(text, i, valueEnd));
                i = valueEnd;
            } else {
                var valueStart = i;
                while (i < len && text[i] != ',' && text[i] != '}') { i++; }
                var valueEnd = i;
                while (valueEnd > valueStart && (text[valueEnd - 1] == ' ' || text[valueEnd - 1] == '\n' || text[valueEnd - 1] == '\t' || text[valueEnd - 1] == '\r')) {
                    valueEnd--;
                }
                json.setRaw(key, JsonText.slice(text, valueStart, valueEnd));
            }
        }
        return json;
    }

    class JsonObject readFile(string path) {
        return JsonObject.parse(Path.readAll(path));
    }

    public void writeFile(string path) {
        Path.writeAll(path, self.stringify());
    }
}

/* ---------------------------------------------------------------------------
 * JsonValue: a real recursive JSON tree.
 *
 * A JsonValue is exactly one of: null, bool, number, string, array, object.
 * The active variant is recorded by `tag`:
 *     0 NULL   1 BOOL   2 NUMBER   3 STRING   4 ARRAY   5 OBJECT   6 ERROR
 * ERROR is the sentinel returned by parse() on malformed input; it answers
 * true to isNull() (so callers that only check isNull stay safe) but can be
 * distinguished with isError().
 *
 * Payload fields (only the ones relevant to `tag` are meaningful):
 *     boolVal   : BOOL
 *     numVal    : NUMBER, stored as a C double; numIsInt records whether the
 *                 source token had no fraction/exponent (so isInt()/asInt()
 *                 round-trip integers losslessly within double's 2^53 range).
 *     strVal    : STRING (decoded — escapes already resolved)
 *     arr       : ARRAY elements, in order
 *     objKeys   : OBJECT keys, in insertion order (decoded)
 *     objVals   : OBJECT values, parallel to objKeys
 *
 * ARC: arr / objVals are Vector<JsonValue> fields, so when a JsonValue is
 * destroyed the framework releases the vectors, which release every child
 * JsonValue — the whole tree tears down recursively with no manual walk.
 * The collections are always allocated in the constructor so release is
 * well-defined regardless of tag.
 * --------------------------------------------------------------------------- */
class JsonValue {
    public int tag;
    public bool boolVal;
    public double numVal;
    public bool numIsInt;
    public string strVal;
    public Vector<JsonValue> arr;
    public Vector<string> objKeys;
    public Vector<JsonValue> objVals;

    public JsonValue() {
        self.tag = 0;
        self.boolVal = false;
        self.numVal = 0.0;
        self.numIsInt = true;
        self.strVal = "";
        self.arr = [];
        self.objKeys = [];
        self.objVals = [];
    }

    public void __del__() {
        /* arr / objVals (Vector<JsonValue>) release their children here. */
    }

    /* ---- Factories ------------------------------------------------------ */

    class JsonValue makeNull() {
        var v = JsonValue();
        v.tag = 0;
        return v;
    }

    class JsonValue makeError() {
        var v = JsonValue();
        v.tag = 6;
        return v;
    }

    class JsonValue makeBool(bool b) {
        var v = JsonValue();
        v.tag = 1;
        v.boolVal = b;
        return v;
    }

    class JsonValue makeInt(int n) {
        var v = JsonValue();
        v.tag = 2;
        v.numVal = (double)n;
        v.numIsInt = true;
        return v;
    }

    class JsonValue makeFloat(double d) {
        var v = JsonValue();
        v.tag = 2;
        v.numVal = d;
        v.numIsInt = false;
        return v;
    }

    class JsonValue makeString(string s) {
        var v = JsonValue();
        v.tag = 3;
        v.strVal = (s == null) ? "" : s;
        return v;
    }

    class JsonValue makeArray() {
        var v = JsonValue();
        v.tag = 4;
        return v;
    }

    class JsonValue makeObject() {
        var v = JsonValue();
        v.tag = 5;
        return v;
    }

    /* ---- Builders (for constructing trees in code) --------------------- */

    public void push(JsonValue child) {
        self.arr.push(child);
    }

    public void set(string key, JsonValue value) {
        for (int i = 0; i < self.objKeys.len; i++) {
            if (self.objKeys.get(i).equals(key)) {
                self.objVals.set(i, value);
                return;
            }
        }
        self.objKeys.push(key);
        self.objVals.push(value);
    }

    /* ---- Kind predicates ---------------------------------------------- */

    public int kind() { return self.tag; }
    public bool isNull() { return self.tag == 0 || self.tag == 6; }
    public bool isError() { return self.tag == 6; }
    public bool isBool() { return self.tag == 1; }
    public bool isNumber() { return self.tag == 2; }
    public bool isString() { return self.tag == 3; }
    public bool isArray() { return self.tag == 4; }
    public bool isObject() { return self.tag == 5; }
    public bool isInt() { return self.tag == 2 && self.numIsInt; }

    /* ---- Accessors with safe defaults --------------------------------- */

    public bool asBool() {
        if (self.tag == 1) { return self.boolVal; }
        return false;
    }

    public int asInt() {
        if (self.tag == 2) { return (int)self.numVal; }
        return 0;
    }

    public double asFloat() {
        if (self.tag == 2) { return self.numVal; }
        return 0.0;
    }

    public string asString() {
        if (self.tag == 3) { return self.strVal; }
        return "";
    }

    /* size(): element count for arrays, key count for objects, else 0. */
    public int size() {
        if (self.tag == 4) { return self.arr.len; }
        if (self.tag == 5) { return self.objKeys.len; }
        return 0;
    }

    /* at(i): array element, or a null JsonValue if out of range / not array. */
    public JsonValue at(int i) {
        if (self.tag == 4 && i >= 0 && i < self.arr.len) {
            return self.arr.get(i);
        }
        return JsonValue.makeNull();
    }

    /* get(key): object member, or a null JsonValue if absent / not object. */
    public JsonValue get(string key) {
        if (self.tag == 5) {
            for (int i = 0; i < self.objKeys.len; i++) {
                if (self.objKeys.get(i).equals(key)) {
                    return self.objVals.get(i);
                }
            }
        }
        return JsonValue.makeNull();
    }

    public bool has(string key) {
        if (self.tag != 5) { return false; }
        for (int i = 0; i < self.objKeys.len; i++) {
            if (self.objKeys.get(i).equals(key)) { return true; }
        }
        return false;
    }

    /* keys(): a fresh Vector<string> of object keys (empty if not an object). */
    public Vector<string> keys() {
        Vector<string> result = [];
        if (self.tag == 5) {
            for (int i = 0; i < self.objKeys.len; i++) {
                result.push(self.objKeys.get(i));
            }
        }
        return result;
    }

    /* ---- Parsing ------------------------------------------------------- */

    /* Full recursive-descent parse. Returns an ERROR sentinel JsonValue on
     * malformed input (never crashes). Trailing non-whitespace is rejected. */
    class JsonValue parse(string text) {
        if (text == null) { return JsonValue.makeError(); }
        var p = JsonParser(text);
        var value = p.parseValue();
        if (!p.ok) { return JsonValue.makeError(); }
        p.skipWs();
        if (p.pos < p.len) { return JsonValue.makeError(); }
        return value;
    }

    class JsonValue readFile(string path) {
        return JsonValue.parse(Path.readAll(path));
    }

    /* ---- Stringify ----------------------------------------------------- */

    public string stringify() {
        if (self.tag == 0) { return "null"; }
        if (self.tag == 6) { return "null"; }
        if (self.tag == 1) { return self.boolVal ? "true" : "false"; }
        if (self.tag == 2) { return JsonNum.format(self.numVal, self.numIsInt); }
        if (self.tag == 3) { return "\"" + JsonValue.encodeString(self.strVal) + "\""; }
        if (self.tag == 4) {
            Vector<string> parts = [];
            for (int i = 0; i < self.arr.len; i++) {
                parts.push(self.arr.get(i).stringify());
            }
            return "[" + parts.join(",") + "]";
        }
        if (self.tag == 5) {
            Vector<string> parts = [];
            for (int i = 0; i < self.objKeys.len; i++) {
                var field = "\"" + JsonValue.encodeString(self.objKeys.get(i)) + "\":";
                field += self.objVals.get(i).stringify();
                parts.push(field);
            }
            return "{" + parts.join(",") + "}";
        }
        return "null";
    }

    /* Escape a string for JSON output, including all control chars < 0x20
     * (emitted as \uXXXX) so the result is always valid JSON. */
    class string encodeString(string text) {
        if (text == null) { return ""; }
        var out = "";
        var n = text.len();
        for (int i = 0; i < n; i++) {
            char c = text[i];
            int code = (int)((unsigned char)c);
            if (c == (char)34) { out += "\\\""; }
            else if (c == '\\') { out += "\\\\"; }
            else if (c == '\n') { out += "\\n"; }
            else if (c == '\r') { out += "\\r"; }
            else if (c == '\t') { out += "\\t"; }
            else if (code == 8) { out += "\\b"; }
            else if (code == 12) { out += "\\f"; }
            else if (code < 32) { out += JsonNum.uEscape(code); }
            else { out += text.substring(i, 1); }
        }
        return out;
    }
}

/* Stateful recursive-descent cursor over the source text. On any malformed
 * token it sets ok=false and stops; callers check ok. */
class JsonParser {
    public string text;
    public int pos;
    public int len;
    public bool ok;

    public JsonParser(string text) {
        self.text = text;
        self.pos = 0;
        self.len = text.len();
        self.ok = true;
    }

    public void skipWs() {
        while (self.pos < self.len) {
            char c = self.text[self.pos];
            if (c == ' ' || c == '\n' || c == '\t' || c == '\r') { self.pos++; }
            else { break; }
        }
    }

    public JsonValue parseValue() {
        self.skipWs();
        if (self.pos >= self.len) { self.ok = false; return JsonValue.makeError(); }
        char c = self.text[self.pos];
        if (c == '{') { return self.parseObject(); }
        if (c == '[') { return self.parseArray(); }
        if (c == (char)34) { return self.parseStringValue(); }
        if (c == 't' || c == 'f') { return self.parseBool(); }
        if (c == 'n') { return self.parseNull(); }
        if (c == '-' || (c >= '0' && c <= '9')) { return self.parseNumber(); }
        self.ok = false;
        return JsonValue.makeError();
    }

    public JsonValue parseObject() {
        var obj = JsonValue.makeObject();
        self.pos++;  /* consume '{' */
        self.skipWs();
        if (self.pos < self.len && self.text[self.pos] == '}') {
            self.pos++;
            return obj;
        }
        while (true) {
            self.skipWs();
            if (self.pos >= self.len || self.text[self.pos] != (char)34) {
                self.ok = false; return obj;
            }
            var key = self.readString();
            if (!self.ok) { return obj; }
            self.skipWs();
            if (self.pos >= self.len || self.text[self.pos] != ':') {
                self.ok = false; return obj;
            }
            self.pos++;  /* consume ':' */
            var value = self.parseValue();
            if (!self.ok) { return obj; }
            obj.set(key, value);
            self.skipWs();
            if (self.pos >= self.len) { self.ok = false; return obj; }
            char d = self.text[self.pos];
            if (d == ',') { self.pos++; continue; }
            if (d == '}') { self.pos++; return obj; }
            self.ok = false; return obj;
        }
        return obj;
    }

    public JsonValue parseArray() {
        var arr = JsonValue.makeArray();
        self.pos++;  /* consume '[' */
        self.skipWs();
        if (self.pos < self.len && self.text[self.pos] == ']') {
            self.pos++;
            return arr;
        }
        while (true) {
            var value = self.parseValue();
            if (!self.ok) { return arr; }
            arr.push(value);
            self.skipWs();
            if (self.pos >= self.len) { self.ok = false; return arr; }
            char d = self.text[self.pos];
            if (d == ',') { self.pos++; continue; }
            if (d == ']') { self.pos++; return arr; }
            self.ok = false; return arr;
        }
        return arr;
    }

    public JsonValue parseStringValue() {
        var s = self.readString();
        if (!self.ok) { return JsonValue.makeError(); }
        return JsonValue.makeString(s);
    }

    /* Read a quoted string at self.pos, decoding escapes; advances past the
     * closing quote. Sets ok=false on an unterminated or invalid escape. */
    public string readString() {
        self.pos++;  /* consume opening '"' */
        var out = "";
        while (self.pos < self.len) {
            char c = self.text[self.pos];
            if (c == (char)34) { self.pos++; return out; }
            if (c == '\\') {
                self.pos++;
                if (self.pos >= self.len) { self.ok = false; return out; }
                char e = self.text[self.pos];
                if (e == (char)34) { out += "\""; }
                else if (e == '\\') { out += "\\"; }
                else if (e == '/') { out += "/"; }
                else if (e == 'n') { out += "\n"; }
                else if (e == 'r') { out += "\r"; }
                else if (e == 't') { out += "\t"; }
                else if (e == 'b') { out += JsonNum.charFromCode(8); }
                else if (e == 'f') { out += JsonNum.charFromCode(12); }
                else if (e == 'u') {
                    var cp = self.readHex4();
                    if (!self.ok) { return out; }
                    /* High surrogate: combine with a following \uXXXX low
                     * surrogate into one code point (BMP-pair → astral). */
                    if (cp >= 0xD800 && cp <= 0xDBFF) {
                        if (self.pos + 2 < self.len && self.text[self.pos + 1] == '\\'
                                && self.text[self.pos + 2] == 'u') {
                            self.pos += 2;
                            var lo = self.readHex4();
                            if (!self.ok) { return out; }
                            if (lo >= 0xDC00 && lo <= 0xDFFF) {
                                cp = 0x10000 + ((cp - 0xD800) * 0x400) + (lo - 0xDC00);
                            } else {
                                /* Unpaired: emit U+FFFD for both. */
                                out += JsonNum.utf8(0xFFFD);
                                cp = lo;
                            }
                        } else {
                            cp = 0xFFFD;  /* lone high surrogate */
                        }
                    } else if (cp >= 0xDC00 && cp <= 0xDFFF) {
                        cp = 0xFFFD;  /* lone low surrogate */
                    }
                    out += JsonNum.utf8(cp);
                } else {
                    self.ok = false; return out;
                }
                self.pos++;
                continue;
            }
            out += self.text.substring(self.pos, 1);
            self.pos++;
        }
        self.ok = false;  /* unterminated */
        return out;
    }

    /* Read exactly 4 hex digits starting just after the 'u'; leaves self.pos
     * on the last hex digit so the caller's pos++ moves past it. */
    public int readHex4() {
        var value = 0;
        for (int k = 0; k < 4; k++) {
            self.pos++;
            if (self.pos >= self.len) { self.ok = false; return 0; }
            char h = self.text[self.pos];
            var digit = -1;
            if (h >= '0' && h <= '9') { digit = (int)(h - '0'); }
            else if (h >= 'a' && h <= 'f') { digit = (int)(h - 'a') + 10; }
            else if (h >= 'A' && h <= 'F') { digit = (int)(h - 'A') + 10; }
            else { self.ok = false; return 0; }
            value = value * 16 + digit;
        }
        return value;
    }

    public JsonValue parseBool() {
        if (self.matchLiteral("true")) { return JsonValue.makeBool(true); }
        if (self.matchLiteral("false")) { return JsonValue.makeBool(false); }
        self.ok = false; return JsonValue.makeError();
    }

    public JsonValue parseNull() {
        if (self.matchLiteral("null")) { return JsonValue.makeNull(); }
        self.ok = false; return JsonValue.makeError();
    }

    public bool matchLiteral(string word) {
        var n = word.len();
        if (self.pos + n > self.len) { return false; }
        for (int k = 0; k < n; k++) {
            if (self.text[self.pos + k] != word[k]) { return false; }
        }
        self.pos += n;
        return true;
    }

    public JsonValue parseNumber() {
        var start = self.pos;
        var isFloat = false;
        if (self.pos < self.len && self.text[self.pos] == '-') { self.pos++; }
        /* integer part */
        if (self.pos >= self.len) { self.ok = false; return JsonValue.makeError(); }
        if (self.text[self.pos] == '0') {
            self.pos++;
        } else if (self.text[self.pos] >= '1' && self.text[self.pos] <= '9') {
            while (self.pos < self.len && self.text[self.pos] >= '0' && self.text[self.pos] <= '9') {
                self.pos++;
            }
        } else {
            self.ok = false; return JsonValue.makeError();
        }
        /* fraction */
        if (self.pos < self.len && self.text[self.pos] == '.') {
            isFloat = true;
            self.pos++;
            if (self.pos >= self.len || self.text[self.pos] < '0' || self.text[self.pos] > '9') {
                self.ok = false; return JsonValue.makeError();
            }
            while (self.pos < self.len && self.text[self.pos] >= '0' && self.text[self.pos] <= '9') {
                self.pos++;
            }
        }
        /* exponent */
        if (self.pos < self.len && (self.text[self.pos] == 'e' || self.text[self.pos] == 'E')) {
            isFloat = true;
            self.pos++;
            if (self.pos < self.len && (self.text[self.pos] == '+' || self.text[self.pos] == '-')) {
                self.pos++;
            }
            if (self.pos >= self.len || self.text[self.pos] < '0' || self.text[self.pos] > '9') {
                self.ok = false; return JsonValue.makeError();
            }
            while (self.pos < self.len && self.text[self.pos] >= '0' && self.text[self.pos] <= '9') {
                self.pos++;
            }
        }
        var token = self.text.substring(start, self.pos - start);
        var d = JsonNum.toDouble(token);
        if (isFloat) { return JsonValue.makeFloat(d); }
        var v = JsonValue.makeInt(0);
        v.numVal = d;
        v.numIsInt = true;
        return v;
    }
}

/* Numeric / byte helpers kept apart from the tree so the tree stays focused. */
class JsonNum {
    /* Parse a numeric token to a double via C strtod. */
    class double toDouble(string token) {
        double result = strtod(token, NULL);
        return result;
    }

    /* Format a number for JSON output. Integers print without a decimal
     * point; floats print with %.17g (full round-trip precision for IEEE
     * double) then collapse to the shortest form via re-parsing isn't done —
     * %.17g guarantees parse(stringify(v)) == v for the double value. */
    class string format(double value, bool isInt) {
        if (isInt) {
            char* buf = (char*)malloc(32);
            snprintf(buf, 32, "%lld", (long long)value);
            return buf;
        }
        char* buf = (char*)malloc(40);
        snprintf(buf, 40, "%.17g", value);
        return buf;
    }

    /* A one-byte string for a control char code (0..255). */
    class string charFromCode(int code) {
        char* buf = (char*)malloc(2);
        buf[0] = (char)code;
        buf[1] = (char)0;
        return buf;
    }

    /* \uXXXX escape for a code < 0x10000 (used for control chars on output). */
    class string uEscape(int code) {
        char* buf = (char*)malloc(8);
        snprintf(buf, 8, "\\u%04x", code);
        return buf;
    }

    /* Encode a Unicode code point as a UTF-8 byte string. */
    class string utf8(int cp) {
        if (cp < 0) { cp = 0xFFFD; }
        if (cp < 0x80) {
            char* b = (char*)malloc(2);
            b[0] = (char)cp;
            b[1] = (char)0;
            return b;
        }
        if (cp < 0x800) {
            char* b = (char*)malloc(3);
            b[0] = (char)(0xC0 | (cp >> 6));
            b[1] = (char)(0x80 | (cp & 0x3F));
            b[2] = (char)0;
            return b;
        }
        if (cp < 0x10000) {
            char* b = (char*)malloc(4);
            b[0] = (char)(0xE0 | (cp >> 12));
            b[1] = (char)(0x80 | ((cp >> 6) & 0x3F));
            b[2] = (char)(0x80 | (cp & 0x3F));
            b[3] = (char)0;
            return b;
        }
        char* b = (char*)malloc(5);
        b[0] = (char)(0xF0 | (cp >> 18));
        b[1] = (char)(0x80 | ((cp >> 12) & 0x3F));
        b[2] = (char)(0x80 | ((cp >> 6) & 0x3F));
        b[3] = (char)(0x80 | (cp & 0x3F));
        b[4] = (char)0;
        return b;
    }
}

class JsonText {
    class string slice(string text, int start, int end) {
        return text.substring(start, end - start);
    }

    class string unescape(string text) {
        var result = "";
        var escaped = false;
        for i in range(text.len()) {
            var current = text.substring(i, 1);
            if (escaped) {
                if (current.equals("n")) { result += "\n"; }
                else if (current.equals("r")) { result += "\r"; }
                else if (current.equals("t")) { result += "\t"; }
                else { result += current; }
                escaped = false;
                continue;
            }
            if (current.equals("\\")) {
                escaped = true;
                continue;
            }
            result += current;
        }
        if (escaped) { result += "\\"; }
        return result;
    }

    class int stringEnd(string text, int start) {
        var len = text.len();
        var escaped = false;
        var i = start;
        while (i < len) {
            if (!escaped && text[i] == (char)34) { return i; }
            escaped = !escaped && text[i] == '\\';
            if (text[i] != '\\') { escaped = false; }
            i++;
        }
        return len;
    }

    /* Index just past the matching close bracket of the {...} or [...] that
     * starts at `start`, honoring nested brackets, strings, and escapes.
     * Returns text.len() if unterminated. */
    class int balancedEnd(string text, int start) {
        var len = text.len();
        var depth = 0;
        var inString = false;
        var escaped = false;
        for (int j = start; j < len; j++) {
            char c = text[j];
            if (inString) {
                if (!escaped && c == (char)34) { inString = false; }
                escaped = !escaped && c == '\\';
                if (c != '\\') { escaped = false; }
                continue;
            }
            if (c == (char)34) {
                inString = true;
                escaped = false;
                continue;
            }
            if (c == '{' || c == '[') {
                depth++;
                continue;
            }
            if (c == '}' || c == ']') {
                depth--;
                if (depth == 0) { return j + 1; }
            }
        }
        return len;
    }

    class int skipSpaces(string text, int i) {
        var len = text.len();
        while (i < len && (text[i] == ' ' || text[i] == '\n' || text[i] == '\t' || text[i] == '\r')) {
            i++;
        }
        return i;
    }

    class bool isInt(string text) {
        var raw = text.trim();
        if (raw.isEmpty()) { return false; }
        var start = 0;
        if (raw[0] == '-' || raw[0] == '+') {
            if (raw.len() == 1) { return false; }
            start = 1;
        }
        for (int i = start; i < raw.len(); i++) {
            if (raw[i] < '0' || raw[i] > '9') { return false; }
        }
        return true;
    }

    class int keyPosition(string text, string key) {
        var len = text.len();
        var depth = 0;
        var inString = false;
        var escaped = false;
        for (int i = 0; i < len; i++) {
            char c = text[i];
            if (inString) {
                if (!escaped && c == (char)34) { inString = false; }
                escaped = !escaped && c == '\\';
                if (c != '\\') { escaped = false; }
                continue;
            }
            if (c == (char)34) {
                if (depth == 1) {
                    var keyStart = i + 1;
                    var keyEnd = JsonText.stringEnd(text, keyStart);
                    var candidate = JsonText.unescape(JsonText.slice(text, keyStart, keyEnd));
                    var after = JsonText.skipSpaces(text, keyEnd + 1);
                    if (after < len && text[after] == ':' && candidate.equals(key)) {
                        return i;
                    }
                    i = keyEnd;
                    continue;
                }
                inString = true;
                escaped = false;
                continue;
            }
            if (c == '{' || c == '[') {
                depth++;
                continue;
            }
            if (c == '}' || c == ']') {
                depth--;
            }
        }
        return -1;
    }

    class int valueStart(string text, string key) {
        var keyPos = JsonText.keyPosition(text, key);
        if (keyPos < 0) { return -1; }
        var keyEnd = JsonText.stringEnd(text, keyPos + 1);
        var colon = JsonText.skipSpaces(text, keyEnd + 1);
        if (colon >= text.len() || text[colon] != ':') { return -1; }
        return JsonText.skipSpaces(text, colon + 1);
    }

    class string parseStringValue(string text, int i, string fallback) {
        var len = text.len();
        i = JsonText.skipSpaces(text, i);
        if (i >= len || text[i] != (char)34) { return fallback; }
        i++;
        var start = i;
        var end = JsonText.stringEnd(text, start);
        return JsonText.unescape(JsonText.slice(text, start, end));
    }

    class string field(string text, string key, string fallback) {
        var i = JsonText.valueStart(text, key);
        if (i < 0) { return fallback; }
        var len = text.len();
        if (i < len && text[i] == (char)34) {
            return JsonText.parseStringValue(text, i, fallback);
        }
        var start = i;
        while (i < len && text[i] != ',' && text[i] != '}' && text[i] != ']') {
            i++;
        }
        var raw = JsonText.slice(text, start, i).trim();
        if (raw.isEmpty()) { return fallback; }
        return raw;
    }

    class int intField(string text, string key, int fallback) {
        var raw = JsonText.field(text, key, "");
        if (raw.isEmpty()) { return fallback; }
        if (!JsonText.isInt(raw)) { return fallback; }
        return Strings.toInt(raw);
    }

    class string objectField(string text, string key) {
        var i = JsonText.valueStart(text, key);
        var len = text.len();
        if (i < 0 || i >= len || text[i] != '{') { return ""; }
        var depth = 0;
        var inString = false;
        var escaped = false;
        for (int j = i; j < len; j++) {
            char c = text[j];
            if (inString) {
                if (!escaped && c == (char)34) { inString = false; }
                escaped = !escaped && c == '\\';
                if (c != '\\') { escaped = false; }
                continue;
            }
            if (c == (char)34) {
                inString = true;
                escaped = false;
                continue;
            }
            if (c == '{') {
                depth++;
                continue;
            }
            if (c == '}') {
                depth--;
                if (depth == 0) {
                    return JsonText.slice(text, i, j + 1);
                }
            }
        }
        return "";
    }

    class string objectPath(string text, Vector<string> path) {
        var current = text;
        for key in path {
            current = JsonText.objectField(current, key);
            if (current.isEmpty()) { return ""; }
        }
        return current;
    }

    class string fieldPath(string text, Vector<string> path, string fallback) {
        if (path.len == 0) { return fallback; }
        if (path.len == 1) { return JsonText.field(text, path.get(0), fallback); }
        var current = text;
        for (int i = 0; i + 1 < path.len; i++) {
            current = JsonText.objectField(current, path.get(i));
            if (current.isEmpty()) { return fallback; }
        }
        return JsonText.field(current, path.get(path.len - 1), fallback);
    }

    class Vector<string> stringArray(string text, string key) {
        Vector<string> result = [];
        var i = JsonText.valueStart(text, key);
        var len = text.len();
        if (i < 0 || i >= len || text[i] != '[') { return result; }
        var depth = 0;
        var inString = false;
        var escaped = false;
        var start = -1;
        for (int j = i + 1; j < len; j++) {
            char c = text[j];
            if (inString) {
                if (!escaped && c == (char)34) {
                    if (depth == 0 && start >= 0) {
                        result.push(JsonText.unescape(JsonText.slice(text, start, j)));
                    }
                    inString = false;
                    start = -1;
                }
                escaped = !escaped && c == '\\';
                if (c != '\\') { escaped = false; }
                continue;
            }
            if (c == (char)34) {
                inString = true;
                escaped = false;
                start = j + 1;
                continue;
            }
            if (c == '{' || c == '[') {
                depth++;
                continue;
            }
            if (c == '}') {
                depth--;
                continue;
            }
            if (c == ']') {
                if (depth == 0) { break; }
                depth--;
            }
        }
        return result;
    }

    class Vector<string> objectArray(string text, string key) {
        Vector<string> result = [];
        var i = JsonText.valueStart(text, key);
        var len = text.len();
        if (i < 0 || i >= len || text[i] != '[') { return result; }
        var depth = 0;
        var start = -1;
        var inString = false;
        var escaped = false;
        for (int j = i + 1; j < len; j++) {
            char c = text[j];
            if (inString) {
                if (!escaped && c == (char)34) { inString = false; }
                escaped = !escaped && c == '\\';
                if (c != '\\') { escaped = false; }
                continue;
            }
            if (c == (char)34) {
                inString = true;
                escaped = false;
                continue;
            }
            if (c == ']') {
                if (depth == 0) { break; }
                depth--;
                continue;
            }
            if (c == '{' || c == '[') {
                if (depth == 0 && c == '{') { start = j; }
                depth++;
                continue;
            }
            if (c == '}') {
                depth--;
                if (depth == 0 && start >= 0) {
                    result.push(JsonText.slice(text, start, j + 1));
                    start = -1;
                }
            }
        }
        return result;
    }

    class Map<string, string> objectMap(string objectText) {
        Map<string, string> result = {};
        if (objectText.isEmpty()) { return result; }
        var parsed = JsonObject.parse(objectText);
        for key, value in parsed.values {
            result.put(key, value);
        }
        return result;
    }

    class Map<string, string> argsObject(string text) {
        return JsonText.objectMap(JsonText.objectField(text, "args"));
    }

    class string expand(string text, Map<string, string> args) {
        string result = Strings.copy(text);
        for key, value in args {
            result = Strings.replace(result, "{{" + key + "}}", value);
        }
        for key, value in args {
            result = Strings.replace(result, "${" + key + "}", value);
        }
        return result;
    }

    class void putArgPair(Map<string, string> result, string pair) {
        var pos = Strings.find(pair, "=", 0);
        if (pos <= 0) {
            fprintf(stderr, "error 0:0 Expected --arg key=value\n");
            exit(1);
        }
        result.put(JsonText.slice(pair, 0, pos), JsonText.slice(pair, pos + 1, pair.len()));
    }
}
