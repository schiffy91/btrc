import std.io;
import std.map;
import std.strings;
import std.vector;

class JsonObject {
    public Map<string, string> values;
    public Map<string, bool> quoted;

    public JsonObject() {
        self.values = {};
        self.quoted = {};
    }

    class string escape(string text) {
        if (text == null) { return ""; }
        var escaped = Strings.replace(text, "\\", "\\\\");
        escaped = Strings.replace(escaped, "\"", "\\\"");
        escaped = Strings.replace(escaped, "\n", "\\n");
        escaped = Strings.replace(escaped, "\r", "\\r");
        escaped = Strings.replace(escaped, "\t", "\\t");
        return escaped;
    }

    class string unescape(string text) {
        return JsonText.unescape(text);
    }

    public void setString(string key, string value) {
        self.values.put(key, value);
        self.quoted.put(key, true);
    }

    public void setRaw(string key, string value) {
        self.values.put(key, value);
        self.quoted.put(key, false);
    }

    public void setBool(string key, bool value) {
        self.values.put(key, value ? "true" : "false");
        self.quoted.put(key, false);
    }

    public void setInt(string key, int value) {
        self.values.put(key, Strings.fromInt(value));
        self.quoted.put(key, false);
    }

    public bool has(string key) {
        return self.values.has(key);
    }

    public string getString(string key, string fallback) {
        if (!self.values.has(key)) { return fallback; }
        return self.values.get(key);
    }

    public bool getBool(string key, bool fallback) {
        if (!self.values.has(key)) { return fallback; }
        var value = self.values.get(key);
        if (value.equals("true")) { return true; }
        if (value.equals("false")) { return false; }
        return fallback;
    }

    public int getInt(string key, int fallback) {
        if (!self.values.has(key)) { return fallback; }
        var raw = self.values.get(key);
        if (!JsonText.isInt(raw)) { return fallback; }
        return Strings.toInt(raw);
    }

    public string stringify() {
        Vector<string> fields = [];
        for key, value in self.values {
            var escapedKey = JsonObject.escape(key);
            var field = "\"" + escapedKey + "\":";
            if (self.quoted.getOrDefault(key, true)) {
                var escapedValue = JsonObject.escape(value);
                field += "\"" + escapedValue + "\"";
            } else {
                field += value;
            }
            fields.push(field);
        }
        return "{" + fields.join(",") + "}";
    }

    class int skipSpaces(string text, int i) {
        return JsonText.skipSpaces(text, i);
    }

    class bool isInt(string text) {
        return JsonText.isInt(text);
    }

    class string slice(string text, int start, int end) {
        return JsonText.slice(text, start, end);
    }

    class int stringEnd(string text, int start) {
        return JsonText.stringEnd(text, start);
    }

    /* Depth-aware single-level parse: only depth-1 strings followed by ':'
     * become keys; nested objects/arrays are captured whole as raw values
     * (re-parse them with JsonObject.parse or query via JsonText). */
    class JsonObject parse(string text) {
        var json = JsonObject();
        var len = text.len();
        var depth = 0;
        var i = 0;
        while (i < len) {
            i = JsonText.skipSpaces(text, i);
            if (i >= len) { break; }
            char c = text[i];
            if (c == '{' || c == '[') {
                depth++;
                i++;
                continue;
            }
            if (c == '}' || c == ']') {
                depth--;
                i++;
                continue;
            }
            if (c != (char)34 || depth != 1) {
                i++;
                continue;
            }
            var keyStart = i + 1;
            var keyEnd = JsonText.stringEnd(text, keyStart);
            var afterKey = JsonText.skipSpaces(text, keyEnd + 1);
            if (afterKey >= len || text[afterKey] != ':') {
                i = keyEnd + 1;
                continue;
            }
            var key = JsonText.unescape(JsonText.slice(text, keyStart, keyEnd));
            i = JsonText.skipSpaces(text, afterKey + 1);
            if (i >= len) { break; }
            if (text[i] == (char)34) {
                var valueStart = i + 1;
                var valueEnd = JsonText.stringEnd(text, valueStart);
                json.setString(key, JsonText.unescape(JsonText.slice(text, valueStart, valueEnd)));
                i = valueEnd + 1;
            } else if (text[i] == '{' || text[i] == '[') {
                var valueEnd = JsonText.balancedEnd(text, i);
                json.setRaw(key, JsonText.slice(text, i, valueEnd));
                i = valueEnd;
            } else {
                var valueStart = i;
                while (i < len && text[i] != ',' && text[i] != '}') { i++; }
                var valueEnd = i;
                while (valueEnd > valueStart && (text[valueEnd - 1] == ' ' || text[valueEnd - 1] == '\n' || text[valueEnd - 1] == '\t' || text[valueEnd - 1] == '\r')) {
                    valueEnd--;
                }
                json.setRaw(key, JsonText.slice(text, valueStart, valueEnd));
            }
        }
        return json;
    }

    class JsonObject readFile(string path) {
        return JsonObject.parse(Path.readAll(path));
    }

    public void writeFile(string path) {
        Path.writeAll(path, self.stringify());
    }
}

class JsonText {
    class string slice(string text, int start, int end) {
        return text.substring(start, end - start);
    }

    class string unescape(string text) {
        var result = "";
        var escaped = false;
        for i in range(text.len()) {
            var current = text.substring(i, 1);
            if (escaped) {
                if (current.equals("n")) { result += "\n"; }
                else if (current.equals("r")) { result += "\r"; }
                else if (current.equals("t")) { result += "\t"; }
                else { result += current; }
                escaped = false;
                continue;
            }
            if (current.equals("\\")) {
                escaped = true;
                continue;
            }
            result += current;
        }
        if (escaped) { result += "\\"; }
        return result;
    }

    class int stringEnd(string text, int start) {
        var len = text.len();
        var escaped = false;
        var i = start;
        while (i < len) {
            if (!escaped && text[i] == (char)34) { return i; }
            escaped = !escaped && text[i] == '\\';
            if (text[i] != '\\') { escaped = false; }
            i++;
        }
        return len;
    }

    /* Index just past the matching close bracket of the {...} or [...] that
     * starts at `start`, honoring nested brackets, strings, and escapes.
     * Returns text.len() if unterminated. */
    class int balancedEnd(string text, int start) {
        var len = text.len();
        var depth = 0;
        var inString = false;
        var escaped = false;
        for (int j = start; j < len; j++) {
            char c = text[j];
            if (inString) {
                if (!escaped && c == (char)34) { inString = false; }
                escaped = !escaped && c == '\\';
                if (c != '\\') { escaped = false; }
                continue;
            }
            if (c == (char)34) {
                inString = true;
                escaped = false;
                continue;
            }
            if (c == '{' || c == '[') {
                depth++;
                continue;
            }
            if (c == '}' || c == ']') {
                depth--;
                if (depth == 0) { return j + 1; }
            }
        }
        return len;
    }

    class int skipSpaces(string text, int i) {
        var len = text.len();
        while (i < len && (text[i] == ' ' || text[i] == '\n' || text[i] == '\t' || text[i] == '\r')) {
            i++;
        }
        return i;
    }

    class bool isInt(string text) {
        var raw = text.trim();
        if (raw.isEmpty()) { return false; }
        var start = 0;
        if (raw[0] == '-' || raw[0] == '+') {
            if (raw.len() == 1) { return false; }
            start = 1;
        }
        for (int i = start; i < raw.len(); i++) {
            if (raw[i] < '0' || raw[i] > '9') { return false; }
        }
        return true;
    }

    class int keyPosition(string text, string key) {
        var len = text.len();
        var depth = 0;
        var inString = false;
        var escaped = false;
        for (int i = 0; i < len; i++) {
            char c = text[i];
            if (inString) {
                if (!escaped && c == (char)34) { inString = false; }
                escaped = !escaped && c == '\\';
                if (c != '\\') { escaped = false; }
                continue;
            }
            if (c == (char)34) {
                if (depth == 1) {
                    var keyStart = i + 1;
                    var keyEnd = JsonText.stringEnd(text, keyStart);
                    var candidate = JsonText.unescape(JsonText.slice(text, keyStart, keyEnd));
                    var after = JsonText.skipSpaces(text, keyEnd + 1);
                    if (after < len && text[after] == ':' && candidate.equals(key)) {
                        return i;
                    }
                    i = keyEnd;
                    continue;
                }
                inString = true;
                escaped = false;
                continue;
            }
            if (c == '{' || c == '[') {
                depth++;
                continue;
            }
            if (c == '}' || c == ']') {
                depth--;
            }
        }
        return -1;
    }

    class int valueStart(string text, string key) {
        var keyPos = JsonText.keyPosition(text, key);
        if (keyPos < 0) { return -1; }
        var keyEnd = JsonText.stringEnd(text, keyPos + 1);
        var colon = JsonText.skipSpaces(text, keyEnd + 1);
        if (colon >= text.len() || text[colon] != ':') { return -1; }
        return JsonText.skipSpaces(text, colon + 1);
    }

    class string parseStringValue(string text, int i, string fallback) {
        var len = text.len();
        i = JsonText.skipSpaces(text, i);
        if (i >= len || text[i] != (char)34) { return fallback; }
        i++;
        var start = i;
        var end = JsonText.stringEnd(text, start);
        return JsonText.unescape(JsonText.slice(text, start, end));
    }

    class string field(string text, string key, string fallback) {
        var i = JsonText.valueStart(text, key);
        if (i < 0) { return fallback; }
        var len = text.len();
        if (i < len && text[i] == (char)34) {
            return JsonText.parseStringValue(text, i, fallback);
        }
        var start = i;
        while (i < len && text[i] != ',' && text[i] != '}' && text[i] != ']') {
            i++;
        }
        var raw = JsonText.slice(text, start, i).trim();
        if (raw.isEmpty()) { return fallback; }
        return raw;
    }

    class int intField(string text, string key, int fallback) {
        var raw = JsonText.field(text, key, "");
        if (raw.isEmpty()) { return fallback; }
        if (!JsonText.isInt(raw)) { return fallback; }
        return Strings.toInt(raw);
    }

    class string objectField(string text, string key) {
        var i = JsonText.valueStart(text, key);
        var len = text.len();
        if (i < 0 || i >= len || text[i] != '{') { return ""; }
        var depth = 0;
        var inString = false;
        var escaped = false;
        for (int j = i; j < len; j++) {
            char c = text[j];
            if (inString) {
                if (!escaped && c == (char)34) { inString = false; }
                escaped = !escaped && c == '\\';
                if (c != '\\') { escaped = false; }
                continue;
            }
            if (c == (char)34) {
                inString = true;
                escaped = false;
                continue;
            }
            if (c == '{') {
                depth++;
                continue;
            }
            if (c == '}') {
                depth--;
                if (depth == 0) {
                    return JsonText.slice(text, i, j + 1);
                }
            }
        }
        return "";
    }

    class string objectPath(string text, Vector<string> path) {
        var current = text;
        for key in path {
            current = JsonText.objectField(current, key);
            if (current.isEmpty()) { return ""; }
        }
        return current;
    }

    class string fieldPath(string text, Vector<string> path, string fallback) {
        if (path.len == 0) { return fallback; }
        if (path.len == 1) { return JsonText.field(text, path.get(0), fallback); }
        var current = text;
        for (int i = 0; i + 1 < path.len; i++) {
            current = JsonText.objectField(current, path.get(i));
            if (current.isEmpty()) { return fallback; }
        }
        return JsonText.field(current, path.get(path.len - 1), fallback);
    }

    class Vector<string> stringArray(string text, string key) {
        Vector<string> result = [];
        var i = JsonText.valueStart(text, key);
        var len = text.len();
        if (i < 0 || i >= len || text[i] != '[') { return result; }
        var depth = 0;
        var inString = false;
        var escaped = false;
        var start = -1;
        for (int j = i + 1; j < len; j++) {
            char c = text[j];
            if (inString) {
                if (!escaped && c == (char)34) {
                    if (depth == 0 && start >= 0) {
                        result.push(JsonText.unescape(JsonText.slice(text, start, j)));
                    }
                    inString = false;
                    start = -1;
                }
                escaped = !escaped && c == '\\';
                if (c != '\\') { escaped = false; }
                continue;
            }
            if (c == (char)34) {
                inString = true;
                escaped = false;
                start = j + 1;
                continue;
            }
            if (c == '{' || c == '[') {
                depth++;
                continue;
            }
            if (c == '}') {
                depth--;
                continue;
            }
            if (c == ']') {
                if (depth == 0) { break; }
                depth--;
            }
        }
        return result;
    }

    class Vector<string> objectArray(string text, string key) {
        Vector<string> result = [];
        var i = JsonText.valueStart(text, key);
        var len = text.len();
        if (i < 0 || i >= len || text[i] != '[') { return result; }
        var depth = 0;
        var start = -1;
        var inString = false;
        var escaped = false;
        for (int j = i + 1; j < len; j++) {
            char c = text[j];
            if (inString) {
                if (!escaped && c == (char)34) { inString = false; }
                escaped = !escaped && c == '\\';
                if (c != '\\') { escaped = false; }
                continue;
            }
            if (c == (char)34) {
                inString = true;
                escaped = false;
                continue;
            }
            if (c == ']') {
                if (depth == 0) { break; }
                depth--;
                continue;
            }
            if (c == '{' || c == '[') {
                if (depth == 0 && c == '{') { start = j; }
                depth++;
                continue;
            }
            if (c == '}') {
                depth--;
                if (depth == 0 && start >= 0) {
                    result.push(JsonText.slice(text, start, j + 1));
                    start = -1;
                }
            }
        }
        return result;
    }

    class Map<string, string> objectMap(string objectText) {
        Map<string, string> result = {};
        if (objectText.isEmpty()) { return result; }
        var parsed = JsonObject.parse(objectText);
        for key, value in parsed.values {
            result.put(key, value);
        }
        return result;
    }

    class Map<string, string> argsObject(string text) {
        return JsonText.objectMap(JsonText.objectField(text, "args"));
    }

    class string expand(string text, Map<string, string> args) {
        string result = Strings.copy(text);
        for key, value in args {
            result = Strings.replace(result, "{{" + key + "}}", value);
        }
        for key, value in args {
            result = Strings.replace(result, "${" + key + "}", value);
        }
        return result;
    }

    class void putArgPair(Map<string, string> result, string pair) {
        var pos = Strings.find(pair, "=", 0);
        if (pos <= 0) {
            fprintf(stderr, "error 0:0 Expected --arg key=value\n");
            exit(1);
        }
        result.put(JsonText.slice(pair, 0, pos), JsonText.slice(pair, pos + 1, pair.len()));
    }
}
