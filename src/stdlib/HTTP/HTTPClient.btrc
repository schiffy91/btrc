/* A synchronous HTTP client: one request, one response, no redirects.
 *
 * This module owns admission (method, URL, headers, limits) and the result
 * callers see. `[[package.providers]]` selects HTTPTransportProvider, which
 * performs the request on each system. */
import Library.Bytes;
import Library.HTTP.HTTPExchange;
import Library.HTTP.HTTPFraming;
import Library.Vector;

class HTTPClientResponse {
	public int status;
	public string body;
	public string error;

	public HTTPClientResponse(int status, string body, string error) {
		self.status = status;
		self.body = body;
		self.error = error;
	}

	public bool ok() { return self.status >= 200 && self.status < 300; }
}

class HTTPClient {
	public int timeoutSecs;
	public int maxRequestBytes;
	public int maxResponseBytes;

	public HTTPClient() {
		self.timeoutSecs = 120;
		self.maxRequestBytes = 8388608;
		self.maxResponseBytes = 8388608;
	}

	public HTTPClient timeout(int secs) {
		if (secs < 1) { secs = 1; }
		if (secs > 86400) { secs = 86400; }
		self.timeoutSecs = secs;
		return self;
	}

	class bool supportedUrl(string url) {
		if (url == null) { return false; }
		string normalized = url.toLower();
		return normalized.startsWith("http://") || normalized.startsWith("https://");
	}

	public HTTPClientResponse request(string method, string url, Vector<string> headers, string body) {
		if (!HTTPFraming.token(method) || method.len() > 64) {
			return HTTPClientResponse(0, "", "invalid HTTP method");
		}
		if (!HTTPFraming.requestTarget(url) || url.len() > 8192) {
			return HTTPClientResponse(0, "", "invalid URL");
		}
		if (!HTTPClient.supportedUrl(url)) {
			return HTTPClientResponse(0, "", "unsupported URL scheme");
		}
		if (self.maxRequestBytes < 0 || self.maxResponseBytes < 0) {
			return HTTPClientResponse(0, "", "HTTP size limits cannot be negative");
		}
		if (self.maxResponseBytes > 2147483582) {
			return HTTPClientResponse(0, "", "response size limit is too large");
		}
		if (headers == null) {
			return HTTPClientResponse(0, "", "headers cannot be null");
		}
		int headerBytes = 0;
		for header in headers {
			if (!HTTPFraming.headerLine(header)) {
				return HTTPClientResponse(0, "", "invalid HTTP header");
			}
			if (header.len() > 65536 - headerBytes) {
				return HTTPClientResponse(0, "", "HTTP headers are too large");
			}
			headerBytes = headerBytes + header.len();
		}
		if (body != null && (size_t)strlen(body) > (size_t)self.maxRequestBytes) {
			return HTTPClientResponse(0, "", "request body is too large");
		}
		int seconds = self.timeoutSecs;
		if (seconds < 1) { seconds = 1; }
		if (seconds > 86400) { seconds = 86400; }
		HTTPExchangeResult result = HTTPTransportProvider.request(method, url, headers, body == null ? "" : body, seconds, self.maxResponseBytes);
		if (result.status == 0) { return HTTPClientResponse(0, "", result.error.isEmpty() ? "request failed" : result.error); }
		return HTTPClientResponse(result.status, result.body.toStringLossy(), "");
	}

	public HTTPClientResponse post(string url, Vector<string> headers, string body) { return self.request("POST", url, headers, body); }

	public HTTPClientResponse get(string url, Vector<string> headers) { return self.request("GET", url, headers, ""); }
}
