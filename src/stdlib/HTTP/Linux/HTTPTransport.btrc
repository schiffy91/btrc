/* First-party Linux HTTP and HTTPS transport over BSD sockets, HTTP/HTTPS
 * forward/CONNECT proxies, SOCKS4/4a/5/5h proxies, and Library.TLS. */
import Library.Bytes;
import Library.HTTP.HTTPExchange;
import Library.HTTP.Unix.HTTPConnect;
import Library.HTTP.Unix.HTTPPlainTransport;
import Library.HTTP.Unix.HTTPProxy;
import Library.HTTP.Unix.HTTPSocks;
import Library.Timer;
import Library.TLS.Linux.ClientStream;
import Library.TLS.TLSStream;
import Library.Vector;

class HTTPToTLSStream implements ITLSByteStream {
	private IHTTPByteStream inner;

	public HTTPToTLSStream(IHTTPByteStream inner) { self.inner = inner; }

	public int receive(Bytes into, int maximum, long long deadline) { return self.inner.receive(into, maximum, deadline); }

	public bool send(Bytes data, long long deadline) { return self.inner.send(data, deadline); }

	public void close() { self.inner.close(); }
}

class TLSToHTTPStream implements IHTTPByteStream {
	private LinuxTLSStream inner;

	public TLSToHTTPStream(LinuxTLSStream inner) { self.inner = inner; }

	public int receive(Bytes into, int maximum, long long deadline) { return self.inner.receive(into, maximum, deadline); }

	public bool send(Bytes data, long long deadline) { return self.inner.send(data, deadline); }

	public void close() { self.inner.close(); }
}

class LinuxHTTPTransport {
	class HTTPExchangeResult request(string method, HTTPClientAddress address, Vector<string> headers, string body, int timeoutSecs, int maxResponseBytes) {
		long long deadline = MonotonicClock.deadlineAfter((long long)timeoutSecs * 1000LL);
		string setting = HTTPProxy.setting(address);
		string socks = HTTPSocks.scheme(setting);
		HTTPClientAddress endpoint = address;
		HTTPClientAddress? proxy = null;
		if (!setting.isEmpty()) {
			if (!socks.isEmpty()) {
				proxy = HTTPSocks.endpoint(setting, socks);
				if (proxy == null) { return HTTPExchangeResult.failed("unsupported proxy URL"); }
			} else {
				string proxyUrl = setting.contains("://") ? setting : "http://" + setting;
				proxy = HTTPClientAddress.parse(proxyUrl, 1080);
				if (proxy == null) { return HTTPExchangeResult.failed("unsupported proxy URL"); }
			}
			endpoint = proxy;
		}
		int fd = HTTPPlainTransport.connectTo(endpoint.resolvable(), endpoint.port, deadline);
		if (fd == -2) { return HTTPExchangeResult.failed("could not resolve host"); }
		if (fd < 0) { return HTTPExchangeResult.failed(MonotonicClock.remaining(deadline) <= 0LL ? "request timed out" : "could not connect"); }
		IHTTPByteStream transport = HTTPSocketStream(fd);
		if (proxy != null && !socks.isEmpty()) {
			if (!HTTPSocks.connect(transport, address, proxy.userInfo, socks, deadline)) {
				transport.close();
				return HTTPExchangeResult.failed(MonotonicClock.remaining(deadline) <= 0LL ? "request timed out" : "SOCKS connection failed");
			}
			if (address.secure) {
				var tls = LinuxTLSStream.connect(HTTPToTLSStream(transport), address.resolvable(), deadline, false);
				if (tls == null) { return HTTPExchangeResult.failed(MonotonicClock.before(deadline) ? "TLS handshake failed" : "request timed out"); }
				transport = TLSToHTTPStream(tls);
			}
			var response = HTTPExchange.run(transport, method, address, HTTPConnect.originHeaders(headers), body, maxResponseBytes, deadline);
			transport.close();
			return response;
		}
		if (proxy != null) {
			if (proxy.secure) {
				var outer = LinuxTLSStream.connect(HTTPToTLSStream(transport), proxy.resolvable(), deadline, true);
				if (outer == null) { return HTTPExchangeResult.failed(MonotonicClock.before(deadline) ? "proxy TLS handshake failed" : "request timed out"); }
				transport = TLSToHTTPStream(outer);
			}
			if (address.secure) {
				string error = HTTPConnect.establish(transport, address, proxy, headers, deadline);
				if (!error.isEmpty()) {
					transport.close();
					return HTTPExchangeResult.failed(MonotonicClock.before(deadline) ? error : "request timed out");
				}
				var tls = LinuxTLSStream.connect(HTTPToTLSStream(transport), address.resolvable(), deadline, false);
				if (tls == null) { return HTTPExchangeResult.failed(MonotonicClock.before(deadline) ? "TLS handshake failed" : "request timed out"); }
				transport = TLSToHTTPStream(tls);
				var response = HTTPExchange.run(transport, method, address, HTTPConnect.originHeaders(headers), body, maxResponseBytes, deadline);
				transport.close();
				return response;
			}
			var response = HTTPExchange.run(transport, method, HTTPPlainTransport.forwardAddress(address), HTTPPlainTransport.forwardHeaders(headers, proxy), body, maxResponseBytes, deadline);
			transport.close();
			return response;
		}
		if (address.secure) {
			var tls = LinuxTLSStream.connect(HTTPToTLSStream(transport), address.resolvable(), deadline, false);
			if (tls == null) { return HTTPExchangeResult.failed(MonotonicClock.before(deadline) ? "TLS handshake failed" : "request timed out"); }
			transport = TLSToHTTPStream(tls);
			var response = HTTPExchange.run(transport, method, address, HTTPConnect.originHeaders(headers), body, maxResponseBytes, deadline);
			transport.close();
			return response;
		}
		var response = HTTPExchange.run(transport, method, address, HTTPConnect.originHeaders(headers), body, maxResponseBytes, deadline);
		transport.close();
		return response;
	}
}
