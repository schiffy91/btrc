/* BSD socket targets share plain HTTP. Apple uses NSURLSession for HTTPS.
 * On macOS an installed curl preserves its own configured CA directory when
 * an explicit CA file is used. Other unsupported curl settings use that provider too. */
#if defined(__APPLE__)
import Library.HTTP.Apple.HTTPURLSession;
import Library.Platform;
#endif
#if !TARGET_OS_IOS
import Library.HTTP.HTTPCurlTransport;
import Library.HTTP.Unix.HTTPProxy;
#endif
#if TARGET_OS_OSX || (defined(__linux__) && !defined(__ANDROID__))
import Library.HTTP.Unix.HTTPSocks;
import Library.Process;
#endif
import Library.HTTP.HTTPExchange;
import Library.HTTP.Unix.HTTPPlainTransport;
import Library.Vector;

class HTTPTransportProvider {
	class HTTPExchangeResult request(string method, string url, Vector<string> headers, string body, int timeoutSecs, int maxResponseBytes) {
		HTTPClientAddress? address = HTTPClientAddress.parse(url);
		if (address == null) { return HTTPExchangeResult.failed("invalid URL"); }
		if (address.secure) {
#if defined(__APPLE__)
			string bundle = Environment.get("CURL_CA_BUNDLE", "");
			if (bundle.isEmpty()) { bundle = Environment.get("SSL_CERT_FILE", ""); }
#if TARGET_OS_OSX
			bool bodyOnGet = !body.isEmpty() && (method.toUpper().equals("GET") || method.toUpper().equals("HEAD"));
			bool installedBundle = !bundle.isEmpty() && !ChildProcessExecutable.resolve("curl", "", [], []).isEmpty();
			if (installedBundle || bodyOnGet || !Environment.get("SSL_CERT_DIR", "").isEmpty()) { return HTTPCurlTransport.request(method, url, headers, body, timeoutSecs, maxResponseBytes); }
			string setting = HTTPProxy.setting(address);
			HTTPClientAddress? proxy = null;
			if (!setting.isEmpty()) {
				string proxyUrl = setting.contains("://") ? setting : "http://" + setting;
				proxy = HTTPClientAddress.parse(proxyUrl, 1080);
				if (proxy == null || proxy.secure || !proxy.userInfo.isEmpty() || !proxy.target.equals("/") || HTTPExchange.names(headers, "proxy-authorization")) { return HTTPCurlTransport.request(method, url, headers, body, timeoutSecs, maxResponseBytes); }
			}
#else
			HTTPClientAddress? proxy = null;
#endif
			return HTTPURLSession.request(method, address, headers, body, timeoutSecs, maxResponseBytes, proxy, bundle);
#else
			return HTTPCurlTransport.request(method, url, headers, body, timeoutSecs, maxResponseBytes);
#endif
		}
#if !TARGET_OS_IOS
		string setting = HTTPProxy.setting(address);
		if (!setting.isEmpty()) {
#if TARGET_OS_OSX || (defined(__linux__) && !defined(__ANDROID__))
			string socks = HTTPSocks.scheme(setting);
			/* Installed curl can negotiate GSSAPI for SOCKS5. Keep caller-specified proxy headers on the
			 * installed transport as well. */
			if (!socks.isEmpty() && !HTTPProxy.needsLegacyHeaders(headers) && (!socks.startsWith("socks5") || ChildProcessExecutable.resolve("curl", "", [], []).isEmpty())) {
				HTTPClientAddress? endpoint = HTTPSocks.endpoint(setting, socks);
				if (endpoint != null) { return HTTPPlainTransport.request(method, address, headers, body, timeoutSecs, maxResponseBytes, endpoint, socks); }
			}
#endif
			string proxyUrl = setting.contains("://") ? setting : "http://" + setting;
			HTTPClientAddress? proxy = HTTPClientAddress.parse(proxyUrl, 1080);
			/* Other proxy schemes retain the existing curl transport. */
			if (proxy == null || proxy.secure) { return HTTPCurlTransport.request(method, url, headers, body, timeoutSecs, maxResponseBytes); }
			return HTTPPlainTransport.request(method, address, headers, body, timeoutSecs, maxResponseBytes, proxy);
		}
#endif
		return HTTPPlainTransport.request(method, address, headers, body, timeoutSecs, maxResponseBytes);
	}
}
