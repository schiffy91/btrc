/* The first-party `http://` transport of the BSD-socket systems: the system
 * resolver and a socket under HTTPExchange. Each address the resolver returns
 * is tried in order, IPv6 and IPv4 alike, and the whole request shares one
 * monotonic deadline, including the wait for the system resolver. */
import Library.Bytes;
import Library.HTTP.HTTPExchange;
import Library.HTTP.HTTPSocket;
import Library.HTTP.Unix.HTTPSocks;
import Library.IO;
import Library.Timer;
import Library.Vector;

extern int btrcHttpResolve(char* host, char* service, long long deadlineMs, void** result);
extern int btrcHttpAddressSocket(void** cursor, struct sockaddr** address, socklen_t* length);
extern void btrcHttpFreeAddresses(void* addresses);

/* A connected, nonblocking, close-on-exec socket the stream owns. */
class HTTPSocketStream implements IHTTPByteStream {
	private int descriptor;

	public HTTPSocketStream(int descriptor) { self.descriptor = descriptor; }

	public int receive(Bytes into, int maximum, long long deadline) {
		if (self.descriptor < 0 || maximum <= 0) { return -2; }
		char buffer[16384];
		int room = maximum < 16384 ? maximum : 16384;
		while (true) {
			if (!HTTPSocket.waitFor(self.descriptor, POLLIN, deadline)) { return MonotonicClock.remaining(deadline) <= 0LL ? -1 : -2; }
			long long count = (long long)recv(self.descriptor, buffer, (size_t)room, 0);
			if (count < 0LL && (errno == EINTR || errno == EAGAIN || errno == EWOULDBLOCK)) { continue; }
			if (count < 0LL) { return -2; }
			if (count > 0LL) { into.appendRaw(buffer, (int)count); }
			return (int)count;
		}
		return -2;
	}

	public bool send(Bytes data, long long deadline) { return HTTPSocket.sendBytesUntil(self.descriptor, data, deadline); }

	public void close() {
		if (self.descriptor >= 0) { close(self.descriptor); }
		self.descriptor = -1;
	}

	public void __del__() { self.close(); }
}

class HTTPPlainTransport {
	class HTTPClientAddress forwardAddress(HTTPClientAddress address) { return HTTPClientAddress(false, address.userInfo, address.host, address.port, "http://" + address.authority() + address.target); }

	class Vector<string> forwardHeaders(Vector<string> headers, HTTPClientAddress proxy) {
		if (proxy.userInfo.isEmpty() || HTTPExchange.names(headers, "proxy-authorization")) { return headers; }
		Vector<string> fields = [];
		for header in headers { fields.push(header); }
		fields.push("Proxy-Authorization: Basic " + HTTPExchange.base64(HTTPExchange.credentials(proxy.userInfo)));
		return fields;
	}

	/* A socket connected to the first address of `host` that answers before
	 * the deadline; -1 when none does, -2 when the name does not resolve. */
	class int connectTo(string host, int port, long long deadline) {
		if (host.isEmpty() || host.len() > 255) { return -2; }
		char name[256];
		memset(name, 0, sizeof(name));
		memcpy(name, host, (size_t)host.len());
		char service[16];
		snprintf(service, sizeof(service), "%d", port);
		void* found = NULL;
		int status = btrcHttpResolve(name, service, deadline, &found);
		if (status != 0) { return status; }
		int connected = -1;
		void* entry = found;
		while (entry != NULL && connected < 0 && MonotonicClock.remaining(deadline) > 0LL) {
			struct sockaddr* address = NULL;
			socklen_t addressLength = 0;
			int descriptor = btrcHttpAddressSocket(&entry, &address, &addressLength);
			if (descriptor >= 0 && !DescriptorFlags.configure(descriptor, true)) {
				close(descriptor);
				descriptor = -1;
			}
			if (descriptor >= 0) {
				int failure = 0;
				if (connect(descriptor, address, addressLength) != 0) {
					failure = errno;
					if (failure == EINPROGRESS || failure == EINTR) {
						failure = ETIMEDOUT;
						socklen_t length = sizeof(failure);
						if (HTTPSocket.waitFor(descriptor, POLLOUT, deadline)) {
							if (getsockopt(descriptor, (int)SOL_SOCKET, (int)SO_ERROR, &failure, &length) != 0) { failure = errno; }
						}
					}
				}
				if (failure == 0) { connected = descriptor; }
				else { close(descriptor); }
			}
		}
		btrcHttpFreeAddresses(found);
		return connected;
	}

	class HTTPExchangeResult request(string method, HTTPClientAddress address, Vector<string> headers, string body, int timeoutSecs, int maxResponseBytes, HTTPClientAddress? proxy = null, string socks = "") {
		long long deadline = MonotonicClock.deadlineAfter((long long)timeoutSecs * 1000LL);
		HTTPClientAddress endpoint = address;
		HTTPClientAddress requestAddress = address;
		Vector<string> requestHeaders = headers;
		if (proxy != null) {
			endpoint = proxy;
			if (socks.isEmpty()) {
				requestAddress = HTTPPlainTransport.forwardAddress(address);
				requestHeaders = HTTPPlainTransport.forwardHeaders(headers, proxy);
			} else {
				requestHeaders = [];
				for header in headers { if (!HTTPExchange.fieldName(header).equals("proxy-authorization")) { requestHeaders.push(header); } }
			}
		}
		int descriptor = HTTPPlainTransport.connectTo(endpoint.resolvable(), endpoint.port, deadline);
		if (descriptor == -2) { return HTTPExchangeResult.failed("could not resolve host"); }
		if (descriptor < 0) { return HTTPExchangeResult.failed(MonotonicClock.remaining(deadline) <= 0LL ? "request timed out" : "could not connect"); }
		var stream = HTTPSocketStream(descriptor);
		if (proxy != null && !socks.isEmpty() && !HTTPSocks.connect(stream, address, proxy.userInfo, socks, deadline)) {
			stream.close();
			return HTTPExchangeResult.failed(MonotonicClock.remaining(deadline) <= 0LL ? "request timed out" : "SOCKS connection failed");
		}
		HTTPExchangeResult result = HTTPExchange.run(stream, method, requestAddress, requestHeaders, body, maxResponseBytes, deadline);
		stream.close();
		return result;
	}
}
