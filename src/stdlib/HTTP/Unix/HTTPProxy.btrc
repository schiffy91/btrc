/* HTTP proxy selection on Unix targets. http_proxy is lowercase only, as
 * required for CGI environments. no_proxy entries name domains or numeric
 * networks and never trigger a lookup of the origin at the client. */
import Library.HTTP.HTTPExchange;
import Library.Platform;
import Library.Strings;
import Library.Vector;

extern int btrcHttpProxyNetwork(string host, string entry);

class HTTPProxy {
	class string configured(HTTPClientAddress address) {
		string proxy = address.secure ? Environment.get("https_proxy", Environment.get("HTTPS_PROXY", "")) : Environment.get("http_proxy", "");
		if (proxy.isEmpty()) { proxy = Environment.get("all_proxy", Environment.get("ALL_PROXY", "")); }
		return proxy;
	}

	class string setting(HTTPClientAddress address) {
		string proxy = HTTPProxy.configured(address);
		return proxy.isEmpty() || HTTPProxy.bypasses(address) ? "" : proxy;
	}

	class bool bypasses(HTTPClientAddress address) {
		string rules = Environment.get("no_proxy", Environment.get("NO_PROXY", "")).trim();
		if (rules.equals("*")) { return true; }
		string host = address.resolvable().toLower();
		if (host.endsWith(".")) { host = host.substring(0, host.len() - 1); }
		for rule in Strings.split(rules, ",") {
			string entry = rule.trim().toLower();
			if (entry.isEmpty()) { continue; }
			int numeric = btrcHttpProxyNetwork(host, entry);
			if (numeric == 1) { return true; }
			if (numeric == 0) { continue; }
			if (entry.startsWith(".")) { entry = entry.substring(1, entry.len() - 1); }
			if (entry.endsWith(".")) { entry = entry.substring(0, entry.len() - 1); }
			if (!entry.isEmpty() && (host.equals(entry) || host.endsWith("." + entry))) { return true; }
		}
		return false;
	}
}
