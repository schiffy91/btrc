/* The curl process, where no first-party or system transport has replaced it
 * yet. Every request is one `curl` child with the URL after `--`, the body on
 * its standard input and the status after a marker on its standard output.
 * This module goes away with the last row that selects it. */
import Library.Bytes;
import Library.HTTP.HTTPExchange;
import Library.Process;
import Library.Strings;
import Library.Timer;
import Library.Vector;

class HTTPCurlTransport {
	class HTTPExchangeResult request(string method, string url, Vector<string> headers, string body, int timeoutSecs, int maxResponseBytes, long long deadline=0LL) {
		int status = 0;
		string responseBody = "";
		bool hasBody = !body.isEmpty();
		int curlResponseLimit = maxResponseBytes > 0 ? maxResponseBytes : 1;
		int captureLimit = maxResponseBytes + 64;
		string statusMarker = "\n__BTRC_HTTP_STATUS__:";
		string duration = Strings.fromInt(timeoutSecs);
		int childTimeout = timeoutSecs * 1000 + 1000;
		if (deadline > 0LL) {
			long long remaining = MonotonicClock.remaining(deadline);
			if (remaining <= 0LL) { return HTTPExchangeResult.failed("request timed out"); }
			childTimeout = (int)remaining;
			string millis = Strings.fromInt(1000 + childTimeout % 1000).substring(1, 3);
			duration = Strings.fromInt(childTimeout / 1000) + "." + millis;
		}

		Vector<string> arguments = [
			"-sS",
			"--proto", "=http,https",
			"--proto-redir", "=http,https",
			"--max-time", duration,
			"--max-filesize", Strings.fromInt(curlResponseLimit),
			"--request", method,
			"--write-out", statusMarker + "%{http_code}"
		];
		for h in headers {
			arguments.push("--header");
			arguments.push(h);
		}
		if (hasBody) {
			arguments.push("--data-binary");
			arguments.push("@-");
		}
		/* The terminator is defense in depth: curl must never interpret any
         * URL-controlled bytes as another option. */
		arguments.push("--");
		arguments.push(url);
		var result = ChildProcess.run("curl", arguments, timeoutMilliseconds=childTimeout, maxStdoutBytes=captureLimit, maxStderrBytes=65536, stdinData=body);
		int marker = Strings.rfind(result.stdout(), statusMarker);
		if (marker >= 0) {
			int statusStart = marker + statusMarker.len();
			string statusText = result.stdout().substring(statusStart, result.stdout().len() - statusStart);
			bool validStatus = statusText.len() == 3;
			for ch in statusText {
				if (ch < '0' || ch > '9') { validStatus = false; }
			}
			if (validStatus) { status = Strings.toInt(statusText); }
			responseBody = result.stdout().substring(0, marker);
		}
		if (status < 100 || status > 599) { status = 0; }

		if (result.code == 125 || responseBody.len() > maxResponseBytes) { return HTTPExchangeResult.failed("response body is too large"); }
		if (result.code != 0) { return HTTPExchangeResult.failed(f"curl failed (exit {result.code})"); }
		if (status == 0) { return HTTPExchangeResult.failed("curl returned an invalid HTTP status"); }
		return HTTPExchangeResult(status, Bytes.fromString(responseBody), "");
	}
}
