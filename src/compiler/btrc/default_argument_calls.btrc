/* Call-boundary construction for declaration-scoped default evaluators. */

OwnershipCallOperand? defaultArgumentBoundOperand(
        Vector<OwnershipCallOperand> operands, int parameterIndex) {
    int index = 0;
    while (index < operands.len) {
        OwnershipCallOperand operand = operands.get(index);
        if (operand.parameterIndex == parameterIndex) { return operand; }
        index = index + 1;
    }
    return null;
}

IRNode defaultArgumentEvaluatedValue(IRGen generator, Node expression,
        string dependency) {
    string key = astNodeKey(expression);
    if (!generator.owningTempOverrides.has(key)) {
        generator.typedOperatorFail("default argument dependency '"
            + dependency + "' was not evaluated before use");
    }
    return generator.owningTempOverrides.get(key);
}

IRNode lowerDefaultArgumentCall(IRGen generator, Node call,
        Vector<Node> parameters, Vector<OwnershipCallOperand> operands,
        OwnershipCallOperand operand, Map<string, Node> varTypes) {
    DefaultArgumentTarget target = defaultArgumentTarget(
        generator, call, varTypes);
    string symbol = ensureDefaultArgumentHelper(
        generator, call, parameters,
        operand.parameterIndex, varTypes);
    Vector<IRNode> arguments = [];
    if (target.selfType != null) {
        Node? receiver = ownershipInstanceReceiver(generator, call);
        if (receiver == null && call.callee != null
                && call.callee.kind == NK_FIELD_ACCESS_EXPR) {
            receiver = call.callee.obj;
        }
        if (receiver == null) {
            generator.typedOperatorFail(
                "default argument method receiver was not evaluated");
        }
        arguments.push(irCast(
            typeToC(target.selfType, generator.analyzed),
            defaultArgumentEvaluatedValue(
                generator, receiver, "method receiver")));
    }
    int prior = 0;
    while (prior < operand.parameterIndex) {
        OwnershipCallOperand? bound = defaultArgumentBoundOperand(
            operands, prior);
        if (bound == null) {
            generator.typedOperatorFail("default argument parameter '"
                + parameters.get(prior).name + "' is unbound");
        }
        OwnershipCallOperand concreteBound = bound;
        arguments.push(defaultArgumentEvaluatedValue(
            generator, concreteBound.expression,
            parameters.get(prior).name));
        prior = prior + 1;
    }
    return irCall(symbol, arguments);
}
