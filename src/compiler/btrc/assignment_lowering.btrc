/* Assignment lowering owner. The operation-local generator parameter supplies
 * recursive expression lowering without being retained by this owner. */

class AssignmentLowerer {
    private Analyzed analysis;
    private CallableBoundaryPolicy callableBoundaries;
    private CallableFlowState callableFlow;

    public AssignmentLowerer(
            Analyzed analysis,
            CallableBoundaryPolicy callableBoundaries,
            CallableFlowState callableFlow) {
        self.analysis = analysis;
        self.callableBoundaries = callableBoundaries;
        self.callableFlow = callableFlow;
    }

    public IRNode lower(
            IRGen generator, Node assignment,
            Map<string, Node> variableTypes) {
        CallableBoundaryContext callableContext =
            generator.assignmentCallableContext(variableTypes);
        Node? callableStorageType = generator.resolvedExpressionType(
            assignment.target, variableTypes);
        self.callableBoundaries.rejectAssignment(
            assignment, callableStorageType, callableContext);
        IRNode? ownedTarget = lowerOwnedAssignment(
            generator,
            assignment, variableTypes);
        if (ownedTarget != null) { return ownedTarget; }
        return self.lowerPlain(generator, assignment, variableTypes);
    }

    /* Lower with any enclosing ownership overrides already active. The
     * ownership boundary calls this operation directly so the target is not
     * rediscovered and a second result-retaining boundary is never nested. */
    public IRNode lowerPlain(
            IRGen generator, Node assignment,
            Map<string, Node> variableTypes) {
        CallableBoundaryContext callableContext =
            generator.assignmentCallableContext(variableTypes);
        int callableAssignmentAbi = 0;
        bool callableAssignment = assignment.op == "="
            && assignment.target != null
            && assignment.target.kind == NK_IDENTIFIER;
        if (callableAssignment) {
            callableAssignmentAbi =
                self.callableBoundaries.expressionAbi(
                    assignment.value_node, callableContext);
        }
        bool lexicalCallableTarget = assignment.target != null
            && assignment.target.kind == NK_IDENTIFIER
            && self.callableBoundaries.lexicalIdentifier(
                assignment.target.name, callableContext);
        Node? closureTargetType = generator.resolvedExpressionType(
            assignment.target, variableTypes);
        if (generator.callableValueEscapes(
                closureTargetType, assignment.value_node,
                variableTypes)) {
            generator.rejectClosureEscape(assignment);
        }

        IRNode? managedLocal =
            lowerManagedLocalStore(
                generator, assignment, variableTypes);
        if (managedLocal != null) { return managedLocal; }
        IRNode? managedField =
            generator.lowerManagedFieldAssignment(
                assignment, variableTypes);
        if (managedField != null) { return managedField; }
        IRNode? indirect = generator.lowerIndirectAssignment(
            assignment, variableTypes);
        if (indirect != null) { return indirect; }

        /* Property setter: obj.prop = v -> ClassName_set_prop(obj, v).
         * self.prop uses backing storage only while lowering that property's
         * compiler-backed accessor; every other self store calls the setter. */
        if (assignment.op == "=" && assignment.target != null
                && assignment.target.kind == NK_FIELD_ACCESS_EXPR) {
            Node target = assignment.target;
            Node? receiverType = generator.resolvedExpressionType(
                target.obj, variableTypes);
            Node? property = instanceMemberForType(
                self.analysis, receiverType, target.field);
            if (receiverType != null && property != null
                    && property.kind == NK_PROPERTY_DECL) {
                Node? propertyType = resolvedInstanceMemberType(
                    self.analysis, receiverType, property);
                if (propertyType == null) {
                    propertyType = property.type;
                }
                return lowerPropertyStoreWithOwnership(
                    generator, assignment, receiverType, property,
                    propertyType, variableTypes);
            }
        }

        /* Collection index assignment: coll[i] = v ->
         * {mangled}_set(coll, i, v). Raw generic backing arrays remain
         * ordinary C indexing. */
        if (assignment.op == "=" && assignment.target != null
                && assignment.target.kind == NK_INDEX_EXPR
                && !generator.inGenericMethod) {
            Node indexed = assignment.target;
            Node? receiverType = generator.resolvedExpressionType(
                indexed.obj, variableTypes);
            if (receiverType != null
                    && receiverType.generic_args.len > 0
                    && receiverType.pointer_depth == 0
                    && self.analysis.isGenericClass(
                        receiverType.base)) {
                string mangled = TypeIdentity.mangleGenericType(
                    receiverType.base, receiverType.generic_args);
                Vector<IRNode> arguments = [];
                arguments.push(generator.lowerExpr(
                    indexed.obj, variableTypes));
                arguments.push(generator.lowerExpr(
                    indexed.index, variableTypes));
                arguments.push(generator.lowerExpr(
                    assignment.value_node, variableTypes));
                return irCall(mangled + "_set", arguments);
            }
        }

        /* Empty collection literals use the target's inferred generic shape. */
        if (assignment.op == "=" && assignment.value_node != null
                && (assignment.value_node.kind == NK_BRACE_INITIALIZER
                    || assignment.value_node.kind == NK_MAP_LITERAL
                    || assignment.value_node.kind == NK_LIST_LITERAL)) {
            Node? targetType = generator.resolvedExpressionType(
                assignment.target, variableTypes);
            if (targetType != null && targetType.generic_args.len > 0
                    && self.analysis.isGenericClass(targetType.base)) {
                IRNode target = generator.lowerExpr(
                    assignment.target, variableTypes);
                IRNode value = irLiteral("NULL");
                if (assignment.value_node.kind
                        == NK_BRACE_INITIALIZER) {
                    value = generator.lowerBraceInit(
                        assignment.value_node,
                        variableTypes, targetType);
                } else if (assignment.value_node.kind
                        == NK_MAP_LITERAL) {
                    value = generator.lowerMapLiteral(
                        assignment.value_node,
                        variableTypes, targetType);
                } else {
                    value = generator.lowerListLiteral(
                        assignment.value_node,
                        variableTypes, targetType);
                }
                return irBinOp(target, "=", value);
            }
        }

        IRNode target = generator.lowerExpr(
            assignment.target, variableTypes);
        if (assignment.op != "=" && assignment.op.length() > 1) {
            IRNode value = generator.lowerExpr(
                assignment.value_node, variableTypes);
            Node? targetType = generator.resolvedExpressionType(
                assignment.target, variableTypes);
            Node? valueType = generator.resolvedExpressionType(
                assignment.value_node, variableTypes);
            string targetC = "int";
            if (targetType != null) {
                targetC = generator.directGenericTargetC(
                    assignment.target, targetType, variableTypes);
            }
            return generator.lowerDirectCompound(
                assignment.op, target, value,
                targetType, valueType, targetC);
        }

        /* Class upcasts need an explicit C pointer conversion. */
        if (assignment.op == "=") {
            Node? targetType = generator.resolvedExpressionType(
                assignment.target, variableTypes);
            Node? valueType = generator.resolvedExpressionType(
                assignment.value_node, variableTypes);
            IRNode value = irLiteral("0");
            if (targetType != null) {
                value = generator.lowerAssignedValue(
                    assignment.value_node,
                    targetType, variableTypes);
            } else {
                value = generator.lowerExpr(
                    assignment.value_node, variableTypes);
            }
            value = generator.upcastClassPointer(
                targetType, valueType, value);
            Node? callableTargetType = resolveTypedefType(
                targetType, self.analysis.typedefTable);
            if (assignment.target.kind == NK_IDENTIFIER
                    && callableTargetType != null
                    && callableTargetType.base == "__fn_ptr"
                    && lexicalCallableTarget) {
                self.callableFlow.setBindingAbi(
                    assignment.target.name,
                    callableAssignmentAbi);
                self.callableFlow.recordExceptional();
            }
            if (targetType != null
                    && assignment.target.kind != NK_IDENTIFIER) {
                return generator.lowerDirectStore(
                    target, value, targetType,
                    generator.directGenericTargetC(
                        assignment.target, targetType,
                        variableTypes));
            }
            return irBinOp(target, assignment.op, value);
        }
        return irBinOp(
            target, assignment.op,
            generator.lowerExpr(
                assignment.value_node, variableTypes));
    }
}
