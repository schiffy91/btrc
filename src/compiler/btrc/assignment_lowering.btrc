/* Assignment dispatch after target ownership has been sequenced exactly once. */

IRNode lowerAssignmentExpression(IRGen generator, Node node,
        Map<string, Node> varTypes) {
    Node? callableStorageType = generator.resolvedExpressionType(
        node.target, varTypes);
    rejectErasingCallableAssignmentBoundary(
        generator, node, callableStorageType, varTypes);
    IRNode? ownedTarget = lowerOwnedAssignment(
        generator, node, varTypes);
    if (ownedTarget != null) { return ownedTarget; }
    return lowerPlainAssignment(generator, node, varTypes);
}

/* Lower an assignment with any enclosing ownership overrides already active.
 * This is deliberately not routed through IRGen.lowerExpr: doing so would
 * rediscover the same target and nest a second result-retaining boundary. */
IRNode lowerPlainAssignment(IRGen generator, Node node,
        Map<string, Node> varTypes) {
    int callableAssignmentAbi = 0;
    bool callableAssignment = node.op == "="
        && node.target != null
        && node.target.kind == NK_IDENTIFIER;
    if (callableAssignment) {
        callableAssignmentAbi = generator.callableExpressionAbi(
            node.value_node, varTypes);
    }
    bool lexicalCallableTarget = node.target != null
        && node.target.kind == NK_IDENTIFIER
        && generator.callableIdentifierIsLexicalLocal(
            node.target.name);
    Node? closureTargetType = generator.resolvedExpressionType(
        node.target, varTypes);
    if (generator.callableValueEscapes(
            closureTargetType, node.value_node, varTypes)) {
        generator.rejectClosureEscape(node);
    }
    IRNode? managedLocal = lowerManagedLocalStore(
        generator, node, varTypes);
    if (managedLocal != null) { return managedLocal; }
    IRNode? managedField = generator.lowerManagedFieldAssignment(
        node, varTypes);
    if (managedField != null) { return managedField; }
    IRNode? indirect = generator.lowerIndirectAssignment(node, varTypes);
    if (indirect != null) { return indirect; }

    /* Property setter: obj.prop = v -> ClassName_set_prop(obj, v).
     * self.prop uses backing storage only while lowering that property's own
     * compiler-backed accessor; every other self store calls the setter. */
    if (node.op == "=" && node.target != null
            && node.target.kind == NK_FIELD_ACCESS_EXPR) {
        Node target = node.target;
        Node? ownerType = generator.resolvedExpressionType(
            target.obj, varTypes);
        Node? property = instanceMemberForType(
            generator.analyzed, ownerType, target.field);
        if (ownerType != null && property != null
                && property.kind == NK_PROPERTY_DECL) {
            Node? propertyType = resolvedInstanceMemberType(
                generator.analyzed, ownerType, property);
            if (propertyType == null) { propertyType = property.type; }
            return lowerPropertyStoreWithOwnership(generator,
                node, ownerType, property, propertyType, varTypes);
        }
    }

    /* Collection index assignment: coll[i] = v -> {mangled}_set(coll, i, v).
     * Raw backing arrays inside generic methods remain ordinary C indexing. */
    if (node.op == "=" && node.target != null
            && node.target.kind == NK_INDEX_EXPR
            && !generator.inGenericMethod) {
        Node indexed = node.target;
        Node? receiverType = generator.resolvedExpressionType(
            indexed.obj, varTypes);
        if (receiverType != null && receiverType.generic_args.len > 0
                && receiverType.pointer_depth == 0
                && generator.analyzed.isGenericClass(receiverType.base)) {
            string mangled = TypeIdentity.mangleGenericType(
                receiverType.base, receiverType.generic_args);
            Vector<IRNode> arguments = [];
            arguments.push(generator.lowerExpr(indexed.obj, varTypes));
            arguments.push(generator.lowerExpr(indexed.index, varTypes));
            arguments.push(generator.lowerExpr(node.value_node, varTypes));
            return irCall(mangled + "_set", arguments);
        }
    }

    /* Empty collection literals use the target's inferred generic shape. */
    if (node.op == "=" && node.value_node != null
            && (node.value_node.kind == NK_BRACE_INITIALIZER
                || node.value_node.kind == NK_MAP_LITERAL
                || node.value_node.kind == NK_LIST_LITERAL)) {
        Node? targetType = generator.resolvedExpressionType(
            node.target, varTypes);
        if (targetType != null && targetType.generic_args.len > 0
                && generator.analyzed.isGenericClass(targetType.base)) {
            IRNode target = generator.lowerExpr(node.target, varTypes);
            IRNode value = irLiteral("NULL");
            if (node.value_node.kind == NK_BRACE_INITIALIZER) {
                value = generator.lowerBraceInit(
                    node.value_node, varTypes, targetType);
            } else if (node.value_node.kind == NK_MAP_LITERAL) {
                value = generator.lowerMapLiteral(
                    node.value_node, varTypes, targetType);
            } else {
                value = generator.lowerListLiteral(
                    node.value_node, varTypes, targetType);
            }
            return irBinOp(target, "=", value);
        }
    }

    IRNode target = generator.lowerExpr(node.target, varTypes);
    if (node.op != "=" && node.op.length() > 1) {
        IRNode value = generator.lowerExpr(node.value_node, varTypes);
        Node? targetType = generator.resolvedExpressionType(
            node.target, varTypes);
        Node? valueType = generator.resolvedExpressionType(
            node.value_node, varTypes);
        string targetC = "int";
        if (targetType != null) {
            targetC = generator.directGenericTargetC(
                node.target, targetType, varTypes);
        }
        return generator.lowerDirectCompound(
            node.op, target, value, targetType, valueType, targetC);
    }

    /* Class upcasts need an explicit C pointer conversion. */
    if (node.op == "=") {
        Node? targetType = generator.resolvedExpressionType(
            node.target, varTypes);
        Node? valueType = generator.resolvedExpressionType(
            node.value_node, varTypes);
        IRNode value = irLiteral("0");
        if (targetType != null) {
            value = generator.lowerAssignedValue(
                node.value_node, targetType, varTypes);
        } else {
            value = generator.lowerExpr(node.value_node, varTypes);
        }
        value = generator.upcastClassPointer(targetType, valueType, value);
        Node? callableTargetType = resolveTypedefType(
            targetType, generator.analyzed.typedefTable);
        if (node.target.kind == NK_IDENTIFIER
                && callableTargetType != null
                && callableTargetType.base == "__fn_ptr"
                && lexicalCallableTarget) {
            generator.setCallableBindingAbi(
                node.target.name, callableAssignmentAbi);
            generator.recordExceptionalCallableFlow();
        }
        if (targetType != null
                && node.target.kind != NK_IDENTIFIER) {
            return generator.lowerDirectStore(
                target, value, targetType,
                generator.directGenericTargetC(
                    node.target, targetType, varTypes));
        }
        return irBinOp(target, node.op, value);
    }
    return irBinOp(
        target, node.op, generator.lowerExpr(node.value_node, varTypes));
}
