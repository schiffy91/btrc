/* Fail closed when a volatile automatic would lose a pointee qualifier.
 * btrc currently models only an outer object qualifier, so it cannot express
 * the layered C type required by an address or array-decay alias. */

class SetjmpQualifierValidator {
    public SetjmpQualifierValidator() {}

    private IRNode? visibleAutomatic(string name, Vector<IRNode> visible) {
        int index = visible.len - 1;
        while (index >= 0) {
            IRNode declaration = visible.get(index);
            if (declaration.name == name) { return declaration; }
            index = index - 1;
        }
        return null;
    }

    private IRParam? visibleParameter(string name, Vector<IRParam> params) {
        int index = 0;
        while (index < params.len) {
            IRParam parameter = params.get(index);
            if (parameter.name == name) { return parameter; }
            index = index + 1;
        }
        return null;
    }

    private void addVisible(Vector<IRNode> visible, IRNode? declaration) {
        if (declaration != null && declaration.kind == IRK_VAR_DECL) {
            visible.push(declaration);
        }
    }

    private void rejectAlias(string name, bool inferred) {
        string reason = "has explicitly volatile storage";
        if (inferred) {
            reason = "is modified across try/throw and requires volatile storage";
        }
        fprintf(stderr,
            "error: storage object '%s' %s; its address or array decay requires unsupported layered pointer qualifiers\n",
            name, reason);
        exit(1);
    }

    private void validateExpression(IRNode? node,
            Vector<IRNode> visible, Vector<IRParam> params,
            int parentKind, string parentField) {
        if (node == null) { return; }
        if (node.kind == IRK_STMT_EXPR) {
            Vector<IRNode> local = copySetjmpVisible(visible);
            int statementIndex = 0;
            while (statementIndex < node.stmts.len) {
                self.validateStatement(
                    node.stmts.get(statementIndex), local, params);
                statementIndex = statementIndex + 1;
            }
            self.validateExpression(
                node.result, local, params, node.kind, "result");
            return;
        }
        if (node.kind == IRK_ADDRESS_OF && node.source_address
                && parentKind != IRK_SIZEOF) {
            string root = irDirectStorageRoot(node.expr);
            if (root != "" && !setjmpCompilerOwnedStorage(root)) {
                IRNode? declaration = self.visibleAutomatic(root, visible);
                if (declaration != null && declaration.is_volatile
                        && declaration.setjmp_inferred_volatile) {
                    self.rejectAlias(
                        root, true);
                }
                if (declaration == null) {
                    IRParam? parameter = self.visibleParameter(root, params);
                    if (parameter != null && parameter.is_volatile
                            && parameter.setjmp_inferred_volatile) {
                        self.rejectAlias(
                            root, true);
                    }
                }
            }
        }
        if (node.kind == IRK_VAR && !setjmpCompilerOwnedStorage(node.name)) {
            IRNode? declaration = self.visibleAutomatic(node.name, visible);
            bool safeIndex = parentKind == IRK_INDEX && parentField == "obj";
            if (declaration != null && declaration.is_volatile
                    && declaration.setjmp_inferred_volatile
                    && declaration.is_array_decl
                    && parentKind != IRK_SIZEOF && !safeIndex) {
                self.rejectAlias(node.name, true);
            }
            return;
        }
        if (node.kind == IRK_FIELD_ACCESS && node.array_storage_known
                && node.array_storage_root != ""
                && !setjmpCompilerOwnedStorage(node.array_storage_root)
                && parentKind != IRK_SIZEOF
                && !(parentKind == IRK_INDEX && parentField == "obj")) {
            IRNode? declaration = self.visibleAutomatic(
                node.array_storage_root, visible);
            if (declaration != null && declaration.is_volatile
                    && declaration.setjmp_inferred_volatile) {
                self.rejectAlias(
                    node.array_storage_root, true);
            }
            if (declaration == null) {
                IRParam? parameter = self.visibleParameter(
                    node.array_storage_root, params);
                if (parameter != null && parameter.is_volatile
                        && parameter.setjmp_inferred_volatile) {
                    self.rejectAlias(
                        node.array_storage_root, true);
                }
            }
        }
        self.validateExpression(
            node.left, visible, params, node.kind, "left");
        self.validateExpression(
            node.right, visible, params, node.kind, "right");
        self.validateExpression(
            node.operand, visible, params, node.kind, "operand");
        self.validateExpression(
            node.expr, visible, params, node.kind, "expr");
        self.validateExpression(
            node.obj, visible, params, node.kind, "obj");
        self.validateExpression(
            node.index, visible, params, node.kind, "index");
        self.validateExpression(
            node.condition, visible, params, node.kind, "condition");
        self.validateExpression(
            node.true_expr, visible, params, node.kind, "true_expr");
        self.validateExpression(
            node.false_expr, visible, params, node.kind, "false_expr");
        self.validateExpression(
            node.array_size, visible, params, node.kind, "array_size");
        self.validateExpression(
            node.init, visible, params, node.kind, "init");
        self.validateExpression(
            node.value, visible, params, node.kind, "value");
        self.validateExpression(
            node.target, visible, params, node.kind, "target");
        self.validateExpression(
            node.update, visible, params, node.kind, "update");
        self.validateExpression(
            node.result, visible, params, node.kind, "result");
        int index = 0;
        while (index < node.args.len) {
            self.validateExpression(
                node.args.get(index), visible, params, node.kind, "args");
            index = index + 1;
        }
    }

    private void validateBlock(IRNode? block,
            Vector<IRNode> inherited, Vector<IRParam> params) {
        if (block == null) { return; }
        Vector<IRNode> visible = copySetjmpVisible(inherited);
        int index = 0;
        while (index < block.stmts.len) {
            self.validateStatement(
                block.stmts.get(index), visible, params);
            index = index + 1;
        }
    }

    private void validateStatement(IRNode statement,
            Vector<IRNode> visible, Vector<IRParam> params) {
        if (statement.kind == IRK_VAR_DECL) {
            self.validateExpression(
                statement.array_size, visible, params, statement.kind, "array_size");
            self.addVisible(visible, statement);
            self.validateExpression(
                statement.init, visible, params, statement.kind, "init");
            return;
        }
        if (statement.kind == IRK_IF) {
            self.validateExpression(
                statement.condition, visible, params, statement.kind, "condition");
            self.validateBlock(statement.then_block, visible, params);
            self.validateBlock(statement.else_block, visible, params);
            return;
        }
        if (statement.kind == IRK_WHILE || statement.kind == IRK_DO_WHILE) {
            self.validateExpression(
                statement.condition, visible, params, statement.kind, "condition");
            self.validateBlock(statement.body, visible, params);
            return;
        }
        if (statement.kind == IRK_FOR) {
            Vector<IRNode> local = copySetjmpVisible(visible);
            if (statement.init != null) {
                self.validateStatement(statement.init, local, params);
            }
            self.validateExpression(
                statement.condition, local, params, statement.kind, "condition");
            self.validateExpression(
                statement.update, local, params, statement.kind, "update");
            self.validateBlock(statement.body, local, params);
            return;
        }
        if (statement.kind == IRK_SWITCH) {
            self.validateExpression(
                statement.value, visible, params, statement.kind, "value");
            int caseIndex = 0;
            while (caseIndex < statement.args.len) {
                IRNode caseNode = statement.args.get(caseIndex);
                Vector<IRNode> local = copySetjmpVisible(visible);
                self.validateExpression(
                    caseNode.value, local, params, caseNode.kind, "value");
                int childIndex = 0;
                while (childIndex < caseNode.stmts.len) {
                    self.validateStatement(
                        caseNode.stmts.get(childIndex), local, params);
                    childIndex = childIndex + 1;
                }
                caseIndex = caseIndex + 1;
            }
            return;
        }
        if (statement.kind == IRK_BLOCK) {
            self.validateBlock(statement, visible, params);
            return;
        }
        self.validateExpression(
            statement, visible, params, IRK_NONE, "");
    }

    public void validateFunction(IRFunction definition) {
        Vector<IRNode> visible = [];
        self.validateBlock(
            definition.body, visible, definition.params);
    }

    public void validateGlobals(IRModule module) {
        Vector<IRNode> visible = [];
        Vector<IRParam> params = [];
        int index = 0;
        while (index < module.global_decls.len) {
            IRGlobalDecl declaration = module.global_decls.get(index);
            self.validateExpression(
                declaration.array_size, visible, params, IRK_NONE, "array_size");
            self.validateExpression(
                declaration.init, visible, params, IRK_NONE, "init");
            index = index + 1;
        }
    }
}
