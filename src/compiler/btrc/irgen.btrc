/* Stage 4 — IR generation (minimal).
 *
 * Mirrors the subset of src/compiler/python/ir/gen/* needed for the pure-int
 * --no-stdlib programs. Walks the parsed AST (Node tree) + Analyzed tables to
 * produce an IRModule of structured IR nodes. All lowering happens here.
 *
 * Variable types are tracked in a per-function Map<string, Node> (name ->
 * declared TypeExpr) used for on-demand type inference (div/mod helper choice).
 */

/* Standard includes (matches _STANDARD_INCLUDES in generator.py). */
Vector<string> standardIncludes() {
    Vector<string> inc = [];
    inc.push("#define _DEFAULT_SOURCE");
    inc.push("#define _DARWIN_C_SOURCE");
    inc.push("stdio.h");
    inc.push("stdlib.h");
    inc.push("string.h");
    inc.push("stdbool.h");
    inc.push("stdint.h");
    inc.push("ctype.h");
    inc.push("math.h");
    inc.push("assert.h");
    inc.push("limits.h");
    return inc;
}

/* Pointer-depth suffix for mangling (mirrors types._pointer_suffix): "_p{n}"
 * for depth>0, "" for depth 0. */
string pointerSuffix(Node t) {
    if (t.pointer_depth > 0) { return "_p" + Strings.fromInt(t.pointer_depth); }
    return "";
}

/* Mangle a single type for use in a C identifier (mirrors types.mangle_type_name).
 * Recurses through nested generic args; "string" stays "string"; the pointer
 * suffix encodes pointer depth. */
string mangleTypeName(Node t) {
    if (t.generic_args.len > 0) {
        string inner = "";
        int i = 0;
        while (i < t.generic_args.len) {
            if (i > 0) { inner = inner + "_"; }
            inner = inner + mangleTypeName(t.generic_args.get(i));
            i = i + 1;
        }
        return t.base + "_" + inner + pointerSuffix(t);
    }
    return t.base + pointerSuffix(t);
}

/* A stable identity key for an AST node, used to map an owning-temporary
 * argument node to its hoisted temp var (Python keys this on id(node); we use
 * the node's source position, which is unique per argument expression). */
string nodeKey(Node n) {
    return Strings.fromInt(n.line) + ":" + Strings.fromInt(n.col);
}

/* Mangle a generic type: List<int> -> btrc_List_int (mirrors
 * types.mangle_generic_type). */
string mangleGenericType(string base, Vector<Node> args) {
    string parts = "";
    int i = 0;
    while (i < args.len) {
        if (i > 0) { parts = parts + "_"; }
        parts = parts + mangleTypeName(args.get(i));
        i = i + 1;
    }
    return "btrc_" + base + "_" + parts;
}

/* C function name for a monomorphized generic-METHOD instance:
 * {class_part}_{method}_{method_arg_mangles}, e.g. btrc_Vector_int_mapTo_string
 * for Vector<int>.mapTo<string>. The class part is mangleGenericType for a
 * generic owner, or the bare class base for a non-generic owner. Mirrors
 * generics.methods_mono.generic_method_instance_name. */
string genericMethodInstanceName(string classBase, Vector<Node> classArgs,
                                 string methodName, Vector<Node> methodArgs) {
    string classPart = classBase;
    if (classArgs.len > 0) { classPart = mangleGenericType(classBase, classArgs); }
    string methodPart = "";
    int i = 0;
    while (i < methodArgs.len) {
        if (i > 0) { methodPart = methodPart + "_"; }
        methodPart = methodPart + mangleTypeName(methodArgs.get(i));
        i = i + 1;
    }
    return classPart + "_" + methodName + "_" + methodPart;
}

/* Get/create the typedef name for a function-pointer type and register its
 * typedef text in the Analyzed cache (mirrors types.fn_ptr_typedef_name +
 * get_fn_ptr_typedefs). generic_args is [ret, param1, param2, ...]. The mangled
 * name is __btrc_fn_<ret>_<p1>_<p2>...; the body is
 * `typedef <ret> (*<mangled>)(<params>);`. */
string fnPtrTypedefName(Node t, Analyzed a) {
    string retC = "void";
    if (t.generic_args.len > 0) { retC = typeToC(t.generic_args.get(0), a); }
    /* Mangled name from ALL generic args (ret + params). */
    string mangled = "__btrc_fn";
    int i = 0;
    while (i < t.generic_args.len) {
        mangled = mangled + "_" + mangleTypeName(t.generic_args.get(i));
        i = i + 1;
    }
    if (!a.fnPtrTypedefs.has(mangled)) {
        string paramsStr = "void";
        if (t.generic_args.len > 1) {
            paramsStr = "";
            int p = 1;
            while (p < t.generic_args.len) {
                if (p > 1) { paramsStr = paramsStr + ", "; }
                paramsStr = paramsStr + typeToC(t.generic_args.get(p), a);
                p = p + 1;
            }
        }
        string td = "typedef " + retC + " (*" + mangled + ")(" + paramsStr + ");";
        a.fnPtrTypedefs.put(mangled, td);
        a.fnPtrOrder.push(mangled);
    }
    return mangled;
}

/* btrc TypeExpr Node -> C type string (mirrors types.py type_to_c, int subset
 * plus user classes + generic instances). `a` supplies the class table so class
 * types become pointers (classes are always heap-allocated). */
string typeToC(Node t, Analyzed a) {
    if (t == null) { return "void"; }
    string base = t.base;
    /* Function-pointer type __fn_ptr(ret, params...) -> mangled typedef name. */
    if (base == "__fn_ptr" && t.generic_args.len > 0) {
        return fnPtrTypedefName(t, a);
    }
    /* Thread<T> / Mutex<T> -> opaque runtime-handle pointers (mirrors
     * types.type_to_c). These are not user generics: no struct/mangled name,
     * just the pthread-backed handle typedef. Checked before the generic-arg
     * mangling branch below. */
    if (base == "Thread" && t.generic_args.len > 0) { return "__btrc_thread_t*"; }
    if (base == "Mutex" && t.generic_args.len > 0) { return "__btrc_mutex_val_t*"; }
    string prefix = "";
    if (t.is_const) { prefix = "const "; }
    string c = base;
    /* Generic instance type (List<int>, user generics): mangled name. Class-typed
     * args have already been upgraded to pointers by upgradeProgramGenericArgs
     * (the AST pass that mirrors the reference's _upgrade_class_type), so the
     * mangled name carries the `_p1` suffix (`btrc_Vector_OwnedItem_p1`). */
    if (t.generic_args.len > 0) {
        c = mangleGenericType(base, t.generic_args);
    } else if (base == "string") { c = "char*"; }
    else if (base == "bool") { c = "bool"; }
    else if (base == "byte") { c = "unsigned char"; }
    else if (base == "uint") { c = "unsigned int"; }
    /* int/float/double/char/void/long/short/size_t map to themselves;
     * user classes also map to their own name (pointer applied below). */
    int p = 0;
    while (p < t.pointer_depth) { c = c + "*"; p = p + 1; }
    /* Class types are reference types: append one pointer level if the source
     * type wasn't already a pointer (mirrors _upgrade_class_type pointer_depth=1
     * with type_to_c then applying it). Generic class instances are likewise
     * heap-allocated reference types. */
    if (t.generic_args.len == 0 && a.isClass(base) && t.pointer_depth == 0) {
        c = c + "*";
    } else if (t.generic_args.len > 0 && a.isGenericClass(base) && t.pointer_depth == 0) {
        c = c + "*";
    }
    if (t.is_array) { c = c + "*"; }
    return prefix + c;
}

/* A scope-managed local variable: an ARC-owned class instance to be released on
 * scope exit / return (mirrors the (var_name, class_name) tuples in the Python
 * generator's _managed_vars_stack). */
class Managed {
    public string name;
    public string cls;
    public Managed(string name, string cls) {
        self.name = name;
        self.cls = cls;
    }
}

class IRGen {
    public Analyzed analyzed;
    /* Runtime helpers referenced during lowering (name -> true). */
    public Map<string, bool> usedHelpers;

    /* ARC managed-variable tracking. `managedStack` is a flat list of all
     * currently-live managed vars across nested scopes; `scopeStarts` records
     * the index in managedStack where each open scope began (so a scope's vars
     * are managedStack[start..end]). Mirrors generator._managed_vars_stack. */
    public Vector<Managed> managedStack;
    public Vector<int> scopeStarts;
    /* Loop-body scope markers: each entry is a `managedStack` length recorded at
     * the start of a loop body, so break/continue can release exactly the
     * managed vars declared inside the current (innermost) loop body. Mirrors
     * generator._loop_scope_depths. */
    public Vector<int> loopScopeDepths;
    /* The var-type map in scope while resolving a call's params for keep-ARC.
     * Set by keepCallArcStmts before paramsForCall walks the callee's receiver
     * type. */
    public Map<string, Node> callParamVarTypes;
    /* Nesting depth of try blocks currently being lowered. Managed-var decls at
     * depth > 0 register an exception-cleanup so a throw (longjmp) still releases
     * them. Mirrors generator.in_try_depth. */
    public int inTryDepth;
    /* Owning-temporary overrides: a `new X()`/ctor-call argument hoisted into a
     * temp so the call references the temp (and the temp can be released after).
     * Keyed by the arg AST node's "line:col"; the value is the temp's IRVar.
     * lowerExpr consults this before lowering an expression. Mirrors
     * generator._owning_temp_overrides (keyed there by id(node)). */
    public Map<string, IRNode> owningTempOverrides;

    /* Unique temp counter (mirrors generator._temp_counter / fresh_temp). */
    public int tempCounter;

    /* Current class being lowered ("" outside any class) — set while emitting a
     * class's methods/constructor so self-typing works. */
    public string currentClass;

    /* C return type of the function currently being lowered (for the return-path
     * release temp; mirrors generator.current_return_c_type). */
    public string currentReturnCType;

    /* AST return-type of the function currently being lowered (null = none). Used
     * for implicit class->string coercion on `return` (mirrors generator.
     * current_return_type + stringable.coerce_value_to_string). */
    public Node? currentReturnTypeNode;

    /* True while lowering a monomorphized generic method/constructor body. The
     * generic emitter (user_emitter.py) lowers binary operators RAW — no div/mod
     * helpers, no string-concat helpers, no operator-overload dispatch — so this
     * flag suppresses those transforms to stay byte-identical. */
    public bool inGenericMethod;

    /* The {type-param -> concrete-type} map for the generic instance whose body
     * is currently being lowered (empty outside a generic method). Body-level
     * type references (cast targets, sizeof, local var decls) resolve through
     * this so `T`/`K`/`V` become the concrete element types. Mirrors
     * _UserGenericEmitter.type_map + _resolve in user_emitter.py. */
    public Map<string, Node> activeTypeMap;

    /* The module currently being generated, so deep expression lowering (lambda
     * lifting) can append the lifted static function + capture-env struct.
     * Mirrors generator.module. */
    public IRModule curModule;

    /* Lambda lifting state (mirrors generator._lambda_counter / fresh_lambda_id
     * / _last_lambda_id / _fn_ptr_envs). lambdaCounter assigns unique ids;
     * lastLambdaId links a just-lowered lambda to its var-decl env allocation;
     * fnPtrEnvFn/fnPtrEnvVar map a captured-lambda variable name -> the impl fn
     * name and its on-stack env var, so a call bypasses the fn pointer. */
    public int lambdaCounter;
    public int lastLambdaId;
    public Map<string, string> fnPtrEnvFn;
    public Map<string, string> fnPtrEnvVar;

    public IRGen(Analyzed analyzed) {
        self.analyzed = analyzed;
        self.usedHelpers = {};
        self.managedStack = [];
        self.scopeStarts = [];
        self.loopScopeDepths = [];
        self.callParamVarTypes = {};
        self.inTryDepth = 0;
        self.owningTempOverrides = {};
        self.tempCounter = 0;
        self.currentClass = "";
        self.currentReturnCType = "void";
        self.currentReturnTypeNode = null;
        self.inGenericMethod = false;
        self.activeTypeMap = {};
        self.curModule = null;
        self.lambdaCounter = 0;
        self.lastLambdaId = 0;
        self.fnPtrEnvFn = {};
        self.fnPtrEnvVar = {};
    }

    /* fresh_lambda_id: unique increasing lambda id (mirrors fresh_lambda_id). */
    public int freshLambdaId() {
        self.lambdaCounter = self.lambdaCounter + 1;
        return self.lambdaCounter;
    }

    /* Resolve a body-level TypeExpr through the active generic type map (so `T`
     * -> the concrete element type) while lowering a monomorphized generic
     * method body; identity otherwise. */
    public Node resolveBodyType(Node? t) {
        if (self.inGenericMethod) { return resolveGenericType(t, self.activeTypeMap); }
        if (t == null) { return makePrimType("void"); }
        return t;
    }

    public void useHelper(string name) {
        self.usedHelpers.put(name, true);
    }

    /* fresh_temp: unique name "{prefix}_{n}" (mirrors generator.fresh_temp). */
    public string freshTemp(string prefix) {
        self.tempCounter = self.tempCounter + 1;
        return prefix + "_" + Strings.fromInt(self.tempCounter);
    }

    /* --- ARC managed-variable scope tracking --- */

    public void pushManagedScope() {
        self.scopeStarts.push(self.managedStack.len);
    }

    /* Pop the current scope, returning its managed vars in declaration order. */
    public Vector<Managed> popManagedScope() {
        Vector<Managed> out = [];
        if (self.scopeStarts.len == 0) { return out; }
        int start = self.scopeStarts.pop();
        int i = start;
        while (i < self.managedStack.len) {
            out.push(self.managedStack.get(i));
            i = i + 1;
        }
        /* Truncate the flat stack back to the scope start. */
        int extra = self.managedStack.len - start;
        int k = 0;
        while (k < extra) { self.managedStack.pop(); k = k + 1; }
        return out;
    }

    public void registerManagedVar(string name, string cls) {
        self.managedStack.push(Managed(name, cls));
    }

    /* Inside a try block, register an exception cleanup for a managed local so a
     * throw (longjmp) still releases it (normal scope exit discards it). Marks
     * the matching IRVarDecl volatile so the `var = NULL` after delete is not
     * optimized away (avoids a double-free). Mirrors
     * variables._maybe_register_cleanup. */
    public void maybeRegisterCleanup(string varName, string destroyFn,
            Vector<IRNode> stmts) {
        if (self.inTryDepth <= 0) { return; }
        /* NOTE: btrcpy also marks the var's IRVarDecl volatile so an optimizer
         * can't drop the post-delete `var = NULL`; the verification harness
         * compiles without -O, and btrc's IRNode has no volatile flag, so we omit
         * it. */
        self.useHelper("__btrc_register_cleanup");
        Vector<IRNode> cargs = [];
        cargs.push(irRawExpr("(void**)&" + varName));
        cargs.push(irRawExpr("(__btrc_cleanup_fn)" + destroyFn));
        stmts.push(irExprStmt(irCall("__btrc_register_cleanup", cargs)));
    }

    /* Drop a variable from auto-management across all open scopes (the user is
     * managing it manually). Rebuilds the flat managedStack without `name` and
     * shifts each scope-start marker down by the count of removed entries that
     * preceded it, so scope boundaries stay valid. Mirrors
     * generator.unregister_managed_var. */
    public void unregisterManagedVar(string name) {
        Vector<Managed> kept = [];
        /* removedBefore[k] = number of entries removed at flat indices < k. */
        int removedSoFar = 0;
        Vector<int> removedBeforeIndex = [];
        int i = 0;
        while (i < self.managedStack.len) {
            removedBeforeIndex.push(removedSoFar);
            Managed mv = self.managedStack.get(i);
            if (mv.name == name) { removedSoFar = removedSoFar + 1; }
            else { kept.push(mv); }
            i = i + 1;
        }
        if (removedSoFar == 0) { return; }
        self.managedStack = kept;
        /* Shift every scope-start marker down by how many removed entries were
         * strictly before it. */
        int s = 0;
        while (s < self.scopeStarts.len) {
            int start = self.scopeStarts.get(s);
            int shift = removedSoFar;
            if (start < removedBeforeIndex.len) { shift = removedBeforeIndex.get(start); }
            self.scopeStarts.set(s, start - shift);
            s = s + 1;
        }
        /* Likewise for loop-scope markers. */
        int l = 0;
        while (l < self.loopScopeDepths.len) {
            int d = self.loopScopeDepths.get(l);
            int shift = removedSoFar;
            if (d < removedBeforeIndex.len) { shift = removedBeforeIndex.get(d); }
            self.loopScopeDepths.set(l, d - shift);
            l = l + 1;
        }
    }

    /* All managed vars across all open scopes, in declaration order. */
    public Vector<Managed> getAllManagedVars() {
        Vector<Managed> out = [];
        int i = 0;
        while (i < self.managedStack.len) {
            out.push(self.managedStack.get(i));
            i = i + 1;
        }
        return out;
    }

    /* Mark the managedStack length that belongs outside the current loop body.
     * Mirrors generator.push_loop_scope. */
    public void pushLoopScope() {
        self.loopScopeDepths.push(self.managedStack.len);
    }

    /* Remove the current loop-body scope marker. Mirrors pop_loop_scope. */
    public void popLoopScope() {
        if (self.loopScopeDepths.len > 0) { self.loopScopeDepths.pop(); }
    }

    /* Managed vars a break/continue must release: everything declared since the
     * innermost loop body began. Mirrors generator.get_loop_managed_vars. */
    public Vector<Managed> getLoopManagedVars() {
        Vector<Managed> out = [];
        if (self.loopScopeDepths.len == 0) { return out; }
        int start = self.loopScopeDepths.get(self.loopScopeDepths.len - 1);
        int i = start;
        while (i < self.managedStack.len) {
            out.push(self.managedStack.get(i));
            i = i + 1;
        }
        return out;
    }

    public IRModule generate(Node prog) {
        IRModule m = IRModule();
        self.curModule = m;
        m.includes = standardIncludes();
        /* setjmp.h is required (after the standard prologue, before the stdlib's
         * own #include directives) whenever any declaration uses try/catch or
         * throw — mirrors generator._emit_includes scanning _uses_trycatch. */
        if (programUsesTrycatch(prog)) { m.includes.push("setjmp.h"); }
        self.emitForwardDecls(prog, m);
        self.emitGenericInstances(m);
        self.emitMethodGenericInstances(m);
        self.emitDeclarations(prog, m);
        /* Function-pointer typedefs accumulated during lowering are emitted into
         * forward_decls (after the struct typedefs already there, before all
         * function/struct bodies). Mirrors generator._emit_fn_ptr_typedefs which
         * appends get_fn_ptr_typedefs() to module.forward_decls. */
        int ft = 0;
        while (ft < self.analyzed.fnPtrOrder.len) {
            string fm = self.analyzed.fnPtrOrder.get(ft);
            m.forward_decls.push(self.analyzed.fnPtrTypedefs.get(fm));
            ft = ft + 1;
        }
        /* Stage 5 — reachability DCE (functions then structs), then helpers.
         * Mirrors optimizer.optimize: dead helpers are pruned via usedHelpers
         * tracking in collectHelpers (called last). */
        optimizeModule(m);
        self.collectHelpers(m);
        return m;
    }

    /* Emit all top-level declarations in source order: classes lower to a struct
     * def + method forward decls + init/new/destroy/methods functions; functions
     * lower to a single function. Mirrors _emit_declarations. */
    public void emitDeclarations(Node prog, IRModule m) {
        int i = 0;
        while (i < prog.declarations.len) {
            Node d = prog.declarations.get(i);
            if (d.kind == NK_CLASS_DECL) {
                if (d.generic_params.len == 0) { self.emitClassDecl(d, m); }
            } else if (d.kind == NK_FUNCTION_DECL) {
                /* Bodyless FunctionDecl (e.g. `bool is_even(int n);`) is a
                 * forward declaration, NOT a definition. Emit it as a forward
                 * decl string and skip function_defs — otherwise we'd emit an
                 * empty-bodied definition that collides with the real one
                 * (mirrors functions.emit_function_decl: body is None branch). */
                if (d.body_node == null) {
                    string fret = typeToC(d.return_type, self.analyzed);
                    if (fret == "") { fret = "void"; }
                    string fparams = "";
                    int fp = 0;
                    while (fp < d.params.len) {
                        Node pp = d.params.get(fp);
                        if (fp > 0) { fparams = fparams + ", "; }
                        fparams = fparams + typeToC(pp.type, self.analyzed) + " " + pp.name;
                        fp = fp + 1;
                    }
                    if (fparams == "") { fparams = "void"; }
                    m.forward_decls.push(f"{fret} {d.name}({fparams});");
                } else {
                    m.functions.push(self.lowerFunction(d));
                }
            } else if (d.kind == NK_STRUCT_DECL) {
                self.emitStructDecl(d, m);
            } else if (d.kind == NK_ENUM_DECL) {
                self.emitEnumDecl(d, m);
            } else if (d.kind == NK_RICH_ENUM_DECL) {
                self.emitRichEnumDecl(d, m);
            } else if (d.kind == NK_VAR_DECL_STMT) {
                self.emitGlobalVar(d, m);
            } else if (d.kind == NK_PREPROCESSOR_DIRECTIVE) {
                self.emitPreprocessor(d, m);
            }
            i = i + 1;
        }
    }

    /* Emit a plain enum (NK_ENUM_DECL) as a C `typedef enum {...}` plus a
     * static `<Name>_toString` switch function. Mirrors enums._emit_enum.
     * Both are emitted as raw_sections (the btrc IRModule has no enum_defs);
     * the typedef precedes any function definition so user code can name the
     * enum type and its prefixed values. */
    public void emitEnumDecl(Node d, IRModule m) {
        string name = d.name;
        /* typedef enum { Name_VALUE = expr, ... } Name; */
        string body = "typedef enum {\n";
        int i = 0;
        while (i < d.values.len) {
            Node v = d.values.get(i);
            string line = "    " + name + "_" + v.name;
            if (v.value_node != null) {
                Map<string, Node> empty = {};
                line = line + " = " + irExprText(self.lowerExpr(v.value_node, empty));
            }
            if (i < d.values.len - 1) { line = line + ","; }
            body = body + line + "\n";
            i = i + 1;
        }
        body = body + "} " + name + ";";
        m.raw_sections.push(body);
        /* static const char* Name_toString(Name val) { switch (val) {...} } */
        m.raw_sections.push(self.enumToStringText(name, d.values, false));
    }

    /* Emit a rich (tagged-union) enum (NK_RICH_ENUM_DECL): a tag enum, per-variant
     * data structs, a tagged-union struct, variant constructors, and a toString
     * function. Mirrors enums._emit_rich_enum. */
    public void emitRichEnumDecl(Node d, IRModule m) {
        string name = d.name;
        /* Tag enum: typedef enum { Name_V_TAG = i, ... } Name_Tag; */
        string tagBody = "typedef enum {\n";
        int i = 0;
        while (i < d.variants.len) {
            Node v = d.variants.get(i);
            string line = "    " + name + "_" + v.name + "_TAG = " + Strings.fromInt(i);
            if (i < d.variants.len - 1) { line = line + ","; }
            tagBody = tagBody + line + "\n";
            i = i + 1;
        }
        tagBody = tagBody + "} " + name + "_Tag;";
        m.raw_sections.push(tagBody);
        /* Per-variant data structs (only variants with params). Forward-declared
         * typedef then a full struct, mirroring enums._emit_rich_enum. */
        int v2 = 0;
        while (v2 < d.variants.len) {
            Node v = d.variants.get(v2);
            if (v.params.len > 0) {
                string sn = name + "_" + v.name + "_Data";
                m.raw_sections.push(f"typedef struct {sn} {sn};");
                string sb = "struct " + sn + " {\n";
                int p = 0;
                while (p < v.params.len) {
                    Node par = v.params.get(p);
                    sb = sb + "    " + typeToC(par.type, self.analyzed) + " " + par.name + ";\n";
                    p = p + 1;
                }
                sb = sb + "};";
                m.raw_sections.push(sb);
            }
            v2 = v2 + 1;
        }
        /* Main tagged-union struct. */
        string unionFields = "";
        int v3 = 0;
        while (v3 < d.variants.len) {
            Node v = d.variants.get(v3);
            if (v.params.len > 0) {
                unionFields = unionFields + "        " + name + "_" + v.name
                    + "_Data " + v.name + ";\n";
            }
            v3 = v3 + 1;
        }
        if (unionFields != "") {
            string us = "typedef struct {\n    " + name + "_Tag tag;\n"
                + "    union {\n" + unionFields + "    } data;\n} " + name + ";";
            m.raw_sections.push(us);
        } else {
            m.raw_sections.push("typedef struct {\n    " + name + "_Tag tag;\n} " + name + ";");
        }
        /* Variant constructors: static Name Name_V(params) { ... }. The setup is
         * hoisted to a local so a class-field store never null-derefs; here the
         * fields are value-typed primitives so a plain struct assignment suffices. */
        int v4 = 0;
        while (v4 < d.variants.len) {
            Node v = d.variants.get(v4);
            string params = "";
            if (v.params.len == 0) {
                params = "void";
            } else {
                int p = 0;
                while (p < v.params.len) {
                    Node par = v.params.get(p);
                    if (p > 0) { params = params + ", "; }
                    params = params + typeToC(par.type, self.analyzed) + " " + par.name;
                    p = p + 1;
                }
            }
            string cb = "static " + name + " " + name + "_" + v.name + "(" + params + ") {\n";
            cb = cb + "    " + name + " __result;\n";
            cb = cb + "    __result.tag = " + name + "_" + v.name + "_TAG;\n";
            int p2 = 0;
            while (p2 < v.params.len) {
                Node par = v.params.get(p2);
                cb = cb + "    __result.data." + v.name + "." + par.name
                    + " = " + par.name + ";\n";
                p2 = p2 + 1;
            }
            cb = cb + "    return __result;\n}";
            m.raw_sections.push(cb);
            v4 = v4 + 1;
        }
        /* toString over the tag field. */
        m.raw_sections.push(self.enumToStringText(name, d.variants, true));
    }

    /* Build the C text of a `<Name>_toString` switch function. For a plain enum
     * (`rich` false) the switch is over `val` and cases are `Name_VALUE`; for a
     * rich enum the switch is over `val.tag` and cases are `Name_VARIANT_TAG`.
     * Mirrors the toString IRFunctionDef in enums.py. */
    public string enumToStringText(string name, Vector<Node> items, bool rich) {
        string switchExpr = "val";
        if (rich) { switchExpr = "val.tag"; }
        string s = "static const char* " + name + "_toString(" + name + " val) {\n";
        s = s + "    switch (" + switchExpr + ") {\n";
        int i = 0;
        while (i < items.len) {
            Node it = items.get(i);
            string caseLabel = name + "_" + it.name;
            if (rich) { caseLabel = caseLabel + "_TAG"; }
            s = s + "        case " + caseLabel + ":\n";
            s = s + "            return \"" + it.name + "\";\n";
            i = i + 1;
        }
        s = s + "        default:\n            return \"unknown\";\n";
        s = s + "    }\n}";
        return s;
    }

    /* Emit a plain (raw C) `struct` definition -> IRStructDef (mirrors
     * emit_struct_decl). An array field (`int buf[8]`) encodes its size in the
     * field name and drops the array-ness from the element type. */
    public void emitStructDecl(Node d, IRModule m) {
        IRStructDef sd = IRStructDef();
        sd.name = d.name;
        int i = 0;
        while (i < d.fields.len) {
            Node f = d.fields.get(i);
            if (f.type != null && f.type.is_array && f.type.array_size != null) {
                Node baseType = Node();
                baseType.kind = NK_TYPE_EXPR;
                baseType.base = f.type.base;
                baseType.generic_args = f.type.generic_args;
                baseType.pointer_depth = f.type.pointer_depth;
                Map<string, Node> empty = {};
                string sizeText = irExprText(self.lowerExpr(f.type.array_size, empty));
                sd.fields.push(IRStructField(typeToC(baseType, self.analyzed),
                    f.name + "[" + sizeText + "]"));
            } else {
                sd.fields.push(IRStructField(typeToC(f.type, self.analyzed), f.name));
            }
            i = i + 1;
        }
        m.struct_defs.push(sd);
    }

    /* Top-level variable -> file-scope C global (mirrors _emit_declarations'
     * VarDeclStmt branch). Default storage is `static` (file linkage); explicit
     * `extern`/`volatile` qualifiers layer on. `extern` is a declaration only —
     * never emit an initializer for it. */
    public void emitGlobalVar(Node d, IRModule m) {
        string ct = "int";
        if (d.type != null) { ct = typeToC(d.type, self.analyzed); }
        bool isExtern = false;
        bool isVolatile = false;
        if (d.type != null) { isExtern = d.type.is_extern; isVolatile = d.type.is_volatile; }
        string storage = "static ";
        if (isExtern) { storage = "extern "; }
        string vol = "";
        if (isVolatile) { vol = "volatile "; }
        string prefix = storage + vol;
        if (d.initializer != null && !isExtern) {
            Map<string, Node> empty = {};
            string initText = irExprText(self.lowerExpr(d.initializer, empty));
            m.raw_sections.push(f"{prefix}{ct} {d.name} = {initText};");
        } else {
            m.raw_sections.push(f"{prefix}{ct} {d.name};");
        }
    }

    /* A preprocessor directive: `#include <h>`/`#include "h"` -> add the header
     * to module.includes; anything else -> raw section (mirrors
     * generator._emit_declarations PreprocessorDirective branch). */
    public void emitPreprocessor(Node d, IRModule m) {
        string text = strStripped(d.text);
        if (text.length() >= 8 && text.substring(0, 8) == "#include") {
            int lt = text.indexOf("<");
            int gt = text.indexOf(">");
            int dq1 = text.indexOf("\"");
            if (lt >= 0 && gt > lt) {
                m.includes.push(text.substring(lt + 1, gt - lt - 1));
            } else if (dq1 >= 0) {
                int dq2 = indexOfFrom(text, "\"", dq1 + 1);
                if (dq2 > dq1) {
                    m.includes.push(text.substring(dq1 + 1, dq2 - dq1 - 1));
                } else {
                    m.includes.push(text);
                }
            } else {
                m.includes.push(text);
            }
        } else {
            m.raw_sections.push(text);
        }
    }

    /* Emit all monomorphized generic instances (mirrors
     * generics.core.emit_generic_instances + user.py + user_methods.py for the
     * user-generic subset: macros, per-instance struct + fwd-decls + methods). */
    public void emitGenericInstances(IRModule m) {
        if (!self.analyzed.hasGenerics()) { return; }
        /* Macros + hash helper emitted once, before any instance. */
        self.useHelper("__btrc_hash_str");
        m.raw_sections.push(genericMacrosText());
        int i = 0;
        while (i < self.analyzed.genericInstances.len) {
            self.emitGenericInstance(self.analyzed.genericInstances.get(i), m);
            i = i + 1;
        }
    }

    /* Emit one generic instance: struct, forward-declaration raw section, then
     * init/new/destroy + methods (all `static`). Mirrors _emit_user_generic_instance
     * + _emit_user_generic_methods. */
    public void emitGenericInstance(GenInstance inst, IRModule m) {
        Node decl = self.analyzed.genericClassTable.get(inst.base);
        string mangled = inst.mangled;
        Map<string, Node> typeMap = {};
        int g = 0;
        while (g < decl.generic_params.len && g < inst.args.len) {
            typeMap.put(decl.generic_params.get(g), inst.args.get(g));
            g = g + 1;
        }

        /* Struct: __rc then resolved fields. */
        IRStructDef sd = IRStructDef();
        sd.name = mangled;
        sd.fields.push(IRStructField("int", "__rc"));
        int fi = 0;
        while (fi < decl.members.len) {
            Node mem = decl.members.get(fi);
            if (mem.kind == NK_FIELD_DECL) {
                Node rt = resolveGenericType(mem.type, typeMap);
                sd.fields.push(IRStructField(typeToC(rt, self.analyzed), mem.name));
            }
            fi = fi + 1;
        }
        m.struct_defs.push(sd);

        /* Constructor params (resolved). */
        Node? ctor = self.genericConstructor(decl);
        Vector<IRParam> ctorParams = [];
        if (ctor != null) {
            int p = 0;
            while (p < ctor.params.len) {
                Node pp = ctor.params.get(p);
                Node rt = resolveGenericType(pp.type, typeMap);
                ctorParams.push(IRParam(typeToC(rt, self.analyzed), pp.name));
                p = p + 1;
            }
        }

        /* Forward-declaration raw section (init, new, destroy, methods). */
        Vector<string> fwds = [];
        string initParams = mangled + "* self";
        int cp = 0;
        while (cp < ctorParams.len) {
            initParams = initParams + ", " + ctorParams.get(cp).c_type + " " + ctorParams.get(cp).name;
            cp = cp + 1;
        }
        fwds.push(f"static void {mangled}_init({initParams});");
        string ctorParamsText = "void";
        if (ctorParams.len > 0) {
            ctorParamsText = "";
            int q = 0;
            while (q < ctorParams.len) {
                if (q > 0) { ctorParamsText = ctorParamsText + ", "; }
                ctorParamsText = ctorParamsText + ctorParams.get(q).c_type + " " + ctorParams.get(q).name;
                q = q + 1;
            }
        }
        fwds.push(f"static {mangled}* {mangled}_new({ctorParamsText});");
        fwds.push(f"static void {mangled}_destroy({mangled}* self);");
        int mi = 0;
        while (mi < decl.members.len) {
            Node mem = decl.members.get(mi);
            if (mem.kind == NK_METHOD_DECL && mem.name != inst.base && mem.name != "__del__"
                    && mem.generic_params.len == 0) {
                Node rrt = resolveGenericType(mem.return_type, typeMap);
                string retC = typeToC(rrt, self.analyzed);
                string mp = mangled + "* self";
                int k = 0;
                while (k < mem.params.len) {
                    Node pp = mem.params.get(k);
                    Node rt = resolveGenericType(pp.type, typeMap);
                    mp = mp + ", " + typeToC(rt, self.analyzed) + " " + pp.name;
                    k = k + 1;
                }
                fwds.push(f"static {retC} {mangled}_{mem.name}({mp});");
            }
            mi = mi + 1;
        }
        string fwdSection = "";
        int fw = 0;
        while (fw < fwds.len) {
            if (fw > 0) { fwdSection = fwdSection + "\n"; }
            fwdSection = fwdSection + fwds.get(fw);
            fw = fw + 1;
        }
        m.raw_sections.push(fwdSection);

        /* Set context for body lowering: self -> the generic instance type, and
         * mark we're inside a generic method (raw operator lowering). */
        string savedClass = self.currentClass;
        self.currentClass = mangled;
        self.inGenericMethod = true;
        self.activeTypeMap = typeMap;

        /* --- _init --- */
        IRFunction initFn = IRFunction();
        initFn.name = mangled + "_init";
        initFn.return_type = "void";
        initFn.is_static = true;
        initFn.params.push(IRParam(mangled + "*", "self"));
        int ip = 0;
        while (ip < ctorParams.len) { initFn.params.push(ctorParams.get(ip)); ip = ip + 1; }
        Vector<IRNode> ibody = [];
        ibody.push(irAssign(irFieldAccess(irVar("self"), "__rc", true), irLiteral("1")));
        Vector<IRNode> ctorBodyStmts = [];
        if (ctor != null && ctor.body_node != null) {
            self.currentReturnCType = "void";
            Map<string, Node> vt = self.genericMethodVarTypes(inst, ctor, typeMap);
            IRNode blk = self.lowerBlock(ctor.body_node, vt);
            int b = 0;
            while (b < blk.stmts.len) { ctorBodyStmts.push(blk.stmts.get(b)); b = b + 1; }
        }
        /* Empty ctor body -> (void)self; to avoid unused-param warning. */
        if (ctorBodyStmts.len == 0) {
            ctorBodyStmts.push(irExprStmt(irCast("void", irVar("self"))));
        }
        int cb = 0;
        while (cb < ctorBodyStmts.len) { ibody.push(ctorBodyStmts.get(cb)); cb = cb + 1; }
        initFn.body = irBlock(ibody);
        m.functions.push(initFn);

        /* --- _new --- */
        IRFunction newFn = IRFunction();
        newFn.name = mangled + "_new";
        newFn.return_type = mangled + "*";
        newFn.is_static = true;
        int np = 0;
        while (np < ctorParams.len) { newFn.params.push(ctorParams.get(np)); np = np + 1; }
        Vector<IRNode> nbody = [];
        Vector<IRNode> sizeofArgs = [];
        sizeofArgs.push(irVar(mangled));
        Vector<IRNode> mallocArgs = [];
        mallocArgs.push(irCall("sizeof", sizeofArgs));
        nbody.push(irVarDecl(mangled + "*", "self", irCast(mangled + "*", irCall("malloc", mallocArgs))));
        Vector<IRNode> memsetArgs = [];
        memsetArgs.push(irVar("self"));
        memsetArgs.push(irLiteral("0"));
        Vector<IRNode> sizeofArgs2 = [];
        sizeofArgs2.push(irVar(mangled));
        memsetArgs.push(irCall("sizeof", sizeofArgs2));
        nbody.push(irExprStmt(irCall("memset", memsetArgs)));
        Vector<IRNode> initArgs = [];
        initArgs.push(irVar("self"));
        int ia = 0;
        while (ia < ctorParams.len) { initArgs.push(irVar(ctorParams.get(ia).name)); ia = ia + 1; }
        nbody.push(irExprStmt(irCall(mangled + "_init", initArgs)));
        nbody.push(irReturn(irVar("self")));
        newFn.body = irBlock(nbody);
        m.functions.push(newFn);

        /* --- _destroy --- (terminal destructor). If the class defines free()
         * (all stdlib collections do), destroy is the single terminal entry
         * point: `<mangled>_free(self)` does content cleanup (release elements,
         * free buffers, null fields), then `free(self)` frees the struct. We do
         * NOT also emit per-field releases in that case (free() already does it —
         * doing both double-releases). Otherwise (no free method) emit per-field
         * releases + free(self). Mirrors generics.user_methods destroy emission. */
        IRFunction dFn = IRFunction();
        dFn.name = mangled + "_destroy";
        dFn.return_type = "void";
        dFn.is_static = true;
        dFn.params.push(IRParam(mangled + "*", "self"));
        Vector<IRNode> dbody = [];
        if (genericMember(self.analyzed, inst.base, "free") != null) {
            Vector<IRNode> freeSelfArgs = [];
            freeSelfArgs.push(irVar("self"));
            dbody.push(irExprStmt(irCall(mangled + "_free", freeSelfArgs)));
        } else {
            self.emitGenericFieldReleases(decl, typeMap, dbody);
        }
        Vector<IRNode> freeArgs = [];
        freeArgs.push(irVar("self"));
        dbody.push(irExprStmt(irCall("free", freeArgs)));
        dFn.body = irBlock(dbody);
        m.functions.push(dFn);

        /* --- methods --- */
        int m2 = 0;
        while (m2 < decl.members.len) {
            Node mem = decl.members.get(m2);
            if (mem.kind == NK_METHOD_DECL && mem.name != inst.base && mem.name != "__del__"
                    && mem.generic_params.len == 0) {
                IRFunction fn = IRFunction();
                fn.name = mangled + "_" + mem.name;
                Node rrt = resolveGenericType(mem.return_type, typeMap);
                string retC = typeToC(rrt, self.analyzed);
                fn.return_type = retC;
                fn.is_static = true;
                fn.params.push(IRParam(mangled + "*", "self"));
                int mp2 = 0;
                while (mp2 < mem.params.len) {
                    Node pp = mem.params.get(mp2);
                    Node rt = resolveGenericType(pp.type, typeMap);
                    fn.params.push(IRParam(typeToC(rt, self.analyzed), pp.name));
                    mp2 = mp2 + 1;
                }
                self.currentReturnCType = retC;
                Vector<IRNode> mbody = [];
                if (mem.body_node != null) {
                    Map<string, Node> vt = self.genericMethodVarTypes(inst, mem, typeMap);
                    IRNode blk = self.lowerBlock(mem.body_node, vt);
                    int b = 0;
                    while (b < blk.stmts.len) { mbody.push(blk.stmts.get(b)); b = b + 1; }
                }
                if (mbody.len == 0) {
                    mbody.push(irExprStmt(irCast("void", irVar("self"))));
                }
                fn.body = irBlock(mbody);
                m.functions.push(fn);
            }
            m2 = m2 + 1;
        }
        self.currentClass = savedClass;
        self.inGenericMethod = false;
        self.activeTypeMap = {};
    }

    /* Emit every monomorphized generic-METHOD function recorded by the analyzer.
     * Each is emitted with a combined type map binding both the class type
     * params (T, ...) and the method type params (U, ...) to the concrete types
     * for that call site. Bodies lower via the same generic-method machinery so
     * cross-type dispatch (e.g. building a Vector<U> inside the body) resolves.
     * Mirrors generics.methods_mono.emit_generic_method_instances. */
    public void emitMethodGenericInstances(IRModule m) {
        if (!self.analyzed.hasMethodGenerics()) { return; }
        int i = 0;
        while (i < self.analyzed.methodGenInstances.len) {
            self.emitOneMethodGenericInstance(self.analyzed.methodGenInstances.get(i), m);
            i = i + 1;
        }
    }

    public void emitOneMethodGenericInstance(MethodGenInstance inst, IRModule m) {
        /* Resolve the owning class decl + method. */
        bool ownerGeneric = self.analyzed.isGenericClass(inst.classBase);
        Node? decl = null;
        Node? method = null;
        if (ownerGeneric) {
            decl = self.analyzed.genericClassTable.get(inst.classBase);
            method = self.analyzed.genericClassMethod(inst.classBase, inst.methodName);
        } else {
            decl = self.analyzed.classTable.get(inst.classBase);
            method = self.analyzed.classMember(inst.classBase, inst.methodName);
        }
        if (method == null || method.kind != NK_METHOD_DECL) { return; }

        /* self type: mangled generic instance for a generic owner, else the
         * bare class name. */
        string selfMangled = inst.classBase;
        if (inst.classArgs.len > 0) {
            selfMangled = mangleGenericType(inst.classBase, inst.classArgs);
        }
        string fnName = genericMethodInstanceName(
            inst.classBase, inst.classArgs, inst.methodName, inst.methodArgs);

        /* Combined {class_param: concrete, method_param: concrete} type map. */
        Map<string, Node> typeMap = {};
        int ci = 0;
        while (ci < decl.generic_params.len && ci < inst.classArgs.len) {
            typeMap.put(decl.generic_params.get(ci), inst.classArgs.get(ci));
            ci = ci + 1;
        }
        int ui = 0;
        while (ui < method.generic_params.len && ui < inst.methodArgs.len) {
            typeMap.put(method.generic_params.get(ui), inst.methodArgs.get(ui));
            ui = ui + 1;
        }

        /* Resolved return + params. */
        Node rrt = resolveGenericType(method.return_type, typeMap);
        string retC = typeToC(rrt, self.analyzed);

        /* Forward declaration (raw_section: body may reference fn-ptr typedefs
         * not yet emitted at forward_decls time). */
        string fwd = f"static {retC} {fnName}({selfMangled}* self";
        int fp = 0;
        while (fp < method.params.len) {
            Node pp = method.params.get(fp);
            Node rt = resolveGenericType(pp.type, typeMap);
            fwd = fwd + ", " + typeToC(rt, self.analyzed) + " " + pp.name;
            fp = fp + 1;
        }
        fwd = fwd + ");";
        m.raw_sections.push(fwd);

        /* Body lowering context. Mirrors emitGenericInstance: set the generic
         * method context, then reset it after. currentReturnTypeNode is set (not
         * save/restored) like lowerMethod does — guarding the nullable store. */
        string savedClass = self.currentClass;
        self.currentClass = selfMangled;
        self.currentReturnCType = retC;
        self.currentReturnTypeNode = rrt;
        self.inGenericMethod = true;
        self.activeTypeMap = typeMap;

        IRFunction fn = IRFunction();
        fn.name = fnName;
        fn.return_type = retC;
        fn.is_static = true;
        fn.params.push(IRParam(selfMangled + "*", "self"));
        int pp2 = 0;
        while (pp2 < method.params.len) {
            Node pp = method.params.get(pp2);
            Node rt = resolveGenericType(pp.type, typeMap);
            fn.params.push(IRParam(typeToC(rt, self.analyzed), pp.name));
            pp2 = pp2 + 1;
        }

        /* var-type map: self -> the receiver instance type, each param -> its
         * resolved type. */
        Map<string, Node> vt = {};
        Node selfT = Node();
        selfT.kind = NK_TYPE_EXPR;
        selfT.base = inst.classBase;
        selfT.generic_args = inst.classArgs;
        selfT.pointer_depth = 1;
        vt.put("self", selfT);
        int vp = 0;
        while (vp < method.params.len) {
            Node pp = method.params.get(vp);
            vt.put(pp.name, resolveGenericType(pp.type, typeMap));
            vp = vp + 1;
        }

        Vector<IRNode> mbody = [];
        if (method.body_node != null) {
            IRNode blk = self.lowerBlock(method.body_node, vt);
            int b = 0;
            while (b < blk.stmts.len) { mbody.push(blk.stmts.get(b)); b = b + 1; }
        }
        if (mbody.len == 0) {
            mbody.push(irExprStmt(irCast("void", irVar("self"))));
        }
        fn.body = irBlock(mbody);
        m.functions.push(fn);

        self.currentClass = savedClass;
        self.inGenericMethod = false;
        self.activeTypeMap = {};
    }

    /* var-type map for lowering a generic method/ctor body: self -> the generic
     * instance type (carries generic_args + pointer_depth 1), each param -> its
     * resolved type. */
    public Map<string, Node> genericMethodVarTypes(GenInstance inst, Node method, Map<string, Node> typeMap) {
        Map<string, Node> vt = {};
        Node selfT = Node();
        selfT.kind = NK_TYPE_EXPR;
        selfT.base = inst.base;
        selfT.generic_args = inst.args;
        selfT.pointer_depth = 1;
        vt.put("self", selfT);
        int i = 0;
        while (i < method.params.len) {
            Node p = method.params.get(i);
            vt.put(p.name, resolveGenericType(p.type, typeMap));
            i = i + 1;
        }
        return vt;
    }

    /* The constructor method of a generic class decl (named like the class), or
     * null. */
    public Node? genericConstructor(Node decl) {
        int i = 0;
        while (i < decl.members.len) {
            Node m = decl.members.get(i);
            if (m.kind == NK_METHOD_DECL && m.name == decl.name) { return m; }
            i = i + 1;
        }
        return null;
    }

    /* Emit ARC field releases for class-typed fields of a generic instance into
     * the destructor body (resolved field types). Mirrors
     * _build_generic_destructor_stmts (no-free subset). */
    public void emitGenericFieldReleases(Node decl, Map<string, Node> typeMap, Vector<IRNode> body) {
        int i = 0;
        while (i < decl.members.len) {
            Node mem = decl.members.get(i);
            if (mem.kind == NK_FIELD_DECL) {
                Node rt = resolveGenericType(mem.type, typeMap);
                /* Only release non-pointer class-instance fields. */
                if (rt.pointer_depth == 0 && self.analyzed.isClass(rt.base)) {
                    body.push(self.fieldReleaseStmt(mem.name, rt.base + "_destroy"));
                }
            }
            i = i + 1;
        }
    }

    /* Emit a class: struct def + method forward decls + constructor +
     * destructor + methods + inherited-method wrappers (mirrors emit_class_decl
     * + class_members). */
    public void emitClassDecl(Node decl, IRModule m) {
        self.currentClass = decl.name;
        self.emitClassStruct(decl, m);
        self.emitMethodForwardDecls(decl, m);
        self.emitConstructor(decl, m);
        self.emitDestructor(decl, m);

        /* Own methods + properties (skip constructor + __del__). */
        Map<string, bool> ownMethods = {};
        int i = 0;
        while (i < decl.members.len) {
            Node mem = decl.members.get(i);
            if (mem.kind == NK_METHOD_DECL && mem.name != decl.name && mem.name != "__del__") {
                m.functions.push(self.lowerMethod(decl, mem));
                ownMethods.put(mem.name, true);
            } else if (mem.kind == NK_PROPERTY_DECL) {
                self.emitProperty(decl, mem, m);
            }
            i = i + 1;
        }

        /* Inherited method wrappers for methods not overridden. */
        string par = parentName(decl);
        if (par != "" && self.analyzed.isClass(par)) {
            self.emitInheritedMethods(decl, ownMethods, m);
        }
        self.currentClass = "";
    }

    /* Emit the struct: __rc first, then parent fields, then own fields, then
     * property backing fields (mirrors _emit_class_struct). */
    public void emitClassStruct(Node decl, IRModule m) {
        IRStructDef sd = IRStructDef();
        sd.name = decl.name;
        sd.fields.push(IRStructField("int", "__rc"));
        /* Parent fields (single-level chain handled by recursion). */
        string par = parentName(decl);
        if (par != "" && self.analyzed.isClass(par)) {
            self.appendParentFields(par, sd);
        }
        int i = 0;
        while (i < decl.members.len) {
            Node mem = decl.members.get(i);
            if (mem.kind == NK_FIELD_DECL) {
                sd.fields.push(IRStructField(typeToC(mem.type, self.analyzed), mem.name));
            } else if (mem.kind == NK_PROPERTY_DECL) {
                sd.fields.push(IRStructField(typeToC(mem.type, self.analyzed),
                    "_prop_" + mem.name));
            }
            i = i + 1;
        }
        m.struct_defs.push(sd);
    }

    /* Append a parent class's own fields (recursively, ancestors first) into a
     * struct def. Python copies parent.fields (which already include ancestors)
     * in insertion order; we recurse parent-first to match. */
    public void appendParentFields(string cls, IRStructDef sd) {
        if (!self.analyzed.isClass(cls)) { return; }
        Node decl = self.analyzed.classTable.get(cls);
        string par = parentName(decl);
        if (par != "" && self.analyzed.isClass(par)) {
            self.appendParentFields(par, sd);
        }
        int i = 0;
        while (i < decl.members.len) {
            Node mem = decl.members.get(i);
            if (mem.kind == NK_FIELD_DECL) {
                sd.fields.push(IRStructField(typeToC(mem.type, self.analyzed), mem.name));
            } else if (mem.kind == NK_PROPERTY_DECL) {
                sd.fields.push(IRStructField(typeToC(mem.type, self.analyzed),
                    "_prop_" + mem.name));
            }
            i = i + 1;
        }
    }

    /* Forward declarations for the constructor + own methods + inherited method
     * wrappers (mirrors _emit_method_forward_decls). */
    public void emitMethodForwardDecls(Node decl, IRModule m) {
        string name = decl.name;
        Node? ctor = self.analyzed.classConstructor(name);
        string ctorParams = "";
        if (ctor != null) { ctorParams = self.paramDeclText(ctor.params); }
        /* X_init(X* self, ctor_params...) */
        string initParams = name + "* self";
        if (ctorParams != "") { initParams = initParams + ", " + ctorParams; }
        m.forward_decls.push(f"void {name}_init({initParams});");
        /* X_new(ctor_params...) */
        string newParams = ctorParams;
        if (newParams == "") { newParams = "void"; }
        m.forward_decls.push(f"{name}* {name}_new({newParams});");
        /* Own methods. */
        Map<string, bool> own = {};
        int i = 0;
        while (i < decl.members.len) {
            Node mem = decl.members.get(i);
            if (mem.kind == NK_METHOD_DECL) { own.put(mem.name, true); }
            if (mem.kind == NK_METHOD_DECL && mem.name != name && mem.name != "__del__") {
                bool isStatic = mem.access == "class";
                string params = "";
                if (!isStatic) { params = name + "* self"; }
                string rest = self.paramDeclText(mem.params);
                if (rest != "") {
                    if (params != "") { params = params + ", " + rest; } else { params = rest; }
                }
                if (params == "") { params = "void"; }
                string ret = typeToC(mem.return_type, self.analyzed);
                m.forward_decls.push(f"{ret} {name}_{mem.name}({params});");
            }
            i = i + 1;
        }
        /* Inherited method wrapper fwds: the immediate parent's merged method
         * set, in order, minus this class's own methods. */
        string par = parentName(decl);
        if (par != "" && self.analyzed.isClass(par)) {
            Vector<MethodEntry> pm = self.analyzed.mergedMethods(par);
            int k = 0;
            while (k < pm.len) {
                MethodEntry e = pm.get(k);
                if (!own.has(e.name)) {
                    string params = name + "* self";
                    string rest = self.paramDeclText(e.sig.params);
                    if (rest != "") { params = params + ", " + rest; }
                    string ret = typeToC(e.sig.return_type, self.analyzed);
                    m.forward_decls.push(f"{ret} {name}_{e.name}({params});");
                }
                k = k + 1;
            }
        }
    }

    /* "T1 n1, T2 n2, ..." for a param list (empty string for no params). */
    public string paramDeclText(Vector<Node> params) {
        string s = "";
        int i = 0;
        while (i < params.len) {
            Node p = params.get(i);
            if (i > 0) { s = s + ", "; }
            s = s + typeToC(p.type, self.analyzed) + " " + p.name;
            i = i + 1;
        }
        return s;
    }

    /* Emit X_init(self, ...) and X_new(...) (mirrors _emit_constructor). */
    public void emitConstructor(Node decl, IRModule m) {
        string name = decl.name;
        Node? ctor = self.analyzed.classConstructor(name);

        /* X_init params: self + ctor params. */
        IRFunction initFn = IRFunction();
        initFn.name = name + "_init";
        initFn.return_type = "void";
        initFn.params.push(IRParam(name + "*", "self"));
        if (ctor != null) {
            int i = 0;
            while (i < ctor.params.len) {
                Node p = ctor.params.get(i);
                initFn.params.push(IRParam(typeToC(p.type, self.analyzed), p.name));
                i = i + 1;
            }
        }
        Vector<IRNode> body = [];
        /* self->__rc = 1; */
        body.push(irAssign(irFieldAccess(irVar("self"), "__rc", true), irLiteral("1")));
        /* Field default initializers (own fields only — mirrors Python). */
        int j = 0;
        while (j < decl.members.len) {
            Node mem = decl.members.get(j);
            if (mem.kind == NK_FIELD_DECL && mem.initializer != null) {
                Map<string, Node> ctorVars = self.ctorVarTypes(decl, ctor);
                /* Collection literals: thread the declared field type so the
                 * mangled collection name matches the field (e.g. `Vector<string>
                 * = []` lowers to `btrc_Vector_string_new`, not the int-inferred
                 * fallback). Mirrors _lower_field_init in classes.py. */
                IRNode v = irLiteral("NULL");
                if (mem.initializer.kind == NK_LIST_LITERAL) {
                    v = self.lowerListLiteral(mem.initializer, ctorVars, mem.type);
                } else if (mem.initializer.kind == NK_MAP_LITERAL) {
                    v = self.lowerMapLiteral(mem.initializer, ctorVars, mem.type);
                } else if (mem.initializer.kind == NK_BRACE_INITIALIZER) {
                    v = self.lowerBraceInit(mem.initializer, ctorVars, mem.type);
                } else {
                    v = self.lowerExpr(mem.initializer, ctorVars);
                }
                body.push(irAssign(irFieldAccess(irVar("self"), mem.name, true), v));
            }
            j = j + 1;
        }
        /* Constructor body (user code). */
        if (ctor != null && ctor.body_node != null) {
            self.currentReturnCType = "void";
            Map<string, Node> ctorVars = self.ctorVarTypes(decl, ctor);
            IRNode blk = self.lowerBlock(ctor.body_node, ctorVars);
            int k = 0;
            while (k < blk.stmts.len) { body.push(blk.stmts.get(k)); k = k + 1; }
        }
        initFn.body = irBlock(body);
        m.functions.push(initFn);

        /* X_new: malloc + memset + init + return. */
        IRFunction newFn = IRFunction();
        newFn.name = name + "_new";
        newFn.return_type = name + "*";
        Vector<IRNode> nbody = [];
        Vector<IRNode> mallocArgs = [];
        mallocArgs.push(irRawExpr(f"sizeof({name})"));
        IRNode mallocCall = irCast(name + "*", irCall("malloc", mallocArgs));
        nbody.push(irVarDecl(name + "*", "self", mallocCall));
        Vector<IRNode> memsetArgs = [];
        memsetArgs.push(irVar("self"));
        memsetArgs.push(irLiteral("0"));
        memsetArgs.push(irRawExpr(f"sizeof({name})"));
        nbody.push(irExprStmt(irCall("memset", memsetArgs)));
        Vector<IRNode> initArgs = [];
        initArgs.push(irVar("self"));
        if (ctor != null) {
            int p = 0;
            while (p < ctor.params.len) {
                newFn.params.push(IRParam(typeToC(ctor.params.get(p).type, self.analyzed),
                    ctor.params.get(p).name));
                initArgs.push(irVar(ctor.params.get(p).name));
                p = p + 1;
            }
        }
        nbody.push(irExprStmt(irCall(name + "_init", initArgs)));
        nbody.push(irReturn(irVar("self")));
        newFn.body = irBlock(nbody);
        m.functions.push(newFn);
    }

    /* var-type map for lowering a constructor body: `self` -> class type, plus
     * each ctor param -> its declared type. */
    public Map<string, Node> ctorVarTypes(Node decl, Node? ctor) {
        Map<string, Node> vt = {};
        vt.put("self", classPtrType(makeClassTypeExpr(decl.name)));
        if (ctor != null) {
            int i = 0;
            while (i < ctor.params.len) {
                Node p = ctor.params.get(i);
                vt.put(p.name, p.type);
                i = i + 1;
            }
        }
        return vt;
    }

    /* Emit X_destroy(self): user __del__ body + class-field releases + free(self)
     * (mirrors emit_destructor, class subset — no generic fields/cyclable). */
    public void emitDestructor(Node decl, IRModule m) {
        string name = decl.name;
        IRFunction fn = IRFunction();
        fn.name = name + "_destroy";
        fn.return_type = "void";
        fn.params.push(IRParam(name + "*", "self"));
        Vector<IRNode> body = [];
        Node? dtor = self.analyzed.classMember(name, "__del__");
        if (dtor != null && dtor.kind == NK_METHOD_DECL && dtor.body_node != null) {
            self.currentReturnCType = "void";
            Map<string, Node> vt = {};
            vt.put("self", classPtrType(makeClassTypeExpr(name)));
            IRNode blk = self.lowerBlock(dtor.body_node, vt);
            int k = 0;
            while (k < blk.stmts.len) { body.push(blk.stmts.get(k)); k = k + 1; }
        }
        /* Release class-instance fields (own + inherited), in source order. */
        bool hasFieldReleases = self.emitFieldReleases(name, body);
        /* ARC: mark as destroyed before freeing, for cascade-destroy tracking
         * during phased (cyclable) scope release. Only emitted for destructors
         * that cascade (release class-type fields); zero-cost when cycle
         * detection is inactive (__btrc_tracking == 0). Mirrors
         * class_members._emit_destructor mark-destroyed gate. */
        if (hasFieldReleases) {
            Vector<IRNode> mdArgs = [];
            mdArgs.push(irVar("self"));
            Vector<IRNode> mdStmts = [];
            mdStmts.push(irExprStmt(irCall("__btrc_mark_destroyed", mdArgs)));
            body.push(irIf(irVar("__btrc_tracking"), irBlock(mdStmts), null));
        }
        /* free(self) */
        Vector<IRNode> fargs = [];
        fargs.push(irVar("self"));
        body.push(irExprStmt(irCall("free", fargs)));
        fn.body = irBlock(body);
        m.functions.push(fn);
        /* ARC: cycle-detection visitor for cyclable classes (after the dtor so
         * the visitor's forward use of {name}_destroy is already declared).
         * Mirrors classes._emit_visitor, gated on is_cyclable. */
        if (self.isCyclable(name)) {
            self.emitVisitor(name, m);
        }
    }

    /* Emit `static void X_visit(X* self, void (*fn)(void**))` which calls fn on
     * the ADDRESS of each cyclable-class field, so the cycle collector can trial-
     * decrement or NULL them. A cyclable class always gets a visitor even with no
     * directly-cyclable field (the collector references X_visit unconditionally).
     * Mirrors classes._emit_visitor. */
    public void emitVisitor(string name, IRModule m) {
        Vector<Node> fields = [];
        self.collectClassFields(name, fields);
        string lines = "";
        int i = 0;
        while (i < fields.len) {
            Node fd = fields.get(i);
            Node ft = fd.type;
            if (ft != null && self.isCyclable(ft.base)) {
                if (lines != "") { lines = lines + "\n"; }
                lines = lines + "    if (self->" + fd.name
                    + ") fn((void**)&self->" + fd.name + ");";
            }
            i = i + 1;
        }
        if (lines == "") { lines = "    (void)self;\n    (void)fn;"; }
        string text = "static void " + name + "_visit(" + name
            + "* self, void (*fn)(void**)) {\n" + lines + "\n}";
        m.raw_sections.push(text);
    }

    /* Append `if (self->f) { if (--self->f->__rc <= 0) F_destroy(self->f); }` for
     * each class-instance field of `cls` (and ancestors). Mirrors emit_destructor
     * field-release loop (cls_info.fields iterates own+inherited). */
    public bool emitFieldReleases(string cls, Vector<IRNode> body) {
        /* Build the ordered field list the way Python's cls_info.fields does:
         * inherited first, then own. */
        Vector<Node> fields = [];
        self.collectClassFields(cls, fields);
        bool any = false;
        int i = 0;
        while (i < fields.len) {
            Node fd = fields.get(i);
            Node ft = fd.type;
            if (ft != null && ft.pointer_depth <= 1 && self.analyzed.isClass(ft.base)) {
                body.push(self.fieldReleaseStmt(fd.name, ft.base + "_destroy"));
                any = true;
            }
            i = i + 1;
        }
        return any;
    }

    /* Collect a class's fields (inherited first, then own) — mirrors the
     * insertion order of ClassInfo.fields. */
    public void collectClassFields(string cls, Vector<Node> out) {
        if (!self.analyzed.isClass(cls)) { return; }
        Node decl = self.analyzed.classTable.get(cls);
        string par = parentName(decl);
        if (par != "" && self.analyzed.isClass(par)) {
            self.collectClassFields(par, out);
        }
        int i = 0;
        while (i < decl.members.len) {
            Node mem = decl.members.get(i);
            if (mem.kind == NK_FIELD_DECL) { out.push(mem); }
            i = i + 1;
        }
    }

    /* The set of class names directly referenced through `cls`'s fields (a
     * field whose declared type, or a generic-arg of it, is a known class).
     * Mirrors the `refs[name]` adjacency built in analyzer.core
     * _compute_cyclable. Includes inherited fields so a base-class field can
     * close a cycle through a subclass. */
    public void classFieldRefs(string cls, Map<string, bool> out) {
        Vector<Node> fields = [];
        self.collectClassFields(cls, fields);
        int i = 0;
        while (i < fields.len) {
            Node fd = fields.get(i);
            Node ft = fd.type;
            if (ft != null) {
                if (self.analyzed.isClass(ft.base)) { out.put(ft.base, true); }
                int g = 0;
                while (g < ft.generic_args.len) {
                    Node ga = ft.generic_args.get(g);
                    if (self.analyzed.isClass(ga.base)) { out.put(ga.base, true); }
                    g = g + 1;
                }
            }
            i = i + 1;
        }
    }

    /* True if `cls` can reach itself through field references (directly or
     * transitively) — i.e. instances of `cls` may form reference cycles, so
     * scope-release must run the cycle collector. DFS over the static field-ref
     * graph; mirrors analyzer.core _compute_cyclable. */
    public bool isCyclable(string cls) {
        if (!self.analyzed.isClass(cls)) { return false; }
        Map<string, bool> visited = {};
        Vector<string> stack = [];
        Map<string, bool> seed = {};
        self.classFieldRefs(cls, seed);
        Vector<string> sk = seed.keys();
        int si = 0;
        while (si < sk.len) { stack.push(sk.get(si)); si = si + 1; }
        while (stack.len > 0) {
            string cur = stack.pop();
            if (cur == cls) { return true; }
            if (visited.has(cur)) { continue; }
            visited.put(cur, true);
            Map<string, bool> refs = {};
            self.classFieldRefs(cur, refs);
            Vector<string> rk = refs.keys();
            int ri = 0;
            while (ri < rk.len) { stack.push(rk.get(ri)); ri = ri + 1; }
        }
        return false;
    }

    /* True if any managed var in `managed` is of a cyclable class — drives the
     * phased scope-release path. Mirrors the has_cyclable check in
     * arc._emit_scope_release. */
    public bool anyCyclable(Vector<Managed> managed) {
        int i = 0;
        while (i < managed.len) {
            if (self.isCyclable(managed.get(i).cls)) { return true; }
            i = i + 1;
        }
        return false;
    }

    /* if (self->f != NULL) { if ((--self->f->__rc) <= 0) { destroy(self->f); } } */
    public IRNode fieldReleaseStmt(string field, string destroyFn) {
        IRNode fa = irFieldAccess(irVar("self"), field, true);
        IRNode rcDec = irUnaryOp("--", irFieldAccess(fa, "__rc", true), true);
        Vector<IRNode> dargs = [];
        dargs.push(fa);
        Vector<IRNode> innerStmts = [];
        innerStmts.push(irExprStmt(irCall(destroyFn, dargs)));
        IRNode innerIf = irIf(irBinOp(rcDec, "<=", irLiteral("0")),
            irBlock(innerStmts), null);
        Vector<IRNode> outerStmts = [];
        outerStmts.push(innerIf);
        return irIf(irBinOp(fa, "!=", irLiteral("NULL")), irBlock(outerStmts), null);
    }

    /* Lower a method to X_method(self, params...) (mirrors emit_method). */
    public IRFunction lowerMethod(Node decl, Node method) {
        string name = decl.name;
        bool isStatic = method.access == "class";
        IRFunction fn = IRFunction();
        fn.name = name + "_" + method.name;
        string ret = typeToC(method.return_type, self.analyzed);
        fn.return_type = ret;
        Map<string, Node> vt = {};
        if (!isStatic) {
            fn.params.push(IRParam(name + "*", "self"));
            vt.put("self", classPtrType(makeClassTypeExpr(name)));
        }
        int i = 0;
        while (i < method.params.len) {
            Node p = method.params.get(i);
            fn.params.push(IRParam(typeToC(p.type, self.analyzed), p.name));
            vt.put(p.name, p.type);
            i = i + 1;
        }
        self.currentReturnCType = ret;
        self.currentReturnTypeNode = method.return_type;
        if (method.body_node != null) {
            /* Hoist to a local: btrcpy double-evaluates `field = call()`. */
            IRNode mb = self.lowerBlock(method.body_node, vt);
            fn.body = mb;
        } else {
            fn.body = irBlock([]);
        }
        return fn;
    }

    /* Emit getter/setter for a property (mirrors emit_property). */
    public void emitProperty(Node decl, Node prop, IRModule m) {
        string name = decl.name;
        string propType = typeToC(prop.type, self.analyzed);
        string backing = "_prop_" + prop.name;
        if (prop.has_getter) {
            IRFunction g = IRFunction();
            g.name = name + "_get_" + prop.name;
            g.return_type = propType;
            g.params.push(IRParam(name + "*", "self"));
            Vector<IRNode> gb = [];
            if (prop.getter_body != null) {
                self.currentReturnCType = propType;
                Map<string, Node> vt = {};
                vt.put("self", classPtrType(makeClassTypeExpr(name)));
                IRNode blk = self.lowerBlock(prop.getter_body, vt);
                int k = 0;
                while (k < blk.stmts.len) { gb.push(blk.stmts.get(k)); k = k + 1; }
            } else {
                gb.push(irReturn(irFieldAccess(irVar("self"), backing, true)));
            }
            g.body = irBlock(gb);
            m.functions.push(g);
        }
        if (prop.has_setter) {
            IRFunction s = IRFunction();
            s.name = name + "_set_" + prop.name;
            s.return_type = "void";
            s.params.push(IRParam(name + "*", "self"));
            s.params.push(IRParam(propType, "value"));
            Vector<IRNode> sb = [];
            if (prop.setter_body != null) {
                self.currentReturnCType = "void";
                Map<string, Node> vt = {};
                vt.put("self", classPtrType(makeClassTypeExpr(name)));
                vt.put("value", prop.type);
                IRNode blk = self.lowerBlock(prop.setter_body, vt);
                int k = 0;
                while (k < blk.stmts.len) { sb.push(blk.stmts.get(k)); k = k + 1; }
            } else {
                sb.push(irAssign(irFieldAccess(irVar("self"), backing, true), irVar("value")));
            }
            s.body = irBlock(sb);
            m.functions.push(s);
        }
    }

    /* Emit wrapper functions for inherited methods not overridden (mirrors
     * emit_inherited_methods). Each wrapper casts self to the IMMEDIATE parent
     * type and calls the immediate parent's method, which itself may be a wrapper
     * (single-hop chaining). Iterates the immediate parent's merged method set. */
    public void emitInheritedMethods(Node decl, Map<string, bool> ownMethods, IRModule m) {
        string name = decl.name;
        string par = parentName(decl);
        if (par == "" || !self.analyzed.isClass(par)) { return; }
        Vector<MethodEntry> pm = self.analyzed.mergedMethods(par);
        int i = 0;
        while (i < pm.len) {
            MethodEntry e = pm.get(i);
            if (!ownMethods.has(e.name)) {
                ownMethods.put(e.name, true);
                Node mem = e.sig;
                IRFunction fn = IRFunction();
                fn.name = name + "_" + e.name;
                string ret = typeToC(mem.return_type, self.analyzed);
                fn.return_type = ret;
                fn.params.push(IRParam(name + "*", "self"));
                Vector<IRNode> callArgs = [];
                callArgs.push(irCast(par + "*", irVar("self")));
                int j = 0;
                while (j < mem.params.len) {
                    Node p = mem.params.get(j);
                    fn.params.push(IRParam(typeToC(p.type, self.analyzed), p.name));
                    callArgs.push(irVar(p.name));
                    j = j + 1;
                }
                IRNode call = irCall(par + "_" + e.name, callArgs);
                Vector<IRNode> wbody = [];
                if (ret == "void") {
                    wbody.push(irExprStmt(call));
                } else {
                    wbody.push(irReturn(call));
                }
                fn.body = irBlock(wbody);
                m.functions.push(fn);
            }
            i = i + 1;
        }
    }

    /* Emit used helpers in the canonical registry order (mirrors the order in
     * which helpers are aggregated in registry.py, filtered by DCE). */
    public void collectHelpers(IRModule m) {
        /* Re-derive the used-helper set from the SURVIVING (post-DCE) function
         * bodies + raw sections, rather than the lowering-time accumulator —
         * helpers referenced only by dead-eliminated functions must NOT survive
         * (mirrors optimizer._eliminate_dead_helpers, which scans final IR). */
        Vector<string> order = canonicalHelperOrder();
        Map<string, bool> used = {};
        int fi = 0;
        while (fi < m.functions.len) {
            IRFunction fn = m.functions.get(fi);
            if (fn.body != null) { scanHelpersInNode(fn.body, used); }
            fi = fi + 1;
        }
        /* Scan raw sections (generic macros, fwd-decl blocks, etc.) for helper
         * names referenced as whole words. */
        int rsi = 0;
        while (rsi < m.raw_sections.len) {
            string sec = m.raw_sections.get(rsi);
            int oi = 0;
            while (oi < order.len) {
                string hn = order.get(oi);
                if (!used.has(hn) && sec.indexOf(hn) >= 0) { used.put(hn, true); }
                oi = oi + 1;
            }
            rsi = rsi + 1;
        }

        /* Resolve transitive dependencies (mirrors collect_helpers worklist). */
        Vector<string> worklist = used.keys();
        while (worklist.len > 0) {
            string cur = worklist.pop();
            Vector<string> deps = helperDeps(cur);
            int d = 0;
            while (d < deps.len) {
                string dep = deps.get(d);
                if (!used.has(dep)) {
                    used.put(dep, true);
                    worklist.push(dep);
                }
                d = d + 1;
            }
        }
        /* Transitive closure over helper -> helper references in C source: a kept
         * helper's body often calls other helpers (mirrors optimizer closure). */
        Vector<string> work2 = used.keys();
        while (work2.len > 0) {
            string cur = work2.pop();
            string src = helperSource(cur);
            int oi = 0;
            while (oi < order.len) {
                string hn = order.get(oi);
                if (!used.has(hn) && src.indexOf(hn) >= 0) {
                    used.put(hn, true);
                    work2.push(hn);
                }
                oi = oi + 1;
            }
        }

        int i = 0;
        while (i < order.len) {
            string name = order.get(i);
            if (used.has(name)) {
                m.helpers.push(helperSource(name));
            }
            i = i + 1;
        }
        /* pthread.h is required whenever any surviving thread/mutex helper uses
         * pthread_* / pthread_t (mirrors threads.py require_runtime_include).
         * Appended after the standard prologue includes. */
        if (used.has("__btrc_thread_spawn") || used.has("__btrc_mutex_val_create")) {
            m.includes.push("pthread.h");
        }
    }

    /* Phase 1 forward declarations (mirrors _emit_forward_decls): for each
     * non-generic class, a `typedef struct X X;` and a `void X_destroy(X*);`
     * prototype; then prototypes for every non-main function with a body. Class
     * method/constructor prototypes are appended later by emitClassDecl. */
    public void emitForwardDecls(Node prog, IRModule m) {
        Vector<string> funcFwds = [];
        int i = 0;
        while (i < prog.declarations.len) {
            Node d = prog.declarations.get(i);
            if ((d.kind == NK_CLASS_DECL && d.generic_params.len == 0) || d.kind == NK_STRUCT_DECL) {
                /* Both non-generic classes and raw structs get a forward typedef
                 * so a function prototype can name `struct X*` before X is
                 * defined (mirrors generator._emit_forward_decls phase-1, which
                 * tests ClassDecl OR StructDecl). Only classes get _destroy. */
                m.forward_decls.push(f"typedef struct {d.name} {d.name};");
                if (d.kind == NK_CLASS_DECL && d.generic_params.len == 0) {
                    m.forward_decls.push(f"void {d.name}_destroy({d.name}* self);");
                }
            } else if (d.kind == NK_FUNCTION_DECL && d.body_node != null && d.name != "main") {
                string ret = typeToC(d.return_type, self.analyzed);
                string params = self.paramListText(d.params);
                funcFwds.push(f"{ret} {d.name}({params});");
            }
            i = i + 1;
        }
        /* Forward typedefs for concrete generic instances, in discovery order
         * (mirrors generator._emit_forward_decls phase-1 generic loop). These
         * come after the non-generic class typedefs and before function fwds. */
        int g = 0;
        while (g < self.analyzed.genericInstances.len) {
            GenInstance gi = self.analyzed.genericInstances.get(g);
            m.forward_decls.push(f"typedef struct {gi.mangled} {gi.mangled};");
            g = g + 1;
        }
        /* Tuple struct definitions + typedefs (mirrors _emit_tuple_structs):
         * emitted after the generic typedefs and before the deferred function
         * forward decls, so a tuple-returning function's prototype sees the
         * tuple's typedef. */
        self.emitTupleStructs(prog, m);
        int j = 0;
        while (j < funcFwds.len) { m.forward_decls.push(funcFwds.get(j)); j = j + 1; }
    }

    /* Scan all declarations (function return/param types, class method return
     * types) and bodies for tuple types, then emit one struct def + forward
     * typedef per unique mangled tuple. Mirrors generator._emit_tuple_structs
     * (the body walk substitutes for Python's node_types scan). */
    public void emitTupleStructs(Node prog, IRModule m) {
        Map<string, bool> seen = {};
        Vector<string> order = [];
        Vector<Node> tupleTypes = [];
        int i = 0;
        while (i < prog.declarations.len) {
            Node d = prog.declarations.get(i);
            if (d.kind == NK_FUNCTION_DECL) {
                self.collectTupleTypes(d.return_type, seen, order, tupleTypes);
                int p = 0;
                while (p < d.params.len) {
                    self.collectTupleTypes(d.params.get(p).type, seen, order, tupleTypes);
                    p = p + 1;
                }
                self.collectTupleTypesBody(d.body_node, seen, order, tupleTypes);
            } else if (d.kind == NK_CLASS_DECL) {
                int mi = 0;
                while (mi < d.members.len) {
                    Node mem = d.members.get(mi);
                    if (mem.kind == NK_METHOD_DECL) {
                        self.collectTupleTypes(mem.return_type, seen, order, tupleTypes);
                        int mp = 0;
                        while (mp < mem.params.len) {
                            self.collectTupleTypes(mem.params.get(mp).type, seen, order, tupleTypes);
                            mp = mp + 1;
                        }
                        self.collectTupleTypesBody(mem.body_node, seen, order, tupleTypes);
                    }
                    mi = mi + 1;
                }
            }
            i = i + 1;
        }
        int s = 0;
        while (s < order.len) {
            string mangled = order.get(s);
            Node tt = tupleTypes.get(s);
            IRStructDef sd = IRStructDef();
            sd.name = mangled;
            int f = 0;
            while (f < tt.generic_args.len) {
                sd.fields.push(IRStructField(
                    typeToC(tt.generic_args.get(f), self.analyzed), f"_{f}"));
                f = f + 1;
            }
            m.struct_defs.push(sd);
            m.forward_decls.push(f"typedef struct {mangled} {mangled};");
            s = s + 1;
        }
    }

    /* Recursively collect tuple types from a type expression (mirrors
     * generator._collect_tuple_types). A tuple type has base "Tuple" with
     * generic_args holding the element types; nested tuples are collected too. */
    public void collectTupleTypes(Node? t, Map<string, bool> seen,
            Vector<string> order, Vector<Node> tupleTypes) {
        if (t == null) { return; }
        /* Recurse into element types FIRST so that a nested tuple used as a
         * field (e.g. the (string,bool) inside (int,(string,bool))) is emitted
         * before the enclosing struct that contains it — otherwise the outer
         * struct references an incomplete type. (Python gets this ordering
         * incidentally via its node_types scan, which sees the inner tuple's
         * standalone use first; doing dependencies-first here is robust.) */
        int i = 0;
        while (i < t.generic_args.len) {
            self.collectTupleTypes(t.generic_args.get(i), seen, order, tupleTypes);
            i = i + 1;
        }
        if (t.base == "Tuple" && t.generic_args.len > 0) {
            string mangled = mangleGenericType("Tuple", t.generic_args);
            if (!seen.has(mangled)) {
                seen.put(mangled, true);
                order.push(mangled);
                tupleTypes.push(t);
            }
        }
    }

    /* Walk a function/method body for tuple types appearing on local var decls
     * and tuple literals. This stands in for the Python node_types scan, which
     * the on-demand inference design of this compiler doesn't maintain. */
    public void collectTupleTypesBody(Node? n, Map<string, bool> seen,
            Vector<string> order, Vector<Node> tupleTypes) {
        if (n == null) { return; }
        if (n.kind == NK_VAR_DECL_STMT) {
            self.collectTupleTypes(n.type, seen, order, tupleTypes);
        }
        int si = 0;
        while (si < n.statements.len) {
            self.collectTupleTypesBody(n.statements.get(si), seen, order, tupleTypes);
            si = si + 1;
        }
        self.collectTupleTypesBody(n.then_block, seen, order, tupleTypes);
        self.collectTupleTypesBody(n.else_block, seen, order, tupleTypes);
        self.collectTupleTypesBody(n.body_node, seen, order, tupleTypes);
        if (n.if_stmt != null) { self.collectTupleTypesBody(n.if_stmt, seen, order, tupleTypes); }
    }

    public string paramListText(Vector<Node> params) {
        if (params.len == 0) { return "void"; }
        string s = "";
        int i = 0;
        while (i < params.len) {
            Node p = params.get(i);
            if (i > 0) { s = s + ", "; }
            s = s + typeToC(p.type, self.analyzed) + " " + p.name;
            i = i + 1;
        }
        return s;
    }

    public IRFunction lowerFunction(Node d) {
        IRFunction fn = IRFunction();
        fn.name = d.name;
        string ret = typeToC(d.return_type, self.analyzed);
        /* main() with void return -> int (matches functions.py). */
        if (d.name == "main" && ret == "void") { ret = "int"; }
        fn.return_type = ret;
        int i = 0;
        while (i < d.params.len) {
            Node p = d.params.get(i);
            fn.params.push(IRParam(typeToC(p.type, self.analyzed), p.name));
            i = i + 1;
        }
        Map<string, Node> varTypes = {};
        int j = 0;
        while (j < d.params.len) {
            Node p = d.params.get(j);
            varTypes.put(p.name, p.type);
            j = j + 1;
        }
        self.currentReturnCType = ret;
        self.currentReturnTypeNode = d.return_type;
        self.currentClass = "";
        if (d.body_node != null) {
            /* Hoist to a local: btrcpy's ARC double-evaluates `field = call()`
             * (see gotchas), which would lower the body twice and desync the
             * fresh-temp counter. */
            IRNode b = self.lowerBlock(d.body_node, varTypes);
            fn.body = b;
        }
        return fn;
    }

    public IRNode lowerBlock(Node block, Map<string, Node> varTypes) {
        Vector<IRNode> stmts = [];
        self.pushManagedScope();
        if (block != null) {
            int i = 0;
            while (i < block.statements.len) {
                Node s = block.statements.get(i);
                self.lowerStmtInto(s, varTypes, stmts);
                i = i + 1;
            }
        }
        /* ARC: release managed vars owned by this block on scope exit. */
        Vector<Managed> managed = self.popManagedScope();
        self.emitScopeRelease(managed, stmts);
        return irBlock(stmts);
    }

    /* Lower a loop body with a loop-scope marker so break/continue inside it
     * release exactly the vars declared in the body. Mirrors _lower_loop_body. */
    public IRNode lowerLoopBody(Node block, Map<string, Node> varTypes) {
        self.pushLoopScope();
        IRNode b = self.lowerBlock(block, varTypes);
        self.popLoopScope();
        return b;
    }

    /* Append rc-- cleanup for all managed vars in a scope, in reverse order
     * (mirrors arc.py _emit_scope_release). When any var is of a cyclable class
     * the phased path runs the cycle collector; otherwise the simple path. */
    public void emitScopeRelease(Vector<Managed> managed, Vector<IRNode> out) {
        if (self.anyCyclable(managed)) {
            self.emitScopeReleasePhased(managed, out);
            return;
        }
        int i = managed.len - 1;
        while (i >= 0) {
            Managed mv = managed.get(i);
            out.push(self.releaseVarStmt(mv.name, mv.cls + "_destroy"));
            i = i - 1;
        }
    }

    /* Three-phase scope release for scopes containing cyclable types. Avoids
     * reading freed memory in the cycle collector via destroyed-object tracking:
     *   1. decrement rc for ALL managed vars
     *   2. destroy those at rc <= 0 (cascade may free others; guarded by
     *      __btrc_is_destroyed so we never read a freed var->__rc)
     *   3. suspect cyclable survivors (rc > 0) for cycle collection
     *   4. run __btrc_collect_cycles if any suspects
     * Mirrors arc._emit_scope_release_phased exactly. */
    public void emitScopeReleasePhased(Vector<Managed> managed, Vector<IRNode> out) {
        /* Enable cascade-destroy tracking; reset the destroyed log. */
        out.push(irAssign(irVar("__btrc_tracking"), irLiteral("1")));
        out.push(irAssign(irVar("__btrc_destroyed_count"), irLiteral("0")));

        /* Phase 1: decrement rc for ALL managed vars (reverse order). */
        int i = managed.len - 1;
        while (i >= 0) {
            Managed mv = managed.get(i);
            IRNode dec = irUnaryOp("--",
                irFieldAccess(irVar(mv.name), "__rc", true), true);
            Vector<IRNode> ph1 = [];
            ph1.push(irExprStmt(dec));
            out.push(irIf(irBinOp(irVar(mv.name), "!=", irLiteral("NULL")),
                irBlock(ph1), null));
            i = i - 1;
        }

        /* Phase 2: destroy those at rc <= 0, guarded by !__btrc_is_destroyed. */
        i = managed.len - 1;
        while (i >= 0) {
            Managed mv = managed.get(i);
            Vector<IRNode> destroyArgs = [];
            destroyArgs.push(irVar(mv.name));
            Vector<IRNode> innermost = [];
            innermost.push(irExprStmt(irCall(mv.cls + "_destroy", destroyArgs)));
            innermost.push(irAssign(irVar(mv.name), irLiteral("NULL")));
            IRNode rcIf = irIf(
                irBinOp(irFieldAccess(irVar(mv.name), "__rc", true), "<=",
                    irLiteral("0")),
                irBlock(innermost), null);
            Vector<IRNode> isdArgs = [];
            isdArgs.push(irVar(mv.name));
            Vector<IRNode> guardStmts = [];
            guardStmts.push(rcIf);
            IRNode guardIf = irIf(
                irBinOp(irCall("__btrc_is_destroyed", isdArgs), "==",
                    irLiteral("0")),
                irBlock(guardStmts), null);
            Vector<IRNode> outerStmts = [];
            outerStmts.push(guardIf);
            out.push(irIf(irBinOp(irVar(mv.name), "!=", irLiteral("NULL")),
                irBlock(outerStmts), null));
            i = i - 1;
        }

        /* Phase 3: suspect cyclable survivors (rc > 0) for cycle collection. */
        i = managed.len - 1;
        while (i >= 0) {
            Managed mv = managed.get(i);
            if (self.isCyclable(mv.cls)) {
                Vector<IRNode> susArgs = [];
                susArgs.push(irVar(mv.name));
                susArgs.push(irRawExpr("(__btrc_visit_fn)" + mv.cls + "_visit"));
                susArgs.push(irRawExpr("(__btrc_destroy_fn)" + mv.cls + "_destroy"));
                Vector<IRNode> innermost = [];
                innermost.push(irExprStmt(irCall("__btrc_suspect", susArgs)));
                IRNode rcIf = irIf(
                    irBinOp(irFieldAccess(irVar(mv.name), "__rc", true), ">",
                        irLiteral("0")),
                    irBlock(innermost), null);
                Vector<IRNode> isdArgs = [];
                isdArgs.push(irVar(mv.name));
                Vector<IRNode> guardStmts = [];
                guardStmts.push(rcIf);
                IRNode guardIf = irIf(
                    irBinOp(irCall("__btrc_is_destroyed", isdArgs), "==",
                        irLiteral("0")),
                    irBlock(guardStmts), null);
                Vector<IRNode> outerStmts = [];
                outerStmts.push(guardIf);
                out.push(irIf(irBinOp(irVar(mv.name), "!=", irLiteral("NULL")),
                    irBlock(outerStmts), null));
            }
            i = i - 1;
        }

        /* Phase 4: collect cycles if any suspects. */
        Vector<IRNode> noArgs = [];
        Vector<IRNode> collectStmts = [];
        collectStmts.push(irExprStmt(irCall("__btrc_collect_cycles", noArgs)));
        out.push(irIf(
            irBinOp(irVar("__btrc_suspect_count"), ">", irLiteral("0")),
            irBlock(collectStmts), null));

        /* Disable tracking. */
        out.push(irAssign(irVar("__btrc_tracking"), irLiteral("0")));
    }

    /* if (v != NULL) { if ((--v->__rc) <= 0) { destroy(v); } } */
    public IRNode releaseVarStmt(string varName, string destroyFn) {
        IRNode rcDec = irUnaryOp("--",
            irFieldAccess(irVar(varName), "__rc", true), true);
        Vector<IRNode> dargs = [];
        dargs.push(irVar(varName));
        Vector<IRNode> innerStmts = [];
        innerStmts.push(irExprStmt(irCall(destroyFn, dargs)));
        IRNode innerIf = irIf(
            irBinOp(rcDec, "<=", irLiteral("0")),
            irBlock(innerStmts), null);
        Vector<IRNode> outerStmts = [];
        outerStmts.push(innerIf);
        return irIf(
            irBinOp(irVar(varName), "!=", irLiteral("NULL")),
            irBlock(outerStmts), null);
    }

    /* Return-path release: rc-- for every managed var across all open scopes
     * except `keepVar` (the returned variable, whose ownership transfers to the
     * caller). Mirrors arc.py _emit_return_release. */
    public void emitReturnRelease(string keepVar, Vector<IRNode> out) {
        Vector<Managed> all = self.getAllManagedVars();
        int i = all.len - 1;
        while (i >= 0) {
            Managed mv = all.get(i);
            if (mv.name != keepVar) {
                out.push(self.releaseVarStmt(mv.name, mv.cls + "_destroy"));
            }
            i = i - 1;
        }
    }

    /* ARC for `obj.field = value` where field is a class-instance field. Appends
     * to `pre` a release of the old field value (rc--, destroy at zero) and to
     * `post` a retain of the new value (value->__rc++, skipped for `new` which is
     * born with rc=1). No-op (leaves pre/post empty) when the target is not a
     * class-typed field assignment or the value is null. Mirrors
     * fields.get_field_assign_arc_stmts. */
    public void fieldAssignArcStmts(Node node, Map<string, Node> varTypes,
            Vector<IRNode> pre, Vector<IRNode> post) {
        if (node.op != "=" || node.target == null
                || node.target.kind != NK_FIELD_ACCESS_EXPR) { return; }
        /* Assigning null needs no ARC. */
        if (node.value_node != null && node.value_node.kind == NK_NULL_LITERAL) { return; }
        Node tgt = node.target;
        Node? ot = inferType(tgt.obj, self.analyzed, varTypes);
        if (ot == null || !self.analyzed.isClass(ot.base)) { return; }
        Node? fd = self.analyzed.classMember(ot.base, tgt.field);
        if (fd == null || fd.kind != NK_FIELD_DECL || fd.type == null) { return; }
        Node ft = fd.type;
        /* Only class-instance fields need keep/release. */
        if (!self.analyzed.isClass(ft.base)) { return; }
        IRNode obj = self.lowerExpr(tgt.obj, varTypes);
        IRNode oldField = irFieldAccess(obj, tgt.field, true);
        string destroyFn = ft.base + "_destroy";
        /* PRE: release the old field value. */
        IRNode rcDec = irUnaryOp("--", irFieldAccess(oldField, "__rc", true), true);
        Vector<IRNode> dargs = [];
        dargs.push(oldField);
        Vector<IRNode> innerStmts = [];
        innerStmts.push(irExprStmt(irCall(destroyFn, dargs)));
        IRNode innerIf = irIf(irBinOp(rcDec, "<=", irLiteral("0")),
            irBlock(innerStmts), null);
        Vector<IRNode> outerStmts = [];
        outerStmts.push(innerIf);
        pre.push(irIf(irBinOp(oldField, "!=", irLiteral("NULL")),
            irBlock(outerStmts), null));
        /* POST: rc++ on the new value, unless it is a fresh `new` (rc already 1). */
        if (node.value_node != null && node.value_node.kind != NK_NEW_EXPR) {
            IRNode v = self.lowerExpr(node.value_node, varTypes);
            post.push(irExprStmt(irUnaryOp("++", irFieldAccess(v, "__rc", true), false)));
        }
    }

    /* Parameter indices carrying the `keep` annotation for a call. Resolves the
     * callee (function / constructor / instance or static method) and scans its
     * params. Mirrors calls.get_keep_param_indices. */
    public Vector<int> keepParamIndices(Node node) {
        Vector<int> out = [];
        Node callee = node.callee;
        if (callee == null) { return out; }
        Vector<Node> params = self.paramsForCall(node);
        int i = 0;
        while (i < params.len) {
            if (params.get(i).keep_) { out.push(i); }
            i = i + 1;
        }
        return out;
    }

    /* The declared params of a call's target (function / constructor / method),
     * empty when unresolvable. Mirrors calls.params_for_call. */
    public Vector<Node> paramsForCall(Node node) {
        Vector<Node> empty = [];
        Node callee = node.callee;
        if (callee == null) { return empty; }
        if (callee.kind == NK_FIELD_ACCESS_EXPR) {
            Node objN = callee.obj;
            Node? ot = inferType(objN, self.analyzed, self.callParamVarTypes);
            if (ot != null && self.analyzed.isClass(ot.base)) {
                Node? m = self.analyzed.classMember(ot.base, callee.field);
                if (m != null && m.kind == NK_METHOD_DECL) { return m.params; }
            }
            if (objN != null && objN.kind == NK_IDENTIFIER
                    && self.analyzed.isClass(objN.name)) {
                Node? m = self.analyzed.classMember(objN.name, callee.field);
                if (m != null && m.kind == NK_METHOD_DECL) { return m.params; }
            }
            return empty;
        }
        if (callee.kind == NK_IDENTIFIER) {
            string name = callee.name;
            if (self.analyzed.isClass(name)) {
                Node? ctor = self.analyzed.classConstructor(name);
                if (ctor != null) { return ctor.params; }
                return empty;
            }
            if (self.analyzed.funcTable.has(name)) {
                return self.analyzed.funcTable.get(name).params;
            }
        }
        return empty;
    }

    /* Keep-call ARC for a call's class-typed arguments (mirrors
     * variables._keep_call_arc_stmts). Two concerns:
     *   1. `keep` param: a call-site rc++ transfers a reference to the callee. A
     *      named-local source is registered managed so its scope release balances
     *      the rc++.
     *   2. Owning-temporary (`new X()` / ctor call X(...)) passed to ANY param:
     *      the temp holds the creation reference (rc=1). It is hoisted into a temp
     *      var (so the call references it) and released after the call. If the
     *      callee kept a reference (collection push rc++ or a keep param), the net
     *      effect leaves exactly the callee's reference; otherwise the transient
     *      is destroyed.
     * `pre` runs before the call (temp decls + keep rc++); `post` runs after
     * (owning-temp releases). Owning-temp args also register an override so the
     * re-lowered call references the temp var. */
    public void keepCallArcStmts(Node node, Map<string, Node> varTypes,
            Vector<IRNode> pre, Vector<IRNode> post) {
        if (node.kind != NK_CALL_EXPR) { return; }
        self.callParamVarTypes = varTypes;
        Vector<int> keepIdx = self.keepParamIndices(node);
        Map<int, bool> keepSet = {};
        int k = 0;
        while (k < keepIdx.len) { keepSet.put(keepIdx.get(k), true); k = k + 1; }
        int idx = 0;
        while (idx < node.args.len) {
            Node arg = node.args.get(idx);
            Node? at = inferType(arg, self.analyzed, varTypes);
            if (at == null || !self.analyzed.isClass(at.base)) { idx = idx + 1; continue; }
            bool isKeep = keepSet.has(idx);
            bool isOwning = self.isOwningTempArg(arg);
            if (!isKeep && !isOwning) { idx = idx + 1; continue; }
            IRNode target = irLiteral("0");
            if (isOwning) {
                /* Hoist the owning temp into a temp var, referenced by both the
                 * call and the post-call release. */
                string tempName = self.freshTemp("__btrc_arg_tmp");
                string tempC = typeToC(at, self.analyzed);
                pre.push(irVarDecl(tempC, tempName, self.lowerExpr(arg, varTypes)));
                self.owningTempOverrides.put(nodeKey(arg), irVar(tempName));
                target = irVar(tempName);
            } else {
                target = self.lowerExpr(arg, varTypes);
            }
            if (isKeep) {
                pre.push(irExprStmt(irUnaryOp("++",
                    irFieldAccess(target, "__rc", true), false)));
                if (!isOwning && arg.kind == NK_IDENTIFIER) {
                    self.registerManagedVar(arg.name, at.base);
                }
            }
            if (isOwning) {
                post.push(self.releaseVarStmt2(target, at.base + "_destroy"));
            }
            idx = idx + 1;
        }
    }

    /* True if `arg` creates a fresh owning object: `new X(...)` or a constructor
     * call `X(...)` (class name as callee). Mirrors _is_owning_temp_arg. */
    public bool isOwningTempArg(Node arg) {
        if (arg.kind == NK_NEW_EXPR) { return true; }
        if (arg.kind == NK_CALL_EXPR && arg.callee != null
                && arg.callee.kind == NK_IDENTIFIER
                && self.analyzed.isClass(arg.callee.name)) {
            return true;
        }
        return false;
    }

    /* if (target != NULL) { if ((--target->__rc) <= 0) { destroy(target); } } for
     * an arbitrary IR target expression (mirrors variables._release_stmt). */
    public IRNode releaseVarStmt2(IRNode target, string destroyFn) {
        IRNode rcDec = irUnaryOp("--", irFieldAccess(target, "__rc", true), true);
        Vector<IRNode> dargs = [];
        dargs.push(target);
        Vector<IRNode> innerStmts = [];
        innerStmts.push(irExprStmt(irCall(destroyFn, dargs)));
        IRNode innerIf = irIf(irBinOp(rcDec, "<=", irLiteral("0")),
            irBlock(innerStmts), null);
        Vector<IRNode> outerStmts = [];
        outerStmts.push(innerIf);
        return irIf(irBinOp(target, "!=", irLiteral("NULL")),
            irBlock(outerStmts), null);
    }

    /* If `expr` is `<managed_local>.free()` / `.destroy()`, the user is managing
     * that local manually — drop it from auto scope-release to avoid a double
     * free. Mirrors statements._maybe_unregister_manual_free. */
    public void maybeUnregisterManualFree(Node? expr) {
        if (expr == null || expr.kind != NK_CALL_EXPR) { return; }
        Node callee = expr.callee;
        if (callee == null || callee.kind != NK_FIELD_ACCESS_EXPR) { return; }
        if (callee.field != "free" && callee.field != "destroy") { return; }
        Node recv = callee.obj;
        if (recv != null && recv.kind == NK_IDENTIFIER) {
            self.unregisterManagedVar(recv.name);
        }
    }

    public void lowerStmtInto(Node node, Map<string, Node> varTypes, Vector<IRNode> out) {
        if (node.kind == NK_VAR_DECL_STMT) {
            /* C array local: `int arr[] = {5,3,1}` / `int buf[N]`. The element
             * type is the base (NOT a pointer), the name carries the `[size]`/`[]`
             * suffix, and a list-literal initializer becomes a raw C aggregate
             * `{...}` (mirrors variables._lower_var_decl's is_array branch). */
            if (node.type != null && node.type.is_array) {
                Node baseType = Node();
                baseType.kind = NK_TYPE_EXPR;
                baseType.base = node.type.base;
                baseType.generic_args = node.type.generic_args;
                baseType.pointer_depth = node.type.pointer_depth;
                string baseC = typeToC(baseType, self.analyzed);
                string varName = node.name + "[]";
                if (node.type.array_size != null) {
                    string sizeText = irExprText(self.lowerExpr(node.type.array_size, varTypes));
                    varName = node.name + "[" + sizeText + "]";
                }
                IRNode? ainit = null;
                if (node.initializer != null) {
                    if (node.initializer.kind == NK_LIST_LITERAL) {
                        string atext = "{";
                        int ai = 0;
                        while (ai < node.initializer.elements.len) {
                            if (ai > 0) { atext = atext + ", "; }
                            atext = atext + irExprText(self.lowerExpr(node.initializer.elements.get(ai), varTypes));
                            ai = ai + 1;
                        }
                        atext = atext + "}";
                        ainit = irRawExpr(atext);
                    } else {
                        ainit = self.lowerExpr(node.initializer, varTypes);
                    }
                }
                if (node.type != null) { varTypes.put(node.name, node.type); }
                out.push(irVarDecl(baseC, varName, ainit));
                return;
            }
            /* `var` (null type): infer from the initializer (mirrors the
             * analyzer setting stmt.type = inferred). */
            Node? declType = node.type;
            if (declType != null) { declType = self.resolveBodyType(declType); }
            if (declType == null && node.initializer != null) {
                declType = inferType(node.initializer, self.analyzed, varTypes);
            }
            string ct = "int";
            if (declType != null) { ct = typeToC(declType, self.analyzed); }
            IRNode? init = null;
            if (node.initializer != null) {
                /* Collection literals: thread the declared type so the mangled
                 * collection name matches the declaration (mirrors the analyzer
                 * stamping node_types from the declared type). */
                if (node.initializer.kind == NK_LIST_LITERAL) {
                    init = self.lowerListLiteral(node.initializer, varTypes, declType);
                } else if (node.initializer.kind == NK_MAP_LITERAL) {
                    init = self.lowerMapLiteral(node.initializer, varTypes, declType);
                } else if (node.initializer.kind == NK_BRACE_INITIALIZER) {
                    init = self.lowerBraceInit(node.initializer, varTypes, declType);
                } else {
                    init = self.lowerExpr(node.initializer, varTypes);
                }
                /* Generic constructor call: Box(42) lowers as a plain call
                 * `Box(42)` (Box isn't a non-generic class); rewrite it to the
                 * mangled `btrc_Box_int_new(42)` using the declared generic args
                 * (mirrors variables._lower_var_decl's generic-ctor fixup). */
                if (declType != null && declType.generic_args.len > 0
                        && init != null && init.kind == IRK_CALL) {
                    Node init0 = node.initializer;
                    if (init0.kind == NK_CALL_EXPR && init0.callee != null
                            && init0.callee.kind == NK_IDENTIFIER
                            && self.analyzed.isGenericClass(init0.callee.name)) {
                        string mangled = mangleGenericType(declType.base, declType.generic_args);
                        init = irCall(mangled + "_new", init.args);
                    }
                }
                /* Implicit class->string coercion: `string s = ClassWithToString();`
                 * wraps the init in `<Class>_toString(...)` (mirrors
                 * variables._lower_var_decl's coerce_value_to_string). */
                if (init != null) {
                    Node? initType = inferType(node.initializer, self.analyzed, varTypes);
                    init = self.coerceToString(declType, initType, init);
                }
            }
            if (declType != null) { varTypes.put(node.name, declType); }
            IRNode vdecl = irVarDecl(ct, node.name, init);
            out.push(vdecl);
            /* Capturing lambda assigned to a var: allocate the capture-env struct
             * on the stack and fill it; cast the impl (which has an extra void*
             * param) to the typedef type for storage; bypass the fn pointer and
             * call the impl directly with &env when the var is invoked. Mirrors
             * variables._lower_var_decl's lambda-capture branch. */
            if (node.initializer != null && node.initializer.kind == NK_LAMBDA_EXPR) {
                Vector<string> lcaps = self.lambdaCaptureNames(node.initializer, varTypes);
                if (lcaps.len > 0) {
                    string lid = Strings.fromInt(self.lastLambdaId);
                    string lfn = "__btrc_lambda_" + lid;
                    string lenv = lfn + "_env";
                    string evar = "__" + node.name + "_env";
                    /* Cast the captured impl to the typedef type for storage. */
                    vdecl.init = irCast(ct, irRawExpr(lfn));
                    out.push(irVarDecl("struct " + lenv, evar, null));
                    int li = 0;
                    while (li < lcaps.len) {
                        string cn = lcaps.get(li);
                        IRNode fa = irFieldAccess(irVar(evar), cn, false);
                        /* Emit as a statement-level IRK_ASSIGN (the emitter
                         * handles assignment as a statement, not an expression). */
                        out.push(irAssign(fa, irVar(cn)));
                        li = li + 1;
                    }
                    self.fnPtrEnvFn.put(node.name, lfn);
                    self.fnPtrEnvVar.put(node.name, evar);
                }
            }
            /* Inside a monomorphized generic method body, ARC is expressed
             * EXPLICITLY in the stdlib source via keep/release/delete — the
             * generic emitter does no auto scope-release (user_emitter_stmts.
             * _var_decl only tracks the type). Auto-managing here would emit a
             * spurious extra release of an escaped local (e.g. the `node` that
             * pushBack stores into the list), corrupting the refcount. */
            if (self.inGenericMethod) { return; }
            /* ARC: auto-manage a class-typed local initialized by `new X(...)`
             * or a constructor call `X(...)` (mirrors variables._lower_var_decl
             * rules 1 & 2). */
            if (declType != null && self.analyzed.isClass(declType.base)
                    && declType.generic_args.len == 0 && node.initializer != null) {
                Node init0 = node.initializer;
                bool owns = init0.kind == NK_NEW_EXPR;
                if (init0.kind == NK_CALL_EXPR && init0.callee != null
                        && init0.callee.kind == NK_IDENTIFIER
                        && self.analyzed.isClass(init0.callee.name)) {
                    owns = true;
                }
                if (owns) {
                    self.registerManagedVar(node.name, declType.base);
                    self.maybeRegisterCleanup(node.name, declType.base + "_destroy", out);
                }
            }
            /* ARC for generic-instance locals (Box<int>, etc.): auto-manage when
             * the initializer OWNS a fresh instance — a `new C<...>()` or a
             * generic constructor call C(...). The managed `cls` is the mangled
             * name so the release uses `<mangled>_destroy`. Mirrors
             * variables._lower_var_decl's generic-collection ARC branch. */
            if (declType != null && declType.generic_args.len > 0
                    && self.analyzed.isGenericClass(declType.base)
                    && node.initializer != null) {
                Node gi = node.initializer;
                /* Owning initializers: list/map/brace literals, `new C<...>()`,
                 * or a generic-class constructor call `C(...)`. Aliasing forms
                 * (a bare identifier, member access, index, arbitrary call) do
                 * NOT own the collection. Mirrors _owns_generic_collection. */
                bool gowns = gi.kind == NK_NEW_EXPR
                    || gi.kind == NK_LIST_LITERAL
                    || gi.kind == NK_MAP_LITERAL
                    || gi.kind == NK_BRACE_INITIALIZER;
                if (gi.kind == NK_CALL_EXPR && gi.callee != null
                        && gi.callee.kind == NK_IDENTIFIER
                        && self.analyzed.isGenericClass(gi.callee.name)) {
                    gowns = true;
                }
                if (gowns) {
                    string mangled = mangleGenericType(declType.base, declType.generic_args);
                    self.registerManagedVar(node.name, mangled);
                    self.maybeRegisterCleanup(node.name, mangled + "_destroy", out);
                }
            }
            return;
        }
        if (node.kind == NK_RETURN_STMT) {
            self.lowerReturn(node, varTypes, out);
            return;
        }
        if (node.kind == NK_EXPR_STMT) {
            Node e = node.expr;
            /* ARC: field assignment implicit keep/release (obj.field = value). */
            if (e != null && e.kind == NK_ASSIGN_EXPR) {
                Vector<IRNode> fpre = [];
                Vector<IRNode> fpost = [];
                self.fieldAssignArcStmts(e, varTypes, fpre, fpost);
                if (fpre.len > 0 || fpost.len > 0) {
                    int a = 0;
                    while (a < fpre.len) { out.push(fpre.get(a)); a = a + 1; }
                    out.push(irExprStmt(self.lowerExpr(e, varTypes)));
                    int b = 0;
                    while (b < fpost.len) { out.push(fpost.get(b)); b = b + 1; }
                    return;
                }
            }
            /* ARC: keep-param rc++ before the call and owning-temporary releases
             * after it (mirrors statements.lower_stmt's _keep_call_arc_stmts).
             * Owning-temp overrides registered here must be live while the call is
             * lowered (so it references the hoisted temp), then cleared. */
            Vector<IRNode> kpre = [];
            Vector<IRNode> kpost = [];
            self.keepCallArcStmts(e, varTypes, kpre, kpost);
            int kp = 0;
            while (kp < kpre.len) { out.push(kpre.get(kp)); kp = kp + 1; }
            out.push(irExprStmt(self.lowerExpr(e, varTypes)));
            if (kpost.len > 0) { self.owningTempOverrides = {}; }
            int kq = 0;
            while (kq < kpost.len) { out.push(kpost.get(kq)); kq = kq + 1; }
            /* ARC: an explicit `v.free()`/`v.destroy()` means the user manages
             * this local; drop it from auto scope-release (mirrors
             * _maybe_unregister_manual_free). */
            self.maybeUnregisterManualFree(e);
            return;
        }
        if (node.kind == NK_IF_STMT) {
            out.push(self.lowerIf(node, varTypes));
            return;
        }
        if (node.kind == NK_WHILE_STMT) {
            IRNode cond = self.lowerExpr(node.condition, varTypes);
            IRNode body = self.lowerLoopBody(node.body_node, varTypes);
            out.push(irWhile(cond, body));
            return;
        }
        if (node.kind == NK_DO_WHILE_STMT) {
            IRNode body = self.lowerLoopBody(node.body_node, varTypes);
            IRNode cond = self.lowerExpr(node.condition, varTypes);
            out.push(irDoWhile(body, cond));
            return;
        }
        if (node.kind == NK_C_FOR_STMT) {
            out.push(self.lowerCFor(node, varTypes));
            return;
        }
        if (node.kind == NK_FOR_IN_STMT) {
            self.lowerForIn(node, varTypes, out);
            return;
        }
        if (node.kind == NK_DELETE_STMT) {
            self.lowerDelete(node, varTypes, out);
            return;
        }
        if (node.kind == NK_BREAK_STMT) {
            /* ARC: release loop-body-owned managed vars before leaving the loop
             * (mirrors statements.lower_stmt BreakStmt). */
            self.emitScopeRelease(self.getLoopManagedVars(), out);
            out.push(irBreak());
            return;
        }
        if (node.kind == NK_CONTINUE_STMT) {
            self.emitScopeRelease(self.getLoopManagedVars(), out);
            out.push(irContinue());
            return;
        }
        if (node.kind == NK_KEEP_STMT) {
            /* keep expr -> expr->__rc++, but ONLY when expr is a managed
             * (class / generic-class) value; a primitive (e.g. `keep val` in a
             * Vector<int> body after monomorphization) is a no-op. Mirrors
             * _keep_stmt: skip unless _class_destroy_fn(resolved) is non-null. */
            Node? kt = inferType(node.expr, self.analyzed, varTypes);
            bool managed = kt != null
                && (self.analyzed.isClass(kt.base)
                    || (kt.generic_args.len > 0 && self.analyzed.isGenericClass(kt.base)));
            if (managed) {
                IRNode expr = self.lowerExpr(node.expr, varTypes);
                out.push(irExprStmt(irUnaryOp("++",
                    irFieldAccess(expr, "__rc", true), false)));
            }
            return;
        }
        if (node.kind == NK_RELEASE_STMT) {
            self.lowerRelease(node, varTypes, out);
            return;
        }
        if (node.kind == NK_THROW_STMT) {
            /* throw expr -> __btrc_throw(expr) (mirrors control_flow._lower_throw). */
            self.useHelper("__btrc_throw");
            IRNode e = self.lowerExpr(node.expr, varTypes);
            Vector<IRNode> targs = [];
            targs.push(e);
            out.push(irExprStmt(irCall("__btrc_throw", targs)));
            return;
        }
        if (node.kind == NK_TRY_CATCH_STMT) {
            self.lowerTryCatch(node, varTypes, out);
            return;
        }
        if (node.kind == NK_SWITCH_STMT) {
            out.push(self.lowerSwitch(node, varTypes));
            return;
        }
        if (node.kind == NK_BLOCK) {
            IRNode b = self.lowerBlock(node, varTypes);
            int i = 0;
            while (i < b.stmts.len) { out.push(b.stmts.get(i)); i = i + 1; }
            return;
        }
        /* Unsupported statement kind: abort loudly (matches unsupported_node). */
        print(f"irgen: unsupported statement kind {node.kind}");
        abortGen();
    }

    /* Lower a return statement with ARC return-path release (mirrors the
     * ReturnStmt branch of statements.lower_stmt). */
    /* True when `sourceType` is a class with a no-arg `toString()` returning
     * string (mirrors stringable.has_to_string). */
    public bool sourceHasToString(Node? sourceType) {
        if (sourceType == null || !self.analyzed.isClass(sourceType.base)) { return false; }
        Node? ts = self.analyzed.classMember(sourceType.base, "toString");
        if (ts == null || ts.kind != NK_METHOD_DECL) { return false; }
        if (ts.params.len > 0) { return false; }
        if (ts.return_type == null || ts.return_type.base != "string") { return false; }
        return true;
    }

    /* Wrap `value` in `<Prefix>_toString(value)` (mirrors stringable.to_string_call).
     * Caller must have checked sourceHasToString(sourceType). */
    public IRNode toStringCall(Node sourceType, IRNode value) {
        string prefix = sourceType.base;
        if (sourceType.generic_args.len > 0 && self.analyzed.isGenericClass(sourceType.base)) {
            prefix = mangleGenericType(sourceType.base, sourceType.generic_args);
        }
        Vector<IRNode> ca = [];
        ca.push(value);
        return irCall(prefix + "_toString", ca);
    }

    /* Implicit class->string coercion (mirrors stringable.coerce_value_to_string
     * / coerce_to_string_param). When `targetType` is `string` and `sourceType`
     * is a class with a no-arg `toString()` returning string, wrap `value` in
     * `<Prefix>_toString(value)`. Otherwise return `value` unchanged. */
    public IRNode coerceToString(Node? targetType, Node? sourceType, IRNode value) {
        if (targetType == null || targetType.base != "string") { return value; }
        if (!self.sourceHasToString(sourceType)) { return value; }
        return self.toStringCall(sourceType, value);
    }

    public void lowerReturn(Node node, Map<string, Node> varTypes, Vector<IRNode> out) {
        if (node.value_node == null) {
            self.emitReturnRelease("", out);
            out.push(irReturn(null));
            return;
        }
        Node val = node.value_node;
        if (val.kind == NK_IDENTIFIER) {
            /* Returning a bare local transfers ownership: exclude it from the
             * release rather than decref'ing it. */
            IRNode v = self.lowerExpr(val, varTypes);
            Node? vt = inferType(val, self.analyzed, varTypes);
            v = self.coerceToString(self.currentReturnTypeNode, vt, v);
            self.emitReturnRelease(val.name, out);
            out.push(irReturn(v));
            return;
        }
        /* Returning a non-trivial expression. */
        IRNode v = self.lowerExpr(val, varTypes);
        Node? rvt = inferType(val, self.analyzed, varTypes);
        v = self.coerceToString(self.currentReturnTypeNode, rvt, v);
        Vector<IRNode> releases = [];
        self.emitReturnRelease("", releases);
        if (releases.len == 0) {
            out.push(irReturn(v));
            return;
        }
        /* Stash in a temp, release, then return the temp (so the release can't
         * free objects the return expression still references). */
        string tmp = self.freshTemp("__btrc_ret");
        out.push(irVarDecl(self.currentReturnCType, tmp, v));
        int i = 0;
        while (i < releases.len) { out.push(releases.get(i)); i = i + 1; }
        out.push(irReturn(irVar(tmp)));
    }

    /* Lower delete expr -> X_destroy(obj) (or free for non-class), then obj=NULL
     * (mirrors control_flow._lower_delete). */
    public void lowerDelete(Node node, Map<string, Node> varTypes, Vector<IRNode> out) {
        IRNode obj = self.lowerExpr(node.expr, varTypes);
        Node? ot = inferType(node.expr, self.analyzed, varTypes);
        /* In a generic body the operand type is `T`/`K`/`V`; resolve it so a
         * generic-instance delete dispatches to the right destructor. */
        if (self.inGenericMethod) { ot = resolveGenericType(ot, self.activeTypeMap); }
        Vector<IRNode> dargs = [];
        dargs.push(obj);
        if (ot != null && self.analyzed.isClass(ot.base) && ot.generic_args.len == 0) {
            out.push(irExprStmt(irCall(ot.base + "_destroy", dargs)));
        } else if (ot != null && ot.generic_args.len > 0
                && self.analyzed.isGenericClass(ot.base)) {
            /* Generic instance: `<mangled>_free` if the class defines a free
             * method, else `<mangled>_destroy` (mirrors _class_destroy_fn). */
            string mangled = mangleGenericType(ot.base, ot.generic_args);
            string dtor = "destroy";
            if (genericMember(self.analyzed, ot.base, "free") != null) { dtor = "free"; }
            out.push(irExprStmt(irCall(mangled + "_" + dtor, dargs)));
        } else {
            out.push(irExprStmt(irCall("free", dargs)));
        }
        out.push(irAssign(obj, irLiteral("NULL")));
    }

    /* Lower `release expr;` -> if (expr != NULL) { if ((--expr->__rc) <= 0) {
     * destroy(expr); } } expr = NULL;  (mirrors arc.py _lower_release). */
    public void lowerRelease(Node node, Map<string, Node> varTypes, Vector<IRNode> out) {
        IRNode expr = self.lowerExpr(node.expr, varTypes);
        Node? et = inferType(node.expr, self.analyzed, varTypes);
        /* In a monomorphized generic body the operand type is `T`/`K`/`V`; resolve
         * it to the concrete element type so the destructor (or skip) is correct. */
        if (self.inGenericMethod) { et = resolveGenericType(et, self.activeTypeMap); }
        string destroyFn = "free";
        bool managed = false;
        if (et != null && self.analyzed.isClass(et.base)) {
            destroyFn = et.base + "_destroy";
            managed = true;
        } else if (et != null && et.generic_args.len > 0
                && self.analyzed.isGenericClass(et.base)) {
            string mangled = mangleGenericType(et.base, et.generic_args);
            string dtor = "destroy";
            if (genericMember(self.analyzed, et.base, "free") != null) { dtor = "free"; }
            destroyFn = mangled + "_" + dtor;
            managed = true;
        }
        /* Releasing a primitive/string element inside a generic collection body
         * is a no-op (mirrors _release_stmt returning [] when the resolved type
         * has no destructor). Outside generics, keep historical emission. */
        if (self.inGenericMethod && !managed) { return; }
        IRNode rcDec = irUnaryOp("--",
            irFieldAccess(expr, "__rc", true), true);
        Vector<IRNode> dargs = [];
        dargs.push(expr);
        Vector<IRNode> innerStmts = [];
        innerStmts.push(irExprStmt(irCall(destroyFn, dargs)));
        IRNode innerIf = irIf(
            irBinOp(rcDec, "<=", irLiteral("0")),
            irBlock(innerStmts), null);
        Vector<IRNode> outerStmts = [];
        outerStmts.push(innerIf);
        out.push(irIf(
            irBinOp(expr, "!=", irLiteral("NULL")),
            irBlock(outerStmts), null));
        out.push(irAssign(expr, irLiteral("NULL")));
    }

    /* Lower try/catch to setjmp/longjmp boilerplate (mirrors
     * control_flow._lower_try_catch, common catch-present subset). */
    public void lowerTryCatch(Node node, Map<string, Node> varTypes, Vector<IRNode> out) {
        self.useHelper("__btrc_trycatch_globals");
        self.useHelper("__btrc_throw");
        /* try/catch needs <setjmp.h> (already added at module level when any
         * declaration uses try/catch). */

        /* A try with a `finally` but NO `catch` must run the finally and then
         * RE-THROW any pending exception to the enclosing handler (mirrors
         * control_flow._lower_try_catch finally_only). */
        bool finallyOnly = node.catch_block == null && node.finally_block != null;
        string pendingName = "";
        string errorName = "";
        if (finallyOnly) {
            pendingName = self.freshTemp("__btrc_finally_pending");
            errorName = self.freshTemp("__btrc_finally_error");
        }

        /* setjmp boilerplate. */
        out.push(irRawC(
            "if (!__btrc_try_stack) {\n"
            + "    __btrc_try_stack = (jmp_buf*)malloc(sizeof(jmp_buf) * __btrc_try_cap);\n"
            + "}\n"
            + "if (__btrc_try_top + 1 >= __btrc_try_cap) {\n"
            + "    __btrc_try_cap *= 2;\n"
            + "    __btrc_try_stack = (jmp_buf*)realloc(__btrc_try_stack, sizeof(jmp_buf) * __btrc_try_cap);\n"
            + "}\n"
            + "__btrc_try_top++;"));

        /* try block. */
        self.inTryDepth = self.inTryDepth + 1;
        IRNode tryBody = self.lowerBlock(node.try_block, varTypes);
        self.inTryDepth = self.inTryDepth - 1;
        /* Normal exit: discard the cleanup registrations (scope release already
         * freed them), then decrement the try level. Gated on whether any
         * exception cleanup is registered at all (mirrors the global-helper check
         * in control_flow._lower_try_catch). */
        if (self.usedHelpers.has("__btrc_register_cleanup")) {
            self.useHelper("__btrc_discard_cleanups");
            Vector<IRNode> dargs = [];
            dargs.push(irVar("__btrc_try_top"));
            tryBody.stmts.push(irExprStmt(irCall("__btrc_discard_cleanups", dargs)));
        }
        tryBody.stmts.push(irRawC("__btrc_try_top--;"));

        /* Pending-exception flag + message buffer, declared before the if. */
        if (finallyOnly) {
            out.push(irRawC(f"bool {pendingName} = false;\nchar {errorName}[1024] = \"\";"));
        }

        /* catch block. */
        IRNode catchBody = irBlock([]);
        if (finallyOnly) {
            /* No user catch: capture the in-flight exception so the finally can
             * run, then re-throw it after. */
            Vector<IRNode> cstmts = [];
            cstmts.push(irRawC(f"{pendingName} = true;\nstrncpy({errorName}, __btrc_error_msg, 1023);\n{errorName}[1023] = '\\0';"));
            catchBody = irBlock(cstmts);
        } else if (node.catch_block != null) {
            /* Register the catch variable's type (declared `catch_type`, else
             * `string` — exceptions are string messages) so body inference (e.g.
             * f-string format specifiers) sees `const char*`, not a default int.
             * The Python compiler gets this from analyzer-stamped node_types. */
            if (node.catch_var != "") {
                Node ctype = makePrimType("string");
                if (node.catch_type != null) { ctype = node.catch_type; }
                varTypes.put(node.catch_var, ctype);
            }
            catchBody = self.lowerBlock(node.catch_block, varTypes);
            if (node.catch_var != "") {
                /* const char* <catch_var> = __btrc_error_msg; prepended. */
                Vector<IRNode> merged = [];
                merged.push(irVarDecl("const char*", node.catch_var, irVar("__btrc_error_msg")));
                int i = 0;
                while (i < catchBody.stmts.len) { merged.push(catchBody.stmts.get(i)); i = i + 1; }
                catchBody = irBlock(merged);
            }
        }

        IRNode tcIf = irIf(irRawExpr("setjmp(__btrc_try_stack[__btrc_try_top]) == 0"),
            tryBody, catchBody);
        out.push(tcIf);

        /* finally block: emitted inline after the if. */
        if (node.finally_block != null) {
            IRNode fin = self.lowerBlock(node.finally_block, varTypes);
            int i = 0;
            while (i < fin.stmts.len) { out.push(fin.stmts.get(i)); i = i + 1; }
            /* Re-throw the captured exception (finally-only). */
            if (finallyOnly) {
                Vector<IRNode> targs = [];
                targs.push(irVar(errorName));
                Vector<IRNode> rethrow = [];
                rethrow.push(irExprStmt(irCall("__btrc_throw", targs)));
                out.push(irIf(irVar(pendingName), irBlock(rethrow), null));
            }
        }
    }

    /* Lower a switch statement -> IRSwitch with IRCase children (mirrors
     * control_flow._lower_switch). A case with no value is the `default:` clause. */
    public IRNode lowerSwitch(Node node, Map<string, Node> varTypes) {
        IRNode val = self.lowerExpr(node.value_node, varTypes);
        Vector<IRNode> cases = [];
        int i = 0;
        while (i < node.cases.len) {
            Node c = node.cases.get(i);
            IRNode? caseVal = null;
            if (c.value_node != null) { caseVal = self.lowerExpr(c.value_node, varTypes); }
            Vector<IRNode> body = [];
            int j = 0;
            while (j < c.body_nlist.len) {
                self.lowerStmtInto(c.body_nlist.get(j), varTypes, body);
                j = j + 1;
            }
            cases.push(irCase(caseVal, body));
            i = i + 1;
        }
        return irSwitch(val, cases);
    }

    public IRNode lowerIf(Node node, Map<string, Node> varTypes) {
        IRNode cond = self.lowerExpr(node.condition, varTypes);
        IRNode then_b = self.lowerBlock(node.then_block, varTypes);
        IRNode? else_b = null;
        if (node.else_block != null) {
            else_b = self.lowerElse(node.else_block, varTypes);
        }
        return irIf(cond, then_b, else_b);
    }

    /* Lower an else tail (ElseBlock or ElseIf) into an IRBlock. */
    public IRNode lowerElse(Node node, Map<string, Node> varTypes) {
        if (node.kind == NK_ELSE_BLOCK) {
            return self.lowerBlock(node.body_node, varTypes);
        }
        if (node.kind == NK_ELSE_IF) {
            Vector<IRNode> stmts = [];
            stmts.push(self.lowerIf(node.if_stmt, varTypes));
            return irBlock(stmts);
        }
        return irBlock([]);
    }

    public IRNode lowerCFor(Node node, Map<string, Node> varTypes) {
        IRNode? init = null;
        if (node.init != null) {
            if (node.init.kind == NK_FOR_INIT_VAR) {
                Node vd = node.init.var_decl;
                string ct = "int";
                if (vd.type != null) { ct = typeToC(vd.type, self.analyzed); }
                IRNode? vinit = null;
                if (vd.initializer != null) {
                    vinit = self.lowerExpr(vd.initializer, varTypes);
                }
                if (vd.type != null) { varTypes.put(vd.name, vd.type); }
                init = irVarDecl(ct, vd.name, vinit);
            } else if (node.init.kind == NK_FOR_INIT_EXPR) {
                init = irExprStmt(self.lowerExpr(node.init.expression, varTypes));
            }
        }
        /* Condition defaults to literal 1 when absent (matches iterations.py). */
        IRNode cond = irLiteral("1");
        if (node.condition != null) { cond = self.lowerExpr(node.condition, varTypes); }
        IRNode? update = null;
        if (node.update != null) {
            update = self.lowerExpr(node.update, varTypes);
        }
        IRNode body = self.lowerLoopBody(node.body_node, varTypes);
        return irFor(init, cond, update, body);
    }

    /* Build a loop body block with `prefix` statements prepended to the lowered
     * body (the binding decls), mirroring body_block.stmts.insert(0, ...). */
    public IRNode loopBodyWithPrefix(Node bodyNode, Map<string, Node> varTypes, Vector<IRNode> prefix) {
        IRNode b = self.lowerLoopBody(bodyNode, varTypes);
        Vector<IRNode> merged = [];
        int p = 0;
        while (p < prefix.len) { merged.push(prefix.get(p)); p = p + 1; }
        int i = 0;
        while (i < b.stmts.len) { merged.push(b.stmts.get(i)); i = i + 1; }
        return irBlock(merged);
    }

    /* Iterable-value C type for a generic arg: class values are reference types,
     * so append a pointer if not already a pointer (mirrors _iter_value_c). */
    public string iterValueC(Node t) {
        string c = typeToC(t, self.analyzed);
        bool isPtr = false;
        if (c.length() >= 1 && c.substring(c.length() - 1, 1) == "*") { isPtr = true; }
        if (t != null && self.analyzed.isClass(t.base) && !isPtr) {
            return c + "*";
        }
        return c;
    }

    /* Lower for-in to a C-style for loop (mirrors iterations._lower_for_in). */
    public void lowerForIn(Node node, Map<string, Node> varTypes, Vector<IRNode> out) {
        Node iterable = node.iterable;
        string varName = node.var_name;

        /* range(...) form. */
        if (iterable.kind == NK_CALL_EXPR && iterable.callee != null
                && iterable.callee.kind == NK_IDENTIFIER
                && iterable.callee.name == "range") {
            self.lowerRangeFor(varName, iterable.args, node.body_node, varTypes, out);
            return;
        }

        Node? iterType = inferType(iterable, self.analyzed, varTypes);
        IRNode irIter = self.lowerExpr(iterable, varTypes);

        /* Iterable protocol: generic class with iterLen + iterGet methods. */
        if (iterType != null && iterType.generic_args.len > 0
                && self.analyzed.isGenericClass(iterType.base)
                && genericMember(self.analyzed, iterType.base, "iterLen") != null
                && genericMember(self.analyzed, iterType.base, "iterGet") != null) {
            self.lowerIterableForIn(node, irIter, iterType, varName, varTypes, out);
            return;
        }

        /* String iteration: for c in str. */
        if (iterType != null && iterType.base == "string" && iterType.pointer_depth == 0
                && iterType.generic_args.len == 0) {
            self.lowerStringForIn(node, irIter, varName, varTypes, out);
            return;
        }

        /* Fallback: list-like with ->len and ->data[i]. */
        string idx = self.freshTemp("__i");
        string tmpIter = self.freshTemp("__iter");
        string iterC = "void*";
        if (iterType != null) {
            iterC = typeToC(iterType, self.analyzed);
            if (!(iterC.length() >= 1 && iterC.substring(iterC.length() - 1, 1) == "*")) {
                iterC = iterC + "*";
            }
        }
        string elemC = "int";
        Node? elemT = null;
        if (iterType != null && iterType.generic_args.len > 0) {
            elemT = iterType.generic_args.get(0);
            elemC = self.iterValueC(elemT);
        }
        if (elemT != null) { varTypes.put(varName, elemT); }
        IRNode dataExpr = irFieldAccess(irVar(tmpIter), "data", true);
        Vector<IRNode> prefix = [];
        prefix.push(irVarDecl(elemC, varName, irIndex(dataExpr, irVar(idx))));
        IRNode body = self.loopBodyWithPrefix(node.body_node, varTypes, prefix);
        out.push(irVarDecl(iterC, tmpIter, irIter));
        IRNode forInit = irVarDecl("int", idx, irLiteral("0"));
        IRNode cond = irBinOp(irVar(idx), "<", irFieldAccess(irVar(tmpIter), "len", true));
        IRNode upd = irUnaryOp("++", irVar(idx), false);
        out.push(irFor(forInit, cond, upd, body));
    }

    /* for-in via Iterable protocol (iterLen/iterGet/iterValueAt). */
    public void lowerIterableForIn(Node node, IRNode irIter, Node iterType, string varName, Map<string, Node> varTypes, Vector<IRNode> out) {
        string mangled = mangleGenericType(iterType.base, iterType.generic_args);
        string idx = self.freshTemp("__i");
        string nVar = self.freshTemp("__n");
        Node elemT = iterType.generic_args.get(0);
        string elemC = self.iterValueC(elemT);
        varTypes.put(varName, elemT);
        Vector<IRNode> prefix = [];
        /* Two-variable iteration (for k, v in map). var_name2 is nullable. */
        string vn2 = "";
        if (node.var_name2 != null) { vn2 = node.var_name2; }
        if (vn2 != "" && iterType.generic_args.len > 1
                && genericMember(self.analyzed, iterType.base, "iterValueAt") != null) {
            Node v2T = iterType.generic_args.get(1);
            string vC = self.iterValueC(v2T);
            varTypes.put(vn2, v2T);
            Vector<IRNode> vargs = [];
            vargs.push(irIter);
            vargs.push(irVar(idx));
            prefix.push(irVarDecl(vC, vn2, irCall(mangled + "_iterValueAt", vargs)));
        }
        Vector<IRNode> gargs = [];
        gargs.push(irIter);
        gargs.push(irVar(idx));
        prefix.push(irVarDecl(elemC, varName, irCall(mangled + "_iterGet", gargs)));
        IRNode body = self.loopBodyWithPrefix(node.body_node, varTypes, prefix);
        Vector<IRNode> nargs = [];
        nargs.push(irIter);
        out.push(irVarDecl("int", nVar, irCall(mangled + "_iterLen", nargs)));
        IRNode forInit = irVarDecl("int", idx, irLiteral("0"));
        IRNode cond = irBinOp(irVar(idx), "<", irVar(nVar));
        IRNode upd = irUnaryOp("++", irVar(idx), false);
        out.push(irFor(forInit, cond, upd, body));
    }

    /* for c in str -> char-by-char iteration. */
    public void lowerStringForIn(Node node, IRNode irIter, string varName, Map<string, Node> varTypes, Vector<IRNode> out) {
        string idx = self.freshTemp("__i");
        varTypes.put(varName, makePrimType("char"));
        Vector<IRNode> prefix = [];
        prefix.push(irVarDecl("char", varName, irIndex(irIter, irVar(idx))));
        IRNode body = self.loopBodyWithPrefix(node.body_node, varTypes, prefix);
        IRNode forInit = irVarDecl("int", idx, irLiteral("0"));
        IRNode cond = irBinOp(irIndex(irIter, irVar(idx)), "!=", irLiteral("'\\0'"));
        IRNode upd = irUnaryOp("++", irVar(idx), false);
        out.push(irFor(forInit, cond, upd, body));
    }

    /* for x in range(...) -> C for loop (1, 2, or 3+ args). */
    public void lowerRangeFor(string varName, Vector<Node> args, Node bodyNode, Map<string, Node> varTypes, Vector<IRNode> out) {
        varTypes.put(varName, makePrimType("int"));
        IRNode body = self.lowerLoopBody(bodyNode, varTypes);
        IRNode upd = irUnaryOp("++", irVar(varName), false);
        if (args.len == 1) {
            IRNode end = self.lowerExpr(args.get(0), varTypes);
            IRNode forInit = irVarDecl("int", varName, irLiteral("0"));
            IRNode cond = irBinOp(irVar(varName), "<", end);
            out.push(irFor(forInit, cond, upd, body));
            return;
        }
        if (args.len == 2) {
            IRNode start = self.lowerExpr(args.get(0), varTypes);
            IRNode end = self.lowerExpr(args.get(1), varTypes);
            IRNode forInit = irVarDecl("int", varName, start);
            IRNode cond = irBinOp(irVar(varName), "<", end);
            out.push(irFor(forInit, cond, upd, body));
            return;
        }
        if (args.len >= 3) {
            IRNode start = self.lowerExpr(args.get(0), varTypes);
            IRNode end = self.lowerExpr(args.get(1), varTypes);
            IRNode step = self.lowerExpr(args.get(2), varTypes);
            IRNode forInit = irVarDecl("int", varName, start);
            IRNode posCond = irBinOp(irVar(varName), "<", end);
            IRNode negCond = irBinOp(irVar(varName), ">", end);
            IRNode cond = irTernary(irBinOp(step, ">", irLiteral("0")), posCond, negCond);
            IRNode upd2 = irBinOp(irVar(varName), "+=", step);
            out.push(irFor(forInit, cond, upd2, body));
            return;
        }
        IRNode forInit = irVarDecl("int", varName, irLiteral("0"));
        IRNode cond = irBinOp(irVar(varName), "<", irLiteral("0"));
        out.push(irFor(forInit, cond, upd, body));
    }

    /* --- expression lowering --- */

    public IRNode lowerExpr(Node node, Map<string, Node> varTypes) {
        if (node == null) { return irLiteral("0"); }
        /* ARC: an owning-temporary argument hoisted into a temp var resolves to
         * that temp (mirrors expressions.lower_expr's _owning_temp_overrides
         * check). The temp is declared/initialized in the call's pre-stmts. */
        if (self.owningTempOverrides.len > 0) {
            string key = nodeKey(node);
            if (self.owningTempOverrides.has(key)) {
                return self.owningTempOverrides.get(key);
            }
        }
        if (node.kind == NK_INT_LITERAL) {
            string raw = node.raw;
            if (raw == "") { raw = Strings.fromInt(node.value_int); }
            if (raw.length() >= 2) {
                string pfx = raw.substring(0, 2);
                if (pfx == "0o" || pfx == "0O") {
                    return irLiteral("0" + raw.substring(2, raw.length() - 2));
                }
            }
            return irLiteral(raw);
        }
        if (node.kind == NK_FLOAT_LITERAL) {
            string raw = node.raw;
            if (raw == "") { raw = f"{node.value_float}"; }
            return irLiteral(raw);
        }
        if (node.kind == NK_STRING_LITERAL) { return irLiteral(node.value_string); }
        if (node.kind == NK_CHAR_LITERAL) { return irLiteral(node.value_string); }
        if (node.kind == NK_F_STRING_LITERAL) { return self.lowerFString(node, varTypes); }
        if (node.kind == NK_BOOL_LITERAL) {
            if (node.value_bool) { return irLiteral("true"); }
            return irLiteral("false");
        }
        if (node.kind == NK_NULL_LITERAL) { return irLiteral("NULL"); }
        if (node.kind == NK_IDENTIFIER) {
            /* Bare enum value (RED -> Color_RED). Mirrors expressions.
             * _lower_identifier's enum_table scan. */
            if (self.analyzed.isEnumValue(node.name)) {
                return irLiteral(self.analyzed.enumOwnerOf(node.name) + "_" + node.name);
            }
            return irVar(node.name);
        }
        if (node.kind == NK_SELF_EXPR) { return irVar("self"); }
        if (node.kind == NK_NEW_EXPR) { return self.lowerNew(node, varTypes); }
        if (node.kind == NK_FIELD_ACCESS_EXPR) { return self.lowerFieldAccess(node, varTypes); }
        if (node.kind == NK_BINARY_EXPR) { return self.lowerBinary(node, varTypes); }
        if (node.kind == NK_UNARY_EXPR) { return self.lowerUnary(node, varTypes); }
        if (node.kind == NK_CALL_EXPR) { return self.lowerCall(node, varTypes); }
        if (node.kind == NK_CAST_EXPR) {
            return irCast(typeToC(self.resolveBodyType(node.target_type), self.analyzed),
                          self.lowerExpr(node.expr, varTypes));
        }
        if (node.kind == NK_TERNARY_EXPR) {
            return irTernary(self.lowerExpr(node.condition, varTypes),
                             self.lowerExpr(node.true_expr, varTypes),
                             self.lowerExpr(node.false_expr, varTypes));
        }
        if (node.kind == NK_INDEX_EXPR) {
            IRNode iobj = self.lowerExpr(node.obj, varTypes);
            IRNode iidx = self.lowerExpr(node.index, varTypes);
            /* Subscript on a generic collection (Vector<T>/Map<K,V>): lower to
             * {mangled}_get(obj, index) (mirrors fields._lower_index). Generic
             * method bodies index raw `T*` backing arrays, so skip there. */
            if (!self.inGenericMethod) {
                Node? iot = inferType(node.obj, self.analyzed, varTypes);
                if (iot != null && iot.generic_args.len > 0
                        && self.analyzed.isGenericClass(iot.base)) {
                    string mangled = mangleGenericType(iot.base, iot.generic_args);
                    Vector<IRNode> gargs = [];
                    gargs.push(iobj);
                    gargs.push(iidx);
                    return irCall(mangled + "_get", gargs);
                }
            }
            return irIndex(iobj, iidx);
        }
        if (node.kind == NK_ASSIGN_EXPR) {
            /* Property setter: obj.prop = v -> ClassName_set_prop(obj, v);
             * self.prop = v inside the class -> backing field assign. */
            if (node.op == "=" && node.target != null
                    && node.target.kind == NK_FIELD_ACCESS_EXPR) {
                Node tgt = node.target;
                Node? ot = inferType(tgt.obj, self.analyzed, varTypes);
                if (ot != null && self.analyzed.isClass(ot.base)
                        && self.analyzed.isProperty(ot.base, tgt.field)) {
                    IRNode obj = self.lowerExpr(tgt.obj, varTypes);
                    IRNode v = self.lowerExpr(node.value_node, varTypes);
                    if (tgt.obj.kind == NK_SELF_EXPR) {
                        IRNode backing = irFieldAccess(obj, "_prop_" + tgt.field, true);
                        return irBinOp(backing, "=", v);
                    }
                    Vector<IRNode> sargs = [];
                    sargs.push(obj);
                    sargs.push(v);
                    return irCall(ot.base + "_set_" + tgt.field, sargs);
                }
            }
            /* Collection index assignment: coll[i] = v -> {mangled}_set(coll, i, v)
             * (mirrors fields._lower_assign index-assignment branch). A generic
             * collection instance is a C pointer, so `coll[i] = v` is not a valid
             * lvalue; route the store through the collection's _set helper.
             * Inside a generic method body, `self.data[i] = v` indexes the raw
             * `T*` backing array, so skip the _set route there (mirrors the
             * NK_INDEX_EXPR read path's `!inGenericMethod` guard). */
            if (node.op == "=" && node.target != null
                    && node.target.kind == NK_INDEX_EXPR
                    && !self.inGenericMethod) {
                Node itgt = node.target;
                Node? iott = inferType(itgt.obj, self.analyzed, varTypes);
                /* Only a collection VALUE (pointer_depth 0) routes through _set;
                 * a raw `T*`/`T**` pointer field (e.g. `self.data` inside a
                 * generic collection method, resolved to `Vector<Obj>*`) is a
                 * plain C array and must use `arr[i] = v`. Without the
                 * pointer_depth guard, monomorphization makes `self.data[i] = v`
                 * inside Vector<Vector<Obj>> wrongly call Vector_Obj_set. */
                if (iott != null && iott.generic_args.len > 0
                        && iott.pointer_depth == 0
                        && self.analyzed.isGenericClass(iott.base)) {
                    string mangled = mangleGenericType(iott.base, iott.generic_args);
                    IRNode iobj2 = self.lowerExpr(itgt.obj, varTypes);
                    IRNode iidx2 = self.lowerExpr(itgt.index, varTypes);
                    IRNode ival2 = self.lowerExpr(node.value_node, varTypes);
                    Vector<IRNode> setArgs = [];
                    setArgs.push(iobj2);
                    setArgs.push(iidx2);
                    setArgs.push(ival2);
                    return irCall(mangled + "_set", setArgs);
                }
            }
            /* Empty {} / [] assigned to a collection-typed target -> coll_new()
             * (mirrors fields._lower_assign empty-brace branch). The target type
             * is inferred (e.g. a Map/Set/Vector field). */
            if (node.op == "=" && node.value_node != null
                    && (node.value_node.kind == NK_BRACE_INITIALIZER
                        || node.value_node.kind == NK_MAP_LITERAL
                        || node.value_node.kind == NK_LIST_LITERAL)) {
                Node? tt = inferType(node.target, self.analyzed, varTypes);
                if (tt != null && tt.generic_args.len > 0
                        && self.analyzed.isGenericClass(tt.base)) {
                    IRNode tgt2 = self.lowerExpr(node.target, varTypes);
                    IRNode rhs = irLiteral("NULL");
                    if (node.value_node.kind == NK_BRACE_INITIALIZER) {
                        rhs = self.lowerBraceInit(node.value_node, varTypes, tt);
                    } else if (node.value_node.kind == NK_MAP_LITERAL) {
                        rhs = self.lowerMapLiteral(node.value_node, varTypes, tt);
                    } else {
                        rhs = self.lowerListLiteral(node.value_node, varTypes, tt);
                    }
                    return irBinOp(tgt2, "=", rhs);
                }
            }
            /* Assignment is lowered as an expression -> IRBinOp with the op,
             * for both `=` and compound (`+=`, etc.). The emitter wraps it in
             * parens: `(x = 5)`, `(sum += i)`. (Matches fields.py _lower_assign
             * for the non-property, non-collection subset.) */
            IRNode target = self.lowerExpr(node.target, varTypes);
            IRNode value = self.lowerExpr(node.value_node, varTypes);
            /* String += -> target = __btrc_str_track(__btrc_strcat(target, v)) */
            if (node.op == "+=" && typeIsString(inferType(node.target, self.analyzed, varTypes))) {
                self.useHelper("__btrc_strcat");
                self.useHelper("__btrc_str_track");
                Vector<IRNode> catArgs = [];
                catArgs.push(target);
                catArgs.push(value);
                IRNode cat = irCall("__btrc_strcat", catArgs);
                Vector<IRNode> trackArgs = [];
                trackArgs.push(cat);
                IRNode tracked = irCall("__btrc_str_track", trackArgs);
                return irBinOp(target, "=", tracked);
            }
            return irBinOp(target, node.op, value);
        }
        if (node.kind == NK_SIZEOF_EXPR) {
            return self.lowerSizeof(node, varTypes);
        }
        if (node.kind == NK_LIST_LITERAL) {
            return self.lowerListLiteral(node, varTypes, null);
        }
        if (node.kind == NK_MAP_LITERAL) {
            return self.lowerMapLiteral(node, varTypes, null);
        }
        if (node.kind == NK_BRACE_INITIALIZER) {
            return self.lowerBraceInit(node, varTypes, null);
        }
        if (node.kind == NK_LAMBDA_EXPR) {
            return self.lowerLambda(node, varTypes);
        }
        if (node.kind == NK_TUPLE_LITERAL) {
            return self.lowerTupleLiteral(node, varTypes);
        }
        if (node.kind == NK_SPAWN_EXPR) {
            return self.lowerSpawn(node, varTypes);
        }
        print(f"irgen: unsupported expression kind {node.kind}");
        abortGen();
        return irLiteral("0");
    }

    /* Compute a lambda's captured variable names: identifiers used in the body
     * that are enclosing locals/params (present in varTypes) and are NOT lambda
     * params, sorted lexicographically. Mirrors analyzer._analyze_lambda's
     * capture computation (btrcc does it on-demand at lowering, having no
     * persistent scope). */
    public Vector<string> lambdaCaptureNames(Node node, Map<string, Node> varTypes) {
        Map<string, bool> paramNames = {};
        int pi = 0;
        while (pi < node.params.len) {
            paramNames.put(node.params.get(pi).name, true);
            pi = pi + 1;
        }
        Map<string, bool> usedNames = {};
        collectIdentifiers(node.body_node, usedNames);
        Vector<string> capNames = [];
        Vector<string> usedKeys = usedNames.keys();
        int uk = 0;
        while (uk < usedKeys.len) {
            string nm = usedKeys.get(uk);
            if (!paramNames.has(nm) && varTypes.has(nm)) { capNames.push(nm); }
            uk = uk + 1;
        }
        /* Sort capture names lexicographically (insertion sort via strcmp). */
        int si = 1;
        while (si < capNames.len) {
            string keyN = capNames.get(si);
            int sj = si - 1;
            while (sj >= 0 && strcmp(capNames.get(sj), keyN) > 0) {
                capNames.set(sj + 1, capNames.get(sj));
                sj = sj - 1;
            }
            capNames.set(sj + 1, keyN);
            si = si + 1;
        }
        return capNames;
    }

    /* Lower a lambda expression to a lifted static function (+ a capture-env
     * struct when it closes over enclosing locals), appended to the current
     * module. Returns an IRRawExpr naming the function, since lambdas are used
     * as function-pointer values. Mirrors ir/gen/lambdas.py lower_lambda. */
    public IRNode lowerLambda(Node node, Map<string, Node> varTypes) {
        int lambdaId = self.freshLambdaId();
        string fnName = "__btrc_lambda_" + Strings.fromInt(lambdaId);
        string envName = fnName + "_env";

        Vector<string> capNames = self.lambdaCaptureNames(node, varTypes);
        bool hasCaptures = capNames.len > 0;

        /* Capture-env struct (one field per captured variable). */
        if (hasCaptures) {
            IRStructDef sd = IRStructDef();
            sd.name = envName;
            int ci = 0;
            while (ci < capNames.len) {
                string cn = capNames.get(ci);
                string cty = typeToC(varTypes.get(cn), self.analyzed);
                sd.fields.push(IRStructField(cty, cn));
                ci = ci + 1;
            }
            self.curModule.struct_defs.push(sd);
        }

        /* Build the lifted function. */
        IRFunction fn = IRFunction();
        fn.name = fnName;
        fn.is_static = true;

        /* Return type: explicit annotation, else infer from __fn_ptr type,
         * else from the body expression, else void. */
        Node fpt = lambdaFnPtrType(node, self.analyzed, varTypes);
        string retC = "void";
        if (node.return_type != null) {
            retC = typeToC(node.return_type, self.analyzed);
        } else if (fpt.generic_args.len > 0) {
            retC = typeToC(fpt.generic_args.get(0), self.analyzed);
        }
        fn.return_type = retC;

        /* Params: the lambda's own params, then a trailing void* env when the
         * lambda captures (kept off the typedef, so captured lambdas are called
         * directly by name with the env arg). */
        int p2 = 0;
        while (p2 < node.params.len) {
            Node pp = node.params.get(p2);
            fn.params.push(IRParam(typeToC(pp.type, self.analyzed), pp.name));
            p2 = p2 + 1;
        }
        if (hasCaptures) {
            fn.params.push(IRParam("void*", "__btrc_env"));
        }

        /* Body: unpack captures from env, then the lowered lambda body. Lower in
         * an isolated ARC/return context (the lambda is a separate C function). */
        Vector<IRNode> body = [];
        if (hasCaptures) {
            IRNode envCast = irCast("struct " + envName + "*", irVar("__btrc_env"));
            body.push(irVarDecl("struct " + envName + "*", "__env", envCast));
            int ci2 = 0;
            while (ci2 < capNames.len) {
                string cn = capNames.get(ci2);
                string cty = typeToC(varTypes.get(cn), self.analyzed);
                IRNode fa = irFieldAccess(irVar("__env"), cn, true);
                body.push(irVarDecl(cty, cn, fa));
                ci2 = ci2 + 1;
            }
        }

        /* Save/restore managed-scope + return context around the body. */
        Vector<Managed> savedManaged = self.managedStack;
        Vector<int> savedStarts = self.scopeStarts;
        string savedRetC = self.currentReturnCType;
        self.managedStack = [];
        self.scopeStarts = [];
        self.currentReturnCType = retC;

        /* varTypes for the lambda body: the captured vars + the lambda params
         * (captures are unpacked as locals; params are bound). Start from the
         * enclosing varTypes so types resolve, then add params. */
        Map<string, Node> bodyVars = {};
        Vector<string> evk = varTypes.keys();
        int ek = 0;
        while (ek < evk.len) {
            string vn = evk.get(ek);
            bodyVars.put(vn, varTypes.get(vn));
            ek = ek + 1;
        }
        int p3 = 0;
        while (p3 < node.params.len) {
            Node pp = node.params.get(p3);
            if (pp.type != null) { bodyVars.put(pp.name, pp.type); }
            p3 = p3 + 1;
        }

        Node lb = node.body_node;
        if (lb != null && lb.kind == NK_LAMBDA_BLOCK && lb.body_node != null) {
            IRNode blk = self.lowerBlock(lb.body_node, bodyVars);
            int b = 0;
            while (b < blk.stmts.len) { body.push(blk.stmts.get(b)); b = b + 1; }
        } else if (lb != null && lb.kind == NK_LAMBDA_EXPR_BODY && lb.expression != null) {
            IRNode rexpr = self.lowerExpr(lb.expression, bodyVars);
            body.push(irReturn(rexpr));
        }

        self.managedStack = savedManaged;
        self.scopeStarts = savedStarts;
        self.currentReturnCType = savedRetC;

        fn.body = irBlock(body);
        self.curModule.functions.push(fn);

        /* Link this lambda to a following var-decl env allocation. */
        self.lastLambdaId = lambdaId;
        return irRawExpr(fnName);
    }

    /* True when a TypeExpr is a primitive scalar that must be boxed into a void*
     * thread/mutex slot via the (void*)(intptr_t) cast chain (mirrors the
     * _PRIMITIVE_TYPES set in threads.py / methods.py). */
    public bool isThreadPrimitive(Node? t) {
        if (t == null) { return false; }
        if (t.generic_args.len > 0) { return false; }
        string b = t.base;
        return b == "int" || b == "float" || b == "double" || b == "char"
            || b == "bool" || b == "short" || b == "long";
    }

    /* Box a lowered result value into a void* for a thread wrapper return.
     * Primitive -> (void*)(intptr_t)(expr); void -> NULL; pointer -> (void*)(expr).
     * Mirrors threads._box_result. retType is the lambda's resolved return type
     * (null/void => NULL). */
    public IRNode boxThreadResult(IRNode? expr, Node? retType) {
        if (expr == null || retType == null || retType.base == "void") {
            return irLiteral("NULL");
        }
        if (self.isThreadPrimitive(retType)) {
            return irCast("void*", irCast("intptr_t", expr));
        }
        return irCast("void*", expr);
    }

    /* Lower a spawn(lambda) expression to a lifted pthread wrapper function
     * (void*(*)(void*)) plus a __btrc_thread_spawn call. Returns the thread
     * handle (__btrc_thread_t*). Mirrors ir/gen/threads.lower_spawn. */
    public IRNode lowerSpawn(Node node, Map<string, Node> varTypes) {
        self.useHelper("__btrc_thread_spawn");
        Node fn = node.fn;
        /* Non-lambda spawn: treat the operand as a function pointer value. */
        if (fn == null || fn.kind != NK_LAMBDA_EXPR) {
            IRNode fnExpr = self.lowerExpr(fn, varTypes);
            Vector<IRNode> sargs = [];
            sargs.push(irRawExpr("(void*(*)(void*))" + irExprText(fnExpr)));
            sargs.push(irLiteral("NULL"));
            return irCall("__btrc_thread_spawn", sargs);
        }

        int spawnId = self.freshLambdaId();
        string wrapperName = "__btrc_spawn_wrapper_" + Strings.fromInt(spawnId);
        string envName = "__btrc_spawn_env_" + Strings.fromInt(spawnId);

        /* Resolve the lambda's return type (for boxing). */
        Node fpt = lambdaFnPtrType(fn, self.analyzed, varTypes);
        Node? retType = null;
        if (fn.return_type != null) { retType = fn.return_type; }
        else if (fpt.generic_args.len > 0) { retType = fpt.generic_args.get(0); }
        string retC = typeToC(retType, self.analyzed);

        Vector<string> capNames = self.lambdaCaptureNames(fn, varTypes);
        bool hasCaptures = capNames.len > 0;

        /* Capture-env struct (one field per captured variable). */
        if (hasCaptures) {
            IRStructDef sd = IRStructDef();
            sd.name = envName;
            int ci = 0;
            while (ci < capNames.len) {
                string cn = capNames.get(ci);
                string cty = typeToC(varTypes.get(cn), self.analyzed);
                sd.fields.push(IRStructField(cty, cn));
                ci = ci + 1;
            }
            self.curModule.struct_defs.push(sd);
        }

        /* --- Build the wrapper: void* wrapper(void* __arg) --- */
        IRFunction wfn = IRFunction();
        wfn.name = wrapperName;
        wfn.is_static = true;
        wfn.return_type = "void*";
        wfn.params.push(IRParam("void*", "__arg"));

        Vector<IRNode> wbody = [];
        if (hasCaptures) {
            IRNode envCast = irCast("struct " + envName + "*", irVar("__arg"));
            wbody.push(irVarDecl("struct " + envName + "*", "__env", envCast));
            int ci2 = 0;
            while (ci2 < capNames.len) {
                string cn = capNames.get(ci2);
                string cty = typeToC(varTypes.get(cn), self.analyzed);
                IRNode fa = irFieldAccess(irVar("__env"), cn, true);
                wbody.push(irVarDecl(cty, cn, fa));
                ci2 = ci2 + 1;
            }
        }

        /* Capture cleanup (ARC release of class captures + free env). */
        Vector<IRNode> cleanup = self.spawnCaptureCleanup(fn, capNames, varTypes);

        /* Lower the lambda body in an isolated ARC/return context. */
        Vector<Managed> savedManaged = self.managedStack;
        Vector<int> savedStarts = self.scopeStarts;
        string savedRetC = self.currentReturnCType;
        self.managedStack = [];
        self.scopeStarts = [];
        self.currentReturnCType = retC;

        Map<string, Node> bodyVars = {};
        Vector<string> evk = varTypes.keys();
        int ek = 0;
        while (ek < evk.len) {
            string vn = evk.get(ek);
            bodyVars.put(vn, varTypes.get(vn));
            ek = ek + 1;
        }
        int p3 = 0;
        while (p3 < fn.params.len) {
            Node pp = fn.params.get(p3);
            if (pp.type != null) { bodyVars.put(pp.name, pp.type); }
            p3 = p3 + 1;
        }

        Node lb = fn.body_node;
        if (lb != null && lb.kind == NK_LAMBDA_BLOCK && lb.body_node != null) {
            IRNode blk = self.lowerBlock(lb.body_node, bodyVars);
            Vector<IRNode> lowered = [];
            int b = 0;
            while (b < blk.stmts.len) {
                lowered.push(self.rewriteThreadReturn(blk.stmts.get(b), retType));
                b = b + 1;
            }
            /* If the body ends in a return and we have cleanup, save the result,
             * run cleanup, then return it (mirrors threads._build_wrapper_body). */
            if (cleanup.len > 0 && lowered.len > 0
                    && lowered.get(lowered.len - 1).kind == IRK_RETURN) {
                IRNode finalRet = lowered.pop();
                int li = 0;
                while (li < lowered.len) { wbody.push(lowered.get(li)); li = li + 1; }
                IRNode rv = irLiteral("NULL");
                if (finalRet.value != null) { rv = finalRet.value; }
                wbody.push(irVarDecl("void*", "__result", rv));
                int cli = 0;
                while (cli < cleanup.len) { wbody.push(cleanup.get(cli)); cli = cli + 1; }
                wbody.push(irReturn(irVar("__result")));
            } else {
                int li = 0;
                while (li < lowered.len) { wbody.push(lowered.get(li)); li = li + 1; }
            }
        } else if (lb != null && lb.kind == NK_LAMBDA_EXPR_BODY && lb.expression != null) {
            IRNode rexpr = self.lowerExpr(lb.expression, bodyVars);
            IRNode boxed = self.boxThreadResult(rexpr, retType);
            if (cleanup.len > 0) {
                wbody.push(irVarDecl("void*", "__result", boxed));
                int cli = 0;
                while (cli < cleanup.len) { wbody.push(cleanup.get(cli)); cli = cli + 1; }
                wbody.push(irReturn(irVar("__result")));
            } else {
                wbody.push(irReturn(boxed));
            }
        }

        self.managedStack = savedManaged;
        self.scopeStarts = savedStarts;
        self.currentReturnCType = savedRetC;

        /* Ensure the wrapper always returns void* (cleanup first when present). */
        if (wbody.len == 0 || wbody.get(wbody.len - 1).kind != IRK_RETURN) {
            int cli = 0;
            while (cli < cleanup.len) { wbody.push(cleanup.get(cli)); cli = cli + 1; }
            wbody.push(irReturn(irLiteral("NULL")));
        }

        wfn.body = irBlock(wbody);
        self.curModule.functions.push(wfn);

        /* --- Build the spawn call --- */
        IRNode fnPtr = irRawExpr("(void*(*)(void*))" + wrapperName);
        if (!hasCaptures) {
            Vector<IRNode> sargs = [];
            sargs.push(fnPtr);
            sargs.push(irLiteral("NULL"));
            return irCall("__btrc_thread_spawn", sargs);
        }
        /* Capturing: allocate + populate the env struct via an IRStmtExpr, then
         * spawn with (void*)env. */
        string seVar = "__se" + Strings.fromInt(spawnId);
        Vector<IRNode> setup = [];
        IRNode mallocCall = irCall("malloc", self.sizeofArgs("struct " + envName));
        IRNode envInit = irCast("struct " + envName + "*", mallocCall);
        setup.push(irVarDecl("struct " + envName + "*", seVar, envInit));
        int cpi = 0;
        while (cpi < capNames.len) {
            string cn = capNames.get(cpi);
            IRNode tgt = irFieldAccess(irVar(seVar), cn, true);
            setup.push(irAssign(tgt, irVar(cn)));
            /* ARC: keep captured class instances alive until the thread finishes
             * (paired with the release in the wrapper cleanup). */
            Node? ct = varTypes.get(cn);
            if (ct != null && self.analyzed.isClass(ct.base) && ct.generic_args.len == 0) {
                IRNode rcInc = irUnaryOp("++", irFieldAccess(irVar(cn), "__rc", true), false);
                Vector<IRNode> incStmts = [];
                incStmts.push(irExprStmt(rcInc));
                setup.push(irIf(irVar(cn), irBlock(incStmts), null));
            }
            cpi = cpi + 1;
        }
        Vector<IRNode> sargs2 = [];
        sargs2.push(fnPtr);
        sargs2.push(irCast("void*", irVar(seVar)));
        IRNode spawnCall = irCall("__btrc_thread_spawn", sargs2);
        return irStmtExpr(setup, spawnCall);
    }

    /* sizeof(<type>) argument list for malloc (a single IRSizeof). */
    public Vector<IRNode> sizeofArgs(string typeText) {
        Vector<IRNode> a = [];
        a.push(irSizeof(typeText));
        return a;
    }

    /* Build capture-cleanup statements for a spawn wrapper: ARC release each
     * class-typed capture, then free the env struct. Mirrors
     * threads._build_capture_cleanup. */
    public Vector<IRNode> spawnCaptureCleanup(Node fn, Vector<string> capNames,
                                              Map<string, Node> varTypes) {
        Vector<IRNode> out = [];
        if (capNames.len == 0) { return out; }
        int i = 0;
        while (i < capNames.len) {
            string cn = capNames.get(i);
            Node? ct = varTypes.get(cn);
            if (ct != null && self.analyzed.isClass(ct.base) && ct.generic_args.len == 0) {
                /* if (cn != NULL) { if ((--cn->__rc) <= 0) { Cls_destroy(cn); } } */
                IRNode rcDec = irUnaryOp("--", irFieldAccess(irVar(cn), "__rc", true), true);
                IRNode cmp = irBinOp(rcDec, "<=", irLiteral("0"));
                Vector<IRNode> dargs = [];
                dargs.push(irVar(cn));
                Vector<IRNode> innerStmts = [];
                innerStmts.push(irExprStmt(irCall(ct.base + "_destroy", dargs)));
                IRNode innerIf = irIf(cmp, irBlock(innerStmts), null);
                Vector<IRNode> outerStmts = [];
                outerStmts.push(innerIf);
                IRNode notNull = irBinOp(irVar(cn), "!=", irLiteral("NULL"));
                out.push(irIf(notNull, irBlock(outerStmts), null));
            }
            i = i + 1;
        }
        Vector<IRNode> fargs = [];
        fargs.push(irVar("__env"));
        out.push(irExprStmt(irCall("free", fargs)));
        return out;
    }

    /* Rewrite an IRReturn inside a thread wrapper body to box the return value
     * into void*. Non-return statements pass through unchanged (the wrapper body
     * is flat — returns are top-level, matching the simple lambda bodies in the
     * thread test corpus). Mirrors threads._rewrite_return. */
    public IRNode rewriteThreadReturn(IRNode stmt, Node? retType) {
        if (stmt.kind == IRK_RETURN) {
            IRNode? v = null;
            if (stmt.value != null) { v = stmt.value; }
            return irReturn(self.boxThreadResult(v, retType));
        }
        return stmt;
    }

    /* Lower a Thread<T> method call. .join() -> __btrc_thread_join(obj) with the
     * void* result cast back to T (intptr-unboxed for primitives). Mirrors
     * methods._lower_thread_method. */
    public IRNode lowerThreadMethod(IRNode obj, string method, Node ot) {
        if (method == "join") {
            self.useHelper("__btrc_thread_join");
            Vector<IRNode> jargs = [];
            jargs.push(obj);
            IRNode joinCall = irCall("__btrc_thread_join", jargs);
            Node? ret = null;
            if (ot.generic_args.len > 0) { ret = ot.generic_args.get(0); }
            if (ret == null || ret.base == "void") { return joinCall; }
            string cty = typeToC(ret, self.analyzed);
            if (self.isThreadPrimitive(ret)) {
                return irCast(cty, irCast("intptr_t", joinCall));
            }
            return irCast(cty, joinCall);
        }
        /* Unknown Thread method: fall back to __btrc_thread_<method>(obj). */
        Vector<IRNode> fargs = [];
        fargs.push(obj);
        return irCall("__btrc_thread_" + method, fargs);
    }

    /* Lower a Mutex<T> method call: .get() unboxes the stored void*; .set(v) boxes
     * the value; .destroy() tears down the mutex. Mirrors methods._lower_mutex_method. */
    public IRNode lowerMutexMethod(IRNode obj, string method, Node ot,
                                   Vector<IRNode> args) {
        Node? valType = null;
        if (ot.generic_args.len > 0) { valType = ot.generic_args.get(0); }
        if (method == "get") {
            self.useHelper("__btrc_mutex_val_get");
            Vector<IRNode> gargs = [];
            gargs.push(obj);
            IRNode getCall = irCall("__btrc_mutex_val_get", gargs);
            if (self.isThreadPrimitive(valType)) {
                string cty = typeToC(valType, self.analyzed);
                return irCast(cty, irCast("intptr_t", getCall));
            }
            if (valType != null) {
                return irCast(typeToC(valType, self.analyzed), getCall);
            }
            return getCall;
        }
        if (method == "set") {
            self.useHelper("__btrc_mutex_val_set");
            Vector<IRNode> sargs = [];
            sargs.push(obj);
            if (args.len > 0) {
                if (self.isThreadPrimitive(valType)) {
                    sargs.push(irCast("void*", irCast("intptr_t", args.get(0))));
                } else {
                    sargs.push(irCast("void*", args.get(0)));
                }
            }
            return irCall("__btrc_mutex_val_set", sargs);
        }
        if (method == "destroy") {
            self.useHelper("__btrc_mutex_val_destroy");
            Vector<IRNode> dargs = [];
            dargs.push(obj);
            return irCall("__btrc_mutex_val_destroy", dargs);
        }
        /* Unknown Mutex method: fall back to __btrc_mutex_val_<method>(obj, ...). */
        Vector<IRNode> fargs = [];
        fargs.push(obj);
        int i = 0;
        while (i < args.len) { fargs.push(args.get(i)); i = i + 1; }
        return irCall("__btrc_mutex_val_" + method, fargs);
    }

    /* Lower Mutex(val) -> __btrc_mutex_val_create(boxed_val). `args` are the
     * pre-lowered call arguments. Mirrors calls._lower_mutex_constructor. */
    public IRNode lowerMutexConstructor(Node node, Vector<IRNode> args,
                                        Map<string, Node> varTypes) {
        self.useHelper("__btrc_mutex_val_create");
        if (node.args.len == 0) {
            Vector<IRNode> nargs = [];
            nargs.push(irLiteral("NULL"));
            return irCall("__btrc_mutex_val_create", nargs);
        }
        Node? argType = inferType(node.args.get(0), self.analyzed, varTypes);
        IRNode boxed = irCast("void*", args.get(0));
        if (self.isThreadPrimitive(argType)) {
            boxed = irCast("void*", irCast("intptr_t", args.get(0)));
        }
        Vector<IRNode> cargs = [];
        cargs.push(boxed);
        return irCall("__btrc_mutex_val_create", cargs);
    }

    public IRNode lowerBinary(Node node, Map<string, Node> varTypes) {
        IRNode left = self.lowerExpr(node.left, varTypes);
        IRNode right = self.lowerExpr(node.right, varTypes);
        string op = node.op;
        /* Generic-method bodies lower operators raw (mirrors user_emitter._expr):
         * no div/mod/concat helpers, no operator overloading. */
        if (self.inGenericMethod) {
            return irBinOp(left, op, right);
        }
        Node lt = inferType(node.left, self.analyzed, varTypes);
        Node rt = inferType(node.right, self.analyzed, varTypes);

        /* String concat: a + b -> __btrc_str_track(__btrc_strcat(a, b)). */
        if (op == "+" && typeIsString(lt) && typeIsString(rt)) {
            self.useHelper("__btrc_strcat");
            self.useHelper("__btrc_str_track");
            Vector<IRNode> catArgs = [];
            catArgs.push(left);
            catArgs.push(right);
            IRNode cat = irCall("__btrc_strcat", catArgs);
            Vector<IRNode> trackArgs = [];
            trackArgs.push(cat);
            return irCall("__btrc_str_track", trackArgs);
        }
        /* String comparison: a == b -> strcmp(a, b) == 0. */
        if ((op == "==" || op == "!=") && typeIsString(lt) && typeIsString(rt)) {
            Vector<IRNode> cmpArgs = [];
            cmpArgs.push(left);
            cmpArgs.push(right);
            IRNode cmp = irCall("strcmp", cmpArgs);
            return irBinOp(cmp, op, irLiteral("0"));
        }
        /* Division: a / b -> helper. */
        if (op == "/" && typeIsNumeric(lt)) {
            Vector<IRNode> dargs = [];
            dargs.push(left);
            dargs.push(right);
            if (typeIsFloatLike(lt)) {
                self.useHelper("__btrc_div_double");
                return irCall("__btrc_div_double", dargs);
            }
            self.useHelper("__btrc_div_int");
            return irCall("__btrc_div_int", dargs);
        }
        /* Modulo: a % b -> helper. */
        if (op == "%" && typeIsNumeric(lt)) {
            Vector<IRNode> margs = [];
            margs.push(left);
            margs.push(right);
            self.useHelper("__btrc_mod_int");
            return irCall("__btrc_mod_int", margs);
        }
        /* Null coalescing: a ?? b -> ({ T __nc = a; __nc != NULL ? __nc : b; }).
         * The temp avoids evaluating `a` twice (mirrors operators.lower_binary_op
         * "??" branch). c_type is the left operand's type, else void*. */
        if (op == "??") {
            string tmp = self.freshTemp("__nc");
            string ct = "void*";
            if (lt != null) { ct = typeToC(lt, self.analyzed); }
            Vector<IRNode> ncStmts = [];
            ncStmts.push(irVarDecl(ct, tmp, left));
            IRNode ncCond = irBinOp(irVar(tmp), "!=", irLiteral("NULL"));
            return irStmtExpr(ncStmts, irTernary(ncCond, irVar(tmp), right));
        }
        /* Operator overloading: a OP b -> ClassName_magic(a, b) when the left
         * operand is a class type defining the magic method. */
        if (lt != null && self.analyzed.isClass(lt.base)) {
            string magic = binaryOpMagic(op);
            if (magic != "") {
                Node? mm = self.analyzed.classMember(lt.base, magic);
                if (mm != null && mm.kind == NK_METHOD_DECL) {
                    Vector<IRNode> oargs = [];
                    oargs.push(left);
                    oargs.push(right);
                    return irCall(lt.base + "_" + magic, oargs);
                }
            }
        }
        return irBinOp(left, op, right);
    }

    public IRNode lowerUnary(Node node, Map<string, Node> varTypes) {
        IRNode operand = self.lowerExpr(node.operand, varTypes);
        string op = node.op;
        if (op == "&") { return irAddressOf(operand); }
        if (op == "*") { return irDeref(operand); }
        /* Operator overloading: -obj -> ClassName___neg__(obj) for a class with
         * a __neg__ method. */
        if (op == "-" && node.prefix) {
            Node? ot = inferType(node.operand, self.analyzed, varTypes);
            if (ot != null && self.analyzed.isClass(ot.base)) {
                Node? mm = self.analyzed.classMember(ot.base, "__neg__");
                if (mm != null && mm.kind == NK_METHOD_DECL) {
                    Vector<IRNode> nargs = [];
                    nargs.push(operand);
                    return irCall(ot.base + "___neg__", nargs);
                }
            }
        }
        return irUnaryOp(op, operand, node.prefix);
    }

    public IRNode lowerSizeof(Node node, Map<string, Node> varTypes) {
        Node operand = node.operand;
        if (operand != null && operand.kind == NK_SIZEOF_TYPE) {
            return irSizeof(typeToC(self.resolveBodyType(operand.type), self.analyzed));
        }
        if (operand != null && operand.kind == NK_SIZEOF_EXPR_OP) {
            IRNode inner = self.lowerExpr(operand.expr, varTypes);
            return irSizeof(irExprText(inner));
        }
        return irSizeof("void");
    }

    /* Lower [a, b, c] -> ({ T* __tmp = T_new(); T_push(__tmp, a); ...; __tmp;})
     * as an IRStmtExpr (mirrors collections.lower_list_literal). `expected` is the
     * declared element-collection type when known (from the var decl), else the
     * mangled type is inferred from the first element. */
    public IRNode lowerListLiteral(Node node, Map<string, Node> varTypes, Node? expected) {
        string mangled = "btrc_Vector_int";
        if (expected != null && expected.generic_args.len > 0) {
            mangled = mangleGenericType(expected.base, expected.generic_args);
        } else if (node.elements.len > 0) {
            Node? et = inferType(node.elements.get(0), self.analyzed, varTypes);
            if (et != null) {
                Node vt = makePrimType("Vector");
                Vector<Node> ga = [];
                ga.push(et);
                vt.generic_args = ga;
                /* Class element types must be upgraded to pointers so the inferred
                 * mangle matches the registered instance (`btrc_Vector_GraphNode_p1`,
                 * not `btrc_Vector_GraphNode`). */
                upgradeTypeGenericArgs(vt, self.analyzed);
                mangled = mangleGenericType("Vector", vt.generic_args);
            }
        }
        string tmp = self.freshTemp("__list");
        Vector<IRNode> stmts = [];
        Vector<IRNode> newArgs = [];
        stmts.push(irVarDecl(mangled + "*", tmp, irCall(mangled + "_new", newArgs)));
        int i = 0;
        while (i < node.elements.len) {
            IRNode el = self.lowerExpr(node.elements.get(i), varTypes);
            Vector<IRNode> pargs = [];
            pargs.push(irVar(tmp));
            pargs.push(el);
            stmts.push(irExprStmt(irCall(mangled + "_push", pargs)));
            i = i + 1;
        }
        return irStmtExpr(stmts, irVar(tmp));
    }

    /* Lower a tuple literal `(a, b, ...)` to a C compound literal
     * `(btrc_Tuple_T0_T1){._0 = a, ._1 = b, ...}` (mirrors
     * expressions._lower_tuple). The struct name is mangled from the inferred
     * element types; an element whose type can't be inferred falls back to
     * `int`, matching the Python fallback path. */
    public IRNode lowerTupleLiteral(Node node, Map<string, Node> varTypes) {
        Vector<Node> elemTypes = [];
        int i = 0;
        while (i < node.elements.len) {
            Node? et = inferType(node.elements.get(i), self.analyzed, varTypes);
            if (et == null) {
                Node fallback = Node();
                fallback.kind = NK_TYPE_EXPR;
                fallback.base = "int";
                elemTypes.push(fallback);
            } else {
                elemTypes.push(et);
            }
            i = i + 1;
        }
        /* Class/generic element types must be upgraded to pointers so the
         * inferred mangle matches the synthesized tuple struct + declared var
         * type (`btrc_Tuple_string_Vector_int_p1`, not
         * `btrc_Tuple_string_Vector_int`). Mirrors the list-literal path above
         * and Python's _lower_tuple, which mangles the node's (already
         * pointer-upgraded) declared type. */
        Node tt = makePrimType("Tuple");
        tt.generic_args = elemTypes;
        upgradeTypeGenericArgs(tt, self.analyzed);
        string mangled = mangleGenericType("Tuple", tt.generic_args);
        Vector<IRNode> elems = [];
        int j = 0;
        while (j < node.elements.len) {
            elems.push(self.lowerExpr(node.elements.get(j), varTypes));
            j = j + 1;
        }
        return irTupleLiteral(mangled, elems);
    }

    /* Lower {k: v, ...} -> Map_new() + put calls (mirrors lower_map_literal).
     * Empty map literal lowers to a bare Map_new() call. */
    public IRNode lowerMapLiteral(Node node, Map<string, Node> varTypes, Node? expected) {
        string mangled = "btrc_Map_string_int";
        if (expected != null && expected.generic_args.len > 0) {
            mangled = mangleGenericType(expected.base, expected.generic_args);
        } else if (node.entries.len > 0) {
            Node ent0 = node.entries.get(0);
            Node? kt = inferType(ent0.key, self.analyzed, varTypes);
            Node? vt = inferType(ent0.value_node, self.analyzed, varTypes);
            if (kt != null && vt != null) {
                Node mt = makePrimType("Map");
                Vector<Node> ga = [];
                ga.push(kt);
                ga.push(vt);
                mt.generic_args = ga;
                /* Class key/value types upgrade to pointers so the mangle matches
                 * the registered instance (e.g. `btrc_Map_int_OwnedItem_p1`). */
                upgradeTypeGenericArgs(mt, self.analyzed);
                mangled = mangleGenericType("Map", mt.generic_args);
            }
        }
        if (node.entries.len == 0) {
            Vector<IRNode> newArgs = [];
            return irCall(mangled + "_new", newArgs);
        }
        string tmp = self.freshTemp("__map");
        Vector<IRNode> stmts = [];
        Vector<IRNode> newArgs = [];
        stmts.push(irVarDecl(mangled + "*", tmp, irCall(mangled + "_new", newArgs)));
        int i = 0;
        while (i < node.entries.len) {
            Node ent = node.entries.get(i);
            IRNode k = self.lowerExpr(ent.key, varTypes);
            IRNode v = self.lowerExpr(ent.value_node, varTypes);
            Vector<IRNode> pargs = [];
            pargs.push(irVar(tmp));
            pargs.push(k);
            pargs.push(v);
            stmts.push(irExprStmt(irCall(mangled + "_put", pargs)));
            i = i + 1;
        }
        return irStmtExpr(stmts, irVar(tmp));
    }

    /* Lower a brace initializer (mirrors expressions.lower_expr BraceInitializer):
     * empty {} with a known generic-collection expected type -> mangled_new();
     * empty {} otherwise -> NULL; non-empty -> {e1, e2, ...} raw expr. */
    public IRNode lowerBraceInit(Node node, Map<string, Node> varTypes, Node? expected) {
        if (node.elements.len == 0) {
            if (expected != null && expected.generic_args.len > 0
                    && self.analyzed.isGenericClass(expected.base)) {
                string mangled = mangleGenericType(expected.base, expected.generic_args);
                Vector<IRNode> newArgs = [];
                return irCall(mangled + "_new", newArgs);
            }
            return irLiteral("NULL");
        }
        string text = "{";
        int i = 0;
        while (i < node.elements.len) {
            if (i > 0) { text = text + ", "; }
            text = text + irExprText(self.lowerExpr(node.elements.get(i), varTypes));
            i = i + 1;
        }
        text = text + "}";
        return irRawExpr(text);
    }

    /* Coerce a single ordered arg into its parameter's string type when the
     * source AST node is a class with toString() (mirrors stringable.
     * coerce_to_string_param). `srcNode` is the source AST arg (a written arg or
     * a param default), used to infer the value's type. */
    public IRNode coerceArgToParam(Node param, Node? srcNode, IRNode value,
            Map<string, Node> varTypes) {
        if (srcNode == null) { return value; }
        Node? srcType = inferType(srcNode, self.analyzed, varTypes);
        return self.coerceToString(param.type, srcType, value);
    }

    /* Return IR args in parameter order, filling omitted defaults (mirrors
     * arguments.order_args_for_params). `params` are Param Nodes (with .name /
     * .default_); `irArgs` are the already-lowered call args in source order;
     * `argNames` are the written keyword names ("" for positional). Positional-
     * only calls keep order and append trailing defaults; named calls expand to
     * the full declared parameter list and may skip optional middle params.
     * Applies the reference's coerce_to_string_param step per slot: when a
     * parameter's type is `string` and the supplying arg (written or default)
     * is a class with a no-arg toString()->string, the arg is wrapped in
     * <Class>_toString(...) (mirrors arguments.order_args_for_params). */
    public Vector<IRNode> orderArgsForParams(Vector<Node> params,
            Vector<string> argNames, Vector<IRNode> irArgs,
            Vector<Node> astArgs, Map<string, Node> varTypes) {
        if (params.len == 0) { return irArgs; }
        /* Pad names to the number of written args. */
        Vector<string> names = [];
        int ni = 0;
        while (ni < irArgs.len) {
            if (ni < argNames.len) { names.push(argNames.get(ni)); }
            else { names.push(""); }
            ni = ni + 1;
        }
        /* Any named args present? */
        bool anyNamed = false;
        int an = 0;
        while (an < names.len) {
            if (names.get(an) != "") { anyNamed = true; }
            an = an + 1;
        }
        /* Positional-only fast path: keep order, append trailing defaults. */
        if (!anyNamed) {
            Vector<IRNode> result = [];
            int k = 0;
            while (k < irArgs.len) {
                IRNode av = irArgs.get(k);
                if (k < params.len && k < astArgs.len) {
                    Node? st = inferType(astArgs.get(k), self.analyzed, varTypes);
                    av = self.coerceToString(params.get(k).type, st, av);
                }
                result.push(av);
                k = k + 1;
            }
            int idx = result.len;
            while (idx < params.len) {
                Node pp = params.get(idx);
                if (pp.default_ != null) {
                    IRNode dv = self.lowerExpr(pp.default_, varTypes);
                    Node? dt = inferType(pp.default_, self.analyzed, varTypes);
                    result.push(self.coerceToString(pp.type, dt, dv));
                } else {
                    result.push(irLiteral("0"));
                }
                idx = idx + 1;
            }
            return result;
        }
        /* Named path: resolve which written arg fills each parameter slot, then
         * build the result in declared order. We map param index -> written-arg
         * index (or -1 for "use the default"). A parallel int Vector is used
         * instead of an IRNode slot Vector because Vector<IRNode>.push rejects
         * null (it bumps the element's refcount), so null placeholders aren't
         * safe; ints are. */
        Map<string, int> paramIndices = {};
        int pi = 0;
        while (pi < params.len) {
            paramIndices.put(params.get(pi).name, pi);
            pi = pi + 1;
        }
        Vector<int> slotArg = [];
        int s = 0;
        while (s < params.len) { slotArg.push(-1); s = s + 1; }
        int positional = 0;
        int ai = 0;
        while (ai < irArgs.len) {
            string nm = names.get(ai);
            if (nm != "") {
                if (paramIndices.has(nm)) {
                    slotArg.set(paramIndices.get(nm), ai);
                }
            } else if (positional < params.len) {
                slotArg.set(positional, ai);
                positional = positional + 1;
            }
            ai = ai + 1;
        }
        Vector<IRNode> out = [];
        int o = 0;
        while (o < params.len) {
            Node pp = params.get(o);
            int src = slotArg.get(o);
            if (src >= 0) {
                IRNode av = irArgs.get(src);
                if (src < astArgs.len) {
                    Node? st = inferType(astArgs.get(src), self.analyzed, varTypes);
                    av = self.coerceToString(pp.type, st, av);
                }
                out.push(av);
            } else {
                if (pp.default_ != null) {
                    IRNode dv = self.lowerExpr(pp.default_, varTypes);
                    Node? dt = inferType(pp.default_, self.analyzed, varTypes);
                    out.push(self.coerceToString(pp.type, dt, dv));
                } else {
                    out.push(irLiteral("0"));
                }
            }
            o = o + 1;
        }
        return out;
    }

    public IRNode lowerCall(Node node, Map<string, Node> varTypes) {
        Node callee = node.callee;
        if (callee != null && callee.kind == NK_IDENTIFIER) {
            string name = callee.name;
            /* Pre-lower every argument (mirrors calls.py line 50:
             * `args = lower_arg_values(...)` runs unconditionally, before the
             * print/constructor/builtin dispatch). For print and constructor
             * calls this result is discarded and the args re-lowered, but the
             * temp counter advances either way — so doing it here keeps fresh
             * temp numbering byte-identical. */
            Vector<IRNode> args = self.lowerArgs(node, varTypes);
            /* Mutex(val) constructor -> __btrc_mutex_val_create(boxed_val)
             * (mirrors calls._lower_mutex_constructor). Boxes a primitive initial
             * value through (void*)(intptr_t); class/other values via (void*).
             * Checked before the user-class constructor branch. */
            if (name == "Mutex" && !self.analyzed.funcNames.has(name)
                    && !self.analyzed.isClass(name)) {
                return self.lowerMutexConstructor(node, args, varTypes);
            }
            /* Constructor call X(...) -> X_new(args) (mirrors variables: a
             * non-generic class name as callee is a constructor). Fill omitted
             * defaults / order named args from the constructor's params
             * (mirrors calls._lower_constructor_call). */
            if (self.analyzed.isClass(name)) {
                Vector<IRNode> cargs = self.lowerArgs(node, varTypes);
                Node? ctor = self.analyzed.classConstructor(name);
                if (ctor != null && ctor.params.len > 0) {
                    cargs = self.orderArgsForParams(
                        ctor.params, node.arg_names, cargs, node.args, varTypes);
                }
                return irCall(name + "_new", cargs);
            }
            /* Built-ins apply only when no user function shadows the name. */
            if (!self.analyzed.funcNames.has(name)) {
                if (name == "print") { return self.lowerPrint(node, varTypes); }
                if (name == "printf") {
                    return irCall("printf", args);
                }
                if (name == "sizeof") {
                    if (node.args.len > 0) {
                        return irSizeof(irExprText(args.get(0)));
                    }
                    return irSizeof("void");
                }
                /* len(s): strlen on a string arg, else x->len (collection). */
                if (name == "len" && node.args.len > 0) {
                    Node? at = inferType(node.args.get(0), self.analyzed, varTypes);
                    if (isStringType(at)) {
                        Vector<IRNode> la = [];
                        la.push(args.get(0));
                        return irCast("int", irCall("strlen", la));
                    }
                    return irFieldAccess(args.get(0), "len", true);
                }
            }
            /* Captured-lambda call: bypass the function pointer and call the
             * lifted impl directly, with &env as the trailing void* argument.
             * Mirrors calls.py's _fn_ptr_envs branch. */
            if (self.fnPtrEnvFn.has(name)) {
                string implFn = self.fnPtrEnvFn.get(name);
                string envVar = self.fnPtrEnvVar.get(name);
                args.push(irCast("void*", irRawExpr("&" + envVar)));
                return irCall(implFn, args);
            }
            /* Fill omitted trailing parameters with their default values and
             * order any named args (mirrors calls._fill_defaults ->
             * order_args_for_params). */
            if (self.analyzed.funcTable.has(name)) {
                Node fnDecl = self.analyzed.funcTable.get(name);
                if (fnDecl.params.len > 0) {
                    args = self.orderArgsForParams(
                        fnDecl.params, node.arg_names, args, node.args, varTypes);
                }
            }
            return irCall(name, args);
        }
        if (callee != null && callee.kind == NK_FIELD_ACCESS_EXPR) {
            return self.lowerMethodCall(node, varTypes);
        }
        print("irgen: unsupported call callee");
        abortGen();
        return irLiteral("0");
    }

    /* Lower obj.method(args) (mirrors methods.lower_method_call, class subset).
     * Static: ClassName.method(args) -> ClassName_method(args).
     * Instance: obj.method(args)    -> ClassType_method(obj, args). */
    public IRNode lowerMethodCall(Node node, Map<string, Node> varTypes) {
        Node fa = node.callee;
        string method = fa.field;
        Node objNode = fa.obj;
        /* Rich enum constructor: Color.RGB(255, 0, 0) -> Color_RGB(255, 0, 0).
         * Mirrors methods.lower_method_call's rich_enum_table branch (checked
         * before the class branch). */
        if (objNode != null && objNode.kind == NK_IDENTIFIER
                && self.analyzed.isRichEnum(objNode.name)) {
            return irCall(objNode.name + "_" + method, self.lowerArgs(node, varTypes));
        }
        /* Static method call on a class name. Order named args / fill defaults
         * from the method's params (mirrors methods.lower_method_call's static
         * branch). */
        if (objNode != null && objNode.kind == NK_IDENTIFIER
                && self.analyzed.isClass(objNode.name)) {
            Vector<IRNode> sargs = self.lowerArgs(node, varTypes);
            Node? sm = self.analyzed.classMember(objNode.name, method);
            if (sm != null && sm.kind == NK_METHOD_DECL && sm.params.len > 0) {
                sargs = self.orderArgsForParams(
                    sm.params, node.arg_names, sargs, node.args, varTypes);
            }
            return irCall(objNode.name + "_" + method, sargs);
        }
        /* Instance method call: dispatch on the object's class. */
        Node? ot = inferType(objNode, self.analyzed, varTypes);
        /* Builtin string instance methods (mirrors methods.lower_method_call's
         * is_string_type branches). Receiver lowered + args lowered first so the
         * fresh-temp counter advances identically. */
        if (isStringType(ot)) {
            IRNode sobj = self.lowerExpr(objNode, varTypes);
            Vector<IRNode> sargs = self.lowerArgs(node, varTypes);
            IRNode? sres = self.lowerStringMethod(sobj, method, sargs);
            if (sres != null) { return sres; }
        }
        /* enum.toString() -> EnumName_toString(val) (mirrors methods.
         * _lower_to_string's enum_table branch). Checked before the generic
         * numeric/bool/char toString fallback. */
        if (method == "toString" && ot != null
                && (self.analyzed.isEnum(ot.base) || self.analyzed.isRichEnum(ot.base))) {
            IRNode eobj = self.lowerExpr(objNode, varTypes);
            Vector<IRNode> eargs = [];
            eargs.push(eobj);
            return irCall(ot.base + "_toString", eargs);
        }
        /* obj.toString() for non-class receivers -> builtin numeric/bool/char
         * conversion (mirrors methods.lower_method_call's toString branch). */
        if (method == "toString" && (ot == null || !self.analyzed.isClass(ot.base))) {
            IRNode tobj = self.lowerExpr(objNode, varTypes);
            return self.lowerToString(tobj, ot);
        }
        /* Thread<T> methods: .join() -> __btrc_thread_join with result unboxing
         * (mirrors methods._lower_thread_method). */
        if (ot != null && ot.base == "Thread" && ot.generic_args.len > 0) {
            IRNode obj = self.lowerExpr(objNode, varTypes);
            return self.lowerThreadMethod(obj, method, ot);
        }
        /* Mutex<T> methods: .get(), .set(v), .destroy() (mirrors
         * methods._lower_mutex_method). */
        if (ot != null && ot.base == "Mutex" && ot.generic_args.len > 0) {
            IRNode obj = self.lowerExpr(objNode, varTypes);
            Vector<IRNode> margs = self.lowerArgs(node, varTypes);
            return self.lowerMutexMethod(obj, method, ot, margs);
        }
        if (ot != null && self.analyzed.isClass(ot.base)) {
            IRNode obj = self.lowerExpr(objNode, varTypes);
            Vector<IRNode> margs = self.lowerArgs(node, varTypes);
            Node? im = self.analyzed.classMember(ot.base, method);
            if (im != null && im.kind == NK_METHOD_DECL && im.params.len > 0) {
                margs = self.orderArgsForParams(
                    im.params, node.arg_names, margs, node.args, varTypes);
            }
            Vector<IRNode> args = [];
            args.push(obj);
            int i = 0;
            while (i < margs.len) {
                args.push(margs.get(i));
                i = i + 1;
            }
            /* Generic method on a non-generic class: dispatch to the
             * monomorphized instance for this call site's method type args. */
            if (im != null && im.kind == NK_METHOD_DECL && im.generic_params.len > 0) {
                string ck = nodeKey(node);
                if (self.analyzed.methodGenCallArgs.has(ck)) {
                    Vector<Node> margTypes = self.analyzed.methodGenCallArgs.get(ck);
                    Vector<Node> noClassArgs = [];
                    string callee = genericMethodInstanceName(
                        ot.base, noClassArgs, method, margTypes);
                    return irCall(callee, args);
                }
            }
            return irCall(ot.base + "_" + method, args);
        }
        /* Instance method call on a generic instance: dispatch via mangled name
         * (mirrors methods.lower_method_call's generic branch). */
        if (ot != null && ot.generic_args.len > 0
                && self.analyzed.isGenericClass(ot.base)) {
            string mangled = mangleGenericType(ot.base, ot.generic_args);
            IRNode obj = self.lowerExpr(objNode, varTypes);
            Vector<IRNode> gmargs = self.lowerArgs(node, varTypes);
            Node? gm = self.analyzed.genericClassMethod(ot.base, method);
            if (gm != null && gm.params.len > 0) {
                gmargs = self.orderArgsForParams(
                    gm.params, node.arg_names, gmargs, node.args, varTypes);
            }
            Vector<IRNode> args = [];
            args.push(obj);
            int i = 0;
            while (i < gmargs.len) {
                args.push(gmargs.get(i));
                i = i + 1;
            }
            /* Generic method on a generic instance: dispatch to the
             * monomorphized instance for the method type args inferred at this
             * call site (e.g. mapTo<string>). Mirrors methods.py's generic
             * method branch. */
            if (gm != null && gm.generic_params.len > 0) {
                string ck = nodeKey(node);
                if (self.analyzed.methodGenCallArgs.has(ck)) {
                    Vector<Node> margTypes = self.analyzed.methodGenCallArgs.get(ck);
                    string callee = genericMethodInstanceName(
                        ot.base, ot.generic_args, method, margTypes);
                    return irCall(callee, args);
                }
            }
            return irCall(mangled + "_" + method, args);
        }
        print("irgen: unsupported method call");
        abortGen();
        return irLiteral("0");
    }

    /* Lower a builtin string instance method (mirrors methods.py:
     * _lower_string_method, _lower_string_special, the STRING_CONVERSIONS and
     * strlen branches). `obj` is the lowered receiver, `args` the lowered args.
     * Returns null if `method` is not a known string method. */
    public IRNode? lowerStringMethod(IRNode obj, string method, Vector<IRNode> args) {
        /* Special-cased: equals -> strcmp(...) == 0; len/length/byteLen -> strlen. */
        if (method == "equals") {
            Vector<IRNode> cargs = [];
            cargs.push(obj);
            int i = 0;
            while (i < args.len) { cargs.push(args.get(i)); i = i + 1; }
            IRNode cmp = irCall("strcmp", cargs);
            return irBinOp(cmp, "==", irLiteral("0"));
        }
        if (method == "len" || method == "length" || method == "byteLen") {
            Vector<IRNode> largs = [];
            largs.push(obj);
            return irCast("int", irCall("strlen", largs));
        }
        /* Conversions to C stdlib (atoi/atof/atol). */
        if (method == "toInt") {
            Vector<IRNode> a = [];
            a.push(obj);
            return irCast("int", irCall("atoi", a));
        }
        if (method == "toFloat") {
            Vector<IRNode> a = [];
            a.push(obj);
            return irCast("float", irCall("atof", a));
        }
        if (method == "toDouble") {
            Vector<IRNode> a = [];
            a.push(obj);
            return irCall("atof", a);
        }
        if (method == "toLong") {
            Vector<IRNode> a = [];
            a.push(obj);
            return irCall("atol", a);
        }
        /* Helper-backed methods: helper(obj, args...), wrapped in __btrc_str_track
         * when the result is a new heap string. */
        string helper = stringMethodHelper(method);
        if (helper == "") { return null; }
        self.useHelper(helper);
        Vector<IRNode> hargs = [];
        hargs.push(obj);
        int j = 0;
        while (j < args.len) { hargs.push(args.get(j)); j = j + 1; }
        IRNode call = irCall(helper, hargs);
        if (stringMethodTracked(method)) {
            self.useHelper("__btrc_str_track");
            Vector<IRNode> targs = [];
            targs.push(call);
            return irCall("__btrc_str_track", targs);
        }
        return call;
    }

    /* Lower obj.toString() for non-class receivers (mirrors methods._lower_to_string).
     * int/long/float/double/char -> __btrc_xToString tracked; bool -> ternary;
     * null type -> __btrc_intToString. */
    public IRNode lowerToString(IRNode obj, Node? ot) {
        if (ot == null) {
            self.useHelper("__btrc_intToString");
            Vector<IRNode> a = [];
            a.push(obj);
            return irCall("__btrc_intToString", a);
        }
        string base = ot.base;
        if (base == "bool") {
            return irTernary(obj, irLiteral("\"true\""), irLiteral("\"false\""));
        }
        string helper = "__btrc_intToString";
        if (base == "long") { helper = "__btrc_longToString"; }
        else if (base == "float") { helper = "__btrc_floatToString"; }
        else if (base == "double") { helper = "__btrc_doubleToString"; }
        else if (base == "char") { helper = "__btrc_charToString"; }
        self.useHelper(helper);
        self.useHelper("__btrc_str_track");
        Vector<IRNode> a = [];
        a.push(obj);
        IRNode call = irCall(helper, a);
        Vector<IRNode> t = [];
        t.push(call);
        return irCall("__btrc_str_track", t);
    }

    /* new X(args) -> X_new(args) (mirrors methods.lower_new_expr, class subset).
     * Generic instance: new C<...>(args) -> btrc_C_T_new(args). */
    public IRNode lowerNew(Node node, Map<string, Node> varTypes) {
        /* Inside a monomorphized generic body, `new ListNode<T>(...)` carries the
         * raw type param T; resolve it through the active type map so the
         * constructor is the concrete `btrc_ListNode_OwnedItem_p1_new`, not the
         * unresolved `btrc_ListNode_T_new`. Mirrors user_emitter resolving the
         * new-expr type via _resolve before mangling. */
        Node newType = node.type;
        if (self.inGenericMethod) { newType = resolveGenericType(newType, self.activeTypeMap); }
        string baseName = node.type.base;
        string typeName = newType.base;
        if (newType.generic_args.len > 0 && self.analyzed.isGenericClass(typeName)) {
            typeName = mangleGenericType(typeName, newType.generic_args);
        }
        Vector<IRNode> args = self.lowerArgs(node, varTypes);
        /* Order named args / fill constructor defaults (mirrors the constructor
         * path; new X(...) shares the same _new signature as X(...)). */
        Node? ctor = self.analyzed.classConstructor(baseName);
        if (ctor == null) {
            ctor = self.analyzed.genericClassMethod(baseName, baseName);
        }
        if (ctor != null && ctor.params.len > 0) {
            args = self.orderArgsForParams(
                ctor.params, node.arg_names, args, node.args, varTypes);
        }
        return irCall(typeName + "_new", args);
    }

    /* Lower field access obj.field (mirrors fields._lower_field_access, class
     * subset). Class-instance and pointer objects use `->`; property access
     * routes through the getter (or backing field for self.prop). */
    public IRNode lowerFieldAccess(Node node, Map<string, Node> varTypes) {
        /* Namespaced enum value: Color.RED -> Color_RED (the qualified form of
         * bare RED). Mirrors fields._lower_field_access's enum_table branch. */
        if (node.obj != null && node.obj.kind == NK_IDENTIFIER
                && self.analyzed.isEnum(node.obj.name)) {
            return irLiteral(node.obj.name + "_" + node.field);
        }
        /* Rich enum variant tag: Color.RGB -> Color_RGB_TAG. Mirrors fields.
         * _lower_field_access's rich_enum_table branch. */
        if (node.obj != null && node.obj.kind == NK_IDENTIFIER
                && self.analyzed.isRichEnum(node.obj.name)) {
            return irVar(node.obj.name + "_" + node.field + "_TAG");
        }
        IRNode obj = self.lowerExpr(node.obj, varTypes);
        Node? ot = inferType(node.obj, self.analyzed, varTypes);
        /* Property access on a class instance. */
        if (ot != null && self.analyzed.isClass(ot.base)
                && self.analyzed.isProperty(ot.base, node.field)) {
            if (node.obj.kind == NK_SELF_EXPR) {
                return irFieldAccess(obj, "_prop_" + node.field, true);
            }
            Vector<IRNode> gargs = [];
            gargs.push(obj);
            return irCall(ot.base + "_get_" + node.field, gargs);
        }
        /* Optional chaining: a?.b -> (a != NULL ? a->b : 0). Mirrors fields.
         * lower_field's node.optional branch. */
        if (node.optional) {
            IRNode access = irFieldAccess(obj, node.field, true);
            IRNode ocCond = irBinOp(obj, "!=", irLiteral("NULL"));
            return irTernary(ocCond, access, irLiteral("0"));
        }
        bool arrow = node.arrow;
        /* Class and generic-class (collection) instances are heap pointers, so a
         * member access on one (e.g. `vec.len` where vec is Vector<int>) is `->`. */
        if (ot != null && (ot.pointer_depth > 0 || self.analyzed.isClass(ot.base)
                || self.analyzed.isGenericClass(ot.base))) {
            arrow = true;
        }
        return irFieldAccess(obj, node.field, arrow);
    }

    public Vector<IRNode> lowerArgs(Node node, Map<string, Node> varTypes) {
        Vector<IRNode> args = [];
        int i = 0;
        while (i < node.args.len) {
            args.push(self.lowerExpr(node.args.get(i), varTypes));
            i = i + 1;
        }
        return args;
    }

    /* Lower an f-string to snprintf-based string building (mirrors
     * fstrings.lower_fstring). Each interpolation is evaluated exactly once into
     * a temp reused by both the measure (snprintf NULL/0) and write passes. */
    public IRNode lowerFString(Node node, Map<string, Node> varTypes) {
        string tmp = self.freshTemp("__fstr");
        string fmt = "";
        Vector<IRNode> argDecls = [];
        Vector<IRNode> args = [];
        int i = 0;
        while (i < node.parts.len) {
            Node part = node.parts.get(i);
            if (part.kind == NK_F_STRING_TEXT) {
                fmt = fmt + replacePercent(part.text);
            } else if (part.kind == NK_F_STRING_EXPR) {
                string spec = self.lowerFStringInterp(part, tmp, args.len, argDecls, args, varTypes);
                fmt = fmt + spec;
            }
            i = i + 1;
        }
        /* No interpolations: a plain string literal. */
        if (args.len == 0) {
            return irLiteral("\"" + fmt + "\"");
        }
        self.useHelper("__btrc_str_track");
        string lenVar = tmp + "_len";
        string bufVar = tmp + "_buf";
        IRNode fmtLit = irLiteral("\"" + fmt + "\"");
        /* int __len = snprintf(NULL, 0, "fmt", args...); */
        Vector<IRNode> measureArgs = [];
        measureArgs.push(irLiteral("NULL"));
        measureArgs.push(irLiteral("0"));
        measureArgs.push(fmtLit);
        int a = 0;
        while (a < args.len) { measureArgs.push(args.get(a)); a = a + 1; }
        /* char* __buf = __btrc_str_track((char*)malloc(__len + 1)); */
        IRNode lenPlus1 = irBinOp(irVar(lenVar), "+", irLiteral("1"));
        Vector<IRNode> mallocArgs = [];
        mallocArgs.push(lenPlus1);
        IRNode mallocCall = irCast("char*", irCall("malloc", mallocArgs));
        Vector<IRNode> trackArgs = [];
        trackArgs.push(mallocCall);
        IRNode trackCall = irCall("__btrc_str_track", trackArgs);
        /* snprintf(__buf, __len + 1, "fmt", args...); */
        Vector<IRNode> writeArgs = [];
        writeArgs.push(irVar(bufVar));
        writeArgs.push(lenPlus1);
        writeArgs.push(fmtLit);
        int w = 0;
        while (w < args.len) { writeArgs.push(args.get(w)); w = w + 1; }

        Vector<IRNode> stmts = [];
        int d = 0;
        while (d < argDecls.len) { stmts.push(argDecls.get(d)); d = d + 1; }
        stmts.push(irVarDecl("int", lenVar, irCall("snprintf", measureArgs)));
        stmts.push(irVarDecl("char*", bufVar, trackCall));
        stmts.push(irExprStmt(irCall("snprintf", writeArgs)));
        return irStmtExpr(stmts, irVar(bufVar));
    }

    /* Lower one f-string interpolation. Appends an arg-decl (evaluated once) and
     * an arg ref (used by both snprintf passes), returns the format spec.
     * Mirrors fstrings._lower_interpolation. */
    public string lowerFStringInterp(Node part, string tmp, int index,
            Vector<IRNode> argDecls, Vector<IRNode> args, Map<string, Node> varTypes) {
        Node ex = part.expression;
        IRNode irValue = self.lowerExpr(ex, varTypes);
        Node? argType = inferType(ex, self.analyzed, varTypes);
        string fmt = formatSpec(argType);
        string cType = "int";
        if (argType != null) { cType = typeToC(argType, self.analyzed); }

        /* Implicit class->string coercion: interpolating a class value with a
         * no-arg toString() formats as `%s` over `<Class>_toString(value)`
         * (mirrors fstrings._lower_interpolation's has_to_string branch). */
        IRNode coercedInterp = self.coerceToString(makePrimType("string"), argType, irValue);
        if (coercedInterp != irValue) {
            irValue = coercedInterp;
            fmt = "%s";
            cType = "char*";
        }

        /* Untracked type: force %s for string-producing expressions (mirrors
         * fstrings._lower_interp's `arg_type is None` branch). A method call
         * whose field is a known string-producing method (toString, trim, ...)
         * — e.g. an enum's `e.toString()` — formats as %s. */
        if (argType == null) {
            if (ex.kind == NK_F_STRING_LITERAL || ex.kind == NK_STRING_LITERAL) {
                fmt = "%s";
            } else if (ex.kind == NK_CALL_EXPR) {
                Node? fcallee = ex.callee;
                if (fcallee != null && fcallee.kind == NK_FIELD_ACCESS_EXPR
                        && isStringProducingMethod(fcallee.field)) {
                    fmt = "%s";
                }
            }
            if (fmt == "%s") { cType = "char*"; } else { cType = "int"; }
        }

        bool isBool = argType != null && argType.base == "bool";
        if (isBool) { cType = "bool"; fmt = "%s"; }

        /* Hoist the value into a temp so it evaluates exactly once. */
        string argVar = tmp + "_arg" + Strings.fromInt(index);
        argDecls.push(irVarDecl(cType, argVar, irValue));
        IRNode irArg = irVar(argVar);
        if (isBool) {
            irArg = irTernary(irArg, irLiteral("\"true\""), irLiteral("\"false\""));
        }
        args.push(irArg);
        return fmt;
    }

    /* print(...) -> printf with format string (matches calls.py _lower_print). */
    public IRNode lowerPrint(Node node, Map<string, Node> varTypes) {
        if (node.args.len == 0) {
            Vector<IRNode> a = [];
            a.push(irLiteral("\"\\n\""));
            return irCall("printf", a);
        }
        string fmt = "";
        Vector<IRNode> irArgs = [];
        int i = 0;
        while (i < node.args.len) {
            Node arg = node.args.get(i);
            IRNode irArg = self.lowerExpr(arg, varTypes);
            Node? at = inferType(arg, self.analyzed, varTypes);
            string spec = formatSpec(at);
            /* Force %s for known string-producing exprs when type is untracked
             * (mirrors _lower_print's arg_type is None branch). */
            if (at == null) {
                if (arg.kind == NK_STRING_LITERAL || arg.kind == NK_F_STRING_LITERAL) {
                    spec = "%s";
                } else if (arg.kind == NK_CALL_EXPR) {
                    Node? callee = arg.callee;
                    if (callee != null && callee.kind == NK_IDENTIFIER
                            && (callee.name == "toString" || callee.name == "str")) {
                        spec = "%s";
                    }
                    if (callee != null && callee.kind == NK_FIELD_ACCESS_EXPR) {
                        string mn = callee.field;
                        if (mn == "toString" || mn == "str" || mn == "trim"
                                || mn == "toUpper" || mn == "toLower" || mn == "substring"
                                || mn == "replace" || mn == "repeat" || mn == "reverse"
                                || mn == "capitalize" || mn == "join" || mn == "split") {
                            spec = "%s";
                        }
                    }
                }
            }
            /* bool -> ternary: val ? "true" : "false" */
            if (at != null && at.base == "bool") {
                irArg = irTernary(irArg, irLiteral("\"true\""), irLiteral("\"false\""));
                spec = "%s";
            }
            if (i > 0) { fmt = fmt + " "; }
            fmt = fmt + spec;
            irArgs.push(irArg);
            i = i + 1;
        }
        fmt = fmt + "\\n";
        Vector<IRNode> callArgs = [];
        callArgs.push(irLiteral("\"" + fmt + "\""));
        int j = 0;
        while (j < irArgs.len) { callArgs.push(irArgs.get(j)); j = j + 1; }
        return irCall("printf", callArgs);
    }
}

/* True if a method-call field name names a string-producing method (toString,
 * str, trim, ...). Used by print/f-string lowering to force %s when the
 * receiver's type is untracked — e.g. an enum's `e.toString()`. Mirrors the
 * field-name set in fstrings._lower_interp / calls._lower_print. */
bool isStringProducingMethod(string m) {
    return m == "toString" || m == "str" || m == "trim"
        || m == "toUpper" || m == "toLower" || m == "substring"
        || m == "replace" || m == "repeat" || m == "reverse"
        || m == "capitalize" || m == "join" || m == "split";
}

/* The C11 _Generic comparison/hashing macros emitted once when any concrete
 * generic instance exists (mirrors generics.core._GENERIC_MACROS verbatim). */
string genericMacrosText() {
    return "/* Type-dependent comparison/hashing macros for generic collections.\n"
        + " * Uses __builtin_choose_expr — unselected branch is NOT evaluated.\n"
        + " * Cast chain (void*)(intptr_t) avoids float-to-pointer hard errors. */\n"
        + "#define __btrc_eq(a, b) __builtin_choose_expr( \\\n"
        + "    __builtin_types_compatible_p(__typeof__(a), char*), \\\n"
        + "    strcmp((const char*)(void*)(intptr_t)(a), (const char*)(void*)(intptr_t)(b)) == 0, \\\n"
        + "    (a) == (b))\n"
        + "#define __btrc_lt(a, b) __builtin_choose_expr( \\\n"
        + "    __builtin_types_compatible_p(__typeof__(a), char*), \\\n"
        + "    strcmp((const char*)(void*)(intptr_t)(a), (const char*)(void*)(intptr_t)(b)) < 0, \\\n"
        + "    (a) < (b))\n"
        + "#define __btrc_gt(a, b) __builtin_choose_expr( \\\n"
        + "    __builtin_types_compatible_p(__typeof__(a), char*), \\\n"
        + "    strcmp((const char*)(void*)(intptr_t)(a), (const char*)(void*)(intptr_t)(b)) > 0, \\\n"
        + "    (a) > (b))\n"
        + "#define __btrc_hash(k) __builtin_choose_expr( \\\n"
        + "    __builtin_types_compatible_p(__typeof__(k), char*), \\\n"
        + "    __btrc_hash_str((const char*)(void*)(intptr_t)(k)), \\\n"
        + "    (unsigned int)(intptr_t)(k))";
}

/* Double every '%' so printf reads it as a literal percent (mirrors
 * fstrings.py's text.replace("%", "%%")). */
string replacePercent(string s) {
    string out = "";
    int i = 0;
    int n = s.length();
    while (i < n) {
        char c = s[i];
        if (c == '%') { out = out + "%%"; }
        else { out = out + f"{c}"; }
        i = i + 1;
    }
    return out;
}

/* Magic-method name for an overloadable binary operator ("" if none).
 * Mirrors the op_map in operators._lower_binary. */
string binaryOpMagic(string op) {
    if (op == "+") { return "__add__"; }
    if (op == "-") { return "__sub__"; }
    if (op == "*") { return "__mul__"; }
    if (op == "/") { return "__div__"; }
    if (op == "%") { return "__mod__"; }
    if (op == "==") { return "__eq__"; }
    if (op == "!=") { return "__ne__"; }
    if (op == "<") { return "__lt__"; }
    if (op == ">") { return "__gt__"; }
    if (op == "<=") { return "__le__"; }
    if (op == ">=") { return "__ge__"; }
    return "";
}

/* Runtime helper backing a helper-mapped string method (mirrors the helper
 * fields of STRING_METHODS in string_methods.py). "" for methods with no helper
 * (len/equals/conversions, handled inline) or unknown names. */
string stringMethodHelper(string method) {
    if (method == "charLen") { return "__btrc_charLen"; }
    if (method == "contains") { return "__btrc_strContains"; }
    if (method == "startsWith") { return "__btrc_startsWith"; }
    if (method == "endsWith") { return "__btrc_endsWith"; }
    if (method == "indexOf") { return "__btrc_indexOf"; }
    if (method == "lastIndexOf") { return "__btrc_lastIndexOf"; }
    if (method == "find") { return "__btrc_find"; }
    if (method == "count") { return "__btrc_count"; }
    if (method == "charAt") { return "__btrc_charAt"; }
    if (method == "isEmpty") { return "__btrc_isEmpty"; }
    if (method == "isBlank") { return "__btrc_isBlank"; }
    if (method == "isUpper") { return "__btrc_isUpper"; }
    if (method == "isLower") { return "__btrc_isLower"; }
    if (method == "isAlnum" || method == "isAlnumStr") { return "__btrc_isAlnumStr"; }
    if (method == "isDigit" || method == "isDigitStr") { return "__btrc_isDigitStr"; }
    if (method == "isAlpha" || method == "isAlphaStr") { return "__btrc_isAlphaStr"; }
    if (method == "trim") { return "__btrc_trim"; }
    if (method == "lstrip") { return "__btrc_lstrip"; }
    if (method == "rstrip") { return "__btrc_rstrip"; }
    if (method == "toUpper") { return "__btrc_toUpper"; }
    if (method == "toLower") { return "__btrc_toLower"; }
    if (method == "substring") { return "__btrc_substring"; }
    if (method == "replace") { return "__btrc_replace"; }
    if (method == "repeat") { return "__btrc_repeat"; }
    if (method == "reverse") { return "__btrc_reverse"; }
    if (method == "capitalize") { return "__btrc_capitalize"; }
    if (method == "title") { return "__btrc_title"; }
    if (method == "swapCase") { return "__btrc_swapCase"; }
    if (method == "padLeft") { return "__btrc_padLeft"; }
    if (method == "padRight") { return "__btrc_padRight"; }
    if (method == "center") { return "__btrc_center"; }
    if (method == "zfill") { return "__btrc_zfill"; }
    if (method == "removePrefix") { return "__btrc_removePrefix"; }
    if (method == "removeSuffix") { return "__btrc_removeSuffix"; }
    if (method == "join") { return "__btrc_join"; }
    if (method == "split") { return "__btrc_split"; }
    return "";
}

/* True for string methods whose helper returns a fresh heap string and must be
 * wrapped in __btrc_str_track (mirrors the tracked= flag in STRING_METHODS). */
bool stringMethodTracked(string method) {
    if (method == "trim" || method == "lstrip" || method == "rstrip"
            || method == "toUpper" || method == "toLower" || method == "substring"
            || method == "replace" || method == "repeat" || method == "reverse"
            || method == "capitalize" || method == "title" || method == "swapCase"
            || method == "padLeft" || method == "padRight" || method == "center"
            || method == "zfill" || method == "removePrefix" || method == "removeSuffix"
            || method == "join") {
        return true;
    }
    return false;
}

/* printf format specifier for a type (mirrors types.py format_spec_for_type). */
string formatSpec(Node? t) {
    if (t == null) { return "%d"; }
    string base = t.base;
    if (t.pointer_depth > 0) { return "%s"; }
    if (base == "int" || base == "short" || base == "byte" || base == "uint") { return "%d"; }
    if (base == "long") { return "%ld"; }
    if (base == "float" || base == "double") { return "%f"; }
    if (base == "char") { return "%c"; }
    if (base == "string") { return "%s"; }
    if (base == "bool") { return "%s"; }
    return "%d";
}

/* Render an IR expression to inline C text (mirrors expressions.py _expr_text,
 * used by sizeof lowering). Only the IR-node subset that can appear there. */
string irExprText(IRNode e) {
    if (e.kind == IRK_LITERAL) { return e.text; }
    if (e.kind == IRK_RAW_EXPR) { return e.text; }
    if (e.kind == IRK_VAR) { return e.name; }
    if (e.kind == IRK_BINOP) {
        return f"({irExprText(e.left)} {e.op} {irExprText(e.right)})";
    }
    if (e.kind == IRK_UNARYOP) {
        if (e.prefix) { return f"({e.op}{irExprText(e.operand)})"; }
        return f"({irExprText(e.operand)}{e.op})";
    }
    if (e.kind == IRK_CALL) {
        string args = "";
        int i = 0;
        while (i < e.args.len) {
            if (i > 0) { args = args + ", "; }
            args = args + irExprText(e.args.get(i));
            i = i + 1;
        }
        return f"{e.callee}({args})";
    }
    if (e.kind == IRK_FIELD_ACCESS) {
        string op = ".";
        if (e.arrow) { op = "->"; }
        return f"{irExprText(e.obj)}{op}{e.field}";
    }
    if (e.kind == IRK_INDEX) {
        return f"{irExprText(e.obj)}[{irExprText(e.index)}]";
    }
    if (e.kind == IRK_CAST) {
        return f"(({e.target_type}){irExprText(e.expr)})";
    }
    if (e.kind == IRK_TERNARY) {
        return f"({irExprText(e.condition)} ? {irExprText(e.true_expr)} : {irExprText(e.false_expr)})";
    }
    if (e.kind == IRK_ADDRESS_OF) { return f"(&{irExprText(e.expr)})"; }
    if (e.kind == IRK_DEREF) { return f"(*{irExprText(e.expr)})"; }
    if (e.kind == IRK_SIZEOF) { return f"sizeof({e.target_type})"; }
    if (e.kind == IRK_TUPLE_LITERAL) {
        string inits = "";
        int i = 0;
        while (i < e.args.len) {
            if (i > 0) { inits = inits + ", "; }
            inits = inits + f"._{i} = " + irExprText(e.args.get(i));
            i = i + 1;
        }
        return f"({e.text})" + "{" + inits + "}";
    }
    return "/* unknown expr */";
}

void abortGen() {
    /* Force a hard exit on unsupported constructs. */
    int[] z = [0];
    int bad = z[1];
}

/* ===================================================================
 * Stage 5 — Optimizer (reachability DCE).
 *
 * Mirrors src/compiler/python/ir/optimizer.py for the class subset:
 *   - _eliminate_dead_functions: keep only functions reachable from `main`
 *     through the call/reference graph; drop forward decls of removed ones.
 *   - _eliminate_dead_structs: keep structs named in surviving code (+ field
 *     embedding closure); drop forward decls of removed ones.
 * Dead-helper elimination is handled separately by usedHelpers tracking.
 * =================================================================== */

void optimizeModule(IRModule m) {
    eliminateDeadFunctions(m);
    eliminateDeadStructs(m);
}

/* Recursively collect runtime-helper references in an IR node into `used`.
 * A helper is referenced when it appears as a call callee, a function name (var)
 * or inside raw C / raw-expr text. Mirrors optimizer._collect_helper_refs +
 * _scan_raw_*. */
void scanHelpersInNode(IRNode? n, Map<string, bool> used) {
    if (n == null) { return; }
    /* Call callee. */
    if (n.callee != "" && !used.has(n.callee) && helperSource(n.callee) != "") {
        used.put(n.callee, true);
    }
    /* Var name (function pointer reference). */
    if (n.name != "" && !used.has(n.name) && helperSource(n.name) != "") {
        used.put(n.name, true);
    }
    /* ARC cycle-detection symbols are emitted by NAME but are DECLARED inside a
     * differently-named helper (the trycatch_globals pattern). Map each
     * referenced function/global to its declaring helper so phased scope release
     * keeps the cycle runtime. Mirrors the explicit helper_refs Python attaches
     * to __btrc_suspect / __btrc_collect_cycles / mark-destroyed calls. */
    if (n.callee == "__btrc_mark_destroyed" || n.callee == "__btrc_is_destroyed") {
        if (!used.has("__btrc_destroyed_tracking")) { used.put("__btrc_destroyed_tracking", true); }
    }
    if (n.callee == "__btrc_suspect") {
        if (!used.has("__btrc_suspect_buf")) { used.put("__btrc_suspect_buf", true); }
    }
    if (n.name == "__btrc_tracking" || n.name == "__btrc_destroyed_count") {
        if (!used.has("__btrc_destroyed_tracking")) { used.put("__btrc_destroyed_tracking", true); }
    }
    if (n.name == "__btrc_suspect_count") {
        if (!used.has("__btrc_suspect_buf")) { used.put("__btrc_suspect_buf", true); }
    }
    /* Raw text (IRRawC / IRRawExpr): scan for any helper name substring. */
    if (n.text != "") {
        Vector<string> order = canonicalHelperOrder();
        int oi = 0;
        while (oi < order.len) {
            string hn = order.get(oi);
            if (!used.has(hn) && n.text.indexOf(hn) >= 0) { used.put(hn, true); }
            oi = oi + 1;
        }
        /* The try/catch setjmp boilerplate references the runtime globals by
         * their variable names (__btrc_try_stack/top/cap); the helper that
         * DECLARES them is named __btrc_trycatch_globals — which never appears
         * literally. A try with no throw inside would otherwise drop it. Mirrors
         * the explicit helper_refs Python attaches to this IRRawC. */
        if (!used.has("__btrc_trycatch_globals") && n.text.indexOf("__btrc_try_top") >= 0) {
            used.put("__btrc_trycatch_globals", true);
        }
    }
    /* Recurse into all sub-node fields. */
    scanHelpersInNode(n.left, used);
    scanHelpersInNode(n.right, used);
    scanHelpersInNode(n.operand, used);
    scanHelpersInNode(n.expr, used);
    scanHelpersInNode(n.obj, used);
    scanHelpersInNode(n.index, used);
    scanHelpersInNode(n.condition, used);
    scanHelpersInNode(n.true_expr, used);
    scanHelpersInNode(n.false_expr, used);
    scanHelpersInNode(n.init, used);
    scanHelpersInNode(n.value, used);
    scanHelpersInNode(n.target, used);
    scanHelpersInNode(n.then_block, used);
    scanHelpersInNode(n.else_block, used);
    scanHelpersInNode(n.body, used);
    scanHelpersInNode(n.update, used);
    scanHelpersInNode(n.result, used);
    int ai = 0;
    while (ai < n.args.len) { scanHelpersInNode(n.args.get(ai), used); ai = ai + 1; }
    int si = 0;
    while (si < n.stmts.len) { scanHelpersInNode(n.stmts.get(si), used); si = si + 1; }
}

/* True if any declaration in the program uses try/catch or throw (mirrors
 * generator._uses_trycatch). A deep recursive walk of body-bearing fields. */
bool programUsesTrycatch(Node prog) {
    int i = 0;
    while (i < prog.declarations.len) {
        if (nodeUsesTrycatch(prog.declarations.get(i))) { return true; }
        i = i + 1;
    }
    return false;
}

/* Recursively scan a node's body-bearing fields for NK_THROW_STMT /
 * NK_TRY_CATCH_STMT. Conservative deep walk over the statement/control-flow
 * child fields of the fat Node. */
bool nodeUsesTrycatch(Node? n) {
    if (n == null) { return false; }
    if (n.kind == NK_THROW_STMT || n.kind == NK_TRY_CATCH_STMT) { return true; }
    /* statement list (Block / Program-like). */
    int i = 0;
    while (i < n.statements.len) {
        if (nodeUsesTrycatch(n.statements.get(i))) { return true; }
        i = i + 1;
    }
    /* class members / methods. */
    int mi = 0;
    while (mi < n.members.len) {
        if (nodeUsesTrycatch(n.members.get(mi))) { return true; }
        mi = mi + 1;
    }
    /* switch cases. */
    int ci = 0;
    while (ci < n.cases.len) {
        Node cc = n.cases.get(ci);
        int bj = 0;
        while (bj < cc.body_nlist.len) {
            if (nodeUsesTrycatch(cc.body_nlist.get(bj))) { return true; }
            bj = bj + 1;
        }
        ci = ci + 1;
    }
    /* single-node body / control-flow children. */
    if (nodeUsesTrycatch(n.body_node)) { return true; }
    if (nodeUsesTrycatch(n.then_block)) { return true; }
    if (nodeUsesTrycatch(n.else_block)) { return true; }
    if (nodeUsesTrycatch(n.if_stmt)) { return true; }
    if (nodeUsesTrycatch(n.try_block)) { return true; }
    if (nodeUsesTrycatch(n.catch_block)) { return true; }
    if (nodeUsesTrycatch(n.finally_block)) { return true; }
    if (nodeUsesTrycatch(n.getter_body)) { return true; }
    if (nodeUsesTrycatch(n.setter_body)) { return true; }
    return false;
}

/* True for a raw section that is purely forward declarations (mirrors
 * optimizer._is_prototype_block): has '(' and ';' but no '{' or '='. */
bool isPrototypeBlock(string s) {
    return s.indexOf("{") < 0 && s.indexOf("=") < 0
        && s.indexOf("(") >= 0 && s.indexOf(";") >= 0;
}

/* Drop the prototypes of eliminated functions from a forward-decl block
 * (mirrors optimizer._prune_prototype_block). Splits on ';', keeps a prototype
 * unless its function name is in `names` but not in `keep`. */
string prunePrototypeBlock(string section, Vector<string> names, Map<string, bool> kept) {
    Vector<string> parts = splitOn(section, ';');
    Vector<string> out = [];
    int i = 0;
    while (i < parts.len) {
        string part = parts.get(i);
        if (strStripped(part) != "") {
            string fname = funcNameBeforeParen(part);
            bool drop = false;
            if (fname != "" && containsName(names, fname) && !kept.has(fname)) {
                drop = true;
            }
            if (!drop) { out.push(part); }
        }
        i = i + 1;
    }
    if (out.len == 0) { return ""; }
    string joined = "";
    int j = 0;
    while (j < out.len) {
        joined = joined + out.get(j) + ";";
        j = j + 1;
    }
    return joined;
}

/* The function name immediately before the first '(' in a prototype fragment
 * (mirrors `re.search(r"(\w+)\s*\(")`): the run of identifier chars ending at
 * the first '(' (skipping whitespace before it). */
string funcNameBeforeParen(string part) {
    int n = part.length();
    int paren = part.indexOf("(");
    if (paren < 0) { return ""; }
    int end = paren;
    while (end > 0 && isWsChar(part[end - 1])) { end = end - 1; }
    int start = end;
    while (start > 0 && isIdentChar(part[start - 1])) { start = start - 1; }
    if (start >= end) { return ""; }
    return part.substring(start, end - start);
}

/* Split a string on a single char delimiter. */
Vector<string> splitOn(string s, char delim) {
    Vector<string> out = [];
    int n = s.length();
    int start = 0;
    int i = 0;
    while (i < n) {
        if (s[i] == delim) {
            out.push(s.substring(start, i - start));
            start = i + 1;
        }
        i = i + 1;
    }
    out.push(s.substring(start, n - start));
    return out;
}

/* Membership in a Vector<string>. */
bool containsName(Vector<string> names, string name) {
    int i = 0;
    while (i < names.len) {
        if (names.get(i) == name) { return true; }
        i = i + 1;
    }
    return false;
}

/* True if a char can be part of a C identifier. */
bool isIdentChar(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
        || (c >= '0' && c <= '9') || c == '_';
}

/* Index of `needle` in `hay` at or after `from` (-1 if absent). btrc's string
 * indexOf has no start-offset overload, so search the suffix and re-offset. */
int indexOfFrom(string hay, string needle, int startAt) {
    int hlen = hay.length();
    if (startAt < 0) { startAt = 0; }
    if (startAt > hlen) { return -1; }
    string suffix = hay.substring(startAt, hlen - startAt);
    int rel = suffix.indexOf(needle);
    if (rel < 0) { return -1; }
    return startAt + rel;
}

/* Add every name in `names` that occurs as a whole identifier in `text` to
 * `out` (mirrors _scan_text_for_names: word-boundary, not substring). */
void scanTextForNames(string text, Vector<string> names, Map<string, bool> out) {
    int n = names.len;
    int tlen = text.length();
    int i = 0;
    while (i < n) {
        string name = names.get(i);
        if (!out.has(name)) {
            int nlen = name.length();
            int startAt = 0;
            bool found = false;
            while (!found && startAt <= tlen - nlen) {
                int pos = indexOfFrom(text, name, startAt);
                if (pos < 0) { startAt = tlen + 1; }
                else {
                    bool okBefore = pos == 0 || !isIdentChar(text[pos - 1]);
                    int after = pos + nlen;
                    bool okAfter = after >= tlen || !isIdentChar(text[after]);
                    if (okBefore && okAfter) { found = true; }
                    else { startAt = pos + 1; }
                }
            }
            if (found) { out.put(name, true); }
        }
        i = i + 1;
    }
}

/* Collect referenced function names from an IR expression/statement tree. Adds
 * IRCall callees and IRVar names that are in `names`; scans text-bearing fields
 * (callee/text/target_type) for embedded identifiers (mirrors
 * _collect_func_refs). */
void collectFuncRefs(IRNode node, Vector<string> names, Map<string, bool> out) {
    if (node == null) { return; }
    if (node.kind == IRK_CALL) {
        if (node.callee != "") { scanTextForNames(node.callee, names, out); }
    }
    if (node.kind == IRK_VAR) {
        scanTextForNames(node.name, names, out);
    }
    if (node.kind == IRK_RAW_EXPR || node.kind == IRK_LITERAL) {
        /* Scan `text` ALWAYS (mirrors optimizer._collect_func_refs treating the
         * `text` field like `callee`): a bare lifted-lambda fn name reference
         * (e.g. an IRRawExpr "__btrc_lambda_1" passed to .map) has no '(' but
         * still keeps that function alive. */
        scanTextForNames(node.text, names, out);
    }
    /* Recurse into every sub-node field. */
    collectFuncRefs(node.left, names, out);
    collectFuncRefs(node.right, names, out);
    collectFuncRefs(node.operand, names, out);
    collectFuncRefs(node.expr, names, out);
    collectFuncRefs(node.obj, names, out);
    collectFuncRefs(node.index, names, out);
    collectFuncRefs(node.condition, names, out);
    collectFuncRefs(node.true_expr, names, out);
    collectFuncRefs(node.false_expr, names, out);
    collectFuncRefs(node.init, names, out);
    collectFuncRefs(node.value, names, out);
    collectFuncRefs(node.target, names, out);
    collectFuncRefs(node.then_block, names, out);
    collectFuncRefs(node.else_block, names, out);
    collectFuncRefs(node.body, names, out);
    collectFuncRefs(node.update, names, out);
    collectFuncRefs(node.result, names, out);
    int i = 0;
    while (i < node.args.len) { collectFuncRefs(node.args.get(i), names, out); i = i + 1; }
    int j = 0;
    while (j < node.stmts.len) { collectFuncRefs(node.stmts.get(j), names, out); j = j + 1; }
}

void eliminateDeadFunctions(IRModule m) {
    if (m.functions.len <= 1) { return; }
    Vector<string> names = [];
    Map<string, int> byName = {};
    Map<string, bool> keepSet = {};
    Vector<string> worklist = [];
    int i = 0;
    while (i < m.functions.len) {
        names.push(m.functions.get(i).name);
        byName.put(m.functions.get(i).name, i);
        i = i + 1;
    }
    /* Roots: the entry points main / btrc_main. */
    int r = 0;
    while (r < names.len) {
        string nm = names.get(r);
        if (nm == "main" || nm == "btrc_main") {
            if (!keepSet.has(nm)) { keepSet.put(nm, true); worklist.push(nm); }
        }
        r = r + 1;
    }
    /* Non-prototype raw sections (the generic _Generic macros, vtables, ...) are
     * emitted verbatim, so any function name they mention is a root. Prototype
     * blocks (generic-method fwd-decls) are NOT roots (mirrors optimizer). */
    int rs = 0;
    while (rs < m.raw_sections.len) {
        string sec = m.raw_sections.get(rs);
        if (!isPrototypeBlock(sec)) {
            Map<string, bool> secRefs = {};
            scanTextForNames(sec, names, secRefs);
            Vector<string> sk = secRefs.keys();
            int z = 0;
            while (z < sk.len) {
                string nm = sk.get(z);
                if (!keepSet.has(nm)) { keepSet.put(nm, true); worklist.push(nm); }
                z = z + 1;
            }
        }
        rs = rs + 1;
    }
    /* Transitive reachability. */
    while (worklist.len > 0) {
        Map<string, bool> refs = {};
        string cur = worklist.pop();
        bool hasFn = byName.has(cur);
        if (hasFn) {
            IRFunction fn = m.functions.get(byName.get(cur));
            if (fn.body != null) {
                collectFuncRefs(fn.body, names, refs);
            }
        }
        Vector<string> rk = refs.keys();
        int k = 0;
        while (k < rk.len) {
            string rn = rk.get(k);
            if (!keepSet.has(rn)) { keepSet.put(rn, true); worklist.push(rn); }
            k = k + 1;
        }
    }
    /* Filter functions. */
    Vector<IRFunction> kept = [];
    Vector<string> removed = [];
    int f = 0;
    while (f < m.functions.len) {
        IRFunction fn = m.functions.get(f);
        if (keepSet.has(fn.name)) { kept.push(fn); }
        else { removed.push(fn.name); }
        f = f + 1;
    }
    m.functions = kept;
    /* Drop forward decls of removed functions: a prototype contains " name(". */
    if (removed.len > 0) {
        Vector<string> fwds = [];
        int d = 0;
        while (d < m.forward_decls.len) {
            string fd = m.forward_decls.get(d);
            bool drop = false;
            int q = 0;
            while (q < removed.len) {
                if (fd.indexOf(" " + removed.get(q) + "(") >= 0) { drop = true; q = removed.len; }
                else { q = q + 1; }
            }
            if (!drop) { fwds.push(fd); }
            d = d + 1;
        }
        m.forward_decls = fwds;
        /* Prune the prototypes of removed functions from prototype-block raw
         * sections (generic-method fwd-decls), dropping any block left empty
         * (mirrors optimizer's prototype-block pruning). */
        Vector<string> newSecs = [];
        int s = 0;
        while (s < m.raw_sections.len) {
            string sec = m.raw_sections.get(s);
            if (isPrototypeBlock(sec)) {
                string pruned = prunePrototypeBlock(sec, names, keepSet);
                if (strStripped(pruned) != "") { newSecs.push(pruned); }
            } else {
                newSecs.push(sec);
            }
            s = s + 1;
        }
        m.raw_sections = newSecs;
    }
}

/* Collect struct-name references in a function's signature (params + return)
 * and body. Mirrors _collect_struct_refs (which scans CType text + strings). */
void collectStructRefsFn(IRFunction fn, Vector<string> names, Map<string, bool> out) {
    scanTextForNames(fn.return_type, names, out);
    int i = 0;
    while (i < fn.params.len) {
        scanTextForNames(fn.params.get(i).c_type, names, out);
        i = i + 1;
    }
    if (fn.body != null) { collectStructRefsNode(fn.body, names, out); }
}

/* Scan an IR node tree for struct names in type-bearing + text fields. */
void collectStructRefsNode(IRNode node, Vector<string> names, Map<string, bool> out) {
    if (node == null) { return; }
    if (node.c_type != "") { scanTextForNames(node.c_type, names, out); }
    if (node.target_type != "") { scanTextForNames(node.target_type, names, out); }
    if (node.text != "") { scanTextForNames(node.text, names, out); }
    if (node.callee != "") { scanTextForNames(node.callee, names, out); }
    collectStructRefsNode(node.left, names, out);
    collectStructRefsNode(node.right, names, out);
    collectStructRefsNode(node.operand, names, out);
    collectStructRefsNode(node.expr, names, out);
    collectStructRefsNode(node.obj, names, out);
    collectStructRefsNode(node.index, names, out);
    collectStructRefsNode(node.condition, names, out);
    collectStructRefsNode(node.true_expr, names, out);
    collectStructRefsNode(node.false_expr, names, out);
    collectStructRefsNode(node.init, names, out);
    collectStructRefsNode(node.value, names, out);
    collectStructRefsNode(node.target, names, out);
    collectStructRefsNode(node.then_block, names, out);
    collectStructRefsNode(node.else_block, names, out);
    collectStructRefsNode(node.body, names, out);
    collectStructRefsNode(node.update, names, out);
    collectStructRefsNode(node.result, names, out);
    int i = 0;
    while (i < node.args.len) { collectStructRefsNode(node.args.get(i), names, out); i = i + 1; }
    int j = 0;
    while (j < node.stmts.len) { collectStructRefsNode(node.stmts.get(j), names, out); j = j + 1; }
}

void eliminateDeadStructs(IRModule m) {
    if (m.struct_defs.len <= 1) { return; }
    Vector<string> names = [];
    Map<string, int> byName = {};
    Map<string, bool> refs = {};
    Map<string, bool> keepSet = {};
    int i = 0;
    while (i < m.struct_defs.len) {
        names.push(m.struct_defs.get(i).name);
        byName.put(m.struct_defs.get(i).name, i);
        i = i + 1;
    }
    int f = 0;
    while (f < m.functions.len) {
        collectStructRefsFn(m.functions.get(f), names, refs);
        f = f + 1;
    }
    /* Also scan raw sections (generic method fwd-decls + macros) for struct
     * names, mirroring optimizer._eliminate_dead_structs. */
    int rs = 0;
    while (rs < m.raw_sections.len) {
        scanTextForNames(m.raw_sections.get(rs), names, refs);
        rs = rs + 1;
    }
    /* Names referenced in surviving functions seed the set; the embedding
     * closure below keeps the struct types of a kept struct's fields. */
    Vector<string> worklist = refs.keys();
    int w0 = 0;
    while (w0 < worklist.len) { keepSet.put(worklist.get(w0), true); w0 = w0 + 1; }
    while (worklist.len > 0) {
        Map<string, bool> fr = {};
        string cur = worklist.pop();
        bool present = byName.has(cur);
        if (present) {
            IRStructDef sd = m.struct_defs.get(byName.get(cur));
            int fl = 0;
            while (fl < sd.fields.len) {
                scanTextForNames(sd.fields.get(fl).c_type, names, fr);
                fl = fl + 1;
            }
        }
        Vector<string> frk = fr.keys();
        int z = 0;
        while (z < frk.len) {
            string nm = frk.get(z);
            if (!keepSet.has(nm)) { keepSet.put(nm, true); worklist.push(nm); }
            z = z + 1;
        }
    }
    if (keepSet.len == names.len) { return; }
    Vector<IRStructDef> kept = [];
    Vector<string> removed = [];
    int s = 0;
    while (s < m.struct_defs.len) {
        IRStructDef sd = m.struct_defs.get(s);
        if (keepSet.has(sd.name)) { kept.push(sd); }
        else { removed.push(sd.name); }
        s = s + 1;
    }
    m.struct_defs = kept;
    Vector<string> fwds = [];
    int d = 0;
    while (d < m.forward_decls.len) {
        string fd = m.forward_decls.get(d);
        Map<string, bool> hit = {};
        scanTextForNames(fd, removed, hit);
        if (hit.len == 0) { fwds.push(fd); }
        d = d + 1;
    }
    m.forward_decls = fwds;
}
