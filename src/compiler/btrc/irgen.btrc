/* Stage 4 — self-hosted structured IR generation.
 *
 * Walks the parsed AST plus Analyzed tables and owns all source-to-C lowering.
 * Per-function TypeExpr maps feed the shared numeric, comparison, reference,
 * hash, and lvalue-update contracts; the emitter only formats resulting IR. */

string compactPackDirective(string text) {
    string compact = Strings.replace(strStripped(text), " ", "");
    compact = Strings.replace(compact, "\t", "");
    compact = Strings.replace(compact, "\r", "");
    return Strings.replace(compact, "\n", "");
}

/* -1: not a supported push spelling; -2: push with inherited alignment;
 * otherwise the explicit (as-yet unvalidated) alignment. */
int packPushAlignment(string text) {
    string compact = compactPackDirective(text);
    if (compact == "#pragmapack(push)") { return -2; }
    string prefix = "#pragmapack(push,";
    if (!compact.startsWith(prefix) || !compact.endsWith(")")) { return -1; }
    int valueLength = compact.length() - prefix.length() - 1;
    if (valueLength <= 0) { return -1; }
    string valueText = compact.substring(prefix.length(), valueLength);
    int index = 0;
    while (index < valueText.length()) {
        if (!typeIdentityAsciiDigit(valueText[index])) { return -1; }
        index = index + 1;
    }
    return Strings.toInt(valueText);
}

bool isPackPop(string text) {
    return compactPackDirective(text) == "#pragmapack(pop)";
}

bool isPackPragma(string text) {
    return packPushAlignment(text) != -1 || isPackPop(text);
}

bool supportedPackAlignment(int alignment) {
    return alignment == 1 || alignment == 2 || alignment == 4
        || alignment == 8 || alignment == 16;
}

void packContractFail(string message) {
    fprintf(stderr, "error: %s\n", message);
    abortGen();
}

Map<string, int> declarationPackAlignments(Node program) {
    Map<string, int> alignments = {};
    Vector<int> stack = [];
    int current = 0;
    int index = 0;
    while (index < program.declarations.len) {
        Node declaration = program.declarations.get(index);
        bool handledDirective = false;
        if (declaration.kind == NK_PREPROCESSOR_DIRECTIVE) {
            int pushed = packPushAlignment(declaration.text);
            if (pushed != -1) {
                stack.push(current);
                if (pushed != -2) {
                    if (!supportedPackAlignment(pushed)) {
                        packContractFail("unsupported #pragma pack alignment "
                            + Strings.fromInt(pushed));
                    }
                    current = pushed;
                }
                handledDirective = true;
            } else if (isPackPop(declaration.text)) {
                if (stack.len == 0) {
                    packContractFail(
                        "#pragma pack(pop) has no matching push");
                }
                current = stack.pop();
                handledDirective = true;
            }
        }
        if (!handledDirective && current > 0
                && (declaration.kind == NK_CLASS_DECL
                    || declaration.kind == NK_STRUCT_DECL)) {
            alignments.put(astNodeKey(declaration), current);
        }
        index = index + 1;
    }
    if (stack.len > 0) {
        packContractFail("#pragma pack(push) has no matching pop");
    }
    return alignments;
}

/* C function name for a monomorphized generic-METHOD instance:
 * {class_part}_{method}_{method_arg_mangles}, e.g. btrc_Vector_int_mapTo_string
 * for Vector<int>.mapTo<string>. The class part is mangleGenericType for a
 * generic owner, or the bare class base for a non-generic owner. Mirrors
 * generics.methods_mono.generic_method_instance_name. */
string genericMethodInstanceName(string classBase, Vector<Node> classArgs,
                                 string methodName, Vector<Node> methodArgs) {
    return mangleMethodInstanceSymbol(
        classBase, classArgs, methodName, methodArgs);
}

/* Get/create the typedef name for a function-pointer type and register the
 * source TypeExpr for later typed declaration generation. generic_args is
 * [ret, param1, param2, ...]. */
string fnPtrTypedefName(Node t, Analyzed a) {
    /* Mangled name from ALL generic args (ret + params). */
    string mangled = mangleFunctionPointerSymbol(t.generic_args);
    if (!a.fnPtrTypes.has(mangled)) {
        /* Register nested callback components first so every typedef is visible
         * before a later typedef names it in a return or parameter type. */
        int component = 0;
        while (component < t.generic_args.len) {
            typeToC(t.generic_args.get(component), a);
            component = component + 1;
        }
        a.fnPtrTypes.put(mangled, t);
        a.fnPtrOrder.push(mangled);
    }
    return mangled;
}

/* btrc TypeExpr Node -> C type string (mirrors types.py type_to_c, int subset
 * plus user classes + generic instances). `a` supplies the class table so class
 * types become pointers (classes are always heap-allocated). */
string typeToC(Node t, Analyzed a) {
    if (t == null) { return "void"; }
    string base = t.base;
    /* Function-pointer type __fn_ptr(ret, params...) -> mangled typedef name. */
    if (base == "__fn_ptr" && t.generic_args.len > 0) {
        return fnPtrTypedefName(t, a);
    }
    /* Thread<T> / Mutex<T> -> opaque runtime-handle pointers (mirrors
     * types.type_to_c). These are not user generics: no struct/mangled name,
     * just the pthread-backed handle typedef. Checked before the generic-arg
     * mangling branch below. */
    if (base == "Thread" && t.generic_args.len > 0) { return "__btrc_thread_t*"; }
    if (base == "Mutex" && t.generic_args.len > 0) { return "__btrc_mutex_val_t*"; }
    string prefix = "";
    if (t.is_const) { prefix = "const "; }
    string c = base;
    /* Generic instance type (List<int>, user generics): mangled name. Class-typed
     * args have already been upgraded to pointers by upgradeProgramGenericArgs
     * (the AST pass that mirrors the reference's _upgrade_class_type), so the
     * mangled name carries the `_p1` suffix (`btrc_Vector_OwnedItem_p1`). */
    if (t.generic_args.len > 0) {
        if (base == "Tuple") { c = mangleGenericSymbol(base, t.generic_args); }
        else { c = mangleGenericType(base, t.generic_args); }
    } else if (base == "string") { c = "char*"; }
    else if (base == "bool") { c = "bool"; }
    else if (base == "byte") { c = "unsigned char"; }
    else if (base == "uint") { c = "unsigned int"; }
    /* int/float/double/char/void/long/short/size_t map to themselves;
     * user classes also map to their own name (pointer applied below). */
    int depth = t.pointer_depth;
    /* A nullable `?` contributes one pointer level so value types can be boxed
     * (int? -> int*), but `string` is already char* (a pointer), so a nullable
     * string must collapse back to char* rather than char** — mirrors the
     * reference type_to_c fix (gcc 15 rejects char* = char**). */
    if (t.is_nullable && base == "string") { depth = depth - 1; }
    int p = 0;
    while (p < depth) { c = c + "*"; p = p + 1; }
    /* Class types are reference types: append one pointer level if the source
     * type wasn't already a pointer (mirrors _upgrade_class_type pointer_depth=1
     * with type_to_c then applying it). Generic class instances are likewise
     * heap-allocated reference types. */
    if (t.generic_args.len == 0 && a.isClass(base) && t.pointer_depth == 0) {
        c = c + "*";
    } else if (t.generic_args.len > 0 && a.isGenericClass(base) && t.pointer_depth == 0) {
        c = c + "*";
    }
    if (t.is_array) { c = c + "*"; }
    return prefix + c;
}

/* A scope-managed local variable: an ARC-owned class instance to be released on
 * scope exit / return (mirrors the (var_name, class_name) tuples in the Python
 * generator's _managed_vars_stack). */
class Managed {
    public string name;
    public string cls;
    public string cleanupKind;
    public Managed(string name, string cls) {
        self.name = name;
        self.cls = cls;
        self.cleanupKind = "arc";
    }
}

/* Abstract ownership ABI state for lexical __fn_ptr bindings.  Missing from
 * both vectors means a borrowed C callback; owned means a btrc source callable
 * returning +1; ambiguous is the conservative join of different paths. */
class CallableFlowSnapshot {
    public Vector<string> owned;
    public Vector<string> ambiguous;

    public CallableFlowSnapshot() {
        self.owned = [];
        self.ambiguous = [];
    }
}

/* Callback ABI states reachable through a throw edge from one lexical try.
 * `names` fixes the outer bindings visible when the try begins so declarations
 * local to the try cannot leak into catch analysis. */
class CallableExceptionalCapture {
    public Vector<string> names;
    public Vector<CallableFlowSnapshot> states;

    public CallableExceptionalCapture() {
        self.names = [];
        self.states = [];
    }
}

/* Snapshot of the ARC managed-scope + return context, taken before lowering an
 * isolated body (a lambda / thread wrapper, a separate C function). Holds COPIES
 * of the managed stack + scope starts so the live IRGen fields can be cleared
 * in place and refilled on restore — never reassigning the field pointer, which
 * would otherwise release (and free) the prior vector while a plain alias of it
 * is still held (btrcc has no retain on aliasing locals). */
class ScopeSnapshot {
    public Vector<Managed> managed;
    public Vector<int> starts;
    public Vector<int> loops;
    public Vector<string> controls;
    public Vector<int> controlManagedStarts;
    public Vector<string> cleanupMarkers;
    public Vector<int> controlCleanupStarts;
    public string retC;
    public Node? retType;
    public bool retOwned;
    public int tryDepth;
    public int trycatchDepth;
    public Vector<string> closureNames;
    public Vector<string> closureFunctions;
    public Vector<string> closureEnvironments;
    public Vector<string> ownedCallableNames;
    public Vector<string> ambiguousCallableNames;
    public Vector<string> callableDeclarations;
    public Vector<int> callableScopeStarts;
    public Vector<CallableExceptionalCapture> callableExceptionCaptures;
    public Vector<string> borrowedLocalBindings;
    /* COPIES of the func-var-decl accumulator (the IRNode handles), so a lambda
     * body lowers in a fresh decl context and the parent's accumulator is
     * restored after. Mirrors saving/clearing gen._func_var_decls around a
     * lambda body in lambdas.py. */
    public Vector<IRNode> funcVarDecls;

    public ScopeSnapshot() {
        self.managed = [];
        self.starts = [];
        self.loops = [];
        self.controls = [];
        self.controlManagedStarts = [];
        self.cleanupMarkers = [];
        self.controlCleanupStarts = [];
        self.retC = "";
        self.retType = null;
        self.retOwned = true;
        self.tryDepth = 0;
        self.trycatchDepth = 0;
        self.closureNames = [];
        self.closureFunctions = [];
        self.closureEnvironments = [];
        self.ownedCallableNames = [];
        self.ambiguousCallableNames = [];
        self.callableDeclarations = [];
        self.callableScopeStarts = [];
        self.callableExceptionCaptures = [];
        self.borrowedLocalBindings = [];
        self.funcVarDecls = [];
    }
}

class IRGen {
    public Analyzed analyzed;
    public GpuRegistry gpu;
    public GpuCpuContext gpuCpu;
    public GpuHostContext gpuHost;
    /* astNodeKey(declaration) -> active #pragma pack alignment. */
    public Map<string, int> packAlignments;
    /* Runtime helpers referenced during lowering (name -> true). */
    public Map<string, bool> usedHelpers;
    /* Cached once at module entry. Allocating constructor wrappers need an
     * exception cleanup guard only when this translation unit can throw. */
    public bool programHasExceptions;

    /* ARC managed-variable tracking. `managedStack` is a flat list of all
     * currently-live managed vars across nested scopes; `scopeStarts` records
     * the index in managedStack where each open scope began (so a scope's vars
     * are managedStack[start..end]). Mirrors generator._managed_vars_stack. */
    public Vector<Managed> managedStack;
    public Vector<int> scopeStarts;
    /* Names whose current lexical representation is borrowed rather than an
     * owned ARC slot.  This prevents a lambda parameter/capture or borrowed
     * synthetic binding from inheriting a same-named managed global's lowering
     * policy.  Block lowering snapshots/restores the map for shadowing. */
    public Map<string, bool> borrowedLocalBindings;
    /* Loop-body scope markers: each entry is a `managedStack` length recorded at
     * the start of a loop body, so break/continue can release exactly the
     * managed vars declared inside the current (innermost) loop body. Mirrors
     * generator._loop_scope_depths. */
    public Vector<int> loopScopeDepths;
    /* Lexical loop/switch/try nesting. Used to pop only the try frames that a
     * break or continue actually crosses. */
    public Vector<string> controlContext;
    /* Managed-stack boundary aligned with each lexical control context. A
     * switch break inside a loop exits case locals but preserves locals owned
     * by the surrounding loop body. */
    public Vector<int> controlManagedStarts;
    public Vector<string> cleanupMarkers;
    /* Markers become active only when their lexical scope registers a cleanup
     * slot, keeping unrelated scalar functions runtime-free. */
    public Map<string, bool> activeCleanupMarkers;
    public Vector<int> controlCleanupStarts;
    /* The var-type map in scope while resolving a call's params for keep-ARC.
     * Set by keepCallArcStmts before paramsForCall walks the callee's receiver
     * type. */
    public Map<string, Node> callParamVarTypes;
    /* Nesting depth of try blocks currently being lowered. Managed-var decls at
     * depth > 0 register an exception-cleanup so a throw (longjmp) still releases
     * them. Mirrors generator.in_try_depth. */
    public int inTryDepth;
    /* Nesting depth of try/catch CONSTRUCTS currently being lowered (try body,
     * catch body, and finally body all count — unlike inTryDepth, which only
     * spans the try body). A class-pointer `return` lowered anywhere inside a
     * try/catch gets laundered through __btrc_launder to dodge the gcc -O2 setjmp
     * cross-branch field-merge miscompile. Mirrors generator.in_trycatch_depth. */
    public int inTrycatchDepth;
    /* Owning-temporary overrides: a `new X()`/ctor-call argument hoisted into a
     * temp so the call references the temp (and the temp can be released after).
     * Keyed by stable astNodeKey identity; the value is the temp's IRVar.
     * lowerExpr consults this before lowering an expression. Mirrors
     * generator._owning_temp_overrides (keyed there by id(node)). */
    public Map<string, IRNode> owningTempOverrides;

    /* Unique temp counter (mirrors generator._temp_counter / fresh_temp). */
    public int tempCounter;

    /* Current class being lowered ("" outside any class) — set while emitting a
     * class's methods/constructor so self-typing works. */
    public string currentClass;

    /* C return type of the function currently being lowered (for the return-path
     * release temp; mirrors generator.current_return_c_type). */
    public string currentReturnCType;

    /* AST return-type of the function currently being lowered (null = none). Used
     * for implicit class->string coercion on `return` (mirrors generator.
     * current_return_type + stringable.coerce_value_to_string). */
    public Node? currentReturnTypeNode;

    /* Managed source functions and methods return one reference owned by the
     * caller. Property getters are the sole borrowed-return boundary. */
    public bool currentReturnOwned;

    /* True while lowering a monomorphized generic method/constructor body. The
     * generic emitter (user_emitter.py) lowers binary operators RAW — no div/mod
     * helpers, no string-concat helpers, no operator-overload dispatch — so this
     * flag suppresses those transforms to stay byte-identical. */
    public bool inGenericMethod;

    /* Public stdlib collection methods batch their explicit element releases
     * and force once when the mutation method completes. */
    public bool batchExplicitReleases;

    /* Explicit keep in any built-in collection method creates a persistent
     * element edge.  This remains true in private helpers such as
     * Map.putRetained; public-method release batching is independent. */
    public bool collectionEdgeKeeps;

    /* The {type-param -> concrete-type} map for the generic instance whose body
     * is currently being lowered (empty outside a generic method). Body-level
     * type references (cast targets, sizeof, local var decls) resolve through
     * this so `T`/`K`/`V` become the concrete element types. Mirrors
     * _UserGenericEmitter.type_map + _resolve in user_emitter.py. */
    public Map<string, Node> activeTypeMap;

    /* The module currently being generated, so deep expression lowering (lambda
     * lifting) can append the lifted static function + capture-env struct.
     * Mirrors generator.module. */
    public IRModule curModule;

    /* Lambda lifting state (mirrors generator._lambda_counter / fresh_lambda_id
     * / _last_lambda_id / _fn_ptr_envs). lambdaCounter assigns unique ids;
     * lastLambdaId links a just-lowered lambda to its var-decl env allocation;
     * fnPtrEnvFn/fnPtrEnvVar map a captured-lambda variable name -> the impl fn
     * name and its on-stack env var, so a call bypasses the fn pointer. */
    public int lambdaCounter;
    public int lastLambdaId;
    public Map<string, string> fnPtrEnvFn;
    public Map<string, string> fnPtrEnvVar;
    /* Function-pointer locals proven to target lifted lambdas or source
     * functions. These callables use btrc's caller-owned managed-return ABI;
     * arbitrary C function pointers deliberately do not enter this map. */
    public Map<string, bool> ownedCallableBindings;
    public Map<string, bool> ambiguousCallableBindings;
    public Vector<string> callableScopeDeclarations;
    public Vector<int> callableScopeStarts;
    public Vector<CallableExceptionalCapture> callableExceptionCaptures;

    /* Every local IRVarDecl produced in the function/method body currently being
     * lowered. A try/catch marks ALL of them `volatile`, since any local modified
     * between setjmp() and read after a longjmp() has an indeterminate value
     * otherwise (C11 7.13.2.1) and gcc 15 manifests the bug. Reset at every
     * body-lowering entry; saved/restored around an isolated (lambda) body.
     * Mirrors generator._func_var_decls + control_flow._lower_try_catch. */
    public Vector<IRNode> funcVarDecls;

    /* One structured take-and-clear adapter per concrete cleanup-slot C type. */
    public Map<string, string> cleanupTakeAdapters;
    public Vector<IRFunction> cleanupTakeAdapterDefinitions;
    public int cleanupSlotCounter;
    public bool cleanupTakeAdaptersFinalized;

    /* Context for lowering explicit enum initializers. Bare references to an
     * earlier member must stay qualified even when the same spelling appears
     * in another enum and is therefore ambiguous program-wide. */
    public bool inEnumInitializer;
    public string enumLoweringOwner;
    public Map<string, bool> enumLoweringMembers;

    public IRGen(Analyzed analyzed) {
        self.analyzed = analyzed;
        self.gpu = GpuRegistry();
        self.gpuCpu = GpuCpuContext();
        self.gpuHost = GpuHostContext();
        self.packAlignments = {};
        self.usedHelpers = {};
        self.programHasExceptions = false;
        self.managedStack = [];
        self.scopeStarts = [];
        self.borrowedLocalBindings = {};
        self.loopScopeDepths = [];
        self.controlContext = [];
        self.controlManagedStarts = [];
        self.cleanupMarkers = [];
        self.activeCleanupMarkers = {};
        self.controlCleanupStarts = [];
        self.callParamVarTypes = {};
        self.inTryDepth = 0;
        self.inTrycatchDepth = 0;
        self.owningTempOverrides = {};
        self.tempCounter = 0;
        self.currentClass = "";
        self.currentReturnCType = "void";
        self.currentReturnTypeNode = null;
        self.currentReturnOwned = true;
        self.inGenericMethod = false;
        self.batchExplicitReleases = false;
        self.collectionEdgeKeeps = false;
        self.activeTypeMap = {};
        self.curModule = null;
        self.lambdaCounter = 0;
        self.lastLambdaId = 0;
        self.fnPtrEnvFn = {};
        self.fnPtrEnvVar = {};
        self.ownedCallableBindings = {};
        self.ambiguousCallableBindings = {};
        self.callableScopeDeclarations = [];
        self.callableScopeStarts = [];
        self.callableExceptionCaptures = [];
        self.funcVarDecls = [];
        self.cleanupTakeAdapters = {};
        self.cleanupTakeAdapterDefinitions = [];
        self.cleanupSlotCounter = 0;
        self.cleanupTakeAdaptersFinalized = false;
        self.inEnumInitializer = false;
        self.enumLoweringOwner = "";
        self.enumLoweringMembers = {};
    }

    /* fresh_lambda_id: unique increasing lambda id (mirrors fresh_lambda_id). */
    public int freshLambdaId() {
        self.lambdaCounter = self.lambdaCounter + 1;
        return self.lambdaCounter;
    }

    public bool hasClosureEnv(string name) {
        return self.fnPtrEnvFn.has(name) && self.fnPtrEnvFn.get(name) != "";
    }

    public bool hasOwnedCallableBinding(string name) {
        return self.ownedCallableBindings.has(name)
            && self.ownedCallableBindings.get(name);
    }

    public bool hasAmbiguousCallableBinding(string name) {
        return self.ambiguousCallableBindings.has(name)
            && self.ambiguousCallableBindings.get(name);
    }

    /* 0 = borrowed C callback, 1 = source-owned +1, 2 = ambiguous join. */
    public int callableBindingAbi(string name) {
        if (self.hasAmbiguousCallableBinding(name)) { return 2; }
        if (self.hasOwnedCallableBinding(name)) { return 1; }
        return 0;
    }

    public void setCallableBindingAbi(string name, int abi) {
        self.ownedCallableBindings.remove(name);
        self.ambiguousCallableBindings.remove(name);
        if (abi == 1) {
            self.ownedCallableBindings.put(name, true);
        } else if (abi == 2) {
            self.ambiguousCallableBindings.put(name, true);
        }
    }

    public int callableExpressionAbi(
            Node? expression, Map<string, Node> varTypes) {
        if (expression == null) { return 0; }
        if (expression.kind == NK_LAMBDA_EXPR) { return 1; }
        if (expression.kind == NK_IDENTIFIER) {
            int lexicalAbi = self.callableBindingAbi(expression.name);
            if (lexicalAbi != 0) { return lexicalAbi; }
            if (varTypes.has(expression.name)) {
                Node? lexicalType = resolveTypedefType(
                    varTypes.get(expression.name),
                    self.analyzed.typedefTable);
                if (lexicalType != null
                        && lexicalType.base == "__fn_ptr") {
                    return 0;
                }
            }
            if (!self.analyzed.funcTable.has(expression.name)) {
                return 0;
            }
            Node declaration = self.analyzed.funcTable.get(
                expression.name);
            if (declaration.body_node != null) { return 1; }
            return 0;
        }
        if (expression.kind == NK_FIELD_ACCESS_EXPR
                && expression.obj != null
                && expression.obj.kind == NK_IDENTIFIER
                && !varTypes.has(expression.obj.name)
                && self.analyzed.isClass(expression.obj.name)) {
            Node? method = self.analyzed.classMethod(
                expression.obj.name, expression.field);
            if (method != null
                    && method.kind == NK_METHOD_DECL
                    && method.access == "class"
                    && method.body_node != null) {
                return 1;
            }
        }
        if (expression.kind == NK_CAST_EXPR) {
            return self.callableExpressionAbi(
                expression.expr, varTypes);
        }
        if (expression.kind == NK_UNARY_EXPR
                && expression.op == "&") {
            return self.callableExpressionAbi(
                expression.operand, varTypes);
        }
        if (expression.kind == NK_TERNARY_EXPR) {
            int trueAbi = self.callableExpressionAbi(
                expression.true_expr, varTypes);
            int falseAbi = self.callableExpressionAbi(
                expression.false_expr, varTypes);
            if (trueAbi == falseAbi) { return trueAbi; }
            return 2;
        }
        return 0;
    }

    public bool callableTypeHasManagedReturn(Node? type) {
        if (type == null) { return false; }
        Node? resolved = self.resolveBodyType(type);
        resolved = resolveTypedefType(
            resolved, self.analyzed.typedefTable);
        return resolved != null
            && resolved.base == "__fn_ptr"
            && resolved.generic_args.len > 0
            && irManagedType(self, resolved.generic_args.get(0));
    }

    public bool callableDeclaredInActiveScope(string name) {
        int index = 0;
        while (index < self.callableScopeDeclarations.len) {
            if (self.callableScopeDeclarations.get(index) == name) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    public bool callableIdentifierIsLexicalLocal(string name) {
        return self.callableDeclaredInActiveScope(name)
            || !self.analyzed.globalVarTypes.has(name);
    }

    public void rejectPersistentCallableEscape(
            Node? expectedType, Node? value,
            Map<string, Node> varTypes, string boundary) {
        if (!self.callableTypeHasManagedReturn(expectedType)
                || self.callableExpressionAbi(value, varTypes) == 0) {
            return;
        }
        print("Managed-return callback cannot cross " + boundary
            + "; bare __fn_ptr storage erases its return ABI");
        abortGen();
    }

    public void snapshotOwnedCallableBindings(Vector<string> names) {
        Vector<string> keys = self.ownedCallableBindings.keys();
        int i = 0;
        while (i < keys.len) {
            string name = keys.get(i);
            if (self.ownedCallableBindings.get(name)) { names.push(name); }
            i = i + 1;
        }
    }

    public void snapshotAmbiguousCallableBindings(Vector<string> names) {
        Vector<string> keys = self.ambiguousCallableBindings.keys();
        int i = 0;
        while (i < keys.len) {
            string name = keys.get(i);
            if (self.ambiguousCallableBindings.get(name)) {
                names.push(name);
            }
            i = i + 1;
        }
    }

    public void restoreOwnedCallableBindings(Vector<string> names) {
        Vector<string> keys = self.ownedCallableBindings.keys();
        int i = 0;
        while (i < keys.len) {
            self.ownedCallableBindings.remove(keys.get(i));
            i = i + 1;
        }
        i = 0;
        while (i < names.len) {
            self.ownedCallableBindings.put(names.get(i), true);
            i = i + 1;
        }
    }

    public void restoreAmbiguousCallableBindings(Vector<string> names) {
        Vector<string> keys = self.ambiguousCallableBindings.keys();
        int i = 0;
        while (i < keys.len) {
            self.ambiguousCallableBindings.remove(keys.get(i));
            i = i + 1;
        }
        i = 0;
        while (i < names.len) {
            self.ambiguousCallableBindings.put(names.get(i), true);
            i = i + 1;
        }
    }

    public CallableFlowSnapshot snapshotCallableFlow() {
        CallableFlowSnapshot flow = CallableFlowSnapshot();
        self.snapshotOwnedCallableBindings(flow.owned);
        self.snapshotAmbiguousCallableBindings(flow.ambiguous);
        return flow;
    }

    public void restoreCallableFlow(CallableFlowSnapshot flow) {
        self.restoreOwnedCallableBindings(flow.owned);
        self.restoreAmbiguousCallableBindings(flow.ambiguous);
    }

    public bool callableFlowHas(Vector<string> names, string name) {
        int i = 0;
        while (i < names.len) {
            if (names.get(i) == name) { return true; }
            i = i + 1;
        }
        return false;
    }

    public int callableFlowAbi(CallableFlowSnapshot flow, string name) {
        if (self.callableFlowHas(flow.ambiguous, name)) { return 2; }
        if (self.callableFlowHas(flow.owned, name)) { return 1; }
        return 0;
    }

    public void appendCallableFlowKeys(
            CallableFlowSnapshot flow, Vector<string> keys) {
        int i = 0;
        while (i < flow.owned.len) {
            string name = flow.owned.get(i);
            if (!self.callableFlowHas(keys, name)) { keys.push(name); }
            i = i + 1;
        }
        i = 0;
        while (i < flow.ambiguous.len) {
            string name = flow.ambiguous.get(i);
            if (!self.callableFlowHas(keys, name)) { keys.push(name); }
            i = i + 1;
        }
    }

    public void joinCallableFlows(Vector<CallableFlowSnapshot> flows) {
        if (flows.len == 0) { return; }
        Vector<string> keys = [];
        int i = 0;
        while (i < flows.len) {
            self.appendCallableFlowKeys(flows.get(i), keys);
            i = i + 1;
        }
        CallableFlowSnapshot joined = CallableFlowSnapshot();
        i = 0;
        while (i < keys.len) {
            string name = keys.get(i);
            int abi = self.callableFlowAbi(flows.get(0), name);
            int path = 1;
            while (path < flows.len) {
                if (self.callableFlowAbi(flows.get(path), name) != abi) {
                    abi = 2;
                }
                path = path + 1;
            }
            if (abi == 1) { joined.owned.push(name); }
            else if (abi == 2) { joined.ambiguous.push(name); }
            i = i + 1;
        }
        self.restoreCallableFlow(joined);
    }

    public CallableFlowSnapshot callableFlowForNames(
            Vector<string> names) {
        CallableFlowSnapshot flow = CallableFlowSnapshot();
        int index = 0;
        while (index < names.len) {
            string name = names.get(index);
            int abi = self.callableBindingAbi(name);
            if (abi == 1) { flow.owned.push(name); }
            else if (abi == 2) { flow.ambiguous.push(name); }
            index = index + 1;
        }
        return flow;
    }

    public CallableExceptionalCapture beginExceptionalCallableCapture(
            Map<string, Node> varTypes) {
        CallableExceptionalCapture capture =
            CallableExceptionalCapture();
        Vector<string> names = varTypes.keys();
        int index = 0;
        while (index < names.len) {
            string name = names.get(index);
            Node? type = resolveTypedefType(
                varTypes.get(name), self.analyzed.typedefTable);
            if (type != null && type.base == "__fn_ptr") {
                capture.names.push(name);
            }
            index = index + 1;
        }
        self.callableExceptionCaptures.push(capture);
        self.recordExceptionalCallableFlow();
        return capture;
    }

    public void finishExceptionalCallableCapture(
            CallableExceptionalCapture capture) {
        if (self.callableExceptionCaptures.len == 0) {
            print("internal compiler error: unmatched callable exception capture");
            abortGen();
        }
        CallableExceptionalCapture active =
            self.callableExceptionCaptures.pop();
        if (active != capture) {
            print("internal compiler error: callable exception captures must be nested");
            abortGen();
        }
    }

    public void recordExceptionalCallableFlow() {
        int index = 0;
        while (index < self.callableExceptionCaptures.len) {
            CallableExceptionalCapture capture =
                self.callableExceptionCaptures.get(index);
            capture.states.push(
                self.callableFlowForNames(capture.names));
            index = index + 1;
        }
    }

    public CallableFlowSnapshot beginCallableScope() {
        CallableFlowSnapshot enclosing = self.snapshotCallableFlow();
        self.callableScopeStarts.push(
            self.callableScopeDeclarations.len);
        return enclosing;
    }

    public void recordCallableDeclaration(string name) {
        if (self.callableScopeStarts.len > 0) {
            self.callableScopeDeclarations.push(name);
        }
        self.setCallableBindingAbi(name, 0);
    }

    public bool callableDeclaredSince(int start, string name) {
        int i = start;
        while (i < self.callableScopeDeclarations.len) {
            if (self.callableScopeDeclarations.get(i) == name) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    public void finishCallableScope(CallableFlowSnapshot enclosing) {
        int start = self.callableScopeDeclarations.len;
        if (self.callableScopeStarts.len > 0) {
            start = self.callableScopeStarts.pop();
        }
        CallableFlowSnapshot current = self.snapshotCallableFlow();
        Vector<string> keys = [];
        self.appendCallableFlowKeys(enclosing, keys);
        self.appendCallableFlowKeys(current, keys);
        self.restoreCallableFlow(enclosing);
        int i = 0;
        while (i < keys.len) {
            string name = keys.get(i);
            if (!self.callableDeclaredSince(start, name)) {
                self.setCallableBindingAbi(
                    name, self.callableFlowAbi(current, name));
            }
            i = i + 1;
        }
        while (self.callableScopeDeclarations.len > start) {
            self.callableScopeDeclarations.pop();
        }
    }

    public void snapshotClosureEnvs(
            Vector<string> names, Vector<string> functions,
            Vector<string> environments) {
        Vector<string> keys = self.fnPtrEnvFn.keys();
        int i = 0;
        while (i < keys.len) {
            string name = keys.get(i);
            names.push(name);
            functions.push(self.fnPtrEnvFn.get(name));
            environments.push(self.fnPtrEnvVar.get(name));
            i = i + 1;
        }
    }

    public void clearClosureEnvs() {
        Vector<string> keys = self.fnPtrEnvFn.keys();
        int i = 0;
        while (i < keys.len) {
            self.fnPtrEnvFn.put(keys.get(i), "");
            self.fnPtrEnvVar.put(keys.get(i), "");
            i = i + 1;
        }
    }

    public void restoreClosureEnvs(
            Vector<string> names, Vector<string> functions,
            Vector<string> environments) {
        self.clearClosureEnvs();
        int i = 0;
        while (i < names.len) {
            self.fnPtrEnvFn.put(names.get(i), functions.get(i));
            self.fnPtrEnvVar.put(names.get(i), environments.get(i));
            i = i + 1;
        }
    }

    /* Resolve a body-level TypeExpr through the active generic type map (so `T`
     * -> the concrete element type) while lowering a monomorphized generic
     * method body; identity otherwise. */
    public Node resolveBodyType(Node? t) {
        if (self.inGenericMethod) { return resolveGenericType(t, self.activeTypeMap); }
        if (t == null) { return makePrimType("void"); }
        return t;
    }

    public void useHelper(string name) {
        self.usedHelpers.put(name, true);
    }

    public void pushControlContext(string kind) {
        self.controlContext.push(kind);
        self.controlManagedStarts.push(self.managedStack.len);
        self.controlCleanupStarts.push(self.cleanupMarkers.len);
    }

    public void popControlContext() {
        if (self.controlContext.len > 0) {
            self.controlContext.pop();
            self.controlManagedStarts.pop();
            self.controlCleanupStarts.pop();
        }
    }

    /* Count try frames crossed before the nearest loop (continue) or nearest
     * loop/switch (break). */
    public int exitedTryDepth(bool switchIsTarget) {
        int depth = 0;
        int i = self.controlContext.len - 1;
        while (i >= 0) {
            string kind = self.controlContext.get(i);
            if (kind == "loop" || (switchIsTarget && kind == "switch")) {
                return depth;
            }
            if (kind == "try") { depth = depth + 1; }
            i = i - 1;
        }
        return 0;
    }

    /* Managed locals crossed before the nearest loop (continue) or nearest
     * loop/switch (break), in declaration order. */
    public Vector<Managed> getControlManagedVars(bool switchIsTarget) {
        Vector<Managed> out = [];
        int context = self.controlContext.len - 1;
        while (context >= 0) {
            string kind = self.controlContext.get(context);
            if (kind == "loop" || (switchIsTarget && kind == "switch")) {
                int start = self.controlManagedStarts.get(context);
                int i = start;
                while (i < self.managedStack.len) {
                    out.push(self.managedStack.get(i));
                    i = i + 1;
                }
                return out;
            }
            context = context - 1;
        }
        return out;
    }

    public string pushCleanupScope() {
        string marker = "";
        if (self.programHasExceptions) {
            marker = self.freshTemp("__btrc_cleanup_scope");
        }
        self.cleanupMarkers.push(marker);
        return marker;
    }

    public void popCleanupScope() {
        if (self.cleanupMarkers.len > 0) {
            string marker = self.cleanupMarkers.pop();
            if (marker != "") { self.activeCleanupMarkers.remove(marker); }
        }
    }

    public void markCleanupRegistration() {
        if (self.cleanupMarkers.len == 0) { return; }
        string marker = self.cleanupMarkers.get(
            self.cleanupMarkers.len - 1);
        if (marker != "") { self.activeCleanupMarkers.put(marker, true); }
    }

    public bool cleanupScopeIsActive(string marker) {
        return marker != "" && self.activeCleanupMarkers.has(marker);
    }

    public string getControlCleanupMarker(bool switchIsTarget) {
        int context = self.controlContext.len - 1;
        while (context >= 0) {
            string kind = self.controlContext.get(context);
            if (kind == "loop" || (switchIsTarget && kind == "switch")) {
                int scope = self.controlCleanupStarts.get(context);
                while (scope < self.cleanupMarkers.len) {
                    string marker = self.cleanupMarkers.get(scope);
                    if (self.cleanupScopeIsActive(marker)) { return marker; }
                    scope = scope + 1;
                }
                return "";
            }
            context = context - 1;
        }
        return "";
    }

    public string getReturnCleanupMarker() {
        int scope = 0;
        while (scope < self.cleanupMarkers.len) {
            string marker = self.cleanupMarkers.get(scope);
            if (self.cleanupScopeIsActive(marker)) { return marker; }
            scope = scope + 1;
        }
        return "";
    }

    /* fresh_temp: unique name "{prefix}_{n}" (mirrors generator.fresh_temp). */
    public string freshTemp(string prefix) {
        self.tempCounter = self.tempCounter + 1;
        return prefix + "_" + Strings.fromInt(self.tempCounter);
    }

    /* --- ARC managed-variable scope tracking --- */

    public void pushManagedScope() {
        self.scopeStarts.push(self.managedStack.len);
    }

    /* Pop the current scope, returning its managed vars in declaration order. */
    public Vector<Managed> popManagedScope() {
        Vector<Managed> out = [];
        if (self.scopeStarts.len == 0) { return out; }
        int start = self.scopeStarts.pop();
        int i = start;
        while (i < self.managedStack.len) {
            out.push(self.managedStack.get(i));
            i = i + 1;
        }
        /* Truncate the flat stack back to the scope start. */
        int extra = self.managedStack.len - start;
        int k = 0;
        while (k < extra) { self.managedStack.pop(); k = k + 1; }
        return out;
    }

    public void registerManagedVar(string name, string cls) {
        self.managedStack.push(Managed(name, cls));
    }

    public void registerThreadVar(string name) {
        Managed owner = Managed(name, "");
        owner.cleanupKind = "thread";
        self.managedStack.push(owner);
    }

    public string localCleanupKind(string name) {
        int index = self.managedStack.len - 1;
        while (index >= 0) {
            Managed owner = self.managedStack.get(index);
            if (owner.name == name) { return owner.cleanupKind; }
            index = index - 1;
        }
        return "";
    }

    public Vector<string> snapshotBorrowedLocalBindings() {
        Vector<string> snapshot = [];
        Vector<string> names = self.borrowedLocalBindings.keys();
        int index = 0;
        while (index < names.len) {
            snapshot.push(names.get(index));
            index = index + 1;
        }
        return snapshot;
    }

    public void restoreBorrowedLocalBindings(Vector<string> snapshot) {
        Vector<string> names = self.borrowedLocalBindings.keys();
        int index = 0;
        while (index < names.len) {
            self.borrowedLocalBindings.remove(names.get(index));
            index = index + 1;
        }
        index = 0;
        while (index < snapshot.len) {
            self.borrowedLocalBindings.put(snapshot.get(index), true);
            index = index + 1;
        }
    }

    /* Start a fresh function/method body: clear the funcVarDecls accumulator in
     * place (no reassignment — see ScopeSnapshot's note on alias-free) so the
     * try/catch volatile pass only marks THIS body's locals. Mirrors the
     * `gen._func_var_decls = []` reset at every body-lowering entry point. */
    public void resetFuncVarDecls() {
        while (self.funcVarDecls.len > 0) { self.funcVarDecls.pop(); }
    }

    /* Begin lowering an isolated body (a lifted lambda / thread wrapper). Snapshot
     * the current managed stack + scope starts into a fresh ScopeSnapshot (by
     * copying entries, NOT aliasing the field pointer), then clear the live
     * fields IN PLACE so the body lowers in an empty managed/return context.
     * Mirrors the reference saving + clearing _managed_vars_stack around a lambda
     * body; the in-place clear avoids btrcc's alias-free bug (reassigning a
     * collection field releases the old vector, which a plain saved alias does
     * not keep alive). */
    public ScopeSnapshot enterIsolatedScope(string retC, Node? retType) {
        ScopeSnapshot snap = ScopeSnapshot();
        snap.retC = self.currentReturnCType;
        snap.retType = self.currentReturnTypeNode;
        snap.retOwned = self.currentReturnOwned;
        snap.tryDepth = self.inTryDepth;
        snap.trycatchDepth = self.inTrycatchDepth;
        int i = 0;
        while (i < self.managedStack.len) {
            Managed mv = self.managedStack.get(i);
            Managed copy = Managed(mv.name, mv.cls);
            copy.cleanupKind = mv.cleanupKind;
            snap.managed.push(copy);
            i = i + 1;
        }
        int j = 0;
        while (j < self.scopeStarts.len) {
            snap.starts.push(self.scopeStarts.get(j));
            j = j + 1;
        }
        int l = 0;
        while (l < self.loopScopeDepths.len) {
            snap.loops.push(self.loopScopeDepths.get(l));
            l = l + 1;
        }
        int c = 0;
        while (c < self.controlContext.len) {
            snap.controls.push(self.controlContext.get(c));
            snap.controlManagedStarts.push(self.controlManagedStarts.get(c));
            snap.controlCleanupStarts.push(self.controlCleanupStarts.get(c));
            c = c + 1;
        }
        int cm = 0;
        while (cm < self.cleanupMarkers.len) {
            snap.cleanupMarkers.push(self.cleanupMarkers.get(cm));
            cm = cm + 1;
        }
        int k = 0;
        while (k < self.funcVarDecls.len) {
            snap.funcVarDecls.push(self.funcVarDecls.get(k));
            k = k + 1;
        }
        self.snapshotClosureEnvs(
            snap.closureNames,
            snap.closureFunctions,
            snap.closureEnvironments);
        self.snapshotOwnedCallableBindings(snap.ownedCallableNames);
        self.snapshotAmbiguousCallableBindings(
            snap.ambiguousCallableNames);
        int callableDeclaration = 0;
        while (callableDeclaration
                < self.callableScopeDeclarations.len) {
            snap.callableDeclarations.push(
                self.callableScopeDeclarations.get(
                    callableDeclaration));
            callableDeclaration = callableDeclaration + 1;
        }
        int callableStart = 0;
        while (callableStart < self.callableScopeStarts.len) {
            snap.callableScopeStarts.push(
                self.callableScopeStarts.get(callableStart));
            callableStart = callableStart + 1;
        }
        int callableCapture = 0;
        while (callableCapture
                < self.callableExceptionCaptures.len) {
            snap.callableExceptionCaptures.push(
                self.callableExceptionCaptures.get(
                    callableCapture));
            callableCapture = callableCapture + 1;
        }
        Vector<string> borrowed = self.snapshotBorrowedLocalBindings();
        int borrowedIndex = 0;
        while (borrowedIndex < borrowed.len) {
            snap.borrowedLocalBindings.push(
                borrowed.get(borrowedIndex));
            borrowedIndex = borrowedIndex + 1;
        }
        /* Clear the live fields in place (no reassignment). */
        while (self.managedStack.len > 0) { self.managedStack.pop(); }
        while (self.scopeStarts.len > 0) { self.scopeStarts.pop(); }
        while (self.loopScopeDepths.len > 0) { self.loopScopeDepths.pop(); }
        while (self.controlContext.len > 0) { self.controlContext.pop(); }
        while (self.controlManagedStarts.len > 0) { self.controlManagedStarts.pop(); }
        while (self.cleanupMarkers.len > 0) { self.cleanupMarkers.pop(); }
        while (self.controlCleanupStarts.len > 0) { self.controlCleanupStarts.pop(); }
        while (self.funcVarDecls.len > 0) { self.funcVarDecls.pop(); }
        self.clearClosureEnvs();
        Vector<string> noOwnedCallables = [];
        self.restoreOwnedCallableBindings(noOwnedCallables);
        Vector<string> noAmbiguousCallables = [];
        self.restoreAmbiguousCallableBindings(
            noAmbiguousCallables);
        while (self.callableScopeDeclarations.len > 0) {
            self.callableScopeDeclarations.pop();
        }
        while (self.callableScopeStarts.len > 0) {
            self.callableScopeStarts.pop();
        }
        while (self.callableExceptionCaptures.len > 0) {
            self.callableExceptionCaptures.pop();
        }
        Vector<string> noBorrowedBindings = [];
        self.restoreBorrowedLocalBindings(noBorrowedBindings);
        self.inTryDepth = 0;
        self.inTrycatchDepth = 0;
        self.currentReturnCType = retC;
        self.currentReturnTypeNode = retType;
        self.currentReturnOwned = true;
        return snap;
    }

    /* End an isolated body: clear the live fields in place and refill them from
     * the snapshot, then restore the return context. */
    public void exitIsolatedScope(ScopeSnapshot snap) {
        while (self.managedStack.len > 0) { self.managedStack.pop(); }
        while (self.scopeStarts.len > 0) { self.scopeStarts.pop(); }
        while (self.loopScopeDepths.len > 0) { self.loopScopeDepths.pop(); }
        while (self.controlContext.len > 0) { self.controlContext.pop(); }
        while (self.controlManagedStarts.len > 0) { self.controlManagedStarts.pop(); }
        while (self.cleanupMarkers.len > 0) { self.cleanupMarkers.pop(); }
        while (self.controlCleanupStarts.len > 0) { self.controlCleanupStarts.pop(); }
        int i = 0;
        while (i < snap.managed.len) {
            Managed mv = snap.managed.get(i);
            Managed copy = Managed(mv.name, mv.cls);
            copy.cleanupKind = mv.cleanupKind;
            self.managedStack.push(copy);
            i = i + 1;
        }
        int j = 0;
        while (j < snap.starts.len) {
            self.scopeStarts.push(snap.starts.get(j));
            j = j + 1;
        }
        int l = 0;
        while (l < snap.loops.len) {
            self.loopScopeDepths.push(snap.loops.get(l));
            l = l + 1;
        }
        int c = 0;
        while (c < snap.controls.len) {
            self.controlContext.push(snap.controls.get(c));
            self.controlManagedStarts.push(snap.controlManagedStarts.get(c));
            self.controlCleanupStarts.push(snap.controlCleanupStarts.get(c));
            c = c + 1;
        }
        int cm = 0;
        while (cm < snap.cleanupMarkers.len) {
            self.cleanupMarkers.push(snap.cleanupMarkers.get(cm));
            cm = cm + 1;
        }
        while (self.funcVarDecls.len > 0) { self.funcVarDecls.pop(); }
        int k = 0;
        while (k < snap.funcVarDecls.len) {
            self.funcVarDecls.push(snap.funcVarDecls.get(k));
            k = k + 1;
        }
        self.restoreClosureEnvs(
            snap.closureNames,
            snap.closureFunctions,
            snap.closureEnvironments);
        self.restoreOwnedCallableBindings(snap.ownedCallableNames);
        self.restoreAmbiguousCallableBindings(
            snap.ambiguousCallableNames);
        while (self.callableScopeDeclarations.len > 0) {
            self.callableScopeDeclarations.pop();
        }
        int callableDeclaration = 0;
        while (callableDeclaration < snap.callableDeclarations.len) {
            self.callableScopeDeclarations.push(
                snap.callableDeclarations.get(callableDeclaration));
            callableDeclaration = callableDeclaration + 1;
        }
        while (self.callableScopeStarts.len > 0) {
            self.callableScopeStarts.pop();
        }
        int callableStart = 0;
        while (callableStart < snap.callableScopeStarts.len) {
            self.callableScopeStarts.push(
                snap.callableScopeStarts.get(callableStart));
            callableStart = callableStart + 1;
        }
        while (self.callableExceptionCaptures.len > 0) {
            self.callableExceptionCaptures.pop();
        }
        int callableCapture = 0;
        while (callableCapture
                < snap.callableExceptionCaptures.len) {
            self.callableExceptionCaptures.push(
                snap.callableExceptionCaptures.get(
                    callableCapture));
            callableCapture = callableCapture + 1;
        }
        self.restoreBorrowedLocalBindings(
            snap.borrowedLocalBindings);
        self.currentReturnCType = snap.retC;
        self.currentReturnTypeNode = snap.retType;
        self.currentReturnOwned = snap.retOwned;
        self.inTryDepth = snap.tryDepth;
        self.inTrycatchDepth = snap.trycatchDepth;
    }

    /* Register every managed local in an exception-capable program: a throw may
     * cross this function into a caller-owned try frame. Normal scope/function
     * exits discard the slot after ordinary ARC release. Marks
     * the matching IRVarDecl volatile so the `var = NULL` after delete is not
     * optimized away (avoids a double-free). Mirrors
     * variables._maybe_register_cleanup. */
    public void maybeRegisterCleanup(string varName, string destroyFn,
            string clsName, Vector<IRNode> stmts) {
        if (!self.programHasExceptions) { return; }
        if (clsName == irManagedStringRuntimeType()) {
            self.maybeRegisterDirectCleanup(varName, destroyFn, stmts);
            return;
        }
        self.markCleanupRegistration();
        IRNode declaration = requireCleanupSlotDeclaration(
            stmts, varName);
        /* Pass the exact layout visitor so a throw can traverse owned fields.
         * Layouts without outgoing managed edges pass NULL. */
        IRNode visitor = irLiteral("NULL");
        if (clsName != "" && managedClassNeedsVisitor(self, clsName)) {
            visitor = irVar(cycleVisitorName(clsName));
        }
        stmts.push(irExprStmt(registerCleanupSlot(self, declaration,
            irVar(destroyFn), visitor, false)));
    }

    public void maybeRegisterDirectCleanup(string varName, string cleanupFn,
            Vector<IRNode> stmts) {
        if (!self.programHasExceptions) { return; }
        self.markCleanupRegistration();
        IRNode declaration = requireCleanupSlotDeclaration(
            stmts, varName);
        self.useHelper(cleanupFn);
        stmts.push(irExprStmt(registerCleanupSlot(self, declaration,
            irVar(cleanupFn), null, true)));
    }

    /* Drop a variable from auto-management across all open scopes (the user is
     * managing it manually). Rebuilds the flat managedStack without `name` and
     * shifts each scope-start marker down by the count of removed entries that
     * preceded it, so scope boundaries stay valid. Mirrors
     * generator.unregister_managed_var. */
    public void unregisterManagedVar(string name) {
        Vector<Managed> kept = [];
        /* removedBefore[k] = number of entries removed at flat indices < k. */
        int removedSoFar = 0;
        Vector<int> removedBeforeIndex = [];
        int i = 0;
        while (i < self.managedStack.len) {
            removedBeforeIndex.push(removedSoFar);
            Managed mv = self.managedStack.get(i);
            if (mv.name == name) { removedSoFar = removedSoFar + 1; }
            else { kept.push(mv); }
            i = i + 1;
        }
        if (removedSoFar == 0) { return; }
        self.managedStack = kept;
        /* Shift every scope-start marker down by how many removed entries were
         * strictly before it. */
        int s = 0;
        while (s < self.scopeStarts.len) {
            int start = self.scopeStarts.get(s);
            int shift = removedSoFar;
            if (start < removedBeforeIndex.len) { shift = removedBeforeIndex.get(start); }
            self.scopeStarts.set(s, start - shift);
            s = s + 1;
        }
        /* Likewise for loop-scope markers. */
        int l = 0;
        while (l < self.loopScopeDepths.len) {
            int d = self.loopScopeDepths.get(l);
            int shift = removedSoFar;
            if (d < removedBeforeIndex.len) { shift = removedBeforeIndex.get(d); }
            self.loopScopeDepths.set(l, d - shift);
            l = l + 1;
        }
        int c = 0;
        while (c < self.controlManagedStarts.len) {
            int d = self.controlManagedStarts.get(c);
            int shift = removedSoFar;
            if (d < removedBeforeIndex.len) { shift = removedBeforeIndex.get(d); }
            self.controlManagedStarts.set(c, d - shift);
            c = c + 1;
        }
        self.borrowedLocalBindings.put(name, true);
    }

    /* All managed vars across all open scopes, in declaration order. */
    public Vector<Managed> getAllManagedVars() {
        Vector<Managed> out = [];
        int i = 0;
        while (i < self.managedStack.len) {
            out.push(self.managedStack.get(i));
            i = i + 1;
        }
        return out;
    }

    /* Mark the managedStack length that belongs outside the current loop body.
     * Mirrors generator.push_loop_scope. */
    public void pushLoopScope() {
        self.loopScopeDepths.push(self.managedStack.len);
    }

    /* Remove the current loop-body scope marker. Mirrors pop_loop_scope. */
    public void popLoopScope() {
        if (self.loopScopeDepths.len > 0) { self.loopScopeDepths.pop(); }
    }

    /* Managed vars a break/continue must release: everything declared since the
     * innermost loop body began. Mirrors generator.get_loop_managed_vars. */
    public Vector<Managed> getLoopManagedVars() {
        Vector<Managed> out = [];
        if (self.loopScopeDepths.len == 0) { return out; }
        int start = self.loopScopeDepths.get(self.loopScopeDepths.len - 1);
        int i = start;
        while (i < self.managedStack.len) {
            out.push(self.managedStack.get(i));
            i = i + 1;
        }
        return out;
    }

    public IRModule generate(Node prog) {
        IRModule m = IRModule();
        self.curModule = m;
        self.packAlignments = declarationPackAlignments(prog);
        addStandardPreprocessorDecls(m);
        /* setjmp.h is required (after the standard prologue, before the stdlib's
         * own #include directives) whenever any declaration uses try/catch or
         * throw — mirrors generator._emit_includes scanning _uses_trycatch. */
        self.programHasExceptions = programUsesTrycatch(prog);
        if (self.programHasExceptions) { requireSystemInclude(m, "setjmp.h"); }
        self.emitForwardDecls(prog, m);
        registerGpuKernels(self, prog, m);
        self.emitGenericInstances(m);
        self.emitMethodGenericInstances(m);
        self.emitDeclarations(prog, m);
        self.emitFunctionPointerTypedefs(m);
        finalizeCleanupTakeAdapters(self, m);
        applySetjmpVolatility(m);
        validateCleanupSlots(m);
        /* Stage 5 — reachability DCE (functions then structs), then helpers.
         * Mirrors optimizer.optimize: dead helpers are pruned via usedHelpers
         * tracking in collectHelpers (called last). */
        optimizeModule(m);
        installProgramCycleBoundary(self, m);
        consumeUnusedParameters(m);
        self.collectHelpers(m);
        return m;
    }

    /* Materialize every callback TypeExpr registered by typeToC as a typed
     * declaration. The loop intentionally observes newly appended entries so
     * nested function-pointer types are emitted deterministically too. */
    public void emitFunctionPointerTypedefs(IRModule m) {
        int index = 0;
        while (index < self.analyzed.fnPtrOrder.len) {
            string name = self.analyzed.fnPtrOrder.get(index);
            Node typeExpr = self.analyzed.fnPtrTypes.get(name);
            string returnType = "void";
            if (typeExpr.generic_args.len > 0) {
                returnType = typeToC(
                    typeExpr.generic_args.get(0), self.analyzed);
            }
            IRFunctionPointerTypedef declaration =
                IRFunctionPointerTypedef(name, returnType);
            int parameter = 1;
            while (parameter < typeExpr.generic_args.len) {
                declaration.param_types.push(typeToC(
                    typeExpr.generic_args.get(parameter), self.analyzed));
                parameter = parameter + 1;
            }
            m.function_pointer_typedefs.push(declaration);
            index = index + 1;
        }
    }

    /* Emit all top-level declarations in source order: classes lower to a struct
     * def + method forward decls + init/new/destroy/methods functions; functions
     * lower to a single function. Mirrors _emit_declarations. */
    public void emitDeclarations(Node prog, IRModule m) {
        lowerTypedefDeclarations(prog, m, self.analyzed);
        Vector<Node> orderedStructs = semanticOrderedStructDefinitions(
            prog, self.analyzed.structTable);
        int structIndex = 0;
        while (structIndex < orderedStructs.len) {
            self.emitStructDecl(orderedStructs.get(structIndex), m);
            structIndex = structIndex + 1;
        }
        int i = 0;
        while (i < prog.declarations.len) {
            Node d = prog.declarations.get(i);
            if (d.kind == NK_CLASS_DECL) {
                if (d.generic_params.len == 0) { self.emitClassDecl(d, m); }
            } else if (d.kind == NK_FUNCTION_DECL) {
                if (d.is_gpu) {
                    emitGpuCpuFallback(self, d, m);
                    i = i + 1;
                    continue;
                }
                /* Bodyless FunctionDecl (e.g. `bool is_even(int n);`) is a
                 * forward declaration, NOT a definition. Emit a typed callable
                 * declaration and skip function_defs — otherwise we'd emit an
                 * empty-bodied definition that collides with the real one
                 * (mirrors functions.emit_function_decl: body is None branch). */
                if (d.body_node == null) {
                    string fret = typeToC(d.return_type, self.analyzed);
                    if (fret == "") { fret = "void"; }
                    IRFunctionDecl declaration =
                        IRFunctionDecl(d.name, fret, false);
                    int fp = 0;
                    while (fp < d.params.len) {
                        Node pp = d.params.get(fp);
                        declaration.params.push(IRParam(
                            typeToC(pp.type, self.analyzed), pp.name));
                        fp = fp + 1;
                    }
                    m.function_decls.push(declaration);
                } else {
                    m.functions.push(self.lowerFunction(d));
                }
            } else if (d.kind == NK_STRUCT_DECL) {
                /* Forward tags were emitted in phase one; complete definitions
                 * were lowered above in by-value dependency order. */
            } else if (d.kind == NK_ENUM_DECL) {
                self.emitEnumDecl(d, m);
            } else if (d.kind == NK_RICH_ENUM_DECL) {
                self.emitRichEnumDecl(d, m);
            } else if (d.kind == NK_TYPEDEF_DECL) {
                /* Already lowered above in dependency order. */
            } else if (d.kind == NK_VAR_DECL_STMT) {
                bool redundantExtern = d.type != null && d.type.is_extern
                    && d.initializer == null
                    && self.analyzed.globalHasDefinition.has(d.name);
                if (!redundantExtern) { self.emitGlobalVar(d, m); }
            } else if (d.kind == NK_PREPROCESSOR_DIRECTIVE) {
                self.emitPreprocessor(d, m);
            }
            i = i + 1;
        }
    }

    /* Emit a plain enum (NK_ENUM_DECL) as a typed enum declaration plus a
     * static `<Name>_toString` switch function. */
    public void emitEnumDecl(Node d, IRModule m) {
        string name = d.name;
        IREnumDef definition = IREnumDef(name);
        Map<string, bool> priorMembers = {};
        int i = 0;
        while (i < d.values.len) {
            Node v = d.values.get(i);
            IRNode value = null;
            if (v.value_node != null) {
                Map<string, Node> empty = {};
                self.inEnumInitializer = true;
                self.enumLoweringOwner = name;
                self.enumLoweringMembers = priorMembers;
                value = self.lowerExpr(v.value_node, empty);
                self.inEnumInitializer = false;
                self.enumLoweringOwner = "";
                self.enumLoweringMembers = {};
            }
            string emittedName = v.name;
            if (name != "") { emittedName = name + "_" + v.name; }
            definition.values.push(IREnumValue(
                emittedName, value));
            priorMembers.put(v.name, true);
            i = i + 1;
        }
        m.enum_defs.push(definition);
        /* static const char* Name_toString(Name val) { switch (val) {...} }.
         * It is an ordinary structured function, so reachability DCE prunes it
         * when unused. An anonymous enum (empty name) has no
         * usable toString name, so skip it entirely (the reference's `_toString`
         * is always dead and removed by DCE). */
        if (name != "") {
            m.functions.push(self.enumToStringFn(name, d.values, false));
        }
    }

    /* Emit a rich (tagged-union) enum (NK_RICH_ENUM_DECL): a tag enum, per-variant
     * data structs, a tagged-union struct, variant constructors, and a toString
     * function. Mirrors enums._emit_rich_enum. */
    public void emitRichEnumDecl(Node d, IRModule m) {
        string name = d.name;
        IREnumDef tagDefinition = IREnumDef(name + "_Tag");
        int i = 0;
        while (i < d.variants.len) {
            Node v = d.variants.get(i);
            tagDefinition.values.push(IREnumValue(
                name + "_" + v.name + "_TAG",
                irLiteral(Strings.fromInt(i))));
            i = i + 1;
        }
        m.enum_defs.push(tagDefinition);
        IRTaggedUnionDef tagged = IRTaggedUnionDef(name, name + "_Tag");
        int v2 = 0;
        while (v2 < d.variants.len) {
            Node v = d.variants.get(v2);
            IRTaggedUnionVariant variant = IRTaggedUnionVariant(v.name);
            int p = 0;
            while (p < v.params.len) {
                Node par = v.params.get(p);
                variant.fields.push(IRStructField(
                    typeToC(par.type, self.analyzed), par.name));
                p = p + 1;
            }
            tagged.variants.push(variant);
            v2 = v2 + 1;
        }
        m.tagged_union_defs.push(tagged);
        /* Variant constructors are ordinary IR functions so their field stores
         * participate in reachability and helper analysis. */
        int v4 = 0;
        while (v4 < d.variants.len) {
            Node v = d.variants.get(v4);
            IRFunction constructor = IRFunction();
            constructor.name = name + "_" + v.name;
            constructor.return_type = name;
            constructor.is_static = true;
            Vector<IRNode> constructorBody = [];
            constructorBody.push(irVarDecl(name, "__result", null));
            constructorBody.push(irAssign(
                irFieldAccess(irVar("__result"), "tag", false),
                irLiteral(name + "_" + v.name + "_TAG")));
            int p2 = 0;
            while (p2 < v.params.len) {
                Node par = v.params.get(p2);
                constructor.params.push(IRParam(
                    typeToC(par.type, self.analyzed), par.name));
                IRNode payload = irFieldAccess(
                    irFieldAccess(irVar("__result"), "data", false),
                    v.name, false);
                constructorBody.push(irAssign(
                    irFieldAccess(payload, par.name, false), irVar(par.name)));
                p2 = p2 + 1;
            }
            constructorBody.push(irReturn(irVar("__result")));
            constructor.body = irBlock(constructorBody);
            m.functions.push(constructor);
            v4 = v4 + 1;
        }
        /* toString over the tag field. Pushed into m.functions so DCE prunes it
         * when unused (mirrors enums._emit_rich_enum's function_defs.append). */
        m.functions.push(self.enumToStringFn(name, d.variants, true));
    }

    /* Build `<Name>_toString` as structured comparisons so aliases remain
     * valid and the function still flows through reachability DCE. */
    public IRFunction enumToStringFn(string name, Vector<Node> items, bool rich) {
        IRNode switchExpr = irVar("val");
        if (rich) { switchExpr = irFieldAccess(irVar("val"), "tag", false); }
        Vector<IRNode> bodyStmts = [];
        int i = 0;
        while (i < items.len) {
            Node it = items.get(i);
            string caseLabel = name + "_" + it.name;
            if (rich) { caseLabel = caseLabel + "_TAG"; }
            Vector<IRNode> matchBody = [];
            matchBody.push(irReturn(irLiteral("\"" + it.name + "\"")));
            bodyStmts.push(irIf(irBinOp(
                switchExpr, "==", irLiteral(caseLabel)),
                irBlock(matchBody), null));
            i = i + 1;
        }
        bodyStmts.push(irReturn(irLiteral("\"unknown\"")));
        IRFunction fn = IRFunction();
        fn.name = name + "_toString";
        fn.return_type = "const char*";
        fn.is_static = true;
        fn.params.push(IRParam(name, "val"));
        fn.body = irBlock(bodyStmts);
        return fn;
    }

    /* Emit a plain (raw C) `struct` definition -> IRStructDef (mirrors
     * emit_struct_decl). An array field (`int buf[8]`) encodes its size in the
     * field name and drops the array-ness from the element type. */
    public void emitStructDecl(Node d, IRModule m) {
        IRStructDef sd = IRStructDef();
        sd.name = d.name;
        string declarationKey = astNodeKey(d);
        if (self.packAlignments.has(declarationKey)) {
            sd.pack_alignment = self.packAlignments.get(declarationKey);
        }
        int i = 0;
        while (i < d.fields.len) {
            Node f = d.fields.get(i);
            if (f.type != null && f.type.is_array && f.type.array_size != null) {
                Node baseType = Node();
                baseType.kind = NK_TYPE_EXPR;
                baseType.base = f.type.base;
                baseType.generic_args = f.type.generic_args;
                baseType.pointer_depth = f.type.pointer_depth;
                Map<string, Node> empty = {};
                string sizeText = irExprText(self.lowerExpr(f.type.array_size, empty));
                sd.fields.push(IRStructField(typeToC(baseType, self.analyzed),
                    f.name + "[" + sizeText + "]"));
            } else {
                sd.fields.push(IRStructField(typeToC(f.type, self.analyzed), f.name));
            }
            i = i + 1;
        }
        m.struct_defs.push(sd);
    }

    /* Top-level variable -> file-scope C global (mirrors _emit_declarations'
     * VarDeclStmt branch). Default storage is `static` (file linkage); explicit
     * `extern`/`volatile` qualifiers layer on. `extern` is a declaration only —
     * never emit an initializer for it. */
    public void emitGlobalVar(Node d, IRModule m) {
        if (d.initializer != null) {
            Map<string, Node> globalTypes = {};
            self.rejectPersistentCallableEscape(
                d.type, d.initializer, globalTypes, "global storage");
        }
        if (d.type != null && d.type.is_array && d.type.array_size != null) {
            Node elementType = Node();
            elementType.kind = NK_TYPE_EXPR;
            elementType.base = d.type.base;
            elementType.generic_args = d.type.generic_args;
            elementType.pointer_depth = d.type.pointer_depth;
            elementType.is_const = d.type.is_const;
            IRGlobalDecl global = IRGlobalDecl(
                typeToC(elementType, self.analyzed), d.name);
            global.is_extern = d.type.is_extern;
            global.is_static = !d.type.is_extern;
            global.is_volatile = d.type.is_volatile;
            Map<string, Node> empty = {};
            global.array_size = self.lowerExpr(d.type.array_size, empty);
            if (d.initializer != null) {
                global.init = lowerStaticInitializer(
                    self, d.initializer, d.type, empty);
            }
            m.global_decls.push(global);
            return;
        }
        string ct = "int";
        if (d.type != null) { ct = typeToC(d.type, self.analyzed); }
        IRGlobalDecl global = IRGlobalDecl(ct, d.name);
        if (d.type != null) {
            global.is_extern = d.type.is_extern;
            global.is_static = !d.type.is_extern;
            global.is_volatile = d.type.is_volatile;
        }
        if (d.initializer != null && !global.is_extern) {
            Map<string, Node> empty = {};
            global.init = lowerStaticInitializer(
                self, d.initializer, d.type, empty);
        }
        m.global_decls.push(global);
    }

    /* A supported preprocessor directive becomes a validated typed declaration;
     * #pragma pack has already become per-struct metadata. */
    public void emitPreprocessor(Node d, IRModule m) {
        string text = preprocessorTrim(d.text);
        if (isPackPragma(text)) { return; }
        lowerPreprocessorDirective(d.text, m);
    }

    /* Emit all monomorphized generic instances (mirrors
     * generics.core.emit_generic_instances + user.py + user_methods.py for the
     * user-generic subset: macros, per-instance struct + fwd-decls + methods). */
    public void emitGenericInstances(IRModule m) {
        if (!self.analyzed.hasGenerics()) { return; }
        int i = 0;
        while (i < self.analyzed.genericInstances.len) {
            self.emitGenericInstance(self.analyzed.genericInstances.get(i), m);
            i = i + 1;
        }
    }

    /* Emit one generic instance: struct, typed callable declarations, then
     * init/new/destroy + methods (all `static`). */
    public void emitGenericInstance(GenInstance inst, IRModule m) {
        Node decl = self.analyzed.genericClassTable.get(inst.base);
        string mangled = inst.mangled;
        Map<string, Node> typeMap = {};
        int g = 0;
        while (g < decl.generic_params.len && g < inst.args.len) {
            typeMap.put(decl.generic_params.get(g), inst.args.get(g));
            g = g + 1;
        }

        /* ARC header, then resolved fields. */
        IRStructDef sd = IRStructDef();
        sd.name = mangled;
        appendArcHeaderField(self, sd);
        int fi = 0;
        while (fi < decl.members.len) {
            Node mem = decl.members.get(fi);
            string storage = instanceStorageName(mem);
            if (storage != "") {
                Node rt = resolveGenericType(mem.type, typeMap);
                sd.fields.push(IRStructField(
                    typeToC(rt, self.analyzed), storage));
            }
            fi = fi + 1;
        }
        m.struct_defs.push(sd);

        /* Constructor params (resolved). */
        Node? ctor = self.genericConstructor(decl);
        Vector<IRParam> ctorParams = [];
        if (ctor != null) {
            int p = 0;
            while (p < ctor.params.len) {
                Node pp = ctor.params.get(p);
                Node rt = resolveGenericType(pp.type, typeMap);
                ctorParams.push(IRParam(typeToC(rt, self.analyzed), pp.name));
                p = p + 1;
            }
        }

        IRFunctionDecl initDeclaration = IRFunctionDecl(
            mangled + "_init", "void", true);
        initDeclaration.params.push(IRParam(mangled + "*", "self"));
        int cp = 0;
        while (cp < ctorParams.len) {
            initDeclaration.params.push(ctorParams.get(cp));
            cp = cp + 1;
        }
        m.function_decls.push(initDeclaration);

        IRFunctionDecl newDeclaration = IRFunctionDecl(
            mangled + "_new", mangled + "*", true);
        int q = 0;
        while (q < ctorParams.len) {
            newDeclaration.params.push(ctorParams.get(q));
            q = q + 1;
        }
        m.function_decls.push(newDeclaration);

        IRFunctionDecl destroyDeclaration = IRFunctionDecl(
            mangled + "_destroy", "void", true);
        destroyDeclaration.params.push(IRParam("void*", "object"));
        m.function_decls.push(destroyDeclaration);
        int mi = 0;
        while (mi < decl.members.len) {
            Node mem = decl.members.get(mi);
            if (mem.kind == NK_METHOD_DECL && !mem.is_constructor
                    && mem.name != "__del__"
                    && mem.generic_params.len == 0) {
                Node rrt = resolveGenericType(mem.return_type, typeMap);
                string retC = typeToC(rrt, self.analyzed);
                IRFunctionDecl methodDeclaration = IRFunctionDecl(
                    mangled + "_" + mem.name, retC, true);
                methodDeclaration.params.push(IRParam(mangled + "*", "self"));
                int k = 0;
                while (k < mem.params.len) {
                    Node pp = mem.params.get(k);
                    Node rt = resolveGenericType(pp.type, typeMap);
                    methodDeclaration.params.push(IRParam(
                        typeToC(rt, self.analyzed), pp.name));
                    k = k + 1;
                }
                m.function_decls.push(methodDeclaration);
            }
            mi = mi + 1;
        }
        emitGenericPropertyForwardDecls(
            self, inst, decl, typeMap, m);

        /* Set context for body lowering: self -> the generic instance type, and
         * mark we're inside a generic method (raw operator lowering). */
        string savedClass = self.currentClass;
        string savedReturnC = self.currentReturnCType;
        Node? savedReturnType = self.currentReturnTypeNode;
        bool savedReturnOwned = self.currentReturnOwned;
        bool savedBatchExplicitReleases = self.batchExplicitReleases;
        bool savedCollectionEdgeKeeps = self.collectionEdgeKeeps;
        self.currentClass = mangled;
        self.inGenericMethod = true;
        self.activeTypeMap = typeMap;
        self.batchExplicitReleases = false;
        self.collectionEdgeKeeps = isPublicCollectionBase(inst.base);

        /* --- _init --- */
        IRFunction initFn = IRFunction();
        initFn.name = mangled + "_init";
        initFn.return_type = "void";
        initFn.is_static = true;
        initFn.params.push(IRParam(mangled + "*", "self"));
        int ip = 0;
        while (ip < ctorParams.len) { initFn.params.push(ctorParams.get(ip)); ip = ip + 1; }
        Vector<IRNode> ibody = [];
        appendArcHeaderInitialization(mangled, ibody);
        Vector<IRNode> ctorBodyStmts = [];
        if (ctor != null && ctor.body_node != null) {
            self.currentReturnCType = "void";
            self.currentReturnTypeNode = null;
            self.currentReturnOwned = true;
            self.currentReturnTypeNode = null;
            self.currentReturnOwned = true;
            self.resetFuncVarDecls();
            Map<string, Node> vt = self.genericMethodVarTypes(inst, ctor, typeMap);
            IRNode blk = self.lowerBlock(ctor.body_node, vt);
            int b = 0;
            while (b < blk.stmts.len) { ctorBodyStmts.push(blk.stmts.get(b)); b = b + 1; }
        }
        /* Empty ctor body -> (void)self; to avoid unused-param warning. */
        if (ctorBodyStmts.len == 0) {
            ctorBodyStmts.push(irExprStmt(irCast("void", irVar("self"))));
        }
        int cb = 0;
        while (cb < ctorBodyStmts.len) { ibody.push(ctorBodyStmts.get(cb)); cb = cb + 1; }
        initFn.body = irBlock(ibody);
        m.functions.push(initFn);

        /* --- _new --- */
        IRFunction newFn = IRFunction();
        newFn.name = mangled + "_new";
        newFn.return_type = mangled + "*";
        newFn.is_static = true;
        int np = 0;
        while (np < ctorParams.len) { newFn.params.push(ctorParams.get(np)); np = np + 1; }
        Vector<IRNode> nbody = [];
        Vector<IRNode> sizeofArgs = [];
        sizeofArgs.push(irVar(mangled));
        Vector<IRNode> mallocArgs = [];
        mallocArgs.push(irCall("sizeof", sizeofArgs));
        nbody.push(irVarDecl(mangled + "*", "self", irCast(mangled + "*", irCall("malloc", mallocArgs))));
        Vector<IRNode> memsetArgs = [];
        memsetArgs.push(irVar("self"));
        memsetArgs.push(irLiteral("0"));
        Vector<IRNode> sizeofArgs2 = [];
        sizeofArgs2.push(irVar(mangled));
        memsetArgs.push(irCall("sizeof", sizeofArgs2));
        nbody.push(irExprStmt(irCall("memset", memsetArgs)));
        string cleanupMark = beginConstructorCleanup(
            self, "self", mangled, nbody);
        Vector<IRNode> initArgs = [];
        initArgs.push(irVar("self"));
        int ia = 0;
        while (ia < ctorParams.len) { initArgs.push(irVar(ctorParams.get(ia).name)); ia = ia + 1; }
        nbody.push(irExprStmt(irCall(mangled + "_init", initArgs)));
        endConstructorCleanup(self, cleanupMark, nbody);
        nbody.push(irReturn(irVar("self")));
        newFn.body = irBlock(nbody);
        m.functions.push(newFn);

        /* --- _destroy --- (terminal destructor). If the class defines free()
         * (all stdlib collections do), destroy is the single terminal entry
         * point: `<mangled>_free(self)` does content cleanup (release elements,
         * free buffers, null fields), then `free(self)` frees the struct. We do
         * NOT also emit per-field releases in that case (free() already does it —
         * doing both double-releases). Otherwise (no free method) emit per-field
         * releases + free(self). Mirrors generics.user_methods destroy emission. */
        IRFunction dFn = IRFunction();
        dFn.name = mangled + "_destroy";
        dFn.return_type = "void";
        dFn.is_static = true;
        dFn.params.push(IRParam("void*", "object"));
        Vector<IRNode> dbody = [];
        dbody.push(irVarDecl(
            mangled + "*", "self", irCast(mangled + "*", irVar("object"))));
        if (self.analyzed.genericClassMethod(inst.base, "free") != null) {
            Vector<IRNode> freeSelfArgs = [];
            freeSelfArgs.push(irVar("self"));
            dbody.push(irExprStmt(irCall(mangled + "_free", freeSelfArgs)));
        } else {
            self.emitGenericFieldReleases(inst, decl, typeMap, dbody);
        }
        Vector<IRNode> freeArgs = [];
        freeArgs.push(irVar("self"));
        dbody.push(irExprStmt(irCall("free", freeArgs)));
        dFn.body = irBlock(dbody);
        m.functions.push(dFn);
        emitGenericCycleVisitor(self, inst, decl, typeMap, m);
        emitArcDescriptor(self, m, mangled,
            genericInstanceNeedsVisitor(self.analyzed, inst));

        /* --- methods --- */
        int m2 = 0;
        while (m2 < decl.members.len) {
            Node mem = decl.members.get(m2);
            if (mem.kind == NK_METHOD_DECL && !mem.is_constructor
                    && mem.name != "__del__"
                    && mem.generic_params.len == 0) {
                IRFunction fn = IRFunction();
                fn.name = mangled + "_" + mem.name;
                Node rrt = resolveGenericType(mem.return_type, typeMap);
                string retC = typeToC(rrt, self.analyzed);
                fn.return_type = retC;
                fn.is_static = true;
                fn.params.push(IRParam(mangled + "*", "self"));
                int mp2 = 0;
                while (mp2 < mem.params.len) {
                    Node pp = mem.params.get(mp2);
                    Node rt = resolveGenericType(pp.type, typeMap);
                    fn.params.push(IRParam(typeToC(rt, self.analyzed), pp.name));
                    mp2 = mp2 + 1;
                }
                self.currentReturnCType = retC;
                self.currentReturnTypeNode = rrt;
                self.currentReturnOwned = true;
                bool publicCollectionMethod =
                    isPublicCollectionBase(inst.base)
                    && mem.access == "public";
                bool topologyCollection = isPublicCollectionBase(inst.base)
                    && genericInstanceNeedsVisitor(self.analyzed, inst);
                self.batchExplicitReleases = publicCollectionMethod;
                Vector<IRNode> mbody = [];
                if (mem.body_node != null) {
                    self.resetFuncVarDecls();
                    Map<string, Node> vt = self.genericMethodVarTypes(inst, mem, typeMap);
                    IRNode blk = self.lowerBlock(mem.body_node, vt);
                    int b = 0;
                    while (b < blk.stmts.len) { mbody.push(blk.stmts.get(b)); b = b + 1; }
                }
                if (mbody.len == 0) {
                    mbody.push(irExprStmt(irCast("void", irVar("self"))));
                }
                fn.body = irBlock(mbody);
                if (topologyCollection) {
                    installCollectionTopologyBoundary(self, fn);
                }
                if (publicCollectionMethod) {
                    installReleaseBearingCycleBoundary(self, fn);
                }
                m.functions.push(fn);
            }
            m2 = m2 + 1;
        }
        emitGenericProperties(self, inst, decl, typeMap, m);
        self.currentClass = savedClass;
        self.currentReturnCType = savedReturnC;
        self.currentReturnTypeNode = savedReturnType;
        self.currentReturnOwned = savedReturnOwned;
        self.batchExplicitReleases = savedBatchExplicitReleases;
        self.collectionEdgeKeeps = savedCollectionEdgeKeeps;
        self.inGenericMethod = false;
        self.activeTypeMap = {};
    }

    /* Emit every monomorphized generic-METHOD function recorded by the analyzer.
     * Each is emitted with a combined type map binding both the class type
     * params (T, ...) and the method type params (U, ...) to the concrete types
     * for that call site. Bodies lower via the same generic-method machinery so
     * cross-type dispatch (e.g. building a Vector<U> inside the body) resolves.
     * Mirrors generics.methods_mono.emit_generic_method_instances. */
    public void emitMethodGenericInstances(IRModule m) {
        if (!self.analyzed.hasMethodGenerics()) { return; }
        int i = 0;
        while (i < self.analyzed.methodGenInstances.len) {
            self.emitOneMethodGenericInstance(self.analyzed.methodGenInstances.get(i), m);
            i = i + 1;
        }
    }

    public void emitOneMethodGenericInstance(MethodGenInstance inst, IRModule m) {
        /* Resolve the owning class decl + method. */
        bool ownerGeneric = self.analyzed.isGenericClass(inst.classBase);
        Node? decl = null;
        Node? method = null;
        if (ownerGeneric) {
            decl = self.analyzed.genericClassTable.get(inst.classBase);
            method = self.analyzed.genericClassMethod(inst.classBase, inst.methodName);
        } else {
            decl = self.analyzed.classTable.get(inst.classBase);
            method = self.analyzed.classMethod(
                inst.classBase, inst.methodName);
        }
        if (decl == null || method == null
                || method.kind != NK_METHOD_DECL) { return; }

        /* self type: mangled generic instance for a generic owner, else the
         * bare class name. */
        string selfMangled = inst.classBase;
        if (inst.classArgs.len > 0) {
            selfMangled = mangleGenericType(inst.classBase, inst.classArgs);
        }
        string fnName = genericMethodInstanceName(
            inst.classBase, inst.classArgs, inst.methodName, inst.methodArgs);

        /* Combined {class_param: concrete, method_param: concrete} type map. */
        Map<string, Node> typeMap = {};
        int ci = 0;
        while (ci < decl.generic_params.len && ci < inst.classArgs.len) {
            typeMap.put(decl.generic_params.get(ci), inst.classArgs.get(ci));
            ci = ci + 1;
        }
        int ui = 0;
        while (ui < method.generic_params.len && ui < inst.methodArgs.len) {
            typeMap.put(method.generic_params.get(ui), inst.methodArgs.get(ui));
            ui = ui + 1;
        }

        /* Resolved return + params. */
        Node rrt = resolveGenericType(method.return_type, typeMap);
        string retC = typeToC(rrt, self.analyzed);

        IRFunctionDecl declaration = IRFunctionDecl(fnName, retC, true);
        declaration.params.push(IRParam(selfMangled + "*", "self"));
        int fp = 0;
        while (fp < method.params.len) {
            Node pp = method.params.get(fp);
            Node rt = resolveGenericType(pp.type, typeMap);
            declaration.params.push(IRParam(
                typeToC(rt, self.analyzed), pp.name));
            fp = fp + 1;
        }
        m.function_decls.push(declaration);

        /* Body lowering context. Mirrors emitGenericInstance: set the generic
         * method context, then reset it after. currentReturnTypeNode is set (not
         * save/restored) like lowerMethod does — guarding the nullable store. */
        string savedClass = self.currentClass;
        string savedReturnC = self.currentReturnCType;
        Node? savedReturnType = self.currentReturnTypeNode;
        bool savedReturnOwned = self.currentReturnOwned;
        bool savedBatchExplicitReleases = self.batchExplicitReleases;
        bool savedCollectionEdgeKeeps = self.collectionEdgeKeeps;
        self.currentClass = selfMangled;
        self.currentReturnCType = retC;
        self.currentReturnTypeNode = rrt;
        self.currentReturnOwned = true;
        self.inGenericMethod = true;
        self.activeTypeMap = typeMap;
        bool publicCollectionMethod =
            isPublicCollectionBase(inst.classBase)
            && method.access == "public";
        bool topologyCollection = false;
        if (isPublicCollectionBase(inst.classBase)) {
            GenInstance ownerInstance = GenInstance(
                inst.classBase, inst.classArgs, selfMangled);
            topologyCollection = genericInstanceNeedsVisitor(
                self.analyzed, ownerInstance);
        }
        self.batchExplicitReleases = publicCollectionMethod;
        self.collectionEdgeKeeps = isPublicCollectionBase(inst.classBase);

        IRFunction fn = IRFunction();
        fn.name = fnName;
        fn.return_type = retC;
        fn.is_static = true;
        fn.params.push(IRParam(selfMangled + "*", "self"));
        int pp2 = 0;
        while (pp2 < method.params.len) {
            Node pp = method.params.get(pp2);
            Node rt = resolveGenericType(pp.type, typeMap);
            fn.params.push(IRParam(typeToC(rt, self.analyzed), pp.name));
            pp2 = pp2 + 1;
        }

        /* var-type map: self -> the receiver instance type, each param -> its
         * resolved type. */
        Map<string, Node> vt = self.seededVarTypes();
        Node selfT = Node();
        selfT.kind = NK_TYPE_EXPR;
        selfT.base = inst.classBase;
        selfT.generic_args = inst.classArgs;
        selfT.pointer_depth = 1;
        vt.put("self", selfT);
        int vp = 0;
        while (vp < method.params.len) {
            Node pp = method.params.get(vp);
            vt.put(pp.name, resolveGenericType(pp.type, typeMap));
            vp = vp + 1;
        }

        Vector<IRNode> mbody = [];
        if (method.body_node != null) {
            self.resetFuncVarDecls();
            IRNode blk = self.lowerBlock(method.body_node, vt);
            int b = 0;
            while (b < blk.stmts.len) { mbody.push(blk.stmts.get(b)); b = b + 1; }
        }
        if (mbody.len == 0) {
            mbody.push(irExprStmt(irCast("void", irVar("self"))));
        }
        fn.body = irBlock(mbody);
        if (topologyCollection) {
            installCollectionTopologyBoundary(self, fn);
        }
        if (publicCollectionMethod) {
            installReleaseBearingCycleBoundary(self, fn);
        }
        m.functions.push(fn);

        self.currentClass = savedClass;
        self.currentReturnCType = savedReturnC;
        self.currentReturnTypeNode = savedReturnType;
        self.currentReturnOwned = savedReturnOwned;
        self.batchExplicitReleases = savedBatchExplicitReleases;
        self.collectionEdgeKeeps = savedCollectionEdgeKeeps;
        self.inGenericMethod = false;
        self.activeTypeMap = {};
    }

    /* var-type map for lowering a generic method/ctor body: self -> the generic
     * instance type (carries generic_args + pointer_depth 1), each param -> its
     * resolved type. */
    public Map<string, Node> genericMethodVarTypes(GenInstance inst, Node method, Map<string, Node> typeMap) {
        Map<string, Node> vt = self.seededVarTypes();
        Node selfT = Node();
        selfT.kind = NK_TYPE_EXPR;
        selfT.base = inst.base;
        selfT.generic_args = inst.args;
        selfT.pointer_depth = 1;
        vt.put("self", selfT);
        int i = 0;
        while (i < method.params.len) {
            Node p = method.params.get(i);
            vt.put(p.name, resolveGenericType(p.type, typeMap));
            i = i + 1;
        }
        return vt;
    }

    /* The explicitly marked constructor of a generic class declaration. */
    public Node? genericConstructor(Node decl) {
        int i = 0;
        while (i < decl.members.len) {
            Node m = decl.members.get(i);
            if (m.kind == NK_METHOD_DECL && m.is_constructor) { return m; }
            i = i + 1;
        }
        return null;
    }

    /* Emit the user __del__ body (if any) followed by ARC field releases for
     * class-typed fields of a generic instance into the destructor body
     * (resolved field types). Mirrors _build_generic_destructor_stmts: the
     * user-defined __del__ runs first, then per-field releases. */
    public void emitGenericFieldReleases(GenInstance inst, Node decl, Map<string, Node> typeMap, Vector<IRNode> body) {
        /* User-defined __del__ body runs first (e.g. box_alive-- bookkeeping). */
        Node? dtor = self.analyzed.genericClassMethod(
            inst.base, "__del__");
        if (dtor != null && dtor.body_node != null) {
            self.currentReturnCType = "void";
            self.currentReturnTypeNode = null;
            self.currentReturnOwned = true;
            self.resetFuncVarDecls();
            Map<string, Node> vt = self.genericMethodVarTypes(inst, dtor, typeMap);
            IRNode blk = self.lowerBlock(dtor.body_node, vt);
            int d = 0;
            while (d < blk.stmts.len) { body.push(blk.stmts.get(d)); d = d + 1; }
        }
        int i = 0;
        while (i < decl.members.len) {
            Node mem = decl.members.get(i);
            string storage = instanceStorageName(mem);
            if (storage != "") {
                Node rt = resolveGenericType(mem.type, typeMap);
                if (irManagedType(self, rt)) {
                    body.push(self.fieldReleaseStmt(storage, rt));
                }
            }
            i = i + 1;
        }
    }

    /* Emit a class: struct def + method forward decls + constructor +
     * destructor + methods + inherited-method wrappers (mirrors emit_class_decl
     * + class_members). */
    public void emitClassDecl(Node decl, IRModule m) {
        self.currentClass = decl.name;
        self.emitClassStruct(decl, m);
        emitClassStaticFields(self, decl, m);
        self.emitMethodForwardDecls(decl, m);
        self.emitConstructor(decl, m);
        self.emitDestructor(decl, m);
        emitArcDescriptor(self, m, decl.name,
            classNeedsCycleVisitor(self, decl.name));

        /* Own methods + properties (skip constructor + __del__). */
        Map<string, bool> ownMethods = {};
        Map<string, bool> ownProperties = {};
        int i = 0;
        while (i < decl.members.len) {
            Node mem = decl.members.get(i);
            if (mem.kind == NK_METHOD_DECL && !mem.is_constructor
                    && mem.name != "__del__") {
                ownMethods.put(mem.name, true);
                if (!mem.is_abstract && mem.body_node != null) {
                    m.functions.push(self.lowerMethod(decl, mem));
                }
            } else if (mem.kind == NK_PROPERTY_DECL) {
                self.emitProperty(decl, mem, m);
                ownProperties.put(mem.name, true);
            }
            i = i + 1;
        }

        /* Inherited method wrappers for methods not overridden. */
        string par = parentName(decl);
        if (par != "" && self.analyzed.isClass(par)) {
            self.emitInheritedMethods(decl, ownMethods, m);
            emitInheritedProperties(self, decl, ownProperties, m);
        }
        self.currentClass = "";
    }

    /* Emit the struct: ARC header first, then parent fields, then own fields, then
     * property backing fields (mirrors _emit_class_struct). */
    public void emitClassStruct(Node decl, IRModule m) {
        IRStructDef sd = IRStructDef();
        sd.name = decl.name;
        string declarationKey = astNodeKey(decl);
        if (self.packAlignments.has(declarationKey)) {
            sd.pack_alignment = self.packAlignments.get(declarationKey);
        }
        appendArcHeaderField(self, sd);
        /* Parent fields (single-level chain handled by recursion). */
        string par = parentName(decl);
        if (par != "" && self.analyzed.isClass(par)) {
            self.appendParentFields(par, sd);
        }
        int i = 0;
        while (i < decl.members.len) {
            Node mem = decl.members.get(i);
            string storage = instanceStorageName(mem);
            if (storage != "") {
                sd.fields.push(IRStructField(
                    typeToC(mem.type, self.analyzed), storage));
            }
            i = i + 1;
        }
        m.struct_defs.push(sd);
    }

    /* Append a parent class's own fields (recursively, ancestors first) into a
     * struct def. Python copies parent.fields (which already include ancestors)
     * in insertion order; we recurse parent-first to match. */
    public void appendParentFields(string cls, IRStructDef sd) {
        if (!self.analyzed.isClass(cls)) { return; }
        Node decl = self.analyzed.classTable.get(cls);
        string par = parentName(decl);
        if (par != "" && self.analyzed.isClass(par)) {
            self.appendParentFields(par, sd);
        }
        int i = 0;
        while (i < decl.members.len) {
            Node mem = decl.members.get(i);
            string storage = instanceStorageName(mem);
            if (storage != "") {
                sd.fields.push(IRStructField(
                    typeToC(mem.type, self.analyzed), storage));
            }
            i = i + 1;
        }
    }

    /* Forward declarations for the constructor + own methods + inherited method
     * wrappers (mirrors _emit_method_forward_decls). */
    public void emitMethodForwardDecls(Node decl, IRModule m) {
        string name = decl.name;
        Node? ctor = self.analyzed.classConstructor(name);
        IRFunctionDecl initDeclaration = IRFunctionDecl(
            name + "_init", "void", false);
        initDeclaration.params.push(IRParam(name + "*", "self"));
        IRFunctionDecl newDeclaration = IRFunctionDecl(
            name + "_new", name + "*", false);
        if (ctor != null) {
            int constructorParam = 0;
            while (constructorParam < ctor.params.len) {
                Node parameter = ctor.params.get(constructorParam);
                IRParam irParameter = IRParam(
                    typeToC(parameter.type, self.analyzed), parameter.name);
                initDeclaration.params.push(irParameter);
                newDeclaration.params.push(irParameter);
                constructorParam = constructorParam + 1;
            }
        }
        m.function_decls.push(initDeclaration);
        m.function_decls.push(newDeclaration);
        /* Own methods. */
        Map<string, bool> own = {};
        Map<string, bool> ownProperties = {};
        int i = 0;
        while (i < decl.members.len) {
            Node mem = decl.members.get(i);
            if (mem.kind == NK_METHOD_DECL) { own.put(mem.name, true); }
            if (mem.kind == NK_METHOD_DECL && !mem.is_constructor
                    && mem.name != "__del__") {
                bool isStatic = mem.access == "class";
                string ret = typeToC(mem.return_type, self.analyzed);
                IRFunctionDecl methodDeclaration = IRFunctionDecl(
                    name + "_" + mem.name, ret, false);
                if (!isStatic) {
                    methodDeclaration.params.push(IRParam(name + "*", "self"));
                }
                int methodParam = 0;
                while (methodParam < mem.params.len) {
                    Node parameter = mem.params.get(methodParam);
                    methodDeclaration.params.push(IRParam(
                        typeToC(parameter.type, self.analyzed), parameter.name));
                    methodParam = methodParam + 1;
                }
                m.function_decls.push(methodDeclaration);
            } else if (mem.kind == NK_PROPERTY_DECL) {
                ownProperties.put(mem.name, true);
                string propertyType = typeToC(mem.type, self.analyzed);
                if (mem.has_getter) {
                    IRFunctionDecl getter = IRFunctionDecl(
                        name + "_get_" + mem.name, propertyType, false);
                    getter.params.push(IRParam(name + "*", "self"));
                    m.function_decls.push(getter);
                }
                if (mem.has_setter) {
                    IRFunctionDecl setter = IRFunctionDecl(
                        name + "_set_" + mem.name, "void", false);
                    setter.params.push(IRParam(name + "*", "self"));
                    setter.params.push(IRParam(propertyType, "value"));
                    m.function_decls.push(setter);
                }
            }
            i = i + 1;
        }
        /* Inherited method wrapper fwds: the immediate parent's merged method
         * set, in order, minus this class's own methods. */
        string par = parentName(decl);
        if (par != "" && self.analyzed.isClass(par)) {
            Vector<MethodEntry> pm = self.analyzed.mergedMethods(par);
            int k = 0;
            while (k < pm.len) {
                MethodEntry e = pm.get(k);
                if (!own.has(e.name)) {
                    string ret = typeToC(e.sig.return_type, self.analyzed);
                    IRFunctionDecl wrapper = IRFunctionDecl(
                        name + "_" + e.name, ret, false);
                    if (e.sig.access != "class") {
                        wrapper.params.push(IRParam(name + "*", "self"));
                    }
                    int wrapperParam = 0;
                    while (wrapperParam < e.sig.params.len) {
                        Node parameter = e.sig.params.get(wrapperParam);
                        wrapper.params.push(IRParam(
                            typeToC(parameter.type, self.analyzed), parameter.name));
                        wrapperParam = wrapperParam + 1;
                    }
                    m.function_decls.push(wrapper);
                }
                k = k + 1;
            }
        }
        emitInheritedPropertyForwardDecls(
            self, decl, ownProperties, m);
    }

    /* "T1 n1, T2 n2, ..." for a param list (empty string for no params). */
    public string paramDeclText(Vector<Node> params) {
        string s = "";
        int i = 0;
        while (i < params.len) {
            Node p = params.get(i);
            if (i > 0) { s = s + ", "; }
            s = s + typeToC(p.type, self.analyzed) + " " + p.name;
            i = i + 1;
        }
        return s;
    }

    /* Emit X_init(self, ...) and X_new(...) (mirrors _emit_constructor). */
    public void emitConstructor(Node decl, IRModule m) {
        string name = decl.name;
        Node? ctor = self.analyzed.classConstructor(name);

        /* X_init params: self + ctor params. */
        IRFunction initFn = IRFunction();
        initFn.name = name + "_init";
        initFn.return_type = "void";
        initFn.params.push(IRParam(name + "*", "self"));
        if (ctor != null) {
            int i = 0;
            while (i < ctor.params.len) {
                Node p = ctor.params.get(i);
                initFn.params.push(IRParam(typeToC(p.type, self.analyzed), p.name));
                i = i + 1;
            }
        }
        Vector<IRNode> body = [];
        appendArcHeaderInitialization(name, body);
        /* Field default initializers (own fields only — mirrors Python). */
        int j = 0;
        while (j < decl.members.len) {
            Node mem = decl.members.get(j);
            if (mem.kind == NK_FIELD_DECL && mem.initializer != null) {
                Map<string, Node> ctorVars = self.ctorVarTypes(decl, ctor);
                /* Collection literals: thread the declared field type so the
                 * mangled collection name matches the field (e.g. `Vector<string>
                 * = []` lowers to `btrc_Vector_string_new`, not the int-inferred
                 * fallback). Mirrors _lower_field_init in classes.py. */
                IRNode v = irLiteral("NULL");
                if (mem.initializer.kind == NK_LIST_LITERAL) {
                    v = self.lowerListLiteral(mem.initializer, ctorVars, mem.type);
                } else if (mem.initializer.kind == NK_MAP_LITERAL) {
                    v = self.lowerMapLiteral(mem.initializer, ctorVars, mem.type);
                } else if (mem.initializer.kind == NK_BRACE_INITIALIZER) {
                    v = self.lowerBraceInit(mem.initializer, ctorVars, mem.type);
                } else {
                    v = self.lowerExpr(mem.initializer, ctorVars);
                }
                IRNode field = irFieldAccess(
                    irVar("self"), mem.name, true);
                bool ownedInitializer =
                    irContextualExpressionOwnsResult(
                        self, mem.initializer, mem.type, ctorVars);
                if (irManagedClassType(self, mem.type)) {
                    body.push(irExprStmt(irManagedReplaceEdge(
                        self, field, v, mem.type, irVar("self"),
                        ownedInitializer)));
                } else {
                    body.push(irAssign(field, v));
                    if (irManagedType(self, mem.type)
                            && ownedInitializer) {
                        body.push(irExprStmt(
                            irManagedAdoptEdge(
                                self, field, mem.type, irVar("self"))));
                    } else if (irManagedType(self, mem.type)) {
                        body.push(irExprStmt(
                            irManagedRetainEdge(
                                self, field, mem.type, irVar("self"))));
                    }
                }
            }
            j = j + 1;
        }
        /* Constructor body (user code). */
        if (ctor != null && ctor.body_node != null) {
            self.currentReturnCType = "void";
            self.resetFuncVarDecls();
            Map<string, Node> ctorVars = self.ctorVarTypes(decl, ctor);
            IRNode blk = self.lowerBlock(ctor.body_node, ctorVars);
            int k = 0;
            while (k < blk.stmts.len) { body.push(blk.stmts.get(k)); k = k + 1; }
        }
        initFn.body = irBlock(body);
        m.functions.push(initFn);

        /* X_new: malloc + memset + init + return. */
        IRFunction newFn = IRFunction();
        newFn.name = name + "_new";
        newFn.return_type = name + "*";
        Vector<IRNode> nbody = [];
        Vector<IRNode> mallocArgs = [];
        mallocArgs.push(irSizeofType(name));
        IRNode mallocCall = irCast(name + "*", irCall("malloc", mallocArgs));
        nbody.push(irVarDecl(name + "*", "self", mallocCall));
        Vector<IRNode> memsetArgs = [];
        memsetArgs.push(irVar("self"));
        memsetArgs.push(irLiteral("0"));
        memsetArgs.push(irSizeofType(name));
        nbody.push(irExprStmt(irCall("memset", memsetArgs)));
        string cleanupMark = beginConstructorCleanup(
            self, "self", name, nbody);
        Vector<IRNode> initArgs = [];
        initArgs.push(irVar("self"));
        if (ctor != null) {
            int p = 0;
            while (p < ctor.params.len) {
                newFn.params.push(IRParam(typeToC(ctor.params.get(p).type, self.analyzed),
                    ctor.params.get(p).name));
                initArgs.push(irVar(ctor.params.get(p).name));
                p = p + 1;
            }
        }
        nbody.push(irExprStmt(irCall(name + "_init", initArgs)));
        endConstructorCleanup(self, cleanupMark, nbody);
        nbody.push(irReturn(irVar("self")));
        newFn.body = irBlock(nbody);
        m.functions.push(newFn);
    }

    /* var-type map for lowering a constructor body: `self` -> class type, plus
     * each ctor param -> its declared type. */
    public Map<string, Node> ctorVarTypes(Node decl, Node? ctor) {
        Map<string, Node> vt = self.seededVarTypes();
        vt.put("self", classPtrType(makeClassTypeExpr(decl.name)));
        if (ctor != null) {
            int i = 0;
            while (i < ctor.params.len) {
                Node p = ctor.params.get(i);
                vt.put(p.name, p.type);
                i = i + 1;
            }
        }
        return vt;
    }

    /* Emit X_destroy(self): user __del__ body + class-field releases + free(self)
     * (mirrors emit_destructor, class subset — no generic fields/cyclable). */
    public void emitDestructor(Node decl, IRModule m) {
        string name = decl.name;
        IRFunction fn = IRFunction();
        fn.name = name + "_destroy";
        fn.return_type = "void";
        fn.params.push(IRParam("void*", "object"));
        Vector<IRNode> body = [];
        body.push(irVarDecl(
            name + "*", "self", irCast(name + "*", irVar("object"))));
        Node? dtor = self.analyzed.classMethod(name, "__del__");
        if (dtor != null && dtor.kind == NK_METHOD_DECL && dtor.body_node != null) {
            self.currentReturnCType = "void";
            self.currentReturnTypeNode = null;
            self.currentReturnOwned = true;
            self.resetFuncVarDecls();
            Map<string, Node> vt = self.seededVarTypes();
            vt.put("self", classPtrType(makeClassTypeExpr(name)));
            IRNode blk = self.lowerBlock(dtor.body_node, vt);
            int k = 0;
            while (k < blk.stmts.len) { body.push(blk.stmts.get(k)); k = k + 1; }
        }
        /* Release class-instance fields (own + inherited), in source order. */
        bool hasFieldReleases = self.emitFieldReleases(name, body);
        /* Mark cascade destruction before freeing. The helper itself checks
         * the process-wide unwind scope under the ARC mutation lock. */
        if (hasFieldReleases) {
            Vector<IRNode> mdArgs = [];
            mdArgs.push(irVar("self"));
            body.push(irExprStmt(irCall("__btrc_mark_destroyed", mdArgs)));
        }
        /* free(self) */
        Vector<IRNode> fargs = [];
        fargs.push(irVar("self"));
        body.push(irExprStmt(irCall("free", fargs)));
        fn.body = irBlock(body);
        m.functions.push(fn);
        /* ARC: cycle-detection visitor for cyclable classes (after the dtor so
         * the visitor's forward use of {name}_destroy is already declared).
         * Mirrors classes._emit_visitor, gated on is_cyclable. */
        if (classNeedsCycleVisitor(self, name)) {
            self.emitVisitor(name, m);
        }
    }

    /* Emit an exactly type-erased `X_visit(void*, callback)` which calls fn on
     * the ADDRESS of each cyclable-class field, so the cycle collector can trial-
     * decrement or NULL them. A cyclable class always gets a visitor even with no
     * directly-cyclable field (the collector references X_visit unconditionally).
    * Mirrors classes._emit_visitor. */
    public void emitVisitor(string name, IRModule m) {
        self.useHelper("__btrc_arc_callback_types");
        IRFunctionDecl visitorDeclaration = IRFunctionDecl(
            cycleVisitorName(name), "void", true);
        visitorDeclaration.params.push(IRParam("void*", "object"));
        visitorDeclaration.params.push(IRParam(
            "__btrc_field_visit_fn", "fn"));
        visitorDeclaration.params.push(IRParam("void*", "context"));
        m.function_decls.push(visitorDeclaration);

        IRFunction fn = IRFunction();
        fn.name = cycleVisitorName(name);
        fn.return_type = "void";
        fn.is_static = true;
        fn.archive_export = true;
        fn.params.push(IRParam("void*", "object"));
        fn.params.push(IRParam("__btrc_field_visit_fn", "fn"));
        fn.params.push(IRParam("void*", "context"));
        Vector<IRNode> body = [];
        body.push(irVarDecl(
            name + "*", "self", irCast(name + "*", irVar("object"))));

        Vector<Node> fields = [];
        self.collectClassFields(name, fields);
        bool visited = false;
        int i = 0;
        while (i < fields.len) {
            Node fd = fields.get(i);
            Node ft = fd.type;
            if (ft != null) {
                IRNode field = irFieldAccess(
                    irVar("self"), instanceStorageName(fd), true);
                if (appendClassCycleFieldVisit(self, ft, field, body)) {
                    visited = true;
                }
            }
            i = i + 1;
        }
        if (!visited) {
            body.push(irExprStmt(irCast("void", irVar("self"))));
            body.push(irExprStmt(irCast("void", irVar("fn"))));
            body.push(irExprStmt(irCast("void", irVar("context"))));
        }
        fn.body = irBlock(body);
        m.functions.push(fn);
    }

    /* Append `if (self->f) { if (--self->f->__rc <= 0) F_destroy(self->f); }` for
     * each class-instance field of `cls` (and ancestors). Mirrors emit_destructor
     * field-release loop (cls_info.fields iterates own+inherited). */
    public bool emitFieldReleases(string cls, Vector<IRNode> body) {
        /* Build the ordered field list the way Python's cls_info.fields does:
         * inherited first, then own. */
        Vector<Node> fields = [];
        self.collectClassFields(cls, fields);
        bool any = false;
        int i = 0;
        while (i < fields.len) {
            Node fd = fields.get(i);
            Node ft = fd.type;
            if (irManagedType(self, ft)) {
                body.push(self.fieldReleaseStmt(
                    instanceStorageName(fd), ft));
                if (irManagedClassType(self, ft)) { any = true; }
            }
            i = i + 1;
        }
        return any;
    }

    /* Collect a class's fields (inherited first, then own) — mirrors the
     * insertion order of ClassInfo.fields. */
    public void collectClassFields(string cls, Vector<Node> out) {
        if (!self.analyzed.isClass(cls)) { return; }
        Node decl = self.analyzed.classTable.get(cls);
        string par = parentName(decl);
        if (par != "" && self.analyzed.isClass(par)) {
            self.collectClassFields(par, out);
        }
        int i = 0;
        while (i < decl.members.len) {
            Node mem = decl.members.get(i);
            if (instanceStorageName(mem) != "") { out.push(mem); }
            i = i + 1;
        }
    }

    public void appendRuntimeClassRefs(
            string staticClass, Map<string, bool> out) {
        Vector<string> runtimeClasses = self.analyzed.classTable.keys();
        int index = 0;
        while (index < runtimeClasses.len) {
            string runtimeClass = runtimeClasses.get(index);
            if (self.analyzed.isSubclass(runtimeClass, staticClass)) {
                out.put(runtimeClass, true);
            }
            index = index + 1;
        }
    }

    /* The set of class names directly referenced through `cls`'s fields (a
     * field whose declared type, or a generic-arg of it, is a known class).
     * Mirrors the `refs[name]` adjacency built in analyzer.core
     * _compute_cyclable. Includes inherited fields so a base-class field can
     * close a cycle through a subclass. */
    public void classFieldRefs(string cls, Map<string, bool> out) {
        Vector<Node> fields = [];
        self.collectClassFields(cls, fields);
        int i = 0;
        while (i < fields.len) {
            Node fd = fields.get(i);
            Node ft = fd.type;
            if (ft != null) {
                if (self.analyzed.isClass(ft.base)) {
                    self.appendRuntimeClassRefs(ft.base, out);
                }
                int g = 0;
                while (g < ft.generic_args.len) {
                    Node ga = ft.generic_args.get(g);
                    if (self.analyzed.isClass(ga.base)) {
                        self.appendRuntimeClassRefs(ga.base, out);
                    }
                    g = g + 1;
                }
            }
            i = i + 1;
        }
    }

    /* True if `cls` can reach itself through field references (directly or
     * transitively) — i.e. instances of `cls` may form reference cycles, so
     * scope-release must run the cycle collector. DFS over the static field-ref
     * graph; mirrors analyzer.core _compute_cyclable. */
    public bool isCyclable(string cls) {
        if (!self.analyzed.isClass(cls)) { return false; }
        Map<string, bool> visited = {};
        Vector<string> stack = [];
        Map<string, bool> seed = {};
        self.classFieldRefs(cls, seed);
        Vector<string> sk = seed.keys();
        int si = 0;
        while (si < sk.len) { stack.push(sk.get(si)); si = si + 1; }
        while (stack.len > 0) {
            string cur = stack.pop();
            if (cur == cls) { return true; }
            if (visited.has(cur)) { continue; }
            visited.put(cur, true);
            Map<string, bool> refs = {};
            self.classFieldRefs(cur, refs);
            Vector<string> rk = refs.keys();
            int ri = 0;
            while (ri < rk.len) { stack.push(rk.get(ri)); ri = ri + 1; }
        }
        return false;
    }

    /* True if any managed var in `managed` is of a cyclable class — drives the
     * phased scope-release path. Mirrors the has_cyclable check in
     * arc._emit_scope_release. */
    public bool anyCyclable(Vector<Managed> managed) {
        int i = 0;
        while (i < managed.len) {
            Managed owner = managed.get(i);
            if (owner.cleanupKind == "arc"
                    && irManagedRuntimeCanCycle(self, owner.cls)) {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    /* Typed field release; the enclosing scope owns the collector flush. */
    public IRNode fieldReleaseStmt(string field, Node typeExpr) {
        IRNode fa = irFieldAccess(irVar("self"), field, true);
        if (irManagedClassType(self, typeExpr)) {
            Vector<IRNode> atomicStatements = [];
            atomicStatements.push(irExprStmt(irManagedReplaceEdge(
                self, fa, irLiteral("NULL"), typeExpr,
                irVar("self"), false)));
            return irBlock(atomicStatements);
        }
        string oldName = self.freshTemp("__btrc_destroy_field");
        Vector<IRNode> statements = [];
        statements.push(irVarDecl(
            typeToC(typeExpr, self.analyzed), oldName, fa));
        statements.push(irExprStmt(irManagedUnlinkEdge(
            self, irVar(oldName), typeExpr, irVar("self"))));
        statements.push(irAssign(fa, irLiteral("NULL")));
        statements.push(irExprStmt(irManagedReleaseEdge(
            self, irVar(oldName), typeExpr, irLiteral("NULL"))));
        return irBlock(statements);
    }

    /* Lower a method to X_method(self, params...) (mirrors emit_method). */
    public IRFunction lowerMethod(Node decl, Node method) {
        string name = decl.name;
        bool isStatic = method.access == "class";
        IRFunction fn = IRFunction();
        fn.name = name + "_" + method.name;
        string ret = typeToC(method.return_type, self.analyzed);
        fn.return_type = ret;
        Map<string, Node> vt = self.seededVarTypes();
        if (!isStatic) {
            fn.params.push(IRParam(name + "*", "self"));
            vt.put("self", classPtrType(makeClassTypeExpr(name)));
        }
        int i = 0;
        while (i < method.params.len) {
            Node p = method.params.get(i);
            fn.params.push(IRParam(typeToC(p.type, self.analyzed), p.name));
            vt.put(p.name, p.type);
            i = i + 1;
        }
        self.currentReturnCType = ret;
        self.currentReturnTypeNode = method.return_type;
        self.currentReturnOwned = true;
        self.resetFuncVarDecls();
        if (method.body_node != null) {
            /* Hoist to a local: btrcpy double-evaluates `field = call()`. */
            IRNode mb = self.lowerBlock(method.body_node, vt);
            fn.body = mb;
        } else {
            Vector<IRNode> empty = [];
            fn.body = irBlock(empty);
        }
        return fn;
    }

    /* Emit getter/setter for a property (mirrors emit_property). */
    public void emitProperty(Node decl, Node prop, IRModule m) {
        string name = decl.name;
        string propType = typeToC(prop.type, self.analyzed);
        string backing = instanceStorageName(prop);
        string savedReturnC = self.currentReturnCType;
        Node? savedReturnType = self.currentReturnTypeNode;
        bool savedReturnOwned = self.currentReturnOwned;
        if (prop.has_getter) {
            IRFunction g = IRFunction();
            g.name = name + "_get_" + prop.name;
            g.return_type = propType;
            g.params.push(IRParam(name + "*", "self"));
            Vector<IRNode> gb = [];
            if (prop.getter_body != null) {
                self.currentReturnCType = propType;
                self.currentReturnTypeNode = prop.type;
                self.currentReturnOwned = false;
                self.resetFuncVarDecls();
                Map<string, Node> vt = self.seededVarTypes();
                vt.put("self", classPtrType(makeClassTypeExpr(name)));
                IRNode blk = self.lowerBlock(prop.getter_body, vt);
                int k = 0;
                while (k < blk.stmts.len) { gb.push(blk.stmts.get(k)); k = k + 1; }
            } else {
                gb.push(irReturn(irFieldAccess(irVar("self"), backing, true)));
            }
            g.body = irBlock(gb);
            m.functions.push(g);
        }
        if (prop.has_setter) {
            IRFunction s = IRFunction();
            s.name = name + "_set_" + prop.name;
            s.return_type = "void";
            s.params.push(IRParam(name + "*", "self"));
            s.params.push(IRParam(propType, "value"));
            Vector<IRNode> sb = [];
            if (prop.setter_body != null) {
                self.currentReturnCType = "void";
                self.currentReturnTypeNode = null;
                self.currentReturnOwned = false;
                self.resetFuncVarDecls();
                Map<string, Node> vt = self.seededVarTypes();
                vt.put("self", classPtrType(makeClassTypeExpr(name)));
                vt.put("value", prop.type);
                IRNode blk = self.lowerBlock(prop.setter_body, vt);
                int k = 0;
                while (k < blk.stmts.len) { sb.push(blk.stmts.get(k)); k = k + 1; }
            } else {
                emitAutoPropertyStore(self, prop.type,
                    irFieldAccess(irVar("self"), backing, true), sb);
            }
            s.body = irBlock(sb);
            m.functions.push(s);
        }
        self.currentReturnCType = savedReturnC;
        self.currentReturnTypeNode = savedReturnType;
        self.currentReturnOwned = savedReturnOwned;
    }

    /* Emit wrapper functions for inherited methods not overridden (mirrors
     * emit_inherited_methods). Each wrapper casts self to the IMMEDIATE parent
     * type and calls the immediate parent's method, which itself may be a wrapper
     * (single-hop chaining). Iterates the immediate parent's merged method set. */
    public void emitInheritedMethods(Node decl, Map<string, bool> ownMethods, IRModule m) {
        string name = decl.name;
        string par = parentName(decl);
        if (par == "" || !self.analyzed.isClass(par)) { return; }
        Vector<MethodEntry> pm = self.analyzed.mergedMethods(par);
        int i = 0;
        while (i < pm.len) {
            MethodEntry e = pm.get(i);
            if (!ownMethods.has(e.name)) {
                ownMethods.put(e.name, true);
                Node mem = e.sig;
                IRFunction fn = IRFunction();
                fn.name = name + "_" + e.name;
                string ret = typeToC(mem.return_type, self.analyzed);
                fn.return_type = ret;
                Vector<IRNode> callArgs = [];
                if (mem.access != "class") {
                    fn.params.push(IRParam(name + "*", "self"));
                    callArgs.push(irCast(par + "*", irVar("self")));
                }
                int j = 0;
                while (j < mem.params.len) {
                    Node p = mem.params.get(j);
                    fn.params.push(IRParam(typeToC(p.type, self.analyzed), p.name));
                    callArgs.push(irVar(p.name));
                    j = j + 1;
                }
                IRNode call = irCall(par + "_" + e.name, callArgs);
                Vector<IRNode> wbody = [];
                if (ret == "void") {
                    wbody.push(irExprStmt(call));
                } else {
                    wbody.push(irReturn(call));
                }
                fn.body = irBlock(wbody);
                m.functions.push(fn);
            }
            i = i + 1;
        }
    }

    /* Emit used helpers in the canonical registry order (mirrors the order in
     * which helpers are aggregated in registry.py, filtered by DCE). */
    public void collectHelpers(IRModule m) {
        /* Re-derive the used-helper set from the SURVIVING (post-DCE) function
         * bodies + structured macros, rather than the lowering-time accumulator —
         * helpers referenced only by dead-eliminated functions must NOT survive
         * (mirrors optimizer._eliminate_dead_helpers, which scans final IR). */
        Vector<string> order = canonicalHelperOrder();
        Map<string, bool> used = {};
        int fi = 0;
        while (fi < m.functions.len) {
            IRFunction fn = m.functions.get(fi);
            if (fn.body != null) { scanHelpersInNode(fn.body, used); }
            fi = fi + 1;
        }
        int declarationIndex = 0;
        while (declarationIndex < m.preprocessor_decls.len) {
            IRPreprocessorDecl declaration =
                m.preprocessor_decls.get(declarationIndex);
            if (declaration.kind == IR_PREPROCESSOR_MACRO) {
                Map<string, bool> macroHelpers = {};
                scanTextForNames(
                    declaration.replacement, order, macroHelpers);
                Vector<string> macroNames = macroHelpers.keys();
                int helperIndex = 0;
                while (helperIndex < macroNames.len) {
                    used.put(macroNames.get(helperIndex), true);
                    helperIndex = helperIndex + 1;
                }
            }
            declarationIndex = declarationIndex + 1;
        }

        /* Structured declarations can depend on a helper-owned ABI without a
         * call node (managed structs embed __btrc_arc_header). */
        collectStructuredHelperRoots(m, used);

        /* Resolve transitive dependencies (mirrors collect_helpers worklist). */
        Vector<string> worklist = used.keys();
        while (worklist.len > 0) {
            string cur = worklist.pop();
            Vector<string> deps = helperDeps(cur);
            int d = 0;
            while (d < deps.len) {
                string dep = deps.get(d);
                if (!used.has(dep)) {
                    used.put(dep, true);
                    worklist.push(dep);
                }
                d = d + 1;
            }
        }
        /* Transitive closure over helper -> helper references in C source: a kept
         * helper's body often calls other helpers (mirrors optimizer closure). */
        Vector<string> work2 = used.keys();
        while (work2.len > 0) {
            string cur = work2.pop();
            string src = helperSource(cur);
            Map<string, bool> sourceHelpers = {};
            scanTextForNames(src, order, sourceHelpers);
            Vector<string> sourceNames = sourceHelpers.keys();
            int sourceIndex = 0;
            while (sourceIndex < sourceNames.len) {
                string helperName = sourceNames.get(sourceIndex);
                if (!used.has(helperName)) {
                    used.put(helperName, true);
                    work2.push(helperName);
                }
                sourceIndex = sourceIndex + 1;
            }
        }

        int i = 0;
        while (i < order.len) {
            string name = order.get(i);
            if (used.has(name)) {
                m.helpers.push(helperSource(name));
            }
            i = i + 1;
        }
        /* Headers belong to the surviving helper graph. This is especially
         * important for a thread-only program: thread cleanup depends
         * transitively on the try-state globals that declare jmp_buf. */
        Vector<string> usedNames = used.keys();
        int hi = 0;
        while (hi < usedNames.len) {
            Vector<string> headers = helperHeaders(usedNames.get(hi));
            int hj = 0;
            while (hj < headers.len) {
                requireSystemInclude(m, headers.get(hj));
                hj = hj + 1;
            }
            hi = hi + 1;
        }
    }

    /* Phase 1 forward declarations (mirrors _emit_forward_decls): for each
     * non-generic class, a `typedef struct X X;` and a `void X_destroy(X*);`
     * prototype; then prototypes for every non-main function with a body. Class
    * method/constructor prototypes are appended later by emitClassDecl. */
    public void emitForwardDecls(Node prog, IRModule m) {
        Vector<IRFunctionDecl> functionDeclarations = [];
        int i = 0;
        while (i < prog.declarations.len) {
            Node d = prog.declarations.get(i);
            if ((d.kind == NK_CLASS_DECL && d.generic_params.len == 0)
                    || d.kind == NK_STRUCT_DECL || d.kind == NK_RICH_ENUM_DECL) {
                /* Both non-generic classes and raw structs get a typed forward
                 * so a function prototype can name `struct X*` before X is
                 * defined (mirrors generator._emit_forward_decls phase-1, which
                 * tests ClassDecl OR StructDecl). Only classes get _destroy. */
                m.struct_forwards.push(IRStructForward(d.name));
                if (d.kind == NK_CLASS_DECL && d.generic_params.len == 0) {
                    IRFunctionDecl destroyDeclaration = IRFunctionDecl(
                        d.name + "_destroy", "void", false);
                    destroyDeclaration.params.push(IRParam("void*", "object"));
                    functionDeclarations.push(destroyDeclaration);
                }
            } else if (d.kind == NK_FUNCTION_DECL && !d.is_gpu
                    && d.body_node != null && d.name != "main") {
                string ret = typeToC(d.return_type, self.analyzed);
                IRFunctionDecl functionDeclaration = IRFunctionDecl(
                    d.name, ret, false);
                int parameter = 0;
                while (parameter < d.params.len) {
                    Node sourceParameter = d.params.get(parameter);
                    functionDeclaration.params.push(IRParam(
                        typeToC(sourceParameter.type, self.analyzed),
                        sourceParameter.name));
                    parameter = parameter + 1;
                }
                functionDeclarations.push(functionDeclaration);
            }
            i = i + 1;
        }
        /* Forward typedefs for concrete generic instances, in discovery order
         * (mirrors generator._emit_forward_decls phase-1 generic loop). These
         * come after the non-generic class typedefs and before function fwds. */
        int g = 0;
        while (g < self.analyzed.genericInstances.len) {
            GenInstance gi = self.analyzed.genericInstances.get(g);
            m.struct_forwards.push(IRStructForward(gi.mangled));
            g = g + 1;
        }
        /* Tuple struct definitions + typedefs (mirrors _emit_tuple_structs):
         * emitted after the generic typedefs and before the deferred function
         * forward decls, so a tuple-returning function's prototype sees the
         * tuple's typedef. */
        self.emitTupleStructs(prog, m);
        int j = 0;
        while (j < functionDeclarations.len) {
            m.function_decls.push(functionDeclarations.get(j));
            j = j + 1;
        }
    }

    /* Scan all declarations (function return/param types, class method return
     * types) and bodies for tuple types, then emit one struct def + forward
     * typedef per unique mangled tuple. Mirrors generator._emit_tuple_structs
     * (the body walk substitutes for Python's node_types scan). */
    public void emitTupleStructs(Node prog, IRModule m) {
        Map<string, bool> seen = {};
        Vector<string> order = [];
        Vector<Node> tupleTypes = [];
        int i = 0;
        while (i < prog.declarations.len) {
            Node d = prog.declarations.get(i);
            if (d.kind == NK_FUNCTION_DECL) {
                self.collectTupleTypes(d.return_type, seen, order, tupleTypes);
                int p = 0;
                while (p < d.params.len) {
                    self.collectTupleTypes(d.params.get(p).type, seen, order, tupleTypes);
                    p = p + 1;
                }
                self.collectTupleTypesBody(d.body_node, seen, order, tupleTypes);
            } else if (d.kind == NK_CLASS_DECL) {
                int mi = 0;
                while (mi < d.members.len) {
                    Node mem = d.members.get(mi);
                    if (mem.kind == NK_METHOD_DECL) {
                        self.collectTupleTypes(mem.return_type, seen, order, tupleTypes);
                        int mp = 0;
                        while (mp < mem.params.len) {
                            self.collectTupleTypes(mem.params.get(mp).type, seen, order, tupleTypes);
                            mp = mp + 1;
                        }
                        self.collectTupleTypesBody(mem.body_node, seen, order, tupleTypes);
                    } else if (mem.kind == NK_FIELD_DECL) {
                        /* A class field of tuple type (e.g. `(int,int) pos;`)
                         * references the tuple struct in the class body, so its
                         * typedef must be emitted. Python catches this via the
                         * field-access node_types scan. */
                        self.collectTupleTypes(mem.type, seen, order, tupleTypes);
                    } else if (mem.kind == NK_PROPERTY_DECL) {
                        self.collectTupleTypes(mem.type, seen, order, tupleTypes);
                    }
                    mi = mi + 1;
                }
            }
            i = i + 1;
        }
        int s = 0;
        while (s < order.len) {
            string mangled = order.get(s);
            Node tt = tupleTypes.get(s);
            IRStructDef sd = IRStructDef();
            sd.name = mangled;
            int f = 0;
            while (f < tt.generic_args.len) {
                sd.fields.push(IRStructField(
                    typeToC(tt.generic_args.get(f), self.analyzed), f"_{f}"));
                f = f + 1;
            }
            m.struct_defs.push(sd);
            m.struct_forwards.push(IRStructForward(mangled));
            s = s + 1;
        }
    }

    /* Recursively collect tuple types from a type expression (mirrors
     * generator._collect_tuple_types). A tuple type has base "Tuple" with
     * generic_args holding the element types; nested tuples are collected too. */
    public void collectTupleTypes(Node? t, Map<string, bool> seen,
            Vector<string> order, Vector<Node> tupleTypes) {
        if (t == null) { return; }
        /* Recurse into element types FIRST so that a nested tuple used as a
         * field (e.g. the (string,bool) inside (int,(string,bool))) is emitted
         * before the enclosing struct that contains it — otherwise the outer
         * struct references an incomplete type. (Python gets this ordering
         * incidentally via its node_types scan, which sees the inner tuple's
         * standalone use first; doing dependencies-first here is robust.) */
        int i = 0;
        while (i < t.generic_args.len) {
            self.collectTupleTypes(t.generic_args.get(i), seen, order, tupleTypes);
            i = i + 1;
        }
        if (t.base == "Tuple" && t.generic_args.len > 0) {
            string mangled = mangleGenericSymbol("Tuple", t.generic_args);
            if (!seen.has(mangled)) {
                seen.put(mangled, true);
                order.push(mangled);
                tupleTypes.push(t);
            }
        }
    }

    /* Walk a function/method body for tuple types appearing on local var decls
     * and tuple literals. This stands in for the Python node_types scan, which
     * the on-demand inference design of this compiler doesn't maintain. */
    public void collectTupleTypesBody(Node? n, Map<string, bool> seen,
            Vector<string> order, Vector<Node> tupleTypes) {
        if (n == null) { return; }
        if (n.kind == NK_VAR_DECL_STMT) {
            self.collectTupleTypes(n.type, seen, order, tupleTypes);
            /* `var t = (1, 2)` declares t with an inferred tuple type and a null
             * annotation, so scanning n.type alone misses the tuple. Infer the
             * type from the initializer (Python catches this via node_types). */
            if (n.type == null && n.initializer != null) {
                Map<string, Node> vt = {};
                Node? it = inferType(n.initializer, self.analyzed, vt);
                self.collectTupleTypes(it, seen, order, tupleTypes);
            }
        }
        int si = 0;
        while (si < n.statements.len) {
            self.collectTupleTypesBody(n.statements.get(si), seen, order, tupleTypes);
            si = si + 1;
        }
        self.collectTupleTypesBody(n.then_block, seen, order, tupleTypes);
        self.collectTupleTypesBody(n.else_block, seen, order, tupleTypes);
        self.collectTupleTypesBody(n.body_node, seen, order, tupleTypes);
        if (n.if_stmt != null) { self.collectTupleTypesBody(n.if_stmt, seen, order, tupleTypes); }
    }

    public string paramListText(Vector<Node> params) {
        if (params.len == 0) { return "void"; }
        string s = "";
        int i = 0;
        while (i < params.len) {
            Node p = params.get(i);
            if (i > 0) { s = s + ", "; }
            s = s + typeToC(p.type, self.analyzed) + " " + p.name;
            i = i + 1;
        }
        return s;
    }

    /* A fresh varTypes map pre-seeded with module-level (global) variable
     * types. Mirrors the reference's global scope being visible inside every
     * function/method body; locals and params added afterward shadow a
     * same-named global. */
    public Map<string, Node> seededVarTypes() {
        Map<string, Node> vt = {};
        Vector<string> gkeys = self.analyzed.globalVarTypes.keys();
        int gk = 0;
        while (gk < gkeys.len) {
            string gn = gkeys.get(gk);
            vt.put(gn, self.analyzed.globalVarTypes.get(gn));
            gk = gk + 1;
        }
        return vt;
    }

    public IRFunction lowerFunction(Node d) {
        self.gpuHost.clear();
        IRFunction fn = IRFunction();
        fn.name = d.name;
        string ret = typeToC(d.return_type, self.analyzed);
        /* main() with void return -> int (matches functions.py). */
        if (d.name == "main" && ret == "void") { ret = "int"; }
        fn.return_type = ret;
        int i = 0;
        while (i < d.params.len) {
            Node p = d.params.get(i);
            fn.params.push(IRParam(typeToC(p.type, self.analyzed), p.name));
            if (p.type != null && p.type.is_array) {
                self.gpuHost.unknown_array_lengths.put(p.name, true);
            }
            i = i + 1;
        }
        /* Seed the global scope: module-level vars are visible inside every
         * function. Params (added next) shadow a same-named global, matching
         * scope resolution order. */
        Map<string, Node> varTypes = self.seededVarTypes();
        int j = 0;
        while (j < d.params.len) {
            Node p = d.params.get(j);
            varTypes.put(p.name, p.type);
            j = j + 1;
        }
        self.currentReturnCType = ret;
        self.currentReturnTypeNode = d.return_type;
        self.currentReturnOwned = true;
        self.currentClass = "";
        self.resetFuncVarDecls();
        if (d.body_node != null) {
            CallableFlowSnapshot functionCallables =
                self.snapshotCallableFlow();
            /* Hoist to a local: btrcpy's ARC double-evaluates `field = call()`
             * (see gotchas), which would lower the body twice and desync the
             * fresh-temp counter. */
            IRNode b = self.lowerBlock(d.body_node, varTypes);
            fn.body = b;
            self.restoreCallableFlow(functionCallables);
        }
        return fn;
    }

    public IRNode lowerBlock(Node block, Map<string, Node> varTypes) {
        Vector<IRNode> declarations = [];
        Vector<Node> types = [];
        Vector<bool> owned = [];
        return self.lowerBlockWithBindings(
            block, varTypes, declarations, types, owned);
    }

    /* Lower a lexical block with synthetic for-in bindings declared after the
     * cleanup marker and managed-scope entry. Managed iterGet results are local
     * +1 owners for one iteration, so ordinary scope/control/return/throw paths
     * must see them before the source body is lowered. */
    public IRNode lowerBlockWithBindings(Node block,
            Map<string, Node> varTypes, Vector<IRNode> declarations,
            Vector<Node> types, Vector<bool> owned) {
        /* Type bindings are lexical just like C declarations.  Nested blocks,
         * loop initializers, and shadowing must not mutate the caller's view. */
        Map<string, Node> scopedVarTypes = semanticCloneTypes(varTypes);
        Vector<string> closureNames = [];
        Vector<string> closureFunctions = [];
        Vector<string> closureEnvironments = [];
        self.snapshotClosureEnvs(
            closureNames, closureFunctions, closureEnvironments);
        CallableFlowSnapshot enclosingCallables =
            self.beginCallableScope();
        Vector<string> borrowedBindings =
            self.snapshotBorrowedLocalBindings();
        Vector<IRNode> stmts = [];
        string cleanupMarker = self.pushCleanupScope();
        self.pushManagedScope();
        int binding = 0;
        while (binding < declarations.len && binding < types.len
                && binding < owned.len) {
            IRNode declaration = declarations.get(binding);
            Node bindingType = types.get(binding);
            stmts.push(declaration);
            if (declaration.kind == IRK_VAR_DECL) {
                scopedVarTypes.put(declaration.name, bindingType);
                self.recordCallableDeclaration(declaration.name);
                self.funcVarDecls.push(declaration);
                if (owned.get(binding)
                        && irManagedType(self, bindingType)) {
                    self.borrowedLocalBindings.remove(
                        declaration.name);
                    string runtimeType = irManagedRuntimeType(
                        self, bindingType);
                    self.registerManagedVar(
                        declaration.name, runtimeType);
                    self.maybeRegisterCleanup(declaration.name,
                        irManagedCleanupSymbol(self, runtimeType),
                        runtimeType, stmts);
                } else if (irManagedType(self, bindingType)) {
                    self.borrowedLocalBindings.put(
                        declaration.name, true);
                }
            }
            binding = binding + 1;
        }
        if (block != null) {
            int i = 0;
            while (i < block.statements.len) {
                Node s = block.statements.get(i);
                self.lowerStmtInto(s, scopedVarTypes, stmts);
                i = i + 1;
            }
        }
        /* ARC: a control-transfer statement already emitted the exact cleanup
         * it exits.  Do not append unreachable normal-exit cleanup after it;
         * besides being dead, that hides a case-ending break from strict GCC's
         * fallthrough analysis. */
        bool fallsThrough = irSequenceMayFallThrough(stmts);
        Vector<Managed> managed = self.popManagedScope();
        bool markerReferenced = fallsThrough
            || irSequenceReferencesVariable(stmts, cleanupMarker);
        if (self.cleanupScopeIsActive(cleanupMarker)
                && markerReferenced) {
            self.useHelper("__btrc_cleanup_mark");
            Vector<IRNode> markArgs = [];
            stmts.insert(0, irVarDecl("int", cleanupMarker,
                irCall("__btrc_cleanup_mark", markArgs)));
        }
        if (fallsThrough) {
            self.emitScopeRelease(managed, stmts);
            self.emitCleanupScopeExit(cleanupMarker, stmts);
        }
        self.popCleanupScope();
        self.restoreClosureEnvs(
            closureNames, closureFunctions, closureEnvironments);
        self.finishCallableScope(enclosingCallables);
        self.restoreBorrowedLocalBindings(borrowedBindings);
        return irBlock(stmts);
    }

    public void emitCleanupScopeExit(string marker, Vector<IRNode> out) {
        if (!self.cleanupScopeIsActive(marker)) { return; }
        self.useHelper("__btrc_discard_cleanups_to");
        Vector<IRNode> args = [];
        args.push(irVar(marker));
        out.push(irExprStmt(irCall("__btrc_discard_cleanups_to", args)));
    }

    public void emitControlCleanupExit(
            bool switchIsTarget, Vector<IRNode> out) {
        self.emitCleanupScopeExit(
            self.getControlCleanupMarker(switchIsTarget), out);
    }

    /* Lower a loop body with a loop-scope marker so break/continue inside it
     * release exactly the vars declared in the body. Mirrors _lower_loop_body. */
    public IRNode lowerLoopBody(Node block, Map<string, Node> varTypes) {
        CallableFlowSnapshot incoming = self.snapshotCallableFlow();
        self.pushLoopScope();
        self.pushControlContext("loop");
        IRNode b = self.lowerBlock(block, varTypes);
        self.popControlContext();
        self.popLoopScope();
        CallableFlowSnapshot bodyFlow = self.snapshotCallableFlow();
        self.restoreCallableFlow(incoming);
        Vector<CallableFlowSnapshot> flows = [];
        flows.push(incoming);
        flows.push(bodyFlow);
        self.joinCallableFlows(flows);
        return b;
    }

    public IRNode lowerLoopBodyWithBindings(Node block,
            Map<string, Node> varTypes, Vector<IRNode> declarations,
            Vector<Node> types, Vector<bool> owned) {
        CallableFlowSnapshot incoming = self.snapshotCallableFlow();
        self.pushLoopScope();
        self.pushControlContext("loop");
        IRNode body = self.lowerBlockWithBindings(
            block, varTypes, declarations, types, owned);
        self.popControlContext();
        self.popLoopScope();
        CallableFlowSnapshot bodyFlow = self.snapshotCallableFlow();
        self.restoreCallableFlow(incoming);
        Vector<CallableFlowSnapshot> flows = [];
        flows.push(incoming);
        flows.push(bodyFlow);
        self.joinCallableFlows(flows);
        return body;
    }

    /* Release every owner; flush only if a release can enqueue a cycle root. */
    public void emitScopeRelease(Vector<Managed> managed, Vector<IRNode> out) {
        if (managed.len == 0) { return; }
        int i = managed.len - 1;
        while (i >= 0) {
            Managed mv = managed.get(i);
            if (mv.cleanupKind == "thread") {
                self.useHelper("__btrc_thread_free");
                Vector<IRNode> args = [];
                args.push(self.consumeThreadHandle(irVar(mv.name)));
                out.push(irExprStmt(irCall(
                    "__btrc_thread_free", args)));
            } else {
                string valueName = self.freshTemp(
                    "__btrc_scope_released");
                out.push(irVarDecl(
                    irManagedRuntimeCType(mv.cls),
                    valueName, irVar(mv.name)));
                out.push(irAssign(
                    irVar(mv.name), irLiteral("NULL")));
                out.push(irExprStmt(irManagedReleaseRuntime(
                    self, irVar(valueName), mv.cls)));
            }
            i = i - 1;
        }
        if (self.anyCyclable(managed)) {
            out.push(irExprStmt(managedArcFlush(self)));
        }
    }

    /* Return-path release: rc-- for every managed var across all open scopes
     * except `keepVar` (the returned variable, whose ownership transfers to the
     * caller). Mirrors arc.py _emit_return_release. */
    public void emitReturnRelease(string keepVar, Vector<IRNode> out) {
        Vector<Managed> all = self.getAllManagedVars();
        Vector<Managed> released = [];
        int i = 0;
        while (i < all.len) {
            Managed mv = all.get(i);
            if (mv.name != keepVar) {
                released.push(mv);
            }
            i = i + 1;
        }
        self.emitScopeRelease(released, out);
    }

    /* ARC for `obj.field = value` where field is a class-instance field. Appends
     * to `pre` a release of the old field value (rc--, destroy at zero) and to
     * `post` a retain of the new value (value->__rc++, skipped for `new` which is
     * born with rc=1). No-op (leaves pre/post empty) when the target is not a
     * class-typed field assignment. Mirrors
     * fields.get_field_assign_arc_stmts. */
    public IRNode? lowerManagedFieldAssignment(
            Node node, Map<string, Node> varTypes) {
        if (node.target == null
                || node.target.kind != NK_FIELD_ACCESS_EXPR) { return null; }
        IRNode? staticStore = lowerManagedStaticFieldStore(
            self, node, varTypes);
        if (staticStore != null) { return staticStore; }
        Node tgt = node.target;
        Node? ot = self.resolvedExpressionType(tgt.obj, varTypes);
        if (ot == null) { return null; }
        Node? fd = instanceMemberForType(
            self.analyzed, ot, tgt.field);
        if (fd == null || fd.type == null) { return null; }
        string storage = "";
        if (fd.kind == NK_FIELD_DECL) {
            storage = instanceStorageName(fd);
        } else if (fd.kind == NK_PROPERTY_DECL
                && tgt.obj.kind == NK_SELF_EXPR) {
            storage = instanceStorageName(fd);
        }
        if (storage == "") { return null; }
        Node? resolvedFieldType = resolvedInstanceMemberType(
            self.analyzed, ot, fd);
        if (resolvedFieldType == null) { return null; }
        Node ft = resolvedFieldType;
        /* Class instances and concrete generic collection instances own ARC
         * slots.  A substituted generic may instead be raw storage (for
         * example Vector<T>.data becomes Item**); classify the resolved shape
         * before generating object-header accesses. */
        bool ftGeneric = ft.generic_args.len > 0
            && self.analyzed.isGenericClass(ft.base);
        if (!irManagedType(self, ft)) { return null; }

        /* Evaluate receiver and RHS exactly once, then make lowerExpr's final
         * assignment reuse those temps. This also lets us retain an aliasing
         * new value before releasing the old field. */
        string objName = self.freshTemp("__btrc_field_obj");
        IRNode objDecl = irVarDecl(
            typeToC(ot, self.analyzed), objName, null);
        self.funcVarDecls.push(objDecl);
        IRNode obj = irVar(objName);
        bool receiverOwned = irExpressionOwnsResult(
            self, tgt.obj, varTypes);

        Node? vt = self.resolvedExpressionType(node.value_node, varTypes);
        string valueC = typeToC(ft, self.analyzed);
        IRNode field = irFieldAccess(obj, storage, true);
        if (node.op != "=") {
            return lowerManagedFieldCompoundStore(self, node,
                objDecl, obj, field, ft, varTypes);
        }
        IRNode valueExpr = irLiteral("NULL");
        if (node.value_node.kind == NK_BRACE_INITIALIZER && ftGeneric) {
            valueExpr = self.lowerBraceInit(node.value_node, varTypes, ft);
        } else if (node.value_node.kind == NK_MAP_LITERAL && ftGeneric) {
            valueExpr = self.lowerMapLiteral(node.value_node, varTypes, ft);
        } else if (node.value_node.kind == NK_LIST_LITERAL && ftGeneric) {
            valueExpr = self.lowerListLiteral(node.value_node, varTypes, ft);
        } else {
            valueExpr = self.lowerExpr(node.value_node, varTypes);
        }
        valueExpr = self.upcastClassPointer(ft, vt, valueExpr);
        bool owned = irContextualExpressionOwnsResult(
            self, node.value_node, ft, varTypes);
        string valueName = self.freshTemp("__btrc_field_new");
        IRNode valueDecl = irVarDecl(valueC, valueName, null);
        self.funcVarDecls.push(valueDecl);
        IRNode newValue = irVar(valueName);

        Vector<IRNode> declarations = [];
        declarations.push(objDecl);
        declarations.push(valueDecl);
        Vector<IRNode> sequence = [];
        sequence.push(irBinOp(
            obj, "=", self.lowerExpr(tgt.obj, varTypes)));
        sequence.push(irBinOp(newValue, "=", valueExpr));
        if (irManagedClassType(self, ft)) {
            sequence.push(irManagedReplaceEdge(
                self, field, newValue, ft, obj, owned));
        } else {
            string oldName = self.freshTemp("__btrc_field_old");
            IRNode oldDecl = irVarDecl(
                typeToC(ft, self.analyzed), oldName, null);
            self.funcVarDecls.push(oldDecl);
            declarations.push(oldDecl);
            IRNode oldValue = irVar(oldName);
            sequence.push(irBinOp(oldValue, "=", field));
            sequence.push(irManagedUnlinkEdge(
                self, oldValue, ft, obj));
            if (owned) {
                sequence.push(irManagedAdoptEdge(
                    self, newValue, ft, obj));
            } else if (node.value_node.kind != NK_NULL_LITERAL) {
                sequence.push(irManagedRetainEdge(
                    self, newValue, ft, obj));
            }
            sequence.push(irBinOp(field, "=", newValue));
            sequence.push(irManagedReleaseEdge(
                self, oldValue, ft, newValue));
        }

        string runtimeType = irManagedRuntimeType(self, ft);
        bool releaseCanEnqueue = irManagedRuntimeCanCycle(
            self, runtimeType);
        if (receiverOwned && irManagedType(self, ot)) {
            string receiverRuntimeType = irManagedRuntimeType(self, ot);
            sequence.push(irManagedReleaseRuntime(
                self, obj, receiverRuntimeType));
            if (irManagedRuntimeCanCycle(self, receiverRuntimeType)) {
                releaseCanEnqueue = true;
            }
        }
        if (releaseCanEnqueue) {
            sequence.push(managedArcPoll(self));
        }
        sequence.push(field);
        return irStmtExpr(declarations, irCommaExpr(sequence));
    }

    /* Parameter indices carrying the `keep` annotation for a call. Resolves the
     * callee (function / constructor / instance or static method) and scans its
     * params. Mirrors calls.get_keep_param_indices. */
    public Vector<int> keepParamIndices(Node node) {
        Vector<int> out = [];
        Node callee = node.callee;
        if (callee == null) { return out; }
        Vector<Node> params = self.paramsForCall(node);
        int positional = 0;
        int i = 0;
        while (i < node.args.len) {
            int paramIndex = positional;
            string argumentName = "";
            if (i < node.arg_names.len) {
                argumentName = node.arg_names.get(i);
            }
            if (argumentName != "") {
                paramIndex = -1;
                int p = 0;
                while (p < params.len) {
                    if (params.get(p).name == argumentName) { paramIndex = p; }
                    p = p + 1;
                }
            } else {
                positional = positional + 1;
            }
            if (paramIndex >= 0 && paramIndex < params.len
                    && params.get(paramIndex).keep_) {
                out.push(i);
            }
            i = i + 1;
        }
        return out;
    }

    /* The declared params of a call's target (function / constructor / method),
     * empty when unresolvable. Mirrors calls.params_for_call. */
    public Vector<Node> paramsForCall(Node node) {
        Vector<Node> empty = [];
        Node callee = node.callee;
        if (callee == null) { return empty; }
        if (callee.kind == NK_LAMBDA_EXPR) { return callee.params; }
        if (callee.kind == NK_FIELD_ACCESS_EXPR) {
            Node objN = callee.obj;
            Node? ot = inferType(objN, self.analyzed, self.callParamVarTypes);
            if (ot != null && self.analyzed.isClass(ot.base)) {
                Node? m = self.analyzed.classMethod(ot.base, callee.field);
                if (m != null && m.kind == NK_METHOD_DECL) { return m.params; }
            }
            if (objN != null && objN.kind == NK_IDENTIFIER
                    && self.analyzed.isClass(objN.name)) {
                Node? m = self.analyzed.classMethod(objN.name, callee.field);
                if (m != null && m.kind == NK_METHOD_DECL) { return m.params; }
            }
            return empty;
        }
        if (callee.kind == NK_IDENTIFIER) {
            string name = callee.name;
            if (self.analyzed.isClass(name)) {
                Node? ctor = self.analyzed.classConstructor(name);
                if (ctor != null) { return ctor.params; }
                return empty;
            }
            if (self.analyzed.funcTable.has(name)) {
                return self.analyzed.funcTable.get(name).params;
            }
        }
        return empty;
    }

    /* Keep-call ARC for a call's class-typed arguments (mirrors
     * variables._keep_call_arc_stmts). Two concerns:
     *   1. `keep` param: a call-site rc++ transfers a reference to the callee. A
     *      named-local source is registered managed so its scope release balances
     *      the rc++.
     *   2. Owning-temporary (`new X()` / ctor call X(...)) passed to ANY param:
     *      the temp holds the creation reference (rc=1). It is hoisted into a temp
     *      var (so the call references it) and released after the call. If the
     *      callee kept a reference (collection push rc++ or a keep param), the net
     *      effect leaves exactly the callee's reference; otherwise the transient
     *      is destroyed.
     * `pre` runs before the call (temp decls + keep rc++); `post` runs after
     * (owning-temp releases). Owning-temp args also register an override so the
     * re-lowered call references the temp var. */
    public void keepCallArcStmts(Node node, Map<string, Node> varTypes,
            Vector<IRNode> pre, Vector<IRNode> post) {
        if (node.kind != NK_CALL_EXPR) { return; }
        if (node.callee != null
                && node.callee.kind == NK_FIELD_ACCESS_EXPR
                && node.callee.optional) {
            /* Optional calls own their ARC sequence.  Hoisting it here would
             * retain/evaluate arguments even when the receiver is null. */
            return;
        }
        self.callParamVarTypes = varTypes;
        Vector<int> keepIdx = self.keepParamIndices(node);
        Map<int, bool> keepSet = {};
        int k = 0;
        while (k < keepIdx.len) { keepSet.put(keepIdx.get(k), true); k = k + 1; }
        int idx = 0;
        while (idx < node.args.len) {
            Node arg = node.args.get(idx);
            Node? at = inferType(arg, self.analyzed, varTypes);
            if (!irManagedType(self, at)) { idx = idx + 1; continue; }
            bool isKeep = keepSet.has(idx);
            bool isOwning = self.isOwningTempArg(arg);
            if (!isKeep && !isOwning) { idx = idx + 1; continue; }
            IRNode target = irLiteral("0");
            if (isOwning) {
                /* Hoist the owning temp into a temp var, referenced by both the
                 * call and the post-call release. */
                string tempName = self.freshTemp("__btrc_arg_tmp");
                string tempC = typeToC(at, self.analyzed);
                pre.push(irVarDecl(tempC, tempName, self.lowerExpr(arg, varTypes)));
                self.owningTempOverrides.put(astNodeKey(arg), irVar(tempName));
                target = irVar(tempName);
            } else {
                target = self.lowerExpr(arg, varTypes);
            }
            if (isKeep) {
                pre.push(irExprStmt(irManagedRetainValue(
                    self, target, at)));
                if (!isOwning && arg.kind == NK_IDENTIFIER) {
                    self.registerManagedVar(arg.name,
                        irManagedRuntimeType(self, at));
                }
            }
            if (isOwning) {
                post.push(self.releaseVarStmt2(
                    target, irManagedRuntimeType(self, at)));
            }
            idx = idx + 1;
        }
    }

    /* True if `arg` creates a fresh owning object: `new X(...)` or a constructor
     * call `X(...)` (class name as callee). Mirrors _is_owning_temp_arg. */
    public bool isOwningTempArg(Node arg) {
        return irExpressionOwnsResult(
            self, arg, self.callParamVarTypes);
    }

    /* Typed arbitrary-expression cleanup at a full-expression boundary. */
    public IRNode releaseVarStmt2(IRNode target, string runtimeType) {
        Vector<IRNode> statements = [];
        statements.push(irExprStmt(irManagedReleaseRuntime(
            self, target, runtimeType)));
        if (irManagedRuntimeCanCycle(self, runtimeType)) {
            statements.push(irExprStmt(managedArcPoll(self)));
        }
        return irBlock(statements);
    }

    /* A terminal destroy() nulls the slot.  Preserve lexical ownership so a
     * later assignment is still released at scope exit; cleanup(NULL) is safe. */
    public string endManualDestroyLifetime(Node? expr) {
        if (expr == null || expr.kind != NK_CALL_EXPR) { return ""; }
        Node callee = expr.callee;
        if (callee == null || callee.kind != NK_FIELD_ACCESS_EXPR) { return ""; }
        if (callee.field != "destroy") { return ""; }
        Node recv = callee.obj;
        if (recv != null && recv.kind == NK_IDENTIFIER) {
            return recv.name;
        }
        return "";
    }

    public void lowerStmtInto(Node node, Map<string, Node> varTypes, Vector<IRNode> out) {
        if (tryLowerGpuCpuReturn(self, node, varTypes, out)) { return; }
        if (tryLowerGpuStatement(self, node, varTypes, out)) { return; }
        if (node.kind == NK_VAR_DECL_STMT) {
            /* C array local: `int arr[] = {5,3,1}` / `int buf[N]`. The element
             * type is the base (NOT a pointer), the name carries the `[size]`/`[]`
             * suffix, and a list-literal initializer becomes a raw C aggregate
             * `{...}` (mirrors variables._lower_var_decl's is_array branch). */
            if (node.type != null && node.type.is_array) {
                Node baseType = Node();
                baseType.kind = NK_TYPE_EXPR;
                baseType.base = node.type.base;
                baseType.generic_args = node.type.generic_args;
                baseType.pointer_depth = node.type.pointer_depth;
                string baseC = typeToC(baseType, self.analyzed);
                IRNode? localArraySize = null;
                if (node.type.array_size != null) {
                    localArraySize = self.lowerExpr(node.type.array_size, varTypes);
                }
                IRNode? ainit = null;
                if (node.initializer != null) {
                    if (node.initializer.kind == NK_LIST_LITERAL
                            || node.initializer.kind
                                == NK_BRACE_INITIALIZER) {
                        Vector<IRNode> elements = [];
                        int ai = 0;
                        while (ai < node.initializer.elements.len) {
                            elements.push(self.lowerExpr(
                                node.initializer.elements.get(ai), varTypes));
                            ai = ai + 1;
                        }
                        ainit = irInitializerList(elements);
                    } else {
                        ainit = self.lowerExpr(node.initializer, varTypes);
                    }
                }
                if (node.type != null) { varTypes.put(node.name, node.type); }
                IRNode arrayDecl = irArrayVarDecl(
                    baseC, node.name, localArraySize, ainit);
                arrayDecl.is_static = node.type.is_static;
                arrayDecl.is_extern = node.type.is_extern;
                arrayDecl.is_volatile = node.type.is_volatile;
                out.push(arrayDecl);
                IRNode arrayLength = null;
                if (node.type.array_size != null) {
                    arrayLength = self.lowerExpr(node.type.array_size, varTypes);
                } else if (node.initializer != null
                        && (node.initializer.kind == NK_LIST_LITERAL
                            || node.initializer.kind == NK_BRACE_INITIALIZER)) {
                    arrayLength = irLiteral(Strings.fromInt(
                        node.initializer.elements.len));
                }
                if (arrayLength != null) {
                    self.gpuHost.array_lengths.put(node.name, arrayLength);
                } else {
                    self.gpuHost.unknown_array_lengths.put(node.name, true);
                }
                return;
            }
            /* `var` (null type): infer from the initializer (mirrors the
             * analyzer setting stmt.type = inferred). */
            Node? declType = node.type;
            if (declType != null) { declType = self.resolveBodyType(declType); }
            if (declType == null && node.initializer != null) {
                declType = self.resolvedExpressionType(
                    node.initializer, varTypes);
            }
            bool directInferredClosure = node.type == null
                && node.initializer != null
                && node.initializer.kind == NK_LAMBDA_EXPR;
            int callableInitializerAbi = 0;
            if (node.initializer != null) {
                callableInitializerAbi = self.callableExpressionAbi(
                    node.initializer, varTypes);
            }
            if (!directInferredClosure && self.callableValueEscapes(
                    declType, node.initializer, varTypes)) {
                self.rejectClosureEscape(node);
            }
            string ct = "int";
            if (declType != null) { ct = typeToC(declType, self.analyzed); }
            IRNode? init = null;
            if (node.initializer != null) {
                /* Collection literals: thread the declared type so the mangled
                 * collection name matches the declaration (mirrors the analyzer
                 * stamping node_types from the declared type). */
                if (node.initializer.kind == NK_LIST_LITERAL) {
                    init = self.lowerListLiteral(node.initializer, varTypes, declType);
                } else if (node.initializer.kind == NK_MAP_LITERAL) {
                    init = self.lowerMapLiteral(node.initializer, varTypes, declType);
                } else if (node.initializer.kind == NK_BRACE_INITIALIZER) {
                    init = self.lowerBraceInit(node.initializer, varTypes, declType);
                } else {
                    init = self.lowerExpr(node.initializer, varTypes);
                }
                /* Generic constructor call: Box(42) lowers as a plain call
                 * `Box(42)` (Box isn't a non-generic class); rewrite it to the
                 * mangled `btrc_Box_int_new(42)` using the declared generic args
                 * (mirrors variables._lower_var_decl's generic-ctor fixup). */
                if (declType != null && declType.generic_args.len > 0
                        && init != null && init.kind == IRK_CALL) {
                    Node init0 = node.initializer;
                    if (init0.kind == NK_CALL_EXPR && init0.callee != null
                            && init0.callee.kind == NK_IDENTIFIER
                            && self.analyzed.isGenericClass(init0.callee.name)) {
                        string mangled = mangleGenericType(declType.base, declType.generic_args);
                        Vector<IRNode> newArgs = init.args;
                        /* Upcast Derived->Base ctor args against the RESOLVED
                         * generic param types (the ctor's `E error` param can't
                         * trigger the upcast in orderArgsForParams). Mirrors
                         * variables._lower_var_decl's generic-ctor upcast. */
                        Node? gctor = self.analyzed.genericClassMethod(
                            init0.callee.name, init0.callee.name);
                        if (gctor != null) {
                            self.upcastGenericCtorArgs(
                                declType, gctor, init0.args, newArgs, varTypes);
                        }
                        init = irCall(mangled + "_new", newArgs);
                    }
                }
                /* Implicit class->string coercion: `string s = ClassWithToString();`
                 * wraps the init in `<Class>_toString(...)` (mirrors
                 * variables._lower_var_decl's coerce_value_to_string). */
                if (init != null) {
                    Node? initType = inferType(node.initializer, self.analyzed, varTypes);
                    init = self.coerceToString(declType, initType, init);
                }
                /* Upcast: storing a subclass instance in a base-class variable
                 * needs an explicit cast — sibling struct pointers are otherwise
                 * incompatible C (gcc 15 rejects `Error* = KeyError*`). Mirrors
                 * variables._lower_var_decl's _is_subclass + IRCast branch. */
                if (init != null && declType != null
                        && self.analyzed.isClass(declType.base)
                        && declType.generic_args.len == 0) {
                    Node? initType2 = inferType(node.initializer, self.analyzed, varTypes);
                    if (initType2 != null && initType2.base != declType.base
                            && self.analyzed.isSubclass(initType2.base, declType.base)) {
                        init = irCast(ct, init);
                    }
                }
            }
            if (init == null && declType != null
                    && irManagedType(self, declType)) {
                /* Empty managed declarations are owned lexical slots too.
                 * Initialize them before registering cleanup so a later
                 * assignment and every exit path can replace/release safely. */
                init = irLiteral("NULL");
            }
            if (declType != null) { varTypes.put(node.name, declType); }
            /* The initializer resolves in the enclosing scope; only after it
             * has been lowered does this owned source local shadow a borrowed
             * lambda/synthetic binding of the same name. */
            self.borrowedLocalBindings.remove(node.name);
            IRNode vdecl = irVarDecl(ct, node.name, init);
            if (node.type != null) {
                vdecl.is_static = node.type.is_static;
                vdecl.is_extern = node.type.is_extern;
                vdecl.is_volatile = node.type.is_volatile;
            }
            self.funcVarDecls.push(vdecl);
            out.push(vdecl);
            self.recordCallableDeclaration(node.name);
            /* A same-named ordinary local shadows an enclosing captured-lambda
             * binding for this lexical block. The block snapshot restores the
             * outer binding on exit. */
            if (self.fnPtrEnvFn.has(node.name)) {
                self.fnPtrEnvFn.put(node.name, "");
                self.fnPtrEnvVar.put(node.name, "");
            }
            Node? callableDeclType = resolveTypedefType(
                declType, self.analyzed.typedefTable);
            if (callableDeclType != null
                    && callableDeclType.base == "__fn_ptr") {
                self.setCallableBindingAbi(
                    node.name, callableInitializerAbi);
            }
            /* Capturing lambda assigned to a var: allocate the capture-env struct
             * on the stack and fill it; cast the impl (which has an extra void*
             * param) to the typedef type for storage; bypass the fn pointer and
             * call the impl directly with &env when the var is invoked. Mirrors
             * variables._lower_var_decl's lambda-capture branch. */
            if (node.initializer != null && node.initializer.kind == NK_LAMBDA_EXPR) {
                Vector<string> lcaps = self.lambdaCaptureNames(node.initializer, varTypes);
                if (lcaps.len > 0) {
                    string lid = Strings.fromInt(self.lastLambdaId);
                    string lfn = "__btrc_lambda_" + lid;
                    string lenv = lfn + "_env";
                    string evar = "__" + node.name + "_env";
                    /* Calls to a capturing lambda always target the lifted
                     * implementation directly with its environment.  A fake
                     * plain function-pointer local would be unused and would
                     * require an incompatible function-type cast, so remove
                     * the just-appended placeholder declaration. */
                    out.pop();
                    self.funcVarDecls.pop();
                    out.push(irVarDecl("struct " + lenv, evar, null));
                    int li = 0;
                    while (li < lcaps.len) {
                        string cn = lcaps.get(li);
                        IRNode fa = irFieldAccess(irVar(evar), cn, false);
                        /* Emit as a statement-level IRK_ASSIGN (the emitter
                         * handles assignment as a statement, not an expression). */
                        out.push(irAssign(fa, irVar(cn)));
                        li = li + 1;
                    }
                    self.fnPtrEnvFn.put(node.name, lfn);
                    self.fnPtrEnvVar.put(node.name, evar);
                }
            }
            /* Every concrete managed local owns its lexical slot, including an
             * empty declaration assigned later. A borrowed initializer is
             * retained; a source +1 transfers directly. */
            if (declType != null && irManagedType(self, declType)) {
                string runtimeType = irManagedRuntimeType(self, declType);
                if (node.initializer != null
                        && !irContextualExpressionOwnsResult(
                        self, node.initializer, declType, varTypes)) {
                    out.push(irExprStmt(
                        irRetainExpression(
                            self, irVar(node.name), declType)));
                }
                self.registerManagedVar(node.name, runtimeType);
                self.maybeRegisterCleanup(node.name,
                    irManagedCleanupSymbol(self, runtimeType),
                    runtimeType, out);
            }
            Node? resolvedDeclType = resolveTypedefType(
                declType, self.analyzed.typedefTable);
            if (resolvedDeclType != null
                    && resolvedDeclType.base == "Thread"
                    && node.initializer != null) {
                self.registerThreadVar(node.name);
                self.useHelper("__btrc_thread_free");
                self.maybeRegisterDirectCleanup(
                    node.name, "__btrc_thread_free", out);
            }
            return;
        }
        if (node.kind == NK_RETURN_STMT) {
            if (self.callableValueEscapes(
                    self.currentReturnTypeNode, node.value_node, varTypes)) {
                self.rejectClosureEscape(node);
            }
            self.lowerReturn(node, varTypes, out);
            return;
        }
        if (node.kind == NK_EXPR_STMT) {
            Node e = node.expr;
            /* Call/new boundaries consume owned operands internally. If the
             * full expression itself yields +1 and its value is discarded,
             * consume that reference at the end of this full expression. */
            IRNode loweredExpression = self.lowerExpr(e, varTypes);
            Node? discardedType = self.resolvedExpressionType(
                e, varTypes);
            if (self.isFreshThreadResult(e, discardedType)) {
                string discardedName = self.freshTemp(
                    "__btrc_discarded_thread");
                IRNode discardedDeclaration = irVarDecl(
                    typeToC(discardedType, self.analyzed),
                    discardedName, loweredExpression);
                self.funcVarDecls.push(discardedDeclaration);
                out.push(discardedDeclaration);
                self.useHelper("__btrc_thread_free");
                Vector<IRNode> freeArgs = [];
                freeArgs.push(irVar(discardedName));
                out.push(irExprStmt(irCall(
                    "__btrc_thread_free", freeArgs)));
            } else if (irManagedType(self, discardedType)
                    && irExpressionOwnsResult(self, e, varTypes)) {
                string discardedName = self.freshTemp(
                    "__btrc_discarded");
                IRNode discardedDeclaration = irVarDecl(
                    typeToC(discardedType, self.analyzed),
                    discardedName, loweredExpression);
                self.funcVarDecls.push(discardedDeclaration);
                out.push(discardedDeclaration);
                out.push(self.releaseVarStmt2(irVar(discardedName),
                    irManagedRuntimeType(self, discardedType)));
            } else {
                out.push(irExprStmt(loweredExpression));
            }
            /* Only terminal destroy() ends auto-management; free() is
             * content cleanup and leaves the instance alive. */
            string destroyedLocal = self.endManualDestroyLifetime(e);
            if (destroyedLocal != "") {
                out.push(irAssign(irVar(destroyedLocal), irLiteral("NULL")));
            }
            return;
        }
        if (node.kind == NK_IF_STMT) {
            out.push(self.lowerIf(node, varTypes));
            return;
        }
        if (node.kind == NK_WHILE_STMT) {
            IRNode cond = self.lowerExpr(node.condition, varTypes);
            IRNode body = self.lowerLoopBody(node.body_node, varTypes);
            out.push(irWhile(cond, body));
            return;
        }
        if (node.kind == NK_DO_WHILE_STMT) {
            IRNode body = self.lowerLoopBody(node.body_node, varTypes);
            IRNode cond = self.lowerExpr(node.condition, varTypes);
            out.push(irDoWhile(body, cond));
            return;
        }
        if (node.kind == NK_C_FOR_STMT) {
            out.push(self.lowerCFor(node, varTypes));
            return;
        }
        if (node.kind == NK_FOR_IN_STMT) {
            self.lowerForIn(node, varTypes, out);
            return;
        }
        if (node.kind == NK_PARALLEL_FOR_STMT) {
            /* `parallel for` lowers to a sequential for-in (no GPU/threading
             * support yet), mirroring statements.lower_stmt's ParallelForStmt
             * branch which delegates to _lower_for_in. The node carries the same
             * var_name / iterable / body fields a for-in does. */
            self.lowerForIn(node, varTypes, out);
            return;
        }
        if (node.kind == NK_DELETE_STMT) {
            self.lowerDelete(node, varTypes, out);
            return;
        }
        if (node.kind == NK_BREAK_STMT) {
            self.emitScopeRelease(self.getControlManagedVars(true), out);
            self.emitControlCleanupExit(true, out);
            self.emitTryPopDepth(self.exitedTryDepth(true), out);
            out.push(irBreak());
            return;
        }
        if (node.kind == NK_CONTINUE_STMT) {
            self.emitScopeRelease(self.getControlManagedVars(false), out);
            self.emitControlCleanupExit(false, out);
            self.emitTryPopDepth(self.exitedTryDepth(false), out);
            out.push(irContinue());
            return;
        }
        if (node.kind == NK_KEEP_STMT) {
            Node? kt = inferType(node.expr, self.analyzed, varTypes);
            if (self.inGenericMethod) {
                kt = resolveGenericType(kt, self.activeTypeMap);
            }
            if (irManagedType(self, kt)) {
                string valueName = self.freshTemp("__btrc_keep_value");
                out.push(irVarDecl(typeToC(kt, self.analyzed), valueName,
                    self.lowerExpr(node.expr, varTypes)));
                IRNode value = irVar(valueName);
                if (self.collectionEdgeKeeps) {
                    /* Public collection methods use keep/release to mutate
                     * persistent element slots.  Those references contribute
                     * to both the total and persistent-edge counts. */
                    out.push(irExprStmt(irManagedRetainEdge(
                        self, value, kt, irVar("self"))));
                } else {
                    /* Ordinary keep creates an external owner (a local, return,
                     * argument, capture, or other raw ARC root). */
                    out.push(irExprStmt(irManagedRetainValue(
                        self, value, kt)));
                }
            }
            return;
        }
        if (node.kind == NK_RELEASE_STMT) {
            self.lowerRelease(node, varTypes, out);
            return;
        }
        if (node.kind == NK_THROW_STMT) {
            /* throw expr -> __btrc_throw(expr) (mirrors control_flow._lower_throw). */
            self.useHelper("__btrc_throw");
            IRNode e = self.lowerExpr(node.expr, varTypes);
            Vector<IRNode> targs = [];
            targs.push(e);
            out.push(irExprStmt(irCall("__btrc_throw", targs)));
            return;
        }
        if (node.kind == NK_TRY_CATCH_STMT) {
            self.lowerTryCatch(node, varTypes, out);
            return;
        }
        if (node.kind == NK_SWITCH_STMT) {
            out.push(self.lowerSwitch(node, varTypes));
            return;
        }
        if (node.kind == NK_BLOCK) {
            IRNode b = self.lowerBlock(node, varTypes);
            /* A source block is a real lexical scope.  Preserve it as a
             * structured IR statement so shadowing, lifetime cleanup, and C11
             * declaration scopes remain intact through emission. */
            out.push(b);
            return;
        }
        /* Unsupported statement kind: abort loudly (matches unsupported_node). */
        print(f"irgen: unsupported statement kind {node.kind}");
        abortGen();
    }

    /* Lower a return statement with ARC return-path release (mirrors the
     * ReturnStmt branch of statements.lower_stmt). */
    /* True when `sourceType` is a class with a no-arg `toString()` returning
     * string (mirrors stringable.has_to_string). */
    public bool sourceHasToString(Node? sourceType) {
        if (sourceType == null || !self.analyzed.isClass(sourceType.base)) { return false; }
        Node? ts = self.analyzed.classMethod(sourceType.base, "toString");
        if (ts == null || ts.kind != NK_METHOD_DECL) { return false; }
        if (ts.params.len > 0) { return false; }
        if (ts.return_type == null || ts.return_type.base != "string") { return false; }
        return true;
    }

    /* Wrap `value` in `<Prefix>_toString(value)` (mirrors stringable.to_string_call).
     * Caller must have checked sourceHasToString(sourceType). */
    public IRNode toStringCall(Node sourceType, IRNode value) {
        string prefix = sourceType.base;
        if (sourceType.generic_args.len > 0 && self.analyzed.isGenericClass(sourceType.base)) {
            prefix = mangleGenericType(sourceType.base, sourceType.generic_args);
        }
        Vector<IRNode> ca = [];
        ca.push(value);
        return irCall(prefix + "_toString", ca);
    }

    /* Implicit class->string coercion (mirrors stringable.coerce_value_to_string
     * / coerce_to_string_param). When `targetType` is `string` and `sourceType`
     * is a class with a no-arg `toString()` returning string, wrap `value` in
     * `<Prefix>_toString(value)`. Otherwise return `value` unchanged. */
    public IRNode coerceToString(Node? targetType, Node? sourceType, IRNode value) {
        if (targetType == null || targetType.base != "string") { return value; }
        if (!self.sourceHasToString(sourceType)) { return value; }
        return self.toStringCall(sourceType, value);
    }

    /* Wrap `value` in an explicit (Base*) cast for a Derived->Base upcast.
     * Returns `value` unchanged unless the target is a concrete (non-generic)
     * class and the source's static type is a strict subclass of it. Generic
     * class targets are skipped: all instances of a generic share one mangled
     * struct, so no upcast is needed (and the cast text would be wrong). A
     * subclass and its base compile to SEPARATE C structs, so a Derived* is not
     * assignment-compatible with a Base* in C; gcc 15 promotes
     * -Wincompatible-pointer-types to a hard error. Mirrors
     * upcast.upcast_class_pointer. */
    public IRNode upcastClassPointer(Node? targetType, Node? sourceType, IRNode value) {
        if (targetType == null || sourceType == null) { return value; }
        if (!self.analyzed.isClass(targetType.base)) { return value; }
        if (targetType.generic_args.len > 0) { return value; }
        if (sourceType.base == targetType.base) { return value; }
        if (!self.analyzed.isSubclass(sourceType.base, targetType.base)) { return value; }
        return irCast(typeToC(targetType, self.analyzed), value);
    }

    /* Apply both string coercion and Derived->Base upcasting to one call
     * argument (mirrors arguments._coerce_arg). */
    public IRNode coerceArg(Node? paramType, Node? srcType, IRNode value) {
        IRNode v = self.coerceToString(paramType, srcType, value);
        return self.upcastClassPointer(paramType, srcType, v);
    }

    /* Upcast Derived->Base generic-constructor args against the RESOLVED generic
     * param types. A generic class's constructor declares its params using the
     * unresolved type params (e.g. `E error`), so the upcast in
     * orderArgsForParams / coerceArg can't fire (`E` isn't a class). Here the
     * `instanceType` (e.g. Result<int, Error>) gives the {T->int, E->Error} map,
     * so the 3rd param resolves to `Error` and a `ValueError*` arg gets the
     * `(Error*)` cast it needs (gcc 15 rejects the bare sibling-pointer pass).
     * `args` is positionally aligned to the constructor params (post
     * orderArgsForParams); upcast only those slots that have a written AST arg.
     * Mirrors variables._lower_var_decl's generic-ctor upcast branch. */
    public void upcastGenericCtorArgs(Node instanceType, Node ctor,
            Vector<Node> astArgs, Vector<IRNode> args,
            Map<string, Node> varTypes) {
        if (ctor.params.len == 0) { return; }
        /* Only safe to align positionally when args weren't reordered by name. */
        if (args.len != astArgs.len) { return; }
        Map<string, Node> typeMap = genericTypeMap(self.analyzed, instanceType);
        int i = 0;
        while (i < args.len && i < ctor.params.len && i < astArgs.len) {
            Node resolved = resolveGenericType(ctor.params.get(i).type, typeMap);
            Node? src = inferType(astArgs.get(i), self.analyzed, varTypes);
            args.set(i, self.upcastClassPointer(resolved, src, args.get(i)));
            i = i + 1;
        }
    }

    /* When a `return` is lexically inside one or more open try blocks, emit the
     * try-level cleanup DISCARD + try-stack pop that the try's normal-exit tail
     * would otherwise run — but which a `return` jumps over, leaving them as dead
     * code after the `return`. Without this, the returned object's cleanup entry
     * stays registered (pointing at memory the caller will later own/free) and the
     * try level stays on the stack; a subsequent __btrc_throw then runs that stale
     * cleanup -> use-after-free. We DISCARD (not release) the cleanups: the
     * returned object escapes and must stay alive, and the non-returned managed
     * locals were already released by emitReturnRelease just before this.
     *
     * The function's open try levels occupy [base+1 .. __btrc_try_top] where
     * base = __btrc_try_top - inTryDepth; so discard every cleanup at
     * try_level >= base+1 (= __btrc_try_top - (inTryDepth - 1)) and pop inTryDepth
     * levels. Mirrors arc._emit_return_try_pop. */
    public void emitReturnTryPop(Vector<IRNode> out) {
        self.emitTryPopDepth(self.inTryDepth, out);
    }

    public void emitReturnCleanupExit(Vector<IRNode> out) {
        self.emitCleanupScopeExit(self.getReturnCleanupMarker(), out);
    }

    public void emitTryPopDepth(int depth, Vector<IRNode> out) {
        if (depth <= 0) { return; }
        /* Only discard cleanups if any were registered (mirrors the gate the
         * try's normal-exit tail uses); a try with no managed locals registers
         * none. */
        if (self.usedHelpers.has("__btrc_register_cleanup")
                || self.usedHelpers.has(
                    "__btrc_register_direct_cleanup")) {
            self.useHelper("__btrc_discard_cleanups");
            IRNode level = irVar("__btrc_try_top");
            if (depth != 1) {
                level = irBinOp(level, "-", irLiteral(Strings.fromInt(depth - 1)));
            }
            Vector<IRNode> dargs = [];
            dargs.push(level);
            out.push(irExprStmt(irCall("__btrc_discard_cleanups", dargs)));
        }
        /* Pop this function's open try levels off the try stack. */
        if (depth == 1) {
            out.push(irExprStmt(irUnaryOp(
                "--", irVar("__btrc_try_top"), false)));
        } else {
            out.push(irExprStmt(irBinOp(
                irVar("__btrc_try_top"), "-=",
                irLiteral(Strings.fromInt(depth)))));
        }
    }

    /* Launder a class-pointer return value through __btrc_launder when the
     * `return` is lowered inside a try/catch construct. gcc -O2 (notably nix's
     * fortify hardening, which forces -O2) miscompiles the setjmp(...)==0 vs catch
     * branches of a try/catch: for a freshly-built object that doesn't otherwise
     * escape, its points-to / store-merging folds the two branches' field inits
     * together and drops the catch object's initialization, so the returned
     * object reads back the wrong field values. Routing the returned pointer
     * through a volatile slot makes it escape, defeating that fold. Identity at
     * runtime; only applied to managed class-pointer returns inside a try/catch.
     * Mirrors arc._maybe_launder_return. */
    public IRNode maybeLaunderReturn(IRNode value) {
        if (self.inTrycatchDepth <= 0) { return value; }
        if (self.currentReturnTypeNode == null) { return value; }
        if (!irManagedType(self, self.currentReturnTypeNode)) { return value; }
        self.useHelper("__btrc_launder");
        Vector<IRNode> largs = [];
        largs.push(value);
        return irCast(self.currentReturnCType, irCall("__btrc_launder", largs));
    }

    public void lowerReturn(Node node, Map<string, Node> varTypes, Vector<IRNode> out) {
        if (node.value_node != null) {
            self.rejectPersistentCallableEscape(
                self.currentReturnTypeNode,
                node.value_node,
                varTypes,
                "a function return");
        }
        lowerOwnedReturn(self, node, varTypes, out);
    }

    /* Lower delete expr -> X_destroy(obj) (or free for non-class), then obj=NULL
     * (mirrors control_flow._lower_delete). */
    public void lowerDelete(Node node, Map<string, Node> varTypes, Vector<IRNode> out) {
        Node? ot = inferType(node.expr, self.analyzed, varTypes);
        /* In a generic body the operand type is `T`/`K`/`V`; resolve it so a
         * generic-instance delete dispatches to the right destructor. */
        if (self.inGenericMethod) { ot = resolveGenericType(ot, self.activeTypeMap); }
        IRNode target = self.lowerExpr(node.expr, varTypes);
        string slotName = self.freshTemp("__btrc_delete_slot");
        /* Managed locals are volatile when their addresses live in the unwind
         * stack. Point at the qualified slot so delete remains warning-clean
         * both inside and outside lexical try blocks. */
        out.push(irVarDecl(typeToC(ot, self.analyzed) + " volatile*", slotName,
            irAddressOf(target)));
        IRNode obj = irDeref(irVar(slotName));
        Vector<IRNode> dargs = [];
        dargs.push(obj);
        IRNode destroy = irExprStmt(irCall("free", dargs));
        if (irManagedType(self, ot)) {
            destroy = irExprStmt(irManagedDestroyValue(
                self, obj, ot));
        }
        Vector<IRNode> destroyBody = [];
        destroyBody.push(destroy);
        out.push(irIf(irBinOp(obj, "!=", irLiteral("NULL")),
            irBlock(destroyBody), null));
        out.push(irAssign(obj, irLiteral("NULL")));
    }

    /* Remove one owned slot, then route the saved value through the shared
     * typed release atom. Clearing first keeps collector visitors from seeing
     * an ownership edge after its count has already been decremented. */
    public void lowerRelease(Node node, Map<string, Node> varTypes, Vector<IRNode> out) {
        Node? et = inferType(node.expr, self.analyzed, varTypes);
        /* In a monomorphized generic body the operand type is `T`/`K`/`V`; resolve
         * it to the concrete element type so the destructor (or skip) is correct. */
        if (self.inGenericMethod) { et = resolveGenericType(et, self.activeTypeMap); }
        /* Primitive values have no ownership unit. Managed strings and class
         * references both dispatch through the shared ownership domain. */
        if (!irManagedType(self, et)) {
            if (self.inGenericMethod) { return; }
            print("internal compiler error: non-managed release reached IR generation");
            abortGen();
        }
        IRNode target = self.lowerExpr(node.expr, varTypes);
        ManagedReleaseSlot releaseSlot = stabilizeManagedReleaseSlot(
            self, node.expr, target, varTypes, out);
        target = releaseSlot.target;
        string slotName = self.freshTemp("__btrc_release_slot");
        out.push(irVarDecl(typeToC(et, self.analyzed) + " volatile*", slotName,
            irAddressOf(target)));
        IRNode slot = irDeref(irVar(slotName));
        string runtimeType = irManagedRuntimeType(self, et);
        bool persistentSlot = releaseSlot.persistent;
        if (persistentSlot && irManagedClassType(self, et)) {
            out.push(irExprStmt(irManagedReplaceEdge(
                self, slot, irLiteral("NULL"), et,
                releaseSlot.owner, false)));
        } else {
            string valueName = self.freshTemp("__btrc_release_value");
            out.push(irVarDecl(
                typeToC(et, self.analyzed), valueName, slot));
            if (persistentSlot) {
                out.push(irExprStmt(irManagedUnlinkEdge(
                    self, irVar(valueName), et, releaseSlot.owner)));
            }
            out.push(irAssign(slot, irLiteral("NULL")));
            if (persistentSlot) {
                out.push(irExprStmt(irManagedReleaseEdge(
                    self, irVar(valueName), et, irLiteral("NULL"))));
            } else {
                out.push(irExprStmt(irManagedReleaseRuntime(
                    self, irVar(valueName), runtimeType)));
            }
        }
        if (irManagedRuntimeCanCycle(self, runtimeType)) {
            if (self.batchExplicitReleases) {
                out.push(irExprStmt(managedArcPoll(self)));
            } else {
                out.push(irExprStmt(managedArcFlush(self)));
            }
        }
    }

    /* Lower try/catch to setjmp/longjmp boilerplate (mirrors
     * control_flow._lower_try_catch, common catch-present subset). */
    public void lowerTryCatch(Node node, Map<string, Node> varTypes, Vector<IRNode> out) {
        /* Mark that everything lowered for this construct (try body, catch,
         * finally) lives inside a try/catch, so class-pointer returns get
         * laundered against the gcc -O2 setjmp cross-branch miscompile (see
         * maybeLaunderReturn). Mirrors control_flow._lower_try_catch's
         * in_trycatch_depth bracket. */
        self.inTrycatchDepth = self.inTrycatchDepth + 1;
        self.lowerTryCatchInner(node, varTypes, out);
        self.inTrycatchDepth = self.inTrycatchDepth - 1;
    }

    public void lowerTryCatchInner(Node node, Map<string, Node> varTypes, Vector<IRNode> out) {
        self.useHelper("__btrc_trycatch_globals");
        self.useHelper("__btrc_push_try");
        self.useHelper("__btrc_throw");
        /* try/catch needs <setjmp.h> (already added at module level when any
         * declaration uses try/catch). */

        /* A try with a `finally` but NO `catch` must run the finally and then
         * RE-THROW any pending exception to the enclosing handler (mirrors
         * control_flow._lower_try_catch finally_only). */
        bool finallyOnly = node.catch_block == null && node.finally_block != null;
        string pendingName = "";
        string errorName = "";
        if (finallyOnly) {
            pendingName = self.freshTemp("__btrc_finally_pending");
            errorName = self.freshTemp("__btrc_finally_error");
        }
        CallableFlowSnapshot incoming = self.snapshotCallableFlow();

        Vector<IRNode> pushTryArgs = [];
        out.push(irExprStmt(irCall("__btrc_push_try", pushTryArgs)));

        /* try block. */
        self.inTryDepth = self.inTryDepth + 1;
        self.pushControlContext("try");
        CallableExceptionalCapture exceptionalCapture =
            self.beginExceptionalCallableCapture(varTypes);
        IRNode tryBody = self.lowerBlock(node.try_block, varTypes);
        CallableFlowSnapshot tryFlow = self.snapshotCallableFlow();
        self.finishExceptionalCallableCapture(
            exceptionalCapture);
        self.restoreCallableFlow(incoming);
        self.popControlContext();
        self.inTryDepth = self.inTryDepth - 1;
        /* Normal exit: discard the cleanup registrations (scope release already
         * freed them), then decrement the try level. Gated on whether any
         * exception cleanup is registered at all (mirrors the global-helper check
         * in control_flow._lower_try_catch). */
        if (self.usedHelpers.has("__btrc_register_cleanup")
                || self.usedHelpers.has(
                    "__btrc_register_direct_cleanup")) {
            self.useHelper("__btrc_discard_cleanups");
            Vector<IRNode> dargs = [];
            dargs.push(irVar("__btrc_try_top"));
            tryBody.stmts.push(irExprStmt(irCall("__btrc_discard_cleanups", dargs)));
        }
        tryBody.stmts.push(irExprStmt(irUnaryOp(
            "--", irVar("__btrc_try_top"), false)));

        /* Without checked throws, every callback state reached while lowering
         * the try is visible to its exceptional edge. */
        Vector<CallableFlowSnapshot> exceptionalFlows = [];
        int exceptionalFlow = 0;
        while (exceptionalFlow
                < exceptionalCapture.states.len) {
            exceptionalFlows.push(
                exceptionalCapture.states.get(exceptionalFlow));
            exceptionalFlow = exceptionalFlow + 1;
        }
        exceptionalFlows.push(tryFlow);
        self.joinCallableFlows(exceptionalFlows);
        CallableFlowSnapshot exceptionalEntry =
            self.snapshotCallableFlow();

        /* Pending-exception flag + message buffer, declared before the if. */
        if (finallyOnly) {
            out.push(irVarDecl(
                "bool", pendingName, irLiteral("false")));
            out.push(irArrayVarDecl(
                "char", errorName, irLiteral("1024"), irLiteral("\"\"")));
        }

        /* catch block. */
        Vector<IRNode> catchStmts = [];
        IRNode catchBody = irBlock(catchStmts);
        CallableFlowSnapshot catchFlow = exceptionalEntry;
        if (finallyOnly) {
            /* No user catch: capture the in-flight exception so the finally can
             * run, then re-throw it after. */
            Vector<IRNode> cstmts = [];
            cstmts.push(irAssign(
                irVar(pendingName), irLiteral("true")));
            Vector<IRNode> copyArgs = [];
            copyArgs.push(irCast("char*", irVar(errorName)));
            copyArgs.push(irVar("__btrc_error_msg"));
            copyArgs.push(irLiteral("1023"));
            cstmts.push(irExprStmt(irCall("strncpy", copyArgs)));
            cstmts.push(irAssign(
                irIndex(irVar(errorName), irLiteral("1023")),
                irLiteral("'\\0'")));
            catchBody = irBlock(cstmts);
        } else if (node.catch_block != null) {
            /* Register the catch variable's type (declared `catch_type`, else
             * `string` — exceptions are string messages) so body inference (e.g.
             * f-string format specifiers) sees `const char*`, not a default int.
             * The Python compiler gets this from analyzer-stamped node_types. */
            Vector<IRNode> catchBindings = [];
            Vector<Node> catchTypes = [];
            Vector<bool> catchOwned = [];
            if (node.catch_var != "") {
                /* Give the catch binding its own message storage. A pointer to
                 * the TLS buffer would be overwritten by any nested catch. */
                Node ctype = makePrimType("string");
                if (node.catch_type != null) { ctype = node.catch_type; }
                self.useHelper("__btrc_strdup");
                self.useHelper("__btrc_str_track");
                Vector<IRNode> copyArgs = [];
                copyArgs.push(irVar("__btrc_error_msg"));
                Vector<IRNode> trackArgs = [];
                trackArgs.push(irCall("__btrc_strdup", copyArgs));
                catchBindings.push(irVarDecl("char*", node.catch_var,
                    irCall("__btrc_str_track", trackArgs)));
                catchTypes.push(ctype);
                catchOwned.push(true);
            }
            catchBody = self.lowerBlockWithBindings(
                node.catch_block, varTypes,
                catchBindings, catchTypes, catchOwned);
            catchFlow = self.snapshotCallableFlow();
            self.restoreCallableFlow(incoming);
            if (node.catch_var != "") {
                /* A catch binding may be intentionally ignored. Keep the C
                 * warning contract explicit without textual statement escapes. */
                int declarationIndex = 0;
                while (declarationIndex < catchBody.stmts.len
                        && !(catchBody.stmts.get(declarationIndex).kind
                                == IRK_VAR_DECL
                            && catchBody.stmts.get(declarationIndex).name
                                == node.catch_var)) {
                    declarationIndex = declarationIndex + 1;
                }
                catchBody.stmts.insert(
                    declarationIndex + 1,
                    irExprStmt(irVar(node.catch_var)));
            }
        }

        Vector<CallableFlowSnapshot> tryFlows = [];
        tryFlows.push(tryFlow);
        tryFlows.push(catchFlow);
        self.joinCallableFlows(tryFlows);

        IRNode frame = irIndex(
            irVar("__btrc_try_stack"), irVar("__btrc_try_top"));
        Vector<IRNode> setjmpArgs = [];
        setjmpArgs.push(irFieldAccess(frame, "env", true));
        IRNode tcIf = irIf(
            irBinOp(irCall("setjmp", setjmpArgs), "==", irLiteral("0")),
            tryBody, catchBody);
        out.push(tcIf);

        /* finally block: emitted inline after the if. */
        if (node.finally_block != null) {
            IRNode fin = self.lowerBlock(node.finally_block, varTypes);
            int i = 0;
            while (i < fin.stmts.len) { out.push(fin.stmts.get(i)); i = i + 1; }
            /* Re-throw the captured exception (finally-only). */
            if (finallyOnly) {
                Vector<IRNode> targs = [];
                targs.push(irCast("const char*", irVar(errorName)));
                Vector<IRNode> rethrow = [];
                rethrow.push(irExprStmt(irCall("__btrc_throw", targs)));
                out.push(irIf(irVar(pendingName), irBlock(rethrow), null));
            }
        }
    }

    /* Lower a switch statement -> IRSwitch with IRCase children (mirrors
     * control_flow._lower_switch). A case with no value is the `default:` clause. */
    public IRNode lowerSwitch(Node node, Map<string, Node> varTypes) {
        IRNode val = self.lowerExpr(node.value_node, varTypes);
        CallableFlowSnapshot incoming = self.snapshotCallableFlow();
        Vector<CallableFlowSnapshot> caseFlows = [];
        bool hasDefault = false;
        Vector<IRNode> cases = [];
        CallableFlowSnapshot fallthroughFlow = incoming;
        bool hasFallthroughFlow = false;
        self.pushControlContext("switch");
        int i = 0;
        while (i < node.cases.len) {
            Node c = node.cases.get(i);
            self.restoreCallableFlow(incoming);
            if (hasFallthroughFlow) {
                Vector<CallableFlowSnapshot> entries = [];
                entries.push(incoming);
                entries.push(fallthroughFlow);
                self.joinCallableFlows(entries);
            }
            CallableFlowSnapshot enclosingCase =
                self.beginCallableScope();
            Map<string, Node> caseTypes = semanticCloneTypes(varTypes);
            Vector<string> caseBorrowedBindings =
                self.snapshotBorrowedLocalBindings();
            IRNode? caseVal = null;
            if (c.value_node != null) {
                caseVal = self.lowerExpr(c.value_node, varTypes);
            } else {
                hasDefault = true;
            }
            Vector<IRNode> body = [];
            self.pushManagedScope();
            int j = 0;
            while (j < c.body_nlist.len) {
                self.lowerStmtInto(c.body_nlist.get(j), caseTypes, body);
                j = j + 1;
            }
            bool fallsThrough = irSequenceMayFallThrough(body);
            Vector<Managed> managed = self.popManagedScope();
            if (fallsThrough) { self.emitScopeRelease(managed, body); }
            self.restoreBorrowedLocalBindings(
                caseBorrowedBindings);
            self.finishCallableScope(enclosingCase);
            CallableFlowSnapshot caseFlow =
                self.snapshotCallableFlow();
            caseFlows.push(caseFlow);
            hasFallthroughFlow = fallsThrough;
            if (hasFallthroughFlow) { fallthroughFlow = caseFlow; }
            cases.push(irCase(caseVal, body));
            i = i + 1;
        }
        self.popControlContext();
        self.restoreCallableFlow(incoming);
        if (!hasDefault) { caseFlows.push(incoming); }
        self.joinCallableFlows(caseFlows);
        return irSwitch(val, cases);
    }

    public IRNode lowerIf(Node node, Map<string, Node> varTypes) {
        IRNode cond = self.lowerExpr(node.condition, varTypes);
        CallableFlowSnapshot incoming = self.snapshotCallableFlow();
        IRNode then_b = self.lowerBlock(node.then_block, varTypes);
        CallableFlowSnapshot thenFlow = self.snapshotCallableFlow();
        self.restoreCallableFlow(incoming);
        IRNode? else_b = null;
        CallableFlowSnapshot elseFlow = incoming;
        if (node.else_block != null) {
            else_b = self.lowerElse(node.else_block, varTypes);
            elseFlow = self.snapshotCallableFlow();
            self.restoreCallableFlow(incoming);
        }
        Vector<CallableFlowSnapshot> flows = [];
        flows.push(thenFlow);
        flows.push(elseFlow);
        self.joinCallableFlows(flows);
        return irIf(cond, then_b, else_b);
    }

    /* Lower an else tail (ElseBlock or ElseIf) into an IRBlock. */
    public IRNode lowerElse(Node node, Map<string, Node> varTypes) {
        if (node.kind == NK_ELSE_BLOCK) {
            return self.lowerBlock(node.body_node, varTypes);
        }
        if (node.kind == NK_ELSE_IF) {
            Vector<IRNode> stmts = [];
            stmts.push(self.lowerIf(node.if_stmt, varTypes));
            return irBlock(stmts);
        }
        Vector<IRNode> empty = [];
        return irBlock(empty);
    }

    public IRNode lowerCFor(Node node, Map<string, Node> varTypes) {
        CallableFlowSnapshot enclosingCallables =
            self.beginCallableScope();
        Map<string, Node> loopTypes = semanticCloneTypes(varTypes);
        IRNode? init = null;
        if (node.init != null) {
            if (node.init.kind == NK_FOR_INIT_VAR) {
                Node vd = node.init.var_decl;
                Node? declType = vd.type;
                if (declType == null) {
                    declType = inferType(
                        vd.initializer, self.analyzed, loopTypes);
                }
                string ct = typeToC(declType, self.analyzed);
                IRNode? vinit = null;
                if (vd.initializer != null) {
                    if (vd.initializer.kind == NK_LIST_LITERAL) {
                        vinit = self.lowerListLiteral(
                            vd.initializer, loopTypes, declType);
                    } else if (vd.initializer.kind == NK_MAP_LITERAL) {
                        vinit = self.lowerMapLiteral(
                            vd.initializer, loopTypes, declType);
                    } else if (vd.initializer.kind == NK_BRACE_INITIALIZER) {
                        vinit = self.lowerBraceInit(
                            vd.initializer, loopTypes, declType);
                    } else {
                        vinit = self.lowerExpr(vd.initializer, loopTypes);
                    }
                }
                if (declType != null) {
                    loopTypes.put(vd.name, declType);
                }
                self.recordCallableDeclaration(vd.name);
                Node? callableDeclType = resolveTypedefType(
                    declType, self.analyzed.typedefTable);
                if (callableDeclType != null
                        && callableDeclType.base == "__fn_ptr") {
                    self.setCallableBindingAbi(
                        vd.name, self.callableExpressionAbi(
                            vd.initializer, loopTypes));
                }
                init = irVarDecl(ct, vd.name, vinit);
            } else if (node.init.kind == NK_FOR_INIT_EXPR) {
                init = irExprStmt(
                    self.lowerExpr(node.init.expression, loopTypes));
            }
        }
        /* Condition defaults to literal 1 when absent (matches iterations.py). */
        IRNode cond = irLiteral("1");
        if (node.condition != null) {
            cond = self.lowerExpr(node.condition, loopTypes);
        }
        IRNode body = self.lowerLoopBody(node.body_node, loopTypes);
        IRNode? update = null;
        if (node.update != null) {
            CallableFlowSnapshot beforeUpdate =
                self.snapshotCallableFlow();
            update = self.lowerExpr(node.update, loopTypes);
            CallableFlowSnapshot updateFlow =
                self.snapshotCallableFlow();
            self.restoreCallableFlow(beforeUpdate);
            Vector<CallableFlowSnapshot> updateFlows = [];
            updateFlows.push(beforeUpdate);
            updateFlows.push(updateFlow);
            self.joinCallableFlows(updateFlows);
        }
        IRNode lowered = irFor(init, cond, update, body);
        self.finishCallableScope(enclosingCallables);
        return lowered;
    }

    /* Build a loop body block with `prefix` statements prepended to the lowered
     * body (the binding decls), mirroring body_block.stmts.insert(0, ...). */
    public IRNode loopBodyWithPrefix(Node bodyNode,
            Map<string, Node> varTypes, Vector<IRNode> prefix,
            Vector<Node> types, Vector<bool> owned) {
        return self.lowerLoopBodyWithBindings(
            bodyNode, varTypes, prefix, types, owned);
    }

    /* Iterable-value C type for a generic arg: class values are reference types,
     * so append a pointer if not already a pointer (mirrors _iter_value_c). */
    public string iterValueC(Node t) {
        string c = typeToC(t, self.analyzed);
        bool isPtr = false;
        if (c.length() >= 1 && c.substring(c.length() - 1, 1) == "*") { isPtr = true; }
        if (t != null && self.analyzed.isClass(t.base) && !isPtr) {
            return c + "*";
        }
        return c;
    }

    /* Lower for-in to a C-style for loop (mirrors iterations._lower_for_in). */
    public void lowerForIn(Node node, Map<string, Node> varTypes, Vector<IRNode> out) {
        Map<string, Node> loopTypes = semanticCloneTypes(varTypes);
        Node iterable = node.iterable;
        string varName = node.var_name;

        /* range(...) form. */
        if (iterable.kind == NK_CALL_EXPR && iterable.callee != null
                && iterable.callee.kind == NK_IDENTIFIER
                && iterable.callee.name == "range") {
            self.lowerRangeFor(
                varName, iterable.args, node.body_node, loopTypes, out);
            return;
        }

        Node? iterType = inferType(iterable, self.analyzed, loopTypes);
        IRNode irIter = self.lowerExpr(iterable, loopTypes);

        /* Iterable protocol: generic class with iterLen + iterGet methods. */
        if (iterType != null
                && semanticIterableMethod(
                    iterType, "iterLen", self.analyzed) != null
                && semanticIterableMethod(
                    iterType, "iterGet", self.analyzed) != null) {
            self.lowerIterableForIn(
                node, irIter, iterType, varName, loopTypes, out);
            return;
        }

        /* String iteration: for c in str. */
        if (iterType != null && iterType.base == "string" && iterType.pointer_depth == 0
                && iterType.generic_args.len == 0) {
            self.lowerStringForIn(
                node, irIter, varName, loopTypes, out);
            return;
        }

        print("internal compiler error: unproven for-in iterable reached IR generation");
        abortGen();
    }

    /* for-in via Iterable protocol (iterLen/iterGet/iterValueAt). */
    public void lowerIterableForIn(Node node, IRNode irIter, Node iterType, string varName, Map<string, Node> varTypes, Vector<IRNode> out) {
        string calleePrefix = iterType.base;
        if (self.analyzed.isGenericClass(iterType.base)) {
            calleePrefix = mangleGenericType(
                iterType.base, iterType.generic_args);
        }
        string idx = self.freshTemp("__i");
        string nVar = self.freshTemp("__n");
        string iterVar = self.freshTemp("__iter");
        out.push(irVarDecl(
            typeToC(iterType, self.analyzed), iterVar, irIter));
        string ownedRuntimeType = beginOwnedIteration(
            self, node.iterable, iterType, varTypes, iterVar, out);
        Node getMethod = semanticIterableMethod(
            iterType, "iterGet", self.analyzed);
        Node elemT = semanticIterableResolvedType(
            getMethod.return_type, iterType, self.analyzed);
        string elemC = self.iterValueC(elemT);
        varTypes.put(varName, elemT);
        Vector<IRNode> bindings = [];
        Vector<Node> bindingTypes = [];
        Vector<bool> bindingOwned = [];
        Vector<IRNode> gargs = [];
        gargs.push(irVar(iterVar));
        gargs.push(irVar(idx));
        bindings.push(irVarDecl(elemC, varName,
            irCall(calleePrefix + "_iterGet", gargs)));
        bindingTypes.push(elemT);
        bindingOwned.push(true);
        /* Two-variable iteration (for k, v in map). var_name2 is nullable. */
        string vn2 = "";
        if (node.var_name2 != null) { vn2 = node.var_name2; }
        Node? valueMethod = semanticIterableMethod(
            iterType, "iterValueAt", self.analyzed);
        if (vn2 != "" && valueMethod != null) {
            Node v2T = semanticIterableResolvedType(
                valueMethod.return_type, iterType, self.analyzed);
            string vC = self.iterValueC(v2T);
            varTypes.put(vn2, v2T);
            Vector<IRNode> vargs = [];
            vargs.push(irVar(iterVar));
            vargs.push(irVar(idx));
            bindings.push(irVarDecl(vC, vn2,
                irCall(calleePrefix + "_iterValueAt", vargs)));
            bindingTypes.push(v2T);
            bindingOwned.push(true);
        }
        IRNode body = self.loopBodyWithPrefix(
            node.body_node, varTypes, bindings,
            bindingTypes, bindingOwned);
        Vector<IRNode> nargs = [];
        nargs.push(irVar(iterVar));
        Node lenMethod = semanticIterableMethod(
            iterType, "iterLen", self.analyzed);
        Node lenType = semanticIterableResolvedType(
            lenMethod.return_type, iterType, self.analyzed);
        out.push(irVarDecl(typeToC(lenType, self.analyzed), nVar,
            irCall(calleePrefix + "_iterLen", nargs)));
        IRNode forInit = irVarDecl("int", idx, irLiteral("0"));
        IRNode cond = irBinOp(irVar(idx), "<", irVar(nVar));
        IRNode upd = irUnaryOp("++", irVar(idx), false);
        out.push(irFor(forInit, cond, upd, body));
        endOwnedIteration(
            self, iterVar, ownedRuntimeType, out);
    }

    /* for c in str -> char-by-char iteration. */
    public void lowerStringForIn(Node node, IRNode irIter, string varName, Map<string, Node> varTypes, Vector<IRNode> out) {
        string idx = self.freshTemp("__i");
        string iterVar = self.freshTemp("__iter");
        out.push(irVarDecl("char*", iterVar, irIter));
        Node stringType = makePrimType("string");
        string ownedRuntimeType = beginOwnedIteration(
            self, node.iterable, stringType,
            varTypes, iterVar, out);
        varTypes.put(varName, makePrimType("char"));
        Vector<IRNode> prefix = [];
        prefix.push(irVarDecl("char", varName,
            irIndex(irVar(iterVar), irVar(idx))));
        Vector<Node> bindingTypes = [];
        bindingTypes.push(makePrimType("char"));
        Vector<bool> bindingOwned = [];
        bindingOwned.push(false);
        IRNode body = self.loopBodyWithPrefix(
            node.body_node, varTypes, prefix,
            bindingTypes, bindingOwned);
        IRNode forInit = irVarDecl("int", idx, irLiteral("0"));
        IRNode cond = irBinOp(
            irIndex(irVar(iterVar), irVar(idx)), "!=", irLiteral("'\\0'"));
        IRNode upd = irUnaryOp("++", irVar(idx), false);
        out.push(irFor(forInit, cond, upd, body));
        endOwnedIteration(
            self, iterVar, ownedRuntimeType, out);
    }

    /* for x in range(...) -> C for loop (1, 2, or 3+ args). */
    public void lowerRangeFor(string varName, Vector<Node> args, Node bodyNode, Map<string, Node> varTypes, Vector<IRNode> out) {
        string startName = self.freshTemp("__range_start");
        string endName = self.freshTemp("__range_end");
        string stepName = self.freshTemp("__range_step");
        IRNode start = irLiteral("0");
        IRNode end = irLiteral("0");
        IRNode step = irLiteral("1");
        if (args.len == 1) {
            end = self.lowerExpr(args.get(0), varTypes);
            out.push(irVarDecl("int", endName, end));
        } else if (args.len == 2 || args.len == 3) {
            start = self.lowerExpr(args.get(0), varTypes);
            end = self.lowerExpr(args.get(1), varTypes);
            out.push(irVarDecl("int", startName, start));
            out.push(irVarDecl("int", endName, end));
            start = irVar(startName);
            if (args.len == 3) {
                step = self.lowerExpr(args.get(2), varTypes);
                out.push(irVarDecl("int", stepName, step));
                step = irVar(stepName);
                Vector<IRNode> zeroStep = [];
                Vector<IRNode> errorArgs = [];
                errorArgs.push(irLiteral("\"range step cannot be zero\\n\""));
                errorArgs.push(irVar("stderr"));
                zeroStep.push(irExprStmt(irCall("fputs", errorArgs)));
                Vector<IRNode> exitArgs = [];
                exitArgs.push(irLiteral("1"));
                zeroStep.push(irExprStmt(irCall("exit", exitArgs)));
                out.push(irIf(irBinOp(step, "==", irLiteral("0")),
                    irBlock(zeroStep), null));
            }
        } else {
            print(f"irgen: range expects 1 to 3 arguments, got {args.len}");
            abortGen();
        }
        end = irVar(endName);
        varTypes.put(varName, makePrimType("int"));
        IRNode body = self.lowerLoopBody(bodyNode, varTypes);
        IRNode forInit = irVarDecl("int", varName, start);
        IRNode cond = irBinOp(irVar(varName), "<", end);
        IRNode update = irUnaryOp("++", irVar(varName), false);
        if (args.len == 3) {
            IRNode posCond = irBinOp(irVar(varName), "<", end);
            IRNode negCond = irBinOp(irVar(varName), ">", end);
            cond = irTernary(
                irBinOp(step, ">", irLiteral("0")), posCond, negCond);
            update = irBinOp(irVar(varName), "+=", step);
        }
        out.push(irFor(forInit, cond, update, body));
    }

    /* --- expression lowering --- */

    public IRNode lowerExpr(Node node, Map<string, Node> varTypes) {
        if (node == null) { return irLiteral("0"); }
        if (self.gpuCpu.active && node.kind == NK_INDEX_EXPR) {
            return lowerGpuCpuIndex(self, node, varTypes);
        }
        /* ARC: an owning-temporary argument hoisted into a temp var resolves to
         * that temp (mirrors expressions.lower_expr's _owning_temp_overrides
         * check). The temp is declared/initialized in the call's pre-stmts. */
        if (self.owningTempOverrides.len > 0) {
            string key = astNodeKey(node);
            if (self.owningTempOverrides.has(key)) {
                return self.owningTempOverrides.get(key);
            }
        }
        if (node.kind == NK_INT_LITERAL) {
            return irLiteral(formatCIntegerLiteral(node.raw, node.value_int));
        }
        if (node.kind == NK_FLOAT_LITERAL) {
            string raw = node.raw;
            if (raw == "") { raw = f"{node.value_float}"; }
            if (self.gpuCpu.active
                    && !raw.endsWith("f") && !raw.endsWith("F")) {
                raw = raw + "f";
            }
            return irLiteral(raw);
        }
        if (node.kind == NK_STRING_LITERAL) { return irLiteral(node.value_string); }
        if (node.kind == NK_CHAR_LITERAL) { return irLiteral(node.value_string); }
        if (node.kind == NK_F_STRING_LITERAL) { return self.lowerFString(node, varTypes); }
        if (node.kind == NK_BOOL_LITERAL) {
            if (node.value_bool) { return irLiteral("true"); }
            return irLiteral("false");
        }
        if (node.kind == NK_NULL_LITERAL) { return irLiteral("NULL"); }
        if (node.kind == NK_IDENTIFIER) {
            if (self.inEnumInitializer
                    && self.enumLoweringMembers.has(node.name)) {
                string prefix = self.enumLoweringOwner;
                if (prefix != "") { prefix = prefix + "_"; }
                return irLiteral(prefix + node.name);
            }
            /* Bare enum value (RED -> Color_RED). Mirrors expressions.
             * _lower_identifier's enum_table scan. */
            if (self.analyzed.isEnumValue(node.name)) {
                string owner = self.analyzed.enumOwnerOf(node.name);
                if (owner != "") { owner = owner + "_"; }
                return irLiteral(owner + node.name);
            }
            return irVar(node.name);
        }
        if (node.kind == NK_SELF_EXPR) { return irVar("self"); }
        if (node.kind == NK_SUPER_EXPR) {
            Node? parentType = inferType(node, self.analyzed, varTypes);
            if (parentType == null) {
                print("internal compiler error: unresolved super expression");
                abortGen();
            }
            return irCast(
                typeToC(parentType, self.analyzed), irVar("self"));
        }
        if (node.kind == NK_NEW_EXPR) {
            return lowerNewWithOwnership(self, node, varTypes);
        }
        if (node.kind == NK_FIELD_ACCESS_EXPR) {
            return lowerOwnedFieldAccess(self, node, varTypes);
        }
        if (node.kind == NK_BINARY_EXPR) {
            return lowerOwnedBinary(self, node, varTypes);
        }
        if (node.kind == NK_UNARY_EXPR) { return self.lowerUnary(node, varTypes); }
        if (node.kind == NK_CALL_EXPR) {
            return lowerCallWithOwnership(self, node, varTypes);
        }
        if (node.kind == NK_CAST_EXPR) {
            return irCast(typeToC(self.resolveBodyType(node.target_type), self.analyzed),
                          self.lowerExpr(node.expr, varTypes));
        }
        if (node.kind == NK_TERNARY_EXPR) {
            return self.lowerTypedTernary(node, varTypes);
        }
        if (node.kind == NK_INDEX_EXPR) {
            return lowerOwnedIndex(self, node, varTypes);
        }
        if (node.kind == NK_ASSIGN_EXPR) {
            int callableAssignmentAbi = 0;
            bool callableAssignment = node.op == "="
                && node.target != null
                && node.target.kind == NK_IDENTIFIER;
            if (callableAssignment) {
                callableAssignmentAbi = self.callableExpressionAbi(
                    node.value_node, varTypes);
            }
            Node? callableStorageType = inferType(
                node.target, self.analyzed, varTypes);
            bool lexicalCallableTarget = node.target != null
                && node.target.kind == NK_IDENTIFIER
                && self.callableIdentifierIsLexicalLocal(
                    node.target.name);
            if (node.op == "=" && !lexicalCallableTarget) {
                string boundary = "persistent storage";
                if (node.target != null
                        && node.target.kind == NK_IDENTIFIER) {
                    boundary = "global storage";
                } else if (node.target != null
                        && node.target.kind == NK_FIELD_ACCESS_EXPR) {
                    boundary = "field storage";
                } else if (node.target != null
                        && node.target.kind == NK_INDEX_EXPR) {
                    boundary = "indexed storage";
                }
                self.rejectPersistentCallableEscape(
                    callableStorageType,
                    node.value_node,
                    varTypes,
                    boundary);
            }
            IRNode? ownedTarget = lowerOwnedAssignment(
                self, node, varTypes);
            if (ownedTarget != null) { return ownedTarget; }
            Node? closureTargetType = inferType(
                node.target, self.analyzed, varTypes);
            if (self.callableValueEscapes(
                    closureTargetType, node.value_node, varTypes)) {
                self.rejectClosureEscape(node);
            }
            IRNode? managedLocal = lowerManagedLocalStore(
                self, node, varTypes);
            if (managedLocal != null) { return managedLocal; }
            IRNode? managedField = self.lowerManagedFieldAssignment(
                node, varTypes);
            if (managedField != null) { return managedField; }
            IRNode? indirect = self.lowerIndirectAssignment(node, varTypes);
            if (indirect != null) { return indirect; }
            /* Property setter: obj.prop = v -> ClassName_set_prop(obj, v);
             * self.prop = v inside the class -> backing field assign. */
            if (node.op == "=" && node.target != null
                    && node.target.kind == NK_FIELD_ACCESS_EXPR) {
                Node tgt = node.target;
                Node? ot = self.resolvedExpressionType(
                    tgt.obj, varTypes);
                Node? property = instanceMemberForType(
                    self.analyzed, ot, tgt.field);
                if (ot != null && property != null
                        && property.kind == NK_PROPERTY_DECL) {
                    Node? propertyType = resolvedInstanceMemberType(
                        self.analyzed, ot, property);
                    if (propertyType == null) {
                        propertyType = property.type;
                    }
                    return lowerPropertyStoreWithOwnership(self,
                        node, ot, property, propertyType, varTypes);
                }
            }
            /* Collection index assignment: coll[i] = v -> {mangled}_set(coll, i, v)
             * (mirrors fields._lower_assign index-assignment branch). A generic
             * collection instance is a C pointer, so `coll[i] = v` is not a valid
             * lvalue; route the store through the collection's _set helper.
             * Inside a generic method body, `self.data[i] = v` indexes the raw
             * `T*` backing array, so skip the _set route there (mirrors the
             * NK_INDEX_EXPR read path's `!inGenericMethod` guard). */
            if (node.op == "=" && node.target != null
                    && node.target.kind == NK_INDEX_EXPR
                    && !self.inGenericMethod) {
                Node itgt = node.target;
                Node? iott = inferType(itgt.obj, self.analyzed, varTypes);
                /* Only a collection VALUE (pointer_depth 0) routes through _set;
                 * a raw `T*`/`T**` pointer field (e.g. `self.data` inside a
                 * generic collection method, resolved to `Vector<Obj>*`) is a
                 * plain C array and must use `arr[i] = v`. Without the
                 * pointer_depth guard, monomorphization makes `self.data[i] = v`
                 * inside Vector<Vector<Obj>> wrongly call Vector_Obj_set. */
                if (iott != null && iott.generic_args.len > 0
                        && iott.pointer_depth == 0
                        && self.analyzed.isGenericClass(iott.base)) {
                    string mangled = mangleGenericType(iott.base, iott.generic_args);
                    IRNode iobj2 = self.lowerExpr(itgt.obj, varTypes);
                    IRNode iidx2 = self.lowerExpr(itgt.index, varTypes);
                    IRNode ival2 = self.lowerExpr(node.value_node, varTypes);
                    Vector<IRNode> setArgs = [];
                    setArgs.push(iobj2);
                    setArgs.push(iidx2);
                    setArgs.push(ival2);
                    return irCall(mangled + "_set", setArgs);
                }
            }
            /* Empty {} / [] assigned to a collection-typed target -> coll_new()
             * (mirrors fields._lower_assign empty-brace branch). The target type
             * is inferred (e.g. a Map/Set/Vector field). */
            if (node.op == "=" && node.value_node != null
                    && (node.value_node.kind == NK_BRACE_INITIALIZER
                        || node.value_node.kind == NK_MAP_LITERAL
                        || node.value_node.kind == NK_LIST_LITERAL)) {
                Node? tt = inferType(node.target, self.analyzed, varTypes);
                if (tt != null && tt.generic_args.len > 0
                        && self.analyzed.isGenericClass(tt.base)) {
                    IRNode tgt2 = self.lowerExpr(node.target, varTypes);
                    IRNode rhs = irLiteral("NULL");
                    if (node.value_node.kind == NK_BRACE_INITIALIZER) {
                        rhs = self.lowerBraceInit(node.value_node, varTypes, tt);
                    } else if (node.value_node.kind == NK_MAP_LITERAL) {
                        rhs = self.lowerMapLiteral(node.value_node, varTypes, tt);
                    } else {
                        rhs = self.lowerListLiteral(node.value_node, varTypes, tt);
                    }
                    return irBinOp(tgt2, "=", rhs);
                }
            }
            /* Assignment is lowered as an expression -> IRBinOp with the op,
             * for both `=` and compound (`+=`, etc.). The emitter wraps it in
             * parens: `(x = 5)`, `(sum += i)`. (Matches fields.py _lower_assign
             * for the non-property, non-collection subset.) */
            IRNode target = self.lowerExpr(node.target, varTypes);
            IRNode value = self.lowerExpr(node.value_node, varTypes);
            if (node.op != "=" && node.op.length() > 1) {
                Node? targetType = self.resolvedExpressionType(
                    node.target, varTypes);
                Node? valueType = self.resolvedExpressionType(
                    node.value_node, varTypes);
                return self.lowerDirectCompound(
                    node.op, target, value, targetType, valueType);
            }
            /* Upcast: storing a subclass instance into a base-class field/var
             * needs an explicit cast — sibling struct pointers are otherwise
             * incompatible C (gcc 15 rejects `Animal* = Dog*`). Mirrors
             * fields._lower_assign's upcast_class_pointer (the `=` branch). */
            if (node.op == "=") {
                Node? tType = inferType(node.target, self.analyzed, varTypes);
                Node? vType = inferType(node.value_node, self.analyzed, varTypes);
                if (tType != null) {
                    value = self.lowerAssignedValue(
                        node.value_node, tType, varTypes);
                }
                value = self.upcastClassPointer(tType, vType, value);
                Node? callableTargetType = resolveTypedefType(
                    tType, self.analyzed.typedefTable);
                if (node.target.kind == NK_IDENTIFIER
                        && callableTargetType != null
                        && callableTargetType.base == "__fn_ptr"
                        && lexicalCallableTarget) {
                    self.setCallableBindingAbi(
                        node.target.name, callableAssignmentAbi);
                    self.recordExceptionalCallableFlow();
                }
                if (tType != null
                        && node.target.kind != NK_IDENTIFIER) {
                    return self.lowerDirectStore(
                        target, value, tType);
                }
            }
            return irBinOp(target, node.op, value);
        }
        if (node.kind == NK_SIZEOF_EXPR) {
            return self.lowerSizeof(node, varTypes);
        }
        if (node.kind == NK_LIST_LITERAL) {
            return self.lowerListLiteral(node, varTypes, null);
        }
        if (node.kind == NK_MAP_LITERAL) {
            return self.lowerMapLiteral(node, varTypes, null);
        }
        if (node.kind == NK_BRACE_INITIALIZER) {
            return self.lowerBraceInit(node, varTypes, null);
        }
        if (node.kind == NK_LAMBDA_EXPR) {
            return self.lowerLambda(node, varTypes);
        }
        if (node.kind == NK_TUPLE_LITERAL) {
            return self.lowerTupleLiteral(node, varTypes);
        }
        if (node.kind == NK_SPAWN_EXPR) {
            return self.lowerSpawn(node, varTypes);
        }
        print(f"irgen: unsupported expression kind {node.kind}");
        abortGen();
        return irLiteral("0");
    }

    /* Compute a lambda's captured variable names: identifiers used in the body
     * that are enclosing locals/params (present in varTypes) and are NOT lambda
     * params, sorted lexicographically. Mirrors analyzer._analyze_lambda's
     * capture computation (btrcc does it on-demand at lowering, having no
     * persistent scope). Module-level globals are visible directly inside the
     * lifted lambda (file scope), so they are NEVER captured even though they
     * appear in varTypes (the global scope is seeded into every function's
     * varTypes); mirrors the reference, where captures come from enclosing
     * function scope, not the module scope. */
    public Vector<string> lambdaCaptureNames(Node node, Map<string, Node> varTypes) {
        Map<string, bool> paramNames = {};
        int pi = 0;
        while (pi < node.params.len) {
            paramNames.put(node.params.get(pi).name, true);
            pi = pi + 1;
        }
        Map<string, bool> usedNames = {};
        collectIdentifiers(node.body_node, usedNames);
        Vector<string> capNames = [];
        Vector<string> usedKeys = usedNames.keys();
        int uk = 0;
        while (uk < usedKeys.len) {
            string nm = usedKeys.get(uk);
            if (!paramNames.has(nm) && varTypes.has(nm)
                    && !self.analyzed.globalVarTypes.has(nm)) {
                capNames.push(nm);
            }
            uk = uk + 1;
        }
        /* Sort capture names lexicographically (insertion sort via strcmp). */
        int si = 1;
        while (si < capNames.len) {
            string keyN = capNames.get(si);
            int sj = si - 1;
            while (sj >= 0 && strcmp(capNames.get(sj), keyN) > 0) {
                capNames.set(sj + 1, capNames.get(sj));
                sj = sj - 1;
            }
            capNames.set(sj + 1, keyN);
            si = si + 1;
        }
        return capNames;
    }

    /* A capturing lambda has an extra environment parameter and therefore
     * cannot be represented by the plain-C-pointer __fn_ptr ABI. Match a value
     * against its contextual type recursively so collection literals cannot
     * erase that environment. The sole storage exception is handled by the
     * caller: an inferred local bound directly to the lambda literal. */
    public bool callableValueEscapes(
            Node? expected, Node? value, Map<string, Node> varTypes) {
        if (expected == null || value == null) { return false; }
        if (value.kind == NK_LIST_LITERAL || value.kind == NK_BRACE_INITIALIZER) {
            Node? elementType = null;
            if (expected.is_array) {
                Node arrayElement = Node();
                arrayElement.kind = NK_TYPE_EXPR;
                arrayElement.base = expected.base;
                arrayElement.generic_args = expected.generic_args;
                arrayElement.pointer_depth = expected.pointer_depth;
                elementType = arrayElement;
            } else if ((expected.base == "Array" || expected.base == "List"
                    || expected.base == "Set" || expected.base == "Vector")
                    && expected.generic_args.len == 1) {
                elementType = expected.generic_args.get(0);
            }
            if (elementType != null) {
                int i = 0;
                while (i < value.elements.len) {
                    if (self.callableValueEscapes(
                            elementType, value.elements.get(i), varTypes)) {
                        return true;
                    }
                    i = i + 1;
                }
            }
            return false;
        }
        if (value.kind == NK_MAP_LITERAL && expected.base == "Map"
                && expected.generic_args.len == 2) {
            int i = 0;
            while (i < value.entries.len) {
                Node entry = value.entries.get(i);
                if (self.callableValueEscapes(
                        expected.generic_args.get(0), entry.key, varTypes)
                        || self.callableValueEscapes(
                            expected.generic_args.get(1), entry.value_node,
                            varTypes)) {
                    return true;
                }
                i = i + 1;
            }
            return false;
        }
        if (value.kind == NK_TUPLE_LITERAL && expected.base == "Tuple") {
            int i = 0;
            while (i < value.elements.len && i < expected.generic_args.len) {
                if (self.callableValueEscapes(
                        expected.generic_args.get(i), value.elements.get(i),
                        varTypes)) {
                    return true;
                }
                i = i + 1;
            }
            return false;
        }
        if (expected.base != "__fn_ptr") { return false; }
        if (value.kind == NK_LAMBDA_EXPR) {
            return self.lambdaCaptureNames(value, varTypes).len > 0;
        }
        return value.kind == NK_IDENTIFIER && self.hasClosureEnv(value.name);
    }

    public void rejectClosureEscape(Node site) {
        print(f"A capturing lambda cannot escape through a bare __fn_ptr; "
            + f"a closure value is required at {site.line}:{site.col}");
        abortGen();
    }

    public void rejectNestedCallableCaptures(
            Vector<string> captures, Node site) {
        int i = 0;
        while (i < captures.len) {
            string capture = captures.get(i);
            if (self.hasClosureEnv(capture)) {
                print(f"A lambda cannot capture an environment-bearing "
                    + f"callable ({capture}); a closure value is required at "
                    + f"{site.line}:{site.col}");
                abortGen();
            }
            i = i + 1;
        }
    }

    /* Lower a lambda expression to a lifted static function (+ a capture-env
     * struct when it closes over enclosing locals), appended to the current
     * module. Returns an IRVar naming the function, since lambdas are used as
     * function-pointer values. Mirrors ir/gen/lambdas.py lower_lambda. */
    public IRNode lowerLambda(Node node, Map<string, Node> varTypes) {
        int lambdaId = self.freshLambdaId();
        string fnName = "__btrc_lambda_" + Strings.fromInt(lambdaId);
        string envName = fnName + "_env";

        Vector<string> capNames = self.lambdaCaptureNames(node, varTypes);
        bool hasCaptures = capNames.len > 0;
        self.rejectNestedCallableCaptures(capNames, node);

        /* Capture-env struct (one field per captured variable). */
        if (hasCaptures) {
            IRStructDef sd = IRStructDef();
            sd.name = envName;
            int ci = 0;
            while (ci < capNames.len) {
                string cn = capNames.get(ci);
                string cty = typeToC(
                    self.resolveBodyType(varTypes.get(cn)), self.analyzed);
                sd.fields.push(IRStructField(cty, cn));
                ci = ci + 1;
            }
            self.curModule.struct_defs.push(sd);
        }

        /* Build the lifted function. */
        IRFunction fn = IRFunction();
        fn.name = fnName;
        fn.is_static = true;

        /* Return type: explicit annotation, else infer from __fn_ptr type,
         * else from the body expression, else void. */
        Node fpt = lambdaFnPtrType(node, self.analyzed, varTypes);
        string retC = "void";
        Node? retType = node.return_type;
        if (node.return_type != null) {
            retC = typeToC(node.return_type, self.analyzed);
        } else if (fpt.generic_args.len > 0) {
            retType = fpt.generic_args.get(0);
            retC = typeToC(retType, self.analyzed);
        }
        fn.return_type = retC;

        /* Params: the lambda's own params, then a trailing void* env when the
         * lambda captures (kept off the typedef, so captured lambdas are called
         * directly by name with the env arg). */
        int p2 = 0;
        while (p2 < node.params.len) {
            Node pp = node.params.get(p2);
            fn.params.push(IRParam(typeToC(pp.type, self.analyzed), pp.name));
            p2 = p2 + 1;
        }
        if (hasCaptures) {
            fn.params.push(IRParam("void*", "__btrc_env"));
        }

        /* Body: unpack captures from env, then the lowered lambda body. Lower in
         * an isolated ARC/return context (the lambda is a separate C function). */
        Vector<IRNode> body = [];
        if (hasCaptures) {
            IRNode envCast = irCast("struct " + envName + "*", irVar("__btrc_env"));
            body.push(irVarDecl("struct " + envName + "*", "__env", envCast));
            int ci2 = 0;
            while (ci2 < capNames.len) {
                string cn = capNames.get(ci2);
                string cty = typeToC(varTypes.get(cn), self.analyzed);
                IRNode fa = irFieldAccess(irVar("__env"), cn, true);
                body.push(irVarDecl(cty, cn, fa));
                ci2 = ci2 + 1;
            }
        }

        /* Save/restore managed-scope + return context around the body. */
        ScopeSnapshot snap = self.enterIsolatedScope(retC, retType);

        /* Parameters and unpacked capture fields are borrowed representations,
         * not ARC-owning locals.  Record them before lowering either body form
         * so a same-named managed global cannot supply replacement semantics. */
        int borrowedParam = 0;
        while (borrowedParam < node.params.len) {
            self.borrowedLocalBindings.put(
                node.params.get(borrowedParam).name, true);
            borrowedParam = borrowedParam + 1;
        }
        int borrowedCapture = 0;
        while (borrowedCapture < capNames.len) {
            self.borrowedLocalBindings.put(
                capNames.get(borrowedCapture), true);
            borrowedCapture = borrowedCapture + 1;
        }

        /* varTypes for the lambda body: the captured vars + the lambda params
         * (captures are unpacked as locals; params are bound). Start from the
         * enclosing varTypes so types resolve, then add params. */
        Map<string, Node> bodyVars = {};
        Vector<string> evk = varTypes.keys();
        int ek = 0;
        while (ek < evk.len) {
            string vn = evk.get(ek);
            bodyVars.put(vn, varTypes.get(vn));
            ek = ek + 1;
        }
        int p3 = 0;
        while (p3 < node.params.len) {
            Node pp = node.params.get(p3);
            if (pp.type != null) { bodyVars.put(pp.name, pp.type); }
            p3 = p3 + 1;
        }

        Node lb = node.body_node;
        if (lb != null && lb.kind == NK_LAMBDA_BLOCK && lb.body_node != null) {
            IRNode blk = self.lowerBlock(lb.body_node, bodyVars);
            int b = 0;
            while (b < blk.stmts.len) { body.push(blk.stmts.get(b)); b = b + 1; }
        } else if (lb != null && lb.kind == NK_LAMBDA_EXPR_BODY && lb.expression != null) {
            IRNode rexpr = self.lowerExpr(lb.expression, bodyVars);
            body.push(irReturn(rexpr));
        }

        self.exitIsolatedScope(snap);

        fn.body = irBlock(body);
        self.curModule.functions.push(fn);

        /* Link this lambda to a following var-decl env allocation. */
        self.lastLambdaId = lambdaId;
        return irVar(fnName);
    }

    /* Value results cross pthread's void* boundary through exact typed storage.
     * Object/data pointers transfer directly; scalars, enums, aggregates, and
     * function pointers are copied through a heap box. Function pointers must
     * never be converted to void*: ISO C does not define that conversion. */
    public bool threadResultRequiresBox(Node? retType) {
        if (retType == null) { return false; }
        Node? resolved = resolveTypedefType(
            retType, self.analyzed.typedefTable);
        if (resolved == null || (resolved.base == "void"
                && resolved.pointer_depth == 0)) {
            return false;
        }
        if (resolved.base == "__fn_ptr") { return true; }
        return !semanticIsReferenceType(resolved, self.analyzed);
    }

    public bool isFreshThreadResult(Node? expression, Node? resultType) {
        Node? resolved = resolveTypedefType(
            resultType, self.analyzed.typedefTable);
        if (expression == null || resolved == null
                || resolved.base != "Thread") {
            return false;
        }
        if (expression.kind == NK_SPAWN_EXPR
                || expression.kind == NK_CALL_EXPR) {
            return true;
        }
        if (expression.kind == NK_NULL_LITERAL) { return false; }
        if (expression.kind == NK_TERNARY_EXPR) {
            return self.isFreshThreadResult(
                    expression.true_expr, resolved)
                && self.isFreshThreadResult(
                    expression.false_expr, resolved);
        }
        return false;
    }

    public string threadResultStorageC(Node resultType) {
        Node storageType = copyTypeExpr(resultType);
        storageType.is_const = false;
        storageType.is_static = false;
        storageType.is_extern = false;
        storageType.is_volatile = false;
        return typeToC(storageType, self.analyzed);
    }

    public IRNode boxExactValue(
            IRNode expr, Node valueType, string prefix) {
        Node? resolved = resolveTypedefType(
            valueType, self.analyzed.typedefTable);
        if (resolved == null || (resolved.base == "void"
                && resolved.pointer_depth == 0)) {
            return irLiteral("NULL");
        }
        self.useHelper("__btrc_safe_realloc");
        string valueC = self.threadResultStorageC(resolved);
        string boxName = self.freshTemp(prefix + "_box");
        string valueName = self.freshTemp(prefix + "_value");
        IRNode box = irVar(boxName);
        IRNode value = irVar(valueName);
        Vector<IRNode> declarations = [];
        declarations.push(irVarDecl(valueC + "*", boxName, null));
        declarations.push(irVarDecl(valueC, valueName, null));
        Vector<IRNode> sequence = [];
        sequence.push(irBinOp(value, "=", expr));
        Vector<IRNode> allocationArgs = [];
        allocationArgs.push(irLiteral("NULL"));
        allocationArgs.push(irSizeofExpr(irDeref(box)));
        sequence.push(irBinOp(box, "=", irCast(valueC + "*",
            irCall("__btrc_safe_realloc", allocationArgs))));
        sequence.push(irBinOp(irDeref(box), "=", value));
        sequence.push(irCast("void*", box));
        return irStmtExpr(declarations, irCommaExpr(sequence));
    }

    public IRNode unboxExactValue(
            IRNode payloadCall, Node valueType, string prefix) {
        Node? resolved = resolveTypedefType(
            valueType, self.analyzed.typedefTable);
        if (resolved == null || (resolved.base == "void"
                && resolved.pointer_depth == 0)) {
            return payloadCall;
        }
        string valueC = self.threadResultStorageC(resolved);
        string payloadName = self.freshTemp(prefix + "_payload");
        string valueName = self.freshTemp(prefix + "_value");
        IRNode payload = irVar(payloadName);
        IRNode value = irVar(valueName);
        Vector<IRNode> declarations = [];
        declarations.push(irVarDecl("void*", payloadName, null));
        declarations.push(irVarDecl(valueC, valueName, null));
        Vector<IRNode> sequence = [];
        sequence.push(irBinOp(payload, "=", payloadCall));
        sequence.push(irBinOp(value, "=",
            irDeref(irCast(valueC + "*", payload))));
        Vector<IRNode> freeArgs = [];
        freeArgs.push(payload);
        sequence.push(irCall("free", freeArgs));
        sequence.push(value);
        return irStmtExpr(declarations, irCommaExpr(sequence));
    }

    public IRNode boxThreadResult(IRNode? expr, Node? retType) {
        Node? resolved = resolveTypedefType(
            retType, self.analyzed.typedefTable);
        if (expr == null || resolved == null || (resolved.base == "void"
                && resolved.pointer_depth == 0)) {
            return irLiteral("NULL");
        }
        if (!self.threadResultRequiresBox(resolved)) {
            return irCast("void*", expr);
        }
        return self.boxExactValue(expr, resolved, "__btrc_thread");
    }

    public IRNode unboxThreadResult(IRNode payloadCall, Node? retType) {
        Node? resolved = resolveTypedefType(
            retType, self.analyzed.typedefTable);
        if (resolved == null || (resolved.base == "void"
                && resolved.pointer_depth == 0)) {
            return payloadCall;
        }
        if (!self.threadResultRequiresBox(resolved)) {
            return irCast(typeToC(retType, self.analyzed), payloadCall);
        }
        return self.unboxExactValue(
            payloadCall, resolved, "__btrc_thread");
    }

    public IRNode consumeOpaqueHandle(IRNode obj, string handleC,
                                      string prefix) {
        bool addressable = obj.kind == IRK_VAR || obj.kind == IRK_FIELD_ACCESS
            || obj.kind == IRK_INDEX || obj.kind == IRK_DEREF;
        if (!addressable) { return obj; }
        string slotName = self.freshTemp(prefix + "_slot");
        string handleName = self.freshTemp(prefix + "_handle");
        IRNode slot = irVar(slotName);
        IRNode handle = irVar(handleName);
        Vector<IRNode> declarations = [];
        declarations.push(irVarDecl(
            handleC + "* volatile*", slotName, null));
        declarations.push(irVarDecl(handleC + "*", handleName, null));
        Vector<IRNode> sequence = [];
        sequence.push(irBinOp(slot, "=", irAddressOf(obj)));
        sequence.push(irBinOp(handle, "=", irDeref(slot)));
        sequence.push(irBinOp(irDeref(slot), "=", irLiteral("NULL")));
        sequence.push(handle);
        return irStmtExpr(declarations, irCommaExpr(sequence));
    }

    public IRNode consumeThreadHandle(IRNode obj) {
        return self.consumeOpaqueHandle(
            obj, "__btrc_thread_t", "__btrc_thread");
    }

    public void appendThreadResultDisposal(
            Vector<IRNode> args, Node? resultType) {
        Node? resolved = resolveTypedefType(
            resultType, self.analyzed.typedefTable);
        IRNode context = irLiteral("NULL");
        IRNode contextSize = irLiteral("0");
        IRNode callback = irLiteral("NULL");
        if (resolved != null && !(resolved.base == "void"
                && resolved.pointer_depth == 0)) {
            if (isStringType(resolved)) {
                self.useHelper("__btrc_thread_string_dispose");
                callback = irVar("__btrc_thread_string_dispose");
            } else if (irManagedType(self, resolved)) {
                context = managedArcDescriptor(
                    self, irManagedRuntimeType(self, resolved));
                contextSize = irSizeofType("__btrc_arc_type");
                self.useHelper("__btrc_thread_arc_dispose");
                callback = irVar("__btrc_thread_arc_dispose");
            } else if (self.threadResultRequiresBox(resolved)) {
                self.useHelper("__btrc_thread_box_dispose");
                callback = irVar("__btrc_thread_box_dispose");
            }
        }
        args.push(context);
        args.push(contextSize);
        args.push(callback);
    }

    /* Lower a spawn(lambda) expression to a lifted pthread wrapper function
     * (void*(*)(void*)) plus a __btrc_thread_spawn call. Returns the thread
     * handle (__btrc_thread_t*). Mirrors ir/gen/threads.lower_spawn. */
    public IRNode lowerSpawn(Node node, Map<string, Node> varTypes) {
        self.useHelper("__btrc_thread_spawn");
        Node fn = node.fn;
        /* Non-lambda spawn: treat the operand as a function pointer value. */
        if (fn == null || fn.kind != NK_LAMBDA_EXPR) {
            if (fn != null && fn.kind == NK_IDENTIFIER
                    && self.hasClosureEnv(fn.name)) {
                print(f"A capturing lambda alias cannot be spawned; pass the "
                    + f"lambda literal directly at {node.line}:{node.col}");
                abortGen();
            }
            IRNode fnExpr = self.lowerExpr(fn, varTypes);
            Vector<IRNode> sargs = [];
            sargs.push(irCast("void*(*)(void*)", fnExpr));
            sargs.push(irLiteral("NULL"));
            Node? fnType = self.resolvedExpressionType(fn, varTypes);
            Node? resultType = null;
            if (fnType != null) {
                fnType = resolveTypedefType(
                    fnType, self.analyzed.typedefTable);
                if (fnType != null && fnType.base == "__fn_ptr"
                        && fnType.generic_args.len > 0) {
                    resultType = fnType.generic_args.get(0);
                }
            }
            self.appendThreadResultDisposal(sargs, resultType);
            return irCall("__btrc_thread_spawn", sargs);
        }

        int spawnId = self.freshLambdaId();
        string wrapperName = "__btrc_spawn_wrapper_" + Strings.fromInt(spawnId);
        string envName = "__btrc_spawn_env_" + Strings.fromInt(spawnId);

        /* Resolve the lambda's return type (for boxing). */
        Node fpt = lambdaFnPtrType(fn, self.analyzed, varTypes);
        Node? retType = null;
        if (fn.return_type != null) { retType = fn.return_type; }
        else if (fpt.generic_args.len > 0) { retType = fpt.generic_args.get(0); }
        string retC = typeToC(retType, self.analyzed);

        Vector<string> capNames = self.lambdaCaptureNames(fn, varTypes);
        bool hasCaptures = capNames.len > 0;
        self.rejectNestedCallableCaptures(capNames, fn);

        /* Capture-env struct (one field per captured variable). */
        if (hasCaptures) {
            IRStructDef sd = IRStructDef();
            sd.name = envName;
            int ci = 0;
            while (ci < capNames.len) {
                string cn = capNames.get(ci);
                string cty = typeToC(
                    self.resolveBodyType(varTypes.get(cn)), self.analyzed);
                sd.fields.push(IRStructField(cty, cn));
                ci = ci + 1;
            }
            self.curModule.struct_defs.push(sd);
        }

        /* --- Build the wrapper: void* wrapper(void* __arg) --- */
        IRFunction wfn = IRFunction();
        wfn.name = wrapperName;
        wfn.is_static = true;
        wfn.return_type = "void*";
        wfn.params.push(IRParam("void*", "__arg"));

        Vector<IRNode> wbody = [];
        if (hasCaptures) {
            IRNode envCast = irCast("struct " + envName + "*", irVar("__arg"));
            wbody.push(irVarDecl("struct " + envName + "*", "__env", envCast));
            int ci2 = 0;
            while (ci2 < capNames.len) {
                string cn = capNames.get(ci2);
                string cty = typeToC(
                    self.resolveBodyType(varTypes.get(cn)), self.analyzed);
                IRNode fa = irFieldAccess(irVar("__env"), cn, true);
                wbody.push(irVarDecl(cty, cn, fa));
                ci2 = ci2 + 1;
            }
        }

        /* Capture cleanup (ARC release of class captures + free env). */
        Vector<IRNode> cleanup = self.spawnCaptureCleanup(fn, capNames, varTypes);

        /* Lower the lambda body in an isolated ARC/return context. */
        ScopeSnapshot snap = self.enterIsolatedScope(retC, retType);

        Map<string, Node> bodyVars = {};
        Vector<string> evk = varTypes.keys();
        int ek = 0;
        while (ek < evk.len) {
            string vn = evk.get(ek);
            bodyVars.put(vn, varTypes.get(vn));
            ek = ek + 1;
        }
        int p3 = 0;
        while (p3 < fn.params.len) {
            Node pp = fn.params.get(p3);
            if (pp.type != null) { bodyVars.put(pp.name, pp.type); }
            p3 = p3 + 1;
        }

        Node lb = fn.body_node;
        if (lb != null && lb.kind == NK_LAMBDA_BLOCK && lb.body_node != null) {
            IRNode blk = self.lowerBlock(lb.body_node, bodyVars);
            Vector<IRNode> lowered = self.rewriteThreadStatements(
                blk.stmts, retType, fn, capNames, varTypes);
            int li = 0;
            while (li < lowered.len) { wbody.push(lowered.get(li)); li = li + 1; }
        } else if (lb != null && lb.kind == NK_LAMBDA_EXPR_BODY && lb.expression != null) {
            Node returnNode = Node();
            returnNode.kind = NK_RETURN_STMT;
            returnNode.value_node = lb.expression;
            Vector<IRNode> returned = [];
            lowerOwnedReturn(self, returnNode, bodyVars, returned);
            Vector<IRNode> lowered = self.rewriteThreadStatements(
                returned, retType, fn, capNames, varTypes);
            int li = 0;
            while (li < lowered.len) {
                wbody.push(lowered.get(li));
                li = li + 1;
            }
        }

        self.exitIsolatedScope(snap);

        /* Ensure the wrapper always returns void* (cleanup first when present). */
        if (wbody.len == 0 || wbody.get(wbody.len - 1).kind != IRK_RETURN) {
            int cli = 0;
            while (cli < cleanup.len) { wbody.push(cleanup.get(cli)); cli = cli + 1; }
            wbody.push(irReturn(irLiteral("NULL")));
        }

        wfn.body = irBlock(wbody);
        self.curModule.functions.push(wfn);

        /* --- Build the spawn call --- */
        IRNode fnPtr = irCast("void*(*)(void*)", irVar(wrapperName));
        if (!hasCaptures) {
            Vector<IRNode> sargs = [];
            sargs.push(fnPtr);
            sargs.push(irLiteral("NULL"));
            self.appendThreadResultDisposal(sargs, retType);
            return irCall("__btrc_thread_spawn", sargs);
        }
        /* Capturing: hoist only the inert env declaration. Allocation, field
         * stores, retains, and spawn stay in a comma expression so an unchosen
         * ternary/short-circuit branch cannot perform them. */
        string seVar = "__se" + Strings.fromInt(spawnId);
        Vector<IRNode> declarations = [];
        declarations.push(irVarDecl("struct " + envName + "*", seVar, null));
        Vector<IRNode> sequence = [];
        self.useHelper("__btrc_safe_realloc");
        Vector<IRNode> allocationArgs = [];
        allocationArgs.push(irLiteral("NULL"));
        allocationArgs.push(irSizeofType("struct " + envName));
        IRNode allocation = irCall("__btrc_safe_realloc", allocationArgs);
        IRNode envInit = irCast("struct " + envName + "*", allocation);
        sequence.push(irBinOp(irVar(seVar), "=", envInit));
        int cpi = 0;
        while (cpi < capNames.len) {
            string cn = capNames.get(cpi);
            IRNode tgt = irFieldAccess(irVar(seVar), cn, true);
            sequence.push(irBinOp(tgt, "=", irVar(cn)));
            /* ARC: keep captured class instances alive until the thread finishes
             * (paired with the release in the wrapper cleanup). */
            Node? ct = varTypes.get(cn);
            if (irManagedType(self, ct)) {
                sequence.push(irManagedRetainValue(
                    self, irVar(cn), ct));
            }
            cpi = cpi + 1;
        }
        Vector<IRNode> sargs2 = [];
        sargs2.push(fnPtr);
        sargs2.push(irCast("void*", irVar(seVar)));
        self.appendThreadResultDisposal(sargs2, retType);
        IRNode spawnCall = irCall("__btrc_thread_spawn", sargs2);
        sequence.push(spawnCall);
        return irStmtExpr(declarations, irCommaExpr(sequence));
    }

    /* Build capture-cleanup statements for a spawn wrapper: ARC release each
     * class-typed capture, then free the env struct. Mirrors
     * threads._build_capture_cleanup. */
    public Vector<IRNode> spawnCaptureCleanup(Node fn, Vector<string> capNames,
                                              Map<string, Node> varTypes) {
        Vector<IRNode> out = [];
        if (capNames.len == 0) { return out; }
        int i = 0;
        while (i < capNames.len) {
            string cn = capNames.get(i);
            Node? ct = varTypes.get(cn);
            if (irManagedType(self, ct)) {
                /* The shared typed ARC adapter owns descriptor selection,
                 * decrement/zero handling, and cycle-candidate buffering. */
                string runtimeType = irManagedRuntimeType(self, ct);
                out.push(irExprStmt(irManagedReleaseRuntime(
                    self, irVar(cn), runtimeType)));
            }
            i = i + 1;
        }
        Vector<IRNode> fargs = [];
        fargs.push(irVar("__env"));
        out.push(irExprStmt(irCall("free", fargs)));
        return out;
    }

    /* Rewrite every return in a structured wrapper body. A return value is
     * evaluated and boxed before capture cleanup, then returned from a fresh
     * void* temp. Try/catch lowers to IRIf, so the same recursive walk covers it
     * together with ordinary if/loops/switches. Mirrors thread_returns.py. */
    public Vector<IRNode> rewriteThreadStatements(
            Vector<IRNode> statements, Node? retType, Node fn,
            Vector<string> capNames, Map<string, Node> varTypes) {
        Vector<IRNode> out = [];
        int i = 0;
        while (i < statements.len) {
            IRNode stmt = statements.get(i);
            if (stmt.kind == IRK_RETURN) {
                IRNode? value = null;
                if (stmt.value != null) { value = stmt.value; }
                IRNode boxed = self.boxThreadResult(value, retType);
                Vector<IRNode> cleanup = self.spawnCaptureCleanup(
                    fn, capNames, varTypes);
                if (cleanup.len == 0) {
                    out.push(irReturn(boxed));
                } else {
                    string resultName = self.freshTemp("__btrc_thread_result");
                    out.push(irVarDecl("void*", resultName, boxed));
                    int ci = 0;
                    while (ci < cleanup.len) {
                        out.push(cleanup.get(ci));
                        ci = ci + 1;
                    }
                    out.push(irReturn(irVar(resultName)));
                }
            } else {
                if (stmt.kind == IRK_IF) {
                    if (stmt.then_block != null) {
                        stmt.then_block.stmts = self.rewriteThreadStatements(
                            stmt.then_block.stmts, retType, fn, capNames, varTypes);
                    }
                    if (stmt.else_block != null) {
                        stmt.else_block.stmts = self.rewriteThreadStatements(
                            stmt.else_block.stmts, retType, fn, capNames, varTypes);
                    }
                } else if (stmt.kind == IRK_WHILE || stmt.kind == IRK_DO_WHILE
                        || stmt.kind == IRK_FOR) {
                    if (stmt.body != null) {
                        stmt.body.stmts = self.rewriteThreadStatements(
                            stmt.body.stmts, retType, fn, capNames, varTypes);
                    }
                } else if (stmt.kind == IRK_SWITCH) {
                    int caseIndex = 0;
                    while (caseIndex < stmt.args.len) {
                        IRNode caseNode = stmt.args.get(caseIndex);
                        caseNode.stmts = self.rewriteThreadStatements(
                            caseNode.stmts, retType, fn, capNames, varTypes);
                        caseIndex = caseIndex + 1;
                    }
                } else if (stmt.kind == IRK_BLOCK) {
                    stmt.stmts = self.rewriteThreadStatements(
                        stmt.stmts, retType, fn, capNames, varTypes);
                }
                out.push(stmt);
            }
            i = i + 1;
        }
        return out;
    }

    /* Lower Thread<T>.join() with the same typed transport contract used by
     * the wrapper return path. */
    public IRNode lowerThreadMethod(IRNode obj, string method, Node ot) {
        if (method == "join") {
            self.useHelper("__btrc_thread_join");
            Vector<IRNode> jargs = [];
            jargs.push(self.consumeThreadHandle(obj));
            IRNode joinCall = irCall("__btrc_thread_join", jargs);
            Node? ret = null;
            if (ot.generic_args.len > 0) { ret = ot.generic_args.get(0); }
            if (ret == null || ret.base == "void") { return joinCall; }
            return self.unboxThreadResult(joinCall, ret);
        }
        /* Unknown Thread method: fall back to __btrc_thread_<method>(obj). */
        Vector<IRNode> fargs = [];
        fargs.push(obj);
        return irCall("__btrc_thread_" + method, fargs);
    }

    /* Lower a Mutex<T> method call: .get() unboxes the stored void*; .set(v) boxes
     * the value; .destroy() tears down the mutex. Mirrors methods._lower_mutex_method. */
    public IRNode lowerMutexMethod(IRNode obj, string method, Node ot,
                                   Vector<IRNode> args) {
        Node? valType = null;
        if (ot.generic_args.len > 0) { valType = ot.generic_args.get(0); }
        if (method == "get") {
            self.useHelper("__btrc_mutex_val_get");
            Vector<IRNode> gargs = [];
            gargs.push(obj);
            IRNode getCall = irCall("__btrc_mutex_val_get", gargs);
            if (valType != null) {
                return self.unboxExactValue(
                    getCall, valType, "__btrc_mutex");
            }
            return getCall;
        }
        if (method == "set") {
            self.useHelper("__btrc_mutex_val_set");
            Vector<IRNode> sargs = [];
            sargs.push(obj);
            if (args.len > 0) {
                sargs.push(self.boxExactValue(
                    args.get(0), valType, "__btrc_mutex"));
            }
            return irCall("__btrc_mutex_val_set", sargs);
        }
        if (method == "destroy") {
            self.useHelper("__btrc_mutex_val_destroy");
            Vector<IRNode> dargs = [];
            dargs.push(self.consumeOpaqueHandle(
                obj, "__btrc_mutex_val_t", "__btrc_mutex"));
            return irCall("__btrc_mutex_val_destroy", dargs);
        }
        /* Unknown Mutex method: fall back to __btrc_mutex_val_<method>(obj, ...). */
        Vector<IRNode> fargs = [];
        fargs.push(obj);
        int i = 0;
        while (i < args.len) { fargs.push(args.get(i)); i = i + 1; }
        return irCall("__btrc_mutex_val_" + method, fargs);
    }

    /* Lower Mutex(val) -> __btrc_mutex_val_create(boxed_val). `args` are the
     * pre-lowered call arguments. Mirrors calls._lower_mutex_constructor. */
    public IRNode lowerMutexConstructor(Node node, Vector<IRNode> args,
                                        Map<string, Node> varTypes) {
        self.useHelper("__btrc_mutex_val_create");
        if (node.args.len == 0) {
            Vector<IRNode> nargs = [];
            nargs.push(irLiteral("NULL"));
            nargs.push(irLiteral("0"));
            nargs.push(irLiteral("NULL"));
            nargs.push(irLiteral("0"));
            nargs.push(irLiteral("NULL"));
            nargs.push(irLiteral("NULL"));
            return irCall("__btrc_mutex_val_create", nargs);
        }
        Node? argType = inferType(node.args.get(0), self.analyzed, varTypes);
        if (node.kind == NK_NEW_EXPR && node.type.generic_args.len > 0) {
            argType = node.type.generic_args.get(0);
        }
        Node concreteType = argType;
        IRNode boxed = self.boxExactValue(
            args.get(0), concreteType, "__btrc_mutex");
        string valueC = self.threadResultStorageC(concreteType);
        IRNode descriptor = irLiteral("NULL");
        IRNode descriptorSize = irLiteral("0");
        IRNode retain = irLiteral("NULL");
        IRNode releaseCallback = irLiteral("NULL");
        if (isStringType(concreteType)) {
            self.useHelper("__btrc_mutex_string_retain");
            self.useHelper("__btrc_mutex_string_release");
            retain = irVar("__btrc_mutex_string_retain");
            releaseCallback = irVar("__btrc_mutex_string_release");
        } else if (irManagedType(self, concreteType)) {
            descriptor = managedArcDescriptor(
                self, irManagedRuntimeType(self, concreteType));
            descriptorSize = irSizeofType("__btrc_arc_type");
            self.useHelper("__btrc_mutex_arc_retain");
            self.useHelper("__btrc_mutex_arc_release");
            retain = irVar("__btrc_mutex_arc_retain");
            releaseCallback = irVar("__btrc_mutex_arc_release");
        }
        Vector<IRNode> cargs = [];
        cargs.push(boxed);
        cargs.push(irSizeofType(valueC));
        cargs.push(descriptor);
        cargs.push(descriptorSize);
        cargs.push(retain);
        cargs.push(releaseCallback);
        return irCall("__btrc_mutex_val_create", cargs);
    }

    public IRNode lowerAssignedValue(Node valueNode, Node targetType,
            Map<string, Node> varTypes) {
        if (valueNode.kind == NK_LIST_LITERAL) {
            return self.lowerListLiteral(valueNode, varTypes, targetType);
        }
        if (valueNode.kind == NK_MAP_LITERAL) {
            return self.lowerMapLiteral(valueNode, varTypes, targetType);
        }
        if (valueNode.kind == NK_BRACE_INITIALIZER) {
            return self.lowerBraceInit(valueNode, varTypes, targetType);
        }
        return self.lowerExpr(valueNode, varTypes);
    }

    public IRNode lowerDirectCompound(string compoundOp,
            IRNode target, IRNode right, Node? targetType, Node? rightType) {
        if (targetType == null || rightType == null) {
            return irBinOp(target, compoundOp, right);
        }
        string pointerType = typeToC(targetType, self.analyzed);
        if (targetType.is_volatile) { pointerType = pointerType + " volatile"; }
        pointerType = pointerType + "*";
        string pointerName = self.freshTemp("__btrc_lvalue");
        string oldName = self.freshTemp("__btrc_update_old");
        IRNode pointer = irVar(pointerName);
        IRNode loaded = irDeref(pointer);
        IRNode oldValue = irVar(oldName);
        Vector<IRNode> declarations = [];
        declarations.push(irVarDecl(pointerType, pointerName, null));
        declarations.push(irVarDecl(
            typeToC(targetType, self.analyzed), oldName, null));
        Vector<IRNode> sequence = [];
        sequence.push(irBinOp(pointer, "=", irAddressOf(target)));
        sequence.push(irBinOp(oldValue, "=", loaded));
        string baseOp = compoundOp.substring(0, compoundOp.length() - 1);
        IRNode? computed = self.lowerOverloadedValues(
            baseOp, oldValue, right, targetType, rightType);
        if (computed == null) {
            computed = self.lowerTypedBinaryValues(
                baseOp, oldValue, right, targetType, rightType);
        }
        if (computed == null) {
            computed = irBinOp(oldValue, baseOp, right);
        }
        sequence.push(irBinOp(loaded, "=", computed));
        return irStmtExpr(declarations, irCommaExpr(sequence));
    }

    public IRNode lowerDirectStore(
            IRNode target, IRNode value, Node targetType) {
        string pointerType = typeToC(targetType, self.analyzed);
        if (targetType.is_volatile) {
            pointerType = pointerType + " volatile";
        }
        pointerType = pointerType + "*";
        string pointerName = self.freshTemp("__btrc_lvalue");
        IRNode pointer = irVar(pointerName);
        IRNode loaded = irDeref(pointer);
        Vector<IRNode> declarations = [];
        declarations.push(irVarDecl(
            pointerType, pointerName, null));
        Vector<IRNode> sequence = [];
        sequence.push(irBinOp(
            pointer, "=", irAddressOf(target)));
        sequence.push(irBinOp(loaded, "=", value));
        return irStmtExpr(declarations, irCommaExpr(sequence));
    }

    /* Property and generic-collection targets are not C lvalues. Build an
     * explicit single-evaluation load/store plan for simple and compound
     * assignments. Direct locals, fields, pointers, and raw indexes return
     * null and remain on the ordinary C-lvalue path. */
    public IRNode? lowerIndirectAssignment(
            Node node, Map<string, Node> varTypes) {
        IRNode? bounded = lowerIndexedAssignmentWithOwnership(
            self, node, varTypes);
        if (bounded != null) { return bounded; }
        return self.lowerIndirectAssignmentCore(node, varTypes);
    }

    public IRNode? lowerIndirectAssignmentCore(
            Node node, Map<string, Node> varTypes) {
        Node target = node.target;
        if (target == null) { return null; }

        if (target.kind == NK_FIELD_ACCESS_EXPR
                && target.obj != null && target.obj.kind != NK_SELF_EXPR) {
            Node? receiverType = self.resolvedExpressionType(
                target.obj, varTypes);
            Node? property = instanceMemberForType(
                self.analyzed, receiverType, target.field);
            if (receiverType != null && property != null
                    && property.kind == NK_PROPERTY_DECL) {
                if (target.optional) {
                    self.typedOperatorFail(
                        "optional-chain expressions are not assignable");
                }
                if (!property.has_setter) {
                    self.typedOperatorFail(
                        "property '" + target.field + "' has no setter");
                }
                if (node.op != "=" && !property.has_getter) {
                    self.typedOperatorFail(
                        "property '" + target.field + "' has no getter");
                }
                Node? valueType = self.resolvedExpressionType(target, varTypes);
                if (valueType == null) {
                    self.typedOperatorFail(
                        "cannot resolve property assignment target type");
                }
                if (node.op == "=") {
                    return lowerPropertyStoreWithOwnership(self,
                        node, receiverType, property,
                        valueType, varTypes);
                }
                string receiverName = self.freshTemp("__btrc_property_obj");
                string valueName = self.freshTemp("__btrc_update_value");
                IRNode receiver = irVar(receiverName);
                IRNode result = irVar(valueName);
                Vector<IRNode> declarations = [];
                declarations.push(irVarDecl(
                    typeToC(receiverType, self.analyzed), receiverName, null));
                declarations.push(irVarDecl(
                    typeToC(valueType, self.analyzed), valueName, null));
                Vector<IRNode> sequence = [];
                sequence.push(irBinOp(
                    receiver, "=", self.lowerExpr(target.obj, varTypes)));
                string prefix = instanceFunctionPrefix(
                    self.analyzed, receiverType);
                string setter = prefix + "_set_" + target.field;
                if (node.op == "=") {
                    IRNode value = self.lowerAssignedValue(
                        node.value_node, valueType, varTypes);
                    Node? sourceType = self.resolvedExpressionType(
                        node.value_node, varTypes);
                    value = self.upcastClassPointer(
                        valueType, sourceType, value);
                    sequence.push(irBinOp(result, "=", value));
                } else {
                    string oldName = self.freshTemp("__btrc_update_old");
                    IRNode oldValue = irVar(oldName);
                    declarations.push(irVarDecl(
                        typeToC(valueType, self.analyzed), oldName, null));
                    Vector<IRNode> getterArgs = [];
                    getterArgs.push(receiver);
                    sequence.push(irBinOp(
                        oldValue, "=",
                        irCall(prefix + "_get_" + target.field, getterArgs)));
                    IRNode right = self.lowerAssignedValue(
                        node.value_node, valueType, varTypes);
                    Node? rightType = self.resolvedExpressionType(
                        node.value_node, varTypes);
                    string baseOp = node.op.substring(
                        0, node.op.length() - 1);
                    IRNode? computed = self.lowerOverloadedValues(
                        baseOp, oldValue, right, valueType, rightType);
                    if (computed == null) {
                        computed = self.lowerTypedBinaryValues(
                            baseOp, oldValue, right, valueType, rightType);
                    }
                    if (computed == null) {
                        computed = irBinOp(oldValue, baseOp, right);
                    }
                    sequence.push(irBinOp(result, "=", computed));
                }
                Vector<IRNode> setterArgs = [];
                setterArgs.push(receiver);
                setterArgs.push(result);
                sequence.push(irCall(setter, setterArgs));
                sequence.push(result);
                return irStmtExpr(declarations, irCommaExpr(sequence));
            }
        }

        if (target.kind == NK_INDEX_EXPR) {
            Node? receiverType = self.resolvedExpressionType(
                target.obj, varTypes);
            if (receiverType != null
                    && !semanticRawIndexedPointer(
                        receiverType, self.analyzed)
                    && semanticValidIndexedSetter(semanticIndexedMethod(
                        receiverType, "set", self.analyzed))) {
                Node? valueType = self.resolvedExpressionType(target, varTypes);
                if (node.op == "=") {
                    Node? setter = semanticIndexedMethod(
                        receiverType, "set", self.analyzed);
                    if (semanticValidIndexedSetter(setter)) {
                        Node concreteSetter = setter;
                        valueType = semanticResolvedIndexedType(
                            concreteSetter.params.get(1).type,
                            receiverType, self.analyzed);
                    }
                }
                Node? indexType = self.resolvedExpressionType(
                    target.index, varTypes);
                if (valueType == null || indexType == null) {
                    self.typedOperatorFail(
                        "cannot resolve collection assignment target type");
                }
                if (node.op != "=" && semanticIndexedMethod(
                        receiverType, "get", self.analyzed) == null) {
                    self.typedOperatorFail(
                        "type '" + receiverType.base
                            + "' has no indexed getter");
                }
                string receiverName = self.freshTemp("__btrc_index_obj");
                string indexName = self.freshTemp("__btrc_index");
                string valueName = self.freshTemp("__btrc_update_value");
                IRNode receiver = irVar(receiverName);
                IRNode index = irVar(indexName);
                IRNode result = irVar(valueName);
                Vector<IRNode> declarations = [];
                declarations.push(irVarDecl(
                    typeToC(receiverType, self.analyzed), receiverName, null));
                declarations.push(irVarDecl(
                    typeToC(indexType, self.analyzed), indexName, null));
                declarations.push(irVarDecl(
                    typeToC(valueType, self.analyzed), valueName, null));
                Vector<IRNode> sequence = [];
                sequence.push(irBinOp(
                    receiver, "=", self.lowerExpr(target.obj, varTypes)));
                sequence.push(irBinOp(
                    index, "=", self.lowerExpr(target.index, varTypes)));
                string prefix = receiverType.base;
                if (self.analyzed.isGenericClass(receiverType.base)) {
                    prefix = mangleGenericType(
                        receiverType.base, receiverType.generic_args);
                }
                if (node.op == "=") {
                    IRNode value = self.lowerAssignedValue(
                        node.value_node, valueType, varTypes);
                    Node? sourceType = self.resolvedExpressionType(
                        node.value_node, varTypes);
                    value = self.upcastClassPointer(
                        valueType, sourceType, value);
                    sequence.push(irBinOp(result, "=", value));
                } else {
                    string oldName = self.freshTemp("__btrc_update_old");
                    IRNode oldValue = irVar(oldName);
                    declarations.push(irVarDecl(
                        typeToC(valueType, self.analyzed), oldName, null));
                    Vector<IRNode> getterArgs = [];
                    getterArgs.push(receiver);
                    getterArgs.push(index);
                    sequence.push(irBinOp(
                        oldValue, "=", irCall(prefix + "_get", getterArgs)));
                    IRNode right = self.lowerAssignedValue(
                        node.value_node, valueType, varTypes);
                    Node? rightType = self.resolvedExpressionType(
                        node.value_node, varTypes);
                    string baseOp = node.op.substring(
                        0, node.op.length() - 1);
                    IRNode? computed = self.lowerOverloadedValues(
                        baseOp, oldValue, right, valueType, rightType);
                    if (computed == null) {
                        computed = self.lowerTypedBinaryValues(
                            baseOp, oldValue, right, valueType, rightType);
                    }
                    if (computed == null) {
                        computed = irBinOp(oldValue, baseOp, right);
                    }
                    sequence.push(irBinOp(result, "=", computed));
                }
                Vector<IRNode> setterArgs = [];
                setterArgs.push(receiver);
                setterArgs.push(index);
                setterArgs.push(result);
                sequence.push(irCall(prefix + "_set", setterArgs));
                sequence.push(result);
                return irStmtExpr(declarations, irCommaExpr(sequence));
            }
        }
        return null;
    }

    public IRNode? lowerIndirectIncDec(
            Node node, Map<string, Node> varTypes) {
        Node target = node.operand;
        if (target == null) { return null; }
        string arithmeticOp = "+";
        if (node.op == "--") { arithmeticOp = "-"; }
        Node oneType = makePrimType("int");

        if (target.kind == NK_FIELD_ACCESS_EXPR
                && target.obj != null && target.obj.kind != NK_SELF_EXPR) {
            Node? receiverType = self.resolvedExpressionType(
                target.obj, varTypes);
            Node? property = instanceMemberForType(
                self.analyzed, receiverType, target.field);
            if (receiverType != null && property != null
                    && property.kind == NK_PROPERTY_DECL) {
                if (target.optional) {
                    self.typedOperatorFail(
                        "optional-chain expressions are not assignable");
                }
                if (!property.has_setter) {
                    self.typedOperatorFail(
                        "property '" + target.field + "' has no setter");
                }
                if (!property.has_getter) {
                    self.typedOperatorFail(
                        "property '" + target.field + "' has no getter");
                }
                Node? valueType = self.resolvedExpressionType(target, varTypes);
                if (valueType == null) {
                    self.typedOperatorFail(
                        "cannot resolve property update target type");
                }
                string receiverName = self.freshTemp("__btrc_property_obj");
                string oldName = self.freshTemp("__btrc_update_old");
                string newName = self.freshTemp("__btrc_update_new");
                IRNode receiver = irVar(receiverName);
                IRNode oldValue = irVar(oldName);
                IRNode newValue = irVar(newName);
                Vector<IRNode> declarations = [];
                declarations.push(irVarDecl(
                    typeToC(receiverType, self.analyzed), receiverName, null));
                declarations.push(irVarDecl(
                    typeToC(valueType, self.analyzed), oldName, null));
                declarations.push(irVarDecl(
                    typeToC(valueType, self.analyzed), newName, null));
                Vector<IRNode> sequence = [];
                sequence.push(irBinOp(
                    receiver, "=", self.lowerExpr(target.obj, varTypes)));
                Vector<IRNode> getterArgs = [];
                getterArgs.push(receiver);
                string prefix = instanceFunctionPrefix(
                    self.analyzed, receiverType);
                sequence.push(irBinOp(
                    oldValue, "=", irCall(
                        prefix + "_get_" + target.field,
                        getterArgs)));
                IRNode? computed = self.lowerTypedBinaryValues(
                    arithmeticOp, oldValue, irLiteral("1"),
                    valueType, oneType);
                if (computed == null) {
                    computed = irBinOp(
                        oldValue, arithmeticOp, irLiteral("1"));
                }
                sequence.push(irBinOp(newValue, "=", computed));
                Vector<IRNode> setterArgs = [];
                setterArgs.push(receiver);
                setterArgs.push(newValue);
                sequence.push(irCall(
                    prefix + "_set_" + target.field,
                    setterArgs));
                if (node.prefix) { sequence.push(newValue); }
                else { sequence.push(oldValue); }
                return irStmtExpr(declarations, irCommaExpr(sequence));
            }
        }

        if (target.kind == NK_INDEX_EXPR) {
            Node? receiverType = self.resolvedExpressionType(
                target.obj, varTypes);
            if (receiverType != null
                    && !semanticRawIndexedPointer(
                        receiverType, self.analyzed)
                    && semanticValidIndexedSetter(semanticIndexedMethod(
                        receiverType, "set", self.analyzed))) {
                Node? valueType = self.resolvedExpressionType(target, varTypes);
                Node? indexType = self.resolvedExpressionType(
                    target.index, varTypes);
                if (valueType == null || indexType == null) {
                    self.typedOperatorFail(
                        "cannot resolve collection update target type");
                }
                if (semanticIndexedMethod(
                        receiverType, "get", self.analyzed) == null) {
                    self.typedOperatorFail(
                        "indexed update requires get and set methods");
                }
                string receiverName = self.freshTemp("__btrc_index_obj");
                string indexName = self.freshTemp("__btrc_index");
                string oldName = self.freshTemp("__btrc_update_old");
                string newName = self.freshTemp("__btrc_update_new");
                IRNode receiver = irVar(receiverName);
                IRNode index = irVar(indexName);
                IRNode oldValue = irVar(oldName);
                IRNode newValue = irVar(newName);
                Vector<IRNode> declarations = [];
                declarations.push(irVarDecl(
                    typeToC(receiverType, self.analyzed), receiverName, null));
                declarations.push(irVarDecl(
                    typeToC(indexType, self.analyzed), indexName, null));
                declarations.push(irVarDecl(
                    typeToC(valueType, self.analyzed), oldName, null));
                declarations.push(irVarDecl(
                    typeToC(valueType, self.analyzed), newName, null));
                Vector<IRNode> sequence = [];
                sequence.push(irBinOp(
                    receiver, "=", self.lowerExpr(target.obj, varTypes)));
                sequence.push(irBinOp(
                    index, "=", self.lowerExpr(target.index, varTypes)));
                string prefix = receiverType.base;
                if (self.analyzed.isGenericClass(receiverType.base)) {
                    prefix = mangleGenericType(
                        receiverType.base, receiverType.generic_args);
                }
                Vector<IRNode> getterArgs = [];
                getterArgs.push(receiver);
                getterArgs.push(index);
                sequence.push(irBinOp(
                    oldValue, "=", irCall(prefix + "_get", getterArgs)));
                IRNode? computed = self.lowerTypedBinaryValues(
                    arithmeticOp, oldValue, irLiteral("1"),
                    valueType, oneType);
                if (computed == null) {
                    computed = irBinOp(
                        oldValue, arithmeticOp, irLiteral("1"));
                }
                sequence.push(irBinOp(newValue, "=", computed));
                Vector<IRNode> setterArgs = [];
                setterArgs.push(receiver);
                setterArgs.push(index);
                setterArgs.push(newValue);
                sequence.push(irCall(prefix + "_set", setterArgs));
                if (node.prefix) { sequence.push(newValue); }
                else { sequence.push(oldValue); }
                return irStmtExpr(declarations, irCommaExpr(sequence));
            }
        }
        return null;
    }

    public Node? resolvedExpressionType(
            Node? expression, Map<string, Node> varTypes) {
        if (self.gpuCpu.active) {
            return gpuContextualExprType(
                expression, self.analyzed, varTypes);
        }
        Node? result = inferType(expression, self.analyzed, varTypes);
        if (result != null && self.inGenericMethod) {
            result = resolveGenericType(result, self.activeTypeMap);
        }
        return result;
    }

    public void typedOperatorFail(string message) {
        fprintf(stderr, "error: %s\n", message);
        abortGen();
    }

    /* Nullable-safe lexicographic comparison. Both source operands are assigned
     * to temps in a comma expression, so each runs exactly once at the original
     * expression site; strcmp is reached only when both values are non-null. */
    public IRNode lowerStringComparisonValues(
            string op, IRNode left, IRNode right) {
        string leftName = self.freshTemp("__btrc_cmp_left");
        string rightName = self.freshTemp("__btrc_cmp_right");
        IRNode leftVar = irVar(leftName);
        IRNode rightVar = irVar(rightName);
        IRNode zero = irLiteral("0");
        IRNode nullValue = irLiteral("NULL");
        Vector<IRNode> strcmpArgs = [];
        strcmpArgs.push(leftVar);
        strcmpArgs.push(rightVar);
        IRNode compareValue = irTernary(
            irBinOp(leftVar, "==", rightVar),
            zero,
            irTernary(
                irBinOp(leftVar, "==", nullValue),
                irLiteral("-1"),
                irTernary(
                    irBinOp(rightVar, "==", nullValue),
                    irLiteral("1"),
                    irCall("strcmp", strcmpArgs))));
        Vector<IRNode> declarations = [];
        declarations.push(irVarDecl("const char*", leftName, null));
        declarations.push(irVarDecl("const char*", rightName, null));
        Vector<IRNode> sequence = [];
        sequence.push(irBinOp(leftVar, "=", left));
        sequence.push(irBinOp(rightVar, "=", right));
        sequence.push(irBinOp(compareValue, op, zero));
        return irStmtExpr(declarations, irCommaExpr(sequence));
    }

    public IRNode lowerNumericValues(string op, IRNode left, IRNode right,
            Node leftType, Node rightType) {
        IRNode loweredLeft = left;
        IRNode loweredRight = right;
        Node? resultType = numericResultType(
            leftType, rightType, self.analyzed);
        if (resultType == null) {
            self.typedOperatorFail(
                "cannot resolve numeric result type for operator '" + op + "'");
        }
        string resultC = typeToC(resultType, self.analyzed);
        if (op == "/" || op == "%") {
            string helper = "__btrc_div";
            if (op == "%") { helper = "__btrc_mod"; }
            self.useHelper(helper);
            Vector<IRNode> args = [];
            args.push(irCast(resultC, loweredLeft));
            args.push(irCast(resultC, loweredRight));
            return irCast(resultC, irCall(helper, args));
        }
        if (numericOperandsNeedCast(leftType, rightType, self.analyzed)) {
            loweredLeft = irCast(resultC, loweredLeft);
            loweredRight = irCast(resultC, loweredRight);
        }
        return irBinOp(loweredLeft, op, loweredRight);
    }

    public IRNode lowerNumericComparisonValues(
            string op, IRNode left, IRNode right,
            Node leftType, Node rightType) {
        Node? resultType = numericResultType(
            leftType, rightType, self.analyzed);
        if (resultType == null) {
            self.typedOperatorFail(
                "cannot resolve numeric result type for operator '" + op + "'");
        }
        if (leftType.base == rightType.base) {
            return irBinOp(left, op, right);
        }
        string resultC = typeToC(resultType, self.analyzed);
        return irBinOp(
            irCast(resultC, left), op,
            irCast(resultC, right));
    }

    public IRNode lowerReferenceEqualityValues(string op,
            IRNode left, IRNode right, Node leftType, Node rightType) {
        if (semanticIsNullType(leftType) || semanticIsNullType(rightType)) {
            Node? functionType = null;
            if (leftType.base == "__fn_ptr") { functionType = leftType; }
            if (rightType.base == "__fn_ptr") { functionType = rightType; }
            if (functionType != null) {
                IRNode typedNull = irCast(
                    typeToC(functionType, self.analyzed), irLiteral("0"));
                if (semanticIsNullType(leftType)) {
                    return irBinOp(typedNull, op, right);
                }
                return irBinOp(left, op, typedNull);
            }
            return irBinOp(left, op, right);
        }
        if (leftType.base == "__fn_ptr" && rightType.base == "__fn_ptr") {
            return irBinOp(left, op, right);
        }
        return irBinOp(
            irCast("const void*", left), op,
            irCast("const void*", right));
    }

    public IRNode? lowerOverloadedValues(string op, IRNode left, IRNode right,
            Node? leftType, Node? rightType) {
        if (leftType == null) { return null; }
        string magic = semanticBinaryOperatorMethod(op);
        if (magic == "") { return null; }
        if (self.analyzed.isClass(leftType.base)) {
            Node? method = self.analyzed.classMethod(leftType.base, magic);
            if (method == null || method.kind != NK_METHOD_DECL) { return null; }
            IRNode loweredRight = right;
            if (method.params.len > 0) {
                loweredRight = self.upcastClassPointer(
                    method.params.get(0).type, rightType, loweredRight);
            }
            Vector<IRNode> args = [];
            args.push(left);
            args.push(loweredRight);
            return irCall(leftType.base + "_" + magic, args);
        }
        if (leftType.generic_args.len > 0
                && self.analyzed.isGenericClass(leftType.base)) {
            Node? method = self.analyzed.genericClassMethod(
                leftType.base, magic);
            if (method == null) { return null; }
            Vector<IRNode> args = [];
            args.push(left);
            args.push(right);
            return irCall(
                mangleGenericType(leftType.base, leftType.generic_args)
                    + "_" + magic,
                args);
        }
        return null;
    }

    public IRNode? lowerTypedBinaryValues(string op,
            IRNode left, IRNode right, Node? leftType, Node? rightType) {
        if (op == "+"
                && (isSemanticScalarString(leftType)
                    || semanticIsCStringPointer(leftType))
                && (isSemanticScalarString(rightType)
                    || semanticIsCStringPointer(rightType))
                && (isSemanticScalarString(leftType)
                    || isSemanticScalarString(rightType))) {
            self.useHelper("__btrc_strcat");
            self.useHelper("__btrc_str_track");
            Vector<IRNode> catArgs = [];
            catArgs.push(left);
            catArgs.push(right);
            Vector<IRNode> trackArgs = [];
            trackArgs.push(irCall("__btrc_strcat", catArgs));
            return irCall("__btrc_str_track", trackArgs);
        }
        if (semanticIsComparisonOperator(op)) {
            int domain = semanticComparisonDomain(
                op, leftType, rightType, self.analyzed);
            if (domain == OP_DOMAIN_UNRESOLVED) {
                return irBinOp(left, op, right);
            }
            if (domain == OP_DOMAIN_INVALID) {
                string leftLabel = "unknown";
                string rightLabel = "unknown";
                if (leftType != null) { leftLabel = typeShapeKey(leftType); }
                if (rightType != null) { rightLabel = typeShapeKey(rightType); }
                /* Generic instances emit every method before function DCE. An
                 * invalid typed operator in an unreachable method must not
                 * reject the whole instance (for example Vector<UiNode>.min).
                 * Defer the structured diagnostic until after function DCE. */
                if (self.inGenericMethod) {
                    return irInvalidExpr(
                        "operator '" + op + "' is not defined for operands '"
                            + leftLabel + "' and '" + rightLabel + "'");
                }
                self.typedOperatorFail(
                    "operator '" + op + "' is not defined for operands '"
                        + leftLabel + "' and '" + rightLabel + "'");
            }
            if (domain == OP_DOMAIN_STRING) {
                return self.lowerStringComparisonValues(op, left, right);
            }
            if (domain == OP_DOMAIN_REFERENCE) {
                return self.lowerReferenceEqualityValues(
                    op, left, right, leftType, rightType);
            }
            return self.lowerNumericComparisonValues(
                op, left, right, leftType, rightType);
        }
        if ((op == "+" || op == "-" || op == "*" || op == "&"
                || op == "|" || op == "^")
                && numericIsType(leftType, self.analyzed)
                && numericIsType(rightType, self.analyzed)) {
            return self.lowerNumericValues(
                op, left, right, leftType, rightType);
        }
        if (op == "/" || op == "%") {
            if (!numericIsType(leftType, self.analyzed)
                    || !numericIsType(rightType, self.analyzed)) {
                self.typedOperatorFail(
                    "operator '" + op + "' requires numeric operands");
            }
            return self.lowerNumericValues(
                op, left, right, leftType, rightType);
        }
        return null;
    }

    public IRNode lowerTypedTernary(Node node, Map<string, Node> varTypes) {
        IRNode condition = self.lowerExpr(node.condition, varTypes);
        IRNode trueValue = self.lowerExpr(node.true_expr, varTypes);
        IRNode falseValue = self.lowerExpr(node.false_expr, varTypes);
        Node? trueType = self.resolvedExpressionType(node.true_expr, varTypes);
        Node? falseType = self.resolvedExpressionType(node.false_expr, varTypes);
        if (irExpressionOwnsResult(self, node, varTypes)) {
            if (node.true_expr.kind != NK_NULL_LITERAL
                    && irManagedType(self, trueType)
                    && !irExpressionOwnsResult(
                        self, node.true_expr, varTypes)) {
                trueValue = irPromoteBorrowedValue(
                    self, trueValue, trueType);
            }
            if (node.false_expr.kind != NK_NULL_LITERAL
                    && irManagedType(self, falseType)
                    && !irExpressionOwnsResult(
                        self, node.false_expr, varTypes)) {
                falseValue = irPromoteBorrowedValue(
                    self, falseValue, falseType);
            }
        }
        Node? resultType = numericResultType(
            trueType, falseType, self.analyzed);
        if (resultType != null && trueType != null && falseType != null
                && numericOperandsNeedCast(
                    trueType, falseType, self.analyzed)) {
            string resultC = typeToC(resultType, self.analyzed);
            trueValue = irCast(resultC, trueValue);
            falseValue = irCast(resultC, falseValue);
        }
        return irTernary(condition, trueValue, falseValue);
    }

    public IRNode lowerBinaryCore(Node node, Map<string, Node> varTypes) {
        IRNode left = self.lowerExpr(node.left, varTypes);
        IRNode right = self.lowerExpr(node.right, varTypes);
        string op = node.op;
        Node? leftType = self.resolvedExpressionType(node.left, varTypes);
        Node? rightType = self.resolvedExpressionType(node.right, varTypes);

        if (op == "??" && irExpressionOwnsResult(
                self, node, varTypes)) {
            if (node.left.kind != NK_NULL_LITERAL
                    && irManagedType(self, leftType)
                    && !irExpressionOwnsResult(
                        self, node.left, varTypes)) {
                left = irPromoteBorrowedValue(self, left, leftType);
            }
            if (node.right.kind != NK_NULL_LITERAL
                    && irManagedType(self, rightType)
                    && !irExpressionOwnsResult(
                        self, node.right, varTypes)) {
                right = irPromoteBorrowedValue(self, right, rightType);
            }
        }

        IRNode? overloaded = self.lowerOverloadedValues(
            op, left, right, leftType, rightType);
        if (overloaded != null) { return overloaded; }

        IRNode? typed = self.lowerTypedBinaryValues(
            op, left, right, leftType, rightType);
        if (typed != null) { return typed; }

        /* Null coalescing evaluates `a` once at the expression site. Only its
         * declaration may be hoisted out of an enclosing control expression. */
        if (op == "??") {
            if (semanticOptionalValueCoalesce(
                    node.left, leftType, rightType, self.analyzed)) {
                if (!irReplaceOptionalPresenceFallback(left, right)) {
                    self.typedOperatorFail(
                        "optional-chain coalescing requires a presence ternary");
                }
                return left;
            }
            string tmp = self.freshTemp("__nc");
            Node? resultType = leftType;
            if (semanticIsNullType(leftType)) { resultType = rightType; }
            string cType = "void*";
            if (resultType != null) {
                cType = typeToC(resultType, self.analyzed);
            }
            Vector<IRNode> declarations = [];
            declarations.push(irVarDecl(cType, tmp, null));
            Vector<IRNode> sequence = [];
            sequence.push(irBinOp(irVar(tmp), "=", left));
            sequence.push(irTernary(
                irBinOp(irVar(tmp), "!=", irLiteral("NULL")),
                irVar(tmp), right));
            return irStmtExpr(declarations, irCommaExpr(sequence));
        }
        return irBinOp(left, op, right);
    }

    public IRNode lowerUnary(Node node, Map<string, Node> varTypes) {
        if (node.op == "++" || node.op == "--") {
            IRNode? indirect = self.lowerIndirectIncDec(node, varTypes);
            if (indirect != null) { return indirect; }
        }
        IRNode operand = self.lowerExpr(node.operand, varTypes);
        string op = node.op;
        if (op == "&") { return irAddressOf(operand); }
        if (op == "*") { return irDeref(operand); }
        /* Operator overloading: -obj -> ClassName___neg__(obj) for a class with
         * a __neg__ method. */
        if (op == "-" && node.prefix) {
            Node? ot = inferType(node.operand, self.analyzed, varTypes);
            if (!self.inGenericMethod && ot != null && self.analyzed.isClass(ot.base)) {
                Node? mm = self.analyzed.classMethod(ot.base, "__neg__");
                if (mm != null && mm.kind == NK_METHOD_DECL) {
                    Vector<IRNode> nargs = [];
                    nargs.push(operand);
                    return irCall(ot.base + "___neg__", nargs);
                }
            }
            /* Monomorphized generic-instance __neg__: -box -> <mangled>___neg__(box).
             * Mirrors operators._lower_unary's generic_args branch. */
            if (!self.inGenericMethod && ot != null && ot.generic_args.len > 0
                    && self.analyzed.isGenericClass(ot.base)) {
                Node? gmm = self.analyzed.genericClassMethod(ot.base, "__neg__");
                if (gmm != null) {
                    string gmangled = mangleGenericType(ot.base, ot.generic_args);
                    Vector<IRNode> gnargs = [];
                    gnargs.push(operand);
                    return irCall(gmangled + "___neg__", gnargs);
                }
            }
        }
        return irUnaryOp(op, operand, node.prefix);
    }

    public IRNode lowerSizeof(Node node, Map<string, Node> varTypes) {
        Node operand = node.operand;
        if (operand != null && operand.kind == NK_SIZEOF_TYPE) {
            return irSizeofType(
                typeToC(self.resolveBodyType(operand.type), self.analyzed));
        }
        if (operand != null && operand.kind == NK_SIZEOF_EXPR_OP) {
            IRNode inner = self.lowerExpr(operand.expr, varTypes);
            return irSizeofExpr(inner);
        }
        return irSizeofType("void");
    }

    /* Lower [a, b, c] with a hoistable declaration and an expression-local
     * allocation/push sequence (mirrors collections.lower_list_literal). */
    public IRNode lowerListLiteral(Node node, Map<string, Node> varTypes, Node? expected) {
        string mangled = "btrc_Vector_int";
        Node? elementExpected = null;
        Node concreteExpected = self.resolveBodyType(expected);
        if (expected != null && concreteExpected.generic_args.len > 0) {
            mangled = mangleGenericType(
                concreteExpected.base, concreteExpected.generic_args);
            elementExpected = concreteExpected.generic_args.get(0);
        } else if (node.elements.len > 0) {
            Node? et = inferType(node.elements.get(0), self.analyzed, varTypes);
            if (et != null) {
                Node vt = makePrimType("Vector");
                Vector<Node> ga = [];
                ga.push(et);
                vt.generic_args = ga;
                /* Class element types must be upgraded to pointers so the inferred
                 * mangle matches the registered instance (`btrc_Vector_GraphNode_p1`,
                 * not `btrc_Vector_GraphNode`). */
                upgradeConcreteTypeGenericArgs(vt, self.analyzed);
                mangled = mangleGenericType("Vector", vt.generic_args);
                elementExpected = vt.generic_args.get(0);
            }
        }
        string tmp = self.freshTemp("__list");
        Vector<IRNode> declarations = [];
        Vector<IRNode> newArgs = [];
        declarations.push(irVarDecl(mangled + "*", tmp, null));
        Vector<IRNode> sequence = [];
        sequence.push(irBinOp(
            irVar(tmp), "=", irCall(mangled + "_new", newArgs)));
        int i = 0;
        while (i < node.elements.len) {
            Vector<IRNode> prefixArguments = [];
            prefixArguments.push(irVar(tmp));
            Vector<Node> operands = [];
            operands.push(node.elements.get(i));
            Vector<Node> expectedTypes = [];
            if (elementExpected != null) {
                expectedTypes.push(elementExpected);
            }
            sequence.push(lowerOwnedEffectCall(
                self, mangled + "_push", prefixArguments,
                operands, expectedTypes, varTypes));
            i = i + 1;
        }
        sequence.push(irVar(tmp));
        return irStmtExpr(declarations, irCommaExpr(sequence));
    }

    /* Lower a tuple literal `(a, b, ...)` to a C compound literal
     * `(btrc_Tuple_T0_T1){._0 = a, ._1 = b, ...}` (mirrors
     * expressions._lower_tuple). The struct name is mangled from the inferred
     * element types; an element whose type can't be inferred falls back to
     * `int`, matching the Python fallback path. */
    public IRNode lowerTupleLiteral(Node node, Map<string, Node> varTypes) {
        Vector<Node> elemTypes = [];
        int i = 0;
        while (i < node.elements.len) {
            Node? et = inferType(node.elements.get(i), self.analyzed, varTypes);
            if (et == null) {
                Node fallback = Node();
                fallback.kind = NK_TYPE_EXPR;
                fallback.base = "int";
                elemTypes.push(fallback);
            } else {
                elemTypes.push(copyTypeExprTree(et));
            }
            i = i + 1;
        }
        /* Class/generic element types must be upgraded to pointers so the
         * inferred mangle matches the synthesized tuple struct + declared var
         * type (`btrc_Tuple_string_Vector_int_p1`, not
         * `btrc_Tuple_string_Vector_int`). Mirrors the list-literal path above
         * and Python's _lower_tuple, which mangles the node's (already
         * pointer-upgraded) declared type. */
        Node tt = makePrimType("Tuple");
        tt.generic_args = elemTypes;
        upgradeConcreteTypeGenericArgs(tt, self.analyzed);
        string mangled = mangleGenericSymbol("Tuple", tt.generic_args);
        Vector<string> fields = [];
        Vector<IRNode> elems = [];
        int j = 0;
        while (j < node.elements.len) {
            fields.push("_" + Strings.fromInt(j));
            elems.push(self.lowerExpr(node.elements.get(j), varTypes));
            j = j + 1;
        }
        return irCompoundLiteral(mangled, fields, elems);
    }

    /* Lower {k: v, ...} -> Map_new() + put calls (mirrors lower_map_literal).
     * Empty map literal lowers to a bare Map_new() call. */
    public IRNode lowerMapLiteral(Node node, Map<string, Node> varTypes, Node? expected) {
        string mangled = "btrc_Map_string_int";
        Node? keyExpected = null;
        Node? valueExpected = null;
        Node concreteExpected = self.resolveBodyType(expected);
        if (expected != null && concreteExpected.generic_args.len > 1) {
            mangled = mangleGenericType(
                concreteExpected.base, concreteExpected.generic_args);
            keyExpected = concreteExpected.generic_args.get(0);
            valueExpected = concreteExpected.generic_args.get(1);
        } else if (node.entries.len > 0) {
            Node ent0 = node.entries.get(0);
            Node? kt = inferType(ent0.key, self.analyzed, varTypes);
            Node? vt = inferType(ent0.value_node, self.analyzed, varTypes);
            if (kt != null && vt != null) {
                Node mt = makePrimType("Map");
                Vector<Node> ga = [];
                ga.push(kt);
                ga.push(vt);
                mt.generic_args = ga;
                /* Class key/value types upgrade to pointers so the mangle matches
                 * the registered instance (e.g. `btrc_Map_int_OwnedItem_p1`). */
                upgradeConcreteTypeGenericArgs(mt, self.analyzed);
                mangled = mangleGenericType("Map", mt.generic_args);
                keyExpected = mt.generic_args.get(0);
                valueExpected = mt.generic_args.get(1);
            }
        }
        if (node.entries.len == 0) {
            Vector<IRNode> newArgs = [];
            return irCall(mangled + "_new", newArgs);
        }
        string tmp = self.freshTemp("__map");
        Vector<IRNode> declarations = [];
        Vector<IRNode> newArgs = [];
        declarations.push(irVarDecl(mangled + "*", tmp, null));
        Vector<IRNode> sequence = [];
        sequence.push(irBinOp(
            irVar(tmp), "=", irCall(mangled + "_new", newArgs)));
        int i = 0;
        while (i < node.entries.len) {
            Node ent = node.entries.get(i);
            Vector<IRNode> prefixArguments = [];
            prefixArguments.push(irVar(tmp));
            Vector<Node> operands = [];
            operands.push(ent.key);
            operands.push(ent.value_node);
            Vector<Node> expectedTypes = [];
            if (keyExpected != null && valueExpected != null) {
                expectedTypes.push(keyExpected);
                expectedTypes.push(valueExpected);
            }
            sequence.push(lowerOwnedEffectCall(
                self, mangled + "_put", prefixArguments,
                operands, expectedTypes, varTypes));
            i = i + 1;
        }
        sequence.push(irVar(tmp));
        return irStmtExpr(declarations, irCommaExpr(sequence));
    }

    /* Lower a brace initializer (mirrors expressions.lower_expr BraceInitializer):
     * empty {} with a known generic-collection expected type -> mangled_new();
     * empty {} otherwise -> NULL; non-empty -> {e1, e2, ...} raw expr. */
    public IRNode lowerBraceInit(Node node, Map<string, Node> varTypes, Node? expected) {
        if (expected != null && expected.pointer_depth == 0) {
            Node aggregateType = expected;
            Node? resolved = resolveTypedefType(
                expected, self.analyzed.typedefTable);
            if (resolved != null) { aggregateType = resolved; }
            string structName = semanticStructTypeName(
                aggregateType, self.analyzed);
            if (structName != ""
                    && self.analyzed.structTable.has(structName)
                    && !self.analyzed.structTable.get(structName).is_forward) {
                Node declaration = self.analyzed.structTable.get(structName);
                Vector<string> fields = [];
                Vector<IRNode> values = [];
                int fieldIndex = 0;
                while (fieldIndex < node.elements.len
                        && fieldIndex < declaration.fields.len) {
                    Node field = declaration.fields.get(fieldIndex);
                    fields.push(field.name);
                    values.push(self.lowerAssignedValue(
                        node.elements.get(fieldIndex), field.type, varTypes));
                    fieldIndex = fieldIndex + 1;
                }
                return irCompoundLiteral(
                    typeToC(expected, self.analyzed), fields, values);
            }
        }
        if (node.elements.len == 0) {
            if (expected != null && expected.generic_args.len > 0
                    && self.analyzed.isGenericClass(expected.base)) {
                string mangled = mangleGenericType(expected.base, expected.generic_args);
                Vector<IRNode> newArgs = [];
                return irCall(mangled + "_new", newArgs);
            }
            return irLiteral("NULL");
        }
        Vector<IRNode> elements = [];
        int i = 0;
        while (i < node.elements.len) {
            elements.push(self.lowerExpr(node.elements.get(i), varTypes));
            i = i + 1;
        }
        return irInitializerList(elements);
    }

    /* Coerce a single ordered arg into its parameter's string type when the
     * source AST node is a class with toString() (mirrors stringable.
     * coerce_to_string_param). `srcNode` is the source AST arg (a written arg or
     * a param default), used to infer the value's type. */
    public IRNode coerceArgToParam(Node param, Node? srcNode, IRNode value,
            Map<string, Node> varTypes) {
        if (srcNode == null) { return value; }
        Node? srcType = inferType(srcNode, self.analyzed, varTypes);
        return self.coerceToString(param.type, srcType, value);
    }

    /* Return IR args in parameter order, filling omitted defaults (mirrors
     * arguments.order_args_for_params). `params` are Param Nodes (with .name /
     * .default_); `irArgs` are the already-lowered call args in source order;
     * `argNames` are the written keyword names ("" for positional). Positional-
     * only calls keep order and append trailing defaults; named calls expand to
     * the full declared parameter list and may skip optional middle params.
     * Applies the reference's coerce_to_string_param step per slot: when a
     * parameter's type is `string` and the supplying arg (written or default)
     * is a class with a no-arg toString()->string, the arg is wrapped in
     * <Class>_toString(...) (mirrors arguments.order_args_for_params). */
    public Vector<IRNode> orderArgsForParams(Vector<Node> params,
            Vector<string> argNames, Vector<IRNode> irArgs,
            Vector<Node> astArgs, Map<string, Node> varTypes) {
        if (params.len == 0) { return irArgs; }
        /* Pad names to the number of written args. */
        Vector<string> names = [];
        int ni = 0;
        while (ni < irArgs.len) {
            if (ni < argNames.len) { names.push(argNames.get(ni)); }
            else { names.push(""); }
            ni = ni + 1;
        }
        /* Any named args present? */
        bool anyNamed = false;
        int an = 0;
        while (an < names.len) {
            if (names.get(an) != "") { anyNamed = true; }
            an = an + 1;
        }
        /* Positional-only fast path: keep order, append trailing defaults. */
        if (!anyNamed) {
            Vector<IRNode> result = [];
            int k = 0;
            while (k < irArgs.len) {
                IRNode av = irArgs.get(k);
                if (k < params.len && k < astArgs.len) {
                    Node sourceNode = astArgs.get(k);
                    if (sourceNode.kind == NK_BRACE_INITIALIZER
                            || sourceNode.kind == NK_LIST_LITERAL
                            || sourceNode.kind == NK_MAP_LITERAL) {
                        av = self.lowerAssignedValue(
                            sourceNode, params.get(k).type, varTypes);
                    }
                    Node? st = inferType(astArgs.get(k), self.analyzed, varTypes);
                    av = self.coerceArg(params.get(k).type, st, av);
                }
                result.push(av);
                k = k + 1;
            }
            int idx = result.len;
            while (idx < params.len) {
                Node pp = params.get(idx);
                if (pp.default_ != null) {
                    IRNode dv = self.lowerAssignedValue(
                        pp.default_, pp.type, varTypes);
                    Node? dt = inferType(pp.default_, self.analyzed, varTypes);
                    result.push(self.coerceArg(pp.type, dt, dv));
                } else {
                    result.push(irLiteral("0"));
                }
                idx = idx + 1;
            }
            return result;
        }
        /* Named path: resolve which written arg fills each parameter slot, then
         * build the result in declared order. We map param index -> written-arg
         * index (or -1 for "use the default"). A parallel int Vector is used
         * instead of an IRNode slot Vector because Vector<IRNode>.push rejects
         * null (it bumps the element's refcount), so null placeholders aren't
         * safe; ints are. */
        Map<string, int> paramIndices = {};
        int pi = 0;
        while (pi < params.len) {
            paramIndices.put(params.get(pi).name, pi);
            pi = pi + 1;
        }
        Vector<int> slotArg = [];
        int s = 0;
        while (s < params.len) { slotArg.push(-1); s = s + 1; }
        int positional = 0;
        int ai = 0;
        while (ai < irArgs.len) {
            string nm = names.get(ai);
            if (nm != "") {
                if (paramIndices.has(nm)) {
                    slotArg.set(paramIndices.get(nm), ai);
                }
            } else if (positional < params.len) {
                slotArg.set(positional, ai);
                positional = positional + 1;
            }
            ai = ai + 1;
        }
        Vector<IRNode> out = [];
        int o = 0;
        while (o < params.len) {
            Node pp = params.get(o);
            int src = slotArg.get(o);
            if (src >= 0) {
                IRNode av = irArgs.get(src);
                if (src < astArgs.len) {
                    Node sourceNode = astArgs.get(src);
                    if (sourceNode.kind == NK_BRACE_INITIALIZER
                            || sourceNode.kind == NK_LIST_LITERAL
                            || sourceNode.kind == NK_MAP_LITERAL) {
                        av = self.lowerAssignedValue(
                            sourceNode, pp.type, varTypes);
                    }
                    Node? st = inferType(astArgs.get(src), self.analyzed, varTypes);
                    av = self.coerceArg(pp.type, st, av);
                }
                out.push(av);
            } else {
                if (pp.default_ != null) {
                    IRNode dv = self.lowerAssignedValue(
                        pp.default_, pp.type, varTypes);
                    Node? dt = inferType(pp.default_, self.analyzed, varTypes);
                    out.push(self.coerceArg(pp.type, dt, dv));
                } else {
                    out.push(irLiteral("0"));
                }
            }
            o = o + 1;
        }
        return out;
    }

    public Node? intrinsicOperandType(Node expression, Map<string, Node> varTypes) {
        return self.resolvedExpressionType(expression, varTypes);
    }

    public IRNode? lowerGenericIntrinsic(
            string name, Node node, Vector<IRNode> args,
            Map<string, Node> varTypes) {
        bool comparison = name == "__btrc_eq" || name == "__btrc_lt"
            || name == "__btrc_gt";
        if (!comparison && name != "__btrc_hash") { return null; }

        int expected = 2;
        if (name == "__btrc_hash") { expected = 1; }
        if (args.len != expected) {
            print(f"{name} expects {expected} operand(s), got {args.len}");
            abortGen();
        }

        if (comparison) {
            string op = "==";
            if (name == "__btrc_lt") { op = "<"; }
            else if (name == "__btrc_gt") { op = ">"; }
            Node? leftType = self.intrinsicOperandType(
                node.args.get(0), varTypes);
            Node? rightType = self.intrinsicOperandType(
                node.args.get(1), varTypes);
            if (leftType == null || rightType == null) {
                self.typedOperatorFail(
                    "cannot resolve operand types for " + name
                    + " while lowering '" + self.currentClass + "' at "
                    + Strings.fromInt(node.line) + ":"
                    + Strings.fromInt(node.col));
            }
            return self.lowerTypedBinaryValues(
                op, args.get(0), args.get(1), leftType, rightType);
        }

        Node? operandType = self.intrinsicOperandType(
            node.args.get(0), varTypes);
        int domain = semanticHashDomain(operandType, self.analyzed);
        if (domain == HASH_DOMAIN_STRING) {
            self.useHelper("__btrc_hash_str");
            Vector<IRNode> hashArgs = [];
            hashArgs.push(args.get(0));
            return irCall("__btrc_hash_str", hashArgs);
        }
        if (domain == HASH_DOMAIN_FLOATING) {
            self.useHelper("__btrc_hash_real");
            Vector<IRNode> hashArgs = [];
            hashArgs.push(args.get(0));
            return irCall("__btrc_hash_real", hashArgs);
        }
        if (domain == HASH_DOMAIN_INTEGRAL) {
            return irCast("unsigned int", args.get(0));
        }
        if (domain == HASH_DOMAIN_REFERENCE) {
            return irCast(
                "unsigned int", irCast("uintptr_t", args.get(0)));
        }
        if (self.inGenericMethod) {
            return irInvalidExpr(
                "__btrc_hash does not support this operand type portably");
        }
        self.typedOperatorFail(
            "__btrc_hash does not support this operand type portably");
        return irLiteral("0");
    }

    public IRNode lowerCallCore(Node node, Map<string, Node> varTypes) {
        self.rejectCallClosureEscapes(node, varTypes);
        Node callee = node.callee;
        if (callee != null && callee.kind == NK_IDENTIFIER) {
            string name = callee.name;
            /* Pre-lower every argument (mirrors calls.py line 50:
             * `args = lower_arg_values(...)` runs unconditionally, before the
             * print/constructor/builtin dispatch). For print and constructor
             * calls this result is discarded and the args re-lowered, but the
             * temp counter advances either way — so doing it here keeps fresh
            * temp numbering byte-identical. */
            Vector<IRNode> args = self.lowerArgs(node, varTypes);
            if (name == "__btrc_safe_calloc"
                    || name == "__btrc_safe_realloc"
                    || name == "__btrc_str_track"
                    || name == "__btrc_string_adopt"
                    || name == "__btrc_string_alloc") {
                self.useHelper(name);
                return irCall(name, args);
            }
            IRNode? gpuCpuBuiltin = lowerGpuCpuBuiltin(
                self, name, node, args, varTypes);
            if (gpuCpuBuiltin != null) { return gpuCpuBuiltin; }
            if (self.gpu.kernels.has(name)) {
                return lowerGpuDispatchExpression(
                    self, name, node, args, varTypes);
            }
            IRNode? intrinsic = self.lowerGenericIntrinsic(
                name, node, args, varTypes);
            if (intrinsic != null) { return intrinsic; }
            /* Mutex(val) constructor -> __btrc_mutex_val_create(boxed_val).
             * Exact typed storage preserves every scalar, aggregate, data
             * pointer, and function-pointer representation. Checked before the
             * user-class constructor branch. */
            if (name == "Mutex" && !self.analyzed.funcNames.has(name)
                    && !self.analyzed.isClass(name)) {
                return self.lowerMutexConstructor(node, args, varTypes);
            }
            /* Self-referential generic constructor inside a monomorphized body:
             * Box(...) within Box<int>'s methods -> btrc_Box_int_new(args).
             * self.currentClass is the current instance's mangled name. Mirrors
             * user_emitter._call's `cls.generic_params -> {self.mangled}_new`. */
            if (self.inGenericMethod && self.analyzed.isGenericClass(name)) {
                Vector<IRNode> gcargs = self.lowerArgs(node, varTypes);
                Node gdecl = self.analyzed.genericClassTable.get(name);
                Node? gctor = self.genericConstructor(gdecl);
                if (gctor != null && gctor.params.len > 0) {
                    gcargs = self.orderArgsForParams(
                        gctor.params, node.arg_names, gcargs, node.args, varTypes);
                }
                return irCall(self.currentClass + "_new", gcargs);
            }
            /* Constructor call X(...) -> X_new(args) (mirrors variables: a
             * non-generic class name as callee is a constructor). Fill omitted
             * defaults / order named args from the constructor's params
             * (mirrors calls._lower_constructor_call). */
            if (self.analyzed.isClass(name)) {
                Vector<IRNode> cargs = self.lowerArgs(node, varTypes);
                Node? ctor = self.analyzed.classConstructor(name);
                if (ctor != null && ctor.params.len > 0) {
                    cargs = self.orderArgsForParams(
                        ctor.params, node.arg_names, cargs, node.args, varTypes);
                }
                return irCall(name + "_new", cargs);
            }
            /* Built-ins apply only when no user function shadows the name. */
            if (!self.analyzed.funcNames.has(name)) {
                if (name == "print") { return self.lowerPrint(node, varTypes); }
                if (name == "printf") {
                    return irCall("printf", args);
                }
                if (name == "sizeof") {
                    if (node.args.len > 0) {
                        return irSizeofExpr(args.get(0));
                    }
                    return irSizeofType("void");
                }
                /* len(s): strlen on a string arg, else x->len (collection). */
                if (name == "len" && node.args.len > 0) {
                    Node? at = inferType(node.args.get(0), self.analyzed, varTypes);
                    if (isStringType(at)) {
                        Vector<IRNode> la = [];
                        la.push(args.get(0));
                        return irCast("int", irCall("strlen", la));
                    }
                    return irFieldAccess(args.get(0), "len", true);
                }
            }
            /* Captured-lambda call: bypass the function pointer and call the
             * lifted impl directly, with &env as the trailing void* argument.
             * Mirrors calls.py's _fn_ptr_envs branch. */
            if (self.hasClosureEnv(name)) {
                string implFn = self.fnPtrEnvFn.get(name);
                string envVar = self.fnPtrEnvVar.get(name);
                args.push(irCast("void*", irAddressOf(irVar(envVar))));
                return irCall(implFn, args);
            }
            /* Fill omitted trailing parameters with their default values and
             * order any named args (mirrors calls._fill_defaults ->
             * order_args_for_params). */
            if (self.analyzed.funcTable.has(name)) {
                Node fnDecl = self.analyzed.funcTable.get(name);
                if (fnDecl.params.len > 0) {
                    args = self.orderArgsForParams(
                        fnDecl.params, node.arg_names, args, node.args, varTypes);
                }
            }
            return irCall(name, args);
        }
        if (callee != null && callee.kind == NK_FIELD_ACCESS_EXPR) {
            return self.lowerMethodCall(node, varTypes);
        }
        /* A lambda literal callee is an IIFE. Lift it first, then materialize a
         * stack capture environment at the expression site. Only its inert
         * declaration is hoisted; field stores and the call remain sequenced in
         * an IR comma expression, preserving branch/loop evaluation. */
        if (callee != null && callee.kind == NK_LAMBDA_EXPR) {
            IRNode lambdaExpr = self.lowerExpr(callee, varTypes);
            int lambdaId = self.lastLambdaId;
            Vector<string> captures = self.lambdaCaptureNames(callee, varTypes);
            Vector<IRNode> lambdaArgs = self.lowerArgs(node, varTypes);
            lambdaArgs = self.orderArgsForParams(
                callee.params, node.arg_names, lambdaArgs, node.args, varTypes);
            if (captures.len == 0) {
                return irCall(irExprText(lambdaExpr), lambdaArgs);
            }
            string lambdaName = "__btrc_lambda_" + Strings.fromInt(lambdaId);
            string envName = lambdaName + "_env";
            string envVar = lambdaName + "_call_env";
            Vector<IRNode> declarations = [];
            declarations.push(irVarDecl("struct " + envName, envVar, null));
            Vector<IRNode> sequence = [];
            int captureIndex = 0;
            while (captureIndex < captures.len) {
                string capture = captures.get(captureIndex);
                sequence.push(irBinOp(
                    irFieldAccess(irVar(envVar), capture, false),
                    "=", irVar(capture)));
                captureIndex = captureIndex + 1;
            }
            lambdaArgs.push(irCast("void*", irAddressOf(irVar(envVar))));
            sequence.push(irCall(lambdaName, lambdaArgs));
            return irStmtExpr(declarations, irCommaExpr(sequence));
        }
        /* Other complex callees retain the generic function-pointer path. */
        Vector<IRNode> gargs = self.lowerArgs(node, varTypes);
        IRNode calleeExpr = self.lowerExpr(callee, varTypes);
        return irCallExpr(calleeExpr, gargs);
    }

    public void rejectCallClosureEscapes(
            Node call, Map<string, Node> varTypes) {
        self.callParamVarTypes = varTypes;
        Vector<Node> params = self.paramsForCall(call);
        int positional = 0;
        int i = 0;
        while (i < call.args.len) {
            int paramIndex = positional;
            string argumentName = "";
            if (i < call.arg_names.len) { argumentName = call.arg_names.get(i); }
            if (argumentName != "") {
                paramIndex = -1;
                int p = 0;
                while (p < params.len) {
                    if (params.get(p).name == argumentName) { paramIndex = p; }
                    p = p + 1;
                }
            } else {
                positional = positional + 1;
            }
            if (paramIndex >= 0 && paramIndex < params.len
                    && self.callableValueEscapes(
                        params.get(paramIndex).type, call.args.get(i),
                        varTypes)) {
                self.rejectClosureEscape(call.args.get(i));
            }
            if (paramIndex >= 0 && paramIndex < params.len) {
                Node parameter = params.get(paramIndex);
                Node? expected = resolveTypedefType(
                    parameter.type, self.analyzed.typedefTable);
                Node? actual = inferType(
                    call.args.get(i), self.analyzed, varTypes);
                actual = resolveTypedefType(
                    actual, self.analyzed.typedefTable);
                if (expected != null && expected.base == "__fn_ptr"
                        && actual != null
                        && actual.base == "__fn_ptr"
                        && actual.generic_args.len > 0
                        && irManagedType(
                            self, actual.generic_args.get(0))
                        && self.callableExpressionAbi(
                            call.args.get(i), varTypes) != 0) {
                    print("Managed-return callback for parameter '"
                        + parameter.name + "' erases its source-owned "
                        + "return ABI; bare __fn_ptr parameters accept only "
                        + "borrowed C callbacks");
                    abortGen();
                }
            }
            i = i + 1;
        }
    }

    public IRNode lowerMethodCall(Node node, Map<string, Node> varTypes) {
        Node field = node.callee;
        if (field.optional) {
            return lowerOptionalCallWithOwnership(self, node, varTypes);
        }
        return self.lowerMethodCallCore(node, varTypes);
    }

    public IRNode optionalCallZero(Node? returnType) {
        if (returnType == null) { return irLiteral("0"); }
        if (returnType.base == "void" && returnType.pointer_depth == 0) {
            return irCast("void", irLiteral("0"));
        }
        if (returnType.is_nullable
                || semanticIsReferenceType(returnType, self.analyzed)) {
            return irLiteral("NULL");
        }
        if (numericIsType(returnType, self.analyzed)) {
            return irLiteral("0");
        }
        Vector<string> noFields = [];
        Vector<IRNode> noValues = [];
        return irCompoundLiteral(
            typeToC(returnType, self.analyzed), noFields, noValues);
    }

    public string optionalManagedRuntimeType(Node typeNode) {
        return irManagedRuntimeType(self, typeNode);
    }

    /* Expression-form ARC release used inside an optional call's true arm.
     * Keeping this as ternary/comma IR preserves standard C11 and prevents a
     * post-call release from escaping the receiver guard. */
    public IRNode optionalReleaseExpr(IRNode target, string runtimeType) {
        Vector<IRNode> sequence = [];
        sequence.push(irManagedReleaseRuntime(
            self, target, runtimeType));
        if (irManagedRuntimeCanCycle(self, runtimeType)) {
            sequence.push(managedArcPoll(self));
        }
        if (sequence.len == 1) { return sequence.get(0); }
        return irCommaExpr(sequence);
    }

    /* `receiver?.method(args)` evaluates the receiver exactly once and keeps
     * both the call and every argument in the true arm.  The temporary's
     * declaration may be hoisted, but its assignment remains at the source
     * expression site through the comma expression. */
    public IRNode lowerOptionalMethodCall(
            Node node, Map<string, Node> varTypes) {
        Node field = node.callee;
        Node receiverNode = field.obj;
        Node? receiverType = self.resolvedExpressionType(
            receiverNode, varTypes);
        if (receiverType == null) {
            self.typedOperatorFail(
                "cannot resolve optional-call receiver type");
        }
        string receiverName = self.freshTemp("__btrc_optional_call_obj");
        IRNode receiver = irVar(receiverName);
        Vector<IRNode> declarations = [];
        IRNode receiverDecl = irVarDecl(
            typeToC(receiverType, self.analyzed), receiverName, null);
        declarations.push(receiverDecl);
        self.funcVarDecls.push(receiverDecl);

        Vector<IRNode> sequence = [];
        sequence.push(irBinOp(receiver, "=",
            self.lowerExpr(receiverNode, varTypes)));
        Vector<IRNode> guardedSequence = [];
        Vector<IRNode> postCall = [];

        string receiverKey = astNodeKey(receiverNode);
        bool hadOverride = self.owningTempOverrides.has(receiverKey);
        IRNode previousOverride = irLiteral("0");
        if (hadOverride) {
            previousOverride = self.owningTempOverrides.get(receiverKey);
        }
        self.owningTempOverrides.put(receiverKey, receiver);

        /* Hoist only arguments that participate in ownership.  Their runtime
         * assignments remain in the guarded arm, so null receivers evaluate no
         * argument.  A non-owning `keep` argument gets a null-initialized
         * tracking temp; scope cleanup can then balance the retain only when the
         * guarded call actually ran. */
        self.callParamVarTypes = varTypes;
        Vector<int> keepIndices = self.keepParamIndices(node);
        Map<int, bool> keepSet = {};
        int keepIndex = 0;
        while (keepIndex < keepIndices.len) {
            keepSet.put(keepIndices.get(keepIndex), true);
            keepIndex = keepIndex + 1;
        }
        Vector<string> overrideKeys = [];
        Vector<int> overrideHadValues = [];
        Vector<IRNode> overridePreviousValues = [];
        int argumentIndex = 0;
        while (argumentIndex < node.args.len) {
            Node argument = node.args.get(argumentIndex);
            Node? argumentType = inferType(
                argument, self.analyzed, varTypes);
            if (argumentType != null) {
                Node resolvedArgumentType = self.resolveBodyType(argumentType);
                bool managed = self.analyzed.isClass(resolvedArgumentType.base)
                    || (resolvedArgumentType.generic_args.len > 0
                        && self.analyzed.isGenericClass(
                            resolvedArgumentType.base));
                bool keepArgument = keepSet.has(argumentIndex);
                bool owningArgument = self.isOwningTempArg(argument);
                if (managed && (keepArgument || owningArgument)) {
                    string argumentName = self.freshTemp(
                        "__btrc_optional_call_arg");
                    IRNode argumentTarget = irVar(argumentName);
                    IRNode argumentDecl = irVarDecl(
                        typeToC(resolvedArgumentType, self.analyzed),
                        argumentName, null);
                    declarations.push(argumentDecl);
                    self.funcVarDecls.push(argumentDecl);
                    if (keepArgument && !owningArgument) {
                        sequence.push(irBinOp(
                            argumentTarget, "=", irLiteral("NULL")));
                    }
                    guardedSequence.push(irBinOp(argumentTarget, "=",
                        self.lowerExpr(argument, varTypes)));

                    string argumentKey = astNodeKey(argument);
                    bool argumentHadOverride =
                        self.owningTempOverrides.has(argumentKey);
                    IRNode argumentPreviousOverride = irLiteral("0");
                    if (argumentHadOverride) {
                        argumentPreviousOverride =
                            self.owningTempOverrides.get(argumentKey);
                    }
                    overrideKeys.push(argumentKey);
                    if (argumentHadOverride) {
                        overrideHadValues.push(1);
                    } else {
                        overrideHadValues.push(0);
                    }
                    overridePreviousValues.push(argumentPreviousOverride);
                    self.owningTempOverrides.put(
                        argumentKey, argumentTarget);

                    if (keepArgument) {
                        guardedSequence.push(irManagedRetainValue(
                            self, argumentTarget, resolvedArgumentType));
                        if (!owningArgument) {
                            self.registerManagedVar(argumentName,
                                self.optionalManagedRuntimeType(
                                    resolvedArgumentType));
                        }
                    }
                    if (owningArgument) {
                        string runtimeType =
                            self.optionalManagedRuntimeType(
                                resolvedArgumentType);
                        postCall.push(self.optionalReleaseExpr(
                            argumentTarget, runtimeType));
                    }
                }
            }
            argumentIndex = argumentIndex + 1;
        }

        IRNode call = self.lowerMethodCallCore(node, varTypes);

        int restoreIndex = overrideKeys.len - 1;
        while (restoreIndex >= 0) {
            string overrideKey = overrideKeys.get(restoreIndex);
            if (overrideHadValues.get(restoreIndex) != 0) {
                self.owningTempOverrides.put(overrideKey,
                    overridePreviousValues.get(restoreIndex));
            } else {
                self.owningTempOverrides.remove(overrideKey);
            }
            restoreIndex = restoreIndex - 1;
        }
        if (hadOverride) {
            self.owningTempOverrides.put(receiverKey, previousOverride);
        } else {
            self.owningTempOverrides.remove(receiverKey);
        }

        Node? returnType = self.resolvedExpressionType(node, varTypes);
        bool isVoid = returnType != null
            && returnType.base == "void"
            && returnType.pointer_depth == 0;
        if (isVoid) {
            guardedSequence.push(call);
            int postIndex = 0;
            while (postIndex < postCall.len) {
                guardedSequence.push(postCall.get(postIndex));
                postIndex = postIndex + 1;
            }
            guardedSequence.push(irCast("void", irLiteral("0")));
        } else {
            string resultName = self.freshTemp(
                "__btrc_optional_call_result");
            string resultC = "int";
            if (returnType != null) {
                resultC = typeToC(returnType, self.analyzed);
            }
            IRNode result = irVar(resultName);
            IRNode resultDecl = irVarDecl(resultC, resultName, null);
            declarations.push(resultDecl);
            self.funcVarDecls.push(resultDecl);
            guardedSequence.push(irBinOp(result, "=", call));
            int postIndex = 0;
            while (postIndex < postCall.len) {
                guardedSequence.push(postCall.get(postIndex));
                postIndex = postIndex + 1;
            }
            guardedSequence.push(result);
        }
        IRNode guarded = irTernary(
            irBinOp(receiver, "!=", irLiteral("NULL")),
            irCommaExpr(guardedSequence),
            self.optionalCallZero(returnType));
        sequence.push(guarded);
        return irStmtExpr(declarations, irCommaExpr(sequence));
    }

    /* Lower obj.method(args) after optional-call guarding has been decided.
     * Static: ClassName.method(args) -> ClassName_method(args).
     * Instance: obj.method(args)    -> ClassType_method(obj, args). */
    public IRNode lowerMethodCallCore(Node node, Map<string, Node> varTypes) {
        Node fa = node.callee;
        string method = fa.field;
        Node objNode = fa.obj;
        Node? callableType = directFunctionPointerType(
            inferType(fa, self.analyzed, varTypes), self.analyzed);
        if (callableType != null) {
            bool wasOptional = fa.optional;
            fa.optional = false;
            IRNode callable = self.lowerExpr(fa, varTypes);
            fa.optional = wasOptional;
            return irCallExpr(callable, self.lowerArgs(node, varTypes));
        }
        /* Rich enum constructor: Color.RGB(255, 0, 0) -> Color_RGB(255, 0, 0).
         * Mirrors methods.lower_method_call's rich_enum_table branch (checked
         * before the class branch). */
        if (objNode != null && objNode.kind == NK_IDENTIFIER
                && self.analyzed.isRichEnum(objNode.name)) {
            return irCall(objNode.name + "_" + method, self.lowerArgs(node, varTypes));
        }
        /* Static method call on a class name. Order named args / fill defaults
         * from the method's params (mirrors methods.lower_method_call's static
         * branch). */
        if (objNode != null && objNode.kind == NK_IDENTIFIER
                && self.analyzed.isClass(objNode.name)) {
            Vector<IRNode> sargs = self.lowerArgs(node, varTypes);
            Node? sm = self.analyzed.classMethod(objNode.name, method);
            if (sm != null && sm.kind == NK_METHOD_DECL && sm.params.len > 0) {
                sargs = self.orderArgsForParams(
                    sm.params, node.arg_names, sargs, node.args, varTypes);
            }
            return irCall(objNode.name + "_" + method, sargs);
        }
        /* Instance method call: dispatch on the object's class. */
        Node? ot = inferType(objNode, self.analyzed, varTypes);
        /* Builtin string instance methods (mirrors methods.lower_method_call's
         * is_string_type branches). Receiver lowered + args lowered first so the
         * fresh-temp counter advances identically. */
        if (isStringType(ot)) {
            IRNode sobj = self.lowerExpr(objNode, varTypes);
            Vector<IRNode> sargs = self.lowerArgs(node, varTypes);
            IRNode? sres = self.lowerStringMethod(sobj, method, sargs);
            if (sres != null) { return sres; }
        }
        /* enum.toString() -> EnumName_toString(val) (mirrors methods.
         * _lower_to_string's enum_table branch). Checked before the generic
         * numeric/bool/char toString fallback. */
        if (method == "toString" && ot != null
                && (self.analyzed.isEnum(ot.base) || self.analyzed.isRichEnum(ot.base))) {
            IRNode eobj = self.lowerExpr(objNode, varTypes);
            Vector<IRNode> eargs = [];
            eargs.push(eobj);
            return irCall(ot.base + "_toString", eargs);
        }
        /* obj.toString() for non-class receivers -> builtin numeric/bool/char
         * conversion (mirrors methods.lower_method_call's toString branch). */
        if (method == "toString" && (ot == null || !self.analyzed.isClass(ot.base))) {
            IRNode tobj = self.lowerExpr(objNode, varTypes);
            return self.lowerToString(tobj, ot);
        }
        /* Thread<T> methods: .join() -> __btrc_thread_join with result unboxing
         * (mirrors methods._lower_thread_method). */
        if (ot != null && ot.base == "Thread" && ot.generic_args.len > 0) {
            IRNode obj = self.lowerExpr(objNode, varTypes);
            return self.lowerThreadMethod(obj, method, ot);
        }
        /* Mutex<T> methods: .get(), .set(v), .destroy() (mirrors
         * methods._lower_mutex_method). */
        if (ot != null && ot.base == "Mutex" && ot.generic_args.len > 0) {
            IRNode obj = self.lowerExpr(objNode, varTypes);
            Vector<IRNode> margs = self.lowerArgs(node, varTypes);
            return self.lowerMutexMethod(obj, method, ot, margs);
        }
        if (ot != null && self.analyzed.isClass(ot.base)) {
            IRNode obj = self.lowerExpr(objNode, varTypes);
            Vector<IRNode> margs = self.lowerArgs(node, varTypes);
            Node? im = self.analyzed.classMethod(ot.base, method);
            if (im != null && im.kind == NK_METHOD_DECL && im.params.len > 0) {
                margs = self.orderArgsForParams(
                    im.params, node.arg_names, margs, node.args, varTypes);
            }
            Vector<IRNode> args = [];
            args.push(obj);
            int i = 0;
            while (i < margs.len) {
                args.push(margs.get(i));
                i = i + 1;
            }
            /* Generic method on a non-generic class: dispatch to the
             * monomorphized instance for this call site's method type args. */
            if (im != null && im.kind == NK_METHOD_DECL && im.generic_params.len > 0) {
                string ck = astNodeKey(node);
                if (self.analyzed.methodGenCallArgs.has(ck)) {
                    Vector<Node> margTypes = self.analyzed.methodGenCallArgs.get(ck);
                    Vector<Node> noClassArgs = [];
                    string callee = genericMethodInstanceName(
                        ot.base, noClassArgs, method, margTypes);
                    return irCall(callee, args);
                }
            }
            return irCall(ot.base + "_" + method, args);
        }
        /* Instance method call on a generic instance: dispatch via mangled name
         * (mirrors methods.lower_method_call's generic branch). */
        if (ot != null && ot.generic_args.len > 0
                && self.analyzed.isGenericClass(ot.base)) {
            string mangled = mangleGenericType(ot.base, ot.generic_args);
            IRNode obj = self.lowerExpr(objNode, varTypes);
            Vector<IRNode> gmargs = self.lowerArgs(node, varTypes);
            Node? gm = self.analyzed.genericClassMethod(ot.base, method);
            if (gm != null && gm.params.len > 0) {
                gmargs = self.orderArgsForParams(
                    gm.params, node.arg_names, gmargs, node.args, varTypes);
                /* Upcast Derived->Base args for a generic-class method. The
                 * method's declared param types reference the class type params
                 * (e.g. push(T val)); resolve each through the receiver's generic
                 * args, then apply a Derived->Base upcast keyed on the resolved
                 * type (e.g. Vector<Animal>.push(Dog*) must cast Dog* to
                 * Animal*). Positional-aligned calls only. Mirrors
                 * methods._upcast_generic_method_args. */
                if (node.args.len == gmargs.len) {
                    Map<string, Node> gtm = genericTypeMap(self.analyzed, ot);
                    int ua = 0;
                    while (ua < node.args.len && ua < gm.params.len) {
                        Node gpt = gm.params.get(ua).type;
                        if (gpt != null && gtm.has(gpt.base)
                                && gpt.generic_args.len == 0) {
                            Node resolved = resolveGenericType(gpt, gtm);
                            Node? gst = inferType(node.args.get(ua), self.analyzed, varTypes);
                            gmargs.set(ua, self.upcastClassPointer(resolved, gst, gmargs.get(ua)));
                        }
                        ua = ua + 1;
                    }
                }
            }
            Vector<IRNode> args = [];
            args.push(obj);
            int i = 0;
            while (i < gmargs.len) {
                args.push(gmargs.get(i));
                i = i + 1;
            }
            /* Generic method on a generic instance: dispatch to the
             * monomorphized instance for the method type args inferred at this
             * call site (e.g. mapTo<string>). Mirrors methods.py's generic
             * method branch. */
            if (gm != null && gm.generic_params.len > 0) {
                string ck = astNodeKey(node);
                if (self.analyzed.methodGenCallArgs.has(ck)) {
                    Vector<Node> margTypes = self.analyzed.methodGenCallArgs.get(ck);
                    string callee = genericMethodInstanceName(
                        ot.base, ot.generic_args, method, margTypes);
                    return irCall(callee, args);
                }
            }
            return irCall(mangled + "_" + method, args);
        }
        print("irgen: unsupported method call");
        abortGen();
        return irLiteral("0");
    }

    /* Lower a builtin string instance method (mirrors methods.py:
     * _lower_string_method, _lower_string_special, the STRING_CONVERSIONS and
     * strlen branches). `obj` is the lowered receiver, `args` the lowered args.
     * Returns null if `method` is not a known string method. */
    public IRNode? lowerStringMethod(IRNode obj, string method, Vector<IRNode> args) {
        /* Special-cased: equals -> strcmp(...) == 0; len/length/byteLen -> strlen. */
        if (method == "equals") {
            Vector<IRNode> cargs = [];
            cargs.push(obj);
            int i = 0;
            while (i < args.len) { cargs.push(args.get(i)); i = i + 1; }
            IRNode cmp = irCall("strcmp", cargs);
            return irBinOp(cmp, "==", irLiteral("0"));
        }
        if (method == "len" || method == "length" || method == "byteLen") {
            Vector<IRNode> largs = [];
            largs.push(obj);
            return irCast("int", irCall("strlen", largs));
        }
        /* Deterministic conversions: integer overflow saturates instead of
         * inheriting atoi/atol's undefined behavior. */
        if (method == "toInt") {
            self.useHelper("__btrc_parseInt");
            Vector<IRNode> a = [];
            a.push(obj);
            return irCall("__btrc_parseInt", a);
        }
        if (method == "toFloat") {
            Vector<IRNode> a = [];
            a.push(obj);
            a.push(irLiteral("NULL"));
            return irCall("strtof", a);
        }
        if (method == "toDouble") {
            Vector<IRNode> a = [];
            a.push(obj);
            a.push(irLiteral("NULL"));
            return irCall("strtod", a);
        }
        if (method == "toLong") {
            self.useHelper("__btrc_parseLong");
            Vector<IRNode> a = [];
            a.push(obj);
            return irCall("__btrc_parseLong", a);
        }
        if (method == "toBool") {
            self.useHelper("__btrc_parseBool");
            Vector<IRNode> a = [];
            a.push(obj);
            return irCall("__btrc_parseBool", a);
        }
        /* Helper-backed methods: helper(obj, args...), wrapped in __btrc_str_track
         * when the result is a new heap string. */
        string helper = stringMethodHelper(method);
        if (helper == "") { return null; }
        self.useHelper(helper);
        Vector<IRNode> hargs = [];
        hargs.push(obj);
        int j = 0;
        while (j < args.len) { hargs.push(args.get(j)); j = j + 1; }
        IRNode call = irCall(helper, hargs);
        if (stringMethodTracked(method)) {
            self.useHelper("__btrc_str_track");
            Vector<IRNode> targs = [];
            targs.push(call);
            return irCall("__btrc_str_track", targs);
        }
        return call;
    }

    /* Lower obj.toString() for non-class receivers (mirrors methods._lower_to_string).
     * int/long/float/double/char -> __btrc_xToString tracked; bool -> ternary;
     * null type -> __btrc_intToString. */
    public IRNode lowerToString(IRNode obj, Node? ot) {
        if (ot == null) {
            self.useHelper("__btrc_intToString");
            Vector<IRNode> a = [];
            a.push(obj);
            return irCall("__btrc_intToString", a);
        }
        string base = ot.base;
        if (base == "bool") {
            return irTernary(obj, irLiteral("\"true\""), irLiteral("\"false\""));
        }
        string helper = "__btrc_intToString";
        if (base == "long" || base == "long int" || base == "signed long"
                || base == "signed long int") { helper = "__btrc_longToString"; }
        else if (base == "long long" || base == "long long int"
                || base == "signed long long" || base == "signed long long int") {
            helper = "__btrc_longLongToString";
        }
        else if (base == "uint" || base == "byte" || base == "unsigned int"
                || base == "unsigned short" || base == "unsigned short int"
                || base == "unsigned char") { helper = "__btrc_uintToString"; }
        else if (base == "unsigned long" || base == "unsigned long int") {
            helper = "__btrc_ulongToString";
        }
        else if (base == "unsigned long long" || base == "unsigned long long int"
                || base == "size_t") { helper = "__btrc_ulongLongToString"; }
        else if (base == "float") { helper = "__btrc_floatToString"; }
        else if (base == "double") { helper = "__btrc_doubleToString"; }
        else if (base == "long double") { helper = "__btrc_longDoubleToString"; }
        else if (base == "char") { helper = "__btrc_charToString"; }
        self.useHelper(helper);
        self.useHelper("__btrc_str_track");
        Vector<IRNode> a = [];
        a.push(obj);
        IRNode call = irCall(helper, a);
        Vector<IRNode> t = [];
        t.push(call);
        return irCall("__btrc_str_track", t);
    }

    /* new X(args) -> X_new(args) (mirrors methods.lower_new_expr, class subset).
     * Generic instance: new C<...>(args) -> btrc_C_T_new(args). */
    public IRNode lowerNewCore(Node node, Map<string, Node> varTypes) {
        /* Inside a monomorphized generic body, `new ListNode<T>(...)` carries the
         * raw type param T; resolve it through the active type map so the
         * constructor is the concrete `btrc_ListNode_OwnedItem_p1_new`, not the
         * unresolved `btrc_ListNode_T_new`. Mirrors user_emitter resolving the
         * new-expr type via _resolve before mangling. */
        Node newType = node.type;
        if (self.inGenericMethod) { newType = resolveGenericType(newType, self.activeTypeMap); }
        string baseName = node.type.base;
        string typeName = newType.base;
        if (newType.generic_args.len > 0 && self.analyzed.isGenericClass(typeName)) {
            typeName = mangleGenericType(typeName, newType.generic_args);
        }
        Vector<IRNode> args = self.lowerArgs(node, varTypes);
        if (newType.base == "Mutex") {
            return self.lowerMutexConstructor(node, args, varTypes);
        }
        /* Order named args / fill constructor defaults (mirrors the constructor
         * path; new X(...) shares the same _new signature as X(...)). */
        Node? ctor = self.analyzed.classConstructor(baseName);
        if (ctor == null) {
            ctor = self.analyzed.genericClassConstructor(baseName);
        }
        if (ctor != null && ctor.params.len > 0) {
            args = self.orderArgsForParams(
                ctor.params, node.arg_names, args, node.args, varTypes);
        }
        /* new C<...>(args): upcast Derived->Base ctor args against the resolved
         * generic param types (the ctor's `E error` param can't trigger the
         * upcast otherwise — see upcastGenericCtorArgs). */
        if (ctor != null && newType.generic_args.len > 0
                && self.analyzed.isGenericClass(newType.base)) {
            self.upcastGenericCtorArgs(newType, ctor, node.args, args, varTypes);
        }
        return irCall(typeName + "_new", args);
    }

    /* Lower field access obj.field (mirrors fields._lower_field_access, class
     * subset). Class-instance and pointer objects use `->`; property access
     * routes through the getter (or backing field for self.prop). */
    public IRNode lowerFieldAccessCore(Node node, Map<string, Node> varTypes) {
        /* Namespaced enum value: Color.RED -> Color_RED (the qualified form of
         * bare RED). Mirrors fields._lower_field_access's enum_table branch. */
        if (node.obj != null && node.obj.kind == NK_IDENTIFIER
                && self.analyzed.isEnum(node.obj.name)) {
            return irLiteral(node.obj.name + "_" + node.field);
        }
        /* Rich enum variant tag: Color.RGB -> Color_RGB_TAG. Mirrors fields.
         * _lower_field_access's rich_enum_table branch. */
        if (node.obj != null && node.obj.kind == NK_IDENTIFIER
                && self.analyzed.isRichEnum(node.obj.name)) {
            return irVar(node.obj.name + "_" + node.field + "_TAG");
        }
        if (irClassStaticField(self, node) != null) {
            return irVar(irClassStaticFieldName(node));
        }
        /* A static method used as a value is its lowered free-function symbol,
         * not a C member projection. A lexical binding with the same spelling
         * still wins over the class namespace. */
        if (node.obj != null && node.obj.kind == NK_IDENTIFIER
                && !varTypes.has(node.obj.name)
                && self.analyzed.isClass(node.obj.name)) {
            Node? staticMethod = self.analyzed.classMethod(
                node.obj.name, node.field);
            if (staticMethod != null
                    && staticMethod.kind == NK_METHOD_DECL
                    && staticMethod.access == "class") {
                return irVar(node.obj.name + "_" + node.field);
            }
        }
        IRNode obj = self.lowerExpr(node.obj, varTypes);
        Node? ot = self.resolvedExpressionType(node.obj, varTypes);
        /* Optional access is represented as a standard-C comma expression with
         * an uninitialized declaration hoisted by IRStmtExpr:
         *
         *   T *tmp; (tmp = receiver, tmp != NULL ? tmp->field : 0)
         *
         * Keeping both the guard and access on the temp is essential: a call,
         * update, or other side-effecting receiver must execute exactly once.
         * Property getters use the same guarded receiver path. */
        if (node.optional) {
            string receiverName = self.freshTemp("__btrc_optional_obj");
            string receiverType = "void*";
            if (ot != null) {
                receiverType = typeToC(ot, self.analyzed);
            }
            IRNode receiver = irVar(receiverName);
            IRNode access = irFieldAccess(receiver, node.field, true);
            Node? property = instanceMemberForType(
                self.analyzed, ot, node.field);
            if (ot != null && property != null
                    && property.kind == NK_PROPERTY_DECL) {
                Vector<IRNode> getterArgs = [];
                getterArgs.push(receiver);
                string prefix = instanceFunctionPrefix(
                    self.analyzed, ot);
                access = irCall(
                    prefix + "_get_" + node.field, getterArgs);
            } else {
                access = irFieldAccess(receiver, node.field, true);
            }
            Vector<IRNode> declarations = [];
            declarations.push(irVarDecl(receiverType, receiverName, null));
            Vector<IRNode> sequence = [];
            sequence.push(irBinOp(receiver, "=", obj));
            sequence.push(irTernary(
                irBinOp(receiver, "!=", irLiteral("NULL")),
                access, irLiteral("0")));
            return irStmtExpr(declarations, irCommaExpr(sequence));
        }
        /* Property access on a class instance. */
        Node? property = instanceMemberForType(
            self.analyzed, ot, node.field);
        if (ot != null && property != null
                && property.kind == NK_PROPERTY_DECL) {
            if (node.obj.kind == NK_SELF_EXPR
                    && propertyNeedsBacking(property)) {
                return irFieldAccess(
                    obj, instanceStorageName(property), true);
            }
            Vector<IRNode> gargs = [];
            gargs.push(obj);
            string prefix = instanceFunctionPrefix(
                self.analyzed, ot);
            return irCall(prefix + "_get_" + node.field, gargs);
        }
        bool arrow = node.arrow;
        /* Class and generic-class (collection) instances are heap pointers, so a
         * member access on one (e.g. `vec.len` where vec is Vector<int>) is `->`. */
        if (ot != null && (ot.pointer_depth > 0 || self.analyzed.isClass(ot.base)
                || self.analyzed.isGenericClass(ot.base))) {
            arrow = true;
        }
        return irFieldAccess(obj, node.field, arrow);
    }

    public IRNode lowerIndexCore(Node node, Map<string, Node> varTypes) {
        IRNode object = self.lowerExpr(node.obj, varTypes);
        IRNode index = self.lowerExpr(node.index, varTypes);
        Node? objectType = self.resolvedExpressionType(
            node.obj, varTypes);
        if (objectType != null
                && !semanticRawIndexedPointer(
                    objectType, self.analyzed)
                && semanticValidIndexedGetter(semanticIndexedMethod(
                    objectType, "get", self.analyzed))) {
            string prefix = objectType.base;
            if (self.analyzed.isGenericClass(objectType.base)) {
                prefix = mangleGenericType(
                    objectType.base, objectType.generic_args);
            }
            Vector<IRNode> arguments = [];
            arguments.push(object);
            arguments.push(index);
            return irCall(prefix + "_get", arguments);
        }
        return irIndex(object, index);
    }

    public Vector<IRNode> lowerArgs(Node node, Map<string, Node> varTypes) {
        Vector<IRNode> args = [];
        int i = 0;
        while (i < node.args.len) {
            args.push(self.lowerExpr(node.args.get(i), varTypes));
            i = i + 1;
        }
        return args;
    }

    /* Lower an f-string to snprintf-based string building (mirrors
     * fstrings.lower_fstring). Each interpolation is evaluated exactly once into
     * a temp reused by both the measure (snprintf NULL/0) and write passes. */
    public IRNode lowerFString(Node node, Map<string, Node> varTypes) {
        string tmp = self.freshTemp("__fstr");
        string fmt = "";
        Vector<IRNode> argDecls = [];
        Vector<IRNode> argAssignments = [];
        Vector<IRNode> args = [];
        int i = 0;
        while (i < node.parts.len) {
            Node part = node.parts.get(i);
            if (part.kind == NK_F_STRING_TEXT) {
                fmt = fmt + replacePercent(part.text);
            } else if (part.kind == NK_F_STRING_EXPR) {
                string spec = self.lowerFStringInterp(
                    part, tmp, args.len, argDecls, argAssignments, args, varTypes);
                fmt = fmt + spec;
            }
            i = i + 1;
        }
        /* No interpolations: a plain string literal. */
        if (args.len == 0) {
            return irLiteral("\"" + fmt + "\"");
        }
        self.useHelper("__btrc_str_track");
        self.useHelper("__btrc_string_alloc");
        string lenVar = tmp + "_len";
        string bufVar = tmp + "_buf";
        IRNode fmtLit = irLiteral("\"" + fmt + "\"");
        /* int __len = snprintf(NULL, 0, "fmt", args...); */
        Vector<IRNode> measureArgs = [];
        measureArgs.push(irLiteral("NULL"));
        measureArgs.push(irLiteral("0"));
        measureArgs.push(fmtLit);
        int a = 0;
        while (a < args.len) { measureArgs.push(args.get(a)); a = a + 1; }
        /* char* __buf = __btrc_str_track(__btrc_string_alloc(__len)); */
        IRNode lenPlus1 = irBinOp(
            irCast("size_t", irVar(lenVar)), "+", irLiteral("1"));
        Vector<IRNode> allocArgs = [];
        allocArgs.push(irVar(lenVar));
        IRNode allocated = irCall("__btrc_string_alloc", allocArgs);
        Vector<IRNode> trackArgs = [];
        trackArgs.push(allocated);
        IRNode trackCall = irCall("__btrc_str_track", trackArgs);
        /* snprintf(__buf, __len + 1, "fmt", args...); */
        Vector<IRNode> writeArgs = [];
        writeArgs.push(irVar(bufVar));
        writeArgs.push(lenPlus1);
        writeArgs.push(fmtLit);
        int w = 0;
        while (w < args.len) { writeArgs.push(args.get(w)); w = w + 1; }

        /* Only declarations are hoisted. All evaluations stay in a comma
         * expression so short-circuit/ternary branches and loop conditions keep
         * their source semantics under strict C11. */
        Vector<IRNode> declarations = [];
        int d = 0;
        while (d < argDecls.len) {
            declarations.push(argDecls.get(d));
            d = d + 1;
        }
        declarations.push(irVarDecl("int", lenVar, null));
        declarations.push(irVarDecl("char*", bufVar, null));

        Vector<IRNode> sequence = [];
        int si = 0;
        while (si < argAssignments.len) {
            sequence.push(argAssignments.get(si));
            si = si + 1;
        }
        sequence.push(irBinOp(irVar(lenVar), "=", irCall("snprintf", measureArgs)));
        sequence.push(irBinOp(irVar(bufVar), "=", trackCall));
        sequence.push(irCall("snprintf", writeArgs));
        sequence.push(irVar(bufVar));
        return irStmtExpr(declarations, irCommaExpr(sequence));
    }

    /* Lower one f-string interpolation. Appends an arg-decl (evaluated once) and
     * an arg ref (used by both snprintf passes), returns the format spec.
     * Mirrors fstrings._lower_interpolation. */
    public string lowerFStringInterp(Node part, string tmp, int index,
            Vector<IRNode> argDecls, Vector<IRNode> argAssignments,
            Vector<IRNode> args, Map<string, Node> varTypes) {
        Node ex = part.expression;
        IRNode irValue = self.lowerExpr(ex, varTypes);
        Node? argType = inferType(ex, self.analyzed, varTypes);
        string fmt = formatSpec(argType);
        string cType = "int";
        if (argType != null) { cType = typeToC(argType, self.analyzed); }

        /* Implicit class->string coercion: interpolating a class value with a
         * no-arg toString() formats as `%s` over `<Class>_toString(value)`
         * (mirrors fstrings._lower_interpolation's has_to_string branch). */
        IRNode coercedInterp = self.coerceToString(makePrimType("string"), argType, irValue);
        if (coercedInterp != irValue) {
            irValue = coercedInterp;
            fmt = "%s";
            cType = "char*";
        }

        /* Untracked type: force %s for string-producing expressions (mirrors
         * fstrings._lower_interp's `arg_type is None` branch). A method call
         * whose field is a known string-producing method (toString, trim, ...)
         * — e.g. an enum's `e.toString()` — formats as %s. */
        if (argType == null) {
            if (ex.kind == NK_F_STRING_LITERAL || ex.kind == NK_STRING_LITERAL) {
                fmt = "%s";
            } else if (ex.kind == NK_CALL_EXPR) {
                Node? fcallee = ex.callee;
                if (fcallee != null && fcallee.kind == NK_FIELD_ACCESS_EXPR
                        && isStringProducingMethod(fcallee.field)) {
                    fmt = "%s";
                }
            }
            if (fmt == "%s") { cType = "char*"; } else { cType = "int"; }
        }

        bool isBool = argType != null && argType.base == "bool";
        if (isBool) { cType = "bool"; fmt = "%s"; }

        /* Hoist the value into a temp so it evaluates exactly once. */
        string argVar = tmp + "_arg" + Strings.fromInt(index);
        argDecls.push(irVarDecl(cType, argVar, null));
        argAssignments.push(irBinOp(irVar(argVar), "=", irValue));
        IRNode irArg = irVar(argVar);
        if (isBool) {
            irArg = irTernary(irArg, irLiteral("\"true\""), irLiteral("\"false\""));
        }
        args.push(irArg);
        return fmt;
    }

    /* print(...) -> printf with format string (matches calls.py _lower_print). */
    public IRNode lowerPrint(Node node, Map<string, Node> varTypes) {
        if (node.args.len == 0) {
            Vector<IRNode> a = [];
            a.push(irLiteral("\"\\n\""));
            return irCall("printf", a);
        }
        string fmt = "";
        Vector<IRNode> irArgs = [];
        int i = 0;
        while (i < node.args.len) {
            Node arg = node.args.get(i);
            IRNode irArg = self.lowerExpr(arg, varTypes);
            Node? at = inferType(arg, self.analyzed, varTypes);
            string spec = formatSpec(at);
            /* Force %s for known string-producing exprs when type is untracked
             * (mirrors _lower_print's arg_type is None branch). */
            if (at == null) {
                if (arg.kind == NK_STRING_LITERAL || arg.kind == NK_F_STRING_LITERAL) {
                    spec = "%s";
                } else if (arg.kind == NK_CALL_EXPR) {
                    Node? callee = arg.callee;
                    if (callee != null && callee.kind == NK_IDENTIFIER
                            && (callee.name == "toString" || callee.name == "str")) {
                        spec = "%s";
                    }
                    if (callee != null && callee.kind == NK_FIELD_ACCESS_EXPR) {
                        string mn = callee.field;
                        if (mn == "toString" || mn == "str" || mn == "trim"
                                || mn == "toUpper" || mn == "toLower" || mn == "substring"
                                || mn == "replace" || mn == "repeat" || mn == "reverse"
                                || mn == "capitalize" || mn == "split") {
                            spec = "%s";
                        }
                    }
                }
            }
            /* bool -> ternary: val ? "true" : "false" */
            if (at != null && at.base == "bool") {
                irArg = irTernary(irArg, irLiteral("\"true\""), irLiteral("\"false\""));
                spec = "%s";
            }
            if (i > 0) { fmt = fmt + " "; }
            fmt = fmt + spec;
            irArgs.push(irArg);
            i = i + 1;
        }
        fmt = fmt + "\\n";
        Vector<IRNode> callArgs = [];
        callArgs.push(irLiteral("\"" + fmt + "\""));
        int j = 0;
        while (j < irArgs.len) { callArgs.push(irArgs.get(j)); j = j + 1; }
        return irCall("printf", callArgs);
    }
}

/* True if a method-call field name names a string-producing method (toString,
 * str, trim, ...). Used by print/f-string lowering to force %s when the
 * receiver's type is untracked — e.g. an enum's `e.toString()`. Mirrors the
 * field-name set in fstrings._lower_interp / calls._lower_print. */
bool isStringProducingMethod(string m) {
    return m == "toString" || m == "str" || m == "trim"
        || m == "toUpper" || m == "toLower" || m == "substring"
        || m == "replace" || m == "repeat" || m == "reverse"
        || m == "capitalize" || m == "split";
}

/* Double every '%' so printf reads it as a literal percent (mirrors
 * fstrings.py's text.replace("%", "%%")). */
string replacePercent(string s) {
    string out = "";
    int i = 0;
    int n = s.length();
    while (i < n) {
        char c = s[i];
        if (c == '%') { out = out + "%%"; }
        else { out = out + f"{c}"; }
        i = i + 1;
    }
    return out;
}

/* Runtime helper backing a helper-mapped string method (mirrors the helper
 * fields of STRING_METHODS in string_methods.py). "" for methods with no helper
 * (len/equals/conversions, handled inline) or unknown names. */
string stringMethodHelper(string method) {
    if (method == "charLen") { return "__btrc_charLen"; }
    if (method == "contains") { return "__btrc_strContains"; }
    if (method == "startsWith") { return "__btrc_startsWith"; }
    if (method == "endsWith") { return "__btrc_endsWith"; }
    if (method == "indexOf") { return "__btrc_indexOf"; }
    if (method == "lastIndexOf") { return "__btrc_lastIndexOf"; }
    if (method == "find") { return "__btrc_find"; }
    if (method == "count") { return "__btrc_count"; }
    if (method == "charAt") { return "__btrc_charAt"; }
    if (method == "isEmpty") { return "__btrc_isEmpty"; }
    if (method == "isBlank") { return "__btrc_isBlank"; }
    if (method == "isUpper") { return "__btrc_isUpper"; }
    if (method == "isLower") { return "__btrc_isLower"; }
    if (method == "isAlnum" || method == "isAlnumStr") { return "__btrc_isAlnumStr"; }
    if (method == "isDigit" || method == "isDigitStr") { return "__btrc_isDigitStr"; }
    if (method == "isAlpha" || method == "isAlphaStr") { return "__btrc_isAlphaStr"; }
    if (method == "trim") { return "__btrc_trim"; }
    if (method == "lstrip") { return "__btrc_lstrip"; }
    if (method == "rstrip") { return "__btrc_rstrip"; }
    if (method == "toUpper") { return "__btrc_toUpper"; }
    if (method == "toLower") { return "__btrc_toLower"; }
    if (method == "substring") { return "__btrc_substring"; }
    if (method == "replace") { return "__btrc_replace"; }
    if (method == "repeat") { return "__btrc_repeat"; }
    if (method == "reverse") { return "__btrc_reverse"; }
    if (method == "capitalize") { return "__btrc_capitalize"; }
    if (method == "title") { return "__btrc_title"; }
    if (method == "swapCase") { return "__btrc_swapCase"; }
    if (method == "padLeft") { return "__btrc_padLeft"; }
    if (method == "padRight") { return "__btrc_padRight"; }
    if (method == "center") { return "__btrc_center"; }
    if (method == "zfill") { return "__btrc_zfill"; }
    if (method == "removePrefix") { return "__btrc_removePrefix"; }
    if (method == "removeSuffix") { return "__btrc_removeSuffix"; }
    if (method == "split") { return "__btrc_split"; }
    return "";
}

/* True for string methods whose helper returns a fresh heap string and must be
 * wrapped in __btrc_str_track (mirrors the tracked= flag in STRING_METHODS). */
bool stringMethodTracked(string method) {
    if (method == "trim" || method == "lstrip" || method == "rstrip"
            || method == "toUpper" || method == "toLower" || method == "substring"
            || method == "replace" || method == "repeat" || method == "reverse"
            || method == "capitalize" || method == "title" || method == "swapCase"
            || method == "padLeft" || method == "padRight" || method == "center"
            || method == "zfill" || method == "removePrefix" || method == "removeSuffix"
            ) {
        return true;
    }
    return false;
}

/* printf format specifier for a type (mirrors types.py format_spec_for_type). */
string formatSpec(Node? t) {
    if (t == null) { return "%d"; }
    string base = t.base;
    if (t.pointer_depth > 0) { return "%s"; }
    if (base == "int" || base == "short" || base == "short int"
            || base == "signed int" || base == "signed short"
            || base == "signed short int") { return "%d"; }
    if (base == "byte" || base == "uint" || base == "unsigned int"
            || base == "unsigned short" || base == "unsigned short int"
            || base == "unsigned char") { return "%u"; }
    if (base == "long" || base == "long int" || base == "signed long"
            || base == "signed long int") { return "%ld"; }
    if (base == "unsigned long" || base == "unsigned long int") { return "%lu"; }
    if (base == "long long" || base == "long long int"
            || base == "signed long long" || base == "signed long long int") {
        return "%lld";
    }
    if (base == "unsigned long long" || base == "unsigned long long int") {
        return "%llu";
    }
    if (base == "size_t") { return "%zu"; }
    if (base == "float" || base == "double") { return "%f"; }
    if (base == "long double") { return "%Lf"; }
    if (base == "char") { return "%c"; }
    if (base == "string") { return "%s"; }
    if (base == "bool") { return "%s"; }
    return "%d";
}

/* Render an IR expression to inline C text (mirrors expressions.py _expr_text,
 * used by sizeof lowering). Only the IR-node subset that can appear there. */
string irExprText(IRNode e) {
    if (e == null) {
        print("internal compiler error: null IR expression in irExprText");
        abortGen();
        return "";
    }
    if (e.kind == IRK_LITERAL) { return e.text; }
    if (e.kind == IRK_VAR) { return e.name; }
    if (e.kind == IRK_BINOP) {
        return f"({irExprText(e.left)} {e.op} {irExprText(e.right)})";
    }
    if (e.kind == IRK_COMMA_EXPR) {
        string out = "(";
        int i = 0;
        while (i < e.args.len) {
            if (i > 0) { out = out + ", "; }
            out = out + irExprText(e.args.get(i));
            i = i + 1;
        }
        return out + ")";
    }
    if (e.kind == IRK_UNARYOP) {
        if (e.prefix) { return f"({e.op}{irExprText(e.operand)})"; }
        return f"({irExprText(e.operand)}{e.op})";
    }
    if (e.kind == IRK_CALL) {
        string args = "";
        int i = 0;
        while (i < e.args.len) {
            if (i > 0) { args = args + ", "; }
            args = args + irExprText(e.args.get(i));
            i = i + 1;
        }
        string callee = e.callee;
        if (e.expr != null) { callee = irExprText(e.expr); }
        return f"{callee}({args})";
    }
    if (e.kind == IRK_FIELD_ACCESS) {
        string op = ".";
        if (e.arrow) { op = "->"; }
        return f"{irExprText(e.obj)}{op}{e.field}";
    }
    if (e.kind == IRK_INDEX) {
        return f"{irExprText(e.obj)}[{irExprText(e.index)}]";
    }
    if (e.kind == IRK_CAST) {
        return f"(({e.target_type}){irExprText(e.expr)})";
    }
    if (e.kind == IRK_TERNARY) {
        return f"({irExprText(e.condition)} ? {irExprText(e.true_expr)} : {irExprText(e.false_expr)})";
    }
    if (e.kind == IRK_ADDRESS_OF) { return f"(&{irExprText(e.expr)})"; }
    if (e.kind == IRK_DEREF) { return f"(*{irExprText(e.expr)})"; }
    if (e.kind == IRK_SIZEOF) {
        if (e.operand != null) { return f"sizeof({irExprText(e.operand)})"; }
        if (e.target_type == "") {
            print("internal compiler error: IRSizeof has no operand");
            abortGen();
        }
        return f"sizeof({e.target_type})";
    }
    if (e.kind == IRK_INITIALIZER_LIST) {
        string values = "";
        int i = 0;
        while (i < e.args.len) {
            if (i > 0) { values = values + ", "; }
            values = values + irExprText(e.args.get(i));
            i = i + 1;
        }
        return "{" + values + "}";
    }
    if (e.kind == IRK_COMPOUND_LITERAL) {
        if (e.target_type == "" || e.field_names.len != e.args.len) {
            print("internal compiler error: malformed IRCompoundLiteral");
            abortGen();
        }
        string fields = "";
        int i = 0;
        while (i < e.args.len) {
            if (i > 0) { fields = fields + ", "; }
            fields = fields + "." + e.field_names.get(i)
                + " = " + irExprText(e.args.get(i));
            i = i + 1;
        }
        return f"({e.target_type})" + "{" + fields + "}";
    }
    print(f"internal compiler error: unsupported IR expression {e.kind} in irExprText");
    abortGen();
    return "";
}

void abortGen() {
    /* Diagnostics must fail closed; an out-of-bounds read is not a portable
     * trap and previously let the compiler emit C after reporting an error. */
    exit(1);
}

/* ===================================================================
 * Stage 5 — Optimizer (reachability DCE).
 *
 * Mirrors src/compiler/python/ir/optimizer.py for the class subset:
 *   - _eliminate_dead_functions: keep only functions reachable from `main`
 *     through the call/reference graph; drop forward decls of removed ones.
 *   - _eliminate_dead_structs: keep structs named in surviving code (+ field
 *     embedding closure); drop forward decls of removed ones.
 * Dead-helper elimination is handled separately by usedHelpers tracking.
 * =================================================================== */

void optimizeModule(IRModule m) {
    eliminateDeadFunctions(m);
    eliminateDeadGpuKernels(m);
    eliminateDeadStructs(m);
}

/* Recursively collect runtime-helper references in an IR node into `used`.
 * A helper is referenced when it appears as a call callee or function name
 * (var). Mirrors optimizer._collect_helper_refs. */
void scanHelpersInNode(IRNode? n, Map<string, bool> used) {
    if (n == null) { return; }
    /* Call callee. */
    if (n.callee != "" && !used.has(n.callee) && helperSource(n.callee) != "") {
        used.put(n.callee, true);
    }
    /* Var name (function pointer reference). */
    if (n.name != "" && !used.has(n.name) && helperSource(n.name) != "") {
        used.put(n.name, true);
    }
    /* Recurse into all sub-node fields. */
    scanHelpersInNode(n.left, used);
    scanHelpersInNode(n.right, used);
    scanHelpersInNode(n.operand, used);
    scanHelpersInNode(n.expr, used);
    scanHelpersInNode(n.obj, used);
    scanHelpersInNode(n.index, used);
    scanHelpersInNode(n.condition, used);
    scanHelpersInNode(n.true_expr, used);
    scanHelpersInNode(n.false_expr, used);
    scanHelpersInNode(n.init, used);
    scanHelpersInNode(n.value, used);
    scanHelpersInNode(n.target, used);
    scanHelpersInNode(n.then_block, used);
    scanHelpersInNode(n.else_block, used);
    scanHelpersInNode(n.body, used);
    scanHelpersInNode(n.update, used);
    scanHelpersInNode(n.result, used);
    scanHelpersInNode(n.array_size, used);
    int ai = 0;
    while (ai < n.args.len) { scanHelpersInNode(n.args.get(ai), used); ai = ai + 1; }
    int si = 0;
    while (si < n.stmts.len) { scanHelpersInNode(n.stmts.get(si), used); si = si + 1; }
}

/* True if any declaration in the program uses try/catch or throw (mirrors
 * generator._uses_trycatch). A deep recursive walk of body-bearing fields. */
bool programUsesTrycatch(Node prog) {
    int i = 0;
    while (i < prog.declarations.len) {
        if (nodeUsesTrycatch(prog.declarations.get(i))) { return true; }
        i = i + 1;
    }
    return false;
}

/* Recursively scan a node's body-bearing fields for NK_THROW_STMT /
 * NK_TRY_CATCH_STMT. Conservative deep walk over the statement/control-flow
 * child fields of the fat Node. */
bool nodeUsesTrycatch(Node? n) {
    if (n == null) { return false; }
    if (n.kind == NK_THROW_STMT || n.kind == NK_TRY_CATCH_STMT) { return true; }
    /* statement list (Block / Program-like). */
    int i = 0;
    while (i < n.statements.len) {
        if (nodeUsesTrycatch(n.statements.get(i))) { return true; }
        i = i + 1;
    }
    /* class members / methods. */
    int mi = 0;
    while (mi < n.members.len) {
        if (nodeUsesTrycatch(n.members.get(mi))) { return true; }
        mi = mi + 1;
    }
    /* switch cases. */
    int ci = 0;
    while (ci < n.cases.len) {
        Node cc = n.cases.get(ci);
        int bj = 0;
        while (bj < cc.body_nlist.len) {
            if (nodeUsesTrycatch(cc.body_nlist.get(bj))) { return true; }
            bj = bj + 1;
        }
        ci = ci + 1;
    }
    /* single-node body / control-flow children. */
    if (nodeUsesTrycatch(n.body_node)) { return true; }
    if (nodeUsesTrycatch(n.then_block)) { return true; }
    if (nodeUsesTrycatch(n.else_block)) { return true; }
    if (nodeUsesTrycatch(n.if_stmt)) { return true; }
    if (nodeUsesTrycatch(n.try_block)) { return true; }
    if (nodeUsesTrycatch(n.catch_block)) { return true; }
    if (nodeUsesTrycatch(n.finally_block)) { return true; }
    if (nodeUsesTrycatch(n.getter_body)) { return true; }
    if (nodeUsesTrycatch(n.setter_body)) { return true; }
    return false;
}

/* Membership in a Vector<string>. */
bool containsName(Vector<string> names, string name) {
    int i = 0;
    while (i < names.len) {
        if (names.get(i) == name) { return true; }
        i = i + 1;
    }
    return false;
}

/* True if a char can be part of a C identifier. */
bool isIdentChar(char c) {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')
        || (c >= '0' && c <= '9') || c == '_';
}

/* Index of `needle` in `hay` at or after `from` (-1 if absent). btrc's string
 * indexOf has no start-offset overload, so search the suffix and re-offset. */
int indexOfFrom(string hay, string needle, int startAt) {
    int hlen = hay.length();
    if (startAt < 0) { startAt = 0; }
    if (startAt > hlen) { return -1; }
    string suffix = hay.substring(startAt, hlen - startAt);
    int rel = suffix.indexOf(needle);
    if (rel < 0) { return -1; }
    return startAt + rel;
}

/* Add every name in `names` that occurs as a whole identifier in `text` to
 * `out` (mirrors _scan_text_for_names: word-boundary, not substring). */
void scanTextForNames(string text, Vector<string> names, Map<string, bool> out) {
    int n = names.len;
    int tlen = text.length();
    int i = 0;
    while (i < n) {
        string name = names.get(i);
        if (!out.has(name)) {
            int nlen = name.length();
            int startAt = 0;
            bool found = false;
            while (!found && startAt <= tlen - nlen) {
                int pos = indexOfFrom(text, name, startAt);
                if (pos < 0) { startAt = tlen + 1; }
                else {
                    bool okBefore = pos == 0 || !isIdentChar(text[pos - 1]);
                    int after = pos + nlen;
                    bool okAfter = after >= tlen || !isIdentChar(text[after]);
                    if (okBefore && okAfter) { found = true; }
                    else { startAt = pos + 1; }
                }
            }
            if (found) { out.put(name, true); }
        }
        i = i + 1;
    }
}

/* Collect referenced function names from an IR expression/statement tree.
 * Calls and function-address IRVar nodes are semantic references. Literal text
 * is data and must never root a same-named dead function. */
void collectFuncRefs(IRNode node, Vector<string> names, Map<string, bool> out) {
    if (node == null) { return; }
    if (node.kind == IRK_CALL) {
        if (node.callee != "") { scanTextForNames(node.callee, names, out); }
    }
    if (node.kind == IRK_VAR) {
        scanTextForNames(node.name, names, out);
    }
    /* Recurse into every sub-node field. */
    collectFuncRefs(node.left, names, out);
    collectFuncRefs(node.right, names, out);
    collectFuncRefs(node.operand, names, out);
    collectFuncRefs(node.expr, names, out);
    collectFuncRefs(node.obj, names, out);
    collectFuncRefs(node.index, names, out);
    collectFuncRefs(node.condition, names, out);
    collectFuncRefs(node.true_expr, names, out);
    collectFuncRefs(node.false_expr, names, out);
    collectFuncRefs(node.init, names, out);
    collectFuncRefs(node.value, names, out);
    collectFuncRefs(node.target, names, out);
    collectFuncRefs(node.then_block, names, out);
    collectFuncRefs(node.else_block, names, out);
    collectFuncRefs(node.body, names, out);
    collectFuncRefs(node.update, names, out);
    collectFuncRefs(node.result, names, out);
    collectFuncRefs(node.array_size, names, out);
    int i = 0;
    while (i < node.args.len) { collectFuncRefs(node.args.get(i), names, out); i = i + 1; }
    int j = 0;
    while (j < node.stmts.len) { collectFuncRefs(node.stmts.get(j), names, out); j = j + 1; }
}

void eliminateDeadFunctions(IRModule m) {
    if (m.functions.len <= 1) { return; }
    Vector<string> names = [];
    Map<string, int> byName = {};
    Map<string, bool> keepSet = {};
    Vector<string> worklist = [];
    int i = 0;
    while (i < m.functions.len) {
        names.push(m.functions.get(i).name);
        byName.put(m.functions.get(i).name, i);
        i = i + 1;
    }
    Vector<string> descriptorNames = [];
    Map<string, int> descriptorByName = {};
    int descriptorIndex = 0;
    while (descriptorIndex < m.global_decls.len) {
        IRGlobalDecl descriptor = m.global_decls.get(descriptorIndex);
        if (descriptor.c_type == "const __btrc_arc_type") {
            descriptorNames.push(descriptor.name);
            descriptorByName.put(descriptor.name, descriptorIndex);
        }
        descriptorIndex = descriptorIndex + 1;
    }
    /* Roots: the entry points main / btrc_main. */
    int r = 0;
    while (r < names.len) {
        string nm = names.get(r);
        if (nm == "main" || nm == "btrc_main") {
            if (!keepSet.has(nm)) { keepSet.put(nm, true); worklist.push(nm); }
        }
        r = r + 1;
    }
    /* Macro replacement bodies and global initializers are executable roots;
     * callable declarations themselves are not. */
    Map<string, bool> rootRefs = {};
    Map<string, bool> descriptorRootRefs = {};
    int preprocessorIndex = 0;
    while (preprocessorIndex < m.preprocessor_decls.len) {
        IRPreprocessorDecl declaration =
            m.preprocessor_decls.get(preprocessorIndex);
        if (declaration.kind == IR_PREPROCESSOR_MACRO) {
            scanTextForNames(declaration.replacement, names, rootRefs);
            scanTextForNames(declaration.replacement,
                descriptorNames, descriptorRootRefs);
        }
        preprocessorIndex = preprocessorIndex + 1;
    }
    int globalIndex = 0;
    while (globalIndex < m.global_decls.len) {
        IRGlobalDecl global = m.global_decls.get(globalIndex);
        if (!descriptorByName.has(global.name)) {
            collectFuncRefs(global.init, names, rootRefs);
            collectFuncRefs(global.array_size, names, rootRefs);
            collectFuncRefs(global.init,
                descriptorNames, descriptorRootRefs);
            collectFuncRefs(global.array_size,
                descriptorNames, descriptorRootRefs);
        }
        globalIndex = globalIndex + 1;
    }
    Vector<string> rootNames = rootRefs.keys();
    int rootIndex = 0;
    while (rootIndex < rootNames.len) {
        string rootName = rootNames.get(rootIndex);
        if (!keepSet.has(rootName)) {
            keepSet.put(rootName, true);
            worklist.push(rootName);
        }
        rootIndex = rootIndex + 1;
    }
    Map<string, bool> keptDescriptors = {};
    Vector<string> descriptorWorklist = descriptorRootRefs.keys();
    /* Transitive reachability. */
    while (worklist.len > 0 || descriptorWorklist.len > 0) {
        Map<string, bool> refs = {};
        if (descriptorWorklist.len > 0) {
            string descriptorName = descriptorWorklist.pop();
            if (keptDescriptors.has(descriptorName)) { continue; }
            keptDescriptors.put(descriptorName, true);
            IRGlobalDecl descriptor = m.global_decls.get(
                descriptorByName.get(descriptorName));
            collectFuncRefs(descriptor.init, names, refs);
            collectFuncRefs(descriptor.array_size, names, refs);
        } else {
            string cur = worklist.pop();
            bool hasFn = byName.has(cur);
            if (hasFn) {
                IRFunction fn = m.functions.get(byName.get(cur));
                if (fn.body != null) {
                    collectFuncRefs(fn.body, names, refs);
                    Map<string, bool> foundDescriptors = {};
                    collectFuncRefs(fn.body,
                        descriptorNames, foundDescriptors);
                    Vector<string> foundNames = foundDescriptors.keys();
                    int foundIndex = 0;
                    while (foundIndex < foundNames.len) {
                        string foundName = foundNames.get(foundIndex);
                        if (!keptDescriptors.has(foundName)) {
                            descriptorWorklist.push(foundName);
                        }
                        foundIndex = foundIndex + 1;
                    }
                }
            }
        }
        Vector<string> rk = refs.keys();
        int k = 0;
        while (k < rk.len) {
            string rn = rk.get(k);
            if (!keepSet.has(rn)) { keepSet.put(rn, true); worklist.push(rn); }
            k = k + 1;
        }
    }
    if (descriptorNames.len > keptDescriptors.len) {
        Vector<IRGlobalDecl> keptGlobals = [];
        int keptGlobalIndex = 0;
        while (keptGlobalIndex < m.global_decls.len) {
            IRGlobalDecl global = m.global_decls.get(keptGlobalIndex);
            if (!descriptorByName.has(global.name)
                    || keptDescriptors.has(global.name)) {
                keptGlobals.push(global);
            }
            keptGlobalIndex = keptGlobalIndex + 1;
        }
        m.global_decls = keptGlobals;
    }
    /* Filter functions. */
    Vector<IRFunction> kept = [];
    Vector<string> removed = [];
    int f = 0;
    while (f < m.functions.len) {
        IRFunction fn = m.functions.get(f);
        if (keepSet.has(fn.name)) { kept.push(fn); }
        else { removed.push(fn.name); }
        f = f + 1;
    }
    m.functions = kept;
    /* Typed declarations are pruned by their explicit function name. */
    if (removed.len > 0) {
        Vector<IRFunctionDecl> declarations = [];
        int d = 0;
        while (d < m.function_decls.len) {
            IRFunctionDecl declaration = m.function_decls.get(d);
            if (!containsName(removed, declaration.name)) {
                declarations.push(declaration);
            }
            d = d + 1;
        }
        m.function_decls = declarations;
    }
}

/* Collect struct-name references in a function's signature (params + return)
 * and body. Mirrors _collect_struct_refs (which scans CType text + strings). */
void collectStructRefsFn(IRFunction fn, Vector<string> names, Map<string, bool> out) {
    scanTextForNames(fn.return_type, names, out);
    int i = 0;
    while (i < fn.params.len) {
        scanTextForNames(fn.params.get(i).c_type, names, out);
        i = i + 1;
    }
    if (fn.body != null) { collectStructRefsNode(fn.body, names, out); }
}

/* Scan an IR node tree for struct names in type-bearing + text fields. */
void collectStructRefsNode(IRNode node, Vector<string> names, Map<string, bool> out) {
    if (node == null) { return; }
    if (node.c_type != "") { scanTextForNames(node.c_type, names, out); }
    if (node.target_type != "") { scanTextForNames(node.target_type, names, out); }
    if (node.text != "") { scanTextForNames(node.text, names, out); }
    if (node.callee != "") { scanTextForNames(node.callee, names, out); }
    collectStructRefsNode(node.left, names, out);
    collectStructRefsNode(node.right, names, out);
    collectStructRefsNode(node.operand, names, out);
    collectStructRefsNode(node.expr, names, out);
    collectStructRefsNode(node.obj, names, out);
    collectStructRefsNode(node.index, names, out);
    collectStructRefsNode(node.condition, names, out);
    collectStructRefsNode(node.true_expr, names, out);
    collectStructRefsNode(node.false_expr, names, out);
    collectStructRefsNode(node.init, names, out);
    collectStructRefsNode(node.value, names, out);
    collectStructRefsNode(node.target, names, out);
    collectStructRefsNode(node.then_block, names, out);
    collectStructRefsNode(node.else_block, names, out);
    collectStructRefsNode(node.body, names, out);
    collectStructRefsNode(node.update, names, out);
    collectStructRefsNode(node.result, names, out);
    collectStructRefsNode(node.array_size, names, out);
    int i = 0;
    while (i < node.args.len) { collectStructRefsNode(node.args.get(i), names, out); i = i + 1; }
    int j = 0;
    while (j < node.stmts.len) { collectStructRefsNode(node.stmts.get(j), names, out); j = j + 1; }
}

void eliminateDeadStructs(IRModule m) {
    if (m.struct_defs.len <= 1) { return; }
    Vector<string> names = [];
    Map<string, int> byName = {};
    Map<string, bool> refs = {};
    Map<string, bool> keepSet = {};
    int i = 0;
    while (i < m.struct_defs.len) {
        names.push(m.struct_defs.get(i).name);
        byName.put(m.struct_defs.get(i).name, i);
        i = i + 1;
    }
    int f = 0;
    while (f < m.functions.len) {
        collectStructRefsFn(m.functions.get(f), names, refs);
        f = f + 1;
    }
    int globalIndex = 0;
    while (globalIndex < m.global_decls.len) {
        IRGlobalDecl global = m.global_decls.get(globalIndex);
        scanTextForNames(global.c_type, names, refs);
        collectStructRefsNode(global.init, names, refs);
        collectStructRefsNode(global.array_size, names, refs);
        globalIndex = globalIndex + 1;
    }
    int declarationIndex = 0;
    while (declarationIndex < m.function_decls.len) {
        IRFunctionDecl declaration = m.function_decls.get(declarationIndex);
        scanTextForNames(declaration.return_type, names, refs);
        int parameterIndex = 0;
        while (parameterIndex < declaration.params.len) {
            scanTextForNames(
                declaration.params.get(parameterIndex).c_type, names, refs);
            parameterIndex = parameterIndex + 1;
        }
        declarationIndex = declarationIndex + 1;
    }
    int pointerIndex = 0;
    while (pointerIndex < m.function_pointer_typedefs.len) {
        IRFunctionPointerTypedef declaration =
            m.function_pointer_typedefs.get(pointerIndex);
        scanTextForNames(declaration.return_type, names, refs);
        int parameterIndex = 0;
        while (parameterIndex < declaration.param_types.len) {
            scanTextForNames(
                declaration.param_types.get(parameterIndex), names, refs);
            parameterIndex = parameterIndex + 1;
        }
        pointerIndex = pointerIndex + 1;
    }
    int typedefIndex = 0;
    while (typedefIndex < m.typedef_defs.len) {
        scanTextForNames(
            m.typedef_defs.get(typedefIndex).target_type, names, refs);
        typedefIndex = typedefIndex + 1;
    }
    int taggedIndex = 0;
    while (taggedIndex < m.tagged_union_defs.len) {
        IRTaggedUnionDef tagged = m.tagged_union_defs.get(taggedIndex);
        scanTextForNames(tagged.tag_type, names, refs);
        int variantIndex = 0;
        while (variantIndex < tagged.variants.len) {
            IRTaggedUnionVariant variant = tagged.variants.get(variantIndex);
            int fieldIndex = 0;
            while (fieldIndex < variant.fields.len) {
                scanTextForNames(
                    variant.fields.get(fieldIndex).c_type, names, refs);
                fieldIndex = fieldIndex + 1;
            }
            variantIndex = variantIndex + 1;
        }
        taggedIndex = taggedIndex + 1;
    }
    int preprocessorIndex = 0;
    while (preprocessorIndex < m.preprocessor_decls.len) {
        IRPreprocessorDecl declaration =
            m.preprocessor_decls.get(preprocessorIndex);
        if (declaration.kind == IR_PREPROCESSOR_MACRO) {
            scanTextForNames(declaration.replacement, names, refs);
        }
        preprocessorIndex = preprocessorIndex + 1;
    }
    /* Names referenced in surviving functions seed the set; the embedding
     * closure below keeps the struct types of a kept struct's fields. */
    Vector<string> worklist = refs.keys();
    int w0 = 0;
    while (w0 < worklist.len) { keepSet.put(worklist.get(w0), true); w0 = w0 + 1; }
    while (worklist.len > 0) {
        Map<string, bool> fr = {};
        string cur = worklist.pop();
        bool present = byName.has(cur);
        if (present) {
            IRStructDef sd = m.struct_defs.get(byName.get(cur));
            int fl = 0;
            while (fl < sd.fields.len) {
                scanTextForNames(sd.fields.get(fl).c_type, names, fr);
                fl = fl + 1;
            }
        }
        Vector<string> frk = fr.keys();
        int z = 0;
        while (z < frk.len) {
            string nm = frk.get(z);
            if (!keepSet.has(nm)) { keepSet.put(nm, true); worklist.push(nm); }
            z = z + 1;
        }
    }
    if (keepSet.len == names.len) { return; }
    Vector<IRStructDef> kept = [];
    Vector<string> removed = [];
    int s = 0;
    while (s < m.struct_defs.len) {
        IRStructDef sd = m.struct_defs.get(s);
        if (keepSet.has(sd.name)) { kept.push(sd); }
        else { removed.push(sd.name); }
        s = s + 1;
    }
    m.struct_defs = kept;
    Vector<IRStructForward> forwards = [];
    int d = 0;
    while (d < m.struct_forwards.len) {
        IRStructForward declaration = m.struct_forwards.get(d);
        if (!containsName(removed, declaration.name)) {
            forwards.push(declaration);
        }
        d = d + 1;
    }
    m.struct_forwards = forwards;
}
