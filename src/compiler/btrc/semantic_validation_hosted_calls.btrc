/* Direct hosted-call resolution, signatures, and source-shadow provenance. */

void semanticValidateDirectHostedOpaqueArguments(string name, Node call,
        SemanticValidationState state, Map<string, Node> vars) {
    int parameterCount = HostedAbi.parameterCount(name);
    int argumentIndex = 0;
    while (argumentIndex < call.args.len
            && argumentIndex < parameterCount) {
        Node expected = makePrimType(
            HostedAbi.parameterBase(name, argumentIndex));
        expected.pointer_depth = HostedAbi.parameterPointerDepth(
            name, argumentIndex);
        expected.is_const = HostedAbi.parameterConst(name, argumentIndex);
        semanticValidateOpaqueCallArgument(
            null, argumentIndex, expected,
            call.args.get(argumentIndex), name, true, state, vars);
        argumentIndex = argumentIndex + 1;
    }
}

bool semanticHostedCallBypassesSourceDefinition(
        string name, SemanticValidationState state) {
    if (!HostedAbi.functionOwnedName(name)
            || !state.analyzed.funcTable.has(name)
            || state.callable == null
            || !HostedAbiProvenance.compilerStdlibNode(state.callable)) {
        return false;
    }
    Node declaration = state.analyzed.funcTable.get(name);
    return declaration.body_node != null
        && !HostedAbiProvenance.compilerStdlibNode(declaration);
}

bool semanticHostedCallUsesOwnedSymbol(string name,
        SemanticValidationState state, Map<string, Node> vars) {
    if (!HostedAbi.functionOwnedName(name) || vars.has(name)) { return false; }
    if (!state.analyzed.funcTable.has(name)) {
        return !state.analyzed.isClass(name);
    }
    Node declaration = state.analyzed.funcTable.get(name);
    return declaration.body_node == null
        || semanticHostedCallBypassesSourceDefinition(name, state);
}

bool semanticHostedArgumentTypeDeferred(Node expected, Node actual,
        SemanticValidationState state) {
    if (state.typeParams.has(actual.base)) { return true; }
    return expected.base == "void" && expected.pointer_depth == 1
        && (actual.base == "string" || actual.pointer_depth > 0
            || actual.is_array);
}

void semanticValidateUnknownHostedOpaqueArguments(string name, Node call,
        SemanticValidationState state, Map<string, Node> vars) {
    int index = 0;
    while (index < call.args.len) {
        Node argument = call.args.get(index);
        if (semanticExpressionIsOpaqueBorrow(argument, state, vars)) {
            semanticValidationFail("Argument to hosted function '" + name
                + "()' cannot forward a managed value as a raw "
                + "representation because its ABI effect is not proven "
                + "read-only", argument);
        }
        index = index + 1;
    }
}

void semanticValidateDirectHostedCall(string name, Node call,
        SemanticValidationState state, Map<string, Node> vars) {
    if (!HostedAbi.exactFunction(name)) {
        semanticValidateUnknownHostedOpaqueArguments(name, call, state, vars);
        return;
    }
    int nameIndex = 0;
    while (nameIndex < call.arg_names.len) {
        if (call.arg_names.get(nameIndex) != "") {
            semanticValidationFail("Hosted function '" + name
                + "()' does not accept named arguments", call);
        }
        nameIndex = nameIndex + 1;
    }
    int expectedCount = HostedAbi.parameterCount(name);
    bool arityValid = call.args.len == expectedCount;
    if (HostedAbi.variadic(name)) {
        arityValid = call.args.len >= expectedCount;
    }
    if (!arityValid) {
        string qualifier = HostedAbi.variadic(name) ? "at least " : "";
        semanticValidationFail("'" + name + "()' expects " + qualifier
            + Strings.fromInt(expectedCount) + " argument(s) but got "
            + Strings.fromInt(call.args.len), call);
        return;
    }
    semanticValidateDirectHostedOpaqueArguments(name, call, state, vars);
    int index = 0;
    while (index < expectedCount) {
        Node expected = makePrimType(HostedAbi.parameterBase(name, index));
        expected.pointer_depth = HostedAbi.parameterPointerDepth(name, index);
        expected.is_const = HostedAbi.parameterConst(name, index);
        Node argument = call.args.get(index);
        semanticValidateVolatileReferenceConversion(
            expected, argument,
            "Argument " + Strings.fromInt(index + 1)
                + " to hosted function '" + name + "()'",
            state, vars);
        Node? actual = semanticInferType(argument, state, vars);
        if (actual != null
                && !semanticHostedArgumentTypeDeferred(
                    expected, actual, state)
                && !semanticAssignmentCompatible(expected, actual, state)) {
            semanticValidationFail("Argument " + Strings.fromInt(index + 1)
                + " to hosted function '" + name + "()' expects '"
                + semanticFormatType(expected) + "' but got '"
                + semanticFormatType(actual) + "'", argument);
        }
        semanticValidateSourceHelperConsumer(
            name, index, argument, state, vars);
        index = index + 1;
    }
}

bool semanticValidateHostedIdentifierCall(Node call,
        SemanticValidationState state, Map<string, Node> vars) {
    string name = call.callee.name;
    if (!semanticHostedCallUsesOwnedSymbol(name, state, vars)) {
        return false;
    }
    bool bypass = semanticHostedCallBypassesSourceDefinition(name, state);
    state.analyzed.hostedCallKeys.put(astNodeKey(call), true);
    semanticValidateDirectHostedCall(name, call, state, vars);
    return HostedAbi.exactFunction(name)
        || bypass || !state.analyzed.funcTable.has(name);
}
