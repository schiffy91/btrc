/* Analyzer-owned ARC cycle eligibility and emitted visitor symbols. */

string cycleVisitorName(string emittedName) {
    return "__btrc_arc_visit_" + emittedName;
}

bool isCycleCollection(string base) {
    return base == "Vector" || base == "Array" || base == "List"
        || base == "Map" || base == "Set";
}

Node genericCycleRootType(GenInstance instance) {
    Node root = Node();
    root.kind = NK_TYPE_EXPR;
    root.base = instance.base;
    int index = 0;
    while (index < instance.args.len) {
        root.generic_args.push(instance.args.get(index));
        index++;
    }
    return root;
}

string genericCycleTypeKey(Node typeExpr) {
    if (typeExpr.generic_args.len > 0) {
        return "generic:" + TypeIdentity.genericInstanceKey(
            typeExpr.base, typeExpr.generic_args);
    }
    return "class:" + TypeIdentity.field(
        "b", TypeIdentity.utf8Hex(typeExpr.base));
}

bool genericCycleManagedType(Analyzed analyzed, Node? typeExpr) {
    Node? canonical = resolveOuterTypedefType(typeExpr, analyzed.typedefTable);
    if (canonical == null || canonical.is_array) { return false; }
    Node resolved = canonical;
    if (mutexPayloadType(analyzed, resolved) != null) { return true; }
    int depth = resolved.pointer_depth;
    if (TypeComposition.nullableCollapsesReferenceLayer(resolved, false)) { depth--; }
    if (depth > 1) { return false; }
    return analyzed.isClass(resolved.base)
        || (resolved.generic_args.len > 0
            && analyzed.isGenericClass(resolved.base));
}

void genericCycleAppendRuntimeTypes(
        Analyzed analyzed, Node typeExpr, Vector<Node> output) {
    Node? canonical = resolveOuterTypedefType(typeExpr, analyzed.typedefTable);
    if (canonical == null) { return; }
    Node resolved = canonical;
    if (mutexPayloadType(analyzed, resolved) != null) {
        output.push(resolved);
        return;
    }
    if (!genericCycleManagedType(analyzed, resolved)) { return; }
    if (resolved.generic_args.len == 0
            && analyzed.isClass(resolved.base)) {
        Vector<string> runtimeClasses = analyzed.classTable.keys();
        int index = 0;
        while (index < runtimeClasses.len) {
            string runtimeClass = runtimeClasses.get(index);
            if (analyzed.isSubclass(runtimeClass, resolved.base)) {
                output.push(makePrimType(runtimeClass));
            }
            index++;
        }
        return;
    }
    output.push(resolved);
}

void genericCycleCollectClassFields(
        Analyzed analyzed, string className, Vector<Node> output) {
    if (!analyzed.isClass(className)) { return; }
    Node declaration = analyzed.classTable.get(className);
    string parent = parentName(declaration);
    if (parent != "" && analyzed.isClass(parent)) {
        genericCycleCollectClassFields(analyzed, parent, output);
    }
    int index = 0;
    while (index < declaration.members.len) {
        Node member = declaration.members.get(index);
        if (instanceStorageName(member) != "") { output.push(member); }
        index++;
    }
}

void genericCycleAppendRefs(
        Analyzed analyzed, Node typeExpr, Vector<Node> output) {
    Node? canonical = resolveOuterTypedefType(typeExpr, analyzed.typedefTable);
    if (canonical == null) { return; }
    Node resolvedType = canonical;
    Node? mutexPayload = mutexPayloadType(analyzed, resolvedType);
    if (mutexPayload != null) {
        genericCycleAppendRuntimeTypes(analyzed, mutexPayload, output);
        return;
    }
    if (resolvedType.generic_args.len > 0
            && analyzed.isGenericClass(resolvedType.base)) {
        Node declaration = analyzed.genericClassTable.get(resolvedType.base);
        Map<string, Node> substitutions = {};
        int parameter = 0;
        while (parameter < declaration.generic_params.len
                && parameter < resolvedType.generic_args.len) {
            substitutions.put(declaration.generic_params.get(parameter),
                resolvedType.generic_args.get(parameter));
            parameter++;
        }
        int memberIndex = 0;
        while (memberIndex < declaration.members.len) {
            Node member = declaration.members.get(memberIndex);
            if (instanceStorageName(member) != "") {
                Node resolved = resolveGenericType(member.type,
                    substitutions, analyzed);
                genericCycleAppendRuntimeTypes(analyzed, resolved, output);
            }
            memberIndex++;
        }
    } else if (analyzed.isClass(resolvedType.base)) {
        Vector<Node> fields = [];
        genericCycleCollectClassFields(analyzed, resolvedType.base, fields);
        int fieldIndex = 0;
        while (fieldIndex < fields.len) {
            genericCycleAppendRuntimeTypes(
                analyzed, fields.get(fieldIndex).type, output);
            fieldIndex++;
        }
    }
    int argumentIndex = 0;
    while (argumentIndex < resolvedType.generic_args.len) {
        genericCycleAppendRuntimeTypes(
            analyzed, resolvedType.generic_args.get(argumentIndex), output);
        argumentIndex++;
    }
}

bool genericCycleReaches(
        Analyzed analyzed, Node initial, string targetKey) {
    Vector<Node> stack = [initial];
    Map<string, bool> visited = {};
    while (stack.len > 0) {
        Node current = stack.pop();
        string currentKey = genericCycleTypeKey(current);
        if (currentKey == targetKey) { return true; }
        if (!visited.has(currentKey)) {
            visited.put(currentKey, true);
            genericCycleAppendRefs(analyzed, current, stack);
        }
    }
    return false;
}

bool genericInstanceIsCyclable(Analyzed analyzed, GenInstance instance) {
    Node root = genericCycleRootType(instance);
    string rootKey = genericCycleTypeKey(root);
    Vector<Node> references = [];
    genericCycleAppendRefs(analyzed, root, references);
    int index = 0;
    while (index < references.len) {
        if (genericCycleReaches(
                analyzed, references.get(index), rootKey)) {
            return true;
        }
        index++;
    }
    return false;
}

bool genericInstanceNeedsVisitor(Analyzed analyzed, GenInstance instance) {
    if (isCycleCollection(instance.base)) {
        if (instance.base == "List") { return instance.args.len == 1; }
        int argument = 0;
        while (argument < instance.args.len) {
            if (genericCycleManagedType(
                    analyzed, instance.args.get(argument))) {
                return true;
            }
            argument++;
        }
        return false;
    }
    if (!analyzed.isGenericClass(instance.base)) { return false; }
    Node declaration = analyzed.genericClassTable.get(instance.base);
    Map<string, Node> substitutions = {};
    int parameter = 0;
    while (parameter < declaration.generic_params.len
            && parameter < instance.args.len) {
        substitutions.put(declaration.generic_params.get(parameter),
            instance.args.get(parameter));
        parameter++;
    }
    int member = 0;
    while (member < declaration.members.len) {
        Node field = declaration.members.get(member);
        if (instanceStorageName(field) != "") {
            Node resolved = resolveGenericType(field.type,
                substitutions, analyzed);
            if (genericCycleManagedType(analyzed, resolved)) { return true; }
        }
        member++;
    }
    return false;
}
