/* Function-local IR invariants for typed exception cleanup registrations. */

class CleanupValidationState {
    public string function_name;
    public Map<int, IRCleanupSlot> declarations;
    public Vector<IRNode> registrations;

    public CleanupValidationState(string functionName) {
        self.function_name = functionName;
        self.declarations = {};
        self.registrations = [];
    }
}

class CleanupSlotValidator {
    private IRModule module;
    private Map<int, string> attached;

    public CleanupSlotValidator(IRModule module) {
        self.module = module;
        self.attached = {};
    }

    private void fail(string message) {
        fprintf(stderr, "internal compiler error: %s\n", message);
        abortGen();
    }

    private void collect(
            IRNode? node, CleanupValidationState state) {
        if (node == null) { return; }
        if (node.kind == IRK_VAR_DECL
                && node.cleanup_slot != null) {
            IRCleanupSlot metadata = node.cleanup_slot;
            if (metadata.name != node.name
                    || metadata.c_type != node.c_type) {
                self.fail(
                    "cleanup metadata does not describe slot "
                    + node.name);
            }
            if (!node.is_volatile) {
                self.fail(
                    "cleanup slot is not volatile: " + node.name);
            }
            if (self.attached.has(metadata.site)) {
                self.fail(
                    "cleanup metadata is attached more than once: "
                    + node.name);
            }
            self.attached.put(
                metadata.site, state.function_name);
            state.declarations.put(metadata.site, metadata);
        }
        if (node.kind == IRK_CALL) {
            bool registration =
                node.callee == "__btrc_register_cleanup"
                || node.callee
                    == "__btrc_register_direct_cleanup";
            if (registration) {
                state.registrations.push(node);
            } else if (node.cleanup_slot != null) {
                self.fail(
                    "cleanup metadata is attached to "
                    + "a non-registration call");
            }
        }

        self.collect(node.left, state);
        self.collect(node.right, state);
        self.collect(node.operand, state);
        self.collect(node.expr, state);
        self.collect(node.obj, state);
        self.collect(node.index, state);
        self.collect(node.condition, state);
        self.collect(node.true_expr, state);
        self.collect(node.false_expr, state);
        self.collect(node.array_size, state);
        self.collect(node.init, state);
        self.collect(node.value, state);
        self.collect(node.target, state);
        self.collect(node.then_block, state);
        self.collect(node.else_block, state);
        self.collect(node.body, state);
        self.collect(node.update, state);
        self.collect(node.result, state);
        int index = 0;
        while (index < node.args.len) {
            self.collect(node.args.get(index), state);
            index = index + 1;
        }
        index = 0;
        while (index < node.stmts.len) {
            self.collect(node.stmts.get(index), state);
            index = index + 1;
        }
    }

    private IRFunction? adapterDefinition(string name) {
        int index = 0;
        while (index < self.module.functions.len) {
            IRFunction definition =
                self.module.functions.get(index);
            if (definition.name == name) { return definition; }
            index = index + 1;
        }
        return null;
    }

    private IRCleanupSlot validateRegistration(IRNode call) {
        int arity = 4;
        if (call.callee
                == "__btrc_register_direct_cleanup") {
            arity = 3;
        }
        if (call.helper_ref != call.callee
                || call.args.len != arity
                || call.cleanup_slot == null) {
            self.fail("malformed typed cleanup registration");
        }
        IRCleanupSlot metadata = call.cleanup_slot;
        IRNode address = call.args.get(0);
        if (address.kind != IRK_CAST
                || address.target_type != "void*"
                || address.expr == null
                || address.expr.kind != IRK_ADDRESS_OF
                || address.expr.expr == null
                || address.expr.expr.kind != IRK_VAR
                || address.expr.expr.name != metadata.name) {
            self.fail(
                "cleanup slot must use an opaque address: "
                + metadata.name);
        }
        IRNode take = call.args.get(1);
        if (take.kind != IRK_FUNCTION_REF
                || take.name != metadata.take_function) {
            self.fail(
                "cleanup slot has the wrong take adapter: "
                + metadata.name);
        }
        return metadata;
    }

    public void validate() {
        self.attached = {};
        int functionIndex = 0;
        while (functionIndex < self.module.functions.len) {
            IRFunction definition =
                self.module.functions.get(functionIndex);
            CleanupValidationState state =
                CleanupValidationState(definition.name);
            self.collect(definition.body, state);
            Map<int, bool> used = {};
            int registrationIndex = 0;
            while (registrationIndex
                    < state.registrations.len) {
                IRCleanupSlot metadata =
                    self.validateRegistration(
                        state.registrations.get(
                            registrationIndex));
                if (!state.declarations.has(metadata.site)) {
                    self.fail(
                        "cleanup registration has no declaration "
                        + "in function " + definition.name + ": "
                        + metadata.name);
                }
                IRCleanupSlot declared =
                    state.declarations.get(metadata.site);
                if (metadata.name != declared.name
                        || metadata.c_type != declared.c_type
                        || metadata.take_function
                            != declared.take_function) {
                    self.fail(
                        "cleanup registration metadata does not match "
                        + "its declaration in function "
                        + definition.name + ": " + metadata.name);
                }
                if (used.has(metadata.site)) {
                    self.fail(
                        "cleanup slot is registered more than once "
                        + "in function " + definition.name + ": "
                        + metadata.name);
                }
                IRFunction? adapter = self.adapterDefinition(
                    metadata.take_function);
                if (adapter == null || !adapter.is_static) {
                    self.fail(
                        "missing static cleanup adapter: "
                        + metadata.take_function);
                }
                used.put(metadata.site, true);
                registrationIndex = registrationIndex + 1;
            }
            Vector<int> sites = state.declarations.keys();
            int siteIndex = 0;
            while (siteIndex < sites.len) {
                int site = sites.get(siteIndex);
                if (!used.has(site)) {
                    self.fail(
                        "cleanup slot metadata has no registration: "
                        + state.declarations.get(site).name);
                }
                siteIndex = siteIndex + 1;
            }
            functionIndex = functionIndex + 1;
        }
    }
}
