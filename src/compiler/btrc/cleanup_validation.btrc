/* Function-local IR invariants for typed exception cleanup registrations. */

class CleanupValidationState {
    public string function_name;
    public Map<int, IRCleanupSlot> declarations;
    public Vector<IRNode> registrations;

    public CleanupValidationState(string functionName) {
        self.function_name = functionName;
        self.declarations = {};
        self.registrations = [];
    }
}

void cleanupValidationFail(string message) {
    fprintf(stderr, "internal compiler error: %s\n", message);
    abortGen();
}

void collectCleanupValidation(IRNode? node, CleanupValidationState state,
        Map<int, string> attached) {
    if (node == null) { return; }
    if (node.kind == IRK_VAR_DECL && node.cleanup_slot != null) {
        IRCleanupSlot metadata = node.cleanup_slot;
        if (metadata.name != node.name || metadata.c_type != node.c_type) {
            cleanupValidationFail(
                "cleanup metadata does not describe slot " + node.name);
        }
        if (!node.is_volatile) {
            cleanupValidationFail(
                "cleanup slot is not volatile: " + node.name);
        }
        if (attached.has(metadata.site)) {
            cleanupValidationFail(
                "cleanup metadata is attached more than once: " + node.name);
        }
        attached.put(metadata.site, state.function_name);
        state.declarations.put(metadata.site, metadata);
    }
    if (node.kind == IRK_CALL) {
        bool registration = node.callee == "__btrc_register_cleanup"
            || node.callee == "__btrc_register_direct_cleanup";
        if (registration) { state.registrations.push(node); }
        else if (node.cleanup_slot != null) {
            cleanupValidationFail(
                "cleanup metadata is attached to a non-registration call");
        }
    }

    collectCleanupValidation(node.left, state, attached);
    collectCleanupValidation(node.right, state, attached);
    collectCleanupValidation(node.operand, state, attached);
    collectCleanupValidation(node.expr, state, attached);
    collectCleanupValidation(node.obj, state, attached);
    collectCleanupValidation(node.index, state, attached);
    collectCleanupValidation(node.condition, state, attached);
    collectCleanupValidation(node.true_expr, state, attached);
    collectCleanupValidation(node.false_expr, state, attached);
    collectCleanupValidation(node.array_size, state, attached);
    collectCleanupValidation(node.init, state, attached);
    collectCleanupValidation(node.value, state, attached);
    collectCleanupValidation(node.target, state, attached);
    collectCleanupValidation(node.then_block, state, attached);
    collectCleanupValidation(node.else_block, state, attached);
    collectCleanupValidation(node.body, state, attached);
    collectCleanupValidation(node.update, state, attached);
    collectCleanupValidation(node.result, state, attached);
    int index = 0;
    while (index < node.args.len) {
        collectCleanupValidation(node.args.get(index), state, attached);
        index = index + 1;
    }
    index = 0;
    while (index < node.stmts.len) {
        collectCleanupValidation(node.stmts.get(index), state, attached);
        index = index + 1;
    }
}

IRFunction? cleanupAdapterDefinition(IRModule module, string name) {
    int index = 0;
    while (index < module.functions.len) {
        IRFunction definition = module.functions.get(index);
        if (definition.name == name) { return definition; }
        index = index + 1;
    }
    return null;
}

IRCleanupSlot validateCleanupRegistration(IRNode call) {
    int arity = 4;
    if (call.callee == "__btrc_register_direct_cleanup") { arity = 3; }
    if (call.helper_ref != call.callee || call.args.len != arity
            || call.cleanup_slot == null) {
        cleanupValidationFail("malformed typed cleanup registration");
    }
    IRCleanupSlot metadata = call.cleanup_slot;
    IRNode address = call.args.get(0);
    if (address.kind != IRK_CAST || address.target_type != "void*"
            || address.expr == null || address.expr.kind != IRK_ADDRESS_OF
            || address.expr.expr == null
            || address.expr.expr.kind != IRK_VAR
            || address.expr.expr.name != metadata.name) {
        cleanupValidationFail(
            "cleanup slot must use an opaque address: " + metadata.name);
    }
    IRNode take = call.args.get(1);
    if (take.kind != IRK_FUNCTION_REF
            || take.name != metadata.take_function) {
        cleanupValidationFail(
            "cleanup slot has the wrong take adapter: " + metadata.name);
    }
    return metadata;
}

void validateCleanupSlots(IRModule module) {
    Map<int, string> attached = {};
    int functionIndex = 0;
    while (functionIndex < module.functions.len) {
        IRFunction definition = module.functions.get(functionIndex);
        CleanupValidationState state =
            CleanupValidationState(definition.name);
        collectCleanupValidation(definition.body, state, attached);
        Map<int, bool> used = {};
        int registrationIndex = 0;
        while (registrationIndex < state.registrations.len) {
            IRCleanupSlot metadata = validateCleanupRegistration(
                state.registrations.get(registrationIndex));
            if (!state.declarations.has(metadata.site)) {
                cleanupValidationFail(
                    "cleanup registration has no declaration in function "
                    + definition.name + ": " + metadata.name);
            }
            IRFunction? adapter = cleanupAdapterDefinition(
                module, metadata.take_function);
            if (adapter == null || !adapter.is_static) {
                cleanupValidationFail(
                    "missing static cleanup adapter: "
                    + metadata.take_function);
            }
            used.put(metadata.site, true);
            registrationIndex = registrationIndex + 1;
        }
        Vector<int> sites = state.declarations.keys();
        int siteIndex = 0;
        while (siteIndex < sites.len) {
            int site = sites.get(siteIndex);
            if (!used.has(site)) {
                cleanupValidationFail(
                    "cleanup slot metadata has no registration: "
                    + state.declarations.get(site).name);
            }
            siteIndex = siteIndex + 1;
        }
        functionIndex = functionIndex + 1;
    }
}
