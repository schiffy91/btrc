	public Vector<string> macroNames() {
		Vector<string>? memo = self.macroNamesMemo;
		if (memo != null) { return memo; }
		Vector<string> built = [];
		self.pushMacroNames0(built);
		self.pushMacroNames1(built);
		self.pushMacroNames2(built);
		self.pushMacroNames3(built);
		self.pushMacroNames4(built);
		self.pushMacroNames5(built);
		self.pushMacroNames6(built);
		self.pushMacroNames7(built);
		self.pushMacroNames8(built);
		self.pushMacroNames9(built);
		self.pushMacroNames10(built);
		self.macroNamesMemo = built;
		return built;
	}

