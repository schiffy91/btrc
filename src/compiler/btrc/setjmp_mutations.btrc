/* Exact storage-identity writes for C11 setjmp qualification. */

Map<string, bool> copyNameSet(Map<string, bool> source) {
    Map<string, bool> result = {};
    Vector<string> names = source.keys();
    int index = 0;
    while (index < names.len) {
        result.put(names.get(index), true);
        index = index + 1;
    }
    return result;
}

string setjmpStorageKey(SetjmpStorage storage) {
    return Strings.fromInt(storage.identity);
}

void recordSetjmpNodeWrites(IRNode? node, Map<string, bool> bound,
        Map<string, bool> modified, SetjmpCallEffects effects) {
    Vector<SetjmpOrigin> writes = effects.flow.writesFor(node);
    int index = 0;
    while (index < writes.len) {
        SetjmpOrigin origin = writes.get(index);
        string key = setjmpStorageKey(origin.storage);
        if (origin.depth == 0 && !bound.has(key)) {
            modified.put(key, true);
        }
        index = index + 1;
    }
}

void collectSetjmpExpressionMutations(IRNode? node,
        Map<string, bool> bound, Map<string, bool> modified,
        SetjmpCallEffects effects) {
    if (node == null) { return; }
    recordSetjmpNodeWrites(node, bound, modified, effects);
    if (node.kind == IRK_SIZEOF) { return; }
    if (node.kind == IRK_STMT_EXPR) {
        Map<string, bool> local = copyNameSet(bound);
        collectSetjmpMutationSequence(
            node.stmts, local, modified, effects);
        collectSetjmpExpressionMutations(
            node.result, local, modified, effects);
        return;
    }
    collectSetjmpExpressionMutations(node.left, bound, modified, effects);
    collectSetjmpExpressionMutations(node.right, bound, modified, effects);
    collectSetjmpExpressionMutations(node.operand, bound, modified, effects);
    collectSetjmpExpressionMutations(node.expr, bound, modified, effects);
    collectSetjmpExpressionMutations(node.obj, bound, modified, effects);
    collectSetjmpExpressionMutations(node.index, bound, modified, effects);
    collectSetjmpExpressionMutations(node.condition, bound, modified, effects);
    collectSetjmpExpressionMutations(node.true_expr, bound, modified, effects);
    collectSetjmpExpressionMutations(node.false_expr, bound, modified, effects);
    collectSetjmpExpressionMutations(node.init, bound, modified, effects);
    collectSetjmpExpressionMutations(node.value, bound, modified, effects);
    collectSetjmpExpressionMutations(node.target, bound, modified, effects);
    collectSetjmpExpressionMutations(node.update, bound, modified, effects);
    collectSetjmpExpressionMutations(node.result, bound, modified, effects);
    collectSetjmpExpressionMutations(node.array_size, bound, modified, effects);
    int index = 0;
    while (index < node.args.len) {
        collectSetjmpExpressionMutations(
            node.args.get(index), bound, modified, effects);
        index = index + 1;
    }
}

void collectSetjmpMutationBlock(IRNode? block, Map<string, bool> inherited,
        Map<string, bool> modified, SetjmpCallEffects effects) {
    if (block == null) { return; }
    Map<string, bool> bound = copyNameSet(inherited);
    collectSetjmpMutationSequence(block.stmts, bound, modified, effects);
}

void collectSetjmpMutationSequence(Vector<IRNode> statements,
        Map<string, bool> bound, Map<string, bool> modified,
        SetjmpCallEffects effects) {
    int index = 0;
    while (index < statements.len) {
        collectSetjmpStatementMutations(
            statements.get(index), bound, modified, effects);
        index = index + 1;
    }
}

void collectSetjmpStatementMutations(IRNode statement,
        Map<string, bool> bound, Map<string, bool> modified,
        SetjmpCallEffects effects) {
    recordSetjmpNodeWrites(statement, bound, modified, effects);
    if (statement.kind == IRK_VAR_DECL) {
        collectSetjmpExpressionMutations(
            statement.array_size, bound, modified, effects);
        SetjmpStorage? storage =
            setjmpDeclarationStorage(effects.flow, statement);
        if (storage != null) { bound.put(setjmpStorageKey(storage), true); }
        collectSetjmpExpressionMutations(
            statement.init, bound, modified, effects);
        return;
    }
    if (statement.kind == IRK_IF) {
        collectSetjmpExpressionMutations(
            statement.condition, bound, modified, effects);
        collectSetjmpMutationBlock(
            statement.then_block, bound, modified, effects);
        collectSetjmpMutationBlock(
            statement.else_block, bound, modified, effects);
        return;
    }
    if (statement.kind == IRK_WHILE || statement.kind == IRK_DO_WHILE) {
        collectSetjmpExpressionMutations(
            statement.condition, bound, modified, effects);
        collectSetjmpMutationBlock(
            statement.body, bound, modified, effects);
        return;
    }
    if (statement.kind == IRK_FOR) {
        Map<string, bool> local = copyNameSet(bound);
        if (statement.init != null && statement.init.kind == IRK_VAR_DECL) {
            collectSetjmpStatementMutations(
                statement.init, local, modified, effects);
        } else {
            collectSetjmpExpressionMutations(
                statement.init, local, modified, effects);
        }
        collectSetjmpExpressionMutations(
            statement.condition, local, modified, effects);
        collectSetjmpExpressionMutations(
            statement.update, local, modified, effects);
        collectSetjmpMutationBlock(
            statement.body, local, modified, effects);
        return;
    }
    if (statement.kind == IRK_SWITCH) {
        collectSetjmpExpressionMutations(
            statement.value, bound, modified, effects);
        int index = 0;
        while (index < statement.args.len) {
            IRNode caseNode = statement.args.get(index);
            Map<string, bool> local = copyNameSet(bound);
            collectSetjmpExpressionMutations(
                caseNode.value, local, modified, effects);
            collectSetjmpMutationSequence(
                caseNode.stmts, local, modified, effects);
            index = index + 1;
        }
        return;
    }
    if (statement.kind == IRK_BLOCK) {
        collectSetjmpMutationBlock(statement, bound, modified, effects);
        return;
    }
    collectSetjmpExpressionMutations(statement, bound, modified, effects);
}

Map<string, bool> setjmpMutatedNames(
        IRNode? block, SetjmpCallEffects effects) {
    Map<string, bool> modified = {};
    Map<string, bool> bound = {};
    collectSetjmpMutationBlock(block, bound, modified, effects);
    return modified;
}

Map<string, bool> setjmpMutatedSequenceAfter(Vector<IRNode> statements,
        int start, SetjmpCallEffects effects) {
    Map<string, bool> modified = {};
    Map<string, bool> bound = {};
    int index = start;
    while (index < statements.len) {
        collectSetjmpStatementMutations(
            statements.get(index), bound, modified, effects);
        index = index + 1;
    }
    return modified;
}

Map<string, bool> setjmpLoopMutatedNames(
        IRNode loop, SetjmpCallEffects effects) {
    IRNode block = IRNode();
    block.kind = IRK_BLOCK;
    if (loop.condition != null) {
        block.stmts.push(irExprStmt(loop.condition));
    }
    if (loop.update != null) { block.stmts.push(irExprStmt(loop.update)); }
    if (loop.body != null) { block.stmts.push(loop.body); }
    return setjmpMutatedNames(block, effects);
}

bool expressionContainsSetjmp(IRNode? node) {
    if (node == null) { return false; }
    if (node.kind == IRK_CALL && node.callee == "setjmp") { return true; }
    if (expressionContainsSetjmp(node.left)
            || expressionContainsSetjmp(node.right)
            || expressionContainsSetjmp(node.operand)
            || expressionContainsSetjmp(node.expr)
            || expressionContainsSetjmp(node.obj)
            || expressionContainsSetjmp(node.index)
            || expressionContainsSetjmp(node.condition)
            || expressionContainsSetjmp(node.true_expr)
            || expressionContainsSetjmp(node.false_expr)
            || expressionContainsSetjmp(node.init)
            || expressionContainsSetjmp(node.value)
            || expressionContainsSetjmp(node.target)
            || expressionContainsSetjmp(node.update)
            || expressionContainsSetjmp(node.result)
            || expressionContainsSetjmp(node.array_size)
            || expressionContainsSetjmp(node.then_block)
            || expressionContainsSetjmp(node.else_block)
            || expressionContainsSetjmp(node.body)) { return true; }
    int index = 0;
    while (index < node.args.len) {
        if (expressionContainsSetjmp(node.args.get(index))) { return true; }
        index = index + 1;
    }
    index = 0;
    while (index < node.stmts.len) {
        if (expressionContainsSetjmp(node.stmts.get(index))) { return true; }
        index = index + 1;
    }
    return false;
}
