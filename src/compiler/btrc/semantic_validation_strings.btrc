/* Argument contracts for the built-in scalar-string method surface. */

Node semanticStringParam(string name, string typeName) {
    Node parameter = Node();
    parameter.kind = NK_PARAM;
    parameter.name = name;
    parameter.type = makePrimType(typeName);
    return parameter;
}

bool semanticZeroArgStringMethod(string method) {
    return method == "len" || method == "byteLen" || method == "length"
        || method == "charLen" || method == "isEmpty"
        || method == "isBlank" || method == "isUpper"
        || method == "isLower" || method == "isAlnum"
        || method == "isAlnumStr" || method == "isDigit"
        || method == "isDigitStr" || method == "isAlpha"
        || method == "isAlphaStr" || method == "trim"
        || method == "lstrip" || method == "rstrip"
        || method == "toUpper" || method == "toLower"
        || method == "reverse" || method == "capitalize"
        || method == "title" || method == "swapCase"
        || method == "toInt" || method == "toFloat"
        || method == "toDouble" || method == "toLong"
        || method == "toBool";
}

bool semanticOneStringArgMethod(string method) {
    return method == "equals" || method == "contains"
        || method == "startsWith" || method == "endsWith"
        || method == "indexOf" || method == "lastIndexOf"
        || method == "count" || method == "removePrefix"
        || method == "removeSuffix" || method == "split";
}

void semanticValidateStringCall(Node call, SemanticValidationState state,
        Map<string, Node> vars) {
    string method = call.callee.field;
    if (stringMethodReturnType(method) == null) {
        semanticValidationFail(
            "Type 'string' has no method '" + method + "'", call);
    }
    Vector<Node> params = [];
    if (semanticOneStringArgMethod(method)) {
        params.push(semanticStringParam("value", "string"));
    } else if (method == "charAt" || method == "repeat"
            || method == "zfill") {
        params.push(semanticStringParam("value", "int"));
    } else if (method == "substring") {
        params.push(semanticStringParam("start", "int"));
        params.push(semanticStringParam("length", "int"));
    } else if (method == "find") {
        params.push(semanticStringParam("value", "string"));
        params.push(semanticStringParam("start", "int"));
    } else if (method == "replace") {
        params.push(semanticStringParam("old", "string"));
        params.push(semanticStringParam("replacement", "string"));
    } else if (method == "padLeft" || method == "padRight"
            || method == "center") {
        params.push(semanticStringParam("width", "int"));
        params.push(semanticStringParam("fill", "char"));
    } else if (!semanticZeroArgStringMethod(method)) {
        semanticValidationFail(
            "No semantic signature for string method '" + method + "'", call);
    }
    Map<string, Node> substitutions = {};
    semanticValidateSignature("string." + method, params, call,
        substitutions, state, vars);
}
