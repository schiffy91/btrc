/* Structured typed ARC release atoms shared by self-host ownership paths. */

class ManagedReleaseSlot {
    public IRNode target;
    public IRNode owner;
    public bool persistent;

    public ManagedReleaseSlot(IRNode target) {
        self.target = target;
        self.owner = irLiteral("NULL");
        self.persistent = false;
    }
}

ManagedReleaseSlot stabilizeManagedReleaseSlot(IRGen generator,
        Node expression, IRNode target, Map<string, Node> varTypes,
        Vector<IRNode> statements) {
    ManagedReleaseSlot result = ManagedReleaseSlot(target);
    Node? ownerType = null;
    IRNode ownerValue = irLiteral("NULL");
    int shape = 0;
    if (expression.kind == NK_FIELD_ACCESS_EXPR
            && target.kind == IRK_FIELD_ACCESS) {
        ownerType = generator.resolvedExpressionType(
            expression.obj, varTypes);
        ownerValue = target.obj;
        shape = 1;
    } else if (expression.kind == NK_INDEX_EXPR
            && expression.obj.kind == NK_FIELD_ACCESS_EXPR
            && target.kind == IRK_INDEX
            && target.obj.kind == IRK_FIELD_ACCESS) {
        ownerType = generator.resolvedExpressionType(
            expression.obj.obj, varTypes);
        ownerValue = target.obj.obj;
        shape = 2;
    }
    if (ownerType == null
            || !generator.managedValues.isClass(
                generator.resolveBodyType(ownerType))) {
        return result;
    }
    Node resolvedOwner = generator.resolveBodyType(ownerType);
    string ownerName = generator.freshTemp("__btrc_release_owner");
    statements.push(irVarDecl(
        typeToC(resolvedOwner, generator.analyzed),
        ownerName, ownerValue));
    result.owner = irVar(ownerName);
    result.persistent = true;
    if (shape == 1) {
        result.target = irFieldAccess(
            result.owner, target.field, target.arrow);
    } else {
        result.target = irIndex(
            irFieldAccess(result.owner,
                target.obj.field, target.obj.arrow),
            target.index);
    }
    return result;
}

IRNode managedArcDescriptor(IRGen generator, string emittedName) {
    if (emittedName
            == generator.managedValues.mutexRuntimeType()) {
        generator.useHelper("__btrc_mutex_arc_type");
        return irAddressOf(irVar("__btrc_mutex_arc_descriptor"));
    }
    Vector<string> fields = [];
    fields.push("visit");
    fields.push("destroy");
    fields.push("hook");
    fields.push("guard");
    fields.push("raise");
    Vector<IRNode> values = [];
    if (generator.cycles.emittedTypeNeedsVisitor(emittedName)) {
        values.push(irFunctionRef(
            generator.cycles.visitorName(emittedName)));
    } else {
        values.push(irLiteral("NULL"));
    }
    values.push(irFunctionRef(emittedName + "_destroy"));
    values.push(irLiteral("NULL"));
    values.push(irLiteral("NULL"));
    values.push(irLiteral("NULL"));
    return irAddressOf(irCompoundLiteral(
        "__btrc_arc_type", fields, values));
}

IRNode managedArcRelease(IRGen generator, IRNode value,
        string emittedName) {
    string helper = "__btrc_arc_release_acyclic";
    if (generator.cycles.runtimeTypeMayCycle(emittedName)) {
        helper = "__btrc_arc_release";
    }
    generator.useHelper(helper);
    Vector<IRNode> arguments = [];
    arguments.push(value);
    arguments.push(managedArcDescriptor(generator, emittedName));
    return irCall(helper, arguments);
}

IRNode managedArcRetain(IRGen generator, IRNode value) {
    generator.useHelper("__btrc_arc_retain");
    Vector<IRNode> arguments = [];
    arguments.push(value);
    return irCall("__btrc_arc_retain", arguments);
}

IRNode managedArcRetainEdge(
        IRGen generator, IRNode value, IRNode owner) {
    generator.useHelper("__btrc_arc_retain_edge");
    Vector<IRNode> arguments = [];
    arguments.push(value);
    arguments.push(owner);
    return irCall("__btrc_arc_retain_edge", arguments);
}

IRNode managedArcAdoptEdge(
        IRGen generator, IRNode value, IRNode owner) {
    generator.useHelper("__btrc_arc_adopt_edge");
    Vector<IRNode> arguments = [];
    arguments.push(value);
    arguments.push(owner);
    return irCall("__btrc_arc_adopt_edge", arguments);
}

IRNode managedArcUnlinkEdge(
        IRGen generator, IRNode value, IRNode owner) {
    generator.useHelper("__btrc_arc_unlink_edge");
    Vector<IRNode> arguments = [];
    arguments.push(value);
    arguments.push(owner);
    return irCall("__btrc_arc_unlink_edge", arguments);
}

IRNode managedArcReleaseEdge(IRGen generator, IRNode value,
        string emittedName, IRNode replacement) {
    generator.useHelper("__btrc_arc_release_edge");
    Vector<IRNode> arguments = [];
    arguments.push(value);
    arguments.push(managedArcDescriptor(generator, emittedName));
    arguments.push(replacement);
    return irCall("__btrc_arc_release_edge", arguments);
}

IRNode managedArcReplaceEdge(IRGen generator, IRNode slot,
        IRNode replacement, string emittedName, IRNode owner,
        string access, bool adopt) {
    generator.useHelper("__btrc_arc_replace_edge");
    Vector<IRNode> arguments = [];
    arguments.push(irCast("volatile void*", irAddressOf(slot)));
    arguments.push(irFunctionRef(access));
    arguments.push(replacement);
    arguments.push(owner);
    arguments.push(managedArcDescriptor(generator, emittedName));
    if (adopt) {
        arguments.push(irLiteral("1"));
    } else {
        arguments.push(irLiteral("0"));
    }
    return irCall("__btrc_arc_replace_edge", arguments);
}

IRNode managedArcDestroySlot(IRGen generator, IRNode slot, string access,
        string emittedName, IRNode owner, bool persistent) {
    string helper = "__btrc_arc_destroy_slot";
    if (persistent) { helper = "__btrc_arc_destroy_edge"; }
    generator.useHelper(helper);
    Vector<IRNode> arguments = [];
    arguments.push(irCast("volatile void*", slot));
    arguments.push(irFunctionRef(access));
    if (persistent) { arguments.push(owner); }
    arguments.push(managedArcDescriptor(generator, emittedName));
    return irCall(helper, arguments);
}

IRNode managedArcFlush(IRGen generator) {
    generator.useHelper("__btrc_flush_cycles");
    Vector<IRNode> arguments = [];
    return irCall("__btrc_flush_cycles", arguments);
}

IRNode managedArcPoll(IRGen generator) {
    generator.useHelper("__btrc_poll_cycles");
    /* The program-exit boundary is installed after reachability DCE. */
    generator.useHelper("__btrc_flush_cycles");
    Vector<IRNode> arguments = [];
    return irCall("__btrc_poll_cycles", arguments);
}

IRNode managedArcInvalidate(IRGen generator, IRNode value) {
    generator.useHelper("__btrc_arc_invalidate");
    Vector<IRNode> arguments = [];
    arguments.push(value);
    return irCall("__btrc_arc_invalidate", arguments);
}
