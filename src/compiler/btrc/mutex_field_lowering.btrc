/* Owner-aware lowering atoms for class-resident Mutex<T> handles. */

Node? mutexPayloadType(Analyzed analyzed, Node? typeExpr) {
    if (typeExpr == null) { return null; }
    Node? resolved = resolveTypedefType(
        typeExpr, analyzed.typedefTable);
    if (resolved == null || resolved.is_array
            || resolved.pointer_depth != 0
            || resolved.base != "Mutex"
            || resolved.generic_args.len != 1) {
        return null;
    }
    return resolved.generic_args.get(0);
}

bool mutexPayloadIsManagedClass(
        Analyzed analyzed, Node? typeExpr) {
    Node? payload = mutexPayloadType(analyzed, typeExpr);
    return payload != null
        && !payload.is_array
        && payload.pointer_depth <= 1
        && (analyzed.isClass(payload.base)
            || (payload.generic_args.len > 0
                && analyzed.isGenericClass(payload.base)));
}

IRNode consumeMutexHandle(IRGen generator, IRNode object) {
    bool addressable = object.kind == IRK_VAR
        || object.kind == IRK_FIELD_ACCESS
        || object.kind == IRK_INDEX
        || object.kind == IRK_DEREF;
    if (!addressable) { return object; }
    generator.useHelper("__btrc_mutex_val_take");
    Vector<IRNode> arguments = [];
    arguments.push(irAddressOf(object));
    return irCall("__btrc_mutex_val_take", arguments);
}

IRNode replaceMutexField(IRGen generator, IRNode slot,
        IRNode replacement, IRNode owner) {
    generator.useHelper("__btrc_mutex_val_replace_owner");
    Vector<IRNode> arguments = [];
    arguments.push(irAddressOf(slot));
    arguments.push(replacement);
    arguments.push(owner);
    return irCall("__btrc_mutex_val_replace_owner", arguments);
}

IRNode destroyMutexField(IRGen generator, IRNode field) {
    generator.useHelper("__btrc_mutex_val_destroy");
    Vector<IRNode> arguments = [];
    arguments.push(consumeMutexHandle(generator, field));
    return irCall("__btrc_mutex_val_destroy", arguments);
}

IRNode lowerMutexFieldAssignment(IRGen generator, Node node,
        Node ownerType, Node fieldType, string storage,
        Map<string, Node> varTypes) {
    if (node.op != "=") {
        fprintf(stderr,
            "error: Mutex fields do not support compound assignment\n");
        abortGen();
    }
    string ownerName = generator.freshTemp(
        "__btrc_mutex_owner");
    string valueName = generator.freshTemp(
        "__btrc_mutex_field");
    IRNode ownerDeclaration = irVarDecl(
        typeToC(ownerType, generator.analyzed), ownerName, null);
    IRNode valueDeclaration = irVarDecl(
        typeToC(fieldType, generator.analyzed), valueName, null);
    generator.funcVarDecls.push(ownerDeclaration);
    generator.funcVarDecls.push(valueDeclaration);
    IRNode owner = irVar(ownerName);
    IRNode value = irVar(valueName);
    IRNode field = irFieldAccess(owner, storage, true);
    IRNode loweredValue = generator.lowerAssignedValue(
        node.value_node, fieldType, varTypes);
    loweredValue = consumeMutexHandle(generator, loweredValue);

    Vector<IRNode> declarations = [];
    declarations.push(ownerDeclaration);
    declarations.push(valueDeclaration);
    Vector<IRNode> sequence = [];
    sequence.push(irBinOp(owner, "=",
        generator.lowerExpr(node.target.obj, varTypes)));
    sequence.push(irBinOp(value, "=", loweredValue));
    sequence.push(replaceMutexField(
        generator, field, value, owner));
    sequence.push(field);
    return irStmtExpr(declarations, irCommaExpr(sequence));
}

bool appendMutexCycleFieldVisit(IRGen generator, Node typeExpr,
        IRNode field, Vector<IRNode> output) {
    if (!mutexPayloadIsManagedClass(
            generator.analyzed, typeExpr)) {
        return false;
    }
    generator.useHelper("__btrc_mutex_val_visit");
    Vector<IRNode> arguments = [];
    arguments.push(field);
    arguments.push(irVar("fn"));
    arguments.push(irVar("context"));
    output.push(irExprStmt(irCall(
        "__btrc_mutex_val_visit", arguments)));
    return true;
}
