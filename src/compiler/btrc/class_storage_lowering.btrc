/* Structured physical fields shared by ordinary and generic class layouts. */

class ClassStorageLowerer {
    class IRStructField field(
            IRGen generator, Node member, string storage) {
        Map<string, Node> noTypeMap = {};
        return ClassStorageLowerer.resolvedField(
            generator, member.type, storage, false, noTypeMap);
    }

    class IRStructField genericField(IRGen generator, Node member,
            string storage, Map<string, Node> typeMap) {
        Node fieldType = resolveGenericType(
            member.type, typeMap, generator.analyzed);
        return ClassStorageLowerer.resolvedField(
            generator, fieldType, storage, true, typeMap);
    }

    class IRStructField resolvedField(IRGen generator, Node fieldType,
            string storage, bool generic, Map<string, Node> typeMap) {
        /* typeToC registers nested callback typedefs. Render only the resolved
         * field shape so a generic placeholder cannot escape into C. */
        IRStructField field = IRStructField(
            typeToC(fieldType, generator.analyzed), storage);
        field.is_volatile = fieldType.is_volatile;
        field.effective_is_volatile = typeEffectiveOuterVolatile(
            fieldType, generator.analyzed.typedefTable);
        if (fieldType.is_array && fieldType.array_size != null) {
            Node elementType = typeWithoutOuterArray(fieldType);
            field.c_type = typeToC(elementType, generator.analyzed);
            Map<string, Node> noVariables = {};
            bool savedGeneric = generator.inGenericMethod;
            Map<string, Node> savedTypeMap = generator.activeTypeMap;
            if (generic) {
                generator.inGenericMethod = true;
                generator.activeTypeMap = typeMap;
            }
            field.array_size = generator.lowerExpr(
                fieldType.array_size, noVariables);
            generator.inGenericMethod = savedGeneric;
            generator.activeTypeMap = savedTypeMap;
        }
        return field;
    }
}
