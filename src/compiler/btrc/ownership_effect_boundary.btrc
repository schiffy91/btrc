/* Single-evaluation ownership boundary for synthetic effect-only calls. */

IRNode lowerOwnedEffectCall(IRGen generator, string callee,
        Vector<IRNode> prefixArguments, Vector<Node> operands,
        Vector<Node> expectedTypes, Map<string, Node> varTypes) {
    bool needsBoundary = false;
    int index = 0;
    while (index < operands.len) {
        Node? expectedType = null;
        if (index < expectedTypes.len) {
            expectedType = expectedTypes.get(index);
        }
        Node operand = operands.get(index);
        Node? sourceType = generator.resolvedExpressionType(
            operand, varTypes);
        if (irContextualUnconsumedOwnedResult(
                generator, operand, expectedType, varTypes)
                || requiresTargetStringConversion(
                    generator, expectedType, sourceType)) {
            needsBoundary = true;
        }
        int laterIndex = index + 1;
        while (laterIndex < operands.len) {
            Node later = operands.get(laterIndex);
            bool operandEffect = ownershipExpressionHasEffect(
                generator, operand, varTypes);
            bool laterEffect = ownershipExpressionHasEffect(
                generator, later, varTypes);
            if ((operandEffect
                    && !ownershipExpressionReorderInert(
                        generator, later))
                    || (laterEffect
                        && !ownershipExpressionReorderInert(
                            generator, operand))) {
                needsBoundary = true;
            }
            laterIndex = laterIndex + 1;
        }
        index = index + 1;
    }

    OwnershipBoundary boundary = OwnershipBoundary();
    if (needsBoundary) {
        index = 0;
        while (index < operands.len) {
            Node operand = operands.get(index);
            Node? expectedType = null;
            if (index < expectedTypes.len) {
                expectedType = expectedTypes.get(index);
            }
            PreparedValue prepared = prepareCallTargetValue(
                generator, operand, expectedType, varTypes);
            ownershipRequireType(
                prepared.effectiveType, operand);
            Node effectiveType = prepared.effectiveType;
            bool laterEffect = false;
            int laterIndex = index + 1;
            while (laterIndex < operands.len) {
                if (ownershipExpressionHasEffect(
                        generator, operands.get(laterIndex), varTypes)) {
                    laterEffect = true;
                }
                laterIndex = laterIndex + 1;
            }
            bool pinBorrowed = laterEffect
                && !prepared.owned
                && generator.managedValues.isManaged(
                    generator.resolveBodyType(effectiveType));
            boundary.addLoweredOperand(generator, operand,
                effectiveType, prepared.value,
                prepared.owned, pinBorrowed);
            index = index + 1;
        }
    }

    Vector<IRNode> arguments = [];
    index = 0;
    while (index < prefixArguments.len) {
        arguments.push(prefixArguments.get(index));
        index = index + 1;
    }
    index = 0;
    while (index < operands.len) {
        if (needsBoundary) {
            arguments.push(generator.lowerExpr(
                operands.get(index), varTypes));
        } else if (index < expectedTypes.len) {
            Node operand = operands.get(index);
            Node targetType = expectedTypes.get(index);
            IRNode value = generator.lowerAssignedValueRaw(
                operand, targetType, varTypes);
            arguments.push(generator.upcastClassPointer(
                targetType,
                generator.resolvedExpressionType(operand, varTypes),
                value));
        } else {
            arguments.push(generator.lowerExpr(operands.get(index), varTypes));
        }
        index = index + 1;
    }
    IRNode call = irCall(callee, arguments);
    if (!needsBoundary) { return call; }
    boundary.restore(generator);
    return boundary.finish(
        generator, call, makePrimType("void"), false);
}

IRNode finishOwnedConstruction(IRGen generator, IRNode declaration,
        string runtimeType, Vector<IRNode> declarations,
        Vector<IRNode> construction) {
    IRNode value = irVar(declaration.name);
    if (!generator.programHasExceptions) {
        construction.push(value);
        return irStmtExpr(
            declarations, irCommaExpr(construction));
    }

    OwnershipBoundary cleanup = OwnershipBoundary();
    cleanup.registerCleanup(
        generator, declaration, declaration.name, runtimeType);
    Vector<IRNode> sequence = [];
    int prefixIndex = 0;
    while (prefixIndex < cleanup.prefix.len) {
        sequence.push(cleanup.prefix.get(prefixIndex));
        prefixIndex = prefixIndex + 1;
    }
    int constructionIndex = 0;
    while (constructionIndex < construction.len) {
        sequence.push(construction.get(constructionIndex));
        constructionIndex = constructionIndex + 1;
    }

    string handoffName = generator.freshTemp(
        "__btrc_construction_handoff");
    IRNode handoffDeclaration = irVarDecl(
        declaration.c_type, handoffName, irLiteral("NULL"));
    declarations.push(handoffDeclaration);
    generator.funcVarDecls.push(handoffDeclaration);
    IRNode handoff = irVar(handoffName);
    sequence.push(irBinOp(handoff, "=", value));
    sequence.push(irBinOp(value, "=", irLiteral("NULL")));
    sequence.push(handoff);
    return irStmtExpr(declarations, irCommaExpr(sequence));
}
