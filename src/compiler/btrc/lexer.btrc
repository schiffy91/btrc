/* Stage 1 — lexer.
 *
 * Faithful port of src/compiler/python/lexer.py + lexer_literals.py. Grammar-
 * driven (keyword/operator/annotation tables come from GrammarInfo, never
 * hardcoded). Emits a Token[] whose --emit-tokens rendering is byte-identical
 * to the Python compiler.
 *
 * btrc gotcha: string.substring(start, COUNT) takes a length, not an end index;
 * every Python `source[a:b]` becomes `source.substring(a, b - a)`.
 */

#include "lexer_preprocessor.btrc"

class Lexer {
    public string source;
    public int sourceLen;
    public GrammarInfo grammar;
    public int pos;
    public int line;
    public int col;
    public Vector<Token> tokens;
    public bool failed;
    public bool complete;
    public string diagnostic;

    public Lexer(string source, GrammarInfo grammar) {
        self.source = source;
        self.sourceLen = source.length();
        self.grammar = grammar;
        self.pos = 0;
        self.line = 1;
        self.col = 1;
        self.tokens = [];
        self.failed = false;
        self.complete = false;
        self.diagnostic = "";
    }

    public Vector<Token> tokenize() {
        if (self.complete) { return self.tokens; }
        while (!self.atEnd() && !self.failed) {
            self.skipWsAndComments();
            if (self.atEnd() || self.failed) { break; }
            char c = self.peek(0);
            if (c == '#' && self.atLineStart()) {
                self.readPreprocessor();
            } else if (c == '@') {
                self.readAnnotation();
            } else if (c == '"') {
                self.readString();
            } else if (c == '\'') {
                self.readChar();
            } else if (Strings.isDigit(c)) {
                self.readNumber();
            } else if (Strings.isAlpha(c) || c == '_') {
                self.readIdentifier();
            } else {
                self.readOperator();
            }
        }
        /* A failed scan must never expose its valid prefix as a usable token
         * stream. Keep one EOF sentinel so defensive consumers remain safe. */
        if (self.failed) { self.tokens = []; }
        self.tokens.push(Token("EOF", "", self.line, self.col));
        self.complete = true;
        return self.tokens;
    }

    public void failLex(string message, int line, int col) {
        if (self.failed) { return; }
        self.failed = true;
        self.diagnostic = f"{message} at {line}:{col}";
    }

    public bool atEnd() {
        return self.pos >= self.sourceLen;
    }

    public char peek(int off) {
        int p = self.pos + off;
        if (p < 0 || p >= self.sourceLen) { return '\0'; }
        return self.source[p];
    }

    public char advance() {
        if (self.atEnd()) { return '\0'; }
        char c = self.source[self.pos];
        if (c == '\n') {
            self.line = self.line + 1;
            self.col = 1;
        } else {
            self.col = self.col + 1;
        }
        self.pos = self.pos + 1;
        return c;
    }

    public bool atLineStart() {
        int p = self.pos - 1;
        while (p >= 0) {
            char c = self.source[p];
            if (c == '\n') { return true; }
            if (c != ' ' && c != '\t' && c != '\f'
                    && c != '\v' && c != '\r') { return false; }
            p = p - 1;
        }
        return true;
    }

    public void skipWsAndComments() {
        bool again = true;
        while (again) {
            again = false;
            while (!self.atEnd()) {
                char c = self.peek(0);
                if (c == ' ' || c == '\t' || c == '\n' || c == '\r'
                        || c == '\f' || c == '\v') {
                    self.advance();
                    again = true;
                } else {
                    break;
                }
            }
            if (self.peek(0) == '/' && self.peek(1) == '/') {
                while (!self.atEnd() && self.peek(0) != '\n') { self.advance(); }
                again = true;
            } else if (self.peek(0) == '/' && self.peek(1) == '*') {
                int line = self.line;
                int col = self.col;
                self.advance();
                self.advance();
                while (!self.atEnd() && !(self.peek(0) == '*' && self.peek(1) == '/')) {
                    self.advance();
                }
                if (self.atEnd()) {
                    self.failLex("Unterminated block comment", line, col);
                    return;
                }
                self.advance();
                self.advance();
                again = true;
            }
        }
    }

    public void readPreprocessor() {
        int startPos = self.pos;
        int line = self.line;
        int col = self.col;
        while (!self.atEnd()) {
            int spliceWidth = lexerPreprocessorSpliceWidth(
                self.source, self.pos);
            if (spliceWidth > 0) {
                int consumed = 0;
                while (consumed < spliceWidth) {
                    self.advance(); consumed = consumed + 1;
                }
            } else if (self.peek(0) == '\n') {
                break;
            } else {
                self.advance();
            }
        }
        string value = self.source.substring(startPos, self.pos - startPos);
        self.tokens.push(Token("PREPROCESSOR", value, line, col));
    }

    public void readAnnotation() {
        int line = self.line;
        int col = self.col;
        self.advance();  // '@'
        int startPos = self.pos;
        while (!self.atEnd() && (Strings.isAlnum(self.peek(0)) || self.peek(0) == '_')) {
            self.advance();
        }
        string name = self.source.substring(startPos, self.pos - startPos);
        if (self.grammar.annotationToToken.has(name)) {
            self.tokens.push(Token(self.grammar.annotationToToken.get(name), "@" + name, line, col));
        } else {
            self.failLex("Unknown annotation '@" + name + "'", line, col);
        }
    }

    public void readIdentifier() {
        int line = self.line;
        int col = self.col;
        int startPos = self.pos;
        while (!self.atEnd() && (Strings.isAlnum(self.peek(0)) || self.peek(0) == '_')) {
            self.advance();
        }
        string value = self.source.substring(startPos, self.pos - startPos);
        if (value == "f" && self.peek(0) == '"') {
            self.readFstring(line, col);
            return;
        }
        string type = "IDENT";
        if (self.grammar.keywordToToken.has(value)) {
            type = self.grammar.keywordToToken.get(value);
        }
        self.tokens.push(Token(type, value, line, col));
        if (type == "IMPORT") {
            self.maybeReadImportPath();
        }
    }

    public void maybeReadImportPath() {
        int savePos = self.pos;
        int saveLine = self.line;
        int saveCol = self.col;
        while (!self.atEnd() && (self.peek(0) == ' ' || self.peek(0) == '\t')) {
            self.advance();
        }
        char c = self.peek(0);
        if (c != '.' && c != '/' && c != '~') {
            self.pos = savePos;
            self.line = saveLine;
            self.col = saveCol;
            return;
        }
        int line = self.line;
        int col = self.col;
        int startPos = self.pos;
        while (!self.atEnd() && self.peek(0) != ';' && self.peek(0) != '\n') {
            self.advance();
        }
        string raw = self.source.substring(startPos, self.pos - startPos);
        string value = rtrim(raw);
        self.tokens.push(Token("PATH_SPEC", value, line, col));
    }

    public void readNumber() {
        lexerReadNumber(self);
    }

    public void readString() {
        lexerReadString(self);
    }

    public void readChar() {
        lexerReadChar(self);
    }

    public void readFstring(int line, int col) {
        lexerReadFstring(self, line, col);
    }

    public void readOperator() {
        int line = self.line;
        int col = self.col;
        int i = 0;
        int n = self.grammar.operators.len;
        while (i < n) {
            string op = self.grammar.operators.get(i);
            int oplen = op.length();
            bool matches = self.pos + oplen <= self.sourceLen;
            int compared = 0;
            while (matches && compared < oplen) {
                if (self.source[self.pos + compared] != op[compared]) {
                    matches = false;
                }
                compared = compared + 1;
            }
            if (matches) {
                int k = 0;
                while (k < oplen) { self.advance(); k = k + 1; }
                self.tokens.push(Token(self.grammar.opToToken.get(op), op, line, col));
                return;
            }
            i = i + 1;
        }
        int unexpected = (int)self.peek(0);
        if (unexpected < 0 || unexpected > 127) {
            self.failLex("Unexpected non-ASCII character", line, col);
            return;
        }
        self.failLex("Unexpected character '" + chr(self.peek(0)) + "'", line, col);
    }
}

string rtrim(string s) {
    int end = s.length();
    while (end > 0) {
        char c = s[end - 1];
        if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
            end = end - 1;
        } else {
            break;
        }
    }
    return s.substring(0, end);
}

#include "lexer_literal_rules.btrc"
#include "lexer_literals.btrc"
