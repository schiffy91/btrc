/* Stage 1 — lexer.
 *
 * Faithful port of src/compiler/python/lexer.py + lexer_literals.py. Grammar-
 * driven (keyword/operator/annotation tables come from GrammarInfo, never
 * hardcoded). Emits a Token[] whose --emit-tokens rendering is byte-identical
 * to the Python compiler.
 *
 * btrc gotcha: string.substring(start, COUNT) takes a length, not an end index;
 * every Python `source[a:b]` becomes `source.substring(a, b - a)`.
 */

bool isHexDigit(char c) {
    return Strings.isDigit(c)
        || (c >= 'a' && c <= 'f')
        || (c >= 'A' && c <= 'F');
}

class Lexer {
    public string source;
    public GrammarInfo grammar;
    public int pos;
    public int line;
    public int col;
    public Vector<Token> tokens;

    public Lexer(string source, GrammarInfo grammar) {
        self.source = source;
        self.grammar = grammar;
        self.pos = 0;
        self.line = 1;
        self.col = 1;
        self.tokens = [];
    }

    public Vector<Token> tokenize() {
        while (!self.atEnd()) {
            self.skipWsAndComments();
            if (self.atEnd()) { break; }
            char c = self.peek(0);
            if (c == '#' && self.atLineStart()) {
                self.readPreprocessor();
            } else if (c == '@') {
                self.readAnnotation();
            } else if (c == '"') {
                self.readString();
            } else if (c == '\'') {
                self.readChar();
            } else if (Strings.isDigit(c)) {
                self.readNumber();
            } else if (Strings.isAlpha(c) || c == '_') {
                self.readIdentifier();
            } else {
                self.readOperator();
            }
        }
        self.tokens.push(Token("EOF", "", self.line, self.col));
        return self.tokens;
    }

    public bool atEnd() {
        return self.pos >= self.source.length();
    }

    public char peek(int off) {
        int p = self.pos + off;
        if (p < 0 || p >= self.source.length()) { return '\0'; }
        return self.source[p];
    }

    public char advance() {
        char c = self.source[self.pos];
        if (c == '\n') {
            self.line = self.line + 1;
            self.col = 1;
        } else {
            self.col = self.col + 1;
        }
        self.pos = self.pos + 1;
        return c;
    }

    public bool atLineStart() {
        int p = self.pos - 1;
        while (p >= 0) {
            char c = self.source[p];
            if (c == '\n') { return true; }
            if (c != ' ' && c != '\t') { return false; }
            p = p - 1;
        }
        return true;
    }

    public void skipWsAndComments() {
        bool again = true;
        while (again) {
            again = false;
            while (!self.atEnd()) {
                char c = self.peek(0);
                if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
                    self.advance();
                    again = true;
                } else {
                    break;
                }
            }
            if (self.peek(0) == '/' && self.peek(1) == '/') {
                while (!self.atEnd() && self.peek(0) != '\n') { self.advance(); }
                again = true;
            } else if (self.peek(0) == '/' && self.peek(1) == '*') {
                self.advance();
                self.advance();
                while (!self.atEnd() && !(self.peek(0) == '*' && self.peek(1) == '/')) {
                    self.advance();
                }
                self.advance();
                self.advance();
                again = true;
            }
        }
    }

    public void readPreprocessor() {
        int startPos = self.pos;
        int line = self.line;
        int col = self.col;
        while (!self.atEnd() && self.peek(0) != '\n') {
            if (self.peek(0) == '\\' && self.peek(1) == '\n') {
                self.advance();
                self.advance();
            } else {
                self.advance();
            }
        }
        string value = self.source.substring(startPos, self.pos - startPos);
        self.tokens.push(Token("PREPROCESSOR", value, line, col));
    }

    public void readAnnotation() {
        int line = self.line;
        int col = self.col;
        self.advance();  // '@'
        int startPos = self.pos;
        while (!self.atEnd() && (Strings.isAlnum(self.peek(0)) || self.peek(0) == '_')) {
            self.advance();
        }
        string name = self.source.substring(startPos, self.pos - startPos);
        if (self.grammar.annotationToToken.has(name)) {
            self.tokens.push(Token(self.grammar.annotationToToken.get(name), "@" + name, line, col));
        } else {
            self.tokens.push(Token("IDENT", "@" + name, line, col));
        }
    }

    public void readIdentifier() {
        int line = self.line;
        int col = self.col;
        int startPos = self.pos;
        while (!self.atEnd() && (Strings.isAlnum(self.peek(0)) || self.peek(0) == '_')) {
            self.advance();
        }
        string value = self.source.substring(startPos, self.pos - startPos);
        if (value == "f" && self.peek(0) == '"') {
            self.readFstring(line, col);
            return;
        }
        string type = "IDENT";
        if (self.grammar.keywordToToken.has(value)) {
            type = self.grammar.keywordToToken.get(value);
        }
        self.tokens.push(Token(type, value, line, col));
        if (type == "IMPORT") {
            self.maybeReadImportPath();
        }
    }

    public void maybeReadImportPath() {
        int savePos = self.pos;
        int saveLine = self.line;
        int saveCol = self.col;
        while (!self.atEnd() && (self.peek(0) == ' ' || self.peek(0) == '\t')) {
            self.advance();
        }
        char c = self.peek(0);
        if (c != '.' && c != '/' && c != '~') {
            self.pos = savePos;
            self.line = saveLine;
            self.col = saveCol;
            return;
        }
        int line = self.line;
        int col = self.col;
        int startPos = self.pos;
        while (!self.atEnd() && self.peek(0) != ';' && self.peek(0) != '\n') {
            self.advance();
        }
        string raw = self.source.substring(startPos, self.pos - startPos);
        string value = rtrim(raw);
        self.tokens.push(Token("PATH_SPEC", value, line, col));
    }

    public void readNumber() {
        int line = self.line;
        int col = self.col;
        int startPos = self.pos;
        bool isFloat = false;
        if (self.peek(0) == '0' && (self.peek(1) == 'x' || self.peek(1) == 'X')) {
            self.advance();
            self.advance();
            while (!self.atEnd() && isHexDigit(self.peek(0))) { self.advance(); }
            self.consumeIntSuffix();
        } else if (self.peek(0) == '0' && (self.peek(1) == 'b' || self.peek(1) == 'B')) {
            self.advance();
            self.advance();
            while (!self.atEnd() && (self.peek(0) == '0' || self.peek(0) == '1')) { self.advance(); }
            self.consumeIntSuffix();
        } else if (self.peek(0) == '0' && (self.peek(1) == 'o' || self.peek(1) == 'O')) {
            self.advance();
            self.advance();
            while (!self.atEnd() && self.peek(0) >= '0' && self.peek(0) <= '7') { self.advance(); }
            self.consumeIntSuffix();
        } else {
            while (!self.atEnd() && Strings.isDigit(self.peek(0))) { self.advance(); }
            if (self.peek(0) == '.' && Strings.isDigit(self.peek(1))) {
                isFloat = true;
                self.advance();
                while (!self.atEnd() && Strings.isDigit(self.peek(0))) { self.advance(); }
            }
            if (self.peek(0) == 'e' || self.peek(0) == 'E') {
                isFloat = true;
                self.advance();
                if (self.peek(0) == '+' || self.peek(0) == '-') { self.advance(); }
                while (!self.atEnd() && Strings.isDigit(self.peek(0))) { self.advance(); }
            }
            if (self.peek(0) == 'f' || self.peek(0) == 'F') {
                isFloat = true;
                self.advance();
            } else {
                self.consumeIntSuffix();
            }
        }
        string value = self.source.substring(startPos, self.pos - startPos);
        string type = "INT_LIT";
        if (isFloat) { type = "FLOAT_LIT"; }
        self.tokens.push(Token(type, value, line, col));
    }

    public void consumeIntSuffix() {
        char c = self.peek(0);
        if (c == 'u' || c == 'U') {
            self.advance();
            if (self.peek(0) == 'l' || self.peek(0) == 'L') {
                self.advance();
                if (self.peek(0) == 'l' || self.peek(0) == 'L') { self.advance(); }
            }
        } else if (c == 'l' || c == 'L') {
            self.advance();
            if (self.peek(0) == 'l' || self.peek(0) == 'L') { self.advance(); }
            if (self.peek(0) == 'u' || self.peek(0) == 'U') { self.advance(); }
        }
    }

    public void readString() {
        int line = self.line;
        int col = self.col;
        if (self.peek(1) == '"' && self.peek(2) == '"') {
            self.readTripleString(line, col);
            return;
        }
        self.advance();  // opening "
        string content = "";
        while (!self.atEnd() && self.peek(0) != '"') {
            char c = self.peek(0);
            if (c == '\\') {
                content = content + chr(self.advance());
                if (!self.atEnd()) { content = content + chr(self.advance()); }
            } else {
                content = content + chr(self.advance());
            }
        }
        self.advance();  // closing "
        self.tokens.push(Token("STRING_LIT", "\"" + content + "\"", line, col));
    }

    public void readTripleString(int line, int col) {
        self.advance();
        self.advance();
        self.advance();
        string content = "";
        while (!self.atEnd() && !(self.peek(0) == '"' && self.peek(1) == '"' && self.peek(2) == '"')) {
            char c = self.peek(0);
            if (c == '\n') {
                content = content + "\\n";
                self.advance();
            } else if (c == '\r') {
                content = content + "\\n";
                self.advance();
                if (self.peek(0) == '\n') { self.advance(); }
            } else if (c == '\\') {
                content = content + chr(self.advance());
                if (!self.atEnd()) { content = content + chr(self.advance()); }
            } else {
                content = content + chr(self.advance());
            }
        }
        self.advance();
        self.advance();
        self.advance();
        self.tokens.push(Token("STRING_LIT", "\"" + content + "\"", line, col));
    }

    public void readChar() {
        int line = self.line;
        int col = self.col;
        self.advance();  // opening '
        string content = "";
        while (!self.atEnd() && self.peek(0) != '\'') {
            char c = self.peek(0);
            if (c == '\\') {
                content = content + chr(self.advance());
                if (!self.atEnd()) { content = content + chr(self.advance()); }
            } else {
                content = content + chr(self.advance());
            }
        }
        self.advance();  // closing '
        self.tokens.push(Token("CHAR_LIT", "'" + content + "'", line, col));
    }

    public void readFstring(int line, int col) {
        self.advance();  // opening "
        string content = "";
        int braceDepth = 0;
        while (!self.atEnd()) {
            char c = self.peek(0);
            if (c == '{') {
                if (braceDepth == 0 && self.peek(1) == '{') {
                    content = content + chr(self.advance());
                    content = content + chr(self.advance());
                } else {
                    braceDepth = braceDepth + 1;
                    content = content + chr(self.advance());
                }
            } else if (c == '}') {
                if (braceDepth == 0 && self.peek(1) == '}') {
                    content = content + chr(self.advance());
                    content = content + chr(self.advance());
                } else {
                    braceDepth = braceDepth - 1;
                    content = content + chr(self.advance());
                }
            } else if (c == '\\') {
                content = content + chr(self.advance());
                if (!self.atEnd()) { content = content + chr(self.advance()); }
            } else if (c == '"' && braceDepth == 0) {
                self.advance();
                break;
            } else {
                content = content + chr(self.advance());
            }
        }
        self.tokens.push(Token("FSTRING_LIT", content, line, col));
    }

    public void readOperator() {
        int line = self.line;
        int col = self.col;
        int i = 0;
        int n = self.grammar.operators.len;
        while (i < n) {
            string op = self.grammar.operators.get(i);
            int oplen = op.length();
            if (self.pos + oplen <= self.source.length()
                && self.source.substring(self.pos, oplen) == op) {
                int k = 0;
                while (k < oplen) { self.advance(); k = k + 1; }
                self.tokens.push(Token(self.grammar.opToToken.get(op), op, line, col));
                return;
            }
            i = i + 1;
        }
        // Unexpected character — emit nothing matchable; advance to avoid a loop.
        self.advance();
    }
}

string rtrim(string s) {
    int end = s.length();
    while (end > 0) {
        char c = s[end - 1];
        if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
            end = end - 1;
        } else {
            break;
        }
    }
    return s.substring(0, end);
}
