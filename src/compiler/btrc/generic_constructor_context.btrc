/* Target-directed generic constructor types for semantic child traversal. */

int genericConstructorParameterIndex(Vector<Node> parameters, string name) {
    int index = 0;
    while (index < parameters.len) {
        if (parameters.get(index).name == name) { return index; }
        index = index + 1;
    }
    return -1;
}

void contextualizeGenericConstructor(Node? expected, Node? expression,
        SemanticValidationState state, Map<string, Node> variables);

void contextualizeGenericElements(Node expected, Vector<Node> elements,
        SemanticValidationState state, Map<string, Node> variables) {
    int index = 0;
    while (index < elements.len) {
        contextualizeGenericConstructor(
            expected, elements.get(index), state, variables);
        index = index + 1;
    }
}

/* Preserve exact specializations before recursive validation reaches a child.
 * This also propagates expected aggregate element/field types so Empty<int>
 * remains recoverable when written as Empty() inside another value. */
void contextualizeGenericConstructor(Node? expected, Node? expression,
        SemanticValidationState state, Map<string, Node> variables) {
    if (expected == null || expression == null) { return; }
    Node? resolved = resolveOuterTypedefType(
        expected, state.analyzed.typedefTable);
    if (resolved == null) { return; }
    Node concrete = resolved;
    if (expression.kind == NK_TERNARY_EXPR) {
        contextualizeGenericConstructor(
            concrete, expression.true_expr, state, variables);
        contextualizeGenericConstructor(
            concrete, expression.false_expr, state, variables);
        return;
    }
    if (expression.kind == NK_MAP_LITERAL
            && concrete.base == "Map"
            && concrete.generic_args.len == 2) {
        int entryIndex = 0;
        while (entryIndex < expression.entries.len) {
            Node entry = expression.entries.get(entryIndex);
            contextualizeGenericConstructor(
                concrete.generic_args.get(0), entry.key, state, variables);
            contextualizeGenericConstructor(
                concrete.generic_args.get(1), entry.value_node,
                state, variables);
            entryIndex = entryIndex + 1;
        }
        return;
    }
    bool aggregate = expression.kind == NK_BRACE_INITIALIZER
        || expression.kind == NK_LIST_LITERAL
        || expression.kind == NK_TUPLE_LITERAL;
    if (aggregate) {
        if (concrete.is_array) {
            Node elementType = typeWithoutOuterArray(concrete);
            contextualizeGenericElements(
                elementType, expression.elements, state, variables);
            return;
        }
        if (concrete.base == "Tuple") {
            int tupleIndex = 0;
            while (tupleIndex < expression.elements.len
                    && tupleIndex < concrete.generic_args.len) {
                contextualizeGenericConstructor(
                    concrete.generic_args.get(tupleIndex),
                    expression.elements.get(tupleIndex), state, variables);
                tupleIndex = tupleIndex + 1;
            }
            return;
        }
        if (concrete.generic_args.len == 1
                && (concrete.base == "Array" || concrete.base == "List"
                    || concrete.base == "Set" || concrete.base == "Vector")) {
            contextualizeGenericElements(
                concrete.generic_args.get(0), expression.elements,
                state, variables);
            return;
        }
        if (state.analyzed.structTable.has(concrete.base)) {
            Node structure = state.analyzed.structTable.get(concrete.base);
            int fieldIndex = 0;
            while (fieldIndex < expression.elements.len
                    && fieldIndex < structure.fields.len) {
                contextualizeGenericConstructor(
                    structure.fields.get(fieldIndex).type,
                    expression.elements.get(fieldIndex), state, variables);
                fieldIndex = fieldIndex + 1;
            }
            return;
        }
    }
    if (expression.kind != NK_CALL_EXPR
            || expression.callee == null
            || expression.callee.kind != NK_IDENTIFIER
            || variables.has(expression.callee.name)) {
        return;
    }
    string name = expression.callee.name;
    if (!state.analyzed.isGenericClass(name)
            || concrete.base != name) { return; }
    Node declaration = state.analyzed.genericClassTable.get(name);
    if (concrete.generic_args.len != declaration.generic_params.len) {
        return;
    }
    state.analyzed.genericConstructorTypes.put(
        astNodeKey(expression), concrete);
    Node? constructor = state.analyzed.genericClassConstructor(name);
    if (constructor == null) { return; }
    Map<string, Node> substitutions = genericTypeMap(
        state.analyzed, concrete);
    contextualizeGenericCallParameters(
        constructor.params, substitutions, expression, state, variables);
}

void contextualizeGenericCallParameters(Vector<Node> parameters,
        Map<string, Node> substitutions, Node call,
        SemanticValidationState state, Map<string, Node> variables) {
    int positional = 0;
    int argumentIndex = 0;
    while (argumentIndex < call.args.len) {
        string name = argumentIndex < call.arg_names.len
            ? call.arg_names.get(argumentIndex) : "";
        int parameterIndex = name == "" ? positional
            : genericConstructorParameterIndex(parameters, name);
        if (name == "") { positional = positional + 1; }
        if (parameterIndex >= 0 && parameterIndex < parameters.len) {
            Node parameterType = parameters.get(parameterIndex).type;
            if (substitutions.len > 0) {
                parameterType = resolveGenericType(
                    parameterType, substitutions, state.analyzed);
            }
            contextualizeGenericConstructor(
                parameterType, call.args.get(argumentIndex), state, variables);
        }
        argumentIndex = argumentIndex + 1;
    }
}

void contextualizeCallableArguments(Node callable, Node call,
        SemanticValidationState state, Map<string, Node> variables) {
    int index = 0;
    while (index < call.args.len
            && index + 1 < callable.generic_args.len) {
        contextualizeGenericConstructor(
            callable.generic_args.get(index + 1), call.args.get(index),
            state, variables);
        index = index + 1;
    }
}

/* Pre-contextualize child calls before semanticValidateExpr descends into
 * them. Otherwise a target-directed Empty() would fail before its parent
 * function/method signature supplies Empty<int>. */
void contextualizeCallGenericConstructors(Node call,
        SemanticValidationState state, Map<string, Node> variables) {
    Node callee = call.callee;
    if (callee == null) { return; }
    Map<string, Node> substitutions = {};
    if (callee.kind == NK_IDENTIFIER) {
        if (variables.has(callee.name)) {
            Node? callable = directFunctionPointerType(
                variables.get(callee.name), state.analyzed);
            if (callable != null) {
                contextualizeCallableArguments(
                    callable, call, state, variables);
            }
            return;
        }
        Node? declaration = null;
        if (state.analyzed.funcTable.has(callee.name)
                && !state.analyzed.hostedCallKeys.has(astNodeKey(call))) {
            declaration = state.analyzed.funcTable.get(callee.name);
        } else if (state.analyzed.isClass(callee.name)) {
            declaration = state.analyzed.classConstructor(callee.name);
        } else if (state.analyzed.isGenericClass(callee.name)) {
            Node? instance = inferSpecializationType(
                call, state.analyzed, variables);
            if (instance != null && instance.generic_args.len > 0) {
                state.analyzed.genericConstructorTypes.put(
                    astNodeKey(call), instance);
                substitutions = genericTypeMap(state.analyzed, instance);
                declaration = state.analyzed.genericClassConstructor(
                    callee.name);
            }
        }
        if (declaration != null) {
            contextualizeGenericCallParameters(
                declaration.params, substitutions,
                call, state, variables);
        }
        return;
    }
    if (callee.kind == NK_LAMBDA_EXPR) {
        contextualizeGenericCallParameters(
            callee.params, substitutions, call, state, variables);
        return;
    }
    if (callee.kind != NK_FIELD_ACCESS_EXPR) {
        Node? callable = directFunctionPointerType(
            inferSpecializationType(callee, state.analyzed, variables),
            state.analyzed);
        if (callable != null) {
            contextualizeCallableArguments(
                callable, call, state, variables);
        }
        return;
    }
    Node? method = null;
    if (callee.obj != null && callee.obj.kind == NK_IDENTIFIER
            && !variables.has(callee.obj.name)
            && state.analyzed.isClass(callee.obj.name)) {
        method = state.analyzed.classMethod(callee.obj.name, callee.field);
    } else {
        Node? receiver = inferSpecializationType(
            callee.obj, state.analyzed, variables);
        if (receiver != null && state.analyzed.isClass(receiver.base)) {
            method = state.analyzed.classMethod(receiver.base, callee.field);
        } else if (receiver != null
                && state.analyzed.isGenericClass(receiver.base)) {
            method = state.analyzed.genericClassMethod(
                receiver.base, callee.field);
            substitutions = genericTypeMap(state.analyzed, receiver);
        }
    }
    if (method != null) {
        substitutions = methodCallTypeMap(
            state.analyzed, call, method, substitutions);
        contextualizeGenericCallParameters(
            method.params, substitutions, call, state, variables);
    }
}

void contextualizeNewGenericConstructors(Node expression,
        SemanticValidationState state, Map<string, Node> variables) {
    Node? constructor = null;
    Map<string, Node> substitutions = {};
    if (state.analyzed.isClass(expression.type.base)) {
        constructor = state.analyzed.classConstructor(expression.type.base);
    } else if (state.analyzed.isGenericClass(expression.type.base)) {
        constructor = state.analyzed.genericClassConstructor(
            expression.type.base);
        substitutions = genericTypeMap(state.analyzed, expression.type);
    }
    if (constructor != null) {
        contextualizeGenericCallParameters(
            constructor.params, substitutions,
            expression, state, variables);
    }
}
