/* Typed cycle traversal for managed slots inside built-in collections. */

string cycleVisitorName(string emittedName) {
    return "__btrc_arc_visit_" + emittedName;
}

bool isCycleCollection(string base) {
    return base == "Vector" || base == "Array" || base == "List"
        || base == "Map" || base == "Set";
}

bool genericTypeHasCycleVisitor(IRGen generator, Node typeExpr) {
    if (typeExpr == null || typeExpr.generic_args.len == 0
            || typeExpr.pointer_depth > 1 || typeExpr.is_array) {
        return false;
    }
    string mangled = mangleGenericType(
        typeExpr.base, typeExpr.generic_args);
    int index = 0;
    while (index < generator.analyzed.genericInstances.len) {
        GenInstance instance =
            generator.analyzed.genericInstances.get(index);
        if (instance.mangled == mangled) {
            return genericInstanceNeedsVisitor(
                generator.analyzed, instance);
        }
        index = index + 1;
    }
    return false;
}

string cycleEdgeEmittedName(Node typeExpr) {
    if (typeExpr.generic_args.len > 0) {
        return mangleGenericType(typeExpr.base, typeExpr.generic_args);
    }
    return typeExpr.base;
}

IRNode cycleEdgeDescriptor(IRGen generator, Node typeExpr) {
    if (irManagedMutexType(generator, typeExpr)) {
        return managedArcDescriptor(
            generator, irManagedMutexRuntimeType());
    }
    string emitted = cycleEdgeEmittedName(typeExpr);
    Vector<string> fields = [];
    fields.push("visit");
    fields.push("destroy");
    fields.push("hook");
    fields.push("guard");
    fields.push("raise");
    Vector<IRNode> values = [];
    if ((typeExpr.generic_args.len > 0
                && genericTypeHasCycleVisitor(generator, typeExpr))
            || (typeExpr.generic_args.len == 0
                && classNeedsCycleVisitor(generator, typeExpr.base))) {
        values.push(irVar(cycleVisitorName(emitted)));
    } else {
        values.push(irLiteral("NULL"));
    }
    values.push(irVar(emitted + "_destroy"));
    values.push(irLiteral("NULL"));
    values.push(irLiteral("NULL"));
    values.push(irLiteral("NULL"));
    return irAddressOf(irCompoundLiteral(
        "__btrc_arc_type", fields, values));
}

void appendCycleCallback(IRGen generator, Node typeExpr, IRNode slot,
        Vector<IRNode> output) {
    Node? canonical = resolveOuterTypedefType(
        typeExpr, generator.analyzed.typedefTable);
    if (canonical == null) { return; }
    Node resolved = canonical;
    string access = ensureArcSlotAdapter(
        generator, typeToC(resolved, generator.analyzed));
    Vector<IRNode> arguments = [];
    arguments.push(irCast("volatile void*", irAddressOf(slot)));
    arguments.push(irVar(access));
    arguments.push(cycleEdgeDescriptor(generator, resolved));
    arguments.push(irVar("context"));
    Vector<IRNode> thenBody = [];
    thenBody.push(irExprStmt(irCall("fn", arguments)));
    output.push(irIf(slot, irBlock(thenBody), null));
}

bool appendClassCycleFieldVisit(IRGen generator, Node typeExpr,
        IRNode slot, Vector<IRNode> output) {
    if (typeExpr == null || typeExpr.pointer_depth > 1
            || typeExpr.is_array) {
        return false;
    }
    if (genericCycleManagedType(generator.analyzed, typeExpr)) {
        appendCycleCallback(generator, typeExpr, slot, output);
        return true;
    }
    return false;
}

bool appendGenericCycleFieldVisit(IRGen generator, Node typeExpr,
        IRNode slot, Vector<IRNode> output) {
    if (typeExpr == null || typeExpr.pointer_depth > 1
            || typeExpr.is_array) {
        return false;
    }
    if (!genericCycleManagedType(generator.analyzed, typeExpr)) { return false; }
    appendCycleCallback(generator, typeExpr, slot, output);
    return true;
}

void appendCollectionSlotVisit(IRGen generator, Node typeExpr,
        IRNode slot, Vector<IRNode> output) {
    if (typeExpr == null || typeExpr.pointer_depth > 1
            || typeExpr.is_array) {
        return;
    }
    if (genericCycleManagedType(generator.analyzed, typeExpr)) {
        appendCycleCallback(generator, typeExpr, slot, output);
    }
}

IRNode collectionIndexedLoop(IRGen generator, string bound,
        Vector<string> fields, Vector<Node> types, bool occupiedOnly) {
    string index = generator.freshTemp("__btrc_visit_index");
    Vector<IRNode> slotBody = [];
    int slotIndex = 0;
    while (slotIndex < fields.len && slotIndex < types.len) {
        IRNode array = irFieldAccess(
            irVar("self"), fields.get(slotIndex), true);
        appendCollectionSlotVisit(generator, types.get(slotIndex),
            irIndex(array, irVar(index)), slotBody);
        slotIndex = slotIndex + 1;
    }
    Vector<IRNode> loopBody = slotBody;
    if (occupiedOnly) {
        IRNode occupied = irIndex(irFieldAccess(
            irVar("self"), "occupied", true), irVar(index));
        loopBody = [];
        loopBody.push(irIf(occupied, irBlock(slotBody), null));
    }
    IRNode init = irVarDecl("int", index, irLiteral("0"));
    IRNode condition = irBinOp(irVar(index), "<",
        irFieldAccess(irVar("self"), bound, true));
    IRNode update = irUnaryOp("++", irVar(index), false);
    return irFor(init, condition, update, irBlock(loopBody));
}

void appendListCycleBody(IRGen generator, Node element,
        Vector<IRNode> body) {
    Node nodeType = Node();
    nodeType.kind = NK_TYPE_EXPR;
    nodeType.base = "ListNode";
    nodeType.generic_args.push(element);
    appendCollectionSlotVisit(generator, nodeType,
        irFieldAccess(irVar("self"), "head", true), body);
    appendCollectionSlotVisit(generator, nodeType,
        irFieldAccess(irVar("self"), "tail", true), body);
}

bool appendBuiltinCollectionCycleBody(IRGen generator,
        GenInstance instance, Vector<IRNode> body) {
    if (!isCycleCollection(instance.base)) { return false; }
    if ((instance.base == "Map" && instance.args.len != 2)
            || (instance.base != "Map" && instance.args.len != 1)) {
        fprintf(stderr, "error: cannot safely traverse malformed %s instance\n",
            instance.base);
        abortGen();
    }
    if (instance.base == "List") {
        appendListCycleBody(generator, instance.args.get(0), body);
        return true;
    }
    Vector<string> fields = [];
    Vector<Node> types = [];
    bool occupiedOnly = false;
    string bound = "len";
    if (instance.base == "Vector" || instance.base == "Array") {
        fields.push("data");
        types.push(instance.args.get(0));
    } else {
        bound = "cap";
        occupiedOnly = true;
        fields.push("keys");
        types.push(instance.args.get(0));
        if (instance.base == "Map") {
            fields.push("values");
            types.push(instance.args.get(1));
        }
    }
    body.push(collectionIndexedLoop(
        generator, bound, fields, types, occupiedOnly));
    return true;
}
