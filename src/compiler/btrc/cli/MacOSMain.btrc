/* Native macOS host composition; the portable Unix entry remains SDK-free. */
import Library.BackgroundJobs.HostWorkerPools;
import Library.Digest.NativeSHA256;

import ./Driver.btrc;
import ../frontend/NativeHeaderProcess.btrc;

int main(int argc, char** argv) { return BtrccCompilerStack.run((int count, char** values) => BtrccDriver(count, values, FeNativeHeaderProcess.read, NativeSHA256(), HostWorkerPools()).run(), argc, argv); }
