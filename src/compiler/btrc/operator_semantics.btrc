/* Shared comparison, reference, and hashing domains for the self-hosted
 * compiler. Mirrors operator_semantics.py and reference_semantics.py. */

enum OperatorDomain {
    OP_DOMAIN_UNRESOLVED = -1,
    OP_DOMAIN_INVALID = 0,
    OP_DOMAIN_STRING = 1,
    OP_DOMAIN_NUMERIC = 2,
    OP_DOMAIN_REFERENCE = 3,
};

enum HashDomain {
    HASH_DOMAIN_INVALID = 0,
    HASH_DOMAIN_STRING = 1,
    HASH_DOMAIN_FLOATING = 2,
    HASH_DOMAIN_INTEGRAL = 3,
    HASH_DOMAIN_REFERENCE = 4,
};

class OperatorSemantics {
    class Node nullType() {
        Node typeExpr = makePrimType("void");
        typeExpr.pointer_depth = 1;
        typeExpr.is_nullable = true;
        return typeExpr;
    }

    class bool isNullType(Node? typeExpr) {
        return typeExpr != null
            && (typeExpr.base == "null" || typeExpr.base == "void")
            && typeExpr.pointer_depth > 0 && typeExpr.is_nullable;
    }

    class int referenceDepth(Node typeExpr) {
        int depth = typeExpr.pointer_depth;
        bool intrinsicReference = typeExpr.base == "string"
            || typeExpr.base == "Thread" || typeExpr.base == "Mutex"
            || typeExpr.base == "__fn_ptr";
        if (TypeComposition.nullableCollapsesReferenceLayer(
                typeExpr, intrinsicReference)) {
            depth = depth - 1;
        }
        if (typeExpr.is_array) { depth = depth + 1; }
        if (intrinsicReference) { depth = depth + 1; }
        return depth;
    }

    /* Effective expression-value depth.  Class and opaque handle declarations
     * omit their intrinsic pointer in source, while inferred/member types may
     * already carry it.  These spellings describe the same runtime value shape. */
    class int valueDepth(Node typeExpr, Analyzed analyzed) {
        int depth = OperatorSemantics.referenceDepth(typeExpr);
        if (depth == 0 && (analyzed.isClass(typeExpr.base)
                || (typeExpr.generic_args.len > 0
                    && analyzed.isGenericClass(typeExpr.base)))) {
            depth = 1;
        }
        return depth;
    }

    class bool isVoidPointer(Node typeExpr) {
        return typeExpr.base == "void"
            && OperatorSemantics.referenceDepth(typeExpr) == 1;
    }

    /* Exactly one C `char` indirection is interoperable with semantic `string`.
     * Arrays count as one indirection; char** and pointer-to-array shapes do not. */
    class bool isCStringPointer(Node? typeExpr) {
        return typeExpr != null && typeExpr.base == "char"
            && OperatorSemantics.referenceDepth(typeExpr) == 1
            && typeExpr.generic_args.len == 0;
    }

    class bool isReferenceType(Node? typeExpr, Analyzed analyzed) {
        if (typeExpr == null) { return false; }
        if (OperatorSemantics.isNullType(typeExpr)
                || TypeComposition.isSemanticScalarString(typeExpr)) {
            return true;
        }
        return typeExpr.pointer_depth > 0 || typeExpr.is_array
            || analyzed.isClass(typeExpr.base)
            || analyzed.isGenericClass(typeExpr.base)
            || typeExpr.base == "Thread" || typeExpr.base == "Mutex"
            || typeExpr.base == "__fn_ptr";
    }

    class bool genericArgsEqual(Vector<Node> left, Vector<Node> right) {
        if (left.len != right.len) { return false; }
        int index = 0;
        while (index < left.len) {
            if (TypeIdentity.shapeKey(left.get(index)) != TypeIdentity.shapeKey(right.get(index))) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    class bool specializationIsSubtype(
            Node child, Node parent, Analyzed analyzed) {
        string currentBase = child.base;
        bool carriesArgs = true;
        Map<string, bool> seen = {};
        while (currentBase != "" && !seen.has(currentBase)) {
            seen.put(currentBase, true);
            if (currentBase == parent.base) {
                if (!carriesArgs) { return parent.generic_args.len == 0; }
                return OperatorSemantics.genericArgsEqual(
                    child.generic_args, parent.generic_args);
            }
            Node? declaration = null;
            if (analyzed.classTable.has(currentBase)) {
                declaration = analyzed.classTable.get(currentBase);
            } else if (analyzed.genericClassTable.has(currentBase)) {
                declaration = analyzed.genericClassTable.get(currentBase);
            }
            if (declaration == null) { return false; }
            string ancestor = parentName(declaration);
            if (ancestor == "") { return false; }
            int ancestorArity = 0;
            if (analyzed.genericClassTable.has(ancestor)) {
                ancestorArity = analyzed.genericClassTable.get(
                    ancestor).generic_params.len;
            }
            if (ancestorArity > 0) {
                int currentArity = declaration.generic_params.len;
                if (!carriesArgs || ancestorArity != currentArity
                        || currentArity != child.generic_args.len) {
                    return false;
                }
            } else {
                carriesArgs = false;
            }
            currentBase = ancestor;
        }
        return false;
    }

    class bool nominallyRelated(Node left, Node right, Analyzed analyzed) {
        bool nominalLeft = analyzed.isClass(left.base)
            || analyzed.isGenericClass(left.base);
        bool nominalRight = analyzed.isClass(right.base)
            || analyzed.isGenericClass(right.base);
        if (!nominalLeft || !nominalRight) { return false; }
        return OperatorSemantics.specializationIsSubtype(left, right, analyzed)
            || OperatorSemantics.specializationIsSubtype(right, left, analyzed);
    }

    class bool referenceTypesCompatible(
            Node? left, Node? right, Analyzed analyzed) {
        if (OperatorSemantics.isNullType(left)) {
            return OperatorSemantics.isReferenceType(right, analyzed);
        }
        if (OperatorSemantics.isNullType(right)) {
            return OperatorSemantics.isReferenceType(left, analyzed);
        }
        if (left == null || right == null) { return false; }
        if (!OperatorSemantics.isReferenceType(left, analyzed)
                || !OperatorSemantics.isReferenceType(right, analyzed)) {
            return false;
        }
        if (left.base == "__fn_ptr" || right.base == "__fn_ptr") {
            return left.base == "__fn_ptr" && right.base == "__fn_ptr"
                && OperatorSemantics.genericArgsEqual(
                    left.generic_args, right.generic_args);
        }
        if (OperatorSemantics.isVoidPointer(left)
                || OperatorSemantics.isVoidPointer(right)) {
            return true;
        }
        if ((TypeComposition.isSemanticScalarString(left)
                    && OperatorSemantics.isCStringPointer(right))
                || (TypeComposition.isSemanticScalarString(right)
                    && OperatorSemantics.isCStringPointer(left))) {
            return true;
        }
        if (OperatorSemantics.valueDepth(left, analyzed)
                != OperatorSemantics.valueDepth(right, analyzed)) {
            return false;
        }
        if (left.base == right.base) {
            return OperatorSemantics.genericArgsEqual(
                left.generic_args, right.generic_args);
        }
        return OperatorSemantics.nominallyRelated(left, right, analyzed);
    }

    class bool isComparisonOperator(string op) {
        return op == "==" || op == "!=" || op == "<" || op == ">"
            || op == "<=" || op == ">=";
    }

    class int comparisonDomain(
            string op, Node? left, Node? right, Analyzed analyzed) {
        if (left == null || right == null) { return OP_DOMAIN_UNRESOLVED; }
        bool leftString = TypeComposition.isSemanticScalarString(left);
        bool rightString = TypeComposition.isSemanticScalarString(right);
        if (leftString || rightString) {
            if ((leftString || OperatorSemantics.isCStringPointer(left)
                        || OperatorSemantics.isNullType(left))
                    && (rightString || OperatorSemantics.isCStringPointer(right)
                        || OperatorSemantics.isNullType(right))) {
                return OP_DOMAIN_STRING;
            }
            return OP_DOMAIN_INVALID;
        }
        if (NumericSemantics.isType(left, analyzed)
                && NumericSemantics.isType(right, analyzed)) {
            return OP_DOMAIN_NUMERIC;
        }
        bool leftRef = OperatorSemantics.isReferenceType(left, analyzed);
        bool rightRef = OperatorSemantics.isReferenceType(right, analyzed);
        if (leftRef || rightRef) {
            if (op != "==" && op != "!=") { return OP_DOMAIN_INVALID; }
            if (OperatorSemantics.referenceTypesCompatible(
                    left, right, analyzed)) {
                return OP_DOMAIN_REFERENCE;
            }
            return OP_DOMAIN_INVALID;
        }
        return OP_DOMAIN_INVALID;
    }

    class int hashDomain(Node? operand, Analyzed analyzed) {
        if (operand == null) { return HASH_DOMAIN_INVALID; }
        if (TypeComposition.isSemanticScalarString(operand)) { return HASH_DOMAIN_STRING; }
        if (NumericSemantics.isFloating(operand)) { return HASH_DOMAIN_FLOATING; }
        if (NumericSemantics.isType(operand, analyzed)) {
            return HASH_DOMAIN_INTEGRAL;
        }
        if (operand.base == "__fn_ptr") { return HASH_DOMAIN_INVALID; }
        if (OperatorSemantics.isReferenceType(operand, analyzed)) {
            return HASH_DOMAIN_REFERENCE;
        }
        return HASH_DOMAIN_INVALID;
    }

    /* One shared source of truth for overloadable binary operators.  Both semantic
     * validation and IR lowering consume this mapping. */
    class string binaryMethodName(string op) {
        if (op == "+") { return "__add__"; }
        if (op == "-") { return "__sub__"; }
        if (op == "*") { return "__mul__"; }
        if (op == "/") { return "__div__"; }
        if (op == "%") { return "__mod__"; }
        if (op == "==") { return "__eq__"; }
        if (op == "!=") { return "__ne__"; }
        if (op == "<") { return "__lt__"; }
        if (op == ">") { return "__gt__"; }
        if (op == "<=") { return "__le__"; }
        if (op == ">=") { return "__ge__"; }
        return "";
    }

    class Node? overloadReturnType(Node? receiverType, string op,
            bool unary, Analyzed analyzed) {
        if (receiverType == null) { return null; }
        string methodName = unary && op == "-"
            ? "__neg__" : OperatorSemantics.binaryMethodName(op);
        if (methodName == "") { return null; }
        Node? method = null;
        if (analyzed.isClass(receiverType.base)) {
            method = analyzed.classMethod(receiverType.base, methodName);
        } else if (analyzed.isGenericClass(receiverType.base)) {
            method = analyzed.genericClassMethod(
                receiverType.base, methodName);
        }
        if (method == null || method.kind != NK_METHOD_DECL) { return null; }
        Node concreteMethod = method;
        if (receiverType.generic_args.len > 0
                && analyzed.isGenericClass(receiverType.base)) {
            return resolveGenericType(concreteMethod.return_type,
                genericTypeMap(analyzed, receiverType),
                analyzed);
        }
        return concreteMethod.return_type;
    }

    class bool isRawPointer(Node? typeExpr, Analyzed analyzed) {
        return typeExpr != null
            && (typeExpr.pointer_depth > 0 || typeExpr.is_array)
            && !analyzed.isClass(typeExpr.base)
            && !analyzed.isGenericClass(typeExpr.base);
    }

    class Node? pointerArithmeticType(Node? left, Node? right,
            string op, Analyzed analyzed) {
        if (op == "-" && OperatorSemantics.isRawPointer(left, analyzed)) {
            if (OperatorSemantics.isRawPointer(right, analyzed)) {
                return makePrimType("long");
            }
            return left;
        }
        if (op == "+") {
            if (OperatorSemantics.isRawPointer(left, analyzed)) { return left; }
            if (OperatorSemantics.isRawPointer(right, analyzed)) { return right; }
        }
        return null;
    }

    /* `obj?.value ?? fallback` is a value-domain coalesce, not a null test on the
     * scalar result.  The optional access already carries the presence condition
     * as a structured ternary; lowering replaces only its false branch. */
    class bool isOptionalValueCoalesce(
            Node? leftExpression, Node? leftType, Node? rightType,
            Analyzed analyzed) {
        return leftExpression != null
            && leftExpression.kind == NK_FIELD_ACCESS_EXPR
            && leftExpression.optional
            && NumericSemantics.isType(leftType, analyzed)
            && NumericSemantics.isType(rightType, analyzed);
    }
}
