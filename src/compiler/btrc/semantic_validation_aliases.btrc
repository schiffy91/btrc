/* User typedef normalization for semantic validation.
 *
 * IR emission preserves source aliases in C declarations.  Semantic checks,
 * however, must reason about their underlying value domain: `typedef int
 * Score;` supports arithmetic and assignment exactly as `int` does. */

Node? semanticResolveAliases(Node? typeExpr,
        SemanticValidationState state) {
    return resolveTypedefType(typeExpr, state.analyzed.typedefTable);
}

/* An array typedef names its C pointer value (`typedef T* Alias`), while a raw
 * outer `T[]` declarator still denotes array storage. Preserve that source
 * boundary before canonical alias expansion erases it. */
Node? semanticArrayValueType(Node? typeExpr,
        SemanticValidationState state) {
    Node? canonical = semanticResolveAliases(typeExpr, state);
    if (typeExpr == null || canonical == null
            || typeExpr.is_array || !canonical.is_array) {
        return typeExpr;
    }
    return typeWithOuterPointer(typeWithoutOuterArray(canonical));
}

Node? semanticInferType(Node? expression, SemanticValidationState state,
        Map<string, Node> vars) {
    if (expression != null && expression.kind == NK_INDEX_EXPR) {
        Node? objectType = semanticInferType(expression.obj, state, vars);
        return semanticResolveAliases(
            semanticIndexResultTypeInState(objectType, state), state);
    }
    if (state.gpuCallable) {
        return semanticResolveAliases(
            gpuContextualExprType(expression, state.analyzed, vars), state);
    }
    return semanticResolveAliases(
        inferType(expression, state.analyzed, vars), state);
}

bool semanticAliasTypesSame(Node? left, Node? right,
        SemanticValidationState state) {
    Node? resolvedLeft = semanticResolveAliases(left, state);
    Node? resolvedRight = semanticResolveAliases(right, state);
    if (resolvedLeft == null || resolvedRight == null) {
        return resolvedLeft == null && resolvedRight == null;
    }
    return typeShapeKey(resolvedLeft) == typeShapeKey(resolvedRight);
}

void semanticValidateTypedefs(Node program, SemanticValidationState state) {
    int index = 0;
    while (index < program.declarations.len) {
        Node declaration = program.declarations.get(index);
        if (declaration.kind == NK_TYPEDEF_DECL) {
            resolveTypedefType(
                declaration.original, state.analyzed.typedefTable);
        }
        index = index + 1;
    }
}
