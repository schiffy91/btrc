/* Source preprocessor mutations share one parser and symbol boundary. */

bool sourceMacroSpace(char value) {
    return value == ' ' || value == '\t'
        || value == '\f' || value == '\v' || value == '\r';
}

bool sourceMacroIdentifierStart(char value) {
    return TypeIdentity.asciiLetter(value) || value == '_';
}

bool sourceMacroIdentifierPart(char value) {
    return sourceMacroIdentifierStart(value)
        || TypeIdentity.asciiDigit(value);
}

string sourceMacroNormalizeSplices(string sourceText) {
    string normalized = Strings.replace(sourceText, "\\\r\n", "");
    normalized = Strings.replace(normalized, "\\\n", "");
    normalized = Strings.replace(normalized, "?" + "?/\r\n", "");
    return Strings.replace(normalized, "?" + "?/\n", "");
}

string sourceMacroNormalizeComments(string sourceText) {
    string normalized = "";
    int index = 0;
    while (index < sourceText.length()) {
        char value = sourceText[index];
        if (value == '"' || value == '\'') {
            int end = sourceMacroSkipQuoted(sourceText, index, value);
            normalized = normalized + sourceText.substring(index, end - index);
            index = end;
        } else if (value == '/' && index + 1 < sourceText.length()
                && sourceText[index + 1] == '*') {
            normalized = normalized + " ";
            index = index + 2;
            while (index + 1 < sourceText.length()
                    && !(sourceText[index] == '*'
                        && sourceText[index + 1] == '/')) {
                index = index + 1;
            }
            index = index + 1 < sourceText.length()
                ? index + 2 : sourceText.length();
        } else {
            normalized = normalized + sourceText.substring(index, 1);
            index = index + 1;
        }
    }
    return normalized;
}

string sourceMacroNormalizeDirective(string sourceText) {
    return sourceMacroNormalizeComments(
        sourceMacroNormalizeSplices(sourceText));
}

int sourceDirectiveNameStart(string sourceText, string operation) {
    int length = sourceText.length();
    int index = 0;
    while (index < length && sourceMacroSpace(sourceText[index])) {
        index = index + 1;
    }
    if (index >= length || sourceText[index] != '#') { return -1; }
    index = index + 1;
    while (index < length && sourceMacroSpace(sourceText[index])) {
        index = index + 1;
    }
    int operationStart = index;
    while (index < length
            && sourceMacroIdentifierPart(sourceText[index])) {
        index = index + 1;
    }
    string found = sourceText.substring(
        operationStart, index - operationStart);
    if (found != operation || index >= length
            || !sourceMacroSpace(sourceText[index])) {
        return -1;
    }
    while (index < length && sourceMacroSpace(sourceText[index])) {
        index = index + 1;
    }
    if (index >= length
            || !sourceMacroIdentifierStart(sourceText[index])) {
        return -1;
    }
    return index;
}

int sourceDirectiveNameEnd(string sourceText, string operation) {
    int index = sourceDirectiveNameStart(sourceText, operation);
    if (index < 0) { return -1; }
    index = index + 1;
    while (index < sourceText.length()
            && sourceMacroIdentifierPart(sourceText[index])) {
        index = index + 1;
    }
    return index;
}

string sourceDirectiveName(string sourceText, string operation) {
    string normalized = sourceMacroNormalizeDirective(sourceText);
    int start = sourceDirectiveNameStart(normalized, operation);
    if (start < 0) { return ""; }
    int end = sourceDirectiveNameEnd(normalized, operation);
    return normalized.substring(start, end - start);
}

string sourceMacroName(string sourceText) {
    return sourceDirectiveName(sourceText, "define");
}

string sourceUndefName(string sourceText) {
    return sourceDirectiveName(sourceText, "undef");
}

string sourceMacroTrim(string value) {
    int start = 0;
    int end = value.length();
    while (start < end && sourceMacroSpace(value[start])) {
        start = start + 1;
    }
    while (end > start && sourceMacroSpace(value[end - 1])) {
        end = end - 1;
    }
    return value.substring(start, end - start);
}

int sourceMacroParametersEnd(string sourceText) {
    int nameEnd = sourceDirectiveNameEnd(sourceText, "define");
    if (nameEnd < 0 || nameEnd >= sourceText.length()
            || sourceText[nameEnd] != '(') {
        return -1;
    }
    int index = nameEnd + 1;
    while (index < sourceText.length() && sourceText[index] != ')') {
        index = index + 1;
    }
    if (index >= sourceText.length()) { return -1; }
    return index;
}

Map<string, bool> sourceMacroParameters(string sourceText) {
    string normalized = sourceMacroNormalizeDirective(sourceText);
    Map<string, bool> parameters = {};
    int nameEnd = sourceDirectiveNameEnd(normalized, "define");
    int close = sourceMacroParametersEnd(normalized);
    if (nameEnd < 0 || close < 0) { return parameters; }
    int start = nameEnd + 1;
    int index = start;
    while (index <= close) {
        if (index == close || normalized[index] == ',') {
            string parameter = sourceMacroTrim(normalized.substring(
                start, index - start));
            if (parameter != "") { parameters.put(parameter, true); }
            start = index + 1;
        }
        index = index + 1;
    }
    return parameters;
}

int sourceMacroReplacementStart(string sourceText) {
    string normalized = sourceMacroNormalizeDirective(sourceText);
    int nameEnd = sourceDirectiveNameEnd(normalized, "define");
    if (nameEnd < 0) { return -1; }
    int close = sourceMacroParametersEnd(normalized);
    if (close >= 0) { return close + 1; }
    return nameEnd;
}

int sourceMacroSkipQuoted(string text, int index, char quote) {
    index = index + 1;
    while (index < text.length()) {
        if (text[index] == '\\') {
            index = index + 2;
        } else if (text[index] == quote) {
            return index + 1;
        } else {
            index = index + 1;
        }
    }
    return index;
}

Vector<string> sourceMacroReplacementIdentifiers(string sourceText) {
    string normalized = sourceMacroNormalizeDirective(sourceText);
    Vector<string> identifiers = [];
    Map<string, bool> parameters = sourceMacroParameters(normalized);
    int index = sourceMacroReplacementStart(normalized);
    if (index < 0) { return identifiers; }
    while (index < normalized.length()) {
        char value = normalized[index];
        if (value == '"' || value == '\'') {
            index = sourceMacroSkipQuoted(normalized, index, value);
        } else if (value == '/' && index + 1 < normalized.length()
                && normalized[index + 1] == '/') {
            return identifiers;
        } else if (value == '/' && index + 1 < normalized.length()
                && normalized[index + 1] == '*') {
            index = index + 2;
            while (index + 1 < normalized.length()
                    && !(normalized[index] == '*'
                        && normalized[index + 1] == '/')) {
                index = index + 1;
            }
            if (index + 1 < normalized.length()) { index = index + 2; }
        } else if (sourceMacroIdentifierStart(value)) {
            int start = index;
            index = index + 1;
            while (index < normalized.length()
                    && sourceMacroIdentifierPart(normalized[index])) {
                index = index + 1;
            }
            string identifier = normalized.substring(start, index - start);
            if (!parameters.has(identifier)
                    && !identifiers.contains(identifier)) {
                identifiers.push(identifier);
            }
        } else {
            index = index + 1;
        }
    }
    return identifiers;
}
