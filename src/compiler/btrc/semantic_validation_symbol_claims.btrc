/* Generated claim families for classes, enums, and generic instances. */

void semanticCollectMergedClassMethods(Analyzed analyzed, string className,
        Vector<MethodEntry> output, Map<string, int> indices,
        Map<string, bool> visited) {
    if (!analyzed.classTable.has(className) || visited.has(className)) {
        return;
    }
    visited.put(className, true);
    Node declaration = analyzed.classTable.get(className);
    string parent = parentName(declaration);
    if (parent != "" && analyzed.classTable.has(parent)) {
        semanticCollectMergedClassMethods(
            analyzed, parent, output, indices, visited);
    }
    int memberIndex = 0;
    while (memberIndex < declaration.members.len) {
        Node member = declaration.members.get(memberIndex);
        if (member.kind == NK_METHOD_DECL && !member.is_constructor
                && member.name != "__del__"
                && member.generic_params.len == 0) {
            MethodEntry entry = MethodEntry(member.name, member);
            if (indices.has(member.name)) {
                output.set(indices.get(member.name), entry);
            } else {
                indices.put(member.name, output.len);
                output.push(entry);
            }
        }
        memberIndex = memberIndex + 1;
    }
}

Vector<MethodEntry> semanticMergedClassMethods(
        Analyzed analyzed, string className) {
    Vector<MethodEntry> output = [];
    Map<string, int> indices = {};
    Map<string, bool> visited = {};
    semanticCollectMergedClassMethods(
        analyzed, className, output, indices, visited);
    return output;
}

bool semanticClassNeedsVisitorSeen(string className, Analyzed analyzed,
        Map<string, bool> visited) {
    if (!analyzed.isClass(className) || visited.has(className)) {
        return false;
    }
    visited.put(className, true);
    Node declaration = analyzed.classTable.get(className);
    string parent = parentName(declaration);
    if (parent != "" && semanticClassNeedsVisitorSeen(
            parent, analyzed, visited)) {
        return true;
    }
    int memberIndex = 0;
    while (memberIndex < declaration.members.len) {
        Node member = declaration.members.get(memberIndex);
        if (instanceStorageName(member) != "" && member.type != null
                && member.type.pointer_depth <= 1
                && (analyzed.isClass(member.type.base)
                    || (member.type.generic_args.len > 0
                        && analyzed.isGenericClass(member.type.base)))) {
            return true;
        }
        memberIndex = memberIndex + 1;
    }
    return false;
}

bool semanticClassNeedsVisitor(string className, Analyzed analyzed) {
    Map<string, bool> visited = {};
    return semanticClassNeedsVisitorSeen(className, analyzed, visited);
}

void semanticClaimClassSymbols(Node declaration,
        SemanticValidationState state, Map<string, string> symbols) {
    string name = declaration.name;
    semanticClaimGeneratedSymbol(state, symbols, name + "_init",
        "class '" + name + "' initializer", declaration);
    semanticClaimGeneratedSymbol(state, symbols, name + "_new",
        "class '" + name + "' allocator", declaration);
    semanticClaimGeneratedSymbol(state, symbols, name + "_destroy",
        "class '" + name + "' destructor", declaration);
    Node? destructor = state.analyzed.classMethod(name, "__del__");
    if (destructor != null && destructor.body_node != null) {
        semanticClaimGeneratedSymbol(state, symbols,
            destructorHookName(name),
            "destructor hook for class '" + name + "'", destructor);
    }
    if (semanticClassNeedsVisitor(name, state.analyzed)) {
        semanticClaimGeneratedSymbol(state, symbols, cycleVisitorName(name),
            "class '" + name + "' cycle visitor", declaration);
    }
    Vector<MethodEntry> methods = semanticMergedClassMethods(
        state.analyzed, name);
    int methodIndex = 0;
    while (methodIndex < methods.len) {
        MethodEntry entry = methods.get(methodIndex);
        semanticClaimGeneratedSymbol(state, symbols, name + "_" + entry.name,
            "method '" + name + "." + entry.name + "'", entry.sig);
        methodIndex = methodIndex + 1;
    }
    Vector<Node> properties = mergedClassProperties(state.analyzed, name);
    int propertyIndex = 0;
    while (propertyIndex < properties.len) {
        Node property = properties.get(propertyIndex);
        if (property.has_getter) {
            semanticClaimGeneratedSymbol(state, symbols,
                name + "_get_" + property.name,
                "getter '" + name + "." + property.name + "'", property);
        }
        if (property.has_setter) {
            semanticClaimGeneratedSymbol(state, symbols,
                name + "_set_" + property.name,
                "setter '" + name + "." + property.name + "'", property);
        }
        propertyIndex = propertyIndex + 1;
    }
    int memberIndex = 0;
    while (memberIndex < declaration.members.len) {
        Node member = declaration.members.get(memberIndex);
        if (member.kind == NK_FIELD_DECL && member.access == "class") {
            semanticClaimGeneratedSymbol(state, symbols,
                name + "_" + member.name,
                "static field '" + name + "." + member.name + "'", member);
        }
        memberIndex = memberIndex + 1;
    }
}

void semanticClaimEnumSymbols(Node declaration,
        SemanticValidationState state, Map<string, string> symbols) {
    int index = 0;
    while (index < declaration.values.len) {
        Node value = declaration.values.get(index);
        if (declaration.name == "") {
            semanticClaimSymbol(symbols, value.name,
                "enum value '" + value.name + "'", value);
        } else {
            string emittedName = declaration.name + "_" + value.name;
            semanticClaimGeneratedSymbol(state, symbols, emittedName,
                "enum value '" + declaration.name + "." + value.name + "'",
                value);
        }
        index = index + 1;
    }
    if (declaration.name != "") {
        semanticClaimGeneratedSymbol(state, symbols,
            declaration.name + "_toString",
            "enum '" + declaration.name + "' formatter", declaration);
    }
}

void semanticClaimRichEnumSymbols(Node declaration,
        SemanticValidationState state, Map<string, string> symbols) {
    semanticClaimGeneratedSymbol(state, symbols, declaration.name + "_Tag",
        "rich enum '" + declaration.name + "' tag type", declaration);
    int index = 0;
    while (index < declaration.variants.len) {
        Node variant = declaration.variants.get(index);
        string stem = declaration.name + "_" + variant.name;
        semanticClaimGeneratedSymbol(state, symbols, stem + "_TAG",
            "rich-enum tag '" + declaration.name + "."
                + variant.name + "'", variant);
        semanticClaimGeneratedSymbol(state, symbols, stem,
            "rich-enum constructor '" + declaration.name + "."
                + variant.name + "'", variant);
        if (variant.params.len > 0) {
            semanticClaimGeneratedSymbol(state, symbols, stem + "_Data",
                "rich-enum payload type '" + declaration.name + "."
                    + variant.name + "'", variant);
        }
        index = index + 1;
    }
    semanticClaimGeneratedSymbol(state, symbols,
        declaration.name + "_toString",
        "rich enum '" + declaration.name + "' formatter", declaration);
}

void semanticClaimGenericInstanceSymbols(SemanticValidationState state,
        Map<string, string> symbols) {
    int instanceIndex = 0;
    while (instanceIndex < state.analyzed.genericInstances.len) {
        GenInstance instance = state.analyzed.genericInstances.get(instanceIndex);
        if (state.analyzed.genericClassTable.has(instance.base)) {
            Node declaration =
                state.analyzed.genericClassTable.get(instance.base);
            string owner = "generic instance '" + instance.mangled + "'";
            semanticClaimGeneratedSymbol(state, symbols,
                instance.mangled + "_init",
                owner + " initializer", declaration);
            semanticClaimGeneratedSymbol(state, symbols,
                instance.mangled + "_new",
                owner + " allocator", declaration);
            semanticClaimGeneratedSymbol(state, symbols,
                instance.mangled + "_destroy",
                owner + " destructor", declaration);
            Node? destructor = state.analyzed.genericClassMethod(
                instance.base, "__del__");
            if (destructor != null && destructor.body_node != null) {
                semanticClaimGeneratedSymbol(state, symbols,
                    destructorHookName(instance.mangled),
                    "destructor hook for " + owner, destructor);
            }
            if (genericInstanceNeedsVisitor(state.analyzed, instance)) {
                semanticClaimGeneratedSymbol(state, symbols,
                    cycleVisitorName(instance.mangled),
                    owner + " cycle visitor", declaration);
            }
            int memberIndex = 0;
            while (memberIndex < declaration.members.len) {
                Node member = declaration.members.get(memberIndex);
                if (member.kind == NK_METHOD_DECL && !member.is_constructor
                        && member.name != "__del__"
                        && member.generic_params.len == 0) {
                    semanticClaimGeneratedSymbol(state, symbols,
                        instance.mangled + "_" + member.name,
                        owner + " method '" + member.name + "'", member);
                } else if (member.kind == NK_PROPERTY_DECL) {
                    if (member.has_getter) {
                        semanticClaimGeneratedSymbol(state, symbols,
                            instance.mangled + "_get_" + member.name,
                            owner + " getter '" + member.name + "'", member);
                    }
                    if (member.has_setter) {
                        semanticClaimGeneratedSymbol(state, symbols,
                            instance.mangled + "_set_" + member.name,
                            owner + " setter '" + member.name + "'", member);
                    }
                }
                memberIndex = memberIndex + 1;
            }
        }
        instanceIndex = instanceIndex + 1;
    }
}
