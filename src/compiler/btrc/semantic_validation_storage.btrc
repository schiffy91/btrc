/* Class layout and inherited member-kind collision contracts. */

void semanticCollectClassStorageSeen(string className, Analyzed analyzed,
        Map<string, bool> output, Map<string, bool> visited) {
    if (!analyzed.classTable.has(className) || visited.has(className)) {
        return;
    }
    visited.put(className, true);
    Node declaration = analyzed.classTable.get(className);
    string parent = parentName(declaration);
    if (parent != "" && analyzed.classTable.has(parent)) {
        semanticCollectClassStorageSeen(
            parent, analyzed, output, visited);
    }
    int index = 0;
    while (index < declaration.members.len) {
        string storage = instanceStorageName(declaration.members.get(index));
        if (storage != "") { output.put(storage, true); }
        index = index + 1;
    }
}

void semanticCollectClassStorage(string className, Analyzed analyzed,
        Map<string, bool> output) {
    Map<string, bool> visited = {};
    semanticCollectClassStorageSeen(
        className, analyzed, output, visited);
}

Node? semanticInheritedClassMember(string className, string memberName,
        Analyzed analyzed) {
    string current = className;
    Map<string, bool> visited = {};
    while (current != "" && analyzed.classTable.has(current)
            && !visited.has(current)) {
        visited.put(current, true);
        Node declaration = analyzed.classTable.get(current);
        int index = 0;
        while (index < declaration.members.len) {
            Node member = declaration.members.get(index);
            if (member.name == memberName
                    && !(member.kind == NK_METHOD_DECL
                        && member.is_constructor)) {
                return member;
            }
            index = index + 1;
        }
        current = parentName(declaration);
    }
    return null;
}

Node? semanticAnyClassDeclaration(
        string className, Analyzed analyzed) {
    if (analyzed.classTable.has(className)) {
        return analyzed.classTable.get(className);
    }
    if (analyzed.genericClassTable.has(className)) {
        return analyzed.genericClassTable.get(className);
    }
    return null;
}

string semanticInheritedPropertyName(string className, Analyzed analyzed,
        Map<string, bool> visited) {
    if (className == "" || visited.has(className)) { return ""; }
    Node? declaration = semanticAnyClassDeclaration(className, analyzed);
    if (declaration == null) { return ""; }
    visited.put(className, true);
    int index = 0;
    while (index < declaration.members.len) {
        Node member = declaration.members.get(index);
        if (member.kind == NK_PROPERTY_DECL) { return member.name; }
        index = index + 1;
    }
    return semanticInheritedPropertyName(
        parentName(declaration), analyzed, visited);
}

void semanticValidateGenericPropertyInheritance(Node declaration,
        SemanticValidationState state) {
    string parent = parentName(declaration);
    if (parent == "") { return; }
    bool crossesGenericBoundary = declaration.generic_params.len > 0
        || state.analyzed.isGenericClass(parent);
    if (!crossesGenericBoundary) { return; }
    Map<string, bool> visited = {};
    string property = semanticInheritedPropertyName(
        parent, state.analyzed, visited);
    if (property != "") {
        semanticValidationFail("Generic property inheritance is not supported: "
            + "class '" + declaration.name + "' inherits property '"
            + property + "'", declaration);
    }
}

void semanticValidateOwnClassStorage(Node declaration) {
    Map<string, bool> storageNames = {};
    storageNames.put("__arc", true);
    storageNames.put("__rc", true);
    storageNames.put("__cycle_safe_rc", true);
    int index = 0;
    while (index < declaration.members.len) {
        Node member = declaration.members.get(index);
        if (declaration.generic_params.len > 0
                && member.kind == NK_FIELD_DECL
                && member.access == "class") {
            semanticValidationFail("Static field '" + declaration.name
                + "." + member.name
                + "' is not supported on a generic class", member);
        }
        string storage = instanceStorageName(member);
        if (storage != "") {
            if (storageNames.has(storage)) {
                if (storage == "__arc" || storage == "__rc"
                        || storage == "__cycle_safe_rc") {
                    semanticValidationFail("Instance storage name '" + storage + "' is "
                        + "reserved for reference counting in class '"
                        + declaration.name + "'", member);
                } else {
                    semanticValidationFail("Instance storage name '" + storage
                        + "' collides with another member in class '"
                        + declaration.name + "'", member);
                }
            }
            storageNames.put(storage, true);
        }
        index = index + 1;
    }
}

void semanticValidateInheritedMemberKind(Node declaration,
        SemanticValidationState state) {
    string parent = parentName(declaration);
    if (parent == "" || !state.analyzed.classTable.has(parent)) { return; }
    int index = 0;
    while (index < declaration.members.len) {
        Node member = declaration.members.get(index);
        Node? inherited = semanticInheritedClassMember(
            parent, member.name, state.analyzed);
        if (inherited != null) {
            bool conflict = (member.kind == NK_PROPERTY_DECL
                    && inherited.kind != NK_PROPERTY_DECL)
                || (member.kind != NK_PROPERTY_DECL
                    && inherited.kind == NK_PROPERTY_DECL);
            if (conflict) {
                semanticValidationFail("Member '" + member.name
                    + "' in class '" + declaration.name
                    + "' conflicts with an inherited member of a different kind",
                    member);
            }
        }
        index = index + 1;
    }
}

void semanticValidateInheritedClassStorage(Node declaration,
        SemanticValidationState state) {
    string parent = parentName(declaration);
    if (parent == "" || !state.analyzed.classTable.has(parent)) { return; }
    Map<string, bool> inheritedStorage = {};
    semanticCollectClassStorage(parent, state.analyzed, inheritedStorage);
    int index = 0;
    while (index < declaration.members.len) {
        Node member = declaration.members.get(index);
        string storage = instanceStorageName(member);
        if (storage != "" && inheritedStorage.has(storage)) {
            semanticValidationFail("Instance storage '" + storage
                + "' in class '" + declaration.name
                + "' conflicts with inherited storage", member);
        }
        index = index + 1;
    }
}

void semanticValidateClassStorage(Node declaration,
        SemanticValidationState state) {
    semanticValidateOwnClassStorage(declaration);
    semanticValidateGenericPropertyInheritance(declaration, state);
    semanticValidateInheritedMemberKind(declaration, state);
    semanticValidateInheritedClassStorage(declaration, state);
}
