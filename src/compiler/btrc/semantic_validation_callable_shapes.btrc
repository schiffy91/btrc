/* Declaration-shape contracts for callables that become C functions. */

bool semanticPlainType(Node? typeExpr, string base,
        SemanticValidationState state) {
    typeExpr = semanticResolveAliases(typeExpr, state);
    return typeExpr != null && typeExpr.base == base
        && typeExpr.pointer_depth == 0 && !typeExpr.is_array
        && typeExpr.generic_args.len == 0;
}

int semanticMagicArity(string name) {
    if (name == "__neg__" || name == "toString"
            || name == "__del__") {
        return 0;
    }
    if (name == "__add__" || name == "__sub__"
            || name == "__mul__" || name == "__div__"
            || name == "__mod__" || name == "__eq__"
            || name == "__ne__" || name == "__lt__"
            || name == "__gt__" || name == "__le__"
            || name == "__ge__") {
        return 1;
    }
    return -1;
}

string semanticMagicReturn(string name) {
    if (name == "__eq__" || name == "__ne__" || name == "__lt__"
            || name == "__gt__" || name == "__le__"
            || name == "__ge__") {
        return "bool";
    }
    if (name == "toString") { return "string"; }
    if (name == "__del__") { return "void"; }
    return "";
}

void semanticValidateArrayReturn(Node callable, string label) {
    if (callable.return_type != null && callable.return_type.is_array
            && !callable.is_gpu) {
        semanticValidationFail(label
            + " cannot return an array outside @gpu", callable);
    }
}

void semanticValidateMainShape(Node functionDecl,
        SemanticValidationState state) {
    if (functionDecl.name != "main") { return; }
    bool resultValid = semanticPlainType(
            functionDecl.return_type, "int", state)
        || semanticPlainType(functionDecl.return_type, "void", state);
    bool paramsValid = functionDecl.params.len == 0;
    if (semanticPlainType(functionDecl.return_type, "int", state)
            && functionDecl.params.len == 2) {
        Node argc = semanticResolveAliases(
            functionDecl.params.get(0).type, state);
        Node argv = semanticResolveAliases(
            functionDecl.params.get(1).type, state);
        int argvDepth = argv.pointer_depth;
        if (argv.is_array) { argvDepth = argvDepth + 1; }
        paramsValid = argc.base == "int" && argc.pointer_depth == 0
            && !argc.is_array && argc.generic_args.len == 0
            && argv.base == "char" && argvDepth == 2
            && argv.generic_args.len == 0;
    }
    if (!resultValid || !paramsValid || functionDecl.is_gpu) {
        semanticValidationFail(
            "main must be 'int main()', 'int main(int, char**)', or 'void main()'",
            functionDecl);
    }
}

void semanticValidateConstructorShape(
        Node classDeclaration, Node method) {
    string label = "Constructor '" + classDeclaration.name + "'";
    if (method.name != classDeclaration.name) {
        semanticValidationFail(label + " must be named '"
            + classDeclaration.name + "'", method);
    }
    if (method.access == "class") {
        semanticValidationFail(label + " cannot be class/static", method);
    }
    if (method.is_abstract) {
        semanticValidationFail(label + " cannot be abstract", method);
    }
    if (method.is_gpu) {
        semanticValidationFail(label + " cannot be @gpu", method);
    }
    if (method.keep_return) {
        semanticValidationFail(label + " cannot use keep-return", method);
    }
    if (method.body_node == null) {
        semanticValidationFail(label + " requires a concrete body", method);
    }
    if (method.generic_params.len > 0) {
        semanticValidationFail(label + " cannot be generic", method);
    }
}

void semanticValidateMagicShape(
        Node classDeclaration, Node method,
        SemanticValidationState state) {
    int arity = semanticMagicArity(method.name);
    if (arity < 0) { return; }
    string label = "Magic method '" + classDeclaration.name
        + "." + method.name + "'";
    if (method.access == "class") {
        semanticValidationFail(label
            + " must be an instance method", method);
    }
    if (method.is_abstract || method.body_node == null) {
        semanticValidationFail(label
            + " requires a concrete body", method);
    }
    if (method.generic_params.len > 0) {
        semanticValidationFail(label + " cannot be generic", method);
    }
    if (method.params.len != arity) {
        semanticValidationFail(label + " expects "
            + Strings.fromInt(arity) + " explicit parameter(s) but got "
            + Strings.fromInt(method.params.len), method);
    }
    string requiredReturn = semanticMagicReturn(method.name);
    if (requiredReturn != ""
            && !semanticPlainType(
                method.return_type, requiredReturn, state)) {
        semanticValidationFail(label + " must return '"
            + requiredReturn + "'", method);
    }
}

void semanticValidateClassCallableShapes(Node classDeclaration,
        SemanticValidationState state) {
    int index = 0;
    while (index < classDeclaration.members.len) {
        Node member = classDeclaration.members.get(index);
        if (member.kind == NK_METHOD_DECL) {
            string label = "Method '" + classDeclaration.name
                + "." + member.name + "'";
            semanticValidateArrayReturn(member, label);
            if (member.is_constructor) {
                semanticValidateConstructorShape(classDeclaration, member);
            } else {
                if (member.name == classDeclaration.name) {
                    if (member.return_type.base != classDeclaration.name) {
                        semanticValidationFail("Constructor '"
                            + classDeclaration.name
                            + "' cannot have return type '"
                            + semanticFormatType(member.return_type) + "'",
                            member);
                    }
                    semanticValidationFail("Method '" + classDeclaration.name
                        + "." + member.name
                        + "' uses explicit-return constructor syntax", member);
                }
                if (member.is_abstract && !classDeclaration.is_abstract) {
                    semanticValidationFail("Abstract " + label
                        + " requires an abstract class", member);
                }
                if (!member.is_abstract && member.body_node == null) {
                    semanticValidationFail("Concrete " + label
                        + " requires a body", member);
                }
                semanticValidateMagicShape(
                    classDeclaration, member, state);
            }
        }
        index = index + 1;
    }
}

void semanticValidateCallableShapes(
        Node program, SemanticValidationState state) {
    int index = 0;
    while (index < program.declarations.len) {
        Node declaration = program.declarations.get(index);
        if (declaration.kind == NK_FUNCTION_DECL) {
            semanticValidateArrayReturn(declaration,
                "Function '" + declaration.name + "'");
            semanticValidateMainShape(declaration, state);
        } else if (declaration.kind == NK_CLASS_DECL) {
            semanticValidateClassCallableShapes(declaration, state);
        }
        index = index + 1;
    }
}
