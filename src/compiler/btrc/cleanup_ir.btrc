/* Typed identity attached to one automatic cleanup slot and its registration. */

class IRCleanupSlot {
    public int site;
    public string name;
    public string c_type;
    public string take_function;

    public IRCleanupSlot(int site, string name, string cType,
            string takeFunction) {
        self.site = site;
        self.name = name;
        self.c_type = cType;
        self.take_function = takeFunction;
    }
}
