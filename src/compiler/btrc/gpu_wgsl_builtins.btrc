/* Closed WGSL builtin vocabulary and type families. */

void gpuValidateBinaryTypes(Node expression, string left, string right) {
    string op = expression.op;
    if (op == "%" && (left != "int" || right != "int")) {
        gpuLoweringFail(expression,
            "GPU remainder operator requires integer operands");
    }
    if ((op == "<<" || op == ">>")
            && (left != "int" || right != "int")) {
        gpuLoweringFail(expression,
            "GPU shift operators require integer operands");
    }
    if (op == "&" || op == "|" || op == "^") {
        if (left != right || (left != "int" && left != "bool")) {
            gpuLoweringFail(expression,
                "GPU bitwise operators require matching int or bool operands");
        }
    }
}
