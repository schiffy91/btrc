/* Standard-C single-evaluation boundaries for owned expression operands. */

class OwnershipBoundary {
    public Vector<IRNode> declarations;
    public Vector<IRNode> prefix;
    public Vector<IRNode> handoffs;
    public Vector<IRNode> suffix;
    public Vector<string> overrideKeys;
    public Vector<int> overrideHadValues;
    public Vector<IRNode> overridePreviousValues;
    public bool resultOwned;

    public OwnershipBoundary() {
        self.declarations = [];
        self.prefix = [];
        self.handoffs = [];
        self.suffix = [];
        self.overrideKeys = [];
        self.overrideHadValues = [];
        self.overridePreviousValues = [];
        self.resultOwned = false;
    }

    public void rememberOverride(IRGen generator, Node expression,
            IRNode value) {
        string key = astNodeKey(expression);
        self.overrideKeys.push(key);
        if (generator.owningTempOverrides.has(key)) {
            self.overrideHadValues.push(1);
            self.overridePreviousValues.push(
                generator.owningTempOverrides.get(key));
        } else {
            self.overrideHadValues.push(0);
            self.overridePreviousValues.push(irLiteral("0"));
        }
        generator.owningTempOverrides.put(key, value);
    }

    public void registerCleanup(IRGen generator, IRNode declaration,
            string name, string runtimeType) {
        if (!generator.programHasExceptions) { return; }
        if (declaration.name != name) {
            cleanupSlotContractFail(
                "cleanup declaration/name mismatch: " + name);
        }
        generator.markCleanupRegistration();
        string cleanupSymbol = irManagedCleanupSymbol(
            generator, runtimeType);
        if (runtimeType == irManagedStringRuntimeType()) {
            self.prefix.push(registerCleanupSlot(generator, declaration,
                irFunctionRef(cleanupSymbol), null, true));
            return;
        }
        IRNode visitor = irLiteral("NULL");
        string visitorSymbol = managedVisitorSymbol(
            generator, runtimeType);
        if (irManagedRuntimeCanCycle(generator, runtimeType)
                && visitorSymbol != "") {
            visitor = irFunctionRef(visitorSymbol);
        }
        self.prefix.push(registerCleanupSlot(generator, declaration,
            irFunctionRef(cleanupSymbol), visitor, false));
    }

    public void addOperand(IRGen generator, Node expression, Node typeExpr,
            bool owned, bool keepValue, Map<string, Node> varTypes) {
        self.addLoweredOperand(generator, expression, typeExpr,
            generator.lowerExpr(expression, varTypes), owned, keepValue);
    }

    public void addCallOperand(IRGen generator, Node expression,
            Node typeExpr, bool owned, bool keepValue, bool transferred,
            Map<string, Node> varTypes) {
        self.addLoweredCallOperand(generator, expression, typeExpr,
            generator.lowerExpr(expression, varTypes), owned, keepValue,
            transferred);
    }

    public void addLoweredOperand(IRGen generator, Node expression,
            Node typeExpr, IRNode lowered, bool owned, bool keepValue) {
        self.addLoweredCallOperand(generator, expression, typeExpr,
            lowered, owned, keepValue, false);
    }

    public void addLoweredCallOperand(IRGen generator, Node expression,
            Node typeExpr, IRNode lowered, bool owned, bool keepValue,
            bool transferred) {
        string runtimeType = "";
        if (irManagedType(generator, typeExpr)) {
            runtimeType = irManagedRuntimeType(generator, typeExpr);
        }
        string name = generator.freshTemp("__btrc_operand");
        IRNode declaration = irVarDecl(
            ownershipOperandCType(generator, expression, typeExpr),
            name, null);
        self.declarations.push(declaration);
        generator.funcVarDecls.push(declaration);
        IRNode value = irVar(name);
        self.prefix.push(irBinOp(value, "=", lowered));
        IRNode callValue = value;

        if (owned && runtimeType != "") {
            self.registerCleanup(
                generator, declaration, name, runtimeType);
            if (!transferred) {
                self.appendReleaseAndClear(
                    generator, value, typeExpr, runtimeType);
            } else {
                string handoffName = generator.freshTemp(
                    "__btrc_transferred_operand");
                IRNode handoffDeclaration = irVarDecl(
                    typeToC(typeExpr, generator.analyzed),
                    handoffName, irLiteral("NULL"));
                self.declarations.push(handoffDeclaration);
                generator.funcVarDecls.push(handoffDeclaration);
                callValue = irVar(handoffName);
                self.handoffs.push(irBinOp(
                    callValue, "=", value));
                self.handoffs.push(irBinOp(
                    value, "=", irLiteral("NULL")));
            }
        }
        if (keepValue && runtimeType != "") {
            string keptName = generator.freshTemp("__btrc_kept_operand");
            IRNode keptDeclaration = irVarDecl(
                typeToC(typeExpr, generator.analyzed), keptName, null);
            self.declarations.push(keptDeclaration);
            generator.funcVarDecls.push(keptDeclaration);
            IRNode kept = irVar(keptName);
            self.prefix.push(irRetainExpression(
                generator, value, typeExpr));
            self.prefix.push(irBinOp(kept, "=", value));
            self.registerCleanup(
                generator, keptDeclaration, keptName, runtimeType);
            self.appendReleaseAndClear(
                generator, kept, typeExpr, runtimeType);
        }
        self.rememberOverride(generator, expression, callValue);
    }

    public void appendReleaseAndClear(IRGen generator, IRNode value,
            Node typeExpr, string runtimeType) {
        string savedName = generator.freshTemp(
            "__btrc_released_operand");
        IRNode savedDeclaration = irVarDecl(
            typeToC(typeExpr, generator.analyzed),
            savedName, irLiteral("NULL"));
        self.declarations.push(savedDeclaration);
        generator.funcVarDecls.push(savedDeclaration);
        IRNode saved = irVar(savedName);
        self.suffix.push(irBinOp(saved, "=", value));
        self.suffix.push(irBinOp(
            value, "=", irLiteral("NULL")));
        self.suffix.push(generator.optionalReleaseExpr(
            saved, runtimeType));
    }

    public void restore(IRGen generator) {
        int index = self.overrideKeys.len - 1;
        while (index >= 0) {
            string key = self.overrideKeys.get(index);
            if (self.overrideHadValues.get(index) != 0) {
                generator.owningTempOverrides.put(
                    key, self.overridePreviousValues.get(index));
            } else {
                generator.owningTempOverrides.remove(key);
            }
            index = index - 1;
        }
    }

    public IRNode finish(IRGen generator, IRNode expression,
            Node? resultType, bool promoteResult) {
        Vector<IRNode> sequence = self.prefix;
        int handoffIndex = 0;
        while (handoffIndex < self.handoffs.len) {
            sequence.push(self.handoffs.get(handoffIndex));
            handoffIndex = handoffIndex + 1;
        }
        bool isVoid = resultType != null
            && resultType.base == "void"
            && resultType.pointer_depth == 0;
        if (isVoid) {
            sequence.push(expression);
            int suffixIndex = 0;
            while (suffixIndex < self.suffix.len) {
                sequence.push(self.suffix.get(suffixIndex));
                suffixIndex = suffixIndex + 1;
            }
            sequence.push(irCast("void", irLiteral("0")));
            return irStmtExpr(self.declarations, irCommaExpr(sequence));
        }
        string resultC = "int";
        if (resultType != null) {
            resultC = typeToC(resultType, generator.analyzed);
        }
        string resultName = generator.freshTemp("__btrc_boundary_result");
        IRNode resultDeclaration = irVarDecl(
            resultC, resultName, null);
        /* GCC tracks this compiler-generated object across a later setjmp even
         * when its source expression block has ended. */
        resultDeclaration.is_volatile = true;
        self.declarations.push(resultDeclaration);
        generator.funcVarDecls.push(resultDeclaration);
        IRNode result = irVar(resultName);
        sequence.push(irBinOp(result, "=", expression));
        if (promoteResult && resultType != null
                && irManagedType(generator, resultType)) {
            sequence.push(irRetainExpression(
                generator, result, resultType));
        }
        bool protectResult = generator.programHasExceptions
            && resultType != null
            && irManagedType(generator, resultType)
            && (self.resultOwned || promoteResult);
        if (protectResult) {
            generator.markCleanupRegistration();
            string runtimeType = irManagedRuntimeType(
                generator, resultType);
            string cleanupSymbol = irManagedCleanupSymbol(
                generator, runtimeType);
            IRNode visitor = null;
            bool direct = runtimeType == irManagedStringRuntimeType();
            if (!direct) {
                string visitorSymbol = managedVisitorSymbol(
                    generator, runtimeType);
                visitor = irLiteral("NULL");
                if (visitorSymbol != "") {
                    visitor = irFunctionRef(visitorSymbol);
                }
            }
            sequence.push(registerCleanupSlot(
                generator, resultDeclaration,
                irFunctionRef(cleanupSymbol), visitor, direct));
        }
        int suffixIndex = 0;
        while (suffixIndex < self.suffix.len) {
            sequence.push(self.suffix.get(suffixIndex));
            suffixIndex = suffixIndex + 1;
        }
        if (protectResult) {
            string handoffName = generator.freshTemp(
                "__btrc_boundary_result_handoff");
            IRNode handoffDeclaration = irVarDecl(
                resultC, handoffName, irLiteral("NULL"));
            self.declarations.push(handoffDeclaration);
            generator.funcVarDecls.push(handoffDeclaration);
            IRNode handoff = irVar(handoffName);
            sequence.push(irBinOp(handoff, "=", result));
            sequence.push(irBinOp(
                result, "=", irLiteral("NULL")));
            sequence.push(handoff);
        } else {
            sequence.push(result);
        }
        return irStmtExpr(self.declarations, irCommaExpr(sequence));
    }
}

void ownershipRequireType(Node? typeExpr, Node expression) {
    if (typeExpr != null) { return; }
    fprintf(stderr, "error: managed ownership boundary at %d:%d requires a concrete type\n",
        expression.line, expression.col);
    abortGen();
}

string ownershipOperandCType(
        IRGen generator, Node expression, Node typeExpr) {
    if (expression.kind == NK_IDENTIFIER
            && generator.analyzed.isEnumValue(expression.name)) {
        return "int";
    }
    return typeToC(typeExpr, generator.analyzed);
}

bool ownershipExpressionHasEffect(IRGen generator, Node? expression,
        Map<string, Node> varTypes) {
    if (expression == null) { return false; }
    int kind = expression.kind;
    if (kind == NK_IDENTIFIER) {
        return generator.resolvedExpressionType(
            expression, varTypes) == null;
    }
    if (kind == NK_ASSIGN_EXPR || kind == NK_CALL_EXPR
            || kind == NK_NEW_EXPR || kind == NK_SPAWN_EXPR
            || kind == NK_F_STRING_LITERAL || kind == NK_LIST_LITERAL
            || kind == NK_MAP_LITERAL || kind == NK_BRACE_INITIALIZER
            || kind == NK_LAMBDA_EXPR) {
        return true;
    }
    if (kind == NK_UNARY_EXPR) {
        return expression.op == "++" || expression.op == "--"
            || ownershipExpressionHasEffect(
                generator, expression.operand, varTypes);
    }
    if (kind == NK_BINARY_EXPR) {
        return ownershipExpressionHasEffect(
                generator, expression.left, varTypes)
            || ownershipExpressionHasEffect(
                generator, expression.right, varTypes);
    }
    if (kind == NK_TERNARY_EXPR) {
        return ownershipExpressionHasEffect(
                generator, expression.condition, varTypes)
            || ownershipExpressionHasEffect(
                generator, expression.true_expr, varTypes)
            || ownershipExpressionHasEffect(
                generator, expression.false_expr, varTypes);
    }
    if (kind == NK_CAST_EXPR) {
        return ownershipExpressionHasEffect(
            generator, expression.expr, varTypes);
    }
    if (kind == NK_FIELD_ACCESS_EXPR) {
        if (expression.optional || ownershipExpressionHasEffect(
                generator, expression.obj, varTypes)) {
            return true;
        }
        Node? receiverType = generator.resolvedExpressionType(
            expression.obj, varTypes);
        Node? member = instanceMemberForType(
            generator.analyzed, receiverType, expression.field);
        return member != null && member.kind == NK_PROPERTY_DECL;
    }
    if (kind == NK_INDEX_EXPR) {
        if (ownershipExpressionHasEffect(
                    generator, expression.obj, varTypes)
                || ownershipExpressionHasEffect(
                    generator, expression.index, varTypes)) {
            return true;
        }
        Node? receiverType = generator.resolvedExpressionType(
            expression.obj, varTypes);
        if (receiverType == null) { return false; }
        return !semanticRawIndexedPointer(receiverType, generator.analyzed)
            && semanticValidIndexedGetter(
                semanticIndexedMethod(
                    receiverType, "get", generator.analyzed));
    }
    return false;
}

bool ownershipExpressionReorderInert(IRGen generator,
        Node expression) {
    int kind = expression.kind;
    if (kind == NK_INT_LITERAL || kind == NK_FLOAT_LITERAL
            || kind == NK_STRING_LITERAL || kind == NK_CHAR_LITERAL
            || kind == NK_BOOL_LITERAL || kind == NK_NULL_LITERAL) {
        return true;
    }
    if (kind == NK_CAST_EXPR) {
        return ownershipExpressionReorderInert(
            generator, expression.expr);
    }
    if (kind == NK_SIZEOF_EXPR) { return true; }
    if (kind == NK_UNARY_EXPR && (expression.op == "+"
            || expression.op == "-" || expression.op == "!"
            || expression.op == "~")) {
        return ownershipExpressionReorderInert(
            generator, expression.operand);
    }
    return kind == NK_IDENTIFIER
        && generator.analyzed.isEnumValue(expression.name);
}

IRNode lowerOwnedFieldAccess(IRGen generator, Node expression,
        Map<string, Node> varTypes) {
    bool receiverOwned = irUnconsumedOwnedResult(
        generator, expression.obj, varTypes);
    Node? receiverType = generator.resolvedExpressionType(
        expression.obj, varTypes);
    bool receiverPinned = !receiverOwned
        && irManagedType(generator, receiverType)
        && irPropertyGetterProjection(
            generator, expression, varTypes);
    if (!receiverOwned && !receiverPinned) {
        return generator.lowerFieldAccessCore(expression, varTypes);
    }
    ownershipRequireType(receiverType, expression.obj);
    OwnershipBoundary boundary = OwnershipBoundary();
    boundary.addOperand(generator, expression.obj,
        receiverType, receiverOwned, receiverPinned, varTypes);
    IRNode lowered = generator.lowerFieldAccessCore(
        expression, varTypes);
    boundary.restore(generator);
    Node? resultType = generator.resolvedExpressionType(
        expression, varTypes);
    return boundary.finish(generator, lowered, resultType,
        irManagedType(generator, resultType));
}

IRNode lowerOwnedIndex(IRGen generator, Node expression,
        Map<string, Node> varTypes) {
    bool objectOwned = irUnconsumedOwnedResult(
        generator, expression.obj, varTypes);
    bool indexOwned = irUnconsumedOwnedResult(
        generator, expression.index, varTypes);
    Node? objectType = generator.resolvedExpressionType(
        expression.obj, varTypes);
    Node? indexType = generator.resolvedExpressionType(
        expression.index, varTypes);
    Node? getter = null;
    if (objectType != null
            && !semanticRawIndexedPointer(
                objectType, generator.analyzed)) {
        getter = semanticIndexedMethod(
            objectType, "get", generator.analyzed);
    }
    bool sourceGetter = semanticValidIndexedGetter(getter);
    Node? expectedIndexType = indexType;
    if (sourceGetter) {
        Node concreteGetter = getter;
        expectedIndexType = semanticResolvedIndexedType(
            concreteGetter.params.get(0).type,
            objectType, generator.analyzed);
    }
    bool indexConverted = sourceGetter
        && requiresTargetStringConversion(
            generator, expectedIndexType, indexType);
    bool objectPinned = !objectOwned && sourceGetter
        && irManagedType(generator, objectType)
        && expression.obj.kind != NK_SELF_EXPR
        && expression.obj.kind != NK_SUPER_EXPR;
    if (!objectOwned && !objectPinned && !indexOwned
            && !indexConverted) {
        return generator.lowerIndexCore(expression, varTypes);
    }
    OwnershipBoundary boundary = OwnershipBoundary();
    ownershipRequireType(objectType, expression.obj);
    boundary.addOperand(generator, expression.obj,
        objectType, objectOwned, objectPinned, varTypes);
    if (indexConverted) {
        PreparedValue preparedIndex = prepareCallTargetValue(
            generator, expression.index,
            expectedIndexType, varTypes);
        ownershipRequireType(
            preparedIndex.effectiveType, expression.index);
        Node effectiveIndexType = preparedIndex.effectiveType;
        boundary.addLoweredCallOperand(generator,
            expression.index, effectiveIndexType,
            preparedIndex.value, preparedIndex.owned,
            false, false);
    } else {
        ownershipRequireType(indexType, expression.index);
        boundary.addOperand(generator, expression.index,
            indexType, indexOwned, false, varTypes);
    }
    IRNode lowered = generator.lowerIndexCore(expression, varTypes);
    boundary.restore(generator);
    Node? resultType = generator.resolvedExpressionType(
        expression, varTypes);
    boundary.resultOwned = sourceGetter
        && irManagedType(generator, resultType);
    return boundary.finish(generator, lowered, resultType,
        irManagedType(generator, resultType) && !sourceGetter);
}

IRNode lowerOwnedBinary(IRGen generator, Node expression,
        Map<string, Node> varTypes) {
    IRNode? flattened = lowerLongStringConcat(
        generator, expression, varTypes);
    if (flattened != null) { return flattened; }
    if (expression.op == "??" || expression.op == "&&"
            || expression.op == "||") {
        return generator.lowerBinaryCore(expression, varTypes);
    }
    bool leftOwned = irUnconsumedOwnedResult(
        generator, expression.left, varTypes);
    Node? leftType = generator.resolvedExpressionType(
        expression.left, varTypes);
    Node? rightType = generator.resolvedExpressionType(
        expression.right, varTypes);
    Node? overload = ownershipBinaryMethod(
        generator, leftType, expression.op);
    Node? rightTargetType = rightType;
    if (overload != null && overload.params.len > 0) {
        rightTargetType = generator.resolveBodyType(
            overload.params.get(0).type);
        if (leftType != null && leftType.generic_args.len > 0
                && generator.analyzed.isGenericClass(leftType.base)) {
            rightTargetType = resolveGenericType(
                overload.params.get(0).type,
                genericTypeMap(generator.analyzed, leftType),
                generator.analyzed);
        }
    }
    bool rightOwned = irContextualUnconsumedOwnedResult(
        generator, expression.right, rightTargetType, varTypes);
    bool rightConverted = requiresTargetStringConversion(
        generator, rightTargetType, rightType);
    bool leftPinned = !leftOwned
        && irManagedType(generator, leftType)
        && (overload != null || ownershipExpressionHasEffect(
            generator, expression.right, varTypes));
    bool rightKeep = leftType != null && rightType != null
        && irManagedType(generator, rightType)
        && irManagedCompoundKeepsRhs(
            generator, leftType, expression.op);
    bool lifetimeRequired = leftOwned || rightOwned || rightConverted
        || leftPinned || rightKeep;
    bool leftEffect = ownershipExpressionHasEffect(
        generator, expression.left, varTypes);
    bool rightEffect = ownershipExpressionHasEffect(
        generator, expression.right, varTypes);
    bool orderingRequired = (leftEffect
            && !ownershipExpressionReorderInert(
                generator, expression.right))
        || (rightEffect && !ownershipExpressionReorderInert(
                generator, expression.left));
    if (!lifetimeRequired && !orderingRequired) {
        return generator.lowerBinaryCore(expression, varTypes);
    }
    if (leftType == null) {
        opaqueOperandOrderFail(expression.left,
            "operator '" + expression.op + "'", false);
    }
    ownershipRequireType(leftType, expression.left);
    OwnershipBoundary boundary = OwnershipBoundary();
    boundary.addOperand(generator, expression.left,
        leftType, leftOwned, leftPinned, varTypes);
    if (rightType != null || rightTargetType != null) {
        PreparedValue prepared = prepareCallTargetValue(
            generator, expression.right,
            rightTargetType, varTypes);
        ownershipRequireType(
            prepared.effectiveType, expression.right);
        Node effectiveType = prepared.effectiveType;
        boundary.addLoweredOperand(generator, expression.right,
            effectiveType, prepared.value,
            prepared.owned, rightKeep);
    }
    IRNode lowered = generator.lowerBinaryCore(expression, varTypes);
    boundary.resultOwned = irExpressionOwnsResult(
        generator, expression, varTypes);
    boundary.restore(generator);
    return boundary.finish(generator, lowered,
        generator.resolvedExpressionType(expression, varTypes), false);
}

Node? ownershipBinaryMethod(
        IRGen generator, Node? leftType, string op) {
    if (leftType == null) { return null; }
    string magic = semanticBinaryOperatorMethod(op);
    if (magic == "") { return null; }
    if (generator.analyzed.isClass(leftType.base)) {
        return generator.analyzed.classMethod(leftType.base, magic);
    }
    if (generator.analyzed.isGenericClass(leftType.base)) {
        return generator.analyzed.genericClassMethod(
            leftType.base, magic);
    }
    return null;
}
