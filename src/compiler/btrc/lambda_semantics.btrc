/* Pure lambda return discovery shared by inference, validation, and lowering. */

Node lambdaVoidType() { return makePrimType("void"); }

Node? inferredLambdaReturnInStatement(
        Node statement, Analyzed analyzed, Map<string, Node> vars);

Node? inferredLambdaReturnInBlock(
        Node? block, Analyzed analyzed, Map<string, Node> outerVars) {
    if (block == null) { return null; }
    Map<string, Node> vars = semanticCloneTypes(outerVars);
    int index = 0;
    while (index < block.statements.len) {
        Node statement = block.statements.get(index);
        if (statement.kind == NK_VAR_DECL_STMT) {
            Node? localType = statement.type;
            if (localType == null) {
                localType = inferType(
                    statement.initializer, analyzed, vars);
            }
            if (localType != null) {
                vars.put(statement.name, localType);
            }
        }
        Node? found = inferredLambdaReturnInStatement(
            statement, analyzed, vars);
        if (found != null) { return found; }
        index = index + 1;
    }
    return null;
}

Node? inferredLambdaReturnInElse(
        Node? elseNode, Analyzed analyzed, Map<string, Node> vars) {
    if (elseNode == null) { return null; }
    if (elseNode.kind == NK_ELSE_BLOCK) {
        return inferredLambdaReturnInBlock(
            elseNode.body_node, analyzed, vars);
    }
    if (elseNode.kind == NK_ELSE_IF) {
        return inferredLambdaReturnInStatement(
            elseNode.if_stmt, analyzed, vars);
    }
    return null;
}

Node? inferredLambdaReturnInStatement(
        Node statement, Analyzed analyzed, Map<string, Node> vars) {
    if (statement.kind == NK_RETURN_STMT) {
        if (statement.value_node == null) { return lambdaVoidType(); }
        return inferType(statement.value_node, analyzed, vars);
    }
    if (statement.kind == NK_BLOCK) {
        return inferredLambdaReturnInBlock(statement, analyzed, vars);
    }
    if (statement.kind == NK_IF_STMT) {
        Node? found = inferredLambdaReturnInBlock(
            statement.then_block, analyzed, vars);
        if (found != null) { return found; }
        return inferredLambdaReturnInElse(
            statement.else_block, analyzed, vars);
    }
    if (statement.kind == NK_WHILE_STMT
            || statement.kind == NK_DO_WHILE_STMT
            || statement.kind == NK_PARALLEL_FOR_STMT) {
        return inferredLambdaReturnInBlock(
            statement.body_node, analyzed, vars);
    }
    if (statement.kind == NK_FOR_IN_STMT) {
        Map<string, Node> loopVars = semanticCloneTypes(vars);
        Node loopType = makePrimType("int");
        if (!semanticIsRangeForm(statement.iterable)) {
            Node? iterable = inferType(statement.iterable, analyzed, vars);
            if (isStringType(iterable)) {
                loopType = makePrimType("char");
            } else if (iterable != null) {
                Node? method = semanticIterableMethod(
                    iterable, "iterGet", analyzed);
                if (method != null) {
                    loopType = semanticIterableResolvedType(
                        method.return_type, iterable, analyzed);
                }
            }
        }
        loopVars.put(statement.var_name, loopType);
        return inferredLambdaReturnInBlock(
            statement.body_node, analyzed, loopVars);
    }
    if (statement.kind == NK_C_FOR_STMT) {
        Map<string, Node> loopVars = semanticCloneTypes(vars);
        if (statement.init != null
                && statement.init.kind == NK_FOR_INIT_VAR) {
            Node declaration = statement.init.var_decl;
            Node? declared = declaration.type;
            if (declared == null) {
                declared = inferType(
                    declaration.initializer, analyzed, loopVars);
            }
            if (declared != null) {
                loopVars.put(declaration.name, declared);
            }
        }
        return inferredLambdaReturnInBlock(
            statement.body_node, analyzed, loopVars);
    }
    if (statement.kind == NK_SWITCH_STMT) {
        int caseIndex = 0;
        while (caseIndex < statement.cases.len) {
            Node caseClause = statement.cases.get(caseIndex);
            int bodyIndex = 0;
            while (bodyIndex < caseClause.body_nlist.len) {
                Node? found = inferredLambdaReturnInStatement(
                    caseClause.body_nlist.get(bodyIndex), analyzed, vars);
                if (found != null) { return found; }
                bodyIndex = bodyIndex + 1;
            }
            caseIndex = caseIndex + 1;
        }
    }
    if (statement.kind == NK_TRY_CATCH_STMT) {
        Node? found = inferredLambdaReturnInBlock(
            statement.try_block, analyzed, vars);
        if (found != null) { return found; }
        found = inferredLambdaReturnInBlock(
            statement.catch_block, analyzed, vars);
        if (found != null) { return found; }
        return inferredLambdaReturnInBlock(
            statement.finally_block, analyzed, vars);
    }
    return null;
}

Node inferredLambdaReturnType(
        Node lambda, Analyzed analyzed, Map<string, Node> outerVars) {
    if (lambda.return_type != null) { return lambda.return_type; }
    Map<string, Node> vars = semanticCloneTypes(outerVars);
    int index = 0;
    while (index < lambda.params.len) {
        Node parameter = lambda.params.get(index);
        if (parameter.type != null) {
            vars.put(parameter.name, parameter.type);
        }
        index = index + 1;
    }
    Node body = lambda.body_node;
    if (body != null && body.kind == NK_LAMBDA_EXPR_BODY) {
        Node? expressionType = inferType(
            body.expression, analyzed, vars);
        if (expressionType != null) { return expressionType; }
        return lambdaVoidType();
    }
    if (body != null && body.kind == NK_LAMBDA_BLOCK) {
        Node? found = inferredLambdaReturnInBlock(
            body.body_node, analyzed, vars);
        if (found != null) { return found; }
    }
    return lambdaVoidType();
}
