/* Stable AST identity/rendering plus recursive type identity and C symbols. */

import std.map;
import std.strings;
import std.vector;

import ../generated/ast/node.btrc;
#include <stdint.h>

class AstIdentity {
	/* Source positions are not unique for chained expressions. The self-host
     * runtime gives class values stable pointer identity, so side tables use
     * that identity directly. */
	class string key(Node node) { return f"{(unsigned long long)(uintptr_t)node}"; }
}

class AstCanonicalRenderer {
	public AstCanonicalRenderer() {}

	public string render(Node node) { return self.renderAtDepth(node, 0); }

	private string renderAtDepth(Node node, int d) {
		if (node.kind == NK_PROGRAM) {
			string out = "(Program";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "declarations=" + self.canonNodeList(node.declarations, d + 1);
			return out + ")";
		} else if (node.kind == NK_PREPROCESSOR_DIRECTIVE) {
			string out = "(PreprocessorDirective";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "text=" + self.canonStr(node.text);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "source_file=" + self.canonOptStr(node.source_file);
			return out + ")";
		} else if (node.kind == NK_IMPORT_DECL) {
			string out = "(ImportDecl";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "spec=" + self.canonNode(node.spec, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "source_file=" + self.canonOptStr(node.source_file);
			return out + ")";
		} else if (node.kind == NK_CLASS_DECL) {
			string out = "(ClassDecl";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "generic_params=" + self.canonStrList(node.generic_params, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "members=" + self.canonNodeList(node.members, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "parent=" + self.canonOptStr(node.parent);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "interfaces=" + self.canonStrList(node.interfaces, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_abstract=" + self.canonBool(node.is_abstract);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_line=" + self.canonInt(node.name_line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_col=" + self.canonInt(node.name_col);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "source_file=" + self.canonOptStr(node.source_file);
			return out + ")";
		} else if (node.kind == NK_INTERFACE_DECL) {
			string out = "(InterfaceDecl";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "methods=" + self.canonNodeList(node.methods, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "parent=" + self.canonOptStr(node.parent);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "generic_params=" + self.canonStrList(node.generic_params, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_line=" + self.canonInt(node.name_line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_col=" + self.canonInt(node.name_col);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "source_file=" + self.canonOptStr(node.source_file);
			return out + ")";
		} else if (node.kind == NK_FUNCTION_DECL) {
			string out = "(FunctionDecl";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "return_type=" + self.canonNode(node.return_type, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "params=" + self.canonNodeList(node.params, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "body=" + self.canonNode(node.body_node, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_gpu=" + self.canonBool(node.is_gpu);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_realtime=" + self.canonBool(node.is_realtime);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "keep_return=" + self.canonBool(node.keep_return);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_line=" + self.canonInt(node.name_line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_col=" + self.canonInt(node.name_col);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "source_file=" + self.canonOptStr(node.source_file);
			return out + ")";
		} else if (node.kind == NK_STRUCT_DECL) {
			string out = "(StructDecl";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "fields=" + self.canonNodeList(node.fields, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_forward=" + self.canonBool(node.is_forward);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_line=" + self.canonInt(node.name_line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_col=" + self.canonInt(node.name_col);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "source_file=" + self.canonOptStr(node.source_file);
			return out + ")";
		} else if (node.kind == NK_ENUM_DECL) {
			string out = "(EnumDecl";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "values=" + self.canonNodeList(node.values, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_line=" + self.canonInt(node.name_line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_col=" + self.canonInt(node.name_col);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "source_file=" + self.canonOptStr(node.source_file);
			return out + ")";
		} else if (node.kind == NK_RICH_ENUM_DECL) {
			string out = "(RichEnumDecl";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "variants=" + self.canonNodeList(node.variants, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_line=" + self.canonInt(node.name_line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_col=" + self.canonInt(node.name_col);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "source_file=" + self.canonOptStr(node.source_file);
			return out + ")";
		} else if (node.kind == NK_TYPEDEF_DECL) {
			string out = "(TypedefDecl";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "original=" + self.canonNode(node.original, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "alias=" + self.canonStr(node.alias);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_line=" + self.canonInt(node.name_line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_col=" + self.canonInt(node.name_col);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "source_file=" + self.canonOptStr(node.source_file);
			return out + ")";
		} else if (node.kind == NK_STD_GLOB) {
			string out = "(StdGlob";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "recursive=" + self.canonBool(node.recursive);
			return out + ")";
		} else if (node.kind == NK_STD_MODULES) {
			string out = "(StdModules";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "names=" + self.canonStrList(node.names, d + 1);
			return out + ")";
		} else if (node.kind == NK_PACKAGE_PATH) {
			string out = "(PackagePath";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "segments=" + self.canonStrList(node.segments, d + 1);
			return out + ")";
		} else if (node.kind == NK_RELATIVE_PATH) {
			string out = "(RelativePath";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "path=" + self.canonStr(node.path);
			return out + ")";
		} else if (node.kind == NK_QUOTED_PATH) {
			string out = "(QuotedPath";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "path=" + self.canonStr(node.path);
			return out + ")";
		} else if (node.kind == NK_TYPE_EXPR) {
			string out = "(TypeExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "base=" + self.canonStr(node.base);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "generic_args=" + self.canonNodeList(node.generic_args, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "pointer_depth=" + self.canonInt(node.pointer_depth);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_array=" + self.canonBool(node.is_array);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "array_size=" + self.canonNode(node.array_size, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_const=" + self.canonBool(node.is_const);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_nullable=" + self.canonBool(node.is_nullable);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "nullable_outer_depth=" + self.canonInt(node.nullable_outer_depth);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_static=" + self.canonBool(node.is_static);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_extern=" + self.canonBool(node.is_extern);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_volatile=" + self.canonBool(node.is_volatile);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col);
			return out + ")";
		} else if (node.kind == NK_PARAM) {
			string out = "(Param";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "type=" + self.canonNode(node.type, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "default=" + self.canonNode(node.default_, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "keep=" + self.canonBool(node.keep_);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_line=" + self.canonInt(node.name_line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_col=" + self.canonInt(node.name_col);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col);
			return out + ")";
		} else if (node.kind == NK_FIELD_DECL) {
			string out = "(FieldDecl";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "access=" + self.canonStr(node.access);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "type=" + self.canonNode(node.type, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "initializer=" + self.canonNode(node.initializer, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_line=" + self.canonInt(node.name_line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_col=" + self.canonInt(node.name_col);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col);
			return out + ")";
		} else if (node.kind == NK_METHOD_DECL) {
			string out = "(MethodDecl";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "access=" + self.canonStr(node.access);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "return_type=" + self.canonNode(node.return_type, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_constructor=" + self.canonBool(node.is_constructor);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "generic_params=" + self.canonStrList(node.generic_params, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "params=" + self.canonNodeList(node.params, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "body=" + self.canonNode(node.body_node, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_gpu=" + self.canonBool(node.is_gpu);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_realtime=" + self.canonBool(node.is_realtime);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_abstract=" + self.canonBool(node.is_abstract);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "keep_return=" + self.canonBool(node.keep_return);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_line=" + self.canonInt(node.name_line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_col=" + self.canonInt(node.name_col);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col);
			return out + ")";
		} else if (node.kind == NK_PROPERTY_DECL) {
			string out = "(PropertyDecl";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "access=" + self.canonStr(node.access);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "type=" + self.canonNode(node.type, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "has_getter=" + self.canonBool(node.has_getter);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "has_setter=" + self.canonBool(node.has_setter);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "getter_body=" + self.canonNode(node.getter_body, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "setter_body=" + self.canonNode(node.setter_body, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_line=" + self.canonInt(node.name_line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_col=" + self.canonInt(node.name_col);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col);
			return out + ")";
		} else if (node.kind == NK_METHOD_SIG) {
			string out = "(MethodSig";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "return_type=" + self.canonNode(node.return_type, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "params=" + self.canonNodeList(node.params, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "keep_return=" + self.canonBool(node.keep_return);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_line=" + self.canonInt(node.name_line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_col=" + self.canonInt(node.name_col);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col);
			return out + ")";
		} else if (node.kind == NK_ENUM_VALUE) {
			string out = "(EnumValue";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "value=" + self.canonNode(node.value_node, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col);
			return out + ")";
		} else if (node.kind == NK_RICH_ENUM_VARIANT) {
			string out = "(RichEnumVariant";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "params=" + self.canonNodeList(node.params, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col);
			return out + ")";
		} else if (node.kind == NK_FIELD_DEF) {
			string out = "(FieldDef";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "type=" + self.canonNode(node.type, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col);
			return out + ")";
		} else if (node.kind == NK_BLOCK) {
			string out = "(Block";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "statements=" + self.canonNodeList(node.statements, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col);
			return out + ")";
		} else if (node.kind == NK_VAR_DECL_STMT) {
			string out = "(VarDeclStmt";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "type=" + self.canonNode(node.type, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "initializer=" + self.canonNode(node.initializer, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_line=" + self.canonInt(node.name_line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name_col=" + self.canonInt(node.name_col);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col);
			return out + ")";
		} else if (node.kind == NK_RETURN_STMT) {
			string out = "(ReturnStmt";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "value=" + self.canonNode(node.value_node, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col);
			return out + ")";
		} else if (node.kind == NK_IF_STMT) {
			string out = "(IfStmt";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "condition=" + self.canonNode(node.condition, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "then_block=" + self.canonNode(node.then_block, d + 1);
