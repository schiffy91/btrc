/* TypeExpr shape transformations and callable signature construction. */

import std.vector;

import ../generated/ast/node.btrc;

class TypeShape {
	class bool intrinsicReference(Node typeExpr) { return typeExpr.base == "Array" || typeExpr.base == "List" || typeExpr.base == "Map" || typeExpr.base == "Mutex" || typeExpr.base == "Set" || typeExpr.base == "Thread" || typeExpr.base == "Vector" || typeExpr.base == "__fn_ptr" || typeExpr.base == "__realtime_fn_ptr" || typeExpr.base == "string"; }

	class Node copyWithArguments(Node typeExpr, Vector<Node> genericArgs) {
		Node result = Node();
		result.kind = NK_TYPE_EXPR;
		result.base = typeExpr.base;
		result.generic_args = genericArgs;
		result.pointer_depth = typeExpr.pointer_depth;
		result.is_array = typeExpr.is_array;
		result.array_size = typeExpr.array_size;
		result.is_const = typeExpr.is_const;
		result.is_nullable = typeExpr.is_nullable;
		result.nullable_outer_depth = typeExpr.nullable_outer_depth;
		result.is_static = typeExpr.is_static;
		result.is_extern = typeExpr.is_extern;
		result.is_volatile = typeExpr.is_volatile;
		result.line = typeExpr.line;
		result.col = typeExpr.col;
		return result;
	}

	class Node copy(Node typeExpr) { return TypeShape.copyWithArguments(typeExpr, typeExpr.generic_args); }

	class Node copyTree(Node typeExpr) {
		Vector<Node> genericArgs = [];
		int index = 0;
		while (index < typeExpr.generic_args.len) {
			genericArgs.push(TypeShape.copyTree(typeExpr.generic_args.get(index)));
			index++;
		}
		return TypeShape.copyWithArguments(typeExpr, genericArgs);
	}

	class Node withoutOuterArray(Node typeExpr) {
		Node result = TypeShape.copy(typeExpr);
		if (result.is_array) {
			result.is_array = false;
			result.array_size = null;
			if (typeExpr.nullable_outer_depth > 0) {
				result.nullable_outer_depth = typeExpr.nullable_outer_depth - 1;
			} else if (typeExpr.is_nullable) {
				int innerStorage = typeExpr.pointer_depth + (typeExpr.is_array ? 1 : 0) - typeExpr.nullable_outer_depth;
				result.is_nullable = false;
				result.nullable_outer_depth = 0;
				if (innerStorage > 1) {
					result.pointer_depth = result.pointer_depth - 1;
				}
			}
		}
		if (result.is_nullable && result.nullable_outer_depth == 0 && result.pointer_depth + (result.is_array ? 1 : 0) == 0) {
			result.is_nullable = false;
		}
		return result;
	}

	class Node withoutOuterPointers(Node typeExpr, int pointerCount) {
		Node result = TypeShape.copy(typeExpr);
		int removed = 0;
		while (removed < pointerCount) {
			if (result.pointer_depth <= 0) { return result; }
			Node previous = TypeShape.copy(result);
			result.pointer_depth = result.pointer_depth - 1;
			if (previous.nullable_outer_depth > 0) {
				result.nullable_outer_depth = previous.nullable_outer_depth - 1;
			} else if (previous.is_nullable) {
				int innerStorage = previous.pointer_depth + (previous.is_array ? 1 : 0) - previous.nullable_outer_depth;
				result.is_nullable = false;
				result.nullable_outer_depth = 0;
				if (innerStorage > 1) {
					result.pointer_depth = result.pointer_depth - 1;
				}
			}
			if (result.is_nullable && result.nullable_outer_depth == 0 && result.pointer_depth + (result.is_array ? 1 : 0) == 0) {
				result.is_nullable = false;
			}
			removed++;
		}
		return result;
	}

	class Node withOuterPointer(Node typeExpr) {
		Node result = TypeShape.copy(typeExpr);
		result.pointer_depth++;
		if (result.is_nullable) {
			result.nullable_outer_depth++;
		}
		return result;
	}
}

class TypeComposition {
	class bool resolvedReferenceShape(Node typeExpr) { return typeExpr.pointer_depth > 0 || typeExpr.is_array || TypeShape.intrinsicReference(typeExpr); }

	class bool nullableCollapsesReferenceLayer(Node typeExpr, bool baseIsReference) {
		if (!typeExpr.is_nullable || typeExpr.pointer_depth <= 0) {
			return false;
		}
		int innerStorage = typeExpr.pointer_depth + (typeExpr.is_array ? 1 : 0) - typeExpr.nullable_outer_depth;
		return innerStorage > 1 || (baseIsReference && innerStorage > 0);
	}

	/* The pointer depth an applied placeholder still contributes once its
     * nullable outer layer collapses into the resolved reference. This is the
     * single definition of that rule; compose() and every substitution
     * consumer read it rather than restating the arithmetic. */
	class int appliedSubstitutionPointerDepth(Node placeholder, bool referenceShape) { return placeholder.pointer_depth - (TypeComposition.nullableCollapsesReferenceLayer(placeholder, referenceShape) ? 1 : 0); }

	/* The composed pointer depth of one placeholder-to-resolved substitution. */
	class int substitutionPointerDepth(Node placeholder, Node resolved) { return resolved.pointer_depth + TypeComposition.appliedSubstitutionPointerDepth(placeholder, TypeComposition.resolvedReferenceShape(resolved)); }

	class Node compose(Node applied, Node resolved, bool referenceShape) {
		bool collapseApplied = TypeComposition.nullableCollapsesReferenceLayer(applied, referenceShape);
		int appliedPointerDepth = TypeComposition.appliedSubstitutionPointerDepth(applied, referenceShape);
		int survivingShellStorage = appliedPointerDepth + (applied.is_array ? 1 : 0);
		Node result = TypeShape.copy(resolved);
		result.pointer_depth = resolved.pointer_depth + appliedPointerDepth;
		result.is_array = applied.is_array || resolved.is_array;
		if (applied.array_size != null) {
			result.array_size = applied.array_size;
		}
		result.is_const = applied.is_const || resolved.is_const;
		result.is_nullable = applied.is_nullable || resolved.is_nullable;
		if (resolved.is_nullable) {
			result.nullable_outer_depth = resolved.nullable_outer_depth + survivingShellStorage;
		} else if (applied.is_nullable) {
			if (collapseApplied) {
				result.nullable_outer_depth = survivingShellStorage;
			} else {
				result.nullable_outer_depth = applied.nullable_outer_depth;
			}
		} else {
			result.nullable_outer_depth = 0;
		}
		result.is_static = applied.is_static || resolved.is_static;
		result.is_extern = applied.is_extern || resolved.is_extern;
		result.is_volatile = applied.is_volatile || resolved.is_volatile;
		if (applied.line != 0) { result.line = applied.line; }
		if (applied.col != 0) { result.col = applied.col; }
		return result;
	}

	class bool isSemanticScalarString(Node? typeExpr) {
		if (typeExpr == null || typeExpr.base != "string" || typeExpr.generic_args.len > 0 || typeExpr.is_array) {
			return false;
		}
		int depth = typeExpr.pointer_depth;
		if (TypeComposition.nullableCollapsesReferenceLayer(typeExpr, true)) {
			depth--;
		}
		return depth == 0;
	}
}

class CallableSignature {
	class Node component(Node declarationType) {
		Node result = TypeShape.copyTree(declarationType);
		result.is_static = false;
		result.is_extern = false;
		return result;
	}

	class Node sourceFunctionPointer(Node declaration) {
		Node callable = Node();
		callable.kind = NK_TYPE_EXPR;
		callable.base = "__fn_ptr";
		callable.generic_args.push(CallableSignature.component(declaration.return_type));
		int index = 0;
		while (index < declaration.params.len) {
			callable.generic_args.push(CallableSignature.component(declaration.params.get(index).type));
			index++;
		}
		return callable;
	}
}
