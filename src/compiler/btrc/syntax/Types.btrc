/* TypeExpr shape transformations and callable signature construction. */

import Library.Vector;

import ../generated/ast/Node.btrc;

class TypeShape {
	class bool intrinsicReference(Node typeExpr) { return typeExpr.base == "Array" || typeExpr.base == "List" || typeExpr.base == "Map" || typeExpr.base == "Mutex" || typeExpr.base == "Set" || typeExpr.base == "Thread" || typeExpr.base == "Vector" || typeExpr.base == "__fn_ptr" || typeExpr.base == "__realtime_fn_ptr" || typeExpr.base == "string"; }

	class Node copyWithArguments(Node typeExpr, Vector<Node> genericArgs) {
		Node result = Node();
		result.kind = NK_TYPE_EXPR;
		result.base = typeExpr.base;
		result.genericArgs = genericArgs;
		result.pointerDepth = typeExpr.pointerDepth;
		result.isArray = typeExpr.isArray;
		result.arraySize = typeExpr.arraySize;
		result.isConst = typeExpr.isConst;
		result.isNullable = typeExpr.isNullable;
		result.nullableOuterDepth = typeExpr.nullableOuterDepth;
		result.isStatic = typeExpr.isStatic;
		result.isExtern = typeExpr.isExtern;
		result.isVolatile = typeExpr.isVolatile;
		result.line = typeExpr.line;
		result.col = typeExpr.col;
		return result;
	}

	class Node copy(Node typeExpr) { return TypeShape.copyWithArguments(typeExpr, typeExpr.genericArgs); }

	class Node copyTree(Node typeExpr) {
		Vector<Node> genericArgs = [];
		int index = 0;
		while (index < typeExpr.genericArgs.len) {
			genericArgs.push(TypeShape.copyTree(typeExpr.genericArgs.get(index)));
			index++;
		}
		return TypeShape.copyWithArguments(typeExpr, genericArgs);
	}

	class Node withoutOuterArray(Node typeExpr) {
		Node result = TypeShape.copy(typeExpr);
		if (result.isArray) {
			result.isArray = false;
			result.arraySize = null;
			if (typeExpr.nullableOuterDepth > 0) {
				result.nullableOuterDepth = typeExpr.nullableOuterDepth - 1;
			} else if (typeExpr.isNullable) {
				int innerStorage = typeExpr.pointerDepth + (typeExpr.isArray ? 1 : 0) - typeExpr.nullableOuterDepth;
				result.isNullable = false;
				result.nullableOuterDepth = 0;
				if (innerStorage > 1) {
					result.pointerDepth = result.pointerDepth - 1;
				}
			}
		}
		if (result.isNullable && result.nullableOuterDepth == 0 && result.pointerDepth + (result.isArray ? 1 : 0) == 0) {
			result.isNullable = false;
		}
		return result;
	}

	class Node withoutOuterPointers(Node typeExpr, int pointerCount) {
		Node result = TypeShape.copy(typeExpr);
		int removed = 0;
		while (removed < pointerCount) {
			if (result.pointerDepth <= 0) { return result; }
			Node previous = TypeShape.copy(result);
			result.pointerDepth = result.pointerDepth - 1;
			if (previous.nullableOuterDepth > 0) {
				result.nullableOuterDepth = previous.nullableOuterDepth - 1;
			} else if (previous.isNullable) {
				int innerStorage = previous.pointerDepth + (previous.isArray ? 1 : 0) - previous.nullableOuterDepth;
				result.isNullable = false;
				result.nullableOuterDepth = 0;
				if (innerStorage > 1) {
					result.pointerDepth = result.pointerDepth - 1;
				}
			}
			if (result.isNullable && result.nullableOuterDepth == 0 && result.pointerDepth + (result.isArray ? 1 : 0) == 0) {
				result.isNullable = false;
			}
			removed++;
		}
		return result;
	}

	class Node withOuterPointer(Node typeExpr) {
		Node result = TypeShape.copy(typeExpr);
		result.pointerDepth++;
		if (result.isNullable) {
			result.nullableOuterDepth++;
		}
		return result;
	}
}

class TypeComposition {
	class bool resolvedReferenceShape(Node typeExpr) { return typeExpr.pointerDepth > 0 || typeExpr.isArray || TypeShape.intrinsicReference(typeExpr); }

	class bool nullableCollapsesReferenceLayer(Node typeExpr, bool baseIsReference) {
		if (!typeExpr.isNullable || typeExpr.pointerDepth <= 0) {
			return false;
		}
		int innerStorage = typeExpr.pointerDepth + (typeExpr.isArray ? 1 : 0) - typeExpr.nullableOuterDepth;
		return innerStorage > 1 || (baseIsReference && innerStorage > 0);
	}

	/* The pointer depth an applied placeholder still contributes once its
     * nullable outer layer collapses into the resolved reference. This is the
     * single definition of that rule; compose() and every substitution
     * consumer read it rather than restating the arithmetic. */
	class int appliedSubstitutionPointerDepth(Node placeholder, bool referenceShape) { return placeholder.pointerDepth - (TypeComposition.nullableCollapsesReferenceLayer(placeholder, referenceShape) ? 1 : 0); }

	/* The composed pointer depth of one placeholder-to-resolved substitution. */
	class int substitutionPointerDepth(Node placeholder, Node resolved) { return resolved.pointerDepth + TypeComposition.appliedSubstitutionPointerDepth(placeholder, TypeComposition.resolvedReferenceShape(resolved)); }

	class Node compose(Node applied, Node resolved, bool referenceShape) {
		bool collapseApplied = TypeComposition.nullableCollapsesReferenceLayer(applied, referenceShape);
		int appliedPointerDepth = TypeComposition.appliedSubstitutionPointerDepth(applied, referenceShape);
		int survivingShellStorage = appliedPointerDepth + (applied.isArray ? 1 : 0);
		Node result = TypeShape.copy(resolved);
		result.pointerDepth = resolved.pointerDepth + appliedPointerDepth;
		result.isArray = applied.isArray || resolved.isArray;
		if (applied.arraySize != null) {
			result.arraySize = applied.arraySize;
		}
		result.isConst = applied.isConst || resolved.isConst;
		result.isNullable = applied.isNullable || resolved.isNullable;
		if (resolved.isNullable) {
			result.nullableOuterDepth = resolved.nullableOuterDepth + survivingShellStorage;
		} else if (applied.isNullable) {
			if (collapseApplied) {
				result.nullableOuterDepth = survivingShellStorage;
			} else {
				result.nullableOuterDepth = applied.nullableOuterDepth;
			}
		} else {
			result.nullableOuterDepth = 0;
		}
		result.isStatic = applied.isStatic || resolved.isStatic;
		result.isExtern = applied.isExtern || resolved.isExtern;
		result.isVolatile = applied.isVolatile || resolved.isVolatile;
		if (applied.line != 0) { result.line = applied.line; }
		if (applied.col != 0) { result.col = applied.col; }
		return result;
	}

	class bool isSemanticScalarString(Node? typeExpr) {
		if (typeExpr == null || typeExpr.base != "string" || typeExpr.genericArgs.len > 0 || typeExpr.isArray) {
			return false;
		}
		int depth = typeExpr.pointerDepth;
		if (TypeComposition.nullableCollapsesReferenceLayer(typeExpr, true)) {
			depth--;
		}
		return depth == 0;
	}
}

class CallableSignature {
	class Node component(Node declarationType) {
		Node result = TypeShape.copyTree(declarationType);
		result.isStatic = false;
		result.isExtern = false;
		return result;
	}

	class Node sourceFunctionPointer(Node declaration) {
		Node callable = Node();
		callable.kind = NK_TYPE_EXPR;
		callable.base = "__fn_ptr";
		callable.genericArgs.push(CallableSignature.component(declaration.returnType));
		int index = 0;
		while (index < declaration.params.len) {
			callable.genericArgs.push(CallableSignature.component(declaration.params.get(index).type));
			index++;
		}
		return callable;
	}
}
