			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_SUPER_EXPR) {
			string out = "(SuperExpr";
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_BINARY_EXPR) {
			string out = "(BinaryExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "left=" + self.canonNode(node.left, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "op=" + self.canonStr(node.op);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "right=" + self.canonNode(node.right, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_UNARY_EXPR) {
			string out = "(UnaryExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "op=" + self.canonStr(node.op);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "operand=" + self.canonNode(node.operand, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "prefix=" + self.canonBool(node.prefix);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_CALL_EXPR) {
			string out = "(CallExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "callee=" + self.canonNode(node.callee, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "args=" + self.canonNodeList(node.args(), d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "arg_names=" + self.canonStrList(node.argNames(), d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_INDEX_EXPR) {
			string out = "(IndexExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "obj=" + self.canonNode(node.obj, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "index=" + self.canonNode(node.index, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_FIELD_ACCESS_EXPR) {
			string out = "(FieldAccessExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "obj=" + self.canonNode(node.obj, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "field=" + self.canonStr(node.field);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "arrow=" + self.canonBool(node.arrow);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "optional=" + self.canonBool(node.optional);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_CAST_EXPR) {
			string out = "(CastExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "target_type=" + self.canonNode(node.targetType, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "expr=" + self.canonNode(node.expr, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_SIZEOF_EXPR) {
			string out = "(SizeofExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "operand=" + self.canonNode(node.operand, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_TERNARY_EXPR) {
			string out = "(TernaryExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "condition=" + self.canonNode(node.condition, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "true_expr=" + self.canonNode(node.trueExpr, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "false_expr=" + self.canonNode(node.falseExpr, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_ASSIGN_EXPR) {
			string out = "(AssignExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "target=" + self.canonNode(node.target, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "op=" + self.canonStr(node.op);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "value=" + self.canonNode(node.valueNode, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_LIST_LITERAL) {
			string out = "(ListLiteral";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "elements=" + self.canonNodeList(node.elements(), d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_MAP_LITERAL) {
			string out = "(MapLiteral";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "entries=" + self.canonNodeList(node.entries(), d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_BRACE_INITIALIZER) {
			string out = "(BraceInitializer";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "elements=" + self.canonNodeList(node.elements(), d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_F_STRING_LITERAL) {
			string out = "(FStringLiteral";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "parts=" + self.canonNodeList(node.parts(), d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_NEW_EXPR) {
			string out = "(NewExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "type=" + self.canonNode(node.type, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "args=" + self.canonNodeList(node.args(), d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "arg_names=" + self.canonStrList(node.argNames(), d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_TUPLE_LITERAL) {
			string out = "(TupleLiteral";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "elements=" + self.canonNodeList(node.elements(), d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_LAMBDA_EXPR) {
			string out = "(LambdaExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "return_type=" + self.canonNode(node.returnType, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "params=" + self.canonNodeList(node.params(), d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "body=" + self.canonNode(node.bodyNode, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "captures=" + self.canonNodeList(node.captures(), d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_SPAWN_EXPR) {
			string out = "(SpawnExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "fn=" + self.canonNode(node.fn, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_STRING_CONCAT) {
			string out = "(StringConcat";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "parts=" + self.canonNodeList(node.parts(), d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_COMMA_EXPR) {
			string out = "(CommaExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "elements=" + self.canonNodeList(node.elements(), d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_SIZEOF_TYPE) {
			string out = "(SizeofType";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "type=" + self.canonNode(node.type, d + 1);
			return out + ")";
		} else if (node.kind == NK_SIZEOF_EXPR_OP) {
			string out = "(SizeofExprOp";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "expr=" + self.canonNode(node.expr, d + 1);
			return out + ")";
		} else if (node.kind == NK_MAP_ENTRY) {
			string out = "(MapEntry";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "key=" + self.canonNode(node.key, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "value=" + self.canonNode(node.valueNode, d + 1);
			return out + ")";
		} else if (node.kind == NK_F_STRING_TEXT) {
			string out = "(FStringText";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "text=" + self.canonStr(node.text);
			return out + ")";
		} else if (node.kind == NK_F_STRING_EXPR) {
			string out = "(FStringExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "expression=" + self.canonNode(node.expression, d + 1);
			return out + ")";
		} else if (node.kind == NK_LAMBDA_BLOCK) {
			string out = "(LambdaBlock";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "body=" + self.canonNode(node.bodyNode, d + 1);
			return out + ")";
		} else if (node.kind == NK_LAMBDA_EXPR_BODY) {
			string out = "(LambdaExprBody";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "expression=" + self.canonNode(node.expression, d + 1);
			return out + ")";
		} else if (node.kind == NK_CAPTURE) {
			string out = "(Capture";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "type=" + self.canonNode(node.type, d + 1);
			return out + ")";
		}
		return "(Unknown)";
	}

	private string spaces(int n) {
		string s = "";
		int i = 0;
		while (i < n) { s = s + " "; i = i + 1; }
		return s;
	}

	private string canonInt(int v) { return Strings.fromInt(v); }

	private string canonBool(bool b) { if (b) { return "true"; } return "false"; }

	private string canonFloat(float f) { return f"{f}"; }

	private string canonStr(string s) {
		string out = "\"";
		int i = 0;
		int n = s.length();
		while (i < n) {
			char c = s[i];
			if (c == '\\') { out = out + "\\\\"; }
			else if (c == '"') { out = out + "\\\""; }
			else if (c == '\n') { out = out + "\\n"; }
			else if (c == '\r') { out = out + "\\r"; }
			else if (c == '\t') { out = out + "\\t"; }
			else { out = out + f"{c}"; }
			i = i + 1;
		}
		return out + "\"";
	}

	private string canonOptStr(string? s) {
		if (s == null) { return "nil"; }
		return self.canonStr(s);
	}

	private string canonNode(Node node, int d) {
		Node? pending = self.pendingBody;
		if (pending != null && pending == node) {
			self.pendingBody = null;
			IAstInterfaceSummary? summary = self.interfaceSummary;
			Node? callable = self.pendingCallable;
			if (summary != null && callable != null) { return "(ElidedBody " + summary.callableBody(callable) + ")"; }
		}
		if (node == null) { return "nil"; }
		return self.renderAtDepth(node, d);
	}

	private string canonNodeList(Vector<Node> xs, int d) {
		if (xs.len == 0) { return "[]"; }
		string out = "[\n";
		int i = 0;
		while (i < xs.len) {
			out = out + self.spaces(2 * (d + 1)) + self.renderAtDepth(xs.get(i), d + 1);
			if (i < xs.len - 1) { out = out + "\n"; }
			i = i + 1;
		}
		return out + "\n" + self.spaces(2 * d) + "]";
	}

	private string canonStrList(Vector<string> xs, int d) {
		if (xs.len == 0) { return "[]"; }
		string out = "[\n";
		int i = 0;
		while (i < xs.len) {
			out = out + self.spaces(2 * (d + 1)) + self.canonStr(xs.get(i));
			if (i < xs.len - 1) { out = out + "\n"; }
			i = i + 1;
		}
		return out + "\n" + self.spaces(2 * d) + "]";
	}
}

class TypeIdentity {
	class bool asciiLetter(char value) { return (value >= 'A' && value <= 'Z') || (value >= 'a' && value <= 'z'); }

	class bool asciiDigit(char value) { return value >= '0' && value <= '9'; }

	class bool safeBase(string base) {
		int length = base.length();
		if (length == 0 || !TypeIdentity.asciiLetter(base[0])) { return false; }
		if (length >= 2 && base[0] == 'Z' && base[1] == 'Q') { return false; }
		int index = 1;
		while (index < length) {
			char value = base[index];
			if (!TypeIdentity.asciiLetter(value) && !TypeIdentity.asciiDigit(value)) {
				return false;
			}
			index = index + 1;
		}
		return true;
	}

	class string utf8Hex(string value) {
		string digits = "0123456789abcdef";
		StringBuilder encoded = StringBuilder();
		int index = 0;
		while (index < value.length()) {
			int byteValue = (int)((unsigned char)value[index]);
			encoded.appendChar(digits[byteValue / 16]);
			encoded.appendChar(digits[byteValue % 16]);
			index = index + 1;
		}
		return encoded.toString();
	}

	class string field(string tag, string value) { return tag + Strings.fromInt(value.length()) + "_" + value; }

	class int qualifierBits(Node typeExpr) {
		int bits = 0;
		if (typeExpr.isConst) { bits = bits + 1; }
		if (typeExpr.isStatic) { bits = bits + 2; }
		if (typeExpr.isExtern) { bits = bits + 4; }
		if (typeExpr.isVolatile) { bits = bits + 8; }
		return bits;
	}

	/* Keys are built on every replayed instance fact: the encoders append
	 * into one builder rather than concatenating a string per field. */
	class void appendInt(StringBuilder out, int value) {
		if (value < 0) { out.append(Strings.fromInt(value)); return; }
		if (value >= 10) { TypeIdentity.appendInt(out, value / 10); }
		out.appendChar((char)((int)'0' + value % 10));
	}

	/* field(tag, utf8Hex(value)). */
	class void appendHexField(StringBuilder out, string tag, string value) {
		string digits = "0123456789abcdef";
		int length = value.length();
		out.append(tag);
		TypeIdentity.appendInt(out, length * 2);
		out.appendChar('_');
		int index = 0;
		while (index < length) {
			int byteValue = (int)((unsigned char)value[index]);
			out.appendChar(digits[byteValue / 16]);
			out.appendChar(digits[byteValue % 16]);
			index = index + 1;
		}
	}

	class void appendTypes(StringBuilder out, Vector<Node> args) {
		out.appendChar('k');
		TypeIdentity.appendInt(out, args.len);
		for argument in args {
			string encoded = TypeIdentity.encode(argument);
			out.appendChar('t');
			TypeIdentity.appendInt(out, encoded.length());
			out.appendChar('_');
			out.append(encoded);
		}
	}

	class void appendEncoded(StringBuilder out, Node typeExpr) {
		TypeIdentity.appendHexField(out, "b", typeExpr.base);
		out.appendChar('p');
		TypeIdentity.appendInt(out, typeExpr.pointerDepth);
		out.append(typeExpr.isNullable ? "n1o" : "n0o");
		TypeIdentity.appendInt(out, typeExpr.nullableOuterDepth);
		out.append(typeExpr.isArray ? "a1q" : "a0q");
		TypeIdentity.appendInt(out, TypeIdentity.qualifierBits(typeExpr));
		TypeIdentity.appendTypes(out, typeExpr.genericArgs());
	}

	class string encodeTypes(Vector<Node> args) {
		StringBuilder out = StringBuilder();
		TypeIdentity.appendTypes(out, args);
		return out.toString();
	}

	class string encode(Node typeExpr) {
		StringBuilder out = StringBuilder();
		TypeIdentity.appendEncoded(out, typeExpr);
		return out.toString();
	}

	/* Whether `encode` captures the whole type: it omits array-size
	 * expressions (and source positions), so a type carrying one anywhere is
	 * not encodable. */
	class bool encodable(Node typeExpr) {
		if (typeExpr.kind != NK_TYPE_EXPR || typeExpr.arraySize != null) { return false; }
		for argument in typeExpr.genericArgs() {
			if (!TypeIdentity.encodable(argument)) { return false; }
		}
		return true;
	}

	/* The inverse of `encode` for an encodable type; null for text that is
	 * not exactly one encoded type. */
	class Node? decode(string text) {
		Vector<int> cursor = [0];
		Node? result = TypeIdentity.decodeAt(text, cursor);
		if (result == null || cursor.get(0) != text.length()) { return null; }
		return result;
	}

	class int decodeInt(string text, Vector<int> cursor) {
		int index = cursor.get(0);
		int start = index;
		int value = 0;
		while (index < text.length() && TypeIdentity.asciiDigit(text[index]) && index - start < 9) {
			value = value * 10 + (int)(text[index] - '0');
			index = index + 1;
		}
		if (index == start) { return -1; }
		cursor.set(0, index);
		return value;
	}

	/* `tag<length>_<value>`: the value, or null when malformed. */
	class string? decodeField(string text, string tag, Vector<int> cursor) {
		int index = cursor.get(0);
		if (index >= text.length() || text[index] != tag[0]) { return null; }
		cursor.set(0, index + 1);
		int length = TypeIdentity.decodeInt(text, cursor);
		index = cursor.get(0);
		if (length < 0 || index >= text.length() || text[index] != '_' || index + 1 + length > text.length()) { return null; }
		cursor.set(0, index + 1 + length);
		return text.substring(index + 1, length);
	}

	/* `<letter><int>` for one shape component, or -1. */
	class int decodeTagged(string text, char tag, Vector<int> cursor) {
		int index = cursor.get(0);
		if (index >= text.length() || text[index] != tag) { return -1; }
		cursor.set(0, index + 1);
		return TypeIdentity.decodeInt(text, cursor);
	}

	class string? hexText(string hex) {
		if (hex.length() % 2 != 0) { return null; }
		StringBuilder text = StringBuilder();
		int index = 0;
		while (index < hex.length()) {
			int high = TypeIdentity.hexDigit(hex[index]);
			int low = TypeIdentity.hexDigit(hex[index + 1]);
			if (high < 0 || low < 0) { return null; }
			text.appendChar((char)(high * 16 + low));
			index = index + 2;
		}
		return text.toString();
	}

	class int hexDigit(char value) {
		if (value >= '0' && value <= '9') { return (int)(value - '0'); }
		if (value >= 'a' && value <= 'f') { return (int)(value - 'a') + 10; }
		return -1;
	}

	class Node? decodeAt(string text, Vector<int> cursor) {
		string? encodedBase = TypeIdentity.decodeField(text, "b", cursor);
		if (encodedBase == null) { return null; }
		string? base = TypeIdentity.hexText(encodedBase);
		int pointers = TypeIdentity.decodeTagged(text, 'p', cursor);
		int nullable = TypeIdentity.decodeTagged(text, 'n', cursor);
		int outer = TypeIdentity.decodeTagged(text, 'o', cursor);
		int array = TypeIdentity.decodeTagged(text, 'a', cursor);
		int qualifiers = TypeIdentity.decodeTagged(text, 'q', cursor);
		int count = TypeIdentity.decodeTagged(text, 'k', cursor);
		if (base == null || pointers < 0 || nullable < 0 || nullable > 1 || outer < 0 || array < 0 || array > 1 || qualifiers < 0 || qualifiers > 15 || count < 0) { return null; }
		Node result = Node();
		result.kind = NK_TYPE_EXPR;
		result.base = base;
		result.pointerDepth = pointers;
		result.isNullable = nullable == 1;
		result.nullableOuterDepth = outer;
		result.isArray = array == 1;
		result.isConst = qualifiers % 2 == 1;
		result.isStatic = (qualifiers / 2) % 2 == 1;
		result.isExtern = (qualifiers / 4) % 2 == 1;
		result.isVolatile = (qualifiers / 8) % 2 == 1;
		int index = 0;
		while (index < count) {
			string? argument = TypeIdentity.decodeField(text, "t", cursor);
			if (argument == null) { return null; }
			Node? decoded = TypeIdentity.decode(argument);
			if (decoded == null) { return null; }
			result.genericArgsMut().push(decoded);
			index = index + 1;
		}
		return result;
	}

	class string encodeNameAndTypes(string base, Vector<Node> args) {
		StringBuilder out = StringBuilder();
		TypeIdentity.appendHexField(out, "b", base);
		TypeIdentity.appendTypes(out, args);
		return out.toString();
	}

	/* Position-independent semantic key. The encoding is recursive and
     * length-delimited, so no two TypeExpr trees can share a key. */
	class string shapeKey(Node typeExpr) { return TypeIdentity.encode(typeExpr); }

	class string genericInstanceKey(string base, Vector<Node> args) { return TypeIdentity.encodeNameAndTypes(base, args); }

	class string methodInstanceKey(string classBase, Vector<Node> classArgs, string methodName, Vector<Node> methodArgs) {
		StringBuilder out = StringBuilder();
		TypeIdentity.appendHexField(out, "b", classBase);
		TypeIdentity.appendTypes(out, classArgs);
		TypeIdentity.appendHexField(out, "m", methodName);
		TypeIdentity.appendTypes(out, methodArgs);
		return out.toString();
	}

	class bool referencesNames(Node? typeExpr, Map<string, bool> names) {
		if (typeExpr == null) { return false; }
		if (names.has(typeExpr.base)) { return true; }
		int index = 0;
		while (index < typeExpr.genericArgs().len) {
			if (TypeIdentity.referencesNames(typeExpr.genericArgs().get(index), names)) {
				return true;
			}
			index = index + 1;
		}
		return false;
	}

	class string genericArgumentProblemInner(Node typeExpr, bool qualifiedComponent) {
		if (!qualifiedComponent && typeExpr.isConst) {
			return "generic arguments cannot be const-qualified";
		}
		if (!qualifiedComponent && typeExpr.isStatic) {
			return "generic arguments cannot be static-qualified";
		}
		if (!qualifiedComponent && typeExpr.isExtern) {
			return "generic arguments cannot be extern-qualified";
		}
		if (!qualifiedComponent && typeExpr.isVolatile) {
			return "generic arguments cannot be volatile-qualified";
		}
		bool childIsStructuralComponent = typeExpr.base == "Tuple" || typeExpr.base == "__fn_ptr" || typeExpr.base == "__realtime_fn_ptr";
		int index = 0;
		while (index < typeExpr.genericArgs().len) {
			string problem = TypeIdentity.genericArgumentProblemInner(typeExpr.genericArgs().get(index), childIsStructuralComponent);
			if (problem != "") { return problem; }
			index = index + 1;
		}
		return "";
	}

	class string genericArgumentProblem(Node typeExpr) { return TypeIdentity.genericArgumentProblemInner(typeExpr, false); }

	class void fail(string message) {
		fprintf(stderr, "error: %s\n", message);
		exit(1);
	}

	class void ensureSupportedGenericArguments(Vector<Node> args) {
		int index = 0;
		while (index < args.len) {
			string problem = TypeIdentity.genericArgumentProblem(args.get(index));
			if (problem != "") { TypeIdentity.fail(problem); }
			index = index + 1;
		}
	}

	class bool legacyComponentPossible(Node typeExpr) { return typeExpr.genericArgs().len == 0 && TypeIdentity.safeBase(typeExpr.base) && typeExpr.nullableOuterDepth == 0 && !typeExpr.isConst && !typeExpr.isStatic && !typeExpr.isExtern && !typeExpr.isVolatile; }

	class string legacyComponent(Node typeExpr) {
		string component = typeExpr.base;
		if (typeExpr.pointerDepth > 0) {
			component = component + "_p" + Strings.fromInt(typeExpr.pointerDepth);
		}
		if (typeExpr.isNullable) { component = component + "_n"; }
		if (typeExpr.isArray) { component = component + "_a"; }
		return component;
	}

	class bool legacySequencePossible(Vector<Node> args) {
		int index = 0;
		while (index < args.len) {
			Node argument = args.get(index);
			if (!TypeIdentity.legacyComponentPossible(argument)) { return false; }
			if (args.len > 1 && (argument.pointerDepth > 0 || argument.isNullable || argument.isArray)) {
				return false;
			}
			index = index + 1;
		}
		return true;
	}

	class string legacySequence(Vector<Node> args) {
		string sequence = "";
		int index = 0;
		while (index < args.len) {
			if (index > 0) { sequence = sequence + "_"; }
			sequence = sequence + TypeIdentity.legacyComponent(args.get(index));
			index = index + 1;
		}
		return sequence;
	}

	class bool legacyComponentSpelling(string value) {
		int length = value.length();
		if (length == 0 || !TypeIdentity.asciiLetter(value[0])) {
			return false;
		}
		int index = 1;
		while (index < length && (TypeIdentity.asciiLetter(value[index]) || TypeIdentity.asciiDigit(value[index]))) {
			index = index + 1;
		}
		string base = value.substring(0, index);
		if (!TypeIdentity.safeBase(base)) { return false; }
		if (index + 2 <= length && value.substring(index, 2) == "_p") {
			index = index + 2;
			int digitStart = index;
			while (index < length && TypeIdentity.asciiDigit(value[index])) {
				index = index + 1;
			}
			if (digitStart == index || value[digitStart] == '0') {
				return false;
			}
		}
		if (index + 2 <= length && value.substring(index, 2) == "_n") {
			index = index + 2;
		}
		if (index + 2 <= length && value.substring(index, 2) == "_a") {
			index = index + 2;
		}
		return index == length;
	}

	class bool legacySequenceSpelling(string value, int arity) {
		if (arity <= 0 || value == "") { return false; }
		if (arity == 1) {
			return TypeIdentity.legacyComponentSpelling(value);
		}
		Vector<string> components = Strings.split(value, "_");
		if (components.len != arity) { return false; }
		int index = 0;
		while (index < components.len) {
			if (!TypeIdentity.safeBase(components.get(index))) {
				return false;
			}
			index = index + 1;
		}
		return true;
	}

	class int encodedFieldEnd(string value, int start, char tag) {
		int length = value.length();
		if (start < 0 || start >= length || value[start] != tag) {
			return -1;
		}
		int index = start + 1;
		int digitStart = index;
		long long payloadLength = 0LL;
		while (index < length && TypeIdentity.asciiDigit(value[index])) {
			long long digit = (long long)(value[index] - '0');
			if (payloadLength > (2147483647LL - digit) / 10LL) {
				return -1;
			}
			payloadLength = payloadLength * 10LL + digit;
			index = index + 1;
		}
		if (digitStart == index || index >= length || value[index] != '_' || (index - digitStart > 1 && value[digitStart] == '0')) {
			return -1;
		}
		index = index + 1;
		if (payloadLength <= 0LL || payloadLength > (long long)(length - index)) {
			return -1;
		}
		return index + (int)payloadLength;
	}

	class int encodedTypesEnd(string value, int start, int arity) {
		if (arity < 0) { return -1; }
		string prefix = "k" + Strings.fromInt(arity);
		if (start < 0 || start + prefix.length() > value.length() || value.substring(start, prefix.length()) != prefix) {
			return -1;
		}
		int index = start + prefix.length();
		int argument = 0;
		while (argument < arity) {
			index = TypeIdentity.encodedFieldEnd(value, index, 't');
			if (index < 0) { return -1; }
			argument = argument + 1;
		}
		return index;
	}

	class bool possibleLegacyMangledGenericType(string symbol, string base, int arity) {
		if (arity <= 0 || !TypeIdentity.safeBase(base)) { return false; }
		string prefix = "btrc_" + base + "_";
		if (!symbol.startsWith(prefix)) { return false; }
		string arguments = symbol.substring(prefix.length(), symbol.length() - prefix.length());
		return TypeIdentity.legacySequenceSpelling(arguments, arity);
	}

	/* Recognize one possible generic-type spelling using only its declared
     * base and arity.  This is intentionally structural: before generic graph
     * closure, semantic analysis does not yet own the concrete TypeExpr rows,
     * but it can still distinguish the canonical legacy/encoded grammars from
     * arbitrary lookalikes. */
	class bool possibleMangledGenericType(string symbol, string base, int arity) {
		if (TypeIdentity.possibleLegacyMangledGenericType(symbol, base, arity)) {
			return true;
		}
		if (arity <= 0) { return false; }
		string prefix = "btrc_ZQg" + TypeIdentity.field("b", TypeIdentity.utf8Hex(base));
		if (!symbol.startsWith(prefix)) { return false; }
		return TypeIdentity.encodedTypesEnd(symbol, prefix.length(), arity) == symbol.length();
	}

	class bool possibleGenericInstanceSymbol(string symbol, string base, int arity, string suffix) {
		if (!symbol.endsWith(suffix) || symbol.length() <= suffix.length()) {
			return false;
		}
		string emitted = symbol.substring(0, symbol.length() - suffix.length());
		return TypeIdentity.possibleMangledGenericType(emitted, base, arity);
	}

	/* Generic-method symbols use the same legacy type sequences, or the
     * collision-safe Qm envelope with independently framed class/method type
     * lists.  Match declared owner/method names and both exact arities. */
	class bool possibleMethodInstanceSymbol(string symbol, string classBase, int classArity, string methodName, int methodArity) {
		if (methodArity <= 0) { return false; }
		if (TypeIdentity.safeBase(classBase) && TypeIdentity.safeBase(methodName)) {
			string marker = "_" + methodName + "_";
			int position = 0;
			while (position + marker.length() < symbol.length()) {
				if (symbol.substring(position, marker.length()) == marker) {
					string owner = symbol.substring(0, position);
					bool ownerMatches = false;
					if (classArity == 0) {
						ownerMatches = owner == classBase;
					} else {
						ownerMatches = TypeIdentity.possibleLegacyMangledGenericType(owner, classBase, classArity);
					}
					int argumentStart = position + marker.length();
					string arguments = symbol.substring(argumentStart, symbol.length() - argumentStart);
					if (ownerMatches && TypeIdentity.legacySequenceSpelling(arguments, methodArity)) {
						return true;
					}
				}
				position = position + 1;
			}
		}

		string prefix = "btrc_ZQm" + TypeIdentity.field("b", TypeIdentity.utf8Hex(classBase));
		if (!symbol.startsWith(prefix)) { return false; }
		int index = TypeIdentity.encodedTypesEnd(symbol, prefix.length(), classArity);
		if (index < 0) { return false; }
		string methodField = TypeIdentity.field("m", TypeIdentity.utf8Hex(methodName));
		if (index + methodField.length() > symbol.length() || symbol.substring(index, methodField.length()) != methodField) {
			return false;
		}
		index = TypeIdentity.encodedTypesEnd(symbol, index + methodField.length(), methodArity);
		return index == symbol.length();
	}


	/* Injective C-identifier component for one type. Types that already spell
     * a safe legacy identifier keep it; everything else takes the reserved
     * length-delimited encoding. Mirrors TypeIdentity.symbol_component. */
	class string symbolComponent(Node typeExpr) {
		if (TypeIdentity.legacyComponentPossible(typeExpr)) {
			return TypeIdentity.legacyComponent(typeExpr);
		}
		return "ZQt" + TypeIdentity.encode(typeExpr);
	}

	/* Structural primitive: unlike writable class specializations, Tuple and
     * __fn_ptr are allowed to carry qualified component types. */
	class string mangleGenericSymbol(string base, Vector<Node> args) {
		if (TypeIdentity.safeBase(base) && TypeIdentity.legacySequencePossible(args)) {
			string legacy = TypeIdentity.legacySequence(args);
			if (legacy == "") { return "btrc_" + base; }
			return "btrc_" + base + "_" + legacy;
		}
		return "btrc_ZQg" + TypeIdentity.encodeNameAndTypes(base, args);
	}

	/* Writable class specialization entry point: fail closed on qualifiers. */
	class string mangleGenericType(string base, Vector<Node> args) {
		TypeIdentity.ensureSupportedGenericArguments(args);
		return TypeIdentity.mangleGenericSymbol(base, args);
	}

	class string mangleMethodInstanceSymbol(string classBase, Vector<Node> classArgs, string methodName, Vector<Node> methodArgs) {
		TypeIdentity.ensureSupportedGenericArguments(classArgs);
		TypeIdentity.ensureSupportedGenericArguments(methodArgs);
		bool legacy = TypeIdentity.safeBase(classBase) && TypeIdentity.safeBase(methodName) && TypeIdentity.legacySequencePossible(classArgs) && TypeIdentity.legacySequencePossible(methodArgs);
		if (legacy) {
			string classPart = classBase;
			if (classArgs.len > 0) {
				classPart = "btrc_" + classBase + "_" + TypeIdentity.legacySequence(classArgs);
			}
			string methodPart = "_" + methodName;
			string methodLegacy = TypeIdentity.legacySequence(methodArgs);
			if (methodLegacy != "") {
				methodPart = methodPart + "_" + methodLegacy;
			}
			return classPart + methodPart;
		}
		string payload = TypeIdentity.encodeNameAndTypes(classBase, classArgs) + TypeIdentity.field("m", TypeIdentity.utf8Hex(methodName)) + TypeIdentity.encodeTypes(methodArgs);
		return "btrc_ZQm" + payload;
	}

	class string mangleFunctionPointerSymbol(Vector<Node> args) {
		if (TypeIdentity.legacySequencePossible(args)) {
			return "__btrc_fn_" + TypeIdentity.legacySequence(args);
		}
		return "__btrc_fn_ZQf" + TypeIdentity.encodeTypes(args);
	}
}

/* Stage 6 floor spike (never merged): a byte codec for whole AST subtrees,
 * generated from Node's fields. Every field that differs from Node()'s
 * default is written as its index and value; a node reached twice is written
 * once and referenced after, so shared subtrees stay shared. A float
 * literal's value is re-derived from its spelling, as the parser derives it. */
class SpikeNodeCodec {
	private StringBuilder out = StringBuilder();
	private Map<string, int> written = {};
	private string input = "";
	private int at = 0;
	/* The input's length, read once: length() counts the bytes each time. */
	private int size = 0;
	private Vector<Node> read = [];
	public bool failed = false;

	public SpikeNodeCodec() {}

	private void integer(int value) { self.out.append(Strings.fromInt(value)); self.out.append(";"); }

	private void text(string? value) { if (value == null) { self.integer(0); return; } self.integer(value.length()); self.out.append(value); }

	public string encodeAll(Vector<Node> nodes) {
		self.integer(nodes.len);
		for node in nodes { self.node(node); }
		return self.out.toString();
	}

	private void nodes(Vector<Node>? values) {
		if (values == null) { self.integer(0); return; }
		self.integer(values.len);
		for value in values { self.node(value); }
	}

	private void strings(Vector<string>? values) {
		if (values == null) { self.integer(0); return; }
		self.integer(values.len);
		for value in values { self.text(value); }
	}

	private void node(Node? value) {
		if (value == null) { self.out.append("n"); return; }
		string identity = AstIdentity.key(value);
		if (self.written.has(identity)) { self.out.append("r"); self.integer(self.written.get(identity)); return; }
		self.written.put(identity, self.written.len);
		self.out.append("o");
		if (value.kind != 0) { self.integer(0); self.integer(value.kind); }
		if (value.declarationsStorage != null) { self.integer(1); self.nodes(value.declarationsStorage); }
		if (!value.text.isEmpty()) { self.integer(2); self.text(value.text); }
		if (value.line != 0) { self.integer(3); self.integer(value.line); }
		if (value.col != 0) { self.integer(4); self.integer(value.col); }
		if (value.sourceFile != null) { self.integer(5); self.text(value.sourceFile); }
		if (value.spec != null) { self.integer(6); self.node(value.spec); }
		if (!value.name.isEmpty()) { self.integer(7); self.text(value.name); }
		if (value.genericParamsStorage != null) { self.integer(8); self.strings(value.genericParamsStorage); }
		if (value.membersStorage != null) { self.integer(9); self.nodes(value.membersStorage); }
		if (value.parent != null) { self.integer(10); self.text(value.parent); }
		if (value.interfacesStorage != null) { self.integer(11); self.strings(value.interfacesStorage); }
		if (value.isAbstract) { self.integer(12); }
		if (value.nameLine != 0) { self.integer(13); self.integer(value.nameLine); }
		if (value.nameCol != 0) { self.integer(14); self.integer(value.nameCol); }
		if (value.methodsStorage != null) { self.integer(15); self.nodes(value.methodsStorage); }
		if (value.returnType != null) { self.integer(16); self.node(value.returnType); }
		if (value.paramsStorage != null) { self.integer(17); self.nodes(value.paramsStorage); }
		if (value.bodyNode != null) { self.integer(18); self.node(value.bodyNode); }
		if (value.isGpu) { self.integer(19); }
		if (value.isRealtime) { self.integer(20); }
		if (value.keepReturn) { self.integer(21); }
		if (value.fieldsStorage != null) { self.integer(22); self.nodes(value.fieldsStorage); }
		if (value.isForward) { self.integer(23); }
		if (value.valuesStorage != null) { self.integer(24); self.nodes(value.valuesStorage); }
		if (value.variantsStorage != null) { self.integer(25); self.nodes(value.variantsStorage); }
		if (value.original != null) { self.integer(26); self.node(value.original); }
		if (!value.alias.isEmpty()) { self.integer(27); self.text(value.alias); }
		if (value.recursive) { self.integer(28); }
		if (value.namesStorage != null) { self.integer(29); self.strings(value.namesStorage); }
		if (value.segmentsStorage != null) { self.integer(30); self.strings(value.segmentsStorage); }
		if (!value.path.isEmpty()) { self.integer(31); self.text(value.path); }
		if (!value.base.isEmpty()) { self.integer(32); self.text(value.base); }
		if (value.genericArgsStorage != null) { self.integer(33); self.nodes(value.genericArgsStorage); }
		if (value.pointerDepth != 0) { self.integer(34); self.integer(value.pointerDepth); }
		if (value.isArray) { self.integer(35); }
		if (value.arraySize != null) { self.integer(36); self.node(value.arraySize); }
		if (value.isConst) { self.integer(37); }
		if (value.isNullable) { self.integer(38); }
		if (value.nullableOuterDepth != 0) { self.integer(39); self.integer(value.nullableOuterDepth); }
		if (value.isStatic) { self.integer(40); }
		if (value.isExtern) { self.integer(41); }
		if (value.isVolatile) { self.integer(42); }
		if (value.type != null) { self.integer(43); self.node(value.type); }
		if (value.default_ != null) { self.integer(44); self.node(value.default_); }
		if (value.keep_) { self.integer(45); }
		if (!value.access.isEmpty()) { self.integer(46); self.text(value.access); }
		if (value.initializer != null) { self.integer(47); self.node(value.initializer); }
		if (value.isConstructor) { self.integer(48); }
		if (value.hasGetter) { self.integer(49); }
		if (value.hasSetter) { self.integer(50); }
		if (value.getterBody != null) { self.integer(51); self.node(value.getterBody); }
		if (value.setterBody != null) { self.integer(52); self.node(value.setterBody); }
		if (value.valueNode != null) { self.integer(53); self.node(value.valueNode); }
		if (value.statementsStorage != null) { self.integer(54); self.nodes(value.statementsStorage); }
		if (value.condition != null) { self.integer(55); self.node(value.condition); }
		if (value.thenBlock != null) { self.integer(56); self.node(value.thenBlock); }
		if (value.elseBlock != null) { self.integer(57); self.node(value.elseBlock); }
		if (!value.varName.isEmpty()) { self.integer(58); self.text(value.varName); }
		if (value.varName2 != null) { self.integer(59); self.text(value.varName2); }
		if (value.iterable != null) { self.integer(60); self.node(value.iterable); }
		if (value.init != null) { self.integer(61); self.node(value.init); }
		if (value.update != null) { self.integer(62); self.node(value.update); }
		if (value.casesStorage != null) { self.integer(63); self.nodes(value.casesStorage); }
		if (value.expr != null) { self.integer(64); self.node(value.expr); }
		if (value.tryBlock != null) { self.integer(65); self.node(value.tryBlock); }
		if (!value.catchVar.isEmpty()) { self.integer(66); self.text(value.catchVar); }
		if (value.catchType != null) { self.integer(67); self.node(value.catchType); }
		if (value.catchBlock != null) { self.integer(68); self.node(value.catchBlock); }
		if (value.finallyBlock != null) { self.integer(69); self.node(value.finallyBlock); }
		if (value.ifStmt != null) { self.integer(70); self.node(value.ifStmt); }
		if (value.expression != null) { self.integer(71); self.node(value.expression); }
		if (value.bodyNodeListStorage != null) { self.integer(72); self.nodes(value.bodyNodeListStorage); }
		if (value.valueInt != 0) { self.integer(73); self.integer(value.valueInt); }
		if (!value.raw.isEmpty()) { self.integer(74); self.text(value.raw); }
		if (!value.valueString.isEmpty()) { self.integer(76); self.text(value.valueString); }
		if (value.valueBool) { self.integer(77); }
		if (value.left != null) { self.integer(78); self.node(value.left); }
		if (!value.op.isEmpty()) { self.integer(79); self.text(value.op); }
		if (value.right != null) { self.integer(80); self.node(value.right); }
		if (value.operand != null) { self.integer(81); self.node(value.operand); }
		if (value.prefix) { self.integer(82); }
		if (value.callee != null) { self.integer(83); self.node(value.callee); }
		if (value.argsStorage != null) { self.integer(84); self.nodes(value.argsStorage); }
		if (value.argNamesStorage != null) { self.integer(85); self.strings(value.argNamesStorage); }
		if (value.obj != null) { self.integer(86); self.node(value.obj); }
		if (value.index != null) { self.integer(87); self.node(value.index); }
		if (!value.field.isEmpty()) { self.integer(88); self.text(value.field); }
		if (value.arrow) { self.integer(89); }
		if (value.optional) { self.integer(90); }
		if (value.targetType != null) { self.integer(91); self.node(value.targetType); }
		if (value.trueExpr != null) { self.integer(92); self.node(value.trueExpr); }
		if (value.falseExpr != null) { self.integer(93); self.node(value.falseExpr); }
		if (value.target != null) { self.integer(94); self.node(value.target); }
		if (value.elementsStorage != null) { self.integer(95); self.nodes(value.elementsStorage); }
		if (value.entriesStorage != null) { self.integer(96); self.nodes(value.entriesStorage); }
		if (value.partsStorage != null) { self.integer(97); self.nodes(value.partsStorage); }
		if (value.capturesStorage != null) { self.integer(98); self.nodes(value.capturesStorage); }
		if (value.fn != null) { self.integer(99); self.node(value.fn); }
		if (value.key != null) { self.integer(100); self.node(value.key); }
		self.out.append("e");
	}

	/* The nodes `encoded` holds, or null when it is malformed. */
	public Vector<Node>? decodeAll(string encoded) {
		self.input = encoded;
		self.at = 0;
		self.size = encoded.length();
		Vector<Node> nodes = [];
		int count = self.readInteger();
		for (int index = 0; index < count && !self.failed; index++) {
			Node? value = self.readNode();
			if (value == null) { self.failed = true; break; }
			nodes.push(value);
		}
		if (self.failed || self.at != self.size) { return null; }
		return nodes;
	}

	private int readInteger() {
		int value = 0;
		bool negative = false;
		int length = self.size;
		if (self.at < length && self.input[self.at] == '-') { negative = true; self.at++; }
		while (self.at < length && self.input[self.at] != ';') {
			char digit = self.input[self.at];
			if (digit < '0' || digit > '9') { self.failed = true; return 0; }
			value = value * 10 + (int)(digit - '0');
			self.at++;
		}
		if (self.at >= length) { self.failed = true; return 0; }
		self.at++;
		return negative ? -value : value;
	}

	private string readText() {
		int length = self.readInteger();
		if (self.failed || length < 0 || self.at + length > self.size) { self.failed = true; return ""; }
		string value = self.input.substring(self.at, length);
		self.at = self.at + length;
		return value;
	}

	private Vector<Node> readNodes() {
		Vector<Node> values = [];
		int count = self.readInteger();
		for (int index = 0; index < count && !self.failed; index++) {
			Node? value = self.readNode();
			if (value == null) { self.failed = true; break; }
			values.push(value);
		}
		return values;
	}

	private Vector<string> readStrings() {
		Vector<string> values = [];
		int count = self.readInteger();
		for (int index = 0; index < count && !self.failed; index++) { values.push(self.readText()); }
		return values;
	}

	private Node? readNode() {
		if (self.failed || self.at >= self.size) { self.failed = true; return null; }
		char tag = self.input[self.at];
		self.at++;
		if (tag == 'n') { return null; }
		if (tag == 'r') {
			int reference = self.readInteger();
			if (self.failed || reference < 0 || reference >= self.read.len) { self.failed = true; return null; }
			return self.read.get(reference);
		}
		if (tag != 'o') { self.failed = true; return null; }
		Node value = Node();
		self.read.push(value);
		while (!self.failed && self.at < self.size && self.input[self.at] != 'e') {
			int field = self.readInteger();
			if (self.failed) { return null; }
			if (field == 0) { value.kind = self.readInteger(); }
			else if (field == 1) { value.declarationsStorage = self.readNodes(); }
			else if (field == 2) { string text = self.readText(); value.text = text; }
			else if (field == 3) { value.line = self.readInteger(); }
			else if (field == 4) { value.col = self.readInteger(); }
			else if (field == 5) { string text = self.readText(); value.sourceFile = text; }
			else if (field == 6) { Node? child = self.readNode(); if (child != null) { value.spec = child; } }
			else if (field == 7) { string text = self.readText(); value.name = text; }
			else if (field == 8) { value.genericParamsStorage = self.readStrings(); }
			else if (field == 9) { value.membersStorage = self.readNodes(); }
			else if (field == 10) { string text = self.readText(); value.parent = text; }
			else if (field == 11) { value.interfacesStorage = self.readStrings(); }
			else if (field == 12) { value.isAbstract = true; }
			else if (field == 13) { value.nameLine = self.readInteger(); }
			else if (field == 14) { value.nameCol = self.readInteger(); }
			else if (field == 15) { value.methodsStorage = self.readNodes(); }
			else if (field == 16) { Node? child = self.readNode(); if (child != null) { value.returnType = child; } }
			else if (field == 17) { value.paramsStorage = self.readNodes(); }
			else if (field == 18) { Node? child = self.readNode(); if (child != null) { value.bodyNode = child; } }
			else if (field == 19) { value.isGpu = true; }
			else if (field == 20) { value.isRealtime = true; }
			else if (field == 21) { value.keepReturn = true; }
			else if (field == 22) { value.fieldsStorage = self.readNodes(); }
			else if (field == 23) { value.isForward = true; }
			else if (field == 24) { value.valuesStorage = self.readNodes(); }
			else if (field == 25) { value.variantsStorage = self.readNodes(); }
			else if (field == 26) { Node? child = self.readNode(); if (child != null) { value.original = child; } }
			else if (field == 27) { string text = self.readText(); value.alias = text; }
			else if (field == 28) { value.recursive = true; }
			else if (field == 29) { value.namesStorage = self.readStrings(); }
			else if (field == 30) { value.segmentsStorage = self.readStrings(); }
			else if (field == 31) { string text = self.readText(); value.path = text; }
			else if (field == 32) { string text = self.readText(); value.base = text; }
			else if (field == 33) { value.genericArgsStorage = self.readNodes(); }
			else if (field == 34) { value.pointerDepth = self.readInteger(); }
			else if (field == 35) { value.isArray = true; }
			else if (field == 36) { Node? child = self.readNode(); if (child != null) { value.arraySize = child; } }
			else if (field == 37) { value.isConst = true; }
			else if (field == 38) { value.isNullable = true; }
			else if (field == 39) { value.nullableOuterDepth = self.readInteger(); }
			else if (field == 40) { value.isStatic = true; }
			else if (field == 41) { value.isExtern = true; }
			else if (field == 42) { value.isVolatile = true; }
			else if (field == 43) { Node? child = self.readNode(); if (child != null) { value.type = child; } }
			else if (field == 44) { Node? child = self.readNode(); if (child != null) { value.default_ = child; } }
			else if (field == 45) { value.keep_ = true; }
			else if (field == 46) { string text = self.readText(); value.access = text; }
			else if (field == 47) { Node? child = self.readNode(); if (child != null) { value.initializer = child; } }
			else if (field == 48) { value.isConstructor = true; }
			else if (field == 49) { value.hasGetter = true; }
			else if (field == 50) { value.hasSetter = true; }
			else if (field == 51) { Node? child = self.readNode(); if (child != null) { value.getterBody = child; } }
			else if (field == 52) { Node? child = self.readNode(); if (child != null) { value.setterBody = child; } }
			else if (field == 53) { Node? child = self.readNode(); if (child != null) { value.valueNode = child; } }
			else if (field == 54) { value.statementsStorage = self.readNodes(); }
			else if (field == 55) { Node? child = self.readNode(); if (child != null) { value.condition = child; } }
			else if (field == 56) { Node? child = self.readNode(); if (child != null) { value.thenBlock = child; } }
			else if (field == 57) { Node? child = self.readNode(); if (child != null) { value.elseBlock = child; } }
			else if (field == 58) { string text = self.readText(); value.varName = text; }
			else if (field == 59) { string text = self.readText(); value.varName2 = text; }
			else if (field == 60) { Node? child = self.readNode(); if (child != null) { value.iterable = child; } }
			else if (field == 61) { Node? child = self.readNode(); if (child != null) { value.init = child; } }
			else if (field == 62) { Node? child = self.readNode(); if (child != null) { value.update = child; } }
			else if (field == 63) { value.casesStorage = self.readNodes(); }
			else if (field == 64) { Node? child = self.readNode(); if (child != null) { value.expr = child; } }
			else if (field == 65) { Node? child = self.readNode(); if (child != null) { value.tryBlock = child; } }
			else if (field == 66) { string text = self.readText(); value.catchVar = text; }
			else if (field == 67) { Node? child = self.readNode(); if (child != null) { value.catchType = child; } }
			else if (field == 68) { Node? child = self.readNode(); if (child != null) { value.catchBlock = child; } }
			else if (field == 69) { Node? child = self.readNode(); if (child != null) { value.finallyBlock = child; } }
			else if (field == 70) { Node? child = self.readNode(); if (child != null) { value.ifStmt = child; } }
			else if (field == 71) { Node? child = self.readNode(); if (child != null) { value.expression = child; } }
			else if (field == 72) { value.bodyNodeListStorage = self.readNodes(); }
			else if (field == 73) { value.valueInt = self.readInteger(); }
			else if (field == 74) { string text = self.readText(); value.raw = text; }
			else if (field == 76) { string text = self.readText(); value.valueString = text; }
			else if (field == 77) { value.valueBool = true; }
			else if (field == 78) { Node? child = self.readNode(); if (child != null) { value.left = child; } }
			else if (field == 79) { string text = self.readText(); value.op = text; }
			else if (field == 80) { Node? child = self.readNode(); if (child != null) { value.right = child; } }
			else if (field == 81) { Node? child = self.readNode(); if (child != null) { value.operand = child; } }
			else if (field == 82) { value.prefix = true; }
			else if (field == 83) { Node? child = self.readNode(); if (child != null) { value.callee = child; } }
			else if (field == 84) { value.argsStorage = self.readNodes(); }
			else if (field == 85) { value.argNamesStorage = self.readStrings(); }
			else if (field == 86) { Node? child = self.readNode(); if (child != null) { value.obj = child; } }
			else if (field == 87) { Node? child = self.readNode(); if (child != null) { value.index = child; } }
			else if (field == 88) { string text = self.readText(); value.field = text; }
			else if (field == 89) { value.arrow = true; }
			else if (field == 90) { value.optional = true; }
			else if (field == 91) { Node? child = self.readNode(); if (child != null) { value.targetType = child; } }
			else if (field == 92) { Node? child = self.readNode(); if (child != null) { value.trueExpr = child; } }
			else if (field == 93) { Node? child = self.readNode(); if (child != null) { value.falseExpr = child; } }
			else if (field == 94) { Node? child = self.readNode(); if (child != null) { value.target = child; } }
			else if (field == 95) { value.elementsStorage = self.readNodes(); }
			else if (field == 96) { value.entriesStorage = self.readNodes(); }
			else if (field == 97) { value.partsStorage = self.readNodes(); }
			else if (field == 98) { value.capturesStorage = self.readNodes(); }
			else if (field == 99) { Node? child = self.readNode(); if (child != null) { value.fn = child; } }
			else if (field == 100) { Node? child = self.readNode(); if (child != null) { value.key = child; } }
			else { self.failed = true; return null; }
		}
		if (self.failed || self.at >= self.size) { self.failed = true; return null; }
		self.at++;
		if (value.kind == NK_FLOAT_LITERAL && !value.raw.isEmpty()) { value.valueFloat = (float)FloatLiteral(value.raw).doubleValue(); }
		return value;
	}
}
