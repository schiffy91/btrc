		} else if (node.kind == NK_BINARY_EXPR) {
			string out = "(BinaryExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "left=" + self.canonNode(node.left, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "op=" + self.canonStr(node.op);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "right=" + self.canonNode(node.right, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_UNARY_EXPR) {
			string out = "(UnaryExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "op=" + self.canonStr(node.op);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "operand=" + self.canonNode(node.operand, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "prefix=" + self.canonBool(node.prefix);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_CALL_EXPR) {
			string out = "(CallExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "callee=" + self.canonNode(node.callee, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "args=" + self.canonNodeList(node.args, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "arg_names=" + self.canonStrList(node.argNames, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_INDEX_EXPR) {
			string out = "(IndexExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "obj=" + self.canonNode(node.obj, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "index=" + self.canonNode(node.index, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_FIELD_ACCESS_EXPR) {
			string out = "(FieldAccessExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "obj=" + self.canonNode(node.obj, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "field=" + self.canonStr(node.field);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "arrow=" + self.canonBool(node.arrow);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "optional=" + self.canonBool(node.optional);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_CAST_EXPR) {
			string out = "(CastExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "target_type=" + self.canonNode(node.targetType, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "expr=" + self.canonNode(node.expr, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_SIZEOF_EXPR) {
			string out = "(SizeofExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "operand=" + self.canonNode(node.operand, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_TERNARY_EXPR) {
			string out = "(TernaryExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "condition=" + self.canonNode(node.condition, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "true_expr=" + self.canonNode(node.trueExpr, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "false_expr=" + self.canonNode(node.falseExpr, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_ASSIGN_EXPR) {
			string out = "(AssignExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "target=" + self.canonNode(node.target, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "op=" + self.canonStr(node.op);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "value=" + self.canonNode(node.valueNode, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_LIST_LITERAL) {
			string out = "(ListLiteral";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "elements=" + self.canonNodeList(node.elements, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_MAP_LITERAL) {
			string out = "(MapLiteral";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "entries=" + self.canonNodeList(node.entries, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_BRACE_INITIALIZER) {
			string out = "(BraceInitializer";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "elements=" + self.canonNodeList(node.elements, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_F_STRING_LITERAL) {
			string out = "(FStringLiteral";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "parts=" + self.canonNodeList(node.parts, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_NEW_EXPR) {
			string out = "(NewExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "type=" + self.canonNode(node.type, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "args=" + self.canonNodeList(node.args, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "arg_names=" + self.canonStrList(node.argNames, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_TUPLE_LITERAL) {
			string out = "(TupleLiteral";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "elements=" + self.canonNodeList(node.elements, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_LAMBDA_EXPR) {
			string out = "(LambdaExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "return_type=" + self.canonNode(node.returnType, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "params=" + self.canonNodeList(node.params, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "body=" + self.canonNode(node.bodyNode, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "captures=" + self.canonNodeList(node.captures, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_SPAWN_EXPR) {
			string out = "(SpawnExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "fn=" + self.canonNode(node.fn, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_SIZEOF_TYPE) {
			string out = "(SizeofType";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "type=" + self.canonNode(node.type, d + 1);
			return out + ")";
		} else if (node.kind == NK_SIZEOF_EXPR_OP) {
			string out = "(SizeofExprOp";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "expr=" + self.canonNode(node.expr, d + 1);
			return out + ")";
		} else if (node.kind == NK_MAP_ENTRY) {
			string out = "(MapEntry";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "key=" + self.canonNode(node.key, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "value=" + self.canonNode(node.valueNode, d + 1);
			return out + ")";
		} else if (node.kind == NK_F_STRING_TEXT) {
			string out = "(FStringText";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "text=" + self.canonStr(node.text);
			return out + ")";
		} else if (node.kind == NK_F_STRING_EXPR) {
			string out = "(FStringExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "expression=" + self.canonNode(node.expression, d + 1);
			return out + ")";
		} else if (node.kind == NK_LAMBDA_BLOCK) {
			string out = "(LambdaBlock";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "body=" + self.canonNode(node.bodyNode, d + 1);
			return out + ")";
		} else if (node.kind == NK_LAMBDA_EXPR_BODY) {
			string out = "(LambdaExprBody";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "expression=" + self.canonNode(node.expression, d + 1);
			return out + ")";
		} else if (node.kind == NK_CAPTURE) {
			string out = "(Capture";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "type=" + self.canonNode(node.type, d + 1);
			return out + ")";
		}
		return "(Unknown)";
	}

	private string spaces(int n) {
		string s = "";
		int i = 0;
		while (i < n) { s = s + " "; i = i + 1; }
		return s;
	}

	private string canonInt(int v) { return Strings.fromInt(v); }

	private string canonBool(bool b) { if (b) { return "true"; } return "false"; }

	private string canonFloat(float f) { return f"{f}"; }

	private string canonStr(string s) {
		string out = "\"";
		int i = 0;
		int n = s.length();
		while (i < n) {
			char c = s[i];
			if (c == '\\') { out = out + "\\\\"; }
			else if (c == '"') { out = out + "\\\""; }
			else if (c == '\n') { out = out + "\\n"; }
			else if (c == '\r') { out = out + "\\r"; }
			else if (c == '\t') { out = out + "\\t"; }
			else { out = out + f"{c}"; }
			i = i + 1;
		}
		return out + "\"";
	}

	private string canonOptStr(string? s) {
		if (s == null) { return "nil"; }
		return self.canonStr(s);
	}

	private string canonNode(Node node, int d) {
		Node? pending = self.pendingBody;
		if (pending != null && pending == node) {
			self.pendingBody = null;
			IAstInterfaceSummary? summary = self.interfaceSummary;
			Node? callable = self.pendingCallable;
			if (summary != null && callable != null) { return "(ElidedBody " + summary.callableBody(callable) + ")"; }
		}
		if (node == null) { return "nil"; }
		return self.renderAtDepth(node, d);
	}

	private string canonNodeList(Vector<Node> xs, int d) {
		if (xs.len == 0) { return "[]"; }
		string out = "[\n";
		int i = 0;
		while (i < xs.len) {
			out = out + self.spaces(2 * (d + 1)) + self.renderAtDepth(xs.get(i), d + 1);
			if (i < xs.len - 1) { out = out + "\n"; }
			i = i + 1;
		}
		return out + "\n" + self.spaces(2 * d) + "]";
	}

	private string canonStrList(Vector<string> xs, int d) {
		if (xs.len == 0) { return "[]"; }
		string out = "[\n";
		int i = 0;
		while (i < xs.len) {
			out = out + self.spaces(2 * (d + 1)) + self.canonStr(xs.get(i));
			if (i < xs.len - 1) { out = out + "\n"; }
			i = i + 1;
		}
		return out + "\n" + self.spaces(2 * d) + "]";
	}
}

class TypeIdentity {
	class bool asciiLetter(char value) { return (value >= 'A' && value <= 'Z') || (value >= 'a' && value <= 'z'); }

	class bool asciiDigit(char value) { return value >= '0' && value <= '9'; }

	class bool safeBase(string base) {
		int length = base.length();
		if (length == 0 || !TypeIdentity.asciiLetter(base[0])) { return false; }
		if (length >= 2 && base[0] == 'Z' && base[1] == 'Q') { return false; }
		int index = 1;
		while (index < length) {
			char value = base[index];
			if (!TypeIdentity.asciiLetter(value) && !TypeIdentity.asciiDigit(value)) {
				return false;
			}
			index = index + 1;
		}
		return true;
	}

	class string utf8Hex(string value) {
		string digits = "0123456789abcdef";
		StringBuilder encoded = StringBuilder();
		int index = 0;
		while (index < value.length()) {
			int byteValue = (int)((unsigned char)value[index]);
			encoded.appendChar(digits[byteValue / 16]);
			encoded.appendChar(digits[byteValue % 16]);
			index = index + 1;
		}
		return encoded.toString();
	}

	class string field(string tag, string value) { return tag + Strings.fromInt(value.length()) + "_" + value; }

	class int qualifierBits(Node typeExpr) {
		int bits = 0;
		if (typeExpr.isConst) { bits = bits + 1; }
		if (typeExpr.isStatic) { bits = bits + 2; }
		if (typeExpr.isExtern) { bits = bits + 4; }
		if (typeExpr.isVolatile) { bits = bits + 8; }
		return bits;
	}

	class string encodeTypes(Vector<Node> args) {
		string encoded = "k" + Strings.fromInt(args.len);
		int index = 0;
		while (index < args.len) {
			encoded = encoded + TypeIdentity.field("t", TypeIdentity.encode(args.get(index)));
			index = index + 1;
		}
		return encoded;
	}

	class string encode(Node typeExpr) {
		string encodedBase = TypeIdentity.utf8Hex(typeExpr.base);
		string shape = "p" + Strings.fromInt(typeExpr.pointerDepth) + "n" + Strings.fromInt(typeExpr.isNullable ? 1 : 0) + "o" + Strings.fromInt(typeExpr.nullableOuterDepth) + "a" + Strings.fromInt(typeExpr.isArray ? 1 : 0) + "q" + Strings.fromInt(TypeIdentity.qualifierBits(typeExpr));
		return TypeIdentity.field("b", encodedBase) + shape + TypeIdentity.encodeTypes(typeExpr.genericArgs);
	}

	/* Whether `encode` captures the whole type: it omits array-size
	 * expressions (and source positions), so a type carrying one anywhere is
	 * not encodable. */
	class bool encodable(Node typeExpr) {
		if (typeExpr.kind != NK_TYPE_EXPR || typeExpr.arraySize != null) { return false; }
		for argument in typeExpr.genericArgs {
			if (!TypeIdentity.encodable(argument)) { return false; }
		}
		return true;
	}

	/* The inverse of `encode` for an encodable type; null for text that is
	 * not exactly one encoded type. */
	class Node? decode(string text) {
		Vector<int> cursor = [0];
		Node? result = TypeIdentity.decodeAt(text, cursor);
		if (result == null || cursor.get(0) != text.length()) { return null; }
		return result;
	}

	class int decodeInt(string text, Vector<int> cursor) {
		int index = cursor.get(0);
		int start = index;
		int value = 0;
		while (index < text.length() && TypeIdentity.asciiDigit(text[index]) && index - start < 9) {
			value = value * 10 + (int)(text[index] - '0');
			index = index + 1;
		}
		if (index == start) { return -1; }
		cursor.set(0, index);
		return value;
	}

	/* `tag<length>_<value>`: the value, or null when malformed. */
	class string? decodeField(string text, string tag, Vector<int> cursor) {
		int index = cursor.get(0);
		if (index >= text.length() || text[index] != tag[0]) { return null; }
		cursor.set(0, index + 1);
		int length = TypeIdentity.decodeInt(text, cursor);
		index = cursor.get(0);
		if (length < 0 || index >= text.length() || text[index] != '_' || index + 1 + length > text.length()) { return null; }
		cursor.set(0, index + 1 + length);
		return text.substring(index + 1, length);
	}

	/* `<letter><int>` for one shape component, or -1. */
	class int decodeTagged(string text, char tag, Vector<int> cursor) {
		int index = cursor.get(0);
		if (index >= text.length() || text[index] != tag) { return -1; }
		cursor.set(0, index + 1);
		return TypeIdentity.decodeInt(text, cursor);
	}

	class string? hexText(string hex) {
		if (hex.length() % 2 != 0) { return null; }
		StringBuilder text = StringBuilder();
		int index = 0;
		while (index < hex.length()) {
			int high = TypeIdentity.hexDigit(hex[index]);
			int low = TypeIdentity.hexDigit(hex[index + 1]);
			if (high < 0 || low < 0) { return null; }
			text.appendChar((char)(high * 16 + low));
			index = index + 2;
		}
		return text.toString();
	}

	class int hexDigit(char value) {
		if (value >= '0' && value <= '9') { return (int)(value - '0'); }
		if (value >= 'a' && value <= 'f') { return (int)(value - 'a') + 10; }
		return -1;
	}

	class Node? decodeAt(string text, Vector<int> cursor) {
		string? encodedBase = TypeIdentity.decodeField(text, "b", cursor);
		if (encodedBase == null) { return null; }
		string? base = TypeIdentity.hexText(encodedBase);
		int pointers = TypeIdentity.decodeTagged(text, 'p', cursor);
		int nullable = TypeIdentity.decodeTagged(text, 'n', cursor);
		int outer = TypeIdentity.decodeTagged(text, 'o', cursor);
		int array = TypeIdentity.decodeTagged(text, 'a', cursor);
		int qualifiers = TypeIdentity.decodeTagged(text, 'q', cursor);
		int count = TypeIdentity.decodeTagged(text, 'k', cursor);
		if (base == null || pointers < 0 || nullable < 0 || nullable > 1 || outer < 0 || array < 0 || array > 1 || qualifiers < 0 || qualifiers > 15 || count < 0) { return null; }
		Node result = Node();
		result.kind = NK_TYPE_EXPR;
		result.base = base;
		result.pointerDepth = pointers;
		result.isNullable = nullable == 1;
		result.nullableOuterDepth = outer;
		result.isArray = array == 1;
		result.isConst = qualifiers % 2 == 1;
		result.isStatic = (qualifiers / 2) % 2 == 1;
		result.isExtern = (qualifiers / 4) % 2 == 1;
		result.isVolatile = (qualifiers / 8) % 2 == 1;
		int index = 0;
		while (index < count) {
			string? argument = TypeIdentity.decodeField(text, "t", cursor);
			if (argument == null) { return null; }
			Node? decoded = TypeIdentity.decode(argument);
			if (decoded == null) { return null; }
			result.genericArgs.push(decoded);
			index = index + 1;
		}
		return result;
	}

	class string encodeNameAndTypes(string base, Vector<Node> args) { return TypeIdentity.field("b", TypeIdentity.utf8Hex(base)) + TypeIdentity.encodeTypes(args); }

	/* Position-independent semantic key. The encoding is recursive and
     * length-delimited, so no two TypeExpr trees can share a key. */
	class string shapeKey(Node typeExpr) { return TypeIdentity.encode(typeExpr); }

	class string genericInstanceKey(string base, Vector<Node> args) { return TypeIdentity.encodeNameAndTypes(base, args); }

	class string methodInstanceKey(string classBase, Vector<Node> classArgs, string methodName, Vector<Node> methodArgs) { return TypeIdentity.encodeNameAndTypes(classBase, classArgs) + TypeIdentity.field("m", TypeIdentity.utf8Hex(methodName)) + TypeIdentity.encodeTypes(methodArgs); }

	class bool referencesNames(Node? typeExpr, Map<string, bool> names) {
		if (typeExpr == null) { return false; }
		if (names.has(typeExpr.base)) { return true; }
		int index = 0;
		while (index < typeExpr.genericArgs.len) {
			if (TypeIdentity.referencesNames(typeExpr.genericArgs.get(index), names)) {
				return true;
			}
			index = index + 1;
		}
		return false;
	}

	class string genericArgumentProblemInner(Node typeExpr, bool qualifiedComponent) {
		if (!qualifiedComponent && typeExpr.isConst) {
			return "generic arguments cannot be const-qualified";
		}
		if (!qualifiedComponent && typeExpr.isStatic) {
			return "generic arguments cannot be static-qualified";
		}
		if (!qualifiedComponent && typeExpr.isExtern) {
			return "generic arguments cannot be extern-qualified";
		}
		if (!qualifiedComponent && typeExpr.isVolatile) {
			return "generic arguments cannot be volatile-qualified";
		}
		bool childIsStructuralComponent = typeExpr.base == "Tuple" || typeExpr.base == "__fn_ptr" || typeExpr.base == "__realtime_fn_ptr";
		int index = 0;
		while (index < typeExpr.genericArgs.len) {
			string problem = TypeIdentity.genericArgumentProblemInner(typeExpr.genericArgs.get(index), childIsStructuralComponent);
			if (problem != "") { return problem; }
			index = index + 1;
		}
		return "";
	}

	class string genericArgumentProblem(Node typeExpr) { return TypeIdentity.genericArgumentProblemInner(typeExpr, false); }

	class void fail(string message) {
		fprintf(stderr, "error: %s\n", message);
		exit(1);
	}

	class void ensureSupportedGenericArguments(Vector<Node> args) {
		int index = 0;
		while (index < args.len) {
			string problem = TypeIdentity.genericArgumentProblem(args.get(index));
			if (problem != "") { TypeIdentity.fail(problem); }
			index = index + 1;
		}
	}

	class bool legacyComponentPossible(Node typeExpr) { return typeExpr.genericArgs.len == 0 && TypeIdentity.safeBase(typeExpr.base) && typeExpr.nullableOuterDepth == 0 && !typeExpr.isConst && !typeExpr.isStatic && !typeExpr.isExtern && !typeExpr.isVolatile; }

	class string legacyComponent(Node typeExpr) {
		string component = typeExpr.base;
		if (typeExpr.pointerDepth > 0) {
			component = component + "_p" + Strings.fromInt(typeExpr.pointerDepth);
		}
		if (typeExpr.isNullable) { component = component + "_n"; }
		if (typeExpr.isArray) { component = component + "_a"; }
		return component;
	}

	class bool legacySequencePossible(Vector<Node> args) {
		int index = 0;
		while (index < args.len) {
			Node argument = args.get(index);
			if (!TypeIdentity.legacyComponentPossible(argument)) { return false; }
			if (args.len > 1 && (argument.pointerDepth > 0 || argument.isNullable || argument.isArray)) {
				return false;
			}
			index = index + 1;
		}
		return true;
	}

	class string legacySequence(Vector<Node> args) {
		string sequence = "";
		int index = 0;
		while (index < args.len) {
			if (index > 0) { sequence = sequence + "_"; }
			sequence = sequence + TypeIdentity.legacyComponent(args.get(index));
			index = index + 1;
		}
		return sequence;
	}

	class bool legacyComponentSpelling(string value) {
		int length = value.length();
		if (length == 0 || !TypeIdentity.asciiLetter(value[0])) {
			return false;
		}
		int index = 1;
		while (index < length && (TypeIdentity.asciiLetter(value[index]) || TypeIdentity.asciiDigit(value[index]))) {
			index = index + 1;
		}
		string base = value.substring(0, index);
		if (!TypeIdentity.safeBase(base)) { return false; }
		if (index + 2 <= length && value.substring(index, 2) == "_p") {
			index = index + 2;
			int digitStart = index;
			while (index < length && TypeIdentity.asciiDigit(value[index])) {
				index = index + 1;
			}
			if (digitStart == index || value[digitStart] == '0') {
				return false;
			}
		}
		if (index + 2 <= length && value.substring(index, 2) == "_n") {
			index = index + 2;
		}
		if (index + 2 <= length && value.substring(index, 2) == "_a") {
			index = index + 2;
		}
		return index == length;
	}

	class bool legacySequenceSpelling(string value, int arity) {
		if (arity <= 0 || value == "") { return false; }
		if (arity == 1) {
			return TypeIdentity.legacyComponentSpelling(value);
		}
		Vector<string> components = Strings.split(value, "_");
		if (components.len != arity) { return false; }
		int index = 0;
		while (index < components.len) {
			if (!TypeIdentity.safeBase(components.get(index))) {
				return false;
			}
			index = index + 1;
		}
		return true;
	}

	class int encodedFieldEnd(string value, int start, char tag) {
		int length = value.length();
		if (start < 0 || start >= length || value[start] != tag) {
			return -1;
		}
		int index = start + 1;
		int digitStart = index;
		long long payloadLength = 0LL;
		while (index < length && TypeIdentity.asciiDigit(value[index])) {
			long long digit = (long long)(value[index] - '0');
			if (payloadLength > (2147483647LL - digit) / 10LL) {
				return -1;
			}
			payloadLength = payloadLength * 10LL + digit;
			index = index + 1;
		}
		if (digitStart == index || index >= length || value[index] != '_' || (index - digitStart > 1 && value[digitStart] == '0')) {
			return -1;
		}
		index = index + 1;
		if (payloadLength <= 0LL || payloadLength > (long long)(length - index)) {
			return -1;
		}
		return index + (int)payloadLength;
	}

	class int encodedTypesEnd(string value, int start, int arity) {
		if (arity < 0) { return -1; }
		string prefix = "k" + Strings.fromInt(arity);
		if (start < 0 || start + prefix.length() > value.length() || value.substring(start, prefix.length()) != prefix) {
			return -1;
		}
		int index = start + prefix.length();
		int argument = 0;
		while (argument < arity) {
			index = TypeIdentity.encodedFieldEnd(value, index, 't');
			if (index < 0) { return -1; }
			argument = argument + 1;
		}
		return index;
	}

	class bool possibleLegacyMangledGenericType(string symbol, string base, int arity) {
		if (arity <= 0 || !TypeIdentity.safeBase(base)) { return false; }
		string prefix = "btrc_" + base + "_";
		if (!symbol.startsWith(prefix)) { return false; }
		string arguments = symbol.substring(prefix.length(), symbol.length() - prefix.length());
		return TypeIdentity.legacySequenceSpelling(arguments, arity);
	}

	/* Recognize one possible generic-type spelling using only its declared
     * base and arity.  This is intentionally structural: before generic graph
     * closure, semantic analysis does not yet own the concrete TypeExpr rows,
     * but it can still distinguish the canonical legacy/encoded grammars from
     * arbitrary lookalikes. */
	class bool possibleMangledGenericType(string symbol, string base, int arity) {
		if (TypeIdentity.possibleLegacyMangledGenericType(symbol, base, arity)) {
			return true;
		}
		if (arity <= 0) { return false; }
		string prefix = "btrc_ZQg" + TypeIdentity.field("b", TypeIdentity.utf8Hex(base));
		if (!symbol.startsWith(prefix)) { return false; }
		return TypeIdentity.encodedTypesEnd(symbol, prefix.length(), arity) == symbol.length();
	}

	class bool possibleGenericInstanceSymbol(string symbol, string base, int arity, string suffix) {
		if (!symbol.endsWith(suffix) || symbol.length() <= suffix.length()) {
			return false;
		}
		string emitted = symbol.substring(0, symbol.length() - suffix.length());
		return TypeIdentity.possibleMangledGenericType(emitted, base, arity);
	}

	/* Generic-method symbols use the same legacy type sequences, or the
     * collision-safe Qm envelope with independently framed class/method type
     * lists.  Match declared owner/method names and both exact arities. */
	class bool possibleMethodInstanceSymbol(string symbol, string classBase, int classArity, string methodName, int methodArity) {
		if (methodArity <= 0) { return false; }
		if (TypeIdentity.safeBase(classBase) && TypeIdentity.safeBase(methodName)) {
			string marker = "_" + methodName + "_";
			int position = 0;
			while (position + marker.length() < symbol.length()) {
				if (symbol.substring(position, marker.length()) == marker) {
					string owner = symbol.substring(0, position);
					bool ownerMatches = false;
					if (classArity == 0) {
						ownerMatches = owner == classBase;
					} else {
						ownerMatches = TypeIdentity.possibleLegacyMangledGenericType(owner, classBase, classArity);
					}
					int argumentStart = position + marker.length();
					string arguments = symbol.substring(argumentStart, symbol.length() - argumentStart);
					if (ownerMatches && TypeIdentity.legacySequenceSpelling(arguments, methodArity)) {
						return true;
					}
				}
				position = position + 1;
			}
		}

		string prefix = "btrc_ZQm" + TypeIdentity.field("b", TypeIdentity.utf8Hex(classBase));
		if (!symbol.startsWith(prefix)) { return false; }
		int index = TypeIdentity.encodedTypesEnd(symbol, prefix.length(), classArity);
		if (index < 0) { return false; }
		string methodField = TypeIdentity.field("m", TypeIdentity.utf8Hex(methodName));
		if (index + methodField.length() > symbol.length() || symbol.substring(index, methodField.length()) != methodField) {
			return false;
		}
		index = TypeIdentity.encodedTypesEnd(symbol, index + methodField.length(), methodArity);
		return index == symbol.length();
	}


	/* Injective C-identifier component for one type. Types that already spell
     * a safe legacy identifier keep it; everything else takes the reserved
     * length-delimited encoding. Mirrors TypeIdentity.symbol_component. */
	class string symbolComponent(Node typeExpr) {
		if (TypeIdentity.legacyComponentPossible(typeExpr)) {
			return TypeIdentity.legacyComponent(typeExpr);
		}
		return "ZQt" + TypeIdentity.encode(typeExpr);
	}

	/* Structural primitive: unlike writable class specializations, Tuple and
     * __fn_ptr are allowed to carry qualified component types. */
	class string mangleGenericSymbol(string base, Vector<Node> args) {
		if (TypeIdentity.safeBase(base) && TypeIdentity.legacySequencePossible(args)) {
			string legacy = TypeIdentity.legacySequence(args);
			if (legacy == "") { return "btrc_" + base; }
			return "btrc_" + base + "_" + legacy;
		}
		return "btrc_ZQg" + TypeIdentity.encodeNameAndTypes(base, args);
	}

	/* Writable class specialization entry point: fail closed on qualifiers. */
	class string mangleGenericType(string base, Vector<Node> args) {
		TypeIdentity.ensureSupportedGenericArguments(args);
		return TypeIdentity.mangleGenericSymbol(base, args);
	}

	class string mangleMethodInstanceSymbol(string classBase, Vector<Node> classArgs, string methodName, Vector<Node> methodArgs) {
		TypeIdentity.ensureSupportedGenericArguments(classArgs);
		TypeIdentity.ensureSupportedGenericArguments(methodArgs);
		bool legacy = TypeIdentity.safeBase(classBase) && TypeIdentity.safeBase(methodName) && TypeIdentity.legacySequencePossible(classArgs) && TypeIdentity.legacySequencePossible(methodArgs);
		if (legacy) {
			string classPart = classBase;
			if (classArgs.len > 0) {
				classPart = "btrc_" + classBase + "_" + TypeIdentity.legacySequence(classArgs);
			}
			string methodPart = "_" + methodName;
			string methodLegacy = TypeIdentity.legacySequence(methodArgs);
			if (methodLegacy != "") {
				methodPart = methodPart + "_" + methodLegacy;
			}
			return classPart + methodPart;
		}
		string payload = TypeIdentity.encodeNameAndTypes(classBase, classArgs) + TypeIdentity.field("m", TypeIdentity.utf8Hex(methodName)) + TypeIdentity.encodeTypes(methodArgs);
		return "btrc_ZQm" + payload;
	}

	class string mangleFunctionPointerSymbol(Vector<Node> args) {
		if (TypeIdentity.legacySequencePossible(args)) {
			return "__btrc_fn_" + TypeIdentity.legacySequence(args);
		}
		return "__btrc_fn_ZQf" + TypeIdentity.encodeTypes(args);
	}
}
