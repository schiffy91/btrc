/* Stable AST identity/rendering plus recursive type identity and C symbols. */

import Library.Map;
import Library.Strings;
import Library.Vector;

import ../generated/ast/Node.btrc;
#include <stdint.h>

class AstIdentity {
	/* Source positions are not unique for chained expressions. The self-host
     * runtime gives class values stable pointer identity, so side tables use
     * that identity directly. */
	class string key(Node node) { return f"{(unsigned long long)(uintptr_t)node}"; }
}

/* A kind-independent walk of the fat AST node: every Node-valued field, in
 * the order Node declares them. A kind leaves the fields it does not use null
 * or empty. Structural keys (pre-order positions within a declaration) are
 * built on this walk, so a new Node field belongs here too; a structure test
 * checks the two lists agree. */
class AstStructure {
	class void children(Node node, Vector<Node> out) {
		for child in node.declarations { out.push(child); }
		if (node.spec != null) { out.push(node.spec); }
		for child in node.members { out.push(child); }
		for child in node.methods { out.push(child); }
		if (node.returnType != null) { out.push(node.returnType); }
		for child in node.params { out.push(child); }
		if (node.bodyNode != null) { out.push(node.bodyNode); }
		for child in node.fields { out.push(child); }
		for child in node.values { out.push(child); }
		for child in node.variants { out.push(child); }
		if (node.original != null) { out.push(node.original); }
		for child in node.genericArgs { out.push(child); }
		if (node.arraySize != null) { out.push(node.arraySize); }
		if (node.type != null) { out.push(node.type); }
		if (node.default_ != null) { out.push(node.default_); }
		if (node.initializer != null) { out.push(node.initializer); }
		if (node.getterBody != null) { out.push(node.getterBody); }
		if (node.setterBody != null) { out.push(node.setterBody); }
		if (node.valueNode != null) { out.push(node.valueNode); }
		for child in node.statements { out.push(child); }
		if (node.condition != null) { out.push(node.condition); }
		if (node.thenBlock != null) { out.push(node.thenBlock); }
		if (node.elseBlock != null) { out.push(node.elseBlock); }
		if (node.iterable != null) { out.push(node.iterable); }
		if (node.init != null) { out.push(node.init); }
		if (node.update != null) { out.push(node.update); }
		for child in node.cases { out.push(child); }
		if (node.expr != null) { out.push(node.expr); }
		if (node.tryBlock != null) { out.push(node.tryBlock); }
		if (node.catchType != null) { out.push(node.catchType); }
		if (node.catchBlock != null) { out.push(node.catchBlock); }
		if (node.finallyBlock != null) { out.push(node.finallyBlock); }
		if (node.ifStmt != null) { out.push(node.ifStmt); }
		if (node.varDecl != null) { out.push(node.varDecl); }
		if (node.expression != null) { out.push(node.expression); }
		for child in node.bodyNodeList { out.push(child); }
		if (node.left != null) { out.push(node.left); }
		if (node.right != null) { out.push(node.right); }
		if (node.operand != null) { out.push(node.operand); }
		if (node.callee != null) { out.push(node.callee); }
		for child in node.args { out.push(child); }
		if (node.obj != null) { out.push(node.obj); }
		if (node.index != null) { out.push(node.index); }
		if (node.targetType != null) { out.push(node.targetType); }
		if (node.trueExpr != null) { out.push(node.trueExpr); }
		if (node.falseExpr != null) { out.push(node.falseExpr); }
		if (node.target != null) { out.push(node.target); }
		for child in node.elements { out.push(child); }
		for child in node.entries { out.push(child); }
		for child in node.parts { out.push(child); }
		for child in node.captures { out.push(child); }
		if (node.fn != null) { out.push(node.fn); }
		if (node.key != null) { out.push(node.key); }
	}

	/* Every node reachable from `root` once, in pre-order: a node's index is
	 * its position. A node reached again (a shared subtree) keeps its first
	 * position. */
	class Vector<Node> preorder(Node root) {
		Vector<Node> result = [];
		Map<Node, bool> seen = {};
		Vector<Node> pending = [root];
		Vector<Node> children = [];
		while (pending.len > 0) {
			Node node = pending.pop();
			if (seen.has(node)) { continue; }
			seen.put(node, true);
			result.push(node);
			children.clear();
			AstStructure.children(node, children);
			int index = children.len - 1;
			while (index >= 0) {
				pending.push(children.get(index));
				index = index - 1;
			}
		}
		return result;
	}

	/* Pre-order position of every node reachable from `root`, by identity. */
	class Map<Node, int> positions(Node root) {
		Map<Node, int> result = {};
		Vector<Node> nodes = AstStructure.preorder(root);
		int index = 0;
		while (index < nodes.len) {
			result.put(nodes.get(index), index);
			index = index + 1;
		}
		return result;
	}
}

/* What an interface rendering keeps of a callable body another declaration
 * may read: supplied by the owner of those semantics, never by syntax. */
interface IAstInterfaceSummary {
	string callableBody(Node callable);
}

class AstCanonicalRenderer {
	/* Interface mode: a non-template callable body renders as its summary. */
	private IAstInterfaceSummary? interfaceSummary = null;
	/* Positions are not part of an interface; a digest renders without them. */
	private bool positions = true;
	private int templateDepth = 0;
	private Node? pendingBody = null;

	public AstCanonicalRenderer() {}

	/* A renderer for declaration interfaces: generic templates keep their
	 * bodies because other groups instantiate them; any other callable body is
	 * replaced by `summary`. Position fields are omitted: the text is an
	 * identity, and an edit that only moves a declaration keeps it. */
	class AstCanonicalRenderer interfaceRenderer(IAstInterfaceSummary summary) {
		AstCanonicalRenderer renderer = AstCanonicalRenderer.positionFreeRenderer();
		renderer.interfaceSummary = summary;
		return renderer;
	}

	/* The canonical text without line, column or source-file fields. */
	class AstCanonicalRenderer positionFreeRenderer() {
		AstCanonicalRenderer renderer = AstCanonicalRenderer();
		renderer.positions = false;
		return renderer;
	}

	public string render(Node node) { return self.renderAtDepth(node, 0); }

	private void enterMembers(bool template) { if (template) { self.templateDepth = self.templateDepth + 1; } }

	private void leaveMembers(bool template) { if (template) { self.templateDepth = self.templateDepth - 1; } }

	/* The next canonNode of exactly `body` is the callable's own body. */
	private void beginBody(Node callable, Node? body, bool template) {
		if (self.interfaceSummary != null && self.templateDepth == 0 && !template) { self.pendingBody = body; }
		else { self.pendingBody = null; }
		self.pendingCallable = callable;
	}

	private Node? pendingCallable = null;

	private string renderAtDepth(Node node, int d) {
		if (node.kind == NK_PROGRAM) {
			string out = "(Program";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "declarations=" + self.canonNodeList(node.declarations, d + 1);
			return out + ")";
		} else if (node.kind == NK_PREPROCESSOR_DIRECTIVE) {
			string out = "(PreprocessorDirective";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "text=" + self.canonStr(node.text);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "source_file=" + self.canonOptStr(node.sourceFile); }
			return out + ")";
		} else if (node.kind == NK_IMPORT_DECL) {
			string out = "(ImportDecl";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "spec=" + self.canonNode(node.spec, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "source_file=" + self.canonOptStr(node.sourceFile); }
			return out + ")";
		} else if (node.kind == NK_CLASS_DECL) {
			string out = "(ClassDecl";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "generic_params=" + self.canonStrList(node.genericParams, d + 1);
			self.enterMembers(node.genericParams.len > 0);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "members=" + self.canonNodeList(node.members, d + 1);
			self.leaveMembers(node.genericParams.len > 0);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "parent=" + self.canonOptStr(node.parent);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "interfaces=" + self.canonStrList(node.interfaces, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_abstract=" + self.canonBool(node.isAbstract);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "name_line=" + self.canonInt(node.nameLine); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "name_col=" + self.canonInt(node.nameCol); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "source_file=" + self.canonOptStr(node.sourceFile); }
			return out + ")";
		} else if (node.kind == NK_INTERFACE_DECL) {
			string out = "(InterfaceDecl";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "methods=" + self.canonNodeList(node.methods, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "parent=" + self.canonOptStr(node.parent);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "generic_params=" + self.canonStrList(node.genericParams, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "name_line=" + self.canonInt(node.nameLine); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "name_col=" + self.canonInt(node.nameCol); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "source_file=" + self.canonOptStr(node.sourceFile); }
			return out + ")";
		} else if (node.kind == NK_FUNCTION_DECL) {
			string out = "(FunctionDecl";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "return_type=" + self.canonNode(node.returnType, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "params=" + self.canonNodeList(node.params, d + 1);
			self.beginBody(node, node.bodyNode, false);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "body=" + self.canonNode(node.bodyNode, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_gpu=" + self.canonBool(node.isGpu);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_realtime=" + self.canonBool(node.isRealtime);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "keep_return=" + self.canonBool(node.keepReturn);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "name_line=" + self.canonInt(node.nameLine); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "name_col=" + self.canonInt(node.nameCol); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "source_file=" + self.canonOptStr(node.sourceFile); }
			return out + ")";
		} else if (node.kind == NK_STRUCT_DECL) {
			string out = "(StructDecl";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "fields=" + self.canonNodeList(node.fields, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_forward=" + self.canonBool(node.isForward);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "name_line=" + self.canonInt(node.nameLine); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "name_col=" + self.canonInt(node.nameCol); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "source_file=" + self.canonOptStr(node.sourceFile); }
			return out + ")";
		} else if (node.kind == NK_ENUM_DECL) {
			string out = "(EnumDecl";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "values=" + self.canonNodeList(node.values, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "name_line=" + self.canonInt(node.nameLine); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "name_col=" + self.canonInt(node.nameCol); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "source_file=" + self.canonOptStr(node.sourceFile); }
			return out + ")";
		} else if (node.kind == NK_RICH_ENUM_DECL) {
			string out = "(RichEnumDecl";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "variants=" + self.canonNodeList(node.variants, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "name_line=" + self.canonInt(node.nameLine); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "name_col=" + self.canonInt(node.nameCol); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "source_file=" + self.canonOptStr(node.sourceFile); }
			return out + ")";
		} else if (node.kind == NK_TYPEDEF_DECL) {
			string out = "(TypedefDecl";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "original=" + self.canonNode(node.original, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "alias=" + self.canonStr(node.alias);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "name_line=" + self.canonInt(node.nameLine); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "name_col=" + self.canonInt(node.nameCol); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "source_file=" + self.canonOptStr(node.sourceFile); }
			return out + ")";
		} else if (node.kind == NK_LIBRARY_GLOB) {
			string out = "(LibraryGlob";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "recursive=" + self.canonBool(node.recursive);
			return out + ")";
		} else if (node.kind == NK_LIBRARY_MODULES) {
			string out = "(LibraryModules";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "names=" + self.canonStrList(node.names, d + 1);
			return out + ")";
		} else if (node.kind == NK_PACKAGE_PATH) {
			string out = "(PackagePath";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "segments=" + self.canonStrList(node.segments(), d + 1);
			return out + ")";
		} else if (node.kind == NK_RELATIVE_PATH) {
			string out = "(RelativePath";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "path=" + self.canonStr(node.path);
			return out + ")";
		} else if (node.kind == NK_QUOTED_PATH) {
			string out = "(QuotedPath";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "path=" + self.canonStr(node.path);
			return out + ")";
		} else if (node.kind == NK_TYPE_EXPR) {
			string out = "(TypeExpr";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "base=" + self.canonStr(node.base);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "generic_args=" + self.canonNodeList(node.genericArgs, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "pointer_depth=" + self.canonInt(node.pointerDepth);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_array=" + self.canonBool(node.isArray);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "array_size=" + self.canonNode(node.arraySize, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_const=" + self.canonBool(node.isConst);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_nullable=" + self.canonBool(node.isNullable);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "nullable_outer_depth=" + self.canonInt(node.nullableOuterDepth);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_static=" + self.canonBool(node.isStatic);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_extern=" + self.canonBool(node.isExtern);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_volatile=" + self.canonBool(node.isVolatile);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_PARAM) {
			string out = "(Param";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "type=" + self.canonNode(node.type, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "default=" + self.canonNode(node.default_, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "keep=" + self.canonBool(node.keep_);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "name_line=" + self.canonInt(node.nameLine); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "name_col=" + self.canonInt(node.nameCol); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_FIELD_DECL) {
			string out = "(FieldDecl";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "access=" + self.canonStr(node.access);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "type=" + self.canonNode(node.type, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "initializer=" + self.canonNode(node.initializer, d + 1);
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "name_line=" + self.canonInt(node.nameLine); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "name_col=" + self.canonInt(node.nameCol); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "line=" + self.canonInt(node.line); }
			if (self.positions) { out = out + "\n" + self.spaces(2 * (d + 1)) + "col=" + self.canonInt(node.col); }
			return out + ")";
		} else if (node.kind == NK_METHOD_DECL) {
			string out = "(MethodDecl";
			out = out + "\n" + self.spaces(2 * (d + 1)) + "access=" + self.canonStr(node.access);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "return_type=" + self.canonNode(node.returnType, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "name=" + self.canonStr(node.name);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "is_constructor=" + self.canonBool(node.isConstructor);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "generic_params=" + self.canonStrList(node.genericParams, d + 1);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "params=" + self.canonNodeList(node.params, d + 1);
			self.beginBody(node, node.bodyNode, node.genericParams.len > 0);
			out = out + "\n" + self.spaces(2 * (d + 1)) + "body=" + self.canonNode(node.bodyNode, d + 1);
