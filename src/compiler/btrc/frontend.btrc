/* Compiler front-end orchestration (self-hosted port of frontend.py).
 *
 * Owns the source-to-composed-source pipeline that runs BEFORE lexing the
 * program for real:
 *
 *     #include / import resolution  ->  stdlib composition  ->  combined source
 *
 * The resolved bundle is byte-identical to btrcpy for the same import mode.
 * Strict per-file imports are the default; legacy whole-stdlib composition is
 * available only through the explicit relaxed compatibility mode.
 *
 * Faithful port of:
 *   - resolve_frontend_source / _resolve_includes_mapped / _resolve_traced
 *   - get_stdlib_source_mapped / _discover_stdlib_files / _stdlib_file_source
 *   - _resolve_include_path / _find_stdlib_file / import_spec_paths /
 *     _relative_import_paths / _stdlib_glob_paths / _stdlib_module_path
 *   - import_scan.scan_directives  (comment/string-aware directive location)
 * Lexical/canonical path rules live in frontend_paths.btrc so drive, UNC, and
 * separator semantics stay independently testable.
 *
 * btrc gotchas honored throughout:
 *   - string.substring(start, COUNT) takes a LENGTH, not an end index.
 *   - char -> string via f"{c}" (string + char concatenation is unsupported).
 *   - String methods are instance (.length(), .substring(a,n), .indexOf(x),
 *     .startsWith(x)); char classification is static (Strings.isSpace(c) etc).
 *   - Map.get aborts on a missing key — every read is guarded by .has(k).
 *   - obj.field = call() double-evaluates: results are hoisted into locals.
 *
 * Requires the stdlib (FileSystem / PathTools / Strings / Vector / Map) and the
 * btrc lexer (tokens.btrc, ebnf.btrc, lexer.btrc) to be in scope. Include this
 * after those modules and frontend_paths.btrc; a driver / btrcc wires the
 * grammar in.
 */

#include "frontend_source_io.btrc"

/* Immutable source-text semantics shared by directive scanning, provenance,
 * and relaxed-stdlib composition. */
class FeSourceText {
    private string content;

    public FeSourceText(string content) {
        self.content = content;
    }

    /* Matches Python str.split("\n"), including the final empty line when
     * the source ends in a newline. */
    public Vector<string> lines() {
        Vector<string> result = [];
        int start = 0;
        int index = 0;
        while (index < self.content.length()) {
            if (self.content[index] == '\n') {
                result.push(self.content.substring(start, index - start));
                start = index + 1;
            }
            index++;
        }
        result.push(self.content.substring(
            start, self.content.length() - start));
        return result;
    }

    public int lineCount() {
        int count = 1;
        int index = 0;
        while (index < self.content.length()) {
            if (self.content[index] == '\n') { count++; }
            index++;
        }
        return count;
    }

    /* Prefix check at an exact source offset without allocating a suffix. */
    public bool startsWithAt(int position, string prefix) {
        if (position < 0
                || position + prefix.length() > self.content.length()) {
            return false;
        }
        int index = 0;
        while (index < prefix.length()) {
            if (self.content[position + index] != prefix[index]) {
                return false;
            }
            index++;
        }
        return true;
    }

    class string joinLines(Vector<string> lines) {
        return Strings.join(lines, "\n");
    }
}

/* ----- a resolved source line: text + native provenance ------------------- */

class FeLine {
    public string text;
    public string sourceFile;  /* absolute path */
    public int lineNumber;     /* 1-based, in sourceFile */

    public FeLine(string text, string sourceFile, int lineNumber) {
        self.text = text;
        self.sourceFile = sourceFile;
        self.lineNumber = lineNumber;
    }
}

enum FeDependencyKind {
    FE_DEPENDENCY_IMPORT = 1,
    FE_DEPENDENCY_INCLUDE = 2,
};

class FeDependencyEdge {
    public string target;
    public int kind;

    public FeDependencyEdge(string target, int kind) {
        self.target = target;
        self.kind = kind;
    }
}

/* Typed dependency graph for per-file visibility. Language imports remain
 * directed; legacy #include edges are traversed in both directions because
 * their source fragments form one compilation unit. */
class FeDependencyGraph {
    public Map<string, Vector<FeDependencyEdge>> outgoing;
    public Map<string, Vector<string>> includeParents;

    public FeDependencyGraph() {
        self.outgoing = {};
        self.includeParents = {};
    }

    public string identity(string path) {
        return feCanonicalPathIdentity(path);
    }

    public void ensureSource(string source) {
        string canonical = self.identity(source);
        if (!self.outgoing.has(canonical)) {
            Vector<FeDependencyEdge> empty = [];
            self.outgoing.put(canonical, empty);
        }
        if (!self.includeParents.has(canonical)) {
            Vector<string> emptyParents = [];
            self.includeParents.put(canonical, emptyParents);
        }
    }

    public bool containsEdge(Vector<FeDependencyEdge> edges,
                             string target, int kind) {
        int index = 0;
        while (index < edges.len) {
            FeDependencyEdge edge = edges.get(index);
            if (edge.kind == kind && edge.target.equals(target)) { return true; }
            index++;
        }
        return false;
    }

    public bool containsPath(Vector<string> paths, string target) {
        int index = 0;
        while (index < paths.len) {
            if (paths.get(index).equals(target)) { return true; }
            index++;
        }
        return false;
    }

    public void add(string source, string target, int kind) {
        string canonicalSource = self.identity(source);
        string canonicalTarget = self.identity(target);
        self.ensureSource(canonicalSource);
        self.ensureSource(canonicalTarget);
        Vector<FeDependencyEdge> edges = self.outgoing.get(canonicalSource);
        if (!self.containsEdge(edges, canonicalTarget, kind)) {
            edges.push(FeDependencyEdge(canonicalTarget, kind));
        }
        if (kind == FE_DEPENDENCY_INCLUDE) {
            Vector<string> parents = self.includeParents.get(canonicalTarget);
            if (!self.containsPath(parents, canonicalSource)) {
                parents.push(canonicalSource);
            }
        }
    }

    public void addImport(string source, string target) {
        self.add(source, target, FE_DEPENDENCY_IMPORT);
    }

    public void addInclude(string source, string target) {
        self.add(source, target, FE_DEPENDENCY_INCLUDE);
    }

    public bool hasSource(string source) {
        return self.outgoing.has(self.identity(source));
    }

    public void queueUnseen(string path, Map<string, bool> seen,
                            Vector<string> pending) {
        if (!seen.has(path)) { pending.push(path); }
    }

    public Map<string, bool> visibilityReachable(string source) {
        string start = self.identity(source);
        Map<string, bool> seen = {};
        Vector<string> pending = [start];
        int index = 0;
        while (index < pending.len) {
            string current = pending.get(index);
            index++;
            if (seen.has(current)) { continue; }
            seen.put(current, true);
            if (self.outgoing.has(current)) {
                Vector<FeDependencyEdge> edges = self.outgoing.get(current);
                int edgeIndex = 0;
                while (edgeIndex < edges.len) {
                    self.queueUnseen(edges.get(edgeIndex).target, seen, pending);
                    edgeIndex++;
                }
            }
            if (self.includeParents.has(current)) {
                Vector<string> parents = self.includeParents.get(current);
                int parentIndex = 0;
                while (parentIndex < parents.len) {
                    self.queueUnseen(parents.get(parentIndex), seen, pending);
                    parentIndex++;
                }
            }
        }
        return seen;
    }
}

/* One exact, deterministic view of every root standard-library module. Root
 * modules are the external-symbol index domain; imported nested modules are
 * compilation-local and contribute declarations through the resolved AST. */
class FeStdlibRootSnapshot {
    private Vector<string> paths;
    private Vector<string> sources;

    public FeStdlibRootSnapshot(Vector<string> paths, Vector<string> sources) {
        self.paths = paths;
        self.sources = sources;
    }

    public int count() {
        return self.paths.len;
    }

    public string pathAt(int index) {
        return self.paths.get(index);
    }

    public string sourceAt(int index) {
        return self.sources.get(index);
    }

    public bool sameContents(FeStdlibRootSnapshot other) {
        if (self.count() != other.count()) { return false; }
        int index = 0;
        while (index < self.count()) {
            if (!self.pathAt(index).equals(other.pathAt(index))
                    || !self.sourceAt(index).equals(other.sourceAt(index))) {
                return false;
            }
            index++;
        }
        return true;
    }

    public int indexOf(string path) {
        string identity = feCanonicalPathIdentity(path);
        int index = 0;
        while (index < self.count()) {
            if (feCanonicalPathIdentity(self.pathAt(index)).equals(identity)) {
                return index;
            }
            index++;
        }
        return -1;
    }

    public bool contains(string path) {
        return self.indexOf(path) >= 0;
    }
}

class FeResolvedSource {
    public string userSource;
    public string source;
    public string stdlibSource;
    public Vector<FeLine> userLines;
    public FeDependencyGraph dependencies;
    public bool strictImports;
    public int stdlibLineCount;
    public string rootSourcePath;
    public FeStdlibRootSnapshot stdlibSnapshot;

    public FeResolvedSource(string userSource, string source,
                            string stdlibSource, Vector<FeLine> userLines,
                            FeDependencyGraph dependencies, bool strictImports,
                            int stdlibLineCount, string rootSourcePath,
                            FeStdlibRootSnapshot stdlibSnapshot) {
        self.userSource = userSource;
        self.source = source;
        self.stdlibSource = stdlibSource;
        self.userLines = userLines;
        self.dependencies = dependencies;
        self.strictImports = strictImports;
        self.stdlibLineCount = stdlibLineCount;
        self.rootSourcePath = rootSourcePath;
        self.stdlibSnapshot = stdlibSnapshot;
    }

    public FeLine? userLineForCombined(int line) {
        int index = line - self.stdlibLineCount - 1;
        if (index < 0 || index >= self.userLines.len) { return null; }
        return self.userLines.get(index);
    }
}

/* ----- a located import/include directive ---------------------------------- */

class FeDirective {
    public string kind;     /* "import" or "btrc_include" */
    public string payload;  /* import: raw spec text; include: the .btrc path */
    public int start;       /* 1-based start line (inclusive) */
    public int end;         /* 1-based end line (inclusive) */

    public FeDirective(string kind, string payload, int start, int end) {
        self.kind = kind;
        self.payload = payload;
        self.start = start;
        self.end = end;
    }
}

/* Deterministic directory-reading policy. FileSystem/Directory preserve native
 * readdir order, while both compiler frontends promise lexical import order. */
class FeSourceDirectoryScanner {
    private int maximumEntries;

    public FeSourceDirectoryScanner() {
        self.maximumEntries = FE_MAX_IMPORT_SCAN_ENTRIES;
    }

    private void sort(Vector<string> entries) {
        entries.sortBy((string left, string right) =>
            Strings.lessThan(left, right));
    }

    public Vector<string> sortedEntries(string path) {
        Vector<string> entries = feReadRequiredDirectory(
            path, self.maximumEntries);
        self.sort(entries);
        return entries;
    }

    public Vector<string> sortedEntriesWithinBudget(
            string path, FeDirectoryScanBudget budget) {
        Vector<string> entries = feReadRequiredDirectory(
            path, budget.remainingEntries());
        budget.addEntries(entries.len);
        self.sort(entries);
        return entries;
    }
}

/* ----- directive scanning (comment/string-aware, via the lexer) ------------ */

class FeDirectiveScanner {
    private GrammarInfo grammar;

    public FeDirectiveScanner(GrammarInfo grammar) {
        self.grammar = grammar;
    }

    /* Extract the include path from a `#include "X.btrc"` preprocessor token,
     * or return "" for a C include (`<...>` or non-.btrc). */
    private string cIncludeBtrcPath(string tokenValue) {
        string s = tokenValue.trim();
        if (!FeSourceText(s).startsWithAt(0, "#include")) { return ""; }
        int i = 8;
        int n = s.length();
        if (i >= n || (s[i] != ' ' && s[i] != '\t')) { return ""; }
        while (i < n && (s[i] == ' ' || s[i] == '\t')) { i++; }
        if (i >= n) { return ""; }
        char open = s[i];
        if (open != '"' && open != '<') { return ""; }
        char close = open == '<' ? '>' : '"';
        i++;
        int pathStart = i;
        while (i < n && s[i] != close && s[i] != '"') { i++; }
        if (i >= n || s[i] != close) { return ""; }
        string path = s.substring(pathStart, i - pathStart);
        i++;
        while (i < n && (s[i] == ' ' || s[i] == '\t')) { i++; }
        if (i != n || !path.endsWith(".btrc")) { return ""; }
        return path;
    }

    private int importTokenEnd(Vector<Token> tokens, int start) {
        if (start >= tokens.len || tokens.get(start).type.equals("EOF")) {
            return -1;
        }
        Token first = tokens.get(start);
        if (first.type.equals("STRING_LIT") || first.type.equals("PATH_SPEC")) {
            return start + 1;
        }
        if (!first.type.equals("IDENT")) { return -1; }
        int index = start + 1;
        if (!first.value.equals("std")) {
            while (index < tokens.len && tokens.get(index).type.equals("DOT")) {
                if (index + 1 >= tokens.len
                        || !tokens.get(index + 1).type.equals("IDENT")) {
                    return -1;
                }
                index = index + 2;
            }
            return index;
        }
        if (index >= tokens.len || !tokens.get(index).type.equals("DOT")) {
            return index;
        }
        index++;
        if (index >= tokens.len) { return -1; }
        Token spec = tokens.get(index);
        if (spec.type.equals("IDENT")) { return index + 1; }
        if (spec.type.equals("STAR")) {
            index++;
            if (index < tokens.len && tokens.get(index).type.equals("STAR")) {
                index++;
            }
            return index;
        }
        if (!spec.type.equals("LBRACE")) { return -1; }
        index++;
        if (index >= tokens.len || !tokens.get(index).type.equals("IDENT")) {
            return -1;
        }
        index++;
        while (index < tokens.len && tokens.get(index).type.equals("COMMA")) {
            index++;
            if (index < tokens.len && tokens.get(index).type.equals("RBRACE")) {
                break;
            }
            if (index >= tokens.len
                    || !tokens.get(index).type.equals("IDENT")) {
                return -1;
            }
            index++;
        }
        if (index >= tokens.len || !tokens.get(index).type.equals("RBRACE")) {
            return -1;
        }
        return index + 1;
    }

    private string canonicalImportSpec(
            Vector<Token> tokens, int start, int end) {
        if (end > start && tokens.get(end - 1).type.equals("SEMICOLON")) {
            end--;
        }
        Token first = tokens.get(start);
        if (first.type.equals("STRING_LIT") || first.type.equals("PATH_SPEC")) {
            return first.value;
        }
        string canonical = "";
        int index = start;
        while (index < end) {
            canonical = canonical + tokens.get(index).value;
            index++;
        }
        return canonical;
    }

    /* Locate whole-line import and btrc-include directives. The lexer makes
     * the scan comment- and string-aware using the pipeline grammar. */
    public Vector<FeDirective> scan(string source) {
        Vector<FeDirective> directives = [];
        Lexer lexer = Lexer(source, self.grammar);
        Vector<Token> tokens = lexer.tokenize();

        Map<int, int> firstCol = {};
        Map<int, int> lastCol = {};
        int tokenIndex = 0;
        while (tokenIndex < tokens.len) {
            Token token = tokens.get(tokenIndex);
            if (!token.type.equals("EOF")) {
                if (!firstCol.has(token.line)) {
                    firstCol.put(token.line, token.col);
                }
                lastCol.put(token.line, token.col);
            }
            tokenIndex++;
        }

        int index = 0;
        while (index < tokens.len) {
            Token token = tokens.get(index);
            bool isFirst = firstCol.has(token.line)
                && firstCol.get(token.line) == token.col;
            bool isImport = token.type.equals("IMPORT")
                || (token.type.equals("IDENT")
                    && token.value.equals("import"));
            if (isFirst && isImport) {
                int specEnd = self.importTokenEnd(tokens, index + 1);
                if (specEnd < 0) {
                    fprintf(stderr,
                        "error: invalid import specification at line %d\n",
                        token.line);
                    exit(1);
                }
                int afterDirective = specEnd;
                if (afterDirective < tokens.len
                        && tokens.get(afterDirective).type.equals("SEMICOLON")) {
                    afterDirective++;
                }
                Token endToken = tokens.get(afterDirective - 1);
                bool ownsLine = lastCol.has(endToken.line)
                    && lastCol.get(endToken.line) == endToken.col;
                if (ownsLine) {
                    string canonical = self.canonicalImportSpec(
                        tokens, index + 1, specEnd);
                    directives.push(FeDirective(
                        "import", canonical, token.line, endToken.line));
                }
                index = afterDirective;
                continue;
            }
            if (isFirst && token.type.equals("PREPROCESSOR")) {
                string path = self.cIncludeBtrcPath(token.value);
                bool isLast = lastCol.has(token.line)
                    && lastCol.get(token.line) == token.col;
                if (path.length() > 0 && isLast) {
                    directives.push(FeDirective(
                        "btrc_include", path, token.line, token.line));
                }
            }
            index++;
        }
        return directives;
    }
}

class FeStdlibLookup {
    public bool found;
    public string path;
    public string diagnostic;

    public FeStdlibLookup(bool found, string path, string diagnostic) {
        self.found = found;
        self.path = path;
        self.diagnostic = diagnostic;
    }
}

/* Instance-owned access to one standard-library directory. Each compilation
 * snapshots root modules so resolution and external-symbol indexing share the
 * same bytes. Nested modules are read once when explicitly resolved. */
class FeStdlibRepository {
    private string directoryPath;
    private FeDirectiveScanner directiveScanner;
    private FeSourceDirectoryScanner sourceDirectories;

    public FeStdlibRepository(string directory, GrammarInfo grammar) {
        self.directoryPath = feAbsPath(directory);
        self.directiveScanner = FeDirectiveScanner(grammar);
        self.sourceDirectories = FeSourceDirectoryScanner();
    }

    public string directory() {
        return self.directoryPath;
    }

    private bool containsPath(Vector<string> paths, string target) {
        int index = 0;
        while (index < paths.len) {
            if (paths.get(index).equals(target)) { return true; }
            index++;
        }
        return false;
    }

    private Vector<string> discoverFiles() {
        Vector<string> ordered = [];
        if (!FileSystem.isDir(self.directoryPath)) { return ordered; }
        Vector<string> entries = self.sourceDirectories.sortedEntries(
            self.directoryPath);
        Vector<string> files = [];
        int index = 0;
        while (index < entries.len) {
            string name = entries.get(index);
            if (name.endsWith(".btrc")) { files.push(name); }
            index++;
        }
        Vector<string> priority = [
            "vector.btrc",
            "list.btrc",
            "strings.btrc",
            "platform.btrc",
            "process.btrc",
            "fs.btrc",
            "daemon.btrc",
            "ui.btrc",
        ];
        int priorityIndex = 0;
        while (priorityIndex < priority.len) {
            string name = priority.get(priorityIndex);
            if (self.containsPath(files, name)) { ordered.push(name); }
            priorityIndex++;
        }
        index = 0;
        while (index < files.len) {
            string name = files.get(index);
            if (!self.containsPath(priority, name)) { ordered.push(name); }
            index++;
        }
        return ordered;
    }

    public FeStdlibRootSnapshot rootSnapshot() {
        Vector<string> paths = [];
        Vector<string> sources = [];
        Vector<string> files = self.discoverFiles();
        int index = 0;
        while (index < files.len) {
            string path = feJoinPath(self.directoryPath, files.get(index));
            if (FileSystem.isFile(path)) {
                string source = feReadRequiredSource(path);
                paths.push(path);
                sources.push(source);
            }
            index++;
        }
        return FeStdlibRootSnapshot(paths, sources);
    }

    /* Prefer captured root-module paths. The one-level nested fallback mirrors
     * Python's stdlib lookup; its source is read once into this compilation's
     * resolved AST and never enters the external root-symbol index. */
    public string findFileForCompilation(
            string includePath, FeStdlibRootSnapshot snapshot) {
        string direct = feJoinPath(self.directoryPath, includePath);
        if (snapshot.contains(direct)) { return direct; }
        string base = feBaseName(includePath);
        if (!FileSystem.isDir(self.directoryPath)) { return ""; }
        Vector<string> entries = self.sourceDirectories.sortedEntries(
            self.directoryPath);
        int index = 0;
        while (index < entries.len) {
            string child = feJoinPath(self.directoryPath, entries.get(index));
            if (FileSystem.isDir(child)) {
                string candidate = feJoinPath(child, base);
                if (FileSystem.isFile(candidate)) { return candidate; }
            }
            index++;
        }
        return "";
    }

    public FeStdlibLookup requiredModuleForCompilation(
            string name, FeStdlibRootSnapshot snapshot) {
        string filename = name.endsWith(".btrc") ? name : name + ".btrc";
        string path = self.findFileForCompilation(filename, snapshot);
        if (!path.isEmpty()) { return FeStdlibLookup(true, path, ""); }
        return FeStdlibLookup(
            false,
            "",
            f"stdlib import 'std.{name}' not found\n  searched: {self.directoryPath}");
    }

    public Vector<string> rootPaths(FeStdlibRootSnapshot snapshot) {
        Vector<string> paths = [];
        int index = 0;
        while (index < snapshot.count()) {
            paths.push(snapshot.pathAt(index));
            index++;
        }
        return paths;
    }

    public string readSourceForCompilation(
            string path, FeStdlibRootSnapshot snapshot) {
        int index = snapshot.indexOf(path);
        if (index >= 0) { return snapshot.sourceAt(index); }
        return feReadRequiredSource(path);
    }

    private bool wordCharacter(char value) {
        return Strings.isAlnum(value) || value == '_';
    }

    private int skipWhitespace(string line, int index) {
        while (index < line.length()
                && (line[index] == ' ' || line[index] == '\t')) {
            index++;
        }
        return index;
    }

    private int matchGenerics(string line, int index) {
        int next = self.skipWhitespace(line, index);
        if (next >= line.length() || line[next] != '<') { return index; }
        int cursor = next + 1;
        int count = 0;
        while (cursor < line.length() && line[cursor] != '>') {
            cursor++;
            count++;
        }
        return cursor < line.length() && count > 0 ? cursor + 1 : index;
    }

    private string declarationName(string line, string keyword) {
        bool isClass = keyword.equals("class");
        int length = line.length();
        int index = self.skipWhitespace(line, 0);
        FeSourceText sourceLine = FeSourceText(line);
        if (isClass && sourceLine.startsWithAt(index, "abstract")) {
            int next = index + 8;
            if (next < length && (line[next] == ' ' || line[next] == '\t')) {
                index = self.skipWhitespace(line, next);
            }
        }
        if (!sourceLine.startsWithAt(index, keyword)) { return ""; }
        int cursor = index + keyword.length();
        if (cursor >= length
                || (line[cursor] != ' ' && line[cursor] != '\t')) {
            return "";
        }
        cursor = self.skipWhitespace(line, cursor);
        int nameStart = cursor;
        while (cursor < length && self.wordCharacter(line[cursor])) { cursor++; }
        if (cursor == nameStart) { return ""; }
        string name = line.substring(nameStart, cursor - nameStart);
        cursor = self.matchGenerics(line, cursor);
        cursor = self.skipWhitespace(line, cursor);
        if (sourceLine.startsWithAt(cursor, "extends")) {
            int next = cursor + 7;
            if (next < length && (line[next] == ' ' || line[next] == '\t')) {
                next = self.skipWhitespace(line, next);
                int wordStart = next;
                while (next < length && self.wordCharacter(line[next])) { next++; }
                if (next > wordStart) {
                    next = self.matchGenerics(line, next);
                    cursor = self.skipWhitespace(line, next);
                }
            }
        }
        if (isClass && sourceLine.startsWithAt(cursor, "implements")) {
            int next = cursor + 10;
            if (next < length && (line[next] == ' ' || line[next] == '\t')) {
                next = self.skipWhitespace(line, next);
                int wordStart = next;
                while (next < length && self.wordCharacter(line[next])) { next++; }
                if (next > wordStart) {
                    bool more = true;
                    while (more) {
                        int saved = next;
                        int separator = self.skipWhitespace(line, next);
                        if (separator < length && line[separator] == ',') {
                            separator = self.skipWhitespace(line, separator + 1);
                            int itemStart = separator;
                            while (separator < length
                                    && self.wordCharacter(line[separator])) {
                                separator++;
                            }
                            if (separator > itemStart) { next = separator; }
                            else { next = saved; more = false; }
                        } else {
                            more = false;
                        }
                    }
                    cursor = self.skipWhitespace(line, next);
                }
            }
        }
        return cursor < length && line[cursor] == '{' ? name : "";
    }

    private Map<string, bool> definedTypeNames(string source) {
        Map<string, bool> names = {};
        Vector<string> lines = FeSourceText(source).lines();
        int index = 0;
        while (index < lines.len) {
            string line = lines.get(index);
            string className = self.declarationName(line, "class");
            if (!className.isEmpty()) { names.put(className, true); }
            string interfaceName = self.declarationName(line, "interface");
            if (!interfaceName.isEmpty()) { names.put(interfaceName, true); }
            index++;
        }
        return names;
    }

    private bool namesIntersect(
            Map<string, bool> left, Map<string, bool> right) {
        Vector<string> names = left.keys();
        int index = 0;
        while (index < names.len) {
            if (right.has(names.get(index))) { return true; }
            index++;
        }
        return false;
    }

    private Vector<string> sourceWithoutImports(string content) {
        Vector<string> lines = FeSourceText(content).lines();
        Vector<FeDirective> directives = self.directiveScanner.scan(content);
        Map<int, bool> covered = {};
        int directiveIndex = 0;
        while (directiveIndex < directives.len) {
            FeDirective directive = directives.get(directiveIndex);
            if (directive.kind.equals("import")) {
                int line = directive.start;
                while (line <= directive.end) { covered.put(line, true); line++; }
            }
            directiveIndex++;
        }
        Vector<string> kept = [];
        int index = 0;
        while (index < lines.len) {
            if (!covered.has(index + 1)) { kept.push(lines.get(index)); }
            index++;
        }
        return kept;
    }

    public string sourceAtSnapshot(
            string userSource, FeStdlibRootSnapshot snapshot) {
        Map<string, bool> userNames = self.definedTypeNames(userSource);
        Vector<string> lines = [];
        FeResolutionBudget budget = FeResolutionBudget();
        int fileIndex = 0;
        while (fileIndex < snapshot.count()) {
            string path = snapshot.pathAt(fileIndex);
            string content = snapshot.sourceAt(fileIndex);
            budget.enter(content, path, 0);
            if (!self.namesIntersect(
                    self.definedTypeNames(content), userNames)) {
                Vector<string> fileLines = self.sourceWithoutImports(content);
                int lineIndex = 0;
                while (lineIndex < fileLines.len) {
                    lines.push(fileLines.get(lineIndex));
                    lineIndex++;
                }
            }
            fileIndex++;
        }
        return FeSourceText.joinLines(lines);
    }

}

/* ----- include / import path resolution ---------------------------------- */

/* Resolves every import form against one immutable standard-library snapshot.
 * A resolver is compilation-local: filesystem traversal policy, import-spec
 * parsing, and safe native-include rendering cannot observe another run. */
class FeImportResolver {
    private FeStdlibRepository stdlib;
    private FeStdlibRootSnapshot stdlibSnapshot;
    private FeSourceDirectoryScanner sourceDirectories;

    public FeImportResolver(
            FeStdlibRepository stdlib, FeStdlibRootSnapshot stdlibSnapshot,
            FeSourceDirectoryScanner sourceDirectories) {
        self.stdlib = stdlib;
        self.stdlibSnapshot = stdlibSnapshot;
        self.sourceDirectories = sourceDirectories;
    }

    /* Resolve a #include path against the including file's directory, then the
     * captured stdlib snapshot. Returns "" if unresolved. */
    public string resolveIncludePath(string includePath, string sourceDir) {
        string local = feJoinPath(sourceDir, includePath);
        if (FileSystem.exists(local)) { return local; }
        return self.stdlib.findFileForCompilation(
            includePath, self.stdlibSnapshot);
    }

    private bool compilableSourcePath(string name) {
        return name.endsWith(".btrc") || name.endsWith(".c");
    }

    /* Recursive imports never descend through symlinked child directories.
     * Directory entries and the final result retain Python's sorted order. */
    private void collectTree(
            string root, Vector<string> out, FeDirectoryScanBudget budget) {
        Vector<string> pending = [];
        pending.push(root);
        while (pending.len > 0) {
            string current = pending.pop();
            Vector<string> entries = self.sourceDirectories
                .sortedEntriesWithinBudget(current, budget);
            Vector<string> children = [];
            int index = 0;
            while (index < entries.len) {
                string name = entries.get(index);
                string path = feJoinPath(current, name);
                if (FileSystem.isDir(path) && !FileSystem.isSymlink(path)) {
                    children.push(path);
                } else if (FileSystem.isFile(path)
                        && self.compilableSourcePath(name)) {
                    budget.addFile();
                    out.push(path);
                }
                index++;
            }
            int child = children.len - 1;
            while (child >= 0) {
                pending.push(children.get(child));
                child--;
            }
        }
    }

    private void sortPaths(Vector<string> paths) {
        paths.sortBy((string left, string right) =>
            Strings.lessThan(left, right));
    }

    private void collectDirectory(
            string root, Vector<string> out, FeDirectoryScanBudget budget) {
        Vector<string> entries = self.sourceDirectories
            .sortedEntriesWithinBudget(root, budget);
        int index = 0;
        while (index < entries.len) {
            string name = entries.get(index);
            string path = feJoinPath(root, name);
            if (FileSystem.isFile(path) && self.compilableSourcePath(name)) {
                budget.addFile();
                out.push(path);
            }
            index++;
        }
        self.sortPaths(out);
    }

    private Vector<string> resolveRelative(string spec, string sourceDir) {
        Vector<string> paths = [];
        bool recursive = spec.endsWith("/**");
        bool directGlob = spec.endsWith("/*");
        if (recursive || directGlob) {
            int suffixLength = recursive ? 3 : 2;
            string base = spec.substring(0, spec.length() - suffixLength);
            string root = PathTools.isAbsolute(base)
                ? base : feJoinPath(sourceDir, base);
            if (!FileSystem.isDir(root)) {
                fprintf(stderr,
                    "error: import directory '%s' not found\n  searched: %s\n",
                    spec, root);
                exit(1);
            }
            FeDirectoryScanBudget budget = FeDirectoryScanBudget(root);
            if (recursive) {
                self.collectTree(root, paths, budget);
                self.sortPaths(paths);
            } else {
                self.collectDirectory(root, paths, budget);
            }
            return paths;
        }

        string directory = PathTools.isAbsolute(spec)
            ? spec : feJoinPath(sourceDir, spec);
        if (FileSystem.isDir(directory)) {
            FeDirectoryScanBudget budget = FeDirectoryScanBudget(directory);
            self.collectDirectory(directory, paths, budget);
            return paths;
        }

        if (FileSystem.exists(directory)) {
            paths.push(directory);
            return paths;
        }
        string resolved = self.resolveIncludePath(spec, sourceDir);
        if (!resolved.isEmpty()) {
            paths.push(resolved);
            return paths;
        }
        fprintf(stderr,
            "error: include file '%s' not found\n  searched: %s\n  searched: %s\n",
            spec, sourceDir, self.stdlib.directory());
        exit(1);
        return paths;
    }

    private bool validIdentifier(string value) {
        if (value.isEmpty()
                || (!Strings.isAlpha(value[0]) && value[0] != '_')) {
            return false;
        }
        int index = 1;
        while (index < value.length()) {
            if (!Strings.isAlnum(value[index]) && value[index] != '_') {
                return false;
            }
            index++;
        }
        return true;
    }

    private bool packageImportSpec(string spec) {
        Vector<string> segments = Strings.split(spec, ".");
        if (segments.len == 0) { return false; }
        int index = 0;
        while (index < segments.len) {
            if (!self.validIdentifier(segments.get(index))) { return false; }
            index++;
        }
        return true;
    }

    private Vector<string> stdlibModuleNames(string rest) {
        Vector<string> names = [];
        if (self.validIdentifier(rest)) {
            names.push(rest);
            return names;
        }
        int length = rest.length();
        if (length < 3 || rest[0] != '{' || rest[length - 1] != '}') {
            return names;
        }
        Vector<string> rawNames = Strings.split(
            rest.substring(1, length - 2), ",");
        int index = 0;
        while (index < rawNames.len) {
            string name = rawNames.get(index).trim();
            bool trailing = index == rawNames.len - 1 && name.isEmpty();
            if (!trailing && !self.validIdentifier(name)) {
                names.clear();
                return names;
            }
            if (!trailing) { names.push(name); }
            index++;
        }
        return names;
    }

    private void rejectInvalidSpec(string spec) {
        fprintf(stderr, "error: invalid import specification: %s\n", spec);
        exit(1);
    }

    /* Resolve the exact raw import form captured by FeDirectiveScanner.
     * Package paths fail closed because btrc.toml resolution is not self-hosted. */
    public Vector<string> resolveSpec(string spec, string sourceDir) {
        int length = spec.length();
        if (length >= 2 && spec[0] == '"' && spec[length - 1] == '"') {
            return self.resolveRelative(
                spec.substring(1, length - 2), sourceDir);
        }
        if (FeSourceText(spec).startsWithAt(0, "std.")) {
            string rest = spec.substring(4, spec.length() - 4);
            if (rest.equals("*") || rest.equals("**")) {
                return self.stdlib.rootPaths(self.stdlibSnapshot);
            }
            Vector<string> names = self.stdlibModuleNames(rest);
            if (names.len == 0) { self.rejectInvalidSpec(spec); }
            Vector<string> paths = [];
            int index = 0;
            while (index < names.len) {
                FeStdlibLookup lookup = self.stdlib.requiredModuleForCompilation(
                    names.get(index), self.stdlibSnapshot);
                if (!lookup.found) {
                    fprintf(stderr, "error: %s\n", lookup.diagnostic);
                    exit(1);
                }
                paths.push(lookup.path);
                index++;
            }
            return paths;
        }
        if (spec.startsWith(".") || spec.startsWith("/")
                || spec.startsWith("~")) {
            return self.resolveRelative(spec, sourceDir);
        }
        if (self.packageImportSpec(spec)) {
            fprintf(stderr,
                "error: package import '%s' is unsupported by btrcc; use btrcpy, or use an explicit local path beginning with './'\n",
                spec);
            exit(1);
        }
        self.rejectInvalidSpec(spec);
        Vector<string> invalid = [];
        return invalid;
    }

    private bool cTrigraphSuffix(char value) {
        return value == '=' || value == '/' || value == '\'' || value == '('
            || value == ')' || value == '!' || value == '<' || value == '>'
            || value == '-';
    }

    /* C11 header names cannot portably quote `"` or control bytes, and
     * trigraph replacement runs before preprocessing. */
    public string renderCInclude(string path) {
        int index = 0;
        while (index < path.length()) {
            int code = (int)(byte)path[index];
            if (path[index] == '"' || code < 32 || code == 127) {
                fprintf(stderr,
                    "error: cannot import C file with a quote or control character in its path: %s\n",
                    path);
                exit(1);
            }
            if (index + 2 < path.length() && path[index] == '?'
                    && path[index + 1] == '?'
                    && self.cTrigraphSuffix(path[index + 2])) {
                fprintf(stderr,
                    "error: cannot import C file whose path contains a C trigraph: %s\n",
                    path);
                exit(1);
            }
            index++;
        }
        return f"#include \"{path}\"";
    }
}

/* ----- top-level entry: compose the full source ---------------------------- */

class FeFrontendResolver {
    private FeDirectiveScanner directiveScanner;
    private FeSourceDirectoryScanner sourceDirectories;
    private FeStdlibRepository stdlib;
    private FeStdlibRootSnapshot stdlibSnapshot;
    private FeImportResolver importResolver;
    private bool includeStdlib;
    private bool strictImports;
    private Map<string, bool> included;
    private FeDependencyGraph dependencies;
    private FeResolutionBudget budget;

    public FeFrontendResolver(
            GrammarInfo grammar, FeStdlibRepository stdlib,
            bool includeStdlib, bool strictImports) {
        self.directiveScanner = FeDirectiveScanner(grammar);
        self.sourceDirectories = FeSourceDirectoryScanner();
        self.stdlib = stdlib;
        Vector<string> emptyPaths = [];
        Vector<string> emptySources = [];
        FeStdlibRootSnapshot emptySnapshot = FeStdlibRootSnapshot(
            emptyPaths, emptySources);
        self.stdlibSnapshot = emptySnapshot;
        self.importResolver = FeImportResolver(
            stdlib, emptySnapshot, self.sourceDirectories);
        self.includeStdlib = includeStdlib;
        self.strictImports = strictImports;
        self.included = {};
        self.dependencies = FeDependencyGraph();
        self.budget = FeResolutionBudget();
    }

    /* Splice resolved targets into the current traversal. C sources become
     * native include lines; btrc sources re-enter dependency resolution. */
    private void inlinePaths(Vector<string> paths, string absPath,
                             Vector<FeLine> out, int depth) {
        int index = 0;
        while (index < paths.len) {
            string fullPath = paths.get(index);
            string absolute = feAbsPath(fullPath);
            self.dependencies.addImport(absPath, absolute);
            if (fullPath.endsWith(".c")) {
                string identity = feCanonicalPathIdentity(absolute);
                if (!self.included.has(identity)) {
                    self.budget.enter("", absolute, depth);
                    self.included.put(identity, true);
                    out.push(FeLine(
                        self.importResolver.renderCInclude(absolute), absPath, 0));
                }
            } else {
                string content = self.stdlib.readSourceForCompilation(
                    fullPath, self.stdlibSnapshot);
                self.resolveInto(content, fullPath, out, depth);
            }
            index++;
        }
    }

    /* Resolve one source and recursively inline its explicit dependencies while
     * preserving line provenance and typed graph edges. */
    private void resolveInto(string source, string sourcePath,
                             Vector<FeLine> out, int depth) {
        string absPath = feAbsPath(sourcePath);
        string identity = feCanonicalPathIdentity(absPath);
        string sourceDir = feDirName(absPath);
        self.dependencies.ensureSource(absPath);
        if (self.included.has(identity)) { return; }
        self.budget.enter(source, absPath, depth);
        self.included.put(identity, true);

        Vector<string> lines = FeSourceText(source).lines();
        Vector<FeDirective> directives = self.directiveScanner.scan(source);
        Map<int, int> byStart = {};
        Map<int, bool> covered = {};
        int directiveIndex = 0;
        while (directiveIndex < directives.len) {
            FeDirective directive = directives.get(directiveIndex);
            byStart.put(directive.start, directiveIndex);
            int line = directive.start;
            while (line <= directive.end) {
                covered.put(line, true);
                line++;
            }
            directiveIndex++;
        }

        int lineIndex = 0;
        while (lineIndex < lines.len) {
            int lineNumber = lineIndex + 1;
            if (byStart.has(lineNumber)) {
                FeDirective directive = directives.get(byStart.get(lineNumber));
                if (directive.kind.equals("btrc_include")) {
                    string resolved = self.importResolver.resolveIncludePath(
                        directive.payload, sourceDir);
                    if (resolved.length() == 0) {
                        fprintf(stderr,
                            "error: include file '%s' not found\n  searched: %s\n  searched: %s\n",
                            directive.payload, sourceDir, self.stdlib.directory());
                        exit(1);
                    }
                    self.dependencies.addInclude(absPath, resolved);
                    string content = self.stdlib.readSourceForCompilation(
                        resolved, self.stdlibSnapshot);
                    self.resolveInto(content, resolved, out, depth + 1);
                } else {
                    Vector<string> paths = self.importResolver.resolveSpec(
                        directive.payload, sourceDir);
                    self.inlinePaths(paths, absPath, out, depth + 1);
                }
            } else if (!covered.has(lineNumber)) {
                out.push(FeLine(lines.get(lineIndex), absPath, lineNumber));
            }
            lineIndex++;
        }
    }

    public FeResolvedSource resolve(string source, string sourcePath) {
        /* Each result owns a stable dependency graph. Resolver reuse must not
         * retain include guards or consume a prior call's resource budget. */
        self.included = {};
        self.dependencies = FeDependencyGraph();
        self.budget = FeResolutionBudget();
        FeStdlibRootSnapshot currentSnapshot = self.stdlib.rootSnapshot();
        self.stdlibSnapshot = currentSnapshot;
        self.importResolver = FeImportResolver(
            self.stdlib, currentSnapshot, self.sourceDirectories);

        Vector<FeLine> userLines = [];
        self.resolveInto(source, sourcePath, userLines, 0);

        Vector<string> userTexts = [];
        int lineIndex = 0;
        while (lineIndex < userLines.len) {
            userTexts.push(userLines.get(lineIndex).text);
            lineIndex++;
        }
        string userSource = FeSourceText.joinLines(userTexts);
        string stdlibSource = "";
        if (self.includeStdlib && !self.strictImports) {
            stdlibSource = self.stdlib.sourceAtSnapshot(
                userSource, self.stdlibSnapshot);
        }
        string separator = stdlibSource.length() > 0 ? "\n" : "";
        feCheckCombinedSourceSize(stdlibSource, separator, userSource);
        string combined = stdlibSource.length() > 0
            ? stdlibSource + "\n" + userSource : userSource;
        int stdlibLineCount = stdlibSource.length() > 0
            ? FeSourceText(stdlibSource).lineCount() : 0;
        return FeResolvedSource(
            userSource, combined, stdlibSource, userLines, self.dependencies,
            self.strictImports, stdlibLineCount, feAbsPath(sourcePath),
            self.stdlibSnapshot);
    }
}
