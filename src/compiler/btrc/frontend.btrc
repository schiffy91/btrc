/* Compiler front-end orchestration (self-hosted port of frontend.py).
 *
 * Owns the source-to-composed-source pipeline that runs BEFORE lexing the
 * program for real:
 *
 *     #include / import resolution  ->  stdlib composition  ->  combined source
 *
 * The resolved bundle is byte-identical to btrcpy for the same import mode.
 * Strict per-file imports are the default; legacy whole-stdlib composition is
 * available only through the explicit relaxed compatibility mode.
 *
 * Faithful port of:
 *   - resolve_frontend_source / _resolve_includes_mapped / _resolve_traced
 *   - get_stdlib_source_mapped / _discover_stdlib_files / _stdlib_file_source
 *   - _resolve_include_path / _find_stdlib_file / import_spec_paths /
 *     _relative_import_paths / _stdlib_glob_paths / _stdlib_module_path
 *   - import_scan.scan_directives  (comment/string-aware directive location)
 * Lexical/canonical path rules live in frontend_paths.btrc so drive, UNC, and
 * separator semantics stay independently testable.
 *
 * btrc gotchas honored throughout:
 *   - string.substring(start, COUNT) takes a LENGTH, not an end index.
 *   - char -> string via f"{c}" (string + char concatenation is unsupported).
 *   - String methods are instance (.length(), .substring(a,n), .indexOf(x),
 *     .startsWith(x)); char classification is static (Strings.isSpace(c) etc).
 *   - Map.get aborts on a missing key — every read is guarded by .has(k).
 *   - obj.field = call() double-evaluates: results are hoisted into locals.
 *
 * Requires the stdlib (FileSystem / PathTools / Strings / Vector / Map) and the
 * btrc lexer (tokens.btrc, ebnf.btrc, lexer.btrc) to be in scope. Include this
 * after those modules and frontend_paths.btrc; a driver / btrcc wires the
 * grammar in.
 */

#include "frontend_data_paths.btrc"
#include "frontend_source_io.btrc"

/* ----- small text helpers (fe-prefixed to avoid clashing with emitter.btrc) - */

/* Split on '\n' (matches Python str.split("\n"): no trailing empty element
 * unless the source ends with '\n'). */
Vector<string> feSplitLines(string s) {
    Vector<string> out = [];
    int n = s.length();
    int start = 0;
    int i = 0;
    while (i < n) {
        if (s[i] == '\n') {
            out.push(s.substring(start, i - start));
            start = i + 1;
        }
        i = i + 1;
    }
    out.push(s.substring(start, n - start));
    return out;
}

/* Join lines with '\n' (matches Python "\n".join(...)). */
string feJoinLines(Vector<string> lines) {
    return Strings.join(lines, "\n");
}

string feTrim(string s) {
    int n = s.length();
    int start = 0;
    while (start < n && Strings.isSpace(s[start])) { start = start + 1; }
    int end = n;
    while (end > start && Strings.isSpace(s[end - 1])) { end = end - 1; }
    return s.substring(start, end - start);
}

bool feEndsWith(string s, string suffix) {
    return s.endsWith(suffix);
}

/* ----- a resolved source line: text + native provenance ------------------- */

class FeLine {
    public string text;
    public string sourceFile;  /* absolute path */
    public int lineNumber;     /* 1-based, in sourceFile */

    public FeLine(string text, string sourceFile, int lineNumber) {
        self.text = text;
        self.sourceFile = sourceFile;
        self.lineNumber = lineNumber;
    }
}

enum FeDependencyKind {
    FE_DEPENDENCY_IMPORT = 1,
    FE_DEPENDENCY_INCLUDE = 2,
};

class FeDependencyEdge {
    public string target;
    public int kind;

    public FeDependencyEdge(string target, int kind) {
        self.target = target;
        self.kind = kind;
    }
}

/* Typed dependency graph for per-file visibility. Language imports remain
 * directed; legacy #include edges are traversed in both directions because
 * their source fragments form one compilation unit. */
class FeDependencyGraph {
    public Map<string, Vector<FeDependencyEdge>> outgoing;
    public Map<string, Vector<string>> includeParents;

    public FeDependencyGraph() {
        self.outgoing = {};
        self.includeParents = {};
    }

    public string identity(string path) {
        return feCanonicalPathIdentity(path);
    }

    public void ensureSource(string source) {
        string canonical = self.identity(source);
        if (!self.outgoing.has(canonical)) {
            Vector<FeDependencyEdge> empty = [];
            self.outgoing.put(canonical, empty);
        }
        if (!self.includeParents.has(canonical)) {
            Vector<string> emptyParents = [];
            self.includeParents.put(canonical, emptyParents);
        }
    }

    public bool containsEdge(Vector<FeDependencyEdge> edges,
                             string target, int kind) {
        int index = 0;
        while (index < edges.len) {
            FeDependencyEdge edge = edges.get(index);
            if (edge.kind == kind && edge.target.equals(target)) { return true; }
            index++;
        }
        return false;
    }

    public bool containsPath(Vector<string> paths, string target) {
        int index = 0;
        while (index < paths.len) {
            if (paths.get(index).equals(target)) { return true; }
            index++;
        }
        return false;
    }

    public void add(string source, string target, int kind) {
        string canonicalSource = self.identity(source);
        string canonicalTarget = self.identity(target);
        self.ensureSource(canonicalSource);
        self.ensureSource(canonicalTarget);
        Vector<FeDependencyEdge> edges = self.outgoing.get(canonicalSource);
        if (!self.containsEdge(edges, canonicalTarget, kind)) {
            edges.push(FeDependencyEdge(canonicalTarget, kind));
        }
        if (kind == FE_DEPENDENCY_INCLUDE) {
            Vector<string> parents = self.includeParents.get(canonicalTarget);
            if (!self.containsPath(parents, canonicalSource)) {
                parents.push(canonicalSource);
            }
        }
    }

    public void addImport(string source, string target) {
        self.add(source, target, FE_DEPENDENCY_IMPORT);
    }

    public void addInclude(string source, string target) {
        self.add(source, target, FE_DEPENDENCY_INCLUDE);
    }

    public bool hasSource(string source) {
        return self.outgoing.has(self.identity(source));
    }

    public void queueUnseen(string path, Map<string, bool> seen,
                            Vector<string> pending) {
        if (!seen.has(path)) { pending.push(path); }
    }

    public Map<string, bool> visibilityReachable(string source) {
        string start = self.identity(source);
        Map<string, bool> seen = {};
        Vector<string> pending = [start];
        int index = 0;
        while (index < pending.len) {
            string current = pending.get(index);
            index++;
            if (seen.has(current)) { continue; }
            seen.put(current, true);
            if (self.outgoing.has(current)) {
                Vector<FeDependencyEdge> edges = self.outgoing.get(current);
                int edgeIndex = 0;
                while (edgeIndex < edges.len) {
                    self.queueUnseen(edges.get(edgeIndex).target, seen, pending);
                    edgeIndex++;
                }
            }
            if (self.includeParents.has(current)) {
                Vector<string> parents = self.includeParents.get(current);
                int parentIndex = 0;
                while (parentIndex < parents.len) {
                    self.queueUnseen(parents.get(parentIndex), seen, pending);
                    parentIndex++;
                }
            }
        }
        return seen;
    }
}

class FeResolvedSource {
    public string userSource;
    public string source;
    public string stdlibSource;
    public Vector<FeLine> userLines;
    public FeDependencyGraph dependencies;
    public bool strictImports;
    public int stdlibLineCount;
    public string rootSourcePath;

    public FeResolvedSource(string userSource, string source,
                            string stdlibSource, Vector<FeLine> userLines,
                            FeDependencyGraph dependencies, bool strictImports,
                            int stdlibLineCount, string rootSourcePath) {
        self.userSource = userSource;
        self.source = source;
        self.stdlibSource = stdlibSource;
        self.userLines = userLines;
        self.dependencies = dependencies;
        self.strictImports = strictImports;
        self.stdlibLineCount = stdlibLineCount;
        self.rootSourcePath = rootSourcePath;
    }

    public FeLine? userLineForCombined(int line) {
        int index = line - self.stdlibLineCount - 1;
        if (index < 0 || index >= self.userLines.len) { return null; }
        return self.userLines.get(index);
    }
}

/* ----- a located import/include directive ---------------------------------- */

class FeDirective {
    public string kind;     /* "import" or "btrc_include" */
    public string payload;  /* import: raw spec text; include: the .btrc path */
    public int start;       /* 1-based start line (inclusive) */
    public int end;         /* 1-based end line (inclusive) */

    public FeDirective(string kind, string payload, int start, int end) {
        self.kind = kind;
        self.payload = payload;
        self.start = start;
        self.end = end;
    }
}

bool feExists(string path) {
    return FileSystem.exists(path);
}

bool feIsDir(string path) {
    return FileSystem.isDir(path);
}

bool feIsFile(string path) {
    return FileSystem.isFile(path);
}

/* Sorted directory entries (FileSystem.listDir is raw readdir order; Python
 * uses sorted(os.listdir(...))). */
Vector<string> feSortedListDir(string path) {
    Vector<string> entries = feReadRequiredDirectory(path, FE_MAX_IMPORT_SCAN_ENTRIES);
    entries.sortBy((string a, string b) => Strings.lessThan(a, b));
    return entries;
}

Vector<string> feSortedListDirBudget(string path, FeDirectoryScanBudget budget) {
    Vector<string> entries = feReadRequiredDirectory(path, budget.remainingEntries());
    budget.addEntries(entries.len);
    entries.sortBy((string a, string b) => Strings.lessThan(a, b));
    return entries;
}

/* ----- defined class/interface names (skip-if-user-redefined) -------------- */

/* Identifier char test (matches Python \w: alnum or underscore). */
bool feIsWordChar(char c) {
    return Strings.isAlnum(c) || c == '_';
}

/* Skip horizontal whitespace from `i`; return the new index. */
int feSkipWs(string line, int i) {
    int n = line.length();
    while (i < n && (line[i] == ' ' || line[i] == '\t')) { i = i + 1; }
    return i;
}

/* Match optional `<...>` generics (one or more non-'>' chars between angles).
 * Returns the index past the closing '>' if matched, else `i` unchanged.
 * Mirrors the regex `\s*<[^>\n]+>`. */
int feMatchGenerics(string line, int i) {
    int n = line.length();
    int j = feSkipWs(line, i);
    if (j >= n || line[j] != '<') { return i; }
    int k = j + 1;
    int count = 0;
    while (k < n && line[k] != '>') { k = k + 1; count = count + 1; }
    if (k >= n || count == 0) { return i; }  /* needs '>' and [^>\n]+ */
    return k + 1;  /* past '>' */
}

/* Match a class/interface declaration head and return the declared name, or ""
 * if `line` is not such a declaration. Faithfully mirrors the single-line
 * _CLASS_NAME_RE / _INTERFACE_NAME_RE matches in frontend.py:
 *   class:     ^\s*(?:abstract\s+)?class\s+(\w+)(?:\s*<...>)?\s*
 *              (?:extends\s+\w+(?:\s*<...>)?\s*)?
 *              (?:implements\s+\w+(?:\s*,\s*\w+)*\s*)?\{
 *   interface: ^\s*interface\s+(\w+)(?:\s*<...>)?
 *              (?:extends\s+\w+(?:\s*<...>)?\s*)?\{
 * The trailing '{' must follow the (optional) clauses directly, which is what
 * distinguishes a real class def from a static method head like
 * `class Vector<string> listDir(...) {` (the regex never matches that). */
string feMatchDeclName(string line, string kw) {
    bool isClass = kw.equals("class");
    int n = line.length();
    int i = feSkipWs(line, 0);
    if (isClass && feRawStartsWith(line, i, "abstract")) {
        int j = i + 8;
        if (j < n && (line[j] == ' ' || line[j] == '\t')) {
            i = feSkipWs(line, j);
        }
    }
    int klen = kw.length();
    if (!feRawStartsWith(line, i, kw)) { return ""; }
    int k = i + klen;
    if (k >= n || (line[k] != ' ' && line[k] != '\t')) { return ""; }  /* \s+ */
    k = feSkipWs(line, k);
    int nameStart = k;
    while (k < n && feIsWordChar(line[k])) { k = k + 1; }
    if (k == nameStart) { return ""; }
    string name = line.substring(nameStart, k - nameStart);

    /* optional generics on the declared name */
    k = feMatchGenerics(line, k);
    k = feSkipWs(line, k);

    /* optional `extends WORD (<...>)?` */
    if (feRawStartsWith(line, k, "extends")) {
        int e = k + 7;
        if (e < n && (line[e] == ' ' || line[e] == '\t')) {
            e = feSkipWs(line, e);
            int ws = e;
            while (e < n && feIsWordChar(line[e])) { e = e + 1; }
            if (e > ws) {
                e = feMatchGenerics(line, e);
                e = feSkipWs(line, e);
                k = e;
            }
        }
    }

    /* optional `implements WORD (, WORD)*` (class only) */
    if (isClass && feRawStartsWith(line, k, "implements")) {
        int m = k + 10;
        if (m < n && (line[m] == ' ' || line[m] == '\t')) {
            m = feSkipWs(line, m);
            int ws = m;
            while (m < n && feIsWordChar(line[m])) { m = m + 1; }
            if (m > ws) {
                /* (\s*,\s*\w+)* */
                bool more = true;
                while (more) {
                    int save = m;
                    int t = feSkipWs(line, m);
                    if (t < n && line[t] == ',') {
                        t = feSkipWs(line, t + 1);
                        int ws2 = t;
                        while (t < n && feIsWordChar(line[t])) { t = t + 1; }
                        if (t > ws2) { m = t; } else { m = save; more = false; }
                    } else {
                        more = false;
                    }
                }
                m = feSkipWs(line, m);
                k = m;
            }
        }
    }

    /* the next char must be '{' */
    if (k < n && line[k] == '{') { return name; }
    return "";
}

/* Raw "does line[pos:] start with prefix" without allocating substrings. */
bool feRawStartsWith(string line, int pos, string prefix) {
    int pn = prefix.length();
    int ln = line.length();
    if (pos + pn > ln) { return false; }
    int i = 0;
    while (i < pn) {
        if (line[pos + i] != prefix[i]) { return false; }
        i = i + 1;
    }
    return true;
}

/* Collect class/interface names defined in `source` (line-based, mirrors the
 * MULTILINE regexes in frontend.py). */
Map<string, bool> feDefinedNames(string source) {
    Map<string, bool> names = {};
    Vector<string> lines = feSplitLines(source);
    int i = 0;
    while (i < lines.len) {
        string line = lines.get(i);
        string cn = feMatchDeclName(line, "class");
        if (cn.length() > 0) { names.put(cn, true); }
        string iname = feMatchDeclName(line, "interface");
        if (iname.length() > 0) { names.put(iname, true); }
        i = i + 1;
    }
    return names;
}

/* True if any name in `a` is also in `b`. */
bool feNamesIntersect(Map<string, bool> a, Map<string, bool> b) {
    Vector<string> ks = a.keys();
    int i = 0;
    while (i < ks.len) {
        if (b.has(ks.get(i))) { return true; }
        i = i + 1;
    }
    return false;
}

/* ----- stdlib discovery ---------------------------------------------------- */

/* Scan the configured stdlib directory and return .btrc filenames in include order:
 * priority files (in listed order, only those present), then the rest sorted.
 * Mirrors _discover_stdlib_files (top-level only, NOT recursive). */
Vector<string> feDiscoverStdlibFiles() {
    Vector<string> ordered = [];
    string dir = feStdlibDir();
    if (!feIsDir(dir)) { return ordered; }
    Vector<string> all = feSortedListDir(dir);
    /* keep only *.btrc */
    Vector<string> files = [];
    int i = 0;
    while (i < all.len) {
        string f = all.get(i);
        if (feEndsWith(f, ".btrc")) { files.push(f); }
        i = i + 1;
    }
    Vector<string> priority = [];
    priority.push("vector.btrc");
    priority.push("list.btrc");
    priority.push("strings.btrc");
    priority.push("platform.btrc");
    priority.push("process.btrc");
    priority.push("fs.btrc");
    priority.push("daemon.btrc");
    priority.push("ui.btrc");
    /* priority first (in priority order, only if present) */
    int p = 0;
    while (p < priority.len) {
        string pf = priority.get(p);
        if (feVecContains(files, pf)) { ordered.push(pf); }
        p = p + 1;
    }
    /* then everything not in priority, in sorted order */
    int j = 0;
    while (j < files.len) {
        string f = files.get(j);
        if (!feVecContains(priority, f)) { ordered.push(f); }
        j = j + 1;
    }
    return ordered;
}

bool feVecContains(Vector<string> v, string x) {
    int i = 0;
    while (i < v.len) {
        if (v.get(i).equals(x)) { return true; }
        i = i + 1;
    }
    return false;
}

/* ----- directive scanning (comment/string-aware, via the lexer) ------------ */

class FeDirectiveScanner {
    private GrammarInfo grammar;

    public FeDirectiveScanner(GrammarInfo grammar) {
        self.grammar = grammar;
    }

    /* Extract the include path from a `#include "X.btrc"` preprocessor token,
     * or return "" for a C include (`<...>` or non-.btrc). */
    private string cIncludeBtrcPath(string tokenValue) {
        string s = feTrim(tokenValue);
        if (!feRawStartsWith(s, 0, "#include")) { return ""; }
        int i = 8;
        int n = s.length();
        if (i >= n || (s[i] != ' ' && s[i] != '\t')) { return ""; }
        while (i < n && (s[i] == ' ' || s[i] == '\t')) { i++; }
        if (i >= n) { return ""; }
        char open = s[i];
        if (open != '"' && open != '<') { return ""; }
        char close = open == '<' ? '>' : '"';
        i++;
        int pathStart = i;
        while (i < n && s[i] != close && s[i] != '"') { i++; }
        if (i >= n || s[i] != close) { return ""; }
        string path = s.substring(pathStart, i - pathStart);
        i++;
        while (i < n && (s[i] == ' ' || s[i] == '\t')) { i++; }
        if (i != n || !feEndsWith(path, ".btrc")) { return ""; }
        return path;
    }

    private int importTokenEnd(Vector<Token> tokens, int start) {
        if (start >= tokens.len || tokens.get(start).type.equals("EOF")) {
            return -1;
        }
        Token first = tokens.get(start);
        if (first.type.equals("STRING_LIT") || first.type.equals("PATH_SPEC")) {
            return start + 1;
        }
        if (!first.type.equals("IDENT")) { return -1; }
        int index = start + 1;
        if (!first.value.equals("std")) {
            while (index < tokens.len && tokens.get(index).type.equals("DOT")) {
                if (index + 1 >= tokens.len
                        || !tokens.get(index + 1).type.equals("IDENT")) {
                    return -1;
                }
                index = index + 2;
            }
            return index;
        }
        if (index >= tokens.len || !tokens.get(index).type.equals("DOT")) {
            return index;
        }
        index++;
        if (index >= tokens.len) { return -1; }
        Token spec = tokens.get(index);
        if (spec.type.equals("IDENT")) { return index + 1; }
        if (spec.type.equals("STAR")) {
            index++;
            if (index < tokens.len && tokens.get(index).type.equals("STAR")) {
                index++;
            }
            return index;
        }
        if (!spec.type.equals("LBRACE")) { return -1; }
        index++;
        if (index >= tokens.len || !tokens.get(index).type.equals("IDENT")) {
            return -1;
        }
        index++;
        while (index < tokens.len && tokens.get(index).type.equals("COMMA")) {
            index++;
            if (index < tokens.len && tokens.get(index).type.equals("RBRACE")) {
                break;
            }
            if (index >= tokens.len
                    || !tokens.get(index).type.equals("IDENT")) {
                return -1;
            }
            index++;
        }
        if (index >= tokens.len || !tokens.get(index).type.equals("RBRACE")) {
            return -1;
        }
        return index + 1;
    }

    private string canonicalImportSpec(
            Vector<Token> tokens, int start, int end) {
        if (end > start && tokens.get(end - 1).type.equals("SEMICOLON")) {
            end--;
        }
        Token first = tokens.get(start);
        if (first.type.equals("STRING_LIT") || first.type.equals("PATH_SPEC")) {
            return first.value;
        }
        string canonical = "";
        int index = start;
        while (index < end) {
            canonical = canonical + tokens.get(index).value;
            index++;
        }
        return canonical;
    }

    /* Locate whole-line import and btrc-include directives. The lexer makes
     * the scan comment- and string-aware using the pipeline grammar. */
    public Vector<FeDirective> scan(string source) {
        Vector<FeDirective> directives = [];
        Lexer lexer = Lexer(source, self.grammar);
        Vector<Token> tokens = lexer.tokenize();

        Map<int, int> firstCol = {};
        Map<int, int> lastCol = {};
        int tokenIndex = 0;
        while (tokenIndex < tokens.len) {
            Token token = tokens.get(tokenIndex);
            if (!token.type.equals("EOF")) {
                if (!firstCol.has(token.line)) {
                    firstCol.put(token.line, token.col);
                }
                lastCol.put(token.line, token.col);
            }
            tokenIndex++;
        }

        int index = 0;
        while (index < tokens.len) {
            Token token = tokens.get(index);
            bool isFirst = firstCol.has(token.line)
                && firstCol.get(token.line) == token.col;
            bool isImport = token.type.equals("IMPORT")
                || (token.type.equals("IDENT")
                    && token.value.equals("import"));
            if (isFirst && isImport) {
                int specEnd = self.importTokenEnd(tokens, index + 1);
                if (specEnd < 0) {
                    fprintf(stderr,
                        "error: invalid import specification at line %d\n",
                        token.line);
                    exit(1);
                }
                int afterDirective = specEnd;
                if (afterDirective < tokens.len
                        && tokens.get(afterDirective).type.equals("SEMICOLON")) {
                    afterDirective++;
                }
                Token endToken = tokens.get(afterDirective - 1);
                bool ownsLine = lastCol.has(endToken.line)
                    && lastCol.get(endToken.line) == endToken.col;
                if (ownsLine) {
                    string canonical = self.canonicalImportSpec(
                        tokens, index + 1, specEnd);
                    directives.push(FeDirective(
                        "import", canonical, token.line, endToken.line));
                }
                index = afterDirective;
                continue;
            }
            if (isFirst && token.type.equals("PREPROCESSOR")) {
                string path = self.cIncludeBtrcPath(token.value);
                bool isLast = lastCol.has(token.line)
                    && lastCol.get(token.line) == token.col;
                if (path.length() > 0 && isLast) {
                    directives.push(FeDirective(
                        "btrc_include", path, token.line, token.line));
                }
            }
            index++;
        }
        return directives;
    }
}

/* ----- include / import path resolution ------------------------------------ */

/* Find a stdlib file by root-relative path or by basename in a subdirectory.
 * Mirrors _find_stdlib_file. Returns "" if not found. */
string feFindStdlibFile(string includePath) {
    string dir = feStdlibDir();
    string direct = feJoinPath(dir, includePath);
    if (feExists(direct)) { return direct; }
    string base = feBaseName(includePath);
    Vector<string> entries = feSortedListDir(dir);
    int i = 0;
    while (i < entries.len) {
        string sub = feJoinPath(dir, entries.get(i));
        if (feIsDir(sub)) {
            string cand = feJoinPath(sub, base);
            if (feExists(cand)) { return cand; }
        }
        i = i + 1;
    }
    return "";
}

/* Resolve a #include path against the including file's directory, then the
 * stdlib. Mirrors _resolve_include_path. Returns "" if unresolved. */
string feResolveIncludePath(string includePath, string sourceDir) {
    string full = feJoinPath(sourceDir, includePath);
    if (feExists(full)) { return full; }
    string std = feFindStdlibFile(includePath);
    if (std.length() > 0) { return std; }
    return "";
}

/* Resolve a single `std.<name>` module to its stdlib file path (mirrors
 * _stdlib_module_path). Returns "" if not found. */
string feStdlibModulePath(string name) {
    string fname = name;
    if (!feEndsWith(fname, ".btrc")) { fname = fname + ".btrc"; }
    return feFindStdlibFile(fname);
}

string feRequiredStdlibModulePath(string name) {
    string path = feStdlibModulePath(name);
    if (path.length() == 0) {
        fprintf(stderr, "error: stdlib import 'std.%s' not found\n  searched: %s\n",
            name, feStdlibDir());
        exit(1);
    }
    return path;
}

/* All stdlib files (discovery order, absolute-relative paths). Mirrors
 * _stdlib_glob_paths. */
Vector<string> feStdlibGlobPaths() {
    Vector<string> out = [];
    string dir = feStdlibDir();
    Vector<string> files = feDiscoverStdlibFiles();
    int i = 0;
    while (i < files.len) {
        out.push(feJoinPath(dir, files.get(i)));
        i = i + 1;
    }
    return out;
}

/* Recursive directory walk collecting *.btrc and *.c files (for `dir/**`),
 * sorted by full path. Mirrors os.walk + sorted(). */
void feWalkCollect(string root, Vector<string> out, FeDirectoryScanBudget budget) {
    Vector<string> pending = [];
    pending.push(root);
    while (pending.len > 0) {
        string current = pending.pop();
        Vector<string> entries = feSortedListDirBudget(current, budget);
        Vector<string> children = [];
        int i = 0;
        while (i < entries.len) {
            string name = entries.get(i);
            string path = feJoinPath(current, name);
            /* Never descend through a symlinked child directory. */
            if (feIsDir(path) && !FileSystem.isSymlink(path)) {
                children.push(path);
            } else if (feIsFile(path)
                    && (feEndsWith(name, ".btrc") || feEndsWith(name, ".c"))) {
                budget.addFile();
                out.push(path);
            }
            i = i + 1;
        }
        int child = children.len - 1;
        while (child >= 0) {
            pending.push(children.get(child));
            child = child - 1;
        }
    }
}

void feSortPaths(Vector<string> v) {
    v.sortBy((string a, string b) => Strings.lessThan(a, b));
}

/* Resolve a relative import spec (possibly a glob) to file path(s). Mirrors
 * _relative_import_paths. */
Vector<string> feRelativeImportPaths(string spec, string sourceDir) {
    Vector<string> out = [];
    bool recursive = feEndsWith(spec, "/**");
    bool directGlob = feEndsWith(spec, "/*");
    if (recursive || directGlob) {
        int cut = 3;
        if (directGlob) { cut = 2; }
        string base = spec.substring(0, spec.length() - cut);
        string root = base;
        if (!PathTools.isAbsolute(base)) { root = feJoinPath(sourceDir, base); }
        if (!feIsDir(root)) {
            fprintf(stderr, "error: import directory '%s' not found\n  searched: %s\n",
                spec, root);
            exit(1);
        }
        FeDirectoryScanBudget budget = FeDirectoryScanBudget(root);
        if (recursive) {
            feWalkCollect(root, out, budget);
            feSortPaths(out);
        } else {
            Vector<string> entries = feSortedListDirBudget(root, budget);
            int i = 0;
            while (i < entries.len) {
                string name = entries.get(i);
                string path = feJoinPath(root, name);
                if (feIsFile(path) && (feEndsWith(name, ".btrc") || feEndsWith(name, ".c"))) {
                    budget.addFile();
                    out.push(path);
                }
                i = i + 1;
            }
            feSortPaths(out);
        }
        return out;
    }

    /* plain directory import */
    string asDir = spec;
    if (!PathTools.isAbsolute(spec)) { asDir = feJoinPath(sourceDir, spec); }
    if (feIsDir(asDir)) {
        FeDirectoryScanBudget budget = FeDirectoryScanBudget(asDir);
        Vector<string> entries = feSortedListDirBudget(asDir, budget);
        int i = 0;
        while (i < entries.len) {
            string name = entries.get(i);
            string path = feJoinPath(asDir, name);
            if (feIsFile(path) && (feEndsWith(name, ".btrc") || feEndsWith(name, ".c"))) {
                budget.addFile();
                out.push(path);
            }
            i = i + 1;
        }
        feSortPaths(out);
        return out;
    }

    /* single file (relative or absolute), else fall back to include resolution */
    string path = spec;
    if (!PathTools.isAbsolute(spec)) { path = feJoinPath(sourceDir, spec); }
    if (feExists(path)) { out.push(path); return out; }
    string resolved = feResolveIncludePath(spec, sourceDir);
    if (resolved.length() > 0) { out.push(resolved); }
    if (out.len == 0) {
        fprintf(stderr, "error: include file '%s' not found\n  searched: %s\n  searched: %s\n",
            spec, sourceDir, feStdlibDir());
        exit(1);
    }
    return out;
}

bool feImportIdentifier(string value) {
    if (value.length() == 0
            || (!Strings.isAlpha(value[0]) && value[0] != '_')) {
        return false;
    }
    int index = 1;
    while (index < value.length()) {
        if (!Strings.isAlnum(value[index]) && value[index] != '_') {
            return false;
        }
        index = index + 1;
    }
    return true;
}

bool fePackageImportSpec(string spec) {
    Vector<string> segments = Strings.split(spec, ".");
    if (segments.len == 0) { return false; }
    int index = 0;
    while (index < segments.len) {
        if (!feImportIdentifier(segments.get(index))) { return false; }
        index = index + 1;
    }
    return true;
}

Vector<string> feStdModuleNames(string rest) {
    Vector<string> names = [];
    if (feImportIdentifier(rest)) {
        names.push(rest);
        return names;
    }
    int length = rest.length();
    if (length < 3 || rest[0] != '{' || rest[length - 1] != '}') {
        return names;
    }
    string inner = rest.substring(1, length - 2);
    Vector<string> rawNames = Strings.split(inner, ",");
    int index = 0;
    while (index < rawNames.len) {
        string name = feTrim(rawNames.get(index));
        bool trailing = index == rawNames.len - 1 && name.length() == 0;
        if (!trailing && !feImportIdentifier(name)) {
            names.clear();
            return names;
        }
        if (!trailing) { names.push(name); }
        index = index + 1;
    }
    return names;
}

void feInvalidImportSpec(string spec) {
    fprintf(stderr, "error: invalid import specification: %s\n", spec);
    exit(1);
}

/* Resolve a raw import spec string to file path(s). Mirrors import_spec_paths
 * over the parsed forms, but works from the raw spec text (since `import` does
 * not currently lex as a keyword token here). Supported:
 *   std.*            -> all stdlib files (discovery order)
 *   std.{a, b, c}    -> each named stdlib module
 *   std.name         -> one stdlib module
 *   "rel/path.btrc"  -> quoted relative path (surrounding quotes stripped)
 *   ./path           -> explicit relative file / dir / glob
 * Package paths fail closed because btrc.toml resolution is not self-hosted. */
Vector<string> feImportSpecPaths(string spec, string sourceDir) {
    /* Quoted path: import "rel/path.btrc"  (the raw spec keeps its surrounding
     * quotes). Mirror the Python parser's QuotedPath handling: strip the
     * matching surrounding quote and resolve the inner path like a relative
     * import. The btrc lexer only enters PATH_SPEC mode for paths beginning
     * with '.', '/' or '~', so a quoted path arrives here as a STRING with the
     * quote characters intact. */
    int sn = spec.length();
    if (sn >= 2) {
        char q = spec[0];
        if (q == '"' && spec[sn - 1] == q) {
            string inner = spec.substring(1, sn - 2);
            return feRelativeImportPaths(inner, sourceDir);
        }
    }
    if (feRawStartsWith(spec, 0, "std.")) {
        string rest = spec.substring(4, spec.length() - 4);
        if (rest.equals("*") || rest.equals("**")) {
            return feStdlibGlobPaths();
        }
        Vector<string> names = feStdModuleNames(rest);
        if (names.len == 0) { feInvalidImportSpec(spec); }
        Vector<string> out = [];
        int index = 0;
        while (index < names.len) {
            out.push(feRequiredStdlibModulePath(names.get(index)));
            index = index + 1;
        }
        return out;
    }
    if (spec.startsWith(".") || spec.startsWith("/") || spec.startsWith("~")) {
        return feRelativeImportPaths(spec, sourceDir);
    }
    if (fePackageImportSpec(spec)) {
        fprintf(stderr,
            "error: package import '%s' is unsupported by btrcc; use btrcpy, or use an explicit local path beginning with './'\n",
            spec);
        exit(1);
    }
    feInvalidImportSpec(spec);
    Vector<string> invalid = [];
    return invalid;
}

/* ----- recursive include / import resolution (mirror _resolve_traced) ------- */

bool feCTrigraphSuffix(char c) {
    return c == '=' || c == '/' || c == '\'' || c == '(' || c == ')'
        || c == '!' || c == '<' || c == '>' || c == '-';
}

/* C11 header names cannot portably quote `"` or control bytes, and trigraph
 * replacement runs before preprocessing. Reject such rare filesystem names
 * instead of emitting a malformed or redirected include directive. */
string feCIncludeDirective(string path) {
    int i = 0;
    while (i < path.length()) {
        int code = (int)(byte)path[i];
        if (path[i] == '"' || code < 32 || code == 127) {
            fprintf(stderr,
                "error: cannot import C file with a quote or control character in its path: %s\n",
                path);
            exit(1);
        }
        if (i + 2 < path.length() && path[i] == '?' && path[i + 1] == '?'
                && feCTrigraphSuffix(path[i + 2])) {
            fprintf(stderr,
                "error: cannot import C file whose path contains a C trigraph: %s\n",
                path);
            exit(1);
        }
        i = i + 1;
    }
    return f"#include \"{path}\"";
}

/* ----- stdlib composition (mirror get_stdlib_source_mapped) ---------------- */

/* Drop a stdlib file's own import directives; the stdlib is composed wholesale.
 * Returns the kept lines (mirrors _stdlib_file_source). */
Vector<string> feStdlibFileSource(
        string content, FeDirectiveScanner directiveScanner) {
    Vector<string> lines = feSplitLines(content);
    Vector<FeDirective> directives = directiveScanner.scan(content);
    Map<int, bool> covered = {};
    int d = 0;
    while (d < directives.len) {
        FeDirective dir = directives.get(d);
        if (dir.kind.equals("import")) {
            int ln = dir.start;
            while (ln <= dir.end) { covered.put(ln, true); ln = ln + 1; }
        }
        d = d + 1;
    }
    Vector<string> kept = [];
    int i = 0;
    while (i < lines.len) {
        int lineNumber = i + 1;
        if (!covered.has(lineNumber)) {
            kept.push(lines.get(i));
        }
        i = i + 1;
    }
    return kept;
}

/* Read stdlib sources in discovery order, skipping any file that defines a
 * class/interface already defined by the user source. Mirrors
 * get_stdlib_source_mapped (.source). */
string feGetStdlibSource(
        string userSource, FeDirectiveScanner directiveScanner) {
    string dir = feStdlibDir();
    Map<string, bool> userNames = feDefinedNames(userSource);
    Vector<string> allLines = [];
    Vector<string> files = feDiscoverStdlibFiles();
    FeResolutionBudget budget = FeResolutionBudget();
    int f = 0;
    while (f < files.len) {
        string fpath = feJoinPath(dir, files.get(f));
        if (feExists(fpath)) {
            string content = feReadRequiredSource(fpath);
            budget.enter(content, fpath, 0);
            Map<string, bool> fileNames = feDefinedNames(content);
            if (!feNamesIntersect(fileNames, userNames)) {
                Vector<string> fileLines = feStdlibFileSource(
                    content, directiveScanner);
                int j = 0;
                while (j < fileLines.len) {
                    allLines.push(fileLines.get(j));
                    j = j + 1;
                }
            }
        }
        f = f + 1;
    }
    return feJoinLines(allLines);
}

/* ----- top-level entry: compose the full source ---------------------------- */

class FeFrontendResolver {
    private FeDirectiveScanner directiveScanner;
    private bool includeStdlib;
    private bool strictImports;
    private Map<string, bool> included;
    private FeDependencyGraph dependencies;
    private FeResolutionBudget budget;

    public FeFrontendResolver(
            GrammarInfo grammar, bool includeStdlib, bool strictImports) {
        self.directiveScanner = FeDirectiveScanner(grammar);
        self.includeStdlib = includeStdlib;
        self.strictImports = strictImports;
        self.included = {};
        self.dependencies = FeDependencyGraph();
        self.budget = FeResolutionBudget();
    }

    /* Splice resolved targets into the current traversal. C sources become
     * native include lines; btrc sources re-enter dependency resolution. */
    private void inlinePaths(Vector<string> paths, string absPath,
                             Vector<FeLine> out, int depth) {
        int index = 0;
        while (index < paths.len) {
            string fullPath = paths.get(index);
            string absolute = feAbsPath(fullPath);
            self.dependencies.addImport(absPath, absolute);
            if (feEndsWith(fullPath, ".c")) {
                string identity = feCanonicalPathIdentity(absolute);
                if (!self.included.has(identity)) {
                    self.budget.enter("", absolute, depth);
                    self.included.put(identity, true);
                    out.push(FeLine(
                        feCIncludeDirective(absolute), absPath, 0));
                }
            } else {
                string content = feReadRequiredSource(fullPath);
                self.resolveInto(content, fullPath, out, depth);
            }
            index++;
        }
    }

    /* Resolve one source and recursively inline its explicit dependencies while
     * preserving line provenance and typed graph edges. */
    private void resolveInto(string source, string sourcePath,
                             Vector<FeLine> out, int depth) {
        string absPath = feAbsPath(sourcePath);
        string identity = feCanonicalPathIdentity(absPath);
        string sourceDir = feDirName(absPath);
        self.dependencies.ensureSource(absPath);
        if (self.included.has(identity)) { return; }
        self.budget.enter(source, absPath, depth);
        self.included.put(identity, true);

        Vector<string> lines = feSplitLines(source);
        Vector<FeDirective> directives = self.directiveScanner.scan(source);
        Map<int, int> byStart = {};
        Map<int, bool> covered = {};
        int directiveIndex = 0;
        while (directiveIndex < directives.len) {
            FeDirective directive = directives.get(directiveIndex);
            byStart.put(directive.start, directiveIndex);
            int line = directive.start;
            while (line <= directive.end) {
                covered.put(line, true);
                line++;
            }
            directiveIndex++;
        }

        int lineIndex = 0;
        while (lineIndex < lines.len) {
            int lineNumber = lineIndex + 1;
            if (byStart.has(lineNumber)) {
                FeDirective directive = directives.get(byStart.get(lineNumber));
                if (directive.kind.equals("btrc_include")) {
                    string resolved = feResolveIncludePath(
                        directive.payload, sourceDir);
                    if (resolved.length() == 0) {
                        fprintf(stderr,
                            "error: include file '%s' not found\n  searched: %s\n  searched: %s\n",
                            directive.payload, sourceDir, feStdlibDir());
                        exit(1);
                    }
                    self.dependencies.addInclude(absPath, resolved);
                    string content = feReadRequiredSource(resolved);
                    self.resolveInto(content, resolved, out, depth + 1);
                } else {
                    Vector<string> paths = feImportSpecPaths(
                        directive.payload, sourceDir);
                    self.inlinePaths(paths, absPath, out, depth + 1);
                }
            } else if (!covered.has(lineNumber)) {
                out.push(FeLine(lines.get(lineIndex), absPath, lineNumber));
            }
            lineIndex++;
        }
    }

    public FeResolvedSource resolve(string source, string sourcePath) {
        /* Each result owns a stable dependency graph. Resolver reuse must not
         * retain include guards or consume a prior call's resource budget. */
        self.included = {};
        self.dependencies = FeDependencyGraph();
        self.budget = FeResolutionBudget();

        Vector<FeLine> userLines = [];
        self.resolveInto(source, sourcePath, userLines, 0);

        Vector<string> userTexts = [];
        int lineIndex = 0;
        while (lineIndex < userLines.len) {
            userTexts.push(userLines.get(lineIndex).text);
            lineIndex++;
        }
        string userSource = feJoinLines(userTexts);
        string stdlibSource = "";
        if (self.includeStdlib && !self.strictImports) {
            stdlibSource = feGetStdlibSource(
                userSource, self.directiveScanner);
        }
        string separator = stdlibSource.length() > 0 ? "\n" : "";
        feCheckCombinedSourceSize(stdlibSource, separator, userSource);
        string combined = stdlibSource.length() > 0
            ? stdlibSource + "\n" + userSource : userSource;
        int stdlibLineCount = stdlibSource.length() > 0
            ? feSplitLines(stdlibSource).len : 0;
        return FeResolvedSource(
            userSource, combined, stdlibSource, userLines, self.dependencies,
            self.strictImports, stdlibLineCount, feAbsPath(sourcePath));
    }
}
