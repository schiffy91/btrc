/* Call-boundary effects for indexed setter sugar. */

IRNode? lowerIndexedAssignmentWithOwnership(IRGen generator, Node expression,
        Map<string, Node> varTypes) {
    if (expression.op != "=" || expression.target == null
            || expression.target.kind != NK_INDEX_EXPR) {
        return null;
    }
    Node target = expression.target;
    Node? receiver = generator.resolvedExpressionType(
        target.obj, varTypes);
    if (receiver == null
            || semanticRawIndexedPointer(receiver, generator.analyzed)) {
        return null;
    }
    Node? setter = semanticIndexedMethod(
        receiver, "set", generator.analyzed);
    if (!semanticValidIndexedSetter(setter)) { return null; }
    Node concreteSetter = setter;
    Node indexType = semanticResolvedIndexedType(
        concreteSetter.params.get(0).type,
        receiver, generator.analyzed);
    Node valueType = semanticResolvedIndexedType(
        concreteSetter.params.get(1).type,
        receiver, generator.analyzed);
    Node? actualIndexType = generator.resolvedExpressionType(
        target.index, varTypes);
    if (actualIndexType == null) { actualIndexType = indexType; }
    Node? actualType = generator.resolvedExpressionType(
        expression.value_node, varTypes);
    if (actualType == null) { actualType = valueType; }
    bool targetManaged = irManagedType(generator, valueType);
    bool keepValue = targetManaged
        && concreteSetter.params.get(1).keep_;
    bool converted = requiresTargetStringConversion(
        generator, valueType, actualType);
    bool indexConverted = requiresTargetStringConversion(
        generator, indexType, actualIndexType);
    if (!targetManaged && !converted && !indexConverted) {
        return null;
    }

    OwnershipBoundary boundary = OwnershipBoundary();
    if (indexConverted) {
        PreparedValue preparedIndex = prepareCallTargetValue(
            generator, target.index, indexType, varTypes);
        ownershipRequireType(
            preparedIndex.effectiveType, target.index);
        Node effectiveIndexType = preparedIndex.effectiveType;
        boundary.addLoweredCallOperand(generator,
            target.index, effectiveIndexType, preparedIndex.value,
            preparedIndex.owned, false, false);
    }
    PreparedValue prepared = prepareCallTargetValue(
        generator, expression.value_node, valueType, varTypes);
    ownershipRequireType(
        prepared.effectiveType, expression.value_node);
    Node effectiveType = prepared.effectiveType;
    bool pinBorrowed = targetManaged && !prepared.owned;
    boundary.addLoweredCallOperand(generator,
        expression.value_node, effectiveType, prepared.value,
        prepared.owned, keepValue || pinBorrowed, false);
    IRNode? lowered = generator.lowerIndirectAssignmentCore(
        expression, varTypes);
    boundary.restore(generator);
    if (lowered == null) {
        fprintf(stderr, "error: indexed setter boundary has no lowering\n");
        abortGen();
    }
    IRNode concreteLowered = lowered;
    return boundary.finish(
        generator, concreteLowered, valueType, targetManaged);
}
