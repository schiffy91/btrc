/* Literal scanning for the self-hosted lexer.
 *
 * This mirrors src/compiler/python/lexer_literals.py. Every reader either
 * emits one complete token or records a sticky Lexer failure; malformed
 * literals never leak a partial token stream to later compiler stages.
 */

void lexerReadNumber(Lexer lex) {
    int line = lex.line;
    int col = lex.col;
    int startPos = lex.pos;
    bool isFloat = false;

    if (lex.peek(0) == '0' && (lex.peek(1) == 'x' || lex.peek(1) == 'X')) {
        lex.advance();
        lex.advance();
        if (!lexerIsHexDigit(lex.peek(0))) {
            lex.failLex("Invalid hex literal: no digits after '0x'", line, col);
            return;
        }
        while (!lex.atEnd() && lexerIsHexDigit(lex.peek(0))) { lex.advance(); }
        lexerConsumeIntegerSuffix(lex, line, col);
        lexerEnsureNumericBoundary(lex, startPos, line, col);
    } else if (lex.peek(0) == '0' && (lex.peek(1) == 'b' || lex.peek(1) == 'B')) {
        lex.advance();
        lex.advance();
        if (Strings.isDigit(lex.peek(0))
                && lex.peek(0) != '0' && lex.peek(0) != '1') {
            lex.failLex(
                "Invalid digit '" + chr(lex.peek(0)) + "' in binary literal",
                line, col);
            return;
        }
        if (lex.peek(0) != '0' && lex.peek(0) != '1') {
            lex.failLex("Invalid binary literal: no digits after '0b'", line, col);
            return;
        }
        while (!lex.atEnd() && (lex.peek(0) == '0' || lex.peek(0) == '1')) {
            lex.advance();
        }
        if (Strings.isDigit(lex.peek(0))) {
            lex.failLex(
                "Invalid digit '" + chr(lex.peek(0)) + "' in binary literal",
                line, col);
            return;
        }
        lexerConsumeIntegerSuffix(lex, line, col);
        if (lex.failed) { return; }
        lexerEnsureNumericBoundary(lex, startPos, line, col);
    } else if (lex.peek(0) == '0' && (lex.peek(1) == 'o' || lex.peek(1) == 'O')) {
        lex.advance();
        lex.advance();
        if (Strings.isDigit(lex.peek(0))
                && (lex.peek(0) < '0' || lex.peek(0) > '7')) {
            lex.failLex(
                "Invalid digit '" + chr(lex.peek(0)) + "' in octal literal",
                line, col);
            return;
        }
        if (lex.peek(0) < '0' || lex.peek(0) > '7') {
            lex.failLex("Invalid octal literal: no digits after '0o'", line, col);
            return;
        }
        while (!lex.atEnd() && lex.peek(0) >= '0' && lex.peek(0) <= '7') {
            lex.advance();
        }
        if (Strings.isDigit(lex.peek(0))) {
            lex.failLex(
                "Invalid digit '" + chr(lex.peek(0)) + "' in octal literal",
                line, col);
            return;
        }
        lexerConsumeIntegerSuffix(lex, line, col);
        if (lex.failed) { return; }
        lexerEnsureNumericBoundary(lex, startPos, line, col);
    } else {
        while (!lex.atEnd() && Strings.isDigit(lex.peek(0))) { lex.advance(); }
        int integerEnd = lex.pos;
        if (lex.peek(0) == '.' && Strings.isDigit(lex.peek(1))) {
            isFloat = true;
            lex.advance();
            while (!lex.atEnd() && Strings.isDigit(lex.peek(0))) { lex.advance(); }
        }
        if (lex.peek(0) == 'e' || lex.peek(0) == 'E') {
            isFloat = true;
            lex.advance();
            if (lex.peek(0) == '+' || lex.peek(0) == '-') { lex.advance(); }
            if (!Strings.isDigit(lex.peek(0))) {
                lex.failLex("Invalid float literal: no digits in exponent", line, col);
                return;
            }
            while (!lex.atEnd() && Strings.isDigit(lex.peek(0))) { lex.advance(); }
        }
        if (isFloat && (lex.peek(0) == 'f' || lex.peek(0) == 'F')) {
            lex.advance();
        } else if (!isFloat) {
            if (integerEnd - startPos > 1 && lex.source[startPos] == '0') {
                int digitIndex = startPos + 1;
                while (digitIndex < integerEnd) {
                    char digit = lex.source[digitIndex];
                    if (digit == '8' || digit == '9') {
                        lex.failLex(
                            "Invalid digit '" + chr(digit) + "' in octal literal",
                            line, col);
                        return;
                    }
                    digitIndex = digitIndex + 1;
                }
            }
            lexerConsumeIntegerSuffix(lex, line, col);
        }
        if (lex.failed) { return; }
        lexerEnsureNumericBoundary(lex, startPos, line, col);
    }

    if (lex.failed) { return; }

    string value = lex.source.substring(startPos, lex.pos - startPos);
    string type = "INT_LIT";
    if (isFloat) { type = "FLOAT_LIT"; }
    lex.tokens.push(Token(type, value, line, col));
}

void lexerReadString(Lexer lex) {
    int line = lex.line;
    int col = lex.col;
    if (lex.peek(1) == '"' && lex.peek(2) == '"') {
        lexerReadTripleString(lex, line, col);
        return;
    }

    lex.advance();
    string content = "";
    while (!lex.atEnd()) {
        char c = lex.peek(0);
        if (c == '"') {
            lex.advance();
            lex.tokens.push(Token("STRING_LIT", "\"" + content + "\"", line, col));
            return;
        }
        if (c == '\\') {
            content = lexerAppendEscape(lex, content, "string", line, col);
            if (lex.failed) { return; }
        } else if (c == '\r' || c == '\n') {
            lex.failLex("Unterminated string literal", line, col);
            return;
        } else {
            content = content + chr(lex.advance());
        }
    }
    lex.failLex("Unterminated string literal", line, col);
}

void lexerReadTripleString(Lexer lex, int line, int col) {
    lex.advance();
    lex.advance();
    lex.advance();
    string content = "";
    while (!lex.atEnd()) {
        if (lex.peek(0) == '"' && lex.peek(1) == '"' && lex.peek(2) == '"') {
            lex.advance();
            lex.advance();
            lex.advance();
            lex.tokens.push(Token("STRING_LIT", "\"" + content + "\"", line, col));
            return;
        }
        char c = lex.peek(0);
        if (c == '\n') {
            content = content + "\\n";
            lex.advance();
        } else if (c == '\r') {
            content = content + "\\n";
            lex.advance();
            if (lex.peek(0) == '\n') { lex.advance(); }
        } else if (c == '\\') {
            content = lexerAppendEscape(lex, content, "string", line, col);
            if (lex.failed) { return; }
        } else {
            content = content + chr(lex.advance());
        }
    }
    lex.failLex("Unterminated triple-quoted string", line, col);
}

void lexerReadChar(Lexer lex) {
    int line = lex.line;
    int col = lex.col;
    lex.advance();
    string content = "";
    while (!lex.atEnd()) {
        char c = lex.peek(0);
        if (c == '\'') {
            lex.advance();
            if (!lexerValidCharContent(content)) {
                lex.failLex(
                    "Character literal must contain exactly one character",
                    line, col);
                return;
            }
            lex.tokens.push(Token("CHAR_LIT", "'" + content + "'", line, col));
            return;
        }
        if (c == '\\') {
            content = content + chr(lex.advance());
            if (!lex.atEnd()) { content = content + chr(lex.advance()); }
        } else if (c == '\r' || c == '\n') {
            lex.failLex("Unterminated character literal", line, col);
            return;
        } else {
            content = content + chr(lex.advance());
        }
    }
    lex.failLex("Unterminated character literal", line, col);
}

bool lexerValidCharContent(string content) {
    int length = content.length();
    if (length == 0) { return false; }
    if (content[0] != '\\') {
        return length == 1 && content[0] >= ' ' && content[0] <= '~';
    }
    if (length == 2) {
        char simple = content[1];
        if (simple == '\'' || simple == '"' || simple == '?' || simple == '\\'
                || simple == 'a' || simple == 'b' || simple == 'f'
                || simple == 'n' || simple == 'r' || simple == 't'
                || simple == 'v') {
            return true;
        }
    }
    bool octal = length >= 2 && length <= 4;
    int octalValue = 0;
    int octalIndex = 1;
    while (octal && octalIndex < length) {
        char digit = content[octalIndex];
        if (digit < '0' || digit > '7') { octal = false; }
        else { octalValue = octalValue * 8 + (int)digit - (int)'0'; }
        octalIndex = octalIndex + 1;
    }
    if (octal) { return octalValue <= 255; }
    return lexerNarrowCharHexEscape(content);
}

void lexerReadFstring(Lexer lex, int line, int col) {
    lex.advance();
    string content = "";
    int braceDepth = 0;
    while (!lex.atEnd()) {
        char c = lex.peek(0);
        if (braceDepth == 0 && c == '"') {
            lex.advance();
            lex.tokens.push(Token("FSTRING_LIT", content, line, col));
            return;
        }
        if (c == '{') {
            if (braceDepth == 0 && lex.peek(1) == '{') {
                content = content + chr(lex.advance());
                content = content + chr(lex.advance());
            } else {
                braceDepth = braceDepth + 1;
                content = content + chr(lex.advance());
            }
        } else if (c == '}') {
            if (braceDepth == 0 && lex.peek(1) == '}') {
                content = content + chr(lex.advance());
                content = content + chr(lex.advance());
            } else {
                braceDepth = braceDepth - 1;
                content = content + chr(lex.advance());
            }
        } else if (c == '\\') {
            content = lexerAppendEscape(lex, content, "f-string", line, col);
            if (lex.failed) { return; }
        } else if (c == '\r' || c == '\n') {
            lex.failLex("Unterminated f-string literal", line, col);
            return;
        } else {
            content = content + chr(lex.advance());
        }
    }
    lex.failLex("Unterminated f-string literal", line, col);
}
