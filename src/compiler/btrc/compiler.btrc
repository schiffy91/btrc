/* Application composition root for the production self-hosted compiler. */

import ./pipeline/stage.btrc;

class Compiler {
    private CompilerPipeline pipeline;

    public Compiler(GrammarInfo grammar, string stdlibDirectory,
                    FeSourceFileReader sourceFiles,
                    FeSourceResolutionPolicy resolutionPolicy) {
        self.pipeline = CompilerPipeline(
            grammar, stdlibDirectory, sourceFiles, resolutionPolicy);
    }

    public BtrccCompilationResult compile(string source, string sourcePath,
                                          BtrccOptions options) {
        return self.pipeline.compile(source, sourcePath, options);
    }
}
