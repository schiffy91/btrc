/* Fail-closed ownership rules for shallow by-value aggregates. */

bool semanticManagedResultType(Node? typeExpr,
        SemanticValidationState state) {
    if (typeExpr == null) { return false; }
    return isStringType(typeExpr)
        || state.analyzed.isClass(typeExpr.base)
        || (typeExpr.generic_args.len > 0
            && state.analyzed.isGenericClass(typeExpr.base));
}

bool semanticStringCallOwnsResult(Node call,
        SemanticValidationState state, Map<string, Node> vars) {
    if (semanticKnownLanguageCall(call, state, vars)) { return true; }
    Node callee = call.callee;
    if (callee == null) { return false; }
    if (callee.kind == NK_IDENTIFIER) {
        return callee.name == "__btrc_str_track"
            || callee.name == "__btrc_string_adopt"
            || callee.name == "__btrc_string_alloc";
    }
    if (callee.kind != NK_FIELD_ACCESS_EXPR) { return false; }
    Node? receiver = semanticInferType(callee.obj, state, vars);
    if (isStringType(receiver)) {
        return stringMethodTracked(callee.field);
    }
    if (receiver == null || callee.field != "toString") { return false; }
    return receiver.base != "bool"
        && !state.analyzed.enumTable.has(receiver.base);
}

bool semanticOwnershipBranchPromotable(Node branch,
        SemanticValidationState state, Map<string, Node> vars) {
    if (branch.kind == NK_NULL_LITERAL
            || semanticExpressionOwnsResult(branch, state, vars)) {
        return true;
    }
    return semanticManagedResultType(
        semanticInferType(branch, state, vars), state);
}

bool semanticConditionalOwnsResult(Node expression, Node left, Node right,
        SemanticValidationState state, Map<string, Node> vars) {
    if (!semanticManagedResultType(
            semanticInferType(expression, state, vars), state)) {
        return false;
    }
    bool ownsBranch = semanticExpressionOwnsResult(left, state, vars)
        || semanticExpressionOwnsResult(right, state, vars);
    return ownsBranch
        && semanticOwnershipBranchPromotable(left, state, vars)
        && semanticOwnershipBranchPromotable(right, state, vars);
}

bool semanticKnownLanguageCall(Node call,
        SemanticValidationState state, Map<string, Node> vars) {
    Node callee = call.callee;
    if (callee == null) { return false; }
    if (callee.kind == NK_IDENTIFIER) {
        if (vars.has(callee.name)
                || state.analyzed.hostedCallKeys.has(astNodeKey(call))) {
            return false;
        }
        return state.analyzed.funcTable.has(callee.name)
            || state.analyzed.isClass(callee.name)
            || state.analyzed.isGenericClass(callee.name);
    }
    if (callee.kind != NK_FIELD_ACCESS_EXPR) { return false; }
    if (callee.obj != null && callee.obj.kind == NK_IDENTIFIER) {
        string owner = callee.obj.name;
        if (state.analyzed.isClass(owner)) {
            Node? method = state.analyzed.classMethod(owner, callee.field);
            if (method != null && method.kind == NK_METHOD_DECL) {
                return true;
            }
        }
        if (state.analyzed.isGenericClass(owner)) {
            Node? method = state.analyzed.genericClassMethod(
                owner, callee.field);
            if (method != null && method.kind == NK_METHOD_DECL) {
                return true;
            }
        }
    }
    Node? receiver = semanticInferType(callee.obj, state, vars);
    if (receiver == null) { return false; }
    if (state.analyzed.isClass(receiver.base)) {
        Node? method = state.analyzed.classMethod(
            receiver.base, callee.field);
        return method != null && method.kind == NK_METHOD_DECL;
    }
    if (state.analyzed.isGenericClass(receiver.base)) {
        Node? method = state.analyzed.genericClassMethod(
            receiver.base, callee.field);
        return method != null && method.kind == NK_METHOD_DECL;
    }
    return false;
}

bool semanticExpressionOwnsResult(Node? expression,
        SemanticValidationState state, Map<string, Node> vars) {
    if (expression == null) { return false; }
    Node? result = semanticInferType(expression, state, vars);
    bool managedResult = semanticManagedResultType(result, state);
    if (expression.kind == NK_NEW_EXPR
            || expression.kind == NK_LIST_LITERAL
            || expression.kind == NK_MAP_LITERAL
            || expression.kind == NK_BRACE_INITIALIZER) {
        return managedResult;
    }
    if (expression.kind == NK_CAST_EXPR) {
        return managedResult
            && semanticExpressionOwnsResult(expression.expr, state, vars);
    }
    if (expression.kind == NK_F_STRING_LITERAL) {
        int index = 0;
        while (index < expression.parts.len) {
            if (expression.parts.get(index).kind == NK_F_STRING_EXPR) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }
    if (expression.kind == NK_CALL_EXPR) {
        if (!managedResult) { return false; }
        if (isStringType(result)) {
            return semanticStringCallOwnsResult(expression, state, vars);
        }
        return semanticKnownLanguageCall(expression, state, vars);
    }
    if (expression.kind == NK_FIELD_ACCESS_EXPR
            || expression.kind == NK_INDEX_EXPR) {
        if (!managedResult) { return false; }
        if (semanticExpressionOwnsResult(
                expression.obj, state, vars)) { return true; }
        if (expression.kind == NK_INDEX_EXPR) {
            Node? receiver = semanticInferType(
                expression.obj, state, vars);
            return receiver != null
                && !semanticRawIndexedPointer(receiver, state.analyzed)
                && semanticValidIndexedGetter(semanticIndexedMethod(
                    receiver, "get", state.analyzed));
        }
        return false;
    }
    if (expression.kind == NK_TERNARY_EXPR) {
        return semanticConditionalOwnsResult(expression,
            expression.true_expr, expression.false_expr, state, vars);
    }
    if (expression.kind == NK_BINARY_EXPR && expression.op == "??") {
        return semanticConditionalOwnsResult(expression,
            expression.left, expression.right, state, vars);
    }
    if (expression.kind == NK_BINARY_EXPR && managedResult) {
        if (expression.op == "+" && isStringType(result)) { return true; }
        Node? left = semanticInferType(expression.left, state, vars);
        if (left == null) { return false; }
        string magic = semanticBinaryOperatorMethod(expression.op);
        if (magic == "") { return false; }
        if (state.analyzed.isClass(left.base)) {
            return state.analyzed.classMethod(left.base, magic) != null;
        }
        if (state.analyzed.isGenericClass(left.base)) {
            return state.analyzed.genericClassMethod(left.base, magic) != null;
        }
    }
    if (expression.kind == NK_UNARY_EXPR && managedResult
            && expression.op == "-") {
        Node? operand = semanticInferType(expression.operand, state, vars);
        if (operand == null) { return false; }
        if (state.analyzed.isClass(operand.base)) {
            return state.analyzed.classMethod(
                operand.base, "__neg__") != null;
        }
        if (state.analyzed.isGenericClass(operand.base)) {
            return state.analyzed.genericClassMethod(
                operand.base, "__neg__") != null;
        }
    }
    return false;
}

void semanticRejectOwnedElements(Vector<Node> elements, string aggregate,
        SemanticValidationState state, Map<string, Node> vars) {
    int index = 0;
    while (index < elements.len) {
        Node element = elements.get(index);
        if (semanticExpressionOwnsResult(element, state, vars)) {
            semanticValidationFail("caller-owned temporary cannot be embedded in "
                + aggregate + "; aggregate class elements are shallow borrowed "
                + "references, so bind the owner to a local first", element);
        }
        index = index + 1;
    }
}

Node? semanticShallowElementType(Node aggregate, int index,
        SemanticValidationState state) {
    if (aggregate.is_array) {
        return semanticArrayElementType(aggregate);
    }
    if (aggregate.base == "Tuple") {
        if (index < aggregate.generic_args.len) {
            return aggregate.generic_args.get(index);
        }
        return null;
    }
    string structName = semanticStructTypeName(
        aggregate, state.analyzed);
    if (structName == "" || !state.analyzed.structTable.has(structName)) {
        return null;
    }
    Node declaration = state.analyzed.structTable.get(structName);
    if (declaration.is_forward || index >= declaration.fields.len) {
        return null;
    }
    return declaration.fields.get(index).type;
}

void semanticRejectConvertedShallowElements(Node aggregate,
        Vector<Node> elements, SemanticValidationState state,
        Map<string, Node> vars) {
    int index = 0;
    while (index < elements.len) {
        Node element = elements.get(index);
        Node? expected = semanticShallowElementType(
            aggregate, index, state);
        Node? actual = semanticInferType(element, state, vars);
        if (semanticRequiresTargetStringConversion(
                expected, actual, state)) {
            semanticValidationFail(
                "implicit class-to-string conversion cannot be embedded "
                    + "in a shallow aggregate because conversion creates "
                    + "a caller-owned temporary; bind the converted string "
                    + "to an owner first",
                element);
        }
        semanticRejectShallowInitializer(
            expected, element, state, vars);
        index = index + 1;
    }
}

void semanticRejectShallowInitializer(Node? expected, Node initializer,
        SemanticValidationState state, Map<string, Node> vars) {
    if (expected == null || (initializer.kind != NK_BRACE_INITIALIZER
            && initializer.kind != NK_LIST_LITERAL
            && initializer.kind != NK_TUPLE_LITERAL)) { return; }
    Node? canonical = semanticResolveAliases(expected, state);
    if (canonical == null) { return; }
    string structName = semanticStructTypeName(
        canonical, state.analyzed);
    bool shallow = canonical.is_array || canonical.base == "Tuple"
        || (structName != "" && canonical.pointer_depth == 0);
    if (shallow) {
        semanticRejectConvertedShallowElements(
            canonical, initializer.elements, state, vars);
        semanticRejectOwnedElements(initializer.elements,
            "a shallow aggregate", state, vars);
    }
}

void semanticRejectShallowStore(Node assignment,
        SemanticValidationState state, Map<string, Node> vars) {
    if (assignment.target == null
            || assignment.target.kind != NK_FIELD_ACCESS_EXPR
            || !semanticExpressionOwnsResult(
                assignment.value_node, state, vars)) { return; }
    Node? receiver = semanticInferType(
        assignment.target.obj, state, vars);
    receiver = semanticResolveAliases(receiver, state);
    if (receiver == null) { return; }
    string structName = semanticStructTypeName(
        receiver, state.analyzed);
    if (receiver.base == "Tuple"
            || (structName != "" && receiver.pointer_depth == 0)) {
        semanticValidationFail("caller-owned temporary cannot be stored in a "
            + "shallow aggregate; bind the owner to a local and store only "
            + "its borrowed reference", assignment.value_node);
    }
}
