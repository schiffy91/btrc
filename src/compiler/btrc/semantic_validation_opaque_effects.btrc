/* Conservative proof that a source raw-pointer parameter is borrow-only. */

bool semanticRawExpressionMentionsParam(Node? expression, string name) {
    if (expression == null) { return false; }
    if (expression.kind == NK_IDENTIFIER) { return expression.name == name; }
    if (expression.kind == NK_LAMBDA_EXPR) {
        int parameter = 0;
        while (parameter < expression.params.len) {
            if (expression.params.get(parameter).name == name) { return false; }
            parameter = parameter + 1;
        }
        Map<string, bool> used = {};
        collectIdentifiers(expression.body_node, used);
        return used.has(name);
    }
    if (expression.kind == NK_SPAWN_EXPR) {
        return semanticRawExpressionMentionsParam(expression.fn, name);
    }
    if (expression.kind == NK_CAST_EXPR) {
        return semanticRawExpressionMentionsParam(expression.expr, name);
    }
    if (expression.kind == NK_UNARY_EXPR) {
        return semanticRawExpressionMentionsParam(expression.operand, name);
    }
    if (expression.kind == NK_BINARY_EXPR) {
        return semanticRawExpressionMentionsParam(expression.left, name)
            || semanticRawExpressionMentionsParam(expression.right, name);
    }
    if (expression.kind == NK_TERNARY_EXPR) {
        return semanticRawExpressionMentionsParam(expression.condition, name)
            || semanticRawExpressionMentionsParam(expression.true_expr, name)
            || semanticRawExpressionMentionsParam(expression.false_expr, name);
    }
    if (expression.kind == NK_ASSIGN_EXPR) {
        return semanticRawExpressionMentionsParam(expression.target, name)
            || semanticRawExpressionMentionsParam(expression.value_node, name);
    }
    if (expression.kind == NK_INDEX_EXPR) {
        return semanticRawExpressionMentionsParam(expression.obj, name)
            || semanticRawExpressionMentionsParam(expression.index, name);
    }
    if (expression.kind == NK_FIELD_ACCESS_EXPR) {
        return semanticRawExpressionMentionsParam(expression.obj, name);
    }
    if (expression.kind == NK_CALL_EXPR || expression.kind == NK_NEW_EXPR) {
        int index = 0;
        while (index < expression.args.len) {
            if (semanticRawExpressionMentionsParam(
                    expression.args.get(index), name)) { return true; }
            index = index + 1;
        }
        return expression.kind == NK_CALL_EXPR
            && semanticRawExpressionMentionsParam(expression.callee, name);
    }
    if (expression.kind == NK_LIST_LITERAL
            || expression.kind == NK_BRACE_INITIALIZER
            || expression.kind == NK_TUPLE_LITERAL) {
        int index = 0;
        while (index < expression.elements.len) {
            if (semanticRawExpressionMentionsParam(
                    expression.elements.get(index), name)) { return true; }
            index = index + 1;
        }
    }
    if (expression.kind == NK_MAP_LITERAL) {
        int index = 0;
        while (index < expression.entries.len) {
            Node entry = expression.entries.get(index);
            if (semanticRawExpressionMentionsParam(entry.key, name)
                    || semanticRawExpressionMentionsParam(
                        entry.value_node, name)) { return true; }
            index = index + 1;
        }
    }
    return false;
}

bool semanticRawExpressionCarriesParam(Node? expression, string name,
        SemanticValidationState state, Map<string, Node> vars) {
    if (expression == null) { return false; }
    if (expression.kind == NK_IDENTIFIER) { return expression.name == name; }
    if (expression.kind == NK_CAST_EXPR) {
        return semanticRawExpressionCarriesParam(
            expression.expr, name, state, vars);
    }
    if (expression.kind == NK_UNARY_EXPR) {
        if (expression.op == "&") {
            return semanticRawExpressionMentionsParam(expression.operand, name);
        }
        if (expression.op == "!") { return false; }
        if (expression.op == "*") {
            return semanticOpaqueProjectionCarrierType(
                    semanticInferType(expression, state, vars), state)
                && semanticRawExpressionMentionsParam(
                    expression.operand, name);
        }
        return semanticRawExpressionCarriesParam(
            expression.operand, name, state, vars);
    }
    if (expression.kind == NK_BINARY_EXPR) {
        if (semanticOpaqueNonCarryingBinary(expression.op)) { return false; }
        return semanticRawExpressionCarriesParam(
                expression.left, name, state, vars)
            || semanticRawExpressionCarriesParam(
                expression.right, name, state, vars);
    }
    if (expression.kind == NK_TERNARY_EXPR) {
        return semanticRawExpressionCarriesParam(
                expression.true_expr, name, state, vars)
            || semanticRawExpressionCarriesParam(
                expression.false_expr, name, state, vars);
    }
    if (expression.kind == NK_INDEX_EXPR
            || expression.kind == NK_FIELD_ACCESS_EXPR) {
        return semanticOpaqueProjectionCarrierType(
                semanticInferType(expression, state, vars), state)
            && semanticRawExpressionMentionsParam(expression, name);
    }
    if (expression.kind == NK_CALL_EXPR) {
        if (expression.callee != null
                && expression.callee.kind == NK_IDENTIFIER) {
            if (!semanticHostedCallUsesOwnedSymbol(
                    expression.callee.name, state, vars)) {
                return false;
            }
            int parameter = hostedAbiReturnAliasParameter(
                expression.callee.name);
            return parameter >= 0 && parameter < expression.args.len
                && semanticRawExpressionCarriesParam(
                    expression.args.get(parameter), name, state, vars);
        }
        return false;
    }
    if (expression.kind == NK_NEW_EXPR) {
        int index = 0;
        while (index < expression.args.len) {
            if (semanticRawExpressionCarriesParam(
                    expression.args.get(index), name,
                    state, vars)) { return true; }
            index = index + 1;
        }
        return false;
    }
    if (expression.kind == NK_LIST_LITERAL
            || expression.kind == NK_BRACE_INITIALIZER
            || expression.kind == NK_TUPLE_LITERAL) {
        int index = 0;
        while (index < expression.elements.len) {
            if (semanticRawExpressionCarriesParam(
                    expression.elements.get(index), name,
                    state, vars)) { return true; }
            index = index + 1;
        }
    }
    if (expression.kind == NK_MAP_LITERAL) {
        int index = 0;
        while (index < expression.entries.len) {
            Node entry = expression.entries.get(index);
            if (semanticRawExpressionCarriesParam(
                    entry.key, name, state, vars)
                    || semanticRawExpressionCarriesParam(
                        entry.value_node, name, state, vars)) { return true; }
            index = index + 1;
        }
    }
    return false;
}

int semanticRawBorrowArgumentParameter(Node declaration, Node call,
        int argumentIndex) {
    if (argumentIndex < call.arg_names.len
            && call.arg_names.get(argumentIndex) != "") {
        return semanticParameterIndex(
            declaration.params, call.arg_names.get(argumentIndex));
    }
    return argumentIndex;
}

bool semanticRawParameterBorrowOnly(Node declaration, int parameterIndex,
        SemanticValidationState state);

bool semanticRawUnresolvedCallBorrowOnly(Node callee, int argumentIndex) {
    return callee != null && callee.kind == NK_IDENTIFIER
        && hostedAbiParameterReadOnlyBorrow(callee.name, argumentIndex);
}

bool semanticRawParamCallSafe(Node call, string parameterName, string owner,
        Map<string, bool> locals, Map<string, Node> vars,
        SemanticValidationState state) {
    Node callee = call.callee;
    if (semanticRawExpressionMentionsParam(callee, parameterName)) {
        return false;
    }
    Node? target = null;
    bool unresolved = false;
    if (callee != null && callee.kind == NK_IDENTIFIER) {
        if (locals.has(callee.name)) { return false; }
        if (semanticHostedCallUsesOwnedSymbol(
                callee.name, state, vars)) {
            unresolved = true;
        } else if (state.analyzed.funcTable.has(callee.name)) {
            Node concreteTarget = state.analyzed.funcTable.get(callee.name);
            target = concreteTarget;
            unresolved = concreteTarget.body_node == null;
        } else {
            unresolved = true;
        }
    } else if (callee != null && callee.kind == NK_FIELD_ACCESS_EXPR
            && callee.obj != null && callee.obj.kind == NK_SELF_EXPR
            && owner != "") {
        target = state.analyzed.classMethod(owner, callee.field);
    }
    int argumentIndex = 0;
    while (argumentIndex < call.args.len) {
        Node argument = call.args.get(argumentIndex);
        if (semanticRawExpressionCarriesParam(
                argument, parameterName, state, vars)) {
            if (callee != null && callee.kind == NK_IDENTIFIER
                    && semanticRawLifetimeCall(call, state, vars)
                    && argumentIndex == 0) { return false; }
            if (unresolved && !semanticRawUnresolvedCallBorrowOnly(
                    callee, argumentIndex)) { return false; }
            if (!unresolved) {
                if (target == null) { return false; }
                int targetIndex = semanticRawBorrowArgumentParameter(
                    target, call, argumentIndex);
                if (targetIndex < 0 || !semanticRawParameterBorrowOnly(
                        target, targetIndex, state)) { return false; }
            }
        }
        argumentIndex = argumentIndex + 1;
    }
    return true;
}

bool semanticRawParamExprSafe(Node? expression, string parameterName,
        string owner, Map<string, bool> locals,
        Map<string, Node> vars, SemanticValidationState state) {
    if (expression == null) { return true; }
    if (expression.kind == NK_ASSIGN_EXPR
            && (semanticRawExpressionMentionsParam(
                    expression.target, parameterName)
                || semanticRawExpressionCarriesParam(
                    expression.value_node, parameterName,
                    state, vars))) { return false; }
    if (expression.kind == NK_UNARY_EXPR
            && (expression.op == "++" || expression.op == "--")
            && semanticRawExpressionMentionsParam(
                expression.operand, parameterName)) { return false; }
    if (expression.kind == NK_CALL_EXPR
            && !semanticRawParamCallSafe(
                expression, parameterName, owner, locals, vars, state)) {
        return false;
    }
    if ((expression.kind == NK_LIST_LITERAL
            || expression.kind == NK_BRACE_INITIALIZER
            || expression.kind == NK_TUPLE_LITERAL
            || expression.kind == NK_MAP_LITERAL
            || expression.kind == NK_LAMBDA_EXPR
            || expression.kind == NK_SPAWN_EXPR
            || expression.kind == NK_NEW_EXPR)
            && semanticRawExpressionMentionsParam(
                expression, parameterName)) { return false; }
    if (expression.kind == NK_BINARY_EXPR) {
        return semanticRawParamExprSafe(expression.left, parameterName,
                owner, locals, vars, state)
            && semanticRawParamExprSafe(expression.right, parameterName,
                owner, locals, vars, state);
    }
    if (expression.kind == NK_UNARY_EXPR) {
        return semanticRawParamExprSafe(expression.operand, parameterName,
            owner, locals, vars, state);
    }
    if (expression.kind == NK_CAST_EXPR) {
        return semanticRawParamExprSafe(expression.expr, parameterName,
            owner, locals, vars, state);
    }
    if (expression.kind == NK_CALL_EXPR || expression.kind == NK_NEW_EXPR) {
        int index = 0;
        while (index < expression.args.len) {
            if (!semanticRawParamExprSafe(expression.args.get(index),
                    parameterName, owner, locals,
                    vars, state)) { return false; }
            index = index + 1;
        }
    }
    return true;
}
