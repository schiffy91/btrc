/* Canonical user-typedef expansion shared by analysis and IR generation.
 * Source declarations still emit their aliases; inferred expression types use
 * the underlying shape so operators, members, calls, and generic arguments all
 * see one semantic type domain. */

void typedefSemanticFail(string message, Node site) {
    fprintf(stderr, "error: %s at %d:%d\n", message, site.line, site.col);
    exit(1);
}

Node composeTypedefType(Node useType, Node originalType) {
    if (useType.is_array && originalType.is_array) {
        typedefSemanticFail(
            "Nested array composition through typedef is not supported",
            useType);
    }
    return composeTypeExpr(useType, originalType,
        typeResolvedReferenceShape(originalType));
}

/* Resolve only the alias naming the represented value. Generic arguments keep
 * their source spelling because they also identify emitted monomorphizations:
 * Box<Text> and Box<string> may share a C-compatible payload, but they have
 * distinct generated symbols when both are requested by the source program. */
Node? resolveOuterTypedefTypeInner(Node? typeExpr,
        Map<string, Node> typedefs, Map<string, bool> visited, Node site) {
    if (typeExpr == null) { return null; }
    Node current = typeExpr;
    if (current.generic_args.len > 0 || !typedefs.has(current.base)) {
        return current;
    }
    if (visited.has(current.base)) {
        typedefSemanticFail(
            "Cyclic typedef involving '" + current.base + "'", site);
    }
    visited.put(current.base, true);
    Node? resolved = resolveOuterTypedefTypeInner(
        typedefs.get(current.base), typedefs, visited, site);
    if (resolved == null) {
        typedefSemanticFail("Invalid null typedef target", site);
    }
    Node target = resolved;
    return composeTypedefType(current, target);
}

Node? resolveOuterTypedefType(Node? typeExpr, Map<string, Node> typedefs) {
    if (typeExpr == null) { return null; }
    Map<string, bool> visited = {};
    return resolveOuterTypedefTypeInner(
        typeExpr, typedefs, visited, typeExpr);
}

Node? resolveTypedefType(Node? typeExpr, Map<string, Node> typedefs) {
    Node? outer = resolveOuterTypedefType(typeExpr, typedefs);
    if (outer == null) { return null; }
    Node current = outer;
    if (current.generic_args.len == 0) { return current; }
    Vector<Node> args = [];
    int index = 0;
    while (index < current.generic_args.len) {
        Node? resolved = resolveTypedefType(
            current.generic_args.get(index), typedefs);
        if (resolved == null) {
            typedefSemanticFail("Invalid null generic type", typeExpr);
        }
        Node concrete = resolved;
        args.push(concrete);
        index = index + 1;
    }
    return copyTypeExprWithArgs(current, args);
}
