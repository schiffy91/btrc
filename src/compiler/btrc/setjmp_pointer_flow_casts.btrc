/* Pointer-depth widening across provenance-transparent casts. */

Vector<SetjmpOrigin> setjmpFlowCastOrigins(SetjmpPointerFlow flow,
        string targetType, Vector<SetjmpOrigin> origins) {
    int targetDepth = setjmpRenderedPointerDepth(
        targetType, flow.typeAliases, flow.typeDepths);
    Vector<SetjmpOrigin> widened = [];
    if (targetDepth == 0) {
        if (!setjmpIsVoidType(targetType, flow.voidAliases)) {
            setjmpAddOrigins(flow.result.captures, origins);
        }
        return widened;
    }
    int index = 0;
    while (index < origins.len) {
        SetjmpOrigin origin = origins.get(index);
        int sourceDepth = origin.storage.pointerDepth;
        int remainingDepth = sourceDepth < 0
            ? -1 : sourceDepth - origin.depth + 1;
        if (origin.depth > 0 && targetDepth != 0
                && (targetDepth < 0 || remainingDepth < 0
                    || targetDepth > remainingDepth)) {
            setjmpAddOrigin(widened, SetjmpOrigin(
                origin.storage, -1, origin.sourceExposed));
        } else {
            setjmpAddOrigin(widened, origin);
        }
        index = index + 1;
    }
    return widened;
}
