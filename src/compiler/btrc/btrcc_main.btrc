int main(int argc, char** argv) {
    BtrccOptions options = BtrccDriverOptions.parse(argc, argv);
    if (!options.valid) {
        fprintf(stderr, "btrcc: error: %s\n%s\n",
            options.diagnostic, BtrccDriverOptions.usage());
        return 1;
    }
    if (options.showHelp) {
        if (printLineChecked(BtrccDriverOptions.usage())) { return 0; }
        fprintf(stderr, "btrcc: error: cannot write standard output\n");
        return 1;
    }

    BtrccDataPaths dataPaths = BtrccRuntimePaths.resolve(
        argc > 0 ? Strings.copy(argv[0]) : "");
    if (!dataPaths.valid) {
        fprintf(stderr, "btrcc: error: %s\n", dataPaths.diagnostic);
        return 1;
    }
    feConfigureDataPaths(dataPaths.grammar, dataPaths.stdlib);
    if (options.showStdlibDirectory) {
        if (printLineChecked(dataPaths.stdlib)) { return 0; }
        fprintf(stderr, "btrcc: error: cannot write standard output\n");
        return 1;
    }

    string gt = feReadRequiredSource(dataPaths.grammar);
    if (gt.isEmpty()) {
        fprintf(stderr, "btrcc: error: cannot read grammar: %s\n",
            dataPaths.grammar);
        return 1;
    }
    GrammarInfo g = parseGrammar(gt);

    string path = Strings.copy(argv[options.inputIndex]);
    if (!FileSystem.isFile(path)) {
        fprintf(stderr, "btrcc: error: input file does not exist: %s\n", path);
        return 1;
    }
    string raw = feReadRequiredSource(path);
    FeFrontendResolver resolver = FeFrontendResolver(
        options.includeStdlib, options.strictImports);
    FeResolvedSource resolved = resolver.resolve(raw, path);
    Lexer lx = Lexer(resolved.source, g);
    Vector<Token> toks = lx.tokenize();
    if (lx.failed) {
        fprintf(stderr, "error: %s\n", lx.diagnostic);
        return 1;
    }
    Parser p = Parser(toks, g);
    Node prog = p.parseProgram();
    if (p.failed) {
        fprintf(stderr, "error: %s\n", p.diagnostic);
        return 1;
    }
    if (options.strictImports) {
        FeImportVisibilityChecker visibility =
            FeImportVisibilityChecker(prog, resolved);
        Vector<FeVisibilityDiagnostic> diagnostics = visibility.check();
        if (diagnostics.len > 0) {
            int diagnosticIndex = 0;
            while (diagnosticIndex < diagnostics.len) {
                fprintf(stderr, "%s\n", diagnostics.get(diagnosticIndex).render());
                diagnosticIndex++;
            }
            return 1;
        }
    }
    hostedAbiStampProgramSources(
        prog, resolved.stdlibLineCount, resolved.userLines, path);

    Analyzed a = analyzeProgram(prog);
    semanticValidateProgram(prog, a);
    closeProgramGenericExpressionGraph(prog, a);
    IRGen gen = IRGen(
        a, path, resolved.stdlibLineCount, resolved.userLines);
    gen.dceEnabled = options.runDce;
    IRModule m = gen.generate(prog);
    CEmitter em = CEmitter();
    string c = em.emit(m);

    if (!printNoNL(c)) {
        fprintf(stderr, "btrcc: error: cannot write standard output\n");
        return 1;
    }
    return 0;
}
