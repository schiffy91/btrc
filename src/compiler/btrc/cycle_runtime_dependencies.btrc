/* ARC helper dependency topology, split into cohesive method fragments. */

class CycleRuntimeDependencyCatalog {
    public CycleRuntimeDependencyCatalog() {}

#include "cycle_runtime_dependencies_state.btrc"
#include "cycle_runtime_dependencies_lifecycle.btrc"

    public Vector<string> dependencies(string name) {
        Vector<string> out = self.stateDependencies(name);
        if (out.len > 0) { return out; }
        return self.lifecycleDependencies(name);
    }
}
