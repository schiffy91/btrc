/* Ownership contracts for ARC-managed Mutex values and destructive calls. */

void semanticValidateMutexDestroyReceiver(Node call, Node receiver,
        SemanticValidationState state, Map<string, Node> vars) {
    Node callee = call.callee;
    if (state.standaloneExpression == null
            || state.standaloneExpression != call) {
        semanticValidationFail(
            "Mutex.destroy() must be a standalone expression statement",
            call);
    }
    if (callee.optional) {
        semanticValidationFail(
            "Mutex.destroy() cannot use optional chaining; release a physical owned slot",
            call);
    }
    if (semanticIsVirtualUpdateTarget(receiver, state, vars)
            || !semanticIsLifetimeStableStorage(receiver, state, vars)) {
        semanticValidationFail(
            "Mutex.destroy() requires a physical owned slot; bind projections or temporaries to a local first",
            call);
    }
    Node? receiverType = semanticInferType(receiver, state, vars);
    semanticValidateTargetReceiverMutability(
        receiver, state, vars, call);
    semanticValidateMutableTarget(receiverType, state, call);
    if (receiver.kind == NK_IDENTIFIER
            && state.borrowedBindings.has(receiver.name)) {
        semanticValidationFail(
            "Borrowed Mutex bindings cannot be destroyed; bind an owned local first",
            call);
    }
}

void semanticValidateMutexCall(Node call, Node receiverType,
        SemanticValidationState state, Map<string, Node> vars) {
    Node callee = call.callee;
    string method = callee.field;
    int expected = 0;
    if (method == "set") {
        expected = 1;
    } else if (method != "get" && method != "destroy") {
        semanticValidationFail("Mutex<T> has no method '" + method + "'", call);
    }
    if (call.args.len != expected) {
        semanticValidationFail("'Mutex." + method + "()' expects "
            + Strings.fromInt(expected) + " argument(s) but got "
            + Strings.fromInt(call.args.len), call);
    }
    if (method == "set" && receiverType.generic_args.len == 1) {
        Node expectedType = receiverType.generic_args.get(0);
        Node argument = call.args.get(0);
        semanticValidateTypedInitializer(expectedType, argument,
            "Argument 'value' to 'Mutex.set()'", state, vars);
        Node? actualType = semanticInferType(argument, state, vars);
        if (actualType != null
                && !semanticContextualAggregateInitializer(argument)
                && !semanticAssignmentCompatible(
                    expectedType, actualType, state)) {
            semanticValidationFail("Argument 'value' to 'Mutex.set()' expects '"
                + semanticFormatType(expectedType) + "' but got '"
                + semanticFormatType(actualType) + "'", call.args.get(0));
        }
    }
    if (method == "destroy") {
        semanticValidateMutexDestroyReceiver(
            call, callee.obj, state, vars);
    }
}
