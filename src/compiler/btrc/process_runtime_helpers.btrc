/* Process helper routing and exact header metadata. */

bool processRuntimeHasHelper(string name) {
    return name == "__btrc_descriptor_close_bound"
        || name == "__btrc_close_descriptors_from"
        || name == "__btrc_move_descriptor_outside_stdio"
        || name == "__btrc_posix_spawn_cloexec";
}

string processRuntimeHelperSource(string name) {
    string source = processRuntimeCloseSource(name);
    if (source != "") { return source; }
    return processRuntimeSpawnSource(name);
}

Vector<string> processRuntimeHelperDependencies(string name) {
    Vector<string> out = [];
    if (!processRuntimeHasHelper(name)) { return out; }
    return out;
}

Vector<string> processRuntimeHelperHeaders(string name) {
    Vector<string> out = [];
    if (name == "__btrc_descriptor_close_bound") {
        out.push("stdint.h");
        out.push("sys/resource.h");
    } else if (name == "__btrc_close_descriptors_from") {
        out.push("errno.h");
        out.push("unistd.h");
    } else if (name == "__btrc_move_descriptor_outside_stdio") {
        out.push("errno.h");
        out.push("fcntl.h");
        out.push("unistd.h");
    } else if (name == "__btrc_posix_spawn_cloexec") {
        out.push("errno.h");
        out.push("sys/types.h");
        out.push("unistd.h");
    }
    return out;
}

void appendProcessRuntimeHelperOrder(Vector<string> order) {
    order.push("__btrc_descriptor_close_bound");
    order.push("__btrc_close_descriptors_from");
    order.push("__btrc_move_descriptor_outside_stdio");
    order.push("__btrc_posix_spawn_cloexec");
}
