/* Process helper routing and exact header metadata. */

class ProcessRuntimeCatalog {
    private ProcessRuntimeSourceCatalog sources;
    private Map<string, bool> members;
    private Vector<string> emissionOrder;

    public ProcessRuntimeCatalog(ProcessRuntimeSourceCatalog sources) {
        self.sources = sources;
        self.emissionOrder = [
            "__btrc_descriptor_close_bound",
            "__btrc_close_descriptors_from",
            "__btrc_close_descriptors_except",
            "__btrc_close_descriptors_except_many",
            "__btrc_move_descriptor_outside_stdio",
            "__btrc_posix_spawn_cloexec",
            "__btrc_process_descriptors_supported",
            "__btrc_validate_executable_descriptor",
            "__btrc_validate_working_directory_descriptor",
            "__btrc_enter_working_directory_descriptor",
            "__btrc_exec_signal_guard_begin",
            "__btrc_exec_signal_guard_parent_end",
            "__btrc_exec_signal_guard_child_end",
            "__btrc_exec_executable_descriptor"
        ];
        self.members = {};
        int index = 0;
        while (index < self.emissionOrder.len) {
            self.members.put(self.emissionOrder.get(index), true);
            index = index + 1;
        }
    }

    public bool has(string name) { return self.members.has(name); }

    public string source(string name) {
        string source = self.sources.closeSource(name);
        if (source != "") { return source; }
        source = self.sources.descriptorSource(name);
        if (source != "") { return source; }
        return self.sources.spawnSource(name);
    }

    public Vector<string> dependencies(string name) {
        Vector<string> out = [];
        if (name == "__btrc_close_descriptors_except"
                || name == "__btrc_close_descriptors_except_many") {
            out.push("__btrc_close_descriptors_from");
        } else if (name == "__btrc_exec_signal_guard_parent_end"
                || name == "__btrc_exec_signal_guard_child_end") {
            out.push("__btrc_exec_signal_guard_begin");
        }
        return out;
    }

    public Vector<string> headers(string name) {
        Vector<string> out = [];
        if (name == "__btrc_descriptor_close_bound") {
            out.push("stdint.h");
            out.push("sys/resource.h");
        } else if (name == "__btrc_close_descriptors_from") {
            out.push("errno.h");
            out.push("unistd.h");
        } else if (name == "__btrc_close_descriptors_except_many") {
            out.push("errno.h");
        } else if (name == "__btrc_move_descriptor_outside_stdio") {
            out.push("errno.h");
            out.push("fcntl.h");
            out.push("unistd.h");
        } else if (name == "__btrc_posix_spawn_cloexec") {
            out.push("errno.h");
            out.push("sys/types.h");
            out.push("unistd.h");
        } else if (name == "__btrc_validate_executable_descriptor"
                || name == "__btrc_validate_working_directory_descriptor") {
            out.push("errno.h");
            out.push("sys/stat.h");
            out.push("unistd.h");
        } else if (name == "__btrc_enter_working_directory_descriptor") {
            out.push("errno.h");
            out.push("unistd.h");
        } else if (name == "__btrc_exec_signal_guard_begin"
                || name == "__btrc_exec_signal_guard_parent_end") {
            out.push("errno.h");
            out.push("pthread.h");
            out.push("signal.h");
        } else if (name == "__btrc_exec_signal_guard_child_end") {
            out.push("errno.h");
            out.push("pthread.h");
            out.push("signal.h");
            out.push("string.h");
        } else if (name == "__btrc_exec_executable_descriptor") {
            out.push("errno.h");
            out.push("unistd.h");
        }
        return out;
    }

    public void appendOrder(Vector<string> order) {
        int index = 0;
        while (index < self.emissionOrder.len) {
            order.push(self.emissionOrder.get(index));
            index = index + 1;
        }
    }
}
