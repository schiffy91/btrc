/* Process helper routing and exact header metadata. */

bool processRuntimeHasHelper(string name) {
    return name == "__btrc_descriptor_close_bound"
        || name == "__btrc_close_descriptors_from"
        || name == "__btrc_close_descriptors_except"
        || name == "__btrc_close_descriptors_except_many"
        || name == "__btrc_move_descriptor_outside_stdio"
        || name == "__btrc_posix_spawn_cloexec"
        || name == "__btrc_process_descriptors_supported"
        || name == "__btrc_validate_executable_descriptor"
        || name == "__btrc_validate_working_directory_descriptor"
        || name == "__btrc_enter_working_directory_descriptor"
        || name == "__btrc_exec_signal_guard_begin"
        || name == "__btrc_exec_signal_guard_parent_end"
        || name == "__btrc_exec_signal_guard_child_end"
        || name == "__btrc_exec_executable_descriptor";
}

string processRuntimeHelperSource(string name) {
    string source = processRuntimeCloseSource(name);
    if (source != "") { return source; }
    source = processRuntimeDescriptorSource(name);
    if (source != "") { return source; }
    return processRuntimeSpawnSource(name);
}

Vector<string> processRuntimeHelperDependencies(string name) {
    Vector<string> out = [];
    if (name == "__btrc_close_descriptors_except"
            || name == "__btrc_close_descriptors_except_many") {
        out.push("__btrc_close_descriptors_from");
    } else if (name == "__btrc_exec_signal_guard_parent_end"
            || name == "__btrc_exec_signal_guard_child_end") {
        out.push("__btrc_exec_signal_guard_begin");
    }
    return out;
}

Vector<string> processRuntimeHelperHeaders(string name) {
    Vector<string> out = [];
    if (name == "__btrc_descriptor_close_bound") {
        out.push("stdint.h");
        out.push("sys/resource.h");
    } else if (name == "__btrc_close_descriptors_from") {
        out.push("errno.h");
        out.push("unistd.h");
    } else if (name == "__btrc_close_descriptors_except_many") {
        out.push("errno.h");
    } else if (name == "__btrc_move_descriptor_outside_stdio") {
        out.push("errno.h");
        out.push("fcntl.h");
        out.push("unistd.h");
    } else if (name == "__btrc_posix_spawn_cloexec") {
        out.push("errno.h");
        out.push("sys/types.h");
        out.push("unistd.h");
    } else if (name == "__btrc_validate_executable_descriptor"
            || name == "__btrc_validate_working_directory_descriptor") {
        out.push("errno.h");
        out.push("sys/stat.h");
        out.push("unistd.h");
    } else if (name == "__btrc_enter_working_directory_descriptor") {
        out.push("errno.h");
        out.push("unistd.h");
    } else if (name == "__btrc_exec_signal_guard_begin"
            || name == "__btrc_exec_signal_guard_parent_end") {
        out.push("errno.h");
        out.push("pthread.h");
        out.push("signal.h");
    } else if (name == "__btrc_exec_signal_guard_child_end") {
        out.push("errno.h");
        out.push("pthread.h");
        out.push("signal.h");
        out.push("string.h");
    } else if (name == "__btrc_exec_executable_descriptor") {
        out.push("errno.h");
        out.push("unistd.h");
    }
    return out;
}

void appendProcessRuntimeHelperOrder(Vector<string> order) {
    order.push("__btrc_descriptor_close_bound");
    order.push("__btrc_close_descriptors_from");
    order.push("__btrc_close_descriptors_except");
    order.push("__btrc_close_descriptors_except_many");
    order.push("__btrc_move_descriptor_outside_stdio");
    order.push("__btrc_posix_spawn_cloexec");
    order.push("__btrc_process_descriptors_supported");
    order.push("__btrc_validate_executable_descriptor");
    order.push("__btrc_validate_working_directory_descriptor");
    order.push("__btrc_enter_working_directory_descriptor");
    order.push("__btrc_exec_signal_guard_begin");
    order.push("__btrc_exec_signal_guard_parent_end");
    order.push("__btrc_exec_signal_guard_child_end");
    order.push("__btrc_exec_executable_descriptor");
}
