/* Canonical recursive identity and C-symbol spelling for TypeExpr nodes.
 * Position and array-bound expressions are deliberately absent from identity:
 * they do not change the represented runtime type shape. */

bool typeIdentityAsciiLetter(char value) {
    return (value >= 'A' && value <= 'Z')
        || (value >= 'a' && value <= 'z');
}

bool typeIdentityAsciiDigit(char value) {
    return value >= '0' && value <= '9';
}

bool typeIdentitySafeBase(string base) {
    int length = base.length();
    if (length == 0 || !typeIdentityAsciiLetter(base[0])) { return false; }
    if (length >= 2 && base[0] == 'Z' && base[1] == 'Q') { return false; }
    int index = 1;
    while (index < length) {
        char value = base[index];
        if (!typeIdentityAsciiLetter(value) && !typeIdentityAsciiDigit(value)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

string typeIdentityUtf8Hex(string value) {
    string digits = "0123456789abcdef";
    string encoded = "";
    int index = 0;
    while (index < value.length()) {
        int byteValue = (int)((unsigned char)value[index]);
        encoded = encoded + chr(digits[byteValue / 16]);
        encoded = encoded + chr(digits[byteValue % 16]);
        index = index + 1;
    }
    return encoded;
}

string typeIdentityField(string tag, string value) {
    return tag + Strings.fromInt(value.length()) + "_" + value;
}

int typeIdentityQualifierBits(Node typeExpr) {
    int bits = 0;
    if (typeExpr.is_const) { bits = bits + 1; }
    if (typeExpr.is_static) { bits = bits + 2; }
    if (typeExpr.is_extern) { bits = bits + 4; }
    if (typeExpr.is_volatile) { bits = bits + 8; }
    return bits;
}

string typeIdentityEncodeType(Node typeExpr);

string typeIdentityEncodeTypes(Vector<Node> args) {
    string encoded = "k" + Strings.fromInt(args.len);
    int index = 0;
    while (index < args.len) {
        encoded = encoded
            + typeIdentityField("t", typeIdentityEncodeType(args.get(index)));
        index = index + 1;
    }
    return encoded;
}

string typeIdentityEncodeType(Node typeExpr) {
    string encodedBase = typeIdentityUtf8Hex(typeExpr.base);
    string shape = "p" + Strings.fromInt(typeExpr.pointer_depth)
        + "n" + Strings.fromInt(typeExpr.is_nullable ? 1 : 0)
        + "a" + Strings.fromInt(typeExpr.is_array ? 1 : 0)
        + "q" + Strings.fromInt(typeIdentityQualifierBits(typeExpr));
    return typeIdentityField("b", encodedBase) + shape
        + typeIdentityEncodeTypes(typeExpr.generic_args);
}

string typeIdentityEncodeNameAndTypes(string base, Vector<Node> args) {
    return typeIdentityField("b", typeIdentityUtf8Hex(base))
        + typeIdentityEncodeTypes(args);
}

/* Position-independent semantic key. The encoding is recursive and
 * length-delimited, so no two TypeExpr trees can share a key. */
string typeShapeKey(Node typeExpr) {
    return typeIdentityEncodeType(typeExpr);
}

string genericInstanceKey(string base, Vector<Node> args) {
    return typeIdentityEncodeNameAndTypes(base, args);
}

string methodInstanceKey(string classBase, Vector<Node> classArgs,
                         string methodName, Vector<Node> methodArgs) {
    return typeIdentityEncodeNameAndTypes(classBase, classArgs)
        + typeIdentityField("m", typeIdentityUtf8Hex(methodName))
        + typeIdentityEncodeTypes(methodArgs);
}

bool typeReferencesNames(Node? typeExpr, Map<string, bool> names) {
    if (typeExpr == null) { return false; }
    if (names.has(typeExpr.base)) { return true; }
    int index = 0;
    while (index < typeExpr.generic_args.len) {
        if (typeReferencesNames(typeExpr.generic_args.get(index), names)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

string genericArgumentProblem(Node typeExpr) {
    if (typeExpr.is_const) {
        return "generic arguments cannot be const-qualified";
    }
    if (typeExpr.is_static) {
        return "generic arguments cannot be static-qualified";
    }
    if (typeExpr.is_extern) {
        return "generic arguments cannot be extern-qualified";
    }
    if (typeExpr.is_volatile) {
        return "generic arguments cannot be volatile-qualified";
    }
    int index = 0;
    while (index < typeExpr.generic_args.len) {
        string problem = genericArgumentProblem(typeExpr.generic_args.get(index));
        if (problem != "") { return problem; }
        index = index + 1;
    }
    return "";
}

void typeShapeFail(string message) {
    fprintf(stderr, "error: %s\n", message);
    exit(1);
}

void ensureSupportedGenericArguments(Vector<Node> args) {
    int index = 0;
    while (index < args.len) {
        string problem = genericArgumentProblem(args.get(index));
        if (problem != "") { typeShapeFail(problem); }
        index = index + 1;
    }
}

bool typeIdentityLegacyComponentPossible(Node typeExpr) {
    return typeExpr.generic_args.len == 0
        && typeIdentitySafeBase(typeExpr.base)
        && !typeExpr.is_const && !typeExpr.is_static
        && !typeExpr.is_extern && !typeExpr.is_volatile;
}

string typeIdentityLegacyComponent(Node typeExpr) {
    string component = typeExpr.base;
    if (typeExpr.pointer_depth > 0) {
        component = component + "_p"
            + Strings.fromInt(typeExpr.pointer_depth);
    }
    if (typeExpr.is_nullable) { component = component + "_n"; }
    if (typeExpr.is_array) { component = component + "_a"; }
    return component;
}

bool typeIdentityLegacySequencePossible(Vector<Node> args) {
    int index = 0;
    while (index < args.len) {
        Node argument = args.get(index);
        if (!typeIdentityLegacyComponentPossible(argument)) { return false; }
        if (args.len > 1 && (argument.pointer_depth > 0
                || argument.is_nullable || argument.is_array)) {
            return false;
        }
        index = index + 1;
    }
    return true;
}

string typeIdentityLegacySequence(Vector<Node> args) {
    string sequence = "";
    int index = 0;
    while (index < args.len) {
        if (index > 0) { sequence = sequence + "_"; }
        sequence = sequence + typeIdentityLegacyComponent(args.get(index));
        index = index + 1;
    }
    return sequence;
}

string typeSymbolComponent(Node typeExpr) {
    if (typeIdentityLegacyComponentPossible(typeExpr)) {
        return typeIdentityLegacyComponent(typeExpr);
    }
    return "ZQt" + typeIdentityEncodeType(typeExpr);
}

/* Structural primitive: unlike writable class specializations, Tuple and
 * __fn_ptr are allowed to carry qualified component types. */
string mangleGenericSymbol(string base, Vector<Node> args) {
    if (typeIdentitySafeBase(base) && typeIdentityLegacySequencePossible(args)) {
        string legacy = typeIdentityLegacySequence(args);
        if (legacy == "") { return "btrc_" + base; }
        return "btrc_" + base + "_" + legacy;
    }
    return "btrc_ZQg" + typeIdentityEncodeNameAndTypes(base, args);
}

/* Writable class specialization entry point: fail closed on qualifiers. */
string mangleGenericType(string base, Vector<Node> args) {
    ensureSupportedGenericArguments(args);
    return mangleGenericSymbol(base, args);
}

string mangleMethodInstanceSymbol(string classBase, Vector<Node> classArgs,
                                  string methodName, Vector<Node> methodArgs) {
    ensureSupportedGenericArguments(classArgs);
    ensureSupportedGenericArguments(methodArgs);
    bool legacy = typeIdentitySafeBase(classBase)
        && typeIdentitySafeBase(methodName)
        && typeIdentityLegacySequencePossible(classArgs)
        && typeIdentityLegacySequencePossible(methodArgs);
    if (legacy) {
        string classPart = classBase;
        if (classArgs.len > 0) {
            classPart = "btrc_" + classBase + "_"
                + typeIdentityLegacySequence(classArgs);
        }
        string methodPart = "_" + methodName;
        string methodLegacy = typeIdentityLegacySequence(methodArgs);
        if (methodLegacy != "") {
            methodPart = methodPart + "_" + methodLegacy;
        }
        return classPart + methodPart;
    }
    string payload = typeIdentityEncodeNameAndTypes(classBase, classArgs)
        + typeIdentityField("m", typeIdentityUtf8Hex(methodName))
        + typeIdentityEncodeTypes(methodArgs);
    return "btrc_ZQm" + payload;
}

string mangleFunctionPointerSymbol(Vector<Node> args) {
    if (typeIdentityLegacySequencePossible(args)) {
        return "__btrc_fn_" + typeIdentityLegacySequence(args);
    }
    return "__btrc_fn_ZQf" + typeIdentityEncodeTypes(args);
}

bool isSemanticScalarString(Node? typeExpr) {
    if (typeExpr == null || typeExpr.base != "string"
            || typeExpr.generic_args.len > 0 || typeExpr.is_array) {
        return false;
    }
    int nullableCollapse = typeExpr.is_nullable ? 1 : 0;
    return typeExpr.pointer_depth - nullableCollapse == 0;
}
