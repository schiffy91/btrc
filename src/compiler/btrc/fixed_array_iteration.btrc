/* Exact-once iteration over fixed C-array storage. */

IRNode fixedArrayIterationCapacity(IRNode array) {
    return irBinOp(
        irSizeofExpr(array), "/",
        irSizeofExpr(irIndex(array, irLiteral("0"))));
}

void lowerFixedArrayForIn(IRGen generator, Node statement,
        Node arrayType, Map<string, Node> varTypes,
        Vector<IRNode> output) {
    Vector<Node> roots = [];
    Vector<bool> owned = [];
    Vector<bool> kept = [];
    ownershipCollectProjectionStorage(
        generator, statement.iterable, varTypes,
        roots, owned, kept);
    Vector<string> rootNames = [];
    Vector<string> runtimeTypes = [];
    Vector<string> overrideKeys = [];
    Vector<int> overrideHadValues = [];
    Vector<IRNode> overridePreviousValues = [];
    int rootIndex = 0;
    while (rootIndex < roots.len) {
        Node root = roots.get(rootIndex);
        Node? rootType = generator.resolvedExpressionType(
            root, varTypes);
        ownershipRequireType(rootType, root);
        string rootName = generator.freshTemp(
            "__array_storage");
        IRNode rootDeclaration = irVarDecl(
            typeToC(rootType, generator.analyzed), rootName,
            generator.lowerExpr(root, varTypes));
        output.push(rootDeclaration);
        string runtimeType = beginOwnedIteration(
            generator, root, rootType, varTypes,
            rootName, output);
        rootNames.push(rootName);
        runtimeTypes.push(runtimeType);

        string key = astNodeKey(root);
        overrideKeys.push(key);
        if (generator.owningTempOverrides.has(key)) {
            overrideHadValues.push(1);
            overridePreviousValues.push(
                generator.owningTempOverrides.get(key));
        } else {
            overrideHadValues.push(0);
            overridePreviousValues.push(irLiteral("0"));
        }
        generator.owningTempOverrides.put(
            key, irVar(rootName));
        rootIndex = rootIndex + 1;
    }

    IRNode projected = generator.lowerExpr(
        statement.iterable, varTypes);
    int overrideIndex = overrideKeys.len - 1;
    while (overrideIndex >= 0) {
        string key = overrideKeys.get(overrideIndex);
        if (overrideHadValues.get(overrideIndex) != 0) {
            generator.owningTempOverrides.put(
                key, overridePreviousValues.get(overrideIndex));
        } else {
            generator.owningTempOverrides.remove(key);
        }
        overrideIndex = overrideIndex - 1;
    }

    string iterable = generator.freshTemp("__iter");
    string length = generator.freshTemp("__n");
    string index = generator.freshTemp("__i");
    output.push(irVarDecl(
        typeToC(arrayType, generator.analyzed),
        iterable, projected));
    IRNode iterationLength = fixedArrayIterationCapacity(projected);
    if (statement.iterable.kind == NK_IDENTIFIER
            && generator.gpuHost.array_lengths.has(
                statement.iterable.name)) {
        iterationLength = generator.gpuHost.array_lengths.get(
            statement.iterable.name);
    }
    output.push(irVarDecl(
        "size_t", length, iterationLength));

    Node elementType = typeWithoutOuterArray(arrayType);
    string sourceName = statement.var_name;
    varTypes.put(sourceName, elementType);
    generator.activateSourceLexicalBinding(sourceName);
    string bindingName =
        generator.sourceLexicalReferenceCName(sourceName);
    Vector<IRNode> bindings = [];
    bindings.push(irVarDecl(
        generator.iterValueC(elementType), bindingName,
        irIndex(irVar(iterable), irVar(index))));
    Vector<string> bindingSourceNames = [];
    bindingSourceNames.push(sourceName);
    Vector<Node> bindingTypes = [];
    bindingTypes.push(elementType);
    Vector<bool> bindingOwned = [];
    bindingOwned.push(false);
    IRNode body = generator.loopBodyWithPrefix(
        statement.body_node, varTypes, bindings,
        bindingSourceNames, bindingTypes, bindingOwned);
    output.push(irFor(
        irVarDecl("size_t", index, irLiteral("0")),
        irBinOp(irVar(index), "<", irVar(length)),
        irUnaryOp("++", irVar(index), false), body));

    int cleanupIndex = rootNames.len - 1;
    while (cleanupIndex >= 0) {
        endOwnedIteration(
            generator, rootNames.get(cleanupIndex),
            runtimeTypes.get(cleanupIndex), output);
        cleanupIndex = cleanupIndex - 1;
    }
}
