/* Array-shaped source types have either embedded backing or pointer slots.
 * Keep that storage provenance separate from element/index type inference. */

bool semanticCurrentArrayParameterTarget(Node target,
        SemanticValidationState state) {
    /* borrowedBindings follows lexical shadowing, unlike parameterNames. */
    return target.kind == NK_IDENTIFIER
        && state.parameterNames.has(target.name)
        && state.borrowedBindings.has(target.name);
}

bool semanticAggregateArrayBacking(Node? initializer) {
    return initializer != null
        && (initializer.kind == NK_BRACE_INITIALIZER
            || initializer.kind == NK_LIST_LITERAL);
}

Node? semanticArrayParameterValueType(Node? typeExpr,
        SemanticValidationState state) {
    Node? valueType = semanticArrayValueType(typeExpr, state);
    Node? canonical = semanticResolveAliases(valueType, state);
    if (canonical == null || !canonical.is_array) { return valueType; }
    return typeWithOuterPointer(typeWithoutOuterArray(canonical));
}

Node? semanticArrayTargetMember(Node? expression,
        SemanticValidationState state, Map<string, Node> vars) {
    if (expression == null || expression.kind != NK_FIELD_ACCESS_EXPR
            || expression.optional || expression.obj == null) {
        return null;
    }
    Node target = expression;
    if (target.obj.kind == NK_IDENTIFIER
            && !vars.has(target.obj.name)) {
        Node? staticMember = null;
        if (state.analyzed.isClass(target.obj.name)) {
            staticMember = state.analyzed.classMember(
                target.obj.name, target.field);
        } else if (state.analyzed.isGenericClass(target.obj.name)) {
            staticMember = genericMember(
                state.analyzed, target.obj.name, target.field);
        }
        if (staticMember != null
                && (staticMember.kind == NK_FIELD_DECL
                    || staticMember.kind == NK_PROPERTY_DECL)) {
            return staticMember;
        }
    }

    Node? receiverType = semanticInferType(target.obj, state, vars);
    receiverType = semanticResolveAliases(receiverType, state);
    if (receiverType == null) { return null; }
    Node? classMember = semanticLvalueMember(
        receiverType, target.field, state);
    if (classMember != null
            && (classMember.kind == NK_FIELD_DECL
                || classMember.kind == NK_PROPERTY_DECL)) {
        return classMember;
    }

    string structName = receiverType.base;
    if (structName.startsWith("struct ")) {
        structName = structName.substring(
            7, structName.length() - 7);
    }
    if (!state.analyzed.structTable.has(structName)) { return null; }
    Node structure = state.analyzed.structTable.get(structName);
    int index = 0;
    while (index < structure.fields.len) {
        Node field = structure.fields.get(index);
        if (field.name == target.field) { return field; }
        index = index + 1;
    }
    return null;
}

bool semanticStructArrayFieldTarget(Node? expression,
        SemanticValidationState state, Map<string, Node> vars) {
    if (expression == null || expression.kind != NK_FIELD_ACCESS_EXPR) {
        return false;
    }
    Node? receiverType = semanticInferType(expression.obj, state, vars);
    receiverType = semanticResolveAliases(receiverType, state);
    if (receiverType == null) { return false; }
    string structName = receiverType.base;
    if (structName.startsWith("struct ")) {
        structName = structName.substring(
            7, structName.length() - 7);
    }
    return state.analyzed.structTable.has(structName);
}

/* Parameters always use C pointer ABI, including source `T p[N]`. Unsized
 * instance/struct fields, unsized auto-properties, and unbacked static fields
 * are pointer-valued slots. Fixed physical fields retain embedded backing. */
bool semanticPointerBackedArrayTarget(Node? expression, Node? inferredType,
        SemanticValidationState state, Map<string, Node> vars) {
    Node? resolvedType = semanticResolveAliases(inferredType, state);
    if (expression == null || resolvedType == null
            || !resolvedType.is_array) {
        return false;
    }
    Node target = expression;
    if (semanticCurrentArrayParameterTarget(target, state)) { return true; }
    if (target.kind == NK_IDENTIFIER && vars.has(target.name)) {
        Node? bindingType = semanticArrayValueType(
            vars.get(target.name), state);
        Node? canonicalBinding = semanticResolveAliases(bindingType, state);
        if (canonicalBinding != null && !canonicalBinding.is_array) {
            return true;
        }
    }
    if (resolvedType.array_size != null
            || target.kind != NK_FIELD_ACCESS_EXPR) {
        return false;
    }
    Node? member = semanticArrayTargetMember(target, state, vars);
    if (member == null || (member.access == "class"
            && member.kind == NK_PROPERTY_DECL)) {
        return false;
    }
    Node? memberValueType = semanticArrayFieldValueType(member, state);
    Node? canonicalMemberValue = semanticResolveAliases(
        memberValueType, state);
    if (canonicalMemberValue != null
            && !canonicalMemberValue.is_array) {
        return true;
    }
    if (member.kind == NK_PROPERTY_DECL) { return true; }
    if (member.kind != NK_FIELD_DECL) { return false; }
    return member.access != "class"
        || !semanticAggregateArrayBacking(member.initializer);
}

Node? semanticAssignmentTargetValueType(Node? expression,
        Node? inferredType, SemanticValidationState state,
        Map<string, Node> vars) {
    if (!semanticPointerBackedArrayTarget(
            expression, inferredType, state, vars)) {
        return inferredType;
    }
    Node? resolvedType = semanticResolveAliases(inferredType, state);
    if (resolvedType == null) { return inferredType; }
    return typeWithOuterPointer(typeWithoutOuterArray(resolvedType));
}

/* A physical unsized field is a pointer value unless a static declaration has
 * brace/list backing. Use its represented value type for defaults and
 * aggregate field initializers without changing source indexing metadata. */
Node? semanticArrayFieldValueType(Node field,
        SemanticValidationState state) {
    Node? valueType = semanticArrayValueType(field.type, state);
    Node? resolvedType = semanticResolveAliases(valueType, state);
    if (resolvedType != null && !resolvedType.is_array) { return valueType; }
    if (resolvedType == null || !resolvedType.is_array
            || resolvedType.array_size != null
            || (field.access == "class"
                && semanticAggregateArrayBacking(field.initializer))) {
        return field.type;
    }
    return typeWithOuterPointer(typeWithoutOuterArray(resolvedType));
}

/* Ordinary inferred array values decay; GPU results materialize new backing. */
Node? semanticInferredBindingValueType(Node? inferredType,
        Node? initializer, SemanticValidationState state,
        Map<string, Node> vars) {
    Node? resolvedType = semanticResolveAliases(inferredType, state);
    if (resolvedType == null || !resolvedType.is_array
            || initializer == null
            || initializer.kind == NK_BRACE_INITIALIZER
            || initializer.kind == NK_LIST_LITERAL) {
        return inferredType;
    }
    if (semanticGpuArrayResultCall(initializer, state, vars)) {
        return resolvedType;
    }
    return typeWithOuterPointer(typeWithoutOuterArray(resolvedType));
}

/* Array-returning GPU dispatch needs an object with provable capacity. Pointer
 * slots and virtual properties are valid ordinary assignment targets but do
 * not retain an extent. */
bool semanticArrayTargetHasCapacity(Node? expression, Node? inferredType,
        SemanticValidationState state, Map<string, Node> vars) {
    Node? resolvedType = semanticResolveAliases(inferredType, state);
    if (expression == null || resolvedType == null) { return false; }
    if ((resolvedType.base == "Array" || resolvedType.base == "Vector")
            && resolvedType.generic_args.len > 0) {
        return true;
    }
    if (!resolvedType.is_array) { return false; }
    if (expression.kind == NK_FIELD_ACCESS_EXPR) {
        if (resolvedType.array_size != null) {
            if (semanticStructArrayFieldTarget(
                    expression, state, vars)) {
                return true;
            }
            Node? fixedMember = semanticArrayTargetMember(
                expression, state, vars);
            if (fixedMember != null
                    && fixedMember.kind == NK_FIELD_DECL
                    && fixedMember.access != "class") {
                return true;
            }
        }
        Node? member = semanticArrayTargetMember(
            expression, state, vars);
        return member != null && member.kind == NK_FIELD_DECL
            && member.access == "class" && member.type.is_array
            && semanticAggregateArrayBacking(member.initializer);
    }
    if (expression.kind != NK_IDENTIFIER) { return false; }
    Node target = expression;
    if (semanticCurrentArrayParameterTarget(target, state)) { return false; }
    if (resolvedType.is_extern
            && resolvedType.array_size == null) {
        return false;
    }
    return !semanticPointerBackedArrayTarget(
            target, resolvedType, state, vars);
}

Node? semanticGpuBufferElementType(Node? typeExpr,
        SemanticValidationState state) {
    Node? canonical = semanticResolveAliases(typeExpr, state);
    if (canonical == null) { return null; }
    if ((canonical.base == "Array" || canonical.base == "Vector")
            && canonical.generic_args.len == 1) {
        return semanticResolveAliases(
            canonical.generic_args.get(0), state);
    }
    if (canonical.is_array) {
        return semanticResolveAliases(
            semanticArrayElementType(canonical), state);
    }
    return null;
}

bool semanticGpuBufferElementsExact(Node? expectedType, Node? actualType,
        SemanticValidationState state) {
    Node? expected = semanticGpuBufferElementType(expectedType, state);
    Node? actual = semanticGpuBufferElementType(actualType, state);
    return expected != null && actual != null
        && typeShapeKey(expected) == typeShapeKey(actual);
}

void semanticValidateGpuArrayParameter(Node callable, Node parameter,
        SemanticValidationState state) {
    if (!callable.is_gpu) { return; }
    Node? typeExpr = semanticResolveAliases(parameter.type, state);
    if (typeExpr != null && typeExpr.is_array
            && (typeExpr.is_const || typeExpr.is_volatile)) {
        semanticValidationFail("@gpu function '" + callable.name
            + "': GPU array buffers are read-write and cannot be const- or "
            + "volatile-qualified in parameter '" + parameter.name + "'",
            parameter);
    }
}

bool semanticGpuInputHasCompatibleStorage(Node? expression,
        Node? expectedType, Node? actualType,
        SemanticValidationState state, Map<string, Node> vars) {
    Node? actual = semanticResolveAliases(actualType, state);
    Node? element = semanticGpuBufferElementType(actual, state);
    return actual != null && element != null
        && !actual.is_volatile && !element.is_volatile
        && semanticArrayTargetHasCapacity(
            expression, actual, state, vars)
        && semanticGpuBufferElementsExact(
            expectedType, actual, state);
}

bool semanticGpuOutputElementCompatible(Node? targetType, Node? sourceType,
        SemanticValidationState state) {
    Node? target = semanticResolveAliases(targetType, state);
    Node? targetElement = semanticGpuBufferElementType(target, state);
    if (target == null || targetElement == null
            || target.is_const || target.is_volatile
            || targetElement.is_const || targetElement.is_volatile) {
        return false;
    }
    return semanticGpuBufferElementsExact(
        target, sourceType, state);
}
