/* ARC transaction shared by physical and virtual managed compound updates. */

bool irManagedCompoundKeepsRhs(
        IRGen generator, Node targetType, string op) {
    string magic = semanticBinaryOperatorMethod(op);
    if (magic == "") { return false; }
    Node? method = null;
    if (generator.analyzed.isClass(targetType.base)) {
        method = generator.analyzed.classMethod(targetType.base, magic);
    } else if (generator.analyzed.isGenericClass(targetType.base)) {
        method = generator.analyzed.genericClassMethod(
            targetType.base, magic);
    }
    return method != null && method.params.len > 0
        && method.params.get(0).keep_;
}

class ManagedUpdateOperands {
    public OwnershipBoundary boundary;
    public Node targetType;
    public Node rightType;
    public IRNode oldValue;
    public IRNode rightValue;
    public IRNode replacement;

    public ManagedUpdateOperands(IRGen generator, Node assignment,
            Node targetType, Node oldNode, IRNode loweredOld,
            bool oldTemporaryOwned, Map<string, Node> varTypes) {
        self.boundary = OwnershipBoundary();
        self.targetType = targetType;

        if (oldTemporaryOwned) {
            self.boundary.addLoweredOperand(generator, oldNode,
                targetType, loweredOld, true, false);
            self.oldValue = generator.lowerExpr(oldNode, varTypes);
        } else {
            string oldName = generator.freshTemp("__btrc_update_old");
            IRNode oldDeclaration = irVarDecl(
                typeToC(targetType, generator.analyzed),
                oldName, irLiteral("NULL"));
            self.boundary.declarations.push(oldDeclaration);
            generator.funcVarDecls.push(oldDeclaration);
            self.oldValue = irVar(oldName);
            self.boundary.prefix.push(irBinOp(
                self.oldValue, "=", loweredOld));
        }

        Node? resolvedRight = generator.resolvedExpressionType(
            assignment.value_node, varTypes);
        if (resolvedRight == null) { resolvedRight = targetType; }
        self.rightType = resolvedRight;
        bool managedRight = irManagedType(generator, self.rightType);
        bool rightOwned = managedRight
            && irContextualUnconsumedOwnedResult(generator,
                assignment.value_node, self.rightType, varTypes);
        bool rightKeep = managedRight && irManagedCompoundKeepsRhs(
            generator, targetType, assignment.op.substring(
                0, assignment.op.length() - 1));
        IRNode loweredRight = generator.lowerAssignedValue(
            assignment.value_node, targetType, varTypes);
        if (rightOwned || rightKeep) {
            self.boundary.addLoweredCallOperand(generator,
                assignment.value_node, self.rightType, loweredRight,
                rightOwned, rightKeep, false);
            self.rightValue = generator.lowerExpr(
                assignment.value_node, varTypes);
        } else {
            string rightName = generator.freshTemp("__btrc_update_rhs");
            IRNode rightDeclaration = irVarDecl(
                typeToC(self.rightType, generator.analyzed),
                rightName, irLiteral("0"));
            self.boundary.declarations.push(rightDeclaration);
            generator.funcVarDecls.push(rightDeclaration);
            self.rightValue = irVar(rightName);
            self.boundary.prefix.push(irBinOp(
                self.rightValue, "=", loweredRight));
        }

        string replacementName = generator.freshTemp(
            "__btrc_update_new");
        IRNode replacementDeclaration = irVarDecl(
            typeToC(targetType, generator.analyzed),
            replacementName, irLiteral("NULL"));
        self.boundary.declarations.push(replacementDeclaration);
        generator.funcVarDecls.push(replacementDeclaration);
        self.replacement = irVar(replacementName);
        self.boundary.registerCleanup(generator, replacementDeclaration,
            replacementName, irManagedRuntimeType(generator, targetType));
    }

    public IRNode computed(IRGen generator, Node assignment) {
        string op = assignment.op.substring(
            0, assignment.op.length() - 1);
        IRNode? result = generator.lowerOverloadedValues(op,
            self.oldValue, self.rightValue,
            self.targetType, self.rightType);
        if (result == null) {
            result = generator.lowerTypedBinaryValues(op,
                self.oldValue, self.rightValue,
                self.targetType, self.rightType);
        }
        if (result == null) {
            generator.typedOperatorFail(
                "managed compound operator '" + assignment.op
                    + "' has no structured lowering");
        }
        return result;
    }

    public void restore(IRGen generator) {
        self.boundary.restore(generator);
    }
}

IRNode finishManagedOwnedUpdate(IRGen generator,
        ManagedUpdateOperands operands, IRNode effect) {
    string resultName = generator.freshTemp("__btrc_update_result");
    IRNode resultDeclaration = irVarDecl(
        typeToC(operands.targetType, generator.analyzed),
        resultName, irLiteral("NULL"));
    operands.boundary.declarations.push(resultDeclaration);
    generator.funcVarDecls.push(resultDeclaration);
    IRNode result = irVar(resultName);
    Vector<IRNode> sequence = operands.boundary.prefix;
    sequence.push(effect);
    sequence.push(irBinOp(result, "=", operands.replacement));
    int suffixIndex = 0;
    while (suffixIndex < operands.boundary.suffix.len) {
        sequence.push(operands.boundary.suffix.get(suffixIndex));
        suffixIndex = suffixIndex + 1;
    }
    sequence.push(irBinOp(
        operands.replacement, "=", irLiteral("NULL")));
    sequence.push(result);
    return irStmtExpr(
        operands.boundary.declarations, irCommaExpr(sequence));
}

IRNode lowerManagedLocalCompoundStore(IRGen generator, Node assignment,
        IRNode target, Node targetType, Map<string, Node> varTypes) {
    ManagedUpdateOperands operands = ManagedUpdateOperands(generator,
        assignment, targetType, assignment.target, target, false, varTypes);
    Vector<IRNode> sequence = [];
    sequence.push(irBinOp(operands.replacement, "=",
        operands.computed(generator, assignment)));
    sequence.push(irBinOp(target, "=", operands.replacement));
    sequence.push(irBinOp(
        operands.replacement, "=", irLiteral("NULL")));
    sequence.push(generator.optionalReleaseExpr(operands.oldValue,
        irManagedRuntimeType(generator, targetType)));
    sequence.push(target);
    operands.restore(generator);
    return operands.boundary.finish(
        generator, irCommaExpr(sequence), targetType, false);
}

IRNode lowerManagedFieldCompoundStore(IRGen generator, Node assignment,
        IRNode receiverDeclaration, IRNode receiver, IRNode target,
        Node targetType, Map<string, Node> varTypes) {
    ManagedUpdateOperands operands = ManagedUpdateOperands(generator,
        assignment, targetType, assignment.target, target, false, varTypes);
    Vector<IRNode> sequence = [];
    sequence.push(irBinOp(operands.replacement, "=",
        operands.computed(generator, assignment)));
    string runtimeType = irManagedRuntimeType(generator, targetType);
    if (irManagedClassType(generator, targetType)) {
        string transferName = generator.freshTemp(
            "__btrc_update_transfer");
        IRNode transferDeclaration = irVarDecl(
            typeToC(targetType, generator.analyzed),
            transferName, irLiteral("NULL"));
        operands.boundary.declarations.push(transferDeclaration);
        generator.funcVarDecls.push(transferDeclaration);
        IRNode transfer = irVar(transferName);
        sequence.push(irBinOp(transfer, "=", operands.replacement));
        sequence.push(irBinOp(
            operands.replacement, "=", irLiteral("NULL")));
        sequence.push(irManagedReplaceEdge(generator,
            target, transfer, targetType, receiver, true));
        if (irManagedRuntimeCanCycle(generator, runtimeType)) {
            sequence.push(managedArcPoll(generator));
        }
    } else {
        sequence.push(irManagedUnlinkEdge(generator,
            operands.oldValue, targetType, receiver));
        sequence.push(irBinOp(target, "=", operands.replacement));
        sequence.push(irBinOp(
            operands.replacement, "=", irLiteral("NULL")));
        sequence.push(generator.optionalReleaseExpr(
            operands.oldValue, runtimeType));
    }
    sequence.push(target);
    operands.restore(generator);
    IRNode update = operands.boundary.finish(
        generator, irCommaExpr(sequence), targetType, false);
    Vector<IRNode> declarations = [];
    declarations.push(receiverDeclaration);
    Vector<IRNode> outer = [];
    outer.push(irBinOp(receiver, "=", generator.lowerExpr(
        assignment.target.obj, varTypes)));
    outer.push(update);
    return irStmtExpr(declarations, irCommaExpr(outer));
}
