/* Mutation target categories, owner lifetime roots, and receiver constness. */

bool semanticIsLvalue(Node? expression,
        SemanticValidationState state, Map<string, Node> vars) {
    if (expression == null) { return false; }
    if (expression.kind == NK_IDENTIFIER) {
        return semanticIdentifierStorage(expression.name, state, vars);
    }
    if (expression.kind == NK_INDEX_EXPR) {
        return semanticIsProtocolIndexProjection(expression, state, vars)
            || semanticIsAddressableStorage(expression, state, vars);
    }
    if (expression.kind == NK_FIELD_ACCESS_EXPR) {
        if (expression.optional) { return false; }
        if (semanticIsPropertyProjection(expression, state, vars)) {
            return true;
        }
        return semanticIsAddressableStorage(expression, state, vars);
    }
    return expression.kind == NK_UNARY_EXPR && expression.op == "*";
}

bool semanticTemporaryManagedType(Node? typeExpr,
        SemanticValidationState state) {
    if (typeExpr == null) { return false; }
    string base = typeExpr.base;
    return isStringType(typeExpr)
        || state.analyzed.isClass(base)
        || state.analyzed.isGenericClass(base)
        || base == "Array" || base == "List" || base == "Map"
        || base == "Set" || base == "Vector" || base == "Mutex";
}

bool semanticHasTemporaryManagedOwner(Node? expression,
        SemanticValidationState state, Map<string, Node> vars) {
    if (expression == null) { return false; }
    Node? resultType = semanticInferType(expression, state, vars);
    resultType = semanticResolveAliases(resultType, state);
    bool managedResult = semanticTemporaryManagedType(resultType, state);
    if ((expression.kind == NK_CALL_EXPR
            || expression.kind == NK_NEW_EXPR) && managedResult) {
        return true;
    }
    if ((expression.kind == NK_LIST_LITERAL
            || expression.kind == NK_MAP_LITERAL
            || expression.kind == NK_BRACE_INITIALIZER) && managedResult) {
        return true;
    }
    if (expression.kind == NK_CAST_EXPR) {
        return semanticHasTemporaryManagedOwner(
            expression.expr, state, vars);
    }
    if (expression.kind == NK_F_STRING_LITERAL) {
        int partIndex = 0;
        while (partIndex < expression.parts.len) {
            if (expression.parts.get(partIndex).kind == NK_F_STRING_EXPR) {
                return true;
            }
            partIndex = partIndex + 1;
        }
        return false;
    }
    if (expression.kind == NK_ASSIGN_EXPR && managedResult) {
        Node? target = expression.target;
        bool ownedReceiver = target != null
            && (target.kind == NK_FIELD_ACCESS_EXPR
                || target.kind == NK_INDEX_EXPR)
            && semanticHasTemporaryManagedOwner(
                target.obj, state, vars);
        bool virtualOwnedValue = expression.op == "="
            && semanticIsVirtualUpdateTarget(target, state, vars)
            && managedResult;
        return ownedReceiver || virtualOwnedValue;
    }
    if (expression.kind == NK_BINARY_EXPR && expression.op != "??"
            && managedResult) {
        Node? leftType = semanticInferType(
            expression.left, state, vars);
        Node? rightType = semanticInferType(
            expression.right, state, vars);
        if (expression.op == "+" && isStringType(leftType)
                && isStringType(rightType)) {
            return true;
        }
        return leftType != null && semanticHasBinaryOverload(
            leftType, expression.op, state);
    }
    if (expression.kind == NK_UNARY_EXPR && managedResult) {
        Node? operandType = semanticInferType(
            expression.operand, state, vars);
        return operandType != null && semanticHasUnaryOverload(
            operandType, expression.op, state);
    }
    if (expression.kind == NK_INDEX_EXPR) {
        if (managedResult && semanticIsProtocolIndexProjection(
                expression, state, vars)) {
            return true;
        }
        return semanticHasTemporaryManagedOwner(
            expression.obj, state, vars);
    }
    if (expression.kind == NK_FIELD_ACCESS_EXPR) {
        if (managedResult && semanticPropertyDispatchProjection(
                expression, state, vars)) {
            return true;
        }
        return semanticHasTemporaryManagedOwner(
            expression.obj, state, vars);
    }
    if (expression.kind == NK_TERNARY_EXPR) {
        return semanticHasTemporaryManagedOwner(
                expression.true_expr, state, vars)
            || semanticHasTemporaryManagedOwner(
                expression.false_expr, state, vars);
    }
    if (expression.kind == NK_BINARY_EXPR && expression.op == "??") {
        return semanticHasTemporaryManagedOwner(
                expression.left, state, vars)
            || semanticHasTemporaryManagedOwner(
                expression.right, state, vars);
    }
    return false;
}

bool semanticIsLifetimeStableStorage(Node? expression,
        SemanticValidationState state, Map<string, Node> vars) {
    return semanticIsAddressableStorage(expression, state, vars)
        && !semanticHasTemporaryManagedOwner(expression, state, vars);
}

bool semanticTargetHasConstReceiver(Node? target,
        SemanticValidationState state, Map<string, Node> vars) {
    if (target == null) { return false; }
    if (target.kind != NK_FIELD_ACCESS_EXPR
            && target.kind != NK_INDEX_EXPR) {
        return false;
    }
    Node? receiverType = semanticInferType(target.obj, state, vars);
    receiverType = semanticResolveAliases(receiverType, state);
    if (receiverType != null && receiverType.is_const) { return true; }
    if (target.kind == NK_INDEX_EXPR
            && semanticRawLvaluePointer(receiverType, state)) {
        return false;
    }
    return semanticTargetHasConstReceiver(target.obj, state, vars);
}

void semanticValidateTargetReceiverMutability(Node? target,
        SemanticValidationState state, Map<string, Node> vars, Node site) {
    if (semanticTargetHasConstReceiver(target, state, vars)) {
        semanticValidationFail(
            "Cannot modify through a const-qualified receiver", site);
    }
}
