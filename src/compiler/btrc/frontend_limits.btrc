/* Owned resource policy and isolated accounting for frontend source graphs. */

import std.io;

class FeSourceResolutionPolicy {
    private int maximumSourceBytes;
    private int maximumFiles;
    private int maximumDirectoryEntries;
    private int maximumImportDepth;

    public FeSourceResolutionPolicy() {
        self.maximumSourceBytes = 67108864;
        self.maximumFiles = 10000;
        self.maximumDirectoryEntries = 100000;
        self.maximumImportDepth = 256;
    }

    public int sourceByteLimit() {
        return self.maximumSourceBytes;
    }

    public int sourceFileLimit() {
        return self.maximumFiles;
    }

    public int directoryEntryLimit() {
        return self.maximumDirectoryEntries;
    }

    public int importDepthLimit() {
        return self.maximumImportDepth;
    }

    public FeResolutionBudget newResolutionBudget() {
        return FeResolutionBudget(self);
    }

    public FeDirectoryScanBudget newDirectoryBudget(string root) {
        return FeDirectoryScanBudget(self, root);
    }

    private int addSourceBytes(int total, string source) {
        int length = source.length();
        if (length > self.maximumSourceBytes - total) {
            fprintf(stderr, "error: resolved source exceeds the %d-byte limit\n",
                self.maximumSourceBytes);
            exit(1);
        }
        return total + length;
    }

    public void validateCombinedSource(
            string first, string separator, string second) {
        int total = self.addSourceBytes(0, first);
        total = self.addSourceBytes(total, separator);
        self.addSourceBytes(total, second);
    }
}

class FeResolutionBudget {
    private FeSourceResolutionPolicy policy;
    private int totalBytes;
    private int files;

    public FeResolutionBudget(FeSourceResolutionPolicy policy) {
        self.policy = policy;
        self.totalBytes = 0;
        self.files = 0;
    }

    public int sourceBytes() {
        return self.totalBytes;
    }

    public int fileCount() {
        return self.files;
    }

    public void enter(string source, string path, int depth) {
        if (depth > self.policy.importDepthLimit()) {
            fprintf(stderr,
                "error: include/import graph exceeds the maximum depth of %d at '%s'\n",
                self.policy.importDepthLimit(), path);
            exit(1);
        }
        self.files++;
        if (self.files > self.policy.sourceFileLimit()) {
            fprintf(stderr, "error: include/import graph exceeds the %d-file limit\n",
                self.policy.sourceFileLimit());
            exit(1);
        }
        int sourceBytes = source.length();
        if (sourceBytes > self.policy.sourceByteLimit() - self.totalBytes) {
            fprintf(stderr, "error: resolved source exceeds the %d-byte limit\n",
                self.policy.sourceByteLimit());
            exit(1);
        }
        self.totalBytes = self.totalBytes + sourceBytes;
    }
}

class FeDirectoryScanBudget {
    private FeSourceResolutionPolicy policy;
    private int entries;
    private int files;
    private string root;

    public FeDirectoryScanBudget(
            FeSourceResolutionPolicy policy, string root) {
        self.policy = policy;
        self.entries = 0;
        self.files = 0;
        self.root = root;
    }

    public int entryCount() {
        return self.entries;
    }

    public int fileCount() {
        return self.files;
    }

    public int remainingEntries() {
        return self.policy.directoryEntryLimit() - self.entries;
    }

    public void addEntries(int count) {
        if (count > self.remainingEntries()) {
            fprintf(stderr,
                "error: import directory exceeds the %d-entry scan limit: '%s'\n",
                self.policy.directoryEntryLimit(), self.root);
            exit(1);
        }
        self.entries = self.entries + count;
    }

    public void addFile() {
        self.files++;
        if (self.files > self.policy.sourceFileLimit()) {
            fprintf(stderr,
                "error: import directory exceeds the %d-file limit: '%s'\n",
                self.policy.sourceFileLimit(), self.root);
            exit(1);
        }
    }
}
