/* Ownership checks for shallow rich-enum constructor payloads. */

Map<string, bool> semanticRichEnumSuppliedParameters(
        Node variant, Node call) {
    Map<string, bool> supplied = {};
    int positional = 0;
    int argumentIndex = 0;
    while (argumentIndex < call.args.len) {
        string argumentName = "";
        if (argumentIndex < call.arg_names.len) {
            argumentName = call.arg_names.get(argumentIndex);
        }
        int parameterIndex = positional;
        if (argumentName != "") {
            parameterIndex = semanticParameterIndex(
                variant.params, argumentName);
        } else {
            positional = positional + 1;
        }
        if (parameterIndex >= 0 && parameterIndex < variant.params.len) {
            supplied.put(Strings.fromInt(parameterIndex), true);
        }
        argumentIndex = argumentIndex + 1;
    }
    return supplied;
}

Map<string, Node> semanticRichEnumDefaultTypes(
        Node variant, int parameterIndex,
        SemanticValidationState state) {
    Map<string, Node> vars = semanticGlobalTypes(state.analyzed);
    int prior = 0;
    while (prior < parameterIndex) {
        Node parameter = variant.params.get(prior);
        vars.put(parameter.name, parameter.type);
        prior = prior + 1;
    }
    return vars;
}

bool semanticRichEnumPayloadRequiresOwner(Node parameter, Node value,
        SemanticValidationState state, Map<string, Node> vars) {
    Node? actual = semanticInferType(value, state, vars);
    return semanticExpressionOwnsResult(value, state, vars)
        || semanticRequiresTargetStringConversion(
            parameter.type, actual, state);
}

void semanticRejectRichEnumOwnedArgs(Node call,
        SemanticValidationState state, Map<string, Node> vars) {
    Node callee = call.callee;
    if (callee == null || callee.kind != NK_FIELD_ACCESS_EXPR
            || callee.obj == null || callee.obj.kind != NK_IDENTIFIER
            || vars.has(callee.obj.name)
            || !state.analyzed.isRichEnum(callee.obj.name)) { return; }
    Node? resolved = semanticResolveRichEnumVariant(
        callee.obj.name, callee.field, state.analyzed);
    if (resolved == null) { return; }
    Node variant = resolved;
    string payload = callee.obj.name + "." + variant.name;
    semanticRejectOwnedElements(call.args,
        "rich-enum payload '" + payload + "'", state, vars);

    int positional = 0;
    int argumentIndex = 0;
    while (argumentIndex < call.args.len) {
        string argumentName = "";
        if (argumentIndex < call.arg_names.len) {
            argumentName = call.arg_names.get(argumentIndex);
        }
        int parameterIndex = positional;
        if (argumentName != "") {
            parameterIndex = semanticParameterIndex(
                variant.params, argumentName);
        } else {
            positional = positional + 1;
        }
        if (parameterIndex >= 0 && parameterIndex < variant.params.len) {
            Node parameter = variant.params.get(parameterIndex);
            Node argument = call.args.get(argumentIndex);
            if (semanticRichEnumPayloadRequiresOwner(
                    parameter, argument, state, vars)) {
                semanticValidationFail("caller-owned temporary cannot be "
                    + "embedded in rich-enum payload '" + payload
                    + "'; aggregate class elements are shallow borrowed "
                    + "references, so bind the owner to a local first",
                    argument);
            }
        }
        argumentIndex = argumentIndex + 1;
    }

    Map<string, bool> supplied =
        semanticRichEnumSuppliedParameters(variant, call);
    int parameterIndex = 0;
    while (parameterIndex < variant.params.len) {
        Node parameter = variant.params.get(parameterIndex);
        if (!supplied.has(Strings.fromInt(parameterIndex))
                && parameter.default_ != null) {
            Map<string, Node> defaultVars = semanticRichEnumDefaultTypes(
                variant, parameterIndex, state);
            if (semanticRichEnumPayloadRequiresOwner(
                    parameter, parameter.default_, state, defaultVars)) {
                semanticValidationFail("Omitted default for rich-enum payload '"
                    + payload + "." + parameter.name + "' produces a "
                    + "caller-owned temporary; rich-enum payloads are shallow "
                    + "borrowed references, so pass a prebound owner explicitly",
                    call);
            }
        }
        parameterIndex = parameterIndex + 1;
    }
}
