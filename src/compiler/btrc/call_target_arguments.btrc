/* Target-resolved parameter binding for calls and constructors. */

Node callTargetResolvedParameter(Analyzed analyzed, Node source,
        Map<string, Node> substitutions) {
    Node parameter = Node();
    parameter.kind = NK_PARAM;
    parameter.name = source.name;
    parameter.type = resolveGenericType(
        source.type, substitutions, analyzed);
    parameter.default_ = source.default_;
    parameter.keep_ = source.keep_;
    parameter.line = source.line;
    parameter.col = source.col;
    return parameter;
}

Vector<Node> callTargetResolvedParameters(Analyzed analyzed,
        Vector<Node> source, Map<string, Node> substitutions) {
    Vector<Node> parameters = [];
    int index = 0;
    while (index < source.len) {
        parameters.push(callTargetResolvedParameter(
            analyzed, source.get(index), substitutions));
        index = index + 1;
    }
    return parameters;
}

Map<string, Node> callTargetTypeMap(IRGen generator, Node call,
        Map<string, Node> varTypes) {
    Map<string, Node> substitutions = {};
    Node? method = null;
    if (call.kind == NK_NEW_EXPR) {
        Node instance = generator.resolveBodyType(call.type);
        if (generator.analyzed.isGenericClass(instance.base)) {
            return genericTypeMap(generator.analyzed, instance);
        }
        return substitutions;
    }
    Node? callee = call.callee;
    if (callee == null) { return substitutions; }
    if (callee.kind == NK_IDENTIFIER) {
        if (varTypes.has(callee.name)
                || !generator.analyzed.isGenericClass(callee.name)) {
            return substitutions;
        }
        Node? instance = generator.resolvedExpressionType(call, varTypes);
        if (instance != null && instance.base == callee.name) {
            return genericTypeMap(generator.analyzed, instance);
        }
        return substitutions;
    }
    if (callee.kind != NK_FIELD_ACCESS_EXPR) {
        return substitutions;
    }
    Node receiver = callee.obj;
    if (receiver != null && receiver.kind == NK_IDENTIFIER
            && !varTypes.has(receiver.name)
            && generator.analyzed.isClass(receiver.name)) {
        method = generator.analyzed.classMethod(
            receiver.name, callee.field);
    } else {
        Node? receiverType = generator.resolvedExpressionType(
            receiver, varTypes);
        if (receiverType != null
                && generator.analyzed.isGenericClass(receiverType.base)) {
            substitutions = genericTypeMap(
                generator.analyzed, receiverType);
            method = generator.analyzed.genericClassMethod(
                receiverType.base, callee.field);
        } else if (receiverType != null
                && generator.analyzed.isClass(receiverType.base)) {
            method = generator.analyzed.classMethod(
                receiverType.base, callee.field);
        }
    }
    if (method != null && method.kind == NK_METHOD_DECL) {
        substitutions = methodCallTypeMap(
            generator.analyzed, call, method, substitutions);
    }
    return substitutions;
}

Map<string, Node> beginCallDefaultTypeScope(IRGen generator,
        Map<string, Node> substitutions) {
    Map<string, Node> saved = generator.activeTypeMap;
    Map<string, Node> combined = {};
    Vector<string> names = saved.keys();
    int index = 0;
    while (index < names.len) {
        string name = names.get(index);
        combined.put(name, saved.get(name));
        index = index + 1;
    }
    names = substitutions.keys();
    index = 0;
    while (index < names.len) {
        string name = names.get(index);
        combined.put(name, substitutions.get(name));
        index = index + 1;
    }
    generator.activeTypeMap = combined;
    generator.callDefaultTypeDepth = generator.callDefaultTypeDepth + 1;
    return saved;
}

void endCallDefaultTypeScope(IRGen generator,
        Map<string, Node> saved) {
    generator.activeTypeMap = saved;
    generator.callDefaultTypeDepth = generator.callDefaultTypeDepth - 1;
}

Node? callDefaultExpressionType(IRGen generator, Node expression,
        Map<string, Node> substitutions, Map<string, Node> varTypes) {
    Map<string, Node> saved = beginCallDefaultTypeScope(
        generator, substitutions);
    Node? result = generator.resolvedExpressionType(
        expression, varTypes);
    endCallDefaultTypeScope(generator, saved);
    return result;
}

IRNode lowerCallDefaultValue(IRGen generator, Node expression,
        Node expected, Map<string, Node> substitutions,
        Map<string, Node> varTypes) {
    Map<string, Node> saved = beginCallDefaultTypeScope(
        generator, substitutions);
    IRNode result = generator.lowerAssignedValueRaw(
        expression, expected, varTypes);
    endCallDefaultTypeScope(generator, saved);
    return result;
}

void callArgumentBindingFail(IRGen generator, string message) {
    generator.typedOperatorFail(message);
}

Vector<IRNode> orderCallTargetArguments(IRGen generator,
        Vector<Node> sourceParameters,
        Map<string, Node> substitutions,
        Vector<string> argNames, Vector<IRNode> irArgs,
        Vector<Node> astArgs, Map<string, Node> varTypes) {
    if (sourceParameters.len == 0) { return irArgs; }
    if (irArgs.len != astArgs.len) {
        callArgumentBindingFail(generator,
            "internal argument/source association mismatch");
    }
    Vector<Node> parameters = callTargetResolvedParameters(
        generator.analyzed, sourceParameters, substitutions);
    Map<string, int> parameterIndices = {};
    Vector<int> sourceForSlot = [];
    int index = 0;
    while (index < parameters.len) {
        parameterIndices.put(parameters.get(index).name, index);
        sourceForSlot.push(-1);
        index = index + 1;
    }
    int positional = 0;
    index = 0;
    while (index < astArgs.len) {
        string name = index < argNames.len
            ? argNames.get(index) : "";
        int slot = positional;
        if (name != "") {
            if (!parameterIndices.has(name)) {
                callArgumentBindingFail(generator,
                    "unknown named argument '" + name + "'");
            }
            slot = parameterIndices.get(name);
        } else {
            positional = positional + 1;
            if (slot >= parameters.len) {
                callArgumentBindingFail(generator,
                    "too many positional arguments");
            }
        }
        if (sourceForSlot.get(slot) >= 0) {
            callArgumentBindingFail(generator,
                "duplicate argument for parameter '"
                + parameters.get(slot).name + "'");
        }
        sourceForSlot.set(slot, index);
        index = index + 1;
    }
    Vector<IRNode> result = [];
    int slot = 0;
    while (slot < parameters.len) {
        Node parameter = parameters.get(slot);
        int sourceIndex = sourceForSlot.get(slot);
        IRNode value = irLiteral("0");
        Node? sourceType = null;
        if (sourceIndex >= 0) {
            Node source = astArgs.get(sourceIndex);
            value = irArgs.get(sourceIndex);
            if (source.kind == NK_BRACE_INITIALIZER
                    || source.kind == NK_LIST_LITERAL
                    || source.kind == NK_MAP_LITERAL) {
                value = generator.lowerAssignedValueRaw(
                    source, parameter.type, varTypes);
            }
            sourceType = generator.resolvedExpressionType(
                source, varTypes);
        } else {
            if (parameter.default_ == null) {
                callArgumentBindingFail(generator,
                    "missing required argument for parameter '"
                    + parameter.name + "'");
            }
            value = lowerCallDefaultValue(
                generator, parameter.default_, parameter.type,
                substitutions, varTypes);
            sourceType = callDefaultExpressionType(
                generator, parameter.default_, substitutions, varTypes);
        }
        result.push(generator.upcastClassPointer(
            parameter.type, sourceType, value));
        slot = slot + 1;
    }
    return result;
}
