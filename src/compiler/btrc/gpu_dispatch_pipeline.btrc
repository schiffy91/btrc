/* Resource binding, chunked execution, checked-status readback, and user-data
 * readback for one structured dispatch helper. */

void gpuMarkNull(Vector<IRNode> body, string name, string ok) {
    body.push(irIf(irBinOp(irVar(name), "==", irVar("NULL")),
        irBlock([irAssign(irVar(ok), irLiteral("false"))]), null));
}

void gpuAppendCheckedRead(Vector<IRNode> body, Vector<IRNode> args,
        string ok) {
    body.push(irIf(irUnaryOp("!",
        irCall("btrc_gpu_read_buffer_checked", args), true),
        irBlock([irAssign(irVar(ok), irLiteral("false"))]), null));
}

void gpuAppendDispatchPipeline(IRGen gen, IRGpuKernel kernel,
        string helperName, string uniformStruct, Vector<IRNode> body,
        Vector<string> bufferNames, string gpu, string ok, string uniforms,
        string uniformBuffer, string statusBuffer, string status,
        string shader, string pipeline, string bindings, string bindGroup,
        string started) {
    string outputBuffer = helperName + "_buf_output";
    if (kernel.output_buffer != null) {
        Vector<IRNode> createOutput = [];
        createOutput.push(irVar(gpu));
        createOutput.push(irBinOp(irVar("__gpu_n"), "*",
            irSizeofType(gpuCElementType(kernel))));
        createOutput.push(gpuUsage(false, true));
        body.push(irVarDecl("void*", outputBuffer,
            irCall("btrc_gpu_create_buffer", createOutput)));
        gpuMarkNull(body, outputBuffer, ok);
        bufferNames.push(outputBuffer);
    }
    body.push(irVarDecl("struct " + uniformStruct, uniforms, null));
    int p = 0;
    while (p < kernel.declaration.params.len) {
        Node parameter = kernel.declaration.params.get(p);
        if (!parameter.type.is_array) {
            IRNode value = irVar(
                HostedAbi.lexicalBindingCNameForAnalysis(
                    parameter.name, gen.analyzed));
            if (parameter.type.base == "bool") {
                value = irTernary(value, irLiteral("1U"), irLiteral("0U"));
            }
            body.push(irAssign(irFieldAccess(irVar(uniforms),
                HostedAbi.lexicalBindingCName(parameter.name), false), value));
        }
        p = p + 1;
    }
    int a = 0;
    while (a < kernel.param_buffers.len) {
        string source = kernel.param_buffers.get(a).name;
        body.push(irAssign(irFieldAccess(irVar(uniforms),
            gpuLengthName(source), false), irVar(gpuLengthName(source))));
        a = a + 1;
    }
    body.push(irAssign(irFieldAccess(irVar(uniforms), "__gpu_off", false),
        irLiteral("0")));
    body.push(irAssign(irFieldAccess(irVar(uniforms), "__gpu_n", false),
        irVar("__gpu_n")));
    Vector<IRNode> createUniform = [];
    createUniform.push(irVar(gpu));
    createUniform.push(irSizeofType("struct " + uniformStruct));
    createUniform.push(gpuUsage(true, false));
    body.push(irVarDecl("void*", uniformBuffer,
        irCall("btrc_gpu_create_buffer", createUniform)));
    gpuMarkNull(body, uniformBuffer, ok);
    Vector<IRNode> writeUniform = [];
    writeUniform.push(irVar(gpu)); writeUniform.push(irVar(uniformBuffer));
    writeUniform.push(irCast("void*", irAddressOf(irVar(uniforms))));
    writeUniform.push(irSizeofType("struct " + uniformStruct));
    body.push(irIf(irVar(ok), irBlock([
        gpuCallStatement("btrc_gpu_write_buffer", writeUniform)]), null));
    body.push(irVarDecl("uint32_t", status, irLiteral("0U")));
    Vector<IRNode> createStatus = [];
    createStatus.push(irVar(gpu));
    createStatus.push(irSizeofType("uint32_t"));
    createStatus.push(gpuUsage(false, true));
    body.push(irVarDecl("void*", statusBuffer,
        irCall("btrc_gpu_create_buffer", createStatus)));
    gpuMarkNull(body, statusBuffer, ok);
    Vector<IRNode> writeStatus = [];
    writeStatus.push(irVar(gpu)); writeStatus.push(irVar(statusBuffer));
    writeStatus.push(irCast("void*", irAddressOf(irVar(status))));
    writeStatus.push(irSizeofType("uint32_t"));
    body.push(irIf(irVar(ok), irBlock([
        gpuCallStatement("btrc_gpu_write_buffer", writeStatus)]), null));
    body.push(irVarDecl("void*", shader, irVar("NULL")));
    body.push(irVarDecl("void*", pipeline, irVar("NULL")));
    body.push(irVarDecl("void*", bindGroup, irVar("NULL")));
    Vector<IRNode> createShader = [];
    createShader.push(irVar(gpu));
    createShader.push(irVar(kernel.name + "_wgsl"));
    body.push(irIf(irVar(ok), irBlock([
        irAssign(irVar(shader),
            irCall("btrc_gpu_create_shader", createShader))]), null));
    gpuMarkNull(body, shader, ok);
    Vector<IRNode> createPipeline = [];
    createPipeline.push(irVar(gpu)); createPipeline.push(irVar(shader));
    createPipeline.push(irLiteral("\"main\""));
    body.push(irIf(irVar(ok), irBlock([
        irAssign(irVar(pipeline),
            irCall("btrc_gpu_create_compute_pipeline", createPipeline))]), null));
    gpuMarkNull(body, pipeline, ok);
    int totalBindings = kernel.param_buffers.len
        + (kernel.output_buffer != null ? 1 : 0) + 2;
    body.push(irArrayVarDecl("void*", bindings,
        irLiteral(Strings.fromInt(totalBindings)), null));
    int binding = 0;
    int b = 0;
    while (b < kernel.param_buffers.len) {
        body.push(irAssign(irIndex(irVar(bindings),
            irLiteral(Strings.fromInt(binding))), irVar(bufferNames.get(b))));
        binding = binding + 1;
        b = b + 1;
    }
    if (kernel.output_buffer != null) {
        body.push(irAssign(irIndex(irVar(bindings),
            irLiteral(Strings.fromInt(binding))), irVar(outputBuffer)));
        binding = binding + 1;
    }
    body.push(irAssign(irIndex(irVar(bindings),
        irLiteral(Strings.fromInt(binding))), irVar(uniformBuffer)));
    binding = binding + 1;
    body.push(irAssign(irIndex(irVar(bindings),
        irLiteral(Strings.fromInt(binding))), irVar(statusBuffer)));
    Vector<IRNode> createBind = [];
    createBind.push(irVar(gpu)); createBind.push(irVar(pipeline));
    createBind.push(irVar(bindings));
    createBind.push(irLiteral(Strings.fromInt(totalBindings)));
    body.push(irIf(irVar(ok), irBlock([
        irAssign(irVar(bindGroup),
            irCall("btrc_gpu_create_bind_group", createBind))]), null));
    gpuMarkNull(body, bindGroup, ok);
    gpuAppendDispatchExecution(gen, kernel, uniformStruct, body, bufferNames,
        gpu, ok, uniforms, uniformBuffer, statusBuffer, status,
        pipeline, bindGroup, outputBuffer, started);
    gpuAppendCleanup(body, bufferNames, uniformBuffer, statusBuffer,
        bindGroup, pipeline, shader);
    gpuAppendStatusFailures(body, status);
    gpuAppendPostSubmitFailure(body, ok, started);
    Vector<IRNode> failedSetup = [];
    gpuAppendUnavailable(gen, kernel, failedSetup, true);
    body.push(irIf(irBinOp(irUnaryOp("!", irVar(ok), true),
        "&&", irUnaryOp("!", irVar(started), true)),
        irBlock(failedSetup), null));
}

void gpuAppendDispatchExecution(IRGen gen, IRGpuKernel kernel,
        string uniformStruct, Vector<IRNode> body,
        Vector<string> bufferNames, string gpu,
        string ok, string uniforms, string uniformBuffer,
        string statusBuffer, string status, string pipeline,
        string bindGroup, string outputBuffer, string started) {
    string offset = "__gpu_offset";
    string items = "__gpu_work_items";
    string groups = "__gpu_workgroups";
    Vector<IRNode> loop = [];
    loop.push(irVarDecl("int", items, irTernary(
        irBinOp(irBinOp(irVar("__gpu_n"), "-", irVar(offset)), ">",
            irLiteral("4194240")), irLiteral("4194240"),
        irBinOp(irVar("__gpu_n"), "-", irVar(offset)))));
    loop.push(irAssign(irFieldAccess(irVar(uniforms), "__gpu_off", false),
        irVar(offset)));
    Vector<IRNode> writeUniform = [];
    writeUniform.push(irVar(gpu)); writeUniform.push(irVar(uniformBuffer));
    writeUniform.push(irCast("void*", irAddressOf(irVar(uniforms))));
    writeUniform.push(irSizeofType("struct " + uniformStruct));
    loop.push(gpuCallStatement("btrc_gpu_write_buffer", writeUniform));
    loop.push(irVarDecl("int", groups, irBinOp(
        irBinOp(irVar(items), "+", irLiteral("63")), "/", irLiteral("64"))));
    Vector<IRNode> dispatch = [];
    dispatch.push(irVar(gpu)); dispatch.push(irVar(pipeline));
    dispatch.push(irVar(bindGroup)); dispatch.push(irVar(groups));
    loop.push(irIf(irCall("btrc_gpu_dispatch", dispatch),
        irBlock([irAssign(irVar(started), irLiteral("true"))]),
        irBlock([irAssign(irVar(ok), irLiteral("false"))])));
    loop.push(irAssign(irVar(offset), irBinOp(irVar(offset), "+", irVar(items))));
    Vector<IRNode> execute = [];
    execute.push(irVarDecl("int", offset, irLiteral("0")));
    execute.push(irWhile(irBinOp(irVar(ok), "&&",
        irBinOp(irVar(offset), "<", irVar("__gpu_n"))),
        irBlock(loop)));
    Vector<IRNode> readStatus = [];
    readStatus.push(irVar(gpu)); readStatus.push(irVar(statusBuffer));
    readStatus.push(irCast("void*", irAddressOf(irVar(status))));
    readStatus.push(irSizeofType("uint32_t"));
    Vector<IRNode> afterDispatch = [];
    gpuAppendCheckedRead(afterDispatch, readStatus, ok);
    Vector<IRNode> readUser = [];
    if (kernel.output_buffer != null) {
        Vector<IRNode> read = [];
        read.push(irVar(gpu)); read.push(irVar(outputBuffer));
        read.push(irCast("void*", irVar("__gpu_output")));
        read.push(irBinOp(irVar("__gpu_n"), "*",
            irSizeofType(gpuCElementType(kernel))));
        gpuAppendCheckedRead(readUser, read, ok);
    } else {
        int b = 0;
        while (b < kernel.param_buffers.len) {
            IRGpuBuffer buffer = kernel.param_buffers.get(b);
            Vector<IRNode> read = [];
            read.push(irVar(gpu)); read.push(irVar(bufferNames.get(b)));
            read.push(irCast("void*",
                irVar(HostedAbi.lexicalBindingCNameForAnalysis(
                    buffer.name, gen.analyzed))));
            read.push(irBinOp(irVar(gpuLengthName(buffer.name)), "*",
                irSizeofType(buffer.elem_type == "f32" ? "float" : "int")));
            gpuAppendCheckedRead(readUser, read, ok);
            b = b + 1;
        }
    }
    afterDispatch.push(irIf(irBinOp(irBinOp(irVar(status), "==", irLiteral("0U")),
        "&&", irVar(ok)),
        irBlock(readUser), null));
    execute.push(irIf(irVar(ok), irBlock(afterDispatch), null));
    body.push(irIf(irVar(ok), irBlock(execute), null));
}
