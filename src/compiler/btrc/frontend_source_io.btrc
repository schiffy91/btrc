/* Strict source-file and directory reads for the self-hosted frontend. */

#include "frontend_limits.btrc"

int FE_MAX_SOURCE_BYTES = 67108864;

void feSourceReadError(string path, string reason) {
    fprintf(stderr, "error: cannot read source file '%s': %s\n", path, reason);
    exit(1);
}

bool feUtf8Continuation(int value) {
    return value >= 128 && value <= 191;
}

bool feValidUtf8At(Bytes data, int index, int width) {
    if (index + width > data.len) { return false; }
    int lead = data.get(index);
    int second = data.get(index + 1);
    if (!feUtf8Continuation(second)) { return false; }
    if (width == 2) { return lead >= 194 && lead <= 223; }
    int third = data.get(index + 2);
    if (!feUtf8Continuation(third)) { return false; }
    if (width == 3) {
        if (lead == 224 && second < 160) { return false; }
        if (lead == 237 && second > 159) { return false; }
        return lead >= 224 && lead <= 239;
    }
    int fourth = data.get(index + 3);
    if (!feUtf8Continuation(fourth)) { return false; }
    if (lead == 240 && second < 144) { return false; }
    if (lead == 244 && second > 143) { return false; }
    return lead >= 240 && lead <= 244;
}

int feUtf8Width(Bytes data, int index) {
    int lead = data.get(index);
    if (lead == 0) { return 0; }
    if (lead <= 127) { return 1; }
    if (lead >= 194 && lead <= 223 && feValidUtf8At(data, index, 2)) { return 2; }
    if (lead >= 224 && lead <= 239 && feValidUtf8At(data, index, 3)) { return 3; }
    if (lead >= 240 && lead <= 244 && feValidUtf8At(data, index, 4)) { return 4; }
    return 0;
}

string feDecodeSource(Bytes data, string path) {
    int index = 0;
    if (data.len >= 3 && data.get(0) == 239
            && data.get(1) == 187 && data.get(2) == 191) {
        index = 3;
    }
    Bytes normalized = Bytes();
    while (index < data.len) {
        int width = feUtf8Width(data, index);
        if (width == 0) {
            fprintf(stderr, "error: source file '%s' is not valid UTF-8 at byte %d\n",
                path, index);
            exit(1);
        }
        int first = data.get(index);
        if (first == 13) {
            normalized.append(10);
            index = index + 1;
            if (index < data.len && data.get(index) == 10) { index = index + 1; }
        } else {
            int part = 0;
            while (part < width) {
                normalized.append(data.get(index + part));
                part = part + 1;
            }
            index = index + width;
        }
    }
    return normalized.toStringLossy();
}

string feReadRequiredSource(string path) {
    File source = File(path, "rb");
    if (!source.ok()) { feSourceReadError(path, "open failed"); }
    Bytes encoded = source.readBytesBounded(FE_MAX_SOURCE_BYTES);
    bool readFailed = source.failed();
    bool closed = source.close();
    if (readFailed) { feSourceReadError(path, "read failed"); }
    if (!closed || source.failed()) { feSourceReadError(path, "close failed"); }
    if (encoded.len > FE_MAX_SOURCE_BYTES) {
        feSourceReadError(path, "file exceeds the 67108864-byte limit");
    }
    return feDecodeSource(encoded, path);
}

Vector<string> feReadRequiredDirectory(string path, int maxEntries) {
    Directory directory = Directory(path);
    Vector<string> entries = directory.entriesBounded(maxEntries);
    if (directory.failed()) {
        fprintf(stderr, "error: cannot scan source directory '%s'\n", path);
        exit(1);
    }
    if (entries.len > maxEntries) {
        fprintf(stderr, "error: source directory exceeds its entry scan limit: '%s'\n",
            path);
        exit(1);
    }
    return entries;
}
