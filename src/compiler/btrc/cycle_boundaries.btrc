/* Deterministic drains at observable self-hosted ownership boundaries. */

bool isPublicCollectionBase(string name) {
    return name == "Array" || name == "List" || name == "Map"
        || name == "Set" || name == "Vector";
}

bool irContainsCyclableRelease(IRNode? node) {
    if (node == null) { return false; }
    if (node.kind == IRK_CALL && node.callee == "__btrc_arc_release") {
        return true;
    }
    if (irContainsCyclableRelease(node.left)
            || irContainsCyclableRelease(node.right)
            || irContainsCyclableRelease(node.operand)
            || irContainsCyclableRelease(node.expr)
            || irContainsCyclableRelease(node.obj)
            || irContainsCyclableRelease(node.index)
            || irContainsCyclableRelease(node.condition)
            || irContainsCyclableRelease(node.true_expr)
            || irContainsCyclableRelease(node.false_expr)
            || irContainsCyclableRelease(node.array_size)
            || irContainsCyclableRelease(node.init)
            || irContainsCyclableRelease(node.value)
            || irContainsCyclableRelease(node.target)
            || irContainsCyclableRelease(node.then_block)
            || irContainsCyclableRelease(node.else_block)
            || irContainsCyclableRelease(node.body)
            || irContainsCyclableRelease(node.update)
            || irContainsCyclableRelease(node.result)) {
        return true;
    }
    int index = 0;
    while (index < node.args.len) {
        if (irContainsCyclableRelease(node.args.get(index))) { return true; }
        index = index + 1;
    }
    index = 0;
    while (index < node.stmts.len) {
        if (irContainsCyclableRelease(node.stmts.get(index))) { return true; }
        index = index + 1;
    }
    return false;
}

IRNode irForcedCycleFlush() {
    Vector<IRNode> arguments = [];
    return irExprStmt(irCall("__btrc_flush_cycles", arguments));
}

bool irIsForcedCycleFlush(IRNode node) {
    return node.kind == IRK_EXPR_STMT
        && node.expr != null
        && node.expr.kind == IRK_CALL
        && node.expr.callee == "__btrc_flush_cycles";
}

bool irSequenceEndsWithCycleFlush(Vector<IRNode> statements) {
    return statements.len > 0
        && irIsForcedCycleFlush(statements.get(statements.len - 1));
}

void rewriteNestedCycleReturns(IRNode node) {
    if (node.kind == IRK_BLOCK) {
        rewriteCycleReturns(node);
    } else if (node.kind == IRK_IF) {
        rewriteCycleReturns(node.then_block);
        if (node.else_block != null) {
            rewriteCycleReturns(node.else_block);
        }
    } else if (node.kind == IRK_WHILE
            || node.kind == IRK_DO_WHILE
            || node.kind == IRK_FOR) {
        rewriteCycleReturns(node.body);
    } else if (node.kind == IRK_SWITCH) {
        int index = 0;
        while (index < node.args.len) {
            IRNode branch = node.args.get(index);
            rewriteCycleReturns(branch);
            index = index + 1;
        }
    } else if (node.kind == IRK_CASE) {
        rewriteCycleReturns(node);
    }
}

void rewriteCycleReturns(IRNode block) {
    Vector<IRNode> rewritten = [];
    int index = 0;
    while (index < block.stmts.len) {
        IRNode statement = block.stmts.get(index);
        rewriteNestedCycleReturns(statement);
        if (statement.kind == IRK_RETURN
                && !irSequenceEndsWithCycleFlush(rewritten)) {
            rewritten.push(irForcedCycleFlush());
        }
        rewritten.push(statement);
        index = index + 1;
    }
    block.stmts = rewritten;
}

void forceCycleBoundary(IRGen generator, IRFunction definition) {
    generator.useHelper("__btrc_flush_cycles");
    rewriteCycleReturns(definition.body);
    if (irSequenceMayFallThrough(definition.body.stmts)
            && !irSequenceEndsWithCycleFlush(definition.body.stmts)) {
        definition.body.stmts.push(irForcedCycleFlush());
    }
}

bool installReleaseBearingCycleBoundary(
        IRGen generator, IRFunction definition) {
    if (definition.body == null
            || !irContainsCyclableRelease(definition.body)) {
        return false;
    }
    forceCycleBoundary(generator, definition);
    return true;
}

void installProgramCycleBoundary(IRGen generator, IRModule module) {
    bool hasCyclableRelease = false;
    int index = 0;
    while (index < module.functions.len) {
        IRFunction definition = module.functions.get(index);
        if (definition.body != null
                && irContainsCyclableRelease(definition.body)) {
            hasCyclableRelease = true;
            break;
        }
        index = index + 1;
    }
    if (!hasCyclableRelease) { return; }
    index = 0;
    while (index < module.functions.len) {
        IRFunction definition = module.functions.get(index);
        if (definition.name == "main" || definition.name == "btrc_main") {
            forceCycleBoundary(generator, definition);
        }
        index = index + 1;
    }
}
