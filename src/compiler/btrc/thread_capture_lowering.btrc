/* Completion-safe ownership lowering for spawned capture environments. */

IRFunction spawnCaptureReleaseAdapter(IRGen generator, string name,
        string envName, string fieldName, Node captureType) {
    IRFunction definition = IRFunction();
    definition.name = name;
    definition.return_type = "void";
    definition.is_static = true;
    definition.params.push(IRParam("void*", "__raw"));
    string envType = "struct " + envName + "*";
    Vector<IRNode> body = [];
    body.push(irVarDecl(envType, "__env",
        irCast(envType, irVar("__raw"))));
    IRNode field = irFieldAccess(
        irVar("__env"), HostedAbi.lexicalBindingCName(fieldName), true);
    body.push(irVarDecl(
        typeToC(captureType, generator.analyzed),
        "__value", field));
    body.push(irAssign(field, irLiteral("NULL")));
    body.push(irExprStmt(irManagedReleaseValue(
        generator, irVar("__value"), captureType)));
    definition.body = irBlock(body);
    return definition;
}

IRNode spawnCaptureErrorBuffer(string name) {
    return irArrayVarDecl(
        "char", name, irLiteral("1024"), irLiteral("\"\""));
}

IRNode guardSpawnCapture(string adapter) {
    Vector<IRNode> arguments = [];
    arguments.push(irFunctionRef(adapter));
    arguments.push(irVar("__env"));
    arguments.push(irVar("__error"));
    arguments.push(irSizeofExpr(irVar("__error")));
    IRNode guarded = irCall("__btrc_arc_guard_hook", arguments);
    Vector<IRNode> first = [];
    Vector<IRNode> copyArguments = [];
    copyArguments.push(irVar("__first_error"));
    copyArguments.push(irVar("__error"));
    copyArguments.push(irSizeofExpr(irVar("__first_error")));
    first.push(irExprStmt(irCall("memcpy", copyArguments)));
    first.push(irAssign(
        irVar("__has_error"), irLiteral("1")));
    return irIf(irBinOp(guarded, "&&", irUnaryOp(
        "!", irVar("__has_error"), true)), irBlock(first), null);
}

string emitSpawnCaptureDisposer(IRGen generator,
        Vector<string> capNames, Map<string, Node> varTypes,
        string envName, int spawnId) {
    if (capNames.len == 0) { return ""; }
    Vector<string> adapters = [];
    int index = 0;
    while (index < capNames.len) {
        string captureName = capNames.get(index);
        Node? captureType = varTypes.get(captureName);
        if (generator.managedValues.isManaged(
                generator.resolveBodyType(captureType))) {
            string adapter = "__btrc_spawn_capture_release_"
                + Strings.fromInt(spawnId) + "_" + captureName;
            generator.curModule.functions.push(
                spawnCaptureReleaseAdapter(generator, adapter,
                    envName, captureName, captureType));
            adapters.push(adapter);
        }
        index = index + 1;
    }

    string name = "__btrc_spawn_env_dispose_"
        + Strings.fromInt(spawnId);
    IRFunction definition = IRFunction();
    definition.name = name;
    definition.return_type = "void";
    definition.is_static = true;
    definition.params.push(IRParam("void*", "__raw"));
    Vector<IRNode> body = [];
    string envType = "struct " + envName + "*";
    body.push(irVarDecl(envType, "__env",
        irCast(envType, irVar("__raw"))));
    if (adapters.len > 0) {
        generator.useHelper("__btrc_arc_guard_hook");
        generator.useHelper("__btrc_raise_captured");
        generator.useHelper("__btrc_throw");
        body.push(irVarDecl(
            "int", "__has_error", irLiteral("0")));
        body.push(spawnCaptureErrorBuffer("__first_error"));
        body.push(spawnCaptureErrorBuffer("__error"));
        index = 0;
        while (index < adapters.len) {
            body.push(guardSpawnCapture(adapters.get(index)));
            index = index + 1;
        }
    }
    Vector<IRNode> freeArguments = [];
    freeArguments.push(irVar("__env"));
    body.push(irExprStmt(irCall("free", freeArguments)));
    if (adapters.len > 0) {
        Vector<IRNode> raiseArguments = [];
        raiseArguments.push(irFunctionRef("__btrc_throw"));
        raiseArguments.push(irVar("__first_error"));
        Vector<IRNode> raiseBody = [];
        raiseBody.push(irExprStmt(irCall(
            "__btrc_raise_captured", raiseArguments)));
        body.push(irIf(irVar("__has_error"),
            irBlock(raiseBody), null));
    }
    definition.body = irBlock(body);
    generator.curModule.functions.push(definition);
    return name;
}
