/* Type-domain, storage-duration, and array-shape declaration contracts. */

bool semanticExplicitCTag(string base) {
    return base.startsWith("struct ") || base.startsWith("enum ")
        || base.startsWith("union ");
}

bool semanticRuntimeTypeBase(string base) {
    return base == "Array" || base == "List" || base == "Map"
        || base == "Mutex" || base == "Set" || base == "Thread"
        || base == "Tuple" || base == "Vector" || base == "__fn_ptr";
}

bool semanticKnownDeclarationType(
        Node typeExpr, SemanticValidationState state) {
    if (typeExpr.pointer_depth > 0 && typeExpr.generic_args.len == 0) {
        return true;
    }
    string base = typeExpr.base;
    return state.typeParams.has(base)
        || NumericSemantics.isIntegralBase(base) || NumericSemantics.isStandardTypedef(base)
        || base == "float" || base == "double" || base == "long double"
        || base == "bool" || base == "string" || base == "void"
        || semanticRuntimeTypeBase(base)
        || state.analyzed.isClass(base)
        || state.analyzed.isGenericClass(base)
        || state.interfaces.has(base)
        || state.analyzed.isEnum(base)
        || state.analyzed.isRichEnum(base)
        || state.analyzed.structTable.has(base)
        || state.analyzed.typedefTable.has(base)
        || base.endsWith("_t")
        || semanticExplicitCTag(base);
}

void semanticValidateDeclaredType(Node? typeExpr, string subject,
        string role, Node site, SemanticValidationState state) {
    if (typeExpr == null) { return; }
    if (typeExpr.is_static && typeExpr.is_extern) {
        semanticValidationFail(
            subject + " cannot be both static and extern", site);
    }
    if ((role == "parameter" || role == "field")
            && (typeExpr.is_static || typeExpr.is_extern)) {
        semanticValidationFail(subject
            + " cannot carry static/extern storage qualifiers", site);
    }
    if (role == "return"
            && (typeEffectiveOuterConst(
                    typeExpr, state.analyzed.typedefTable)
                || typeEffectiveOuterVolatile(
                    typeExpr, state.analyzed.typedefTable))) {
        semanticValidationFail(subject
            + " cannot carry an outer const/volatile qualifier; "
            + "C discards qualifiers on returned values", site);
    }
    Node? canonical = semanticResolveAliases(typeExpr, state);
    if (canonical != null && canonical.base == "Mutex"
            && (canonical.pointer_depth > 0 || canonical.is_array
                || canonical.is_const)) {
        semanticValidationFail(
            "Mutex<T> owner type must be one direct mutable handle; "
                + "pointer, array, and const Mutex shapes are not supported",
            site);
    }
    if (canonical != null && canonical.base != "Mutex"
            && canonical.base != "Thread"
            && canonical.base != "__fn_ptr"
            && !state.analyzed.isClass(canonical.base)
            && !state.analyzed.isGenericClass(canonical.base)
            && semanticContainsMutexStorage(canonical, state)) {
        semanticValidationFail(subject
            + " cannot embed a Mutex handle in shallow by-value storage; "
            + "keep Mutex<T> as a direct managed value", site);
    }
    semanticValidateMutexPayloadsInType(typeExpr, site, state);
    if (canonical != null && canonical.base == "Thread"
            && (canonical.pointer_depth > 0 || canonical.is_array
                || canonical.is_const || canonical.is_nullable)) {
        semanticValidationFail(
            "Thread<T> owner type must be one direct mutable handle; "
                + "pointer, array, const, and nullable Thread shapes are not "
                + "supported",
            site);
    }
    if ((role == "field" || role == "parameter")
            && semanticContainsThreadStorage(typeExpr, state)) {
        semanticValidationFail(subject
            + " cannot own a Thread handle; keep each Thread<T> in one "
            + "initialized local variable or return it", site);
    }
    if (canonical != null && canonical.base == "Thread"
            && canonical.generic_args.len > 0) {
        Node resultType = canonical.generic_args.get(0);
        Map<string, bool> visiting = {};
        if (semanticThreadResultHasUnsizedArray(
                resultType, visiting, state)) {
            semanticValidationFail(
                "Thread<T> result type cannot contain an unsized array; "
                    + "return a managed collection or another explicitly "
                    + "owned value",
                site);
        }
        if (semanticContainsThreadStorage(resultType, state)) {
            semanticValidationFail(
                "Thread<T> result type cannot contain another Thread handle",
                site);
        }
        if (semanticContainsMutexStorage(resultType, state)) {
            semanticValidationFail(
                "Thread<T> result type cannot contain a Mutex handle",
                site);
        }
        if (!semanticDirectManagedThreadResult(resultType, state)
                && semanticThreadAggregateHasManagedReference(
                    resultType, visiting, state)) {
            semanticValidationFail(
                "Thread<T> aggregate result type cannot contain string or "
                    + "class references; return the managed value directly "
                    + "or use a scalar-only aggregate",
                site);
        }
    }
    if (role != "return" && role != "alias"
            && semanticScalarVoid(canonical)) {
        semanticValidationFail(subject
            + " cannot have scalar/non-pointer void type", site);
    }
    if (canonical != null && canonical.pointer_depth == 0
            && state.analyzed.structTable.has(canonical.base)
            && state.analyzed.structTable.get(canonical.base).is_forward) {
        semanticValidationFail("Incomplete struct '" + canonical.base
            + "' cannot be used by value for " + subject, site);
    }
    if (!semanticKnownDeclarationType(typeExpr, state)) {
        semanticValidationFail(subject + " uses unknown by-value type '"
            + semanticFormatType(typeExpr) + "'", site);
    }
    int index = 0;
    while (index < typeExpr.generic_args.len) {
        string argumentRole = "object";
        if ((typeExpr.base == "__fn_ptr" || typeExpr.base == "Thread")
                && index == 0) {
            argumentRole = "return";
        }
        semanticValidateDeclaredType(typeExpr.generic_args.get(index),
            "Generic argument " + Strings.fromInt(index + 1)
                + " of " + subject,
            argumentRole, site, state);
        index = index + 1;
    }
}

void semanticValidateAggregateDeclarationTypes(
        Node program, SemanticValidationState state) {
    Map<string, Node> noVars = {};
    int index = 0;
    while (index < program.declarations.len) {
        Node declaration = program.declarations.get(index);
        if (declaration.kind == NK_STRUCT_DECL && !declaration.is_forward) {
            int fieldIndex = 0;
            while (fieldIndex < declaration.fields.len) {
                Node field = declaration.fields.get(fieldIndex);
                semanticValidateDeclaredType(field.type,
                    "Struct field '" + declaration.name + "."
                        + field.name + "'", "field", field, state);
                semanticValidateArrayBound(field.type,
                    "struct field '" + declaration.name + "."
                        + field.name + "'", "field", field, state, noVars);
                fieldIndex = fieldIndex + 1;
            }
        } else if (declaration.kind == NK_TYPEDEF_DECL) {
            semanticValidateDeclaredType(declaration.original,
                "Typedef '" + declaration.alias + "'", "alias",
                declaration, state);
        } else if (declaration.kind == NK_INTERFACE_DECL) {
            Map<string, bool> previousParams =
                semanticCloneFlags(state.typeParams);
            state.typeParams = semanticTypeParamSet(
                declaration.generic_params);
            int methodIndex = 0;
            while (methodIndex < declaration.methods.len) {
                Node method = declaration.methods.get(methodIndex);
                semanticValidateDeclaredType(method.return_type,
                    "Interface method '" + declaration.name + "."
                        + method.name + "' return", "return", method, state);
                semanticValidateArrayReturn(method, "Interface method '"
                    + declaration.name + "." + method.name + "'");
                int parameterIndex = 0;
                while (parameterIndex < method.params.len) {
                    Node parameter = method.params.get(parameterIndex);
                    semanticValidateDeclaredType(parameter.type,
                        "Parameter '" + parameter.name + "'", "parameter",
                        parameter, state);
                    parameterIndex = parameterIndex + 1;
                }
                methodIndex = methodIndex + 1;
            }
            state.typeParams = previousParams;
        } else if (declaration.kind == NK_RICH_ENUM_DECL) {
            int variantIndex = 0;
            while (variantIndex < declaration.variants.len) {
                Node variant = declaration.variants.get(variantIndex);
                int parameterIndex = 0;
                while (parameterIndex < variant.params.len) {
                    Node parameter = variant.params.get(parameterIndex);
                    semanticValidateDeclaredType(parameter.type,
                        "Rich-enum payload '" + declaration.name + "."
                            + variant.name + "." + parameter.name + "'",
                        "parameter", parameter, state);
                    if (typeEffectiveOuterConst(
                            parameter.type,
                            state.analyzed.typedefTable)) {
                        semanticValidationFail("Rich-enum payload '"
                            + declaration.name + "." + variant.name + "."
                            + parameter.name + "' cannot use const storage "
                            + "until rich-enum constructors use structured "
                            + "initialization", parameter);
                    }
                    parameterIndex = parameterIndex + 1;
                }
                variantIndex = variantIndex + 1;
            }
        }
        index = index + 1;
    }
}
