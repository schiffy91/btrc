            + "    if (!object) return 0;\n"
            + "    __btrc_arc_lock_mutation();\n"
            + "    __btrc_arc_release_impl(object, type, 1, replacement);\n"
            + "    __btrc_arc_unlock_mutation();\n"
            + "    __btrc_arc_drain_deferred();\n"
            + "    return 0;\n"
            + "}";
