/* Normalize unused C parameters into explicit structured discards.
 * Mirrors src/compiler/python/ir/parameter_usage.py. */

void collectParameterUses(IRNode node, Map<string, bool> names,
                          Map<string, bool> references,
                          Map<string, bool> declarations) {
    if (node == null) { return; }
    if (node.kind == IRK_VAR && names.has(node.name)) {
        references.put(node.name, true);
    } else if (node.kind == IRK_VAR_DECL && names.has(node.name)) {
        declarations.put(node.name, true);
    }

    collectParameterUses(node.left, names, references, declarations);
    collectParameterUses(node.right, names, references, declarations);
    collectParameterUses(node.operand, names, references, declarations);
    collectParameterUses(node.expr, names, references, declarations);
    collectParameterUses(node.obj, names, references, declarations);
    collectParameterUses(node.index, names, references, declarations);
    collectParameterUses(node.condition, names, references, declarations);
    collectParameterUses(node.true_expr, names, references, declarations);
    collectParameterUses(node.false_expr, names, references, declarations);
    collectParameterUses(node.init, names, references, declarations);
    collectParameterUses(node.value, names, references, declarations);
    collectParameterUses(node.target, names, references, declarations);
    collectParameterUses(node.then_block, names, references, declarations);
    collectParameterUses(node.else_block, names, references, declarations);
    collectParameterUses(node.body, names, references, declarations);
    collectParameterUses(node.update, names, references, declarations);
    collectParameterUses(node.result, names, references, declarations);
    collectParameterUses(node.array_size, names, references, declarations);
    int i = 0;
    while (i < node.args.len) {
        collectParameterUses(
            node.args.get(i), names, references, declarations);
        i = i + 1;
    }
    int s = 0;
    while (s < node.stmts.len) {
        collectParameterUses(
            node.stmts.get(s), names, references, declarations);
        s = s + 1;
    }
}

void consumeUnusedParameters(IRModule module) {
    int f = 0;
    while (f < module.functions.len) {
        IRFunction fn = module.functions.get(f);
        if (fn.body != null && fn.params.len > 0) {
            Map<string, bool> names = {};
            int p = 0;
            while (p < fn.params.len) {
                names.put(fn.params.get(p).name, true);
                p = p + 1;
            }

            Map<string, bool> references = {};
            Map<string, bool> declarations = {};
            collectParameterUses(
                fn.body, names, references, declarations);

            Map<string, bool> existingDiscards = {};
            int s = 0;
            while (s < fn.body.stmts.len) {
                IRNode statement = fn.body.stmts.get(s);
                if (statement.kind == IRK_EXPR_STMT
                        && statement.expr != null
                        && statement.expr.kind == IRK_VAR) {
                    existingDiscards.put(statement.expr.name, true);
                }
                s = s + 1;
            }

            Vector<IRNode> prefix = [];
            p = 0;
            while (p < fn.params.len) {
                string name = fn.params.get(p).name;
                bool unused = !references.has(name)
                    || declarations.has(name);
                if (unused && !existingDiscards.has(name)) {
                    prefix.push(irExprStmt(irVar(name)));
                }
                p = p + 1;
            }
            s = 0;
            while (s < fn.body.stmts.len) {
                prefix.push(fn.body.stmts.get(s));
                s = s + 1;
            }
            fn.body.stmts = prefix;
        }
        f = f + 1;
    }
}
