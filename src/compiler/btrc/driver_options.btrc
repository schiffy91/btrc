/* Command-line model for the production self-hosted compiler driver. */

class BtrccOptions {
    public bool valid;
    public bool includeStdlib;
    public bool strictImports;
    public bool runDce;
    public bool showHelp;
    public bool showStdlibDirectory;
    public int inputIndex;
    public string diagnostic;

    public BtrccOptions() {
        self.valid = true;
        self.includeStdlib = true;
        self.strictImports = true;
        self.runDce = true;
        self.showHelp = false;
        self.showStdlibDirectory = false;
        self.inputIndex = 1;
        self.diagnostic = "";
    }
}

class BtrccDriverOptions {
    class string usage() {
        return "usage: btrcc [--strict-imports | --relaxed-imports] "
            + "[--no-stdlib] [--no-dce] [--] <file.btrc>\n"
            + "       btrcc --stdlib-dir\n\n"
            + "Strict imports are the default; --strict-imports explicitly "
            + "asserts that mode.\n"
            + "--relaxed-imports enables legacy implicit cross-file visibility "
            + "and stdlib composition.\n"
            + "--no-stdlib disables relaxed stdlib composition; explicit "
            + "imports still resolve.";
    }

    class BtrccOptions invalid(BtrccOptions options, string diagnostic) {
        options.valid = false;
        options.diagnostic = diagnostic;
        return options;
    }

    class BtrccOptions parse(int argc, char** argv) {
        BtrccOptions options = new BtrccOptions();
        int index = 1;
        int importMode = 0;
        while (index < argc) {
            string option = Strings.copy(argv[index]);
            if (option.equals("--no-stdlib")) {
                options.includeStdlib = false;
            } else if (option.equals("--strict-imports")) {
                if (importMode < 0) {
                    return BtrccDriverOptions.invalid(
                        options,
                        "--strict-imports cannot be combined with --relaxed-imports");
                }
                importMode = 1;
                options.strictImports = true;
            } else if (option.equals("--relaxed-imports")) {
                if (importMode > 0) {
                    return BtrccDriverOptions.invalid(
                        options,
                        "--relaxed-imports cannot be combined with --strict-imports");
                }
                importMode = -1;
                options.strictImports = false;
            } else if (option.equals("--no-dce")) {
                options.runDce = false;
            } else if (option.equals("--stdlib-dir")) {
                options.showStdlibDirectory = true;
            } else if (option.equals("--help") || option.equals("-h")) {
                options.showHelp = true;
            } else if (option.equals("--")) {
                index++;
                break;
            } else if (option.startsWith("-")) {
                return BtrccDriverOptions.invalid(
                    options, f"unknown option: {option}");
            } else {
                break;
            }
            index++;
        }
        options.inputIndex = index;
        if (options.showHelp) { return options; }
        if (options.showStdlibDirectory) {
            if (index < argc) {
                return BtrccDriverOptions.invalid(
                    options, "--stdlib-dir does not accept an input file");
            }
            return options;
        }
        if (index >= argc) {
            return BtrccDriverOptions.invalid(options, "missing input file");
        }
        if (index + 1 < argc) {
            return BtrccDriverOptions.invalid(
                options, "only one input file may be compiled at a time");
        }
        return options;
    }
}
