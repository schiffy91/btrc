/* Storage receivers that back borrowed ordinary-call array projections. */

void ownershipCollectProjectionStorage(IRGen generator,
        Node? expression, Map<string, Node> varTypes,
        Vector<Node> roots, Vector<bool> owned, Vector<bool> kept) {
    ownershipCollectProjectionStorageWithPolicy(generator,
        expression, varTypes, roots, owned, kept, false);
}

void ownershipCollectProjectionStorageWithPolicy(IRGen generator,
        Node? expression, Map<string, Node> varTypes,
        Vector<Node> roots, Vector<bool> owned, Vector<bool> kept,
        bool omitBorrowedGuard) {
    if (expression == null || generator.owningTempOverrides.has(
            astNodeKey(expression))) { return; }
    IRRawProjectionContextBuilder builder =
        IRRawProjectionContextBuilder(generator, varTypes);
    RawProjectionCarrierContext context = builder.build(expression);
    RawProjectionCarrier? carrier = rawProjectionCarrier(
        expression, context);
    if (carrier == null || carrier.kind != "leaf") { return; }
    RawProjectionStorageRoot? storage = rawProjectionStorageRoot(
        carrier, context);
    if (storage == null) { return; }
    bool rootOwned = storage.managed && irUnconsumedOwnedResult(
        generator, storage.expression, varTypes);
    if (omitBorrowedGuard && !rootOwned) { return; }
    roots.push(storage.expression);
    owned.push(rootOwned);
    kept.push(storage.managed && !rootOwned);
}

bool ownershipCallHasProjectionRoots(IRGen generator, Node call,
        Node? receiver,
        Vector<OwnershipCallOperand> operands,
        Map<string, Node> varTypes) {
    Vector<Node> roots = [];
    Vector<bool> owned = [];
    Vector<bool> kept = [];
    ownershipCollectProjectionStorage(
        generator, receiver, varTypes, roots, owned, kept);
    if (roots.len > 0) { return true; }
    int index = 0;
    while (index < operands.len) {
        ownershipCollectProjectionStorageWithPolicy(generator,
            operands.get(index).expression, varTypes,
            roots, owned, kept,
            ownershipCallOmitsBorrowedProjectionGuard(
                generator, call, operands, index, varTypes));
        if (roots.len > 0) { return true; }
        index = index + 1;
    }
    return false;
}

void ownershipAddCallProjectionRoots(OwnershipBoundary boundary,
        IRGen generator, Node? expression,
        Map<string, Node> varTypes) {
    ownershipAddCallProjectionRootsWithPolicy(boundary,
        generator, expression, varTypes, false);
}

void ownershipAddCallProjectionRootsWithPolicy(OwnershipBoundary boundary,
        IRGen generator, Node? expression,
        Map<string, Node> varTypes, bool omitBorrowedGuard) {
    Vector<Node> roots = [];
    Vector<bool> owned = [];
    Vector<bool> kept = [];
    ownershipCollectProjectionStorageWithPolicy(
        generator, expression, varTypes, roots, owned, kept,
        omitBorrowedGuard);
    int index = 0;
    while (index < roots.len) {
        Node root = roots.get(index);
        Node? rootType = generator.resolvedExpressionType(
            root, varTypes);
        ownershipRequireType(rootType, root);
        boundary.addOperand(
            generator, root, rootType,
            owned.get(index), kept.get(index), varTypes);
        index = index + 1;
    }
}

bool ownershipCallOmitsBorrowedProjectionGuard(IRGen generator,
        Node call, Vector<OwnershipCallOperand> operands, int index,
        Map<string, Node> varTypes) {
    if (!generator.analyzed.hostedCallKeys.has(astNodeKey(call))
            || call.callee == null
            || call.callee.kind != NK_IDENTIFIER) { return false; }
    OwnershipCallOperand operand = operands.get(index);
    if (operand.parameterIndex < 0
            || !HostedAbi.parameterReadOnlyBorrow(
                call.callee.name, operand.parameterIndex)) {
        return false;
    }
    int laterIndex = index + 1;
    while (laterIndex < operands.len) {
        OwnershipCallOperand later = operands.get(laterIndex);
        if (later.defaultArgument || later.needsConversion
                || ownershipExpressionHasEffect(
                    generator, later.expression, varTypes)) {
            return false;
        }
        laterIndex = laterIndex + 1;
    }
    return true;
}
