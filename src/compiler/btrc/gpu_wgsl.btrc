/* WGSL kernel assembly. Expression and statement walks live in focused
 * sibling modules; this file owns only state, type/name contracts, and the
 * shader-level resource layout. */

class GpuScopeBinding {
    public string source;
    public string previous_name;
    public Node previous_type;
    public bool had_name;
    public bool had_type;

    public GpuScopeBinding(string source) {
        self.source = source;
        self.previous_name = "";
        self.previous_type = null;
        self.had_name = false;
        self.had_type = false;
    }
}

class GpuWgsl {
    public Analyzed analyzed;
    public IRGpuKernel kernel;
    public Vector<string> lines;
    public int indent;
    public int nextLocal;
    public int nextValue;
    public Map<string, string> names;
    public Map<string, Node> varTypes;
    public Map<string, bool> uniforms;
    public Map<string, bool> boolUniforms;
    public Map<string, string> arrayLengths;
    public Vector<GpuScopeBinding> bindings;
    public Vector<int> scopeStarts;
    public bool hasOutput;

    public GpuWgsl(Analyzed analyzed, IRGpuKernel kernel) {
        self.analyzed = analyzed;
        self.kernel = kernel;
        self.lines = [];
        self.indent = 1;
        self.nextLocal = 0;
        self.nextValue = 0;
        self.names = {};
        self.varTypes = {};
        self.uniforms = {};
        self.boolUniforms = {};
        self.arrayLengths = {};
        self.bindings = [];
        self.scopeStarts = [];
        self.hasOutput = kernel.output_buffer != null;
    }

    public void line(string value) {
        string prefix = "";
        int i = 0;
        while (i < self.indent) { prefix = prefix + "    "; i = i + 1; }
        self.lines.push(prefix + value);
    }

    public string freshValue() {
        string value = "btrc_e_" + Strings.fromInt(self.nextValue);
        self.nextValue = self.nextValue + 1;
        return value;
    }

    public string declareName(string source) {
        GpuScopeBinding binding = GpuScopeBinding(source);
        if (self.names.has(source)) {
            binding.had_name = true;
            binding.previous_name = self.names.get(source);
        }
        if (self.varTypes.has(source)) {
            binding.had_type = true;
            binding.previous_type = self.varTypes.get(source);
        }
        self.bindings.push(binding);
        string value = "btrc_v_" + Strings.fromInt(self.nextLocal);
        self.nextLocal = self.nextLocal + 1;
        self.names.put(source, value);
        return value;
    }

    public void pushScope() { self.scopeStarts.push(self.bindings.len); }

    public void popScope() {
        if (self.scopeStarts.len == 0) { return; }
        int start = self.scopeStarts.pop();
        while (self.bindings.len > start) {
            GpuScopeBinding binding = self.bindings.pop();
            if (binding.had_name) {
                self.names.put(binding.source, binding.previous_name);
            } else {
                self.names.remove(binding.source);
            }
            if (binding.had_type) {
                self.varTypes.put(binding.source, binding.previous_type);
            } else {
                self.varTypes.remove(binding.source);
            }
        }
    }

    public string lookupName(Node at, string source) {
        if (!self.names.has(source)) {
            gpuLoweringFail(at, "identifier '" + source
                + "' is not available in WGSL scope");
        }
        return self.names.get(source);
    }

    public Node? typeOf(Node expression) {
        return gpuContextualExprType(
            expression, self.analyzed, self.varTypes);
    }

    public string expr(Node expression) {
        return gpuWgslExpr(self, expression);
    }

    public void stmt(Node statement) {
        gpuWgslStmt(self, statement);
    }

    public string finish() {
        string result = "";
        int i = 0;
        while (i < self.lines.len) {
            if (i > 0) { result = result + "\n"; }
            result = result + self.lines.get(i);
            i = i + 1;
        }
        return result;
    }
}

void gpuLoweringFail(Node? at, string message) {
    int line = 0;
    int col = 0;
    if (at != null) { line = at.line; col = at.col; }
    fprintf(stderr, "error: @gpu lowering at %d:%d: %s\n", line, col, message);
    exit(1);
}

string gpuWgslScalarType(Node? type) {
    if (type == null) { return "i32"; }
    Node resolved = type;
    if (resolved.is_array || resolved.pointer_depth > 0
            || resolved.generic_args.len > 0 || resolved.is_nullable) {
        gpuLoweringFail(resolved, "type has no WGSL scalar representation");
    }
    if (resolved.base == "int") { return "i32"; }
    if (resolved.base == "float") { return "f32"; }
    if (resolved.base == "bool") { return "bool"; }
    gpuLoweringFail(resolved, "type '" + resolved.base
        + "' has no WGSL scalar representation");
    return "i32";
}

string gpuWgslElementType(Node? type) {
    if (type == null) {
        gpuLoweringFail(type, "GPU buffers require int or float elements");
    }
    Node resolved = type;
    if (resolved.base != "int" && resolved.base != "float") {
        gpuLoweringFail(resolved, "GPU buffers require int or float elements");
    }
    if (resolved.pointer_depth > 0 || resolved.generic_args.len > 0
            || resolved.is_nullable) {
        gpuLoweringFail(resolved, "GPU buffer type is not host-shareable");
    }
    if (resolved.base == "float") { return "f32"; }
    return "i32";
}

string generateGpuWgsl(Analyzed analyzed, IRGpuKernel kernel) {
    GpuWgsl out = GpuWgsl(analyzed, kernel);
    Node declaration = kernel.declaration;
    int sourceOrdinal = 0;
    int arrayOrdinal = 0;
    int binding = 0;
    int p = 0;
    while (p < declaration.params.len) {
        Node parameter = declaration.params.get(p);
        string shaderName = "btrc_p_" + Strings.fromInt(sourceOrdinal);
        out.names.put(parameter.name, shaderName);
        out.varTypes.put(parameter.name, parameter.type);
        if (parameter.type.is_array) {
            IRGpuBuffer buffer = IRGpuBuffer(parameter.name,
                gpuWgslElementType(parameter.type), binding);
            kernel.param_buffers.push(buffer);
            out.arrayLengths.put(parameter.name,
                "btrc_len_" + Strings.fromInt(arrayOrdinal));
            out.lines.push("@group(0) @binding(" + Strings.fromInt(binding)
                + ") var<storage, read_write> " + shaderName + ": array<"
                + buffer.elem_type + ">;");
            binding = binding + 1;
            arrayOrdinal = arrayOrdinal + 1;
        } else {
            string storageType = gpuWgslScalarType(parameter.type);
            if (storageType == "bool") {
                storageType = "u32";
                out.boolUniforms.put(parameter.name, true);
            }
            kernel.uniform_params.push(IRGpuUniform(parameter.name, storageType));
            out.uniforms.put(parameter.name, true);
        }
        sourceOrdinal = sourceOrdinal + 1;
        p = p + 1;
    }
    Node ret = declaration.return_type;
    if (ret != null && ret.base != "void") {
        if (!ret.is_array) {
            gpuLoweringFail(ret, "GPU return type must be void, int[], or float[]");
        }
        kernel.output_buffer = IRGpuBuffer("_output",
            gpuWgslElementType(ret), binding);
        out.lines.push("@group(0) @binding(" + Strings.fromInt(binding)
            + ") var<storage, read_write> _output: array<"
            + kernel.output_buffer.elem_type + ">;");
        binding = binding + 1;
        out.hasOutput = true;
    }
    out.lines.push("");
    out.lines.push("struct Uniforms {");
    int u = 0;
    while (u < kernel.uniform_params.len) {
        IRGpuUniform uniform = kernel.uniform_params.get(u);
        out.lines.push("    " + out.names.get(uniform.name) + ": "
            + uniform.storage_type + ",");
        u = u + 1;
    }
    int a = 0;
    while (a < kernel.param_buffers.len) {
        IRGpuBuffer buffer = kernel.param_buffers.get(a);
        out.lines.push("    " + out.arrayLengths.get(buffer.name) + ": i32,");
        a = a + 1;
    }
    out.lines.push("    btrc_off: i32,");
    out.lines.push("    btrc_n: i32,");
    out.lines.push("}");
    out.lines.push("@group(0) @binding(" + Strings.fromInt(binding)
        + ") var<uniform> uniforms: Uniforms;");
    binding = binding + 1;
    out.lines.push("struct BtrcStatus { code: atomic<u32>, }");
    out.lines.push("@group(0) @binding(" + Strings.fromInt(binding)
        + ") var<storage, read_write> btrc_status: BtrcStatus;");
    out.lines.push("");
    out.lines.push("@compute @workgroup_size(64)");
    out.lines.push("fn main(@builtin(global_invocation_id) gid: vec3<u32>) {");
    out.line("let btrc_gid: i32 = i32(gid.x) + uniforms.btrc_off;");
    out.line("if (btrc_gid >= uniforms.btrc_n) { return; }");
    if (declaration.body_node != null) {
        gpuEmitBlock(out, declaration.body_node);
    }
    out.lines.push("}");
    return out.finish();
}
