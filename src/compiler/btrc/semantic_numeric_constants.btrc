/* Numeric leaves and defined integral casts for constant-expression folding. */

class SemanticIntegralCastRange {
    public bool supported;
    public bool isUnsigned;
    public long long minimum;
    public unsigned long long maximum;

    public SemanticIntegralCastRange(bool supported, bool isUnsigned,
            long long minimum, unsigned long long maximum) {
        self.supported = supported;
        self.isUnsigned = isUnsigned;
        self.minimum = minimum;
        self.maximum = maximum;
    }
}

SemanticIntegralCastRange semanticUnsupportedCastRange() {
    return SemanticIntegralCastRange(false, false, 0LL, 0ULL);
}

SemanticIntegralCastRange semanticSignedCastRange(
        long long minimum, long long maximum) {
    return SemanticIntegralCastRange(
        true, false, minimum, (unsigned long long)maximum);
}

SemanticIntegralCastRange semanticUnsignedCastRange(
        unsigned long long maximum) {
    return SemanticIntegralCastRange(true, true, 0LL, maximum);
}

SemanticIntegralCastRange semanticBuiltinCastRange(
        string base, Analyzed analyzed) {
    if (base == "byte" || base == "signed char") {
        return semanticSignedCastRange(SCHAR_MIN, SCHAR_MAX);
    }
    if (base == "unsigned char") {
        return semanticUnsignedCastRange(UCHAR_MAX);
    }
    if (base == "short" || base == "short int"
            || base == "signed short" || base == "signed short int") {
        return semanticSignedCastRange(SHRT_MIN, SHRT_MAX);
    }
    if (base == "unsigned short" || base == "unsigned short int") {
        return semanticUnsignedCastRange(USHRT_MAX);
    }
    if (base == "int" || base == "signed" || base == "signed int"
            || analyzed.isEnum(base) || base.startsWith("enum ")) {
        return semanticSignedCastRange(INT_MIN, INT_MAX);
    }
    if (base == "uint" || base == "unsigned"
            || base == "unsigned int") {
        return semanticUnsignedCastRange(UINT_MAX);
    }
    if (base == "long" || base == "long int"
            || base == "signed long" || base == "signed long int") {
        return semanticSignedCastRange(LONG_MIN, LONG_MAX);
    }
    if (base == "unsigned long" || base == "unsigned long int") {
        return semanticUnsignedCastRange(ULONG_MAX);
    }
    if (base == "long long" || base == "long long int"
            || base == "signed long long"
            || base == "signed long long int") {
        return semanticSignedCastRange(LLONG_MIN, LLONG_MAX);
    }
    if (base == "unsigned long long"
            || base == "unsigned long long int") {
        return semanticUnsignedCastRange(ULLONG_MAX);
    }
    return semanticUnsupportedCastRange();
}

SemanticIntegralCastRange semanticFixedCastRange(string base) {
    if (base == "int8_t") { return semanticSignedCastRange(INT8_MIN, INT8_MAX); }
    if (base == "uint8_t") { return semanticUnsignedCastRange(UINT8_MAX); }
    if (base == "int16_t") { return semanticSignedCastRange(INT16_MIN, INT16_MAX); }
    if (base == "uint16_t") { return semanticUnsignedCastRange(UINT16_MAX); }
    if (base == "int32_t") { return semanticSignedCastRange(INT32_MIN, INT32_MAX); }
    if (base == "uint32_t") { return semanticUnsignedCastRange(UINT32_MAX); }
    if (base == "int64_t") { return semanticSignedCastRange(INT64_MIN, INT64_MAX); }
    if (base == "uint64_t") { return semanticUnsignedCastRange(UINT64_MAX); }
    if (base == "int_least8_t") {
        return semanticSignedCastRange(INT_LEAST8_MIN, INT_LEAST8_MAX);
    }
    if (base == "uint_least8_t") {
        return semanticUnsignedCastRange(UINT_LEAST8_MAX);
    }
    if (base == "int_least16_t") {
        return semanticSignedCastRange(INT_LEAST16_MIN, INT_LEAST16_MAX);
    }
    if (base == "uint_least16_t") {
        return semanticUnsignedCastRange(UINT_LEAST16_MAX);
    }
    if (base == "int_least32_t") {
        return semanticSignedCastRange(INT_LEAST32_MIN, INT_LEAST32_MAX);
    }
    if (base == "uint_least32_t") {
        return semanticUnsignedCastRange(UINT_LEAST32_MAX);
    }
    if (base == "int_least64_t") {
        return semanticSignedCastRange(INT_LEAST64_MIN, INT_LEAST64_MAX);
    }
    if (base == "uint_least64_t") {
        return semanticUnsignedCastRange(UINT_LEAST64_MAX);
    }
    return semanticUnsupportedCastRange();
}

SemanticIntegralCastRange semanticAbiCastRange(string base) {
    if (base == "int_fast8_t") {
        return semanticSignedCastRange(INT_FAST8_MIN, INT_FAST8_MAX);
    }
    if (base == "uint_fast8_t") {
        return semanticUnsignedCastRange(UINT_FAST8_MAX);
    }
    if (base == "int_fast16_t") {
        return semanticSignedCastRange(INT_FAST16_MIN, INT_FAST16_MAX);
    }
    if (base == "uint_fast16_t") {
        return semanticUnsignedCastRange(UINT_FAST16_MAX);
    }
    if (base == "int_fast32_t") {
        return semanticSignedCastRange(INT_FAST32_MIN, INT_FAST32_MAX);
    }
    if (base == "uint_fast32_t") {
        return semanticUnsignedCastRange(UINT_FAST32_MAX);
    }
    if (base == "int_fast64_t") {
        return semanticSignedCastRange(INT_FAST64_MIN, INT_FAST64_MAX);
    }
    if (base == "uint_fast64_t") {
        return semanticUnsignedCastRange(UINT_FAST64_MAX);
    }
    if (base == "intptr_t") {
        return semanticSignedCastRange(INTPTR_MIN, INTPTR_MAX);
    }
    if (base == "uintptr_t") {
        return semanticUnsignedCastRange(UINTPTR_MAX);
    }
    if (base == "intmax_t") {
        return semanticSignedCastRange(INTMAX_MIN, INTMAX_MAX);
    }
    if (base == "uintmax_t") {
        return semanticUnsignedCastRange(UINTMAX_MAX);
    }
    if (base == "ptrdiff_t") {
        return semanticSignedCastRange(PTRDIFF_MIN, PTRDIFF_MAX);
    }
    if (base == "size_t") { return semanticUnsignedCastRange(SIZE_MAX); }
    return semanticUnsupportedCastRange();
}

SemanticIntegralCastRange semanticIntegralCastRange(
        Node target, Analyzed analyzed) {
    SemanticIntegralCastRange range = semanticBuiltinCastRange(
        target.base, analyzed);
    if (range.supported) { return range; }
    range = semanticFixedCastRange(target.base);
    if (range.supported) { return range; }
    return semanticAbiCastRange(target.base);
}

SemanticIntegerConstant semanticIntegerLiteralConstant(Node expression) {
    IntegerLiteralInfo info = parseIntegerLiteralInfo(expression.raw);
    if (!info.valid) { return semanticInvalidConstant(); }
    if (info.magnitude > (unsigned long long)LLONG_MAX) {
        return semanticUnknownConstant();
    }
    return semanticKnownConstant((long long)info.magnitude);
}

SemanticIntegerConstant semanticConvertKnownIntegral(
        long long value, SemanticIntegralCastRange range) {
    if (!range.supported) { return semanticUnknownConstant(); }
    if (!range.isUnsigned) {
        if (value < range.minimum
                || (value >= 0
                    && (unsigned long long)value > range.maximum)) {
            return semanticInvalidConstant();
        }
        return semanticKnownConstant(value);
    }
    unsigned long long converted = (unsigned long long)value;
    if (range.maximum != ULLONG_MAX) {
        converted = converted % (range.maximum + 1ULL);
    }
    if (converted > (unsigned long long)LLONG_MAX) {
        return semanticUnknownConstant();
    }
    return semanticKnownConstant((long long)converted);
}

SemanticIntegerConstant semanticConvertFloatLiteral(
        string raw, SemanticIntegralCastRange range) {
    if (!range.supported) { return semanticUnknownConstant(); }
    long double value = truncl(strtold(floatLiteralBody(raw), NULL));
    long double lower = range.isUnsigned
        ? (long double)0.0 : (long double)range.minimum;
    long double upper = (long double)range.maximum + (long double)1.0;
    if (value < lower || value >= upper) {
        return semanticInvalidConstant();
    }
    if (range.isUnsigned) {
        unsigned long long converted = (unsigned long long)value;
        if (converted > (unsigned long long)LLONG_MAX) {
            return semanticUnknownConstant();
        }
        return semanticKnownConstant((long long)converted);
    }
    return semanticKnownConstant((long long)value);
}

SemanticIntegerConstant semanticIntegralCastConstant(
        Node expression, SemanticValidationState state,
        bool restrictEnum, string enumOwner,
        Map<string, bool> allowedMembers) {
    Node? resolved = semanticResolveAliases(expression.target_type, state);
    if (resolved == null
            || !semanticIntegralType(resolved, state.analyzed)) {
        return semanticInvalidConstant();
    }
    Node target = resolved;
    if (target.base == "bool") {
        if (expression.expr.kind == NK_FLOAT_LITERAL) {
            return semanticKnownConstant(
                floatLiteralDoubleValue(expression.expr.raw) != 0.0 ? 1 : 0);
        }
        SemanticIntegerConstant operand = semanticIntegerConstant(
            expression.expr, state, restrictEnum, enumOwner, allowedMembers);
        if (!operand.valid || !operand.known) { return operand; }
        return semanticKnownConstant(operand.value != 0 ? 1 : 0);
    }
    SemanticIntegralCastRange range = semanticIntegralCastRange(
        target, state.analyzed);
    if (expression.expr.kind == NK_FLOAT_LITERAL) {
        return semanticConvertFloatLiteral(expression.expr.raw, range);
    }
    SemanticIntegerConstant operand = semanticIntegerConstant(
        expression.expr, state, restrictEnum, enumOwner, allowedMembers);
    if (!operand.valid || !operand.known) { return operand; }
    return semanticConvertKnownIntegral(operand.value, range);
}
