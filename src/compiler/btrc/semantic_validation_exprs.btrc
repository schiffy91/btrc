/* Expression-domain validation.  Unknown C interop values remain unresolved;
 * once both operand types are known, invalid operations fail before IR gen. */

bool semanticRawPointer(Node? typeExpr, Analyzed analyzed) {
    return typeExpr != null
        && (typeExpr.pointer_depth > 0 || typeExpr.is_array)
        && !analyzed.isClass(typeExpr.base)
        && !analyzed.isGenericClass(typeExpr.base);
}

bool semanticHasBinaryOverload(
        Node leftType, string op, SemanticValidationState state) {
    string magic = state.operators.binaryMethodName(op);
    if (magic == "") { return false; }
    Node? method = null;
    if (state.analyzed.isClass(leftType.base)) {
        method = state.analyzed.classMethod(leftType.base, magic);
    } else if (state.analyzed.isGenericClass(leftType.base)) {
        method = state.analyzed.genericClassMethod(leftType.base, magic);
    }
    return method != null && method.kind == NK_METHOD_DECL;
}

bool semanticHasUnaryOverload(
        Node operandType, string op, SemanticValidationState state) {
    if (op != "-") { return false; }
    Node? method = null;
    if (state.analyzed.isClass(operandType.base)) {
        method = state.analyzed.classMethod(operandType.base, "__neg__");
    } else if (state.analyzed.isGenericClass(operandType.base)) {
        method = state.analyzed.genericClassMethod(
            operandType.base, "__neg__");
    }
    return method != null && method.kind == NK_METHOD_DECL;
}

void semanticOperatorFailure(Node expression, Node left, Node right) {
    semanticValidationFail("operator '" + expression.op
        + "' is not defined for '" + semanticFormatType(left)
        + "' and '" + semanticFormatType(right) + "'", expression);
}

void semanticValidatePortableNumericMix(
        Node site, Node left, Node right, string context,
        SemanticValidationState state) {
    if (NumericSemantics.isType(left, state.analyzed)
            && NumericSemantics.isType(right, state.analyzed)
            && !NumericSemantics.integerMixIsPortable(left, right)) {
        semanticValidationFail(context + " mixes ABI-dependent integer type '"
            + semanticFormatType(left) + "' with '"
            + semanticFormatType(right)
            + "'; cast explicitly to a fixed-width or built-in integer type",
            site);
    }
}

void semanticValidateBinary(Node expression, SemanticValidationState state,
        Map<string, Node> vars) {
    semanticRejectThreadObservation(expression.left, state, vars);
    semanticRejectThreadObservation(expression.right, state, vars);
    Node? left = semanticInferType(expression.left, state, vars);
    Node? right = semanticInferType(expression.right, state, vars);
    if (left == null || right == null
            || semanticTypeContainsParams(left, state.typeParams)
            || semanticTypeContainsParams(right, state.typeParams)) {
        return;
    }
    if (semanticHasBinaryOverload(left, expression.op, state)) { return; }
    semanticValidatePortableNumericMix(
        expression, left, right, "Operator '" + expression.op + "'", state);
    string op = expression.op;
    bool valid = false;
    if (op == "??") {
        bool optionalScalar = state.operators.isOptionalValueCoalesce(
            expression.left, left, right);
        valid = optionalScalar
            || (state.operators.isReferenceType(left)
                && (semanticAssignmentCompatible(left, right, state)
                    || semanticAssignmentCompatible(right, left, state)));
    } else if (op == "&&" || op == "||") {
        valid = semanticScalarConditionType(left, state)
            && semanticScalarConditionType(right, state);
    } else if (op == "&" || op == "|" || op == "^"
            || op == "<<" || op == ">>") {
        valid = semanticIntegralType(left, state.analyzed)
            && semanticIntegralType(right, state.analyzed);
    } else if (op == "+" || op == "-") {
        valid = (NumericSemantics.isType(left, state.analyzed)
                && NumericSemantics.isType(right, state.analyzed))
            || (op == "+" && TypeComposition.isSemanticScalarString(left)
                && TypeComposition.isSemanticScalarString(right))
            || (semanticRawPointer(left, state.analyzed)
                && semanticIntegralType(right, state.analyzed))
            || (op == "+" && semanticIntegralType(left, state.analyzed)
                && semanticRawPointer(right, state.analyzed))
            || (op == "-" && semanticRawPointer(left, state.analyzed)
                && semanticRawPointer(right, state.analyzed)
                && state.operators.referenceTypesCompatible(left, right));
    } else if (op == "*" || op == "/" || op == "%") {
        valid = NumericSemantics.isType(left, state.analyzed)
            && NumericSemantics.isType(right, state.analyzed)
            && left.base != "bool" && right.base != "bool";
    } else if (state.operators.isComparisonOperator(op)) {
        valid = state.operators.comparisonDomain(
            op, left, right) != OP_DOMAIN_INVALID;
    } else {
        return;
    }
    if (!valid) { semanticOperatorFailure(expression, left, right); }
}

void semanticValidateUnary(Node expression, SemanticValidationState state,
        Map<string, Node> vars) {
    if (expression.op == "&") {
        bool addressable = semanticIsLifetimeStableStorage(
                expression.operand, state, vars)
            || (expression.operand.kind == NK_IDENTIFIER
                && (state.analyzed.funcNames.has(expression.operand.name)
                    || SourceRuntimeSymbols.helper(
                        expression.operand.name)));
        if (!addressable) {
            Node? invalidType = semanticInferType(
                expression.operand, state, vars);
            string spelling = invalidType == null
                ? "unknown" : semanticFormatType(invalidType);
            semanticValidationFail("Unary operator '&' is not defined for '"
                + spelling + "'", expression);
        }
        return;
    }
    Node? operand = semanticInferType(expression.operand, state, vars);
    if (operand == null
            || semanticTypeContainsParams(operand, state.typeParams)) {
        return;
    }
    if (semanticHasUnaryOverload(operand, expression.op, state)) {
        return;
    }
    bool valid = true;
    if (expression.op == "*") {
        valid = operand.pointer_depth > 0 || operand.is_array;
    } else if (expression.op == "++" || expression.op == "--") {
        valid = semanticIsLvalue(expression.operand, state, vars)
            && ((NumericSemantics.isType(operand, state.analyzed)
                    && operand.base != "bool")
                || operand.pointer_depth > 0);
        if (valid) {
            semanticValidatePropertyMutation(expression.operand,
                true, false, state, vars, expression);
            semanticValidateIndexedMutation(expression.operand,
                true, state, vars, expression);
            semanticValidateMutableTarget(operand, state, expression, false);
            semanticValidateTargetReceiverMutability(
                expression.operand, state, vars, expression);
        }
    } else if (expression.op == "+" || expression.op == "-") {
        valid = NumericSemantics.isType(operand, state.analyzed)
            && operand.base != "bool";
    } else if (expression.op == "~") {
        valid = semanticIntegralType(operand, state.analyzed);
    } else if (expression.op == "!") {
        valid = semanticScalarConditionType(operand, state);
    }
    if (!valid) {
        semanticValidationFail("Unary operator '" + expression.op
            + "' is not defined for '" + semanticFormatType(operand) + "'",
            expression);
    }
}

void semanticValidateExpr(Node? expression, SemanticValidationState state,
        Map<string, Node> vars) {
    if (expression == null) { return; }
    semanticValidateGpuArrayResultContext(expression, state, vars);
    if (expression.kind == NK_BINARY_EXPR) {
        semanticValidateExpr(expression.left, state, vars);
        semanticValidateExpr(expression.right, state, vars);
        semanticValidateBinary(expression, state, vars);
    } else if (expression.kind == NK_UNARY_EXPR) {
        semanticValidateExpr(expression.operand, state, vars);
        semanticValidateUnary(expression, state, vars);
    } else if (expression.kind == NK_ASSIGN_EXPR) {
        if (expression.target != null
                && expression.target.kind == NK_INDEX_EXPR) {
            semanticValidateExpr(expression.target.obj, state, vars);
            semanticValidateExpr(expression.target.index, state, vars);
            semanticValidateIndex(expression.target, state, vars,
                expression.op != "=");
        } else if (expression.target != null
                && expression.target.kind == NK_FIELD_ACCESS_EXPR) {
            semanticValidateExpr(expression.target.obj, state, vars);
            semanticValidateField(
                expression.target, expression.op != "=", state, vars);
        } else {
            semanticValidateExpr(expression.target, state, vars);
        }
        if (expression.op == "=") {
            contextualizeGenericConstructor(
                semanticInferType(expression.target, state, vars),
                expression.value_node, state, vars);
        }
        semanticValidateExpr(expression.value_node, state, vars);
        semanticValidateAssignment(expression, state, vars);
    } else if (expression.kind == NK_CALL_EXPR) {
        contextualizeCallGenericConstructors(expression, state, vars);
        /* An unresolved direct identifier call is the deliberate C-interop
         * seam.  Validate all other callees as ordinary value expressions. */
        if (expression.callee != null
                && expression.callee.kind == NK_FIELD_ACCESS_EXPR) {
            semanticValidateExpr(expression.callee.obj, state, vars);
        } else if (expression.callee == null
                || expression.callee.kind != NK_IDENTIFIER) {
            semanticValidateExpr(expression.callee, state, vars);
        }
        int index = 0;
        while (index < expression.args.len) {
            semanticValidateExpr(expression.args.get(index), state, vars);
            index = index + 1;
        }
        semanticValidateGeneratedSymbolCall(expression, state, vars);
        semanticValidateCall(expression, state, vars);
    } else if (expression.kind == NK_INDEX_EXPR) {
        semanticValidateExpr(expression.obj, state, vars);
        semanticValidateExpr(expression.index, state, vars);
        semanticValidateIndex(expression, state, vars, true);
    } else if (expression.kind == NK_FIELD_ACCESS_EXPR) {
        semanticValidateExpr(expression.obj, state, vars);
        semanticValidateField(expression, true, state, vars);
    } else if (expression.kind == NK_TERNARY_EXPR) {
        semanticValidateExpr(expression.condition, state, vars);
        semanticValidateCondition(
            expression.condition, "Ternary expression", state, vars);
        semanticValidateExpr(expression.true_expr, state, vars);
        semanticValidateExpr(expression.false_expr, state, vars);
        Node? first = semanticInferType(expression.true_expr, state, vars);
        Node? second = semanticInferType(expression.false_expr, state, vars);
        if (first != null && second != null) {
            semanticValidatePortableNumericMix(
                expression, first, second, "Ternary expression", state);
        }
        if (first != null && second != null
                && !semanticAssignmentCompatible(first, second, state)
                && !semanticAssignmentCompatible(second, first, state)) {
            semanticValidationFail("Ternary branches have incompatible types '"
                + semanticFormatType(first) + "' and '"
                + semanticFormatType(second) + "'", expression);
        }
    } else {
        semanticValidateExprChildren(expression, state, vars);
    }
}
