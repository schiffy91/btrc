/* Exception guards for heap objects whose constructor is still running.
 *
 * The cleanup stack stores the address of `self`, so a longjmp through init
 * releases the partially initialized object through its concrete destructor.
 * memset makes untouched managed fields null; initialized fields are therefore
 * reclaimed by the same destructor used after a successful construction. */

string beginConstructorCleanup(IRGen generator, string selfName,
        Vector<IRNode> output) {
    if (!generator.programHasExceptions) { return ""; }

    generator.useHelper("__btrc_cleanup_mark");
    string marker = generator.freshTemp(
        "__btrc_constructor_cleanup");
    Vector<IRNode> markArguments = [];
    output.push(irVarDecl("int", marker,
        irCall("__btrc_cleanup_mark", markArguments)));

    IRNode declaration = requireCleanupSlotDeclaration(
        output, selfName);
    generator.useHelper("__btrc_arc_abandon");
    output.push(irExprStmt(registerCleanupSlot(generator, declaration,
        irFunctionRef("__btrc_arc_abandon"),
        irLiteral("NULL"), true)));
    return marker;
}

void endConstructorCleanup(IRGen generator, string marker,
        Vector<IRNode> output) {
    if (marker == "") { return; }
    generator.useHelper("__btrc_discard_cleanups_to");
    Vector<IRNode> arguments = [];
    arguments.push(irVar(marker));
    output.push(irExprStmt(irCall(
        "__btrc_discard_cleanups_to", arguments)));
}
