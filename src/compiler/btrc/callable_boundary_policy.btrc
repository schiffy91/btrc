/* Fail-closed ABI policy for callbacks whose managed return tag is not stored
 * in a bare C function pointer. One context describes the active lowering
 * environment; the policy itself retains only immutable semantic tables. */

class CallableBoundaryContext {
    private Map<string, Node> variableTypes;
    private Map<string, Node> typeParameters;
    private bool resolvesTypeParameters;
    private Map<string, bool> ownedCallables;
    private Map<string, bool> ambiguousCallables;
    private Vector<string> lexicalCallableDeclarations;

    public CallableBoundaryContext(
            Map<string, Node> variableTypes,
            Map<string, Node> typeParameters,
            bool resolvesTypeParameters,
            Map<string, bool> ownedCallables,
            Map<string, bool> ambiguousCallables,
            Vector<string> lexicalCallableDeclarations) {
        self.variableTypes = variableTypes;
        self.typeParameters = typeParameters;
        self.resolvesTypeParameters = resolvesTypeParameters;
        self.ownedCallables = ownedCallables;
        self.ambiguousCallables = ambiguousCallables;
        self.lexicalCallableDeclarations = lexicalCallableDeclarations;
    }

    public Node resolveType(Node? typeExpr, Analyzed analysis) {
        if (self.resolvesTypeParameters) {
            return resolveGenericType(
                typeExpr, self.typeParameters, analysis);
        }
        if (typeExpr == null) { return makePrimType("void"); }
        return typeExpr;
    }

    public bool hasVariable(string name) {
        return self.variableTypes.has(name);
    }

    public Node variableType(string name) {
        return self.variableTypes.get(name);
    }

    public int abiFor(string name) {
        if (self.ambiguousCallables.has(name)
                && self.ambiguousCallables.get(name)) {
            return 2;
        }
        if (self.ownedCallables.has(name)
                && self.ownedCallables.get(name)) {
            return 1;
        }
        return 0;
    }

    public bool declaresCallable(string name) {
        int index = 0;
        while (index < self.lexicalCallableDeclarations.len) {
            if (self.lexicalCallableDeclarations.get(index) == name) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }
}

class CallableBoundaryPolicy {
    private Analyzed analysis;

    public CallableBoundaryPolicy(Analyzed analysis) {
        self.analysis = analysis;
    }

    private Node bodyType(
            Node? typeExpr, CallableBoundaryContext context) {
        return context.resolveType(typeExpr, self.analysis);
    }

    private Node? canonicalType(
            Node? typeExpr, CallableBoundaryContext context) {
        if (typeExpr == null) { return null; }
        Node concrete = self.bodyType(typeExpr, context);
        Node? canonical = resolveTypedefType(
            concrete, self.analysis.typedefTable);
        if (canonical != null) { return canonical; }
        return concrete;
    }

    private bool managedValueType(
            Node? typeExpr, CallableBoundaryContext context) {
        if (typeExpr == null) { return false; }
        Node resolved = self.bodyType(typeExpr, context);
        Node? outer = resolveOuterTypedefType(
            resolved, self.analysis.typedefTable);
        if (outer == null) { return false; }
        resolved = outer;
        if (isStringType(resolved)) { return true; }

        int classDepth = resolved.pointer_depth;
        if (TypeComposition.nullableCollapsesReferenceLayer(
                resolved, false)) {
            classDepth = classDepth - 1;
        }
        bool classValue = !resolved.is_array && classDepth <= 1
            && (self.analysis.isClass(resolved.base)
                || (resolved.generic_args.len > 0
                    && self.analysis.isGenericClass(resolved.base)));
        if (classValue) { return true; }

        int mutexDepth = resolved.pointer_depth;
        if (TypeComposition.nullableCollapsesReferenceLayer(
                resolved, true)) {
            mutexDepth = mutexDepth - 1;
        }
        return !resolved.is_array && mutexDepth == 0
            && resolved.base == "Mutex"
            && resolved.generic_args.len == 1;
    }

    private bool managedCallbackType(
            Node? typeExpr, CallableBoundaryContext context) {
        Node? canonicalType = self.canonicalType(typeExpr, context);
        if (canonicalType == null) { return false; }
        Node canonical = canonicalType;
        return canonical.base == "__fn_ptr"
            && canonical.pointer_depth == 0
            && !canonical.is_array
            && canonical.generic_args.len > 0
            && self.managedValueType(
                canonical.generic_args.get(0), context);
    }

    private Node arrayElement(Node arrayType) {
        Node element = typeWithoutOuterArray(arrayType);
        element.is_static = false;
        element.is_extern = false;
        return element;
    }

    private Node? structDeclaration(Node typeExpr) {
        if (typeExpr.pointer_depth > 0) { return null; }
        string name = semanticStructTypeName(typeExpr, self.analysis);
        if (name == "" || !self.analysis.structTable.has(name)) {
            return null;
        }
        Node declaration = self.analysis.structTable.get(name);
        if (declaration.is_forward) { return null; }
        return declaration;
    }

    private bool validatedReferenceOwner(Node typeExpr) {
        return typeExpr.pointer_depth > 0
            || self.analysis.isClass(typeExpr.base)
            || self.analysis.isGenericClass(typeExpr.base);
    }

    private bool typeContainsManagedSeen(
            Node? typeExpr, CallableBoundaryContext context,
            Map<string, bool> active) {
        Node? canonicalType = self.canonicalType(typeExpr, context);
        if (canonicalType == null) { return false; }
        Node canonical = canonicalType;
        if (self.managedCallbackType(canonical, context)) { return true; }
        if (self.validatedReferenceOwner(canonical)) { return false; }
        string key = TypeIdentity.shapeKey(canonical);
        if (active.has(key)) { return false; }
        active.put(key, true);
        bool contains = false;
        if (canonical.is_array) {
            contains = self.typeContainsManagedSeen(
                self.arrayElement(canonical), context, active);
        } else if (canonical.pointer_depth == 0
                && (canonical.base == "Array" || canonical.base == "List"
                    || canonical.base == "Set" || canonical.base == "Vector")
                && canonical.generic_args.len == 1) {
            contains = self.typeContainsManagedSeen(
                canonical.generic_args.get(0), context, active);
        } else if (canonical.pointer_depth == 0
                && (canonical.base == "Map" || canonical.base == "Tuple")) {
            int index = 0;
            while (!contains && index < canonical.generic_args.len) {
                contains = self.typeContainsManagedSeen(
                    canonical.generic_args.get(index), context, active);
                index = index + 1;
            }
        } else {
            Node? declaration = self.structDeclaration(canonical);
            if (declaration != null) {
                int index = 0;
                while (!contains && index < declaration.fields.len) {
                    contains = self.typeContainsManagedSeen(
                        declaration.fields.get(index).type,
                        context, active);
                    index = index + 1;
                }
            }
        }
        active.remove(key);
        return contains;
    }

    private bool typeContainsManaged(
            Node? typeExpr, CallableBoundaryContext context) {
        Map<string, bool> active = {};
        return self.typeContainsManagedSeen(typeExpr, context, active);
    }

    public int expressionAbi(
            Node? expression, CallableBoundaryContext context) {
        if (expression == null) { return 0; }
        if (expression.kind == NK_LAMBDA_EXPR) { return 1; }
        if (expression.kind == NK_IDENTIFIER) {
            int lexicalAbi = context.abiFor(expression.name);
            if (lexicalAbi != 0) { return lexicalAbi; }
            if (context.hasVariable(expression.name)) {
                Node? lexicalType = resolveTypedefType(
                    context.variableType(expression.name),
                    self.analysis.typedefTable);
                if (lexicalType != null
                        && lexicalType.base == "__fn_ptr") {
                    return 0;
                }
            }
            if (!self.analysis.funcTable.has(expression.name)) {
                return 0;
            }
            Node declaration = self.analysis.funcTable.get(expression.name);
            return declaration.body_node != null ? 1 : 0;
        }
        if (expression.kind == NK_FIELD_ACCESS_EXPR
                && expression.obj != null
                && expression.obj.kind == NK_IDENTIFIER
                && !context.hasVariable(expression.obj.name)
                && self.analysis.isClass(expression.obj.name)) {
            Node? method = self.analysis.classMethod(
                expression.obj.name, expression.field);
            if (method != null
                    && method.kind == NK_METHOD_DECL
                    && method.access == "class"
                    && method.body_node != null) {
                return 1;
            }
        }
        if (expression.kind == NK_CAST_EXPR) {
            return self.expressionAbi(expression.expr, context);
        }
        if (expression.kind == NK_UNARY_EXPR && expression.op == "&") {
            return self.expressionAbi(expression.operand, context);
        }
        if (expression.kind == NK_TERNARY_EXPR) {
            int trueAbi = self.expressionAbi(
                expression.true_expr, context);
            int falseAbi = self.expressionAbi(
                expression.false_expr, context);
            if (trueAbi == falseAbi) { return trueAbi; }
            return 2;
        }
        return 0;
    }

    public bool lexicalIdentifier(
            string name, CallableBoundaryContext context) {
        return context.declaresCallable(name)
            || !self.analysis.globalVarTypes.has(name);
    }

    private bool unsafeValue(
            Node? expectedType, Node? value,
            CallableBoundaryContext context) {
        if (expectedType == null || value == null) { return false; }
        Node? canonicalType = self.canonicalType(expectedType, context);
        if (canonicalType == null) { return false; }
        Node canonical = canonicalType;
        if (self.managedCallbackType(canonical, context)) {
            return self.expressionAbi(value, context) != 0;
        }
        if (value.kind == NK_LIST_LITERAL
                || value.kind == NK_BRACE_INITIALIZER) {
            Node? elementType = null;
            if (canonical.is_array) {
                elementType = self.arrayElement(canonical);
            } else if ((canonical.base == "Array"
                    || canonical.base == "List" || canonical.base == "Set"
                    || canonical.base == "Vector")
                    && canonical.generic_args.len == 1) {
                elementType = canonical.generic_args.get(0);
            }
            if (elementType != null) {
                int index = 0;
                while (index < value.elements.len) {
                    if (self.unsafeValue(elementType,
                            value.elements.get(index), context)) {
                        return true;
                    }
                    index = index + 1;
                }
                return false;
            }
            if (canonical.base == "Tuple") {
                int index = 0;
                while (index < value.elements.len
                        && index < canonical.generic_args.len) {
                    if (self.unsafeValue(
                            canonical.generic_args.get(index),
                            value.elements.get(index), context)) {
                        return true;
                    }
                    index = index + 1;
                }
                return false;
            }
            Node? declaration = self.structDeclaration(canonical);
            if (declaration != null) {
                int index = 0;
                while (index < value.elements.len
                        && index < declaration.fields.len) {
                    if (self.unsafeValue(
                            declaration.fields.get(index).type,
                            value.elements.get(index), context)) {
                        return true;
                    }
                    index = index + 1;
                }
                return false;
            }
        }
        if (value.kind == NK_TUPLE_LITERAL && canonical.base == "Tuple") {
            int index = 0;
            while (index < value.elements.len
                    && index < canonical.generic_args.len) {
                if (self.unsafeValue(
                        canonical.generic_args.get(index),
                        value.elements.get(index), context)) {
                    return true;
                }
                index = index + 1;
            }
            return false;
        }
        if (value.kind == NK_MAP_LITERAL && canonical.base == "Map"
                && canonical.generic_args.len == 2) {
            int index = 0;
            while (index < value.entries.len) {
                Node entry = value.entries.get(index);
                if (self.unsafeValue(canonical.generic_args.get(0),
                        entry.key, context)
                        || self.unsafeValue(canonical.generic_args.get(1),
                            entry.value_node, context)) {
                    return true;
                }
                index = index + 1;
            }
            return false;
        }
        if (self.validatedReferenceOwner(canonical)) { return false; }
        /* Aggregate values carry no ABI tag for their callback leaves. */
        return self.typeContainsManaged(canonical, context);
    }

    public void rejectPersistentStorage(
            Node? expectedType, Node? value,
            CallableBoundaryContext context, string boundary) {
        if (!self.unsafeValue(expectedType, value, context)) { return; }
        print("Managed-return callback cannot cross " + boundary
            + "; bare __fn_ptr storage erases its return ABI");
        abortGen();
    }

    public void rejectAggregateInitializer(
            Node? expectedType, Node? value,
            CallableBoundaryContext context) {
        if (self.managedCallbackType(expectedType, context)) { return; }
        self.rejectPersistentStorage(
            expectedType, value, context, "aggregate storage");
    }

    public void rejectAssignment(
            Node assignment, Node? targetType,
            CallableBoundaryContext context) {
        if (assignment.op != "=" || assignment.target == null) { return; }
        Node target = assignment.target;
        bool localIdentifier = target.kind == NK_IDENTIFIER
            && self.lexicalIdentifier(target.name, context);
        if (localIdentifier
                && self.managedCallbackType(targetType, context)) {
            return;
        }
        string boundary = "persistent storage";
        if (target.kind == NK_IDENTIFIER) {
            boundary = localIdentifier
                ? "aggregate storage" : "global storage";
        } else if (target.kind == NK_FIELD_ACCESS_EXPR) {
            boundary = "field storage";
        } else if (target.kind == NK_INDEX_EXPR) {
            boundary = "indexed storage";
        }
        self.rejectPersistentStorage(
            targetType, assignment.value_node, context, boundary);
    }

    public Vector<Node> functionPointerParameters(Node signature) {
        Vector<Node> parameters = [];
        int index = 1;
        while (index < signature.generic_args.len) {
            Node parameter = Node();
            parameter.kind = NK_PARAM;
            parameter.name = Strings.fromInt(index - 1);
            parameter.type = signature.generic_args.get(index);
            parameters.push(parameter);
            index = index + 1;
        }
        return parameters;
    }

    private void rejectUnsafeArgument(
            Node parameter, Node argument,
            CallableBoundaryContext context) {
        if (!self.unsafeValue(parameter.type, argument, context)) { return; }
        print("Managed-return callback for parameter '" + parameter.name
            + "' erases its source-owned return ABI; bare __fn_ptr parameters "
            + "accept only borrowed C callbacks");
        abortGen();
    }

    public void rejectUnsafeArguments(
            Node call, Vector<Node> parameters,
            CallableBoundaryContext context) {
        if (parameters.len == 0) { return; }
        Map<string, int> parameterIndices = {};
        Vector<int> bound = [];
        int index = 0;
        while (index < parameters.len) {
            parameterIndices.put(parameters.get(index).name, index);
            bound.push(0);
            index = index + 1;
        }
        int positional = 0;
        index = 0;
        while (index < call.args.len) {
            int parameterIndex = positional;
            string argumentName = "";
            if (index < call.arg_names.len) {
                argumentName = call.arg_names.get(index);
            }
            if (argumentName != "") {
                parameterIndex = -1;
                if (parameterIndices.has(argumentName)) {
                    parameterIndex = parameterIndices.get(argumentName);
                }
            } else {
                positional = positional + 1;
            }
            if (parameterIndex >= 0 && parameterIndex < parameters.len) {
                bound.set(parameterIndex, 1);
                self.rejectUnsafeArgument(
                    parameters.get(parameterIndex),
                    call.args.get(index), context);
            }
            index = index + 1;
        }
        index = 0;
        while (index < parameters.len) {
            Node parameter = parameters.get(index);
            if (bound.get(index) == 0 && parameter.default_ != null) {
                self.rejectUnsafeArgument(
                    parameter, parameter.default_, context);
            }
            index = index + 1;
        }
    }
}
