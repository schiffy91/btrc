import ./lexer/stage.btrc;

#include "frontend_source_io.btrc"
#include "driver_output.btrc"
int main(int argc, char** argv) {
  BtrccOutput output = BtrccOutput(stdout);
  FeSourceResolutionPolicy resolutionPolicy = FeSourceResolutionPolicy();
  FeSourceFileReader sourceFiles = FeSourceFileReader(resolutionPolicy);
  if (argc < 2) { print("usage: lex <file.btrc>"); return 1; }
  string grammarText = sourceFiles.readRequired("src/language/grammar.ebnf");
  GrammarInfo g = parseGrammar(grammarText);
  string src = sourceFiles.readRequired(Strings.copy(argv[1]));
  Lexer lx = Lexer(src, g);
  Vector<Token> toks = lx.tokenize();
  if (lx.failed) {
    fprintf(stderr, "error: %s\n", lx.diagnostic);
    return 1;
  }
  int i = 0;
  while (i < toks.len) {
    if (!output.writeChunk(toks.get(i).repr(), true)) {
      fprintf(stderr, "lex: error: cannot write standard output\n");
      return 1;
    }
    i = i + 1;
  }
  if (output.flush()) { return 0; }
  fprintf(stderr, "lex: error: cannot write standard output\n");
  return 1;
}
