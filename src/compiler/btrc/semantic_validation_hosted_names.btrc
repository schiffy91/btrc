/* Hosted macro and ordinary-identifier namespace contracts. */

bool semanticPublicNativeBinding(string name) {
    return name == "btrc_gpu_available"
        || name == "btrc_gui_surface_width"
        || name == "btrc_tray_show";
}

bool semanticTrustedNativeBinding(string name, Node site) {
    return semanticPublicNativeBinding(name)
        || hostedAbiCompilerStdlibNode(site);
}

bool semanticHostedGeneratedNameSite(Node site) {
    return (site.kind == NK_FUNCTION_DECL && site.body_node != null)
        || site.kind == NK_METHOD_DECL
        || site.kind == NK_METHOD_SIG
        || site.kind == NK_PROPERTY_DECL
        || site.kind == NK_RICH_ENUM_VARIANT;
}

void semanticValidateHostedDeclaredName(
        string name, string subject, Node site, bool cNameGenerated) {
    if (name != "" && hostedAbiOwnedName(name)
            && hostedAbiMacroName(name)
            && !cNameGenerated
            && !semanticHostedGeneratedNameSite(site)
            && !semanticHostedTrustedEnviron(site)) {
        semanticValidationFail(subject + " name '" + name
            + "' collides with an automatically included C macro", site);
    }
}

bool semanticHostedTrustedEnviron(Node declaration) {
    if (!hostedAbiCompilerStdlibNode(declaration)
            || declaration.kind != NK_VAR_DECL_STMT
            || declaration.name != "environ"
            || declaration.initializer != null
            || declaration.type == null) {
        return false;
    }
    Node typeNode = declaration.type;
    return typeNode.base == "char" && typeNode.pointer_depth == 2
        && typeNode.is_extern && !typeNode.is_array
        && typeNode.generic_args.len == 0;
}

bool semanticHostedTrustedWinsize(Node declaration) {
    return hostedAbiCompilerStdlibNode(declaration)
        && declaration.kind == NK_STRUCT_DECL
        && declaration.name == "winsize"
        && declaration.is_forward;
}

void semanticValidateHostedTopLevelName(Node declaration) {
    if (!semanticNamedTopLevel(declaration)) { return; }
    string name = semanticTopLevelName(declaration);
    if (!hostedAbiOwnedName(name)
            || declaration.kind == NK_FUNCTION_DECL
            || semanticHostedTrustedEnviron(declaration)
            || semanticHostedTrustedWinsize(declaration)) {
        return;
    }
    semanticValidationFail("Top-level declaration name '" + name
        + "' collides with a compiler-owned hosted C symbol", declaration);
}
