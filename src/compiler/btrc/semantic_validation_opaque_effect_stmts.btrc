/* Statement composition and public borrow-only effect query. */

bool semanticRawParamBlockSafe(Node? block, string parameterName,
        string owner, Map<string, bool> locals,
        Map<string, Node> vars, SemanticValidationState state);

bool semanticRawParamStmtSafe(Node statement, string parameterName,
        string owner, Map<string, bool> locals,
        Map<string, Node> vars, SemanticValidationState state) {
    if (statement.kind == NK_VAR_DECL_STMT) {
        if (semanticRawExpressionCarriesParam(
                statement.initializer, parameterName,
                state, vars)) { return false; }
        return semanticRawParamExprSafe(statement.initializer,
            parameterName, owner, locals, vars, state);
    }
    if (statement.kind == NK_RETURN_STMT) {
        if (semanticRawExpressionCarriesParam(
                statement.value_node, parameterName,
                state, vars)) { return false; }
        return semanticRawParamExprSafe(statement.value_node,
            parameterName, owner, locals, vars, state);
    }
    if (statement.kind == NK_EXPR_STMT) {
        return semanticRawParamExprSafe(statement.expr,
            parameterName, owner, locals, vars, state);
    }
    if (statement.kind == NK_IF_STMT) {
        return semanticRawParamExprSafe(statement.condition,
                parameterName, owner, locals, vars, state)
            && semanticRawParamBlockSafe(statement.then_block,
                parameterName, owner, locals, vars, state)
            && (statement.else_block == null
                || semanticRawParamStmtSafe(statement.else_block,
                    parameterName, owner, locals, vars, state));
    }
    if (statement.kind == NK_ELSE_BLOCK) {
        return semanticRawParamBlockSafe(statement.body_node,
            parameterName, owner, locals, vars, state);
    }
    if (statement.kind == NK_ELSE_IF) {
        return semanticRawParamStmtSafe(statement.if_stmt,
            parameterName, owner, locals, vars, state);
    }
    if (statement.kind == NK_WHILE_STMT
            || statement.kind == NK_DO_WHILE_STMT) {
        return semanticRawParamExprSafe(statement.condition,
                parameterName, owner, locals, vars, state)
            && semanticRawParamBlockSafe(statement.body_node,
                parameterName, owner, locals, vars, state);
    }
    if (statement.kind == NK_FOR_IN_STMT
            || statement.kind == NK_PARALLEL_FOR_STMT) {
        return semanticRawParamExprSafe(statement.iterable,
                parameterName, owner, locals, vars, state)
            && semanticRawParamBlockSafe(statement.body_node,
                parameterName, owner, locals, vars, state);
    }
    if (statement.kind == NK_C_FOR_STMT) {
        bool initSafe = true;
        if (statement.init != null) {
            if (statement.init.kind == NK_FOR_INIT_VAR) {
                initSafe = semanticRawParamStmtSafe(statement.init.var_decl,
                    parameterName, owner, locals, vars, state);
            } else {
                initSafe = semanticRawParamExprSafe(
                    statement.init.expression,
                    parameterName, owner, locals, vars, state);
            }
        }
        return initSafe
            && semanticRawParamExprSafe(statement.condition,
                parameterName, owner, locals, vars, state)
            && semanticRawParamExprSafe(statement.update,
                parameterName, owner, locals, vars, state)
            && semanticRawParamBlockSafe(statement.body_node,
                parameterName, owner, locals, vars, state);
    }
    if (statement.kind == NK_SWITCH_STMT) {
        if (!semanticRawParamExprSafe(statement.value_node,
                parameterName, owner, locals, vars, state)) { return false; }
        int caseIndex = 0;
        while (caseIndex < statement.cases.len) {
            Node caseClause = statement.cases.get(caseIndex);
            if (!semanticRawParamExprSafe(caseClause.value_node,
                    parameterName, owner, locals, vars, state)) { return false; }
            int bodyIndex = 0;
            while (bodyIndex < caseClause.body_nlist.len) {
                if (!semanticRawParamStmtSafe(
                        caseClause.body_nlist.get(bodyIndex), parameterName,
                        owner, locals, vars, state)) { return false; }
                bodyIndex = bodyIndex + 1;
            }
            caseIndex = caseIndex + 1;
        }
        return true;
    }
    if (statement.kind == NK_TRY_CATCH_STMT) {
        return semanticRawParamBlockSafe(statement.try_block,
                parameterName, owner, locals, vars, state)
            && semanticRawParamBlockSafe(statement.catch_block,
                parameterName, owner, locals, vars, state)
            && semanticRawParamBlockSafe(statement.finally_block,
                parameterName, owner, locals, vars, state);
    }
    if (statement.kind == NK_DELETE_STMT
            || statement.kind == NK_RELEASE_STMT
            || statement.kind == NK_KEEP_STMT
            || statement.kind == NK_THROW_STMT) {
        if (semanticRawExpressionMentionsParam(
                statement.expr, parameterName)) { return false; }
        return semanticRawParamExprSafe(statement.expr,
            parameterName, owner, locals, vars, state);
    }
    return true;
}

bool semanticRawParamBlockSafe(Node? block, string parameterName,
        string owner, Map<string, bool> locals,
        Map<string, Node> vars, SemanticValidationState state) {
    if (block == null) { return false; }
    int index = 0;
    while (index < block.statements.len) {
        if (!semanticRawParamStmtSafe(block.statements.get(index),
                parameterName, owner, locals, vars, state)) { return false; }
        index = index + 1;
    }
    return true;
}

bool semanticRawParameterBorrowOnly(Node declaration, int parameterIndex,
        SemanticValidationState state) {
    if (declaration.body_node == null
            || parameterIndex < 0
            || parameterIndex >= declaration.params.len) { return false; }
    string provenance = declaration.source_file == null
        ? "none" : declaration.source_file;
    string key = astNodeKey(declaration) + "#"
        + Strings.fromInt(parameterIndex) + "#" + provenance;
    if (state.rawBorrowEffectKnown.has(key)) {
        return state.rawBorrowEffects.has(key);
    }
    if (state.rawBorrowVisiting.has(key)) { return false; }
    state.rawBorrowVisiting.put(key, true);
    Map<string, bool> locals = {};
    Map<string, Node> vars = {};
    int paramIndex = 0;
    while (paramIndex < declaration.params.len) {
        locals.put(declaration.params.get(paramIndex).name, true);
        vars.put(declaration.params.get(paramIndex).name,
            declaration.params.get(paramIndex).type);
        paramIndex = paramIndex + 1;
    }
    semanticRawCollectLocalNames(declaration.body_node, locals);
    Node? previousCallable = state.callable;
    state.callable = declaration;
    bool safe = semanticRawParamBlockSafe(
        declaration.body_node,
        declaration.params.get(parameterIndex).name,
        semanticRawBorrowOwner(declaration, state), locals, vars, state);
    state.callable = previousCallable;
    state.rawBorrowVisiting.remove(key);
    state.rawBorrowEffectKnown.put(key, true);
    if (safe) { state.rawBorrowEffects.put(key, true); }
    return safe;
}

void semanticValidateOpaqueCallArgument(Node? declaration,
        int parameterIndex, Node? expected, Node argument, string label,
        bool bodylessFfi, SemanticValidationState state,
        Map<string, Node> vars) {
    if (!semanticOpaqueRawCarrierType(expected, state)
            || !semanticExpressionIsOpaqueBorrow(argument, state, vars)) {
        return;
    }
    if ((bodylessFfi
            && hostedAbiParameterReadOnlyBorrow(label, parameterIndex))
            || (declaration != null
            && semanticRawParameterBorrowOnly(
                declaration, parameterIndex, state))) { return; }
    semanticValidationFail("Argument to '" + label
        + "()' cannot forward a managed value as a raw representation "
        + "because the parameter is not proven borrow-only", argument);
}

void semanticValidateOpaqueCallArguments(Node? declaration,
        Vector<Node> params, Node call, string label,
        Map<string, Node> substitutions, bool bodylessFfi,
        SemanticValidationState state, Map<string, Node> vars) {
    int argumentIndex = 0;
    while (argumentIndex < call.args.len) {
        int parameterIndex = argumentIndex;
        if (argumentIndex < call.arg_names.len
                && call.arg_names.get(argumentIndex) != "") {
            parameterIndex = semanticParameterIndex(
                params, call.arg_names.get(argumentIndex));
        }
        if (parameterIndex >= 0 && parameterIndex < params.len) {
            Node expected = params.get(parameterIndex).type;
            if (substitutions.len > 0) {
                expected = resolveGenericType(
                    expected, substitutions, state.analyzed);
            }
            semanticValidateOpaqueCallArgument(
                declaration, parameterIndex, expected,
                call.args.get(argumentIndex), label, bodylessFfi,
                state, vars);
        }
        argumentIndex = argumentIndex + 1;
    }
}
