/* Stage 3 — self-hosted semantic tables and on-demand expression inference.
 *
 * Declaration registration, generic-instance discovery, nominal class data,
 * and inferred TypeExpr values supply the same typed lowering contracts used
 * by the Python compiler. Numeric/operator policy itself lives in the small
 * numeric_semantics.btrc and operator_semantics.btrc modules. */

/* A concrete monomorphization request: base generic class + the concrete type
 * args it was instantiated with, plus the precomputed mangled name. */
class GenInstance {
    public string base;
    public Vector<Node> args;
    public string mangled;
    public GenInstance(string base, Vector<Node> args, string mangled) {
        self.base = base;
        self.args = args;
        self.mangled = mangled;
    }
}

/* One monomorphization target for a generic METHOD (a method with its own
 * type parameters, e.g. Vector<T>.mapTo<U>). `classBase` is the owning class
 * base name, `classArgs` the receiver instance's type args (e.g. [int] for
 * Vector<int>; empty for a non-generic owner), `methodArgs` the inferred
 * method type args (e.g. [string] for mapTo<string>). Mirrors one entry of
 * the reference's analyzed.generic_method_instances. */
class MethodGenInstance {
    public string classBase;
    public string methodName;
    public Vector<Node> classArgs;
    public Vector<Node> methodArgs;
    public MethodGenInstance(string classBase, string methodName,
                             Vector<Node> classArgs, Vector<Node> methodArgs) {
        self.classBase = classBase;
        self.methodName = methodName;
        self.classArgs = classArgs;
        self.methodArgs = methodArgs;
    }
}

class Analyzed {
    /* function name -> the function's return TypeExpr node (NK_TYPE_EXPR) */
    public Map<string, Node> funcRetTypes;
    /* set of declared function names (value always "1") */
    public Map<string, bool> funcNames;
    /* function name -> its FunctionDecl node (for default-parameter filling). */
    public Map<string, Node> funcTable;
    /* class name -> its ClassDecl node (NK_CLASS_DECL). Mirrors class_table. */
    public Map<string, Node> classTable;
    /* generic class base name -> its ClassDecl node (generic_params non-empty). */
    public Map<string, Node> genericClassTable;
    /* Concrete generic instances in discovery (declaration-walk) order, deduped
     * by mangled name. Mirrors analyzer.generic_instances flattened. */
    public Vector<GenInstance> genericInstances;
    /* set of canonical recursive instance keys already collected (dedup). */
    public Map<string, bool> genericSeen;
    /* enum type name -> its EnumDecl node (NK_ENUM_DECL). Mirrors enum_table
     * keyed by type name (Python enum_table maps name -> [value names]). */
    public Map<string, Node> enumTable;
    /* bare enum value name (e.g. "RED") -> owning enum type name ("Color"). Lets
     * a bare identifier lower to its prefixed C constant. */
    public Map<string, string> enumValueOwner;
    /* Number of enum declarations that export each bare spelling. Qualified
     * access remains legal when the bare form is ambiguous. */
    public Map<string, int> enumValueOwnerCount;
    /* rich (tagged-union) enum type name -> its RichEnumDecl node
     * (NK_RICH_ENUM_DECL). Mirrors rich_enum_table. */
    public Map<string, Node> richEnumTable;
    /* Function-pointer types accumulated during lowering. `fnPtrTypes` maps
     * the mangled name (e.g. __btrc_fn_bool_int) to its TypeExpr; IR generation
     * later creates typed IRFunctionPointerTypedef declarations. `fnPtrOrder`
     * preserves first-seen insertion order for deterministic emission. */
    public Map<string, Node> fnPtrTypes;
    public Vector<string> fnPtrOrder;
    /* Generic-method monomorphization targets, in discovery order, deduped by
     * the same mangled-key as their emitted C name. Mirrors
     * analyzed.generic_method_instances. */
    public Vector<MethodGenInstance> methodGenInstances;
    public Map<string, bool> methodGenSeen;
    /* call-site astNodeKey (stable Node identity) -> the inferred method
     * type args, so IR-gen can mangle the call to its monomorphized instance
     * without re-running inference. Mirrors generic_method_call_args. */
    public Map<string, Vector<Node>> methodGenCallArgs;
    /* Canonical stdlib call sites that must bypass a user source definition
     * sharing a compiler-owned hosted spelling. */
    public Map<string, bool> hostedCallKeys;
    /* Generic constructor call identity -> exact context/inference result.
     * This is the self-hosted counterpart of reference node_types: no-arg and
     * nested constructors retain the concrete specialization selected by a
     * return, argument, initializer, or assignment boundary. */
    public Map<string, Node> genericConstructorTypes;
    /* Module-level (file-scope) variable name -> its TypeExpr. Mirrors the
     * reference's global scope: a bare identifier referencing a top-level var
     * resolves to this type during inference (e.g. `string order` so
     * `order.equals(...)` lowers as a string method). Seeded into each
     * function's local varTypes at lowering entry. */
    public Map<string, Node> globalVarTypes;
    /* Global names with a concrete definition (not an initializer-less extern).
     * IR generation suppresses redundant extern redeclarations when the same
     * composed translation unit already owns the definition. */
    public Map<string, bool> globalHasDefinition;
    /* user typedef alias -> original TypeExpr; inference canonicalizes through
     * this table while IR declarations preserve source alias spelling. */
    public Map<string, Node> typedefTable;
    /* struct tag/name -> complete definition when available, otherwise its
     * forward declaration. */
    public Map<string, Node> structTable;
    /* Immutable declaration indexes built after registration and before the
     * first inference query. General-member and method-only namespaces remain
     * separate so a value member never masks an inherited method. */
    public bool memberIndexReady;
    public Map<string, Node> classMemberIndex;
    public Map<string, Node> classMethodIndex;
    public Map<string, Node> classConstructorIndex;
    public Map<string, Node> genericMemberIndex;
    public Map<string, Node> genericMethodIndex;
    public Map<string, Node> genericConstructorIndex;
    /* IR generation enables this memo only inside one immutable type
     * environment. Semantic analysis leaves it disabled because its scopes are
     * still being built and mutated. */
    public bool expressionInferenceMemoEnabled;
    public Map<string, bool> expressionInferenceMemoKnown;
    public Map<string, Node> expressionInferenceMemoValues;
    /* for-in iterable identity -> semantic proof of real array capacity. */
    public Map<string, bool> arrayIterationCapacityKeys;

    public Analyzed() {
        self.funcRetTypes = {};
        self.funcNames = {};
        self.funcTable = {};
        self.classTable = {};
        self.genericClassTable = {};
        self.genericInstances = [];
        self.genericSeen = {};
        self.enumTable = {};
        self.enumValueOwner = {};
        self.enumValueOwnerCount = {};
        self.richEnumTable = {};
        self.fnPtrTypes = {};
        self.fnPtrOrder = [];
        self.methodGenInstances = [];
        self.methodGenSeen = {};
        self.methodGenCallArgs = {};
        self.hostedCallKeys = {};
        self.genericConstructorTypes = {};
        self.globalVarTypes = {};
        self.globalHasDefinition = {};
        self.typedefTable = {};
        self.structTable = {};
        self.memberIndexReady = false;
        self.classMemberIndex = {};
        self.classMethodIndex = {};
        self.classConstructorIndex = {};
        self.genericMemberIndex = {};
        self.genericMethodIndex = {};
        self.genericConstructorIndex = {};
        self.expressionInferenceMemoEnabled = false;
        self.expressionInferenceMemoKnown = {};
        self.expressionInferenceMemoValues = {};
        self.arrayIterationCapacityKeys = {};
    }

    /* True if any generic-method monomorphization target exists. */
    public bool hasMethodGenerics() {
        return self.methodGenInstances.len > 0;
    }

    /* True if `name` names a known (plain) enum type. */
    public bool isEnum(string name) {
        return self.enumTable.has(name);
    }

    /* True if `name` names a known rich (tagged-union) enum type. */
    public bool isRichEnum(string name) {
        return self.richEnumTable.has(name);
    }

    /* True if `name` is a bare enum value (e.g. RED). */
    public bool isEnumValue(string name) {
        return self.enumValueOwner.has(name)
            && self.enumValueOwnerCount.get(name) == 1;
    }

    public bool isAmbiguousEnumValue(string name) {
        return self.enumValueOwnerCount.has(name)
            && self.enumValueOwnerCount.get(name) > 1;
    }

    public bool enumContains(string enumName, string valueName) {
        if (!self.enumTable.has(enumName)) { return false; }
        Node declaration = self.enumTable.get(enumName);
        int index = 0;
        while (index < declaration.values.len) {
            if (declaration.values.get(index).name == valueName) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }

    /* The owning enum type name of bare value `name` ("" if unknown). */
    public string enumOwnerOf(string name) {
        if (self.enumValueOwner.has(name)) { return self.enumValueOwner.get(name); }
        return "";
    }

    /* True if `name` names a known generic class. */
    public bool isGenericClass(string name) {
        return self.genericClassTable.has(name);
    }

    /* True if any concrete generic instance exists (drives macro emission). */
    public bool hasGenerics() {
        return self.genericInstances.len > 0;
    }

    /* True if `name` names a known (non-generic) class. */
    public bool isClass(string name) {
        return self.classTable.has(name);
    }

    public void requireMemberIndex() {
        if (self.memberIndexReady) { return; }
        fprintf(stderr, "internal compiler error: declaration member index is not ready\n");
        exit(1);
    }

    /* True if `base` is a (transitive) parent class of `sub`. Walks the parent
     * chain from `sub`; `sub == base` counts as true. Mirrors
     * variables._is_subclass. */
    public bool isSubclass(string sub, string base) {
        string cur = sub;
        Map<string, bool> seen = {};
        while (cur != "" && !seen.has(cur)) {
            if (cur == base) { return true; }
            seen.put(cur, true);
            if (!self.classTable.has(cur)) { return false; }
            Node decl = self.classTable.get(cur);
            cur = parentName(decl);
        }
        return false;
    }

    /* Look up an ordinary class member by name, walking the inheritance chain.
     * Constructors are declaration-only call targets and never instance
     * members; classConstructor() is their sole lookup path. */
    public Node? classMember(string cls, string member) {
        self.requireMemberIndex();
        string key = analyzedMemberIndexKey(cls, member);
        if (self.classMemberIndex.has(key)) {
            return self.classMemberIndex.get(key);
        }
        return null;
    }

    /* Method-only lookup has a separate source namespace from fields and
     * properties. Walk inheritance just like classMember, but never let a
     * same-named value member mask the callable declaration. */
    public Node? classMethod(string cls, string method) {
        self.requireMemberIndex();
        string key = analyzedMemberIndexKey(cls, method);
        if (self.classMethodIndex.has(key)) {
            return self.classMethodIndex.get(key);
        }
        return null;
    }

    /* The explicitly marked constructor MethodDecl of class `cls`, or null. */
    public Node? classConstructor(string cls) {
        self.requireMemberIndex();
        if (self.classConstructorIndex.has(cls)) {
            return self.classConstructorIndex.get(cls);
        }
        return null;
    }

    /* The MethodDecl named `member` on generic class `cls` (own members only;
     * generic classes are not inherited in this compiler), or null. Used to
     * order named args / fill defaults on generic-instance method calls. */
    public Node? genericClassMethod(string cls, string member) {
        self.requireMemberIndex();
        string key = analyzedMemberIndexKey(cls, member);
        if (self.genericMethodIndex.has(key)) {
            return self.genericMethodIndex.get(key);
        }
        return null;
    }

    public Node? genericClassConstructor(string cls) {
        self.requireMemberIndex();
        if (self.genericConstructorIndex.has(cls)) {
            return self.genericConstructorIndex.get(cls);
        }
        return null;
    }

    /* True if `member` is a property (PropertyDecl) of class `cls` (own or
     * inherited). */
    public bool isProperty(string cls, string member) {
        Node? m = self.classMember(cls, member);
        return m != null && m.kind == NK_PROPERTY_DECL;
    }

    /* The merged method set of class `cls` — own methods plus all inherited ones,
     * with the dict-merge ordering the analyzer uses: parent (already-merged)
     * methods first in their order, child's own appended, an override keeping the
     * parent's position but using the child's decl. Excludes constructors and
     * __del__. Mirrors ClassInfo.methods after _resolve_class_parents. */
    public Vector<MethodEntry> mergedMethods(string cls) {
        Vector<MethodEntry> out = [];
        if (!self.classTable.has(cls)) { return out; }
        Node decl = self.classTable.get(cls);
        Map<string, int> idx = {};
        string par = parentName(decl);
        if (par != "" && self.classTable.has(par)) {
            Vector<MethodEntry> pm = self.mergedMethods(par);
            int p = 0;
            while (p < pm.len) {
                MethodEntry pe = pm.get(p);
                idx.put(pe.name, out.len);
                out.push(MethodEntry(pe.name, pe.sig));
                p = p + 1;
            }
        }
        int i = 0;
        while (i < decl.members.len) {
            Node m = decl.members.get(i);
            if (m.kind == NK_METHOD_DECL && !m.is_constructor
                    && m.name != "__del__") {
                if (idx.has(m.name)) {
                    out.set(idx.get(m.name), MethodEntry(m.name, m));
                } else {
                    idx.put(m.name, out.len);
                    out.push(MethodEntry(m.name, m));
                }
            }
            i = i + 1;
        }
        return out;
    }
}

/* A method available on a class: its name and the MethodDecl that defines its
 * signature (own or inherited). */
class MethodEntry {
    public string name;
    public Node sig;
    public MethodEntry(string name, Node sig) {
        self.name = name;
        self.sig = sig;
    }
}

/* The parent class name of a ClassDecl ("" if none). */
string parentName(Node decl) {
    if (decl.parent == null) { return ""; }
    return decl.parent;
}

/* Build the function + class tables from the parsed program. */
Analyzed analyzeProgram(Node prog) {
    Analyzed a = Analyzed();
    int i = 0;
    while (i < prog.declarations.len) {
        Node d = prog.declarations.get(i);
        if (d.kind == NK_FUNCTION_DECL) {
            a.funcNames.put(d.name, true);
            a.funcRetTypes.put(d.name, d.return_type);
            a.funcTable.put(d.name, d);
        } else if (d.kind == NK_CLASS_DECL) {
            if (d.generic_params.len == 0) {
                a.classTable.put(d.name, d);
            } else {
                a.genericClassTable.put(d.name, d);
            }
        } else if (d.kind == NK_ENUM_DECL) {
            a.enumTable.put(d.name, d);
            int v = 0;
            while (v < d.values.len) {
                string valueName = d.values.get(v).name;
                int ownerCount = 0;
                if (a.enumValueOwnerCount.has(valueName)) {
                    ownerCount = a.enumValueOwnerCount.get(valueName);
                }
                a.enumValueOwnerCount.put(valueName, ownerCount + 1);
                if (!a.enumValueOwner.has(valueName)) {
                    a.enumValueOwner.put(valueName, d.name);
                }
                v = v + 1;
            }
        } else if (d.kind == NK_RICH_ENUM_DECL) {
            a.richEnumTable.put(d.name, d);
        } else if (d.kind == NK_TYPEDEF_DECL) {
            a.typedefTable.put(d.alias, d.original);
        } else if (d.kind == NK_STRUCT_DECL) {
            if (!a.structTable.has(d.name) || !d.is_forward) {
                a.structTable.put(d.name, d);
            }
        } else if (d.kind == NK_VAR_DECL_STMT) {
            /* Module-level variable: record its type in the global scope so a
             * bare identifier referencing it resolves during inference. An
             * explicit type is used directly; a `var` global's type is deduced
             * from its initializer (mirrors the analyzer seeding the global
             * scope with each module-level var's resolved type). */
            if (d.type != null) {
                a.globalVarTypes.put(d.name, d.type);
            }
            bool externOnly = d.type != null && d.type.is_extern
                && d.initializer == null;
            if (!externOnly) { a.globalHasDefinition.put(d.name, true); }
        }
        i = i + 1;
    }
    indexAnalyzedMembers(a);
    /* `var` (untyped) module-level variables: deduce the type from the
     * initializer now that the function/class tables are populated, so a bare
     * reference to such a global still resolves (mirrors the global-scope type
     * the analyzer records for an inferred top-level var). */
    int gv = 0;
    while (gv < prog.declarations.len) {
        Node d = prog.declarations.get(gv);
        if (d.kind == NK_VAR_DECL_STMT && d.type == null && d.initializer != null) {
            Map<string, Node> empty = {};
            Node? gt = inferSpecializationType(
                d.initializer, a, empty);
            if (gt != null) { a.globalVarTypes.put(d.name, gt); }
        }
        gv = gv + 1;
    }
    /* Second pass: upgrade class-typed generic args to pointers across the whole
     * AST (mirrors the reference's _upgrade_class_type, which must run before
     * generic instances are collected so the `_p1`-suffixed mangling and the
     * resolved field/element types agree everywhere). */
    int u = 0;
    while (u < prog.declarations.len) {
        upgradeDeclGenericArgs(prog.declarations.get(u), a);
        u = u + 1;
    }
    /* Third pass: collect concrete generic instances by walking every
     * declaration's types + bodies in source order (mirrors the analyzer's
     * _collect_generic_instances calls across registration + body analysis). */
    int j = 0;
    while (j < prog.declarations.len) {
        collectGenericsDecl(prog.declarations.get(j), a);
        j = j + 1;
    }
    /* Fourth pass: register transitive generic deps. A generic class can hold
     * fields/methods typed in OTHER generic classes (e.g. List<T> has a
     * ListNode<T> head/tail), so each registered instance can imply more.
     * Mirrors _register_transitive_generic_deps inside the reference's
     * while-changed emission loop: keep registering resolved member types until
     * no new instance appears. */
    registerTransitiveGenericInstances(a);

    /* Fifth pass: collect generic-METHOD monomorphization targets. A generic
     * method (its own type params, e.g. Vector<T>.mapTo<U>) needs one emitted
     * C function per (receiver-instance x method-type-args) combination. This
     * walk tracks in-scope var types so each call site's receiver and argument
     * types can be inferred. Mirrors analyzer.generic_methods. */
    int mg = 0;
    while (mg < prog.declarations.len) {
        collectMethodGenericsDecl(prog.declarations.get(mg), a);
        mg = mg + 1;
    }
    /* Method-generic signatures can reference further concrete generic types
     * (e.g. Vector<string> from mapTo's return type) — close those over too. */
    registerTransitiveGenericInstances(a);
    return a;
}

/* --- Generic-method instance collection (varTypes-tracking body walk). ---
 * Walks each function/method body building a {var -> TypeExpr} map (the same
 * map IR-gen later uses), and at every method call whose resolved method has
 * its own type parameters, infers the concrete method type args and records a
 * monomorphization target. */
void collectMethodGenericsDecl(Node d, Analyzed a) {
    if (d.kind == NK_FUNCTION_DECL) {
        Map<string, Node> vt = {};
        int i = 0;
        while (i < d.params.len) {
            vt.put(d.params.get(i).name, d.params.get(i).type);
            i = i + 1;
        }
        if (d.body_node != null) { collectMethodGenericsBlock(d.body_node, a, vt); }
    } else if (d.kind == NK_CLASS_DECL && d.generic_params.len == 0) {
        int i = 0;
        while (i < d.members.len) {
            Node mem = d.members.get(i);
            if (mem.kind == NK_METHOD_DECL && mem.body_node != null) {
                Map<string, Node> vt = {};
                Node selfT = makeClassTypeExpr(d.name);
                selfT.pointer_depth = 1;
                vt.put("self", selfT);
                int p = 0;
                while (p < mem.params.len) {
                    vt.put(mem.params.get(p).name, mem.params.get(p).type);
                    p = p + 1;
                }
                collectMethodGenericsBlock(mem.body_node, a, vt);
            }
            i = i + 1;
        }
    }
    /* Generic-class method bodies are templates; their call sites with concrete
     * receivers are reached through the per-instance lowering, not here. */
}

void collectMethodGenericsBlock(Node block, Analyzed a, Map<string, Node> vt) {
    if (block == null) { return; }
    int i = 0;
    while (i < block.statements.len) {
        collectMethodGenericsStmt(block.statements.get(i), a, vt);
        i = i + 1;
    }
}

void collectMethodGenericsStmt(Node s, Analyzed a, Map<string, Node> vt) {
    if (s == null) { return; }
    if (s.kind == NK_VAR_DECL_STMT) {
        collectMethodGenericsExpr(s.initializer, a, vt);
        if (s.type != null) {
            vt.put(s.name, s.type);
        } else if (s.initializer != null) {
            Node? it = inferSpecializationType(
                s.initializer, a, vt);
            if (it != null) { vt.put(s.name, it); }
        }
    } else if (s.kind == NK_RETURN_STMT) {
        collectMethodGenericsExpr(s.value_node, a, vt);
    } else if (s.kind == NK_EXPR_STMT) {
        collectMethodGenericsExpr(s.expr, a, vt);
    } else if (s.kind == NK_IF_STMT) {
        collectMethodGenericsExpr(s.condition, a, vt);
        collectMethodGenericsBlock(s.then_block, a, vt);
        if (s.else_block != null) { collectMethodGenericsStmt(s.else_block, a, vt); }
    } else if (s.kind == NK_ELSE_BLOCK) {
        collectMethodGenericsBlock(s.body_node, a, vt);
    } else if (s.kind == NK_ELSE_IF) {
        collectMethodGenericsStmt(s.if_stmt, a, vt);
    } else if (s.kind == NK_WHILE_STMT || s.kind == NK_DO_WHILE_STMT) {
        collectMethodGenericsExpr(s.condition, a, vt);
        collectMethodGenericsBlock(s.body_node, a, vt);
    } else if (s.kind == NK_C_FOR_STMT) {
        if (s.init != null) {
            if (s.init.kind == NK_FOR_INIT_VAR) { collectMethodGenericsStmt(s.init.var_decl, a, vt); }
            else if (s.init.kind == NK_FOR_INIT_EXPR) { collectMethodGenericsExpr(s.init.expression, a, vt); }
        }
        collectMethodGenericsExpr(s.condition, a, vt);
        collectMethodGenericsExpr(s.update, a, vt);
        collectMethodGenericsBlock(s.body_node, a, vt);
    } else if (s.kind == NK_FOR_IN_STMT || s.kind == NK_PARALLEL_FOR_STMT) {
        collectMethodGenericsExpr(s.iterable, a, vt);
        collectMethodGenericsBlock(s.body_node, a, vt);
    } else if (s.kind == NK_DELETE_STMT) {
        collectMethodGenericsExpr(s.expr, a, vt);
    } else if (s.kind == NK_TRY_CATCH_STMT) {
        if (s.try_block != null) { collectMethodGenericsBlock(s.try_block, a, vt); }
        if (s.catch_block != null) { collectMethodGenericsBlock(s.catch_block, a, vt); }
        if (s.finally_block != null) { collectMethodGenericsBlock(s.finally_block, a, vt); }
    } else if (s.kind == NK_SWITCH_STMT) {
        collectMethodGenericsExpr(s.value_node, a, vt);
        int ci = 0;
        while (ci < s.cases.len) {
            Node c = s.cases.get(ci);
            collectMethodGenericsExpr(c.value_node, a, vt);
            int cj = 0;
            while (cj < c.body_nlist.len) {
                collectMethodGenericsStmt(c.body_nlist.get(cj), a, vt);
                cj = cj + 1;
            }
            ci = ci + 1;
        }
    } else if (s.kind == NK_BLOCK) {
        collectMethodGenericsBlock(s, a, vt);
    }
}

void collectMethodGenericsExpr(Node e, Analyzed a, Map<string, Node> vt) {
    if (e == null) { return; }
    if (e.kind == NK_CALL_EXPR) {
        collectMethodGenericCall(e, a, vt);
    }
    collectMethodGenericsExpr(e.callee, a, vt);
    collectMethodGenericsExpr(e.left, a, vt);
    collectMethodGenericsExpr(e.right, a, vt);
    collectMethodGenericsExpr(e.operand, a, vt);
    collectMethodGenericsExpr(e.expr, a, vt);
    collectMethodGenericsExpr(e.obj, a, vt);
    collectMethodGenericsExpr(e.index, a, vt);
    collectMethodGenericsExpr(e.condition, a, vt);
    collectMethodGenericsExpr(e.true_expr, a, vt);
    collectMethodGenericsExpr(e.false_expr, a, vt);
    collectMethodGenericsExpr(e.target, a, vt);
    collectMethodGenericsExpr(e.value_node, a, vt);
    int i = 0;
    while (i < e.args.len) { collectMethodGenericsExpr(e.args.get(i), a, vt); i = i + 1; }
}

/* If `call` is an instance method call to a generic method, infer its method
 * type args and record a monomorphization target. Mirrors
 * generic_methods._collect_generic_method_instance. */
void collectMethodGenericCall(Node call, Analyzed a, Map<string, Node> vt) {
    Node callee = call.callee;
    if (callee == null || callee.kind != NK_FIELD_ACCESS_EXPR) { return; }
    Node objNode = callee.obj;
    string method = callee.field;
    /* Static (ClassName.method) calls are not receiver-instance method generics. */
    if (objNode != null && objNode.kind == NK_IDENTIFIER && a.isClass(objNode.name)) {
        return;
    }
    Node? ot = inferSpecializationType(objNode, a, vt);
    if (ot == null) { return; }
    /* Resolve the owning method declaration (generic instance OR plain class).
     * `classArgs` is a FRESH copy of the receiver's generic args (never an alias
     * of the AST's `ot.generic_args` — aliasing a borrowed managed vector into a
     * scope-released local would underflow its refcount and free the AST node). */
    Node? method_decl = null;
    string classBase = "";
    Vector<Node> classArgs = [];
    bool ownerGeneric = ot.generic_args.len > 0 && a.isGenericClass(ot.base);
    if (ownerGeneric) {
        method_decl = a.genericClassMethod(ot.base, method);
        classBase = ot.base;
        int ca = 0;
        while (ca < ot.generic_args.len) { classArgs.push(ot.generic_args.get(ca)); ca = ca + 1; }
    } else if (a.isClass(ot.base)) {
        method_decl = a.classMethod(ot.base, method);
        classBase = ot.base;
    } else {
        return;
    }
    if (method_decl == null || method_decl.kind != NK_METHOD_DECL) { return; }
    if (method_decl.generic_params.len == 0) { return; }

    /* Class-level substitutions (e.g. {T: int} for Vector<int>). */
    Map<string, Node> classSubs = {};
    if (ownerGeneric) {
        Node gdecl = a.genericClassTable.get(ot.base);
        int gi = 0;
        while (gi < gdecl.generic_params.len && gi < ot.generic_args.len) {
            classSubs.put(gdecl.generic_params.get(gi), ot.generic_args.get(gi));
            gi = gi + 1;
        }
    }

    /* Infer each method type parameter from the arguments. */
    Map<string, Node> methodSubs = {};
    inferMethodTypeArgs(call, method_decl, classSubs, a, vt, methodSubs);
    Vector<Node> methodArgs = [];
    Map<string, bool> tparams = typeParameterSet(method_decl.generic_params);
    int mp = 0;
    bool ok = true;
    while (mp < method_decl.generic_params.len) {
        string gp = method_decl.generic_params.get(mp);
        if (!methodSubs.has(gp)) { ok = false; }
        else {
            Node arg = methodSubs.get(gp);
            if (typeReferencesNames(arg, tparams)) { ok = false; }
            else { methodArgs.push(arg); }
        }
        mp = mp + 1;
    }
    if (!ok) { return; }

    string owner = classBase + "." + method;
    validateGenericArgumentsForOwner(owner, methodArgs);

    /* Resolve and validate the full signature before recording an instance.
     * This catches nested-array composition and nested writable class
     * specializations after class- and method-level substitution. */
    Map<string, Node> full = {};
    Vector<string> csk = classSubs.keys();
    int ci = 0;
    while (ci < csk.len) {
        full.put(csk.get(ci), classSubs.get(csk.get(ci)));
        ci = ci + 1;
    }
    int mi = 0;
    while (mi < method_decl.generic_params.len) {
        string gp = method_decl.generic_params.get(mi);
        if (methodSubs.has(gp)) { full.put(gp, methodSubs.get(gp)); }
        mi = mi + 1;
    }
    validateSpecializedType(owner, method_decl.return_type, full, a);
    int vsi = 0;
    while (vsi < method_decl.params.len) {
        validateSpecializedType(
            owner, method_decl.params.get(vsi).type, full, a);
        vsi = vsi + 1;
    }

    string key = methodInstanceKey(
        classBase, classArgs, method, methodArgs);
    if (!a.methodGenSeen.has(key)) {
        a.methodGenSeen.put(key, true);
        a.methodGenInstances.push(
            MethodGenInstance(classBase, method, classArgs, methodArgs));
    }
    /* Record per-call-site method args for IR-gen mangling. */
    a.methodGenCallArgs.put(astNodeKey(call), methodArgs);

    /* Register concrete generic types that the substituted signature mentions
     * (e.g. Vector<string> from mapTo's return type). */
    registerSubstitutedGenerics(method_decl.return_type, full, a);
    int pi = 0;
    while (pi < method_decl.params.len) {
        registerSubstitutedGenerics(method_decl.params.get(pi).type, full, a);
        pi = pi + 1;
    }
}

/* Resolve `t` through `subs` and register any concrete generic instance it
 * (or its nested args) names. */
void registerSubstitutedGenerics(Node? t, Map<string, Node> subs, Analyzed a) {
    if (t == null) { return; }
    Node resolved = resolveGenericType(t, subs, a);
    registerGenericInstance(resolved, a);
}

/* Infer concrete bindings for each method type parameter by unifying every
 * method parameter's declared type (after class-level substitution) against
 * the corresponding argument's inferred type. Writes results into `subs`. */
void inferMethodTypeArgs(Node call, Node method, Map<string, Node> classSubs,
                         Analyzed a, Map<string, Node> vt, Map<string, Node> subs) {
    /* Set of method type-param names. */
    Map<string, bool> tparams = {};
    int t = 0;
    while (t < method.generic_params.len) {
        tparams.put(method.generic_params.get(t), true);
        t = t + 1;
    }
    int i = 0;
    while (i < method.params.len && i < call.args.len) {
        Node declared = resolveGenericType(
            method.params.get(i).type, classSubs, a);
        Node? actual = argTypeForInference(call.args.get(i), a, vt);
        if (actual != null) {
            unifyTypeParam(declared, actual, tparams, subs);
        }
        i = i + 1;
    }
}

/* Inferred TypeExpr of a call argument, normalized for unification. A bare
 * function reference (Identifier naming a top-level function) is reconstructed
 * into __fn_ptr<ret, params...> so it unifies the same way a lambda does. */
Node? argTypeForInference(Node arg, Analyzed a, Map<string, Node> vt) {
    if (arg.kind == NK_IDENTIFIER && a.funcTable.has(arg.name)
            && !vt.has(arg.name)) {
        return sourceFunctionPointerType(a.funcTable.get(arg.name));
    }
    return inferSpecializationType(arg, a, vt);
}

/* Structurally unify `declared` (may mention type params) with `actual`,
 * recording bindings for any name in `tparams` into `subs`. */
void unifyTypeParam(Node? declared, Node? actual, Map<string, bool> tparams,
                    Map<string, Node> subs) {
    if (declared == null || actual == null) { return; }
    if (tparams.has(declared.base) && declared.generic_args.len == 0) {
        if (!subs.has(declared.base)) {
            Node? binding = stripOnePointer(actual, declared);
            if (binding != null) {
                Node concreteBinding = binding;
                subs.put(declared.base, concreteBinding);
            }
        }
        return;
    }
    if (declared.generic_args.len > 0 && actual.generic_args.len > 0) {
        int i = 0;
        while (i < declared.generic_args.len && i < actual.generic_args.len) {
            unifyTypeParam(declared.generic_args.get(i), actual.generic_args.get(i),
                           tparams, subs);
            i = i + 1;
        }
    }
}

/* Adjust `actual` for the pointer depth the declared param adds (declared U*
 * vs actual int* binds U to int). */
Node? stripOnePointer(Node actual, Node declared) {
    int extra = declared.pointer_depth;
    Node binding = actual;
    int removed = 0;
    while (removed < extra) {
        if (binding.pointer_depth <= 0) { return null; }
        binding = typeWithoutOuterPointers(binding, 1);
        removed = removed + 1;
    }
    return binding;
}

Map<string, bool> typeParameterSet(Vector<string> parameters) {
    Map<string, bool> names = {};
    int index = 0;
    while (index < parameters.len) {
        names.put(parameters.get(index), true);
        index = index + 1;
    }
    return names;
}

Map<string, bool> mergeTypeParameterSets(
        Map<string, bool> inherited, Vector<string> parameters) {
    Map<string, bool> names = {};
    Vector<string> inheritedNames = inherited.keys();
    int inheritedIndex = 0;
    while (inheritedIndex < inheritedNames.len) {
        names.put(inheritedNames.get(inheritedIndex), true);
        inheritedIndex = inheritedIndex + 1;
    }
    int parameterIndex = 0;
    while (parameterIndex < parameters.len) {
        names.put(parameters.get(parameterIndex), true);
        parameterIndex = parameterIndex + 1;
    }
    return names;
}

void validateGenericArgumentsForOwner(string owner, Vector<Node> args) {
    int index = 0;
    while (index < args.len) {
        string problem = genericArgumentProblem(args.get(index));
        if (problem != "") {
            typeShapeFail("Generic argument " + Strings.fromInt(index + 1)
                + " for '" + owner + "' is invalid: " + problem);
        }
        index = index + 1;
    }
}

/* Qualifiers are coherent inside structural Tuple/__fn_ptr shapes, but not in
 * a nested writable class specialization. Validate only known generic classes
 * and then recurse so nested class shapes cannot bypass the policy. */
void validateNestedClassArguments(string owner, Node? typeExpr, Analyzed a) {
    if (typeExpr == null) { return; }
    if (a.genericClassTable.has(typeExpr.base)) {
        validateGenericArgumentsForOwner(
            owner + " via " + typeExpr.base, typeExpr.generic_args);
    }
    int index = 0;
    while (index < typeExpr.generic_args.len) {
        validateNestedClassArguments(
            owner, typeExpr.generic_args.get(index), a);
        index = index + 1;
    }
}

void validateSpecializedType(string owner, Node? declared,
                             Map<string, Node> substitutions, Analyzed a) {
    if (declared == null) { return; }
    Node resolved = resolveGenericType(
        declared, substitutions, a);
    validateNestedClassArguments(owner, resolved, a);
}

void validateGenericClassSpecialization(Node typeExpr, Analyzed a) {
    if (!a.genericClassTable.has(typeExpr.base)) { return; }
    validateGenericArgumentsForOwner(typeExpr.base, typeExpr.generic_args);
    Node declaration = a.genericClassTable.get(typeExpr.base);
    if (declaration.generic_params.len != typeExpr.generic_args.len) { return; }
    Map<string, Node> substitutions = {};
    int parameter = 0;
    while (parameter < declaration.generic_params.len) {
        substitutions.put(
            declaration.generic_params.get(parameter),
            typeExpr.generic_args.get(parameter));
        parameter = parameter + 1;
    }
    int memberIndex = 0;
    while (memberIndex < declaration.members.len) {
        Node member = declaration.members.get(memberIndex);
        if (member.kind == NK_FIELD_DECL || member.kind == NK_PROPERTY_DECL) {
            validateSpecializedType(
                typeExpr.base, member.type, substitutions, a);
        } else if (member.kind == NK_METHOD_DECL) {
            validateSpecializedType(
                typeExpr.base, member.return_type, substitutions, a);
            int paramIndex = 0;
            while (paramIndex < member.params.len) {
                validateSpecializedType(typeExpr.base,
                    member.params.get(paramIndex).type, substitutions, a);
                paramIndex = paramIndex + 1;
            }
        }
        memberIndex = memberIndex + 1;
    }
}

/* Register the transitive generic-instance closure: for every concrete generic
 * instance, resolve its member field/method/param types through that instance's
 * type map and register any resolved generic-class type. Repeats until the
 * instance set stops growing (new instances can imply further ones). */
void registerTransitiveGenericInstances(Analyzed a) {
    bool changed = true;
    while (changed) {
        changed = false;
        int idx = 0;
        /* genericInstances may grow during the loop; re-read .len each step. */
        while (idx < a.genericInstances.len) {
            GenInstance inst = a.genericInstances.get(idx);
            if (a.genericClassTable.has(inst.base)) {
                Node decl = a.genericClassTable.get(inst.base);
                Map<string, Node> tm = {};
                int g = 0;
                while (g < decl.generic_params.len && g < inst.args.len) {
                    tm.put(decl.generic_params.get(g), inst.args.get(g));
                    g = g + 1;
                }
                int mi = 0;
                while (mi < decl.members.len) {
                    Node mem = decl.members.get(mi);
                    Map<string, bool> unresolved = {};
                    if (mem.kind == NK_METHOD_DECL) {
                        unresolved = typeParameterSet(mem.generic_params);
                    }
                    if (mem.kind == NK_FIELD_DECL || mem.kind == NK_PROPERTY_DECL) {
                        if (registerResolvedGenericInstance(
                                mem.type, tm, unresolved, a)) { changed = true; }
                    } else if (mem.kind == NK_METHOD_DECL) {
                        if (registerResolvedGenericInstance(
                                mem.return_type, tm, unresolved, a)) { changed = true; }
                        int p = 0;
                        while (p < mem.params.len) {
                            if (registerResolvedGenericInstance(
                                    mem.params.get(p).type, tm,
                                    unresolved, a)) { changed = true; }
                            p = p + 1;
                        }
                    }
                    mi = mi + 1;
                }
            }
            idx = idx + 1;
        }
    }
    closeGenericInstanceGraph(a);
}

/* Resolve a member TypeExpr through `tm` and, if the result is a concrete
 * generic-class instance not yet seen, register it. Returns true if a new
 * instance was added (so the caller's fixpoint loop iterates again). */
bool registerResolvedGenericInstance(Node? t, Map<string, Node> tm,
                                     Map<string, bool> unresolved, Analyzed a) {
    if (t == null) { return false; }
    Node resolved = resolveGenericType(t, tm, a);
    int before = a.genericInstances.len;
    registerGenericInstanceWithUnresolved(resolved, a, unresolved);
    return a.genericInstances.len > before;
}

/* --- AST pass: upgrade class-typed generic args to pointers in place. ---
 * Walks the same type/expr surface as the generic-collection walkers below, but
 * for each TypeExpr it calls upgradeTypeGenericArgs so nested class args become
 * pointers. Generic-class member templates (T-typed fields) are intentionally
 * skipped — their T resolves per instance from the (already-upgraded) instance
 * args, exactly as in the reference. */
void upgradeDeclGenericArgs(Node d, Analyzed a) {
    if (d.kind == NK_FUNCTION_DECL) {
        Map<string, bool> unresolved = typeParameterSet(d.generic_params);
        int i = 0;
        while (i < d.params.len) {
            upgradeTypeGenericArgs(d.params.get(i).type, a, unresolved);
            i = i + 1;
        }
        upgradeTypeGenericArgs(d.return_type, a, unresolved);
        if (d.body_node != null) {
            upgradeBlockGenericArgs(d.body_node, a, unresolved);
        }
    } else if (d.kind == NK_CLASS_DECL) {
        /* Keep class parameters as unresolved templates while normalizing every
         * concrete nested class type. This matters for signatures such as
         * `Mutex<Payload>` inside a generic class: Payload still has pointer
         * representation even though an unrelated `T` remains unresolved. */
        Map<string, bool> classParameters =
            typeParameterSet(d.generic_params);
        int i = 0;
        while (i < d.members.len) {
            Node mem = d.members.get(i);
            if (mem.kind == NK_FIELD_DECL || mem.kind == NK_PROPERTY_DECL) {
                upgradeTypeGenericArgs(mem.type, a, classParameters);
            } else if (mem.kind == NK_METHOD_DECL) {
                Map<string, bool> unresolved = mergeTypeParameterSets(
                    classParameters, mem.generic_params);
                int p = 0;
                while (p < mem.params.len) {
                    upgradeTypeGenericArgs(
                        mem.params.get(p).type, a, unresolved);
                    p = p + 1;
                }
                upgradeTypeGenericArgs(mem.return_type, a, unresolved);
                if (mem.body_node != null) {
                    upgradeBlockGenericArgs(mem.body_node, a, unresolved);
                }
            }
            i = i + 1;
        }
    } else if (d.kind == NK_VAR_DECL_STMT) {
        Map<string, bool> unresolved = {};
        upgradeTypeGenericArgs(d.type, a, unresolved);
        upgradeExprGenericArgs(d.initializer, a, unresolved);
    }
}

void upgradeBlockGenericArgs(Node block, Analyzed a,
                             Map<string, bool> unresolved) {
    if (block == null) { return; }
    int i = 0;
    while (i < block.statements.len) {
        upgradeStmtGenericArgs(block.statements.get(i), a, unresolved);
        i = i + 1;
    }
}

void upgradeStmtGenericArgs(Node s, Analyzed a,
                            Map<string, bool> unresolved) {
    if (s == null) { return; }
    if (s.kind == NK_VAR_DECL_STMT) {
        upgradeTypeGenericArgs(s.type, a, unresolved);
        upgradeExprGenericArgs(s.initializer, a, unresolved);
    } else if (s.kind == NK_RETURN_STMT) {
        upgradeExprGenericArgs(s.value_node, a, unresolved);
    } else if (s.kind == NK_EXPR_STMT) {
        upgradeExprGenericArgs(s.expr, a, unresolved);
    } else if (s.kind == NK_IF_STMT) {
        upgradeExprGenericArgs(s.condition, a, unresolved);
        upgradeBlockGenericArgs(s.then_block, a, unresolved);
        if (s.else_block != null) {
            upgradeStmtGenericArgs(s.else_block, a, unresolved);
        }
    } else if (s.kind == NK_ELSE_BLOCK) {
        upgradeBlockGenericArgs(s.body_node, a, unresolved);
    } else if (s.kind == NK_ELSE_IF) {
        upgradeStmtGenericArgs(s.if_stmt, a, unresolved);
    } else if (s.kind == NK_WHILE_STMT || s.kind == NK_DO_WHILE_STMT) {
        upgradeExprGenericArgs(s.condition, a, unresolved);
        upgradeBlockGenericArgs(s.body_node, a, unresolved);
    } else if (s.kind == NK_C_FOR_STMT) {
        if (s.init != null) {
            if (s.init.kind == NK_FOR_INIT_VAR) {
                upgradeStmtGenericArgs(s.init.var_decl, a, unresolved);
            } else if (s.init.kind == NK_FOR_INIT_EXPR) {
                upgradeExprGenericArgs(s.init.expression, a, unresolved);
            }
        }
        upgradeExprGenericArgs(s.condition, a, unresolved);
        upgradeExprGenericArgs(s.update, a, unresolved);
        upgradeBlockGenericArgs(s.body_node, a, unresolved);
    } else if (s.kind == NK_FOR_IN_STMT || s.kind == NK_PARALLEL_FOR_STMT) {
        upgradeExprGenericArgs(s.iterable, a, unresolved);
        upgradeBlockGenericArgs(s.body_node, a, unresolved);
    } else if (s.kind == NK_DELETE_STMT) {
        upgradeExprGenericArgs(s.expr, a, unresolved);
    } else if (s.kind == NK_TRY_CATCH_STMT) {
        if (s.try_block != null) {
            upgradeBlockGenericArgs(s.try_block, a, unresolved);
        }
        if (s.catch_block != null) {
            upgradeBlockGenericArgs(s.catch_block, a, unresolved);
        }
        if (s.finally_block != null) {
            upgradeBlockGenericArgs(s.finally_block, a, unresolved);
        }
    } else if (s.kind == NK_SWITCH_STMT) {
        upgradeExprGenericArgs(s.value_node, a, unresolved);
        int ci = 0;
        while (ci < s.cases.len) {
            Node c = s.cases.get(ci);
            upgradeExprGenericArgs(c.value_node, a, unresolved);
            int cj = 0;
            while (cj < c.body_nlist.len) {
                upgradeStmtGenericArgs(
                    c.body_nlist.get(cj), a, unresolved);
                cj = cj + 1;
            }
            ci = ci + 1;
        }
    } else if (s.kind == NK_BLOCK) {
        upgradeBlockGenericArgs(s, a, unresolved);
    }
}

void upgradeExprGenericArgs(Node e, Analyzed a,
                            Map<string, bool> unresolved) {
    if (e == null) { return; }
    if (e.kind == NK_NEW_EXPR) {
        upgradeTypeGenericArgs(e.type, a, unresolved);
    }
    if (e.kind == NK_CAST_EXPR) {
        upgradeTypeGenericArgs(e.target_type, a, unresolved);
    }
    if (e.kind == NK_SIZEOF_TYPE) {
        upgradeTypeGenericArgs(e.type, a, unresolved);
    }
    if (e.kind == NK_LAMBDA_EXPR) {
        upgradeTypeGenericArgs(e.return_type, a, unresolved);
        int parameter = 0;
        while (parameter < e.params.len) {
            Node value = e.params.get(parameter);
            upgradeTypeGenericArgs(value.type, a, unresolved);
            upgradeExprGenericArgs(value.default_, a, unresolved);
            parameter = parameter + 1;
        }
        int capture = 0;
        while (capture < e.captures.len) {
            upgradeTypeGenericArgs(
                e.captures.get(capture).type, a, unresolved);
            capture = capture + 1;
        }
        if (e.body_node != null
                && e.body_node.kind == NK_LAMBDA_BLOCK) {
            upgradeBlockGenericArgs(
                e.body_node.body_node, a, unresolved);
        } else if (e.body_node != null
                && e.body_node.kind == NK_LAMBDA_EXPR_BODY) {
            upgradeExprGenericArgs(
                e.body_node.expression, a, unresolved);
        }
    }
    upgradeExprGenericArgs(e.callee, a, unresolved);
    upgradeExprGenericArgs(e.left, a, unresolved);
    upgradeExprGenericArgs(e.right, a, unresolved);
    upgradeExprGenericArgs(e.operand, a, unresolved);
    upgradeExprGenericArgs(e.expr, a, unresolved);
    upgradeExprGenericArgs(e.obj, a, unresolved);
    upgradeExprGenericArgs(e.index, a, unresolved);
    upgradeExprGenericArgs(e.condition, a, unresolved);
    upgradeExprGenericArgs(e.true_expr, a, unresolved);
    upgradeExprGenericArgs(e.false_expr, a, unresolved);
    upgradeExprGenericArgs(e.target, a, unresolved);
    upgradeExprGenericArgs(e.value_node, a, unresolved);
    upgradeExprGenericArgs(e.expression, a, unresolved);
    upgradeExprGenericArgs(e.fn, a, unresolved);
    upgradeExprGenericArgs(e.key, a, unresolved);
    int i = 0;
    while (i < e.args.len) {
        upgradeExprGenericArgs(e.args.get(i), a, unresolved);
        i = i + 1;
    }
    i = 0;
    while (i < e.elements.len) {
        upgradeExprGenericArgs(e.elements.get(i), a, unresolved);
        i = i + 1;
    }
    i = 0;
    while (i < e.entries.len) {
        upgradeExprGenericArgs(e.entries.get(i), a, unresolved);
        i = i + 1;
    }
    i = 0;
    while (i < e.parts.len) {
        upgradeExprGenericArgs(e.parts.get(i), a, unresolved);
        i = i + 1;
    }
}

/* Register a concrete generic instance (deduped, in discovery order), while
 * filtering only the type-parameter names that are unresolved in this lexical
 * template. A declared one-letter class is therefore never mistaken for T. */
void registerGenericInstance(Node? t, Analyzed a) {
    Map<string, bool> unresolved = {};
    registerGenericInstanceWithUnresolved(t, a, unresolved);
}

void registerGenericInstanceWithUnresolved(
        Node? t, Analyzed a, Map<string, bool> unresolved) {
    if (t == null) { return; }
    if (t.generic_args.len == 0) { return; }
    string base = t.base;
    if (a.genericClassTable.has(base)) {
        validateGenericClassSpecialization(t, a);
    }
    if (a.genericClassTable.has(base)
            && !typeReferencesNames(t, unresolved)) {
        /* By this point class-typed args have been upgraded to pointers in the
         * AST by upgradeProgramGenericArgs, so the mangled name carries the
         * `_p1` suffix and the per-instance type map resolves T to a pointer. */
        string mangled = mangleGenericType(base, t.generic_args);
        string key = genericInstanceKey(base, t.generic_args);
        if (!a.genericSeen.has(key)) {
            a.genericSeen.put(key, true);
            a.genericInstances.push(GenInstance(base, t.generic_args, mangled));
        }
    }
    /* Even when the outer shape is unresolved, a concrete nested argument is
     * independently registerable and must not be lost. */
    int i = 0;
    while (i < t.generic_args.len) {
        registerGenericInstanceWithUnresolved(
            t.generic_args.get(i), a, unresolved);
        i = i + 1;
    }
}

/* Walk a top-level declaration for generic instances (param/return/field types
 * and statement bodies). */
void collectGenericsDecl(Node d, Analyzed a) {
    if (d.kind == NK_FUNCTION_DECL) {
        Map<string, bool> unresolved = typeParameterSet(d.generic_params);
        int i = 0;
        while (i < d.params.len) {
            registerGenericInstanceWithUnresolved(
                d.params.get(i).type, a, unresolved);
            i = i + 1;
        }
        registerGenericInstanceWithUnresolved(d.return_type, a, unresolved);
        if (d.body_node != null) {
            collectGenericsBlock(d.body_node, a, unresolved);
        }
    } else if (d.kind == NK_CLASS_DECL) {
        /* Field/method/property types of NON-generic classes can mention generic
         * instances; generic class members are templated (their T-typed members
         * resolve per instance, not here). */
        if (d.generic_params.len == 0) {
            Map<string, bool> none = {};
            int i = 0;
            while (i < d.members.len) {
                Node mem = d.members.get(i);
                if (mem.kind == NK_FIELD_DECL || mem.kind == NK_PROPERTY_DECL) {
                    registerGenericInstanceWithUnresolved(mem.type, a, none);
                } else if (mem.kind == NK_METHOD_DECL) {
                    Map<string, bool> unresolved =
                        typeParameterSet(mem.generic_params);
                    int p = 0;
                    while (p < mem.params.len) {
                        registerGenericInstanceWithUnresolved(
                            mem.params.get(p).type, a, unresolved);
                        p = p + 1;
                    }
                    registerGenericInstanceWithUnresolved(
                        mem.return_type, a, unresolved);
                    if (mem.body_node != null) {
                        collectGenericsBlock(mem.body_node, a, unresolved);
                    }
                }
                i = i + 1;
            }
        }
    }
}

/* Walk a block's statements for generic-instance-bearing types/exprs. */
void collectGenericsBlock(Node block, Analyzed a,
                          Map<string, bool> unresolved) {
    if (block == null) { return; }
    int i = 0;
    while (i < block.statements.len) {
        collectGenericsStmt(block.statements.get(i), a, unresolved);
        i = i + 1;
    }
}

void collectGenericsStmt(Node s, Analyzed a,
                         Map<string, bool> unresolved) {
    if (s == null) { return; }
    if (s.kind == NK_VAR_DECL_STMT) {
        registerGenericInstanceWithUnresolved(s.type, a, unresolved);
        collectGenericsExpr(s.initializer, a, unresolved);
    } else if (s.kind == NK_RETURN_STMT) {
        collectGenericsExpr(s.value_node, a, unresolved);
    } else if (s.kind == NK_EXPR_STMT) {
        collectGenericsExpr(s.expr, a, unresolved);
    } else if (s.kind == NK_IF_STMT) {
        collectGenericsExpr(s.condition, a, unresolved);
        collectGenericsBlock(s.then_block, a, unresolved);
        if (s.else_block != null) {
            collectGenericsStmt(s.else_block, a, unresolved);
        }
    } else if (s.kind == NK_ELSE_BLOCK) {
        collectGenericsBlock(s.body_node, a, unresolved);
    } else if (s.kind == NK_ELSE_IF) {
        collectGenericsStmt(s.if_stmt, a, unresolved);
    } else if (s.kind == NK_WHILE_STMT || s.kind == NK_DO_WHILE_STMT) {
        collectGenericsExpr(s.condition, a, unresolved);
        collectGenericsBlock(s.body_node, a, unresolved);
    } else if (s.kind == NK_C_FOR_STMT) {
        if (s.init != null) {
            if (s.init.kind == NK_FOR_INIT_VAR) {
                collectGenericsStmt(s.init.var_decl, a, unresolved);
            } else if (s.init.kind == NK_FOR_INIT_EXPR) {
                collectGenericsExpr(s.init.expression, a, unresolved);
            }
        }
        collectGenericsExpr(s.condition, a, unresolved);
        collectGenericsExpr(s.update, a, unresolved);
        collectGenericsBlock(s.body_node, a, unresolved);
    } else if (s.kind == NK_DELETE_STMT) {
        collectGenericsExpr(s.expr, a, unresolved);
    } else if (s.kind == NK_TRY_CATCH_STMT) {
        if (s.try_block != null) {
            collectGenericsBlock(s.try_block, a, unresolved);
        }
        if (s.catch_block != null) {
            collectGenericsBlock(s.catch_block, a, unresolved);
        }
        if (s.finally_block != null) {
            collectGenericsBlock(s.finally_block, a, unresolved);
        }
    } else if (s.kind == NK_SWITCH_STMT) {
        collectGenericsExpr(s.value_node, a, unresolved);
        int ci = 0;
        while (ci < s.cases.len) {
            Node c = s.cases.get(ci);
            collectGenericsExpr(c.value_node, a, unresolved);
            int cj = 0;
            while (cj < c.body_nlist.len) {
                collectGenericsStmt(c.body_nlist.get(cj), a, unresolved);
                cj = cj + 1;
            }
            ci = ci + 1;
        }
    } else if (s.kind == NK_BLOCK) {
        collectGenericsBlock(s, a, unresolved);
    }
}

void collectGenericsExpr(Node e, Analyzed a,
                         Map<string, bool> unresolved) {
    if (e == null) { return; }
    if (e.kind == NK_NEW_EXPR) {
        registerGenericInstanceWithUnresolved(e.type, a, unresolved);
    }
    if (e.kind == NK_CAST_EXPR) {
        registerGenericInstanceWithUnresolved(e.target_type, a, unresolved);
    }
    /* Recurse through sub-expressions that can hold a generic-typed expr. */
    collectGenericsExpr(e.callee, a, unresolved);
    collectGenericsExpr(e.left, a, unresolved);
    collectGenericsExpr(e.right, a, unresolved);
    collectGenericsExpr(e.operand, a, unresolved);
    collectGenericsExpr(e.expr, a, unresolved);
    collectGenericsExpr(e.obj, a, unresolved);
    collectGenericsExpr(e.index, a, unresolved);
    collectGenericsExpr(e.condition, a, unresolved);
    collectGenericsExpr(e.true_expr, a, unresolved);
    collectGenericsExpr(e.false_expr, a, unresolved);
    collectGenericsExpr(e.target, a, unresolved);
    collectGenericsExpr(e.value_node, a, unresolved);
    int i = 0;
    while (i < e.args.len) {
        collectGenericsExpr(e.args.get(i), a, unresolved);
        i = i + 1;
    }
}

/* On-demand type inference for an expression node, given a map of in-scope
 * variable name -> declared TypeExpr node. Returns a TypeExpr Node, or null if
 * the type is unknown (mirrors Python's node_types.get returning None). */
Node? inferTypeRaw(Node? node, Analyzed a, Map<string, Node> varTypes) {
    if (node == null) { return null; }
    if (node.kind == NK_INT_LITERAL) { return integerLiteralType(node.raw); }
    if (node.kind == NK_FLOAT_LITERAL) { return floatLiteralType(node.raw); }
    if (node.kind == NK_BOOL_LITERAL) { return makePrimType("bool"); }
    if (node.kind == NK_CHAR_LITERAL) { return makePrimType("char"); }
    if (node.kind == NK_STRING_LITERAL) { return makePrimType("string"); }
    if (node.kind == NK_F_STRING_LITERAL) { return makePrimType("string"); }
    if (node.kind == NK_SIZEOF_EXPR) { return makePrimType("size_t"); }
    if (node.kind == NK_NULL_LITERAL) { return makeSemanticNullType(); }
    if (node.kind == NK_IDENTIFIER) {
        if (node.name == "NULL") { return makeSemanticNullType(); }
        if (varTypes.has(node.name)) { return varTypes.get(node.name); }
        if (a.funcTable.has(node.name)) {
            return argTypeForInference(node, a, varTypes);
        }
        if (a.isEnumValue(node.name)) {
            string owner = a.enumOwnerOf(node.name);
            /* Anonymous-enum constants enter C's ordinary integer namespace;
             * they do not introduce a nominal source type. */
            if (owner == "") { return makePrimType("int"); }
            return makePrimType(owner);
        }
        /* Standard stream objects are opaque FILE pointers. The reference
         * analyzer records this type too; preserving it here lets structured
         * call sequencing hoist stderr/stdout/stdin without inventing a C11
         * typeof fallback or mistaking the operand for a managed value. */
        if (node.name == "stdin" || node.name == "stdout"
                || node.name == "stderr") {
            Node streamType = makePrimType("FILE");
            streamType.pointer_depth = 1;
            return streamType;
        }
        if (node.name == "__func__") {
            Node functionNameType = makePrimType("char");
            functionNameType.pointer_depth = 1;
            functionNameType.is_const = true;
            return functionNameType;
        }
        Node? predefinedType = cPredefinedIdentifierType(node.name);
        if (predefinedType != null) { return predefinedType; }
        if (isCOpaqueValueIdentifier(node.name)) { return null; }
        if (isCIntegerIdentifier(node.name)) { return makePrimType("int"); }
        return null;
    }
    if (node.kind == NK_BINARY_EXPR) {
        Node? leftType = inferSpecializationType(node.left, a, varTypes);
        Node? rightType = inferSpecializationType(node.right, a, varTypes);
        Node? overloaded = operatorOverloadReturnType(
            leftType, node.op, false, a);
        if (overloaded != null) { return overloaded; }
        /* Comparison/logical ops yield bool. Arithmetic follows the shared,
         * operand-order-independent numeric contract. */
        if (isComparisonOp(node.op)) { return makePrimType("bool"); }
        Node? pointerType = operatorPointerArithmeticType(
            leftType, rightType, node.op, a);
        if (pointerType != null) { return pointerType; }
        Node? numericType = numericResultType(leftType, rightType, a);
        if (numericType != null) { return numericType; }
        if (leftType != null) { return leftType; }
        return rightType;
    }
    if (node.kind == NK_ASSIGN_EXPR) {
        return inferSpecializationType(node.target, a, varTypes);
    }
    if (node.kind == NK_UNARY_EXPR) {
        Node? declaredOperandType = inferTypeRaw(
            node.operand, a, varTypes);
        Node? operandType = inferSpecializationType(
            node.operand, a, varTypes);
        if (operandType == null) { return null; }
        if (node.op == "!") { return makePrimType("bool"); }
        if (node.op == "&") {
            if (node.operand != null
                    && node.operand.kind == NK_IDENTIFIER
                    && a.funcTable.has(node.operand.name)
                    && !varTypes.has(node.operand.name)) {
                return operandType;
            }
            Node addressed = typeWithoutOuterArray(operandType);
            return typeWithOuterPointer(addressed);
        }
        if (node.op == "*") {
            if (operandType.is_array || operandType.pointer_depth > 0) {
                Node? preserved = typeWithoutOuterStorageThroughTypedef(
                    declaredOperandType, a.typedefTable);
                if (preserved != null) { return preserved; }
                if (operandType.is_array) {
                    return typeWithoutOuterArray(operandType);
                }
                return typeWithoutOuterPointers(operandType, 1);
            }
        }
        Node? overloaded = operatorOverloadReturnType(
            operandType, node.op, true, a);
        if (overloaded != null) { return overloaded; }
        return operandType;
    }
    if (node.kind == NK_SELF_EXPR) {
        if (varTypes.has("self")) { return varTypes.get("self"); }
        return null;
    }
    if (node.kind == NK_SUPER_EXPR) {
        if (!varTypes.has("self")) { return null; }
        Node selfType = varTypes.get("self");
        if (!a.classTable.has(selfType.base)) { return null; }
        string parent = parentName(a.classTable.get(selfType.base));
        if (parent == "") { return null; }
        return classPtrType(makeClassTypeExpr(parent));
    }
    if (node.kind == NK_NEW_EXPR) {
        /* Thread<T> and Mutex<T> are already source-level opaque handles.
         * Unlike user classes, their TypeExpr must not gain an additional
         * pointer depth during inference. Mirrors TypeInferencer._infer_type. */
        if (node.type.base == "Thread" || node.type.base == "Mutex") {
            return node.type;
        }
        return classPtrType(node.type);
    }
    if (node.kind == NK_FIELD_ACCESS_EXPR) {
        /* A class-qualified field is translation-unit storage, but its value
         * still has the declaration's type.  Nested projections and managed
         * static replacement both rely on this result. */
        if (node.obj != null && node.obj.kind == NK_IDENTIFIER
                && a.isClass(node.obj.name)) {
            Node? staticMember = a.classMember(
                node.obj.name, node.field);
            if (staticMember != null
                    && staticMember.kind == NK_FIELD_DECL
                    && staticMember.access == "class") {
                return staticMember.type;
            }
        }
        if (node.obj != null && node.obj.kind == NK_IDENTIFIER
                && a.isEnum(node.obj.name)
                && a.enumContains(node.obj.name, node.field)) {
            return makePrimType(node.obj.name);
        }
        Node? ot = inferSpecializationType(node.obj, a, varTypes);
        if (ot != null && ot.base == "Tuple") {
            int tupleIndex = tupleFieldIndex(node.field);
            if (tupleIndex >= 0 && tupleIndex < ot.generic_args.len) {
                return ot.generic_args.get(tupleIndex);
            }
            return null;
        }
        /* Rich-enum field access: `s.tag` is int; any other direct field of a
         * rich enum (the `data` union) has no scalar type. Mirrors
         * type_inference._infer_field_access_type's rich_enum_table branch. */
        if (ot != null && a.isRichEnum(ot.base)) {
            if (node.field == "tag") { return makePrimType("int"); }
            return null;
        }
        /* Rich-enum payload field: `s.data.<Variant>.<field>` resolves to the
         * variant param's declared type (so the f-string interp picks the right
         * format and the arrow decision sees a class-pointer payload). Mirrors
         * type_inference._infer_field_access_type's nested rich_enum branch. */
        if (node.obj != null && node.obj.kind == NK_FIELD_ACCESS_EXPR
                && node.obj.obj != null
                && node.obj.obj.kind == NK_FIELD_ACCESS_EXPR) {
            Node dataExpr = node.obj.obj;
            Node? sType = inferSpecializationType(
                dataExpr.obj, a, varTypes);
            if (sType != null && a.isRichEnum(sType.base)) {
                Node reDecl = a.richEnumTable.get(sType.base);
                string variantName = node.obj.field;
                int vi = 0;
                while (vi < reDecl.variants.len) {
                    Node v = reDecl.variants.get(vi);
                    if (v.name == variantName) {
                        int pi = 0;
                        while (pi < v.params.len) {
                            Node par = v.params.get(pi);
                            if (par.name == node.field) { return par.type; }
                            pi = pi + 1;
                        }
                    }
                    vi = vi + 1;
                }
            }
        }
        if (ot != null && a.isClass(ot.base)) {
            Node? fm = a.classMember(ot.base, node.field);
            if (fm != null && fm.kind == NK_FIELD_DECL) { return fm.type; }
            if (fm != null && fm.kind == NK_PROPERTY_DECL) { return fm.type; }
        }
        /* Generic instance field access: resolve the field type via the type map. */
        if (ot != null && ot.generic_args.len > 0 && a.isGenericClass(ot.base)) {
            Node? fm = genericMember(a, ot.base, node.field);
            if (fm != null && (fm.kind == NK_FIELD_DECL || fm.kind == NK_PROPERTY_DECL)) {
                return resolveGenericType(
                    fm.type, genericTypeMap(a, ot), a);
            }
        }
        Node? nativeField = structFieldType(ot, node.field, a);
        if (nativeField != null) { return nativeField; }
        return null;
    }
    if (node.kind == NK_CALL_EXPR) {
        Node callee = node.callee;
        if (callee != null && callee.kind == NK_LAMBDA_EXPR) {
            Node callableType = lambdaFnPtrType(callee, a, varTypes);
            if (callableType.generic_args.len > 0) {
                return callableType.generic_args.get(0);
            }
        }
        Node? callableCallee = directFunctionPointerSpecializationType(
            inferSpecializationType(callee, a, varTypes), a);
        if (callableCallee != null) {
            return callableCallee.generic_args.get(0);
        }
        if (callee != null && callee.kind == NK_IDENTIFIER) {
            if (varTypes.has(callee.name)) { return null; }
            string constructorKey = astNodeKey(node);
            if (a.genericConstructorTypes.has(constructorKey)) {
                return a.genericConstructorTypes.get(constructorKey);
            }
            if (callee.name == "__btrc_hash") { return makePrimType("uint"); }
            if (callee.name == "__btrc_eq" || callee.name == "__btrc_lt"
                    || callee.name == "__btrc_gt") {
                return makePrimType("bool");
            }
            if (callee.name == "__btrc_str_track"
                    || callee.name == "__btrc_string_adopt"
                    || callee.name == "__btrc_string_alloc") {
                return makePrimType("string");
            }
            string hostedCallKey = astNodeKey(node);
            if (a.funcRetTypes.has(callee.name)
                    && !a.hostedCallKeys.has(hostedCallKey)) {
                return a.funcRetTypes.get(callee.name);
            }
            Node? hostedResult = hostedAbiSemanticResultType(callee.name);
            if (hostedResult != null) { return hostedResult; }
            /* Builtin Mutex(value) infers the exact payload type. Keep this in
             * semantic inference (matching the reference compiler) so ownership
             * boundaries and every other consumer see a typed handle instead of
             * falling back to an integer C temporary. */
            if (callee.name == "Mutex" && node.args.len > 0) {
                Node mutexType = makePrimType("Mutex");
                Node? argumentType = inferSpecializationType(
                    node.args.get(0), a, varTypes);
                if (argumentType == null) {
                    argumentType = makePrimType("int");
                } else if ((a.isClass(argumentType.base)
                            || a.isGenericClass(argumentType.base))
                        && argumentType.pointer_depth == 0) {
                    /* Local scope tables preserve the source spelling of an
                     * outer class type, while declaration normalization eagerly
                     * records class-typed generic arguments as pointers.  A
                     * Mutex payload is an expression value, so give an inferred
                     * bare class the same heap-reference shape used by the
                     * reference compiler before embedding it in Mutex<T>. */
                    argumentType = classPtrType(argumentType);
                }
                mutexType.generic_args.push(argumentType);
                return mutexType;
            }
            if (a.isGenericClass(callee.name)) {
                return inferGenericConstructorCallType(
                    node, callee.name, a, varTypes);
            }
            /* Constructor call ClassName(...) yields a class-instance pointer. */
            if (a.isClass(callee.name)) {
                return classPtrType(makeClassTypeExpr(callee.name));
            }
        }
        if (callee != null && callee.kind == NK_FIELD_ACCESS_EXPR) {
            string method = callee.field;
            /* A rich-enum variant constructor is a namespaced free function
             * whose value has the enum type. Keep this in the shared
             * specialization inference path so call-boundary result slots and
             * generic-body consumers use the same resolved target. */
            if (callee.obj != null
                    && callee.obj.kind == NK_IDENTIFIER
                    && !varTypes.has(callee.obj.name)
                    && semanticResolveRichEnumVariant(
                        callee.obj.name, method, a) != null) {
                return makePrimType(callee.obj.name);
            }
            /* Static method call ClassName.method(...) */
            if (callee.obj != null && callee.obj.kind == NK_IDENTIFIER
                    && !varTypes.has(callee.obj.name)
                    && a.isClass(callee.obj.name)) {
                Node? sm = a.classMethod(callee.obj.name, method);
                if (sm != null && sm.kind == NK_METHOD_DECL) { return sm.return_type; }
            }
            /* Instance method call obj.method(...) */
            Node? ot = inferSpecializationType(
                callee.obj, a, varTypes);
            if (ot != null && method == "toString"
                    && ot.pointer_depth == 0 && !ot.is_array
                    && ot.generic_args.len == 0
                    && (numericIsType(ot, a) || ot.base == "bool"
                        || a.isEnum(ot.base)
                        || a.isRichEnum(ot.base))) {
                return makePrimType("string");
            }
            /* Builtin string method: return type from the shared spec. */
            if (isStringType(ot)) {
                Node? srt = stringMethodReturnType(method);
                if (srt != null) { return srt; }
            }
            /* Thread<T>.join() -> T, Mutex<T>.get() -> T, Mutex<T>.set/destroy ->
             * void (mirrors type_inference's Thread/Mutex CallExpr branches). The
             * payload type drives the arrow decision when a Mutex stores a class
             * instance (e.g. mb.get().v must emit `->v`, not `.v`). */
            if (ot != null && ot.base == "Thread" && ot.generic_args.len > 0) {
                if (method == "join") { return ot.generic_args.get(0); }
            }
            if (ot != null && ot.base == "Mutex" && ot.generic_args.len > 0) {
                if (method == "get") { return ot.generic_args.get(0); }
                if (method == "set" || method == "destroy") { return makePrimType("void"); }
            }
            if (ot != null && a.isClass(ot.base)) {
                Node? mm = a.classMethod(ot.base, method);
                if (mm != null && mm.kind == NK_METHOD_DECL) {
                    Map<string, Node> noClassArgs = {};
                    return resolveGenericType(
                        mm.return_type,
                        methodCallTypeMap(a, node, mm, noClassArgs),
                        a);
                }
                if (mm != null && mm.kind == NK_PROPERTY_DECL) { return mm.type; }
            }
            /* Generic instance method call: resolve return type via type map. */
            if (ot != null && ot.generic_args.len > 0 && a.isGenericClass(ot.base)) {
                Node? mm = a.genericClassMethod(ot.base, method);
                if (mm != null && mm.kind == NK_METHOD_DECL) {
                    Map<string, Node> classArgs = genericTypeMap(a, ot);
                    return resolveGenericType(
                        mm.return_type,
                        methodCallTypeMap(a, node, mm, classArgs),
                        a);
                }
                if (mm != null && mm.kind == NK_PROPERTY_DECL) {
                    return resolveGenericType(
                        mm.type, genericTypeMap(a, ot), a);
                }
            }
        }
        return null;
    }
    if (node.kind == NK_INDEX_EXPR) {
        Node? declaredObjectType = inferTypeRaw(
            node.obj, a, varTypes);
        Node? ot = resolveOuterTypedefType(
            declaredObjectType, a.typedefTable);
        if (ot != null && (ot.is_array
                || semanticRawIndexedPointer(ot, a))) {
            Node? preserved = typeWithoutOuterStorageThroughTypedef(
                declaredObjectType, a.typedefTable);
            if (preserved != null) { return preserved; }
        }
        return semanticIndexResultType(ot, a);
    }
    if (node.kind == NK_CAST_EXPR) { return node.target_type; }
    if (node.kind == NK_TERNARY_EXPR) {
        Node? trueType = inferSpecializationType(
            node.true_expr, a, varTypes);
        Node? falseType = inferSpecializationType(
            node.false_expr, a, varTypes);
        Node? numericType = numericResultType(trueType, falseType, a);
        if (numericType != null) { return numericType; }
        if (semanticIsNullType(trueType) && falseType != null) {
            return falseType;
        }
        if (semanticIsNullType(falseType) && trueType != null) {
            return trueType;
        }
        if (trueType != null) { return trueType; }
        return falseType;
    }
    if (node.kind == NK_LIST_LITERAL) {
        if (node.elements.len > 0) {
            Node? et = inferSpecializationType(
                node.elements.get(0), a, varTypes);
            if (et != null) {
                Node elementType = et;
                if ((a.isClass(et.base) || a.isGenericClass(et.base))
                        && et.pointer_depth == 0) {
                    elementType = classPtrType(et);
                }
                Node u = Node();
                u.kind = NK_TYPE_EXPR;
                u.base = "Vector";
                Vector<Node> ga = [];
                ga.push(elementType);
                u.generic_args = ga;
                return u;
            }
        }
        return null;
    }
    if (node.kind == NK_LAMBDA_EXPR) {
        return lambdaFnPtrType(node, a, varTypes);
    }
    if (node.kind == NK_SPAWN_EXPR) {
        /* spawn(callable) yields Thread<T> where T is the callable's return type
         * (mirrors expressions._infer_spawn_return_type / type_inference's
         * SpawnExpr branch). A lambda's return type is its annotation or the
         * inferred body return type (lambdaFnPtrType's arg[0]); a non-lambda
         * function-pointer operand contributes void. */
        Node ret = makePrimType("void");
        Node fn = node.fn;
        if (fn != null && fn.kind == NK_LAMBDA_EXPR) {
            Node fpt = lambdaFnPtrType(fn, a, varTypes);
            if (fpt.generic_args.len > 0) { ret = fpt.generic_args.get(0); }
        } else if (fn != null) {
            Node? fnt = inferSpecializationType(fn, a, varTypes);
            if (fnt != null && fnt.base == "__fn_ptr" && fnt.generic_args.len > 0) {
                ret = fnt.generic_args.get(0);
            }
        }
        Node u = Node();
        u.kind = NK_TYPE_EXPR;
        u.base = "Thread";
        Vector<Node> tga = [];
        tga.push(ret);
        u.generic_args = tga;
        return u;
    }
    if (node.kind == NK_TUPLE_LITERAL) {
        /* A tuple literal's type is Tuple<T0, T1, ...> built from each element's
         * inferred type. Needed so a nested tuple element (e.g. the (string,bool)
         * inside (int,(string,bool))) mangles to the right struct name rather
         * than falling back to int. Element fallback is int to match the
         * lowerTupleLiteral fallback. */
        Node u = Node();
        u.kind = NK_TYPE_EXPR;
        u.base = "Tuple";
        Vector<Node> ga = [];
        int ti = 0;
        while (ti < node.elements.len) {
            Node? et = inferSpecializationType(
                node.elements.get(ti), a, varTypes);
            if (et == null) { et = makePrimType("int"); }
            ga.push(copyTypeExprTree(et));
            ti = ti + 1;
        }
        u.generic_args = ga;
        /* Declared aggregate types eagerly normalize nested class references
         * to their concrete pointer shape.  Inferred symbol types keep the
         * source spelling for an outer class, so normalize these copied tuple
         * arguments before invariant generic comparison.  The recursive copy
         * avoids mutating the symbol table while handling nested tuples. */
        upgradeConcreteTypeGenericArgs(u, a);
        return u;
    }
    return null;
}

Node? inferType(Node? node, Analyzed a, Map<string, Node> varTypes) {
    return resolveTypedefType(
        inferTypeRaw(node, a, varTypes), a.typedefTable);
}

/* Match the reference analyzer's stored expression-type domain: expand the
 * alias naming the value itself, but retain aliases nested in generic
 * arguments so IR symbol selection agrees with generic-instance collection. */
Node? inferSpecializationTypeUnmemoized(
        Node? node, Analyzed a, Map<string, Node> varTypes) {
    return resolveOuterTypedefType(
        inferTypeRaw(node, a, varTypes), a.typedefTable);
}

Node? directFunctionPointerType(Node? typeExpr, Analyzed a) {
    Node? resolved = resolveTypedefType(typeExpr, a.typedefTable);
    if (resolved == null || resolved.base != "__fn_ptr"
            || resolved.pointer_depth != 0 || resolved.is_array
            || resolved.generic_args.len == 0) {
        return null;
    }
    return resolved;
}

/* Callable shape for expression inference. The outer alias may name the
 * callback itself, but aliases inside its result/parameter list remain source
 * identities until a consumer explicitly requests canonical ABI types. */
Node? directFunctionPointerSpecializationType(
        Node? typeExpr, Analyzed a) {
    Node? resolved = resolveOuterTypedefType(
        typeExpr, a.typedefTable);
    if (resolved == null || resolved.base != "__fn_ptr"
            || resolved.pointer_depth != 0 || resolved.is_array
            || resolved.generic_args.len == 0) {
        return null;
    }
    return resolved;
}

/* Infer the __fn_ptr(ret, params...) TypeExpr for a lambda expression so that
 * `var f = lambda` declares `f` with the right typedef'd C type. The return
 * type is the lambda's explicit annotation, or inferred from its expression
 * body, or "void" for a block body without annotation (mirrors lambdas.py's
 * return-type resolution + the analyzer storing the lambda type as __fn_ptr). */
Node lambdaFnPtrType(Node node, Analyzed a, Map<string, Node> varTypes) {
    Node u = Node();
    u.kind = NK_TYPE_EXPR;
    u.base = "__fn_ptr";
    Vector<Node> ga = [];
    /* arg[0] is the explicit or structurally inferred return type. */
    Node ret = inferredLambdaReturnType(node, a, varTypes);
    if ((a.isClass(ret.base) || a.isGenericClass(ret.base))
            && ret.pointer_depth == 0 && !ret.is_array) {
        ret = classPtrType(ret);
    }
    ga.push(ret);
    /* arg[1..] = parameter types. */
    int i = 0;
    while (i < node.params.len) {
        Node p = node.params.get(i);
        if (p.type != null) { ga.push(p.type); }
        else { ga.push(makePrimType("int")); }
        i = i + 1;
    }
    u.generic_args = ga;
    return u;
}

/* Walk an AST subtree and collect all Identifier names into `names` (value
 * always true). Mirrors analyzer._collect_identifiers: an Identifier adds its
 * name and stops; otherwise every Node-typed and Vector<Node>-typed child field
 * is visited recursively. Used by lambda lowering to compute captures. */
void collectIdentifiers(Node? n, Map<string, bool> names) {
    if (n == null) { return; }
    if (n.kind == NK_IDENTIFIER) {
        names.put(n.name, true);
        return;
    }
    if (n.kind == NK_SELF_EXPR || n.kind == NK_SUPER_EXPR) {
        names.put("self", true);
        return;
    }
    /* Node-typed scalar children. */
    collectIdentifiers(n.spec, names);
    collectIdentifiers(n.return_type, names);
    collectIdentifiers(n.body_node, names);
    collectIdentifiers(n.original, names);
    collectIdentifiers(n.array_size, names);
    collectIdentifiers(n.type, names);
    collectIdentifiers(n.default_, names);
    collectIdentifiers(n.initializer, names);
    collectIdentifiers(n.getter_body, names);
    collectIdentifiers(n.setter_body, names);
    collectIdentifiers(n.value_node, names);
    collectIdentifiers(n.condition, names);
    collectIdentifiers(n.then_block, names);
    collectIdentifiers(n.else_block, names);
    collectIdentifiers(n.iterable, names);
    collectIdentifiers(n.init, names);
    collectIdentifiers(n.update, names);
    collectIdentifiers(n.expr, names);
    collectIdentifiers(n.try_block, names);
    collectIdentifiers(n.catch_type, names);
    collectIdentifiers(n.catch_block, names);
    collectIdentifiers(n.finally_block, names);
    collectIdentifiers(n.if_stmt, names);
    collectIdentifiers(n.var_decl, names);
    collectIdentifiers(n.expression, names);
    collectIdentifiers(n.left, names);
    collectIdentifiers(n.right, names);
    collectIdentifiers(n.operand, names);
    collectIdentifiers(n.callee, names);
    collectIdentifiers(n.obj, names);
    collectIdentifiers(n.index, names);
    collectIdentifiers(n.target_type, names);
    collectIdentifiers(n.true_expr, names);
    collectIdentifiers(n.false_expr, names);
    collectIdentifiers(n.target, names);
    collectIdentifiers(n.fn, names);
    collectIdentifiers(n.key, names);
    /* Vector<Node> children. */
    collectIdentifiersList(n.members, names);
    collectIdentifiersList(n.methods, names);
    collectIdentifiersList(n.params, names);
    collectIdentifiersList(n.fields, names);
    collectIdentifiersList(n.values, names);
    collectIdentifiersList(n.variants, names);
    collectIdentifiersList(n.generic_args, names);
    collectIdentifiersList(n.statements, names);
    collectIdentifiersList(n.cases, names);
    collectIdentifiersList(n.args, names);
    collectIdentifiersList(n.elements, names);
    collectIdentifiersList(n.entries, names);
    collectIdentifiersList(n.parts, names);
    collectIdentifiersList(n.captures, names);
    collectIdentifiersList(n.body_nlist, names);
}

void collectIdentifiersList(Vector<Node> xs, Map<string, bool> names) {
    int i = 0;
    while (i < xs.len) {
        collectIdentifiers(xs.get(i), names);
        i = i + 1;
    }
}

/* Substitute generic type parameters in a TypeExpr using a param-name -> concrete
 * TypeExpr map. Mirrors generics.core._resolve_type. Combines pointer depths when
 * a T* member is resolved against a pointer concrete type. */
bool genericSubstitutionReferenceShape(Node typeExpr, Analyzed analyzed) {
    return typeResolvedReferenceShape(typeExpr)
        || analyzed.isClass(typeExpr.base)
        || analyzed.isGenericClass(typeExpr.base);
}

Node resolveGenericType(Node? t, Map<string, Node> typeMap,
                        Analyzed analyzed) {
    if (t == null) { return makePrimType("void"); }
    if (typeMap.has(t.base) && t.generic_args.len == 0) {
        Node resolved = typeMap.get(t.base);
        Node referenceShape = resolved;
        Node? canonical = resolveOuterTypedefType(
            resolved, analyzed.typedefTable);
        if (canonical != null) { referenceShape = canonical; }
        if (t.is_array && referenceShape.is_array) {
            typeShapeFail("nested array composition for type parameter '"
                + t.base + "' is not supported");
        }
        return composeTypeExpr(t, resolved,
            genericSubstitutionReferenceShape(referenceShape, analyzed));
    }
    if (t.generic_args.len > 0) {
        Node u = Node();
        u.kind = NK_TYPE_EXPR;
        u.base = t.base;
        Vector<Node> ra = [];
        int i = 0;
        while (i < t.generic_args.len) {
            ra.push(resolveGenericType(
                t.generic_args.get(i), typeMap, analyzed));
            i = i + 1;
        }
        u.generic_args = ra;
        u.pointer_depth = t.pointer_depth;
        u.is_array = t.is_array;
        u.array_size = t.array_size;
        u.is_const = t.is_const;
        u.is_nullable = t.is_nullable;
        u.nullable_outer_depth = t.nullable_outer_depth;
        u.is_static = t.is_static;
        u.is_extern = t.is_extern;
        u.is_volatile = t.is_volatile;
        u.line = t.line;
        u.col = t.col;
        return u;
    }
    return t;
}

/* Build a {generic-param-name -> concrete-arg-type} map for a generic instance
 * type (e.g. Box<int> with params [T] -> {T: int}). */
Map<string, Node> genericTypeMap(Analyzed a, Node instanceType) {
    Map<string, Node> tm = {};
    if (!a.genericClassTable.has(instanceType.base)) { return tm; }
    Node decl = a.genericClassTable.get(instanceType.base);
    int i = 0;
    while (i < decl.generic_params.len && i < instanceType.generic_args.len) {
        tm.put(decl.generic_params.get(i), instanceType.generic_args.get(i));
        i = i + 1;
    }
    return tm;
}

/* Merge receiver-class and per-call method substitutions for semantic return
 * inference. Generic-method instance collection records the latter by call
 * identity; leaving them out here exposes an unresolved `U` even though IR
 * generation already targets the correct monomorphized method. */
Map<string, Node> methodCallTypeMap(Analyzed a, Node call, Node method,
        Map<string, Node> classArguments) {
    Map<string, Node> substitutions = {};
    Vector<string> classNames = classArguments.keys();
    int classIndex = 0;
    while (classIndex < classNames.len) {
        string name = classNames.get(classIndex);
        substitutions.put(name, classArguments.get(name));
        classIndex = classIndex + 1;
    }
    string callKey = astNodeKey(call);
    if (!a.methodGenCallArgs.has(callKey)) { return substitutions; }
    Vector<Node> methodArguments = a.methodGenCallArgs.get(callKey);
    int methodIndex = 0;
    while (methodIndex < method.generic_params.len
            && methodIndex < methodArguments.len) {
        substitutions.put(method.generic_params.get(methodIndex),
            methodArguments.get(methodIndex));
        methodIndex = methodIndex + 1;
    }
    return substitutions;
}

/* Find a member (field/method/property) in a generic class decl by name. */
Node? genericMember(Analyzed a, string base, string member) {
    a.requireMemberIndex();
    string key = analyzedMemberIndexKey(base, member);
    if (a.genericMemberIndex.has(key)) {
        return a.genericMemberIndex.get(key);
    }
    return null;
}

/* A bare class TypeExpr (pointer_depth 0) for class `name`. */
Node makeClassTypeExpr(string name) {
    Node t = Node();
    t.kind = NK_TYPE_EXPR;
    t.base = name;
    return t;
}

/* Class instance type as the analyzer sees it: pointer_depth 1 (classes are
 * always heap-allocated). Mirrors _upgrade_class_type. Generic args / array /
 * nullable carry over; line/col are irrelevant for inference. */
Node classPtrType(Node? t) {
    if (t == null) { return makePrimType("void"); }
    Node u = Node();
    u.kind = NK_TYPE_EXPR;
    u.base = t.base;
    u.generic_args = t.generic_args;
    u.pointer_depth = 1;
    u.is_array = t.is_array;
    u.is_nullable = t.is_nullable;
    u.nullable_outer_depth = t.nullable_outer_depth;
    return u;
}

/* Upgrade class-typed GENERIC ARGUMENTS in a TypeExpr IN PLACE so they become
 * pointers (mirrors the reference's _upgrade_class_type, which raises any
 * class_table base — regular OR generic — to pointer_depth 1, recursing through
 * generic args). After this runs, a `Vector<OwnedItem>`'s arg is `OwnedItem*`
 * and a `Vector<Vector<int>>`'s arg is `Vector<int>*`, so:
 *   - the mangled name carries the `_p1` suffix (`btrc_Vector_OwnedItem_p1`),
 *   - the per-instance type map resolves `T` to a pointer (so `T* data` -> `**`).
 * The OUTER class type is left at its source pointer_depth — typeToC applies the
 * class pointer lazily there; only nested args need the eager AST upgrade so the
 * mangled name and field types agree everywhere. */
void upgradeConcreteTypeGenericArgs(Node? t, Analyzed a) {
    Map<string, bool> unresolved = {};
    upgradeTypeGenericArgs(t, a, unresolved);
}

void upgradeTypeGenericArgs(Node? t, Analyzed a,
                            Map<string, bool> unresolved) {
    if (t == null) { return; }
    int i = 0;
    while (i < t.generic_args.len) {
        Node arg = t.generic_args.get(i);
        /* Recurse into the arg's own generic args first. */
        upgradeTypeGenericArgs(arg, a, unresolved);
        /* A class instance (regular or generic) is a heap pointer: a bare
         * (depth-0) class-typed arg gains one pointer level. A lexically
         * shadowing type parameter is never reinterpreted as a global class. */
        if (!unresolved.has(arg.base)
                && (a.isClass(arg.base) || a.isGenericClass(arg.base))
                && arg.pointer_depth == 0) {
            arg.pointer_depth = 1;
        }
        i = i + 1;
    }
}

/* --- small TypeExpr helpers --- */

Node makePrimType(string base) {
    Node t = Node();
    t.kind = NK_TYPE_EXPR;
    t.base = base;
    return t;
}

/* Supported unresolved C integer seam. Mirrors c_call_types.py exactly:
 * errno and all-uppercase identifiers (with digits/underscores allowed) are
 * treated as integer-valued C macros. At least one uppercase letter is needed,
 * matching Python str.isupper(). */
bool isCIntegerIdentifier(string name) {
    if (name == "errno") { return true; }
    if (name == "" || name == "NULL") { return false; }
    bool sawUpper = false;
    int index = 0;
    while (index < name.length()) {
        char value = name[index];
        if (value >= 'a' && value <= 'z') { return false; }
        if (value >= 'A' && value <= 'Z') { sawUpper = true; }
        index = index + 1;
    }
    return sawUpper;
}

/* Object-like C macros have no safe default ABI.  Keep them unresolved so a
 * typed use site can supply storage shape without silently narrowing through
 * the historical implicit-int seam. */
bool isCOpaqueValueIdentifier(string name) {
    return name != "errno" && isCIntegerIdentifier(name);
}

/* True for the btrc `string` scalar (base "string", no generics, depth 0).
 * Mirrors types.is_string_type. */
bool isStringType(Node? t) {
    return isSemanticScalarString(t);
}

/* Return type of a builtin string method (mirrors type_utils
 * ._string_method_return_type over the shared string_methods spec). Returns null
 * for an unknown method. `split` returns a `string*` (heap list of strings). */
Node? stringMethodReturnType(string method) {
    if (method == "len" || method == "byteLen" || method == "length"
            || method == "charLen" || method == "indexOf" || method == "lastIndexOf"
            || method == "find" || method == "count" || method == "toInt") {
        return makePrimType("int");
    }
    if (method == "equals" || method == "contains" || method == "startsWith"
            || method == "endsWith" || method == "isEmpty" || method == "isBlank"
            || method == "isUpper" || method == "isLower" || method == "isAlnum"
            || method == "isAlnumStr" || method == "isDigit" || method == "isDigitStr"
            || method == "isAlpha" || method == "isAlphaStr" || method == "toBool") {
        return makePrimType("bool");
    }
    if (method == "charAt") { return makePrimType("char"); }
    if (method == "toFloat") { return makePrimType("float"); }
    if (method == "toDouble") { return makePrimType("double"); }
    if (method == "toLong") { return makePrimType("long"); }
    if (method == "trim" || method == "lstrip" || method == "rstrip"
            || method == "toUpper" || method == "toLower" || method == "substring"
            || method == "replace" || method == "repeat" || method == "reverse"
            || method == "capitalize" || method == "title" || method == "swapCase"
            || method == "padLeft" || method == "padRight" || method == "center"
            || method == "zfill" || method == "removePrefix" || method == "removeSuffix"
            ) {
        return makePrimType("string");
    }
    if (method == "split") {
        Node t = Node();
        t.kind = NK_TYPE_EXPR;
        t.base = "string";
        t.pointer_depth = 1;
        return t;
    }
    return null;
}

bool isComparisonOp(string op) {
    return op == "==" || op == "!=" || op == "<" || op == ">"
        || op == "<=" || op == ">=" || op == "&&" || op == "||";
}
