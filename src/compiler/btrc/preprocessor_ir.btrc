/* Validated lowering for the supported source preprocessor subset.
 *
 * The source compiler accepts only single-line includes and object/function
 * macros here.  #pragma pack is consumed separately as struct metadata.  Every
 * other or malformed directive fails before an IR module can be emitted. */

bool preprocessorSpace(char value) {
    return value == ' ' || value == '\t';
}

bool preprocessorIdentifierStart(char value) {
    return typeIdentityAsciiLetter(value) || value == '_';
}

bool preprocessorIdentifierPart(char value) {
    return preprocessorIdentifierStart(value) || typeIdentityAsciiDigit(value);
}

bool preprocessorTrigraphSuffix(char value) {
    return value == '=' || value == '/' || value == '\'' || value == '('
        || value == ')' || value == '!' || value == '<' || value == '>'
        || value == '-';
}

bool containsPreprocessorTrigraph(string value) {
    int index = 0;
    while (index + 2 < value.length()) {
        if (value[index] == '?' && value[index + 1] == '?'
                && preprocessorTrigraphSuffix(value[index + 2])) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

string preprocessorTrimLeft(string value) {
    int start = 0;
    while (start < value.length() && preprocessorSpace(value[start])) {
        start = start + 1;
    }
    return value.substring(start, value.length() - start);
}

string preprocessorTrim(string value) {
    int start = 0;
    int end = value.length();
    while (start < end && preprocessorSpace(value[start])) { start = start + 1; }
    while (end > start && preprocessorSpace(value[end - 1])) { end = end - 1; }
    return value.substring(start, end - start);
}

void preprocessorFail(string message) {
    fprintf(stderr, "error: %s\n", message);
    exit(1);
}

bool validPreprocessorIdentifier(string value) {
    if (value.length() == 0 || !preprocessorIdentifierStart(value[0])) {
        return false;
    }
    int index = 1;
    while (index < value.length()) {
        if (!preprocessorIdentifierPart(value[index])) { return false; }
        index = index + 1;
    }
    return true;
}

bool validIncludeHeader(string header) {
    if (header.length() == 0) { return false; }
    int index = 0;
    while (index < header.length()) {
        char value = header[index];
        int code = (int)(byte)value;
        if (code < 32 || code == 127 || value == '<'
                || value == '>' || value == '"') {
            return false;
        }
        index = index + 1;
    }
    return !containsPreprocessorTrigraph(header);
}

bool sameStructuredInclude(IRPreprocessorDecl left,
        IRPreprocessorDecl right) {
    return left.kind == IR_PREPROCESSOR_INCLUDE
        && right.kind == IR_PREPROCESSOR_INCLUDE
        && left.header == right.header
        && left.is_system == right.is_system;
}

/* Includes are deduplicated at production time so emission is a pure ordered
 * walk. Macros intentionally preserve every source declaration. */
void appendPreprocessorDecl(IRModule module, IRPreprocessorDecl declaration) {
    if (declaration.kind == IR_PREPROCESSOR_INCLUDE) {
        int index = 0;
        while (index < module.preprocessor_decls.len) {
            if (sameStructuredInclude(
                    module.preprocessor_decls.get(index), declaration)) {
                return;
            }
            index = index + 1;
        }
    }
    module.preprocessor_decls.push(declaration);
}

void requireSystemInclude(IRModule module, string header) {
    if (!validIncludeHeader(header)) {
        preprocessorFail("invalid generated include header");
    }
    appendPreprocessorDecl(module, irInclude(header, true));
}

void addStandardPreprocessorDecls(IRModule module) {
    Vector<string> noParams = [];
    appendPreprocessorDecl(module, irMacro(
        "_DEFAULT_SOURCE", false, noParams, ""));
    Vector<string> noParams2 = [];
    appendPreprocessorDecl(module, irMacro(
        "_DARWIN_C_SOURCE", false, noParams2, ""));

    Vector<string> headers = [
        "stdio.h", "stdlib.h", "string.h", "stdbool.h", "stdint.h",
        "ctype.h", "math.h", "assert.h", "limits.h"
    ];
    int index = 0;
    while (index < headers.len) {
        requireSystemInclude(module, headers.get(index));
        index = index + 1;
    }
}

IRPreprocessorDecl parseIncludeDirective(string payload, string source) {
    string value = preprocessorTrim(payload);
    if (value.length() < 3) {
        preprocessorFail("malformed #include directive: " + source);
    }
    char opening = value[0];
    char closing = value[value.length() - 1];
    bool isSystem = opening == '<';
    if ((!isSystem && opening != '"')
            || (isSystem && closing != '>')
            || (!isSystem && closing != '"')) {
        preprocessorFail("malformed #include directive: " + source);
    }
    string header = value.substring(1, value.length() - 2);
    if (!validIncludeHeader(header)) {
        preprocessorFail("malformed #include directive: " + source);
    }
    return irInclude(header, isSystem);
}

Vector<string> parseMacroParameters(string value, string source) {
    Vector<string> params = [];
    string parameterText = preprocessorTrim(value);
    if (parameterText == "") { return params; }
    int start = 0;
    int index = 0;
    while (index <= parameterText.length()) {
        if (index == parameterText.length() || parameterText[index] == ',') {
            string parameter = preprocessorTrim(
                parameterText.substring(start, index - start));
            if (!validPreprocessorIdentifier(parameter)) {
                preprocessorFail(
                    "invalid function-like macro parameters: " + source);
            }
            if (params.contains(parameter)) {
                preprocessorFail(
                    "duplicate function-like macro parameter: " + source);
            }
            params.push(parameter);
            start = index + 1;
        }
        index = index + 1;
    }
    return params;
}

IRPreprocessorDecl parseMacroDirective(string payload, string source) {
    if (payload.length() == 0 || !preprocessorSpace(payload[0])) {
        preprocessorFail("malformed #define directive: " + source);
    }
    int index = 0;
    while (index < payload.length() && preprocessorSpace(payload[index])) {
        index = index + 1;
    }
    int nameStart = index;
    if (index >= payload.length()
            || !preprocessorIdentifierStart(payload[index])) {
        preprocessorFail("malformed #define directive: " + source);
    }
    index = index + 1;
    while (index < payload.length()
            && preprocessorIdentifierPart(payload[index])) {
        index = index + 1;
    }
    string name = payload.substring(nameStart, index - nameStart);
    if (index >= payload.length() || payload[index] != '(') {
        string replacement = preprocessorTrimLeft(
            payload.substring(index, payload.length() - index));
        Vector<string> noParams = [];
        return irMacro(name, false, noParams, replacement);
    }

    int close = index + 1;
    while (close < payload.length() && payload[close] != ')') {
        close = close + 1;
    }
    if (close >= payload.length()) {
        preprocessorFail("malformed function-like #define: " + source);
    }
    Vector<string> params = parseMacroParameters(
        payload.substring(index + 1, close - index - 1), source);
    string replacement = preprocessorTrimLeft(
        payload.substring(close + 1, payload.length() - close - 1));
    return irMacro(name, true, params, replacement);
}

void lowerPreprocessorDirective(string sourceText, IRModule module) {
    int rawIndex = 0;
    while (rawIndex < sourceText.length()) {
        if (sourceText[rawIndex] == '\n' || sourceText[rawIndex] == '\r') {
            preprocessorFail("multi-line preprocessor directives are unsupported");
        }
        rawIndex = rawIndex + 1;
    }
    if (containsPreprocessorTrigraph(sourceText)) {
        preprocessorFail(
            "C11 trigraphs in preprocessor directives are unsupported");
    }
    string source = preprocessorTrim(sourceText);
    if (source.length() == 0 || source[source.length() - 1] == '\\') {
        preprocessorFail("multi-line preprocessor directives are unsupported");
    }
    if (source[0] != '#') {
        preprocessorFail("malformed preprocessor directive: " + source);
    }
    int index = 1;
    while (index < source.length() && preprocessorSpace(source[index])) {
        index = index + 1;
    }
    int nameStart = index;
    if (index >= source.length()
            || !preprocessorIdentifierStart(source[index])) {
        preprocessorFail("malformed preprocessor directive: " + source);
    }
    index = index + 1;
    while (index < source.length()
            && preprocessorIdentifierPart(source[index])) {
        index = index + 1;
    }
    string directive = source.substring(nameStart, index - nameStart);
    string payload = source.substring(index, source.length() - index);
    if (directive == "include") {
        appendPreprocessorDecl(
            module, parseIncludeDirective(payload, source));
        return;
    }
    if (directive == "define") {
        appendPreprocessorDecl(
            module, parseMacroDirective(payload, source));
        return;
    }
    if (directive == "pragma") {
        preprocessorFail("unsupported #pragma directive: " + source);
    }
    preprocessorFail("unsupported preprocessor directive '#" + directive + "'");
}
