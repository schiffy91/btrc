/* GPU call-site lowering and per-site helper registration. */

string gpuCallKernelName(IRGen gen, Node expression,
        Map<string, Node> varTypes) {
    if (expression == null || expression.kind != NK_CALL_EXPR
            || expression.callee == null
            || expression.callee.kind != NK_IDENTIFIER) { return ""; }
    string name = expression.callee.name;
    if (gen.gpu.kernels.has(name)
            && !gen.hasClosureEnv(name)
            && !varTypes.has(name)) { return name; }
    return "";
}

string ensureGpuDispatchHelper(IRGen gen, IRGpuKernel kernel) {
    string prefix = gen.freshTemp("__btrc_gpu_" + kernel.name);
    string helperName = prefix + "_run";
    string uniformStruct = prefix + "_uniforms";
    IRStructDef uniforms = IRStructDef();
    uniforms.name = uniformStruct;
    int p = 0;
    while (p < kernel.declaration.params.len) {
        Node parameter = kernel.declaration.params.get(p);
        if (!parameter.type.is_array) {
            string cType = typeToC(parameter.type, gen.analyzed);
            if (parameter.type.base == "bool") { cType = "uint32_t"; }
            uniforms.fields.push(IRStructField(
                cType, sourceLexicalBindingCName(parameter.name)));
        }
        p = p + 1;
    }
    int b = 0;
    while (b < kernel.param_buffers.len) {
        uniforms.fields.push(IRStructField("int",
            gpuLengthName(kernel.param_buffers.get(b).name)));
        b = b + 1;
    }
    uniforms.fields.push(IRStructField("int", "__gpu_off"));
    uniforms.fields.push(IRStructField("int", "__gpu_n"));
    gen.curModule.struct_defs.push(uniforms);
    gen.curModule.functions.push(buildGpuDispatchHelper(
        gen, kernel, helperName, uniformStruct));
    return helperName;
}

void appendGpuPreparedSequence(GpuPreparedCall prepared,
        Vector<IRNode> out) {
    int d = 0;
    while (d < prepared.declarations.len) {
        out.push(prepared.declarations.get(d));
        d = d + 1;
    }
    int s = 0;
    while (s < prepared.sequence.len) {
        out.push(irExprStmt(prepared.sequence.get(s)));
        s = s + 1;
    }
}

void appendGpuPreparedCleanup(GpuPreparedCall prepared,
        Vector<IRNode> out) {
    int index = 0;
    while (index < prepared.cleanup.len) {
        out.push(irExprStmt(prepared.cleanup.get(index)));
        index = index + 1;
    }
}

void appendGpuOutputTargetSequence(GpuOutputTargetPlan plan,
        Vector<IRNode> out) {
    int declaration = 0;
    while (declaration < plan.declarations.len) {
        out.push(plan.declarations.get(declaration));
        declaration = declaration + 1;
    }
    int expression = 0;
    while (expression < plan.sequence.len) {
        out.push(irExprStmt(plan.sequence.get(expression)));
        expression = expression + 1;
    }
}

void appendGpuOutputTargetCleanup(GpuOutputTargetPlan plan,
        Vector<IRNode> out) {
    int index = 0;
    while (index < plan.cleanup.len) {
        out.push(irExprStmt(plan.cleanup.get(index)));
        index = index + 1;
    }
}

OwnershipBoundary? gpuOutputTargetBoundary(IRGen gen, Node target,
        Map<string, Node> varTypes) {
    Vector<Node> operands = [];
    Vector<bool> owned = [];
    Vector<bool> kept = [];
    collectOwnedAssignmentTargetOperands(
        gen, target, varTypes, operands, owned, kept, false);
    bool required = false;
    int index = 0;
    while (index < owned.len) {
        if (owned.get(index) || kept.get(index)) { required = true; }
        index = index + 1;
    }
    if (!required) { return null; }
    OwnershipBoundary boundary = OwnershipBoundary();
    index = 0;
    while (index < operands.len) {
        Node operand = operands.get(index);
        Node? operandType = gen.resolvedExpressionType(
            operand, varTypes);
        ownershipRequireType(operandType, operand);
        boundary.addOperand(gen, operand, operandType,
            owned.get(index), kept.get(index), varTypes);
        index = index + 1;
    }
    return boundary;
}

void appendOwnedGpuOutputDispatch(IRGen gen, OwnershipBoundary boundary,
        GpuPreparedCall prepared, GpuOutputTargetPlan output,
        string helper, Vector<IRNode> helperArgs, Vector<IRNode> out) {
    Vector<IRNode> declarations = output.declarations;
    int index = 0;
    while (index < prepared.declarations.len) {
        declarations.push(prepared.declarations.get(index));
        index = index + 1;
    }
    Vector<IRNode> sequence = output.sequence;
    index = 0;
    while (index < prepared.sequence.len) {
        sequence.push(prepared.sequence.get(index));
        index = index + 1;
    }
    sequence.push(irCall(helper, helperArgs));
    index = 0;
    while (index < prepared.cleanup.len) {
        sequence.push(prepared.cleanup.get(index));
        index = index + 1;
    }
    index = 0;
    while (index < output.cleanup.len) {
        sequence.push(output.cleanup.get(index));
        index = index + 1;
    }
    boundary.restore(gen);
    IRNode dispatch = irStmtExpr(
        declarations, irCommaExpr(sequence));
    out.push(irExprStmt(boundary.finish(
        gen, dispatch, null, false)));
}

bool tryLowerGpuStatement(IRGen gen, Node statement,
        Map<string, Node> varTypes, Vector<IRNode> out) {
    Node call = null;
    Node target = null;
    bool declarationOutput = false;
    if (statement.kind == NK_VAR_DECL_STMT) {
        string kernelName = gpuCallKernelName(
            gen, statement.initializer, varTypes);
        if (kernelName != ""
                && gen.gpu.kernels.get(kernelName).output_buffer != null) {
            call = statement.initializer;
            target = statement;
            declarationOutput = true;
        }
    } else if (statement.kind == NK_EXPR_STMT
            && statement.expr != null
            && statement.expr.kind == NK_ASSIGN_EXPR
            && statement.expr.op == "=") {
        string kernelName = gpuCallKernelName(
            gen, statement.expr.value_node, varTypes);
        if (kernelName != ""
                && gen.gpu.kernels.get(kernelName).output_buffer != null) {
            call = statement.expr.value_node;
            target = statement.expr.target;
        }
    }
    if (call == null) { return false; }
    string name = call.callee.name;
    IRGpuKernel kernel = gen.gpu.kernels.get(name);
    OwnershipBoundary? outputBoundary = null;
    if (!declarationOutput) {
        outputBoundary = gpuOutputTargetBoundary(
            gen, target, varTypes);
    }
    GpuOutputTargetPlan outputPlan = null;
    if (!declarationOutput) {
        IRNode loweredTarget = gen.lowerExpr(target, varTypes);
        outputPlan = prepareGpuOutputTarget(
            gen, target, loweredTarget, varTypes);
    }
    IRNode explicitCapacity = null;
    if (declarationOutput && statement.type != null
            && statement.type.array_size != null) {
        string sizeName = gen.freshTemp("__gpu_output_size");
        IRNode sizeDeclaration = irVarDecl(
            "int", sizeName,
            gen.lowerExpr(statement.type.array_size, varTypes));
        gen.funcVarDecls.push(sizeDeclaration);
        out.push(sizeDeclaration);
        explicitCapacity = irVar(sizeName);
    }
    Vector<IRNode> lowered = [];
    GpuPreparedCall prepared = prepareGpuCall(
        gen, kernel, call, lowered, varTypes, true);
    if (outputBoundary == null) {
        if (!declarationOutput) {
            appendGpuOutputTargetSequence(outputPlan, out);
        }
        appendGpuPreparedSequence(prepared, out);
    }
    IRNode outputValue = null;
    IRNode capacity = null;
    if (declarationOutput) {
        Node? resultType = statement.type;
        if (resultType == null) { resultType = kernel.declaration.return_type; }
        if (resultType == null || !resultType.is_array) {
            gpuLoweringFail(statement,
                "GPU array result requires an array declaration");
        }
        IRNode logicalCapacity = prepared.dispatch_length;
        if (explicitCapacity != null) {
            logicalCapacity = explicitCapacity;
        }
        IRNode storageCapacity = irTernary(
            irBinOp(logicalCapacity, ">", irLiteral("0")),
            logicalCapacity, irLiteral("1"));
        out.push(irArrayVarDecl(gpuCElementType(kernel), statement.name,
            storageCapacity, null));
        outputValue = irVar(statement.name);
        capacity = logicalCapacity;
        varTypes.put(statement.name, resultType);
        gen.gpuHost.array_lengths.put(
            statement.name, prepared.dispatch_length);
        gen.gpuHost.unknown_array_lengths.remove(statement.name);
    } else {
        outputValue = outputPlan.data;
        capacity = outputPlan.capacity;
    }
    string helper = ensureGpuDispatchHelper(gen, kernel);
    Vector<IRNode> helperArgs = prepared.helper_args;
    helperArgs.push(outputValue);
    helperArgs.push(capacity);
    if (outputBoundary != null) {
        appendOwnedGpuOutputDispatch(gen, outputBoundary,
            prepared, outputPlan, helper, helperArgs, out);
    } else {
        out.push(gpuCallStatement(helper, helperArgs));
        appendGpuPreparedCleanup(prepared, out);
        if (!declarationOutput) {
            appendGpuOutputTargetCleanup(outputPlan, out);
        }
    }
    return true;
}

IRNode lowerGpuDispatchExpression(IRGen gen, string name, Node call,
        Vector<IRNode> loweredArgs, Map<string, Node> varTypes) {
    IRGpuKernel kernel = gen.gpu.kernels.get(name);
    if (kernel.output_buffer != null) {
        gpuLoweringFail(call,
            "GPU array result must initialize or assign a capacity-known array");
    }
    GpuPreparedCall prepared = prepareGpuCall(
        gen, kernel, call, loweredArgs, varTypes, true);
    string helper = ensureGpuDispatchHelper(gen, kernel);
    Vector<IRNode> sequence = prepared.sequence;
    sequence.push(irCall(helper, prepared.helper_args));
    int index = 0;
    while (index < prepared.cleanup.len) {
        sequence.push(prepared.cleanup.get(index));
        index = index + 1;
    }
    return irStmtExpr(prepared.declarations, irCommaExpr(sequence));
}
