/* GPU call-site lowering and per-site helper registration. */

string gpuCallKernelName(IRGen gen, Node expression) {
    if (expression == null || expression.kind != NK_CALL_EXPR
            || expression.callee == null
            || expression.callee.kind != NK_IDENTIFIER) { return ""; }
    string name = expression.callee.name;
    if (gen.gpu.kernels.has(name)) { return name; }
    return "";
}

string ensureGpuDispatchHelper(IRGen gen, IRGpuKernel kernel) {
    string prefix = gen.freshTemp("__btrc_gpu_" + kernel.name);
    string helperName = prefix + "_run";
    string uniformStruct = prefix + "_uniforms";
    IRStructDef uniforms = IRStructDef();
    uniforms.name = uniformStruct;
    int p = 0;
    while (p < kernel.declaration.params.len) {
        Node parameter = kernel.declaration.params.get(p);
        if (!parameter.type.is_array) {
            string cType = typeToC(parameter.type, gen.analyzed);
            if (parameter.type.base == "bool") { cType = "uint32_t"; }
            uniforms.fields.push(IRStructField(cType, parameter.name));
        }
        p = p + 1;
    }
    int b = 0;
    while (b < kernel.param_buffers.len) {
        uniforms.fields.push(IRStructField("int",
            gpuLengthName(kernel.param_buffers.get(b).name)));
        b = b + 1;
    }
    uniforms.fields.push(IRStructField("int", "__gpu_off"));
    uniforms.fields.push(IRStructField("int", "__gpu_n"));
    gen.curModule.struct_defs.push(uniforms);
    gen.curModule.functions.push(buildGpuDispatchHelper(
        gen, kernel, helperName, uniformStruct));
    return helperName;
}

void appendGpuPreparedSequence(GpuPreparedCall prepared,
        Vector<IRNode> out) {
    int d = 0;
    while (d < prepared.declarations.len) {
        out.push(prepared.declarations.get(d));
        d = d + 1;
    }
    int s = 0;
    while (s < prepared.sequence.len) {
        out.push(irExprStmt(prepared.sequence.get(s)));
        s = s + 1;
    }
}

bool tryLowerGpuStatement(IRGen gen, Node statement,
        Map<string, Node> varTypes, Vector<IRNode> out) {
    Node call = null;
    Node target = null;
    bool declarationOutput = false;
    if (statement.kind == NK_VAR_DECL_STMT) {
        string kernelName = gpuCallKernelName(gen, statement.initializer);
        if (kernelName != ""
                && gen.gpu.kernels.get(kernelName).output_buffer != null) {
            call = statement.initializer;
            target = statement;
            declarationOutput = true;
        }
    } else if (statement.kind == NK_EXPR_STMT
            && statement.expr != null
            && statement.expr.kind == NK_ASSIGN_EXPR
            && statement.expr.op == "=") {
        string kernelName = gpuCallKernelName(gen, statement.expr.value_node);
        if (kernelName != ""
                && gen.gpu.kernels.get(kernelName).output_buffer != null) {
            call = statement.expr.value_node;
            target = statement.expr.target;
        }
    }
    if (call == null) { return false; }
    string name = call.callee.name;
    IRGpuKernel kernel = gen.gpu.kernels.get(name);
    Vector<IRNode> lowered = gen.lowerArgs(call, varTypes);
    GpuPreparedCall prepared = prepareGpuCall(
        gen, kernel, call, lowered, varTypes);
    appendGpuPreparedSequence(prepared, out);
    IRNode outputValue = null;
    IRNode capacity = null;
    if (declarationOutput) {
        Node? resultType = statement.type;
        if (resultType == null) { resultType = kernel.declaration.return_type; }
        if (resultType == null || !resultType.is_array) {
            gpuLoweringFail(statement,
                "GPU array result requires an array declaration");
        }
        IRNode storageCapacity = irTernary(
            irBinOp(prepared.dispatch_length, ">", irLiteral("0")),
            prepared.dispatch_length, irLiteral("1"));
        out.push(irArrayVarDecl(gpuCElementType(kernel), statement.name,
            storageCapacity, null));
        outputValue = irVar(statement.name);
        capacity = prepared.dispatch_length;
        varTypes.put(statement.name, resultType);
        gen.gpuHost.array_lengths.put(statement.name, capacity);
    } else {
        outputValue = gen.lowerExpr(target, varTypes);
        capacity = gpuOutputCapacity(gen, target);
    }
    string helper = ensureGpuDispatchHelper(gen, kernel);
    Vector<IRNode> helperArgs = prepared.helper_args;
    helperArgs.push(outputValue);
    helperArgs.push(capacity);
    out.push(gpuCallStatement(helper, helperArgs));
    return true;
}

IRNode lowerGpuDispatchExpression(IRGen gen, string name, Node call,
        Vector<IRNode> loweredArgs, Map<string, Node> varTypes) {
    IRGpuKernel kernel = gen.gpu.kernels.get(name);
    if (kernel.output_buffer != null) {
        gpuLoweringFail(call,
            "GPU array result must initialize or assign a capacity-known array");
    }
    GpuPreparedCall prepared = prepareGpuCall(
        gen, kernel, call, loweredArgs, varTypes);
    string helper = ensureGpuDispatchHelper(gen, kernel);
    Vector<IRNode> sequence = prepared.sequence;
    sequence.push(irCall(helper, prepared.helper_args));
    sequence.push(irLiteral("0"));
    return irStmtExpr(prepared.declarations, irCommaExpr(sequence));
}
