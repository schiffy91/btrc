/* Application composition root for the production self-hosted compiler. */

import ./pipeline/Stage.btrc;

class Compiler {
	private CompilerPipeline pipeline;

	public Compiler(GrammarInfo grammar, string stdlibDirectory, FeSourceFileReader sourceFiles, FeNativeHeaderReader nativeHeaderReader = (FeNativeHeaderReader)null) { self.pipeline = CompilerPipeline(grammar, stdlibDirectory, sourceFiles, nativeHeaderReader); }

	public BtrccCompilationResult compile(string source, string sourcePath, BtrccOptions options) { return self.pipeline.compile(source, sourcePath, options); }
}
