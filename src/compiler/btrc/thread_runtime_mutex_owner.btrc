/* Exact self-hosted mirror of the Python owner-aware Mutex helper registry. */
string threadRuntimeMutexOwnerSource(string name) {
    if (name == "__btrc_mutex_val_bind_owner") {
        return "static void __btrc_mutex_val_bind_owner(\n"
            + "        __btrc_mutex_val_t* m, void* owner) {\n"
            + "    if (!m) return;\n"
            + "    if (!owner) { fprintf(stderr, \"btrc: Mutex owner cannot be null\\n\"); exit(1); }\n"
            + "    void* topology = m->slot_access\n"
            + "        ? __btrc_arc_topology_begin() : NULL;\n"
            + "    int err = pthread_mutex_lock(&m->lock);\n"
            + "    if (err != 0) { fprintf(stderr, \"btrc: mutex lock failed (%d)\\n\", err); exit(1); }\n"
            + "    char first_error[1024] = \"\";\n"
            + "    int has_error = 0;\n"
            + "    if (m->slot_access && m->owner && m->owner != owner) {\n"
            + "        memcpy(first_error, \"Mutex handle already has an owner\",\n"
            + "            sizeof \"Mutex handle already has an owner\");\n"
            + "        has_error = 1;\n"
            + "    } else if (!m->owner && m->slot_access && m->retain) {\n"
            + "        has_error = __btrc_mutex_value_callback_guard(\n"
            + "            m->retain, m->value, m->access, m->context, owner,\n"
            + "            first_error, sizeof first_error);\n"
            + "        if (!has_error) {\n"
            + "            has_error = __btrc_mutex_value_callback_guard(\n"
            + "                m->release, m->value, m->access, m->context, NULL,\n"
            + "                first_error, sizeof first_error);\n"
            + "            if (has_error) {\n"
            + "                char rollback_error[1024] = \"\";\n"
            + "                (void)__btrc_mutex_value_callback_guard(\n"
            + "                    m->release, m->value, m->access, m->context,\n"
            + "                    owner, rollback_error, sizeof rollback_error);\n"
            + "            }\n"
            + "        }\n"
            + "    }\n"
            + "    if (!has_error && m->slot_access) m->owner = owner;\n"
            + "    __btrc_raise_fn saved_raise = m->raise;\n"
            + "    err = pthread_mutex_unlock(&m->lock);\n"
            + "    if (err != 0) { fprintf(stderr, \"btrc: mutex unlock failed (%d)\\n\", err); exit(1); }\n"
            + "    int should_flush = topology\n"
            + "        && __btrc_arc_topology_leave(topology);\n"
            + "    if (should_flush && m->finalize) {\n"
            + "        char finalize_error[1024] = \"\";\n"
            + "        int finalize_failed = __btrc_mutex_finalize_callback_guard(\n"
            + "            m->finalize, m->context,\n"
            + "            finalize_error, sizeof finalize_error);\n"
            + "        if (finalize_failed && !has_error) {\n"
            + "            memcpy(first_error, finalize_error, sizeof first_error);\n"
            + "            has_error = 1;\n"
            + "        }\n"
            + "    }\n"
            + "    if (has_error)\n"
            + "        __btrc_raise_captured(saved_raise, first_error);\n"
            + "}"
            ;
    }
    if (name == "__btrc_mutex_destroy_guard_adapter") {
        return "static void __btrc_mutex_destroy_thunk(void* raw) {\n"
            + "    __btrc_mutex_val_destroy((__btrc_mutex_val_t*)raw);\n"
            + "}"
            ;
    }
    if (name == "__btrc_mutex_val_take") {
        return "static __btrc_mutex_val_t* __btrc_mutex_val_take(\n"
            + "        __btrc_mutex_val_t* volatile* slot) {\n"
            + "    if (!slot) { fprintf(stderr, \"btrc: invalid Mutex take slot\\n\"); exit(1); }\n"
            + "    __btrc_mutex_val_t* m = *slot;\n"
            + "    if (!m) return NULL;\n"
            + "    void* topology = m->slot_access\n"
            + "        ? __btrc_arc_topology_begin() : NULL;\n"
            + "    int err = pthread_mutex_lock(&m->lock);\n"
            + "    if (err != 0) { fprintf(stderr, \"btrc: mutex lock failed (%d)\\n\", err); exit(1); }\n"
            + "    if (*slot != m) { fprintf(stderr, \"btrc: Mutex take slot changed during transaction\\n\"); exit(1); }\n"
            + "    char first_error[1024] = \"\";\n"
            + "    int has_error = 0;\n"
            + "    int committed = 0;\n"
            + "    void* owner = m->owner;\n"
            + "    if (owner && m->slot_access && m->retain) {\n"
            + "        has_error = __btrc_mutex_value_callback_guard(\n"
            + "            m->retain, m->value, m->access, m->context, NULL,\n"
            + "            first_error, sizeof first_error);\n"
            + "        if (!has_error) {\n"
            + "            has_error = __btrc_mutex_value_callback_guard(\n"
            + "                m->release, m->value, m->access, m->context,\n"
            + "                owner, first_error, sizeof first_error);\n"
            + "            if (has_error) {\n"
            + "                char rollback_error[1024] = \"\";\n"
            + "                (void)__btrc_mutex_value_callback_guard(\n"
            + "                    m->release, m->value, m->access, m->context,\n"
            + "                    NULL, rollback_error, sizeof rollback_error);\n"
            + "            }\n"
            + "        }\n"
            + "    }\n"
            + "    if (!has_error) {\n"
            + "        m->owner = NULL;\n"
            + "        *slot = NULL;\n"
            + "        committed = 1;\n"
            + "    }\n"
            + "    __btrc_raise_fn saved_raise = m->raise;\n"
            + "    err = pthread_mutex_unlock(&m->lock);\n"
            + "    if (err != 0) { fprintf(stderr, \"btrc: mutex unlock failed (%d)\\n\", err); exit(1); }\n"
            + "    int should_flush = topology\n"
            + "        && __btrc_arc_topology_leave(topology);\n"
            + "    if (should_flush && m->finalize) {\n"
            + "        char finalize_error[1024] = \"\";\n"
            + "        int finalize_failed = __btrc_mutex_finalize_callback_guard(\n"
            + "            m->finalize, m->context,\n"
            + "            finalize_error, sizeof finalize_error);\n"
            + "        if (finalize_failed && !has_error) {\n"
            + "            memcpy(first_error, finalize_error, sizeof first_error);\n"
            + "            has_error = 1;\n"
            + "        }\n"
            + "    }\n"
            + "    if (has_error && committed) {\n"
            + "        char cleanup_error[1024] = \"\";\n"
            + "        (void)__btrc_arc_guard_hook(\n"
            + "            __btrc_mutex_destroy_thunk, m,\n"
            + "            cleanup_error, sizeof cleanup_error);\n"
            + "    }\n"
            + "    if (has_error)\n"
            + "        __btrc_raise_captured(saved_raise, first_error);\n"
            + "    return m;\n"
            + "}"
            ;
    }
    if (name == "__btrc_mutex_val_visit") {
        return "static void __btrc_mutex_val_visit(\n"
            + "        __btrc_mutex_val_t* m, __btrc_field_visit_fn fn,\n"
            + "        void* context) {\n"
            + "    if (!m || !fn) return;\n"
            + "    int err = pthread_mutex_lock(&m->lock);\n"
            + "    if (err != 0) { fprintf(stderr, \"btrc: mutex lock failed (%d)\\n\", err); exit(1); }\n"
            + "    if (m->owner && m->value && m->slot_access)\n"
            + "        fn((volatile void*)m->value, m->slot_access,\n"
            + "            (const __btrc_arc_type*)m->context, context);\n"
            + "    err = pthread_mutex_unlock(&m->lock);\n"
            + "    if (err != 0) { fprintf(stderr, \"btrc: mutex unlock failed (%d)\\n\", err); exit(1); }\n"
            + "}"
            ;
    }
    if (name == "__btrc_mutex_val_replace_owner") {
        return "typedef struct {\n"
            + "    __btrc_mutex_val_t* mutex;\n"
            + "    void* owner;\n"
            + "} __btrc_mutex_bind_call;\n"
            + "static void __btrc_mutex_bind_thunk(void* raw) {\n"
            + "    __btrc_mutex_bind_call* call =\n"
            + "        (__btrc_mutex_bind_call*)raw;\n"
            + "    __btrc_mutex_val_bind_owner(call->mutex, call->owner);\n"
            + "}\n"
            + "static void __btrc_mutex_val_replace_owner(\n"
            + "        __btrc_mutex_val_t* volatile* slot,\n"
            + "        __btrc_mutex_val_t* replacement, void* owner) {\n"
            + "    if (!slot || !owner) { fprintf(stderr, \"btrc: invalid Mutex field replacement\\n\"); exit(1); }\n"
            + "    __btrc_mutex_val_t* old = *slot;\n"
            + "    int graph_value = (replacement && replacement->slot_access)\n"
            + "        || (old && old->slot_access);\n"
            + "    void* topology = graph_value\n"
            + "        ? __btrc_arc_topology_begin() : NULL;\n"
            + "    __btrc_raise_fn saved_raise = replacement\n"
            + "        ? replacement->raise : (old ? old->raise : NULL);\n"
            + "    char first_error[1024] = \"\";\n"
            + "    int has_error = 0;\n"
            + "    if (replacement) {\n"
            + "        __btrc_mutex_bind_call bind = {replacement, owner};\n"
            + "        has_error = __btrc_arc_guard_hook(\n"
            + "            __btrc_mutex_bind_thunk, &bind,\n"
            + "            first_error, sizeof first_error);\n"
            + "    }\n"
            + "    if (has_error && replacement && old != replacement\n"
            + "            && replacement->owner == NULL) {\n"
            + "        char cleanup_error[1024] = \"\";\n"
            + "        (void)__btrc_arc_guard_hook(\n"
            + "            __btrc_mutex_destroy_thunk, replacement,\n"
            + "            cleanup_error, sizeof cleanup_error);\n"
            + "    }\n"
            + "    if (!has_error && old != replacement) {\n"
            + "        *slot = replacement;\n"
            + "        if (old)\n"
            + "            has_error = __btrc_arc_guard_hook(\n"
            + "                __btrc_mutex_destroy_thunk, old,\n"
            + "                first_error, sizeof first_error);\n"
            + "    }\n"
            + "    int should_flush = topology\n"
            + "        && __btrc_arc_topology_leave(topology);\n"
            + "    if (should_flush) {\n"
            + "        char finalize_error[1024] = \"\";\n"
            + "        int finalize_failed = __btrc_mutex_finalize_callback_guard(\n"
            + "            __btrc_mutex_arc_finalize, NULL,\n"
            + "            finalize_error, sizeof finalize_error);\n"
            + "        if (finalize_failed && !has_error) {\n"
            + "            memcpy(first_error, finalize_error, sizeof first_error);\n"
            + "            has_error = 1;\n"
            + "        }\n"
            + "    }\n"
            + "    if (has_error)\n"
            + "        __btrc_raise_captured(saved_raise, first_error);\n"
            + "}"
            ;
    }
    return "";
}
