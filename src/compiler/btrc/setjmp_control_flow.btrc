/* Structured continuation and loop-backedge traversal for setjmp volatility. */

void scanSetjmpBlock(IRNode? block, Vector<IRNode> inherited,
        Vector<IRParam> params, SetjmpCallEffects effects) {
    if (block == null) { return; }
    Vector<IRNode> visible = copySetjmpVisible(inherited);
    int index = 0;
    while (index < block.stmts.len) {
        IRNode statement = block.stmts.get(index);
        if (expressionContainsSetjmp(statement)) {
            Map<string, bool> continuation = setjmpMutatedSequenceAfter(
                block.stmts, index + 1, effects);
            markSetjmpVisible(
                visible, params, continuation, true, effects);
        }
        scanSetjmpStatement(statement, visible, params, effects);
        index = index + 1;
    }
}

void markSetjmpLoopVisible(IRNode statement, Vector<IRNode> visible,
        Vector<IRParam> params, SetjmpCallEffects effects) {
    if (!expressionContainsSetjmp(statement)) { return; }
    Map<string, bool> modified =
        setjmpLoopMutatedNames(statement, effects);
    markSetjmpVisible(visible, params, modified, true, effects);
}

void scanSetjmpIf(IRNode statement, Vector<IRNode> visible,
        Vector<IRParam> params, SetjmpCallEffects effects) {
    Map<string, bool> all = {};
    if (expressionContainsSetjmp(statement.condition)) {
        Map<string, bool> modified =
            setjmpMutatedNames(statement.then_block, effects);
        Map<string, bool> catchModified =
            setjmpMutatedNames(statement.else_block, effects);
        Vector<string> catchNames = catchModified.keys();
        int index = 0;
        while (index < catchNames.len) {
            modified.put(catchNames.get(index), true);
            index = index + 1;
        }
        processSetjmpExpression(
            statement.condition, visible, params, modified, true, effects);
    } else {
        processSetjmpExpression(
            statement.condition, visible, params, all, false, effects);
    }
    scanSetjmpBlock(statement.then_block, visible, params, effects);
    scanSetjmpBlock(statement.else_block, visible, params, effects);
}

void scanSetjmpSwitch(IRNode statement, Vector<IRNode> visible,
        Vector<IRParam> params, SetjmpCallEffects effects) {
    prepareSetjmpSimple(statement.value, null, visible, params, effects);
    int index = 0;
    while (index < statement.args.len) {
        IRNode caseNode = statement.args.get(index);
        Vector<IRNode> caseVisible = copySetjmpVisible(visible);
        prepareSetjmpSimple(
            caseNode.value, null, caseVisible, params, effects);
        IRNode caseBlock = IRNode();
        caseBlock.kind = IRK_BLOCK;
        caseBlock.stmts = caseNode.stmts;
        if (expressionContainsSetjmp(caseBlock)
                && caseNode.falls_through) {
            Map<string, bool> continuation = {};
            int next = index;
            while (next + 1 < statement.args.len
                    && statement.args.get(next).falls_through) {
                next = next + 1;
                IRNode nextCase = statement.args.get(next);
                IRNode nextBlock = IRNode();
                nextBlock.kind = IRK_BLOCK;
                nextBlock.stmts = nextCase.stmts;
                Map<string, bool> nextMutations =
                    setjmpMutatedNames(nextBlock, effects);
                Vector<string> names = nextMutations.keys();
                int nameIndex = 0;
                while (nameIndex < names.len) {
                    continuation.put(names.get(nameIndex), true);
                    nameIndex = nameIndex + 1;
                }
            }
            markSetjmpVisible(
                caseVisible, params, continuation, true, effects);
        }
        scanSetjmpBlock(caseBlock, caseVisible, params, effects);
        index = index + 1;
    }
}

void scanSetjmpStatement(IRNode statement, Vector<IRNode> visible,
        Vector<IRParam> params, SetjmpCallEffects effects) {
    Map<string, bool> all = {};
    if (statement.kind == IRK_VAR_DECL) {
        prepareSetjmpDeclaration(
            statement, visible, params, all, false, effects);
    } else if (statement.kind == IRK_ASSIGN) {
        prepareSetjmpSimple(
            statement.target, statement.value, visible, params, effects);
    } else if (statement.kind == IRK_RETURN) {
        prepareSetjmpSimple(
            statement.value, null, visible, params, effects);
    } else if (statement.kind == IRK_EXPR_STMT) {
        prepareSetjmpSimple(
            statement.expr, null, visible, params, effects);
    } else if (statement.kind == IRK_IF) {
        scanSetjmpIf(statement, visible, params, effects);
    } else if (statement.kind == IRK_WHILE) {
        markSetjmpLoopVisible(statement, visible, params, effects);
        prepareSetjmpSimple(
            statement.condition, null, visible, params, effects);
        scanSetjmpBlock(statement.body, visible, params, effects);
    } else if (statement.kind == IRK_DO_WHILE) {
        markSetjmpLoopVisible(statement, visible, params, effects);
        processSetjmpExpression(
            statement.condition, visible, params, all, false, effects);
        scanSetjmpBlock(statement.body, visible, params, effects);
    } else if (statement.kind == IRK_FOR) {
        scanSetjmpFor(statement, visible, params, effects);
    } else if (statement.kind == IRK_SWITCH) {
        scanSetjmpSwitch(statement, visible, params, effects);
    } else if (statement.kind == IRK_BLOCK) {
        scanSetjmpBlock(statement, visible, params, effects);
    }
}

void prepareSetjmpForInit(IRNode? init, Vector<IRNode> visible,
        Vector<IRParam> params, SetjmpCallEffects effects) {
    if (init == null) { return; }
    Map<string, bool> all = {};
    if (init.kind == IRK_ASSIGN) {
        prepareSetjmpHoists(
            init.target, visible, params, all, false, effects);
        prepareSetjmpHoists(
            init.value, visible, params, all, false, effects);
    } else if (init.kind == IRK_EXPR_STMT) {
        prepareSetjmpHoists(
            init.expr, visible, params, all, false, effects);
    }
}

void scanSetjmpForInit(IRNode? init, Vector<IRNode> visible,
        Vector<IRParam> params, SetjmpCallEffects effects) {
    if (init == null) { return; }
    Map<string, bool> all = {};
    if (init.kind == IRK_ASSIGN) {
        scanSetjmpResidual(
            init.target, visible, params, all, false, effects);
        scanSetjmpResidual(
            init.value, visible, params, all, false, effects);
    } else if (init.kind == IRK_EXPR_STMT) {
        scanSetjmpResidual(
            init.expr, visible, params, all, false, effects);
    }
}

void scanSetjmpFor(IRNode statement, Vector<IRNode> visible,
        Vector<IRParam> params, SetjmpCallEffects effects) {
    Map<string, bool> all = {};
    if (statement.init != null && statement.init.kind == IRK_VAR_DECL) {
        prepareSetjmpHoists(statement.init.array_size,
            visible, params, all, false, effects);
        prepareSetjmpHoists(statement.init.init,
            visible, params, all, false, effects);
    } else {
        prepareSetjmpForInit(statement.init, visible, params, effects);
    }
    prepareSetjmpHoists(
        statement.condition, visible, params, all, false, effects);
    prepareSetjmpHoists(
        statement.update, visible, params, all, false, effects);

    Vector<IRNode> loopVisible = copySetjmpVisible(visible);
    if (statement.init != null && statement.init.kind == IRK_VAR_DECL) {
        scanSetjmpResidual(statement.init.array_size,
            visible, params, all, false, effects);
        addSetjmpVisible(loopVisible, statement.init);
        scanSetjmpResidual(statement.init.init,
            loopVisible, params, all, false, effects);
    } else {
        scanSetjmpForInit(statement.init, loopVisible, params, effects);
    }
    markSetjmpLoopVisible(statement, loopVisible, params, effects);
    scanSetjmpResidual(statement.condition,
        loopVisible, params, all, false, effects);
    scanSetjmpResidual(statement.update,
        loopVisible, params, all, false, effects);
    scanSetjmpBlock(statement.body, loopVisible, params, effects);
}

void applySetjmpVolatility(IRModule module) {
    SetjmpQualifierValidator qualifierValidator =
        SetjmpQualifierValidator();
    qualifierValidator.validateGlobals(module);
    bool hasSetjmp = false;
    int index = 0;
    while (index < module.functions.len) {
        IRFunction definition = module.functions.get(index);
        if (definition.body != null
                && expressionContainsSetjmp(definition.body)) {
            hasSetjmp = true;
        }
        index = index + 1;
    }
    if (!hasSetjmp) { return; }
    Map<string, SetjmpCallEffects> effectsByFunction =
        buildSetjmpCallEffects(module);
    index = 0;
    while (index < module.functions.len) {
        IRFunction definition = module.functions.get(index);
        if (definition.body != null) {
            rejectUnmodelledSetjmpCaptures(
                definition, effectsByFunction.get(definition.name));
            Vector<IRNode> visible = [];
            scanSetjmpBlock(definition.body, visible, definition.params,
                effectsByFunction.get(definition.name));
        }
        qualifierValidator.validateFunction(definition);
        index = index + 1;
    }
}
