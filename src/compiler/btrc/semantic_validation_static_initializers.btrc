/* Strict-C constant/address initializer categories for static storage. */

int SC_INVALID = 0;
int SC_INTEGER = 1;
int SC_ARITHMETIC = 2;
int SC_ADDRESS = 3;

bool semanticStaticArrayDesignator(
        Node? expression, SemanticValidationState state) {
    if (expression == null) { return false; }
    if (expression.kind == NK_STRING_LITERAL) { return true; }
    if (expression.kind == NK_IDENTIFIER
            && state.analyzed.globalVarTypes.has(expression.name)) {
        Node typeExpr = state.analyzed.globalVarTypes.get(expression.name);
        return typeExpr.is_array;
    }
    return false;
}

bool semanticStaticAddressOperand(
        Node? expression, SemanticValidationState state) {
    if (expression == null) { return false; }
    if (expression.kind == NK_STRING_LITERAL) { return true; }
    if (expression.kind == NK_IDENTIFIER) {
        return state.analyzed.funcNames.has(expression.name)
            || state.analyzed.globalVarTypes.has(expression.name);
    }
    if (expression.kind == NK_FIELD_ACCESS_EXPR && !expression.arrow) {
        return semanticStaticAddressOperand(expression.obj, state);
    }
    if (expression.kind == NK_INDEX_EXPR) {
        Map<string, bool> unrestricted = {};
        SemanticIntegerConstant index = semanticIntegerConstant(
            expression.index, state, false, "", unrestricted);
        return index.valid
            && semanticStaticArrayDesignator(expression.obj, state);
    }
    return false;
}

bool semanticKnownNumericZero(Node expression) {
    if (expression.kind == NK_INT_LITERAL) {
        IntegerLiteralInfo info = parseIntegerLiteralInfo(expression.raw);
        return info.valid && info.magnitude == 0ULL;
    }
    if (expression.kind == NK_FLOAT_LITERAL) {
        return expression.value_float == 0.0;
    }
    if (expression.kind == NK_BOOL_LITERAL) {
        return !expression.value_bool;
    }
    return false;
}

int semanticStaticInitializerCategory(
        Node? expression, SemanticValidationState state) {
    if (expression == null) { return SC_INVALID; }
    Map<string, bool> unrestricted = {};
    SemanticIntegerConstant integer = semanticIntegerConstant(
        expression, state, false, "", unrestricted);
    if (integer.valid) { return SC_INTEGER; }
    if (expression.kind == NK_FLOAT_LITERAL) { return SC_ARITHMETIC; }
    if (expression.kind == NK_STRING_LITERAL
            || expression.kind == NK_NULL_LITERAL) {
        return SC_ADDRESS;
    }
    if (expression.kind == NK_IDENTIFIER) {
        if (expression.name == "NULL") { return SC_ADDRESS; }
        if (state.analyzed.funcNames.has(expression.name)) {
            return SC_ADDRESS;
        }
        if (state.analyzed.globalVarTypes.has(expression.name)
                && state.analyzed.globalVarTypes.get(
                    expression.name).is_array) {
            return SC_ADDRESS;
        }
        return SC_INVALID;
    }
    if (expression.kind == NK_UNARY_EXPR) {
        if (expression.op == "&"
                && semanticStaticAddressOperand(
                    expression.operand, state)) {
            return SC_ADDRESS;
        }
        if (expression.op == "+" || expression.op == "-") {
            int operand = semanticStaticInitializerCategory(
                expression.operand, state);
            if (operand == SC_ARITHMETIC) { return SC_ARITHMETIC; }
        }
        return SC_INVALID;
    }
    if (expression.kind == NK_BINARY_EXPR) {
        int left = semanticStaticInitializerCategory(
            expression.left, state);
        int right = semanticStaticInitializerCategory(
            expression.right, state);
        if (expression.op == "+"
                && ((left == SC_ADDRESS && right == SC_INTEGER)
                    || (left == SC_INTEGER && right == SC_ADDRESS))) {
            return SC_ADDRESS;
        }
        if (expression.op == "-"
                && left == SC_ADDRESS && right == SC_INTEGER) {
            return SC_ADDRESS;
        }
        bool leftArithmetic = left == SC_INTEGER || left == SC_ARITHMETIC;
        bool rightArithmetic = right == SC_INTEGER || right == SC_ARITHMETIC;
        if (leftArithmetic && rightArithmetic
                && (expression.op == "+" || expression.op == "-"
                    || expression.op == "*" || expression.op == "/"
                    || expression.op == "<" || expression.op == ">"
                    || expression.op == "<=" || expression.op == ">="
                    || expression.op == "==" || expression.op == "!=")) {
            if (expression.op == "/"
                    && semanticKnownNumericZero(expression.right)) {
                return SC_INVALID;
            }
            if (expression.op == "<" || expression.op == ">"
                    || expression.op == "<=" || expression.op == ">="
                    || expression.op == "==" || expression.op == "!=") {
                return SC_INTEGER;
            }
            return SC_ARITHMETIC;
        }
        return SC_INVALID;
    }
    if (expression.kind == NK_TERNARY_EXPR) {
        SemanticIntegerConstant condition = semanticIntegerConstant(
            expression.condition, state, false, "", unrestricted);
        if (!condition.valid) { return SC_INVALID; }
        if (condition.known) {
            if (condition.value != 0) {
                return semanticStaticInitializerCategory(
                    expression.true_expr, state);
            }
            return semanticStaticInitializerCategory(
                expression.false_expr, state);
        }
        int whenTrue = semanticStaticInitializerCategory(
            expression.true_expr, state);
        int whenFalse = semanticStaticInitializerCategory(
            expression.false_expr, state);
        if (whenTrue == whenFalse) { return whenTrue; }
        return SC_INVALID;
    }
    if (expression.kind == NK_CAST_EXPR) {
        Node? target = semanticResolveAliases(
            expression.target_type, state);
        int operand = semanticStaticInitializerCategory(
            expression.expr, state);
        if (target == null || operand == SC_INVALID) { return SC_INVALID; }
        if (semanticIsReferenceType(target, state.analyzed)) {
            if (operand == SC_INTEGER || operand == SC_ADDRESS) {
                return SC_ADDRESS;
            }
            return SC_INVALID;
        }
        if (numericIsType(target, state.analyzed)
                && (operand == SC_INTEGER || operand == SC_ARITHMETIC)) {
            if (semanticIntegralType(target, state.analyzed)) {
                return SC_INTEGER;
            }
            return SC_ARITHMETIC;
        }
    }
    return SC_INVALID;
}

bool semanticStaticInitializer(Node? expression, Node? expected,
        SemanticValidationState state) {
    if (expression == null) { return true; }
    if (expected != null && expected.generic_args.len > 0
            && expected.base != "Tuple"
            && expected.base != "__fn_ptr"
            && (state.analyzed.isGenericClass(expected.base)
                || semanticRuntimeTypeBase(expected.base))) {
        /* Collection/class literals allocate and populate at runtime; their
         * brace spelling is not a C aggregate constant initializer. */
        return false;
    }
    if (expression.kind == NK_BRACE_INITIALIZER
            || expression.kind == NK_LIST_LITERAL) {
        if (expression.kind == NK_LIST_LITERAL
                && (expected == null || !expected.is_array)) {
            return false;
        }
        int index = 0;
        while (index < expression.elements.len) {
            if (!semanticStaticInitializer(
                    expression.elements.get(index), null, state)) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }
    return semanticStaticInitializerCategory(expression, state) != SC_INVALID;
}
