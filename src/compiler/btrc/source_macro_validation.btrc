/* Semantic boundaries for C preprocessor namespace mutations. */

bool sourceMacroTokenPasteAt(string text, int index) {
    return (index + 1 < text.length()
            && text[index] == '#' && text[index + 1] == '#')
        || (index + 3 < text.length()
            && text[index] == '%' && text[index + 1] == ':'
            && text[index + 2] == '%' && text[index + 3] == ':')
        || (index + 5 < text.length()
            && text[index] == '?' && text[index + 1] == '?'
            && text[index + 2] == '=' && text[index + 3] == '?'
            && text[index + 4] == '?' && text[index + 5] == '=');
}

bool sourceMacroUsesTokenPaste(string sourceText) {
    string normalized = sourceMacroNormalizeDirective(sourceText);
    int index = sourceMacroReplacementStart(normalized);
    while (index >= 0 && index < normalized.length()) {
        char value = normalized[index];
        if (value == '"' || value == '\'') {
            index = sourceMacroSkipQuoted(normalized, index, value);
        } else if (value == '/' && index + 1 < normalized.length()
                && normalized[index + 1] == '/') {
            return false;
        } else if (value == '/' && index + 1 < normalized.length()
                && normalized[index + 1] == '*') {
            index = index + 2;
            while (index + 1 < normalized.length()
                    && !(normalized[index] == '*'
                        && normalized[index + 1] == '/')) {
                index = index + 1;
            }
            if (index + 1 < normalized.length()) { index = index + 2; }
        } else if (sourceMacroTokenPasteAt(normalized, index)) {
            return true;
        } else {
            index = index + 1;
        }
    }
    return false;
}

void semanticValidateMacroName(string name, Node site) {
    string prefix = semanticCompilerReservedPrefix(name);
    if (prefix != "") {
        semanticValidationFail("Macro name '" + name
            + "' uses the compiler-reserved '" + prefix
            + "' prefix", site);
    }
    if (semanticCFileScopeReservedIdentifier(name)) {
        semanticValidationFail("Macro name '" + name
            + "' is reserved by C11 at file scope", site);
    }
    if (hostedAbiOwnedName(name)) {
        semanticValidationFail("Macro name '" + name
            + "' is a compiler-owned hosted C symbol", site);
    }
}

void semanticValidateUndefName(string name, Node site) {
    string prefix = semanticCompilerReservedPrefix(name);
    if (prefix != "") {
        semanticValidationFail("Source #undef of compiler-owned C symbol '"
            + name + "' is not allowed", site);
    }
    if (semanticCFileScopeReservedIdentifier(name)) {
        semanticValidationFail("Source #undef name '" + name
            + "' is reserved by C11 at file scope", site);
    }
    if (hostedAbiOwnedName(name)) {
        semanticValidationFail("Source #undef of compiler-owned hosted C symbol '"
            + name + "' is not allowed", site);
    }
}

void semanticClaimSourceMacroSymbols(
        Node program, Map<string, string> symbols) {
    int index = 0;
    while (index < program.declarations.len) {
        Node declaration = program.declarations.get(index);
        if (declaration.kind == NK_PREPROCESSOR_DIRECTIVE) {
            string name = sourceMacroName(declaration.text);
            if (name != "") {
                semanticClaimSymbol(symbols, name,
                    "source macro '" + name + "'", declaration);
            }
        }
        index = index + 1;
    }
}

void semanticCollectSourceMacros(
        Node program, SemanticValidationState state) {
    int index = 0;
    while (index < program.declarations.len) {
        Node declaration = program.declarations.get(index);
        if (declaration.kind == NK_PREPROCESSOR_DIRECTIVE) {
            string name = sourceMacroName(declaration.text);
            if (name != "") {
                state.sourceMacros.put(name, true);
                state.sourceMacroDefinitions.put(name, declaration.text);
            }
            string undefName = sourceUndefName(declaration.text);
            if (undefName != "") {
                state.sourceMacroDefinitions.remove(undefName);
            }
        }
        index = index + 1;
    }
}

void semanticRejectPreprocessorSymbol(string symbol, string action,
        Node site, SemanticValidationState state) {
    if (state.generatedSymbols.has(symbol)) {
        semanticValidationFail(action
            + " compiler-generated C symbol '" + symbol + "' for "
            + state.generatedSymbols.get(symbol) + " is not allowed", site);
    }
    if (compilerOwnedUnresolvedSymbol(symbol)) {
        semanticValidationFail(action
            + " compiler-owned C symbol '" + symbol
            + "' is not allowed", site);
    }
}

void semanticValidateMacroReplacementSymbol(string macroName,
        string sourceText, string symbol, Node site,
        SemanticValidationState state) {
    if (hostedAbiRawLifetimeArity(symbol) > 0) {
        semanticValidationFail("Raw lifetime consumer '" + symbol
            + "' cannot be referenced from macro replacement '"
            + macroName + "'", site);
    } else if (hostedAbiMacroReferenceRequiresSemanticCall(symbol)) {
        semanticValidationFail("Hosted function '" + symbol
            + "' requires semantic call analysis and cannot be referenced "
            + "from macro replacement '" + macroName + "'", site);
    }
    semanticValidateMacroLanguageSymbol(
        macroName, sourceText, symbol, site, state);
    semanticRejectPreprocessorSymbol(symbol,
        "Replacement list for source macro '" + macroName
            + "' references", site, state);
}

void semanticValidatePreprocessorSymbolReferences(
        Node program, SemanticValidationState state) {
    int index = 0;
    while (index < program.declarations.len) {
        Node declaration = program.declarations.get(index);
        if (declaration.kind == NK_PREPROCESSOR_DIRECTIVE) {
            string undefName = sourceUndefName(declaration.text);
            if (undefName != "") {
                semanticRejectPreprocessorSymbol(
                    undefName, "Source #undef of", declaration, state);
            }
            string macroName = sourceMacroName(declaration.text);
            if (macroName != "") {
                if (sourceMacroUsesTokenPaste(declaration.text)) {
                    semanticValidationFail("Source macro '" + macroName
                        + "' uses token pasting, which can construct "
                        + "compiler-owned C symbols", declaration);
                }
                Vector<string> identifiers =
                    sourceMacroReplacementIdentifiers(declaration.text);
                int identifierIndex = 0;
                while (identifierIndex < identifiers.len) {
                    semanticValidateMacroReplacementSymbol(macroName,
                        declaration.text, identifiers.get(identifierIndex),
                        declaration, state);
                    identifierIndex = identifierIndex + 1;
                }
            }
        }
        index = index + 1;
    }
}
