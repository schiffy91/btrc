#include "asdl.btrc"
int main() {
  string src = Path.readAll("src/language/ast.asdl");
  AsdlParser p = AsdlParser(src);
  Vector<AType> types = p.parse();
  int i = 0;
  while (i < types.len) {
    AType t = types.get(i);
    print(f"TYPE {t.name} ctors={t.ctors.len} attrs={t.attrs.len}");
    int j = 0;
    while (j < t.ctors.len) {
      ACtor c = t.ctors.get(j);
      print(f"  CTOR {c.name} fields={c.fields.len}");
      int k = 0;
      while (k < c.fields.len) {
        AField f = c.fields.get(k);
        print(f"    F {f.typeName} {f.name} seq={f.seq} opt={f.opt}");
        k = k + 1;
      }
      j = j + 1;
    }
    int a = 0;
    while (a < t.attrs.len) {
      AField f = t.attrs.get(a);
      print(f"    ATTR {f.typeName} {f.name} seq={f.seq} opt={f.opt}");
      a = a + 1;
    }
    i = i + 1;
  }
  return 0;
}
