import std.bytes;
import std.fs;
import std.io;
import std.strings;
import std.vector;

#include "asdl.btrc"
#include "../frontend_source_io.btrc"
#include "../driver_output.btrc"
int main() {
  BtrccOutput output = BtrccOutput(stdout);
  FeSourceFileReader sourceFiles = FeSourceFileReader();
  string src = sourceFiles.readRequired("src/language/ast.asdl");
  AsdlParser p = AsdlParser(src);
  Vector<AType> types = p.parse();
  int i = 0;
  while (i < types.len) {
    AType t = types.get(i);
    if (!output.writeChunk(
            f"TYPE {t.name} ctors={t.ctors.len} attrs={t.attrs.len}", true)) {
      fprintf(stderr, "asdl_dump: error: cannot write standard output\n");
      return 1;
    }
    int j = 0;
    while (j < t.ctors.len) {
      ACtor c = t.ctors.get(j);
      if (!output.writeChunk(f"  CTOR {c.name} fields={c.fields.len}", true)) {
        fprintf(stderr, "asdl_dump: error: cannot write standard output\n");
        return 1;
      }
      int k = 0;
      while (k < c.fields.len) {
        AField f = c.fields.get(k);
        if (!output.writeChunk(
                f"    F {f.typeName} {f.name} seq={f.seq} opt={f.opt}", true)) {
          fprintf(stderr, "asdl_dump: error: cannot write standard output\n");
          return 1;
        }
        k = k + 1;
      }
      j = j + 1;
    }
    int a = 0;
    while (a < t.attrs.len) {
      AField f = t.attrs.get(a);
      if (!output.writeChunk(
              f"    ATTR {f.typeName} {f.name} seq={f.seq} opt={f.opt}", true)) {
        fprintf(stderr, "asdl_dump: error: cannot write standard output\n");
        return 1;
      }
      a = a + 1;
    }
    i = i + 1;
  }
  if (output.flush()) { return 0; }
  fprintf(stderr, "asdl_dump: error: cannot write standard output\n");
  return 1;
}
