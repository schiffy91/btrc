/* btrc-native ASDL parser.
 *
 * Parses src/language/ast.asdl into AType/ACtor/AField records, so the AST
 * (node.btrc) can be generated by btrc itself — zero dependencies beyond the
 * btrcpy executable. Faithful port of src/compiler/python/ast/asdl_parser.py.
 *
 * ASDL forms handled: `module N { ... }`; `name = Con(fields) | Con(fields) ...
 * [attributes(fields)]`; product/single-constructor types; simple enums
 * (constructors with no fields); fields `type name` / `type* name` (seq) /
 * `type? name` (opt); `--` line comments.
 *
 * No #include — the driver (asdl_main.btrc) composes this with any deps.
 */

class AField {
    public string typeName;
    public string name;
    public bool seq;
    public bool opt;
    public AField(string typeName, string name, bool seq, bool opt) {
        self.typeName = typeName;
        self.name = name;
        self.seq = seq;
        self.opt = opt;
    }
}

class ACtor {
    public string name;
    public Vector<AField> fields;
    public ACtor(string name) {
        self.name = name;
        self.fields = [];
    }
}

class AType {
    public string name;
    public Vector<ACtor> ctors;
    public Vector<AField> attrs;
    public AType(string name) {
        self.name = name;
        self.ctors = [];
        self.attrs = [];
    }
}

class AsdlParser {
    public string src;
    public int pos;

    public AsdlParser(string src) {
        self.src = src;
        self.pos = 0;
    }

    public char cur() {
        if (self.pos >= self.src.length()) { return '\0'; }
        return self.src[self.pos];
    }

    public void skipWs() {
        bool again = true;
        while (again) {
            again = false;
            while (self.pos < self.src.length()) {
                char c = self.src[self.pos];
                if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
                    self.pos = self.pos + 1;
                    again = true;
                } else {
                    break;
                }
            }
            if (self.pos + 1 < self.src.length()
                && self.src[self.pos] == '-' && self.src[self.pos + 1] == '-') {
                while (self.pos < self.src.length() && self.src[self.pos] != '\n') {
                    self.pos = self.pos + 1;
                }
                again = true;
            }
        }
    }

    public string readIdent() {
        self.skipWs();
        int start = self.pos;
        while (self.pos < self.src.length()) {
            char c = self.src[self.pos];
            if (Strings.isAlnum(c) || c == '_') { self.pos = self.pos + 1; } else { break; }
        }
        return self.src.substring(start, self.pos - start);
    }

    public bool eat(char ch) {
        self.skipWs();
        if (self.cur() == ch) { self.pos = self.pos + 1; return true; }
        return false;
    }

    public Vector<AType> parse() {
        Vector<AType> types = [];
        self.readIdent();    // "module"
        self.readIdent();    // module name
        self.eat('{');
        self.skipWs();
        while (self.cur() != '}' && self.cur() != '\0') {
            AType t = self.parseType();
            types.push(t);
            self.skipWs();
        }
        return types;
    }

    public AType parseType() {
        string name = self.readIdent();
        self.eat('=');
        AType t = AType(name);
        bool more = true;
        while (more) {
            string conName = self.readIdent();
            ACtor c = ACtor(conName);
            self.skipWs();
            if (self.cur() == '(') {
                self.eat('(');
                self.parseFields(c.fields);
                self.eat(')');
            }
            t.ctors.push(c);
            self.skipWs();
            if (self.cur() == '|') { self.eat('|'); } else { more = false; }
        }
        // optional `attributes(...)` — else backtrack (it's the next type name)
        int save = self.pos;
        string maybe = self.readIdent();
        if (maybe == "attributes") {
            self.eat('(');
            self.parseFields(t.attrs);
            self.eat(')');
        } else {
            self.pos = save;
        }
        return t;
    }

    public void parseFields(Vector<AField> out) {
        self.skipWs();
        if (self.cur() == ')') { return; }
        bool more = true;
        while (more) {
            string ty = self.readIdent();
            bool seq = false;
            bool opt = false;
            self.skipWs();
            if (self.cur() == '*') { self.eat('*'); seq = true; }
            else if (self.cur() == '?') { self.eat('?'); opt = true; }
            string nm = self.readIdent();
            AField f = AField(ty, nm, seq, opt);
            out.push(f);
            self.skipWs();
            if (self.cur() == ',') { self.eat(','); } else { more = false; }
        }
    }
}
