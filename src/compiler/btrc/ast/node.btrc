            string out = "(NewExpr";
            out = out + "\n" + spaces(2 * (d + 1)) + "type=" + canonNode(self.type, d + 1);
            out = out + "\n" + spaces(2 * (d + 1)) + "args=" + canonNodeList(self.args, d + 1);
            out = out + "\n" + spaces(2 * (d + 1)) + "arg_names=" + canonStrList(self.arg_names, d + 1);
            out = out + "\n" + spaces(2 * (d + 1)) + "line=" + canonInt(self.line);
            out = out + "\n" + spaces(2 * (d + 1)) + "col=" + canonInt(self.col);
            return out + ")";
        } else if (self.kind == NK_TUPLE_LITERAL) {
            string out = "(TupleLiteral";
            out = out + "\n" + spaces(2 * (d + 1)) + "elements=" + canonNodeList(self.elements, d + 1);
            out = out + "\n" + spaces(2 * (d + 1)) + "line=" + canonInt(self.line);
            out = out + "\n" + spaces(2 * (d + 1)) + "col=" + canonInt(self.col);
            return out + ")";
        } else if (self.kind == NK_LAMBDA_EXPR) {
            string out = "(LambdaExpr";
            out = out + "\n" + spaces(2 * (d + 1)) + "return_type=" + canonNode(self.return_type, d + 1);
            out = out + "\n" + spaces(2 * (d + 1)) + "params=" + canonNodeList(self.params, d + 1);
            out = out + "\n" + spaces(2 * (d + 1)) + "body=" + canonNode(self.body_node, d + 1);
            out = out + "\n" + spaces(2 * (d + 1)) + "captures=" + canonNodeList(self.captures, d + 1);
            out = out + "\n" + spaces(2 * (d + 1)) + "line=" + canonInt(self.line);
            out = out + "\n" + spaces(2 * (d + 1)) + "col=" + canonInt(self.col);
            return out + ")";
        } else if (self.kind == NK_SPAWN_EXPR) {
            string out = "(SpawnExpr";
            out = out + "\n" + spaces(2 * (d + 1)) + "fn=" + canonNode(self.fn, d + 1);
            out = out + "\n" + spaces(2 * (d + 1)) + "line=" + canonInt(self.line);
            out = out + "\n" + spaces(2 * (d + 1)) + "col=" + canonInt(self.col);
            return out + ")";
        } else if (self.kind == NK_SIZEOF_TYPE) {
            string out = "(SizeofType";
            out = out + "\n" + spaces(2 * (d + 1)) + "type=" + canonNode(self.type, d + 1);
            return out + ")";
        } else if (self.kind == NK_SIZEOF_EXPR_OP) {
            string out = "(SizeofExprOp";
            out = out + "\n" + spaces(2 * (d + 1)) + "expr=" + canonNode(self.expr, d + 1);
            return out + ")";
        } else if (self.kind == NK_MAP_ENTRY) {
            string out = "(MapEntry";
            out = out + "\n" + spaces(2 * (d + 1)) + "key=" + canonNode(self.key, d + 1);
            out = out + "\n" + spaces(2 * (d + 1)) + "value=" + canonNode(self.value_node, d + 1);
            return out + ")";
        } else if (self.kind == NK_F_STRING_TEXT) {
            string out = "(FStringText";
            out = out + "\n" + spaces(2 * (d + 1)) + "text=" + canonStr(self.text);
            return out + ")";
        } else if (self.kind == NK_F_STRING_EXPR) {
            string out = "(FStringExpr";
            out = out + "\n" + spaces(2 * (d + 1)) + "expression=" + canonNode(self.expression, d + 1);
            return out + ")";
        } else if (self.kind == NK_LAMBDA_BLOCK) {
            string out = "(LambdaBlock";
            out = out + "\n" + spaces(2 * (d + 1)) + "body=" + canonNode(self.body_node, d + 1);
            return out + ")";
        } else if (self.kind == NK_LAMBDA_EXPR_BODY) {
            string out = "(LambdaExprBody";
            out = out + "\n" + spaces(2 * (d + 1)) + "expression=" + canonNode(self.expression, d + 1);
            return out + ")";
        } else if (self.kind == NK_CAPTURE) {
            string out = "(Capture";
            out = out + "\n" + spaces(2 * (d + 1)) + "name=" + canonStr(self.name);
            out = out + "\n" + spaces(2 * (d + 1)) + "type=" + canonNode(self.type, d + 1);
            return out + ")";
        }
        return "(Unknown)";
    }
}

string spaces(int n) {
    string s = "";
    int i = 0;
    while (i < n) { s = s + " "; i = i + 1; }
    return s;
}

string canonInt(int v) { return Strings.fromInt(v); }
string canonBool(bool b) { if (b) { return "true"; } return "false"; }
string canonFloat(float f) { return f"{f}"; }

string canonStr(string s) {
    string out = "\"";
    int i = 0;
    int n = s.length();
    while (i < n) {
        char c = s[i];
        if (c == '\\') { out = out + "\\\\"; }
        else if (c == '"') { out = out + "\\\""; }
        else if (c == '\n') { out = out + "\\n"; }
        else if (c == '\r') { out = out + "\\r"; }
        else if (c == '\t') { out = out + "\\t"; }
        else { out = out + f"{c}"; }
        i = i + 1;
    }
    return out + "\"";
}

string canonOptStr(string? s) {
    if (s == null) { return "nil"; }
    return canonStr(s);
}

string canonNode(Node node, int d) {
    if (node == null) { return "nil"; }
    return node.canon(d);
}

string canonNodeList(Vector<Node> xs, int d) {
    if (xs.len == 0) { return "[]"; }
    string out = "[\n";
    int i = 0;
    while (i < xs.len) {
        out = out + spaces(2 * (d + 1)) + xs.get(i).canon(d + 1);
        if (i < xs.len - 1) { out = out + "\n"; }
        i = i + 1;
    }
    return out + "\n" + spaces(2 * d) + "]";
}

string canonStrList(Vector<string> xs, int d) {
    if (xs.len == 0) { return "[]"; }
    string out = "[\n";
    int i = 0;
    while (i < xs.len) {
        out = out + spaces(2 * (d + 1)) + canonStr(xs.get(i));
        if (i < xs.len - 1) { out = out + "\n"; }
        i = i + 1;
    }
    return out + "\n" + spaces(2 * d) + "]";
}

