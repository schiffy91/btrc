#include "asdl.btrc"

/* btrc-native AST node generator.
 *
 * Reads src/language/ast.asdl, parses it with asdl.btrc, and prints the
 * fat tagged-node AST source (node.btrc) to stdout — byte-identical to the
 * committed src/compiler/btrc/ast/node.btrc. Zero dependencies beyond the
 * btrcpy executable.
 *
 * Faithful port of src/compiler/python/ast/gen_btrc_ast.py + the helpers it
 * reuses from src/compiler/python/ast/asdl_btrc.py.
 */

/* A constructor paired with its parent type's attributes/sum-ness. */
class CtorPlan {
    public ACtor ctor;
    public Vector<AField> attrs;
    public bool parentIsSum;
    public string parentName;
    public CtorPlan(ACtor ctor, Vector<AField> attrs, bool parentIsSum, string parentName) {
        self.ctor = ctor;
        self.attrs = attrs;
        self.parentIsSum = parentIsSum;
        self.parentName = parentName;
    }
}

/* One field's fat-node plan, keyed in declaration order. */
class FieldDecl2 {
    public string backing;
    public string decl;
    public string init;
    public FieldDecl2(string backing, string decl, string init) {
        self.backing = backing;
        self.decl = decl;
        self.init = init;
    }
}

/* Per-kind canon entry. */
class KindEntry {
    public string asdlName;
    public string backing;
    public string cat;
    public string decl;
    public bool optstr;
    public KindEntry(string asdlName, string backing, string cat, string decl, bool optstr) {
        self.asdlName = asdlName;
        self.backing = backing;
        self.cat = cat;
        self.decl = decl;
        self.optstr = optstr;
    }
}

bool charIsUpper(char c) { return c >= 'A' && c <= 'Z'; }
bool charIsLower(char c) { return c >= 'a' && c <= 'z'; }
bool charIsDigit(char c) { return c >= '0' && c <= '9'; }

string charToUpper(char c) {
    if (c >= 'a' && c <= 'z') {
        char u = (char)((int)c - 32);
        return f"{u}";
    }
    return f"{c}";
}

/* snake_case ASDL type name -> PascalCase class name. */
string toPascal(string name) {
    string out = "";
    int i = 0;
    int n = name.length();
    bool atStart = true;
    while (i < n) {
        char c = name[i];
        if (c == '_') {
            atStart = true;
        } else {
            if (atStart) { out = out + charToUpper(c); } else { out = out + f"{c}"; }
            atStart = false;
        }
        i = i + 1;
    }
    return out;
}

/* PascalCase -> SCREAMING_SNAKE_CASE. */
string toScreamingSnake(string name) {
    string out = "";
    int i = 0;
    int n = name.length();
    while (i < n) {
        char ch = name[i];
        if (charIsUpper(ch) && i > 0) {
            char prev = name[i - 1];
            bool nextLower = (i + 1 < n) && charIsLower(name[i + 1]);
            if (charIsLower(prev) || charIsDigit(prev) || (nextLower && charIsUpper(prev))) {
                out = out + "_";
            }
        }
        out = out + charToUpper(ch);
        i = i + 1;
    }
    return out;
}

bool isSumType(AType t) { return t.ctors.len > 1; }

bool isSimpleEnum(AType t) {
    if (t.ctors.len <= 1) { return false; }
    int i = 0;
    while (i < t.ctors.len) {
        if (t.ctors.get(i).fields.len != 0) { return false; }
        i = i + 1;
    }
    return true;
}

/* btrc reserved keywords that collide with field names. The Python side reads
 * these from the grammar; the only field names in this ASDL that collide are
 * `default` and `keep`. */
bool isKeyword(string name) {
    return name == "default" || name == "keep";
}

string safeName(string name) {
    if (isKeyword(name)) { return name + "_"; }
    return name;
}

/* ASDL type name -> btrc type name used in field declarations. */
void buildTypeNameMap(Vector<AType> types, Map<string, string> nameMap) {
    nameMap.put("identifier", "string");
    nameMap.put("string", "string");
    nameMap.put("int", "int");
    nameMap.put("float", "float");
    nameMap.put("bool", "bool");
    int i = 0;
    while (i < types.len) {
        AType t = types.get(i);
        if (isSimpleEnum(t)) {
            nameMap.put(t.name, "int");
        } else if (isSumType(t)) {
            nameMap.put(t.name, toPascal(t.name));
        } else {
            nameMap.put(t.name, t.ctors.get(0).name);
        }
        i = i + 1;
    }
}

string btrcType(AField f, Map<string, string> nameMap) {
    string base = f.typeName;
    if (nameMap.has(f.typeName)) { base = nameMap.get(f.typeName); }
    if (f.seq) { return f"List<{base}>"; }
    return base;
}

bool isScalar(string t) {
    return t == "int" || t == "bool" || t == "string" || t == "float";
}

/* (category) for a field's fat-node representation. */
string fatCat(string btrcT) {
    if (isScalar(btrcT)) { return "scalar"; }
    if (btrcT.startsWith("List<")) {
        string inner = btrcT.substring(5, btrcT.length() - 6);
        if (inner == "string") { return "strlist"; }
        return "nodelist";
    }
    return "node";
}

/* (declared btrc type) for a field's fat-node representation. */
string fatDecl(string btrcT) {
    if (isScalar(btrcT)) { return btrcT; }
    if (btrcT.startsWith("List<")) {
        string inner = btrcT.substring(5, btrcT.length() - 6);
        if (inner == "string") { return "Vector<string>"; }
        return "Vector<Node>";
    }
    return "Node";
}

string variantSuffix(string cat, string decl) {
    if (cat == "scalar") { return decl; }
    if (cat == "node") { return "node"; }
    if (cat == "nodelist") { return "nlist"; }
    return "slist";
}

string initFor(string decl) {
    if (decl == "int") { return "0"; }
    if (decl == "bool") { return "false"; }
    if (decl == "string") { return "\"\""; }
    if (decl == "float") { return "0.0"; }
    if (decl == "Vector<Node>") { return "[]"; }
    if (decl == "Vector<string>") { return "[]"; }
    return "null";
}

string valueDump(string cat, string decl, string backing, bool optstr) {
    if (cat == "scalar") {
        if (optstr) { return f"canonOptStr(self.{backing})"; }
        if (decl == "int") { return f"canonInt(self.{backing})"; }
        if (decl == "bool") { return f"canonBool(self.{backing})"; }
        if (decl == "string") { return f"canonStr(self.{backing})"; }
        return f"canonFloat(self.{backing})";
    }
    if (cat == "node") { return f"canonNode(self.{backing}, d + 1)"; }
    if (cat == "nodelist") { return f"canonNodeList(self.{backing}, d + 1)"; }
    return f"canonStrList(self.{backing}, d + 1)";
}

int main() {
    string src = Path.readAll("src/language/ast.asdl");
    AsdlParser p = AsdlParser(src);
    Vector<AType> types = p.parse();

    Map<string, string> nameMap = {};
    buildTypeNameMap(types, nameMap);

    // ctors (excluding simple enums), each with parent attrs + sum-ness.
    Vector<CtorPlan> ctors = [];
    int ti = 0;
    while (ti < types.len) {
        AType t = types.get(ti);
        if (!isSimpleEnum(t)) {
            bool sum = isSumType(t);
            int ci = 0;
            while (ci < t.ctors.len) {
                CtorPlan cp = CtorPlan(t.ctors.get(ci), t.attrs, sum, t.name);
                ctors.push(cp);
                ci = ci + 1;
            }
        }
        ti = ti + 1;
    }

    // Collect every safe field name -> set of "cat|decl" across constructors.
    Map<string, Vector<string>> seen = {};
    Vector<string> seenOrder = [];
    int pi = 0;
    while (pi < ctors.len) {
        CtorPlan cp = ctors.get(pi);
        Vector<AField> fields = [];
        int fi = 0;
        while (fi < cp.ctor.fields.len) { fields.push(cp.ctor.fields.get(fi)); fi = fi + 1; }
        int ai = 0;
        while (ai < cp.attrs.len) { fields.push(cp.attrs.get(ai)); ai = ai + 1; }
        int k = 0;
        while (k < fields.len) {
            AField f = fields.get(k);
            string bt = btrcType(f, nameMap);
            string cat = fatCat(bt);
            string decl = fatDecl(bt);
            string nm = safeName(f.name);
            string tag = f"{cat}|{decl}";
            if (!seen.has(nm)) {
                Vector<string> v = [];
                seen.put(nm, v);
                seenOrder.push(nm);
            }
            Vector<string> tags = seen.get(nm);
            bool found = false;
            int x = 0;
            while (x < tags.len) {
                if (tags.get(x) == tag) { found = true; }
                x = x + 1;
            }
            if (!found) { tags.push(tag); }
            k = k + 1;
        }
        pi = pi + 1;
    }

    // conflicted: names with >1 distinct (cat,decl).
    Map<string, bool> conflicted = {};
    int si = 0;
    while (si < seenOrder.len) {
        string nm = seenOrder.get(si);
        if (seen.get(nm).len > 1) { conflicted.put(nm, true); }
        si = si + 1;
    }

    // A string field optional in EVERY use (and not conflicted) becomes string?.
    Map<string, bool> strSeen = {};        // name -> has any string use
    Map<string, bool> strAllOpt = {};      // name -> all string uses are opt
    Vector<string> strOrder = [];
    int qi = 0;
    while (qi < ctors.len) {
        CtorPlan cp = ctors.get(qi);
        Vector<AField> fields = [];
        int fi = 0;
        while (fi < cp.ctor.fields.len) { fields.push(cp.ctor.fields.get(fi)); fi = fi + 1; }
        int ai = 0;
        while (ai < cp.attrs.len) { fields.push(cp.attrs.get(ai)); ai = ai + 1; }
        int k = 0;
        while (k < fields.len) {
            AField f = fields.get(k);
            string bt = btrcType(f, nameMap);
            string cat = fatCat(bt);
            string decl = fatDecl(bt);
            if (cat == "scalar" && decl == "string") {
                string nm = safeName(f.name);
                if (!strSeen.has(nm)) {
                    strSeen.put(nm, true);
                    strAllOpt.put(nm, true);
                    strOrder.push(nm);
                }
                if (!f.opt) { strAllOpt.put(nm, false); }
            }
            k = k + 1;
        }
        qi = qi + 1;
    }
    Map<string, bool> nullableStr = {};
    int ri = 0;
    while (ri < strOrder.len) {
        string nm = strOrder.get(ri);
        if (strAllOpt.get(nm) && !conflicted.has(nm)) { nullableStr.put(nm, true); }
        ri = ri + 1;
    }

    // Ordered, de-duplicated backing field declarations + per-kind canon plans.
    Map<string, FieldDecl2> decls = {};
    Vector<string> order = [];
    Map<string, Vector<KindEntry>> perKind = {};
    Vector<string> kindOrder = [];
    int ki = 0;
    while (ki < ctors.len) {
        CtorPlan cp = ctors.get(ki);
        string kind = f"NK_{toScreamingSnake(cp.ctor.name)}";
        Vector<KindEntry> entries = [];
        Vector<AField> fields = [];
        int fi = 0;
        while (fi < cp.ctor.fields.len) { fields.push(cp.ctor.fields.get(fi)); fi = fi + 1; }
        int ai = 0;
        while (ai < cp.attrs.len) { fields.push(cp.attrs.get(ai)); ai = ai + 1; }
        int k = 0;
        while (k < fields.len) {
            AField f = fields.get(k);
            string nm = safeName(f.name);
            string bt = btrcType(f, nameMap);
            string cat = fatCat(bt);
            string decl = fatDecl(bt);
            string bn = nm;
            if (conflicted.has(nm)) { bn = f"{nm}_{variantSuffix(cat, decl)}"; }
            bool optstr = nullableStr.has(bn);
            if (!decls.has(bn)) {
                if (optstr) {
                    FieldDecl2 fd = FieldDecl2(bn, "string?", "null");
                    decls.put(bn, fd);
                } else {
                    FieldDecl2 fd = FieldDecl2(bn, decl, initFor(decl));
                    decls.put(bn, fd);
                }
                order.push(bn);
            }
            KindEntry ke = KindEntry(f.name, bn, cat, decl, optstr);
            entries.push(ke);
            k = k + 1;
        }
        perKind.put(kind, entries);
        kindOrder.push(kind);
        ki = ki + 1;
    }

    // ---- emit ----
    Vector<string> L = [];
    L.push("/* Self-hosted btrc AST — fat tagged node.");
    L.push(" *");
    L.push(" * Auto-generated from src/language/ast/ast.asdl by gen_btrc_ast.py.");
    L.push(" * DO NOT EDIT BY HAND. btrc lacks dynamic dispatch/downcast, so the AST");
    L.push(" * is one Node with a `kind` tag + the union of all fields.");
    L.push(" */");
    L.push("");

    // NodeKind enum
    L.push("enum NodeKind {");
    L.push("    NK_NONE = 0,");
    int ei = 0;
    while (ei < ctors.len) {
        CtorPlan cp = ctors.get(ei);
        L.push(f"    NK_{toScreamingSnake(cp.ctor.name)},");
        ei = ei + 1;
    }
    L.push("};");
    L.push("");

    // simple enums
    int sei = 0;
    while (sei < types.len) {
        AType t = types.get(sei);
        if (isSimpleEnum(t)) {
            L.push(f"enum {toPascal(t.name)} {{");
            int ci = 0;
            while (ci < t.ctors.len) {
                string comma = ",";
                if (ci >= t.ctors.len - 1) { comma = ""; }
                L.push(f"    {toScreamingSnake(t.ctors.get(ci).name)} = {ci}{comma}");
                ci = ci + 1;
            }
            L.push("};");
            L.push("");
        }
        sei = sei + 1;
    }

    // fat Node class
    L.push("class Node {");
    L.push("    public int kind;");
    int di = 0;
    while (di < order.len) {
        FieldDecl2 fd = decls.get(order.get(di));
        L.push(f"    public {fd.decl} {fd.backing};");
        di = di + 1;
    }
    L.push("");
    L.push("    public Node() {");
    L.push("        self.kind = NK_NONE;");
    int di2 = 0;
    while (di2 < order.len) {
        FieldDecl2 fd = decls.get(order.get(di2));
        L.push(f"        self.{fd.backing} = {fd.init};");
        di2 = di2 + 1;
    }
    L.push("    }");
    L.push("");

    // canon(depth)
    L.push("    public string canon(int d) {");
    int ci2 = 0;
    bool first = true;
    while (ci2 < ctors.len) {
        CtorPlan cp = ctors.get(ci2);
        string kind = f"NK_{toScreamingSnake(cp.ctor.name)}";
        string kw = "} else if";
        if (first) { kw = "if"; }
        first = false;
        L.push(f"        {kw} (self.kind == {kind}) {{");
        L.push(f"            string out = \"({cp.ctor.name}\";");
        Vector<KindEntry> entries = perKind.get(kind);
        int ei2 = 0;
        while (ei2 < entries.len) {
            KindEntry ke = entries.get(ei2);
            string vd = valueDump(ke.cat, ke.decl, ke.backing, ke.optstr);
            L.push(f"            out = out + \"\\n\" + spaces(2 * (d + 1)) + \"{ke.asdlName}=\" + {vd};");
            ei2 = ei2 + 1;
        }
        L.push("            return out + \")\";");
        ci2 = ci2 + 1;
    }
    L.push("        }");
    L.push("        return \"(Unknown)\";");
    L.push("    }");
    L.push("}");
    L.push("");

    // canon formatting helpers (verbatim)
    L.push(helpers());

    print(Strings.join(L, "\n"));
    return 0;
}

string helpers() {
    string h = "";
    h = h + "string spaces(int n) {\n";
    h = h + "    string s = \"\";\n";
    h = h + "    int i = 0;\n";
    h = h + "    while (i < n) { s = s + \" \"; i = i + 1; }\n";
    h = h + "    return s;\n";
    h = h + "}\n";
    h = h + "\n";
    h = h + "string canonInt(int v) { return Strings.fromInt(v); }\n";
    h = h + "string canonBool(bool b) { if (b) { return \"true\"; } return \"false\"; }\n";
    h = h + "string canonFloat(float f) { return f\"{f}\"; }\n";
    h = h + "\n";
    h = h + "string canonStr(string s) {\n";
    h = h + "    string out = \"\\\"\";\n";
    h = h + "    int i = 0;\n";
    h = h + "    int n = s.length();\n";
    h = h + "    while (i < n) {\n";
    h = h + "        char c = s[i];\n";
    h = h + "        if (c == '\\\\') { out = out + \"\\\\\\\\\"; }\n";
    h = h + "        else if (c == '\"') { out = out + \"\\\\\\\"\"; }\n";
    h = h + "        else if (c == '\\n') { out = out + \"\\\\n\"; }\n";
    h = h + "        else if (c == '\\r') { out = out + \"\\\\r\"; }\n";
    h = h + "        else if (c == '\\t') { out = out + \"\\\\t\"; }\n";
    h = h + "        else { out = out + f\"{c}\"; }\n";
    h = h + "        i = i + 1;\n";
    h = h + "    }\n";
    h = h + "    return out + \"\\\"\";\n";
    h = h + "}\n";
    h = h + "\n";
    h = h + "string canonOptStr(string? s) {\n";
    h = h + "    if (s == null) { return \"nil\"; }\n";
    h = h + "    return canonStr(s);\n";
    h = h + "}\n";
    h = h + "\n";
    h = h + "string canonNode(Node node, int d) {\n";
    h = h + "    if (node == null) { return \"nil\"; }\n";
    h = h + "    return node.canon(d);\n";
    h = h + "}\n";
    h = h + "\n";
    h = h + "string canonNodeList(Vector<Node> xs, int d) {\n";
    h = h + "    if (xs.len == 0) { return \"[]\"; }\n";
    h = h + "    string out = \"[\\n\";\n";
    h = h + "    int i = 0;\n";
    h = h + "    while (i < xs.len) {\n";
    h = h + "        out = out + spaces(2 * (d + 1)) + xs.get(i).canon(d + 1);\n";
    h = h + "        if (i < xs.len - 1) { out = out + \"\\n\"; }\n";
    h = h + "        i = i + 1;\n";
    h = h + "    }\n";
    h = h + "    return out + \"\\n\" + spaces(2 * d) + \"]\";\n";
    h = h + "}\n";
    h = h + "\n";
    h = h + "string canonStrList(Vector<string> xs, int d) {\n";
    h = h + "    if (xs.len == 0) { return \"[]\"; }\n";
    h = h + "    string out = \"[\\n\";\n";
    h = h + "    int i = 0;\n";
    h = h + "    while (i < xs.len) {\n";
    h = h + "        out = out + spaces(2 * (d + 1)) + canonStr(xs.get(i));\n";
    h = h + "        if (i < xs.len - 1) { out = out + \"\\n\"; }\n";
    h = h + "        i = i + 1;\n";
    h = h + "    }\n";
    h = h + "    return out + \"\\n\" + spaces(2 * d) + \"]\";\n";
    h = h + "}\n";
    return h;
}
