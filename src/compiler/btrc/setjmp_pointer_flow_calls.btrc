/* Call transfers for setjmp pointer provenance. */

Vector<SetjmpOrigin> setjmpFlowCall(
        SetjmpPointerFlow flow, IRNode call) {
    if (call.expr != null) { setjmpFlowExpression(flow, call.expr); }
    int index = 0;
    while (index < call.args.len) {
        setjmpFlowExpression(flow, call.args.get(index));
        index = index + 1;
    }
    SetjmpFunctionEffect effect =
        setjmpFlowEffectFor(flow, call.callee, call.args.len);
    Vector<SetjmpOrigin> writes = [];
    index = 0;
    while (index < effect.writes.len) {
        SetjmpParameterEffect item = effect.writes.get(index);
        if (item.index >= 0 && item.index < call.args.len) {
            setjmpAddOrigins(writes, setjmpFlowArgumentTargets(
                flow, call.args.get(item.index), item.depth));
        }
        index = index + 1;
    }
    flow.result.recordWrite(call, writes);
    index = 0;
    while (index < writes.len) {
        SetjmpOrigin origin = writes.get(index);
        SetjmpStorage storage = origin.storage;
        if (origin.depth == 0 && storage.isPointer && !storage.isArray) {
            Vector<SetjmpOrigin> unknown = [];
            flow.replaceAliases(storage, unknown);
            if (origin.sourceExposed && !storage.compilerOwned) {
                flow.result.recordUnknownPointerValue(storage);
            }
        }
        index = index + 1;
    }
    index = 0;
    while (index < effect.captures.len) {
        SetjmpParameterEffect item = effect.captures.get(index);
        if (item.index >= 0 && item.index < call.args.len) {
            setjmpAddOrigins(flow.result.captures,
                setjmpFlowArgumentTargets(
                    flow, call.args.get(item.index), item.depth));
        }
        index = index + 1;
    }
    Vector<SetjmpOrigin> returns = [];
    index = 0;
    while (index < effect.returns.len) {
        SetjmpParameterEffect item = effect.returns.get(index);
        if (item.index >= 0 && item.index < call.args.len) {
            setjmpAddOrigins(returns, setjmpFlowArgumentTargets(
                flow, call.args.get(item.index), item.depth));
        }
        index = index + 1;
    }
    if (effect.unknownReturn) {
        index = 0;
        while (index < call.args.len) {
            setjmpAddOrigins(
                returns, flow.result.originsFor(call.args.get(index)));
            index = index + 1;
        }
    }
    flow.result.recordOrigins(call, returns);
    return returns;
}
