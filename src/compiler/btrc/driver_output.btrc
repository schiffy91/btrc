/* Checked process output owned by a concrete stream instance. */

class BtrccOutput {
    private FILE* stream;

    public BtrccOutput(FILE* stream) {
        self.stream = stream;
    }

    public bool writeChunk(string value, bool trailingNewline) {
        if (value == null || self.stream == NULL) { return false; }
        int length = value.length();
        if (length > 0
                && fwrite(value, 1, (size_t)length, self.stream)
                    != (size_t)length) {
            return false;
        }
        if (trailingNewline && fputc('\n', self.stream) == EOF) {
            return false;
        }
        return ferror(self.stream) == 0;
    }

    public bool flush() {
        if (self.stream == NULL || fflush(self.stream) != 0) { return false; }
        return ferror(self.stream) == 0;
    }

    public bool write(string value, bool trailingNewline = false) {
        return self.writeChunk(value, trailingNewline) && self.flush();
    }

    public bool writeLine(string value) {
        return self.write(value, true);
    }
}
