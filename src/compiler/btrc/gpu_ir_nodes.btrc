/* Typed GPU IR metadata shared by lowering, DCE, and C emission.
 * WGSL is the deliberate foreign-language boundary; host dispatch remains
 * ordinary structured IRFunction/IRNode data. */

class IRGpuBuffer {
    public string name;
    public string elem_type;
    public int binding;

    public IRGpuBuffer(string name, string elemType, int binding) {
        self.name = name;
        self.elem_type = elemType;
        self.binding = binding;
    }
}

class IRGpuUniform {
    public string name;
    public string storage_type;

    public IRGpuUniform(string name, string storageType) {
        self.name = name;
        self.storage_type = storageType;
    }
}

class IRGpuKernel {
    public string name;
    public string wgsl_source;
    public int workgroup_size;
    public Vector<IRGpuBuffer> param_buffers;
    public IRGpuBuffer output_buffer;
    public Vector<IRGpuUniform> uniform_params;
    public Node declaration;

    public IRGpuKernel(string name, Node declaration) {
        self.name = name;
        self.wgsl_source = "";
        self.workgroup_size = 64;
        self.param_buffers = [];
        self.output_buffer = null;
        self.uniform_params = [];
        self.declaration = declaration;
    }
}

class GpuRegistry {
    public Map<string, IRGpuKernel> kernels;

    public GpuRegistry() { self.kernels = {}; }
}

class GpuCpuContext {
    public bool active;
    public bool returns_array;
    public string index_name;
    public Map<string, string> array_lengths;

    public GpuCpuContext() {
        self.active = false;
        self.returns_array = false;
        self.index_name = "";
        self.array_lengths = {};
    }
}

class GpuHostContext {
    public Map<string, IRNode> array_lengths;
    public Map<string, bool> unknown_array_lengths;

    public GpuHostContext() {
        self.array_lengths = {};
        self.unknown_array_lengths = {};
    }

    public void clear() {
        self.array_lengths = {};
        self.unknown_array_lengths = {};
    }
}
