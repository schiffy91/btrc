/* C formatting for the one foreign-language boundary: a WGSL string global. */

string escapeGpuShader(string source) {
    string escaped = "";
    int i = 0;
    while (i < source.length()) {
        char c = source[i];
        if (c == '\\') { escaped = escaped + "\\\\"; }
        else if (c == '"') { escaped = escaped + "\\\""; }
        else if (c == '\n') { escaped = escaped + "\\n"; }
        else if (c == '\r') { escaped = escaped + "\\r"; }
        else if (c == '\t') { escaped = escaped + "\\t"; }
        else { escaped = escaped + source.substring(i, 1); }
        i = i + 1;
    }
    return escaped;
}

void emitGpuKernels(CEmitter emitter, IRModule module) {
    int i = 0;
    while (i < module.gpu_kernels.len) {
        IRGpuKernel kernel = module.gpu_kernels.get(i);
        emitter.line("static char* " + kernel.name + "_wgsl = \""
            + escapeGpuShader(kernel.wgsl_source) + "\";");
        emitter.line("");
        i = i + 1;
    }
}
