/* C literals frozen while lowering a declaration-scoped default. */

string defaultArgumentCStringLiteral(string value) {
    string escaped = Strings.replace(value, "\\", "\\\\");
    escaped = Strings.replace(escaped, "\"", "\\\"");
    escaped = Strings.replace(escaped, "\r", "\\r");
    escaped = Strings.replace(escaped, "\n", "\\n");
    escaped = Strings.replace(escaped, "\t", "\\t");
    return "\"" + escaped + "\"";
}
