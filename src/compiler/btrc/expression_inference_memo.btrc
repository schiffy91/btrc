/* Context-scoped memoization for recursive expression inference.
 *
 * `inferTypeRaw` recursively re-enters inferSpecializationType for child AST
 * nodes. Keeping the memo at that public recursion seam makes one inference
 * epoch linear in the number of distinct nodes instead of repeatedly walking
 * every suffix of a deep expression. IR generation alone enables the memo;
 * semantic analysis continues to use an isolated uncached environment. */

void beginExpressionInferenceMemo(Analyzed analyzed) {
    analyzed.expressionInferenceMemoKnown = {};
    analyzed.expressionInferenceMemoValues = {};
    analyzed.expressionInferenceMemoEnabled = true;
}

/* Module prepasses (notably WGSL registration) use their own contextual type
 * domains. Start every generate() call with no persistent inference context;
 * individual lowered bodies opt in through beginExpressionInferenceMemo. */
void disableExpressionInferenceMemo(Analyzed analyzed) {
    analyzed.expressionInferenceMemoKnown = {};
    analyzed.expressionInferenceMemoValues = {};
    analyzed.expressionInferenceMemoEnabled = false;
}

Node? inferSpecializationType(
        Node? node, Analyzed analyzed, Map<string, Node> varTypes) {
    if (node == null || !analyzed.expressionInferenceMemoEnabled) {
        return inferSpecializationTypeUnmemoized(
            node, analyzed, varTypes);
    }
    string key = astNodeKey(node);
    if (analyzed.expressionInferenceMemoKnown.has(key)) {
        if (analyzed.expressionInferenceMemoValues.has(key)) {
            return analyzed.expressionInferenceMemoValues.get(key);
        }
        return null;
    }
    Node? result = inferSpecializationTypeUnmemoized(
        node, analyzed, varTypes);
    analyzed.expressionInferenceMemoKnown.put(key, true);
    if (result != null) {
        analyzed.expressionInferenceMemoValues.put(key, result);
    }
    return result;
}

/* Defaults are declaration-scoped ASTs reused under call-site environments.
 * Disable the persistent body memo for the complete recursive inference, then
 * restore the enclosing context without discarding its already-proven types. */
Node? inferSpecializationTypeWithoutMemo(
        Node? node, Analyzed analyzed, Map<string, Node> varTypes) {
    bool enabled = analyzed.expressionInferenceMemoEnabled;
    analyzed.expressionInferenceMemoEnabled = false;
    Node? result = inferSpecializationTypeUnmemoized(
        node, analyzed, varTypes);
    analyzed.expressionInferenceMemoEnabled = enabled;
    return result;
}
