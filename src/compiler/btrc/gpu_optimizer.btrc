/* Dead GPU shader elimination after ordinary function reachability DCE. */

void collectGpuRefs(IRNode? node, Map<string, bool> shaderNames,
        Map<string, bool> used) {
    if (node == null) { return; }
    if (node.kind == IRK_VAR && shaderNames.has(node.name)) {
        used.put(node.name, true);
    }
    collectGpuRefs(node.left, shaderNames, used);
    collectGpuRefs(node.right, shaderNames, used);
    collectGpuRefs(node.operand, shaderNames, used);
    collectGpuRefs(node.expr, shaderNames, used);
    collectGpuRefs(node.obj, shaderNames, used);
    collectGpuRefs(node.index, shaderNames, used);
    collectGpuRefs(node.condition, shaderNames, used);
    collectGpuRefs(node.true_expr, shaderNames, used);
    collectGpuRefs(node.false_expr, shaderNames, used);
    collectGpuRefs(node.init, shaderNames, used);
    collectGpuRefs(node.value, shaderNames, used);
    collectGpuRefs(node.target, shaderNames, used);
    collectGpuRefs(node.then_block, shaderNames, used);
    collectGpuRefs(node.else_block, shaderNames, used);
    collectGpuRefs(node.body, shaderNames, used);
    collectGpuRefs(node.update, shaderNames, used);
    collectGpuRefs(node.result, shaderNames, used);
    int a = 0;
    while (a < node.args.len) {
        collectGpuRefs(node.args.get(a), shaderNames, used);
        a = a + 1;
    }
    int s = 0;
    while (s < node.stmts.len) {
        collectGpuRefs(node.stmts.get(s), shaderNames, used);
        s = s + 1;
    }
}

void eliminateDeadGpuKernels(IRModule module) {
    Map<string, bool> names = {};
    int k = 0;
    while (k < module.gpu_kernels.len) {
        names.put(module.gpu_kernels.get(k).name + "_wgsl", true);
        k = k + 1;
    }
    Map<string, bool> used = {};
    int f = 0;
    while (f < module.functions.len) {
        collectGpuRefs(module.functions.get(f).body, names, used);
        f = f + 1;
    }
    Vector<IRGpuKernel> kept = [];
    k = 0;
    while (k < module.gpu_kernels.len) {
        IRGpuKernel kernel = module.gpu_kernels.get(k);
        if (used.has(kernel.name + "_wgsl")) { kept.push(kernel); }
        k = k + 1;
    }
    module.gpu_kernels = kept;
    if (kept.len == 0) {
        Vector<IRPreprocessorDecl> preprocessor = [];
        int p = 0;
        while (p < module.preprocessor_decls.len) {
            IRPreprocessorDecl declaration = module.preprocessor_decls.get(p);
            if (!(declaration.kind == IR_PREPROCESSOR_INCLUDE
                    && !declaration.is_system
                    && declaration.header == "btrc_gpu.h")) {
                preprocessor.push(declaration);
            }
            p = p + 1;
        }
        module.preprocessor_decls = preprocessor;
    }
}
