/* Statement/body validation with lexical type scopes. */

void semanticValidateVariable(Node declaration,
        SemanticValidationState state, Map<string, Node> vars) {
    if (state.owner == "") {
        semanticValidateDeclaredName(
            declaration.name, "Variable", declaration);
    } else {
        semanticValidateLexicalBindingName(
            declaration.name, "Variable", declaration, state);
    }
    Node? preliminaryType = declaration.type;
    if (preliminaryType == null && declaration.initializer != null) {
        preliminaryType = semanticInferType(
            declaration.initializer, state, vars);
    }
    if (state.owner != "") {
        semanticRejectThreadOwnerShadow(
            declaration.name, preliminaryType, vars, declaration, state);
    }
    semanticValidateMutexPayloadsInType(
        preliminaryType, declaration, state);
    semanticValidateThreadVariableOwner(
        declaration, preliminaryType, state.owner == "", state);
    semanticValidateVariableStorage(
        declaration, state.owner == "", state, vars);
    semanticRejectRuntimeInterfaceType(declaration.type, declaration, state);
    contextualizeGenericConstructor(
        declaration.type, declaration.initializer, state, vars);
    semanticValidateGpuArrayInitializer(
        declaration.initializer, declaration.type, state, vars);
    bool previousOwnedOpaqueVariable = state.allowOwnedOpaqueVariable;
    state.allowOwnedOpaqueVariable = semanticExpressionOwnsResult(
        declaration.initializer, state, vars);
    Node? declared = semanticArrayValueType(
        declaration.type, state);
    Node? sourceDeclared = semanticResolveAliases(
        declaration.type, state);
    Node? representedDeclared = semanticResolveAliases(declared, state);
    if (semanticGpuArrayResultCall(
            declaration.initializer, state, vars)
            && sourceDeclared != null && sourceDeclared.is_array
            && representedDeclared != null
            && !representedDeclared.is_array) {
        semanticValidationFail("Initializer for '" + declaration.name
            + "' cannot materialize an array-returning @gpu result through "
            + "a pointer-valued array alias", declaration);
    }
    semanticValidateTypedInitializer(declared, declaration.initializer,
        "Initializer for '" + declaration.name + "'", state, vars);
    /* Typed initializer validation owns qualifier loss before its opaque
     * representation check.  Keep the preliminary-type check afterward for
     * inferred `var` bindings whose target type is not available yet. */
    semanticValidateOpaqueBorrowStorage(
        preliminaryType, declaration.initializer,
        "Variable '" + declaration.name + "'", state, vars);
    state.allowOwnedOpaqueVariable = previousOwnedOpaqueVariable;
    Node? actual = semanticInferType(
        declaration.initializer, state, vars);
    if (semanticScalarVoid(actual)) {
        semanticValidationFail("Cannot assign void expression to variable '"
            + declaration.name + "'", declaration);
    }
    if (declared == null) {
        if (declaration.initializer == null) {
            semanticValidationFail("'var' declaration of '" + declaration.name
                + "' requires an initializer", declaration);
        }
        if (declaration.initializer.kind == NK_BRACE_INITIALIZER) {
            semanticValidationFail("Cannot infer array storage for 'var' from "
                + "a brace initializer; use an explicit array declaration",
                declaration);
        }
        if (actual == null) {
            semanticValidationFail("Cannot infer type for 'var' declaration of '"
                + declaration.name + "'", declaration);
        }
        declared = semanticInferredBindingValueType(
            actual, declaration.initializer, state, vars);
    } else if (actual != null
            && !semanticAssignmentCompatible(declared, actual, state)
            && !semanticContextualAggregateInitializer(
                declaration.initializer)) {
        semanticValidationFail("Cannot assign '" + semanticFormatType(actual)
            + "' to variable '" + declaration.name + "' of type '"
            + semanticFormatType(declared) + "'", declaration);
    }
    semanticRejectThreadHandleCopy(
        declared, actual, declaration.initializer, declaration, state);
    vars.put(declaration.name, declared);
    state.borrowedBindings.remove(declaration.name);
    if (state.owner != "") {
        state.localBindings.put(declaration.name, true);
    }
}

void semanticValidateReturn(Node statement, SemanticValidationState state,
        Map<string, Node> vars) {
    contextualizeGenericConstructor(
        state.returnType, statement.value_node, state, vars);
    semanticValidateExpr(statement.value_node, state, vars);
    semanticValidateThreadTransferSource(statement.value_node, state, vars);
    if (state.returnType == null) { return; }
    Node expectedReturn = state.returnType;
    semanticValidateOpaqueBorrowStorage(
        expectedReturn, statement.value_node, "Return value", state, vars);
    semanticValidateVolatileReferenceConversion(
        expectedReturn, statement.value_node,
        "Return value", state, vars);
    if (!state.gpuCallable || !expectedReturn.is_array) {
        semanticValidateTypedInitializer(expectedReturn, statement.value_node,
            "Return value", state, vars);
    }
    bool returnsVoid = semanticScalarVoid(expectedReturn);
    if (statement.value_node == null) {
        if (!returnsVoid) {
            semanticValidationFail("Non-void function or method must return '"
                + semanticFormatType(expectedReturn) + "'", statement);
        }
        return;
    }
    if (returnsVoid) {
        semanticValidationFail(
            "Void function or method cannot return a value", statement);
    }
    Node? actual = semanticInferType(statement.value_node, state, vars);
    if (state.borrowedReturn
            && semanticRequiresTargetStringConversion(
                expectedReturn, actual, state)) {
        semanticValidationFail(
            "Borrowed property getter cannot return an implicit "
                + "class-to-string conversion because conversion creates "
                + "a caller-owned temporary",
            statement.value_node);
    }
    bool compatible = semanticContextualAggregateInitializer(
            statement.value_node)
        || actual == null
        || semanticAssignmentCompatible(expectedReturn, actual, state);
    if (!compatible && state.gpuCallable && expectedReturn.is_array) {
        Node elementType = typeWithoutOuterArray(expectedReturn);
        compatible = semanticAssignmentCompatible(
            elementType, actual, state);
    }
    if (!compatible) {
        semanticValidationFail("Return type mismatch: expected '"
            + semanticFormatType(expectedReturn) + "' but got '"
            + semanticFormatType(actual) + "'", statement);
    }
}

void semanticValidateCFor(Node statement, SemanticValidationState state,
        Map<string, Node> vars) {
    Map<string, bool> previousLocalBindings =
        semanticCloneFlags(state.localBindings);
    Map<string, Node> loopVars = semanticCloneTypes(vars);
    if (statement.init != null) {
        if (statement.init.kind == NK_FOR_INIT_VAR) {
            Node declaration = statement.init.var_decl;
            semanticValidateVariable(declaration, state, loopVars);
            Node? declarationType = declaration.type;
            if (declarationType == null) {
                declarationType = semanticInferType(
                    declaration.initializer, state, loopVars);
            }
            if (declaration.type != null
                    && (declaration.type.is_static
                        || declaration.type.is_extern)) {
                semanticValidationFail("C-style for initializer cannot use "
                    + "static or extern storage", declaration);
            }
            if (declarationType != null && declarationType.is_array) {
                semanticValidationFail("C-style for initializer cannot "
                    + "declare an array", declaration);
            }
        } else if (statement.init.kind == NK_FOR_INIT_EXPR) {
            semanticValidateExpr(statement.init.expression, state, loopVars);
            semanticRejectThreadObservation(
                statement.init.expression, state, loopVars);
        }
    }
    semanticValidateExpr(statement.condition, state, loopVars);
    semanticValidateCondition(
        statement.condition, "C-style for loop", state, loopVars);
    int previousLoop = state.loopDepth;
    int previousBreak = state.breakDepth;
    state.loopDepth = previousLoop + 1;
    state.breakDepth = previousBreak + 1;
    semanticValidateBlock(statement.body_node, state, loopVars);
    semanticValidateExpr(statement.update, state, loopVars);
    semanticRejectThreadObservation(statement.update, state, loopVars);
    state.loopDepth = previousLoop;
    state.breakDepth = previousBreak;
    state.localBindings = previousLocalBindings;
}

void semanticValidateTry(Node statement, SemanticValidationState state,
        Map<string, Node> vars) {
    semanticValidateBlock(statement.try_block, state, vars);
    if (statement.catch_block != null) {
        Map<string, bool> previousCatchLocals =
            semanticCloneFlags(state.localBindings);
        Map<string, Node> catchVars = semanticCloneTypes(vars);
        Map<string, bool> catchNames = {};
        Node catchType = statement.catch_type;
        if (catchType == null) { catchType = makePrimType("string"); }
        if (statement.catch_var != "") {
            semanticValidateLexicalBindingName(
                statement.catch_var, "Catch variable", statement, state);
            semanticRejectThreadOwnerShadow(
                statement.catch_var, catchType, vars, statement, state);
            catchNames.put(statement.catch_var, true);
            catchVars.put(statement.catch_var, catchType);
            state.localBindings.put(statement.catch_var, true);
        }
        semanticValidateDirectLocalNames(
            statement.catch_block, catchNames);
        semanticValidateBlock(statement.catch_block, state, catchVars);
        state.localBindings = previousCatchLocals;
    }
    if (statement.finally_block != null) {
        semanticValidateBlock(statement.finally_block, state, vars);
    }
}

void semanticValidateStmt(Node statement, SemanticValidationState state,
        Map<string, Node> vars) {
    if (statement.kind == NK_VAR_DECL_STMT) {
        semanticValidateVariable(statement, state, vars);
    } else if (statement.kind == NK_RETURN_STMT) {
        semanticValidateReturn(statement, state, vars);
    } else if (statement.kind == NK_EXPR_STMT) {
        Node? previousStandalone = state.standaloneExpression;
        state.standaloneExpression = statement.expr;
        semanticValidateGpuResultStatement(
            statement.expr, state, vars);
        state.standaloneExpression = previousStandalone;
        semanticValidateThreadExpressionDiscard(
            statement.expr, state, vars);
    } else if (statement.kind == NK_IF_STMT) {
        semanticValidateExpr(statement.condition, state, vars);
        semanticValidateCondition(
            statement.condition, "If statement", state, vars);
        semanticValidateBlock(statement.then_block, state, vars);
        if (statement.else_block != null) {
            semanticValidateStmt(statement.else_block, state, vars);
        }
    } else if (statement.kind == NK_ELSE_BLOCK) {
        semanticValidateBlock(statement.body_node, state, vars);
    } else if (statement.kind == NK_ELSE_IF) {
        semanticValidateStmt(statement.if_stmt, state, vars);
    } else if (statement.kind == NK_WHILE_STMT
            || statement.kind == NK_DO_WHILE_STMT) {
        semanticValidateLoop(statement, state, vars);
    } else if (statement.kind == NK_FOR_IN_STMT
            || statement.kind == NK_PARALLEL_FOR_STMT) {
        semanticValidateForIn(statement, state, vars);
    } else if (statement.kind == NK_C_FOR_STMT) {
        semanticValidateCFor(statement, state, vars);
    } else if (statement.kind == NK_SWITCH_STMT) {
        semanticValidateSwitch(statement, state, vars);
    } else if (statement.kind == NK_TRY_CATCH_STMT) {
        semanticValidateTry(statement, state, vars);
    } else if (statement.kind == NK_DELETE_STMT
            || statement.kind == NK_KEEP_STMT
            || statement.kind == NK_RELEASE_STMT) {
        semanticValidateOwnership(statement, state, vars);
    } else if (statement.kind == NK_THROW_STMT) {
        semanticValidateExpr(statement.expr, state, vars);
        semanticRejectThreadObservation(statement.expr, state, vars);
    } else if (statement.kind == NK_BREAK_STMT) {
        if (state.breakDepth == 0) {
            semanticValidationFail("'break' statement outside of loop or switch",
                statement);
        }
    } else if (statement.kind == NK_CONTINUE_STMT) {
        if (state.loopDepth == 0) {
            semanticValidationFail("'continue' statement outside of loop",
                statement);
        }
    } else if (statement.kind == NK_BLOCK) {
        semanticValidateBlock(statement, state, vars);
    }
}
