/* Hosted-ABI queries over Python-generated exact and ownership tables. */

class HostedAbi {

    class string encodedSpec(string name) {
        return GeneratedHostedAbi.encodedSpec(name);
    }

    class Vector<string> specParts(string name) {
        string encoded = HostedAbi.encodedSpec(name);
        if (encoded == "") {
            Vector<string> empty = [];
            return empty;
        }
        return Strings.split(encoded, ";");
    }

    class Vector<string> header(string name) {
        Vector<string> parts = HostedAbi.specParts(name);
        if (parts.len == 0) {
            Vector<string> empty = [];
            return empty;
        }
        return Strings.split(parts.get(0), ",");
    }

    class Vector<string> parameter(string name, int index) {
        Vector<string> parts = HostedAbi.specParts(name);
        if (index < 0 || index + 1 >= parts.len) {
            Vector<string> empty = [];
            return empty;
        }
        return Strings.split(parts.get(index + 1), ",");
    }

    class bool exactFunction(string name) {
        return HostedAbi.encodedSpec(name) != "";
    }

    class bool functionOwnedName(string name) {
        return HostedAbi.exactFunction(name)
            || GeneratedHostedAbi.functionOwnedName(name);
    }

    class bool macroName(string name) {
        return GeneratedHostedAbi.macroName(name);
    }

    class bool typeName(string name) {
        return GeneratedHostedAbi.typeName(name);
    }

    class bool typedefName(string name) {
        return GeneratedHostedAbi.typedefName(name);
    }

    class bool sourceAdoptingHelper(string name, int index) {
        return index == 0
            && GeneratedHostedAbi.sourceAdoptingHelper(name)
            && HostedAbi.parameterEffect(name, index) == "consume";
    }

    class string resultBase(string name) {
        Vector<string> header = HostedAbi.header(name);
        return header.len == 0 ? "" : header.get(0);
    }

    class int resultPointerDepth(string name) {
        Vector<string> header = HostedAbi.header(name);
        return header.len == 0 ? 0 : Strings.toInt(header.get(1));
    }

    class bool resultConst(string name) {
        Vector<string> header = HostedAbi.header(name);
        return header.len > 2 && header.get(2) == "1";
    }

    class string semanticResultBase(string name) {
        Vector<string> header = HostedAbi.header(name);
        return header.len == 0 ? "" : header.get(3);
    }

    class int semanticResultPointerDepth(string name) {
        Vector<string> header = HostedAbi.header(name);
        return header.len == 0 ? 0 : Strings.toInt(header.get(4));
    }

    class bool semanticResultConst(string name) {
        Vector<string> header = HostedAbi.header(name);
        return header.len > 5 && header.get(5) == "1";
    }

    class bool variadic(string name) {
        Vector<string> header = HostedAbi.header(name);
        return header.len > 6 && header.get(6) == "1";
    }

    class string returnEffect(string name) {
        Vector<string> header = HostedAbi.header(name);
        return header.len == 0 ? "unknown" : header.get(7);
    }

    class int returnAliasParameter(string name) {
        Vector<string> header = HostedAbi.header(name);
        return header.len == 0 ? -1 : Strings.toInt(header.get(8));
    }

    class string returnAliasNullEffect(string name) {
        Vector<string> header = HostedAbi.header(name);
        if (header.len <= 10 || header.get(10) == "none") { return ""; }
        return header.get(10);
    }

    class string returnDeallocator(string name) {
        Vector<string> header = HostedAbi.header(name);
        if (header.len <= 11 || header.get(11) == "none") { return ""; }
        return header.get(11);
    }

    class string returnAliasShape(string name) {
        Vector<string> header = HostedAbi.header(name);
        if (header.len <= 12 || header.get(12) == "none") { return ""; }
        return header.get(12);
    }

    class string consumeDeallocator(string name) {
        Vector<string> header = HostedAbi.header(name);
        if (header.len <= 13 || header.get(13) == "none") { return ""; }
        return header.get(13);
    }

    class string returnAliasNullDeallocator(string name) {
        Vector<string> header = HostedAbi.header(name);
        if (header.len <= 14 || header.get(14) == "none") { return ""; }
        return header.get(14);
    }

    class int parameterCount(string name) {
        Vector<string> parts = HostedAbi.specParts(name);
        return parts.len == 0 ? -1 : parts.len - 1;
    }

    class string parameterBase(string name, int index) {
        Vector<string> parameter = HostedAbi.parameter(name, index);
        return parameter.len == 0 ? "" : parameter.get(0);
    }

    class int parameterPointerDepth(string name, int index) {
        Vector<string> parameter = HostedAbi.parameter(name, index);
        return parameter.len == 0 ? 0 : Strings.toInt(parameter.get(1));
    }

    class bool parameterConst(string name, int index) {
        Vector<string> parameter = HostedAbi.parameter(name, index);
        return parameter.len > 2 && parameter.get(2) == "1";
    }

    class string parameterEffect(string name, int index) {
        Vector<string> parameter = HostedAbi.parameter(name, index);
        return parameter.len == 0 ? "unknown" : parameter.get(3);
    }

    class bool parameterReadOnlyBorrow(string name, int index) {
        string effect = HostedAbi.parameterEffect(name, index);
        return effect == "read" || (effect == "value"
            && HostedAbi.parameterPointerDepth(name, index) == 0);
    }

    class bool parameterNonescaping(string name, int index) {
        string effect = HostedAbi.parameterEffect(name, index);
        return effect == "read" || effect == "mutate" || effect == "value";
    }

    class bool macroReferenceRequiresSemanticCall(string name) {
        if (!HostedAbi.functionOwnedName(name)) { return false; }
        if (!HostedAbi.exactFunction(name) || HostedAbi.variadic(name)) { return true; }
        if (HostedAbi.semanticResultPointerDepth(name) > 0) { return true; }
        int count = HostedAbi.parameterCount(name);
        for (int index = 0; index < count; index = index + 1) {
            string effect = HostedAbi.parameterEffect(name, index);
            if (HostedAbi.parameterPointerDepth(name, index) > 0) {
                if (effect != "read") { return true; }
            } else if (effect != "value") {
                return true;
            }
        }
        return false;
    }

    class int rawLifetimeArity(string name) {
        Vector<string> header = HostedAbi.header(name);
        if (header.len == 0 || header.get(9) != "1") { return 0; }
        return HostedAbi.parameterCount(name);
    }

    class bool ownedName(string name) {
        return HostedAbi.exactFunction(name)
            || GeneratedHostedAbi.ownedName(name);
    }

    class Node? semanticResultType(string name) {
        string base = HostedAbi.semanticResultBase(name);
        if (base == "") { return null; }
        Node result = makePrimType(base);
        result.pointer_depth = HostedAbi.semanticResultPointerDepth(name);
        result.is_const = HostedAbi.semanticResultConst(name);
        return result;
    }

    class string sourceFunctionSymbol(string name) {
        if (HostedAbi.ownedName(name)) { return "__btrc_source_" + name; }
        return name;
    }

    class string lexicalBindingCName(string name) {
        /* Named-argument labels retain their source spelling, but an object-like
         * hosted macro cannot safely be emitted as a C parameter identifier. */
        if (HostedAbi.macroName(name)) { return "__btrc_source_" + name; }
        return name;
    }

    class bool lexicalBindingConflictsType(
            string name, Analyzed analyzed) {
        if (HostedAbi.typedefName(name)
                || analyzed.isClass(name)
                || analyzed.isGenericClass(name)
                || analyzed.isEnum(name)
                || analyzed.isRichEnum(name)
                || analyzed.structTable.has(name)
                || analyzed.typedefTable.has(name)) {
            return true;
        }
        Vector<string> classNames = analyzed.classTable.keys();
        Vector<string> genericClassNames = analyzed.genericClassTable.keys();
        int table = 0;
        while (table < 2) {
            Vector<string> names = classNames;
            if (table == 1) { names = genericClassNames; }
            int classIndex = 0;
            while (classIndex < names.len) {
                Node declaration = table == 0
                    ? analyzed.classTable.get(names.get(classIndex))
                    : analyzed.genericClassTable.get(names.get(classIndex));
                int parameterIndex = 0;
                while (parameterIndex < declaration.generic_params.len) {
                    if (declaration.generic_params.get(parameterIndex) == name) {
                        return true;
                    }
                    parameterIndex = parameterIndex + 1;
                }
                int memberIndex = 0;
                while (memberIndex < declaration.members.len) {
                    Node member = declaration.members.get(memberIndex);
                    int methodParameterIndex = 0;
                    while (methodParameterIndex
                            < member.generic_params.len) {
                        if (member.generic_params.get(
                                methodParameterIndex) == name) {
                            return true;
                        }
                        methodParameterIndex = methodParameterIndex + 1;
                    }
                    memberIndex = memberIndex + 1;
                }
                classIndex = classIndex + 1;
            }
            table = table + 1;
        }
        return false;
    }

    class string lexicalBindingCNameForAnalysis(
            string name, Analyzed analyzed) {
        if (HostedAbi.macroName(name)
                || HostedAbi.lexicalBindingConflictsType(name, analyzed)) {
            return "__btrc_source_" + name;
        }
        return name;
    }

}
