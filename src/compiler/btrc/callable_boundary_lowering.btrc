/* Fail-closed storage boundaries for untagged managed-return callbacks. */

Node? callableBoundaryCanonicalType(IRGen generator, Node? typeExpr) {
    if (typeExpr == null) { return null; }
    Node concrete = generator.resolveBodyType(typeExpr);
    Node? canonical = resolveTypedefType(
        concrete, generator.analyzed.typedefTable);
    if (canonical != null) { return canonical; }
    return concrete;
}

bool callableBoundaryManagedType(IRGen generator, Node? typeExpr) {
    Node? canonicalType = callableBoundaryCanonicalType(
        generator, typeExpr);
    if (canonicalType == null) { return false; }
    Node canonical = canonicalType;
    return canonical.base == "__fn_ptr"
        && canonical.pointer_depth == 0
        && !canonical.is_array
        && canonical.generic_args.len > 0
        && irManagedType(generator, canonical.generic_args.get(0));
}

Node callableBoundaryArrayElement(Node arrayType) {
    Node element = typeWithoutOuterArray(arrayType);
    element.is_static = false;
    element.is_extern = false;
    return element;
}

Node? callableBoundaryStructDeclaration(
        IRGen generator, Node typeExpr) {
    if (typeExpr.pointer_depth > 0) { return null; }
    string name = semanticStructTypeName(
        typeExpr, generator.analyzed);
    if (name == "" || !generator.analyzed.structTable.has(name)) {
        return null;
    }
    Node declaration = generator.analyzed.structTable.get(name);
    if (declaration.is_forward) { return null; }
    return declaration;
}

bool callableBoundaryTypeContainsManagedSeen(
        IRGen generator, Node? typeExpr, Map<string, bool> active) {
    Node? canonicalType = callableBoundaryCanonicalType(
        generator, typeExpr);
    if (canonicalType == null) { return false; }
    Node canonical = canonicalType;
    if (callableBoundaryManagedType(generator, canonical)) { return true; }
    string key = typeShapeKey(canonical);
    if (active.has(key)) { return false; }
    active.put(key, true);
    bool contains = false;
    if (canonical.is_array) {
        contains = callableBoundaryTypeContainsManagedSeen(
            generator, callableBoundaryArrayElement(canonical), active);
    } else if (canonical.pointer_depth == 0
            && (canonical.base == "Array" || canonical.base == "List"
                || canonical.base == "Set" || canonical.base == "Vector")
            && canonical.generic_args.len == 1) {
        contains = callableBoundaryTypeContainsManagedSeen(
            generator, canonical.generic_args.get(0), active);
    } else if (canonical.pointer_depth == 0
            && (canonical.base == "Map" || canonical.base == "Tuple")) {
        int index = 0;
        while (!contains && index < canonical.generic_args.len) {
            contains = callableBoundaryTypeContainsManagedSeen(
                generator, canonical.generic_args.get(index), active);
            index = index + 1;
        }
    } else {
        Node? declaration = callableBoundaryStructDeclaration(
            generator, canonical);
        if (declaration != null) {
            int index = 0;
            while (!contains && index < declaration.fields.len) {
                contains = callableBoundaryTypeContainsManagedSeen(
                    generator, declaration.fields.get(index).type, active);
                index = index + 1;
            }
        }
    }
    active.remove(key);
    return contains;
}

bool callableBoundaryTypeContainsManaged(
        IRGen generator, Node? typeExpr) {
    Map<string, bool> active = {};
    return callableBoundaryTypeContainsManagedSeen(
        generator, typeExpr, active);
}

bool callableBoundaryUnsafeValue(
        IRGen generator, Node? expectedType, Node? value,
        Map<string, Node> varTypes) {
    if (expectedType == null || value == null) { return false; }
    Node? canonicalType = callableBoundaryCanonicalType(
        generator, expectedType);
    if (canonicalType == null) { return false; }
    Node canonical = canonicalType;
    if (callableBoundaryManagedType(generator, canonical)) {
        return generator.callableExpressionAbi(value, varTypes) != 0;
    }
    if (!callableBoundaryTypeContainsManaged(generator, canonical)) {
        return false;
    }
    if (value.kind == NK_LIST_LITERAL
            || value.kind == NK_BRACE_INITIALIZER) {
        Node? elementType = null;
        if (canonical.is_array) {
            elementType = callableBoundaryArrayElement(canonical);
        } else if ((canonical.base == "Array"
                || canonical.base == "List" || canonical.base == "Set"
                || canonical.base == "Vector")
                && canonical.generic_args.len == 1) {
            elementType = canonical.generic_args.get(0);
        }
        if (elementType != null) {
            int index = 0;
            while (index < value.elements.len) {
                if (callableBoundaryUnsafeValue(generator, elementType,
                        value.elements.get(index), varTypes)) {
                    return true;
                }
                index = index + 1;
            }
            return false;
        }
        if (canonical.base == "Tuple") {
            int index = 0;
            while (index < value.elements.len
                    && index < canonical.generic_args.len) {
                if (callableBoundaryUnsafeValue(generator,
                        canonical.generic_args.get(index),
                        value.elements.get(index), varTypes)) {
                    return true;
                }
                index = index + 1;
            }
            return false;
        }
        Node? declaration = callableBoundaryStructDeclaration(
            generator, canonical);
        if (declaration != null) {
            int index = 0;
            while (index < value.elements.len
                    && index < declaration.fields.len) {
                if (callableBoundaryUnsafeValue(generator,
                        declaration.fields.get(index).type,
                        value.elements.get(index), varTypes)) {
                    return true;
                }
                index = index + 1;
            }
            return false;
        }
        return true;
    }
    if (value.kind == NK_TUPLE_LITERAL
            && canonical.base == "Tuple") {
        int index = 0;
        while (index < value.elements.len
                && index < canonical.generic_args.len) {
            if (callableBoundaryUnsafeValue(generator,
                    canonical.generic_args.get(index),
                    value.elements.get(index), varTypes)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }
    if (value.kind == NK_MAP_LITERAL && canonical.base == "Map"
            && canonical.generic_args.len == 2) {
        int index = 0;
        while (index < value.entries.len) {
            Node entry = value.entries.get(index);
            if (callableBoundaryUnsafeValue(generator,
                    canonical.generic_args.get(0), entry.key, varTypes)
                    || callableBoundaryUnsafeValue(generator,
                        canonical.generic_args.get(1), entry.value_node,
                        varTypes)) {
                return true;
            }
            index = index + 1;
        }
        return false;
    }
    /* Aggregate values carry no ABI tag for their callback leaves. */
    return true;
}

void rejectPersistentCallableBoundary(IRGen generator,
        Node? expectedType, Node? value, Map<string, Node> varTypes,
        string boundary) {
    if (!callableBoundaryUnsafeValue(
            generator, expectedType, value, varTypes)) {
        return;
    }
    print("Managed-return callback cannot cross " + boundary
        + "; bare __fn_ptr storage erases its return ABI");
    abortGen();
}

void rejectAggregateCallableInitializerBoundary(IRGen generator,
        Node? expectedType, Node? value, Map<string, Node> varTypes) {
    if (callableBoundaryManagedType(generator, expectedType)) { return; }
    rejectPersistentCallableBoundary(generator, expectedType, value,
        varTypes, "aggregate storage");
}

void rejectErasingCallableAssignmentBoundary(IRGen generator,
        Node assignment, Node? targetType, Map<string, Node> varTypes) {
    if (assignment.op != "=" || assignment.target == null) { return; }
    Node target = assignment.target;
    bool localIdentifier = target.kind == NK_IDENTIFIER
        && generator.callableIdentifierIsLexicalLocal(target.name);
    if (localIdentifier
            && callableBoundaryManagedType(generator, targetType)) {
        return;
    }
    string boundary = "persistent storage";
    if (target.kind == NK_IDENTIFIER) {
        boundary = localIdentifier ? "aggregate storage" : "global storage";
    } else if (target.kind == NK_FIELD_ACCESS_EXPR) {
        boundary = "field storage";
    } else if (target.kind == NK_INDEX_EXPR) {
        boundary = "indexed storage";
    }
    rejectPersistentCallableBoundary(generator, targetType,
        assignment.value_node, varTypes, boundary);
}
