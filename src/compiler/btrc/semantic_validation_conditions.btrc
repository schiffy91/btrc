/* One C11-compatible truth-value domain for every executable condition. */

bool semanticScalarConditionType(
        Node? typeExpr, SemanticValidationState state) {
    if (typeExpr == null) { return false; }
    return NumericSemantics.isType(typeExpr, state.analyzed)
        || state.operators.isReferenceType(typeExpr);
}

bool semanticThreadCopySource(Node value) {
    if (value.kind == NK_SPAWN_EXPR || value.kind == NK_CALL_EXPR
            || value.kind == NK_NULL_LITERAL) {
        return false;
    }
    if (value.kind == NK_TERNARY_EXPR) {
        return semanticThreadCopySource(value.true_expr)
            || semanticThreadCopySource(value.false_expr);
    }
    return true;
}

bool semanticFreshThreadResult(Node? expression,
        SemanticValidationState state, Map<string, Node> vars) {
    if (expression == null || semanticThreadCopySource(expression)) {
        return false;
    }
    Node? resultType = semanticInferType(expression, state, vars);
    return resultType != null && resultType.base == "Thread";
}

bool semanticThreadValue(Node? expression,
        SemanticValidationState state, Map<string, Node> vars) {
    Node? valueType = semanticInferType(expression, state, vars);
    return valueType != null && valueType.base == "Thread";
}

void semanticRejectFreshThreadResult(Node? expression,
        SemanticValidationState state, Map<string, Node> vars) {
    if (expression == null) { return; }
    if (!semanticFreshThreadResult(expression, state, vars)) { return; }
    semanticValidationFail(
        "Fresh Thread result must be joined, returned, discarded directly, "
            + "or bound to a direct Thread<T> owner",
        expression);
}

void semanticRejectThreadObservation(Node? expression,
        SemanticValidationState state, Map<string, Node> vars) {
    if (expression == null
            || !semanticThreadValue(expression, state, vars)
            || expression.kind == NK_IDENTIFIER) {
        return;
    }
    if (semanticFreshThreadResult(expression, state, vars)) {
        semanticRejectFreshThreadResult(expression, state, vars);
        return;
    }
    semanticValidationFail(
        "Thread-producing expression must be a direct spawn() or "
            + "Thread-returning call before it can be consumed",
        expression);
}

void semanticValidateThreadTransferSource(Node? expression,
        SemanticValidationState state, Map<string, Node> vars) {
    if (expression == null
            || !semanticThreadValue(expression, state, vars)
            || expression.kind == NK_IDENTIFIER
            || semanticFreshThreadResult(expression, state, vars)) {
        return;
    }
    semanticValidationFail(
        "Thread transfer must use one unique local owner or a direct fresh "
            + "result",
        expression);
}

void semanticValidateThreadExpressionDiscard(Node? expression,
        SemanticValidationState state, Map<string, Node> vars) {
    if (expression == null
            || !semanticThreadValue(expression, state, vars)
            || expression.kind == NK_IDENTIFIER
            || semanticFreshThreadResult(expression, state, vars)) {
        return;
    }
    semanticValidationFail(
        "Only a direct fresh Thread result can be discarded safely",
        expression);
}

void semanticRejectThreadValueEscape(Node? expression, string destination,
        SemanticValidationState state, Map<string, Node> vars) {
    if (expression == null
            || !semanticThreadValue(expression, state, vars)) { return; }
    semanticValidationFail("Thread handles cannot be " + destination
        + "; join or return the unique owner instead", expression);
}

void semanticValidateCondition(Node? expression, string subject,
        SemanticValidationState state, Map<string, Node> vars) {
    if (expression == null) { return; }
    semanticRejectThreadObservation(expression, state, vars);
    Node? conditionType = semanticInferType(expression, state, vars);
    if (conditionType == null
            || semanticTypeContainsParams(
                conditionType, state.typeParams)) {
        return;
    }
    if (!semanticScalarConditionType(conditionType, state)) {
        semanticValidationFail(subject + " requires a scalar condition, got '"
            + semanticFormatType(conditionType) + "'", expression);
    }
}
