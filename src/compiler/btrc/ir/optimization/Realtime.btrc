/* Structured-IR backstop for source @realtime proofs. */

import Library.Map;
import Library.Vector;

import ../Model.btrc;

/* What proving some of one unit's functions left for the program: calls to
 * names the unit neither defines nor knows to be safe, each with the function
 * whose proof reached it and the call path. */
class RealtimeUnitProof {
	public Vector<string> starts = [];
	public Vector<string> callees = [];
	public Vector<string> paths = [];

	public RealtimeUnitProof() {}
}

class RealtimeIRVerifier {
	private Map<string, IRFunction> functions;
	private Map<string, bool> safeExternals;
	private Map<string, string> intrinsicTargets;
	/* Unit proofs: unresolved calls are collected rather than rejected. */
	private RealtimeUnitProof? pending = null;
	private string pendingStart = "";

	public RealtimeIRVerifier(IRModule module) {
		self.functions = {};
		self.safeExternals = module.realtimeSafeExternals;
		self.intrinsicTargets = module.realtimeIntrinsicTargets;
	}

	/* Prove `names` through `unit`'s own definitions, each starting at its
	 * path. A call the unit does not define, and does not know to be a safe
	 * external, is returned for the program to resolve; everything else is
	 * checked exactly as a whole-module proof checks it. */
	class RealtimeUnitProof proveWithin(IRModule unit, Vector<string> names, Vector<string> paths) {
		RealtimeUnitProof proof = RealtimeUnitProof();
		RealtimeIRVerifier verifier = RealtimeIRVerifier(unit);
		for definition in unit.functions { verifier.functions.put(definition.name, definition); }
		verifier.pending = proof;
		for (int index = 0; index < names.len; index++) {
			if (!verifier.functions.has(names.get(index))) { continue; }
			verifier.pendingStart = names.get(index);
			Map<string, bool> visiting = {};
			verifier.validateFunction(verifier.functions.get(names.get(index)), paths.get(index), visiting);
		}
		return proof;
	}

	public void validate(IRModule module) {
		bool hasRealtimeRoot = false;
		int index = 0;
		while (index < module.functions.len) {
			IRFunction definition = module.functions.get(index);
			if (definition.isRealtime) {
				hasRealtimeRoot = true;
			}
			index = index + 1;
		}
		if (!hasRealtimeRoot) { return; }
		index = 0;
		while (index < module.functions.len) {
			IRFunction definition = module.functions.get(index);
			self.functions.put(definition.name, definition);
			index = index + 1;
		}
		index = 0;
		while (index < module.functions.len) {
			IRFunction definition = module.functions.get(index);
			if (definition.isRealtime) {
				Map<string, bool> visiting = {};
				self.validateFunction(definition, definition.name, visiting);
			}
			index = index + 1;
		}
	}

	private void validateFunction(IRFunction definition, string path, Map<string, bool> visiting) {
		if (visiting.has(definition.name)) {
			self.fail("recursive call cycle", path);
		}
		Map<string, bool> next = {};
		Vector<string> names = visiting.keys();
		int index = 0;
		while (index < names.len) {
			next.put(names.get(index), true);
			index = index + 1;
		}
		next.put(definition.name, true);
		self.validateNode(definition.body, path, next);
	}

	private void validateNode(IRNode? node, string path, Map<string, bool> visiting) {
		if (node == null) { return; }
		if (node.kind == IRK_OBJECTIVE_C_MESSAGE || node.kind == IRK_OBJECTIVE_C_BLOCK || node.kind == IRK_OBJECTIVE_C_AUTORELEASE_POOL || node.kind == IRK_OBJECTIVE_C_EXCEPTION_BOUNDARY || (node.kind == IRK_CAST && ((IRConversionPayload)node.payload).bridge != "")) { self.fail("Objective-C operation", path); }
		if (node.kind == IRK_CXX_NEW || node.kind == IRK_CXX_DELETE || node.kind == IRK_CXX_EXCEPTION_BOUNDARY) { self.fail("C++ lifetime operation", path); }
		if (node.kind == IRK_WHILE || node.kind == IRK_DO_WHILE) {
			self.fail("unbounded loop", path);
		}
		if (node.kind == IRK_FOR && !((IRControlPayload)node.payload).realtimeBounded) {
			self.fail("uncertified for loop", path);
		}
		if (node.kind == IRK_LITERAL && (node.text.startsWith("\"") || node.text.startsWith("L\"") || node.text.startsWith("u\"") || node.text.startsWith("U\"") || node.text.startsWith("u8\""))) {
			self.fail("string literal", path);
		}
		if (node.kind == IRK_FUNCTION_REF) {
			self.fail("function value '" + node.name + "'", path);
		}
		if (node.kind == IRK_CALL) {
			if (((IRCallPayload)node.payload).callee == "") {
				if (((IRCallPayload)node.payload).realtimeProvenance != "typed-realtime-function") { self.fail("indirect call", path); }
			} else if (((IRCallPayload)node.payload).realtimeProvenance == "typed-realtime-function") {
				self.fail("typed-callable provenance on direct call '" + ((IRCallPayload)node.payload).callee + "'", path);
			}
			if (((IRCallPayload)node.payload).callee != "" && ((IRCallPayload)node.payload).realtimeProvenance != "" && (!self.intrinsicTargets.has(((IRCallPayload)node.payload).callee) || self.intrinsicTargets.get(((IRCallPayload)node.payload).callee) != ((IRCallPayload)node.payload).realtimeProvenance)) {
				self.fail("invalid intrinsic provenance '" + ((IRCallPayload)node.payload).realtimeProvenance + "' for '" + ((IRCallPayload)node.payload).callee + "'", path);
			}
			RealtimeUnitProof? pending = self.pending;
			if (((IRCallPayload)node.payload).callee != "" && !self.functions.has(((IRCallPayload)node.payload).callee) && pending != null) {
				if (!self.safeExternals.has(((IRCallPayload)node.payload).callee) && ((IRCallPayload)node.payload).realtimeProvenance == "") {
					pending.starts.push(self.pendingStart);
					pending.callees.push(((IRCallPayload)node.payload).callee);
					pending.paths.push(path);
				}
			} else if (((IRCallPayload)node.payload).callee != "" && !self.functions.has(((IRCallPayload)node.payload).callee)) {
				if (!self.safeExternals.has(((IRCallPayload)node.payload).callee) && ((IRCallPayload)node.payload).realtimeProvenance == "") {
					self.fail("external/runtime call '" + ((IRCallPayload)node.payload).callee + "'", path);
				}
			} else if (((IRCallPayload)node.payload).callee != "") {
				IRFunction target = self.functions.get(((IRCallPayload)node.payload).callee);
				self.validateFunction(target, path + " -> " + target.name, visiting);
			}
		}
		int domain = node.payloadDomain();
		self.validateNode(node.left, path, visiting);
		self.validateNode(node.right, path, visiting);
		self.validateNode((domain == IR_PAYLOAD_UNARY ? ((IRUnaryPayload)node.payload).operand : domain == IR_PAYLOAD_CONVERSION_AGGREGATE ? ((IRConversionPayload)node.payload).operand : null), path, visiting);
		self.validateNode(node.expr, path, visiting);
		self.validateNode((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).obj : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).obj : null), path, visiting);
		self.validateNode((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).index : null), path, visiting);
		self.validateNode((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).condition : null), path, visiting);
		self.validateNode((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).trueExpr : null), path, visiting);
		self.validateNode((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).falseExpr : null), path, visiting);
		self.validateNode((domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).arraySize : null), path, visiting);
		self.validateNode((domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).init : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).init : null), path, visiting);
		self.validateNode((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).value : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).value : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).value : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).value : null), path, visiting);
		self.validateNode((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).target : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).target : null), path, visiting);
		self.validateNode((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).thenBlock : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).thenBlock : null), path, visiting);
		self.validateNode((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).elseBlock : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).elseBlock : null), path, visiting);
		self.validateNode((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).body : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).body : null), path, visiting);
		self.validateNode((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).update : null), path, visiting);
		self.validateNode((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).result : null), path, visiting);
		int index = 0;
		while (index < node.args().len) {
			self.validateNode(node.args().get(index), path, visiting);
			index = index + 1;
		}
		index = 0;
		while (index < node.stmts().len) {
			self.validateNode(node.stmts().get(index), path, visiting);
			index = index + 1;
		}
	}

	private void fail(string operation, string path) {
		fprintf(stderr, "internal compiler error: IR realtime backstop rejected %s via %s\n", operation, path);
		exit(1);
	}
}
