/* C11 setjmp capture, visibility, volatility, and qualifier safety. */

import Library.Map;
import Library.Strings;
import Library.Vector;

import ../../Model.btrc;
import ./Analysis.btrc;

class SetjmpSafetyPlanner {
	private SetjmpEffectAnalysis effectAnalysis;
	private Map<string, SetjmpCallEffects> effectsByFunction;
	private Map<string, bool> setjmpBodies = {};  /* function name -> body contains setjmp */

	public SetjmpSafetyPlanner(SetjmpEffectAnalysis effectAnalysis) {
		self.effectAnalysis = effectAnalysis;
		self.effectsByFunction = {};
	}

	private IRNode? visibleAutomatic(string name, Vector<IRNode> visible) {
		int index = visible.len - 1;
		while (index >= 0) {
			IRNode declaration = visible.get(index);
			if (declaration.name == name) { return declaration; }
			index = index - 1;
		}
		return null;
	}

	private IRParam? visibleParameter(string name, Vector<IRParam> params) {
		int index = 0;
		while (index < params.len) {
			IRParam parameter = params.get(index);
			if (parameter.name == name) { return parameter; }
			index = index + 1;
		}
		return null;
	}

	private void addVisible(Vector<IRNode> visible, IRNode? declaration) {
		if (declaration != null && declaration.kind == IRK_VAR_DECL) {
			visible.push(declaration);
		}
	}

	private void rejectAlias(string name, bool inferred) {
		string reason = "has explicitly volatile storage";
		if (inferred) {
			reason = "is modified across try/throw and requires volatile storage";
		}
		fprintf(stderr, "error: storage object '%s' %s; its address or array decay requires unsupported layered pointer qualifiers\n", name, reason);
		exit(1);
	}

	private void validateExpression(IRNode? node, Vector<IRNode> visible, Vector<IRParam> params, int parentKind, string parentField) {
		if (node == null) { return; }
		int domain = node.payloadDomain();
		if (node.kind == IRK_STMT_EXPR) {
			Vector<IRNode> local = self.copyVisible(visible);
			int statementIndex = 0;
			while (statementIndex < node.stmts().len) {
				self.validateStatement(node.stmts().get(statementIndex), local, params);
				statementIndex = statementIndex + 1;
			}
			self.validateExpression((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).result : null), local, params, node.kind, "result");
			return;
		}
		if (node.kind == IRK_ADDRESS_OF && node.sourceAddress && parentKind != IRK_SIZEOF) {
			string root = IRNode.directStorageRoot(node.expr);
			if (root != "" && !self.compilerOwnedStorage(root)) {
				IRNode? declaration = self.visibleAutomatic(root, visible);
				if (declaration != null && ((IRDeclarationPayload)declaration.payload).isVolatile && ((IRDeclarationPayload)declaration.payload).setjmpInferredVolatile) {
					self.rejectAlias(root, true);
				}
				if (declaration == null) {
					IRParam? parameter = self.visibleParameter(root, params);
					if (parameter != null && parameter.isVolatile && parameter.setjmpInferredVolatile) {
						self.rejectAlias(root, true);
					}
				}
			}
		}
		if (node.kind == IRK_VAR && !self.compilerOwnedStorage(node.name)) {
			IRNode? declaration = self.visibleAutomatic(node.name, visible);
			bool safeIndex = parentKind == IRK_INDEX && parentField == "obj";
			if (declaration != null && ((IRDeclarationPayload)declaration.payload).isVolatile && ((IRDeclarationPayload)declaration.payload).setjmpInferredVolatile && ((IRDeclarationPayload)declaration.payload).isArrayDecl && parentKind != IRK_SIZEOF && !safeIndex) {
				self.rejectAlias(node.name, true);
			}
			return;
		}
		if (node.kind == IRK_FIELD_ACCESS && node.arrayStorageKnown && node.arrayStorageRoot != "" && !self.compilerOwnedStorage(node.arrayStorageRoot) && parentKind != IRK_SIZEOF && !(parentKind == IRK_INDEX && parentField == "obj")) {
			IRNode? declaration = self.visibleAutomatic(node.arrayStorageRoot, visible);
			if (declaration != null && ((IRDeclarationPayload)declaration.payload).isVolatile && ((IRDeclarationPayload)declaration.payload).setjmpInferredVolatile) {
				self.rejectAlias(node.arrayStorageRoot, true);
			}
			if (declaration == null) {
				IRParam? parameter = self.visibleParameter(node.arrayStorageRoot, params);
				if (parameter != null && parameter.isVolatile && parameter.setjmpInferredVolatile) {
					self.rejectAlias(node.arrayStorageRoot, true);
				}
			}
		}
		self.validateExpression(node.left, visible, params, node.kind, "left");
		self.validateExpression(node.right, visible, params, node.kind, "right");
		self.validateExpression((domain == IR_PAYLOAD_UNARY ? ((IRUnaryPayload)node.payload).operand : domain == IR_PAYLOAD_CONVERSION_AGGREGATE ? ((IRConversionPayload)node.payload).operand : null), visible, params, node.kind, "operand");
		self.validateExpression(node.expr, visible, params, node.kind, "expr");
		self.validateExpression((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).obj : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).obj : null), visible, params, node.kind, "obj");
		self.validateExpression((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).index : null), visible, params, node.kind, "index");
		self.validateExpression((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).condition : null), visible, params, node.kind, "condition");
		self.validateExpression((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).trueExpr : null), visible, params, node.kind, "true_expr");
		self.validateExpression((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).falseExpr : null), visible, params, node.kind, "false_expr");
		self.validateExpression((domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).arraySize : null), visible, params, node.kind, "array_size");
		self.validateExpression((domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).init : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).init : null), visible, params, node.kind, "init");
		self.validateExpression((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).value : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).value : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).value : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).value : null), visible, params, node.kind, "value");
		self.validateExpression((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).target : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).target : null), visible, params, node.kind, "target");
		self.validateExpression((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).update : null), visible, params, node.kind, "update");
		self.validateExpression((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).result : null), visible, params, node.kind, "result");
		int index = 0;
		while (index < node.args().len) {
			self.validateExpression(node.args().get(index), visible, params, node.kind, "args");
			index = index + 1;
		}
	}

	private void validateBlock(IRNode? block, Vector<IRNode> inherited, Vector<IRParam> params) {
		if (block == null) { return; }
		Vector<IRNode> visible = self.copyVisible(inherited);
		int index = 0;
		while (index < block.stmts().len) {
			self.validateStatement(block.stmts().get(index), visible, params);
			index = index + 1;
		}
	}

	private void validateStatement(IRNode statement, Vector<IRNode> visible, Vector<IRParam> params) {
		if (statement.kind == IRK_VAR_DECL) {
			self.validateExpression(((IRDeclarationPayload)statement.payload).arraySize, visible, params, statement.kind, "array_size");
			self.addVisible(visible, statement);
			self.validateExpression(((IRDeclarationPayload)statement.payload).init, visible, params, statement.kind, "init");
			return;
		}
		if (statement.kind == IRK_IF) {
			self.validateExpression(((IRControlPayload)statement.payload).condition, visible, params, statement.kind, "condition");
			self.validateBlock(((IRControlPayload)statement.payload).thenBlock, visible, params);
			self.validateBlock(((IRControlPayload)statement.payload).elseBlock, visible, params);
			return;
		}
		if (statement.kind == IRK_WHILE || statement.kind == IRK_DO_WHILE) {
			self.validateExpression(((IRControlPayload)statement.payload).condition, visible, params, statement.kind, "condition");
			self.validateBlock(((IRControlPayload)statement.payload).body, visible, params);
			return;
		}
		if (statement.kind == IRK_FOR) {
			Vector<IRNode> local = self.copyVisible(visible);
			if (((IRControlPayload)statement.payload).init != null) {
				self.validateStatement(((IRControlPayload)statement.payload).init, local, params);
			}
			self.validateExpression(((IRControlPayload)statement.payload).condition, local, params, statement.kind, "condition");
			self.validateExpression(((IRControlPayload)statement.payload).update, local, params, statement.kind, "update");
			self.validateBlock(((IRControlPayload)statement.payload).body, local, params);
			return;
		}
		if (statement.kind == IRK_SWITCH) {
			self.validateExpression(((IRControlPayload)statement.payload).value, visible, params, statement.kind, "value");
			int caseIndex = 0;
			while (caseIndex < statement.args().len) {
				IRNode caseNode = statement.args().get(caseIndex);
				int caseDomain = caseNode.payloadDomain();
				Vector<IRNode> local = self.copyVisible(visible);
				self.validateExpression((caseDomain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)caseNode.payload).value : caseDomain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)caseNode.payload).value : caseDomain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)caseNode.payload).value : caseDomain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)caseNode.payload).value : null), local, params, caseNode.kind, "value");
				int childIndex = 0;
				while (childIndex < caseNode.stmts().len) {
					self.validateStatement(caseNode.stmts().get(childIndex), local, params);
					childIndex = childIndex + 1;
				}
				caseIndex = caseIndex + 1;
			}
			return;
		}
		if (statement.kind == IRK_BLOCK) {
			self.validateBlock(statement, visible, params);
			return;
		}
		self.validateExpression(statement, visible, params, IRK_NONE, "");
	}

	private void validateFunction(IRFunction definition) {
		Vector<IRNode> visible = [];
		self.validateBlock(definition.body, visible, definition.params);
	}

	private void validateGlobals(IRModule module) {
		Vector<IRNode> visible = [];
		Vector<IRParam> params = [];
		int index = 0;
		while (index < module.globalDecls.len) {
			IRGlobalDecl declaration = module.globalDecls.get(index);
			self.validateExpression(declaration.arraySize, visible, params, IRK_NONE, "array_size");
			self.validateExpression(declaration.init, visible, params, IRK_NONE, "init");
			index = index + 1;
		}
	}

	private bool compilerOwnedStorage(string name) { return name.startsWith("__btrc_") && !name.startsWith("__btrc_source_"); }

	private Map<string, bool> copyNameSet(Map<string, bool> source) {
		Map<string, bool> result = {};
		Vector<string> names = source.keys();
		int index = 0;
		while (index < names.len) {
			result.put(names.get(index), true);
			index = index + 1;
		}
		return result;
	}

	private string storageKey(SetjmpStorage storage) { return Strings.fromInt(storage.identity); }

	private void recordNodeWrites(IRNode? node, Map<string, bool> bound, Map<string, bool> modified, SetjmpCallEffects effects) {
		Vector<SetjmpOrigin> writes = effects.flow.writesFor(node);
		int index = 0;
		while (index < writes.len) {
			SetjmpOrigin origin = writes.get(index);
			string key = self.storageKey(origin.storage);
			if (origin.depth == 0 && !bound.has(key)) {
				modified.put(key, true);
			}
			index = index + 1;
		}
	}

	private void collectExpressionMutations(IRNode? node, Map<string, bool> bound, Map<string, bool> modified, SetjmpCallEffects effects) {
		if (node == null) { return; }
		int domain = node.payloadDomain();
		self.recordNodeWrites(node, bound, modified, effects);
		if (node.kind == IRK_SIZEOF) { return; }
		if (node.kind == IRK_STMT_EXPR) {
			Map<string, bool> local = self.copyNameSet(bound);
			self.collectMutationSequence(node.stmts(), local, modified, effects);
			self.collectExpressionMutations((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).result : null), local, modified, effects);
			return;
		}
		self.collectExpressionMutations(node.left, bound, modified, effects);
		self.collectExpressionMutations(node.right, bound, modified, effects);
		self.collectExpressionMutations((domain == IR_PAYLOAD_UNARY ? ((IRUnaryPayload)node.payload).operand : domain == IR_PAYLOAD_CONVERSION_AGGREGATE ? ((IRConversionPayload)node.payload).operand : null), bound, modified, effects);
		self.collectExpressionMutations(node.expr, bound, modified, effects);
		self.collectExpressionMutations((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).obj : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).obj : null), bound, modified, effects);
		self.collectExpressionMutations((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).index : null), bound, modified, effects);
		self.collectExpressionMutations((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).condition : null), bound, modified, effects);
		self.collectExpressionMutations((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).trueExpr : null), bound, modified, effects);
		self.collectExpressionMutations((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).falseExpr : null), bound, modified, effects);
		self.collectExpressionMutations((domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).init : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).init : null), bound, modified, effects);
		self.collectExpressionMutations((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).value : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).value : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).value : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).value : null), bound, modified, effects);
		self.collectExpressionMutations((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).target : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).target : null), bound, modified, effects);
		self.collectExpressionMutations((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).update : null), bound, modified, effects);
		self.collectExpressionMutations((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).result : null), bound, modified, effects);
		self.collectExpressionMutations((domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).arraySize : null), bound, modified, effects);
		int index = 0;
		while (index < node.args().len) {
			self.collectExpressionMutations(node.args().get(index), bound, modified, effects);
			index = index + 1;
		}
	}

	private void collectMutationBlock(IRNode? block, Map<string, bool> inherited, Map<string, bool> modified, SetjmpCallEffects effects) {
		if (block == null) { return; }
		Map<string, bool> bound = self.copyNameSet(inherited);
		self.collectMutationSequence(block.stmts(), bound, modified, effects);
	}

	private void collectMutationSequence(Vector<IRNode> statements, Map<string, bool> bound, Map<string, bool> modified, SetjmpCallEffects effects) {
		int index = 0;
		while (index < statements.len) {
			self.collectStatementMutations(statements.get(index), bound, modified, effects);
			index = index + 1;
		}
	}

	private void collectStatementMutations(IRNode statement, Map<string, bool> bound, Map<string, bool> modified, SetjmpCallEffects effects) {
		self.recordNodeWrites(statement, bound, modified, effects);
		if (statement.kind == IRK_VAR_DECL) {
			self.collectExpressionMutations(((IRDeclarationPayload)statement.payload).arraySize, bound, modified, effects);
			SetjmpStorage? storage = effects.flow.declarationStorage(statement);
			if (storage != null) { bound.put(self.storageKey(storage), true); }
			self.collectExpressionMutations(((IRDeclarationPayload)statement.payload).init, bound, modified, effects);
			return;
		}
		if (statement.kind == IRK_IF) {
			self.collectExpressionMutations(((IRControlPayload)statement.payload).condition, bound, modified, effects);
			self.collectMutationBlock(((IRControlPayload)statement.payload).thenBlock, bound, modified, effects);
			self.collectMutationBlock(((IRControlPayload)statement.payload).elseBlock, bound, modified, effects);
			return;
		}
		if (statement.kind == IRK_WHILE || statement.kind == IRK_DO_WHILE) {
			self.collectExpressionMutations(((IRControlPayload)statement.payload).condition, bound, modified, effects);
			self.collectMutationBlock(((IRControlPayload)statement.payload).body, bound, modified, effects);
			return;
		}
		if (statement.kind == IRK_FOR) {
			Map<string, bool> local = self.copyNameSet(bound);
			if (((IRControlPayload)statement.payload).init != null && ((IRControlPayload)statement.payload).init.kind == IRK_VAR_DECL) {
				self.collectStatementMutations(((IRControlPayload)statement.payload).init, local, modified, effects);
			} else {
				self.collectExpressionMutations(((IRControlPayload)statement.payload).init, local, modified, effects);
			}
			self.collectExpressionMutations(((IRControlPayload)statement.payload).condition, local, modified, effects);
			self.collectExpressionMutations(((IRControlPayload)statement.payload).update, local, modified, effects);
			self.collectMutationBlock(((IRControlPayload)statement.payload).body, local, modified, effects);
			return;
		}
		if (statement.kind == IRK_SWITCH) {
			self.collectExpressionMutations(((IRControlPayload)statement.payload).value, bound, modified, effects);
			int index = 0;
			while (index < statement.args().len) {
				IRNode caseNode = statement.args().get(index);
				int caseDomain = caseNode.payloadDomain();
				Map<string, bool> local = self.copyNameSet(bound);
				self.collectExpressionMutations((caseDomain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)caseNode.payload).value : caseDomain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)caseNode.payload).value : caseDomain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)caseNode.payload).value : caseDomain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)caseNode.payload).value : null), local, modified, effects);
				self.collectMutationSequence(caseNode.stmts(), local, modified, effects);
				index = index + 1;
			}
			return;
		}
		if (statement.kind == IRK_BLOCK) {
			self.collectMutationBlock(statement, bound, modified, effects);
			return;
		}
		self.collectExpressionMutations(statement, bound, modified, effects);
	}

	private Map<string, bool> mutatedNames(IRNode? block, SetjmpCallEffects effects) {
		Map<string, bool> modified = {};
		Map<string, bool> bound = {};
		self.collectMutationBlock(block, bound, modified, effects);
		return modified;
	}

	private Map<string, bool> mutatedSequenceAfter(Vector<IRNode> statements, int start, SetjmpCallEffects effects) {
		Map<string, bool> modified = {};
		Map<string, bool> bound = {};
		int index = start;
		while (index < statements.len) {
			self.collectStatementMutations(statements.get(index), bound, modified, effects);
			index = index + 1;
		}
		return modified;
	}

	private Map<string, bool> loopMutatedNames(IRNode loop, SetjmpCallEffects effects) {
		IRNode block = IRNode(IRK_BLOCK);
		if (((IRControlPayload)loop.payload).condition != null) {
			block.stmtsMut().push(IRNode.expressionStatement(((IRControlPayload)loop.payload).condition));
		}
		if (((IRControlPayload)loop.payload).update != null) { block.stmtsMut().push(IRNode.expressionStatement(((IRControlPayload)loop.payload).update)); }
		if (((IRControlPayload)loop.payload).body != null) { block.stmtsMut().push(((IRControlPayload)loop.payload).body); }
		return self.mutatedNames(block, effects);
	}

	private bool containsSetjmp(IRNode? node) {
		if (node == null) { return false; }
		int domain = node.payloadDomain();
		if (node.kind == IRK_CALL && (domain == IR_PAYLOAD_CALL ? ((IRCallPayload)node.payload).callee : "") == "setjmp") { return true; }
		if (self.containsSetjmp(node.left) || self.containsSetjmp(node.right) || self.containsSetjmp((domain == IR_PAYLOAD_UNARY ? ((IRUnaryPayload)node.payload).operand : domain == IR_PAYLOAD_CONVERSION_AGGREGATE ? ((IRConversionPayload)node.payload).operand : null)) || self.containsSetjmp(node.expr) || self.containsSetjmp((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).obj : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).obj : null)) || self.containsSetjmp((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).index : null)) || self.containsSetjmp((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).condition : null)) || self.containsSetjmp((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).trueExpr : null)) || self.containsSetjmp((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).falseExpr : null)) || self.containsSetjmp((domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).init : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).init : null)) || self.containsSetjmp((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).value : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).value : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).value : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).value : null)) || self.containsSetjmp((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).target : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).target : null)) || self.containsSetjmp((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).update : null)) || self.containsSetjmp((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).result : null)) || self.containsSetjmp((domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).arraySize : null)) || self.containsSetjmp((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).thenBlock : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).thenBlock : null)) || self.containsSetjmp((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).elseBlock : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).elseBlock : null)) || self.containsSetjmp((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).body : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).body : null))) { return true; }
		int index = 0;
		while (index < node.args().len) {
			if (self.containsSetjmp(node.args().get(index))) { return true; }
			index = index + 1;
		}
		index = 0;
		while (index < node.stmts().len) {
			if (self.containsSetjmp(node.stmts().get(index))) { return true; }
			index = index + 1;
		}
		return false;
	}

	/* Qualify the generated temporaries GCC can report as clobbered. GCC's
	 * -Wclobbered judges register pseudos after -O2 coalescing, which may merge
	 * a generated temporary declared after a setjmp with a value live across
	 * it; large functions then warn about storage that is never live there.
	 * Qualify return temporaries of a setjmp function, generated pointer
	 * storage inside a try or handler, and every generated local inside a
	 * try that encloses another try.
	 * Volatile storage is never coalesced. Arrays are memory already, and a
	 * local whose address is taken lives in memory and keeps its declared
	 * pointee type for the API that receives the address. */
	private void qualifyGeneratedLocals(IRNode body, SetjmpCallEffects effects) {
		Map<string, bool> addressed = {};
		self.collectAddressed(body, addressed);
		self.qualifyGenerated(body, addressed, effects, false, false);
	}

	private void collectAddressed(IRNode? node, Map<string, bool> addressed) {
		if (node == null) { return; }
		int domain = node.payloadDomain();
		if (node.kind == IRK_ADDRESS_OF) {
			string root = IRNode.directStorageRoot(node.expr);
			if (root != "") { addressed.put(root, true); }
		}
		self.collectAddressed(node.left, addressed);
		self.collectAddressed(node.right, addressed);
		self.collectAddressed((domain == IR_PAYLOAD_UNARY ? ((IRUnaryPayload)node.payload).operand : domain == IR_PAYLOAD_CONVERSION_AGGREGATE ? ((IRConversionPayload)node.payload).operand : null), addressed);
		self.collectAddressed(node.expr, addressed);
		self.collectAddressed((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).obj : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).obj : null), addressed);
		self.collectAddressed((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).index : null), addressed);
		self.collectAddressed((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).condition : null), addressed);
		self.collectAddressed((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).trueExpr : null), addressed);
		self.collectAddressed((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).falseExpr : null), addressed);
		self.collectAddressed((domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).init : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).init : null), addressed);
		self.collectAddressed((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).value : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).value : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).value : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).value : null), addressed);
		self.collectAddressed((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).target : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).target : null), addressed);
		self.collectAddressed((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).update : null), addressed);
		self.collectAddressed((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).result : null), addressed);
		self.collectAddressed((domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).arraySize : null), addressed);
		self.collectAddressed((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).thenBlock : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).thenBlock : null), addressed);
		self.collectAddressed((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).elseBlock : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).elseBlock : null), addressed);
		self.collectAddressed((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).body : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).body : null), addressed);
		for argument in node.args() { self.collectAddressed(argument, addressed); }
		for statement in node.stmts() { self.collectAddressed(statement, addressed); }
	}

	private void qualifyGenerated(IRNode? node, Map<string, bool> addressed, SetjmpCallEffects effects, bool nested, bool protectedRegion) {
		if (node == null) { return; }
		int domain = node.payloadDomain();
		bool pointerInRegion = false;
		if (protectedRegion && node.kind == IRK_VAR_DECL && self.compilerOwnedStorage(node.name)) {
			SetjmpStorage? storage = effects.flow.declarationStorage(node);
			pointerInRegion = storage != null && storage.isPointer;
		}
		if (node.kind == IRK_VAR_DECL && self.compilerOwnedStorage(node.name) && (nested || pointerInRegion || node.name.startsWith("__btrc_ret_")) && !((IRDeclarationPayload)node.payload).isStatic && !((IRDeclarationPayload)node.payload).isExtern && !((IRDeclarationPayload)node.payload).isArrayDecl && !addressed.has(node.name)) {
			if (!((IRDeclarationPayload)node.payload).isVolatile) { ((IRDeclarationPayload)node.payload).setjmpInferredVolatile = true; }
			((IRDeclarationPayload)node.payload).isVolatile = true;
			((IRDeclarationPayload)node.payload).effectiveIsVolatile = true;
		}
		/* A try whose protected or handler region holds another try. */
		bool region = protectedRegion || (node.kind == IRK_IF && self.containsSetjmp((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).condition : null)));
		bool inner = nested || (node.kind == IRK_IF && self.containsSetjmp((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).condition : null)) && (self.containsSetjmp((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).thenBlock : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).thenBlock : null)) || self.containsSetjmp((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).elseBlock : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).elseBlock : null))));
		self.qualifyGenerated(node.left, addressed, effects, inner, region);
		self.qualifyGenerated(node.right, addressed, effects, inner, region);
		self.qualifyGenerated((domain == IR_PAYLOAD_UNARY ? ((IRUnaryPayload)node.payload).operand : domain == IR_PAYLOAD_CONVERSION_AGGREGATE ? ((IRConversionPayload)node.payload).operand : null), addressed, effects, inner, region);
		self.qualifyGenerated(node.expr, addressed, effects, inner, region);
		self.qualifyGenerated((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).obj : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).obj : null), addressed, effects, inner, region);
		self.qualifyGenerated((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).index : null), addressed, effects, inner, region);
		self.qualifyGenerated((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).condition : null), addressed, effects, inner, region);
		self.qualifyGenerated((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).trueExpr : null), addressed, effects, inner, region);
		self.qualifyGenerated((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).falseExpr : null), addressed, effects, inner, region);
		self.qualifyGenerated((domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).init : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).init : null), addressed, effects, inner, region);
		self.qualifyGenerated((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).value : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).value : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).value : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).value : null), addressed, effects, inner, region);
		self.qualifyGenerated((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).target : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).target : null), addressed, effects, inner, region);
		self.qualifyGenerated((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).update : null), addressed, effects, inner, region);
		self.qualifyGenerated((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).result : null), addressed, effects, inner, region);
		self.qualifyGenerated((domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).arraySize : null), addressed, effects, inner, region);
		self.qualifyGenerated((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).thenBlock : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).thenBlock : null), addressed, effects, inner, region);
		self.qualifyGenerated((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).elseBlock : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).elseBlock : null), addressed, effects, inner, region);
		self.qualifyGenerated((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).body : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).body : null), addressed, effects, inner, region);
		for argument in node.args() { self.qualifyGenerated(argument, addressed, effects, inner, region); }
		for statement in node.stmts() { self.qualifyGenerated(statement, addressed, effects, inner, region); }
	}

	private bool bodyContainsSetjmp(IRFunction definition) {
		if (definition.body == null) { return false; }
		if (!self.setjmpBodies.has(definition.name)) { self.setjmpBodies.put(definition.name, self.containsSetjmp(definition.body)); }
		return self.setjmpBodies.get(definition.name);
	}

	private void rejectUnmodelledCaptures(IRFunction definition, SetjmpCallEffects effects) {
		if (!self.bodyContainsSetjmp(definition)) { return; }
		int index = 0;
		while (index < effects.flow.unknownPointerValues.len) {
			SetjmpStorage storage = effects.flow.unknownPointerValues.get(index);
			fprintf(stderr, "error: pointer storage object '%s' receives an unmodelled " + "pointer value in a function containing try/setjmp\n", storage.name);
			exit(1);
		}
		Vector<SetjmpOrigin> escaped = effects.flow.copyOrigins(effects.flow.captures);
		index = 0;
		while (index < effects.flow.returns.len) {
			SetjmpOrigin origin = effects.flow.returns.get(index);
			if (origin.depth == 0) { effects.flow.addOrigin(escaped, origin); }
			index = index + 1;
		}
		index = 0;
		while (index < escaped.len) {
			SetjmpOrigin origin = escaped.get(index);
			SetjmpStorage storage = origin.storage;
			if (origin.depth == 0 && origin.sourceExposed && storage.automatic() && !storage.compilerOwned) {
				fprintf(stderr, "error: automatic storage object '%s' escapes into " + "unmodelled storage in a function containing try/setjmp\n", storage.name);
				exit(1);
			}
			index = index + 1;
		}
	}

	private Vector<IRNode> copyVisible(Vector<IRNode> source) {
		Vector<IRNode> result = [];
		int index = 0;
		while (index < source.len) {
			result.push(source.get(index));
			index = index + 1;
		}
		return result;
	}

	private string visibleDeclarationKey(IRNode declaration, SetjmpCallEffects effects) {
		SetjmpStorage? storage = effects.flow.declarationStorage(declaration);
		return storage == null ? "" : self.storageKey(storage);
	}

	private string visibleParameterKey(IRParam parameter, SetjmpCallEffects effects) {
		SetjmpStorage? storage = effects.flow.parameterStorage(parameter);
		return storage == null ? "" : self.storageKey(storage);
	}

	private void markVisible(Vector<IRNode> visible, Vector<IRParam> params, Map<string, bool> modified, bool filterModified, SetjmpCallEffects effects) {
		Map<string, bool> remaining = self.copyNameSet(modified);
		int index = 0;
		if (!filterModified) {
			while (index < params.len) {
				string key = self.visibleParameterKey(params.get(index), effects);
				if (key != "") { remaining.put(key, true); }
				index = index + 1;
			}
			index = 0;
			while (index < visible.len) {
				string key = self.visibleDeclarationKey(visible.get(index), effects);
				if (key != "") { remaining.put(key, true); }
				index = index + 1;
			}
		} else {
			/* GCC diagnoses generated temporaries that are initialized before a
             * setjmp and consumed after its branch even without a direct write. */
			while (index < visible.len) {
				IRNode declaration = visible.get(index);
				if (self.compilerOwnedStorage(declaration.name)) {
					string key = self.visibleDeclarationKey(declaration, effects);
					if (key != "") { remaining.put(key, true); }
				}
				index = index + 1;
			}
		}
		index = visible.len - 1;
		while (index >= 0) {
			IRNode declaration = visible.get(index);
			string key = self.visibleDeclarationKey(declaration, effects);
			if (key != "" && remaining.has(key)) {
				if (!((IRDeclarationPayload)declaration.payload).isStatic && !((IRDeclarationPayload)declaration.payload).isExtern) {
					if (!((IRDeclarationPayload)declaration.payload).isVolatile) {
						((IRDeclarationPayload)declaration.payload).setjmpInferredVolatile = true;
					}
					((IRDeclarationPayload)declaration.payload).isVolatile = true;
					((IRDeclarationPayload)declaration.payload).effectiveIsVolatile = true;
				}
				remaining.remove(key);
			}
			index = index - 1;
		}
		index = 0;
		while (index < params.len) {
			IRParam parameter = params.get(index);
			string key = self.visibleParameterKey(parameter, effects);
			if (key != "" && remaining.has(key)) {
				if (!parameter.isVolatile) {
					parameter.setjmpInferredVolatile = true;
				}
				parameter.isVolatile = true;
				parameter.effectiveIsVolatile = true;
			}
			index = index + 1;
		}
	}

	private void scanResidual(IRNode? node, Vector<IRNode> visible, Vector<IRParam> params, Map<string, bool> modified, bool filterModified, SetjmpCallEffects effects) {
		if (node == null) { return; }
		int domain = node.payloadDomain();
		if (node.kind == IRK_CALL && (domain == IR_PAYLOAD_CALL ? ((IRCallPayload)node.payload).callee : "") == "setjmp") {
			self.markVisible(visible, params, modified, filterModified, effects);
			return;
		}
		if (node.kind == IRK_STMT_EXPR) {
			self.scanResidual((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).result : null), visible, params, modified, filterModified, effects);
			return;
		}
		self.scanResidual(node.left, visible, params, modified, filterModified, effects);
		self.scanResidual(node.right, visible, params, modified, filterModified, effects);
		self.scanResidual((domain == IR_PAYLOAD_UNARY ? ((IRUnaryPayload)node.payload).operand : domain == IR_PAYLOAD_CONVERSION_AGGREGATE ? ((IRConversionPayload)node.payload).operand : null), visible, params, modified, filterModified, effects);
		self.scanResidual(node.expr, visible, params, modified, filterModified, effects);
		self.scanResidual((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).obj : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).obj : null), visible, params, modified, filterModified, effects);
		self.scanResidual((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).index : null), visible, params, modified, filterModified, effects);
		self.scanResidual((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).condition : null), visible, params, modified, filterModified, effects);
		self.scanResidual((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).trueExpr : null), visible, params, modified, filterModified, effects);
		self.scanResidual((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).falseExpr : null), visible, params, modified, filterModified, effects);
		self.scanResidual((domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).arraySize : null), visible, params, modified, filterModified, effects);
		self.scanResidual((domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).init : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).init : null), visible, params, modified, filterModified, effects);
		self.scanResidual((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).value : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).value : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).value : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).value : null), visible, params, modified, filterModified, effects);
		self.scanResidual((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).target : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).target : null), visible, params, modified, filterModified, effects);
		self.scanResidual((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).update : null), visible, params, modified, filterModified, effects);
		self.scanResidual((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).result : null), visible, params, modified, filterModified, effects);
		int index = 0;
		while (index < node.args().len) {
			self.scanResidual(node.args().get(index), visible, params, modified, filterModified, effects);
			index = index + 1;
		}
	}

	private void prepareDeclaration(IRNode declaration, Vector<IRNode> visible, Vector<IRParam> params, Map<string, bool> modified, bool filterModified, SetjmpCallEffects effects) {
		self.prepareHoists(((IRDeclarationPayload)declaration.payload).arraySize, visible, params, modified, filterModified, effects);
		self.prepareHoists(((IRDeclarationPayload)declaration.payload).init, visible, params, modified, filterModified, effects);
		self.scanResidual(((IRDeclarationPayload)declaration.payload).arraySize, visible, params, modified, filterModified, effects);
		self.addVisible(visible, declaration);
		self.scanResidual(((IRDeclarationPayload)declaration.payload).init, visible, params, modified, filterModified, effects);
	}

	private void prepareHoists(IRNode? node, Vector<IRNode> visible, Vector<IRParam> params, Map<string, bool> modified, bool filterModified, SetjmpCallEffects effects) {
		if (node == null) { return; }
		int domain = node.payloadDomain();
		if (node.kind == IRK_STMT_EXPR) {
			int index = 0;
			while (index < node.stmts().len) {
				IRNode declaration = node.stmts().get(index);
				if (declaration.kind == IRK_VAR_DECL) {
					self.prepareDeclaration(declaration, visible, params, modified, filterModified, effects);
				}
				index = index + 1;
			}
			self.prepareHoists((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).result : null), visible, params, modified, filterModified, effects);
			return;
		}
		self.prepareHoists(node.left, visible, params, modified, filterModified, effects);
		self.prepareHoists(node.right, visible, params, modified, filterModified, effects);
		self.prepareHoists((domain == IR_PAYLOAD_UNARY ? ((IRUnaryPayload)node.payload).operand : domain == IR_PAYLOAD_CONVERSION_AGGREGATE ? ((IRConversionPayload)node.payload).operand : null), visible, params, modified, filterModified, effects);
		self.prepareHoists(node.expr, visible, params, modified, filterModified, effects);
		self.prepareHoists((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).obj : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).obj : null), visible, params, modified, filterModified, effects);
		self.prepareHoists((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).index : null), visible, params, modified, filterModified, effects);
		self.prepareHoists((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).condition : null), visible, params, modified, filterModified, effects);
		self.prepareHoists((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).trueExpr : null), visible, params, modified, filterModified, effects);
		self.prepareHoists((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).falseExpr : null), visible, params, modified, filterModified, effects);
		self.prepareHoists((domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).arraySize : null), visible, params, modified, filterModified, effects);
		self.prepareHoists((domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).init : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).init : null), visible, params, modified, filterModified, effects);
		self.prepareHoists((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).value : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).value : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).value : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).value : null), visible, params, modified, filterModified, effects);
		self.prepareHoists((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).target : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).target : null), visible, params, modified, filterModified, effects);
		self.prepareHoists((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).update : null), visible, params, modified, filterModified, effects);
		self.prepareHoists((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).result : null), visible, params, modified, filterModified, effects);
		int index = 0;
		while (index < node.args().len) {
			self.prepareHoists(node.args().get(index), visible, params, modified, filterModified, effects);
			index = index + 1;
		}
	}

	private void processExpression(IRNode? node, Vector<IRNode> visible, Vector<IRParam> params, Map<string, bool> modified, bool filterModified, SetjmpCallEffects effects) {
		self.prepareHoists(node, visible, params, modified, filterModified, effects);
		self.scanResidual(node, visible, params, modified, filterModified, effects);
	}

	private void prepareSimple(IRNode? first, IRNode? second, Vector<IRNode> visible, Vector<IRParam> params, SetjmpCallEffects effects) {
		Map<string, bool> all = {};
		self.prepareHoists(first, visible, params, all, false, effects);
		self.prepareHoists(second, visible, params, all, false, effects);
		self.scanResidual(first, visible, params, all, false, effects);
		self.scanResidual(second, visible, params, all, false, effects);
	}

	private void scanBlock(IRNode? block, Vector<IRNode> inherited, Vector<IRParam> params, SetjmpCallEffects effects) {
		if (block == null) { return; }
		Vector<IRNode> visible = self.copyVisible(inherited);
		int index = 0;
		while (index < block.stmts().len) {
			IRNode statement = block.stmts().get(index);
			if (self.containsSetjmp(statement)) {
				Map<string, bool> continuation = self.mutatedSequenceAfter(block.stmts(), index + 1, effects);
				self.markVisible(visible, params, continuation, true, effects);
			}
			self.scanStatement(statement, visible, params, effects);
			index = index + 1;
		}
	}

	private void markLoopVisible(IRNode statement, Vector<IRNode> visible, Vector<IRParam> params, SetjmpCallEffects effects) {
		if (!self.containsSetjmp(statement)) { return; }
		Map<string, bool> modified = self.loopMutatedNames(statement, effects);
		self.markVisible(visible, params, modified, true, effects);
	}

	private void scanIf(IRNode statement, Vector<IRNode> visible, Vector<IRParam> params, SetjmpCallEffects effects) {
		Map<string, bool> all = {};
		if (self.containsSetjmp(((IRControlPayload)statement.payload).condition)) {
			Map<string, bool> modified = self.mutatedNames(((IRControlPayload)statement.payload).thenBlock, effects);
			Map<string, bool> catchModified = self.mutatedNames(((IRControlPayload)statement.payload).elseBlock, effects);
			Vector<string> catchNames = catchModified.keys();
			int index = 0;
			while (index < catchNames.len) {
				modified.put(catchNames.get(index), true);
				index = index + 1;
			}
			self.processExpression(((IRControlPayload)statement.payload).condition, visible, params, modified, true, effects);
		} else {
			self.processExpression(((IRControlPayload)statement.payload).condition, visible, params, all, false, effects);
		}
		self.scanBlock(((IRControlPayload)statement.payload).thenBlock, visible, params, effects);
		self.scanBlock(((IRControlPayload)statement.payload).elseBlock, visible, params, effects);
	}

	private void scanSwitch(IRNode statement, Vector<IRNode> visible, Vector<IRParam> params, SetjmpCallEffects effects) {
		self.prepareSimple(((IRControlPayload)statement.payload).value, null, visible, params, effects);
		int index = 0;
		while (index < statement.args().len) {
			IRNode caseNode = statement.args().get(index);
			int caseDomain = caseNode.payloadDomain();
			Vector<IRNode> caseVisible = self.copyVisible(visible);
			self.prepareSimple((caseDomain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)caseNode.payload).value : caseDomain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)caseNode.payload).value : caseDomain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)caseNode.payload).value : caseDomain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)caseNode.payload).value : null), null, caseVisible, params, effects);
			IRNode caseBlock = IRNode(IRK_BLOCK);
			((IRControlPayload)caseBlock.payload).stmtsStorage = caseNode.stmts();
			if (self.containsSetjmp(caseBlock) && (caseDomain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)caseNode.payload).fallsThrough : false)) {
				Map<string, bool> continuation = {};
				int next = index;
				while (next + 1 < statement.args().len) {
					IRNode previousCase = statement.args().get(next);
					if (previousCase.payloadDomain() != IR_PAYLOAD_CONTROL_SEQUENCE || !((IRControlPayload)previousCase.payload).fallsThrough) { break; }
					next = next + 1;
					IRNode nextCase = statement.args().get(next);
					IRNode nextBlock = IRNode(IRK_BLOCK);
					((IRControlPayload)nextBlock.payload).stmtsStorage = nextCase.stmts();
					Map<string, bool> nextMutations = self.mutatedNames(nextBlock, effects);
					Vector<string> names = nextMutations.keys();
					int nameIndex = 0;
					while (nameIndex < names.len) {
						continuation.put(names.get(nameIndex), true);
						nameIndex = nameIndex + 1;
					}
				}
				self.markVisible(caseVisible, params, continuation, true, effects);
			}
			self.scanBlock(caseBlock, caseVisible, params, effects);
			index = index + 1;
		}
	}

	private void scanStatement(IRNode statement, Vector<IRNode> visible, Vector<IRParam> params, SetjmpCallEffects effects) {
		Map<string, bool> all = {};
		if (statement.kind == IRK_VAR_DECL) {
			self.prepareDeclaration(statement, visible, params, all, false, effects);
		} else if (statement.kind == IRK_ASSIGN) {
			self.prepareSimple(((IRValuePayload)statement.payload).target, ((IRValuePayload)statement.payload).value, visible, params, effects);
		} else if (statement.kind == IRK_RETURN) {
			self.prepareSimple(((IRValuePayload)statement.payload).value, null, visible, params, effects);
		} else if (statement.kind == IRK_EXPR_STMT) {
			self.prepareSimple(statement.expr, null, visible, params, effects);
		} else if (statement.kind == IRK_IF) {
			self.scanIf(statement, visible, params, effects);
		} else if (statement.kind == IRK_WHILE) {
			self.markLoopVisible(statement, visible, params, effects);
			self.prepareSimple(((IRControlPayload)statement.payload).condition, null, visible, params, effects);
			self.scanBlock(((IRControlPayload)statement.payload).body, visible, params, effects);
		} else if (statement.kind == IRK_DO_WHILE) {
			self.markLoopVisible(statement, visible, params, effects);
			self.processExpression(((IRControlPayload)statement.payload).condition, visible, params, all, false, effects);
			self.scanBlock(((IRControlPayload)statement.payload).body, visible, params, effects);
		} else if (statement.kind == IRK_FOR) {
			self.scanFor(statement, visible, params, effects);
		} else if (statement.kind == IRK_SWITCH) {
			self.scanSwitch(statement, visible, params, effects);
		} else if (statement.kind == IRK_BLOCK) {
			self.scanBlock(statement, visible, params, effects);
		}
	}

	private void prepareForInit(IRNode? init, Vector<IRNode> visible, Vector<IRParam> params, SetjmpCallEffects effects) {
		if (init == null) { return; }
		Map<string, bool> all = {};
		if (init.kind == IRK_ASSIGN) {
			self.prepareHoists(((IRValuePayload)init.payload).target, visible, params, all, false, effects);
			self.prepareHoists(((IRValuePayload)init.payload).value, visible, params, all, false, effects);
		} else if (init.kind == IRK_EXPR_STMT) {
			self.prepareHoists(init.expr, visible, params, all, false, effects);
		}
	}

	private void scanForInit(IRNode? init, Vector<IRNode> visible, Vector<IRParam> params, SetjmpCallEffects effects) {
		if (init == null) { return; }
		Map<string, bool> all = {};
		if (init.kind == IRK_ASSIGN) {
			self.scanResidual(((IRValuePayload)init.payload).target, visible, params, all, false, effects);
			self.scanResidual(((IRValuePayload)init.payload).value, visible, params, all, false, effects);
		} else if (init.kind == IRK_EXPR_STMT) {
			self.scanResidual(init.expr, visible, params, all, false, effects);
		}
	}

	private void scanFor(IRNode statement, Vector<IRNode> visible, Vector<IRParam> params, SetjmpCallEffects effects) {
		Map<string, bool> all = {};
		if (((IRControlPayload)statement.payload).init != null && ((IRControlPayload)statement.payload).init.kind == IRK_VAR_DECL) {
			self.prepareHoists(((IRDeclarationPayload)((IRControlPayload)statement.payload).init.payload).arraySize, visible, params, all, false, effects);
			self.prepareHoists(((IRDeclarationPayload)((IRControlPayload)statement.payload).init.payload).init, visible, params, all, false, effects);
		} else {
			self.prepareForInit(((IRControlPayload)statement.payload).init, visible, params, effects);
		}
		self.prepareHoists(((IRControlPayload)statement.payload).condition, visible, params, all, false, effects);
		self.prepareHoists(((IRControlPayload)statement.payload).update, visible, params, all, false, effects);

		Vector<IRNode> loopVisible = self.copyVisible(visible);
		if (((IRControlPayload)statement.payload).init != null && ((IRControlPayload)statement.payload).init.kind == IRK_VAR_DECL) {
			self.scanResidual(((IRDeclarationPayload)((IRControlPayload)statement.payload).init.payload).arraySize, visible, params, all, false, effects);
			self.addVisible(loopVisible, ((IRControlPayload)statement.payload).init);
			self.scanResidual(((IRDeclarationPayload)((IRControlPayload)statement.payload).init.payload).init, loopVisible, params, all, false, effects);
		} else {
			self.scanForInit(((IRControlPayload)statement.payload).init, loopVisible, params, effects);
		}
		self.markLoopVisible(statement, loopVisible, params, effects);
		self.scanResidual(((IRControlPayload)statement.payload).condition, loopVisible, params, all, false, effects);
		self.scanResidual(((IRControlPayload)statement.payload).update, loopVisible, params, all, false, effects);
		self.scanBlock(((IRControlPayload)statement.payload).body, loopVisible, params, effects);
	}

	public void apply(IRModule module) {
		Map<string, SetjmpCallEffects> none = {};
		self.applySolved(module, none);
	}

	/* A module unit passes the effects its program solve found; an empty map
	 * analyzes the module on its own. */
	public void applySolved(IRModule module, Map<string, SetjmpCallEffects> solvedEffects) {
		self.setjmpBodies = {};
		self.validateGlobals(module);
		bool hasSetjmp = false;
		/* Only a function that calls setjmp can qualify storage: the scan marks
		 * nothing elsewhere, and validation rejects only what was marked. */
		Map<string, bool> roots = {};
		int index = 0;
		while (index < module.functions.len) {
			IRFunction definition = module.functions.get(index);
			if (self.bodyContainsSetjmp(definition)) {
				hasSetjmp = true;
				roots.put(definition.name, true);
			}
			index = index + 1;
		}
		if (!hasSetjmp) { return; }
		self.effectsByFunction = solvedEffects.len > 0 ? solvedEffects : self.effectAnalysis.analyze(module, roots);
		index = 0;
		while (index < module.functions.len) {
			IRFunction definition = module.functions.get(index);
			IRNode? body = definition.body;
			if (body != null && self.bodyContainsSetjmp(definition)) {
				SetjmpCallEffects effects = self.effectsByFunction.get(definition.name);
				self.rejectUnmodelledCaptures(definition, effects);
				Vector<IRNode> visible = [];
				self.scanBlock(body, visible, definition.params, effects);
				self.qualifyGeneratedLocals(body, effects);
			}
			self.validateFunction(definition);
			index = index + 1;
		}
	}
}
