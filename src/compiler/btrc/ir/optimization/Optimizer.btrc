/* Whole-module reachability and parameter normalization. */

import Library.Map;
import Library.Strings;
import Library.Vector;

import ../../frontend/Timing.btrc;
import ../gpu/Pipeline.btrc;
import ../lowering/ownership/CycleBoundaries.btrc;
import ../Model.btrc;
import ../runtime/Catalog.btrc;
import ../runtime/References.btrc;
import ./Cleanup.btrc;
import ./Realtime.btrc;
import ./setjmp/Analysis.btrc;
import ./setjmp/Safety.btrc;

class IROptimizer {
	private SetjmpSafetyPlanner setjmpSafety;
	private RuntimeHelperCatalog runtimeHelpers;
	/* A module unit's externally linked definitions are reachable from other units. */
	private bool moduleUnit = false;
	/* Module unit: exported functions DCE dropped because they contain a
	 * deferred invalid-operator diagnostic, by name with that diagnostic. */
	private Map<string, string> droppedInvalid = {};

	public Map<string, string> droppedInvalidExports() { return self.droppedInvalid; }

	private string invalidDiagnostic(IRNode? node) {
		if (node == null) { return ""; }
		if (node.kind == IRK_INVALID_EXPR) { return node.text; }
		/* Field by field: a child list per node would allocate for every node
		 * of every exported body. */
		string found = self.invalidDiagnostic(node.left);
		if (found.isEmpty()) { found = self.invalidDiagnostic(node.right); }
		if (found.isEmpty()) { found = self.invalidDiagnostic(node.operand); }
		if (found.isEmpty()) { found = self.invalidDiagnostic(node.expr); }
		if (found.isEmpty()) { found = self.invalidDiagnostic(node.obj); }
		if (found.isEmpty()) { found = self.invalidDiagnostic(node.index); }
		if (found.isEmpty()) { found = self.invalidDiagnostic(node.condition); }
		if (found.isEmpty()) { found = self.invalidDiagnostic(node.trueExpr); }
		if (found.isEmpty()) { found = self.invalidDiagnostic(node.falseExpr); }
		if (found.isEmpty()) { found = self.invalidDiagnostic(node.init); }
		if (found.isEmpty()) { found = self.invalidDiagnostic(node.value); }
		if (found.isEmpty()) { found = self.invalidDiagnostic(node.target); }
		if (found.isEmpty()) { found = self.invalidDiagnostic(node.thenBlock); }
		if (found.isEmpty()) { found = self.invalidDiagnostic(node.elseBlock); }
		if (found.isEmpty()) { found = self.invalidDiagnostic(node.body); }
		if (found.isEmpty()) { found = self.invalidDiagnostic(node.update); }
		if (found.isEmpty()) { found = self.invalidDiagnostic(node.result); }
		if (found.isEmpty()) { found = self.invalidDiagnostic(node.arraySize); }
		if (!found.isEmpty()) { return found; }
		for argument in node.args() {
			string found = self.invalidDiagnostic(argument);
			if (!found.isEmpty()) { return found; }
		}
		for statement in node.stmts() {
			string found = self.invalidDiagnostic(statement);
			if (!found.isEmpty()) { return found; }
		}
		return "";
	}

	public IROptimizer(SetjmpSafetyPlanner setjmpSafety, RuntimeHelperCatalog runtimeHelpers) {
		self.setjmpSafety = setjmpSafety;
		self.runtimeHelpers = runtimeHelpers;
	}

	/* Complete stage-five cascade.  Every operation consumes and mutates only
     * structured IR plus immutable repositories supplied by the pipeline. */
	public void optimize(IRModule module, bool eliminateDeadCode) {
		RealtimeIRVerifier(module).validate(module);
		BtrccPhaseTimer.mark("o-realtime");
		self.setjmpSafety.apply(module);
		BtrccPhaseTimer.mark("o-setjmp");
		CleanupSlotValidator(module).validate();
		BtrccPhaseTimer.mark("o-cleanup");
		if (eliminateDeadCode) {
			self.eliminateUnreachable(module);
		}
		BtrccPhaseTimer.mark("o-dce");
		CycleReturnBoundaryLowerer().installProgramBoundary(module);
		self.normalizeUnusedParameters(module);
		self.orderPrototypes(module);
		self.renumberAdapters(module);
		self.renumberTemporaries(module);
		BtrccPhaseTimer.mark("o-params");
		RuntimeReferenceCollector references = RuntimeReferenceCollector(self.runtimeHelpers);
		Map<string, bool> requiredHelpers = references.requiredBy(module);
		self.runtimeHelpers.materializeInto(module, requiredHelpers, references.requiredHeaders());
		BtrccPhaseTimer.mark("o-helpers");
	}

	/* One module unit: realtime and setjmp facts were solved across the
	 * program's units, and whether any unit releases cyclable values is a
	 * program fact. */
	/* Generic-instance members of a module unit are export roots only when
	 * some unit of the program needs them; others behave as in whole-program
	 * DCE. */
	private Map<string, bool> unneededInstances = {};

	public void optimizeModuleUnit(IRModule module, bool eliminateDeadCode, Map<string, SetjmpCallEffects> setjmpEffects, bool programCyclableRelease, Map<string, bool> unneededInstances) {
		self.moduleUnit = true;
		self.unneededInstances = unneededInstances;
		self.droppedInvalid = {};
		/* A generic instance emits every method; one whose body carries a
		 * deferred invalid-operator diagnostic is not an export root, exactly
		 * as whole-program DCE drops it when nothing reaches it. */
		for definition in module.functions {
			if (!definition.isStatic) {
				string diagnostic = self.invalidDiagnostic(definition.body);
				if (!diagnostic.isEmpty()) { self.droppedInvalid.put(definition.name, diagnostic); }
			}
		}
		RealtimeIRVerifier(module).validate(module);
		self.setjmpSafety.applySolved(module, setjmpEffects);
		CleanupSlotValidator(module).validate();
		if (eliminateDeadCode) {
			self.eliminateUnreachable(module);
		}
		for definition in module.functions {
			if (self.droppedInvalid.has(definition.name)) { self.droppedInvalid.remove(definition.name); }
		}
		CycleReturnBoundaryLowerer().installProgramBoundaryWhen(module, programCyclableRelease);
		self.normalizeUnusedParameters(module);
		self.orderPrototypes(module);
		self.renumberAdapters(module);
		self.renumberTemporaries(module);
		RuntimeReferenceCollector references = RuntimeReferenceCollector(self.runtimeHelpers);
		Map<string, bool> requiredHelpers = references.requiredBy(module);
		self.runtimeHelpers.materializeInto(module, requiredHelpers, references.requiredHeaders());
		self.moduleUnit = false;
		self.unneededInstances = {};
	}

	private void eliminateUnreachable(IRModule module) {
		self.eliminateDeadGlobals(module);
		self.eliminateDeadFunctions(module);
		GpuPipeline.eliminateUnreachable(module);
		self.eliminateDeadExterns(module);
		self.eliminateDeadTypeDeclarations(module);
	}

	/* A prototype with no definition in this module survives only while
	 * live code calls or names it. Mirrors IROptimizer._prune_externs. */
	private void eliminateDeadExterns(IRModule m) {
		Map<string, bool> defined = {};
		for definition in m.functions { defined.put(definition.name, true); }
		Map<string, bool> names = {};
		for declaration in m.functionDecls {
			if (!defined.has(declaration.name)) { names.put(declaration.name, true); }
		}
		if (names.len == 0) { return; }
		Map<string, bool> referenced = {};
		for definition in m.functions { self.collectFuncRefs(definition.body, names, referenced); }
		for global in m.globalDecls { self.collectFuncRefs(global.init, names, referenced); }
		for declaration in m.objectiveCClasses {
			for method in declaration.methods { self.collectFuncRefs(method.body, names, referenced); }
		}
		for declaration in m.preprocessorDecls {
			if (declaration.kind == IR_PREPROCESSOR_MACRO) { self.scanTextForKnownNames(declaration.replacement, names, referenced); }
		}
		Vector<IRFunctionDecl> kept = [];
		for declaration in m.functionDecls {
			if (!names.has(declaration.name) || referenced.has(declaration.name)) { kept.push(declaration); }
		}
		if (kept.len == m.functionDecls.len) { return; }
		Vector<IRFunctionDecl> previous = m.functionDecls;
		if (self.moduleUnit) { keep previous; }
		m.functionDecls = kept;
	}

	/* File-scope value reachability before ordinary function/helper DCE.
     * Runtime-helper C is emitted before IRGlobalDecl values and cannot name an
     * internal module global; helper-owned state stays inside helper source. */

	private bool globalInitializerHasEffects(IRNode? node) {
		if (node == null) { return false; }
		if (node.kind == IRK_CALL || node.kind == IRK_CXX_NEW || node.kind == IRK_OBJECTIVE_C_MESSAGE || node.kind == IRK_OBJECTIVE_C_BLOCK || (node.kind == IRK_CAST && (node.bridge == "retain" || node.bridge == "transfer")) || node.kind == IRK_STMT_EXPR || node.kind == IRK_INVALID_EXPR || node.kind >= IRK_VAR_DECL) {
			return true;
		}
		if (node.kind == IRK_UNARYOP && (node.op == "++" || node.op == "--")) {
			return true;
		}
		if (self.globalInitializerHasEffects(node.left) || self.globalInitializerHasEffects(node.right) || self.globalInitializerHasEffects(node.operand) || self.globalInitializerHasEffects(node.expr) || self.globalInitializerHasEffects(node.obj) || self.globalInitializerHasEffects(node.index) || self.globalInitializerHasEffects(node.condition) || self.globalInitializerHasEffects(node.trueExpr) || self.globalInitializerHasEffects(node.falseExpr) || self.globalInitializerHasEffects(node.init) || self.globalInitializerHasEffects(node.value) || self.globalInitializerHasEffects(node.target) || self.globalInitializerHasEffects(node.thenBlock) || self.globalInitializerHasEffects(node.elseBlock) || self.globalInitializerHasEffects(node.body) || self.globalInitializerHasEffects(node.update) || self.globalInitializerHasEffects(node.result) || self.globalInitializerHasEffects(node.arraySize)) {
			return true;
		}
		int argument = 0;
		while (argument < node.args().len) {
			if (self.globalInitializerHasEffects(node.args().get(argument))) {
				return true;
			}
			argument = argument + 1;
		}
		return false;
	}

	private void collectGlobalRefs(IRNode? node, Map<string, bool> names, Map<string, bool> out) {
		if (node == null) { return; }
		if (node.kind == IRK_VAR && names.has(node.name)) {
			out.put(node.name, true);
		}
		if (node.kind == IRK_CALL && names.has(node.callee)) {
			out.put(node.callee, true);
		}
		self.collectGlobalRefs(node.left, names, out);
		self.collectGlobalRefs(node.right, names, out);
		self.collectGlobalRefs(node.operand, names, out);
		self.collectGlobalRefs(node.expr, names, out);
		self.collectGlobalRefs(node.obj, names, out);
		self.collectGlobalRefs(node.index, names, out);
		self.collectGlobalRefs(node.condition, names, out);
		self.collectGlobalRefs(node.trueExpr, names, out);
		self.collectGlobalRefs(node.falseExpr, names, out);
		self.collectGlobalRefs(node.init, names, out);
		self.collectGlobalRefs(node.value, names, out);
		self.collectGlobalRefs(node.target, names, out);
		self.collectGlobalRefs(node.thenBlock, names, out);
		self.collectGlobalRefs(node.elseBlock, names, out);
		self.collectGlobalRefs(node.body, names, out);
		self.collectGlobalRefs(node.update, names, out);
		self.collectGlobalRefs(node.result, names, out);
		self.collectGlobalRefs(node.arraySize, names, out);
		int argument = 0;
		while (argument < node.args().len) {
			self.collectGlobalRefs(node.args().get(argument), names, out);
			argument = argument + 1;
		}
		int statement = 0;
		while (statement < node.stmts().len) {
			self.collectGlobalRefs(node.stmts().get(statement), names, out);
			statement = statement + 1;
		}
	}

	private void enqueueGlobalFunctionRefs(Map<string, bool> references, Map<string, bool> live, Vector<string> worklist) {
		Vector<string> names = references.keys();
		int index = 0;
		while (index < names.len) {
			string name = names.get(index);
			if (!live.has(name)) {
				live.put(name, true);
				worklist.push(name);
			}
			index = index + 1;
		}
	}

	private void eliminateDeadGlobals(IRModule module) {
		if (module.globalDecls.len == 0) { return; }

		Vector<string> functionNames = [];
		Map<string, bool> knownFunctions = {};
		Map<string, int> functionByName = {};
		Map<string, bool> liveFunctions = {};
		Vector<string> functionWorklist = [];
		int functionIndex = 0;
		while (functionIndex < module.functions.len) {
			IRFunction fn = module.functions.get(functionIndex);
			functionNames.push(fn.name);
			knownFunctions.put(fn.name, true);
			functionByName.put(fn.name, functionIndex);
			if (fn.name == "main" || fn.name == "btrc_main") {
				liveFunctions.put(fn.name, true);
				functionWorklist.push(fn.name);
			}
			functionIndex = functionIndex + 1;
		}

		Vector<string> globalNames = [];
		Map<string, bool> knownGlobals = {};
		Map<string, bool> liveGlobals = {};
		Vector<string> globalWorklist = [];
		int globalIndex = 0;
		while (globalIndex < module.globalDecls.len) {
			IRGlobalDecl global = module.globalDecls.get(globalIndex);
			if (!knownGlobals.has(global.name)) {
				knownGlobals.put(global.name, true);
				globalNames.push(global.name);
			}
			/* Volatile affects accesses, not the observability of unreachable
             * internal storage. External linkage and real references still root
             * every volatile object that can be observed. */
			if (!global.isStatic || global.isExtern || self.globalInitializerHasEffects(global.init) || self.globalInitializerHasEffects(global.arraySize)) {
				if (!liveGlobals.has(global.name)) {
					liveGlobals.put(global.name, true);
					globalWorklist.push(global.name);
				}
			}
			globalIndex = globalIndex + 1;
		}

		int preprocessorIndex = 0;
		while (preprocessorIndex < module.preprocessorDecls.len) {
			IRPreprocessorDecl declaration = module.preprocessorDecls.get(preprocessorIndex);
			if (declaration.kind == IR_PREPROCESSOR_MACRO) {
				Map<string, bool> functionRoots = {};
				Map<string, bool> globalRoots = {};
				self.scanTextForNames(declaration.replacement, functionNames, functionRoots);
				self.scanTextForNames(declaration.replacement, globalNames, globalRoots);
				self.enqueueGlobalFunctionRefs(functionRoots, liveFunctions, functionWorklist);
				self.enqueueGlobalFunctionRefs(globalRoots, liveGlobals, globalWorklist);
			}
			preprocessorIndex = preprocessorIndex + 1;
		}

		for declaration in module.objectiveCClasses {
			Map<string, bool> functionRoots = {};
			Map<string, bool> globalRoots = {};
			for method in declaration.methods {
				self.collectFuncRefs(method.body, knownFunctions, functionRoots);
				self.collectGlobalRefs(method.body, knownGlobals, globalRoots);
			}
			self.enqueueGlobalFunctionRefs(functionRoots, liveFunctions, functionWorklist);
			self.enqueueGlobalFunctionRefs(globalRoots, liveGlobals, globalWorklist);
		}
		while (functionWorklist.len > 0 || globalWorklist.len > 0) {
			Map<string, bool> functionRefs = {};
			Map<string, bool> globalRefs = {};
			if (functionWorklist.len > 0) {
				string functionName = functionWorklist.pop();
				IRFunction fn = module.functions.get(functionByName.get(functionName));
				self.collectFuncRefs(fn.body, knownFunctions, functionRefs);
				self.collectGlobalRefs(fn.body, knownGlobals, globalRefs);
			} else {
				string globalName = globalWorklist.pop();
				int declarationIndex = 0;
				while (declarationIndex < module.globalDecls.len) {
					IRGlobalDecl global = module.globalDecls.get(declarationIndex);
					if (global.name == globalName) {
						self.collectFuncRefs(global.init, knownFunctions, functionRefs);
						self.collectFuncRefs(global.arraySize, knownFunctions, functionRefs);
						self.collectGlobalRefs(global.init, knownGlobals, globalRefs);
						self.collectGlobalRefs(global.arraySize, knownGlobals, globalRefs);
					}
					declarationIndex = declarationIndex + 1;
				}
			}
			self.enqueueGlobalFunctionRefs(functionRefs, liveFunctions, functionWorklist);
			self.enqueueGlobalFunctionRefs(globalRefs, liveGlobals, globalWorklist);
		}

		Vector<IRGlobalDecl> kept = [];
		globalIndex = 0;
		while (globalIndex < module.globalDecls.len) {
			IRGlobalDecl global = module.globalDecls.get(globalIndex);
			if (liveGlobals.has(global.name)) { kept.push(global); }
			globalIndex = globalIndex + 1;
		}
		module.globalDecls = kept;
	}

	/* True if a char can be part of a C identifier. */
	private bool isIdentChar(char c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_'; }

	/* Index of `needle` in `hay` at or after `from` (-1 if absent). btrc's string
     * indexOf has no start-offset overload, so search the suffix and re-offset. */
	private int indexOfFrom(string hay, string needle, int startAt) {
		int hlen = hay.length();
		if (startAt < 0) { startAt = 0; }
		if (startAt > hlen) { return -1; }
		string suffix = hay.substring(startAt, hlen - startAt);
		int rel = suffix.indexOf(needle);
		if (rel < 0) { return -1; }
		return startAt + rel;
	}

	/* Add every name in `names` that occurs as a whole identifier in `text` to
     * `out` (mirrors _scan_text_for_names: word-boundary, not substring). */
	private void scanTextForNames(string text, Vector<string> names, Map<string, bool> out) {
		int n = names.len;
		int tlen = text.length();
		int i = 0;
		while (i < n) {
			string name = names.get(i);
			if (!out.has(name)) {
				int nlen = name.length();
				int startAt = 0;
				bool found = false;
				while (!found && startAt <= tlen - nlen) {
					int pos = self.indexOfFrom(text, name, startAt);
					if (pos < 0) { startAt = tlen + 1; }
					else {
						bool okBefore = pos == 0 || !self.isIdentChar(text[pos - 1]);
						int after = pos + nlen;
						bool okAfter = after >= tlen || !self.isIdentChar(text[after]);
						if (okBefore && okAfter) { found = true; }
						else { startAt = pos + 1; }
					}
				}
				if (found) { out.put(name, true); }
			}
			i = i + 1;
		}
	}

	/* Add whole C identifiers from `text` that are present in `names`.  Unlike
     * scanTextForNames this is linear in the text length: type reachability walks
     * every surviving IR node, so probing the complete declaration-name vector at
     * every leaf would make the pass O(IR nodes * declarations). */
	private void scanTextForKnownNames(string text, Map<string, bool> names, Map<string, bool> out) {
		int length = text.length();
		int index = 0;
		while (index < length) {
			while (index < length && !self.isIdentChar(text[index])) {
				index = index + 1;
			}
			int start = index;
			while (index < length && self.isIdentChar(text[index])) {
				index = index + 1;
			}
			if (start < index) {
				string identifier = text.substring(start, index - start);
				if (names.has(identifier)) { out.put(identifier, true); }
			}
		}
	}

	/* Collect referenced function names from an IR expression/statement tree.
     * Calls and IRFunctionRef nodes are semantic references. Literal text
     * is data and must never root a same-named dead function. */
	private void collectFuncRefs(IRNode? node, Map<string, bool> names, Map<string, bool> out) {
		if (node == null) { return; }
		if (node.kind == IRK_CALL && names.has(node.callee)) {
			out.put(node.callee, true);
		}
		if (node.kind == IRK_FUNCTION_REF && names.has(node.name)) {
			out.put(node.name, true);
		}
		/* Recurse into every sub-node field. */
		self.collectFuncRefs(node.left, names, out);
		self.collectFuncRefs(node.right, names, out);
		self.collectFuncRefs(node.operand, names, out);
		self.collectFuncRefs(node.expr, names, out);
		self.collectFuncRefs(node.obj, names, out);
		self.collectFuncRefs(node.index, names, out);
		self.collectFuncRefs(node.condition, names, out);
		self.collectFuncRefs(node.trueExpr, names, out);
		self.collectFuncRefs(node.falseExpr, names, out);
		self.collectFuncRefs(node.init, names, out);
		self.collectFuncRefs(node.value, names, out);
		self.collectFuncRefs(node.target, names, out);
		self.collectFuncRefs(node.thenBlock, names, out);
		self.collectFuncRefs(node.elseBlock, names, out);
		self.collectFuncRefs(node.body, names, out);
		self.collectFuncRefs(node.update, names, out);
		self.collectFuncRefs(node.result, names, out);
		self.collectFuncRefs(node.arraySize, names, out);
		int i = 0;
		while (i < node.args().len) { self.collectFuncRefs(node.args().get(i), names, out); i = i + 1; }
		int j = 0;
		while (j < node.stmts().len) { self.collectFuncRefs(node.stmts().get(j), names, out); j = j + 1; }
	}

	private void eliminateDeadFunctions(IRModule m) {
		if (m.functions.len == 0) { return; }
		Vector<string> names = [];
		Map<string, bool> knownNames = {};
		Map<string, int> byName = {};
		Map<string, bool> keepSet = {};
		Vector<string> worklist = [];
		int i = 0;
		while (i < m.functions.len) {
			names.push(m.functions.get(i).name);
			knownNames.put(m.functions.get(i).name, true);
			byName.put(m.functions.get(i).name, i);
			i = i + 1;
		}
		Vector<string> descriptorNames = [];
		Map<string, bool> knownDescriptorNames = {};
		Map<string, int> descriptorByName = {};
		int descriptorIndex = 0;
		while (descriptorIndex < m.globalDecls.len) {
			IRGlobalDecl descriptor = m.globalDecls.get(descriptorIndex);
			if (descriptor.cType == "const __btrc_arc_type") {
				descriptorNames.push(descriptor.name);
				knownDescriptorNames.put(descriptor.name, true);
				descriptorByName.put(descriptor.name, descriptorIndex);
			}
			descriptorIndex = descriptorIndex + 1;
		}
		/* Roots: the entry points main / btrc_main. */
		int r = 0;
		while (r < names.len) {
			string nm = names.get(r);
			if (nm == "main" || nm == "btrc_main" || (self.moduleUnit && !m.functions.get(r).isStatic && !self.droppedInvalid.has(nm) && !self.unneededInstances.has(nm))) {
				if (!keepSet.has(nm)) { keepSet.put(nm, true); worklist.push(nm); }
			}
			r = r + 1;
		}
		/* Macro replacement bodies and global initializers are executable roots;
         * callable declarations themselves are not. */
		Map<string, bool> rootRefs = {};
		Map<string, bool> descriptorRootRefs = {};
		int preprocessorIndex = 0;
		while (preprocessorIndex < m.preprocessorDecls.len) {
			IRPreprocessorDecl declaration = m.preprocessorDecls.get(preprocessorIndex);
			if (declaration.kind == IR_PREPROCESSOR_MACRO) {
				self.scanTextForNames(declaration.replacement, names, rootRefs);
				self.scanTextForNames(declaration.replacement, descriptorNames, descriptorRootRefs);
			}
			preprocessorIndex = preprocessorIndex + 1;
		}
		int globalIndex = 0;
		while (globalIndex < m.globalDecls.len) {
			IRGlobalDecl global = m.globalDecls.get(globalIndex);
			if (!descriptorByName.has(global.name)) {
				self.collectFuncRefs(global.init, knownNames, rootRefs);
				self.collectFuncRefs(global.arraySize, knownNames, rootRefs);
				self.collectGlobalRefs(global.init, knownDescriptorNames, descriptorRootRefs);
				self.collectGlobalRefs(global.arraySize, knownDescriptorNames, descriptorRootRefs);
			}
			globalIndex = globalIndex + 1;
		}
		for declaration in m.objectiveCClasses {
			for method in declaration.methods {
				self.collectFuncRefs(method.body, knownNames, rootRefs);
				self.collectGlobalRefs(method.body, knownDescriptorNames, descriptorRootRefs);
			}
		}
		Vector<string> rootNames = rootRefs.keys();
		int rootIndex = 0;
		while (rootIndex < rootNames.len) {
			string rootName = rootNames.get(rootIndex);
			if (!keepSet.has(rootName)) {
				keepSet.put(rootName, true);
				worklist.push(rootName);
			}
			rootIndex = rootIndex + 1;
		}
		Map<string, bool> keptDescriptors = {};
		Vector<string> descriptorWorklist = descriptorRootRefs.keys();
		/* Transitive reachability. */
		while (worklist.len > 0 || descriptorWorklist.len > 0) {
			Map<string, bool> refs = {};
			if (descriptorWorklist.len > 0) {
				string descriptorName = descriptorWorklist.pop();
				if (keptDescriptors.has(descriptorName)) { continue; }
				keptDescriptors.put(descriptorName, true);
				IRGlobalDecl descriptor = m.globalDecls.get(descriptorByName.get(descriptorName));
				self.collectFuncRefs(descriptor.init, knownNames, refs);
				self.collectFuncRefs(descriptor.arraySize, knownNames, refs);
			} else {
				string cur = worklist.pop();
				bool hasFn = byName.has(cur);
				if (hasFn) {
					IRFunction fn = m.functions.get(byName.get(cur));
					if (fn.body != null) {
						self.collectFuncRefs(fn.body, knownNames, refs);
						Map<string, bool> foundDescriptors = {};
						self.collectGlobalRefs(fn.body, knownDescriptorNames, foundDescriptors);
						Vector<string> foundNames = foundDescriptors.keys();
						int foundIndex = 0;
						while (foundIndex < foundNames.len) {
							string foundName = foundNames.get(foundIndex);
							if (!keptDescriptors.has(foundName)) {
								descriptorWorklist.push(foundName);
							}
							foundIndex = foundIndex + 1;
						}
					}
				}
			}
			Vector<string> rk = refs.keys();
			int k = 0;
			while (k < rk.len) {
				string rn = rk.get(k);
				if (!keepSet.has(rn)) { keepSet.put(rn, true); worklist.push(rn); }
				k = k + 1;
			}
		}
		if (descriptorNames.len > keptDescriptors.len) {
			Vector<IRGlobalDecl> keptGlobals = [];
			int keptGlobalIndex = 0;
			while (keptGlobalIndex < m.globalDecls.len) {
				IRGlobalDecl global = m.globalDecls.get(keptGlobalIndex);
				if (!descriptorByName.has(global.name) || keptDescriptors.has(global.name)) {
					keptGlobals.push(global);
				}
				keptGlobalIndex = keptGlobalIndex + 1;
			}
			m.globalDecls = keptGlobals;
		}
		/* Filter functions. */
		Vector<IRFunction> kept = [];
		Map<string, bool> removed = {};
		int f = 0;
		while (f < m.functions.len) {
			IRFunction fn = m.functions.get(f);
			if (keepSet.has(fn.name)) { kept.push(fn); }
			else { removed.put(fn.name, true); }
			f = f + 1;
		}
		m.functions = kept;
		/* Typed declarations are pruned by their explicit function name. */
		if (removed.len > 0) {
			Vector<IRFunctionDecl> declarations = [];
			int d = 0;
			while (d < m.functionDecls.len) {
				IRFunctionDecl declaration = m.functionDecls.get(d);
				if (!removed.has(declaration.name)) {
					declarations.push(declaration);
				}
				d = d + 1;
			}
			m.functionDecls = declarations;
		}
	}

	/* Collect struct-name references in a function's signature (params + return)
     * and body. Mirrors Python collect_c_type_references: only resolved type text
     * is a type-reachability edge. */
	private void collectStructRefsFn(IRFunction fn, Map<string, bool> names, Map<string, bool> out) {
		self.scanTextForKnownNames(fn.returnType, names, out);
		int i = 0;
		while (i < fn.params.len) {
			self.scanTextForKnownNames(fn.params.get(i).cType, names, out);
			i = i + 1;
		}
		if (fn.body != null) { self.collectStructRefsNode(fn.body, names, out); }
	}

	/* Scan only type-bearing IR fields. Literal payloads and callable names are
     * values, not type references; treating them as C source both roots unrelated
     * declarations and repeatedly scans large generated-runtime string data. */
	private void collectStructRefsNode(IRNode? node, Map<string, bool> names, Map<string, bool> out) {
		if (node == null) { return; }
		if (node.cType != "") {
			self.scanTextForKnownNames(node.cType, names, out);
		}
		if (node.targetType != "") {
			self.scanTextForKnownNames(node.targetType, names, out);
		}
		if (node.params != null) {
			for (int index = 0; index < node.params.len; index++) { self.scanTextForKnownNames(node.params.get(index).cType, names, out); }
		}
		self.collectStructRefsNode(node.left, names, out);
		self.collectStructRefsNode(node.right, names, out);
		self.collectStructRefsNode(node.operand, names, out);
		self.collectStructRefsNode(node.expr, names, out);
		self.collectStructRefsNode(node.obj, names, out);
		self.collectStructRefsNode(node.index, names, out);
		self.collectStructRefsNode(node.condition, names, out);
		self.collectStructRefsNode(node.trueExpr, names, out);
		self.collectStructRefsNode(node.falseExpr, names, out);
		self.collectStructRefsNode(node.init, names, out);
		self.collectStructRefsNode(node.value, names, out);
		self.collectStructRefsNode(node.target, names, out);
		self.collectStructRefsNode(node.thenBlock, names, out);
		self.collectStructRefsNode(node.elseBlock, names, out);
		self.collectStructRefsNode(node.body, names, out);
		self.collectStructRefsNode(node.update, names, out);
		self.collectStructRefsNode(node.result, names, out);
		self.collectStructRefsNode(node.arraySize, names, out);
		int i = 0;
		while (i < node.args().len) { self.collectStructRefsNode(node.args().get(i), names, out); i = i + 1; }
		int j = 0;
		while (j < node.stmts().len) { self.collectStructRefsNode(node.stmts().get(j), names, out); j = j + 1; }
	}

	/* Typed C declarations survive only when live code reaches them.  Mirrors
	 * IROptimizer._prune_types: every enum, struct forward, function-pointer
	 * typedef, typedef, tagged union and struct is keyed by its group and
	 * position; the types and enum values named by live functions, globals,
	 * prototypes, Objective-C classes and macros seed the kept set, and each
	 * kept declaration keeps whatever its own fields, targets and values name. */
	private void collectEnumValueRefs(IRNode? node, Map<string, bool> names, Map<string, bool> out) {
		if (node == null) { return; }
		if (node.kind == IRK_VAR && names.has(node.name)) { out.put(node.name, true); }
		self.collectEnumValueRefs(node.left, names, out);
		self.collectEnumValueRefs(node.right, names, out);
		self.collectEnumValueRefs(node.operand, names, out);
		self.collectEnumValueRefs(node.expr, names, out);
		self.collectEnumValueRefs(node.obj, names, out);
		self.collectEnumValueRefs(node.index, names, out);
		self.collectEnumValueRefs(node.condition, names, out);
		self.collectEnumValueRefs(node.trueExpr, names, out);
		self.collectEnumValueRefs(node.falseExpr, names, out);
		self.collectEnumValueRefs(node.init, names, out);
		self.collectEnumValueRefs(node.value, names, out);
		self.collectEnumValueRefs(node.target, names, out);
		self.collectEnumValueRefs(node.thenBlock, names, out);
		self.collectEnumValueRefs(node.elseBlock, names, out);
		self.collectEnumValueRefs(node.body, names, out);
		self.collectEnumValueRefs(node.update, names, out);
		self.collectEnumValueRefs(node.result, names, out);
		self.collectEnumValueRefs(node.arraySize, names, out);
		for argument in node.args() { self.collectEnumValueRefs(argument, names, out); }
		for statement in node.stmts() { self.collectEnumValueRefs(statement, names, out); }
	}

	private void provideDeclarationName(Map<string, Vector<string>> providers, string name, string key) {
		if (name == "") { return; }
		if (!providers.has(name)) {
			Vector<string> keys = [];
			providers.put(name, keys);
		}
		providers.get(name).push(key);
	}

	private void keepProviders(Map<string, bool> names, Map<string, Vector<string>> providers, Map<string, bool> keepSet, Vector<string> worklist) {
		for name in names.keys() {
			if (!providers.has(name)) { continue; }
			for key in providers.get(name) {
				if (!keepSet.has(key)) {
					keepSet.put(key, true);
					worklist.push(key);
				}
			}
		}
	}

	private void collectFieldRefs(Vector<IRStructField> fields, Map<string, bool> typeNames, Map<string, bool> valueNames, Map<string, bool> types, Map<string, bool> values) {
		for field in fields {
			self.scanTextForKnownNames(field.cType, typeNames, types);
			self.collectStructRefsNode(field.arraySize, typeNames, types);
			self.collectEnumValueRefs(field.arraySize, valueNames, values);
			Vector<IRStructField>? record = field.recordFields;
			if (record != null) { self.collectFieldRefs(record, typeNames, valueNames, types, values); }
		}
	}

	private void collectDeclarationRefs(IRModule m, string key, Map<string, bool> typeNames, Map<string, bool> valueNames, Map<string, bool> types, Map<string, bool> values) {
		string group = key.substring(0, 1);
		int index = Strings.toInt(key.substring(2, key.length() - 2));
		if (group == "e") {
			for value in m.enumDefs.get(index).values {
				self.collectStructRefsNode(value.value, typeNames, types);
				self.collectEnumValueRefs(value.value, valueNames, values);
			}
		} else if (group == "p") {
			IRFunctionPointerTypedef pointer = m.functionPointerTypedefs.get(index);
			self.scanTextForKnownNames(pointer.returnType, typeNames, types);
			for parameterType in pointer.paramTypes { self.scanTextForKnownNames(parameterType, typeNames, types); }
		} else if (group == "t") {
			self.scanTextForKnownNames(m.typedefDefs.get(index).targetType, typeNames, types);
		} else if (group == "u") {
			IRTaggedUnionDef tagged = m.taggedUnionDefs.get(index);
			self.scanTextForKnownNames(tagged.tagType, typeNames, types);
			for variant in tagged.variants { self.collectFieldRefs(variant.fields, typeNames, valueNames, types, values); }
		} else if (group == "s") {
			self.collectFieldRefs(m.structDefs.get(index).fields, typeNames, valueNames, types, values);
		}
	}

	private void eliminateDeadTypeDeclarations(IRModule m) {
		Map<string, Vector<string>> typeProviders = {};
		Map<string, Vector<string>> valueProviders = {};
		Map<string, bool> keepSet = {};
		Vector<string> worklist = [];
		int declarationCount = 0;
		for (int index = 0; index < m.enumDefs.len; index++) {
			IREnumDef definition = m.enumDefs.get(index);
			string key = "e:" + Strings.fromInt(index);
			self.provideDeclarationName(typeProviders, definition.name, key);
			for value in definition.values {
				self.provideDeclarationName(valueProviders, value.name, key);
				if (value.name.startsWith("__btrc_atomic_lock_free_") && !keepSet.has(key)) {
					keepSet.put(key, true);
					worklist.push(key);
				}
			}
			declarationCount = declarationCount + 1;
		}
		for (int index = 0; index < m.structForwards.len; index++) {
			self.provideDeclarationName(typeProviders, m.structForwards.get(index).name, "f:" + Strings.fromInt(index));
			declarationCount = declarationCount + 1;
		}
		for (int index = 0; index < m.functionPointerTypedefs.len; index++) {
			self.provideDeclarationName(typeProviders, m.functionPointerTypedefs.get(index).name, "p:" + Strings.fromInt(index));
			declarationCount = declarationCount + 1;
		}
		for (int index = 0; index < m.typedefDefs.len; index++) {
			self.provideDeclarationName(typeProviders, m.typedefDefs.get(index).name, "t:" + Strings.fromInt(index));
			declarationCount = declarationCount + 1;
		}
		for (int index = 0; index < m.taggedUnionDefs.len; index++) {
			IRTaggedUnionDef tagged = m.taggedUnionDefs.get(index);
			string key = "u:" + Strings.fromInt(index);
			self.provideDeclarationName(typeProviders, tagged.name, key);
			for variant in tagged.variants {
				if (variant.fields.len > 0) { self.provideDeclarationName(typeProviders, tagged.name + "_" + variant.name + "_Data", key); }
			}
			declarationCount = declarationCount + 1;
		}
		for (int index = 0; index < m.structDefs.len; index++) {
			self.provideDeclarationName(typeProviders, m.structDefs.get(index).name, "s:" + Strings.fromInt(index));
			declarationCount = declarationCount + 1;
		}
		if (declarationCount == 0) { return; }
		Map<string, bool> typeNames = {};
		for name in typeProviders.keys() { typeNames.put(name, true); }
		Map<string, bool> valueNames = {};
		for name in valueProviders.keys() { valueNames.put(name, true); }

		Map<string, bool> types = {};
		Map<string, bool> values = {};
		for definition in m.functions {
			self.collectStructRefsFn(definition, typeNames, types);
			self.collectEnumValueRefs(definition.body, valueNames, values);
		}
		for global in m.globalDecls {
			self.scanTextForKnownNames(global.cType, typeNames, types);
			self.collectStructRefsNode(global.init, typeNames, types);
			self.collectStructRefsNode(global.arraySize, typeNames, types);
			self.collectEnumValueRefs(global.init, valueNames, values);
			self.collectEnumValueRefs(global.arraySize, valueNames, values);
		}
		for declaration in m.functionDecls {
			self.scanTextForKnownNames(declaration.returnType, typeNames, types);
			for parameter in declaration.params { self.scanTextForKnownNames(parameter.cType, typeNames, types); }
		}
		for declaration in m.objectiveCClasses {
			for field in declaration.fields { self.scanTextForKnownNames(field.cType, typeNames, types); }
			for method in declaration.methods {
				self.scanTextForKnownNames(method.returnType, typeNames, types);
				for parameter in method.params { self.scanTextForKnownNames(parameter.cType, typeNames, types); }
				self.collectStructRefsNode(method.body, typeNames, types);
				self.collectEnumValueRefs(method.body, valueNames, values);
			}
		}
		for declaration in m.preprocessorDecls {
			if (declaration.kind == IR_PREPROCESSOR_MACRO) {
				self.scanTextForKnownNames(declaration.replacement, typeNames, types);
				self.scanTextForKnownNames(declaration.replacement, valueNames, values);
			}
		}
		self.keepProviders(types, typeProviders, keepSet, worklist);
		self.keepProviders(values, valueProviders, keepSet, worklist);
		while (worklist.len > 0) {
			Map<string, bool> dependencyTypes = {};
			Map<string, bool> dependencyValues = {};
			self.collectDeclarationRefs(m, worklist.pop(), typeNames, valueNames, dependencyTypes, dependencyValues);
			self.keepProviders(dependencyTypes, typeProviders, keepSet, worklist);
			self.keepProviders(dependencyValues, valueProviders, keepSet, worklist);
		}
		if (keepSet.len == declarationCount) { return; }

		/* A module unit's dropped declarations are the program's shared
		 * declaration IR, alive in other units: releasing this unit's lists
		 * would only prove each one still reachable. */
		Vector<IREnumDef> enums = [];
		for (int index = 0; index < m.enumDefs.len; index++) { if (keepSet.has("e:" + Strings.fromInt(index))) { enums.push(m.enumDefs.get(index)); } }
		Vector<IRStructForward> forwards = [];
		for (int index = 0; index < m.structForwards.len; index++) { if (keepSet.has("f:" + Strings.fromInt(index))) { forwards.push(m.structForwards.get(index)); } }
		Vector<IRFunctionPointerTypedef> pointers = [];
		for (int index = 0; index < m.functionPointerTypedefs.len; index++) { if (keepSet.has("p:" + Strings.fromInt(index))) { pointers.push(m.functionPointerTypedefs.get(index)); } }
		Vector<IRTypedefDef> typedefs = [];
		for (int index = 0; index < m.typedefDefs.len; index++) { if (keepSet.has("t:" + Strings.fromInt(index))) { typedefs.push(m.typedefDefs.get(index)); } }
		Vector<IRTaggedUnionDef> tagged = [];
		for (int index = 0; index < m.taggedUnionDefs.len; index++) { if (keepSet.has("u:" + Strings.fromInt(index))) { tagged.push(m.taggedUnionDefs.get(index)); } }
		Vector<IRStructDef> structs = [];
		for (int index = 0; index < m.structDefs.len; index++) { if (keepSet.has("s:" + Strings.fromInt(index))) { structs.push(m.structDefs.get(index)); } }
		if (self.moduleUnit) {
			Vector<IREnumDef> previousEnums = m.enumDefs;
			Vector<IRStructForward> previousForwards = m.structForwards;
			Vector<IRFunctionPointerTypedef> previousPointers = m.functionPointerTypedefs;
			Vector<IRTypedefDef> previousTypedefs = m.typedefDefs;
			Vector<IRTaggedUnionDef> previousTagged = m.taggedUnionDefs;
			Vector<IRStructDef> previousStructs = m.structDefs;
			keep previousEnums;
			keep previousForwards;
			keep previousPointers;
			keep previousTypedefs;
			keep previousTagged;
			keep previousStructs;
		}
		m.enumDefs = enums;
		m.structForwards = forwards;
		m.functionPointerTypedefs = pointers;
		m.typedefDefs = typedefs;
		m.taggedUnionDefs = tagged;
		m.structDefs = structs;
	}

	/* Number each generated adapter family's surviving members from 1, in
	 * definition order, and rename every reference. Adapters are numbered when
	 * lowering first needs them, so without this a family's names depended on
	 * adapters only dead functions used. Mirrors IROptimizer._renumber_adapters. */
	private bool adapterMember(string name, string prefix) {
		if (!name.startsWith(prefix) || name.length() == prefix.length()) { return false; }
		int index = prefix.length();
		while (index < name.length()) {
			if (name[index] < '0' || name[index] > '9') { return false; }
			index = index + 1;
		}
		return true;
	}

	private void renameSymbols(IRNode? node, Map<string, string> renamed) {
		if (node == null) { return; }
		if (node.kind == IRK_FUNCTION_REF && renamed.has(node.name)) { node.name = renamed.get(node.name); }
		if (node.callee != "" && renamed.has(node.callee)) { node.callee = renamed.get(node.callee); }
		if (node.helperRef != "" && renamed.has(node.helperRef)) { node.helperRef = renamed.get(node.helperRef); }
		IRCleanupSlot? slot = node.cleanupSlot;
		if (slot != null && renamed.has(slot.takeFunction)) { slot.takeFunction = renamed.get(slot.takeFunction); }
		self.renameSymbols(node.left, renamed);
		self.renameSymbols(node.right, renamed);
		self.renameSymbols(node.operand, renamed);
		self.renameSymbols(node.expr, renamed);
		self.renameSymbols(node.obj, renamed);
		self.renameSymbols(node.index, renamed);
		self.renameSymbols(node.condition, renamed);
		self.renameSymbols(node.trueExpr, renamed);
		self.renameSymbols(node.falseExpr, renamed);
		self.renameSymbols(node.arraySize, renamed);
		self.renameSymbols(node.init, renamed);
		self.renameSymbols(node.value, renamed);
		self.renameSymbols(node.target, renamed);
		self.renameSymbols(node.thenBlock, renamed);
		self.renameSymbols(node.elseBlock, renamed);
		self.renameSymbols(node.body, renamed);
		self.renameSymbols(node.update, renamed);
		self.renameSymbols(node.result, renamed);
		for argument in node.args() { self.renameSymbols(argument, renamed); }
		for statement in node.stmts() { self.renameSymbols(statement, renamed); }
	}

	private void renameModuleSymbols(IRModule module, Map<string, string> renamed) {
		for definition in module.functions {
			if (renamed.has(definition.name)) { definition.name = renamed.get(definition.name); }
			self.renameSymbols(definition.body, renamed);
		}
		for declaration in module.functionDecls {
			if (renamed.has(declaration.name)) { declaration.name = renamed.get(declaration.name); }
		}
		for global in module.globalDecls {
			self.renameSymbols(global.init, renamed);
			self.renameSymbols(global.arraySize, renamed);
		}
		for declaration in module.objectiveCClasses {
			for method in declaration.methods { self.renameSymbols(method.body, renamed); }
		}
	}

	/* Order and number each generated adapter family by first use: the first
	 * surviving non-adapter function that names a member, ties keeping
	 * creation order. Creation order followed the order functions were
	 * lowered in, which differs between the compilers. The adapters'
	 * positions are then filled family by family. Mirrors
	 * IROptimizer._renumber_adapters in the Python owner. */
	private void renumberAdapters(IRModule module) {
		Vector<string> families = ["__btrc_arc_slot_access_", "__btrc_mutex_value_access_", "__btrc_store_", "__btrc_cleanup_take_"];
		Map<string, bool> members = {};
		for definition in module.functions {
			for prefix in families {
				if (self.adapterMember(definition.name, prefix)) { members.put(definition.name, true); }
			}
		}
		if (members.len == 0) { return; }
		Map<string, int> firstUse = {};
		int position = 0;
		for definition in module.functions {
			if (!members.has(definition.name)) { self.collectAdapterUses(definition.body, members, position, firstUse); }
			position = position + 1;
		}
		int unused = module.functions.len;
		Map<string, string> placeholders = {};
		Map<string, string> finals = {};
		bool changed = false;
		Vector<int> positions = [];
		Vector<int> ordered = [];
		for prefix in families {
			Vector<int> ranked = [];
			int index = 0;
			for definition in module.functions {
				if (self.adapterMember(definition.name, prefix)) {
					positions.push(index);
					int rank = firstUse.has(definition.name) ? firstUse.get(definition.name) : unused;
					int at = ranked.len;
					while (at > 0) {
						string previous = module.functions.get(ranked.get(at - 1)).name;
						int previousRank = firstUse.has(previous) ? firstUse.get(previous) : unused;
						if (previousRank <= rank) { break; }
						at = at - 1;
					}
					ranked.insert(at, index);
				}
				index = index + 1;
			}
			int number = 0;
			for source in ranked {
				number = number + 1;
				string name = module.functions.get(source).name;
				string placeholder = "#" + prefix + Strings.fromInt(number);
				string finalName = prefix + Strings.fromInt(number);
				placeholders.put(name, placeholder);
				finals.put(placeholder, finalName);
				if (name != finalName) { changed = true; }
				ordered.push(source);
			}
		}
		/* The adapters keep the positions they occupy, filled family by family. */
		positions.sort();
		Vector<IRFunction> reordered = [];
		for definition in module.functions { reordered.push(definition); }
		int slot = 0;
		while (slot < positions.len) {
			if (positions.get(slot) != ordered.get(slot)) { changed = true; }
			reordered.set(positions.get(slot), module.functions.get(ordered.get(slot)));
			slot = slot + 1;
		}
		module.functions = reordered;
		if (!changed) { return; }
		self.renameModuleSymbols(module, placeholders);
		self.renameModuleSymbols(module, finals);
	}

	private void collectAdapterUses(IRNode? node, Map<string, bool> members, int position, Map<string, int> firstUse) {
		if (node == null) { return; }
		if (node.kind == IRK_FUNCTION_REF && members.has(node.name) && !firstUse.has(node.name)) { firstUse.put(node.name, position); }
		if (node.callee != "" && members.has(node.callee) && !firstUse.has(node.callee)) { firstUse.put(node.callee, position); }
		IRCleanupSlot? slot = node.cleanupSlot;
		if (slot != null && members.has(slot.takeFunction) && !firstUse.has(slot.takeFunction)) { firstUse.put(slot.takeFunction, position); }
		self.collectAdapterUses(node.left, members, position, firstUse);
		self.collectAdapterUses(node.right, members, position, firstUse);
		self.collectAdapterUses(node.operand, members, position, firstUse);
		self.collectAdapterUses(node.expr, members, position, firstUse);
		self.collectAdapterUses(node.obj, members, position, firstUse);
		self.collectAdapterUses(node.index, members, position, firstUse);
		self.collectAdapterUses(node.condition, members, position, firstUse);
		self.collectAdapterUses(node.trueExpr, members, position, firstUse);
		self.collectAdapterUses(node.falseExpr, members, position, firstUse);
		self.collectAdapterUses(node.arraySize, members, position, firstUse);
		self.collectAdapterUses(node.init, members, position, firstUse);
		self.collectAdapterUses(node.value, members, position, firstUse);
		self.collectAdapterUses(node.target, members, position, firstUse);
		self.collectAdapterUses(node.thenBlock, members, position, firstUse);
		self.collectAdapterUses(node.elseBlock, members, position, firstUse);
		self.collectAdapterUses(node.body, members, position, firstUse);
		self.collectAdapterUses(node.update, members, position, firstUse);
		self.collectAdapterUses(node.result, members, position, firstUse);
		for argument in node.args() { self.collectAdapterUses(argument, members, position, firstUse); }
		for statement in node.stmts() { self.collectAdapterUses(statement, members, position, firstUse); }
	}

	/* Number each function's compiler temporaries from 1, in allocation
	 * order, skipping any number a non-temporary name in the function already
	 * spells. Lowering draws every temporary from one counter, so without
	 * this a function's names depended on how much else was lowered first,
	 * including functions DCE later removed. Mirrors
	 * IROptimizer._renumber_temporaries in the Python owner. */
	private int temporaryNumber(string name) {
		int index = name.length() - 1;
		while (index >= 0 && name[index] >= '0' && name[index] <= '9') { index = index - 1; }
		if (index <= 0 || index == name.length() - 1 || name[index] != '_') { return 0; }
		return Strings.toInt(name.substring(index + 1, name.length() - index - 1));
	}

	private void collectTemporaryNames(IRNode? node, Map<string, bool> generated, Map<string, int> temporaries, Vector<string> order, Map<string, bool> occupied) {
		if (node == null) { return; }
		if (node.kind == IRK_VAR || node.kind == IRK_VAR_DECL) {
			if (generated.has(node.name)) {
				if (!temporaries.has(node.name)) {
					temporaries.put(node.name, self.temporaryNumber(node.name));
					order.push(node.name);
				}
			} else {
				occupied.put(node.name, true);
			}
		}
		self.collectTemporaryNames(node.left, generated, temporaries, order, occupied);
		self.collectTemporaryNames(node.right, generated, temporaries, order, occupied);
		self.collectTemporaryNames(node.operand, generated, temporaries, order, occupied);
		self.collectTemporaryNames(node.expr, generated, temporaries, order, occupied);
		self.collectTemporaryNames(node.obj, generated, temporaries, order, occupied);
		self.collectTemporaryNames(node.index, generated, temporaries, order, occupied);
		self.collectTemporaryNames(node.condition, generated, temporaries, order, occupied);
		self.collectTemporaryNames(node.trueExpr, generated, temporaries, order, occupied);
		self.collectTemporaryNames(node.falseExpr, generated, temporaries, order, occupied);
		self.collectTemporaryNames(node.arraySize, generated, temporaries, order, occupied);
		self.collectTemporaryNames(node.init, generated, temporaries, order, occupied);
		self.collectTemporaryNames(node.value, generated, temporaries, order, occupied);
		self.collectTemporaryNames(node.target, generated, temporaries, order, occupied);
		self.collectTemporaryNames(node.thenBlock, generated, temporaries, order, occupied);
		self.collectTemporaryNames(node.elseBlock, generated, temporaries, order, occupied);
		self.collectTemporaryNames(node.body, generated, temporaries, order, occupied);
		self.collectTemporaryNames(node.update, generated, temporaries, order, occupied);
		self.collectTemporaryNames(node.result, generated, temporaries, order, occupied);
		for argument in node.args() { self.collectTemporaryNames(argument, generated, temporaries, order, occupied); }
		for statement in node.stmts() { self.collectTemporaryNames(statement, generated, temporaries, order, occupied); }
	}

	private void renameTemporaries(IRNode? node, Map<string, string> renamed) {
		if (node == null) { return; }
		if ((node.kind == IRK_VAR || node.kind == IRK_VAR_DECL) && renamed.has(node.name)) { node.name = renamed.get(node.name); }
		if (renamed.has(node.storageRoot)) { node.storageRoot = renamed.get(node.storageRoot); }
		if (renamed.has(node.arrayStorageRoot)) { node.arrayStorageRoot = renamed.get(node.arrayStorageRoot); }
		IRCleanupSlot? slot = node.cleanupSlot;
		if (slot != null && renamed.has(slot.name)) { slot.name = renamed.get(slot.name); }
		self.renameTemporaries(node.left, renamed);
		self.renameTemporaries(node.right, renamed);
		self.renameTemporaries(node.operand, renamed);
		self.renameTemporaries(node.expr, renamed);
		self.renameTemporaries(node.obj, renamed);
		self.renameTemporaries(node.index, renamed);
		self.renameTemporaries(node.condition, renamed);
		self.renameTemporaries(node.trueExpr, renamed);
		self.renameTemporaries(node.falseExpr, renamed);
		self.renameTemporaries(node.arraySize, renamed);
		self.renameTemporaries(node.init, renamed);
		self.renameTemporaries(node.value, renamed);
		self.renameTemporaries(node.target, renamed);
		self.renameTemporaries(node.thenBlock, renamed);
		self.renameTemporaries(node.elseBlock, renamed);
		self.renameTemporaries(node.body, renamed);
		self.renameTemporaries(node.update, renamed);
		self.renameTemporaries(node.result, renamed);
		for argument in node.args() { self.renameTemporaries(argument, renamed); }
		for statement in node.stmts() { self.renameTemporaries(statement, renamed); }
	}

	private void renumberBody(Vector<IRParam> params, IRNode? body, Map<string, bool> generated) {
		Map<string, int> temporaries = {};
		Vector<string> order = [];
		Map<string, bool> occupied = {};
		for parameter in params { occupied.put(parameter.name, true); }
		self.collectTemporaryNames(body, generated, temporaries, order, occupied);
		if (order.len == 0) { return; }
		/* Stable insertion sort by the allocation counter. */
		Vector<string> sorted = [];
		for name in order {
			int position = sorted.len;
			while (position > 0 && temporaries.get(sorted.get(position - 1)) > temporaries.get(name)) { position = position - 1; }
			sorted.insert(position, name);
		}
		/* Two phases through placeholders no identifier can spell, so a node
		 * the IR shares between two places is never renamed twice. */
		Map<string, string> placeholders = {};
		Map<string, string> finals = {};
		int counter = 0;
		for name in sorted {
			if (temporaries.get(name) == 0) { continue; }
			string prefix = name.substring(0, name.length() - Strings.fromInt(temporaries.get(name)).length() - 1);
			string candidate = "";
			while (true) {
				counter = counter + 1;
				candidate = prefix + "_" + Strings.fromInt(counter);
				if (!occupied.has(candidate)) { break; }
			}
			string placeholder = "#" + Strings.fromInt(counter);
			placeholders.put(name, placeholder);
			finals.put(placeholder, candidate);
		}
		self.renameTemporaries(body, placeholders);
		self.renameTemporaries(body, finals);
	}

	private void renumberTemporaries(IRModule module) {
		Map<string, bool> generated = module.temporaryNames.generated;
		if (generated.len == 0) { return; }
		for definition in module.functions { self.renumberBody(definition.params, definition.body, generated); }
		for declaration in module.objectiveCClasses {
			for method in declaration.methods { self.renumberBody(method.params, method.body, generated); }
		}
	}

	/* Order prototypes independently of the lowering phase that declared
	 * them: those with no definition in this module keep their relative order
	 * and come first, the rest follow their definitions' order. Mirrors
	 * IROptimizer._order_prototypes in the Python owner. */
	private void orderPrototypes(IRModule module) {
		Map<string, Vector<IRFunctionDecl>> byName = {};
		Map<string, bool> defined = {};
		for definition in module.functions { defined.put(definition.name, true); }
		Vector<IRFunctionDecl> ordered = [];
		for declaration in module.functionDecls {
			if (!defined.has(declaration.name)) {
				ordered.push(declaration);
				continue;
			}
			if (!byName.has(declaration.name)) {
				Vector<IRFunctionDecl> group = [];
				byName.put(declaration.name, group);
			}
			byName.get(declaration.name).push(declaration);
		}
		for definition in module.functions {
			if (!byName.has(definition.name)) { continue; }
			for declaration in byName.get(definition.name) { ordered.push(declaration); }
			byName.remove(definition.name);
		}
		module.functionDecls = ordered;
	}

	/* Normalize unused C parameters into explicit structured discards.
     * Mirrors IROptimizer._normalize_unused_parameters in the Python owner. */

	private void collectParameterUses(IRNode node, Map<string, bool> names, Map<string, bool> references, Map<string, bool> declarations) {
		if (node == null) { return; }
		if (node.kind == IRK_VAR && names.has(node.name)) {
			references.put(node.name, true);
		} else if (node.kind == IRK_VAR_DECL && names.has(node.name)) {
			declarations.put(node.name, true);
		}

		self.collectParameterUses(node.left, names, references, declarations);
		self.collectParameterUses(node.right, names, references, declarations);
		self.collectParameterUses(node.operand, names, references, declarations);
		self.collectParameterUses(node.expr, names, references, declarations);
		self.collectParameterUses(node.obj, names, references, declarations);
		self.collectParameterUses(node.index, names, references, declarations);
		self.collectParameterUses(node.condition, names, references, declarations);
		self.collectParameterUses(node.trueExpr, names, references, declarations);
		self.collectParameterUses(node.falseExpr, names, references, declarations);
		self.collectParameterUses(node.init, names, references, declarations);
		self.collectParameterUses(node.value, names, references, declarations);
		self.collectParameterUses(node.target, names, references, declarations);
		self.collectParameterUses(node.thenBlock, names, references, declarations);
		self.collectParameterUses(node.elseBlock, names, references, declarations);
		self.collectParameterUses(node.body, names, references, declarations);
		self.collectParameterUses(node.update, names, references, declarations);
		self.collectParameterUses(node.result, names, references, declarations);
		self.collectParameterUses(node.arraySize, names, references, declarations);
		int i = 0;
		while (i < node.args().len) {
			self.collectParameterUses(node.args().get(i), names, references, declarations);
			i = i + 1;
		}
		int s = 0;
		while (s < node.stmts().len) {
			self.collectParameterUses(node.stmts().get(s), names, references, declarations);
			s = s + 1;
		}
	}

	private void normalizeUnusedParameters(IRModule module) {
		int f = 0;
		while (f < module.functions.len) {
			IRFunction fn = module.functions.get(f);
			if (fn.body != null && fn.params.len > 0) {
				Map<string, bool> names = {};
				int p = 0;
				while (p < fn.params.len) {
					names.put(fn.params.get(p).name, true);
					p = p + 1;
				}

				Map<string, bool> references = {};
				Map<string, bool> declarations = {};
				self.collectParameterUses(fn.body, names, references, declarations);

				Map<string, bool> existingDiscards = {};
				int s = 0;
				while (s < fn.body.stmts().len) {
					IRNode statement = fn.body.stmts().get(s);
					if (statement.kind == IRK_EXPR_STMT && statement.expr != null && statement.expr.kind == IRK_VAR) {
						existingDiscards.put(statement.expr.name, true);
					}
					s = s + 1;
				}

				Vector<IRNode> prefix = [];
				p = 0;
				while (p < fn.params.len) {
					string name = fn.params.get(p).name;
					bool unused = !references.has(name) || declarations.has(name);
					if (unused && !existingDiscards.has(name)) {
						prefix.push(IRNode.expressionStatement(IRNode.variable(name)));
					}
					p = p + 1;
				}
				s = 0;
				while (s < fn.body.stmts().len) {
					prefix.push(fn.body.stmts().get(s));
					s = s + 1;
				}
				fn.body.stmtsStorage = prefix;
			}
			f = f + 1;
		}
	}
}

/* The canonical group order of typed declarations, which the plan keeps
 * among declarations that are ready together. */
enum IRTypeDeclarationGroup {
	IR_TYPE_DECLARATION_ENUM = 0,
	IR_TYPE_DECLARATION_FUNCTION_POINTER = 1,
	IR_TYPE_DECLARATION_TYPEDEF = 2,
	IR_TYPE_DECLARATION_TAGGED_UNION = 3,
	IR_TYPE_DECLARATION_STRUCT = 4
};

/* One planned typed declaration: its group and its position in that group's
 * module list. */
class IRTypeDeclarationRef {
	public int group;
	public int index;

	public IRTypeDeclarationRef(int group, int index) {
		self.group = group;
		self.index = index;
	}
}

/* The stable strict-C dependency order of a module's typed declarations.
 * Mirrors IROptimizer.plan_type_declarations: a declaration follows every
 * declaration it names, except that a struct or tagged union named through a
 * pointer, or outside a complete-type context, needs only its forward. A
 * struct, tagged union or enum is a complete-type context, and it also
 * follows each aggregate a non-pointer typedef it uses resolves to. Ready
 * declarations keep the canonical group order. */
class IRTypeDeclarationPlanner {
	class Vector<IRTypeDeclarationRef> plan(IRModule module) {
		Vector<IRTypeDeclarationRef> declarations = [];
		for (int index = 0; index < module.enumDefs.len; index++) { declarations.push(IRTypeDeclarationRef(IR_TYPE_DECLARATION_ENUM, index)); }
		for (int index = 0; index < module.functionPointerTypedefs.len; index++) { declarations.push(IRTypeDeclarationRef(IR_TYPE_DECLARATION_FUNCTION_POINTER, index)); }
		for (int index = 0; index < module.typedefDefs.len; index++) { declarations.push(IRTypeDeclarationRef(IR_TYPE_DECLARATION_TYPEDEF, index)); }
		for (int index = 0; index < module.taggedUnionDefs.len; index++) { declarations.push(IRTypeDeclarationRef(IR_TYPE_DECLARATION_TAGGED_UNION, index)); }
		for (int index = 0; index < module.structDefs.len; index++) { declarations.push(IRTypeDeclarationRef(IR_TYPE_DECLARATION_STRUCT, index)); }
		if (declarations.len == 0) { return declarations; }
		Map<string, int> providers = IRTypeDeclarationPlanner.typeProviders(module, declarations);
		Map<string, int> valueProviders = IRTypeDeclarationPlanner.enumValueProviders(module, declarations);
		Vector<Vector<int>> aliasTargets = IRTypeDeclarationPlanner.aliasCompleteTargets(module, declarations, providers);
		Vector<Vector<int>> dependencies = [];
		for (int index = 0; index < declarations.len; index++) {
			dependencies.push(IRTypeDeclarationPlanner.typeDependencies(module, index, declarations, providers, valueProviders, aliasTargets));
		}
		return IRTypeDeclarationPlanner.stableOrder(module, declarations, dependencies);
	}

	class string declarationName(IRModule module, IRTypeDeclarationRef declaration) {
		if (declaration.group == IR_TYPE_DECLARATION_ENUM) { return module.enumDefs.get(declaration.index).name; }
		if (declaration.group == IR_TYPE_DECLARATION_FUNCTION_POINTER) { return module.functionPointerTypedefs.get(declaration.index).name; }
		if (declaration.group == IR_TYPE_DECLARATION_TYPEDEF) { return module.typedefDefs.get(declaration.index).name; }
		if (declaration.group == IR_TYPE_DECLARATION_TAGGED_UNION) { return module.taggedUnionDefs.get(declaration.index).name; }
		return module.structDefs.get(declaration.index).name;
	}

	class bool isAggregate(IRTypeDeclarationRef declaration) { return declaration.group == IR_TYPE_DECLARATION_TAGGED_UNION || declaration.group == IR_TYPE_DECLARATION_STRUCT; }

	class void provide(Map<string, int> providers, string name, int index, string kind) {
		if (providers.has(name) && providers.get(name) != index) { throw "duplicate typed C " + kind + " provider '" + name + "'"; }
		providers.put(name, index);
	}

	class Map<string, int> typeProviders(IRModule module, Vector<IRTypeDeclarationRef> declarations) {
		Map<string, int> providers = {};
		for (int index = 0; index < declarations.len; index++) {
			IRTypeDeclarationRef declaration = declarations.get(index);
			string name = IRTypeDeclarationPlanner.declarationName(module, declaration);
			if (declaration.group == IR_TYPE_DECLARATION_ENUM && name.isEmpty()) { continue; }
			IRTypeDeclarationPlanner.provide(providers, name, index, "declaration");
			if (declaration.group == IR_TYPE_DECLARATION_TAGGED_UNION) {
				for variant in module.taggedUnionDefs.get(declaration.index).variants {
					if (variant.fields.len > 0) { IRTypeDeclarationPlanner.provide(providers, name + "_" + variant.name + "_Data", index, "declaration"); }
				}
			}
		}
		return providers;
	}

	class Map<string, int> enumValueProviders(IRModule module, Vector<IRTypeDeclarationRef> declarations) {
		Map<string, int> providers = {};
		for (int index = 0; index < declarations.len; index++) {
			IRTypeDeclarationRef declaration = declarations.get(index);
			if (declaration.group != IR_TYPE_DECLARATION_ENUM) { continue; }
			for value in module.enumDefs.get(declaration.index).values { IRTypeDeclarationPlanner.provide(providers, value.name, index, "enum-value"); }
		}
		return providers;
	}

	/* The providers each whole identifier of C type text names. */
	class Vector<int> typeReferences(string text, Map<string, int> providers) {
		Vector<int> references = [];
		int length = text.length();
		int index = 0;
		while (index < length) {
			while (index < length && !IRTypeDeclarationPlanner.isIdentifierChar(text[index])) { index = index + 1; }
			int start = index;
			while (index < length && IRTypeDeclarationPlanner.isIdentifierChar(text[index])) { index = index + 1; }
			if (start < index) {
				string name = text.substring(start, index - start);
				if (providers.has(name)) { references.push(providers.get(name)); }
			}
		}
		return references;
	}

	class bool isIdentifierChar(char value) { return (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z') || (value >= '0' && value <= '9') || value == '_'; }

	/* Every C type text an expression spells, as the reference walks each
	 * CType node of a declaration. */
	class void expressionTypes(IRNode? node, Vector<string> out) {
		if (node == null) { return; }
		if (!node.cType.isEmpty()) { out.push(node.cType); }
		if (!node.targetType.isEmpty()) { out.push(node.targetType); }
		if (node.params != null) { for parameter in node.params { out.push(parameter.cType); } }
		if (node.cleanupSlot != null) { out.push(node.cleanupSlot.cType); }
		IRTypeDeclarationPlanner.expressionTypes(node.left, out);
		IRTypeDeclarationPlanner.expressionTypes(node.right, out);
		IRTypeDeclarationPlanner.expressionTypes(node.operand, out);
		IRTypeDeclarationPlanner.expressionTypes(node.expr, out);
		IRTypeDeclarationPlanner.expressionTypes(node.obj, out);
		IRTypeDeclarationPlanner.expressionTypes(node.index, out);
		IRTypeDeclarationPlanner.expressionTypes(node.condition, out);
		IRTypeDeclarationPlanner.expressionTypes(node.trueExpr, out);
		IRTypeDeclarationPlanner.expressionTypes(node.falseExpr, out);
		IRTypeDeclarationPlanner.expressionTypes(node.init, out);
		IRTypeDeclarationPlanner.expressionTypes(node.value, out);
		IRTypeDeclarationPlanner.expressionTypes(node.target, out);
		IRTypeDeclarationPlanner.expressionTypes(node.thenBlock, out);
		IRTypeDeclarationPlanner.expressionTypes(node.elseBlock, out);
		IRTypeDeclarationPlanner.expressionTypes(node.body, out);
		IRTypeDeclarationPlanner.expressionTypes(node.update, out);
		IRTypeDeclarationPlanner.expressionTypes(node.result, out);
		IRTypeDeclarationPlanner.expressionTypes(node.arraySize, out);
		for argument in node.args() { IRTypeDeclarationPlanner.expressionTypes(argument, out); }
		for statement in node.stmts() { IRTypeDeclarationPlanner.expressionTypes(statement, out); }
	}

	class void fieldTypes(Vector<IRStructField> fields, Vector<string> out) {
		for field in fields {
			out.push(field.cType);
			IRTypeDeclarationPlanner.expressionTypes(field.arraySize, out);
			Vector<IRStructField>? record = field.recordFields;
			if (record != null) { IRTypeDeclarationPlanner.fieldTypes(record, out); }
		}
	}

	/* Every C type text one declaration spells. */
	class Vector<string> declarationTypes(IRModule module, IRTypeDeclarationRef declaration) {
		Vector<string> types = [];
		if (declaration.group == IR_TYPE_DECLARATION_ENUM) {
			for value in module.enumDefs.get(declaration.index).values { IRTypeDeclarationPlanner.expressionTypes(value.value, types); }
		} else if (declaration.group == IR_TYPE_DECLARATION_FUNCTION_POINTER) {
			IRFunctionPointerTypedef pointer = module.functionPointerTypedefs.get(declaration.index);
			types.push(pointer.returnType);
			for parameter in pointer.paramTypes { types.push(parameter); }
		} else if (declaration.group == IR_TYPE_DECLARATION_TYPEDEF) {
			types.push(module.typedefDefs.get(declaration.index).targetType);
		} else if (declaration.group == IR_TYPE_DECLARATION_TAGGED_UNION) {
			IRTaggedUnionDef tagged = module.taggedUnionDefs.get(declaration.index);
			types.push(tagged.tagType);
			for variant in tagged.variants { IRTypeDeclarationPlanner.fieldTypes(variant.fields, types); }
		} else {
			IRTypeDeclarationPlanner.fieldTypes(module.structDefs.get(declaration.index).fields, types);
		}
		return types;
	}

	/* The aggregates each non-pointer typedef resolves to through any chain
	 * of typedefs, which a complete-type context needs complete. */
	class Vector<Vector<int>> aliasCompleteTargets(IRModule module, Vector<IRTypeDeclarationRef> declarations, Map<string, int> providers) {
		Vector<Vector<int>> memo = [];
		Vector<int> state = [];
		for (int index = 0; index < declarations.len; index++) {
			Vector<int> empty = [];
			memo.push(empty);
			state.push(0);
		}
		for (int index = 0; index < declarations.len; index++) {
			IRTypeDeclarationPlanner.resolveAliasTargets(module, index, declarations, providers, memo, state);
		}
		return memo;
	}

	/* state: 0 unresolved, 1 resolving, 2 resolved. */
	class Vector<int> resolveAliasTargets(IRModule module, int index, Vector<IRTypeDeclarationRef> declarations, Map<string, int> providers, Vector<Vector<int>> memo, Vector<int> state) {
		Vector<int> targets = [];
		if (state.get(index) == 2) { return memo.get(index); }
		if (state.get(index) == 1) { return targets; }
		IRTypeDeclarationRef declaration = declarations.get(index);
		if (declaration.group != IR_TYPE_DECLARATION_TYPEDEF) { return targets; }
		string text = module.typedefDefs.get(declaration.index).targetType;
		if (text.indexOf("*") >= 0) {
			memo.set(index, targets);
			state.set(index, 2);
			return targets;
		}
		state.set(index, 1);
		for provider in IRTypeDeclarationPlanner.typeReferences(text, providers) {
			IRTypeDeclarationRef provided = declarations.get(provider);
			if (IRTypeDeclarationPlanner.isAggregate(provided)) { targets.push(provider); }
			else if (provided.group == IR_TYPE_DECLARATION_TYPEDEF) {
				for target in IRTypeDeclarationPlanner.resolveAliasTargets(module, provider, declarations, providers, memo, state) { targets.push(target); }
			}
		}
		memo.set(index, targets);
		state.set(index, 2);
		return targets;
	}

	class void enumValueReferences(IRNode? node, Map<string, int> valueProviders, Vector<string> out) {
		if (node == null) { return; }
		if (node.kind == IRK_VAR && valueProviders.has(node.name)) { out.push(node.name); }
		IRTypeDeclarationPlanner.enumValueReferences(node.left, valueProviders, out);
		IRTypeDeclarationPlanner.enumValueReferences(node.right, valueProviders, out);
		IRTypeDeclarationPlanner.enumValueReferences(node.operand, valueProviders, out);
		IRTypeDeclarationPlanner.enumValueReferences(node.expr, valueProviders, out);
		IRTypeDeclarationPlanner.enumValueReferences(node.obj, valueProviders, out);
		IRTypeDeclarationPlanner.enumValueReferences(node.index, valueProviders, out);
		IRTypeDeclarationPlanner.enumValueReferences(node.condition, valueProviders, out);
		IRTypeDeclarationPlanner.enumValueReferences(node.trueExpr, valueProviders, out);
		IRTypeDeclarationPlanner.enumValueReferences(node.falseExpr, valueProviders, out);
		IRTypeDeclarationPlanner.enumValueReferences(node.init, valueProviders, out);
		IRTypeDeclarationPlanner.enumValueReferences(node.value, valueProviders, out);
		IRTypeDeclarationPlanner.enumValueReferences(node.target, valueProviders, out);
		IRTypeDeclarationPlanner.enumValueReferences(node.thenBlock, valueProviders, out);
		IRTypeDeclarationPlanner.enumValueReferences(node.elseBlock, valueProviders, out);
		IRTypeDeclarationPlanner.enumValueReferences(node.body, valueProviders, out);
		IRTypeDeclarationPlanner.enumValueReferences(node.update, valueProviders, out);
		IRTypeDeclarationPlanner.enumValueReferences(node.result, valueProviders, out);
		IRTypeDeclarationPlanner.enumValueReferences(node.arraySize, valueProviders, out);
		for argument in node.args() { IRTypeDeclarationPlanner.enumValueReferences(argument, valueProviders, out); }
		for statement in node.stmts() { IRTypeDeclarationPlanner.enumValueReferences(statement, valueProviders, out); }
	}

	class Vector<int> typeDependencies(IRModule module, int declarationIndex, Vector<IRTypeDeclarationRef> declarations, Map<string, int> providers, Map<string, int> valueProviders, Vector<Vector<int>> aliasTargets) {
		Vector<int> dependencies = [];
		IRTypeDeclarationRef declaration = declarations.get(declarationIndex);
		bool completeTypeContext = declaration.group != IR_TYPE_DECLARATION_FUNCTION_POINTER && declaration.group != IR_TYPE_DECLARATION_TYPEDEF;
		for text in IRTypeDeclarationPlanner.declarationTypes(module, declaration) {
			bool requiresComplete = completeTypeContext && text.indexOf("*") < 0;
			for provider in IRTypeDeclarationPlanner.typeReferences(text, providers) {
				IRTypeDeclarationRef provided = declarations.get(provider);
				if (!IRTypeDeclarationPlanner.isAggregate(provided) || requiresComplete) { dependencies.push(provider); }
				if (requiresComplete && provided.group == IR_TYPE_DECLARATION_TYPEDEF) {
					for target in aliasTargets.get(provider) { dependencies.push(target); }
				}
			}
		}
		if (declaration.group == IR_TYPE_DECLARATION_ENUM && valueProviders.len > 0) {
			Vector<string> references = [];
			for value in module.enumDefs.get(declaration.index).values { IRTypeDeclarationPlanner.enumValueReferences(value.value, valueProviders, references); }
			for name in references {
				int provider = valueProviders.get(name);
				if (provider != declarationIndex) { dependencies.push(provider); }
			}
		}
		return dependencies;
	}

	class Vector<IRTypeDeclarationRef> stableOrder(IRModule module, Vector<IRTypeDeclarationRef> declarations, Vector<Vector<int>> dependencies) {
		Vector<IRTypeDeclarationRef> ordered = [];
		Vector<bool> completed = [];
		for (int index = 0; index < declarations.len; index++) { completed.push(false); }
		while (ordered.len < declarations.len) {
			bool progressed = false;
			for (int index = 0; index < declarations.len; index++) {
				if (completed.get(index)) { continue; }
				bool ready = true;
				for dependency in dependencies.get(index) {
					if (!completed.get(dependency)) { ready = false; }
				}
				if (!ready) { continue; }
				completed.set(index, true);
				ordered.push(declarations.get(index));
				progressed = true;
			}
			if (!progressed) {
				Vector<string> names = [];
				for (int index = 0; index < declarations.len; index++) {
					if (completed.get(index)) { continue; }
					string name = IRTypeDeclarationPlanner.declarationName(module, declarations.get(index));
					names.push(name.isEmpty() ? "<anonymous enum>" : name);
				}
				throw "cyclic typed C declaration dependency involving " + Strings.join(names, ", ");
			}
		}
		return ordered;
	}
}
