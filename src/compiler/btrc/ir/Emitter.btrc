import Library.Map;
import Library.Strings;
import Library.Vector;

import ./Model.btrc;
import ./RuntimeState.btrc;

/* Stage 6 — C emitter (minimal).
 *
 * Mirrors src/compiler/python/backend/c_emitter.py for the
 * supported IR subset. A simple recursive tree walk over IR nodes producing C
 * text byte-identical to the Python reference. NO lowering here — just
 * formatting. Output ends with a trailing newline (lines joined by "\n" + "\n").
 */

class CEmitter {
	private Vector<string> lines;
	private int indent;
	private string language;
	/* Several units share one program: functions and globals lose internal
	 * linkage, and a secondary unit only declares the globals and kernels. */
	private bool sharedLinkage = false;
	private bool declarationsOnly = false;
	private int unitIndex = -1;
	/* --debug: every content line inside a function body is preceded by a
	 * #line directive naming its .btrc origin, or the generated file itself
	 * once a marker-less stretch begins (the line number is patched in last). */
	private bool debug = false;
	private string debugCfile = "";
	private bool dbgEnabled = false;
	private bool dbgHasLocation = false;
	private string dbgFile = "";
	private int dbgLine = 0;
	private Map<string, string> lineFilenames;

	public CEmitter() {
		self.lines = [];
		self.indent = 0;
		self.language = "c";
		self.lineFilenames = {};
	}

	private string qualifyVolatileObjectType(string ctype, bool isVolatile) {
		if (!isVolatile) { return ctype; }
		int length = ctype.length();
		if (length > 0 && ctype.substring(length - 1, 1) == "*") {
			return ctype + " volatile";
		}
		return "volatile " + ctype;
	}

	private void requireObjectiveC() {
		if (self.language != "objective-c") { throw "Objective-C IR requires an Objective-C adapter unit"; }
	}

	private void requireCpp() {
		if (self.language != "c++") { throw "C++ IR requires a C++ adapter unit"; }
	}

	private void validateSelectorIdentifier(string identifier) {
		if (identifier.isEmpty()) { throw "Objective-C selector requires identifier components"; }
		int index = 0;
		while (index < identifier.length()) {
			int letter = identifier.charAt(index);
			bool alphabetic = (letter >= 65 && letter <= 90) || (letter >= 97 && letter <= 122) || letter == 95;
			if (!alphabetic && !(index > 0 && letter >= 48 && letter <= 57)) { throw "Objective-C selector requires identifier components"; }
			index = index + 1;
		}
	}

	public string emit(IRModule m) {
		self.lineFilenames = {};
		return self.emitUnit(m, -1, 0, m.functions.len);
	}

	/* The module as one primary unit followed by secondaries of about
	 * `targetLines` lines of function definitions each. Every unit carries the
	 * prologue, helpers, types and prototypes; the primary defines the globals
	 * and kernels and the secondaries declare them. Functions are split in
	 * module order, so the units concatenate to the single-unit text minus the
	 * duplicated preamble. Objective-C and C++ modules stay one unit. */
	public Vector<string> emitUnits(IRModule m, int targetLines, string unitsPrefix = "") {
		self.lineFilenames = {};
		Vector<string> units = [];
		if (m.language != "c" || m.objectiveCClasses.len > 0 || targetLines <= 0) { units.push(self.emit(m)); return units; }
		Vector<int> sizes = [];
		int total = 0;
		self.language = m.language;
		self.sharedLinkage = true;
		for fn in m.functions {
			self.lines = [];
			self.indent = 0;
			self.emitFunction(fn);
			sizes.push(self.lines.len);
			total = total + self.lines.len;
		}
		Vector<int> starts = self.unitStarts(m, sizes, total, targetLines);
		int unit = 0;
		while (unit < starts.len) {
			int first = starts.get(unit);
			int end = unit + 1 < starts.len ? starts.get(unit + 1) : sizes.len;
			units.push(self.emitUnit(m, unit, first, end, unitsPrefix));
			unit = unit + 1;
		}
		return units;
	}

	/* Units are runs of consecutive functions from the same source module
	 * packed to about targetLines each (at most 64 units), so editing one
	 * module changes that module's unit and leaves the others byte-identical
	 * for the native object cache. Synthesized functions join the preceding
	 * module's run. */
	private Vector<int> unitStarts(IRModule m, Vector<int> sizes, int total, int targetLines) {
		int target = targetLines;
		if (total / 64 + 1 > target) { target = total / 64 + 1; }
		Vector<int> starts = [0];
		string runFile = "";
		int runStart = 0;
		int unitLines = 0;
		int index = 0;
		while (index <= sizes.len) {
			string file = index < sizes.len ? m.functions.get(index).sourceFile : "";
			if (index == 0) { runFile = file; }
			bool runEnds = index == sizes.len || (!file.isEmpty() && file != runFile);
			if (runEnds) {
				int runLines = 0;
				int at = runStart;
				while (at < index) { runLines = runLines + sizes.get(at); at = at + 1; }
				if (unitLines > 0 && unitLines + runLines > target) { starts.push(runStart); unitLines = 0; }
				unitLines = unitLines + runLines;
				runStart = index;
				runFile = file;
			}
			index = index + 1;
		}
		return starts;
	}

	/* unitIndex -1 is the whole program as one unit; 0 the primary of a split
	 * program; higher indices are secondaries. [first, end) selects functions. */
	private string emitUnit(IRModule m, int unitIndex, int first, int end, string unitsPrefix = "") {
		if (m.language != "c" && m.language != "objective-c" && m.language != "c++") { throw "unsupported IR translation-unit language"; }
		self.language = m.language;
		self.lines = [];
		self.indent = 0;
		self.sharedLinkage = unitIndex >= 0;
		self.declarationsOnly = unitIndex > 0;
		self.unitIndex = unitIndex;
		self.debug = m.debug;
		self.debugCfile = m.debugCfile;
		if (unitIndex > 0 && (!unitsPrefix.isEmpty() || !m.debugCfile.isEmpty())) { self.debugCfile = (unitsPrefix.isEmpty() ? m.debugCfile : unitsPrefix) + ".unit-" + Strings.fromInt(unitIndex) + ".c"; }
		self.dbgEnabled = false;

		self.line("/* Generated by btrc */");
		if (unitIndex >= 0) {
			/* Every unit carries every helper the program selected; the ones
			 * this unit's functions do not reach are unused here by design. */
			self.line("#pragma GCC diagnostic ignored \"-Wunused-function\"");
		}

		/* Reserve the typed preprocessor slot (filled after body is known). */
		int preprocessorSlot = self.lines.len;
		Map<string, bool> nativeNames = {};
		for declaration in m.objectiveCClasses {
			self.requireObjectiveC();
			self.validateSelectorIdentifier(declaration.name);
			if (nativeNames.has(declaration.name)) { throw "Objective-C class declarations require distinct names"; }
			nativeNames.put(declaration.name, true);
			self.line("@class " + declaration.name + ";");
		}
		if (m.objectiveCClasses.len > 0) { self.line(""); }

		/* Runtime helpers (raw C source, blank line after each). */
		int h = 0;
		while (h < m.helpers.len) {
			/* A split program defines the helpers' file-scope state in the
			 * primary unit and declares it extern in the others. */
			if (self.sharedLinkage) { self.raw(RuntimeUnitState.forUnit(m.helpers.get(h), self.unitIndex == 0)); }
			else { self.raw(m.helpers.get(h)); }
			self.line("");
			h = h + 1;
		}

		/* Enum definitions (before forward decls, since functions and
         * function-pointer typedefs may reference an enum type by name).
         * Mirrors emitter.py's enum_defs loop. */
		int e = 0;
		while (e < m.enumDefs.len) {
			self.emitEnum(m.enumDefs.get(e));
			e = e + 1;
		}

		int i = 0;
		while (i < m.structForwards.len) {
			self.emitStructForward(m.structForwards.get(i));
			i = i + 1;
		}
		if (m.structForwards.len > 0) { self.line(""); }

		self.emitOrderedAliases(m);
		i = 0;
		while (i < m.taggedUnionDefs.len) {
			self.emitTaggedUnion(m.taggedUnionDefs.get(i));
			i = i + 1;
		}

		i = 0;
		while (i < m.functionDecls.len) {
			self.emitFunctionDecl(m.functionDecls.get(i));
			i = i + 1;
		}
		if (m.functionDecls.len > 0) { self.line(""); }
		if (self.sharedLinkage) {
			/* Functions defined in another unit need a prototype here; the
			 * module only declares some of them itself. */
			for fn in m.functions {
				string prefix = fn.cLinkage ? "extern \"C\" " : "";
				self.line(prefix + fn.returnType + " " + fn.name + "(" + self.paramList(fn.params) + ");");
			}
			if (m.functions.len > 0) { self.line(""); }
		}

		/* Struct definitions. */
		i = 0;
		while (i < m.structDefs.len) {
			self.emitStruct(m.structDefs.get(i));
			i = i + 1;
		}

		i = 0;
		while (i < m.globalDecls.len) {
			self.emitGlobal(m.globalDecls.get(i));
			i = i + 1;
		}
		if (m.globalDecls.len > 0) { self.line(""); }

		Map<string, bool> definedNativeNames = {};
		for declaration in m.objectiveCClasses {
			if (nativeNames.has(declaration.superclass) && !definedNativeNames.has(declaration.superclass)) { throw "Objective-C superclass must be declared before its subclass"; }
			self.emitObjectiveCInterface(declaration);
			definedNativeNames.put(declaration.name, true);
		}
		for declaration in m.objectiveCClasses { self.emitObjectiveCImplementation(declaration); }
		self.emitGpuKernels(m);

		/* Function definitions. */
		i = first;
		while (i < end) {
			self.emitFunction(m.functions.get(i));
			i = i + 1;
		}

		/* Build and splice in the ordered structured preprocessor prologue. */
		Vector<string> preprocessorLines = self.buildPreprocessorLines(m);
		self.spliceLines(preprocessorSlot, preprocessorLines);
		if (self.debug) { self.fixGeneratedLineResets(); }

		return self.joinLines();
	}

	private string objectiveCMethodSignature(IRObjectiveCMethod method) {
		if (method.body == null || method.body.kind != IRK_BLOCK || method.returnType.isEmpty() || method.params == null) { throw "Objective-C method requires a return type, parameters and IRBlock body"; }
		var pieces = Strings.split(method.selector, ":");
		int count = pieces.len;
		if (method.params.len > 0) {
			if (count != method.params.len + 1 || pieces.get(count - 1) != "") { throw "Objective-C selector does not match argument count"; }
			count--;
		} else if (count != 1) { throw "Objective-C selector does not match argument count"; }
		string signature = (method.isClassMethod ? "+" : "-") + " (" + method.returnType + ")";
		Map<string, bool> names = {};
		for (int index = 0; index < count; index++) {
			var piece = pieces.get(index);
			self.validateSelectorIdentifier(piece);
			if (method.params.len == 0) { signature = signature + piece; }
			else {
				var parameter = method.params.get(index);
				self.validateSelectorIdentifier(parameter.name);
				if (parameter.cType.isEmpty() || parameter.cType == "void") { throw "Objective-C method parameter requires a non-void type"; }
				if (names.has(parameter.name) || parameter.name == "self" || parameter.name == "_cmd") { throw "Objective-C method parameters require distinct non-reserved names"; }
				names.put(parameter.name, true);
				if (index > 0) { signature = signature + " "; }
				signature = signature + piece + ":(" + parameter.cType + ")" + parameter.name;
			}
		}
		return signature;
	}

	private void emitObjectiveCInterface(IRObjectiveCClass declaration) {
		self.requireObjectiveC();
		self.validateSelectorIdentifier(declaration.superclass);
		if (declaration.name == declaration.superclass) { throw "Objective-C class cannot inherit itself"; }
		if (declaration.protocols == null) { throw "Objective-C class requires a protocol list"; }
		Map<string, bool> protocolNames = {};
		for protocol in declaration.protocols {
			self.validateSelectorIdentifier(protocol);
			if (protocolNames.has(protocol)) { throw "Objective-C protocols require distinct names"; }
			protocolNames.put(protocol, true);
		}
		string protocols = declaration.protocols.len > 0 ? " <" + Strings.join(declaration.protocols, ", ") + ">" : "";
		self.line("@interface " + declaration.name + " : " + declaration.superclass + protocols + " {");
		self.line("@private");
		self.indent++;
		Map<string, bool> fields = {};
		for field in declaration.fields {
			self.validateSelectorIdentifier(field.name);
			if (field.cType.isEmpty() || field.cType == "void") { throw "Objective-C field requires a non-void type"; }
			if (fields.has(field.name) || field.name == "self" || field.name == "_cmd" || field.name == "isa") { throw "Objective-C fields require distinct non-reserved names"; }
			if (field.arraySize != null) { throw "Objective-C adapter array fields require a fixed native layout"; }
			fields.put(field.name, true);
			self.line(self.qualifyVolatileObjectType(field.cType, field.isVolatile || field.effectiveIsVolatile) + " " + field.name + ";");
		}
		self.indent--;
		self.line("}");
		Map<string, bool> selectors = {};
		for method in declaration.methods {
			string key = (method.isClassMethod ? "+" : "-") + method.selector;
			if (selectors.has(key)) { throw "Objective-C class contains a duplicate method"; }
			selectors.put(key, true);
			self.line(self.objectiveCMethodSignature(method) + ";");
		}
		self.line("@end");
		self.line("");
	}

	private void emitObjectiveCImplementation(IRObjectiveCClass declaration) {
		self.line("@implementation " + declaration.name);
		for method in declaration.methods {
			self.line(self.objectiveCMethodSignature(method) + " {");
			self.indent++;
			self.emitBlockContents(method.body);
			self.indent--;
			self.line("}");
		}
		self.line("@end");
		self.line("");
	}

	private string escapedGpuShader(string source) {
		string escaped = "";
		int index = 0;
		while (index < source.length()) {
			char value = source[index];
			if (value == '\\') { escaped = escaped + "\\\\"; }
			else if (value == '"') { escaped = escaped + "\\\""; }
			else if (value == '\n') { escaped = escaped + "\\n"; }
			else if (value == '\r') { escaped = escaped + "\\r"; }
			else if (value == '\t') { escaped = escaped + "\\t"; }
			else { escaped = escaped + source.substring(index, 1); }
			index++;
		}
		return escaped;
	}

	private void emitGpuKernels(IRModule module) {
		int index = 0;
		while (index < module.gpuKernels.len) {
			IRGpuKernel kernel = module.gpuKernels.get(index);
			if (self.declarationsOnly) { self.line("extern char* " + kernel.name + "_wgsl;"); }
			else if (self.sharedLinkage) { self.line("char* " + kernel.name + "_wgsl = \"" + self.escapedGpuShader(kernel.wgslSource) + "\";"); }
			else { self.line("static char* " + kernel.name + "_wgsl = \"" + self.escapedGpuShader(kernel.wgslSource) + "\";"); }
			self.line("");
			index++;
		}
	}

	private Vector<string> buildPreprocessorLines(IRModule m) {
		Vector<string> out = [];
		int i = 0;
		while (i < m.preprocessorDecls.len) {
			IRPreprocessorDecl declaration = m.preprocessorDecls.get(i);
			if (declaration.kind == IR_PREPROCESSOR_INCLUDE) {
				if (declaration.isSystem) {
					out.push("#include <" + declaration.header + ">");
				} else {
					out.push("#include \"" + declaration.header + "\"");
				}
			} else if (declaration.kind == IR_PREPROCESSOR_MACRO) {
				string parameters = "";
				if (declaration.functionLike) {
					parameters = "(";
					int parameter = 0;
					while (parameter < declaration.params.len) {
						if (parameter > 0) { parameters = parameters + ", "; }
						parameters = parameters + declaration.params.get(parameter);
						parameter = parameter + 1;
					}
					parameters = parameters + ")";
				}
				string replacement = "";
				if (declaration.replacement != "") {
					replacement = " " + declaration.replacement;
				}
				out.push("#define " + declaration.name + parameters + replacement);
			} else {
				print("internal compiler error: invalid preprocessor IR declaration");
				exit(1);
			}
			i = i + 1;
		}
		if (out.len > 0) { out.push(""); }
		return out;
	}

	/* Insert `ins` lines into self.lines at index `at`. */
	private void spliceLines(int at, Vector<string> ins) {
		Vector<string> rebuilt = [];
		int i = 0;
		while (i < at) { rebuilt.push(self.lines.get(i)); i = i + 1; }
		int j = 0;
		while (j < ins.len) { rebuilt.push(ins.get(j)); j = j + 1; }
		int k = at;
		while (k < self.lines.len) { rebuilt.push(self.lines.get(k)); k = k + 1; }
		self.lines = rebuilt;
	}

	private string joinLines() {
		if (self.lines.len == 0) { return ""; }
		return Strings.join(self.lines, "\n") + "\n";
	}

	private void emitEnum(IREnumDef definition) {
		if (definition.name == "") { self.line("enum {"); }
		else { self.line("typedef enum {"); }
		self.indent = self.indent + 1;
		int index = 0;
		while (index < definition.values.len) {
			IREnumValue value = definition.values.get(index);
			string suffix = "";
			if (value.value != null) {
				suffix = " = " + self.expr(value.value);
			}
			if (index < definition.values.len - 1) { suffix = suffix + ","; }
			self.line(value.name + suffix);
			index = index + 1;
		}
		self.indent = self.indent - 1;
		if (definition.name == "") { self.line("};"); }
		else { self.line("} " + definition.name + ";"); }
		self.line("");
	}

	private void emitStructForward(IRStructForward declaration) { self.line("typedef struct " + declaration.name + " " + declaration.name + ";"); }

	private bool aliasIdentifierChar(char value) { return (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z') || (value >= '0' && value <= '9') || value == '_'; }

	private bool aliasDependenciesReady(string typeText, string ownName, Map<string, bool> providers, Map<string, bool> emitted) {
		int length = typeText.length();
		int index = 0;
		while (index < length) {
			while (index < length && !self.aliasIdentifierChar(typeText[index])) {
				index = index + 1;
			}
			int start = index;
			while (index < length && self.aliasIdentifierChar(typeText[index])) {
				index = index + 1;
			}
			if (start < index) {
				string name = typeText.substring(start, index - start);
				if (name != ownName && providers.has(name) && !emitted.has(name)) {
					return false;
				}
			}
		}
		return true;
	}

	private bool functionPointerDependenciesReady(IRFunctionPointerTypedef declaration, Map<string, bool> providers, Map<string, bool> emitted) {
		if (!self.aliasDependenciesReady(declaration.returnType, declaration.name, providers, emitted)) {
			return false;
		}
		int index = 0;
		while (index < declaration.paramTypes.len) {
			if (!self.aliasDependenciesReady(declaration.paramTypes.get(index), declaration.name, providers, emitted)) {
				return false;
			}
			index = index + 1;
		}
		return true;
	}

	/* Function-pointer and ordinary typedef declarations form one dependency
     * graph.  Preserve the reference frontend's stable group order whenever
     * possible, while moving named aliases ahead of callbacks that use them. */
	private void emitOrderedAliases(IRModule module) {
		Map<string, bool> providers = {};
		int index = 0;
		while (index < module.functionPointerTypedefs.len) {
			providers.put(module.functionPointerTypedefs.get(index).name, true);
			index = index + 1;
		}
		index = 0;
		while (index < module.typedefDefs.len) {
			providers.put(module.typedefDefs.get(index).name, true);
			index = index + 1;
		}

		Map<string, bool> emitted = {};
		int remaining = module.functionPointerTypedefs.len + module.typedefDefs.len;
		while (remaining > 0) {
			bool progressed = false;
			index = 0;
			while (index < module.functionPointerTypedefs.len) {
				IRFunctionPointerTypedef declaration = module.functionPointerTypedefs.get(index);
				if (!emitted.has(declaration.name) && self.functionPointerDependenciesReady(declaration, providers, emitted)) {
					self.emitFunctionPointerTypedef(declaration);
					self.line("");
					emitted.put(declaration.name, true);
					remaining = remaining - 1;
					progressed = true;
				}
				index = index + 1;
			}
			index = 0;
			while (index < module.typedefDefs.len) {
				IRTypedefDef declaration = module.typedefDefs.get(index);
				if (!emitted.has(declaration.name) && self.aliasDependenciesReady(declaration.targetType, declaration.name, providers, emitted)) {
					self.emitTypedef(declaration);
					emitted.put(declaration.name, true);
					remaining = remaining - 1;
					progressed = true;
				}
				index = index + 1;
			}
			if (!progressed) {
				fprintf(stderr, "error: cyclic typed C alias dependency\n");
				exit(1);
			}
		}
	}

	private void emitFunctionPointerTypedef(IRFunctionPointerTypedef declaration) {
		string parameters = "void";
		if (declaration.paramTypes.len > 0) {
			parameters = "";
			int index = 0;
			while (index < declaration.paramTypes.len) {
				if (index > 0) { parameters = parameters + ", "; }
				parameters = parameters + declaration.paramTypes.get(index);
				index = index + 1;
			}
		}
		self.line("typedef " + declaration.returnType + " (*" + declaration.name + ")(" + parameters + ");");
	}

	private void emitFunctionDecl(IRFunctionDecl declaration) {
		string storage = "";
		if (declaration.isStatic && !self.sharedLinkage) { storage = "static "; }
		if (declaration.cLinkage) { self.requireCpp(); if (declaration.isStatic) { throw "C language linkage requires a nonstatic C++ adapter function"; } storage = "extern \"C\" "; }
		self.line(storage + declaration.returnType + " " + declaration.name + "(" + self.paramList(declaration.params) + ");");
	}

	/* --- struct emission (matches emitter.py _emit_struct) --- */

	private string structFieldDeclaration(IRStructField field) {
		string suffix = "";
		if (field.arraySize != null) {
			suffix = "[" + self.expr(field.arraySize) + "]";
		}
		string ctype = self.qualifyVolatileObjectType(field.cType, field.isVolatile);
		return ctype + " " + field.name + suffix + ";";
	}

	private void emitStruct(IRStructDef s) {
		if (s.packAlignment > 0) {
			self.line("#pragma pack(push, " + Strings.fromInt(s.packAlignment) + ")");
		}
		self.line(f"struct {s.name} {{");
		self.indent = self.indent + 1;
		int i = 0;
		while (i < s.fields.len) {
			IRStructField f = s.fields.get(i);
			self.line(self.structFieldDeclaration(f));
			i = i + 1;
		}
		self.indent = self.indent - 1;
		self.line("};");
		if (s.packAlignment > 0) { self.line("#pragma pack(pop)"); }
		self.line("");
	}

	private void emitTypedef(IRTypedefDef d) {
		string targetType = self.qualifyVolatileObjectType(d.targetType, d.isVolatile);
		self.line(f"typedef {targetType} {d.name};");
		self.line("");
	}

	private void emitTaggedUnion(IRTaggedUnionDef d) {
		int i = 0;
		while (i < d.variants.len) {
			IRTaggedUnionVariant variant = d.variants.get(i);
			if (variant.fields.len > 0) {
				string dataName = d.name + "_" + variant.name + "_Data";
				self.line(f"typedef struct {dataName} {{");
				self.indent = self.indent + 1;
				int f = 0;
				while (f < variant.fields.len) {
					IRStructField field = variant.fields.get(f);
					self.line(self.structFieldDeclaration(field));
					f = f + 1;
				}
				self.indent = self.indent - 1;
				self.line(f"}} {dataName};");
				self.line("");
			}
			i = i + 1;
		}
		self.line(f"struct {d.name} {{");
		self.indent = self.indent + 1;
		self.line(f"{d.tagType} tag;");
		bool hasPayload = false;
		i = 0;
		while (i < d.variants.len) {
			if (d.variants.get(i).fields.len > 0) { hasPayload = true; }
			i = i + 1;
		}
		if (hasPayload) {
			self.line("union {");
			self.indent = self.indent + 1;
			i = 0;
			while (i < d.variants.len) {
				IRTaggedUnionVariant variant = d.variants.get(i);
				if (variant.fields.len > 0) {
					string dataName = d.name + "_" + variant.name + "_Data";
					self.line(f"{dataName} {variant.name};");
				}
				i = i + 1;
			}
			self.indent = self.indent - 1;
			self.line("} data;");
		}
		self.indent = self.indent - 1;
		self.line("};");
		self.line("");
	}

	private void emitGlobal(IRGlobalDecl d) {
		string storage = "";
		if (self.declarationsOnly || d.isExtern) { storage = "extern "; }
		else if (d.isStatic && !self.sharedLinkage) { storage = "static "; }
		string ctype = self.qualifyVolatileObjectType(d.cType, d.isVolatile);
		string suffix = "";
		if (d.arraySize != null) { suffix = "[" + self.expr(d.arraySize) + "]"; }
		else if (d.isUnsizedArray) { suffix = "[]"; }
		string initializer = "";
		if (d.init != null && !self.declarationsOnly) { initializer = " = " + self.expr(d.init); }
		self.line(storage + ctype + " " + d.name + suffix + initializer + ";");
	}

	/* --- function emission --- */

	private void emitFunction(IRFunction fn) {
		string prefix = "";
		if (fn.isStatic && !self.sharedLinkage) { prefix = "static "; }
		if (fn.cLinkage) { self.requireCpp(); if (fn.isStatic) { throw "C language linkage requires a nonstatic C++ adapter function"; } prefix = "extern \"C\" "; }
		self.line(prefix + fn.returnType + " " + fn.name + "(" + self.paramList(fn.params) + ") {");
		if (fn.body != null) {
			self.indent = self.indent + 1;
			/* A #line left active by the previous function must not leak into
			 * this one: start every body mapped to the generated file until its
			 * first marker. */
			if (self.debug) { self.dbgEnabled = true; self.dbgHasLocation = false; }
			self.emitBlockContents(fn.body);
			self.dbgEnabled = false;
			self.indent = self.indent - 1;
		}
		self.line("}");
		self.line("");
	}

	/* One C string-literal payload for a #line directive. */
	private string cLineFilename(string path) {
		/* Every content line repeats a path; retain its encoded value only for
		 * this emission, shared by the count pass and all translation units. */
		if (self.lineFilenames.has(path)) { return self.lineFilenames.get(path); }
		string escaped = "";
		int index = 0;
		while (index < path.length()) {
			char value = path[index];
			int code = (int)value;
			if (code < 0) { code = code + 256; }
			if (value == '\\' || value == '"' || value == '?') { escaped = escaped + "\\" + path.substring(index, 1); }
			else if (code < 32 || code == 127) { escaped = escaped + "\\" + Strings.fromInt(code / 64) + Strings.fromInt((code / 8) % 8) + Strings.fromInt(code % 8); }
			else { escaped = escaped + path.substring(index, 1); }
			index++;
		}
		self.lineFilenames.put(path, escaped);
		return escaped;
	}

	private void emitLineDirective() {
		if (self.dbgHasLocation) { self.lines.push("#line " + Strings.fromInt(self.dbgLine) + " \"" + self.cLineFilename(self.dbgFile) + "\""); return; }
		string cfile = self.debugCfile.isEmpty() ? "<btrc-generated>" : self.debugCfile;
		self.lines.push("#line @@BTRC_CLINE@@ \"" + self.cLineFilename(cfile) + "\"");
	}

	/* Generated-file resets name the line after themselves once the layout is final. */
	private void fixGeneratedLineResets() {
		int index = 0;
		while (index < self.lines.len) {
			string current = self.lines.get(index);
			if (current.contains("@@BTRC_CLINE@@")) { self.lines.set(index, Strings.replace(current, "@@BTRC_CLINE@@", Strings.fromInt(index + 2))); }
			index = index + 1;
		}
	}

	private string paramList(Vector<IRParam> declarations) {
		string params = "";
		if (declarations.len == 0) {
			params = "void";
		} else {
			int i = 0;
			while (i < declarations.len) {
				IRParam p = declarations.get(i);
				if (i > 0) { params = params + ", "; }
				string paramType = self.qualifyVolatileObjectType(p.cType, p.isVolatile);
				params = params + paramType + " " + p.name;
				i = i + 1;
			}
		}
		return params;
	}

	private void emitBlockContents(IRNode block) {
		int i = 0;
		while (i < block.stmts.len) {
			self.emitStmt(block.stmts.get(i));
			i = i + 1;
		}
	}

	/* --- statement emission --- */

	private void emitStmt(IRNode s) {
		if (s.kind == IRK_LINE_MARKER) { self.dbgHasLocation = true; self.dbgFile = s.sourceFile; self.dbgLine = s.sourceLine; return; }
		if (s.kind == IRK_CXX_DELETE) { self.requireCpp(); self.line("delete " + self.expr(s.value) + ";"); return; }
		if (s.kind == IRK_CXX_EXCEPTION_BOUNDARY) {
			self.requireCpp();
			if (s.body == null || s.elseBlock == null || s.body.kind != IRK_BLOCK || s.elseBlock.kind != IRK_BLOCK || (s.thenBlock != null && s.thenBlock.kind != IRK_BLOCK)) { throw "C++ exception boundary requires structured body and failure blocks"; }
			self.line("try {"); self.indent++; self.emitBlockContents(s.body); self.indent--;
			if (s.thenBlock != null) { self.line("} catch (const std::bad_alloc&) {"); self.indent++; self.emitBlockContents(s.thenBlock); self.indent--; }
			self.line("} catch (...) {"); self.indent++; self.emitBlockContents(s.elseBlock); self.indent--; self.line("}"); return;
		}
		if (s.kind == IRK_OBJECTIVE_C_AUTORELEASE_POOL || s.kind == IRK_OBJECTIVE_C_EXCEPTION_BOUNDARY) {
			self.requireObjectiveC();
			if (s.body == null || s.body.kind != IRK_BLOCK) { throw "Objective-C scope requires an IRBlock"; }
			if (s.kind == IRK_OBJECTIVE_C_AUTORELEASE_POOL) { self.line("@autoreleasepool {"); }
			else { self.line("@try {"); }
			self.indent = self.indent + 1;
			self.emitBlockContents(s.body);
			self.indent = self.indent - 1;
			if (s.kind == IRK_OBJECTIVE_C_EXCEPTION_BOUNDARY) {
				if (s.elseBlock == null || s.elseBlock.kind != IRK_BLOCK) { throw "Objective-C exception boundary requires an IRBlock failure path"; }
				self.line("} @catch (...) {");
				self.indent = self.indent + 1;
				self.emitBlockContents(s.elseBlock);
				self.indent = self.indent - 1;
			}
			self.line("}");
			return;
		}
		if (s.kind == IRK_VAR_DECL) {
			string ctype = self.qualifiedDeclType(s);
			string declarator = self.localDeclarator(s);
			if (s.init != null) {
				self.line(f"{ctype} {declarator} = {self.expr(s.init)};");
			} else {
				self.line(f"{ctype} {declarator};");
			}
			return;
		}
		if (s.kind == IRK_ASSIGN) {
			self.line(f"{self.expr(s.target)} = {self.expr(s.value)};");
			return;
		}
		if (s.kind == IRK_RETURN) {
			if (s.value != null) {
				self.line(f"return {self.expr(s.value)};");
			} else {
				self.line("return;");
			}
			return;
		}
		if (s.kind == IRK_EXPR_STMT) {
			self.line(f"{self.discardedExpr(s.expr)};");
			return;
		}
		if (s.kind == IRK_BLOCK) {
			self.line("{");
			self.indent = self.indent + 1;
			self.emitBlockContents(s);
			self.indent = self.indent - 1;
			self.line("}");
			return;
		}
		if (s.kind == IRK_IF) {
			self.line(f"if ({self.condExpr(s.condition)}) {{");
			if (s.thenBlock != null) {
				self.indent = self.indent + 1;
				self.emitBlockContents(s.thenBlock);
				self.indent = self.indent - 1;
			}
			self.emitElseTail(s);
			return;
		}
		if (s.kind == IRK_WHILE) {
			self.line(f"while ({self.condExpr(s.condition)}) {{");
			if (s.body != null) {
				self.indent = self.indent + 1;
				self.emitBlockContents(s.body);
				self.indent = self.indent - 1;
			}
			self.line("}");
			return;
		}
		if (s.kind == IRK_DO_WHILE) {
			string conditionText = self.condExpr(s.condition);
			self.line("do {");
			if (s.body != null) {
				self.indent = self.indent + 1;
				self.emitBlockContents(s.body);
				self.indent = self.indent - 1;
			}
			self.line(f"}} while ({conditionText});");
			return;
		}
		if (s.kind == IRK_FOR) {
			string initText = self.forInitText(s.init);
			string condText = "";
			if (s.condition != null) { condText = self.expr(s.condition); }
			string updateText = "";
			if (s.update != null) {
				if (s.update.kind == IRK_ASSIGN) {
					updateText = f"{self.expr(s.update.target)} = {self.expr(s.update.value)}";
				} else {
					updateText = self.expr(s.update);
				}
			}
			self.line(f"for ({initText}; {condText}; {updateText}) {{");
			if (s.body != null) {
				self.indent = self.indent + 1;
				self.emitBlockContents(s.body);
				self.indent = self.indent - 1;
			}
			self.line("}");
			return;
		}
		if (s.kind == IRK_BREAK) { self.line("break;"); return; }
		if (s.kind == IRK_CONTINUE) { self.line("continue;"); return; }
		if (s.kind == IRK_SWITCH) {
			/* switch (val) { case V: <body> default: <body> } — mirrors the
             * IRSwitch branch of emitter._emit_stmt. */
			self.line(f"switch ({self.expr(s.value)}) {{");
			self.indent = self.indent + 1;
			int ci = 0;
			while (ci < s.args.len) {
				IRNode c = s.args.get(ci);
				if (c.value != null) {
					self.line(f"case {self.expr(c.value)}:");
				} else {
					self.line("default:");
				}
				self.line("{");
				self.indent = self.indent + 1;
				int j = 0;
				while (j < c.stmts.len) { self.emitStmt(c.stmts.get(j)); j = j + 1; }
				self.indent = self.indent - 1;
				self.line("}");
				if (c.fallsThrough && ci + 1 < s.args.len) {
					self.line("/* fall through */");
				}
				ci = ci + 1;
			}
			self.indent = self.indent - 1;
			self.line("}");
			return;
		}
		print(f"internal compiler error: unsupported IR statement {s.kind}");
		exit(1);
	}

	private string forInitText(IRNode init) {
		if (init == null) { return ""; }
		if (init.kind == IRK_VAR_DECL) {
			string ctype = self.qualifiedDeclType(init);
			string declarator = self.localDeclarator(init);
			if (init.init != null) {
				return f"{ctype} {declarator} = {self.expr(init.init)}";
			}
			return f"{ctype} {declarator}";
		}
		if (init.kind == IRK_ASSIGN) {
			return f"{self.expr(init.target)} = {self.expr(init.value)}";
		}
		if (init.kind == IRK_EXPR_STMT) {
			return self.discardedExpr(init.expr);
		}
		print(f"internal compiler error: unsupported for initializer {init.kind}");
		exit(1);
		return "";
	}

	private string qualifiedDeclType(IRNode declaration) {
		string storage = "";
		if (declaration.isStatic) { storage = "static "; }
		else if (declaration.isExtern) { storage = "extern "; }
		string ctype = self.qualifyVolatileObjectType(declaration.cType, declaration.isVolatile);
		return storage + ctype;
	}

	private string localDeclarator(IRNode declaration) {
		if (!declaration.isArrayDecl) { return declaration.name; }
		string size = "";
		if (declaration.arraySize != null) {
			size = self.expr(declaration.arraySize);
		}
		return declaration.name + "[" + size + "]";
	}

	/* Emit the else / else-if tail of an IRIf, recursing for chains. */
	private void emitElseTail(IRNode s) {
		if (s.elseBlock == null || s.elseBlock.stmts.len == 0) {
			self.line("}");
			return;
		}
		self.line("} else {");
		self.indent = self.indent + 1;
		self.emitBlockContents(s.elseBlock);
		self.indent = self.indent - 1;
		self.line("}");
	}

	/* --- expression emission (matches backend/c_emitter.py exactly) --- */

	private string compound(string opening, Vector<string> values, string closing, string inlineSeparator, string lineSeparator) {
		string inlineText = opening;
		int index = 0;
		while (index < values.len) {
			if (index > 0) {
				inlineText = inlineText + inlineSeparator;
			}
			inlineText = inlineText + values.get(index);
			index = index + 1;
		}
		inlineText = inlineText + closing;
		if (inlineText.length() <= 1000 && !self.stringHasLineBreak(inlineText)) {
			return inlineText;
		}
		string multiline = opening + "\n";
		index = 0;
		while (index < values.len) {
			if (index > 0) {
				multiline = multiline + lineSeparator;
			}
			multiline = multiline + values.get(index);
			index = index + 1;
		}
		return multiline + "\n" + closing;
	}

	private string delimited(string opening, Vector<string> values, string closing) { return self.compound(opening, values, closing, ", ", ",\n"); }

	private string condExpr(IRNode e) {
		string result = self.expr(e);
		int n = result.length();
		if (n >= 2 && result.substring(0, 1) == "(" && result.substring(n - 1, 1) == ")") {
			int depth = 0;
			bool stripsOuter = true;
			bool inSingle = false;
			bool inDouble = false;
			bool escaped = false;
			int i = 0;
			while (i < n) {
				char ch = result[i];
				if (escaped) { escaped = false; }
				else if ((inSingle || inDouble) && ch == '\\') { escaped = true; }
				else if (!inDouble && ch == '\'') { inSingle = !inSingle; }
				else if (!inSingle && ch == '"') { inDouble = !inDouble; }
				else if (!inSingle && !inDouble) {
					if (ch == '(') { depth = depth + 1; }
					else if (ch == ')') { depth = depth - 1; }
					if (depth == 0 && i < n - 1) {
						stripsOuter = false;
						i = n;
					}
				}
				if (i < n) { i = i + 1; }
			}
			if (stripsOuter) {
				result = result.substring(1, n - 2);
			}
		}
		return result;
	}

	private string discardedExpr(IRNode e) {
		Vector<string> values = [self.expr(e)];
		return self.compound("(void)(", values, ")", "", "\n");
	}

	private string expr(IRNode e) {
		if (e == null) {
			print("internal compiler error: null IR expression");
			exit(1);
			return "";
		}
		if (e.kind == IRK_LITERAL) { return e.text; }
		if (e.kind == IRK_VAR || e.kind == IRK_FUNCTION_REF) {
			return e.name;
		}
		if (e.kind == IRK_BINOP) {
			Vector<string> values = [
				self.expr(e.left), e.op, self.expr(e.right)
			];
			return self.compound("(", values, ")", " ", "\n");
		}
		if (e.kind == IRK_COMMA_EXPR) {
			Vector<string> values = [];
			int i = 0;
			while (i < e.args.len) {
				values.push(self.expr(e.args.get(i)));
				i = i + 1;
			}
			return self.delimited("(", values, ")");
		}
		if (e.kind == IRK_UNARYOP) {
			Vector<string> values = [self.expr(e.operand)];
			if (e.prefix) {
				return self.compound("(" + e.op, values, ")", "", "\n");
			}
			return self.compound("(", values, e.op + ")", "", "\n");
		}
		if (e.kind == IRK_CALL) {
			Vector<string> args = [];
			int i = 0;
			while (i < e.args.len) {
				args.push(self.expr(e.args.get(i)));
				i = i + 1;
			}
			string callee = e.callee;
			if (e.expr != null) { callee = self.expr(e.expr); }
			Vector<string> call = [callee, self.delimited("(", args, ")")];
			return self.compound("", call, "", "", "\n");
		}
		if (e.kind == IRK_OBJECTIVE_C_SELECTOR) {
			self.requireObjectiveC();
			Vector<string> pieces = Strings.split(e.name, ":");
			int count = pieces.len;
			if (count > 1) {
				if (pieces.get(count - 1) != "") { throw "Objective-C selector does not match argument count"; }
				count--;
			}
			for index in range(count) { self.validateSelectorIdentifier(pieces.get(index)); }
			return "@selector(" + e.name + ")";
		}
		if (e.kind == IRK_CXX_NEW) {
			self.requireCpp();
			string arguments = "";
			for index in range(e.args.len) { if (index > 0) { arguments += ", "; } arguments += self.expr(e.args.get(index)); }
			return "new " + e.targetType + "(" + arguments + ")";
		}
		if (e.kind == IRK_OBJECTIVE_C_MESSAGE) {
			self.requireObjectiveC();
			if (e.obj == null) { throw "Objective-C message requires a receiver"; }
			Vector<string> pieces = Strings.split(e.name, ":");
			int count = pieces.len;
			if (e.args.len > 0) {
				if (count != e.args.len + 1 || pieces.get(count - 1) != "") { throw "Objective-C selector does not match argument count"; }
				count = count - 1;
			} else if (count != 1) { throw "Objective-C selector does not match argument count"; }
			Vector<string> parts = [self.expr(e.obj)];
			int index = 0;
			while (index < count) {
				string piece = pieces.get(index);
				self.validateSelectorIdentifier(piece);
				if (e.args.len > 0) { parts.push(piece + ":" + self.expr(e.args.get(index))); }
				else { parts.push(piece); }
				index = index + 1;
			}
			return self.compound("[", parts, "]", " ", "\n");
		}
		if (e.kind == IRK_OBJECTIVE_C_BLOCK) {
			self.requireObjectiveC();
			if (e.body == null || e.body.kind != IRK_BLOCK || e.targetType.isEmpty() || e.params == null) { throw "Objective-C block requires a return type, parameters and IRBlock body"; }
			Map<string, bool> names = {};
			for (int index = 0; index < e.params.len; index++) {
				var param = e.params.get(index);
				self.validateSelectorIdentifier(param.name);
				if (param.cType.isEmpty() || param.cType == "void") { throw "Objective-C block parameter requires a non-void type"; }
				if (names.has(param.name)) { throw "Objective-C block parameters require distinct names"; }
				names.put(param.name, true);
			}
			var body = CEmitter();
			body.language = self.language;
			body.indent = 1;
			body.emitBlockContents(e.body);
			return "^" + e.targetType + "(" + self.paramList(e.params) + ") {\n" + Strings.join(body.lines, "\n") + "\n}";
		}
		if (e.kind == IRK_FIELD_ACCESS) {
			string op = ".";
			if (e.arrow) { op = "->"; }
			Vector<string> values = [self.expr(e.obj), op + e.field];
			return self.compound("", values, "", "", "\n");
		}
		if (e.kind == IRK_CAST) {
			string bridge = "";
			if (e.bridge != "") {
				self.requireObjectiveC();
				if (e.bridge == "borrow") { bridge = "__bridge "; }
				else if (e.bridge == "retain") { bridge = "__bridge_retained "; }
				else if (e.bridge == "transfer") { bridge = "__bridge_transfer "; }
				else { throw "unsupported Objective-C bridge ownership"; }
			}
			Vector<string> values = [self.expr(e.expr)];
			return self.compound("((" + bridge + e.targetType + ")", values, ")", "", "\n");
		}
		if (e.kind == IRK_TERNARY) {
			Vector<string> values = [
				self.expr(e.condition), "?", self.expr(e.trueExpr),
				":", self.expr(e.falseExpr)
			];
			return self.compound("(", values, ")", " ", "\n");
		}
		if (e.kind == IRK_SIZEOF) {
			if (e.operand != null) {
				Vector<string> operand = [self.expr(e.operand)];
				return self.compound("sizeof(", operand, ")", "", "\n");
			}
			if (e.targetType == "") {
				print("internal compiler error: IRSizeof has no operand");
				exit(1);
			}
			Vector<string> values = [e.targetType];
			return self.compound("sizeof(", values, ")", "", "\n");
		}
		if (e.kind == IRK_INITIALIZER_LIST) {
			Vector<string> values = [];
			if (e.args.len == 0) { values.push("0"); }
			int i = 0;
			while (i < e.args.len) {
				values.push(self.expr(e.args.get(i)));
				i = i + 1;
			}
			return self.delimited("{", values, "}");
		}
		if (e.kind == IRK_COMPOUND_LITERAL) {
			if (e.targetType == "" || e.fieldNames.len != e.args.len) {
				print("internal compiler error: malformed IRCompoundLiteral");
				exit(1);
			}
			Vector<string> fields = [];
			if (e.args.len == 0) { fields.push("0"); }
			int i = 0;
			while (i < e.args.len) {
				Vector<string> value = [self.expr(e.args.get(i))];
				fields.push(self.compound("." + e.fieldNames.get(i) + " = ", value, "", "", "\n"));
				i = i + 1;
			}
			Vector<string> literal = [self.delimited("{", fields, "}")];
			return self.compound("(" + e.targetType + ")", literal, "", "", "\n");
		}
		if (e.kind == IRK_INDEX) {
			Vector<string> indexValue = [self.expr(e.index)];
			string index = self.compound("[", indexValue, "]", "", "\n");
			Vector<string> values = [self.expr(e.obj), index];
			return self.compound("", values, "", "", "\n");
		}
		if (e.kind == IRK_ADDRESS_OF) {
			Vector<string> values = [self.expr(e.expr)];
			return self.compound("(&", values, ")", "", "\n");
		}
		if (e.kind == IRK_DEREF) {
			Vector<string> values = [self.expr(e.expr)];
			return self.compound("(*", values, ")", "", "\n");
		}
		if (e.kind == IRK_STMT_EXPR) {
			/* Only uninitialized declarations may be hoisted. Runtime work must
             * stay in the result comma expression so branches and loop
             * conditions preserve their source evaluation semantics. */
			int i = 0;
			while (i < e.stmts.len) {
				IRNode declaration = e.stmts.get(i);
				bool safeInitializer = declaration.init == null;
				if (declaration.init != null && declaration.init.kind == IRK_LITERAL && (declaration.init.text == "0" || declaration.init.text == "NULL" || declaration.init.text == "false")) {
					safeInitializer = true;
				}
				if (declaration.kind != IRK_VAR_DECL || !safeInitializer) {
					print("internal compiler error: unsafe IRStmtExpr setup");
					exit(1);
				}
				self.emitStmt(declaration);
				i = i + 1;
			}
			return self.expr(e.result);
		}
		if (e.kind == IRK_INVALID_EXPR) {
			fprintf(stderr, "error: %s\n", e.text);
			exit(1);
		}
		print(f"internal compiler error: unsupported IR expression {e.kind}");
		exit(1);
		return "";
	}

	/* --- output helpers (matches emitter.py _line) --- */

	private void line(string text) {
		Vector<string> parts = self.splitLines(text);
		int index = 0;
		while (index < parts.len) {
			string part = parts.get(index);
			if (self.stripped(part) != "") {
				if (self.dbgEnabled) { self.emitLineDirective(); }
				self.lines.push(self.indentation(self.indent) + part);
			} else {
				self.lines.push("");
			}
			index = index + 1;
		}
	}

	/* Emit raw text without indentation (mirrors emitter.py _raw): strip
     * trailing newlines, then push each \n-separated line verbatim. */
	private void raw(string text) {
		string t = self.withoutTrailingNewlines(text);
		Vector<string> parts = self.splitLines(t);
		int i = 0;
		while (i < parts.len) { self.lines.push(parts.get(i)); i = i + 1; }
	}

	private string withoutTrailingNewlines(string s) {
		int end = s.length();
		while (end > 0 && s[end - 1] == '\n') { end = end - 1; }
		return s.substring(0, end);
	}

	private bool stringHasLineBreak(string value) {
		int index = 0;
		while (index < value.length()) {
			if (value[index] == '\n' || value[index] == '\r') { return true; }
			index = index + 1;
		}
		return false;
	}

	/* Split a string on '\n' into its lines (no trailing empty element unless
     * the original ended with a separator, matching Python str.split("\n")). */
	private Vector<string> splitLines(string s) {
		Vector<string> out = [];
		int n = s.length();
		int start = 0;
		int i = 0;
		while (i < n) {
			if (s[i] == '\n') {
				out.push(s.substring(start, i - start));
				start = i + 1;
			}
			i = i + 1;
		}
		out.push(s.substring(start, n - start));
		return out;
	}

	private string indentation(int n) {
		string s = "";
		int i = 0;
		while (i < n) { s = s + "    "; i = i + 1; }
		return s;
	}

	/* Whitespace-stripped copy, used to detect blank lines. */
	private string stripped(string s) {
		int n = s.length();
		int start = 0;
		while (start < n && self.whitespace(s[start])) { start = start + 1; }
		int end = n;
		while (end > start && self.whitespace(s[end - 1])) { end = end - 1; }
		return s.substring(start, end - start);
	}

	private bool whitespace(char c) { return c == ' ' || c == '\t' || c == '\n' || c == '\r'; }
}
