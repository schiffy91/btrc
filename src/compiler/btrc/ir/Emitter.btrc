import std.Map;
import std.Strings;
import std.Vector;

import ./Model.btrc;

/* Stage 6 — C emitter (minimal).
 *
 * Mirrors src/compiler/python/backend/c_emitter.py for the
 * supported IR subset. A simple recursive tree walk over IR nodes producing C
 * text byte-identical to the Python reference. NO lowering here — just
 * formatting. Output ends with a trailing newline (lines joined by "\n" + "\n").
 */

class CEmitter {
	private Vector<string> lines;
	private int indent;

	public CEmitter() {
		self.lines = [];
		self.indent = 0;
	}

	private string qualifyVolatileObjectType(string ctype, bool isVolatile) {
		if (!isVolatile) { return ctype; }
		int length = ctype.length();
		if (length > 0 && ctype.substring(length - 1, 1) == "*") {
			return ctype + " volatile";
		}
		return "volatile " + ctype;
	}

	public string emit(IRModule m) {
		self.lines = [];
		self.indent = 0;

		self.line("/* Generated by btrc */");

		/* Reserve the typed preprocessor slot (filled after body is known). */
		int preprocessorSlot = self.lines.len;

		/* Runtime helpers (raw C source, blank line after each). */
		int h = 0;
		while (h < m.helpers.len) {
			self.raw(m.helpers.get(h));
			self.line("");
			h = h + 1;
		}

		/* Enum definitions (before forward decls, since functions and
         * function-pointer typedefs may reference an enum type by name).
         * Mirrors emitter.py's enum_defs loop. */
		int e = 0;
		while (e < m.enumDefs.len) {
			self.emitEnum(m.enumDefs.get(e));
			e = e + 1;
		}

		int i = 0;
		while (i < m.structForwards.len) {
			self.emitStructForward(m.structForwards.get(i));
			i = i + 1;
		}
		if (m.structForwards.len > 0) { self.line(""); }

		self.emitOrderedAliases(m);
		i = 0;
		while (i < m.taggedUnionDefs.len) {
			self.emitTaggedUnion(m.taggedUnionDefs.get(i));
			i = i + 1;
		}

		i = 0;
		while (i < m.functionDecls.len) {
			self.emitFunctionDecl(m.functionDecls.get(i));
			i = i + 1;
		}
		if (m.functionDecls.len > 0) { self.line(""); }

		/* Struct definitions. */
		i = 0;
		while (i < m.structDefs.len) {
			self.emitStruct(m.structDefs.get(i));
			i = i + 1;
		}

		i = 0;
		while (i < m.globalDecls.len) {
			self.emitGlobal(m.globalDecls.get(i));
			i = i + 1;
		}
		if (m.globalDecls.len > 0) { self.line(""); }

		self.emitGpuKernels(m);

		/* Function definitions. */
		i = 0;
		while (i < m.functions.len) {
			self.emitFunction(m.functions.get(i));
			i = i + 1;
		}

		/* Build and splice in the ordered structured preprocessor prologue. */
		Vector<string> preprocessorLines = self.buildPreprocessorLines(m);
		self.spliceLines(preprocessorSlot, preprocessorLines);

		return self.joinLines();
	}

	private string escapedGpuShader(string source) {
		string escaped = "";
		int index = 0;
		while (index < source.length()) {
			char value = source[index];
			if (value == '\\') { escaped = escaped + "\\\\"; }
			else if (value == '"') { escaped = escaped + "\\\""; }
			else if (value == '\n') { escaped = escaped + "\\n"; }
			else if (value == '\r') { escaped = escaped + "\\r"; }
			else if (value == '\t') { escaped = escaped + "\\t"; }
			else { escaped = escaped + source.substring(index, 1); }
			index++;
		}
		return escaped;
	}

	private void emitGpuKernels(IRModule module) {
		int index = 0;
		while (index < module.gpuKernels.len) {
			IRGpuKernel kernel = module.gpuKernels.get(index);
			self.line("static char* " + kernel.name + "_wgsl = \"" + self.escapedGpuShader(kernel.wgslSource) + "\";");
			self.line("");
			index++;
		}
	}

	private Vector<string> buildPreprocessorLines(IRModule m) {
		Vector<string> out = [];
		int i = 0;
		while (i < m.preprocessorDecls.len) {
			IRPreprocessorDecl declaration = m.preprocessorDecls.get(i);
			if (declaration.kind == IR_PREPROCESSOR_INCLUDE) {
				if (declaration.isSystem) {
					out.push("#include <" + declaration.header + ">");
				} else {
					out.push("#include \"" + declaration.header + "\"");
				}
			} else if (declaration.kind == IR_PREPROCESSOR_MACRO) {
				string parameters = "";
				if (declaration.functionLike) {
					parameters = "(";
					int parameter = 0;
					while (parameter < declaration.params.len) {
						if (parameter > 0) { parameters = parameters + ", "; }
						parameters = parameters + declaration.params.get(parameter);
						parameter = parameter + 1;
					}
					parameters = parameters + ")";
				}
				string replacement = "";
				if (declaration.replacement != "") {
					replacement = " " + declaration.replacement;
				}
				out.push("#define " + declaration.name + parameters + replacement);
			} else {
				print("internal compiler error: invalid preprocessor IR declaration");
				exit(1);
			}
			i = i + 1;
		}
		if (out.len > 0) { out.push(""); }
		return out;
	}

	/* Insert `ins` lines into self.lines at index `at`. */
	private void spliceLines(int at, Vector<string> ins) {
		Vector<string> rebuilt = [];
		int i = 0;
		while (i < at) { rebuilt.push(self.lines.get(i)); i = i + 1; }
		int j = 0;
		while (j < ins.len) { rebuilt.push(ins.get(j)); j = j + 1; }
		int k = at;
		while (k < self.lines.len) { rebuilt.push(self.lines.get(k)); k = k + 1; }
		self.lines = rebuilt;
	}

	private string joinLines() {
		if (self.lines.len == 0) { return ""; }
		return Strings.join(self.lines, "\n") + "\n";
	}

	private void emitEnum(IREnumDef definition) {
		if (definition.name == "") { self.line("enum {"); }
		else { self.line("typedef enum {"); }
		self.indent = self.indent + 1;
		int index = 0;
		while (index < definition.values.len) {
			IREnumValue value = definition.values.get(index);
			string suffix = "";
			if (value.value != null) {
				suffix = " = " + self.expr(value.value);
			}
			if (index < definition.values.len - 1) { suffix = suffix + ","; }
			self.line(value.name + suffix);
			index = index + 1;
		}
		self.indent = self.indent - 1;
		if (definition.name == "") { self.line("};"); }
		else { self.line("} " + definition.name + ";"); }
		self.line("");
	}

	private void emitStructForward(IRStructForward declaration) { self.line("typedef struct " + declaration.name + " " + declaration.name + ";"); }

	private bool aliasIdentifierChar(char value) { return (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z') || (value >= '0' && value <= '9') || value == '_'; }

	private bool aliasDependenciesReady(string typeText, string ownName, Map<string, bool> providers, Map<string, bool> emitted) {
		int length = typeText.length();
		int index = 0;
		while (index < length) {
			while (index < length && !self.aliasIdentifierChar(typeText[index])) {
				index = index + 1;
			}
			int start = index;
			while (index < length && self.aliasIdentifierChar(typeText[index])) {
				index = index + 1;
			}
			if (start < index) {
				string name = typeText.substring(start, index - start);
				if (name != ownName && providers.has(name) && !emitted.has(name)) {
					return false;
				}
			}
		}
		return true;
	}

	private bool functionPointerDependenciesReady(IRFunctionPointerTypedef declaration, Map<string, bool> providers, Map<string, bool> emitted) {
		if (!self.aliasDependenciesReady(declaration.returnType, declaration.name, providers, emitted)) {
			return false;
		}
		int index = 0;
		while (index < declaration.paramTypes.len) {
			if (!self.aliasDependenciesReady(declaration.paramTypes.get(index), declaration.name, providers, emitted)) {
				return false;
			}
			index = index + 1;
		}
		return true;
	}

	/* Function-pointer and ordinary typedef declarations form one dependency
     * graph.  Preserve the reference frontend's stable group order whenever
     * possible, while moving named aliases ahead of callbacks that use them. */
	private void emitOrderedAliases(IRModule module) {
		Map<string, bool> providers = {};
		int index = 0;
		while (index < module.functionPointerTypedefs.len) {
			providers.put(module.functionPointerTypedefs.get(index).name, true);
			index = index + 1;
		}
		index = 0;
		while (index < module.typedefDefs.len) {
			providers.put(module.typedefDefs.get(index).name, true);
			index = index + 1;
		}

		Map<string, bool> emitted = {};
		int remaining = module.functionPointerTypedefs.len + module.typedefDefs.len;
		while (remaining > 0) {
			bool progressed = false;
			index = 0;
			while (index < module.functionPointerTypedefs.len) {
				IRFunctionPointerTypedef declaration = module.functionPointerTypedefs.get(index);
				if (!emitted.has(declaration.name) && self.functionPointerDependenciesReady(declaration, providers, emitted)) {
					self.emitFunctionPointerTypedef(declaration);
					self.line("");
					emitted.put(declaration.name, true);
					remaining = remaining - 1;
					progressed = true;
				}
				index = index + 1;
			}
			index = 0;
			while (index < module.typedefDefs.len) {
				IRTypedefDef declaration = module.typedefDefs.get(index);
				if (!emitted.has(declaration.name) && self.aliasDependenciesReady(declaration.targetType, declaration.name, providers, emitted)) {
					self.emitTypedef(declaration);
					emitted.put(declaration.name, true);
					remaining = remaining - 1;
					progressed = true;
				}
				index = index + 1;
			}
			if (!progressed) {
				fprintf(stderr, "error: cyclic typed C alias dependency\n");
				exit(1);
			}
		}
	}

	private void emitFunctionPointerTypedef(IRFunctionPointerTypedef declaration) {
		string parameters = "void";
		if (declaration.paramTypes.len > 0) {
			parameters = "";
			int index = 0;
			while (index < declaration.paramTypes.len) {
				if (index > 0) { parameters = parameters + ", "; }
				parameters = parameters + declaration.paramTypes.get(index);
				index = index + 1;
			}
		}
		self.line("typedef " + declaration.returnType + " (*" + declaration.name + ")(" + parameters + ");");
	}

	private void emitFunctionDecl(IRFunctionDecl declaration) {
		string storage = "";
		if (declaration.isStatic) { storage = "static "; }
		self.line(storage + declaration.returnType + " " + declaration.name + "(" + self.paramList(declaration.params) + ");");
	}

	/* --- struct emission (matches emitter.py _emit_struct) --- */

	private string structFieldDeclaration(IRStructField field) {
		string suffix = "";
		if (field.arraySize != null) {
			suffix = "[" + self.expr(field.arraySize) + "]";
		}
		string ctype = self.qualifyVolatileObjectType(field.cType, field.isVolatile);
		return ctype + " " + field.name + suffix + ";";
	}

	private void emitStruct(IRStructDef s) {
		if (s.packAlignment > 0) {
			self.line("#pragma pack(push, " + Strings.fromInt(s.packAlignment) + ")");
		}
		self.line(f"struct {s.name} {{");
		self.indent = self.indent + 1;
		int i = 0;
		while (i < s.fields.len) {
			IRStructField f = s.fields.get(i);
			self.line(self.structFieldDeclaration(f));
			i = i + 1;
		}
		self.indent = self.indent - 1;
		self.line("};");
		if (s.packAlignment > 0) { self.line("#pragma pack(pop)"); }
		self.line("");
	}

	private void emitTypedef(IRTypedefDef d) {
		string targetType = self.qualifyVolatileObjectType(d.targetType, d.isVolatile);
		self.line(f"typedef {targetType} {d.name};");
		self.line("");
	}

	private void emitTaggedUnion(IRTaggedUnionDef d) {
		int i = 0;
		while (i < d.variants.len) {
			IRTaggedUnionVariant variant = d.variants.get(i);
			if (variant.fields.len > 0) {
				string dataName = d.name + "_" + variant.name + "_Data";
				self.line(f"typedef struct {dataName} {{");
				self.indent = self.indent + 1;
				int f = 0;
				while (f < variant.fields.len) {
					IRStructField field = variant.fields.get(f);
					self.line(self.structFieldDeclaration(field));
					f = f + 1;
				}
				self.indent = self.indent - 1;
				self.line(f"}} {dataName};");
				self.line("");
			}
			i = i + 1;
		}
		self.line(f"struct {d.name} {{");
		self.indent = self.indent + 1;
		self.line(f"{d.tagType} tag;");
		bool hasPayload = false;
		i = 0;
		while (i < d.variants.len) {
			if (d.variants.get(i).fields.len > 0) { hasPayload = true; }
			i = i + 1;
		}
		if (hasPayload) {
			self.line("union {");
			self.indent = self.indent + 1;
			i = 0;
			while (i < d.variants.len) {
				IRTaggedUnionVariant variant = d.variants.get(i);
				if (variant.fields.len > 0) {
					string dataName = d.name + "_" + variant.name + "_Data";
					self.line(f"{dataName} {variant.name};");
				}
				i = i + 1;
			}
			self.indent = self.indent - 1;
			self.line("} data;");
		}
		self.indent = self.indent - 1;
		self.line("};");
		self.line("");
	}

	private void emitGlobal(IRGlobalDecl d) {
		string storage = "";
		if (d.isStatic) { storage = "static "; }
		else if (d.isExtern) { storage = "extern "; }
		string ctype = self.qualifyVolatileObjectType(d.cType, d.isVolatile);
		string suffix = "";
		if (d.arraySize != null) { suffix = "[" + self.expr(d.arraySize) + "]"; }
		else if (d.isUnsizedArray) { suffix = "[]"; }
		string initializer = "";
		if (d.init != null) { initializer = " = " + self.expr(d.init); }
		self.line(storage + ctype + " " + d.name + suffix + initializer + ";");
	}

	/* --- function emission --- */

	private void emitFunction(IRFunction fn) {
		string prefix = "";
		if (fn.isStatic) { prefix = "static "; }
		self.line(prefix + fn.returnType + " " + fn.name + "(" + self.paramList(fn.params) + ") {");
		if (fn.body != null) {
			self.indent = self.indent + 1;
			self.emitBlockContents(fn.body);
			self.indent = self.indent - 1;
		}
		self.line("}");
		self.line("");
	}

	private string paramList(Vector<IRParam> declarations) {
		string params = "";
		if (declarations.len == 0) {
			params = "void";
		} else {
			int i = 0;
			while (i < declarations.len) {
				IRParam p = declarations.get(i);
				if (i > 0) { params = params + ", "; }
				string paramType = self.qualifyVolatileObjectType(p.cType, p.isVolatile);
				params = params + paramType + " " + p.name;
				i = i + 1;
			}
		}
		return params;
	}

	private void emitBlockContents(IRNode block) {
		int i = 0;
		while (i < block.stmts.len) {
			self.emitStmt(block.stmts.get(i));
			i = i + 1;
		}
	}

	/* --- statement emission --- */

	private void emitStmt(IRNode s) {
		if (s.kind == IRK_VAR_DECL) {
			string ctype = self.qualifiedDeclType(s);
			string declarator = self.localDeclarator(s);
			if (s.init != null) {
				self.line(f"{ctype} {declarator} = {self.expr(s.init)};");
			} else {
				self.line(f"{ctype} {declarator};");
			}
			return;
		}
		if (s.kind == IRK_ASSIGN) {
			self.line(f"{self.expr(s.target)} = {self.expr(s.value)};");
			return;
		}
		if (s.kind == IRK_RETURN) {
			if (s.value != null) {
				self.line(f"return {self.expr(s.value)};");
			} else {
				self.line("return;");
			}
			return;
		}
		if (s.kind == IRK_EXPR_STMT) {
			self.line(f"{self.discardedExpr(s.expr)};");
			return;
		}
		if (s.kind == IRK_BLOCK) {
			self.line("{");
			self.indent = self.indent + 1;
			self.emitBlockContents(s);
			self.indent = self.indent - 1;
			self.line("}");
			return;
		}
		if (s.kind == IRK_IF) {
			self.line(f"if ({self.condExpr(s.condition)}) {{");
			if (s.thenBlock != null) {
				self.indent = self.indent + 1;
				self.emitBlockContents(s.thenBlock);
				self.indent = self.indent - 1;
			}
			self.emitElseTail(s);
			return;
		}
		if (s.kind == IRK_WHILE) {
			self.line(f"while ({self.condExpr(s.condition)}) {{");
			if (s.body != null) {
				self.indent = self.indent + 1;
				self.emitBlockContents(s.body);
				self.indent = self.indent - 1;
			}
			self.line("}");
			return;
		}
		if (s.kind == IRK_DO_WHILE) {
			string conditionText = self.condExpr(s.condition);
			self.line("do {");
			if (s.body != null) {
				self.indent = self.indent + 1;
				self.emitBlockContents(s.body);
				self.indent = self.indent - 1;
			}
			self.line(f"}} while ({conditionText});");
			return;
		}
		if (s.kind == IRK_FOR) {
			string initText = self.forInitText(s.init);
			string condText = "";
			if (s.condition != null) { condText = self.expr(s.condition); }
			string updateText = "";
			if (s.update != null) {
				if (s.update.kind == IRK_ASSIGN) {
					updateText = f"{self.expr(s.update.target)} = {self.expr(s.update.value)}";
				} else {
					updateText = self.expr(s.update);
				}
			}
			self.line(f"for ({initText}; {condText}; {updateText}) {{");
			if (s.body != null) {
				self.indent = self.indent + 1;
				self.emitBlockContents(s.body);
				self.indent = self.indent - 1;
			}
			self.line("}");
			return;
		}
		if (s.kind == IRK_BREAK) { self.line("break;"); return; }
		if (s.kind == IRK_CONTINUE) { self.line("continue;"); return; }
		if (s.kind == IRK_SWITCH) {
			/* switch (val) { case V: <body> default: <body> } — mirrors the
             * IRSwitch branch of emitter._emit_stmt. */
			self.line(f"switch ({self.expr(s.value)}) {{");
			self.indent = self.indent + 1;
			int ci = 0;
			while (ci < s.args.len) {
				IRNode c = s.args.get(ci);
				if (c.value != null) {
					self.line(f"case {self.expr(c.value)}:");
				} else {
					self.line("default:");
				}
				self.line("{");
				self.indent = self.indent + 1;
				int j = 0;
				while (j < c.stmts.len) { self.emitStmt(c.stmts.get(j)); j = j + 1; }
				self.indent = self.indent - 1;
				self.line("}");
				if (c.fallsThrough && ci + 1 < s.args.len) {
					self.line("/* fall through */");
				}
				ci = ci + 1;
			}
			self.indent = self.indent - 1;
			self.line("}");
			return;
		}
		print(f"internal compiler error: unsupported IR statement {s.kind}");
		exit(1);
	}

	private string forInitText(IRNode init) {
		if (init == null) { return ""; }
		if (init.kind == IRK_VAR_DECL) {
			string ctype = self.qualifiedDeclType(init);
			string declarator = self.localDeclarator(init);
			if (init.init != null) {
				return f"{ctype} {declarator} = {self.expr(init.init)}";
			}
			return f"{ctype} {declarator}";
		}
		if (init.kind == IRK_ASSIGN) {
			return f"{self.expr(init.target)} = {self.expr(init.value)}";
		}
		if (init.kind == IRK_EXPR_STMT) {
			return self.discardedExpr(init.expr);
		}
		print(f"internal compiler error: unsupported for initializer {init.kind}");
		exit(1);
		return "";
	}

	private string qualifiedDeclType(IRNode declaration) {
		string storage = "";
		if (declaration.isStatic) { storage = "static "; }
		else if (declaration.isExtern) { storage = "extern "; }
		string ctype = self.qualifyVolatileObjectType(declaration.cType, declaration.isVolatile);
		return storage + ctype;
	}

	private string localDeclarator(IRNode declaration) {
		if (!declaration.isArrayDecl) { return declaration.name; }
		string size = "";
		if (declaration.arraySize != null) {
			size = self.expr(declaration.arraySize);
		}
		return declaration.name + "[" + size + "]";
	}

	/* Emit the else / else-if tail of an IRIf, recursing for chains. */
	private void emitElseTail(IRNode s) {
		if (s.elseBlock == null || s.elseBlock.stmts.len == 0) {
			self.line("}");
			return;
		}
		self.line("} else {");
		self.indent = self.indent + 1;
		self.emitBlockContents(s.elseBlock);
		self.indent = self.indent - 1;
		self.line("}");
	}

	/* --- expression emission (matches backend/c_emitter.py exactly) --- */

	private string compound(string opening, Vector<string> values, string closing, string inlineSeparator, string lineSeparator) {
		string inlineText = opening;
		int index = 0;
		while (index < values.len) {
			if (index > 0) {
				inlineText = inlineText + inlineSeparator;
			}
			inlineText = inlineText + values.get(index);
			index = index + 1;
		}
		inlineText = inlineText + closing;
		if (inlineText.length() <= 1000 && !self.stringHasLineBreak(inlineText)) {
			return inlineText;
		}
		string multiline = opening + "\n";
		index = 0;
		while (index < values.len) {
			if (index > 0) {
				multiline = multiline + lineSeparator;
			}
			multiline = multiline + values.get(index);
			index = index + 1;
		}
		return multiline + "\n" + closing;
	}

	private string delimited(string opening, Vector<string> values, string closing) { return self.compound(opening, values, closing, ", ", ",\n"); }

	private string condExpr(IRNode e) {
		string result = self.expr(e);
		int n = result.length();
		if (n >= 2 && result.substring(0, 1) == "(" && result.substring(n - 1, 1) == ")") {
			int depth = 0;
			bool stripsOuter = true;
			bool inSingle = false;
			bool inDouble = false;
			bool escaped = false;
			int i = 0;
			while (i < n) {
				char ch = result[i];
				if (escaped) { escaped = false; }
				else if ((inSingle || inDouble) && ch == '\\') { escaped = true; }
				else if (!inDouble && ch == '\'') { inSingle = !inSingle; }
				else if (!inSingle && ch == '"') { inDouble = !inDouble; }
				else if (!inSingle && !inDouble) {
					if (ch == '(') { depth = depth + 1; }
					else if (ch == ')') { depth = depth - 1; }
					if (depth == 0 && i < n - 1) {
						stripsOuter = false;
						i = n;
					}
				}
				if (i < n) { i = i + 1; }
			}
			if (stripsOuter) {
				result = result.substring(1, n - 2);
			}
		}
		return result;
	}

	private string discardedExpr(IRNode e) {
		Vector<string> values = [self.expr(e)];
		return self.compound("(void)(", values, ")", "", "\n");
	}

	private string expr(IRNode e) {
		if (e == null) {
			print("internal compiler error: null IR expression");
			exit(1);
			return "";
		}
		if (e.kind == IRK_LITERAL) { return e.text; }
		if (e.kind == IRK_VAR || e.kind == IRK_FUNCTION_REF) {
			return e.name;
		}
		if (e.kind == IRK_BINOP) {
			Vector<string> values = [
				self.expr(e.left), e.op, self.expr(e.right)
			];
			return self.compound("(", values, ")", " ", "\n");
		}
		if (e.kind == IRK_COMMA_EXPR) {
			Vector<string> values = [];
			int i = 0;
			while (i < e.args.len) {
				values.push(self.expr(e.args.get(i)));
				i = i + 1;
			}
			return self.delimited("(", values, ")");
		}
		if (e.kind == IRK_UNARYOP) {
			Vector<string> values = [self.expr(e.operand)];
			if (e.prefix) {
				return self.compound("(" + e.op, values, ")", "", "\n");
			}
			return self.compound("(", values, e.op + ")", "", "\n");
		}
		if (e.kind == IRK_CALL) {
			Vector<string> args = [];
			int i = 0;
			while (i < e.args.len) {
				args.push(self.expr(e.args.get(i)));
				i = i + 1;
			}
			string callee = e.callee;
			if (e.expr != null) { callee = self.expr(e.expr); }
			Vector<string> call = [callee, self.delimited("(", args, ")")];
			return self.compound("", call, "", "", "\n");
		}
		if (e.kind == IRK_FIELD_ACCESS) {
			string op = ".";
			if (e.arrow) { op = "->"; }
			Vector<string> values = [self.expr(e.obj), op + e.field];
			return self.compound("", values, "", "", "\n");
		}
		if (e.kind == IRK_CAST) {
			Vector<string> values = [self.expr(e.expr)];
			return self.compound("((" + e.targetType + ")", values, ")", "", "\n");
		}
		if (e.kind == IRK_TERNARY) {
			Vector<string> values = [
				self.expr(e.condition), "?", self.expr(e.trueExpr),
				":", self.expr(e.falseExpr)
			];
			return self.compound("(", values, ")", " ", "\n");
		}
		if (e.kind == IRK_SIZEOF) {
			if (e.operand != null) {
				Vector<string> operand = [self.expr(e.operand)];
				return self.compound("sizeof(", operand, ")", "", "\n");
			}
			if (e.targetType == "") {
				print("internal compiler error: IRSizeof has no operand");
				exit(1);
			}
			Vector<string> values = [e.targetType];
			return self.compound("sizeof(", values, ")", "", "\n");
		}
		if (e.kind == IRK_INITIALIZER_LIST) {
			Vector<string> values = [];
			if (e.args.len == 0) { values.push("0"); }
			int i = 0;
			while (i < e.args.len) {
				values.push(self.expr(e.args.get(i)));
				i = i + 1;
			}
			return self.delimited("{", values, "}");
		}
		if (e.kind == IRK_COMPOUND_LITERAL) {
			if (e.targetType == "" || e.fieldNames.len != e.args.len) {
				print("internal compiler error: malformed IRCompoundLiteral");
				exit(1);
			}
			Vector<string> fields = [];
			if (e.args.len == 0) { fields.push("0"); }
			int i = 0;
			while (i < e.args.len) {
				Vector<string> value = [self.expr(e.args.get(i))];
				fields.push(self.compound("." + e.fieldNames.get(i) + " = ", value, "", "", "\n"));
				i = i + 1;
			}
			Vector<string> literal = [self.delimited("{", fields, "}")];
			return self.compound("(" + e.targetType + ")", literal, "", "", "\n");
		}
		if (e.kind == IRK_INDEX) {
			Vector<string> indexValue = [self.expr(e.index)];
			string index = self.compound("[", indexValue, "]", "", "\n");
			Vector<string> values = [self.expr(e.obj), index];
			return self.compound("", values, "", "", "\n");
		}
		if (e.kind == IRK_ADDRESS_OF) {
			Vector<string> values = [self.expr(e.expr)];
			return self.compound("(&", values, ")", "", "\n");
		}
		if (e.kind == IRK_DEREF) {
			Vector<string> values = [self.expr(e.expr)];
			return self.compound("(*", values, ")", "", "\n");
		}
		if (e.kind == IRK_STMT_EXPR) {
			/* Only uninitialized declarations may be hoisted. Runtime work must
             * stay in the result comma expression so branches and loop
             * conditions preserve their source evaluation semantics. */
			int i = 0;
			while (i < e.stmts.len) {
				IRNode declaration = e.stmts.get(i);
				bool safeInitializer = declaration.init == null;
				if (declaration.init != null && declaration.init.kind == IRK_LITERAL && (declaration.init.text == "0" || declaration.init.text == "NULL" || declaration.init.text == "false")) {
					safeInitializer = true;
				}
				if (declaration.kind != IRK_VAR_DECL || !safeInitializer) {
					print("internal compiler error: unsafe IRStmtExpr setup");
					exit(1);
				}
				self.emitStmt(declaration);
				i = i + 1;
			}
			return self.expr(e.result);
		}
		if (e.kind == IRK_INVALID_EXPR) {
			fprintf(stderr, "error: %s\n", e.text);
			exit(1);
		}
		print(f"internal compiler error: unsupported IR expression {e.kind}");
		exit(1);
		return "";
	}

	/* --- output helpers (matches emitter.py _line) --- */

	private void line(string text) {
		Vector<string> parts = self.splitLines(text);
		int index = 0;
		while (index < parts.len) {
			string part = parts.get(index);
			if (self.stripped(part) != "") {
				self.lines.push(self.indentation(self.indent) + part);
			} else {
				self.lines.push("");
			}
			index = index + 1;
		}
	}

	/* Emit raw text without indentation (mirrors emitter.py _raw): strip
     * trailing newlines, then push each \n-separated line verbatim. */
	private void raw(string text) {
		string t = self.withoutTrailingNewlines(text);
		Vector<string> parts = self.splitLines(t);
		int i = 0;
		while (i < parts.len) { self.lines.push(parts.get(i)); i = i + 1; }
	}

	private string withoutTrailingNewlines(string s) {
		int end = s.length();
		while (end > 0 && s[end - 1] == '\n') { end = end - 1; }
		return s.substring(0, end);
	}

	private bool stringHasLineBreak(string value) {
		int index = 0;
		while (index < value.length()) {
			if (value[index] == '\n' || value[index] == '\r') { return true; }
			index = index + 1;
		}
		return false;
	}

	/* Split a string on '\n' into its lines (no trailing empty element unless
     * the original ended with a separator, matching Python str.split("\n")). */
	private Vector<string> splitLines(string s) {
		Vector<string> out = [];
		int n = s.length();
		int start = 0;
		int i = 0;
		while (i < n) {
			if (s[i] == '\n') {
				out.push(s.substring(start, i - start));
				start = i + 1;
			}
			i = i + 1;
		}
		out.push(s.substring(start, n - start));
		return out;
	}

	private string indentation(int n) {
		string s = "";
		int i = 0;
		while (i < n) { s = s + "    "; i = i + 1; }
		return s;
	}

	/* Whitespace-stripped copy, used to detect blank lines. */
	private string stripped(string s) {
		int n = s.length();
		int start = 0;
		while (start < n && self.whitespace(s[start])) { start = start + 1; }
		int end = n;
		while (end > start && self.whitespace(s[end - 1])) { end = end - 1; }
		return s.substring(start, end - start);
	}

	private bool whitespace(char c) { return c == ' ' || c == '\t' || c == '\n' || c == '\r'; }
}
