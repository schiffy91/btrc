/* Stateful WGSL emission for one GPU kernel. */

import std.map;
import std.strings;
import std.vector;
import ../../analyzer/gpu.btrc;
import ../../analyzer/types.btrc;
import ../../generated/ast/node.btrc;
import ../../syntax/literals.btrc;
import ../model.btrc;



class GpuScopeBinding {
    public string source;
    public string previous_name;
    public Node previous_type;
    public bool had_name;
    public bool had_type;

    public GpuScopeBinding(string source) {
        self.source = source;
        self.previous_name = "";
        self.previous_type = null;
        self.had_name = false;
        self.had_type = false;
    }
}



class GpuWgslEmitter {
    private GpuSemantics semantics;
    private IRGpuKernel kernel;
    private Vector<string> lines;
    private int indent;
    private int nextLocal;
    private int nextValue;
    private Map<string, string> names;
    private Map<string, Node> varTypes;
    private Map<string, bool> uniforms;
    private Map<string, bool> boolUniforms;
    private Map<string, string> arrayLengths;
    private Vector<GpuScopeBinding> bindings;
    private Vector<int> scopeStarts;
    private bool hasOutput;

    public GpuWgslEmitter(GpuSemantics semantics, IRGpuKernel kernel) {
        self.semantics = semantics;
        self.kernel = kernel;
        self.lines = [];
        self.indent = 1;
        self.nextLocal = 0;
        self.nextValue = 0;
        self.names = {};
        self.varTypes = {};
        self.uniforms = {};
        self.boolUniforms = {};
        self.arrayLengths = {};
        self.bindings = [];
        self.scopeStarts = [];
        self.hasOutput = kernel.output_buffer != null;
    }

    private void line(string value) {
        string prefix = "";
        int index = 0;
        while (index < self.indent) {
            prefix = prefix + "    ";
            index = index + 1;
        }
        self.lines.push(prefix + value);
    }

    private string freshValue() {
        string value = "btrc_e_" + Strings.fromInt(self.nextValue);
        self.nextValue = self.nextValue + 1;
        return value;
    }

    private string declareName(string source) {
        GpuScopeBinding binding = GpuScopeBinding(source);
        if (self.names.has(source)) {
            binding.had_name = true;
            binding.previous_name = self.names.get(source);
        }
        if (self.varTypes.has(source)) {
            binding.had_type = true;
            binding.previous_type = self.varTypes.get(source);
        }
        self.bindings.push(binding);
        string value = "btrc_v_" + Strings.fromInt(self.nextLocal);
        self.nextLocal = self.nextLocal + 1;
        self.names.put(source, value);
        return value;
    }

    private void pushScope() { self.scopeStarts.push(self.bindings.len); }

    private void popScope() {
        if (self.scopeStarts.len == 0) { return; }
        int start = self.scopeStarts.pop();
        while (self.bindings.len > start) {
            GpuScopeBinding binding = self.bindings.pop();
            if (binding.had_name) {
                self.names.put(binding.source, binding.previous_name);
            } else {
                self.names.remove(binding.source);
            }
            if (binding.had_type) {
                self.varTypes.put(binding.source, binding.previous_type);
            } else {
                self.varTypes.remove(binding.source);
            }
        }
    }

    private string lookupName(Node at, string source) {
        if (!self.names.has(source)) {
            self.gpuLoweringFail(at, "identifier '" + source
                + "' is not available in WGSL scope");
        }
        return self.names.get(source);
    }

    private Node? typeOf(Node expression) {
        return self.semantics.contextualExprType(
            expression, self.varTypes);
    }

    private string expr(Node expression) {
        return self.gpuWgslExpr(expression);
    }

    private void stmt(Node statement) {
        self.gpuWgslStmt(statement);
    }

    private string finish() {
        string result = "";
        int index = 0;
        while (index < self.lines.len) {
            if (index > 0) { result = result + "\n"; }
            result = result + self.lines.get(index);
            index = index + 1;
        }
        return result;
    }


    private void gpuLoweringFail(Node? at, string message) {
        int line = 0;
        int col = 0;
        if (at != null) { line = at.line; col = at.col; }
        fprintf(stderr, "error: @gpu lowering at %d:%d: %s\n", line, col, message);
        exit(1);
    }

    private string gpuWgslScalarType(Node? type) {
        if (type == null) { return "i32"; }
        Node resolved = type;
        if (resolved.is_array || resolved.pointer_depth > 0
                || resolved.generic_args.len > 0 || resolved.is_nullable) {
            self.gpuLoweringFail(resolved, "type has no WGSL scalar representation");
        }
        if (resolved.base == "int") { return "i32"; }
        if (resolved.base == "float") { return "f32"; }
        if (resolved.base == "bool") { return "bool"; }
        self.gpuLoweringFail(resolved, "type '" + resolved.base
            + "' has no WGSL scalar representation");
        return "i32";
    }

    private string gpuWgslElementType(Node? type) {
        if (type == null) {
            self.gpuLoweringFail(type, "GPU buffers require int or float elements");
        }
        Node resolved = type;
        if (resolved.base != "int" && resolved.base != "float") {
            self.gpuLoweringFail(resolved, "GPU buffers require int or float elements");
        }
        if (resolved.pointer_depth > 0 || resolved.generic_args.len > 0
                || resolved.is_nullable) {
            self.gpuLoweringFail(resolved, "GPU buffer type is not host-shareable");
        }
        if (resolved.base == "float") { return "f32"; }
        return "i32";
    }

    private void gpuValidateBinaryTypes(Node expression, string left, string right) {
        string op = expression.op;
        if (op == "%" && (left != "int" || right != "int")) {
            self.gpuLoweringFail(expression,
                "GPU remainder operator requires integer operands");
        }
        if ((op == "<<" || op == ">>")
                && (left != "int" || right != "int")) {
            self.gpuLoweringFail(expression,
                "GPU shift operators require integer operands");
        }
        if (op == "&" || op == "|" || op == "^") {
            if (left != right || (left != "int" && left != "bool")) {
                self.gpuLoweringFail(expression,
                    "GPU bitwise operators require matching int or bool operands");
            }
        }
    }

    private void gpuValidateFloatLiteral(Node expression) {
        FloatLiteral literal = FloatLiteral(expression.raw);
        double value = literal.doubleValue();
        if (literal.narrowingProblem(value) != "") {
            self.gpuLoweringFail(expression,
                "floating literal is outside the WGSL f32 range");
        }
    }

    private string gpuWgslFloatLiteral(Node expression) {
        self.gpuValidateFloatLiteral(expression);
        string raw = expression.raw;
        if (raw == "") { raw = Strings.fromFloat(expression.value_float); }
        if (raw.endsWith("f") || raw.endsWith("F")) {
            raw = raw.substring(0, raw.length() - 1);
        }
        if (raw.indexOf(".") < 0 && raw.indexOf("e") < 0
                && raw.indexOf("E") < 0) {
            raw = raw + ".0";
        }
        return raw;
    }

    private string gpuExprBase(Node expression) {
        Node? type = self.typeOf(expression);
        if (type != null) { return type.base; }
        if (expression.kind == NK_BOOL_LITERAL) { return "bool"; }
        if (expression.kind == NK_FLOAT_LITERAL) { return "float"; }
        if (expression.kind == NK_INT_LITERAL) { return "int"; }
        return "";
    }

    private string gpuCoerceText(string value, string source, string target) {
        if (source == "" || target == "" || source == target) { return value; }
        if (source == "bool" && target == "int") {
            return "select(0, 1, " + value + ")";
        }
        if (source == "bool" && target == "float") {
            return "select(0.0, 1.0, " + value + ")";
        }
        if (target == "bool" && source == "int") {
            return "(" + value + " != 0)";
        }
        if (target == "bool" && source == "float") {
            return "(" + value + " != 0.0)";
        }
        if (source == "int" && target == "float") { return "f32(" + value + ")"; }
        if (source == "float" && target == "int") { return "i32(" + value + ")"; }
        return value;
    }

    private string gpuCheckedArithmetic(Node expression,
            string left, string right) {
        string leftName = self.freshValue();
        string rightName = self.freshValue();
        string result = self.freshValue();
        self.line("let " + leftName + ": i32 = " + left + ";");
        self.line("let " + rightName + ": i32 = " + right + ";");
        self.line("var " + result + ": i32 = 0;");
        int zeroCode = 2;
        if (expression.op == "%") { zeroCode = 3; }
        self.line("if (" + rightName + " == 0) {");
        self.indent = self.indent + 1;
        self.line("atomicMax(&btrc_status.code, "
            + Strings.fromInt(zeroCode) + "u);");
        self.indent = self.indent - 1;
        self.line("} else if (" + leftName
            + " == -2147483648 && " + rightName + " == -1) {");
        self.indent = self.indent + 1;
        if (expression.op == "/") {
            self.line("atomicMax(&btrc_status.code, 4u);");
        } else {
            self.line(result + " = 0;");
        }
        self.indent = self.indent - 1;
        self.line("} else {");
        self.indent = self.indent + 1;
        self.line(result + " = " + leftName + " " + expression.op
            + " " + rightName + ";");
        self.indent = self.indent - 1;
        self.line("}");
        return result;
    }

    private string gpuCheckedIndex(Node expression) {
        if (expression.obj == null || expression.obj.kind != NK_IDENTIFIER) {
            self.gpuLoweringFail(expression, "GPU indexing requires an array parameter");
        }
        string source = expression.obj.name;
        if (!self.arrayLengths.has(source)) {
            self.gpuLoweringFail(expression, "GPU indexing requires an array parameter");
        }
        Node? arrayType = self.typeOf(expression.obj);
        string element = self.gpuWgslElementType(arrayType);
        string indexValue = self.expr(expression.index);
        string indexName = self.freshValue();
        string result = self.freshValue();
        string length = "uniforms." + self.arrayLengths.get(source);
        self.line("let " + indexName + ": i32 = " + indexValue + ";");
        self.line("var " + result + ": " + element + ";");
        self.line("if (" + indexName + " < 0 || " + indexName
            + " >= " + length + ") {");
        self.indent = self.indent + 1;
        self.line("atomicMax(&btrc_status.code, 1u);");
        self.line(result + " = " + (element == "f32" ? "0.0" : "0") + ";");
        self.indent = self.indent - 1;
        self.line("} else {");
        self.indent = self.indent + 1;
        self.line(result + " = " + self.lookupName(expression.obj, source)
            + "[" + indexName + "];");
        self.indent = self.indent - 1;
        self.line("}");
        return result;
    }

    private string gpuWgslBinary(Node expression) {
        if (expression.op == "&&" || expression.op == "||") {
            if (self.gpuExprBase(expression.left) != "bool"
                    || self.gpuExprBase(expression.right) != "bool") {
                self.gpuLoweringFail(expression,
                    "GPU logical operators require bool operands");
            }
            string left = self.expr(expression.left);
            string result = self.freshValue();
            self.line("var " + result + ": bool = " + left + ";");
            string condition = result;
            if (expression.op == "||") { condition = "!" + result; }
            self.line("if (" + condition + ") {");
            self.indent = self.indent + 1;
            string rightLazy = self.expr(expression.right);
            self.line(result + " = " + rightLazy + ";");
            self.indent = self.indent - 1;
            self.line("}");
            return result;
        }
        string leftType = self.gpuExprBase(expression.left);
        string rightType = self.gpuExprBase(expression.right);
        string left = self.expr(expression.left);
        string right = self.expr(expression.right);
        self.gpuValidateBinaryTypes(expression, leftType, rightType);
        if ((expression.op == "/" || expression.op == "%")
                && leftType == "int" && rightType == "int") {
            return self.gpuCheckedArithmetic(expression, left, right);
        }
        bool allowed = expression.op == "+" || expression.op == "-"
            || expression.op == "*" || expression.op == "/"
            || expression.op == "%" || expression.op == "=="
            || expression.op == "!=" || expression.op == "<"
            || expression.op == ">" || expression.op == "<="
            || expression.op == ">=" || expression.op == "&"
            || expression.op == "|" || expression.op == "^"
            || expression.op == "<<" || expression.op == ">>";
        if (!allowed) { self.gpuLoweringFail(expression, "operator has no WGSL definition"); }
        if (expression.op == "^" && leftType == "bool") {
            return "(" + left + " != " + right + ")";
        }
        if (expression.op == "<<" || expression.op == ">>") {
            right = "u32(" + right + ")";
        } else if ((leftType == "int" && rightType == "float")
                || (leftType == "float" && rightType == "int")) {
            left = self.gpuCoerceText(left, leftType, "float");
            right = self.gpuCoerceText(right, rightType, "float");
        }
        return "(" + left + " " + expression.op + " " + right + ")";
    }

    private string gpuWgslCall(Node expression) {
        if (expression.callee == null || expression.callee.kind != NK_IDENTIFIER) {
            self.gpuLoweringFail(expression, "indirect and method calls have no WGSL definition");
        }
        string name = expression.callee.name;
        int named = 0;
        while (named < expression.arg_names.len) {
            if (expression.arg_names.get(named) != "") {
                self.gpuLoweringFail(expression, "WGSL built-ins do not accept named arguments");
            }
            named = named + 1;
        }
        bool sourceFunction =
            self.semantics.callResolvesToSourceSymbol(
                expression, self.varTypes);
        if (sourceFunction || self.names.has(name)) {
            self.gpuLoweringFail(expression, "call to '" + name
                + "' has no WGSL definition because it resolves to a source symbol");
        }
        if (name == "gpu_id") {
            if (expression.args.len != 0) {
                self.gpuLoweringFail(expression, "gpu_id() takes no arguments");
            }
            return "btrc_gid";
        }
        if (!self.semantics.builtin(name)) {
            self.gpuLoweringFail(expression, "call to '" + name
                + "' has no WGSL definition");
        }
        int arity = self.semantics.builtinArity(name);
        if (expression.args.len != arity) {
            self.gpuLoweringFail(expression, name + "() expects "
                + Strings.fromInt(arity) + " argument(s)");
        }
        string expectedBase = "";
        int typeIndex = 0;
        while (typeIndex < expression.args.len) {
            string actual = self.gpuExprBase(expression.args.get(typeIndex));
            if (self.semantics.floatBuiltin(name) && actual != "float") {
                self.gpuLoweringFail(expression,
                    name + "() requires float arguments in GPU functions");
            }
            if (self.semantics.sameTypeBuiltin(name)) {
                if (actual != "int" && actual != "float") {
                    self.gpuLoweringFail(expression,
                        name + "() requires int or float arguments in GPU functions");
                }
                if (expectedBase == "") { expectedBase = actual; }
                else if (actual != expectedBase) {
                    self.gpuLoweringFail(expression,
                        name + "() arguments must have the same GPU scalar type");
                }
            }
            typeIndex = typeIndex + 1;
        }
        Vector<string> rendered = [];
        int i = 0;
        while (i < expression.args.len) {
            rendered.push(self.expr(expression.args.get(i)));
            i = i + 1;
        }
        if (name == "round") {
            string value = self.freshValue();
            self.line("let " + value + ": f32 = " + rendered.get(0) + ";");
            return "select(select(ceil(" + value + " - 0.5), floor("
                + value + " + 0.5), " + value + " >= 0.0), " + value
                + ", " + value + " == 0.0)";
        }
        string args = "";
        int a = 0;
        while (a < rendered.len) {
            if (a > 0) { args = args + ", "; }
            args = args + rendered.get(a);
            a = a + 1;
        }
        return name + "(" + args + ")";
    }

    private string gpuWgslExpr(Node expression) {
        if (expression == null) { self.gpuLoweringFail(expression, "missing WGSL expression"); }
        if (expression.kind == NK_INT_LITERAL) { return Strings.fromInt(expression.value_int); }
        if (expression.kind == NK_FLOAT_LITERAL) {
            return self.gpuWgslFloatLiteral(expression);
        }
        if (expression.kind == NK_BOOL_LITERAL) {
            if (expression.value_bool) { return "true"; }
            return "false";
        }
        if (expression.kind == NK_IDENTIFIER) {
            string mapped = self.lookupName(expression, expression.name);
            if (self.uniforms.has(expression.name)) {
                mapped = "uniforms." + mapped;
                if (self.boolUniforms.has(expression.name)) {
                    mapped = "(" + mapped + " != 0u)";
                }
            }
            return mapped;
        }
        if (expression.kind == NK_BINARY_EXPR) { return self.gpuWgslBinary(expression); }
        if (expression.kind == NK_INDEX_EXPR) { return self.gpuCheckedIndex(expression); }
        if (expression.kind == NK_CALL_EXPR) { return self.gpuWgslCall(expression); }
        if (expression.kind == NK_UNARY_EXPR) {
            string operand = self.expr(expression.operand);
            if (expression.op == "+") { return operand; }
            if (expression.op == "!" || expression.op == "~" || expression.op == "-") {
                return "(" + expression.op + operand + ")";
            }
            if (expression.op == "++" || expression.op == "--") {
                if (self.gpuExprBase(expression.operand) == "float") {
                    return operand + (expression.op == "++" ? " += 1.0" : " -= 1.0");
                }
                return operand + expression.op;
            }
            self.gpuLoweringFail(expression, "unary operator has no WGSL definition");
        }
        if (expression.kind == NK_TERNARY_EXPR) {
            string condition = self.expr(expression.condition);
            string result = self.freshValue();
            string target = self.gpuExprBase(expression);
            if (target == "") { target = self.gpuExprBase(expression.true_expr); }
            Node targetNode = SemanticTypeSystem.primitive(target);
            self.line("var " + result + ": " + self.gpuWgslScalarType(targetNode) + ";");
            self.line("if (" + condition + ") {");
            self.indent = self.indent + 1;
            string yes = self.expr(expression.true_expr);
            yes = self.gpuCoerceText(yes, self.gpuExprBase(expression.true_expr), target);
            self.line(result + " = " + yes + ";");
            self.indent = self.indent - 1;
            self.line("} else {");
            self.indent = self.indent + 1;
            string no = self.expr(expression.false_expr);
            no = self.gpuCoerceText(no, self.gpuExprBase(expression.false_expr), target);
            self.line(result + " = " + no + ";");
            self.indent = self.indent - 1;
            self.line("}");
            return result;
        }
        if (expression.kind == NK_CAST_EXPR) {
            string value = self.expr(expression.expr);
            return self.gpuCoerceText(value, self.gpuExprBase(expression.expr),
                expression.target_type.base);
        }
        self.gpuLoweringFail(expression, "expression has no WGSL definition");
        return "0";
    }

    private void gpuEmitBlock(Node block) {
        if (block == null) { return; }
        self.pushScope();
        int i = 0;
        while (i < block.statements.len) {
            self.stmt(block.statements.get(i));
            i = i + 1;
        }
        self.popScope();
    }

    private void gpuEmitAssignedLine(Node assignment,
            string targetText, string value, string targetBase,
            string valueBase) {
        string renderedValue = value;
        string op = assignment.op;
        bool known = op == "=" || op == "+=" || op == "-=" || op == "*="
            || op == "/=" || op == "%=" || op == "&=" || op == "|="
            || op == "^=" || op == "<<=" || op == ">>=";
        if (!known) { self.gpuLoweringFail(assignment, "invalid GPU assignment operator"); }
        if (op != "=" && targetBase != valueBase) {
            self.gpuLoweringFail(assignment,
                "GPU compound assignment requires matching operand types");
        }
        if ((op == "<<=" || op == ">>=") && targetBase != "int") {
            self.gpuLoweringFail(assignment,
                "GPU shift assignment requires integer operands");
        }
        if ((op == "&=" || op == "|=" || op == "^=")
                && targetBase != "int" && targetBase != "bool") {
            self.gpuLoweringFail(assignment,
                "GPU bitwise assignment requires int or bool operands");
        }
        if (op == "%=" && targetBase == "float") {
            self.gpuLoweringFail(assignment,
                "GPU remainder assignment requires integer operands");
        }
        if (op == "^=" && targetBase == "bool") {
            self.line(targetText + " = " + targetText + " != "
                + renderedValue + ";");
            return;
        }
        if (op == "<<=" || op == ">>=") {
            renderedValue = "u32(" + renderedValue + ")";
        }
        if ((op == "/=" || op == "%=") && targetBase == "int") {
            Node binary = Node();
            binary.kind = NK_BINARY_EXPR;
            binary.op = op == "/=" ? "/" : "%";
            string checked = self.gpuCheckedArithmetic(
                binary, targetText, renderedValue);
            self.line(targetText + " = " + checked + ";");
            return;
        }
        self.line(targetText + " " + op + " " + renderedValue + ";");
    }

    private void gpuEmitIndexAssignment(Node assignment) {
        Node target = assignment.target;
        if (target.obj == null || target.obj.kind != NK_IDENTIFIER
                || !self.arrayLengths.has(target.obj.name)) {
            self.gpuLoweringFail(assignment, "GPU assignment target must be a local or buffer element");
        }
        string indexValue = self.expr(target.index);
        string indexName = self.freshValue();
        string length = "uniforms." + self.arrayLengths.get(target.obj.name);
        self.line("let " + indexName + ": i32 = " + indexValue + ";");
        self.line("if (" + indexName + " < 0 || " + indexName
            + " >= " + length + ") {");
        self.indent = self.indent + 1;
        self.line("atomicMax(&btrc_status.code, 1u);");
        self.indent = self.indent - 1;
        self.line("} else {");
        self.indent = self.indent + 1;
        string value = self.expr(assignment.value_node);
        string targetBase = self.gpuExprBase(target);
        value = self.gpuCoerceText(value, self.gpuExprBase(assignment.value_node), targetBase);
        string targetText = self.lookupName(target.obj, target.obj.name)
            + "[" + indexName + "]";
        self.gpuEmitAssignedLine(assignment, targetText, value, targetBase,
            self.gpuExprBase(assignment.value_node));
        self.indent = self.indent - 1;
        self.line("}");
    }

    private void gpuEmitAssignment(Node assignment) {
        if (assignment.target.kind == NK_INDEX_EXPR) {
            self.gpuEmitIndexAssignment(assignment);
            return;
        }
        if (assignment.target.kind != NK_IDENTIFIER
                || self.uniforms.has(assignment.target.name)) {
            self.gpuLoweringFail(assignment, "GPU assignment target must be a writable local or buffer element");
        }
        string value = self.expr(assignment.value_node);
        value = self.gpuCoerceText(value, self.gpuExprBase(assignment.value_node),
            self.gpuExprBase(assignment.target));
        self.gpuEmitAssignedLine(assignment,
            self.lookupName(assignment.target, assignment.target.name), value,
            self.gpuExprBase(assignment.target),
            self.gpuExprBase(assignment.value_node));
    }

    private void gpuEmitUpdate(Node expression) {
        if (expression.kind == NK_ASSIGN_EXPR) {
            self.gpuEmitAssignment(expression);
            return;
        }
        if (expression.kind == NK_UNARY_EXPR
                && (expression.op == "++" || expression.op == "--")) {
            if (expression.operand.kind == NK_INDEX_EXPR) {
                Node synthetic = Node();
                synthetic.kind = NK_ASSIGN_EXPR;
                synthetic.target = expression.operand;
                synthetic.op = expression.op == "++" ? "+=" : "-=";
                Node one = Node();
                if (self.gpuExprBase(expression.operand) == "float") {
                    one.kind = NK_FLOAT_LITERAL;
                    one.raw = "1.0";
                    one.value_float = 1.0;
                } else {
                    one.kind = NK_INT_LITERAL;
                    one.raw = "1";
                    one.value_int = 1;
                }
                synthetic.value_node = one;
                self.gpuEmitIndexAssignment(synthetic);
                return;
            }
            if (expression.operand.kind != NK_IDENTIFIER
                    || self.uniforms.has(expression.operand.name)) {
                self.gpuLoweringFail(expression, "GPU update target must be writable");
            }
            string name = self.lookupName(expression.operand, expression.operand.name);
            if (self.gpuExprBase(expression.operand) == "float") {
                self.line(name + (expression.op == "++" ? " += 1.0;" : " -= 1.0;"));
            } else {
                self.line(name + expression.op + ";");
            }
            return;
        }
        if (expression.kind == NK_CALL_EXPR) {
            self.line("_ = " + self.expr(expression) + ";");
            return;
        }
        self.gpuLoweringFail(expression,
            "expression statement must be an assignment, update, or WGSL built-in call");
    }

    private void gpuEmitReturn(Node statement) {
        if (statement.value_node != null && self.hasOutput) {
            string value = "";
            Node? valueType = self.typeOf(statement.value_node);
            if (valueType != null && valueType.is_array) {
                if (statement.value_node.kind != NK_IDENTIFIER
                        || !self.arrayLengths.has(statement.value_node.name)) {
                    self.gpuLoweringFail(statement, "GPU array return must name an array parameter");
                }
                string source = statement.value_node.name;
                string length = "uniforms." + self.arrayLengths.get(source);
                self.line("if (btrc_gid < 0 || btrc_gid >= " + length + ") {");
                self.indent = self.indent + 1;
                self.line("atomicMax(&btrc_status.code, 1u);");
                self.indent = self.indent - 1;
                self.line("} else {");
                self.indent = self.indent + 1;
                value = self.lookupName(statement.value_node, source) + "[btrc_gid]";
                self.line("_output[btrc_gid] = " + value + ";");
                self.indent = self.indent - 1;
                self.line("}");
            } else {
                value = self.expr(statement.value_node);
                string target = self.kernel.output_buffer.elem_type == "f32" ? "float" : "int";
                value = self.gpuCoerceText(value,
                    self.gpuExprBase(statement.value_node), target);
                self.line("_output[btrc_gid] = " + value + ";");
            }
        } else if (statement.value_node != null && !self.hasOutput) {
            self.gpuLoweringFail(statement, "void GPU function cannot return a value");
        }
        self.line("return;");
    }

    private void gpuEmitIf(Node statement) {
        if (self.gpuExprBase(statement.condition) != "bool") {
            self.gpuLoweringFail(statement.condition, "GPU if condition must be bool");
        }
        string condition = self.expr(statement.condition);
        self.line("if (" + condition + ") {");
        self.indent = self.indent + 1;
        self.gpuEmitBlock(statement.then_block);
        self.indent = self.indent - 1;
        if (statement.else_block != null
                && statement.else_block.kind == NK_ELSE_BLOCK) {
            self.line("} else {");
            self.indent = self.indent + 1;
            self.gpuEmitBlock(statement.else_block.body_node);
            self.indent = self.indent - 1;
            self.line("}");
        } else if (statement.else_block != null
                && statement.else_block.kind == NK_ELSE_IF) {
            self.line("} else {");
            self.indent = self.indent + 1;
            self.gpuEmitIf(statement.else_block.if_stmt);
            self.indent = self.indent - 1;
            self.line("}");
        } else {
            self.line("}");
        }
    }

    private void gpuEmitWhile(Node statement) {
        if (self.gpuExprBase(statement.condition) != "bool") {
            self.gpuLoweringFail(statement.condition, "GPU while condition must be bool");
        }
        self.line("loop {");
        self.indent = self.indent + 1;
        string condition = self.expr(statement.condition);
        self.line("if (!(" + condition + ")) { break; }");
        self.gpuEmitBlock(statement.body_node);
        self.indent = self.indent - 1;
        self.line("}");
    }

    private void gpuEmitFor(Node statement) {
        self.line("{");
        self.indent = self.indent + 1;
        self.pushScope();
        if (statement.init != null) {
            if (statement.init.kind == NK_FOR_INIT_VAR) {
                self.gpuWgslStmt(statement.init.var_decl);
            } else if (statement.init.kind == NK_FOR_INIT_EXPR) {
                self.gpuEmitUpdate(statement.init.expression);
            } else {
                self.gpuLoweringFail(statement.init, "unsupported GPU for initializer");
            }
        }
        self.line("loop {");
        self.indent = self.indent + 1;
        if (statement.condition != null) {
            if (self.gpuExprBase(statement.condition) != "bool") {
                self.gpuLoweringFail(statement.condition, "GPU for condition must be bool");
            }
            string condition = self.expr(statement.condition);
            self.line("if (!(" + condition + ")) { break; }");
        }
        self.gpuEmitBlock(statement.body_node);
        if (statement.update != null) {
            self.line("continuing {");
            self.indent = self.indent + 1;
            self.gpuEmitUpdate(statement.update);
            self.indent = self.indent - 1;
            self.line("}");
        }
        self.indent = self.indent - 1;
        self.line("}");
        self.popScope();
        self.indent = self.indent - 1;
        self.line("}");
    }

    private void gpuWgslStmt(Node statement) {
        if (statement.kind == NK_VAR_DECL_STMT) {
            Node? type = statement.type;
            if (type == null && statement.initializer != null) {
                type = self.typeOf(statement.initializer);
            }
            if (type == null || type.is_array) {
                self.gpuLoweringFail(statement, "GPU local must have a scalar type");
            }
            Node resolvedType = type;
            string initial = "";
            if (statement.initializer != null) {
                initial = self.expr(statement.initializer);
                initial = " = " + self.gpuCoerceText(initial,
                    self.gpuExprBase(statement.initializer), resolvedType.base);
            }
            string name = self.declareName(statement.name);
            self.varTypes.put(statement.name, resolvedType);
            self.line("var " + name + ": "
                + self.gpuWgslScalarType(resolvedType) + initial + ";");
            return;
        }
        if (statement.kind == NK_RETURN_STMT) { self.gpuEmitReturn(statement); return; }
        if (statement.kind == NK_IF_STMT) { self.gpuEmitIf(statement); return; }
        if (statement.kind == NK_WHILE_STMT) { self.gpuEmitWhile(statement); return; }
        if (statement.kind == NK_C_FOR_STMT) { self.gpuEmitFor(statement); return; }
        if (statement.kind == NK_EXPR_STMT) { self.gpuEmitUpdate(statement.expr); return; }
        if (statement.kind == NK_BREAK_STMT) { self.line("break;"); return; }
        if (statement.kind == NK_CONTINUE_STMT) { self.line("continue;"); return; }
        self.gpuLoweringFail(statement, "statement has no WGSL definition");
    }


    public string emit() {
        Node declaration = self.kernel.declaration;
        int sourceOrdinal = 0;
        int arrayOrdinal = 0;
        int binding = 0;
        int parameterIndex = 0;
        while (parameterIndex < declaration.params.len) {
            Node parameter = declaration.params.get(parameterIndex);
            string shaderName = "btrc_p_" + Strings.fromInt(sourceOrdinal);
            self.names.put(parameter.name, shaderName);
            self.varTypes.put(parameter.name, parameter.type);
            if (parameter.type.is_array) {
                IRGpuBuffer buffer = IRGpuBuffer(parameter.name,
                    self.gpuWgslElementType(parameter.type), binding);
                self.kernel.param_buffers.push(buffer);
                self.arrayLengths.put(parameter.name,
                    "btrc_len_" + Strings.fromInt(arrayOrdinal));
                self.lines.push("@group(0) @binding(" + Strings.fromInt(binding)
                    + ") var<storage, read_write> " + shaderName + ": array<"
                    + buffer.elem_type + ">;");
                binding = binding + 1;
                arrayOrdinal = arrayOrdinal + 1;
            } else {
                string storageType = self.gpuWgslScalarType(parameter.type);
                if (storageType == "bool") {
                    storageType = "u32";
                    self.boolUniforms.put(parameter.name, true);
                }
                self.kernel.uniform_params.push(
                    IRGpuUniform(parameter.name, storageType));
                self.uniforms.put(parameter.name, true);
            }
            sourceOrdinal = sourceOrdinal + 1;
            parameterIndex = parameterIndex + 1;
        }
        Node returnType = declaration.return_type;
        if (returnType != null && returnType.base != "void") {
            if (!returnType.is_array) {
                self.gpuLoweringFail(returnType,
                    "GPU return type must be void, int[], or float[]");
            }
            self.kernel.output_buffer = IRGpuBuffer("_output",
                self.gpuWgslElementType(returnType), binding);
            self.lines.push("@group(0) @binding(" + Strings.fromInt(binding)
                + ") var<storage, read_write> _output: array<"
                + self.kernel.output_buffer.elem_type + ">;");
            binding = binding + 1;
            self.hasOutput = true;
        }
        self.lines.push("");
        self.lines.push("struct Uniforms {");
        int uniformIndex = 0;
        while (uniformIndex < self.kernel.uniform_params.len) {
            IRGpuUniform uniform = self.kernel.uniform_params.get(uniformIndex);
            self.lines.push("    " + self.names.get(uniform.name) + ": "
                + uniform.storage_type + ",");
            uniformIndex = uniformIndex + 1;
        }
        int arrayIndex = 0;
        while (arrayIndex < self.kernel.param_buffers.len) {
            IRGpuBuffer buffer = self.kernel.param_buffers.get(arrayIndex);
            self.lines.push("    " + self.arrayLengths.get(buffer.name) + ": i32,");
            arrayIndex = arrayIndex + 1;
        }
        self.lines.push("    btrc_off: i32,");
        self.lines.push("    btrc_n: i32,");
        self.lines.push("}");
        self.lines.push("@group(0) @binding(" + Strings.fromInt(binding)
            + ") var<uniform> uniforms: Uniforms;");
        binding = binding + 1;
        self.lines.push("struct BtrcStatus { code: atomic<u32>, }");
        self.lines.push("@group(0) @binding(" + Strings.fromInt(binding)
            + ") var<storage, read_write> btrc_status: BtrcStatus;");
        self.lines.push("");
        self.lines.push("@compute @workgroup_size(64)");
        self.lines.push("fn main(@builtin(global_invocation_id) gid: vec3<u32>) {");
        self.line("let btrc_gid: i32 = i32(gid.x) + uniforms.btrc_off;");
        self.line("if (btrc_gid >= uniforms.btrc_n) { return; }");
        if (declaration.body_node != null) {
            self.gpuEmitBlock(declaration.body_node);
        }
        self.lines.push("}");
        return self.finish();
    }


}
