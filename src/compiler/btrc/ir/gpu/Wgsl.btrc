/* Stateful WGSL emission for one GPU kernel. */

import Library.Map;
import Library.Strings;
import Library.Vector;

import ../../analyzer/GPU.btrc;
import ../../generated/ast/Node.btrc;
import ../../syntax/Literals.btrc;
import ../Model.btrc;



class GpuScopeBinding {
	public string source;
	public string previousName;
	public Node previousType;
	public bool hadName;
	public bool hadType;

	public GpuScopeBinding(string source) {
		self.source = source;
		self.previousName = "";
		self.previousType = null;
		self.hadName = false;
		self.hadType = false;
	}
}



class GpuWgslEmitter {
	private GpuSemantics semantics;
	private IRGpuKernel kernel;
	private Vector<string> lines;
	private int indent;
	private int nextLocal;
	private int nextValue;
	private Map<string, string> names;
	private Map<string, Node> varTypes;
	private Map<string, bool> uniforms;
	private Map<string, bool> boolUniforms;
	private Map<string, string> arrayLengths;
	private Vector<GpuScopeBinding> bindings;
	private Vector<int> scopeStarts;
	private bool hasOutput;

	public GpuWgslEmitter(GpuSemantics semantics, IRGpuKernel kernel) {
		self.semantics = semantics;
		self.kernel = kernel;
		self.lines = [];
		self.indent = 1;
		self.nextLocal = 0;
		self.nextValue = 0;
		self.names = {};
		self.varTypes = {};
		self.uniforms = {};
		self.boolUniforms = {};
		self.arrayLengths = {};
		self.bindings = [];
		self.scopeStarts = [];
		self.hasOutput = kernel.outputBuffer != null;
	}

	private void line(string value) {
		string prefix = "";
		int index = 0;
		while (index < self.indent) {
			prefix = prefix + "    ";
			index = index + 1;
		}
		self.lines.push(prefix + value);
	}

	private string freshValue() {
		string value = "btrc_e_" + Strings.fromInt(self.nextValue);
		self.nextValue = self.nextValue + 1;
		return value;
	}

	private string declareName(string source) {
		GpuScopeBinding binding = GpuScopeBinding(source);
		if (self.names.has(source)) {
			binding.hadName = true;
			binding.previousName = self.names.get(source);
		}
		if (self.varTypes.has(source)) {
			binding.hadType = true;
			binding.previousType = self.varTypes.get(source);
		}
		self.bindings.push(binding);
		string value = "btrc_v_" + Strings.fromInt(self.nextLocal);
		self.nextLocal = self.nextLocal + 1;
		self.names.put(source, value);
		return value;
	}

	private void pushScope() { self.scopeStarts.push(self.bindings.len); }

	private void popScope() {
		if (self.scopeStarts.len == 0) { return; }
		int start = self.scopeStarts.pop();
		while (self.bindings.len > start) {
			GpuScopeBinding binding = self.bindings.pop();
			if (binding.hadName) {
				self.names.put(binding.source, binding.previousName);
			} else {
				self.names.remove(binding.source);
			}
			if (binding.hadType) {
				self.varTypes.put(binding.source, binding.previousType);
			} else {
				self.varTypes.remove(binding.source);
			}
		}
	}

	private string lookupName(Node at, string source) {
		if (!self.names.has(source)) {
			self.gpuLoweringFail(at, "identifier '" + source + "' is not available in WGSL scope");
		}
		return self.names.get(source);
	}

	private Node? typeOf(Node expression) { return self.semantics.contextualExprType(expression, self.varTypes); }

	private string expr(Node expression) { return self.gpuWgslExpr(expression); }

	private void stmt(Node statement) { self.gpuWgslStmt(statement); }

	private string finish() {
		string result = "";
		int index = 0;
		while (index < self.lines.len) {
			if (index > 0) { result = result + "\n"; }
			result = result + self.lines.get(index);
			index = index + 1;
		}
		return result;
	}

	/* The analyzer's GpuKernelValidator has already proven the kernel; a
	 * failure here is a compiler invariant, never a user diagnostic. */
	private void gpuLoweringFail(Node? at, string message) {
		int line = 0;
		int col = 0;
		if (at != null) { line = at.line; col = at.col; }
		fprintf(stderr, "error: @gpu lowering at %d:%d: %s\n", line, col, message);
		exit(1);
	}

	private string gpuWgslScalarType(Node? type) {
		if (type != null && type.base == "int") { return "i32"; }
		if (type != null && type.base == "float") { return "f32"; }
		if (type != null && type.base == "bool") { return "bool"; }
		string name = type == null ? "void" : type.base;
		self.gpuLoweringFail(type, "type '" + name + "' has no WGSL scalar representation");
		return "i32";
	}

	private string gpuWgslElementType(Node? type) { return self.gpuWgslScalarType(type); }

	private string gpuWgslFloatLiteral(Node expression) {
		string raw = expression.raw;
		if (raw == "") { raw = Strings.fromFloat(expression.valueFloat); }
		if (raw.endsWith("f") || raw.endsWith("F")) {
			raw = raw.substring(0, raw.length() - 1);
		}
		if (raw.indexOf(".") < 0 && raw.indexOf("e") < 0 && raw.indexOf("E") < 0) {
			raw = raw + ".0";
		}
		return raw;
	}

	private string gpuExprBase(Node? expression) {
		if (expression == null) { return ""; }
		Node? type = self.typeOf(expression);
		if (type != null) { return type.base; }
		return "";
	}

	private string gpuCoerceText(string value, string source, string target) {
		if (source == "" || target == "" || source == target) { return value; }
		if (source == "bool" && target == "int") {
			return "select(0, 1, " + value + ")";
		}
		if (source == "bool" && target == "float") {
			return "select(0.0, 1.0, " + value + ")";
		}
		if (target == "bool" && source == "int") {
			return "(" + value + " != 0)";
		}
		if (target == "bool" && source == "float") {
			return "(" + value + " != 0.0)";
		}
		if (source == "int" && target == "float") { return "f32(" + value + ")"; }
		if (source == "float" && target == "int") { return "i32(" + value + ")"; }
		return value;
	}

	private string gpuCoercedExpr(Node expression, string target) { return self.gpuCoerceText(self.expr(expression), self.gpuExprBase(expression), target); }

	private void gpuSignalStatus(int code) { self.line("_ = atomicMax(&btrc_status.code, " + Strings.fromInt(code) + "u);"); }

	private string gpuCheckedDivmod(string op, string left, string right, string resultBase) {
		string wgslType = resultBase == "float" ? "f32" : "i32";
		string zero = resultBase == "float" ? "0.0" : "0";
		string leftName = self.freshValue();
		string rightName = self.freshValue();
		string result = self.freshValue();
		self.line("let " + leftName + ": " + wgslType + " = " + left + ";");
		self.line("let " + rightName + ": " + wgslType + " = " + right + ";");
		self.line("var " + result + ": " + wgslType + " = " + zero + ";");
		self.line("if (" + rightName + " == " + zero + ") {");
		self.indent = self.indent + 1;
		self.gpuSignalStatus(op == "/" ? 2 : 3);
		self.indent = self.indent - 1;
		if (resultBase == "int") {
			self.line("} else if (" + leftName + " == -2147483648 && " + rightName + " == -1) {");
			self.indent = self.indent + 1;
			if (op == "/") {
				self.gpuSignalStatus(4);
			} else {
				self.line(result + " = 0;");
			}
			self.indent = self.indent - 1;
		}
		self.line("} else {");
		self.indent = self.indent + 1;
		self.line(result + " = " + leftName + " " + op + " " + rightName + ";");
		self.indent = self.indent - 1;
		self.line("}");
		return result;
	}

	private string gpuCheckedArrayAccess(Node at, string source, string index) {
		if (!self.arrayLengths.has(source)) {
			self.gpuLoweringFail(at, "WGSL array '" + source + "' has no length metadata");
		}
		string array = self.gpuIdentifier(at, source);
		string indexName = self.freshValue();
		string validName = self.freshValue();
		string safeName = self.freshValue();
		string length = "uniforms." + self.arrayLengths.get(source);
		self.line("let " + indexName + ": i32 = " + index + ";");
		self.line("let " + validName + ": bool = (" + indexName + " >= 0 && " + indexName + " < " + length + ");");
		self.line("if (!" + validName + ") {");
		self.indent = self.indent + 1;
		self.gpuSignalStatus(1);
		self.indent = self.indent - 1;
		self.line("}");
		self.line("let " + safeName + ": i32 = select(0, " + indexName + ", " + validName + ");");
		return array + "[" + safeName + "]";
	}

	private string gpuCheckedIndex(Node expression) {
		if (expression.obj == null || expression.obj.kind != NK_IDENTIFIER) {
			self.gpuLoweringFail(expression, "WGSL checked indexing requires an array parameter");
		}
		return self.gpuCheckedArrayAccess(expression, expression.obj.name, self.expr(expression.index));
	}

	private string gpuIdentifier(Node at, string source) {
		string mapped = self.lookupName(at, source);
		if (self.uniforms.has(source)) {
			if (self.boolUniforms.has(source)) {
				return "(uniforms." + mapped + " != 0u)";
			}
			return "uniforms." + mapped;
		}
		return mapped;
	}

	private string gpuWgslBinary(Node expression) {
		string op = expression.op;
		if (op == "&&" || op == "||") {
			string left = self.expr(expression.left);
			string result = self.freshValue();
			self.line("var " + result + ": bool = " + left + ";");
			string condition = op == "&&" ? result : "!" + result;
			self.line("if (" + condition + ") {");
			self.indent = self.indent + 1;
			string right = self.expr(expression.right);
			self.line(result + " = " + right + ";");
			self.indent = self.indent - 1;
			self.line("}");
			return result;
		}
		bool direct = op == "+" || op == "-" || op == "*" || op == "/" || op == "%" || op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "&" || op == "|" || op == "^" || op == "<<" || op == ">>";
		if (!direct) { self.gpuLoweringFail(expression, "unsupported WGSL binary expression"); }
		string leftType = self.gpuExprBase(expression.left);
		string rightType = self.gpuExprBase(expression.right);
		string left = self.expr(expression.left);
		string right = self.expr(expression.right);
		if (op == "^" && leftType == "bool") {
			return "(" + left + " != " + right + ")";
		}
		if ((leftType == "int" && rightType == "float") || (leftType == "float" && rightType == "int")) {
			left = self.gpuCoerceText(left, leftType, "float");
			right = self.gpuCoerceText(right, rightType, "float");
		}
		if (op == "/" || op == "%") {
			string resultBase = leftType == "float" || rightType == "float" ? "float" : "int";
			return self.gpuCheckedDivmod(op, left, right, resultBase);
		}
		if (op == "<<" || op == ">>") {
			right = "u32(" + right + ")";
		}
		return "(" + left + " " + op + " " + right + ")";
	}

	private string gpuWgslCall(Node expression) {
		if (expression.callee == null || expression.callee.kind != NK_IDENTIFIER) {
			self.gpuLoweringFail(expression, "unsupported WGSL call expression");
		}
		string name = expression.callee.name;
		if (name == "gpu_id") { return "btrc_gid"; }
		if (!self.semantics.builtin(name)) {
			self.gpuLoweringFail(expression, "unsupported WGSL call expression");
		}
		if (name == "round") {
			string value = self.expr(expression.args().get(0));
			string temporary = self.freshValue();
			self.line("let " + temporary + ": f32 = " + value + ";");
			string away = "select(ceil(" + temporary + " - 0.5), floor(" + temporary + " + 0.5), " + temporary + " >= 0.0)";
			return "select(" + away + ", " + temporary + ", " + temporary + " == 0.0)";
		}
		string arguments = "";
		int index = 0;
		while (index < expression.args().len) {
			if (index > 0) { arguments = arguments + ", "; }
			arguments = arguments + self.expr(expression.args().get(index));
			index = index + 1;
		}
		return name + "(" + arguments + ")";
	}

	private string gpuWgslAssignment(Node assignment) {
		string target = self.expr(assignment.target);
		string targetBase = self.gpuExprBase(assignment.target);
		string value = self.gpuCoercedExpr(assignment.valueNode, targetBase);
		string op = assignment.op;
		if (op == "/=" || op == "%=") {
			string checked = self.gpuCheckedDivmod(op.substring(0, 1), target, value, targetBase == "" ? "int" : targetBase);
			return target + " = " + checked;
		}
		if (op == "^=" && targetBase == "bool") {
			return target + " = (" + target + " != " + value + ")";
		}
		if (op == "<<=" || op == ">>=") {
			return target + " " + op + " u32(" + value + ")";
		}
		return target + " " + op + " " + value;
	}

	private string gpuWgslTernary(Node expression) {
		string target = self.gpuExprBase(expression);
		string temporary = self.freshValue();
		string condition = self.expr(expression.condition);
		self.line("var " + temporary + ": " + self.gpuWgslScalarType(self.typeOf(expression)) + ";");
		self.line("if (" + condition + ") {");
		self.indent = self.indent + 1;
		string yes = self.gpuCoercedExpr(expression.trueExpr, target);
		self.line(temporary + " = " + yes + ";");
		self.indent = self.indent - 1;
		self.line("} else {");
		self.indent = self.indent + 1;
		string no = self.gpuCoercedExpr(expression.falseExpr, target);
		self.line(temporary + " = " + no + ";");
		self.indent = self.indent - 1;
		self.line("}");
		return temporary;
	}

	private string gpuWgslExpr(Node expression) {
		if (expression == null) { self.gpuLoweringFail(expression, "missing WGSL expression"); }
		if (expression.kind == NK_INT_LITERAL) {
			/* Only `-2147483648` reaches WGSL with a literal outside int. */
			if (IntegerLiteral(expression.raw).details().magnitude == 2147483648ULL) { return "2147483648"; }
			return Strings.fromInt(expression.valueInt);
		}
		if (expression.kind == NK_FLOAT_LITERAL) { return self.gpuWgslFloatLiteral(expression); }
		if (expression.kind == NK_BOOL_LITERAL) { return expression.valueBool ? "true" : "false"; }
		if (expression.kind == NK_IDENTIFIER) { return self.gpuIdentifier(expression, expression.name); }
		if (expression.kind == NK_BINARY_EXPR) { return self.gpuWgslBinary(expression); }
		if (expression.kind == NK_UNARY_EXPR) {
			string operand = self.expr(expression.operand);
			if (expression.op == "++" || expression.op == "--") {
				if (self.gpuExprBase(expression.operand) == "float") {
					return operand + (expression.op == "++" ? " += 1.0" : " -= 1.0");
				}
				return operand + expression.op;
			}
			if (expression.op == "+") { return operand; }
			if (expression.op == "!" || expression.op == "~" || expression.op == "-") {
				return "(" + expression.op + operand + ")";
			}
			self.gpuLoweringFail(expression, "unsupported WGSL unary expression");
		}
		if (expression.kind == NK_CALL_EXPR) { return self.gpuWgslCall(expression); }
		if (expression.kind == NK_INDEX_EXPR) { return self.gpuCheckedIndex(expression); }
		if (expression.kind == NK_ASSIGN_EXPR) { return self.gpuWgslAssignment(expression); }
		if (expression.kind == NK_TERNARY_EXPR) { return self.gpuWgslTernary(expression); }
		if (expression.kind == NK_CAST_EXPR) {
			string inner = self.expr(expression.expr);
			return self.gpuCoerceText(inner, self.gpuExprBase(expression.expr), expression.targetType.base);
		}
		self.gpuLoweringFail(expression, "unsupported WGSL expression");
		return "0";
	}

	private void gpuEmitScoped(Node? block) {
		if (block == null) { return; }
		self.pushScope();
		for statement in block.statements() {
			self.stmt(statement);
		}
		self.popScope();
	}

	private void gpuEmitExpressionStatement(Node expression) {
		bool update = expression.kind == NK_ASSIGN_EXPR || (expression.kind == NK_UNARY_EXPR && (expression.op == "++" || expression.op == "--"));
		if (!update && expression.kind != NK_CALL_EXPR) {
			self.gpuLoweringFail(expression, "unsupported WGSL expression statement");
		}
		string rendered = self.expr(expression);
		if (expression.kind == NK_CALL_EXPR) {
			self.line("_ = " + rendered + ";");
		} else {
			self.line(rendered + ";");
		}
	}

	private void gpuEmitVarDecl(Node statement) {
		Node? type = statement.type;
		if (type == null && statement.initializer != null) {
			type = self.typeOf(statement.initializer);
		}
		string targetBase = type == null ? "" : type.base;
		string initial = "";
		if (statement.initializer != null) {
			initial = " = " + self.gpuCoercedExpr(statement.initializer, targetBase);
		}
		string name = self.declareName(statement.name);
		if (type != null) { self.varTypes.put(statement.name, type); }
		self.line("var " + name + ": " + self.gpuWgslScalarType(type) + initial + ";");
	}

	private void gpuEmitReturn(Node statement) {
		if (statement.valueNode != null && self.hasOutput) {
			Node value = statement.valueNode;
			Node? valueType = self.typeOf(value);
			string valueBase = valueType == null ? "" : valueType.base;
			string rendered = "";
			if (valueType != null && valueType.isArray) {
				if (value.kind != NK_IDENTIFIER) {
					self.gpuLoweringFail(value, "unsupported WGSL array return");
				}
				rendered = self.gpuCheckedArrayAccess(value, value.name, "btrc_gid");
			} else {
				rendered = self.expr(value);
			}
			string target = self.kernel.declaration.returnType.base;
			self.line("_output[btrc_gid] = " + self.gpuCoerceText(rendered, valueBase, target) + ";");
		}
		self.line("return;");
	}

	private void gpuEmitIf(Node statement) {
		string condition = self.expr(statement.condition);
		self.line("if (" + condition + ") {");
		self.indent = self.indent + 1;
		self.gpuEmitScoped(statement.thenBlock);
		self.indent = self.indent - 1;
		if (statement.elseBlock != null && statement.elseBlock.kind == NK_ELSE_BLOCK) {
			self.line("} else {");
			self.indent = self.indent + 1;
			self.gpuEmitScoped(statement.elseBlock.bodyNode);
			self.indent = self.indent - 1;
			self.line("}");
		} else if (statement.elseBlock != null && statement.elseBlock.kind == NK_ELSE_IF) {
			self.line("} else {");
			self.indent = self.indent + 1;
			self.pushScope();
			self.gpuEmitIf(statement.elseBlock.ifStmt);
			self.popScope();
			self.indent = self.indent - 1;
			self.line("}");
		} else {
			self.line("}");
		}
	}

	private void gpuEmitWhile(Node statement) {
		self.line("loop {");
		self.indent = self.indent + 1;
		self.pushScope();
		string condition = self.expr(statement.condition);
		self.line("if (!(" + condition + ")) { break; }");
		self.gpuEmitScoped(statement.bodyNode);
		self.popScope();
		self.indent = self.indent - 1;
		self.line("}");
	}

	private void gpuEmitFor(Node statement) {
		self.line("{");
		self.indent = self.indent + 1;
		self.pushScope();
		if (statement.init != null && statement.init.kind == NK_FOR_INIT_VAR) {
			for declaration in statement.init.declarations() { self.gpuEmitVarDecl(declaration); }
		} else if (statement.init != null && statement.init.kind == NK_FOR_INIT_EXPR) {
			self.gpuEmitExpressionStatement(statement.init.expression);
		}
		self.line("loop {");
		self.indent = self.indent + 1;
		self.pushScope();
		if (statement.condition != null) {
			string condition = self.expr(statement.condition);
			self.line("if (!(" + condition + ")) { break; }");
		}
		self.gpuEmitScoped(statement.bodyNode);
		if (statement.update != null) {
			self.line("continuing {");
			self.indent = self.indent + 1;
			self.gpuEmitExpressionStatement(statement.update);
			self.indent = self.indent - 1;
			self.line("}");
		}
		self.popScope();
		self.indent = self.indent - 1;
		self.line("}");
		self.popScope();
		self.indent = self.indent - 1;
		self.line("}");
	}

	private void gpuWgslStmt(Node statement) {
		if (statement.kind == NK_VAR_DECL_STMT) { self.gpuEmitVarDecl(statement); return; }
		if (statement.kind == NK_RETURN_STMT) { self.gpuEmitReturn(statement); return; }
		if (statement.kind == NK_IF_STMT) { self.gpuEmitIf(statement); return; }
		if (statement.kind == NK_WHILE_STMT) { self.gpuEmitWhile(statement); return; }
		if (statement.kind == NK_C_FOR_STMT) { self.gpuEmitFor(statement); return; }
		if (statement.kind == NK_EXPR_STMT) { self.gpuEmitExpressionStatement(statement.expr); return; }
		if (statement.kind == NK_BREAK_STMT) { self.line("break;"); return; }
		if (statement.kind == NK_CONTINUE_STMT) { self.line("continue;"); return; }
		self.gpuLoweringFail(statement, "unsupported WGSL statement");
	}

	public string emit() {
		Node declaration = self.kernel.declaration;
		/* Shader names number the buffers first and the uniforms after them,
		 * each group in parameter order, exactly as the Python emitter does. */
		int arrayCount = 0;
		for counted in declaration.params() {
			if (counted.type.isArray) { arrayCount = arrayCount + 1; }
		}
		int arrayOrdinal = 0;
		int uniformOrdinal = 0;
		int binding = 0;
		for parameter in declaration.params() {
			self.varTypes.put(parameter.name, parameter.type);
			if (parameter.type.isArray) {
				string shaderName = "btrc_p_" + Strings.fromInt(arrayOrdinal);
				self.names.put(parameter.name, shaderName);
				IRGpuBuffer buffer = IRGpuBuffer(parameter.name, self.gpuWgslElementType(parameter.type), binding);
				self.kernel.paramBuffers.push(buffer);
				self.arrayLengths.put(parameter.name, "btrc_len_" + Strings.fromInt(arrayOrdinal));
				self.lines.push("@group(0) @binding(" + Strings.fromInt(binding) + ") var<storage, read_write> " + shaderName + ": array<" + buffer.elemType + ">;");
				binding = binding + 1;
				arrayOrdinal = arrayOrdinal + 1;
			} else {
				self.names.put(parameter.name, "btrc_p_" + Strings.fromInt(arrayCount + uniformOrdinal));
				string storageType = self.gpuWgslScalarType(parameter.type);
				if (storageType == "bool") {
					storageType = "u32";
					self.boolUniforms.put(parameter.name, true);
				}
				self.kernel.uniformParams.push(IRGpuUniform(parameter.name, storageType));
				self.uniforms.put(parameter.name, true);
				uniformOrdinal = uniformOrdinal + 1;
			}
		}
		Node returnType = declaration.returnType;
		if (returnType != null && returnType.base != "void") {
			if (!returnType.isArray) {
				self.gpuLoweringFail(returnType, "unsupported WGSL return type");
			}
			self.kernel.outputBuffer = IRGpuBuffer("_output", self.gpuWgslElementType(returnType), binding);
			self.lines.push("@group(0) @binding(" + Strings.fromInt(binding) + ") var<storage, read_write> _output: array<" + self.kernel.outputBuffer.elemType + ">;");
			binding = binding + 1;
			self.hasOutput = true;
		}
		self.lines.push("");
		self.lines.push("struct Uniforms {");
		int uniformIndex = 0;
		while (uniformIndex < self.kernel.uniformParams.len) {
			IRGpuUniform uniform = self.kernel.uniformParams.get(uniformIndex);
			self.lines.push("    " + self.names.get(uniform.name) + ": " + uniform.storageType + ",");
			uniformIndex = uniformIndex + 1;
		}
		int arrayIndex = 0;
		while (arrayIndex < self.kernel.paramBuffers.len) {
			IRGpuBuffer buffer = self.kernel.paramBuffers.get(arrayIndex);
			self.lines.push("    " + self.arrayLengths.get(buffer.name) + ": i32,");
			arrayIndex = arrayIndex + 1;
		}
		self.lines.push("    btrc_off: i32,");
		self.lines.push("    btrc_n: i32,");
		self.lines.push("}");
		self.lines.push("@group(0) @binding(" + Strings.fromInt(binding) + ") var<uniform> uniforms: Uniforms;");
		binding = binding + 1;
		self.lines.push("");
		self.lines.push("struct BtrcStatus { code: atomic<u32>, }");
		self.lines.push("@group(0) @binding(" + Strings.fromInt(binding) + ") var<storage, read_write> btrc_status: BtrcStatus;");
		self.lines.push("");
		self.lines.push("@compute @workgroup_size(64)");
		self.lines.push("fn main(@builtin(global_invocation_id) gid: vec3<u32>) {");
		self.line("let btrc_gid: i32 = i32(gid.x) + uniforms.btrc_off;");
		self.line("if (btrc_gid >= uniforms.btrc_n) { return; }");
		self.gpuEmitScoped(declaration.bodyNode);
		self.lines.push("}");
		return self.finish();
	}
}
