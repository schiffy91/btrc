/* Runtime-helper discovery and transitive closure over surviving structured IR. */

import Library.Map;
import Library.Vector;

import ../Model.btrc;
import ./Catalog.btrc;

class RuntimeReferenceCollector {
	private RuntimeHelperCatalog catalog;
	/* Hosted headers live structured IR needs directly, as Python's
	 * IROptimizer._structured_runtime_headers derives them: <setjmp.h> for a
	 * setjmp call, <stdatomic.h> for atomic types, calls and constants, and
	 * the compute runtime header for a call into it. */
	private Map<string, bool> structuredHeaders = {};
	private Map<string, bool> definedFunctions = {};

	public RuntimeReferenceCollector(RuntimeHelperCatalog catalog) { self.catalog = catalog; }

	/* The headers found by the last requiredBy walk. */
	public Map<string, bool> requiredHeaders() { return self.structuredHeaders; }

	public Map<string, bool> requiredBy(IRModule module) {
		Vector<string> canonicalOrder = self.catalog.order();
		Map<string, bool> used = {};
		self.structuredHeaders = {};
		self.definedFunctions = {};
		for definition in module.functions { self.definedFunctions.put(definition.name, true); }

		int functionIndex = 0;
		while (functionIndex < module.functions.len) {
			IRFunction definition = module.functions.get(functionIndex);
			if (definition.body != null) {
				self.collectNode(definition.body, used);
			}
			functionIndex = functionIndex + 1;
		}

		for declaration in module.objectiveCClasses {
			for method in declaration.methods { self.collectNode(method.body, used); }
		}
		int globalIndex = 0;
		while (globalIndex < module.globalDecls.len) {
			self.collectNode(module.globalDecls.get(globalIndex).init, used);
			globalIndex = globalIndex + 1;
		}

		self.collectMacroReferences(module, canonicalOrder, used);
		self.collectStructuredRoots(module, used);
		self.closeDeclaredDependencies(used);
		return used;
	}

	private bool isIdentifierChar(char character) { return (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') || (character >= '0' && character <= '9') || character == '_'; }

	private bool isIdentifierStart(char character) { return (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') || character == '_'; }

	private int skipQuoted(string source, int start) {
		char quote = source[start];
		int index = start + 1;
		while (index < source.length()) {
			if (source[index] == '\\') {
				index = index + 2;
			} else if (source[index] == quote) {
				return index + 1;
			} else {
				index = index + 1;
			}
		}
		return source.length();
	}

	private void scanTextForNames(string source, Vector<string> names, Map<string, bool> references) {
		Map<string, bool> candidates = {};
		int nameIndex = 0;
		while (nameIndex < names.len) {
			candidates.put(names.get(nameIndex), true);
			nameIndex = nameIndex + 1;
		}

		int index = 0;
		while (index < source.length()) {
			char current = source[index];
			if (current == '"' || current == '\'') {
				index = self.skipQuoted(source, index);
			} else if (current == '/' && index + 1 < source.length() && source[index + 1] == '/') {
				index = index + 2;
				while (index < source.length() && source[index] != '\n') {
					index = index + 1;
				}
			} else if (current == '/' && index + 1 < source.length() && source[index + 1] == '*') {
				index = index + 2;
				while (index + 1 < source.length() && !(source[index] == '*' && source[index + 1] == '/')) {
					index = index + 1;
				}
				index = index + 2;
			} else if (self.isIdentifierStart(current)) {
				int end = index + 1;
				while (end < source.length() && self.isIdentifierChar(source[end])) {
					end = end + 1;
				}
				string identifier = source.substring(index, end - index);
				if (candidates.has(identifier)) {
					references.put(identifier, true);
				}
				index = end;
			} else {
				index = index + 1;
			}
		}
	}

	private void collectStructuredHeaders(IRNode node) {
		if (node.kind == IRK_CALL) {
			if (((IRCallPayload)node.payload).callee == "setjmp") { self.structuredHeaders.put("setjmp.h", true); }
			if (((IRCallPayload)node.payload).callee.startsWith("atomic_")) { self.structuredHeaders.put("stdatomic.h", true); }
			if (((IRCallPayload)node.payload).callee.startsWith("btrc_gpu_") && !self.definedFunctions.has(((IRCallPayload)node.payload).callee)) {
				self.structuredHeaders.put("btrc_gpu_compute_internal.h", true);
			}
		}
		if (node.kind == IRK_VAR && (node.name.startsWith("memory_order_") || node.name.startsWith("ATOMIC_"))) {
			self.structuredHeaders.put("stdatomic.h", true);
		}
	}

	private void collectTypeProviderReferences(string cType, Map<string, bool> used) {
		if (cType.contains("_Atomic(") || cType == "memory_order") { self.structuredHeaders.put("stdatomic.h", true); }
		int length = cType.length();
		int index = 0;
		while (index < length) {
			while (index < length && !self.isIdentifierChar(cType[index])) {
				index = index + 1;
			}
			int start = index;
			while (index < length && self.isIdentifierChar(cType[index])) {
				index = index + 1;
			}
			if (start < index) {
				string identifier = cType.substring(start, index - start);
				string provider = self.catalog.helperProvidingType(identifier);
				if (provider != "") { used.put(provider, true); }
			}
		}
	}

	private void collectObjectProviderReference(string name, Map<string, bool> used) {
		string provider = self.catalog.helperProvidingObject(name);
		if (provider != "") { used.put(provider, true); }
	}

	/* A record's fields, including those of its anonymous members. */
	private void collectStructFields(Vector<IRStructField> fields, Map<string, bool> used) {
		for field in fields {
			self.collectTypeProviderReferences(field.cType, used);
			self.collectNode(field.arraySize, used);
			Vector<IRStructField>? record = field.recordFields;
			if (record != null) { self.collectStructFields(record, used); }
		}
	}

	private void collectNode(IRNode? node, Map<string, bool> used) {
		if (node == null) { return; }
		int domain = node.payloadDomain();
		if (domain == IR_PAYLOAD_CALL) {
			if (((IRCallPayload)node.payload).callee != "" && !used.has(((IRCallPayload)node.payload).callee) && self.catalog.has(((IRCallPayload)node.payload).callee)) {
				used.put(((IRCallPayload)node.payload).callee, true);
			}
			if (((IRCallPayload)node.payload).helperRef != "" && !used.has(((IRCallPayload)node.payload).helperRef) && self.catalog.has(((IRCallPayload)node.payload).helperRef)) {
				used.put(((IRCallPayload)node.payload).helperRef, true);
			}
		}
		if (node.kind == IRK_FUNCTION_REF && !used.has(node.name) && self.catalog.has(node.name)) {
			used.put(node.name, true);
		}
		if (domain == IR_PAYLOAD_DECLARATION) { self.collectTypeProviderReferences(((IRDeclarationPayload)node.payload).cType, used); }
		if (domain == IR_PAYLOAD_CONVERSION_AGGREGATE) { self.collectTypeProviderReferences(((IRConversionPayload)node.payload).targetType, used); }
		if (domain == IR_PAYLOAD_NATIVE) {
			self.collectTypeProviderReferences(((IRNativePayload)node.payload).targetType, used);
			if (((IRNativePayload)node.payload).params != null) {
				for (int index = 0; index < ((IRNativePayload)node.payload).params.len; index++) { self.collectTypeProviderReferences(((IRNativePayload)node.payload).params.get(index).cType, used); }
			}
		}
		if (domain == IR_PAYLOAD_CALL && ((IRCallPayload)node.payload).cleanupSlot != null) {
			self.collectTypeProviderReferences(((IRCallPayload)node.payload).cleanupSlot.cType, used);
		}
		if (domain == IR_PAYLOAD_DECLARATION && ((IRDeclarationPayload)node.payload).cleanupSlot != null) {
			self.collectTypeProviderReferences(((IRDeclarationPayload)node.payload).cleanupSlot.cType, used);
		}
		if (node.kind == IRK_VAR) {
			self.collectObjectProviderReference(node.name, used);
		}
		self.collectStructuredHeaders(node);

		self.collectNode(node.left, used);
		self.collectNode(node.right, used);
		self.collectNode(domain == IR_PAYLOAD_UNARY ? ((IRUnaryPayload)node.payload).operand : domain == IR_PAYLOAD_CONVERSION_AGGREGATE ? ((IRConversionPayload)node.payload).operand : null, used);
		self.collectNode(node.expr, used);
		self.collectNode(domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).obj : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).obj : null, used);
		self.collectNode(domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).index : null, used);
		self.collectNode(domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).condition : null, used);
		self.collectNode(domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).trueExpr : null, used);
		self.collectNode(domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).falseExpr : null, used);
		self.collectNode(domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).init : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).init : null, used);
		self.collectNode(domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).value : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).value : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).value : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).value : null, used);
		self.collectNode(domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).target : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).target : null, used);
		self.collectNode(domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).thenBlock : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).thenBlock : null, used);
		self.collectNode(domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).elseBlock : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).elseBlock : null, used);
		self.collectNode(domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).body : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).body : null, used);
		self.collectNode(domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).update : null, used);
		self.collectNode(domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).result : null, used);
		self.collectNode(domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).arraySize : null, used);

		int argumentIndex = 0;
		while (argumentIndex < node.args().len) {
			self.collectNode(node.args().get(argumentIndex), used);
			argumentIndex = argumentIndex + 1;
		}
		int statementIndex = 0;
		while (statementIndex < node.stmts().len) {
			self.collectNode(node.stmts().get(statementIndex), used);
			statementIndex = statementIndex + 1;
		}
	}

	private void collectMacroReferences(IRModule module, Vector<string> canonicalOrder, Map<string, bool> used) {
		int declarationIndex = 0;
		while (declarationIndex < module.preprocessorDecls.len) {
			IRPreprocessorDecl declaration = module.preprocessorDecls.get(declarationIndex);
			if (declaration.kind == IR_PREPROCESSOR_MACRO) {
				Map<string, bool> macroHelpers = {};
				self.scanTextForNames(declaration.replacement, canonicalOrder, macroHelpers);
				Vector<string> names = macroHelpers.keys();
				int nameIndex = 0;
				while (nameIndex < names.len) {
					used.put(names.get(nameIndex), true);
					nameIndex = nameIndex + 1;
				}
			}
			declarationIndex = declarationIndex + 1;
		}
	}

	private void closeDeclaredDependencies(Map<string, bool> used) {
		Vector<string> worklist = used.keys();
		while (worklist.len > 0) {
			string current = worklist.pop();
			Vector<string> dependencies = self.catalog.dependencies(current);
			int dependencyIndex = 0;
			while (dependencyIndex < dependencies.len) {
				string dependency = dependencies.get(dependencyIndex);
				if (!used.has(dependency)) {
					used.put(dependency, true);
					worklist.push(dependency);
				}
				dependencyIndex = dependencyIndex + 1;
			}
		}
	}

	private void collectStructuredRoots(IRModule module, Map<string, bool> used) {
		for declaration in module.objectiveCClasses {
			for field in declaration.fields { self.collectTypeProviderReferences(field.cType, used); }
			for method in declaration.methods {
				self.collectTypeProviderReferences(method.returnType, used);
				for parameter in method.params { self.collectTypeProviderReferences(parameter.cType, used); }
			}
		}
		int functionIndex = 0;
		while (functionIndex < module.functions.len) {
			IRFunction definition = module.functions.get(functionIndex);
			self.collectTypeProviderReferences(definition.returnType, used);
			int parameterIndex = 0;
			while (parameterIndex < definition.params.len) {
				self.collectTypeProviderReferences(definition.params.get(parameterIndex).cType, used);
				parameterIndex = parameterIndex + 1;
			}
			functionIndex = functionIndex + 1;
		}

		int structIndex = 0;
		while (structIndex < module.structDefs.len) {
			self.collectStructFields(module.structDefs.get(structIndex).fields, used);
			structIndex = structIndex + 1;
		}

		int globalIndex = 0;
		while (globalIndex < module.globalDecls.len) {
			IRGlobalDecl global = module.globalDecls.get(globalIndex);
			self.collectTypeProviderReferences(global.cType, used);
			self.collectNode(global.arraySize, used);
			globalIndex = globalIndex + 1;
		}

		int enumIndex = 0;
		while (enumIndex < module.enumDefs.len) {
			IREnumDef definition = module.enumDefs.get(enumIndex);
			int valueIndex = 0;
			while (valueIndex < definition.values.len) {
				self.collectNode(definition.values.get(valueIndex).value, used);
				valueIndex = valueIndex + 1;
			}
			enumIndex = enumIndex + 1;
		}

		int declarationIndex = 0;
		while (declarationIndex < module.functionDecls.len) {
			IRFunctionDecl declaration = module.functionDecls.get(declarationIndex);
			self.collectTypeProviderReferences(declaration.returnType, used);
			int parameterIndex = 0;
			while (parameterIndex < declaration.params.len) {
				self.collectTypeProviderReferences(declaration.params.get(parameterIndex).cType, used);
				parameterIndex = parameterIndex + 1;
			}
			declarationIndex = declarationIndex + 1;
		}

		int pointerIndex = 0;
		while (pointerIndex < module.functionPointerTypedefs.len) {
			IRFunctionPointerTypedef pointer = module.functionPointerTypedefs.get(pointerIndex);
			self.collectTypeProviderReferences(pointer.returnType, used);
			int parameterIndex = 0;
			while (parameterIndex < pointer.paramTypes.len) {
				self.collectTypeProviderReferences(pointer.paramTypes.get(parameterIndex), used);
				parameterIndex = parameterIndex + 1;
			}
			pointerIndex = pointerIndex + 1;
		}

		int typedefIndex = 0;
		while (typedefIndex < module.typedefDefs.len) {
			self.collectTypeProviderReferences(module.typedefDefs.get(typedefIndex).targetType, used);
			typedefIndex = typedefIndex + 1;
		}

		int taggedIndex = 0;
		while (taggedIndex < module.taggedUnionDefs.len) {
			IRTaggedUnionDef tagged = module.taggedUnionDefs.get(taggedIndex);
			self.collectTypeProviderReferences(tagged.tagType, used);
			int variantIndex = 0;
			while (variantIndex < tagged.variants.len) {
				IRTaggedUnionVariant variant = tagged.variants.get(variantIndex);
				int fieldIndex = 0;
				while (fieldIndex < variant.fields.len) {
					IRStructField field = variant.fields.get(fieldIndex);
					self.collectTypeProviderReferences(field.cType, used);
					self.collectNode(field.arraySize, used);
					fieldIndex = fieldIndex + 1;
				}
				variantIndex = variantIndex + 1;
			}
			taggedIndex = taggedIndex + 1;
		}
	}
}
