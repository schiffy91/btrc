import std.map;
import std.vector;
import ../../analyzer/hosted_abi.btrc;
import ../../analyzer/models.btrc;
import ../../analyzer/operators.btrc;
import ../../analyzer/ownership/values.btrc;
import ../../analyzer/types.btrc;
import ../../generated/ast/node.btrc;
import ../../syntax/identity.btrc;
import ../../syntax/types.btrc;
import ../model.btrc;
import ./context.btrc;
import ./ownership/calls.btrc;
import ./ownership/operands.btrc;
import ./types.btrc;

/* String coercion/format policy and materialization over already-lowered values. */

/* Exact, portable values for C printf-family variadic boundaries. */

class PrintfArg {
    public string formatSpec;
    public IRNode value;

    public PrintfArg(string formatSpec, IRNode value) {
        self.formatSpec = formatSpec;
        self.value = value;
    }
}


/* One target-aware value contract for storage, calls, and returns.
 *
 * Class-to-string conversion is an ownership boundary, not a textual wrapper:
 * the source is evaluated once, an owning source is protected/released, the
 * nullable receiver is guarded, and the synthesized string result is +1.
 */

class PreparedValue {
    public IRNode value;
    public Node? effectiveType;
    public bool owned;
    public bool converted;

    public PreparedValue(IRNode value, Node? effectiveType,
            bool owned, bool converted) {
        self.value = value;
        self.effectiveType = effectiveType;
        self.owned = owned;
        self.converted = converted;
    }
}


class StringLowerer {
    private Analyzed analyzed;
    private HostedAbiRepository hostedAbi;
    private OperatorSemantics operators;
    private ManagedValueSemantics managedValues;
    private LoweringContext context;
    private OwnershipOperandPlanner operandPlanner;
    private CallOwnershipLowerer callOwnership;
    private CTypeLowerer cTypes;

    public StringLowerer(Analyzed analyzed,
            HostedAbiRepository hostedAbi, OperatorSemantics operators,
            ManagedValueSemantics managedValues,
            OwnershipOperandPlanner operandPlanner,
            CallOwnershipLowerer callOwnership,
            LoweringContext context, CTypeLowerer cTypes) {
        self.analyzed = analyzed; self.operators = operators;
        self.hostedAbi = hostedAbi;
        self.managedValues = managedValues;
        self.operandPlanner = operandPlanner;
        self.callOwnership = callOwnership;
        self.context = context; self.cTypes = cTypes;
    }

    public Node? printfCanonicalType(Node? typeExpr) {
        if (typeExpr == null) { return null; }
        Node bodyType = self.cTypes.resolveBodyType(typeExpr, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
        Node? canonical = SemanticTypeSystem.resolveTypedefType(
            bodyType, self.analyzed.typedefTable);
        if (canonical != null) { return canonical; }
        return bodyType;
    }

    public bool printfCStringType(Node typeExpr) {
        int indirections = typeExpr.pointer_depth;
        if (typeExpr.is_array) { indirections = indirections + 1; }
        return typeExpr.base == "char"
            && typeExpr.generic_args.len == 0
            && indirections == 1;
    }

    public string printfFormatSpec(Node? typeExpr) {
        Node? canonicalType = self.printfCanonicalType(typeExpr);
        if (canonicalType == null) { return "%d"; }
        Node canonical = canonicalType;
        string base = canonical.base;
        if (base == "__fn_ptr") { return "%s"; }
        if (SemanticTypeSystem.isString(canonical)
                || self.printfCStringType(canonical)) {
            return "%s";
        }
        if (canonical.is_array
                || self.cTypes.lower(canonical).endsWith("*")) {
            return "%p";
        }
        if (base == "int" || base == "short" || base == "short int"
                || base == "signed int" || base == "signed short"
                || base == "signed short int") { return "%d"; }
        if (base == "byte" || base == "uint" || base == "unsigned int"
                || base == "unsigned short" || base == "unsigned short int"
                || base == "unsigned char") { return "%u"; }
        if (base == "long" || base == "long int" || base == "signed long"
                || base == "signed long int") { return "%ld"; }
        if (base == "unsigned long" || base == "unsigned long int") {
            return "%lu";
        }
        if (base == "long long" || base == "long long int"
                || base == "signed long long"
                || base == "signed long long int") { return "%lld"; }
        if (base == "unsigned long long"
                || base == "unsigned long long int") { return "%llu"; }
        if (base == "size_t") { return "%zu"; }
        if (base == "float" || base == "double") { return "%f"; }
        if (base == "long double") { return "%Lf"; }
        if (base == "char") { return "%c"; }
        if (base == "bool") { return "%s"; }
        return "%d";
    }

    public bool printfByValueAggregate(Node typeExpr) {
        if (typeExpr.pointer_depth > 0 || typeExpr.is_array) { return false; }
        if (typeExpr.base == "Tuple" || typeExpr.base.startsWith("(")) {
            return true;
        }
        return SemanticTypeSystem.resolvedStructName(typeExpr, self.analyzed) != "";
    }

    public PrintfArg adaptPrintfArg(IRNode value,
            Node? valueType, string fallbackFormat) {
        Node? canonicalType = self.printfCanonicalType(valueType);
        string spec = fallbackFormat;
        if (canonicalType != null) {
            spec = self.printfFormatSpec(canonicalType);
            Node canonical = canonicalType;
            bool scalarValue = canonical.pointer_depth == 0
                && !canonical.is_array;
            if (canonical.base == "__fn_ptr" && scalarValue) {
                Vector<IRNode> sequence = [];
                sequence.push(IRNode.cast("void", value));
                sequence.push(IRNode.literal("\"<function>\""));
                return PrintfArg("%s", IRNode.commaExpression(sequence));
            }
            if (canonical.base == "bool" && scalarValue) {
                return PrintfArg("%s", IRNode.ternary(
                    value, IRNode.literal("\"true\""),
                    IRNode.literal("\"false\"")));
            }
            if (canonical.base == "__fn_ptr") {
                return PrintfArg("%p", IRNode.cast("void*", value));
            }
            if (scalarValue && (self.analyzed.enumTable.has(canonical.base)
                    || canonical.base.startsWith("enum "))) {
                return PrintfArg("%d", IRNode.cast("int", value));
            }
            if (scalarValue
                    && self.analyzed.richEnumTable.has(canonical.base)) {
                Vector<IRNode> arguments = [];
                arguments.push(value);
                return PrintfArg("%s", IRNode.call(
                    canonical.base + "_toString", arguments));
            }
            if (self.printfByValueAggregate(canonical)) {
                string token = "\"<struct>\"";
                if (canonical.base == "Tuple"
                        || canonical.base.startsWith("(")) {
                    token = "\"<tuple>\"";
                }
                Vector<IRNode> sequence = [];
                sequence.push(IRNode.cast("void", value));
                sequence.push(IRNode.literal(token));
                return PrintfArg("%s", IRNode.commaExpression(sequence));
            }
        }
        if (spec == "%s") {
            self.context.referenceHelper("__btrc_string_or_empty");
            Vector<IRNode> arguments = [];
            arguments.push(value);
            return PrintfArg(spec, IRNode.call(
                "__btrc_string_or_empty", arguments));
        }
        if (spec == "%p") {
            return PrintfArg(spec, IRNode.cast("void*", value));
        }
        if (spec == "%u") {
            return PrintfArg(spec, IRNode.cast("unsigned int", value));
        }
        return PrintfArg(spec, value);
    }
    public Node? preparedCanonicalType(Node? typeExpr) {
        if (typeExpr == null) { return null; }
        Node concrete = self.cTypes.resolveBodyType(typeExpr, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
        Node? resolved = SemanticTypeSystem.resolveTypedefType(
            concrete, self.analyzed.typedefTable);
        if (resolved != null) { return resolved; }
        return concrete;
    }

    public bool requiresTargetStringConversion(Node? targetType, Node? sourceType) {
        Node? target = self.preparedCanonicalType(targetType);
        Node? source = self.preparedCanonicalType(sourceType);
        return target != null && TypeComposition.isSemanticScalarString(target)
            && self.sourceHasToString(source);
    }

    public string hostedStringConversionMode(Node expression,
            Node? targetType, Node? sourceType) {
        Node? target = self.preparedCanonicalType(targetType);
        Node? source = self.preparedCanonicalType(sourceType);
        if (target == null || source == null
                || !TypeComposition.isSemanticScalarString(target)
                || !self.operators.isCStringPointer(source)) {
            return "";
        }
        if (expression.kind != NK_CALL_EXPR || expression.callee == null
                || expression.callee.kind != NK_IDENTIFIER
                || !self.analyzed.hostedCallKeys.has(
                    AstIdentity.key(expression))) {
            return "reject";
        }
        string effect = self.hostedAbi.returnEffectForCall(
            expression.callee.name, expression);
        if (effect == "fresh"
                && self.hostedAbi.returnDeallocatorForCall(
                    expression.callee.name, expression) == "free") {
            return "adopt";
        }
        if (effect == "alias" || effect == "independent") { return "copy"; }
        return "reject";
    }

    public bool requiresTargetValueConversion(Node expression,
            Node? targetType, Node? sourceType) {
        string hosted = self.hostedStringConversionMode(expression, targetType, sourceType);
        return self.requiresTargetStringConversion(targetType, sourceType)
            || hosted == "adopt" || hosted == "copy";
    }

    public IRNode lowerHostedStringConversion(IRNode lowered, string mode) {
        IRNode value = lowered;
        if (mode == "copy") {
            self.context.referenceHelper("__btrc_strdup");
            Vector<IRNode> copyArguments = [];
            copyArguments.push(value);
            value = IRNode.call("__btrc_strdup", copyArguments);
        }
        self.context.referenceHelper("__btrc_str_track");
        Vector<IRNode> trackArguments = [];
        trackArguments.push(value);
        return IRNode.call("__btrc_str_track", trackArguments);
    }

    public IRNode lowerRequestedHostedStringResult(Node expression, IRNode lowered) {
        if (!self.context.hasHostedConversion(expression)) { return lowered; }
        return self.lowerHostedStringConversion(lowered,
            self.context.hostedConversion(expression));
    }

    public PreparedValue prepareLoweredTargetValue(Node expression, Node? targetType, Node? sourceType,
            IRNode lowered, bool sourceOwned,
            Map<string, Node> varTypes) {
        Node? target = self.preparedCanonicalType(targetType);
        Node? source = self.preparedCanonicalType(sourceType);
        if (!self.requiresTargetStringConversion(target, source)) {
            IRNode value = self.upcastClassPointer(
                target, source, lowered);
            Node? effective = source;
            if (target != null && source != null
                    && self.analyzed.isClass(target.base)
                    && target.generic_args.len == 0
                    && source.base != target.base
                    && self.analyzed.isSubclass(
                        source.base, target.base)) {
                effective = target;
            }
            if (effective == null) { effective = target; }
            return PreparedValue(value, effective, sourceOwned, false);
        }

        self.operandPlanner.requireType(source, expression);
        Node concreteSource = source;
        OwnershipBoundary boundary = self.callOwnership.boundary();
        bool pinBorrowedReceiver = !sourceOwned
            && self.managedValues.isManaged(
                self.cTypes.resolveBodyType(concreteSource, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))
            && expression.kind != NK_SELF_EXPR
            && expression.kind != NK_SUPER_EXPR;
        boundary.addLoweredOperand(expression,
            concreteSource, lowered, sourceOwned, pinBorrowedReceiver);
        IRNode receiver = self.context.expressionOverride(expression);
        IRNode converted = IRNode.ternary(
            IRNode.binary(receiver, "!=", IRNode.literal("NULL")),
            self.toStringCall(concreteSource, receiver),
            IRNode.literal("\"\""));
        boundary.resultOwned = true;
        boundary.restore();
        return PreparedValue(
            boundary.finish(converted, target, false),
            target, true, true);
    }

    public bool sourceHasToString(Node? sourceType) {
        if (sourceType == null || sourceType.is_array
                || self.operators.valueDepth(sourceType) != 1) {
            return false;
        }
        Node? method = null;
        if (self.analyzed.isClass(sourceType.base)) {
            method = self.analyzed.classMethod(sourceType.base, "toString");
        } else if (self.analyzed.isGenericClass(sourceType.base)) {
            method = self.analyzed.genericClassMethod(
                sourceType.base, "toString");
        } else {
            return false;
        }
        return method != null && method.kind == NK_METHOD_DECL
            && method.params.len == 0 && method.return_type != null
            && TypeComposition.isSemanticScalarString(method.return_type);
    }

    public IRNode toStringCall(Node sourceType, IRNode value) {
        string prefix = sourceType.base;
        if (sourceType.generic_args.len > 0
                && self.analyzed.isGenericClass(sourceType.base)) {
            prefix = TypeIdentity.mangleGenericType(
                sourceType.base, sourceType.generic_args);
        }
        Vector<IRNode> arguments = [];
        arguments.push(value);
        return IRNode.call(prefix + "_toString", arguments);
    }

    public IRNode upcastClassPointer(
            Node? targetType, Node? sourceType, IRNode value) {
        if (targetType == null || sourceType == null) { return value; }
        if (!self.analyzed.isClass(targetType.base)
                || targetType.generic_args.len > 0
                || sourceType.base == targetType.base
                || !self.analyzed.isSubclass(
                    sourceType.base, targetType.base)) {
            return value;
        }
        return IRNode.cast(self.cTypes.lower(targetType), value);
    }

    public IRNode? lowerStringMethod(IRNode obj, string method, Vector<IRNode> args) {
        /* Special-cased: equals -> strcmp(...) == 0; len/length/byteLen -> strlen. */
        if (method == "equals") {
            Vector<IRNode> cargs = [];
            cargs.push(obj);
            int i = 0;
            while (i < args.len) { cargs.push(args.get(i)); i = i + 1; }
            IRNode cmp = IRNode.call("strcmp", cargs);
            return IRNode.binary(cmp, "==", IRNode.literal("0"));
        }
        if (method == "len" || method == "length" || method == "byteLen") {
            Vector<IRNode> largs = [];
            largs.push(obj);
            return IRNode.cast("int", IRNode.call("strlen", largs));
        }
        /* Deterministic conversions: integer overflow saturates instead of
         * inheriting atoi/atol's undefined behavior. */
        if (method == "toInt") {
            self.context.referenceHelper("__btrc_parseInt");
            Vector<IRNode> a = [];
            a.push(obj);
            return IRNode.call("__btrc_parseInt", a);
        }
        if (method == "toFloat") {
            Vector<IRNode> a = [];
            a.push(obj);
            a.push(IRNode.literal("NULL"));
            return IRNode.call("strtof", a);
        }
        if (method == "toDouble") {
            Vector<IRNode> a = [];
            a.push(obj);
            a.push(IRNode.literal("NULL"));
            return IRNode.call("strtod", a);
        }
        if (method == "toLong") {
            self.context.referenceHelper("__btrc_parseLong");
            Vector<IRNode> a = [];
            a.push(obj);
            return IRNode.call("__btrc_parseLong", a);
        }
        if (method == "toBool") {
            self.context.referenceHelper("__btrc_parseBool");
            Vector<IRNode> a = [];
            a.push(obj);
            return IRNode.call("__btrc_parseBool", a);
        }
        /* Helper-backed methods: helper(obj, args...), wrapped in __btrc_str_track
         * when the result is a new heap string. */
        string helper = self.stringMethodHelper(method);
        if (helper == "") { return null; }
        self.context.referenceHelper(helper);
        Vector<IRNode> hargs = [];
        hargs.push(obj);
        int j = 0;
        while (j < args.len) { hargs.push(args.get(j)); j = j + 1; }
        IRNode call = IRNode.call(helper, hargs);
        if (SemanticTypeSystem.stringResultIsTracked(method)) {
            self.context.referenceHelper("__btrc_str_track");
            Vector<IRNode> targs = [];
            targs.push(call);
            return IRNode.call("__btrc_str_track", targs);
        }
        return call;
    }

    /* Lower obj.toString() for non-class receivers (mirrors methods._lower_to_string).
     * int/long/float/double/char -> __btrc_xToString tracked; bool -> ternary;
     * null type -> __btrc_intToString. */
    public IRNode lowerToString(IRNode obj, Node? ot) {
        if (ot == null) {
            self.context.referenceHelper("__btrc_intToString");
            Vector<IRNode> a = [];
            a.push(obj);
            return IRNode.call("__btrc_intToString", a);
        }
        string base = ot.base;
        if (base == "bool") {
            return IRNode.ternary(obj, IRNode.literal("\"true\""), IRNode.literal("\"false\""));
        }
        string helper = "__btrc_intToString";
        if (base == "long" || base == "long int" || base == "signed long"
                || base == "signed long int") { helper = "__btrc_longToString"; }
        else if (base == "long long" || base == "long long int"
                || base == "signed long long" || base == "signed long long int") {
            helper = "__btrc_longLongToString";
        }
        else if (base == "uint" || base == "byte" || base == "unsigned int"
                || base == "unsigned short" || base == "unsigned short int"
                || base == "unsigned char") { helper = "__btrc_uintToString"; }
        else if (base == "unsigned long" || base == "unsigned long int") {
            helper = "__btrc_ulongToString";
        }
        else if (base == "unsigned long long" || base == "unsigned long long int"
                || base == "size_t") { helper = "__btrc_ulongLongToString"; }
        else if (base == "float") { helper = "__btrc_floatToString"; }
        else if (base == "double") { helper = "__btrc_doubleToString"; }
        else if (base == "long double") { helper = "__btrc_longDoubleToString"; }
        else if (base == "char") { helper = "__btrc_charToString"; }
        self.context.referenceHelper(helper);
        self.context.referenceHelper("__btrc_str_track");
        Vector<IRNode> a = [];
        a.push(obj);
        IRNode call = IRNode.call(helper, a);
        Vector<IRNode> t = [];
        t.push(call);
        return IRNode.call("__btrc_str_track", t);
    }

    /* new X(args) -> X_new(args) (mirrors methods.lower_new_expr, class subset).
     * Generic instance: new C<...>(args) -> btrc_C_T_new(args). */
    /* True if a method-call field name names a string-producing method (toString,
     * str, trim, ...). Used by print/f-string lowering to force %s when the
     * receiver's type is untracked — e.g. an enum's `e.toString()`. Mirrors the
     * field-name set in fstrings._lower_interp / calls._lower_print. */
    public bool isStringProducingMethod(string m) {
        return m == "toString" || m == "str" || m == "trim"
            || m == "toUpper" || m == "toLower" || m == "substring"
            || m == "replace" || m == "repeat" || m == "reverse"
            || m == "capitalize" || m == "split";
    }

    /* Double every '%' so printf reads it as a literal percent (mirrors
     * fstrings.py's text.replace("%", "%%")). */
    public string replacePercent(string s) {
        string out = "";
        int i = 0;
        int n = s.length();
        while (i < n) {
            char c = s[i];
            if (c == '%') { out = out + "%%"; }
            else { out = out + f"{c}"; }
            i = i + 1;
        }
        return out;
    }

    /* Runtime helper backing a helper-mapped string method (mirrors the helper
     * fields of STRING_METHODS in analyzer/types.py). "" for methods with no helper
     * (len/equals/conversions, handled inline) or unknown names. */
    public string stringMethodHelper(string method) {
        if (method == "charLen") { return "__btrc_charLen"; }
        if (method == "contains") { return "__btrc_strContains"; }
        if (method == "startsWith") { return "__btrc_startsWith"; }
        if (method == "endsWith") { return "__btrc_endsWith"; }
        if (method == "indexOf") { return "__btrc_indexOf"; }
        if (method == "lastIndexOf") { return "__btrc_lastIndexOf"; }
        if (method == "find") { return "__btrc_find"; }
        if (method == "count") { return "__btrc_count"; }
        if (method == "charAt") { return "__btrc_charAt"; }
        if (method == "isEmpty") { return "__btrc_isEmpty"; }
        if (method == "isBlank") { return "__btrc_isBlank"; }
        if (method == "isUpper") { return "__btrc_isUpper"; }
        if (method == "isLower") { return "__btrc_isLower"; }
        if (method == "isAlnum" || method == "isAlnumStr") { return "__btrc_isAlnumStr"; }
        if (method == "isDigit" || method == "isDigitStr") { return "__btrc_isDigitStr"; }
        if (method == "isAlpha" || method == "isAlphaStr") { return "__btrc_isAlphaStr"; }
        if (method == "trim") { return "__btrc_trim"; }
        if (method == "lstrip") { return "__btrc_lstrip"; }
        if (method == "rstrip") { return "__btrc_rstrip"; }
        if (method == "toUpper") { return "__btrc_toUpper"; }
        if (method == "toLower") { return "__btrc_toLower"; }
        if (method == "substring") { return "__btrc_substring"; }
        if (method == "replace") { return "__btrc_replace"; }
        if (method == "repeat") { return "__btrc_repeat"; }
        if (method == "reverse") { return "__btrc_reverse"; }
        if (method == "capitalize") { return "__btrc_capitalize"; }
        if (method == "title") { return "__btrc_title"; }
        if (method == "swapCase") { return "__btrc_swapCase"; }
        if (method == "padLeft") { return "__btrc_padLeft"; }
        if (method == "padRight") { return "__btrc_padRight"; }
        if (method == "center") { return "__btrc_center"; }
        if (method == "zfill") { return "__btrc_zfill"; }
        if (method == "removePrefix") { return "__btrc_removePrefix"; }
        if (method == "removeSuffix") { return "__btrc_removeSuffix"; }
        if (method == "split") { return "__btrc_split"; }
        return "";
    }
}
