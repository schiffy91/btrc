import Library.Map;
import Library.Strings;
import Library.Vector;

import ../../analyzer/Models.btrc;
import ../../analyzer/ownership/Values.btrc;
import ../../analyzer/Types.btrc;
import ../../analyzer/validation/Storage.btrc;
import ../../generated/ast/Node.btrc;
import ../../syntax/Identity.btrc;
import ../../syntax/Types.btrc;
import ../Model.btrc;
import ./ownership/Operands.btrc;
import ./Types.btrc;

/* Aggregate construction and raw indexing are C expression domains
 * where source operands are otherwise exposed to unspecified evaluation
 * order. This per-generation owner detects those boundaries and reuses the
 * same typed operand/ARC machinery as calls and operators. */

class AggregateDeclarationPlan {
	public Vector<IRNode> declarations;
	public Vector<IRNode> prefix;
	public IRNode initializer;
	public Vector<IRNode> suffix;

	public AggregateDeclarationPlan() {
		self.declarations = [];
		self.prefix = [];
		self.initializer = IRNode.literal("0");
		self.suffix = [];
	}

	public void emitBefore(Vector<IRNode> statements) {
		int declarationIndex = 0;
		while (declarationIndex < self.declarations.len) {
			statements.push(self.declarations.get(declarationIndex));
			declarationIndex = declarationIndex + 1;
		}
		int prefixIndex = 0;
		while (prefixIndex < self.prefix.len) {
			statements.push(IRNode.expressionStatement(self.prefix.get(prefixIndex)));
			prefixIndex = prefixIndex + 1;
		}
	}

	public void emitAfter(Vector<IRNode> statements) {
		int suffixIndex = 0;
		while (suffixIndex < self.suffix.len) {
			statements.push(IRNode.expressionStatement(self.suffix.get(suffixIndex)));
			suffixIndex = suffixIndex + 1;
		}
	}
}

class AggregateOperandPlan {
	public Node expression;
	public Node? contextualType;
	public Node? effectiveType;
	public bool pinBorrowed;

	public AggregateOperandPlan(Node expression, Node? contextualType) {
		self.expression = expression;
		self.contextualType = contextualType;
		self.effectiveType = null;
		self.pinBorrowed = false;
	}
}

class AggregateEvaluationPlan {
	public Vector<AggregateOperandPlan> operands;
	public bool ordered;
	public Node? resultType;

	public AggregateEvaluationPlan() {
		self.operands = [];
		self.ordered = false;
		self.resultType = null;
	}
}

class AggregateValueLowerer {
	private Analyzed analyzed;
	private ManagedValueSemantics managedValues;
	private OwnershipOperandPlanner operandPlanner;
	private int buildingDepth;

	public AggregateValueLowerer(Analyzed analyzed, ManagedValueSemantics managedValues, OwnershipOperandPlanner operandPlanner) {
		self.analyzed = analyzed;
		self.managedValues = managedValues;
		self.operandPlanner = operandPlanner;
		self.buildingDepth = 0;
	}

	public bool isBuilding() { return self.buildingDepth > 0; }

	public void beginBuild() { self.buildingDepth = self.buildingDepth + 1; }

	public void endBuild() {
		self.buildingDepth = self.buildingDepth - 1;
		if (self.buildingDepth < 0) {
			print("internal compiler error: aggregate build depth underflow");
			exit(1);
		}
	}

	public AggregateEvaluationPlan plan(Node expression, Node? expected, OwnershipOperandEnvironment environment) {
		AggregateEvaluationPlan plan = AggregateEvaluationPlan();
		/* Fixed arrays initialize storage from flattened leaves. Record and
		 * tuple values instead stage their immediate typed children. */
		bool flatten = expected != null && self.operandPlanner.resolveType(expected, environment).isArray;
		self.collectOperands(expression, expected, environment, plan.operands, flatten);
		Vector<Node> expressions = [];
		int expressionIndex = 0;
		while (expressionIndex < plan.operands.len) {
			expressions.push(plan.operands.get(expressionIndex).expression);
			expressionIndex = expressionIndex + 1;
		}
		plan.ordered = self.operandPlanner.requiresOrder(expressions, environment);
		plan.resultType = expected;
		if (plan.resultType == null) {
			plan.resultType = self.operandPlanner.expressionType(expression, environment);
		}
		if (!plan.ordered) { return plan; }

		int index = 0;
		while (index < plan.operands.len) {
			AggregateOperandPlan operand = plan.operands.get(index);
			operand.effectiveType = self.operandPlanner.expressionType(operand.expression, environment);
			if (operand.effectiveType == null) {
				operand.effectiveType = operand.contextualType;
			}
			Node concreteType = self.operandPlanner.requireType(operand.effectiveType, operand.expression);
			bool laterEffect = false;
			int later = index + 1;
			while (later < plan.operands.len) {
				if (self.operandPlanner.hasEffect(plan.operands.get(later).expression, environment)) {
					laterEffect = true;
				}
				later = later + 1;
			}
			operand.pinBorrowed = laterEffect && operand.expression.kind != NK_SELF_EXPR && operand.expression.kind != NK_SUPER_EXPR && self.managedValues.isManaged(self.operandPlanner.resolveType(concreteType, environment));
			index = index + 1;
		}
		return plan;
	}

	public void rejectHeapClassBrace(Node expression, Node? expected, OwnershipOperandEnvironment environment) {
		if (expected == null || expression.elements().len == 0) {
			return;
		}
		Node resolved = self.operandPlanner.resolveType(expected, environment);
		if (!self.analyzed.isGenericClass(resolved.base) || self.collectionClass(resolved.base)) {
			return;
		}
		fprintf(stderr, "error: cannot use a non-empty brace initializer for " + "heap class '%s'; use an explicit constructor call at %d:%d\n", resolved.base, expression.line, expression.col);
		exit(1);
	}

	private bool collectionClass(string name) { return name == "Array" || name == "List" || name == "Map" || name == "Set" || name == "Vector"; }

	public void rejectVariableArrayInitializer(Node? typeExpr, Node? initializer, bool gpuResult, string subject) {
		if (typeExpr == null || initializer == null || gpuResult) {
			return;
		}
		Node arrayType = typeExpr;
		if (!arrayType.isArray || arrayType.arraySize == null || self.analyzed.constantArrayBoundKeys.has(AstIdentity.key(arrayType.arraySize))) {
			return;
		}
		fprintf(stderr, "error: %s is a variable-length array and cannot have " + "an initializer at %d:%d\n", subject, initializer.line, initializer.col);
		exit(1);
	}

	public Vector<SemanticInitializerSlot> initializerSlots(Node target, Node initializer) {
		Vector<SemanticInitializerProblem> problems = [];
		Vector<SemanticInitializerSlot> slots = SemanticTypeSystem.initializerLeafSlots(target, initializer, self.analyzed, problems);
		for problem in problems {
			fprintf(stderr, "error: %s at %d:%d\n", problem.message, problem.site.line, problem.site.col);
			exit(1);
		}
		return slots;
	}

	public IRNode arrayInitializerExtent(Node target, Node initializer) {
		if (!SemanticTypeSystem.hasDesignators(initializer)) { return IRNode.literal(Strings.fromInt(initializer.elements().len)); }
		self.initializerSlots(target, initializer);
		SemanticInitializerPlan plan = SemanticTypeSystem.initializerSlots(target, initializer, self.analyzed);
		return IRNode.literal(f"{plan.extent}");
	}

	/* Values have already been lowered in source order. Only their inert paths
	 * are grouped, so merging .a.x and .a.y never reorders side effects. */
	public IRNode materializeInitializerPaths(Vector<SemanticInitializerSlot> slots, Vector<IRNode> values, Node target, CTypeLowerer cTypes, bool runtime) {
		Vector<SemanticInitializerSlot> normalized = [];
		for slot in slots {
			Vector<Node> path = [];
			for step in slot.path { if (step.kind != NK_ANONYMOUS_MEMBER) { path.push(step); } }
			normalized.push(SemanticInitializerSlot(slot.element, path, slot.type));
		}
		return self.materializeInitializerChildren(normalized, values, target, cTypes, runtime, 0);
	}

	public IRNode compoundInitializer(IRNode initializer, Node target, CTypeLowerer cTypes) {
		Vector<string> names = [];
		int index = 0;
		while (index < initializer.args().len) { names.push(""); index++; }
		return IRNode.compoundLiteral(cTypes.lower(target), names, initializer.args());
	}

	private IRNode materializeInitializerChildren(Vector<SemanticInitializerSlot> slots, Vector<IRNode> values, Node target, CTypeLowerer cTypes, bool runtime, int depth) {
		Map<string, Vector<int>> groups = {};
		Vector<string> order = [];
		int position = 0;
		for slot in slots {
			Node step = slot.path.get(depth);
			string key = step.kind == NK_FIELD_DEF ? "field:" + step.name : f"index:{SemanticTypeSystem.initializerIndexValue(step, self.analyzed)}";
			if (!groups.has(key)) { Vector<int> indexes = []; groups.put(key, indexes); order.push(key); }
			groups.get(key).push(position);
			position++;
		}
		Vector<IRNode> entries = [];
		for key in order {
			Vector<int> indexes = groups.get(key);
			SemanticInitializerSlot first = slots.get(indexes.get(0));
			Node step = first.path.get(depth);
			Node childType = step.kind == NK_FIELD_DEF ? step.type : TypeShape.withoutOuterArray(target);
			IRNode value = values.get(indexes.get(0));
			if (first.path.len > depth + 1) {
				Vector<SemanticInitializerSlot> childSlots = [];
				Vector<IRNode> childValues = [];
				for index in indexes { childSlots.push(slots.get(index)); childValues.push(values.get(index)); }
				Node canonical = childType;
				Node? resolved = SemanticTypeSystem.resolveTypedefType(childType, self.analyzed.typedefTable);
				if (resolved != null) { canonical = resolved; }
				value = self.materializeInitializerChildren(childSlots, childValues, canonical, cTypes, runtime, depth + 1);
				if (runtime && !canonical.isArray) { value = self.compoundInitializer(value, childType, cTypes); }
			}
			if (step.kind == NK_FIELD_DEF) {
				entries.push(IRNode.designation(step.name, null, value));
			} else {
				long long index = SemanticTypeSystem.initializerIndexValue(step, self.analyzed);
				entries.push(IRNode.designation("", IRNode.literal(f"{index}"), value));
			}
		}
		return IRNode.initializerList(entries);
	}

	private Node? contextualElementType(Node? aggregateType, Node aggregate, int index, OwnershipOperandEnvironment environment) {
		if (aggregateType == null) {
			string initializerKey = AstIdentity.key(aggregate);
			if (self.analyzed.initializerPlans.has(initializerKey)) {
				return SemanticTypeSystem.initializerSlotType(self.analyzed.initializerPlans.get(initializerKey), aggregate.elements().get(index));
			}
			return null;
		}
		Node concrete = self.operandPlanner.resolveType(aggregateType, environment);
		Node? resolved = SemanticTypeSystem.resolveTypedefType(concrete, self.analyzed.typedefTable);
		if (resolved != null) { concrete = resolved; }
		if (concrete.isArray) {
			if (SemanticTypeSystem.hasDesignators(aggregate)) {
				for slot in self.initializerSlots(concrete, aggregate) {
					if (SemanticTypeSystem.sameNode(slot.element, aggregate.elements().get(index))) { return slot.type; }
				}
				return null;
			}
			return TypeShape.withoutOuterArray(concrete);
		}
		if (concrete.base == "Tuple" && index < concrete.genericArgs().len) {
			return concrete.genericArgs().get(index);
		}
		if ((concrete.base == "Array" || concrete.base == "List" || concrete.base == "Set" || concrete.base == "Vector") && concrete.genericArgs().len == 1) {
			return concrete.genericArgs().get(0);
		}
		string structName = StorageValidator.structTypeName(concrete, self.analyzed);
		if (structName == "" || !self.analyzed.structTable.has(structName)) {
			return null;
		}
		Node declaration = self.analyzed.structTable.get(structName);
		if (declaration.isForward) {
			return null;
		}
		SemanticInitializerPlan plan = SemanticTypeSystem.initializerSlots(declaration, aggregate, self.analyzed);
		return SemanticTypeSystem.initializerSlotType(plan, aggregate.elements().get(index));
	}

	private void collectOperands(Node aggregate, Node? aggregateType, OwnershipOperandEnvironment environment, Vector<AggregateOperandPlan> operands, bool flatten) {
		Node? expected = aggregateType;
		if (expected == null) { expected = self.operandPlanner.expressionType(aggregate, environment); }
		if (expected != null) {
			Node concrete = self.operandPlanner.resolveType(expected, environment);
			if (concrete.isArray && SemanticTypeSystem.hasDesignators(aggregate)) {
				for slot in self.initializerSlots(concrete, aggregate) { self.collectOperand(slot.element, slot.type, environment, operands, flatten); }
				return;
			}
			string name = StorageValidator.structTypeName(concrete, self.analyzed);
			if (!concrete.isArray && concrete.pointerDepth == 0 && name != "" && self.analyzed.structTable.has(name)) {
				Node declaration = self.analyzed.structTable.get(name);
				if (!declaration.isForward) {
					for slot in self.initializerSlots(declaration, aggregate) {
						self.collectOperand(slot.element, slot.type, environment, operands, flatten);
					}
					return;
				}
			}
		}
		int index = 0;
		while (index < aggregate.elements().len) {
			self.collectOperand(aggregate.elements().get(index), self.contextualElementType(expected, aggregate, index, environment), environment, operands, flatten);
			index = index + 1;
		}
	}

	private void collectOperand(Node element, Node? contextualType, OwnershipOperandEnvironment environment, Vector<AggregateOperandPlan> operands, bool flatten) {
		Node? elementType = self.operandPlanner.expressionType(element, environment);
		if (elementType == null) { elementType = contextualType; }
		bool nested = (element.kind == NK_BRACE_INITIALIZER || element.kind == NK_TUPLE_LITERAL || element.kind == NK_LIST_LITERAL) && self.valueAggregate(elementType, environment);
		/* Arrays have no assignable value temporary. Named records and tuples
		 * keep their own value boundary unless an outer array needs leaves. */
		bool array = elementType != null && self.operandPlanner.resolveType(elementType, environment).isArray;
		if (nested && (flatten || array)) {
			self.collectOperands(element, elementType, environment, operands, true);
		} else {
			operands.push(AggregateOperandPlan(element, contextualType));
		}
	}

	private bool valueAggregate(Node? typeExpr, OwnershipOperandEnvironment environment) {
		if (typeExpr == null) { return false; }
		Node resolved = self.operandPlanner.resolveType(typeExpr, environment);
		/* Pointer depth describes an array's elements, not its outer storage. */
		if (resolved.isArray) { return true; }
		if (resolved.pointerDepth > 0) { return false; }
		if (resolved.base == "Tuple") {
			return true;
		}
		string structName = StorageValidator.structTypeName(resolved, self.analyzed);
		return structName != "" && self.analyzed.structTable.has(structName);
	}
}
