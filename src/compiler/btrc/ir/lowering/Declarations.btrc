import Library.Strings;
import Library.Vector;

import ../../analyzer/Declarations.btrc;
import ../../analyzer/Generics.btrc;
import ../../analyzer/HostedAbi.btrc;
import ../../analyzer/Models.btrc;
import ../../analyzer/ownership/Cycles.btrc;
import ../../analyzer/ownership/Values.btrc;
import ../../analyzer/Types.btrc;
import ../../analyzer/validation/Declarations.btrc;
import ../../generated/ast/Node.btrc;
import ../../generated/native_abi/Models.btrc;
import ../../frontend/Models.btrc;
import ../../syntax/Identity.btrc;
import ../../syntax/Types.btrc;
import ../Model.btrc;
import ./CallableFlow.btrc;
import ./Callables.btrc;
import ./Context.btrc;
import ./Expressions.btrc;
import ./Functions.btrc;
import ./ownership/CycleBoundaries.btrc;
import ./ownership/Lifetime.btrc;
import ./ownership/ManagedTypes.btrc;
import ./Strings.btrc;
import ./Types.btrc;

/* Module declaration, class storage, field/property, preprocessor, and
 * concrete specialization materialization. */

class DeclarationLowerer {
	private Analyzed analyzed;
	private HostedAbiRepository hostedAbi;
	private DeclarationRegistry semanticDeclarations;
	private ManagedValueSemantics managedValues;
	private CycleSemantics cycles;
	private CleanupSlotRegistry cleanupSlots;
	private CallableValueSemantics callableValues;
	private CallableBoundaryPolicy callableBoundaries;
	private LoweringContext context;
	private ManagedLifetimeLowerer managedLifetime;
	private ManagedTypeLowerer managedTypes;
	private CycleBoundaryLowerer cycleBoundaries;
	private CycleReturnBoundaryLowerer cycleReturns;
	private CTypeLowerer cTypes;
	private FunctionLowerer functions;
	private ExpressionLowerer expressions;

	public DeclarationLowerer(Analyzed analyzed, HostedAbiRepository hostedAbi, DeclarationRegistry semanticDeclarations, ManagedValueSemantics managedValues, CycleSemantics cycles, CleanupSlotRegistry cleanupSlots, CallableValueSemantics callableValues, CallableBoundaryPolicy callableBoundaries, LoweringContext context, ManagedLifetimeLowerer managedLifetime, ManagedTypeLowerer managedTypes, CycleBoundaryLowerer cycleBoundaries, CycleReturnBoundaryLowerer cycleReturns, CTypeLowerer cTypes, FunctionLowerer functions, ExpressionLowerer expressions) {
		self.analyzed = analyzed;
		self.hostedAbi = hostedAbi;
		self.semanticDeclarations = semanticDeclarations;
		self.managedValues = managedValues; self.cycles = cycles;
		self.cleanupSlots = cleanupSlots;
		self.callableValues = callableValues;
		self.callableBoundaries = callableBoundaries;
		self.context = context; self.managedLifetime = managedLifetime;
		self.managedTypes = managedTypes;
		self.cycleBoundaries = cycleBoundaries;
		self.cycleReturns = cycleReturns;
		self.cTypes = cTypes; self.functions = functions; self.expressions = expressions;
	}

	private string lexicalBindingCName(string name) { return self.hostedAbi.lexicalBindingCName(name, self.hostedAbi.typedefName(name) || self.analyzed.lexicalBindingConflictsType(name)); }

	private string compactPackDirective(string text) {
		string compact = Strings.replace(text, " ", "");
		compact = Strings.replace(compact, "\t", "");
		compact = Strings.replace(compact, "\r", "");
		return Strings.replace(compact, "\n", "");
	}

	private int packPushAlignment(string text) {
		string compact = self.compactPackDirective(text);
		if (compact == "#pragmapack(push)") { return -2; }
		string prefix = "#pragmapack(push,";
		if (!compact.startsWith(prefix) || !compact.endsWith(")")) {
			return -1;
		}
		int length = compact.length() - prefix.length() - 1;
		if (length <= 0) { return -1; }
		string valueText = compact.substring(prefix.length(), length);
		int index = 0;
		while (index < valueText.length()) {
			if (!TypeIdentity.asciiDigit(valueText[index])) { return -1; }
			index = index + 1;
		}
		return Strings.toInt(valueText);
	}

	private bool packPop(string text) { return self.compactPackDirective(text) == "#pragmapack(pop)"; }

	private bool isPackPragma(string text) { return self.packPushAlignment(text) != -1 || self.packPop(text); }

	private bool supportedPackAlignment(int alignment) { return alignment == 1 || alignment == 2 || alignment == 4 || alignment == 8 || alignment == 16; }

	public Map<string, int> packAlignments(Node program) {
		Map<string, int> alignments = {};
		Vector<int> stack = [];
		int current = 0;
		int index = 0;
		while (index < program.declarations.len) {
			Node declaration = program.declarations.get(index);
			bool directive = false;
			if (declaration.kind == NK_PREPROCESSOR_DIRECTIVE) {
				int pushed = self.packPushAlignment(declaration.text);
				if (pushed != -1) {
					stack.push(current);
					if (pushed != -2) {
						if (!self.supportedPackAlignment(pushed)) {
							self.preprocessorFail("unsupported #pragma pack alignment " + Strings.fromInt(pushed));
						}
						current = pushed;
					}
					directive = true;
				} else if (self.packPop(declaration.text)) {
					if (stack.len == 0) {
						self.preprocessorFail("#pragma pack(pop) has no matching push");
					}
					current = stack.pop();
					directive = true;
				}
			}
			if (!directive && current > 0 && (declaration.kind == NK_CLASS_DECL || declaration.kind == NK_STRUCT_DECL)) {
				alignments.put(AstIdentity.key(declaration), current);
			}
			index = index + 1;
		}
		if (stack.len > 0) {
			self.preprocessorFail("#pragma pack(push) has no matching pop");
		}
		return alignments;
	}

	private IRNode nativeNullGuard(IRNode value, string message, bool realtime = false) {
		Vector<IRNode> noArguments = [];
		if (realtime) {
			IRNode trap = IRNode.call("__builtin_trap", noArguments);
			trap.neverReturns = true;
			return IRNode.ifStatement(IRNode.binary(value, "==", IRNode.literal("NULL")), IRNode.block([IRNode.expressionStatement(trap)]), null);
		}
		IRNode abortCall = IRNode.call("abort", noArguments);
		abortCall.neverReturns = true;
		Vector<IRNode> failure = [IRNode.expressionStatement(IRNode.call("fputs", [IRNode.literal("\"" + message + "\\n\""), IRNode.variable("stderr")])), IRNode.expressionStatement(abortCall)];
		return IRNode.ifStatement(IRNode.binary(value, "==", IRNode.literal("NULL")), IRNode.block(failure), null);
	}

	private void emitNativeAdapter(Node declaration, FeNativeCallContract contract, IRModule module) {
		string name = contract.adapterSymbol(declaration.name);
		if (name.equals(declaration.name)) { return; }
		var adapter = IRFunction();
		adapter.name = name;
		adapter.returnType = self.cTypes.lower(declaration.returnType);
		adapter.isStatic = true;
		Vector<IRNode> arguments = [];
		Vector<IRNode> statements = [];
		Map<string, bool> parameterNames = {};
		for index in range(declaration.params.len) {
			Node parameter = declaration.params.get(index);
			adapter.params.push(self.cTypes.lowerParameter(parameter));
			parameterNames.put(parameter.name, true);
			IRNode argument = IRNode.variable(parameter.name);
			arguments.push(argument);
			if (contract.nonnullParameters.get(index)) { statements.push(self.nativeNullGuard(argument, f"Native call {declaration.name}: null argument {parameter.name}", contract.realtimeSafe)); }
		}
		Vector<IRNode> locals = [];
		for index in range(contract.recordInputs.len) {
			var projection = contract.recordInputs.get(index);
			if (projection != null) { arguments.set(index, self.nativeRecordInput(projection, arguments.get(index), locals, statements, declaration.name, declaration.params.get(index).name, parameterNames, contract.recordTypes)); }
		}
		locals.extend(statements);
		statements = locals;
		Vector<Vector<IRNode>> releases = [];
		Vector<IRNode> cleanup = [];
		Map<int, bool> contexts = {};
		for callback in contract.callbacks { contexts.put(callback.contextIndex, true); }
		Map<int, int> visible = {};
		int argumentIndex = 0;
		for index in range(arguments.len + contexts.len) {
			if (!contexts.has(index)) { visible.put(index, argumentIndex); argumentIndex++; }
		}
		Map<int, bool> leases = {};
		for index in range(contract.resourceParameters.len) {
			if (!contract.resourceParameters.get(index).isEmpty()) { leases.put(index, true); }
		}
		for callback in contract.callbacks { leases.put(visible.get(callback.parameterIndex), true); }
		if (leases.len > 0) {
			IRNode discard = self.nativeCleanupScope(parameterNames, statements);
			if (contract.callbacks.len > 0) { cleanup.push(IRNode.expressionStatement(self.managedLifetime.flushCycles())); }
			cleanup.push(discard);
			for index in range(arguments.len) {
				if (leases.has(index)) { arguments.set(index, self.emitNativeLease(index, declaration.params.get(index).type, arguments.get(index), parameterNames, statements, releases)); }
			}
		}
		for index in range(contract.resourceParameters.len) {
			string resource = contract.resourceParameters.get(index);
			if (!resource.isEmpty()) { arguments.set(index, IRNode.cast(resource, arguments.get(index))); }
		}
		if (contract.callbacks.len > 0) {
			Vector<IRNode> nativeArguments = [];
			for index in range(arguments.len + contexts.len) {
				if (contexts.has(index)) { nativeArguments.push(IRNode.literal("NULL")); }
				else { nativeArguments.push(arguments.get(visible.get(index))); }
			}
			for callback in contract.callbacks {
				IRNode receiver = nativeArguments.get(callback.parameterIndex);
				IRNode thunk = self.emitNativeCallback(declaration.name, callback, module);
				string contextType = f"struct __btrc_native_callback_{declaration.name}_{callback.parameterIndex}_context";
				string contextName = f"__btrc_callback_context_{callback.parameterIndex}";
				while (parameterNames.has(contextName)) { contextName = contextName + "_"; }
				statements.push(IRNode.variableDeclaration(contextType, contextName, IRNode.compoundLiteral(contextType, ["receiver", "thread"], [receiver, IRNode.addressOf(IRNode.variable("__btrc_try_top"))])));
				nativeArguments.set(callback.contextIndex, IRNode.addressOf(IRNode.variable(contextName)));
				nativeArguments.set(callback.parameterIndex, thunk);
			}
			arguments = nativeArguments;
		}
		IRNode call = IRNode.call(declaration.name, arguments);
		if (!contract.resourceResult.isEmpty()) { call = IRNode.cast(adapter.returnType, call); }
		if (adapter.returnType.equals("void")) {
			statements.push(IRNode.expressionStatement(call));
			for (int index = releases.len - 1; index >= 0; index--) { statements.extend(releases.get(index)); }
			statements.extend(cleanup);
		} else if (contract.nonnullReturn || releases.len > 0) {
			string result = "__btrc_native_result";
			while (parameterNames.has(result)) { result = result + "_"; }
			IRNode resultSlot = IRNode.variableDeclaration(adapter.returnType, result, call);
			statements.push(resultSlot);
			if (leases.len > 0 && !contract.resourceResult.isEmpty()) { statements.push(IRNode.expressionStatement(self.managedLifetime.registerCleanupSlot(resultSlot, self.managedValues.runtimeType(declaration.returnType)))); }
			for (int index = releases.len - 1; index >= 0; index--) { statements.extend(releases.get(index)); }
			if (contract.nonnullReturn) { statements.push(self.nativeNullGuard(IRNode.variable(result), f"Native call {declaration.name}: null result", contract.realtimeSafe)); }
			statements.extend(cleanup);
			statements.push(IRNode.returnStatement(IRNode.variable(result)));
		} else {
			statements.push(IRNode.returnStatement(call));
		}
		adapter.body = IRNode.block(statements);
		var prototype = IRFunctionDecl(name, adapter.returnType, true);
		prototype.params = adapter.params;
		module.functionDecls.push(prototype);
		module.functions.push(adapter);
	}

	private IRNode nativeCleanupScope(Map<string, bool> parameterNames, Vector<IRNode> statements) {
		string marker = "__btrc_native_cleanup_mark";
		while (parameterNames.has(marker)) { marker = marker + "_"; }
		Vector<IRNode> noArguments = [];
		self.context.referenceHelper("__btrc_cleanup_mark");
		self.context.referenceHelper("__btrc_discard_cleanups_to");
		statements.push(IRNode.variableDeclaration("int", marker, IRNode.call("__btrc_cleanup_mark", noArguments)));
		return IRNode.expressionStatement(IRNode.call("__btrc_discard_cleanups_to", [IRNode.variable(marker)]));
	}

	private IRNode emitNativeLease(int index, Node valueType, IRNode argument, Map<string, bool> parameterNames, Vector<IRNode> statements, Vector<Vector<IRNode>> releases) {
		string name = f"__btrc_native_argument_{index}";
		while (parameterNames.has(name)) { name = name + "_"; }
		string valueCType = self.cTypes.lower(valueType);
		IRNode slot = IRNode.variableDeclaration(valueCType, name, argument);
		statements.push(slot);
		IRNode value = IRNode.variable(name);
		statements.push(IRNode.expressionStatement(self.managedLifetime.retainValue(value, valueType)));
		statements.push(IRNode.expressionStatement(self.managedLifetime.registerCleanupSlot(slot, self.managedValues.runtimeType(valueType))));
		string releasedName = f"__btrc_native_released_{index}";
		while (parameterNames.has(releasedName)) { releasedName = releasedName + "_"; }
		releases.push([
			IRNode.variableDeclaration(valueCType, releasedName, value),
			IRNode.assignment(value, IRNode.literal("NULL")),
			IRNode.expressionStatement(self.managedLifetime.releaseValue(IRNode.variable(releasedName), valueType))
		]);
		return value;
	}

	private IRNode emitNativeCallback(string functionName, FeNativeCallbackProjection callback, IRModule module) {
		var adapter = IRFunction();
		adapter.name = f"__btrc_native_callback_{functionName}_{callback.parameterIndex}";
		adapter.returnType = self.cTypes.lower(callback.returnType);
		adapter.isStatic = true;
		var contextStruct = IRStructDef();
		contextStruct.name = adapter.name + "_context";
		contextStruct.fields.push(IRStructField(callback.interfaceName + "*", "receiver"));
		contextStruct.fields.push(IRStructField("volatile int*", "thread"));
		module.structDefs.push(contextStruct);
		string contextType = "const struct " + contextStruct.name + "*";
		IRNode context = IRNode.variable("__btrc_context");
		IRNode contextDeclaration = IRNode.variableDeclaration(contextType, "__btrc_context", IRNode.cast(contextType, IRNode.variable(f"argument{callback.callbackContextIndex}")));
		Vector<IRNode> arguments = [IRNode.fieldAccess(context, "receiver", true)];
		for index in range(callback.parameters.len) {
			string name = f"argument{index}";
			adapter.params.push(IRParam(self.cTypes.lower(callback.parameters.get(index)), name));
			if (index != callback.callbackContextIndex) { arguments.push(IRNode.variable(name)); }
		}
		IRNode call = IRNode.call(callback.interfaceName + "_invoke", arguments);
		Vector<IRNode> body = [];
		if (adapter.returnType == "void") { body.push(IRNode.expressionStatement(call)); }
		else { body.push(IRNode.variableDeclaration(adapter.returnType, "__btrc_callback_result", call)); }
		body.push(IRNode.expressionStatement(IRNode.unary("--", IRNode.variable("__btrc_try_top"), false)));
		body.push(IRNode.returnStatement(adapter.returnType == "void" ? null : IRNode.variable("__btrc_callback_result")));
		self.context.referenceHelper("__btrc_trycatch_globals");
		self.context.referenceHelper("__btrc_push_try");
		self.appendPreprocessorDecl(module, IRPreprocessorDecl.include("setjmp.h", true));
		IRNode frame = IRNode.indexAccess(IRNode.variable("__btrc_try_stack"), IRNode.variable("__btrc_try_top"));
		IRNode condition = IRNode.binary(IRNode.call("setjmp", [IRNode.fieldAccess(frame, "env", true)]), "==", IRNode.literal("0"));
		Vector<IRNode> noArguments = [];
		IRNode abortCall = IRNode.call("abort", noArguments);
		abortCall.neverReturns = true;
		Vector<IRNode> failure = [
			IRNode.expressionStatement(IRNode.call("fputs", [IRNode.literal("\"BTRC native callback failed: \""), IRNode.variable("stderr")])),
			IRNode.expressionStatement(IRNode.call("fputs", [IRNode.variable("__btrc_error_msg"), IRNode.variable("stderr")])),
			IRNode.expressionStatement(abortCall)
		];
		IRNode wrongThread = IRNode.ifStatement(IRNode.binary(IRNode.fieldAccess(context, "thread", true), "!=", IRNode.addressOf(IRNode.variable("__btrc_try_top"))), IRNode.block([
			IRNode.expressionStatement(IRNode.call("fputs", [IRNode.literal("\"BTRC native callback delivered on the wrong thread\\n\""), IRNode.variable("stderr")])),
			IRNode.expressionStatement(abortCall)
		]), null);
		adapter.body = IRNode.block([contextDeclaration, wrongThread, IRNode.expressionStatement(IRNode.call("__btrc_push_try", noArguments)), IRNode.ifStatement(condition, IRNode.block(body), IRNode.block(failure))]);
		var prototype = IRFunctionDecl(adapter.name, adapter.returnType, true);
		prototype.params = adapter.params;
		module.functionDecls.push(prototype);
		module.functions.push(adapter);
		return IRNode.functionReference(adapter.name);
	}

	private void emitResourceLifetime(FeNativeImportedDeclaration imported, IRModule module) {
		var resource = imported.resource;
		if (resource == null) { return; }
		module.structForwards.push(IRStructForward("__btrc_native_" + resource.name));
		for operation in ["retain", "release"] {
			var adapter = IRFunction();
			adapter.name = "__btrc_native_" + resource.name + "_" + operation;
			adapter.returnType = "void";
			adapter.isStatic = true;
			adapter.params.push(IRParam("void*", "value"));
			IRNode value = IRNode.variable("value");
			IRNode call = IRNode.call(operation == "retain" ? resource.retainFunction : resource.releaseFunction, [IRNode.cast(resource.name, value)]);
			adapter.body = IRNode.block([IRNode.ifStatement(IRNode.binary(value, "!=", IRNode.literal("NULL")), IRNode.block([IRNode.expressionStatement(IRNode.cast("void", call))]), null)]);
			var prototype = IRFunctionDecl(adapter.name, "void", true);
			prototype.params = adapter.params;
			module.functionDecls.push(prototype);
			module.functions.push(adapter);
		}
	}

	private IRNode nativeRecordInput(FeNativeRecordInput projection, IRNode value, Vector<IRNode> locals, Vector<IRNode> statements, string callName, string path, Map<string, bool> parameterNames, Map<string, FeNativeRecordInput> recordTypes, string prefix = "") {
		/* Declare nested SDK storage at adapter scope, outside conditional initialization. */
		string name = f"__btrc_record_input_{locals.len}";
		while (parameterNames.has(name)) { name = name + "_"; }
		IRNode native = IRNode.variable(name);
		locals.push(IRNode.variableDeclaration(projection.nativeSpelling, name, IRNode.initializerList([IRNode.literal("0")])));
		Vector<IRNode> assignments = [];
		for field in projection.fields {
			IRNode source = IRNode.fieldAccess(value, field.name, true);
			IRNode target = IRNode.fieldAccess(native, field.name, false);
			string fieldPath = path + "." + field.name;
			if ((!field.record.isEmpty() || !field.objectType.isEmpty()) && !field.valueType.isNullable) { assignments.push(self.nativeNullGuard(source, f"Native call {callName}: null input {fieldPath}", false)); }
			if (!field.record.isEmpty()) { source = self.nativeRecordInput(recordTypes.get(field.record), source, locals, assignments, callName, fieldPath, parameterNames, recordTypes, field.prefix); }
			else if (!field.objectType.isEmpty()) { source = IRNode.cast("void*", source); }
			assignments.push(IRNode.assignment(target, source));
		}
		statements.push(IRNode.ifStatement(IRNode.binary(value, "!=", IRNode.literal("NULL")), IRNode.block(assignments), null));
		IRNode address = IRNode.addressOf(prefix.isEmpty() ? native : IRNode.fieldAccess(native, prefix, false));
		return IRNode.ternary(IRNode.binary(value, "==", IRNode.literal("NULL")), IRNode.literal("NULL"), address);
	}

	private IRModule objectiveCUnit(FeNativeImportedDeclaration imported, IRModule module) {
		if (!module.nativeUnits.has("ObjectiveCAdapters")) { var unit = IRModule(); unit.language = "objective-c"; module.nativeUnits.put("ObjectiveCAdapters", unit); }
		IRModule native = module.nativeUnits.get("ObjectiveCAdapters");
		self.appendPreprocessorDecl(native, IRPreprocessorDecl.include("stdlib.h", true));
		for header in imported.headers { self.appendPreprocessorDecl(native, IRPreprocessorDecl.include(header, false)); }
		var records = Node();
		records.kind = NK_PROGRAM;
		for importedRecord in self.analyzed.nativeDeclarations {
			if (importedRecord.declaration.kind == NK_STRUCT_DECL && importedRecord.language == "objective-c" && !importedRecord.coalesced) { records.declarations.push(importedRecord.declaration); }
		}
		for record in DeclarationValidator.orderedStructDefinitions(records, self.analyzed.structTable) {
			string name = "__btrc_value_" + record.name;
			bool declared = false;
			for definition in native.structDefs { if (definition.name == name) { declared = true; } }
			if (declared) { continue; }
			var definition = IRStructDef();
			definition.name = name;
			for field in record.fields { definition.fields.push(IRStructField(self.cTypes.lower(field.type), field.name)); }
			native.structForwards.push(IRStructForward(name));
			native.structDefs.push(definition);
			module.structForwards.push(IRStructForward(name));
			module.structDefs.push(definition);
		}
		return native;
	}

	private bool objectiveCRecord(Node type) { return type.pointerDepth == 0 && !type.isArray && self.analyzed.isObjectiveCRecord(type.base); }

	private IRNode objectiveCValue(Node type, IRNode value, bool toNative) {
		if (!self.objectiveCRecord(type)) { return value; }
		Node record = self.analyzed.structTable.get(type.base);
		Vector<string> names = [];
		Vector<IRNode> values = [];
		for field in record.fields {
			names.push(field.name);
			values.push(self.objectiveCValue(field.type, IRNode.fieldAccess(value, field.name, false), toNative));
		}
		string spelling = toNative ? self.analyzed.nativeTypeSpelling(type.base) : self.cTypes.lower(type);
		return IRNode.compoundLiteral(spelling, names, values);
	}

	private void emitObjectiveCGlobal(FeNativeImportedDeclaration imported, IRModule module) {
		IRModule native = self.objectiveCUnit(imported, module);
		if (self.analyzed.isObjectiveCObjectGlobal(imported.declaration.name)) {
			self.emitObjectiveCObjectGlobal(imported, module, native);
			return;
		}
		var adapter = IRFunction();
		adapter.name = "__btrc_objc_address_" + imported.declaration.name;
		adapter.returnType = self.cTypes.lower(imported.declaration.type) + "*";
		adapter.body = IRNode.block([IRNode.returnStatement(IRNode.addressOf(IRNode.variable(imported.declaration.name)))]);
		native.functions.push(adapter);
		module.functionDecls.push(IRFunctionDecl(adapter.name, adapter.returnType, false));
	}

	private void emitObjectiveCObjectGlobal(FeNativeImportedDeclaration imported, IRModule module, IRModule native) {
		Node declaration = imported.declaration;
		var wrapper = IRFunction();
		wrapper.name = "__btrc_objc_read_" + declaration.name;
		wrapper.returnType = self.cTypes.lower(declaration.type);
		wrapper.isStatic = true;
		var adapter = IRFunction();
		adapter.name = wrapper.name + "_adapter";
		adapter.returnType = "int";
		adapter.params.push(IRParam(wrapper.returnType + "*", "nativeResult"));
		IRNode result = IRNode.variable("nativeResult");
		IRNode value = IRNode.cast(wrapper.returnType, IRNode.variable(declaration.name), "retain");
		IRNode body = IRNode.block([IRNode.assignment(IRNode.dereference(result), value), IRNode.returnStatement(IRNode.literal("0"))]);
		IRNode failureBody = IRNode.block([IRNode.returnStatement(IRNode.literal("1"))]);
		adapter.body = IRNode.block([IRNode.objectiveCAutoreleasePool(IRNode.block([IRNode.objectiveCExceptionBoundary(body, failureBody)]))]);
		native.functions.push(adapter);
		var external = IRFunctionDecl(adapter.name, "int", false);
		external.params = adapter.params;
		module.functionDecls.push(external);
		self.context.referenceHelper("__btrc_throw");
		IRNode failure = IRNode.call("__btrc_throw", [IRNode.literal("\"Objective-C exception reading " + declaration.name + "\"")]);
		failure.neverReturns = true;
		Vector<IRNode> statements = [
			IRNode.variableDeclaration(wrapper.returnType, "nativeResult", IRNode.literal("0")),
			IRNode.ifStatement(IRNode.call(adapter.name, [IRNode.addressOf(result)]), IRNode.block([IRNode.expressionStatement(failure)]), null)
		];
		if (!declaration.type.isNullable) { statements.push(self.objectiveCNullGuard(result, "Objective-C global " + declaration.name + ": null result")); }
		statements.push(IRNode.returnStatement(result));
		wrapper.body = IRNode.block(statements);
		module.functionDecls.push(IRFunctionDecl(wrapper.name, wrapper.returnType, true));
		module.functions.push(wrapper);
	}

	private void emitObjectiveCAdapters(FeNativeImportedDeclaration imported, IRModule module) {
		IRModule native = self.objectiveCUnit(imported, module);
		for declaration in self.analyzed.nativeDeclarations {
			if (declaration.declaration.kind != NK_CLASS_DECL || declaration.language != "objective-c") { continue; }
			string opaqueName = "__btrc_native_" + declaration.declaration.name;
			bool declared = false;
			for forward in native.structForwards { if (forward.name == opaqueName) { declared = true; } }
			if (!declared) {
				native.structForwards.push(IRStructForward(opaqueName));
				module.structForwards.push(IRStructForward(opaqueName));
			}
		}
		self.emitObjectiveCLifetime(imported, module, native);
		for method in imported.declaration.members {
			NativeNode descriptor = imported.methods.get(method.name);
			string name = imported.declaration.name + "_" + method.name;
			var wrapper = IRFunction();
			wrapper.name = name;
			wrapper.returnType = self.cTypes.lower(method.returnType);
			wrapper.isStatic = true;
			var adapter = IRFunction();
			adapter.name = "__btrc_objc_" + name;
			adapter.returnType = "int";
			Vector<IRNode> arguments = [];
			Vector<IRNode> nativeArguments = [];
			IRNode receiver = IRNode.variable(imported.declaration.name);
			if (!descriptor.classMethod) {
				var parameter = IRParam("struct __btrc_native_" + imported.declaration.name + "*", "self");
				wrapper.params.push(parameter);
				adapter.params.push(parameter);
				arguments.push(IRNode.variable("self"));
				receiver = IRNode.cast(self.objectiveCObjectType(imported.declaration.name), IRNode.variable("self"), "borrow");
			}
			for parameter in method.params {
				var lowered = self.cTypes.lowerParameter(parameter);
				wrapper.params.push(lowered);
				adapter.params.push(lowered);
				arguments.push(IRNode.variable(parameter.name));
				IRNode argument = IRNode.variable(parameter.name);
				if (self.managedValues.isNative(parameter.type)) { argument = IRNode.cast(self.objectiveCObjectType(parameter.type.base), argument, "borrow"); }
				else { argument = self.objectiveCValue(parameter.type, argument, true); }
				nativeArguments.push(argument);
			}
			bool returnsValue = wrapper.returnType != "void";
			IRNode result = IRNode.variable("nativeResult");
			IRNode message = IRNode.objectiveCMessage(receiver, descriptor.selector, nativeArguments);
			if (self.managedValues.isNative(method.returnType)) { message = IRNode.cast(wrapper.returnType, message, "retain"); }
			Vector<IRNode> body = [];
			bool recordReturn = self.objectiveCRecord(method.returnType);
			if (recordReturn) {
				body.push(IRNode.variableDeclaration(self.analyzed.nativeTypeSpelling(method.returnType.base), "sdkResult", message));
				message = self.objectiveCValue(method.returnType, IRNode.variable("sdkResult"), false);
			}
			if (returnsValue) {
				adapter.params.push(IRParam(wrapper.returnType + "*", "nativeResult"));
				body.push(IRNode.assignment(IRNode.dereference(result), message));
			} else { body.push(IRNode.expressionStatement(message)); }
			body.push(IRNode.returnStatement(IRNode.literal("0")));
			adapter.body = IRNode.block([IRNode.objectiveCAutoreleasePool(IRNode.block([IRNode.objectiveCExceptionBoundary(IRNode.block(body), IRNode.block([IRNode.returnStatement(IRNode.literal("1"))]))]))]);
			native.functions.push(adapter);
			var external = IRFunctionDecl(adapter.name, "int", false);
			external.params = adapter.params;
			module.functionDecls.push(external);
			Vector<IRNode> statements = [];
			Vector<IRNode> callArguments = [];
			callArguments.extend(arguments);
			if (returnsValue) {
				bool aggregateReturn = method.returnType.pointerDepth == 0 && !method.returnType.isArray && self.analyzed.structTable.has(method.returnType.base);
				IRNode initial = aggregateReturn ? IRNode.initializerList([IRNode.literal("0")]) : IRNode.literal("0");
				statements.push(IRNode.variableDeclaration(wrapper.returnType, "nativeResult", initial));
				callArguments.push(IRNode.addressOf(result));
			}
			self.context.referenceHelper("__btrc_throw");
			if (!descriptor.classMethod) { statements.push(self.objectiveCNullGuard(IRNode.variable("self"), "Objective-C call " + descriptor.name + ": null argument self")); }
			for parameter in method.params {
				if (parameter.type.pointerDepth > 0 && !parameter.type.isNullable) { statements.push(self.objectiveCNullGuard(IRNode.variable(parameter.name), "Objective-C call " + descriptor.name + ": null argument " + parameter.name)); }
			}
			Vector<Node> argumentTypes = [];
			if (!descriptor.classMethod) {
				Node selfType = Node();
				selfType.kind = NK_TYPE_EXPR;
				selfType.base = imported.declaration.name;
				selfType.pointerDepth = 1;
				argumentTypes.push(selfType);
			}
			for parameter in method.params { argumentTypes.push(parameter.type); }
			Map<string, bool> parameterNames = {};
			for parameter in wrapper.params { parameterNames.put(parameter.name, true); }
			Vector<Vector<IRNode>> releases = [];
			Vector<IRNode> cleanup = [];
			for index in range(argumentTypes.len) {
				Node valueType = argumentTypes.get(index);
				if (!self.managedValues.isNative(valueType)) { continue; }
				if (cleanup.len == 0) { cleanup.push(self.nativeCleanupScope(parameterNames, statements)); }
				callArguments.set(index, self.emitNativeLease(index, valueType, callArguments.get(index), parameterNames, statements, releases));
			}
			IRNode failure = IRNode.call("__btrc_throw", [IRNode.literal("\"Objective-C exception in " + descriptor.name + "\"")]);
			failure.neverReturns = true;
			statements.push(IRNode.ifStatement(IRNode.call(adapter.name, callArguments), IRNode.block([IRNode.expressionStatement(failure)]), null));
			for (int index = releases.len - 1; index >= 0; index--) { statements.extend(releases.get(index)); }
			statements.extend(cleanup);
			if (returnsValue) {
				if (self.managedValues.isNative(method.returnType) && !method.returnType.isNullable) { statements.push(self.objectiveCNullGuard(result, "Objective-C call " + descriptor.name + ": null result")); }
				statements.push(IRNode.returnStatement(result));
			}
			wrapper.body = IRNode.block(statements);
			var prototype = IRFunctionDecl(name, wrapper.returnType, true);
			prototype.params = wrapper.params;
			module.functionDecls.push(prototype);
			module.functions.push(wrapper);
		}
	}

	private IRNode objectiveCNullGuard(IRNode value, string message) {
		self.context.referenceHelper("__btrc_throw");
		IRNode failure = IRNode.call("__btrc_throw", [IRNode.literal("\"" + message + "\"")]);
		failure.neverReturns = true;
		return IRNode.ifStatement(IRNode.binary(value, "==", IRNode.literal("NULL")), IRNode.block([IRNode.expressionStatement(failure)]), null);
	}

	private string objectiveCObjectType(string name) { return name == "id" ? "id" : name + "*"; }

	private void emitObjectiveCLifetime(FeNativeImportedDeclaration imported, IRModule module, IRModule native) {
		Vector<string> operations = ["retain", "release"];
		for operation in operations {
			var adapter = IRFunction();
			adapter.name = "__btrc_objc_" + imported.declaration.name + "_" + operation;
			adapter.returnType = "void";
			adapter.params.push(IRParam("void*", "value"));
			string nativeType = self.objectiveCObjectType(imported.declaration.name);
			IRNode value = IRNode.variable("value");
			Vector<IRNode> body = [];
			if (operation == "retain") {
				IRNode borrowed = IRNode.cast(nativeType, value, "borrow");
				body.push(IRNode.expressionStatement(IRNode.cast("void", IRNode.cast("void*", borrowed, "retain"))));
			} else {
				body.push(IRNode.variableDeclaration(nativeType, "owned", IRNode.cast(nativeType, value, "transfer")));
				body.push(IRNode.expressionStatement(IRNode.cast("void", IRNode.variable("owned"))));
			}
			Vector<IRNode> noArguments = [];
			IRNode failure = IRNode.call("abort", noArguments);
			failure.neverReturns = true;
			IRNode boundary = IRNode.objectiveCExceptionBoundary(IRNode.block(body), IRNode.block([IRNode.expressionStatement(failure)]));
			adapter.body = IRNode.block([IRNode.objectiveCAutoreleasePool(IRNode.block([boundary]))]);
			native.functions.push(adapter);
			var prototype = IRFunctionDecl(adapter.name, "void", false);
			prototype.params = adapter.params;
			module.functionDecls.push(prototype);
		}
	}

	public void emitDeclarations(Node prog, IRModule m) {
		for name in self.analyzed.interfaceTable.keys() { self.emitInterface(name, m); }
		Map<string, bool> nativeAdapters = {};
		Map<string, bool> nativeConstants = {};
		for imported in self.analyzed.nativeDeclarations {
			if (!self.validIncludeHeader(imported.header)) { self.preprocessorFail("invalid native include header"); }
			if (imported.language == "c") { self.appendPreprocessorDecl(m, IRPreprocessorDecl.include(imported.header, false)); }
			if (imported.declaration.kind == NK_CLASS_DECL && !imported.coalesced) {
				if (imported.resource != null) { self.emitResourceLifetime(imported, m); }
				else { self.emitObjectiveCAdapters(imported, m); }
			}
			if (imported.language == "objective-c" && imported.declaration.kind == NK_VAR_DECL_STMT && !nativeConstants.has(imported.declaration.name)) {
				if (imported.declaration.initializer == null) { self.emitObjectiveCGlobal(imported, m); }
				else { self.emitGlobalVar(imported.declaration, m, false); }
				nativeConstants.put(imported.declaration.name, true);
			}
			if (imported.declaration.kind == NK_FUNCTION_DECL && imported.callContract != null && !nativeAdapters.has(imported.declaration.name)) {
				self.emitNativeAdapter(imported.declaration, imported.callContract, m);
				nativeAdapters.put(imported.declaration.name, true);
			}
		}
		Map<string, bool> externallyDefinedGlobals = {};
		int globalDeclarationIndex = 0;
		while (globalDeclarationIndex < prog.declarations.len) {
			Node declaration = prog.declarations.get(globalDeclarationIndex);
			if (declaration.kind == NK_VAR_DECL_STMT && declaration.type != null && declaration.type.isExtern && self.analyzed.globalHasDefinition.has(declaration.name)) {
				externallyDefinedGlobals.put(declaration.name, true);
			}
			globalDeclarationIndex = globalDeclarationIndex + 1;
		}
		int i = 0;
		while (i < prog.declarations.len) {
			Node d = prog.declarations.get(i);
			if (self.analyzed.isNativeDeclaration(d)) {
				i++;
				continue;
			}
			if (d.kind == NK_CLASS_DECL) {
				if (d.genericParams.len == 0) { self.emitClassDecl(d, m); }
			} else if (d.kind == NK_FUNCTION_DECL) {
				if (d.isGpu) {
					self.functions.emitGpuCpuFallback(d, m);
					i = i + 1;
					continue;
				}
				/* Bodyless FunctionDecl (e.g. `bool is_even(int n);`) is a
                 * forward declaration, NOT a definition. Emit a typed callable
                 * declaration and skip function_defs — otherwise we'd emit an
                 * empty-bodied definition that collides with the real one
                 * (mirrors functions.emit_function_decl: body is None branch). */
				if (d.bodyNode == null) {
					string fret = self.cTypes.lower(d.returnType);
					if (fret == "") { fret = "void"; }
					IRFunctionDecl declaration = IRFunctionDecl(self.semanticDeclarations.sourceFunctionSymbol(d.name), fret, false);
					int fp = 0;
					while (fp < d.params.len) {
						Node pp = d.params.get(fp);
						declaration.params.push(self.cTypes.lowerParameter(pp));
						fp = fp + 1;
					}
					m.functionDecls.push(declaration);
				} else {
					m.functions.push(self.functions.lowerFunction(d));
				}
			} else if (d.kind == NK_STRUCT_DECL) {
				/* Forward tags were emitted in phase one; complete definitions
                 * were lowered above in by-value dependency order. */
			} else if (d.kind == NK_ENUM_DECL) {
				self.emitEnumDecl(d, m);
			} else if (d.kind == NK_RICH_ENUM_DECL) {
				self.emitRichEnumDecl(d, m);
			} else if (d.kind == NK_TYPEDEF_DECL) {
				/* Already lowered above in dependency order. */
			} else if (d.kind == NK_VAR_DECL_STMT) {
				bool redundantExtern = d.type != null && d.type.isExtern && d.initializer == null && self.analyzed.globalHasDefinition.has(d.name);
				if (!redundantExtern) {
					self.emitGlobalVar(d, m, externallyDefinedGlobals.has(d.name));
				}
			} else if (d.kind == NK_PREPROCESSOR_DIRECTIVE) {
				self.emitPreprocessor(d, m);
			}
			i = i + 1;
		}
	}

	/* Raw by-value structs must be complete before a monomorphized generic
     * struct embeds them. Keep their semantic dependency order as a dedicated
     * type-declaration phase, matching the reference pipeline's _emit_structs
     * before _emit_generic_collections. */
	public void emitStructDefinitions(Node prog, IRModule m) {
		Vector<Node> ordered = DeclarationValidator.orderedStructDefinitions(prog, self.analyzed.structTable);
		int index = 0;
		while (index < ordered.len) {
			if (!self.analyzed.isNativeDeclaration(ordered.get(index))) { self.emitStructDecl(ordered.get(index), m); }
			index = index + 1;
		}
	}

	/* Emit a plain enum (NK_ENUM_DECL) as a typed enum declaration plus a
     * static `<Name>_toString` switch function. */
	public void emitEnumDecl(Node d, IRModule m) {
		CallableFlowState callableFlow = CallableFlowState();
		string name = d.name;
		IREnumDef definition = IREnumDef(name);
		Map<string, bool> priorMembers = {};
		int i = 0;
		while (i < d.values.len) {
			Node v = d.values.get(i);
			IRNode value = null;
			if (v.valueNode != null) {
				Map<string, Node> empty = {};
				self.context.enumInitializer = true;
				self.context.enumOwner = name;
				self.context.enumMembers = priorMembers;
				value = self.expressions.lowerExpr(v.valueNode, empty, callableFlow);
				self.context.enumInitializer = false;
				self.context.enumOwner = "";
				self.context.enumMembers = {};
			}
			string emittedName = v.name;
			if (name != "") { emittedName = name + "_" + v.name; }
			definition.values.push(IREnumValue(emittedName, value));
			priorMembers.put(v.name, true);
			i = i + 1;
		}
		m.enumDefs.push(definition);
		/* static const char* Name_toString(Name val) { switch (val) {...} }.
         * It is an ordinary structured function, so reachability DCE prunes it
         * when unused. An anonymous enum (empty name) has no
         * usable toString name, so skip it entirely (the reference's `_toString`
         * is always dead and removed by DCE). */
		if (name != "") {
			m.functions.push(self.enumToStringFn(name, d.values, false));
		}
	}

	/* Emit a rich (tagged-union) enum (NK_RICH_ENUM_DECL): a tag enum, per-variant
     * data structs, a tagged-union struct, variant constructors, and a toString
     * function. Mirrors enums._emit_rich_enum. */
	public void emitRichEnumDecl(Node d, IRModule m) {
		string name = d.name;
		IREnumDef tagDefinition = IREnumDef(name + "_Tag");
		int i = 0;
		while (i < d.variants.len) {
			Node v = d.variants.get(i);
			tagDefinition.values.push(IREnumValue(name + "_" + v.name + "_TAG", IRNode.literal(Strings.fromInt(i))));
			i = i + 1;
		}
		m.enumDefs.push(tagDefinition);
		IRTaggedUnionDef tagged = IRTaggedUnionDef(name, name + "_Tag");
		int v2 = 0;
		while (v2 < d.variants.len) {
			Node v = d.variants.get(v2);
			IRTaggedUnionVariant variant = IRTaggedUnionVariant(v.name);
			int p = 0;
			while (p < v.params.len) {
				Node par = v.params.get(p);
				IRStructField variantField = IRStructField(self.cTypes.lower(par.type), self.hostedAbi.lexicalBindingCName(par.name, false));
				variantField.isVolatile = par.type != null && par.type.isVolatile;
				variantField.effectiveIsVolatile = SemanticTypeSystem.typeEffectiveOuterVolatile(par.type, self.analyzed.typedefTable);
				variant.fields.push(variantField);
				p = p + 1;
			}
			tagged.variants.push(variant);
			v2 = v2 + 1;
		}
		m.taggedUnionDefs.push(tagged);
		/* Variant constructors are ordinary IR functions so their field stores
         * participate in reachability and helper analysis. */
		int v4 = 0;
		while (v4 < d.variants.len) {
			Node v = d.variants.get(v4);
			IRFunction constructor = IRFunction();
			constructor.name = name + "_" + v.name;
			constructor.returnType = name;
			constructor.isStatic = true;
			Vector<IRNode> constructorBody = [];
			constructorBody.push(IRNode.variableDeclaration(name, "__result", null));
			constructorBody.push(IRNode.assignment(IRNode.fieldAccess(IRNode.variable("__result"), "tag", false), IRNode.variable(name + "_" + v.name + "_TAG")));
			int p2 = 0;
			while (p2 < v.params.len) {
				Node par = v.params.get(p2);
				constructor.params.push(self.cTypes.lowerParameter(par));
				IRNode payload = IRNode.fieldAccess(IRNode.fieldAccess(IRNode.variable("__result"), "data", false), v.name, false);
				constructorBody.push(IRNode.assignment(IRNode.fieldAccess(payload, self.hostedAbi.lexicalBindingCName(par.name, false), false), IRNode.variable(self.lexicalBindingCName(par.name))));
				p2 = p2 + 1;
			}
			constructorBody.push(IRNode.returnStatement(IRNode.variable("__result")));
			constructor.body = IRNode.block(constructorBody);
			m.functions.push(constructor);
			v4 = v4 + 1;
		}
		/* toString over the tag field. Pushed into m.functions so DCE prunes it
         * when unused (mirrors enums._emit_rich_enum's function_defs.append). */
		m.functions.push(self.enumToStringFn(name, d.variants, true));
	}

	/* Build `<Name>_toString` as structured comparisons so aliases remain
     * valid and the function still flows through reachability DCE. */
	public IRFunction enumToStringFn(string name, Vector<Node> items, bool rich) {
		IRNode switchExpr = IRNode.variable("val");
		if (rich) { switchExpr = IRNode.fieldAccess(IRNode.variable("val"), "tag", false); }
		Vector<IRNode> bodyStmts = [];
		int i = 0;
		while (i < items.len) {
			Node it = items.get(i);
			string caseLabel = name + "_" + it.name;
			if (rich) { caseLabel = caseLabel + "_TAG"; }
			Vector<IRNode> matchBody = [];
			matchBody.push(IRNode.returnStatement(IRNode.literal("\"" + it.name + "\"")));
			bodyStmts.push(IRNode.ifStatement(IRNode.binary(switchExpr, "==", IRNode.variable(caseLabel)), IRNode.block(matchBody), null));
			i = i + 1;
		}
		bodyStmts.push(IRNode.returnStatement(IRNode.literal("\"unknown\"")));
		IRFunction fn = IRFunction();
		fn.name = name + "_toString";
		fn.returnType = "const char*";
		fn.isStatic = true;
		fn.archiveExport = true;
		fn.params.push(IRParam(name, "val"));
		fn.body = IRNode.block(bodyStmts);
		return fn;
	}

	/* Lower a source `struct` definition to IRStructDef (mirrors
     * emit_struct_decl). An array field (`int buf[8]`) keeps its bound as an
     * IR expression and drops the array-ness from the element type. */
	public void emitStructDecl(Node d, IRModule m) {
		CallableFlowState callableFlow = CallableFlowState();
		IRStructDef sd = IRStructDef();
		sd.name = d.name;
		string declarationKey = AstIdentity.key(d);
		if (self.context.packAlignments.has(declarationKey)) {
			sd.packAlignment = self.context.packAlignments.get(declarationKey);
		}
		int i = 0;
		while (i < d.fields.len) {
			Node f = d.fields.get(i);
			if (f.type != null && f.type.isArray && f.type.arraySize != null) {
				Node baseType = TypeShape.withoutOuterArray(f.type);
				Map<string, Node> empty = {};
				IRStructField field = IRStructField(self.cTypes.lower(baseType), f.name);
				field.arraySize = self.expressions.lowerExpr(f.type.arraySize, empty, callableFlow);
				field.isVolatile = f.type.isVolatile;
				field.effectiveIsVolatile = SemanticTypeSystem.typeEffectiveOuterVolatile(f.type, self.analyzed.typedefTable);
				sd.fields.push(field);
			} else {
				IRStructField field = IRStructField(self.cTypes.lower(f.type), f.name);
				field.isVolatile = f.type != null && f.type.isVolatile;
				field.effectiveIsVolatile = SemanticTypeSystem.typeEffectiveOuterVolatile(f.type, self.analyzed.typedefTable);
				sd.fields.push(field);
			}
			i = i + 1;
		}
		m.structDefs.push(sd);
	}

	/* Top-level variable -> file-scope C global (mirrors _emit_declarations'
     * VarDeclStmt branch). Default storage is `static` (file linkage). A bare
     * `extern` remains an uninitialized declaration; a separate ordinary
     * definition paired with it receives external linkage. */
	public void emitGlobalVar(Node d, IRModule m, bool forceExternal) {
		CallableFlowState callableFlow = CallableFlowState();
		if (d.initializer != null) {
			Map<string, Node> globalTypes = {};
			CallableBoundaryContext callableContext = callableFlow.boundaryContext(globalTypes, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
			bool unsafe = callableFlow.persistentStorageUnsafe(d.type, d.initializer, self.callableValues, callableContext);
			self.callableBoundaries.rejectPersistentStorage(d.type, d.initializer, callableContext, unsafe, "global storage");
		}
		bool inferredArray = d.initializer != null && (d.initializer.kind == NK_LIST_LITERAL || d.initializer.kind == NK_BRACE_INITIALIZER);
		if (d.type != null && d.type.isArray && (d.type.arraySize != null || inferredArray || d.type.isExtern)) {
			Node elementType = TypeShape.withoutOuterArray(d.type);
			IRGlobalDecl global = IRGlobalDecl(self.cTypes.lower(elementType), d.name);
			global.isExtern = d.type.isExtern && !forceExternal;
			global.isStatic = !(global.isExtern || forceExternal);
			global.isVolatile = d.type.isVolatile;
			global.effectiveIsVolatile = SemanticTypeSystem.typeEffectiveOuterVolatile(d.type, self.analyzed.typedefTable);
			Map<string, Node> empty = {};
			if (d.type.arraySize != null) {
				global.arraySize = self.expressions.lowerExpr(d.type.arraySize, empty, callableFlow);
			} else if (inferredArray) {
				global.arraySize = IRNode.literal(Strings.fromInt(d.initializer.elements.len));
			} else {
				global.isUnsizedArray = true;
			}
			if (d.initializer != null) {
				global.init = self.expressions.lowerStaticInitializer(d.initializer, d.type, empty, callableFlow);
			}
			m.globalDecls.push(global);
			return;
		}
		string ct = "int";
		if (d.type != null) { ct = self.cTypes.lower(d.type); }
		IRGlobalDecl global = IRGlobalDecl(ct, d.name);
		global.isExtern = d.type != null && d.type.isExtern && !forceExternal;
		global.isStatic = !(global.isExtern || forceExternal);
		if (d.type != null) {
			global.isVolatile = d.type.isVolatile;
			global.effectiveIsVolatile = SemanticTypeSystem.typeEffectiveOuterVolatile(d.type, self.analyzed.typedefTable);
		}
		if (d.initializer != null && !global.isExtern) {
			Map<string, Node> empty = {};
			global.init = self.expressions.lowerStaticInitializer(d.initializer, d.type, empty, callableFlow);
		}
		m.globalDecls.push(global);
	}

	/* A supported preprocessor directive becomes a validated typed declaration;
     * #pragma pack has already become per-struct metadata. */
	public void emitPreprocessor(Node d, IRModule m) {
		string text = self.preprocessorTrim(d.text);
		if (self.isPackPragma(text)) { return; }
		self.lowerPreprocessorDirective(d.text, m);
	}

	/* Emit one generic instance: struct, typed callable declarations, then
     * init/new/destroy + methods (all `static`). */
	public void emitGenericInstance(GenInstance inst, IRModule m) {
		/* The same source AST is lowered once per concrete type map. Never let
         * one instance reuse another instance's inferred expression type. */
		self.functions.resetExpressionInferenceMemo();
		Node decl = self.analyzed.genericClassTable.get(inst.base);
		string mangled = inst.mangled;
		Map<string, Node> typeMap = {};
		int g = 0;
		while (g < decl.genericParams.len && g < inst.args.len) {
			typeMap.put(decl.genericParams.get(g), inst.args.get(g));
			g = g + 1;
		}

		/* ARC header, then resolved fields. */
		IRStructDef sd = IRStructDef();
		sd.name = mangled;
		self.managedTypes.appendHeaderField(sd);
		int fi = 0;
		while (fi < decl.members.len) {
			Node mem = decl.members.get(fi);
			string storage = DeclarationRegistry.instanceStorageName(mem);
			if (storage != "") {
				sd.fields.push(self.genericField(mem, storage, typeMap));
			}
			fi = fi + 1;
		}
		m.structDefs.push(sd);

		/* Constructor params (resolved). */
		Node? ctor = self.functions.genericConstructor(decl);
		Vector<IRParam> ctorParams = [];
		if (ctor != null) {
			int p = 0;
			while (p < ctor.params.len) {
				Node pp = ctor.params.get(p);
				ctorParams.push(self.cTypes.lowerResolvedParameter(pp, SemanticTypeSystem.resolveGenericType(pp.type, typeMap, self.analyzed), self.cTypes.lowerGeneric(pp.type, typeMap)));
				p = p + 1;
			}
		}

		IRFunctionDecl initDeclaration = IRFunctionDecl(mangled + "_init", "void", true);
		initDeclaration.params.push(IRParam(mangled + "*", "self"));
		int cp = 0;
		while (cp < ctorParams.len) {
			initDeclaration.params.push(ctorParams.get(cp));
			cp = cp + 1;
		}
		m.functionDecls.push(initDeclaration);

		IRFunctionDecl newDeclaration = IRFunctionDecl(mangled + "_new", mangled + "*", true);
		int q = 0;
		while (q < ctorParams.len) {
			newDeclaration.params.push(ctorParams.get(q));
			q = q + 1;
		}
		m.functionDecls.push(newDeclaration);

		IRFunctionDecl destroyDeclaration = IRFunctionDecl(mangled + "_destroy", "void", true);
		destroyDeclaration.params.push(IRParam("void*", "object"));
		m.functionDecls.push(destroyDeclaration);
		int mi = 0;
		while (mi < decl.members.len) {
			Node mem = decl.members.get(mi);
			if (mem.kind == NK_METHOD_DECL && !mem.isConstructor && mem.name != "__del__" && mem.genericParams.len == 0) {
				string retC = self.cTypes.lowerGeneric(mem.returnType, typeMap);
				IRFunctionDecl methodDeclaration = IRFunctionDecl(mangled + "_" + mem.name, retC, true);
				methodDeclaration.params.push(IRParam(mangled + "*", "self"));
				int k = 0;
				while (k < mem.params.len) {
					Node pp = mem.params.get(k);
					methodDeclaration.params.push(self.cTypes.lowerResolvedParameter(pp, SemanticTypeSystem.resolveGenericType(pp.type, typeMap, self.analyzed), self.cTypes.lowerGeneric(pp.type, typeMap)));
					k = k + 1;
				}
				m.functionDecls.push(methodDeclaration);
			}
			mi = mi + 1;
		}
		self.emitGenericPropertyForwardDecls(inst, decl, typeMap, m);

		/* Set context for body lowering: self -> the generic instance type, and
         * mark we're inside a generic method (raw operator lowering). */
		string savedClass = self.context.currentClass;
		string savedReturnC = self.context.currentReturnCType;
		Node? savedReturnType = self.context.currentReturnType;
		bool savedReturnOwned = self.context.currentReturnOwned;
		bool savedBatchExplicitReleases = self.context.batchExplicitReleases;
		bool savedCollectionEdgeKeeps = self.context.collectionEdgeKeeps;
		self.context.currentClass = mangled;
		self.context.genericBody = true;
		self.context.activeTypeMap = typeMap;
		self.context.batchExplicitReleases = false;
		self.context.collectionEdgeKeeps = self.cycleBoundaries.publicCollectionBase(inst.base);

		/* --- _init --- */
		IRFunction initFn = IRFunction();
		initFn.name = mangled + "_init";
		initFn.returnType = "void";
		initFn.isStatic = true;
		initFn.params.push(IRParam(mangled + "*", "self"));
		int ip = 0;
		while (ip < ctorParams.len) { initFn.params.push(ctorParams.get(ip)); ip = ip + 1; }
		Vector<IRNode> ibody = [];
		self.managedTypes.appendHeaderInitialization(mangled, ibody);
		self.context.currentReturnCType = "void";
		self.context.currentReturnType = null;
		self.context.currentReturnOwned = true;
		self.functions.resetFuncVarDecls();
		Map<string, Node> genericCtorVars = self.genericInitializerVarTypes(inst, ctor);
		Vector<string> constructorSourceBindings = self.context.snapshotSourceBindings();
		Vector<string> noConstructorSourceBindings = [];
		self.context.restoreSourceBindings(noConstructorSourceBindings);
		if (ctor != null) {
			self.functions.activateSourceLexicalParameters(ctor.params);
		}
		self.appendInstanceFieldInitializers(decl, genericCtorVars, true, typeMap, ibody);
		Vector<IRNode> ctorBodyStmts = [];
		if (ctor != null && ctor.bodyNode != null) {
			IRNode blk = self.functions.lowerBody(ctor.bodyNode, genericCtorVars);
			int b = 0;
			while (b < blk.stmts.len) { ctorBodyStmts.push(blk.stmts.get(b)); b = b + 1; }
		}
		self.context.restoreSourceBindings(constructorSourceBindings);
		/* Empty ctor body -> (void)self; to avoid unused-param warning. */
		if (ctorBodyStmts.len == 0) {
			ctorBodyStmts.push(IRNode.expressionStatement(IRNode.cast("void", IRNode.variable("self"))));
		}
		int cb = 0;
		while (cb < ctorBodyStmts.len) { ibody.push(ctorBodyStmts.get(cb)); cb = cb + 1; }
		initFn.body = IRNode.block(ibody);
		m.functions.push(initFn);

		/* --- _new --- */
		IRFunction newFn = IRFunction();
		newFn.name = mangled + "_new";
		newFn.returnType = mangled + "*";
		newFn.isStatic = true;
		int np = 0;
		while (np < ctorParams.len) { newFn.params.push(ctorParams.get(np)); np = np + 1; }
		Vector<IRNode> nbody = [];
		self.context.referenceHelper("__btrc_safe_calloc");
		Vector<IRNode> callocArgs = [];
		callocArgs.push(IRNode.literal("1"));
		callocArgs.push(IRNode.sizeofType(mangled));
		nbody.push(IRNode.variableDeclaration(mangled + "*", "self", IRNode.cast(mangled + "*", IRNode.call("__btrc_safe_calloc", callocArgs))));
		string cleanupMark = self.beginConstructorCleanup("self", nbody);
		Vector<IRNode> initArgs = [];
		initArgs.push(IRNode.variable("self"));
		int ia = 0;
		while (ia < ctorParams.len) { initArgs.push(IRNode.variable(ctorParams.get(ia).name)); ia = ia + 1; }
		nbody.push(IRNode.expressionStatement(IRNode.call(mangled + "_init", initArgs)));
		self.endConstructorCleanup(cleanupMark, nbody);
		nbody.push(IRNode.returnStatement(IRNode.variable("self")));
		newFn.body = IRNode.block(nbody);
		m.functions.push(newFn);

		/* Lower source __del__ into its own function so a source return cannot
         * bypass compiler-owned terminal finalization. */
		Node? genericDestructor = self.analyzed.genericClassMethod(inst.base, "__del__");
		bool hasDestructorHook = genericDestructor != null && genericDestructor.bodyNode != null;
		if (genericDestructor != null && genericDestructor.bodyNode != null) {
			self.context.currentReturnCType = "void";
			self.context.currentReturnType = null;
			self.context.currentReturnOwned = true;
			self.functions.resetFuncVarDecls();
			Map<string, Node> destructorTypes = self.functions.genericMethodVarTypes(inst, genericDestructor);
			IRNode destructorBlock = self.functions.lowerBody(genericDestructor.bodyNode, destructorTypes);
			Vector<IRNode> hookBody = [];
			int hookStatement = 0;
			while (hookStatement < destructorBlock.stmts.len) {
				hookBody.push(destructorBlock.stmts.get(hookStatement));
				hookStatement = hookStatement + 1;
			}
			m.functions.push(self.buildDestructorHook(mangled, hookBody));
		}

		/* --- _destroy --- (terminal destructor). Source lifecycle behavior is
         * explicit in the isolated __del__ hook. An ordinary method named free
         * has no compiler meaning; terminal destruction always detaches every
         * compiler-owned managed field before freeing the instance struct. */
		IRFunction dFn = IRFunction();
		dFn.name = mangled + "_destroy";
		dFn.returnType = "void";
		dFn.isStatic = true;
		dFn.params.push(IRParam("void*", "object"));
		Vector<IRNode> dbody = [];
		dbody.push(IRNode.variableDeclaration(mangled + "*", "self", IRNode.cast(mangled + "*", IRNode.variable("object"))));
		bool hasGenericFieldReleases = self.functions.emitGenericFieldReleases(decl, typeMap, dbody);
		if (hasGenericFieldReleases) {
			self.context.referenceHelper("__btrc_mark_destroyed");
			Vector<IRNode> markArgs = [];
			markArgs.push(IRNode.variable("self"));
			dbody.push(IRNode.expressionStatement(IRNode.call("__btrc_mark_destroyed", markArgs)));
		}
		Vector<IRNode> freeArgs = [];
		freeArgs.push(IRNode.variable("self"));
		dbody.push(IRNode.expressionStatement(IRNode.call("free", freeArgs)));
		dFn.body = IRNode.block(dbody);
		m.functions.push(dFn);
		self.cycleBoundaries.emitGenericVisitor(inst, decl, typeMap, m);
		int interfaceCount = self.emitInterfaceBindings(mangled, decl, m);
		self.managedTypes.emitDescriptor(m, mangled, self.cycles.genericInstanceNeedsVisitor(inst), hasDestructorHook, interfaceCount);

		/* --- methods --- */
		int m2 = 0;
		while (m2 < decl.members.len) {
			Node mem = decl.members.get(m2);
			if (mem.kind == NK_METHOD_DECL && !mem.isConstructor && mem.name != "__del__" && mem.genericParams.len == 0) {
				IRFunction fn = IRFunction();
				fn.name = mangled + "_" + mem.name;
				Node rrt = SemanticTypeSystem.resolveGenericType(mem.returnType, typeMap, self.analyzed);
				string retC = self.cTypes.lowerGeneric(mem.returnType, typeMap);
				fn.returnType = retC;
				fn.isStatic = true;
				fn.params.push(IRParam(mangled + "*", "self"));
				int mp2 = 0;
				while (mp2 < mem.params.len) {
					Node pp = mem.params.get(mp2);
					fn.params.push(self.cTypes.lowerResolvedParameter(pp, SemanticTypeSystem.resolveGenericType(pp.type, typeMap, self.analyzed), self.cTypes.lowerGeneric(pp.type, typeMap)));
					mp2 = mp2 + 1;
				}
				self.context.currentReturnCType = retC;
				self.context.currentReturnType = rrt;
				self.context.currentReturnOwned = true;
				bool publicCollectionMethod = self.cycleBoundaries.publicCollectionBase(inst.base) && mem.access == "public";
				bool topologyCollection = self.cycleBoundaries.publicCollectionBase(inst.base) && self.cycles.genericInstanceNeedsVisitor(inst);
				self.context.batchExplicitReleases = publicCollectionMethod;
				Vector<IRNode> mbody = [];
				if (mem.bodyNode != null) {
					Vector<string> methodSourceBindings = self.functions.replaceSourceLexicalParameters(mem.params);
					self.functions.resetFuncVarDecls();
					Map<string, Node> vt = self.functions.genericMethodVarTypes(inst, mem);
					IRNode blk = self.functions.lowerBody(mem.bodyNode, vt);
					int b = 0;
					while (b < blk.stmts.len) { mbody.push(blk.stmts.get(b)); b = b + 1; }
					self.context.restoreSourceBindings(methodSourceBindings);
				}
				if (mbody.len == 0) {
					mbody.push(IRNode.expressionStatement(IRNode.cast("void", IRNode.variable("self"))));
				}
				fn.body = IRNode.block(mbody);
				if (topologyCollection) {
					self.cycleBoundaries.installCollectionTopologyBoundary(fn);
				}
				if (publicCollectionMethod) {
					self.cycleReturns.installReleaseBearingBoundary(fn);
				}
				m.functions.push(fn);
			}
			m2 = m2 + 1;
		}
		self.emitGenericProperties(inst, decl, typeMap, m);
		self.context.currentClass = savedClass;
		self.context.currentReturnCType = savedReturnC;
		self.context.currentReturnType = savedReturnType;
		self.context.currentReturnOwned = savedReturnOwned;
		self.context.batchExplicitReleases = savedBatchExplicitReleases;
		self.context.collectionEdgeKeeps = savedCollectionEdgeKeeps;
		self.context.genericBody = false;
		self.context.activeTypeMap = {};
	}

	/* Emit every monomorphized generic-METHOD function recorded by the analyzer.
     * Each is emitted with a combined type map binding both the class type
     * params (T, ...) and the method type params (U, ...) to the concrete types
     * for that call site. Bodies lower via the same generic-method machinery so
     * cross-type dispatch (e.g. building a Vector<U> inside the body) resolves.
     * Mirrors generics.methods_mono.emit_generic_method_instances. */
	private void appendInterfaceFunction(IRFunction callable, IRModule module) {
		var prototype = IRFunctionDecl(callable.name, callable.returnType, true);
		prototype.params = callable.params;
		module.functionDecls.push(prototype);
		module.functions.push(callable);
	}

	private void emitInterface(string name, IRModule module) {
		if (self.analyzed.interfaceTable.get(name).genericParams.len > 0) { return; }
		string tableName = f"__btrc_interface_{name.length()}_{name}";
		var table = IRStructDef();
		table.name = tableName;
		for method in self.analyzed.interfaceMethods(name) {
			var dispatch = IRFunction();
			dispatch.name = name + "_" + method.name;
			dispatch.returnType = self.cTypes.lower(method.returnType);
			dispatch.isStatic = true;
			dispatch.params.push(IRParam(name + "*", "self"));
			var signature = IRFunctionPointerTypedef(tableName + "_" + method.name + "_fn", dispatch.returnType);
			signature.paramTypes.push("void*");
			Vector<IRNode> arguments = [IRNode.variable("self")];
			for parameter in method.params {
				var lowered = self.cTypes.lowerParameter(parameter);
				dispatch.params.push(lowered);
				signature.paramTypes.push(lowered.cType);
				arguments.push(IRNode.variable(lowered.name));
			}
			module.functionPointerTypedefs.push(signature);
			table.fields.push(IRStructField(signature.name, method.name));
			self.context.referenceHelper("__btrc_interface_methods");
			IRNode lookup = IRNode.call("__btrc_interface_methods", [IRNode.variable("self"), IRNode.literal("\"" + name + "\"")]);
			string tableType = "const struct " + tableName + "*";
			IRNode methods = IRNode.variableDeclaration(tableType, "__btrc_methods", IRNode.cast(tableType, lookup));
			IRNode call = IRNode.indirectCall(IRNode.fieldAccess(IRNode.variable("__btrc_methods"), method.name, true), arguments);
			dispatch.body = IRNode.block([methods, dispatch.returnType == "void" ? IRNode.expressionStatement(call) : IRNode.returnStatement(call)]);
			self.appendInterfaceFunction(dispatch, module);
		}
		if (table.fields.len > 0) { module.structDefs.push(table); }
	}

	private int emitInterfaceBindings(string emittedName, Node declaration, IRModule module) {
		if (declaration.isAbstract) { return 0; }
		Vector<IRNode> entries = [];
		Vector<string> names = self.analyzed.interfaceTable.keys().sorted();
		for name in names {
			if (self.analyzed.interfaceTable.get(name).genericParams.len > 0 || !self.analyzed.isSubclass(declaration.name, name)) { continue; }
			Vector<Node> requirements = self.analyzed.interfaceMethods(name);
			Vector<IRNode> methods = [];
			for requirement in requirements {
				var thunk = IRFunction();
				thunk.name = f"__btrc_interface_impl_{emittedName.length()}_{emittedName}_{name.length()}_{name}_{requirement.name}";
				thunk.returnType = self.cTypes.lower(requirement.returnType);
				thunk.isStatic = true;
				thunk.params.push(IRParam("void*", "__btrc_receiver"));
				Vector<IRNode> arguments = [IRNode.cast(emittedName + "*", IRNode.variable("__btrc_receiver"))];
				for parameter in requirement.params {
					var lowered = self.cTypes.lowerParameter(parameter);
					thunk.params.push(lowered);
					arguments.push(IRNode.variable(lowered.name));
				}
				IRNode call = IRNode.call(emittedName + "_" + requirement.name, arguments);
				thunk.body = IRNode.block([thunk.returnType == "void" ? IRNode.expressionStatement(call) : IRNode.returnStatement(call)]);
				self.appendInterfaceFunction(thunk, module);
				methods.push(IRNode.functionReference(thunk.name));
			}
			var table = IRGlobalDecl(methods.len > 0 ? f"const struct __btrc_interface_{name.length()}_{name}" : "const unsigned char", f"__btrc_interface_table_{emittedName.length()}_{emittedName}_{name}");
			table.init = methods.len > 0 ? IRNode.initializerList(methods) : IRNode.literal("0");
			module.globalDecls.push(table);
			entries.push(IRNode.initializerList([IRNode.literal("\"" + name + "\""), IRNode.addressOf(IRNode.variable(table.name))]));
		}
		if (entries.len > 0) {
			var directory = IRGlobalDecl("const __btrc_interface_entry", "__btrc_interfaces_" + emittedName);
			directory.isUnsizedArray = true;
			directory.init = IRNode.initializerList(entries);
			module.globalDecls.push(directory);
		}
		return entries.len;
	}

	public void emitClassDecl(Node decl, IRModule m) {
		self.context.currentClass = decl.name;
		self.emitClassStruct(decl, m);
		self.emitClassStaticFields(decl, m);
		self.emitMethodForwardDecls(decl, m);
		self.emitConstructor(decl, m);
		bool hasDestructorHook = self.emitDestructor(decl, m);
		int interfaceCount = self.emitInterfaceBindings(decl.name, decl, m);
		self.managedTypes.emitDescriptor(m, decl.name, self.cycles.classNeedsVisitor(decl.name), hasDestructorHook, interfaceCount);

		/* Own methods + properties (skip constructor + __del__). */
		Map<string, bool> ownMethods = {};
		Map<string, bool> ownProperties = {};
		int i = 0;
		while (i < decl.members.len) {
			Node mem = decl.members.get(i);
			if (mem.kind == NK_METHOD_DECL && !mem.isConstructor && mem.name != "__del__") {
				ownMethods.put(mem.name, true);
				if (mem.genericParams.len == 0 && !mem.isAbstract && mem.bodyNode != null) {
					m.functions.push(self.lowerMethod(decl, mem));
				}
			} else if (mem.kind == NK_PROPERTY_DECL) {
				self.emitProperty(decl, mem, m);
				ownProperties.put(mem.name, true);
			}
			i = i + 1;
		}

		/* Inherited method wrappers for methods not overridden. */
		string par = DeclarationRegistry.parentName(decl);
		if (par != "" && self.analyzed.isClass(par)) {
			self.emitInheritedMethods(decl, ownMethods, m);
			self.emitInheritedProperties(decl, ownProperties, m);
		}
		self.context.currentClass = "";
	}

	/* Emit the struct: ARC header first, then parent fields, then own fields, then
     * property backing fields (mirrors _emit_class_struct). */
	public void emitClassStruct(Node decl, IRModule m) {
		IRStructDef sd = IRStructDef();
		sd.name = decl.name;
		string declarationKey = AstIdentity.key(decl);
		if (self.context.packAlignments.has(declarationKey)) {
			sd.packAlignment = self.context.packAlignments.get(declarationKey);
		}
		self.managedTypes.appendHeaderField(sd);
		/* Parent fields (single-level chain handled by recursion). */
		string par = DeclarationRegistry.parentName(decl);
		if (par != "" && self.analyzed.isClass(par)) {
			self.appendParentFields(par, sd);
		}
		int i = 0;
		while (i < decl.members.len) {
			Node mem = decl.members.get(i);
			string storage = DeclarationRegistry.instanceStorageName(mem);
			if (storage != "") {
				sd.fields.push(self.field(mem, storage));
			}
			i = i + 1;
		}
		m.structDefs.push(sd);
	}

	/* Append a parent class's own fields (recursively, ancestors first) into a
     * struct def. Python copies parent.fields (which already include ancestors)
     * in insertion order; we recurse parent-first to match. */
	public void appendParentFields(string cls, IRStructDef sd) {
		if (!self.analyzed.isClass(cls)) { return; }
		Node decl = self.analyzed.classTable.get(cls);
		string par = DeclarationRegistry.parentName(decl);
		if (par != "" && self.analyzed.isClass(par)) {
			self.appendParentFields(par, sd);
		}
		int i = 0;
		while (i < decl.members.len) {
			Node mem = decl.members.get(i);
			string storage = DeclarationRegistry.instanceStorageName(mem);
			if (storage != "") {
				sd.fields.push(self.field(mem, storage));
			}
			i = i + 1;
		}
	}

	/* Forward declarations for the constructor + own methods + inherited method
     * wrappers (mirrors _emit_method_forward_decls). */
	public void emitMethodForwardDecls(Node decl, IRModule m) {
		string name = decl.name;
		Node? ctor = self.analyzed.classConstructor(name);
		IRFunctionDecl initDeclaration = IRFunctionDecl(name + "_init", "void", false);
		initDeclaration.params.push(IRParam(name + "*", "self"));
		IRFunctionDecl newDeclaration = IRFunctionDecl(name + "_new", name + "*", false);
		if (ctor != null) {
			int constructorParam = 0;
			while (constructorParam < ctor.params.len) {
				Node parameter = ctor.params.get(constructorParam);
				IRParam irParameter = self.cTypes.lowerParameter(parameter);
				initDeclaration.params.push(irParameter);
				newDeclaration.params.push(self.cTypes.copyParameter(irParameter));
				constructorParam = constructorParam + 1;
			}
		}
		m.functionDecls.push(initDeclaration);
		m.functionDecls.push(newDeclaration);
		/* Own methods. */
		Map<string, bool> own = {};
		Map<string, bool> ownProperties = {};
		int i = 0;
		while (i < decl.members.len) {
			Node mem = decl.members.get(i);
			if (mem.kind == NK_METHOD_DECL) { own.put(mem.name, true); }
			if (mem.kind == NK_METHOD_DECL && !mem.isConstructor && mem.name != "__del__" && mem.genericParams.len == 0) {
				bool isStatic = mem.access == "class";
				string ret = self.cTypes.lower(mem.returnType);
				IRFunctionDecl methodDeclaration = IRFunctionDecl(name + "_" + mem.name, ret, false);
				if (!isStatic) {
					methodDeclaration.params.push(IRParam(name + "*", "self"));
				}
				int methodParam = 0;
				while (methodParam < mem.params.len) {
					Node parameter = mem.params.get(methodParam);
					methodDeclaration.params.push(self.cTypes.lowerParameter(parameter));
					methodParam = methodParam + 1;
				}
				m.functionDecls.push(methodDeclaration);
			} else if (mem.kind == NK_PROPERTY_DECL) {
				ownProperties.put(mem.name, true);
				string propertyType = self.cTypes.lower(mem.type);
				if (mem.hasGetter) {
					IRFunctionDecl getter = IRFunctionDecl(name + "_get_" + mem.name, propertyType, false);
					getter.params.push(IRParam(name + "*", "self"));
					m.functionDecls.push(getter);
				}
				if (mem.hasSetter) {
					IRFunctionDecl setter = IRFunctionDecl(name + "_set_" + mem.name, "void", false);
					setter.params.push(IRParam(name + "*", "self"));
					setter.params.push(self.cTypes.lowerNamedParameter(mem.type, propertyType, self.lexicalBindingCName("value")));
					m.functionDecls.push(setter);
				}
			}
			i = i + 1;
		}
		/* Inherited method wrapper fwds: the immediate parent's merged method
         * set, in order, minus this class's own methods. */
		string par = DeclarationRegistry.parentName(decl);
		if (par != "" && self.analyzed.isClass(par)) {
			Vector<MethodEntry> pm = self.analyzed.mergedMethods(par);
			int k = 0;
			while (k < pm.len) {
				MethodEntry e = pm.get(k);
				if (!own.has(e.name) && e.sig.genericParams.len == 0) {
					string ret = self.cTypes.lower(e.sig.returnType);
					IRFunctionDecl wrapper = IRFunctionDecl(name + "_" + e.name, ret, false);
					if (e.sig.access != "class") {
						wrapper.params.push(IRParam(name + "*", "self"));
					}
					int wrapperParam = 0;
					while (wrapperParam < e.sig.params.len) {
						Node parameter = e.sig.params.get(wrapperParam);
						wrapper.params.push(self.cTypes.lowerParameter(parameter));
						wrapperParam = wrapperParam + 1;
					}
					m.functionDecls.push(wrapper);
				}
				k = k + 1;
			}
		}
		self.emitInheritedPropertyForwardDecls(decl, ownProperties, m);
	}

	/* "T1 n1, T2 n2, ..." for a param list (empty string for no params). */

	/* Emit X_init(self, ...) and X_new(...) (mirrors _emit_constructor). */
	public void emitConstructor(Node decl, IRModule m) {
		string name = decl.name;
		Node? ctor = self.analyzed.classConstructor(name);

		/* X_init params: self + ctor params. */
		IRFunction initFn = IRFunction();
		initFn.name = name + "_init";
		initFn.returnType = "void";
		initFn.params.push(IRParam(name + "*", "self"));
		if (ctor != null) {
			int i = 0;
			while (i < ctor.params.len) {
				Node p = ctor.params.get(i);
				initFn.params.push(self.cTypes.lowerParameter(p));
				i = i + 1;
			}
		}
		Vector<IRNode> body = [];
		self.managedTypes.appendHeaderInitialization(name, body);
		self.context.currentReturnCType = "void";
		self.context.currentReturnType = null;
		self.context.currentReturnOwned = true;
		self.functions.resetFuncVarDecls();
		Map<string, Node> ctorVars = self.ctorVarTypes(decl, ctor);
		Vector<string> sourceBindings = self.context.snapshotSourceBindings();
		Vector<string> noSourceBindings = [];
		self.context.restoreSourceBindings(noSourceBindings);
		if (ctor != null) {
			self.functions.activateSourceLexicalParameters(ctor.params);
		}
		Map<string, Node> noTypeMap = {};
		self.appendInstanceFieldInitializers(decl, ctorVars, false, noTypeMap, body);
		/* Constructor body (user code). */
		if (ctor != null && ctor.bodyNode != null) {
			IRNode blk = self.functions.lowerBody(ctor.bodyNode, ctorVars);
			int k = 0;
			while (k < blk.stmts.len) { body.push(blk.stmts.get(k)); k = k + 1; }
		}
		self.context.restoreSourceBindings(sourceBindings);
		initFn.body = IRNode.block(body);
		m.functions.push(initFn);

		/* X_new: checked zeroed allocation + init + return. */
		IRFunction newFn = IRFunction();
		newFn.name = name + "_new";
		newFn.returnType = name + "*";
		Vector<IRNode> nbody = [];
		self.context.referenceHelper("__btrc_safe_calloc");
		Vector<IRNode> callocArgs = [];
		callocArgs.push(IRNode.literal("1"));
		callocArgs.push(IRNode.sizeofType(name));
		IRNode callocCall = IRNode.cast(name + "*", IRNode.call("__btrc_safe_calloc", callocArgs));
		nbody.push(IRNode.variableDeclaration(name + "*", "self", callocCall));
		string cleanupMark = self.beginConstructorCleanup("self", nbody);
		Vector<IRNode> initArgs = [];
		initArgs.push(IRNode.variable("self"));
		if (ctor != null) {
			int p = 0;
			while (p < ctor.params.len) {
				newFn.params.push(self.cTypes.lowerParameter(ctor.params.get(p)));
				initArgs.push(IRNode.variable(self.lexicalBindingCName(ctor.params.get(p).name)));
				p = p + 1;
			}
		}
		nbody.push(IRNode.expressionStatement(IRNode.call(name + "_init", initArgs)));
		self.endConstructorCleanup(cleanupMark, nbody);
		nbody.push(IRNode.returnStatement(IRNode.variable("self")));
		newFn.body = IRNode.block(nbody);
		m.functions.push(newFn);
	}

	/* var-type map for lowering a constructor body: `self` -> class type, plus
     * each ctor param -> its declared type. */
	public Map<string, Node> ctorVarTypes(Node decl, Node? ctor) {
		Map<string, Node> vt = self.functions.seededVarTypes();
		vt.put("self", SemanticTypeSystem.classReference(SemanticTypeSystem.namedClass(decl.name)));
		if (ctor != null) {
			int i = 0;
			while (i < ctor.params.len) {
				Node p = ctor.params.get(i);
				vt.put(p.name, p.type);
				i = i + 1;
			}
		}
		return vt;
	}

	/* Emit an isolated source __del__ hook followed by X_destroy(self), whose
     * field detachment and free cannot be bypassed by a source return. */
	public bool emitDestructor(Node decl, IRModule m) {
		string name = decl.name;
		IRFunction fn = IRFunction();
		fn.name = name + "_destroy";
		fn.returnType = "void";
		fn.params.push(IRParam("void*", "object"));
		Vector<IRNode> body = [];
		body.push(IRNode.variableDeclaration(name + "*", "self", IRNode.cast(name + "*", IRNode.variable("object"))));
		Node? dtor = self.analyzed.classMethod(name, "__del__");
		if (dtor != null && dtor.kind == NK_METHOD_DECL && dtor.bodyNode != null) {
			self.context.currentReturnCType = "void";
			self.context.currentReturnType = null;
			self.context.currentReturnOwned = true;
			self.functions.resetFuncVarDecls();
			Map<string, Node> vt = self.functions.seededVarTypes();
			vt.put("self", SemanticTypeSystem.classReference(SemanticTypeSystem.namedClass(name)));
			IRNode blk = self.functions.lowerBody(dtor.bodyNode, vt);
			Vector<IRNode> hookBody = [];
			int k = 0;
			while (k < blk.stmts.len) {
				hookBody.push(blk.stmts.get(k));
				k = k + 1;
			}
			m.functions.push(self.buildDestructorHook(name, hookBody));
		}
		/* Release class-instance fields (own + inherited), in source order. */
		bool hasFieldReleases = self.emitFieldReleases(name, body);
		/* Mark cascade destruction before freeing. The helper itself checks
         * the process-wide unwind scope under the ARC mutation lock. */
		if (hasFieldReleases) {
			Vector<IRNode> mdArgs = [];
			mdArgs.push(IRNode.variable("self"));
			body.push(IRNode.expressionStatement(IRNode.call("__btrc_mark_destroyed", mdArgs)));
		}
		/* free(self) */
		Vector<IRNode> fargs = [];
		fargs.push(IRNode.variable("self"));
		body.push(IRNode.expressionStatement(IRNode.call("free", fargs)));
		fn.body = IRNode.block(body);
		m.functions.push(fn);
		/* ARC: cycle-detection visitor for cyclable classes (after the dtor so
         * the visitor's forward use of {name}_destroy is already declared).
         * Mirrors classes._emit_visitor, gated on is_cyclable. */
		if (self.cycles.classNeedsVisitor(name)) {
			self.emitVisitor(name, m);
		}
		return dtor != null && dtor.kind == NK_METHOD_DECL && dtor.bodyNode != null;
	}

	/* Emit an exactly type-erased `X_visit(void*, callback)` which calls fn on
     * the ADDRESS of each cyclable-class field, so the cycle collector can trial-
     * decrement or NULL them. A cyclable class always gets a visitor even with no
     * directly-cyclable field (the collector references X_visit unconditionally).
    * Mirrors classes._emit_visitor. */
	public void emitVisitor(string name, IRModule m) {
		self.context.referenceHelper("__btrc_arc_callback_types");
		IRFunctionDecl visitorDeclaration = IRFunctionDecl(self.cycles.visitorName(name), "void", true);
		visitorDeclaration.params.push(IRParam("void*", "object"));
		visitorDeclaration.params.push(IRParam("__btrc_field_visit_fn", "fn"));
		visitorDeclaration.params.push(IRParam("void*", "context"));
		m.functionDecls.push(visitorDeclaration);

		IRFunction fn = IRFunction();
		fn.name = self.cycles.visitorName(name);
		fn.returnType = "void";
		fn.isStatic = true;
		fn.archiveExport = true;
		fn.params.push(IRParam("void*", "object"));
		fn.params.push(IRParam("__btrc_field_visit_fn", "fn"));
		fn.params.push(IRParam("void*", "context"));
		Vector<IRNode> body = [];
		body.push(IRNode.variableDeclaration(name + "*", "self", IRNode.cast(name + "*", IRNode.variable("object"))));

		Vector<Node> fields = [];
		self.cycles.collectClassFields(name, fields);
		bool visited = false;
		int i = 0;
		while (i < fields.len) {
			Node fd = fields.get(i);
			Node ft = fd.type;
			if (ft != null) {
				IRNode field = IRNode.fieldAccess(IRNode.variable("self"), DeclarationRegistry.instanceStorageName(fd), true);
				if (self.cycleBoundaries.appendClassFieldVisit(ft, field, body)) {
					visited = true;
				}
			}
			i = i + 1;
		}
		if (!visited) {
			body.push(IRNode.expressionStatement(IRNode.cast("void", IRNode.variable("self"))));
			body.push(IRNode.expressionStatement(IRNode.cast("void", IRNode.variable("fn"))));
			body.push(IRNode.expressionStatement(IRNode.cast("void", IRNode.variable("context"))));
		}
		fn.body = IRNode.block(body);
		m.functions.push(fn);
	}

	/* Append `if (self->f) { if (--self->f->__rc <= 0) F_destroy(self->f); }` for
     * each class-instance field of `cls` (and ancestors). Mirrors emit_destructor
     * field-release loop (cls_info.fields iterates own+inherited). */
	public bool emitFieldReleases(string cls, Vector<IRNode> body) {
		/* Build the ordered field list the way Python's cls_info.fields does:
         * inherited first, then own. */
		Vector<Node> fields = [];
		self.cycles.collectClassFields(cls, fields);
		bool any = false;
		int i = 0;
		while (i < fields.len) {
			Node fd = fields.get(i);
			Node ft = fd.type;
			if (self.managedValues.isManaged(self.cTypes.resolveBodyType(ft, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))) {
				body.push(self.managedTypes.releaseField(DeclarationRegistry.instanceStorageName(fd), ft));
				if (self.managedValues.isArc(self.cTypes.resolveBodyType(ft, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))) {
					any = true;
				}
			}
			i = i + 1;
		}
		return any;
	}

	/* Lower a method to X_method(self, params...) (mirrors emit_method). */
	public IRFunction lowerMethod(Node decl, Node method) {
		string name = decl.name;
		bool isStatic = method.access == "class";
		IRFunction fn = IRFunction();
		fn.name = name + "_" + method.name;
		fn.isRealtime = method.isRealtime;
		string ret = self.cTypes.lower(method.returnType);
		fn.returnType = ret;
		Map<string, Node> vt = self.functions.seededVarTypes();
		if (!isStatic) {
			fn.params.push(IRParam(name + "*", "self"));
			vt.put("self", SemanticTypeSystem.classReference(SemanticTypeSystem.namedClass(name)));
		}
		int i = 0;
		while (i < method.params.len) {
			Node p = method.params.get(i);
			fn.params.push(self.cTypes.lowerParameter(p));
			vt.put(p.name, p.type);
			i = i + 1;
		}
		self.context.currentReturnCType = ret;
		self.context.currentReturnType = method.returnType;
		self.context.currentReturnOwned = true;
		self.functions.resetFuncVarDecls();
		if (method.bodyNode != null) {
			Vector<string> sourceBindings = self.functions.replaceSourceLexicalParameters(method.params);
			/* Hoist to a local: btrcpy double-evaluates `field = call()`. */
			IRNode mb = self.functions.lowerBody(method.bodyNode, vt);
			fn.body = mb;
			self.context.restoreSourceBindings(sourceBindings);
		} else {
			Vector<IRNode> empty = [];
			fn.body = IRNode.block(empty);
		}
		return fn;
	}

	/* Emit getter/setter for a property (mirrors emit_property). */
	/* Auto-property backing storage is declaration-owned: it is generated
     * alongside the setter and never participates in recursive expression
     * dispatch. */
	private void emitAutoPropertyStore(Node propertyType, IRNode target, IRNode value, Vector<IRNode> body) {
		Node concreteType = self.cTypes.resolveBodyType(propertyType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
		if (!self.managedValues.isManaged(concreteType)) {
			body.push(IRNode.assignment(target, value));
			return;
		}
		if (self.managedValues.isArc(concreteType)) {
			body.push(IRNode.expressionStatement(self.managedLifetime.replaceEdge(target, value, propertyType, IRNode.variable("self"), false)));
			string runtimeType = self.managedValues.runtimeType(concreteType);
			if (self.cycles.runtimeTypeMayCycle(runtimeType)) {
				body.push(IRNode.expressionStatement(self.managedLifetime.pollCycles()));
			}
			return;
		}
		string oldName = self.context.freshTemporary("__btrc_property_old");
		IRNode oldDeclaration = IRNode.variableDeclaration(self.cTypes.lower(propertyType), oldName, target);
		self.context.recordLocal(oldDeclaration);
		body.push(oldDeclaration);
		body.push(IRNode.expressionStatement(self.managedLifetime.unlinkEdge(IRNode.variable(oldName), propertyType, IRNode.variable("self"))));
		body.push(IRNode.expressionStatement(self.managedLifetime.retainEdge(value, propertyType, IRNode.variable("self"))));
		body.push(IRNode.assignment(target, value));
		body.push(IRNode.expressionStatement(self.managedLifetime.releaseEdge(IRNode.variable(oldName), propertyType, value)));
		string runtimeType = self.managedValues.runtimeType(concreteType);
		if (self.cycles.runtimeTypeMayCycle(runtimeType)) {
			body.push(IRNode.expressionStatement(self.managedLifetime.pollCycles()));
		}
	}

	public void emitProperty(Node decl, Node prop, IRModule m) {
		string name = decl.name;
		string propType = self.cTypes.lower(prop.type);
		string backing = DeclarationRegistry.instanceStorageName(prop);
		string savedReturnC = self.context.currentReturnCType;
		Node? savedReturnType = self.context.currentReturnType;
		bool savedReturnOwned = self.context.currentReturnOwned;
		string savedPropertyBacking = self.context.currentPropertyBacking;
		if (prop.hasGetter) {
			IRFunction g = IRFunction();
			g.name = name + "_get_" + prop.name;
			g.returnType = propType;
			g.params.push(IRParam(name + "*", "self"));
			Vector<IRNode> gb = [];
			if (prop.getterBody != null) {
				self.context.currentReturnCType = propType;
				self.context.currentReturnType = prop.type;
				/* Custom getters are call-shaped +1 projections. */
				self.context.currentReturnOwned = true;
				if (DeclarationRegistry.propertyNeedsBacking(prop)) {
					self.context.currentPropertyBacking = prop.name;
				} else {
					self.context.currentPropertyBacking = "";
				}
				self.functions.resetFuncVarDecls();
				Map<string, Node> vt = self.functions.seededVarTypes();
				vt.put("self", SemanticTypeSystem.classReference(SemanticTypeSystem.namedClass(name)));
				IRNode blk = self.functions.lowerBody(prop.getterBody, vt);
				self.context.currentPropertyBacking = savedPropertyBacking;
				int k = 0;
				while (k < blk.stmts.len) { gb.push(blk.stmts.get(k)); k = k + 1; }
			} else {
				gb.push(IRNode.returnStatement(IRNode.fieldAccess(IRNode.variable("self"), backing, true)));
			}
			g.body = IRNode.block(gb);
			m.functions.push(g);
		}
		if (prop.hasSetter) {
			string valueCName = self.lexicalBindingCName("value");
			IRFunction s = IRFunction();
			s.name = name + "_set_" + prop.name;
			s.returnType = "void";
			s.params.push(IRParam(name + "*", "self"));
			s.params.push(self.cTypes.lowerNamedParameter(prop.type, propType, valueCName));
			Vector<IRNode> sb = [];
			if (prop.setterBody != null) {
				self.context.currentReturnCType = "void";
				self.context.currentReturnType = null;
				self.context.currentReturnOwned = false;
				if (DeclarationRegistry.propertyNeedsBacking(prop)) {
					self.context.currentPropertyBacking = prop.name;
				} else {
					self.context.currentPropertyBacking = "";
				}
				self.functions.resetFuncVarDecls();
				Map<string, Node> vt = self.functions.seededVarTypes();
				vt.put("self", SemanticTypeSystem.classReference(SemanticTypeSystem.namedClass(name)));
				vt.put("value", prop.type);
				Vector<string> sourceBindings = self.context.snapshotSourceBindings();
				Vector<string> noSourceBindings = [];
				self.context.restoreSourceBindings(noSourceBindings);
				self.context.activateSourceName("value", self.lexicalBindingCName("value"));
				IRNode blk = self.functions.lowerBody(prop.setterBody, vt);
				self.context.currentPropertyBacking = savedPropertyBacking;
				self.context.restoreSourceBindings(sourceBindings);
				int k = 0;
				while (k < blk.stmts.len) { sb.push(blk.stmts.get(k)); k = k + 1; }
			} else {
				self.emitAutoPropertyStore(prop.type, IRNode.fieldAccess(IRNode.variable("self"), backing, true), IRNode.variable(valueCName), sb);
			}
			s.body = IRNode.block(sb);
			m.functions.push(s);
		}
		self.context.currentReturnCType = savedReturnC;
		self.context.currentReturnType = savedReturnType;
		self.context.currentReturnOwned = savedReturnOwned;
		self.context.currentPropertyBacking = savedPropertyBacking;
	}

	/* Emit wrapper functions for inherited methods not overridden (mirrors
     * emit_inherited_methods). Each wrapper casts self to the IMMEDIATE parent
     * type and calls the immediate parent's method, which itself may be a wrapper
     * (single-hop chaining). Iterates the immediate parent's merged method set. */
	public void emitInheritedMethods(Node decl, Map<string, bool> ownMethods, IRModule m) {
		string name = decl.name;
		string par = DeclarationRegistry.parentName(decl);
		if (par == "" || !self.analyzed.isClass(par)) { return; }
		Vector<MethodEntry> pm = self.analyzed.mergedMethods(par);
		int i = 0;
		while (i < pm.len) {
			MethodEntry e = pm.get(i);
			if (!ownMethods.has(e.name) && e.sig.genericParams.len == 0) {
				ownMethods.put(e.name, true);
				Node mem = e.sig;
				IRFunction fn = IRFunction();
				fn.name = name + "_" + e.name;
				string ret = self.cTypes.lower(mem.returnType);
				fn.returnType = ret;
				Vector<IRNode> callArgs = [];
				if (mem.access != "class") {
					fn.params.push(IRParam(name + "*", "self"));
					callArgs.push(IRNode.cast(par + "*", IRNode.variable("self")));
				}
				int j = 0;
				while (j < mem.params.len) {
					Node p = mem.params.get(j);
					fn.params.push(self.cTypes.lowerParameter(p));
					callArgs.push(IRNode.variable(self.lexicalBindingCName(p.name)));
					j = j + 1;
				}
				IRNode call = IRNode.call(par + "_" + e.name, callArgs);
				Vector<IRNode> wbody = [];
				if (ret == "void") {
					wbody.push(IRNode.expressionStatement(call));
				} else {
					wbody.push(IRNode.returnStatement(call));
				}
				fn.body = IRNode.block(wbody);
				m.functions.push(fn);
			}
			i = i + 1;
		}
	}

	/* Phase 1 forward declarations (mirrors _emit_forward_decls): for each
     * non-generic class, a `typedef struct X X;` and a `void X_destroy(X*);`
     * prototype; then prototypes for every non-main function with a body. Class
     * method/constructor prototypes are appended later by emitClassDecl. */
	public void appendEnumToStringForwardDecl(Node declaration, Vector<IRFunctionDecl> destination) {
		IRFunctionDecl toString = IRFunctionDecl(declaration.name + "_toString", "const char*", true);
		toString.params.push(IRParam(declaration.name, "val"));
		destination.push(toString);
	}

	public void appendRichEnumForwardDecls(Node declaration, Vector<IRFunctionDecl> destination) {
		int variantIndex = 0;
		while (variantIndex < declaration.variants.len) {
			Node variant = declaration.variants.get(variantIndex);
			IRFunctionDecl constructor = IRFunctionDecl(declaration.name + "_" + variant.name, declaration.name, true);
			int parameterIndex = 0;
			while (parameterIndex < variant.params.len) {
				Node parameter = variant.params.get(parameterIndex);
				constructor.params.push(self.cTypes.lowerParameter(parameter));
				parameterIndex = parameterIndex + 1;
			}
			destination.push(constructor);
			variantIndex = variantIndex + 1;
		}
		self.appendEnumToStringForwardDecl(declaration, destination);
	}

	public void emitForwardDecls(Node prog, IRModule m) {
		Vector<IRFunctionDecl> functionDeclarations = [];
		int i = 0;
		while (i < prog.declarations.len) {
			Node d = prog.declarations.get(i);
			if (self.analyzed.isNativeDeclaration(d) && d.kind != NK_INTERFACE_DECL) {
				i++;
				continue;
			}
			if (((d.kind == NK_CLASS_DECL || d.kind == NK_INTERFACE_DECL) && d.genericParams.len == 0) || d.kind == NK_STRUCT_DECL || d.kind == NK_RICH_ENUM_DECL) {
				/* Both non-generic classes and raw structs get a typed forward
                 * so a function prototype can name `struct X*` before X is
                 * defined (mirrors legacy forward-declaration phase-1, which
                 * tests ClassDecl OR StructDecl). Only classes get _destroy. */
				m.structForwards.push(IRStructForward(d.name));
				if (d.kind == NK_CLASS_DECL && d.genericParams.len == 0) {
					IRFunctionDecl destroyDeclaration = IRFunctionDecl(d.name + "_destroy", "void", false);
					destroyDeclaration.params.push(IRParam("void*", "object"));
					functionDeclarations.push(destroyDeclaration);
				} else if (d.kind == NK_RICH_ENUM_DECL) {
					self.appendRichEnumForwardDecls(d, functionDeclarations);
				}
			} else if (d.kind == NK_ENUM_DECL && d.name != "") {
				self.appendEnumToStringForwardDecl(d, functionDeclarations);
			} else if (d.kind == NK_FUNCTION_DECL && !d.isGpu && d.bodyNode != null && d.name != "main") {
				string ret = self.cTypes.lower(d.returnType);
				IRFunctionDecl functionDeclaration = IRFunctionDecl(self.semanticDeclarations.sourceFunctionSymbol(d.name), ret, false);
				int parameter = 0;
				while (parameter < d.params.len) {
					Node sourceParameter = d.params.get(parameter);
					functionDeclaration.params.push(self.cTypes.lowerParameter(sourceParameter));
					parameter = parameter + 1;
				}
				functionDeclarations.push(functionDeclaration);
			}
			i = i + 1;
		}
		/* Forward typedefs for concrete generic instances, in discovery order
         * (mirrors legacy forward-declaration phase-1 generic loop). These
         * come after the non-generic class typedefs and before function fwds. */
		int g = 0;
		while (g < self.analyzed.genericInstances.len) {
			GenInstance gi = self.analyzed.genericInstances.get(g);
			m.structForwards.push(IRStructForward(gi.mangled));
			g = g + 1;
		}
		/* Tuple struct definitions + typedefs (mirrors _emit_tuple_structs):
         * emitted after the generic typedefs and before the deferred function
         * forward decls, so a tuple-returning function's prototype sees the
         * tuple's typedef. */
		self.emitTupleStructs(prog, m);
		int j = 0;
		while (j < functionDeclarations.len) {
			m.functionDecls.push(functionDeclarations.get(j));
			j = j + 1;
		}
	}

	/* Scan all declarations (function return/param types, class method return
     * types) and bodies for tuple types, then emit one struct def + forward
     * typedef per unique mangled tuple. Mirrors legacy tuple emission
     * (the body walk substitutes for Python's node_types scan). */
	public void emitTupleStructs(Node prog, IRModule m) {
		Map<string, bool> seen = {};
		Vector<string> order = [];
		Vector<Node> tupleTypes = [];
		int i = 0;
		while (i < prog.declarations.len) {
			Node d = prog.declarations.get(i);
			if (d.kind == NK_FUNCTION_DECL) {
				self.collectTupleTypes(d.returnType, seen, order, tupleTypes);
				int p = 0;
				while (p < d.params.len) {
					self.collectTupleTypes(d.params.get(p).type, seen, order, tupleTypes);
					p = p + 1;
				}
				self.collectTupleTypesBody(d.bodyNode, seen, order, tupleTypes);
			} else if (d.kind == NK_CLASS_DECL) {
				int mi = 0;
				while (mi < d.members.len) {
					Node mem = d.members.get(mi);
					if (mem.kind == NK_METHOD_DECL) {
						self.collectTupleTypes(mem.returnType, seen, order, tupleTypes);
						int mp = 0;
						while (mp < mem.params.len) {
							self.collectTupleTypes(mem.params.get(mp).type, seen, order, tupleTypes);
							mp = mp + 1;
						}
						self.collectTupleTypesBody(mem.bodyNode, seen, order, tupleTypes);
					} else if (mem.kind == NK_FIELD_DECL) {
						/* A class field of tuple type (e.g. `(int,int) pos;`)
                         * references the tuple struct in the class body, so its
                         * typedef must be emitted. Python catches this via the
                         * field-access node_types scan. */
						self.collectTupleTypes(mem.type, seen, order, tupleTypes);
					} else if (mem.kind == NK_PROPERTY_DECL) {
						self.collectTupleTypes(mem.type, seen, order, tupleTypes);
					}
					mi = mi + 1;
				}
			}
			i = i + 1;
		}
		int instanceIndex = 0;
		while (instanceIndex < self.analyzed.genericInstances.len) {
			GenInstance instance = self.analyzed.genericInstances.get(instanceIndex);
			if (self.analyzed.genericClassTable.has(instance.base)) {
				Node genericDeclaration = self.analyzed.genericClassTable.get(instance.base);
				Node concreteInstanceType = SemanticTypeSystem.primitive(instance.base);
				concreteInstanceType.genericArgs = instance.args;
				Map<string, Node> substitutions = SemanticTypeSystem.genericTypeMap(self.analyzed, concreteInstanceType);
				int memberIndex = 0;
				while (memberIndex < genericDeclaration.members.len) {
					Node genericMember = genericDeclaration.members.get(memberIndex);
					if (genericMember.kind == NK_FIELD_DECL || genericMember.kind == NK_PROPERTY_DECL) {
						self.collectTupleTypes(SemanticTypeSystem.resolveGenericType(genericMember.type, substitutions, self.analyzed), seen, order, tupleTypes);
					}
					memberIndex = memberIndex + 1;
				}
			}
			instanceIndex = instanceIndex + 1;
		}
		int s = 0;
		while (s < order.len) {
			string mangled = order.get(s);
			Node tt = tupleTypes.get(s);
			IRStructDef sd = IRStructDef();
			sd.name = mangled;
			int f = 0;
			while (f < tt.genericArgs.len) {
				Node argument = tt.genericArgs.get(f);
				IRStructField tupleField = IRStructField(self.cTypes.lower(argument), f"_{f}");
				tupleField.isVolatile = argument.isVolatile;
				tupleField.effectiveIsVolatile = SemanticTypeSystem.typeEffectiveOuterVolatile(argument, self.analyzed.typedefTable);
				sd.fields.push(tupleField);
				f = f + 1;
			}
			m.structDefs.push(sd);
			m.structForwards.push(IRStructForward(mangled));
			s = s + 1;
		}
	}

	/* Recursively collect tuple types from a type expression (mirrors
     * legacy tuple collection). A tuple type has base "Tuple" with
     * generic_args holding the element types; nested tuples are collected too. */
	public void collectTupleTypes(Node? t, Map<string, bool> seen, Vector<string> order, Vector<Node> tupleTypes) {
		if (t == null) { return; }
		/* Recurse into element types FIRST so that a nested tuple used as a
         * field (e.g. the (string,bool) inside (int,(string,bool))) is emitted
         * before the enclosing struct that contains it — otherwise the outer
         * struct references an incomplete type. (Python gets this ordering
         * incidentally via its node_types scan, which sees the inner tuple's
         * standalone use first; doing dependencies-first here is robust.) */
		int i = 0;
		while (i < t.genericArgs.len) {
			self.collectTupleTypes(t.genericArgs.get(i), seen, order, tupleTypes);
			i = i + 1;
		}
		if (t.base == "Tuple" && t.genericArgs.len > 0) {
			string mangled = TypeIdentity.mangleGenericSymbol("Tuple", t.genericArgs);
			if (!seen.has(mangled)) {
				seen.put(mangled, true);
				order.push(mangled);
				tupleTypes.push(t);
			}
		}
	}

	/* Walk a function/method body for tuple types appearing on local var decls
     * and tuple literals. This stands in for the Python node_types scan, which
     * the on-demand inference design of this compiler doesn't maintain. */
	public void collectTupleTypesBody(Node? n, Map<string, bool> seen, Vector<string> order, Vector<Node> tupleTypes) {
		if (n == null) { return; }
		if (n.kind == NK_VAR_DECL_STMT) {
			self.collectTupleTypes(n.type, seen, order, tupleTypes);
			/* `var t = (1, 2)` declares t with an inferred tuple type and a null
             * annotation, so scanning n.type alone misses the tuple. Infer the
             * type from the initializer (Python catches this via node_types). */
			if (n.type == null && n.initializer != null) {
				Map<string, Node> vt = {};
				Node? it = self.expressions.resolvedExpressionType(n.initializer, vt);
				self.collectTupleTypes(it, seen, order, tupleTypes);
			}
		}
		int si = 0;
		while (si < n.statements.len) {
			self.collectTupleTypesBody(n.statements.get(si), seen, order, tupleTypes);
			si = si + 1;
		}
		self.collectTupleTypesBody(n.thenBlock, seen, order, tupleTypes);
		self.collectTupleTypesBody(n.elseBlock, seen, order, tupleTypes);
		self.collectTupleTypesBody(n.bodyNode, seen, order, tupleTypes);
		if (n.ifStmt != null) { self.collectTupleTypesBody(n.ifStmt, seen, order, tupleTypes); }
	}


	/* A fresh varTypes map pre-seeded with module-level (global) variable
     * types. Mirrors the reference's global scope being visible inside every
     * function/method body; locals and params added afterward shadow a
     * same-named global. */

	/* Child-typed wrappers for inherited property accessors. */

	private void emitInheritedPropertyForwardDecls(Node declaration, Map<string, bool> ownProperties, IRModule module) {
		string parent = DeclarationRegistry.parentName(declaration);
		if (parent == "" || !self.analyzed.isClass(parent)) { return; }
		Vector<Node> properties = DeclarationRegistry.mergedClassProperties(self.analyzed, parent);
		int index = 0;
		while (index < properties.len) {
			Node property = properties.get(index);
			if (!ownProperties.has(property.name)) {
				string propertyType = self.cTypes.lower(property.type);
				if (property.hasGetter) {
					IRFunctionDecl getter = IRFunctionDecl(declaration.name + "_get_" + property.name, propertyType, false);
					getter.params.push(IRParam(declaration.name + "*", "self"));
					module.functionDecls.push(getter);
				}
				if (property.hasSetter) {
					IRFunctionDecl setter = IRFunctionDecl(declaration.name + "_set_" + property.name, "void", false);
					setter.params.push(IRParam(declaration.name + "*", "self"));
					setter.params.push(self.cTypes.lowerNamedParameter(property.type, propertyType, self.lexicalBindingCName("value")));
					module.functionDecls.push(setter);
				}
			}
			index = index + 1;
		}
	}

	private void emitInheritedProperties(Node declaration, Map<string, bool> ownProperties, IRModule module) {
		string parent = DeclarationRegistry.parentName(declaration);
		if (parent == "" || !self.analyzed.isClass(parent)) { return; }
		Vector<Node> properties = DeclarationRegistry.mergedClassProperties(self.analyzed, parent);
		int index = 0;
		while (index < properties.len) {
			Node property = properties.get(index);
			if (!ownProperties.has(property.name)) {
				string propertyType = self.cTypes.lower(property.type);
				if (property.hasGetter) {
					IRFunction getter = IRFunction();
					getter.name = declaration.name + "_get_" + property.name;
					getter.returnType = propertyType;
					getter.params.push(IRParam(declaration.name + "*", "self"));
					Vector<IRNode> arguments = [];
					arguments.push(IRNode.cast(parent + "*", IRNode.variable("self")));
					Vector<IRNode> body = [];
					body.push(IRNode.returnStatement(IRNode.call(parent + "_get_" + property.name, arguments)));
					getter.body = IRNode.block(body);
					module.functions.push(getter);
				}
				if (property.hasSetter) {
					string valueCName = self.lexicalBindingCName("value");
					IRFunction setter = IRFunction();
					setter.name = declaration.name + "_set_" + property.name;
					setter.returnType = "void";
					setter.params.push(IRParam(declaration.name + "*", "self"));
					setter.params.push(self.cTypes.lowerNamedParameter(property.type, propertyType, valueCName));
					Vector<IRNode> arguments = [];
					arguments.push(IRNode.cast(parent + "*", IRNode.variable("self")));
					arguments.push(IRNode.variable(valueCName));
					Vector<IRNode> body = [];
					body.push(IRNode.expressionStatement(IRNode.call(parent + "_set_" + property.name, arguments)));
					setter.body = IRNode.block(body);
					module.functions.push(setter);
				}
			}
			index = index + 1;
		}
	}

	private Map<string, Node> genericPropertyVarTypes(GenInstance instance, Node property, Map<string, Node> typeMap, bool includeValue) {
		Map<string, Node> variables = self.functions.seededVarTypes();
		Node selfType = Node();
		selfType.kind = NK_TYPE_EXPR;
		selfType.base = instance.base;
		selfType.genericArgs = instance.args;
		selfType.pointerDepth = 1;
		variables.put("self", selfType);
		if (includeValue) {
			variables.put("value", SemanticTypeSystem.resolveGenericType(property.type, typeMap, self.analyzed));
		}
		return variables;
	}

	private void emitGenericPropertyForwardDecls(GenInstance instance, Node declaration, Map<string, Node> typeMap, IRModule module) {
		int index = 0;
		while (index < declaration.members.len) {
			Node property = declaration.members.get(index);
			if (property.kind == NK_PROPERTY_DECL) {
				Node resolvedType = SemanticTypeSystem.resolveGenericType(property.type, typeMap, self.analyzed);
				string propertyType = self.cTypes.lowerGeneric(property.type, typeMap);
				if (property.hasGetter) {
					IRFunctionDecl getter = IRFunctionDecl(instance.mangled + "_get_" + property.name, propertyType, true);
					getter.params.push(IRParam(instance.mangled + "*", "self"));
					module.functionDecls.push(getter);
				}
				if (property.hasSetter) {
					IRFunctionDecl setter = IRFunctionDecl(instance.mangled + "_set_" + property.name, "void", true);
					setter.params.push(IRParam(instance.mangled + "*", "self"));
					setter.params.push(self.cTypes.lowerNamedParameter(resolvedType, propertyType, self.lexicalBindingCName("value")));
					module.functionDecls.push(setter);
				}
			}
			index = index + 1;
		}
	}

	private void emitGenericProperties(GenInstance instance, Node declaration, Map<string, Node> typeMap, IRModule module) {
		string savedReturnCType = self.context.currentReturnCType;
		Node? savedReturnType = self.context.currentReturnType;
		bool savedReturnOwned = self.context.currentReturnOwned;
		string savedPropertyBacking = self.context.currentPropertyBacking;
		int index = 0;
		while (index < declaration.members.len) {
			Node property = declaration.members.get(index);
			if (property.kind == NK_PROPERTY_DECL) {
				Node resolvedType = SemanticTypeSystem.resolveGenericType(property.type, typeMap, self.analyzed);
				string propertyType = self.cTypes.lowerGeneric(property.type, typeMap);
				string backing = DeclarationRegistry.instanceStorageName(property);
				if (property.hasGetter) {
					IRFunction getter = IRFunction();
					getter.name = instance.mangled + "_get_" + property.name;
					getter.returnType = propertyType;
					getter.isStatic = true;
					getter.params.push(IRParam(instance.mangled + "*", "self"));
					Vector<IRNode> body = [];
					if (property.getterBody == null) {
						body.push(IRNode.returnStatement(IRNode.fieldAccess(IRNode.variable("self"), backing, true)));
					} else {
						self.context.currentReturnCType = propertyType;
						self.context.currentReturnType = resolvedType;
						/* Custom getters are call-shaped +1 projections. */
						self.context.currentReturnOwned = true;
						if (DeclarationRegistry.propertyNeedsBacking(property)) {
							self.context.currentPropertyBacking = property.name;
						} else {
							self.context.currentPropertyBacking = "";
						}
						self.functions.resetFuncVarDecls();
						Map<string, Node> variables = self.genericPropertyVarTypes(instance, property, typeMap, false);
						IRNode block = self.functions.lowerBody(property.getterBody, variables);
						self.context.currentPropertyBacking = savedPropertyBacking;
						int statement = 0;
						while (statement < block.stmts.len) {
							body.push(block.stmts.get(statement));
							statement = statement + 1;
						}
					}
					getter.body = IRNode.block(body);
					module.functions.push(getter);
				}
				if (property.hasSetter) {
					string valueCName = self.lexicalBindingCName("value");
					IRFunction setter = IRFunction();
					setter.name = instance.mangled + "_set_" + property.name;
					setter.returnType = "void";
					setter.isStatic = true;
					setter.params.push(IRParam(instance.mangled + "*", "self"));
					setter.params.push(self.cTypes.lowerNamedParameter(resolvedType, propertyType, valueCName));
					Vector<IRNode> body = [];
					if (property.setterBody == null) {
						self.emitAutoPropertyStore(resolvedType, IRNode.fieldAccess(IRNode.variable("self"), backing, true), IRNode.variable(valueCName), body);
					} else {
						self.context.currentReturnCType = "void";
						self.context.currentReturnType = null;
						self.context.currentReturnOwned = false;
						if (DeclarationRegistry.propertyNeedsBacking(property)) {
							self.context.currentPropertyBacking = property.name;
						} else {
							self.context.currentPropertyBacking = "";
						}
						self.functions.resetFuncVarDecls();
						Map<string, Node> variables = self.genericPropertyVarTypes(instance, property, typeMap, true);
						Vector<string> sourceBindings = self.context.snapshotSourceBindings();
						Vector<string> noSourceBindings = [];
						self.context.restoreSourceBindings(noSourceBindings);
						self.context.activateSourceName("value", self.lexicalBindingCName("value"));
						IRNode block = self.functions.lowerBody(property.setterBody, variables);
						self.context.currentPropertyBacking = savedPropertyBacking;
						self.context.restoreSourceBindings(sourceBindings);
						int statement = 0;
						while (statement < block.stmts.len) {
							body.push(block.stmts.get(statement));
							statement = statement + 1;
						}
					}
					setter.body = IRNode.block(body);
					module.functions.push(setter);
				}
			}
			index = index + 1;
		}
		self.context.currentReturnCType = savedReturnCType;
		self.context.currentReturnType = savedReturnType;
		self.context.currentReturnOwned = savedReturnOwned;
		self.context.currentPropertyBacking = savedPropertyBacking;
	}

	/* Exception guards for heap objects whose constructor is still running.
     *
     * The cleanup stack stores the address of `self`, so a longjmp through init
     * releases the partially initialized object through its concrete destructor.
     * memset makes untouched managed fields null; initialized fields are therefore
     * reclaimed by the same destructor used after a successful construction. */

	private string beginConstructorCleanup(string selfName, Vector<IRNode> output) {
		if (!self.context.exceptionsAreEnabled()) { return ""; }

		self.context.referenceHelper("__btrc_cleanup_mark");
		string marker = self.context.freshTemporary("__btrc_constructor_cleanup");
		Vector<IRNode> markArguments = [];
		output.push(IRNode.variableDeclaration("int", marker, IRNode.call("__btrc_cleanup_mark", markArguments)));

		IRNode declaration = self.cleanupSlots.requireDeclaration(output, selfName);
		self.context.referenceHelper("__btrc_arc_abandon");
		output.push(IRNode.expressionStatement(self.cleanupSlots.registerSlot(self.context, declaration, IRNode.functionReference("__btrc_arc_abandon"), IRNode.literal("NULL"), true)));
		return marker;
	}

	private void endConstructorCleanup(string marker, Vector<IRNode> output) {
		if (marker == "") { return; }
		self.context.referenceHelper("__btrc_discard_cleanups_to");
		Vector<IRNode> arguments = [];
		arguments.push(IRNode.variable(marker));
		output.push(IRNode.expressionStatement(IRNode.call("__btrc_discard_cleanups_to", arguments)));
	}

	/* Hidden source-destructor hook construction shared by ordinary and generic
     * class lowering. A source return exits this function, never the terminal
     * compiler-owned destructor that detaches fields and frees the object. */

	private IRFunction buildDestructorHook(string ownerName, Vector<IRNode> body) {
		IRFunction hook = IRFunction();
		hook.name = GenericSpecializer.destructorHookName(ownerName);
		hook.returnType = "void";
		hook.params.push(IRParam("void*", "object"));
		Vector<IRNode> hookBody = [];
		hookBody.push(IRNode.variableDeclaration(ownerName + "*", "self", IRNode.cast(ownerName + "*", IRNode.variable("object"))));
		hookBody.push(IRNode.expressionStatement(IRNode.cast("void", IRNode.variable("self"))));
		int statement = 0;
		while (statement < body.len) {
			hookBody.push(body.get(statement));
			statement = statement + 1;
		}
		hook.body = IRNode.block(hookBody);
		hook.isStatic = true;
		hook.archiveExport = true;
		return hook;
	}

	/* Source-order instance field defaults shared by ordinary and generic classes. */

	private Map<string, Node> genericInitializerVarTypes(GenInstance instance, Node? constructor) {
		Map<string, Node> variables = self.functions.seededVarTypes();
		Node selfType = Node();
		selfType.kind = NK_TYPE_EXPR;
		selfType.base = instance.base;
		selfType.genericArgs = instance.args;
		selfType.pointerDepth = 1;
		variables.put("self", selfType);
		if (constructor != null) {
			int index = 0;
			while (index < constructor.params.len) {
				Node parameter = constructor.params.get(index);
				variables.put(parameter.name, parameter.type);
				index = index + 1;
			}
		}
		return variables;
	}

	private Node instanceInitializerFieldType(Node field, bool generic, Map<string, Node> typeMap) {
		if (generic) {
			return SemanticTypeSystem.resolveGenericType(field.type, typeMap, self.analyzed);
		}
		return self.cTypes.resolveBodyType(field.type, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
	}

	private void rejectInstanceArrayDefaultAtCodegen(Node field, Node fieldType) {
		if (!fieldType.isArray || field.initializer == null) { return; }
		if (field.initializer.kind != NK_BRACE_INITIALIZER && field.initializer.kind != NK_LIST_LITERAL) { return; }
		fprintf(stderr, "error: array-valued class field default '%s' requires persistent backing storage at %d:%d\n", field.name, field.line, field.col);
		exit(1);
	}

	private void appendInstanceFieldInitializers(Node declaration, Map<string, Node> variables, bool generic, Map<string, Node> typeMap, Vector<IRNode> body) {
		CallableFlowState callableFlow = CallableFlowState();
		int index = 0;
		while (index < declaration.members.len) {
			Node field = declaration.members.get(index);
			string storage = DeclarationRegistry.instanceStorageName(field);
			if (field.kind == NK_FIELD_DECL && field.access != "class" && storage != "" && field.initializer != null) {
				Node fieldType = self.instanceInitializerFieldType(field, generic, typeMap);
				self.rejectInstanceArrayDefaultAtCodegen(field, fieldType);
				CallableBoundaryContext callableContext = callableFlow.boundaryContext(variables, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
				bool unsafe = callableFlow.persistentStorageUnsafe(fieldType, field.initializer, self.callableValues, callableContext);
				self.callableBoundaries.rejectPersistentStorage(fieldType, field.initializer, callableContext, unsafe, "instance field storage");
				PreparedValue prepared = self.expressions.prepareTargetValue(field.initializer, fieldType, variables, callableFlow);
				IRNode target = IRNode.fieldAccess(IRNode.variable("self"), storage, true);
				if (self.managedValues.isArc(self.cTypes.resolveBodyType(fieldType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))) {
					body.push(IRNode.expressionStatement(self.managedLifetime.replaceEdge(target, prepared.value, fieldType, IRNode.variable("self"), prepared.owned)));
				} else {
					body.push(IRNode.assignment(target, prepared.value));
					if (self.managedValues.isManaged(self.cTypes.resolveBodyType(fieldType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))) {
						if (prepared.owned) {
							body.push(IRNode.expressionStatement(self.managedLifetime.adoptEdge(target, fieldType, IRNode.variable("self"))));
						} else {
							body.push(IRNode.expressionStatement(self.managedLifetime.retainEdge(target, fieldType, IRNode.variable("self"))));
						}
					}
				}
			}
			index = index + 1;
		}
	}

	/* Validated lowering for the supported source preprocessor subset.
     *
     * The source compiler accepts only single-line includes and object/function
     * macros here.  #pragma pack is consumed separately as struct metadata.  Every
     * other or malformed directive fails before an IR module can be emitted. */

	private bool preprocessorSpace(char value) { return value == ' ' || value == '\t' || value == '\f' || value == '\v' || value == '\r'; }

	private bool preprocessorIdentifierStart(char value) { return TypeIdentity.asciiLetter(value) || value == '_'; }

	private bool preprocessorIdentifierPart(char value) { return self.preprocessorIdentifierStart(value) || TypeIdentity.asciiDigit(value); }

	private bool preprocessorTrigraphSuffix(char value) { return value == '=' || value == '/' || value == '\'' || value == '(' || value == ')' || value == '!' || value == '<' || value == '>' || value == '-'; }

	private bool containsPreprocessorTrigraph(string value) {
		int index = 0;
		while (index + 2 < value.length()) {
			if (value[index] == '?' && value[index + 1] == '?' && self.preprocessorTrigraphSuffix(value[index + 2])) {
				return true;
			}
			index = index + 1;
		}
		return false;
	}

	private string preprocessorTrimLeft(string value) {
		int start = 0;
		while (start < value.length() && self.preprocessorSpace(value[start])) {
			start = start + 1;
		}
		return value.substring(start, value.length() - start);
	}

	private string preprocessorTrim(string value) {
		int start = 0;
		int end = value.length();
		while (start < end && self.preprocessorSpace(value[start])) {
			start = start + 1;
		}
		while (end > start && self.preprocessorSpace(value[end - 1])) {
			end = end - 1;
		}
		return value.substring(start, end - start);
	}

	private void preprocessorFail(string message) {
		fprintf(stderr, "error: %s\n", message);
		exit(1);
	}

	private bool validPreprocessorIdentifier(string value) {
		if (value.length() == 0 || !self.preprocessorIdentifierStart(value[0])) {
			return false;
		}
		int index = 1;
		while (index < value.length()) {
			if (!self.preprocessorIdentifierPart(value[index])) {
				return false;
			}
			index = index + 1;
		}
		return true;
	}

	private bool validIncludeHeader(string header) {
		if (header.length() == 0) { return false; }
		int index = 0;
		while (index < header.length()) {
			char value = header[index];
			int code = (int)(byte)value;
			if (code < 32 || code == 127 || value == '<' || value == '>' || value == '"') {
				return false;
			}
			index = index + 1;
		}
		return !self.containsPreprocessorTrigraph(header);
	}

	private bool sameStructuredInclude(IRPreprocessorDecl left, IRPreprocessorDecl right) { return left.kind == IR_PREPROCESSOR_INCLUDE && right.kind == IR_PREPROCESSOR_INCLUDE && left.header == right.header && left.isSystem == right.isSystem; }

	/* Includes are deduplicated at production time so emission is a pure ordered
     * walk. Macros intentionally preserve every source declaration. */
	private void appendPreprocessorDecl(IRModule module, IRPreprocessorDecl declaration) {
		if (declaration.kind == IR_PREPROCESSOR_INCLUDE) {
			int index = 0;
			while (index < module.preprocessorDecls.len) {
				if (self.sameStructuredInclude(module.preprocessorDecls.get(index), declaration)) {
					return;
				}
				index = index + 1;
			}
		}
		module.preprocessorDecls.push(declaration);
	}

	public void requireSystemInclude(IRModule module, string header) {
		if (!self.validIncludeHeader(header)) {
			self.preprocessorFail("invalid generated include header");
		}
		self.appendPreprocessorDecl(module, IRPreprocessorDecl.include(header, true));
	}

	public void addStandardPreprocessorDecls(IRModule module) {
		Vector<string> noParams = [];
		self.appendPreprocessorDecl(module, IRPreprocessorDecl.macro("_DEFAULT_SOURCE", false, noParams, ""));
		Vector<string> noParams2 = [];
		self.appendPreprocessorDecl(module, IRPreprocessorDecl.macro("_DARWIN_C_SOURCE", false, noParams2, ""));

		Vector<string> headers = [
			"stdio.h", "stdlib.h", "string.h", "stdbool.h", "stdint.h",
			"ctype.h", "math.h", "assert.h", "limits.h"
		];
		int index = 0;
		while (index < headers.len) {
			self.requireSystemInclude(module, headers.get(index));
			index = index + 1;
		}
	}

	private IRPreprocessorDecl parseIncludeDirective(string payload, string source) {
		string value = self.preprocessorTrim(payload);
		if (value.length() < 3) {
			self.preprocessorFail("malformed #include directive: " + source);
		}
		char opening = value[0];
		char closing = value[value.length() - 1];
		bool isSystem = opening == '<';
		if ((!isSystem && opening != '"') || (isSystem && closing != '>') || (!isSystem && closing != '"')) {
			self.preprocessorFail("malformed #include directive: " + source);
		}
		string header = value.substring(1, value.length() - 2);
		if (!self.validIncludeHeader(header)) {
			self.preprocessorFail("malformed #include directive: " + source);
		}
		return IRPreprocessorDecl.include(header, isSystem);
	}

	private Vector<string> parseMacroParameters(string value, string source) {
		Vector<string> params = [];
		string parameterText = self.preprocessorTrim(value);
		if (parameterText == "") { return params; }
		int start = 0;
		int index = 0;
		while (index <= parameterText.length()) {
			if (index == parameterText.length() || parameterText[index] == ',') {
				string parameter = self.preprocessorTrim(parameterText.substring(start, index - start));
				bool finalVariadic = parameter == "..." && index == parameterText.length();
				if (!self.validPreprocessorIdentifier(parameter) && !finalVariadic) {
					self.preprocessorFail("invalid function-like macro parameters: " + source);
				}
				if (params.contains(parameter)) {
					self.preprocessorFail("duplicate function-like macro parameter: " + source);
				}
				params.push(parameter);
				start = index + 1;
			}
			index = index + 1;
		}
		return params;
	}

	private IRPreprocessorDecl parseMacroDirective(string payload, string source) {
		if (payload.length() == 0 || !self.preprocessorSpace(payload[0])) {
			self.preprocessorFail("malformed #define directive: " + source);
		}
		int index = 0;
		while (index < payload.length() && self.preprocessorSpace(payload[index])) {
			index = index + 1;
		}
		int nameStart = index;
		if (index >= payload.length() || !self.preprocessorIdentifierStart(payload[index])) {
			self.preprocessorFail("malformed #define directive: " + source);
		}
		index = index + 1;
		while (index < payload.length() && self.preprocessorIdentifierPart(payload[index])) {
			index = index + 1;
		}
		string name = payload.substring(nameStart, index - nameStart);
		if (index >= payload.length() || payload[index] != '(') {
			string replacement = self.preprocessorTrimLeft(payload.substring(index, payload.length() - index));
			Vector<string> noParams = [];
			return IRPreprocessorDecl.macro(name, false, noParams, replacement);
		}

		int close = index + 1;
		while (close < payload.length() && payload[close] != ')') {
			close = close + 1;
		}
		if (close >= payload.length()) {
			self.preprocessorFail("malformed function-like #define: " + source);
		}
		Vector<string> params = self.parseMacroParameters(payload.substring(index + 1, close - index - 1), source);
		string replacement = self.preprocessorTrimLeft(payload.substring(close + 1, payload.length() - close - 1));
		return IRPreprocessorDecl.macro(name, true, params, replacement);
	}

	private void lowerPreprocessorDirective(string sourceText, IRModule module) {
		if (self.containsPreprocessorTrigraph(sourceText)) {
			self.preprocessorFail("C11 trigraphs in preprocessor directives are unsupported");
		}
		int rawIndex = 0;
		while (rawIndex < sourceText.length()) {
			if (sourceText[rawIndex] == '\n' || sourceText[rawIndex] == '\r') {
				self.preprocessorFail("multi-line preprocessor directives are unsupported");
			}
			rawIndex = rawIndex + 1;
		}
		string source = self.preprocessorTrim(sourceText);
		if (source.length() == 0 || source[source.length() - 1] == '\\') {
			self.preprocessorFail("multi-line preprocessor directives are unsupported");
		}
		if (source[0] != '#') {
			self.preprocessorFail("malformed preprocessor directive: " + source);
		}
		int index = 1;
		while (index < source.length() && self.preprocessorSpace(source[index])) {
			index = index + 1;
		}
		int nameStart = index;
		if (index >= source.length() || !self.preprocessorIdentifierStart(source[index])) {
			self.preprocessorFail("malformed preprocessor directive: " + source);
		}
		index = index + 1;
		while (index < source.length() && self.preprocessorIdentifierPart(source[index])) {
			index = index + 1;
		}
		string directive = source.substring(nameStart, index - nameStart);
		string payload = source.substring(index, source.length() - index);
		if (directive == "include") {
			self.appendPreprocessorDecl(module, self.parseIncludeDirective(payload, source));
			return;
		}
		if (directive == "define") {
			self.appendPreprocessorDecl(module, self.parseMacroDirective(payload, source));
			return;
		}
		if (directive == "pragma") {
			self.preprocessorFail("unsupported #pragma directive: " + source);
		}
		self.preprocessorFail("unsupported preprocessor directive '#" + directive + "'");
	}

	/* Translation-unit storage and ARC replacement for class-access fields. */

	private void emitClassStaticFields(Node declaration, IRModule module) {
		CallableFlowState callableFlow = CallableFlowState();
		int index = 0;
		while (index < declaration.members.len) {
			Node field = declaration.members.get(index);
			if (field.kind == NK_FIELD_DECL && field.access == "class") {
				Node storageType = field.type;
				IRGlobalDecl global;
				bool materializedArray = field.type.isArray && (field.type.arraySize != null || (field.initializer != null && (field.initializer.kind == NK_LIST_LITERAL || field.initializer.kind == NK_BRACE_INITIALIZER)));
				if (materializedArray) {
					storageType = TypeShape.withoutOuterArray(field.type);
				}
				global = IRGlobalDecl(self.cTypes.lower(storageType), declaration.name + "_" + field.name);
				global.isStatic = true;
				global.isVolatile = field.type.isVolatile;
				global.effectiveIsVolatile = SemanticTypeSystem.typeEffectiveOuterVolatile(field.type, self.analyzed.typedefTable);
				Map<string, Node> empty = {};
				if (field.type.isArray) {
					if (field.type.arraySize != null) {
						global.arraySize = self.expressions.lowerExpr(field.type.arraySize, empty, callableFlow);
					} else if (field.initializer != null && (field.initializer.kind == NK_LIST_LITERAL || field.initializer.kind == NK_BRACE_INITIALIZER)) {
						global.arraySize = IRNode.literal(Strings.fromInt(field.initializer.elements.len));
					}
				}
				if (field.initializer != null) {
					CallableBoundaryContext callableContext = callableFlow.boundaryContext(empty, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
					bool unsafe = callableFlow.persistentStorageUnsafe(field.type, field.initializer, self.callableValues, callableContext);
					self.callableBoundaries.rejectPersistentStorage(field.type, field.initializer, callableContext, unsafe, "class field storage");
					global.init = self.expressions.lowerStaticInitializer(field.initializer, field.type, empty, callableFlow);
				}
				module.globalDecls.push(global);
			}
			index = index + 1;
		}
	}

	private IRStructField field(Node member, string storage) {
		Map<string, Node> noTypeMap = {};
		return self.resolvedField(member.type, storage, false, noTypeMap);
	}

	private IRStructField genericField(Node member, string storage, Map<string, Node> typeMap) {
		Node fieldType = SemanticTypeSystem.resolveGenericType(member.type, typeMap, self.analyzed);
		return self.resolvedField(fieldType, storage, true, typeMap);
	}

	private IRStructField resolvedField(Node fieldType, string storage, bool generic, Map<string, Node> typeMap) {
		CallableFlowState callableFlow = CallableFlowState();
		/* CTypeLowerer registers nested callback typedefs. Render only the resolved
         * field shape so a generic placeholder cannot escape into C. */
		IRStructField field = IRStructField(self.cTypes.lower(fieldType), storage);
		field.isVolatile = fieldType.isVolatile;
		field.effectiveIsVolatile = SemanticTypeSystem.typeEffectiveOuterVolatile(fieldType, self.analyzed.typedefTable);
		if (fieldType.isArray && fieldType.arraySize != null) {
			Node elementType = TypeShape.withoutOuterArray(fieldType);
			field.cType = self.cTypes.lower(elementType);
			Map<string, Node> noVariables = {};
			bool savedGeneric = self.context.genericBody;
			Map<string, Node> savedTypeMap = self.context.activeTypeMap;
			if (generic) {
				self.context.genericBody = true;
				self.context.activeTypeMap = typeMap;
			}
			field.arraySize = self.expressions.lowerExpr(fieldType.arraySize, noVariables, callableFlow);
			self.context.genericBody = savedGeneric;
			self.context.activeTypeMap = savedTypeMap;
		}
		return field;
	}
}
