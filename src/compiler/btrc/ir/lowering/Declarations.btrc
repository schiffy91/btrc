		string interfaceTable = f"__btrc_interface_{callback.interfaceName.length()}_{callback.interfaceName}";
		var fallback = IRFunctionPointerTypedef(fallbackName, resultType); for parameter in payload { fallback.paramTypes.push(parameter.cType); } module.functionPointerTypedefs.push(fallback);
		var contextDefinition = IRStructDef(); contextDefinition.name = contextName;
		Node atomic = Node(); atomic.kind = NK_TYPE_EXPR; atomic.base = "Atomic"; atomic.pointerDepth = 1; Node unsignedType = Node(); unsignedType.kind = NK_TYPE_EXPR; unsignedType.base = "uint"; atomic.genericArgs.push(unsignedType);
		contextDefinition.fields = [IRStructField(self.cTypes.lower(receiverType), "receiver"), IRStructField(self.cTypes.lower(ownerType), "owner"), IRStructField(self.cTypes.lower(atomic), "gate"), IRStructField(fallbackName, "denied"), IRStructField(interfaceTable + "_invoke_fn", "invoke")];
		module.structDefs.push(contextDefinition); module.structForwards.push(IRStructForward(contextName));
		var capabilityDefinition = IRStructDef(); capabilityDefinition.name = shape.invocation; capabilityDefinition.fields.push(IRStructField("void*", "_context")); module.structDefs.push(capabilityDefinition); module.structForwards.push(IRStructForward(shape.invocation));
		IRNode loadContext = IRNode.variableDeclaration(contextType, "context", IRNode.cast(contextType, IRNode.variable("raw")));
		self.nativeUniqueFunction(module, prefix + "_destroy", "void", [IRParam("void*", "raw")], [loadContext, IRNode.expressionStatement(IRNode.call(uniquePrefix + "_end_borrow", [owner])), IRNode.expressionStatement(self.managedLifetime.releaseValue(receiver, receiverType)), IRNode.expressionStatement(IRNode.call("free", [context]))]);
		self.nativeUniqueFunction(module, prefix + "_unregister", "bool", [IRParam("void*", "raw")], [loadContext, IRNode.returnStatement(IRNode.binary(IRNode.call(callback.unregister.name, [unit]), "==", IRNode.literal("0")))]);
		IRNode denied = IRNode.indirectCall(IRNode.fieldAccess(context, "denied", true), payloadValues); denied.realtimeProvenance = "typed-realtime-function";
		Vector<IRNode> invocationArguments = [receiver, IRNode.addressOf(IRNode.variable("invocation"))]; invocationArguments.extend(payloadValues);
		IRNode invoke = IRNode.indirectCall(IRNode.fieldAccess(context, "invoke", true), invocationArguments); invoke.realtimeProvenance = "typed-realtime-function";
		Vector<IRNode> body = [
			IRNode.variableDeclaration(contextType, "context", IRNode.cast(contextType, IRNode.variable(parameters.get(callback.callbackContextIndex).name))),
			IRNode.ifStatement(IRNode.binary(IRNode.call("callbackGateTryEnter", [gate]), "==", IRNode.literal("false")), IRNode.block([IRNode.returnStatement(denied)]), null),
			IRNode.variableDeclaration("struct " + shape.invocation, "invocation", IRNode.initializerList([IRNode.literal("0")])),
			IRNode.assignment(IRNode.fieldAccess(IRNode.variable("invocation"), "_context", false), context),
			IRNode.variableDeclaration(resultType, "result", invoke),
			IRNode.expressionStatement(IRNode.call("callbackGateLeave", [gate])), IRNode.returnStatement(IRNode.variable("result"))
		];
		self.nativeUniqueFunction(module, prefix + "_invoke", resultType, parameters, body); module.functions.get(module.functions.len - 1).isRealtime = true;
		for operation in shape.operations {
			Vector<IRParam> operationParameters = [IRParam("struct " + shape.invocation + "*", "self")];
			Vector<IRNode> arguments = [];
			for position in range(operation.parameters.len + 1) {
				if (position == operation.ownerIndex) { arguments.push(unit); }
				else { Node parameter = operation.parameters.get(position < operation.ownerIndex ? position : position - 1); var lowered = self.cTypes.lowerParameter(parameter); operationParameters.push(lowered); arguments.push(IRNode.variable(lowered.name)); }
			}
			self.nativeUniqueFunction(module, shape.invocation + "_" + operation.name, self.cTypes.lower(operation.returnType), operationParameters, [IRNode.variableDeclaration(contextType, "context", IRNode.cast(contextType, IRNode.fieldAccess(IRNode.variable("self"), "_context", true))), IRNode.returnStatement(IRNode.call(operation.nativeFunction, arguments))]);
			module.functions.get(module.functions.len - 1).isRealtime = true; module.realtimeSafeExternals.put(operation.nativeFunction, true);
		}
		Vector<IRParam> adapterParameters = []; for parameter in declaration.params { adapterParameters.push(self.cTypes.lowerParameter(parameter)); }
		Vector<int> visible = []; for index in range(shape.nativeParameters.len) { if (index != callback.parameterIndex && index != shape.sizeIndex) { visible.push(index); } }
		IRNode ownerArgument = IRNode.variable(adapterParameters.get(visible.indexOf(shape.ownerIndex)).name);
		IRNode receiverArgument = IRNode.variable(adapterParameters.get(adapterParameters.len - 3).name); IRNode deniedArgument = IRNode.variable(adapterParameters.get(adapterParameters.len - 2).name); IRNode scopeArgument = IRNode.variable(adapterParameters.get(adapterParameters.len - 1).name);
		IRNode lookup = IRNode.call("__btrc_interface_methods", [receiver, IRNode.literal(StringLiteral(callback.interfaceName).cSource())]);
		Vector<IRNode> statements = [
			self.nativeNullGuard(ownerArgument, "Realtime registration requires an owner"), self.nativeNullGuard(receiverArgument, "Realtime registration requires a receiver"), self.nativeNullGuard(deniedArgument, "Realtime registration requires a denied-admission fallback"), self.nativeNullGuard(scopeArgument, "Realtime registration requires a scope"),
			IRNode.variableDeclaration(contextType, "context", IRNode.cast(contextType, IRNode.call("__btrc_safe_calloc", [IRNode.literal("1"), IRNode.sizeofType("struct " + contextName)]))),
			IRNode.assignment(owner, ownerArgument), IRNode.expressionStatement(self.managedLifetime.retainValue(owner, ownerType)), IRNode.expressionStatement(IRNode.call(uniquePrefix + "_begin_borrow", [owner])),
			IRNode.assignment(receiver, receiverArgument), IRNode.expressionStatement(self.managedLifetime.retainValue(receiver, receiverType)), IRNode.assignment(IRNode.fieldAccess(context, "denied", true), deniedArgument),
			IRNode.assignment(IRNode.fieldAccess(context, "invoke", true), IRNode.fieldAccess(IRNode.cast("const struct " + interfaceTable + "*", lookup), "invoke", true)),
			IRNode.variableDeclaration("struct CallbackState*", "registration", IRNode.call("CallbackScope_createNative", [scopeArgument, context, IRNode.functionReference(prefix + "_destroy"), IRNode.functionReference(prefix + "_unregister")])),
			IRNode.assignment(gate, IRNode.call("CallbackState_activationGate", [IRNode.variable("registration")])),
			IRNode.variableDeclaration(callback.record, "record", IRNode.initializerList([IRNode.literal("0")])),
			IRNode.assignment(IRNode.fieldAccess(IRNode.variable("record"), callback.field, false), IRNode.functionReference(prefix + "_invoke")), IRNode.assignment(IRNode.fieldAccess(IRNode.variable("record"), callback.contextFields.get(0), false), context)
		];
		Vector<IRNode> nativeArguments = [];
		for index in range(shape.nativeParameters.len) {
			if (index == shape.ownerIndex) { nativeArguments.push(unit); }
			else if (index == callback.parameterIndex) { nativeArguments.push(IRNode.addressOf(IRNode.variable("record"))); }
			else if (index == shape.sizeIndex) { nativeArguments.push(IRNode.sizeofType(callback.record)); }
			else { nativeArguments.push(IRNode.variable(adapterParameters.get(visible.indexOf(index)).name)); }
		}
		statements.push(IRNode.variableDeclaration(self.cTypes.lower(shape.statusType), "status", IRNode.call(shape.nativeFunction, nativeArguments)));
		IRNode failure = self.nativeNullGuard(IRNode.literal("NULL"), "Realtime callback activation failed with indeterminate publication"); failure.condition = IRNode.binary(IRNode.variable("status"), "!=", IRNode.literal("0")); statements.push(failure);
		statements.push(IRNode.expressionStatement(IRNode.call("CallbackState_finishActivation", [IRNode.variable("registration"), IRNode.literal("true")]))); statements.push(IRNode.returnStatement(IRNode.variable("registration")));
		self.nativeUniqueFunction(module, prefix, self.cTypes.lower(declaration.returnType), adapterParameters, statements);
	}

	private IRNode tableHolder(string holderType, IRNode context) { return IRNode.variableDeclaration(holderType, "holder", IRNode.cast(holderType, context)); }

	private IRNode tableThreadGuard(IRNode holder) {
		Vector<IRNode> noArguments = [];
		IRNode abortCall = IRNode.call("abort", noArguments);
		abortCall.neverReturns = true;
		return IRNode.ifStatement(IRNode.binary(IRNode.fieldAccess(holder, "thread", true), "!=", IRNode.addressOf(IRNode.variable("__btrc_try_top"))), IRNode.block([
			IRNode.expressionStatement(IRNode.call("fputs", [IRNode.literal("\"BTRC native callback delivered on the wrong thread\\n\""), IRNode.variable("stderr")])),
			IRNode.expressionStatement(abortCall)
		]), null);
	}

	/* One holder claim per live SDK table: the original and every SDK reopen. */
	private void emitCallbackTableAdapter(Node declaration, FeNativeCallContract contract, IRModule module) {
		self.context.referenceHelper("__btrc_safe_calloc");
		var table = contract.callbackTable;
		string prefix = "__btrc_native_table_" + table.resource; string holderName = prefix + "_holder"; string holderType = "struct " + holderName + "*";
		Node receiverType = SemanticTypeSystem.namedClass(table.interfaceName); string receiverC = self.cTypes.lower(receiverType); string tableType = table.nativeType + "*";
		module.structForwards.push(IRStructForward(holderName));
		var holderDefinition = IRStructDef(); holderDefinition.name = holderName;
		holderDefinition.fields = [IRStructField(receiverC, "receiver"), IRStructField("char*", "label"), IRStructField("long", "claims"), IRStructField("volatile int*", "thread")];
		module.structDefs.push(holderDefinition);
		IRNode holder = IRNode.variable("holder"); IRNode claims = IRNode.fieldAccess(holder, "claims", true); IRNode receiver = IRNode.fieldAccess(holder, "receiver", true); IRNode label = IRNode.fieldAccess(holder, "label", true);
		Vector<string> assignedFields = []; Vector<string> assignedFunctions = [];
		for method in table.methods {
			Vector<IRParam> parameters = []; Vector<IRNode> arguments = [receiver];
			for index in range(method.nativeParameters.len) {
				var parameter = IRParam(method.nativeParameters.get(index), f"argument{index}"); parameters.push(parameter);
				if (index != table.contextIndex) { arguments.push(IRNode.variable(parameter.name)); }
			}
			IRNode call = IRNode.call(table.interfaceName + "_" + method.name, arguments);
			Vector<IRNode> inner = [];
			if (method.nativeReturn == "void") { inner.push(IRNode.expressionStatement(call)); } else { inner.push(IRNode.variableDeclaration(method.nativeReturn, "result", call)); }
			inner.push(IRNode.expressionStatement(IRNode.unary("--", IRNode.variable("__btrc_try_top"), false)));
			if (method.nativeReturn == "void") { inner.push(IRNode.returnStatement(null)); } else { inner.push(IRNode.returnStatement(IRNode.variable("result"))); }
			self.nativeUniqueFunction(module, prefix + "_" + method.name, method.nativeReturn, parameters, [self.tableHolder(holderType, IRNode.variable(parameters.get(table.contextIndex).name)), self.tableThreadGuard(holder), self.nativeCallbackBoundary(inner, module)]);
			assignedFields.push(method.field); assignedFunctions.push(prefix + "_" + method.name);
		}
		if (!table.label.isEmpty()) {
			self.nativeUniqueFunction(module, prefix + "_label", "const char*", [IRParam("void*", "argument0")], [self.tableHolder(holderType, IRNode.variable("argument0")), self.tableThreadGuard(holder), IRNode.returnStatement(label)]);
			assignedFields.push(table.label); assignedFunctions.push(prefix + "_label");
		}
		if (!table.reopen.isEmpty()) { assignedFields.push(table.reopen); assignedFunctions.push(prefix + "_reopen"); }
		if (!table.releaseField.isEmpty()) { assignedFields.push(table.releaseField); assignedFunctions.push(prefix + "_release"); }
		IRNode nativeTable = IRNode.variable("table");
		Vector<IRNode> allocation = [
			IRNode.variableDeclaration(tableType, "table", IRNode.cast(tableType, IRNode.call("__btrc_safe_calloc", [IRNode.literal("1"), IRNode.sizeofType(table.nativeType)]))),
			IRNode.assignment(IRNode.fieldAccess(nativeTable, table.context, true), IRNode.cast("void*", holder))
		];
		for index in range(assignedFields.len) { allocation.push(IRNode.assignment(IRNode.fieldAccess(nativeTable, assignedFields.get(index), true), IRNode.functionReference(assignedFunctions.get(index)))); }
		allocation.push(IRNode.assignment(claims, IRNode.binary(claims, "+", IRNode.literal("1"))));
		allocation.push(IRNode.returnStatement(nativeTable));
		self.nativeUniqueFunction(module, prefix + "_table", tableType, [IRParam(holderType, "holder")], allocation);
		if (!table.reopen.isEmpty()) {
			IRNode name = IRNode.variable("argument1");
			IRNode mismatch = IRNode.binary(IRNode.binary(name, "==", IRNode.literal("NULL")), "||", IRNode.binary(IRNode.call("strcmp", [name, label]), "!=", IRNode.literal("0")));
			self.nativeUniqueFunction(module, prefix + "_reopen", tableType, [IRParam("void*", "argument0"), IRParam("const char*", "argument1")], [
				self.tableHolder(holderType, IRNode.variable("argument0")), self.tableThreadGuard(holder),
				IRNode.ifStatement(mismatch, IRNode.block([IRNode.returnStatement(IRNode.literal("NULL"))]), null),
				IRNode.returnStatement(IRNode.call(prefix + "_table", [holder]))
			]);
		}
		if (!table.releaseField.isEmpty()) {
			IRNode argument = IRNode.variable("argument0");
			Vector<IRNode> finalRelease = [
				IRNode.expressionStatement(self.managedLifetime.releaseValue(receiver, receiverType)),
				IRNode.expressionStatement(IRNode.call("free", [label])),
				IRNode.expressionStatement(IRNode.call("free", [holder])),
				IRNode.expressionStatement(IRNode.unary("--", IRNode.variable("__btrc_try_top"), false))
			];
			self.nativeUniqueFunction(module, prefix + "_release", "void", [IRParam(tableType, "argument0")], [
				IRNode.ifStatement(IRNode.binary(argument, "==", IRNode.literal("NULL")), IRNode.block([IRNode.returnStatement(null)]), null),
				self.tableHolder(holderType, IRNode.fieldAccess(argument, table.context, true)), self.tableThreadGuard(holder),
				IRNode.expressionStatement(IRNode.call("free", [argument])),
				IRNode.assignment(claims, IRNode.binary(claims, "-", IRNode.literal("1"))),
				IRNode.ifStatement(IRNode.binary(claims, "==", IRNode.literal("0")), self.nativeCallbackBoundary(finalRelease, module), null)
			]);
		}
		Vector<IRParam> createParameters = [IRParam(receiverC, "receiver")];
		Vector<IRNode> create = [
			IRNode.variableDeclaration(holderType, "holder", IRNode.cast(holderType, IRNode.call("__btrc_safe_calloc", [IRNode.literal("1"), IRNode.sizeofType("struct " + holderName)]))),
			IRNode.assignment(receiver, IRNode.variable("receiver")),
			IRNode.expressionStatement(self.managedLifetime.retainValue(IRNode.variable("receiver"), receiverType)),
			IRNode.assignment(IRNode.fieldAccess(holder, "thread", true), IRNode.addressOf(IRNode.variable("__btrc_try_top")))
		];
		if (!table.label.isEmpty()) {
			createParameters.push(IRParam("char*", "label"));
			create.push(IRNode.variableDeclaration("size_t", "length", IRNode.call("strlen", [IRNode.variable("label")])));
			create.push(IRNode.assignment(label, IRNode.cast("char*", IRNode.call("__btrc_safe_calloc", [IRNode.literal("1"), IRNode.binary(IRNode.variable("length"), "+", IRNode.literal("1"))]))));
			create.push(IRNode.expressionStatement(IRNode.call("memcpy", [label, IRNode.variable("label"), IRNode.variable("length")])));
		}
		create.push(IRNode.returnStatement(IRNode.call(prefix + "_table", [holder])));
		self.nativeUniqueFunction(module, prefix + "_create", tableType, createParameters, create);
		Vector<IRParam> adapterParameters = []; Vector<IRNode> statements = []; Vector<IRNode> arguments = []; Map<string, bool> parameterNames = {};
		for parameter in declaration.params {
			var lowered = self.cTypes.lowerParameter(parameter); adapterParameters.push(lowered); parameterNames.put(lowered.name, true); arguments.push(IRNode.variable(lowered.name));
			statements.push(self.nativeNullGuard(IRNode.variable(lowered.name), f"Native call {declaration.name}: null argument {lowered.name}"));
		}
		Vector<Vector<IRNode>> releases = []; Vector<IRNode> cleanup = [];
		self.nativeUniqueResult(declaration, IRNode.call(prefix + "_create", arguments), parameterNames, statements, releases, cleanup);
		self.nativeUniqueFunction(module, contract.adapterSymbol(declaration.name), self.cTypes.lower(declaration.returnType), adapterParameters, statements);
	}

	private void nativeUniqueFunction(IRModule module, string name, string result, Vector<IRParam> parameters, Vector<IRNode> statements) {
		var declaration = IRFunctionDecl(name, result, true);
		declaration.params = parameters;
		module.functionDecls.push(declaration);
		var adapter = IRFunction();
		adapter.name = name; adapter.returnType = result; adapter.params = parameters;
		adapter.isStatic = true; adapter.body = IRNode.block(statements);
		module.functions.push(adapter);
	}

	private IRNode nativeUniqueChecked(string name, Vector<IRNode> arguments) {
		IRNode guard = self.nativeNullGuard(IRNode.literal("NULL"), f"Native resource synchronization: {name} failed");
		guard.condition = IRNode.binary(IRNode.call(name, arguments), "!=", IRNode.literal("0"));
		return guard;
	}

	private void emitUniqueResource(FeNativeImportedDeclaration imported, IRModule module) {
		var resource = imported.resource;
		string nativeType = imported.typeSpelling.isEmpty() ? resource.name : imported.typeSpelling;
		bool statusRelease = !resource.releaseConsumption.isEmpty();
		string closeType = "void";
		for member in imported.declaration.members { if (member.name == "close") { closeType = self.cTypes.lower(member.returnType); } }
		self.appendPreprocessorDecl(module, IRPreprocessorDecl.include("pthread.h", true));
		string nativePrefix = "__btrc_native_" + resource.name;
		string prefix = "__btrc_unique_" + resource.name;
		module.structForwards.push(IRStructForward(nativePrefix));
		string pointerType = "struct " + nativePrefix + "*";
		IRNode owner = IRNode.variable("self");
		IRNode value = IRNode.fieldAccess(owner, "value", true);
		IRNode borrows = IRNode.fieldAccess(owner, "borrows", true);
		IRNode closing = IRNode.fieldAccess(owner, "closing", true);
		IRNode status = IRNode.fieldAccess(owner, "status", true);
		IRNode closingThread = IRNode.fieldAccess(owner, "closingThread", true);
		IRNode mutex = IRNode.addressOf(IRNode.fieldAccess(owner, "lock", true));
		IRNode completed = IRNode.addressOf(IRNode.fieldAccess(owner, "completed", true));
		Vector<IRParam> parameters = [IRParam(pointerType, "self")];
		var definition = IRStructDef(); definition.name = nativePrefix;
		self.managedTypes.appendHeaderField(definition);
		definition.fields.push(IRStructField(nativeType, "value"));
		definition.fields.push(IRStructField("unsigned int", "borrows"));
		definition.fields.push(IRStructField("bool", "closing"));
		definition.fields.push(IRStructField("pthread_t", "closingThread"));
		definition.fields.push(IRStructField("pthread_mutex_t", "lock"));
		definition.fields.push(IRStructField("pthread_cond_t", "completed"));
		if (statusRelease) { definition.fields.push(IRStructField(closeType, "status")); }
		if (!resource.storage.isEmpty()) { definition.fields.push(IRStructField(nativeType, "storage")); definition.fields.push(IRStructField("void*", "input")); definition.fields.push(IRStructField("bool", "inputAttached")); }
		module.structDefs.push(definition);
		for helper in ["__btrc_arc_retain", "__btrc_arc_release", "__btrc_safe_calloc"] { self.context.referenceHelper(helper); }
		Vector<IRNode> noArguments = [];
		IRNode lock = self.nativeUniqueChecked("pthread_mutex_lock", [mutex]);
		IRNode unlock = self.nativeUniqueChecked("pthread_mutex_unlock", [mutex]);
		IRNode reentrant = self.nativeNullGuard(IRNode.literal("NULL"), f"Native resource {resource.name}: reentrant close");
		reentrant.condition = IRNode.call("pthread_equal", [closingThread, IRNode.call("pthread_self", noArguments)]);
		IRNode wait = IRNode.whileStatement(closing, IRNode.block([reentrant, self.nativeUniqueChecked("pthread_cond_wait", [completed, mutex])]));
		IRNode borrowed = self.nativeNullGuard(IRNode.literal("NULL"), f"Native resource {resource.name}: close during borrow");
		borrowed.condition = IRNode.binary(borrows, "!=", IRNode.literal("0"));
		Vector<IRNode> close = [
			IRNode.ifStatement(IRNode.binary(owner, "==", IRNode.literal("NULL")), IRNode.block([IRNode.returnStatement(statusRelease ? IRNode.literal("0") : null)]), null),
			lock, wait
		];
		if (statusRelease) { close.push(IRNode.ifStatement(IRNode.binary(value, "==", IRNode.literal("NULL")), IRNode.block([
				IRNode.variableDeclaration(closeType, "result", status), unlock, IRNode.returnStatement(IRNode.variable("result"))
			]), null)); }
		close.extend([borrowed, IRNode.variableDeclaration(nativeType, "native", value),
			IRNode.assignment(value, IRNode.literal("NULL")), IRNode.assignment(closing, IRNode.literal("true")),
			IRNode.assignment(closingThread, IRNode.call("pthread_self", noArguments)), unlock
		]);
		IRNode destroyCall = IRNode.call(resource.releaseFunction, [IRNode.variable("native")]);
		if (statusRelease) { close.push(IRNode.variableDeclaration(closeType, "result", destroyCall)); }
		else { close.push(IRNode.ifStatement(IRNode.variable("native"), IRNode.block([IRNode.expressionStatement(destroyCall)]), null)); }
		if (!resource.storage.isEmpty()) {
			for field in ["input", "storage"] {
				IRNode storage = IRNode.fieldAccess(owner, field, true);
				close.push(IRNode.expressionStatement(IRNode.call("free", [storage])));
				close.push(IRNode.assignment(storage, IRNode.literal("NULL")));
			}
		}
		close.push(lock);
		if (statusRelease) { close.push(IRNode.assignment(status, IRNode.variable("result"))); }
		close.extend([IRNode.assignment(closing, IRNode.literal("false")), self.nativeUniqueChecked("pthread_cond_broadcast", [completed]), unlock]);
		if (statusRelease) { close.push(IRNode.returnStatement(IRNode.variable("result"))); }
		self.nativeUniqueFunction(module, prefix + "_close", closeType, parameters, close);
		self.nativeUniqueFunction(module, prefix + "_isOpen_public", "bool", parameters, [
			IRNode.ifStatement(IRNode.binary(owner, "==", IRNode.literal("NULL")), IRNode.block([IRNode.returnStatement(IRNode.literal("false"))]), null),
			lock, IRNode.variableDeclaration("bool", "opened", IRNode.binary(IRNode.binary(value, "!=", IRNode.literal("NULL")), "&&", IRNode.binary(closing, "==", IRNode.literal("false")))), unlock, IRNode.returnStatement(IRNode.variable("opened"))
		]);
		IRNode destroyClose = IRNode.call(prefix + "_close", [owner]);
		IRNode destroyCheck = self.nativeNullGuard(IRNode.literal("NULL"), f"Native resource {resource.name}: destruction outcome is indeterminate");
		destroyCheck.condition = IRNode.binary(destroyClose, "!=", IRNode.literal("0"));
		Vector<IRNode> destroy = [
			IRNode.variableDeclaration(pointerType, "self", IRNode.cast(pointerType, IRNode.variable("raw"))),
			resource.cleanupStatus == "abort" ? destroyCheck : IRNode.expressionStatement(destroyClose)
		];
		if (!resource.storage.isEmpty()) { for field in ["input", "storage"] { destroy.push(IRNode.expressionStatement(IRNode.call("free", [IRNode.fieldAccess(owner, field, true)]))); } }
		destroy.extend([
			self.nativeUniqueChecked("pthread_cond_destroy", [completed]), self.nativeUniqueChecked("pthread_mutex_destroy", [mutex]),
			IRNode.expressionStatement(IRNode.call("free", [owner]))
		]);
		self.nativeUniqueFunction(module, prefix + "_destroy", "void", [IRParam("void*", "raw")], destroy);
		self.managedTypes.emitDescriptor(module, prefix, false, false);
		Vector<IRNode> create = [IRNode.variableDeclaration(pointerType, "self", IRNode.cast(pointerType, IRNode.call("__btrc_safe_calloc", [IRNode.literal("1"), IRNode.sizeofType("struct " + nativePrefix)])))];
		create.push(self.nativeUniqueChecked("pthread_mutex_init", [mutex, IRNode.literal("NULL")]));
		create.push(self.nativeUniqueChecked("pthread_cond_init", [completed, IRNode.literal("NULL")]));
		self.managedTypes.appendHeaderInitialization(prefix, create);
		create.push(IRNode.returnStatement(owner));
		Vector<IRParam> noParameters = [];
		self.nativeUniqueFunction(module, prefix + "_new", pointerType, noParameters, create);
		self.nativeUniqueFunction(module, nativePrefix + "_retain", "void", [IRParam("void*", "raw")], [IRNode.expressionStatement(IRNode.call("__btrc_arc_retain", [IRNode.variable("raw")]))]);
		self.nativeUniqueFunction(module, nativePrefix + "_release", "void", [IRParam("void*", "raw")], [IRNode.expressionStatement(IRNode.call("__btrc_arc_release", [IRNode.variable("raw"), IRNode.addressOf(IRNode.variable(self.managedTypes.descriptorSymbol(prefix)))]))]);
		Vector<IRNode> publicClose = [];
		if (statusRelease) { publicClose.push(self.nativeNullGuard(owner, f"Native resource {resource.name}: close on null owner")); }
		publicClose.push(IRNode.expressionStatement(IRNode.call(nativePrefix + "_retain", [owner])));
		IRNode closeCall = IRNode.call(prefix + "_close", [owner]);
		publicClose.push(statusRelease ? IRNode.variableDeclaration(closeType, "result", closeCall) : IRNode.expressionStatement(closeCall));
		publicClose.push(IRNode.expressionStatement(IRNode.call(nativePrefix + "_release", [owner])));
		if (statusRelease) { publicClose.push(IRNode.returnStatement(IRNode.variable("result"))); }
		self.nativeUniqueFunction(module, prefix + "_close_public", closeType, parameters, publicClose);
		IRNode overflow = self.nativeNullGuard(IRNode.literal("NULL"), f"Native resource {resource.name}: borrow overflow");
		overflow.condition = IRNode.binary(borrows, "==", IRNode.variable("UINT_MAX"));
		IRNode exclusive = self.nativeNullGuard(IRNode.literal("NULL"), f"Native resource {resource.name}: exclusive operation in progress"); exclusive.condition = closing;
		self.nativeUniqueFunction(module, prefix + "_begin_borrow", "void", parameters, [
			IRNode.ifStatement(IRNode.binary(owner, "==", IRNode.literal("NULL")), IRNode.block([IRNode.returnStatement(null)]), null), lock,
			self.nativeNullGuard(value, f"Native resource {resource.name}: use after close"), exclusive, overflow,
			IRNode.assignment(borrows, IRNode.binary(borrows, "+", IRNode.literal("1"))), unlock
		]);
		self.nativeUniqueFunction(module, prefix + "_end_borrow", "void", [IRParam("void*", "raw")], [
			IRNode.ifStatement(IRNode.binary(IRNode.variable("raw"), "==", IRNode.literal("NULL")), IRNode.block([IRNode.returnStatement(null)]), null),
			IRNode.variableDeclaration(pointerType, "self", IRNode.cast(pointerType, IRNode.variable("raw"))), lock,
			IRNode.assignment(borrows, IRNode.binary(borrows, "-", IRNode.literal("1"))), unlock,
			IRNode.expressionStatement(IRNode.call(nativePrefix + "_release", [owner]))
		]);
		if (!resource.storage.isEmpty()) {
			IRNode attachmentBorrowed = self.nativeNullGuard(IRNode.literal("NULL"), f"Native resource {resource.name}: attachment during borrow"); attachmentBorrowed.condition = IRNode.binary(borrows, "!=", IRNode.literal("0"));
			IRNode attached = self.nativeNullGuard(IRNode.literal("NULL"), f"Native resource {resource.name}: input already attached"); attached.condition = IRNode.fieldAccess(owner, "inputAttached", true);
			self.nativeUniqueFunction(module, prefix + "_begin_attachment", "void", parameters, [
				self.nativeNullGuard(owner, f"Native resource {resource.name}: attachment on null owner"), lock, exclusive,
				self.nativeNullGuard(value, f"Native resource {resource.name}: use after close"), attachmentBorrowed, attached,
				IRNode.assignment(closing, IRNode.literal("true")), IRNode.assignment(closingThread, IRNode.call("pthread_self", noArguments)), unlock
			]);
			self.nativeUniqueFunction(module, prefix + "_end_attachment", "void", [IRParam("void*", "raw")], [
				IRNode.ifStatement(IRNode.binary(IRNode.variable("raw"), "==", IRNode.literal("NULL")), IRNode.block([IRNode.returnStatement(null)]), null),
				IRNode.variableDeclaration(pointerType, "self", IRNode.cast(pointerType, IRNode.variable("raw"))), lock,
				IRNode.assignment(closing, IRNode.literal("false")), self.nativeUniqueChecked("pthread_cond_broadcast", [completed]), unlock,
				IRNode.expressionStatement(IRNode.call(nativePrefix + "_release", [owner]))
			]);
		}
	}

	private IRNode nativeSnapshotPath(FeNativeRecordPath path, IRNode root, Vector<IRNode> statements, Vector<IRNode> failure) {
		IRNode value = root;
		for index in range(path.fields.len) {
			bool pointer = path.pointers.get(index);
			if (pointer) { statements.push(IRNode.ifStatement(IRNode.binary(value, "==", IRNode.literal("NULL")), IRNode.block(failure), null)); }
			value = IRNode.fieldAccess(value, path.fields.get(index), pointer);
		}
		return value;
	}

	private Vector<IRNode> nativeSnapshotPlane(Vector<FeNativeRecordPath> paths, Vector<IRNode> arguments, Vector<IRNode> statements, Vector<IRNode> failure) {
		IRNode width = IRNode.variable("__btrc_snapshot_width"); IRNode rows = IRNode.variable("__btrc_snapshot_rows");
		IRNode pitch = IRNode.variable("__btrc_snapshot_pitch"); IRNode pointer = IRNode.variable("__btrc_snapshot_pointer");
		IRNode span = IRNode.variable("__btrc_snapshot_span"); IRNode stride = IRNode.variable("__btrc_snapshot_stride");
		IRNode offset = IRNode.variable("__btrc_snapshot_offset"); IRNode address = IRNode.variable("__btrc_snapshot_address");
		Vector<IRNode> dimensions = [width, rows];
		for index in range(dimensions.len) {
			FeNativeRecordPath path = paths.get(index + 1); IRNode dimension = dimensions.get(index);
			IRNode value = self.nativeSnapshotPath(path, arguments.get(0), statements, failure);
			statements.push(IRNode.variableDeclaration(self.cTypes.lower(path.valueType), dimension.name, value));
			if (!path.valueType.base.startsWith("unsigned")) { statements.push(IRNode.ifStatement(IRNode.binary(dimension, "<", IRNode.literal("0")), IRNode.block(failure), null)); }
		}
		statements.extend([
			IRNode.variableDeclaration("const unsigned char*", pointer.name, IRNode.literal("NULL")),
			IRNode.variableDeclaration("unsigned long long", span.name, IRNode.literal("0ULL"))
		]);
		Vector<IRNode> nonempty = [];
		IRNode value = self.nativeSnapshotPath(paths.get(3), arguments.get(0), nonempty, failure);
		nonempty.extend([
			IRNode.variableDeclaration("long long", pitch.name, IRNode.cast("long long", value)),
			IRNode.variableDeclaration("unsigned long long", stride.name, IRNode.ternary(IRNode.binary(pitch, "<", IRNode.literal("0LL")), IRNode.binary(IRNode.literal("0ULL"), "-", IRNode.cast("unsigned long long", pitch)), IRNode.cast("unsigned long long", pitch))),
			IRNode.ifStatement(IRNode.binary(stride, "==", IRNode.literal("0ULL")), IRNode.block(failure), null),
			IRNode.ifStatement(IRNode.binary(IRNode.cast("unsigned long long", rows), ">", IRNode.binary(IRNode.cast("unsigned long long", arguments.get(1)), "/", stride)), IRNode.block(failure), null),
			IRNode.assignment(span, IRNode.binary(IRNode.cast("unsigned long long", rows), "*", stride)),
			IRNode.ifStatement(IRNode.binary(span, ">", IRNode.literal("2147483646ULL")), IRNode.block(failure), null)
		]);
		IRNode data = self.nativeSnapshotPath(paths.get(0), arguments.get(0), nonempty, failure);
		nonempty.extend([
			IRNode.assignment(pointer, IRNode.cast("const unsigned char*", data)),
			IRNode.ifStatement(IRNode.binary(pointer, "==", IRNode.literal("NULL")), IRNode.block(failure), null),
			IRNode.variableDeclaration("uintptr_t", address.name, IRNode.cast("uintptr_t", pointer)),
			IRNode.variableDeclaration("unsigned long long", offset.name, IRNode.binary(span, "-", stride)),
			IRNode.ifStatement(IRNode.binary(pitch, "<", IRNode.literal("0LL")), IRNode.block([
			IRNode.ifStatement(IRNode.binary(IRNode.cast("unsigned long long", address), "<=", offset), IRNode.block(failure), null),
			IRNode.assignment(address, IRNode.binary(address, "-", IRNode.cast("uintptr_t", offset)))
		]), null),
			IRNode.ifStatement(IRNode.binary(span, ">", IRNode.binary(IRNode.cast("unsigned long long", IRNode.variable("UINTPTR_MAX")), "-", IRNode.cast("unsigned long long", address))), IRNode.block(failure), null),
			IRNode.ifStatement(IRNode.binary(pitch, "<", IRNode.literal("0LL")), IRNode.block([IRNode.assignment(pointer, IRNode.binary(pointer, "-", IRNode.cast("size_t", offset)))]), null)
		]);
		statements.push(IRNode.ifStatement(IRNode.binary(IRNode.binary(width, "!=", IRNode.literal("0")), "&&", IRNode.binary(rows, "!=", IRNode.literal("0"))), IRNode.block(nonempty), null));
		return [pointer, span];
	}

	private Vector<IRNode> nativeSnapshotSpan(Vector<FeNativeRecordPath> paths, Vector<IRNode> arguments, Vector<IRNode> statements, Vector<IRNode> failure) {
		FeNativeRecordPath lengthPath = paths.get(1);
		IRNode length = IRNode.variable("__btrc_snapshot_length"); IRNode pointer = IRNode.variable("__btrc_snapshot_pointer");
		IRNode value = self.nativeSnapshotPath(lengthPath, arguments.get(0), statements, failure);
		statements.push(IRNode.variableDeclaration(self.cTypes.lower(lengthPath.valueType), length.name, value));
		if (!lengthPath.valueType.base.startsWith("unsigned")) { statements.push(IRNode.ifStatement(IRNode.binary(length, "<", IRNode.literal("0")), IRNode.block(failure), null)); }
		IRNode wide = IRNode.cast("uintmax_t", length);
		statements.push(IRNode.ifStatement(IRNode.binary(IRNode.binary(wide, ">", IRNode.cast("uintmax_t", arguments.get(1))), "||", IRNode.binary(wide, ">", IRNode.literal("2147483646U"))), IRNode.block(failure), null));
		value = self.nativeSnapshotPath(paths.get(0), arguments.get(0), statements, failure);
		statements.extend([
			IRNode.variableDeclaration("const unsigned char*", pointer.name, IRNode.cast("const unsigned char*", value)),
			IRNode.ifStatement(IRNode.binary(IRNode.binary(length, "!=", IRNode.literal("0")), "&&", IRNode.binary(pointer, "==", IRNode.literal("NULL"))), IRNode.block(failure), null),
			IRNode.ifStatement(IRNode.binary(wide, ">", IRNode.binary(IRNode.cast("uintmax_t", IRNode.variable("UINTPTR_MAX")), "-", IRNode.cast("uintmax_t", IRNode.cast("uintptr_t", pointer)))), IRNode.block(failure), null)
		]);
		return [pointer, length];
	}

	private void nativeRecordSnapshot(Node declaration, FeNativeRecordSnapshot snapshot, Vector<IRNode> arguments, Vector<IRNode> statements, Vector<Vector<IRNode>> releases, Vector<IRNode> cleanup) {
		Vector<IRNode> failure = [];
		for (int index = releases.len - 1; index >= 0; index--) { failure.extend(releases.get(index)); }
		failure.extend(cleanup); failure.push(IRNode.returnStatement(IRNode.literal("NULL")));
		if (!snapshot.byteField.isEmpty() || snapshot.strings.len > 0) { statements.push(IRNode.ifStatement(IRNode.binary(arguments.get(1), "<", IRNode.literal("0")), IRNode.block(failure), null)); }
		if (snapshot.guardPath != null) {
			IRNode guard = self.nativeSnapshotPath(snapshot.guardPath, arguments.get(0), statements, failure);
			statements.push(IRNode.ifStatement(IRNode.binary(guard, "!=", IRNode.variable(snapshot.guardConstant)), IRNode.block(failure), null));
		}
		Vector<IRNode> values = [];
		for index in range(snapshot.paths.len) {
			FeNativeRecordPath path = snapshot.paths.get(index);
			IRNode value = self.nativeSnapshotPath(path, arguments.get(0), statements, failure);
			string name = f"__btrc_snapshot_field_{index}";
			statements.push(IRNode.variableDeclaration(self.cTypes.lower(path.valueType), name, value)); values.push(IRNode.variable(name));
		}
		Vector<IRNode> plane = [];
		if (!snapshot.byteField.isEmpty()) { plane = snapshot.byteSpan ? self.nativeSnapshotSpan(snapshot.bytePaths, arguments, statements, failure) : self.nativeSnapshotPlane(snapshot.bytePaths, arguments, statements, failure); }
		var stringNames = snapshot.strings.keys(); stringNames.sortBy((string left, string right) => Strings.lessThan(left, right));
		Vector<IRNode> pointers = []; Vector<IRNode> lengths = [];
		for index in range(stringNames.len) {
			IRNode value = self.nativeSnapshotPath(snapshot.strings.get(stringNames.get(index)), arguments.get(0), statements, failure);
			IRNode pointer = IRNode.variable(f"__btrc_snapshot_string_{index}"); IRNode length = IRNode.variable(f"__btrc_snapshot_length_{index}");
			pointers.push(pointer); lengths.push(length);
			statements.extend([
				IRNode.variableDeclaration("const char*", pointer.name, IRNode.cast("const char*", value)),
				IRNode.variableDeclaration("size_t", length.name, IRNode.literal("0")),
				IRNode.ifStatement(IRNode.binary(pointer, "!=", IRNode.literal("NULL")), IRNode.block([
				IRNode.whileStatement(IRNode.binary(IRNode.binary(length, "<=", IRNode.cast("size_t", arguments.get(1))), "&&", IRNode.binary(IRNode.dereference(IRNode.binary(pointer, "+", length)), "!=", IRNode.literal("0"))), IRNode.block([IRNode.assignment(length, IRNode.binary(length, "+", IRNode.literal("1")))])),
				IRNode.ifStatement(IRNode.binary(IRNode.binary(length, ">", IRNode.cast("size_t", arguments.get(1))), "||", IRNode.binary(length, ">", IRNode.literal("2147483646U"))), IRNode.block(failure), null)
			]), null)
			]);
		}
		Vector<IRNode> noArguments = [];
		IRNode owner = IRNode.variable("__btrc_snapshot_result");
		IRNode slot = IRNode.variableDeclaration(self.cTypes.lower(declaration.returnType), owner.name, IRNode.call(snapshot.resultName + "_new", noArguments));
		statements.extend([slot, IRNode.expressionStatement(self.managedLifetime.registerCleanupSlot(slot, self.managedValues.runtimeType(declaration.returnType)))]);
		for index in range(snapshot.fields.len) { statements.push(IRNode.assignment(IRNode.fieldAccess(owner, snapshot.fields.get(index).name, true), values.get(index))); }

		for index in range(stringNames.len) {
			IRNode field = IRNode.fieldAccess(owner, stringNames.get(index), true); IRNode pointer = pointers.get(index); IRNode length = lengths.get(index);
			statements.push(IRNode.ifStatement(IRNode.binary(pointer, "!=", IRNode.literal("NULL")), IRNode.block([
				IRNode.assignment(field, IRNode.call("__btrc_string_alloc", [IRNode.cast("int", length)])),
				IRNode.expressionStatement(IRNode.call("memcpy", [field, pointer, length]))
			]), null));
		}
		if (!snapshot.byteField.isEmpty()) {
			var bytesType = Node(); bytesType.kind = NK_TYPE_EXPR; bytesType.base = "Bytes"; bytesType.pointerDepth = 1;
			statements.push(IRNode.expressionStatement(self.managedLifetime.replaceEdge(IRNode.fieldAccess(owner, snapshot.byteField, true), IRNode.call("Bytes_fromRaw", [IRNode.cast("char*", plane.get(0)), IRNode.cast("int", plane.get(1))]), bytesType, owner, true)));
		}
		for (int index = releases.len - 1; index >= 0; index--) { statements.extend(releases.get(index)); }
		statements.extend(cleanup); statements.push(IRNode.returnStatement(owner));
	}

	private void nativeCopiedResult(Node declaration, FeNativeCallContract contract, Vector<IRNode> arguments, Map<string, bool> parameterNames, Vector<IRNode> statements, Vector<Vector<IRNode>> releases, Vector<IRNode> cleanup) {
		FeNativeCopiedResult projection = contract.copiedResult;
		Vector<string> names = [];
		for stem in ["copied_result", "copied_pointer", "copied_length"] {
			string name = "__btrc_native_" + stem;
			while (parameterNames.has(name) || names.contains(name)) { name = name + "_"; }
			names.push(name);
		}
		IRNode result = IRNode.variable(names.get(0)); IRNode pointer = IRNode.variable(names.get(1)); IRNode length = IRNode.variable(names.get(2));
		IRNode slot = IRNode.variableDeclaration(self.cTypes.lower(declaration.returnType), names.get(0), IRNode.literal("NULL"));
		statements.extend([slot, IRNode.expressionStatement(self.managedLifetime.registerCleanupSlot(slot, self.managedValues.runtimeType(declaration.returnType))), IRNode.variableDeclaration(projection.kind == "string" ? "const char*" : "const void*", names.get(1), IRNode.call(declaration.name, arguments))]);
		if (contract.nonnullReturn) { statements.push(self.nativeNullGuard(pointer, f"Native call {declaration.name}: null result")); }
		if (projection.kind == "string") {
			Vector<IRNode> copy = [IRNode.assignment(result, IRNode.call("__btrc_string_alloc", [IRNode.cast("int", length)])), IRNode.expressionStatement(IRNode.call("memcpy", [result, pointer, length]))];
			Vector<IRNode> measured = [IRNode.variableDeclaration("size_t", names.get(2), IRNode.call("strlen", [pointer])), IRNode.ifStatement(IRNode.binary(length, "<=", IRNode.literal("2147483647U")), IRNode.block(copy), null)];
			statements.push(IRNode.ifStatement(IRNode.binary(pointer, "!=", IRNode.literal("NULL")), IRNode.block(measured), null));
		} else {
			Vector<IRNode> lengthArguments = [];
			for index in projection.lengthArguments { lengthArguments.push(arguments.get(index)); }
			statements.push(IRNode.variableDeclaration("int", names.get(2), IRNode.call(projection.lengthFunction, lengthArguments)));
			IRNode bounded = IRNode.binary(IRNode.binary(length, ">=", IRNode.literal("0")), "&&", IRNode.binary(length, "<=", IRNode.literal("2147483646")));
			IRNode validPointer = IRNode.binary(IRNode.binary(pointer, "!=", IRNode.literal("NULL")), "||", IRNode.binary(length, "==", IRNode.literal("0")));
			statements.push(IRNode.ifStatement(IRNode.binary(bounded, "&&", validPointer), IRNode.block([IRNode.assignment(result, IRNode.call("Bytes_fromRaw", [IRNode.cast("char*", pointer), length]))]), null));
		}
		for (int index = releases.len - 1; index >= 0; index--) { statements.extend(releases.get(index)); }
		statements.extend(cleanup); statements.push(IRNode.returnStatement(result));
	}

	private void nativeOwnedOutput(Node declaration, FeNativeOwnedOutput output, Vector<IRNode> arguments, Map<string, bool> parameterNames, Vector<IRNode> statements, Vector<Vector<IRNode>> releases, Vector<IRNode> cleanup) {
		if (output.initializer != null) { self.nativeInitializer(declaration, output, arguments, parameterNames, statements, releases, cleanup); return; }
		if (output.sizedResource != null) { self.nativeResourceOutput(declaration, output, arguments, parameterNames, statements, releases, cleanup); return; }
		Vector<IRNode> callArguments = arguments;
		string name = "__btrc_native_owned_output";
		while (parameterNames.has(name)) { name = name + "_"; }
		Vector<IRNode> noArguments = [];
		IRNode slot = IRNode.variableDeclaration(self.cTypes.lower(declaration.returnType), name, IRNode.call(output.resultName + "_new", noArguments));
		IRNode owner = IRNode.variable(name);
		IRNode child = IRNode.fieldAccess(owner, "value", true);
		IRNode native = IRNode.fieldAccess(child, "value", true);
		statements.extend([slot, IRNode.expressionStatement(self.managedLifetime.registerCleanupSlot(slot, self.managedValues.runtimeType(declaration.returnType))), IRNode.assignment(child, IRNode.call("__btrc_unique_" + output.resource + "_new", noArguments))]);
		FeNativeOutputOffset? offset = output.offset;
		Vector<string> offsetNames = [];
		IRNode source = IRNode.literal("NULL"); IRNode length = IRNode.literal("0"); IRNode tail = IRNode.literal("NULL");
		if (offset != null) {
			for stem in ["tail", "tail_base", "tail_address"] {
				string local = "__btrc_native_" + stem;
				while (parameterNames.has(local) || local == name || offsetNames.contains(local)) { local = local + "_"; }
				offsetNames.push(local);
			}
			tail = IRNode.variable(offsetNames.get(0));
			Vector<IRNode> nativeArguments = [];
			int visible = 0;
			for index in range(arguments.len + 2) {
				if (index == output.parameterIndex) { nativeArguments.push(IRNode.addressOf(native)); }
				else if (index == offset.parameterIndex) { nativeArguments.push(IRNode.addressOf(tail)); }
				else {
					IRNode argument = arguments.get(visible); visible++;
					if (index == offset.inputIndex) { source = argument; }
					if (index == offset.lengthIndex) { length = argument; }
					nativeArguments.push(argument);
				}
			}
			callArguments = nativeArguments;
			statements.push(IRNode.variableDeclaration("const char*", offsetNames.get(0), IRNode.literal("NULL")));
			IRNode guard = self.nativeNullGuard(IRNode.literal("NULL"), f"Native call {declaration.name}: negative bounded input length");
			guard.condition = IRNode.binary(length, "<", IRNode.literal("0")); statements.push(guard);
		} else { callArguments.insert(output.parameterIndex, IRNode.addressOf(native)); }
		statements.push(IRNode.assignment(IRNode.fieldAccess(owner, "status", true), IRNode.call(declaration.name, callArguments)));
		if (offset != null) {
			IRNode base = IRNode.variable(offsetNames.get(1)); IRNode address = IRNode.variable(offsetNames.get(2));
			IRNode difference = IRNode.binary(address, "-", base);
			IRNode valid = IRNode.binary(IRNode.binary(IRNode.binary(tail, "!=", IRNode.literal("NULL")), "&&", IRNode.binary(source, "!=", IRNode.literal("NULL"))), "&&", IRNode.binary(IRNode.binary(address, ">=", base), "&&", IRNode.binary(difference, "<=", IRNode.cast("uintptr_t", length))));
			statements.extend([
				IRNode.variableDeclaration("uintptr_t", offsetNames.get(1), IRNode.cast("uintptr_t", source)),
				IRNode.variableDeclaration("uintptr_t", offsetNames.get(2), IRNode.cast("uintptr_t", tail)),
				IRNode.assignment(IRNode.fieldAccess(owner, offset.field, true), IRNode.literal("-1")),
				IRNode.ifStatement(valid, IRNode.block([IRNode.assignment(IRNode.fieldAccess(owner, offset.field, true), IRNode.cast("int", difference))]), null)
			]);
		}
		statements.push(IRNode.ifStatement(IRNode.binary(native, "==", IRNode.literal("NULL")), IRNode.block([
			IRNode.expressionStatement(IRNode.call("__btrc_native_" + output.resource + "_release", [child])), IRNode.assignment(child, IRNode.literal("NULL"))
		]), null));
		for (int index = releases.len - 1; index >= 0; index--) { statements.extend(releases.get(index)); }
		statements.extend(cleanup); statements.push(IRNode.returnStatement(owner));
	}

	private void nativeCopiedInput(Node declaration, FeNativeCopiedInput shape, Vector<IRNode> arguments, Map<string, bool> parameterNames, Vector<IRNode> statements, Vector<Vector<IRNode>> releases, Vector<IRNode> cleanup) {
		IRNode owner = arguments.get(shape.ownerIndex);
		IRNode source = arguments.get(shape.inputIndex); IRNode length = arguments.get(shape.lengthIndex);
		IRNode backing = IRNode.fieldAccess(owner, "input", true);
		string calledName = "__btrc_native_input_called"; while (parameterNames.has(calledName)) { calledName = calledName + "_"; }
		IRNode called = IRNode.variable(calledName);
		IRNode invalid = self.nativeNullGuard(IRNode.literal("NULL"), f"Native call {declaration.name}: invalid copied input span");
		invalid.condition = IRNode.binary(IRNode.binary(IRNode.cast("uintmax_t", length), ">", IRNode.cast("uintmax_t", IRNode.variable("SIZE_MAX"))), "||", IRNode.binary(IRNode.binary(length, "!=", IRNode.literal("0")), "&&", IRNode.binary(source, "==", IRNode.literal("NULL"))));
		Vector<IRNode> nativeArguments = [];
		for index in range(arguments.len) { nativeArguments.push(index == shape.ownerIndex ? IRNode.fieldAccess(owner, "value", true) : index == shape.inputIndex ? backing : arguments.get(index)); }
		statements.extend([
			IRNode.variableDeclaration("bool", calledName, IRNode.literal("false")), invalid,
			IRNode.assignment(backing, IRNode.call("calloc", [IRNode.literal("1"), IRNode.ternary(IRNode.binary(length, "==", IRNode.literal("0")), IRNode.literal("1"), length)])),
			IRNode.ifStatement(IRNode.binary(backing, "!=", IRNode.literal("NULL")), IRNode.block([
			IRNode.ifStatement(IRNode.binary(length, "!=", IRNode.literal("0")), IRNode.block([IRNode.expressionStatement(IRNode.call("memcpy", [backing, source, length]))]), null),
			IRNode.expressionStatement(IRNode.call(declaration.name, nativeArguments)), IRNode.assignment(IRNode.fieldAccess(owner, "inputAttached", true), IRNode.literal("true")), IRNode.assignment(called, IRNode.literal("true"))
		]), null)
		]);
		for (int index = releases.len - 1; index >= 0; index--) { statements.extend(releases.get(index)); }
		statements.extend(cleanup); statements.push(IRNode.returnStatement(called));
	}

	private void nativeInitializer(Node declaration, FeNativeOwnedOutput output, Vector<IRNode> arguments, Map<string, bool> parameterNames, Vector<IRNode> statements, Vector<Vector<IRNode>> releases, Vector<IRNode> cleanup) {
		string name = "__btrc_native_initializer";
		while (parameterNames.has(name)) { name = name + "_"; }
		Vector<IRNode> noArguments = [];
		IRNode owner = IRNode.variable(name);
		IRNode child = IRNode.fieldAccess(owner, "value", true);
		IRNode storage = IRNode.fieldAccess(child, "storage", true);
		IRNode backing = IRNode.fieldAccess(child, "input", true);
		IRNode native = IRNode.fieldAccess(child, "value", true);
		IRNode called = IRNode.fieldAccess(owner, "called", true);
		IRNode status = IRNode.fieldAccess(owner, "status", true);
		IRNode slot = IRNode.variableDeclaration(self.cTypes.lower(declaration.returnType), name, IRNode.call(output.resultName + "_new", noArguments));
		statements.extend([
			slot, IRNode.expressionStatement(self.managedLifetime.registerCleanupSlot(slot, self.managedValues.runtimeType(declaration.returnType))),
			IRNode.assignment(child, IRNode.call("__btrc_unique_" + output.resource + "_new", noArguments)),
			IRNode.assignment(storage, IRNode.call("calloc", [IRNode.literal("1"), IRNode.sizeofExpression(IRNode.dereference(storage))]))
		]);
		FeNativeInitializer shape = output.initializer;
		Vector<IRNode> nativeArguments = [];
		int visible = 0;
		for index in range(arguments.len + 1) {
			if (index == output.parameterIndex) { nativeArguments.push(storage); }
			else { nativeArguments.push(arguments.get(visible)); visible++; }
		}
		IRNode ready = IRNode.binary(storage, "!=", IRNode.literal("NULL"));
		if (shape.copiedInput >= 0) {
			IRNode source = nativeArguments.get(shape.copiedInput); IRNode length = nativeArguments.get(shape.length);
			IRNode invalid = self.nativeNullGuard(IRNode.literal("NULL"), f"Native call {declaration.name}: invalid copied input span");
			invalid.condition = IRNode.binary(IRNode.binary(IRNode.cast("uintmax_t", length), ">", IRNode.cast("uintmax_t", IRNode.variable("SIZE_MAX"))), "||", IRNode.binary(IRNode.binary(length, "!=", IRNode.literal("0")), "&&", IRNode.binary(source, "==", IRNode.literal("NULL"))));
			statements.push(invalid);
			statements.push(IRNode.ifStatement(ready, IRNode.block([
				IRNode.assignment(backing, IRNode.call("calloc", [IRNode.literal("1"), IRNode.ternary(IRNode.binary(length, "==", IRNode.literal("0")), IRNode.literal("1"), length)])),
				IRNode.ifStatement(IRNode.binary(IRNode.binary(backing, "!=", IRNode.literal("NULL")), "&&", IRNode.binary(length, "!=", IRNode.literal("0"))), IRNode.block([IRNode.expressionStatement(IRNode.call("memcpy", [backing, source, length]))]), null)
			]), null));
			ready = IRNode.binary(ready, "&&", IRNode.binary(backing, "!=", IRNode.literal("NULL")));
			nativeArguments.set(shape.copiedInput, IRNode.ternary(source, backing, IRNode.literal("NULL")));
		}
		statements.push(IRNode.ifStatement(ready, IRNode.block([
			IRNode.assignment(status, IRNode.call(declaration.name, nativeArguments)),
			IRNode.assignment(called, IRNode.literal("true")),
			IRNode.ifStatement(IRNode.binary(status, shape.success.isEmpty() ? "!=" : "==", shape.success.isEmpty() ? IRNode.literal("0") : IRNode.variable(shape.success)), IRNode.block([IRNode.assignment(native, storage)]), null)
		]), null));
		statements.push(IRNode.ifStatement(IRNode.binary(native, "==", IRNode.literal("NULL")), IRNode.block([
			IRNode.expressionStatement(IRNode.call("__btrc_native_" + output.resource + "_release", [child])), IRNode.assignment(child, IRNode.literal("NULL"))
		]), null));
		for group in releases { statements.extend(group); }
		statements.extend(cleanup); statements.push(IRNode.returnStatement(owner));
	}

	private void nativeResourceOutput(Node declaration, FeNativeOwnedOutput output, Vector<IRNode> arguments, Map<string, bool> parameterNames, Vector<IRNode> statements, Vector<Vector<IRNode>> releases, Vector<IRNode> cleanup) {
		Vector<string> names = [];
		for stem in ["owner", "value", "size"] {
			string name = "__btrc_native_output_" + stem;
			while (parameterNames.has(name) || names.contains(name)) { name = name + "_"; }
			names.push(name);
		}
		FeNativeSizedResourceOutput sized = output.sizedResource;
		var valueType = Node(); valueType.kind = NK_TYPE_EXPR; valueType.base = output.resource; valueType.isNullable = true; valueType.pointerDepth = 1;
		Vector<IRNode> noArguments = [];
		IRNode ownerSlot = IRNode.variableDeclaration(self.cTypes.lower(declaration.returnType), names.get(0), IRNode.call(output.resultName + "_new", noArguments));
		IRNode valueSlot = IRNode.variableDeclaration(output.resource, names.get(1), IRNode.literal("NULL")); valueSlot.isVolatile = true;
		IRNode sizeSlot = IRNode.variableDeclaration(self.cTypes.lower(sized.sizeType), names.get(2), IRNode.sizeofType(output.resource)); sizeSlot.isVolatile = true;
		IRNode owner = IRNode.variable(names.get(0)); IRNode value = IRNode.variable(names.get(1)); IRNode size = IRNode.variable(names.get(2));
		statements.extend([
			ownerSlot, IRNode.expressionStatement(self.managedLifetime.registerCleanupSlot(ownerSlot, self.managedValues.runtimeType(declaration.returnType))),
			valueSlot, IRNode.expressionStatement(self.managedLifetime.registerCleanupSlot(valueSlot, self.managedValues.runtimeType(valueType))), sizeSlot
		]);
		Vector<IRNode> nativeArguments = [];
		int visible = 0;
		for index in range(arguments.len + 2) {
			if (index == output.parameterIndex) { nativeArguments.push(IRNode.cast("void*", IRNode.addressOf(value))); }
			else if (index == sized.sizeIndex) { nativeArguments.push(IRNode.cast(self.cTypes.lower(sized.sizeType) + "*", IRNode.addressOf(size))); }
			else { nativeArguments.push(arguments.get(visible)); visible++; }
		}
		statements.extend([
			IRNode.assignment(IRNode.fieldAccess(owner, "status", true), IRNode.call(sized.nativeFunction, nativeArguments)),
			IRNode.assignment(IRNode.fieldAccess(owner, "size", true), size),
			IRNode.assignment(IRNode.fieldAccess(owner, "sizeValid", true), IRNode.binary(size, "==", IRNode.sizeofType(output.resource))),
			IRNode.assignment(IRNode.fieldAccess(owner, "value", true), IRNode.cast(self.cTypes.lower(valueType), value)),
			IRNode.assignment(value, IRNode.literal("NULL"))
		]);
		for (int index = releases.len - 1; index >= 0; index--) { statements.extend(releases.get(index)); }
		statements.extend(cleanup); statements.push(IRNode.returnStatement(owner));
	}

	private void nativeUniqueResult(Node declaration, IRNode call, Map<string, bool> parameterNames, Vector<IRNode> statements, Vector<Vector<IRNode>> releases, Vector<IRNode> cleanup) {
		string prefix = "__btrc_unique_" + declaration.returnType.base;
		string name = "__btrc_unique_result";
		while (parameterNames.has(name)) { name = name + "_"; }
		if (cleanup.len == 0) { cleanup.push(self.nativeCleanupScope(parameterNames, statements)); }
		Vector<IRNode> noArguments = [];
		IRNode slot = IRNode.variableDeclaration(self.cTypes.lower(declaration.returnType), name, IRNode.call(prefix + "_new", noArguments));
		IRNode result = IRNode.variable(name);
		IRNode value = IRNode.fieldAccess(result, "value", true);
		statements.push(slot);
		statements.push(IRNode.expressionStatement(self.managedLifetime.registerCleanupSlot(slot, self.managedValues.runtimeType(declaration.returnType))));
		statements.push(IRNode.assignment(value, call));
		statements.push(IRNode.ifStatement(IRNode.binary(value, "==", IRNode.literal("NULL")), IRNode.block([
			IRNode.expressionStatement(IRNode.call("__btrc_native_" + declaration.returnType.base + "_release", [result])), IRNode.assignment(result, IRNode.literal("NULL"))
		]), null));
		for (int index = releases.len - 1; index >= 0; index--) { statements.extend(releases.get(index)); }
		if (!declaration.returnType.isNullable) { statements.push(self.nativeNullGuard(result, f"Native call {declaration.name}: null result")); }
		statements.extend(cleanup); statements.push(IRNode.returnStatement(result));
	}

	private IRNode nativeRecordInput(FeNativeRecordInput projection, IRNode value, Vector<IRNode> locals, Vector<IRNode> statements, string callName, string path, Map<string, bool> parameterNames, Map<string, FeNativeRecordInput> recordTypes, Vector<Vector<IRNode>> releases, string prefix = "", bool byValue = false) {
		/* Declare nested SDK storage at adapter scope, outside conditional initialization. */
		string name = f"__btrc_record_input_{locals.len}";
		while (parameterNames.has(name)) { name = name + "_"; }
		IRNode native = IRNode.variable(name);
		locals.push(IRNode.variableDeclaration(projection.nativeSpelling, name, IRNode.initializerList([IRNode.literal("0")])));
		Vector<IRNode> assignments = [];
		for field in projection.fields {
			if (field.callback) { continue; }
			IRNode source = IRNode.fieldAccess(value, field.name, true);
			IRNode target = IRNode.fieldAccess(native, field.name, false);
			string fieldPath = path + "." + field.name;
			if ((!field.record.isEmpty() || field.managed()) && !field.valueType.isNullable) { assignments.push(self.nativeNullGuard(source, f"Native call {callName}: null input {fieldPath}", false)); }
			if (!field.record.isEmpty()) { source = self.nativeRecordInput(recordTypes.get(field.record), source, locals, assignments, callName, fieldPath, parameterNames, recordTypes, releases, field.prefix, field.byValue); }
			else if (field.managed()) { source = self.emitNativeLease(parameterNames.len + locals.len, self.analyzed.classMember(projection.inputName(), field.name).type, source, parameterNames, assignments, releases, false, locals); source = IRNode.cast(field.resourceType.isEmpty() ? "void*" : field.resourceType, source); }
			assignments.push(IRNode.assignment(target, source));
		}
		statements.push(IRNode.ifStatement(IRNode.binary(value, "!=", IRNode.literal("NULL")), IRNode.block(assignments), null));
		if (projection.byValue || byValue) { return native; }
		IRNode address = IRNode.addressOf(prefix.isEmpty() ? native : IRNode.fieldAccess(native, prefix, false));
		return IRNode.ternary(IRNode.binary(value, "==", IRNode.literal("NULL")), IRNode.literal("NULL"), address);
	}

	private IRModule objectiveCUnit(FeNativeImportedDeclaration imported, IRModule module) {
		if (!module.nativeUnits.has("ObjectiveCAdapters")) { var unit = IRModule(); unit.language = "objective-c"; module.nativeUnits.put("ObjectiveCAdapters", unit); }
		IRModule native = module.nativeUnits.get("ObjectiveCAdapters");
		self.appendPreprocessorDecl(native, IRPreprocessorDecl.include("stdlib.h", true));
		for header in imported.headers { self.appendPreprocessorDecl(native, IRPreprocessorDecl.include(header, false)); }
		var records = Node();
		records.kind = NK_PROGRAM;
		for importedRecord in self.analyzed.nativeDeclarations {
			if (importedRecord.declaration.kind == NK_STRUCT_DECL && importedRecord.language == "objective-c" && !importedRecord.coalesced) { records.declarations.push(importedRecord.declaration); }
		}
		for record in DeclarationValidator.orderedStructDefinitions(records, self.analyzed.structTable) {
			string name = "__btrc_value_" + record.name;
			bool declared = false;
			for definition in native.structDefs { if (definition.name == name) { declared = true; } }
			if (declared) { continue; }
			var definition = IRStructDef();
			definition.name = name;
			for field in record.fields { definition.fields.push(IRStructField(self.cTypes.lower(field.type), field.name)); }
			native.structForwards.push(IRStructForward(name));
			native.structDefs.push(definition);
			module.structForwards.push(IRStructForward(name));
			module.structDefs.push(definition);
		}
		return native;
	}

	private bool objectiveCRecord(Node type) { return type.pointerDepth == 0 && !type.isArray && self.analyzed.isObjectiveCRecord(type.base); }

	private IRNode objectiveCValue(Node type, IRNode value, bool toNative) {
		if (!self.objectiveCRecord(type)) { return value; }
		Node record = self.analyzed.structTable.get(type.base);
		Vector<string> names = [];
		Vector<IRNode> values = [];
		for field in record.fields {
			names.push(field.name);
			values.push(self.objectiveCValue(field.type, IRNode.fieldAccess(value, field.name, false), toNative));
		}
		string spelling = toNative ? self.analyzed.nativeTypeSpelling(type.base) : self.cTypes.lower(type);
		return IRNode.compoundLiteral(spelling, names, values);
	}

	private void emitNativeGlobal(FeNativeImportedDeclaration imported, IRModule module) {
		if (imported.language == "c") {
			Node declaration = imported.declaration;
			var accessor = IRFunction();
			accessor.name = "__btrc_native_read_" + declaration.name;
			accessor.returnType = self.cTypes.lower(declaration.type);
			accessor.isStatic = true;
			string resultName = "__btrc_native_global_result";
			while (resultName == declaration.name) { resultName = resultName + "_"; }
			IRNode result = IRNode.variable(resultName);
			Vector<IRNode> statements = [IRNode.variableDeclaration(accessor.returnType, resultName, IRNode.cast(accessor.returnType, IRNode.variable(declaration.name)))];
			if (!declaration.type.isNullable) { statements.push(self.nativeNullGuard(result, f"Native global {declaration.name}: null result")); }
			statements.push(IRNode.expressionStatement(self.managedLifetime.retainValue(result, declaration.type)));
			statements.push(IRNode.returnStatement(result));
			accessor.body = IRNode.block(statements);
			module.functionDecls.push(IRFunctionDecl(accessor.name, accessor.returnType, true));
			module.functions.push(accessor);
			return;
		}
		IRModule native = self.objectiveCUnit(imported, module);
		if (self.analyzed.nativeGlobalReturnsOwned(imported.declaration.name)) {
			self.emitObjectiveCObjectGlobal(imported, module, native);
			return;
		}
		var adapter = IRFunction();
		adapter.name = "__btrc_objc_address_" + imported.declaration.name;
		adapter.returnType = self.cTypes.lower(imported.declaration.type) + "*";
		adapter.body = IRNode.block([IRNode.returnStatement(IRNode.addressOf(IRNode.variable(imported.declaration.name)))]);
		native.functions.push(adapter);
		module.functionDecls.push(IRFunctionDecl(adapter.name, adapter.returnType, false));
	}

	private void emitObjectiveCObjectGlobal(FeNativeImportedDeclaration imported, IRModule module, IRModule native) {
		Node declaration = imported.declaration;
		var wrapper = IRFunction();
		wrapper.name = "__btrc_objc_read_" + declaration.name;
		wrapper.returnType = self.cTypes.lower(declaration.type);
		wrapper.isStatic = true;
		var adapter = IRFunction();
		adapter.name = wrapper.name + "_adapter";
		adapter.returnType = "int";
		adapter.params.push(IRParam(wrapper.returnType + "*", "nativeResult"));
		IRNode result = IRNode.variable("nativeResult");
		IRNode value = IRNode.cast(wrapper.returnType, IRNode.variable(declaration.name), "retain");
		IRNode body = IRNode.block([IRNode.assignment(IRNode.dereference(result), value), IRNode.returnStatement(IRNode.literal("0"))]);
		IRNode failureBody = IRNode.block([IRNode.returnStatement(IRNode.literal("1"))]);
		adapter.body = IRNode.block([IRNode.objectiveCAutoreleasePool(IRNode.block([IRNode.objectiveCExceptionBoundary(body, failureBody)]))]);
		native.functions.push(adapter);
		var external = IRFunctionDecl(adapter.name, "int", false);
		external.params = adapter.params;
		module.functionDecls.push(external);
		self.context.referenceHelper("__btrc_throw");
		IRNode failure = IRNode.call("__btrc_throw", [IRNode.literal("\"Objective-C exception reading " + declaration.name + "\"")]);
		failure.neverReturns = true;
		Vector<IRNode> statements = [
			IRNode.variableDeclaration(wrapper.returnType, "nativeResult", IRNode.literal("0")),
			IRNode.ifStatement(IRNode.call(adapter.name, [IRNode.addressOf(result)]), IRNode.block([IRNode.expressionStatement(failure)]), null)
		];
		if (imported.callContract != null && imported.callContract.executor == "main") {
			self.appendPreprocessorDecl(module, IRPreprocessorDecl.include("pthread.h", true));
			Vector<IRNode> noArguments = [];
			IRNode guard = IRNode.ifStatement(IRNode.binary(IRNode.call("pthread_main_np", noArguments), "==", IRNode.literal("0")), IRNode.block([self.objectiveCNullGuard(IRNode.literal("NULL"), "Native global " + declaration.name + " requires the main thread")]), null);
			Vector<IRNode> guarded = [guard];
			guarded.extend(statements);
			statements = guarded;
		}
		if (!declaration.type.isNullable) { statements.push(self.objectiveCNullGuard(result, "Objective-C global " + declaration.name + ": null result")); }
		statements.push(IRNode.returnStatement(result));
		wrapper.body = IRNode.block(statements);
		module.functionDecls.push(IRFunctionDecl(wrapper.name, wrapper.returnType, true));
		module.functions.push(wrapper);
	}

	private void emitObjectiveCAdapters(FeNativeImportedDeclaration imported, IRModule module) {
		IRModule native = self.objectiveCUnit(imported, module);
		for declaration in self.analyzed.nativeDeclarations {
			if (declaration.declaration.kind != NK_CLASS_DECL || declaration.language != "objective-c") { continue; }
			string opaqueName = "__btrc_native_" + declaration.declaration.name;
			bool declared = false;
			for forward in native.structForwards { if (forward.name == opaqueName) { declared = true; } }
			if (!declared) {
				native.structForwards.push(IRStructForward(opaqueName));
				module.structForwards.push(IRStructForward(opaqueName));
			}
		}
		self.emitObjectiveCLifetime(imported, module, native);
		for method in imported.declaration.members {
			var contract = imported.methods.get(method.name);
			if (contract.callbacks.len > 0 && contract.callbacks.get(0).oneShot) {
				self.emitOneShotObjectiveCAdapter(imported, method, contract, module, native);
				continue;
			}
			if (contract.callbacks.len > 0 && contract.callbacks.get(0).unregister != null) {
				self.emitStoredObjectiveCAdapter(imported, method, contract, module, native);
				continue;
			}
			NativeNode descriptor = contract.objectiveCMethod;
			bool initializer = descriptor.methodFamily == "init" && !descriptor.classMethod && descriptor.relatedResult;
			bool classFactory = descriptor.classMethod || initializer;
			Map<int, FeNativeCallbackProjection> callbacks = {};
			for callback in contract.callbacks { callbacks.put(callback.parameterIndex, callback); }
			int offset = classFactory ? 0 : 1;
			string name = imported.declaration.name + "_" + method.name;
			var wrapper = IRFunction();
			wrapper.name = name;
			wrapper.returnType = self.cTypes.lower(method.returnType);
			wrapper.isStatic = true;
			var adapter = IRFunction();
			adapter.name = "__btrc_objc_" + name;
			adapter.returnType = "int";
			Vector<IRNode> arguments = [];
			Vector<IRNode> nativeArguments = [];
			IRNode receiver = IRNode.variable(imported.declaration.name);
			if (initializer) { Vector<IRNode> allocationArguments = []; receiver = IRNode.objectiveCMessage(receiver, "alloc", allocationArguments); }
			if (!classFactory) {
				var parameter = IRParam("struct __btrc_native_" + imported.declaration.name + "*", "self");
				wrapper.params.push(parameter);
				adapter.params.push(parameter);
				arguments.push(IRNode.variable("self"));
				receiver = IRNode.cast(self.objectiveCObjectType(imported.declaration.name), IRNode.variable("self"), "borrow");
			}
			for index in range(method.params.len) {
				Node parameter = method.params.get(index);
				var lowered = self.cTypes.lowerParameter(parameter);
				wrapper.params.push(lowered);
				arguments.push(IRNode.variable(parameter.name));
				if (callbacks.has(index)) {
					var callback = callbacks.get(index);
					var valueTypes = self.nativeCallbackTypes(callback);
					var signature = IRFunctionPointerTypedef(f"{adapter.name}_callback{index}", self.cTypes.lower(callback.returnType));
					for value in valueTypes { signature.paramTypes.push(self.cTypes.lower(value)); }
					module.functionPointerTypedefs.push(signature);
					native.functionPointerTypedefs.push(signature);
					adapter.params.push(IRParam(signature.name, parameter.name));
					adapter.params.push(IRParam("void*", parameter.name + "Context"));
					var block = IRNode();
					block.kind = IRK_OBJECTIVE_C_BLOCK;
					block.targetType = callback.nativeReturn;
					block.params = [];
					Vector<IRNode> forwarded = [];
					for position in range(callback.nativeParameters.len) {
						string localName = f"__btrc_block_value{position}";
						block.params.push(IRParam(callback.nativeParameters.get(position), localName));
						Node valueType = valueTypes.get(position);
						IRNode value = IRNode.variable(localName);
						if (self.managedValues.isNative(valueType)) { value = IRNode.cast(self.cTypes.lower(valueType), value, "borrow"); }
						forwarded.push(value);
					}
					forwarded.push(IRNode.variable(parameter.name + "Context"));
					IRNode call = IRNode.indirectCall(IRNode.variable(parameter.name), forwarded);
					block.body = signature.returnType == "void" ? IRNode.block([IRNode.expressionStatement(call), IRNode.returnStatement(null)]) : IRNode.block([IRNode.returnStatement(IRNode.cast(callback.nativeReturn, call))]);
					nativeArguments.push(block);
					continue;
				}
				adapter.params.push(lowered);
				IRNode argument = IRNode.variable(parameter.name);
				if (self.managedValues.isNative(parameter.type)) { argument = IRNode.cast(self.objectiveCObjectType(parameter.type.base), argument, "borrow"); }
				else { argument = self.objectiveCValue(parameter.type, argument, true); }
				nativeArguments.push(argument);
			}
			bool returnsValue = wrapper.returnType != "void";
			IRNode result = IRNode.variable("nativeResult");
			IRNode message = IRNode.objectiveCMessage(receiver, descriptor.selector, nativeArguments);
			if (self.managedValues.isNative(method.returnType)) { message = IRNode.cast(wrapper.returnType, message, "retain"); }
			Vector<IRNode> body = [];
			bool recordReturn = self.objectiveCRecord(method.returnType);
			if (recordReturn) {
				body.push(IRNode.variableDeclaration(self.analyzed.nativeTypeSpelling(method.returnType.base), "sdkResult", message));
				message = self.objectiveCValue(method.returnType, IRNode.variable("sdkResult"), false);
			}
			if (returnsValue) {
				string outputType = self.managedValues.isNative(method.returnType) ? wrapper.returnType + " volatile" : wrapper.returnType;
				adapter.params.push(IRParam(outputType + "*", "nativeResult"));
				body.push(IRNode.assignment(IRNode.dereference(result), message));
			} else { body.push(IRNode.expressionStatement(message)); }
			body.push(IRNode.returnStatement(IRNode.literal("0")));
			adapter.body = IRNode.block([IRNode.objectiveCAutoreleasePool(IRNode.block([IRNode.objectiveCExceptionBoundary(IRNode.block(body), IRNode.block([IRNode.returnStatement(IRNode.literal("1"))]))]))]);
			native.functions.push(adapter);
			var external = IRFunctionDecl(adapter.name, "int", false);
			external.params = adapter.params;
			module.functionDecls.push(external);
			Vector<IRNode> statements = [];
			Vector<IRNode> callArguments = [];
			callArguments.extend(arguments);
			if (returnsValue) {
				bool aggregateReturn = method.returnType.pointerDepth == 0 && !method.returnType.isArray && self.analyzed.structTable.has(method.returnType.base);
				IRNode initial = aggregateReturn ? IRNode.initializerList([IRNode.literal("0")]) : IRNode.literal("0");
				statements.push(IRNode.variableDeclaration(wrapper.returnType, "nativeResult", initial));
				callArguments.push(IRNode.addressOf(result));
			}
			self.context.referenceHelper("__btrc_throw");
			if (!classFactory) { statements.push(self.objectiveCNullGuard(IRNode.variable("self"), "Objective-C call " + descriptor.name + ": null argument self")); }
			for index in range(method.params.len) {
				Node parameter = method.params.get(index);
				if (callbacks.has(index) || (parameter.type.pointerDepth > 0 && !parameter.type.isNullable)) { statements.push(self.objectiveCNullGuard(IRNode.variable(parameter.name), "Objective-C call " + descriptor.name + ": null argument " + parameter.name)); }
			}
			Vector<Node> argumentTypes = [];
			if (!classFactory) {
				Node selfType = Node();
				selfType.kind = NK_TYPE_EXPR;
				selfType.base = imported.declaration.name;
				selfType.pointerDepth = 1;
				argumentTypes.push(selfType);
			}
			for parameter in method.params { argumentTypes.push(parameter.type); }
			Map<string, bool> parameterNames = {};
			for parameter in wrapper.params { parameterNames.put(parameter.name, true); }
			Vector<Vector<IRNode>> releases = [];
			Vector<IRNode> cleanup = [];
			for index in range(argumentTypes.len) {
				Node valueType = argumentTypes.get(index);
				if (!self.managedValues.isNative(valueType) && !callbacks.has(index - offset)) { continue; }
				if (cleanup.len == 0) { cleanup.push(self.nativeCleanupScope(parameterNames, statements)); }
				callArguments.set(index, self.emitNativeLease(index, valueType, callArguments.get(index), parameterNames, statements, releases));
			}
			Vector<IRNode> expanded = [];
			for index in range(arguments.len) {
				if (callbacks.has(index - offset)) { expanded.extend(self.emitNativeCallbackContext(name, callbacks.get(index - offset), callArguments.get(index), parameterNames, statements, module)); }
				else { expanded.push(callArguments.get(index)); }
			}
			if (returnsValue) { expanded.push(IRNode.addressOf(result)); }
			IRNode failure = IRNode.call("__btrc_throw", [IRNode.literal("\"Objective-C exception in " + descriptor.name + "\"")]);
			failure.neverReturns = true;
			statements.push(IRNode.ifStatement(IRNode.call(adapter.name, expanded), IRNode.block([IRNode.expressionStatement(failure)]), null));
			if (releases.len > 0 && self.managedValues.isNative(method.returnType)) { statements.push(IRNode.expressionStatement(self.managedLifetime.registerCleanupSlot(statements.get(0), self.managedValues.runtimeType(method.returnType)))); }
			for (int index = releases.len - 1; index >= 0; index--) { statements.extend(releases.get(index)); }
			if (contract.callbacks.len > 0) { statements.push(IRNode.expressionStatement(self.managedLifetime.flushCycles())); }
			statements.extend(cleanup);
			if (returnsValue) {
				if (self.managedValues.isNative(method.returnType) && !method.returnType.isNullable) { statements.push(self.objectiveCNullGuard(result, "Objective-C call " + descriptor.name + ": null result")); }
				statements.push(IRNode.returnStatement(result));
			}
			wrapper.body = IRNode.block(statements);
			var prototype = IRFunctionDecl(name, wrapper.returnType, true);
			prototype.params = wrapper.params;
			module.functionDecls.push(prototype);
			module.functions.push(wrapper);
		}
	}

	private void emitStoredContextLifetime(string prefix, Node contextType, string contextSymbol, IRModule module) {
		IRNode context = IRNode.cast(self.cTypes.lower(contextType), IRNode.variable("rawContext"));
		for operation in ["retain", "release"] {
			var thunk = IRFunction();
			thunk.name = prefix + "_" + operation;
			thunk.returnType = "void";
			thunk.isStatic = true;
			thunk.params = [IRParam("void*", "rawContext")];
			/* A foreign root uses an ordinary non-field ARC claim. Its access
			 * check also applies when native ARC destroys the captured holder. */
			IRNode action = operation == "retain" ? self.managedLifetime.retainValue(context, contextType) : self.managedLifetime.releaseValue(context, contextType);
			thunk.body = self.nativeCallbackBoundary([
				IRNode.expressionStatement(IRNode.call(contextSymbol + "_isOpen", [context])),
				IRNode.expressionStatement(action),
				IRNode.expressionStatement(IRNode.unary("--", IRNode.variable("__btrc_try_top"), false))
			], module);
			self.appendFunction(thunk, module);
		}
	}

	private string emitStoredContextHolder(string prefix, string lifetimeType, IRModule native) {
		string name = prefix + "Holder";
		Vector<IRParam> noParameters = [];
		var holder = IRObjectiveCClass(name, "NSObject");
		holder.fields = [IRStructField("void*", "_context"), IRStructField(lifetimeType, "_release")];
		holder.methods = [
			IRObjectiveCMethod("configure:retain:release:", "void", [IRParam("void*", "context"), IRParam(lifetimeType, "retainContext"), IRParam(lifetimeType, "releaseContext")], IRNode.block([
			IRNode.expressionStatement(IRNode.indirectCall(IRNode.variable("retainContext"), [IRNode.variable("context")])),
			IRNode.assignment(IRNode.variable("_context"), IRNode.variable("context")),
			IRNode.assignment(IRNode.variable("_release"), IRNode.variable("releaseContext"))
		])),
			IRObjectiveCMethod("context", "void*", noParameters, IRNode.block([IRNode.returnStatement(IRNode.variable("_context"))])),
			IRObjectiveCMethod("dealloc", "void", noParameters, IRNode.block([
			IRNode.ifStatement(IRNode.variable("_context"), IRNode.block([IRNode.expressionStatement(IRNode.indirectCall(IRNode.variable("_release"), [IRNode.variable("_context")]))]), null)
		]))
		];
		native.objectiveCClasses.push(holder);
		return name;
	}

	private IRNode nativeStringView(int index, FeNativeStringView view, IRNode argument, IRNode receiver, Node valueType, Map<string, bool> parameterNames, Vector<IRNode> statements, Vector<Vector<IRNode>> releases) {
		IRNode value = self.emitNativeLease(index, valueType, IRNode.literal("NULL"), parameterNames, statements, releases, true);
		IRNode data = IRNode.fieldAccess(argument, view.data, false);
		IRNode length = IRNode.fieldAccess(argument, view.length, false);
		IRNode present = IRNode.binary(data, "!=", IRNode.literal("NULL"));
		IRNode nonempty = IRNode.binary(present, "&&", IRNode.binary(length, "!=", IRNode.literal("0")));
		IRNode invalidNull = IRNode.binary(length, "!=", IRNode.literal("0"));
		if (view.nullMaximum) { invalidNull = IRNode.binary(invalidNull, "&&", IRNode.binary(length, "!=", IRNode.cast(view.lengthSpelling, IRNode.literal("-1")))); }
		Vector<IRNode> conditions = [
			IRNode.binary(IRNode.binary(data, "==", IRNode.literal("NULL")), "&&", invalidNull),
			IRNode.binary(present, "&&", IRNode.binary(IRNode.cast("unsigned long long", length), ">", IRNode.literal("2147483647ULL"))),
			IRNode.binary(nonempty, "&&", IRNode.binary(IRNode.call("memchr", [data, IRNode.literal("0"), IRNode.cast("size_t", length)]), "!=", IRNode.literal("NULL")))
		];
		Vector<string> messages = ["null data with nonempty length", "byte length exceeds BTRC string range", "embedded NUL cannot be represented as a BTRC string"];
		Vector<IRNode> body = [];
		for position in range(conditions.len) {
			IRNode guard = self.nativeNullGuard(data, "Native string view: " + messages.get(position));
			guard.condition = conditions.get(position);
			body.push(guard);
		}
		body.push(IRNode.assignment(value, IRNode.ternary(nonempty, IRNode.call("__btrc_string_alloc", [IRNode.cast("int", length)]), IRNode.literal("\"\""))));
		body.push(IRNode.ifStatement(nonempty, IRNode.block([IRNode.expressionStatement(IRNode.call("memcpy", [value, data, IRNode.cast("size_t", length)]))]), null));
		statements.push(IRNode.ifStatement(receiver, IRNode.block(body), null));
		return value;
	}

	private string emitStoredContextInvoker(string prefix, FeNativeCallbackProjection callback, Node contextType, string contextSymbol, IRModule module, bool consumeNativeClaim = false) {
		var valueTypes = self.nativeCallbackTypes(callback);
		var thunk = IRFunction();
		thunk.name = prefix + "_invoke";
		thunk.returnType = self.cTypes.lower(callback.returnType);
		bool returnsValue = thunk.returnType != "void";
		thunk.isStatic = true;
		Map<string, bool> parameterNames = {};
		for index in range(valueTypes.len) {
			string name = f"argument{index}";
			string parameterType = callback.stringArguments.has(index) ? callback.stringArguments.get(index).nativeSpelling : callback.ownedArguments.contains(index) ? callback.parameters.get(index).base : self.cTypes.lower(valueTypes.get(index));
			thunk.params.push(IRParam(parameterType, name));
			parameterNames.put(name, true);
		}
		IRNode context = IRNode.cast(self.cTypes.lower(contextType), IRNode.variable(thunk.params.get(callback.callbackContextIndex).name));
		Node receiverType = contextType.genericArgs.get(0);
		IRNode receiver = IRNode.variable("receiver");
		IRNode receiverSlot = IRNode.variableDeclaration(self.cTypes.lower(receiverType), "receiver", IRNode.call(contextSymbol + "_enter", [context]));
		Vector<IRNode> body = [];
		IRNode cleanup = self.nativeCleanupScope(parameterNames, body);
		for index in callback.callbackContextIndices {
			if (index == callback.callbackContextIndex) { continue; }
			IRNode value = IRNode.variable(thunk.params.get(index).name);
			IRNode guard = self.nativeNullGuard(value, f"Native callback {prefix}: inconsistent context slots");
			guard.condition = IRNode.binary(value, "!=", IRNode.variable(thunk.params.get(callback.callbackContextIndex).name));
			body.push(guard);
		}
		body.push(receiverSlot);
		body.push(IRNode.expressionStatement(self.managedLifetime.registerCleanupSlot(receiverSlot, self.managedValues.runtimeType(receiverType))));
		if (returnsValue) {
			body.push(self.objectiveCNullGuard(receiver, f"Stored callback {prefix}: query after cancellation"));
			IRNode resultSlot = IRNode.variableDeclaration(thunk.returnType, "result", IRNode.literal("0"));
			body.push(resultSlot);
			if (self.managedValues.isNative(callback.returnType)) { body.push(IRNode.expressionStatement(self.managedLifetime.registerCleanupSlot(resultSlot, self.managedValues.runtimeType(callback.returnType)))); }
		}
		Vector<IRNode> arguments = [receiver];
		Vector<Vector<IRNode>> releases = [];
		for index in range(valueTypes.len) {
			if (callback.isContext(index)) { continue; }
			Node valueType = valueTypes.get(index);
			IRNode value = IRNode.variable(thunk.params.get(index).name);
			if (callback.stringArguments.has(index)) {
				arguments.push(self.nativeStringView(index, callback.stringArguments.get(index), value, receiver, valueType, parameterNames, body, releases));
				continue;
			}
			bool owned = callback.ownedArguments.contains(index);
			if (owned) { value = IRNode.cast(self.cTypes.lower(valueType), value); }
			if (self.managedValues.isNative(valueType)) {
				if (!valueType.isNullable) { body.push(self.objectiveCNullGuard(value, f"Stored callback {prefix}: null argument {index}")); }
				value = self.emitNativeLease(index, valueType, value, parameterNames, body, releases, owned);
			}
			arguments.push(value);
		}
		IRNode invocation = IRNode.call(callback.interfaceName + "_" + callback.methodName, arguments);
		body.push(IRNode.ifStatement(receiver, IRNode.block([
			returnsValue ? IRNode.assignment(IRNode.variable("result"), invocation) : IRNode.expressionStatement(invocation),
			IRNode.expressionStatement(IRNode.call(contextSymbol + "_leave", [context]))
		]), null));
		for (int index = releases.len - 1; index >= 0; index--) { body.extend(releases.get(index)); }
		self.releaseStoredLocal(receiver, receiverType, "releasedReceiver", body);
		if (callback.oneShot) { body.push(IRNode.expressionStatement(IRNode.call(contextSymbol + "_complete", [context]))); }
		if (consumeNativeClaim) { body.push(IRNode.expressionStatement(self.managedLifetime.releaseValue(context, contextType))); }
		body.push(cleanup);
		body.push(IRNode.expressionStatement(IRNode.unary("--", IRNode.variable("__btrc_try_top"), false)));
		if (returnsValue) { body.push(IRNode.returnStatement(IRNode.variable("result"))); }
		thunk.body = self.nativeCallbackBoundary(body, module);
		self.appendFunction(thunk, module);
		return thunk.name;
	}

	private void emitOneShotCAdapter(Node declaration, FeNativeCallContract contract, IRModule module) {
		FeNativeCallbackProjection callback = contract.callbacks.get(0);
		var adapter = IRFunction();
		adapter.name = contract.adapterSymbol(declaration.name);
		adapter.returnType = self.cTypes.lower(declaration.returnType);
		adapter.isStatic = true;
		bool returnsValue = declaration.returnType.base == "CallbackResult";
		Node contextType = returnsValue ? declaration.returnType.genericArgs.get(1) : declaration.returnType;
		string contextSymbol = TypeIdentity.mangleGenericSymbol(contextType.base, contextType.genericArgs);
		string invoke = self.emitStoredContextInvoker(adapter.name, callback, contextType, contextSymbol, module, true);
		Map<string, bool> parameterNames = {};
		Vector<IRNode> arguments = [];
		for parameter in declaration.params { adapter.params.push(self.cTypes.lowerParameter(parameter)); parameterNames.put(parameter.name, true); arguments.push(IRNode.variable(parameter.name)); }
		Vector<IRNode> body = [];
		IRNode cleanup = self.nativeCleanupScope(parameterNames, body);
		Vector<Vector<IRNode>> releases = [];
		for index in range(declaration.params.len) {
			Node parameter = declaration.params.get(index);
			if (contract.nonnullParameters.get(index)) { body.push(self.nativeNullGuard(arguments.get(index), f"Native call {declaration.name}: null {parameter.name}", false)); }
			if (self.analyzed.classTable.has(parameter.type.base) || self.analyzed.interfaceTable.has(parameter.type.base) || self.analyzed.genericClassTable.has(parameter.type.base)) { arguments.set(index, self.emitNativeLease(index, parameter.type, arguments.get(index), parameterNames, body, releases)); }
		}
		int receiverIndex = callback.parameterIndex - (callback.contextIndex >= 0 && callback.contextIndex < callback.parameterIndex ? 1 : 0);
		IRNode receiver = arguments.get(receiverIndex);
		if (!callback.field.isEmpty()) {
			receiver = IRNode.fieldAccess(receiver, callback.field, true);
			body.push(self.nativeNullGuard(receiver, f"Native call {declaration.name}: null callback {callback.field}", false));
			Node inputType = declaration.params.get(receiverIndex).type;
			receiver = self.emitNativeLease(arguments.len, self.analyzed.classMember(inputType.base, callback.field).type, receiver, parameterNames, body, releases);
		}
		Vector<IRNode> locals = [];
		for index in range(contract.recordInputs.len) {
			var projection = contract.recordInputs.get(index);
			if (projection != null) { arguments.set(index, self.nativeRecordInput(projection, arguments.get(index), locals, body, declaration.name, declaration.params.get(index).name, parameterNames, contract.recordTypes, releases)); }
		}
		locals.extend(body);
		body = locals;
		for index in range(contract.resourceParameters.len) { if (!contract.resourceParameters.get(index).isEmpty()) { arguments.set(index, IRNode.cast(contract.resourceParameters.get(index), arguments.get(index))); } }
		Vector<IRNode> nativeArguments = [];
		int visible = 0;
		for index in range(arguments.len - 1 + (callback.contextIndex >= 0 ? 1 : 0)) {
			if (index == callback.contextIndex) { nativeArguments.push(IRNode.literal("NULL")); }
			else { nativeArguments.push(arguments.get(visible)); visible++; }
		}
		string contextName = "__btrc_native_request";
		while (parameterNames.has(contextName)) { contextName = contextName + "_"; }
		IRNode context = IRNode.variable(contextName);
		IRNode slot = IRNode.variableDeclaration(self.cTypes.lower(contextType), contextName, IRNode.call(contextSymbol + "_new", [receiver]));
		body.push(slot);
		body.push(IRNode.expressionStatement(self.managedLifetime.registerCleanupSlot(slot, self.managedValues.runtimeType(contextType))));
		IRNode result = context;
		if (returnsValue) {
			string resultName = "__btrc_native_result";
			while (parameterNames.has(resultName)) { resultName = resultName + "_"; }
			string resultSymbol = TypeIdentity.mangleGenericSymbol(declaration.returnType.base, declaration.returnType.genericArgs);
			IRNode resultSlot = IRNode.variableDeclaration(adapter.returnType, resultName, IRNode.call(resultSymbol + "_new", [context]));
			result = IRNode.variable(resultName);
			body.push(resultSlot);
			body.push(IRNode.expressionStatement(self.managedLifetime.registerCleanupSlot(resultSlot, self.managedValues.runtimeType(declaration.returnType))));
		}
		body.push(IRNode.expressionStatement(IRNode.call(contextSymbol + "_activate", [context, arguments.get(arguments.len - 1)])));
		body.push(IRNode.expressionStatement(self.managedLifetime.retainValue(context, contextType)));
		if (!callback.field.isEmpty()) {
			IRNode descriptor = nativeArguments.get(callback.parameterIndex);
			body.push(IRNode.assignment(IRNode.fieldAccess(descriptor, callback.field, false), IRNode.functionReference(invoke)));
			for field in callback.contextFields { body.push(IRNode.assignment(IRNode.fieldAccess(descriptor, field, false), IRNode.cast("void*", context))); }
		} else {
			nativeArguments.set(callback.parameterIndex, IRNode.functionReference(invoke));
			nativeArguments.set(callback.contextIndex, IRNode.cast("void*", context));
		}
		IRNode nativeCall = IRNode.call(declaration.name, nativeArguments);
		if (returnsValue) {
			body.push(IRNode.assignment(IRNode.fieldAccess(result, "value", true), nativeCall));
		} else { body.push(IRNode.expressionStatement(nativeCall)); }
		body.push(IRNode.expressionStatement(IRNode.call(contextSymbol + "_publish", [context])));
		if (returnsValue) { body.push(IRNode.expressionStatement(self.managedLifetime.releaseValue(context, contextType))); body.push(IRNode.assignment(context, IRNode.literal("NULL"))); }
		for (int index = releases.len - 1; index >= 0; index--) { body.extend(releases.get(index)); }
		body.push(cleanup);
		body.push(IRNode.returnStatement(result));
		adapter.body = IRNode.block(body);
		self.appendFunction(adapter, module);
	}

	private void emitOneShotObjectiveCAdapter(FeNativeImportedDeclaration imported, Node method, FeNativeCallContract contract, IRModule module, IRModule native) {
		Vector<IRNode> noArguments = [];
		NativeNode descriptor = contract.objectiveCMethod;
		FeNativeCallbackProjection callback = contract.callbacks.get(0);
		string name = imported.declaration.name + "_" + method.name;
		string prefix = "__btrc_objc_" + name;
		Node contextType = method.returnType;
		string contextSymbol = TypeIdentity.mangleGenericSymbol(contextType.base, contextType.genericArgs);
		string contextC = self.cTypes.lower(contextType);
		self.emitStoredContextLifetime(prefix, contextType, contextSymbol, module);
		string invoke = self.emitStoredContextInvoker(prefix, callback, contextType, contextSymbol, module);
		var values = self.nativeCallbackTypes(callback);
		var lifetime = IRFunctionPointerTypedef(prefix + "_lifetime", "void");
		lifetime.paramTypes = ["void*"];
		var invocation = IRFunctionPointerTypedef(prefix + "_callback", "void");
		for value in values { invocation.paramTypes.push(self.cTypes.lower(value)); }
		for definition in [lifetime, invocation] {
			module.functionPointerTypedefs.push(definition);
			native.functionPointerTypedefs.push(definition);
		}
		string holderName = self.emitStoredContextHolder(prefix, lifetime.name, native);
		var wrapper = IRFunction();
		wrapper.name = name;
		wrapper.returnType = contextC;
		wrapper.isStatic = true;
		Vector<Node> parameterTypes = [];
		int offset = descriptor.classMethod ? 0 : 1;
		if (offset != 0) {
			Node source = Node(); source.kind = NK_TYPE_EXPR; source.base = imported.declaration.name; source.pointerDepth = 1;
			wrapper.params.push(IRParam(self.cTypes.lower(source), "self"));
			parameterTypes.push(source);
		}
		for parameter in method.params {
			wrapper.params.push(self.cTypes.lowerParameter(parameter));
			parameterTypes.push(parameter.type);
		}
		IRNode nativeReceiver = offset == 0 ? IRNode.variable(imported.declaration.name) : IRNode.cast(self.objectiveCObjectType(imported.declaration.name), IRNode.variable("self"), "borrow");
		var adapter = IRFunction();
		adapter.name = prefix;
		adapter.returnType = "int";
		if (offset != 0) { adapter.params.push(wrapper.params.get(0)); }
		Vector<IRNode> nativeArguments = [];
		for index in range(method.params.len - 1) {
			IRParam parameter = wrapper.params.get(index + offset);
			if (index == callback.parameterIndex) {
				adapter.params.extend([IRParam(invocation.name, "invoke"), IRParam("void*", "context"), IRParam(lifetime.name, "retainContext"), IRParam(lifetime.name, "releaseContext")]);
				var block = IRNode();
				block.kind = IRK_OBJECTIVE_C_BLOCK;
				block.targetType = "void";
				block.params = [];
				Vector<IRNode> arguments = [];
				for position in range(callback.nativeParameters.len) {
					string localName = f"value{position}";
					block.params.push(IRParam(callback.nativeParameters.get(position), localName));
					Node valueType = values.get(position);
					IRNode value = IRNode.variable(localName);
					if (self.managedValues.isNative(valueType)) { value = IRNode.cast(self.cTypes.lower(valueType), value, "borrow"); }
					arguments.push(value);
				}
				arguments.push(IRNode.objectiveCMessage(IRNode.variable("holder"), "context", noArguments));
				block.body = IRNode.block([IRNode.expressionStatement(IRNode.indirectCall(IRNode.variable("invoke"), arguments))]);
				nativeArguments.push(block);
			} else {
				adapter.params.push(parameter);
				Node valueType = method.params.get(index).type;
				IRNode value = IRNode.variable(parameter.name);
				nativeArguments.push(self.managedValues.isNative(valueType) ? IRNode.cast(self.objectiveCObjectType(valueType.base), value, "borrow") : self.objectiveCValue(valueType, value, true));
			}
		}
		IRNode holder = IRNode.variable("holder");
		Vector<IRNode> nativeBody = [
			IRNode.variableDeclaration(holderName + "*", "holder", IRNode.objectiveCMessage(IRNode.variable(holderName), "new", noArguments)),
			IRNode.ifStatement(IRNode.binary(holder, "==", IRNode.literal("nil")), IRNode.block([IRNode.returnStatement(IRNode.literal("2"))]), null),
			IRNode.expressionStatement(IRNode.objectiveCMessage(holder, "configure:retain:release:", [IRNode.variable("context"), IRNode.variable("retainContext"), IRNode.variable("releaseContext")])),
			IRNode.expressionStatement(IRNode.objectiveCMessage(nativeReceiver, descriptor.selector, nativeArguments)),
			IRNode.returnStatement(IRNode.literal("0"))
		];
		adapter.body = IRNode.block([IRNode.objectiveCAutoreleasePool(IRNode.block([
			IRNode.objectiveCExceptionBoundary(IRNode.block(nativeBody), IRNode.block([IRNode.returnStatement(IRNode.literal("1"))]))
		]))]);
		native.functions.push(adapter);
		var external = IRFunctionDecl(prefix, "int", false);
		external.params = adapter.params;
		module.functionDecls.push(external);
		Vector<IRNode> body = [];
		Map<string, bool> parameterNames = {};
		for parameter in wrapper.params { parameterNames.put(parameter.name, true); }
		IRNode cleanup = self.nativeCleanupScope(parameterNames, body);
		Vector<IRNode> arguments = [];
		Vector<Vector<IRNode>> releases = [];
		for index in range(wrapper.params.len) {
			IRParam parameter = wrapper.params.get(index);
			Node valueType = parameterTypes.get(index);
			IRNode value = IRNode.variable(parameter.name);
			if (self.managedValues.isManaged(valueType)) {
				if (!valueType.isNullable) { body.push(self.objectiveCNullGuard(value, f"One-shot {descriptor.name}: null {parameter.name}")); }
				value = self.emitNativeLease(index, valueType, value, parameterNames, body, releases);
			}
			arguments.push(value);
		}
		IRNode context = IRNode.variable("context");
		IRNode contextSlot = IRNode.variableDeclaration(contextC, "context", IRNode.call(contextSymbol + "_new", [arguments.get(callback.parameterIndex + offset)]));
		body.push(contextSlot);
		body.push(IRNode.expressionStatement(self.managedLifetime.registerCleanupSlot(contextSlot, self.managedValues.runtimeType(contextType))));
		body.push(IRNode.expressionStatement(IRNode.call(contextSymbol + "_activate", [context, arguments.get(arguments.len - 1)])));
		Vector<IRNode> adapterArguments = [];
		for index in range(arguments.len - 1) {
			if (index == callback.parameterIndex + offset) {
				adapterArguments.extend([IRNode.functionReference(invoke), IRNode.cast("void*", context), IRNode.functionReference(prefix + "_retain"), IRNode.functionReference(prefix + "_release")]);
			} else { adapterArguments.push(arguments.get(index)); }
		}
		body.push(IRNode.variableDeclaration("int", "activationStatus", IRNode.call(prefix, adapterArguments)));
		body.push(IRNode.ifStatement(IRNode.variable("activationStatus"), self.storedActivationFailure(callback, contextSymbol, context, f"One-shot {descriptor.name}: activation failed before publication"), null));
		body.push(IRNode.expressionStatement(IRNode.call(contextSymbol + "_publish", [context])));
		for (int index = releases.len - 1; index >= 0; index--) { body.extend(releases.get(index)); }
		body.push(cleanup);
		body.push(IRNode.returnStatement(context));
		wrapper.body = IRNode.block(body);
		self.appendFunction(wrapper, module);
	}

	private string emitStoredDelegateHolder(FeNativeCallbackProjection callback, IRModule native, Vector<IRFunctionPointerTypedef> invocations, Vector<Vector<Node>> callbackTypes) {
		var holder = native.objectiveCClasses.get(native.objectiveCClasses.len - 1);
		holder.protocols = [callback.delegateProtocol];
		var configure = holder.methods.get(0);
		for index in range(callback.delegateMethods.len) {
			var method = callback.delegateMethods.get(index);
			var invocation = invocations.get(index);
			var valueTypes = callbackTypes.get(index);
			string field = f"_invoke{index}";
			configure.selector = configure.selector + f"invoke{index}:";
			configure.params.push(IRParam(invocation.name, f"invoke{index}"));
			configure.body.stmts.push(IRNode.assignment(IRNode.variable(field), IRNode.variable(f"invoke{index}")));
			holder.fields.push(IRStructField(invocation.name, field));
			Vector<IRParam> parameters = [];
			Vector<IRNode> arguments = [];
			for position in range(method.nativeParameters.len) {
				string name = f"argument{position}";
				parameters.push(IRParam(method.nativeParameters.get(position), name));
				Node valueType = valueTypes.get(position);
				IRNode value = IRNode.variable(name);
				if (self.managedValues.isNative(valueType)) { value = IRNode.cast(self.cTypes.lower(valueType), value, "borrow"); }
				arguments.push(value);
			}
			arguments.push(IRNode.variable("_context"));
			IRNode call = IRNode.indirectCall(IRNode.variable(field), arguments);
			IRNode body = invocation.returnType == "void" ? IRNode.expressionStatement(call) : IRNode.returnStatement(IRNode.cast(method.nativeReturn, call));
			holder.methods.push(IRObjectiveCMethod(method.nativeMethod.selector, method.nativeReturn, parameters, IRNode.block([body])));
		}
		return configure.selector;
	}

	private string emitStoredActionHolder(IRModule native, string invocationType) {
		var holder = native.objectiveCClasses.get(native.objectiveCClasses.len - 1);
		var configure = holder.methods.get(0);
		configure.selector = configure.selector + "invoke:source:";
		configure.params.extend([IRParam(invocationType, "invoke"), IRParam("id", "source")]);
		holder.fields.extend([IRStructField(invocationType, "_invoke"), IRStructField("id", "_source")]);
		configure.body.stmts.extend([
			IRNode.assignment(IRNode.variable("_invoke"), IRNode.variable("invoke")),
			IRNode.assignment(IRNode.variable("_source"), IRNode.variable("source"))
		]);
		Vector<IRNode> noArguments = [];
		IRNode abortCall = IRNode.call("abort", noArguments);
		abortCall.neverReturns = true;
		holder.methods.push(IRObjectiveCMethod("btrcInvoke:", "void", [IRParam("id", "sender")], IRNode.block([
			IRNode.ifStatement(IRNode.binary(IRNode.variable("sender"), "!=", IRNode.variable("_source")), IRNode.block([IRNode.expressionStatement(abortCall)]), null),
			IRNode.expressionStatement(IRNode.indirectCall(IRNode.variable("_invoke"), [IRNode.variable("_context")]))
		])));
		return configure.selector;
	}

	private void releaseStoredLocal(IRNode value, Node valueType, string name, Vector<IRNode> body) {
		body.push(IRNode.variableDeclaration(self.cTypes.lower(valueType), name, value));
		body.push(IRNode.assignment(value, IRNode.literal("NULL")));
		body.push(IRNode.expressionStatement(self.managedLifetime.releaseValue(IRNode.variable(name), valueType)));
	}

	private void emitStoredObjectiveCAdapter(FeNativeImportedDeclaration imported, Node method, FeNativeCallContract contract, IRModule module, IRModule native) {
		Vector<IRNode> noArguments = [];
		NativeNode descriptor = contract.objectiveCMethod;
		FeNativeCallbackProjection callback = contract.callbacks.get(0);
		bool objectCallback = callback.slotGetter != null;
		bool action = callback.actionSetter != null;
		NativeNode cancellation = callback.unregister;
		string name = imported.declaration.name + "_" + method.name;
		string prefix = "__btrc_objc_" + name;
		Node contextType = method.returnType;
		string contextSymbol = TypeIdentity.mangleGenericSymbol(contextType.base, contextType.genericArgs);
		Node tokenType = contextType.genericArgs.get(1);
		bool paired = cancellation.signature.parameters.len > 0 && !cancellation.classMethod;
		Node nativeTokenType = paired ? tokenType.genericArgs.get(1) : tokenType;
		string nativeTokenC = self.cTypes.lower(nativeTokenType);
		string tokenSymbol = TypeIdentity.mangleGenericSymbol(tokenType.base, tokenType.genericArgs);
		Node sourceType = paired ? tokenType.genericArgs.get(0) : nativeTokenType;
		string tokenC = self.cTypes.lower(tokenType);
		string contextC = self.cTypes.lower(contextType);
		self.emitStoredContextLifetime(prefix, contextType, contextSymbol, module);
		var lifetime = IRFunctionPointerTypedef(prefix + "_lifetime", "void");
		lifetime.paramTypes = ["void*"];
		Vector<FeNativeCallbackProjection> projections = objectCallback ? callback.delegateMethods : [callback];
		Vector<IRFunctionPointerTypedef> invocations = [];
		Vector<string> invokers = [];
		Vector<Vector<Node>> callbackTypes = [];
		Vector<IRFunctionPointerTypedef> definitions = [lifetime];
		for index in range(projections.len) {
			var projection = projections.get(index);
			invokers.push(self.emitStoredContextInvoker(f"{prefix}_{index}", projection, contextType, contextSymbol, module));
			var values = self.nativeCallbackTypes(projection);
			callbackTypes.push(values);
			var invocation = IRFunctionPointerTypedef(f"{prefix}_callback{index}", self.cTypes.lower(projection.returnType));
			for value in values { invocation.paramTypes.push(self.cTypes.lower(value)); }
			invocations.push(invocation);
			definitions.push(invocation);
		}
		for definition in definitions {
			module.functionPointerTypedefs.push(definition);
			native.functionPointerTypedefs.push(definition);
		}
		string holderName = self.emitStoredContextHolder(prefix, lifetime.name, native);
		string configureSelector = action ? self.emitStoredActionHolder(native, invocations.get(0).name) : objectCallback ? self.emitStoredDelegateHolder(callback, native, invocations, callbackTypes) : "configure:retain:release:";
		IRNode token = IRNode.variable("token");
		var unregisterAdapter = IRFunction();
		unregisterAdapter.name = prefix + "_unregister_adapter";
		unregisterAdapter.returnType = "void";
		unregisterAdapter.params = [IRParam(nativeTokenC, "token")];
		IRNode unregisterReceiver = IRNode.cast(self.objectiveCObjectType(nativeTokenType.base), token, "borrow");
		Vector<IRNode> unregisterArguments = [];
		if (cancellation.classMethod) {
			unregisterArguments.push(unregisterReceiver);
			unregisterReceiver = IRNode.variable(cancellation.receiver);
		}
		if (paired) {
			unregisterAdapter.params = [IRParam(self.cTypes.lower(sourceType), "source"), IRParam(nativeTokenC, "token")];
			unregisterArguments.push(unregisterReceiver);
			unregisterReceiver = IRNode.cast(self.objectiveCObjectType(sourceType.base), IRNode.variable("source"), "borrow");
		}
		IRNode abortCall = IRNode.call("abort", noArguments);
		abortCall.neverReturns = true;
		Vector<IRNode> nativeUnregister = [];
		if (objectCallback) {
			IRNode current = IRNode.objectiveCMessage(unregisterReceiver, callback.slotGetter.selector, noArguments);
			nativeUnregister.push(IRNode.ifStatement(IRNode.binary(current, "!=", IRNode.cast("id", token, "borrow")), IRNode.block([IRNode.expressionStatement(abortCall)]), null));
			unregisterArguments = [IRNode.literal("nil")];
		}
		if (action) {
			IRNode selector = IRNode.objectiveCMessage(unregisterReceiver, callback.actionGetter.selector, noArguments);
			nativeUnregister.push(IRNode.ifStatement(IRNode.binary(selector, "!=", IRNode.objectiveCSelector("btrcInvoke:")), IRNode.block([IRNode.expressionStatement(abortCall)]), null));
			nativeUnregister.push(IRNode.expressionStatement(IRNode.objectiveCMessage(unregisterReceiver, callback.actionSetter.selector, [IRNode.literal("NULL")])));
		}
		nativeUnregister.push(IRNode.expressionStatement(IRNode.objectiveCMessage(unregisterReceiver, cancellation.selector, unregisterArguments)));
		if (objectCallback) { nativeUnregister.push(IRNode.ifStatement(IRNode.binary(IRNode.objectiveCMessage(unregisterReceiver, callback.slotGetter.selector, noArguments), "!=", IRNode.literal("nil")), IRNode.block([IRNode.expressionStatement(abortCall)]), null)); }
		if (action) { nativeUnregister.push(IRNode.ifStatement(IRNode.binary(IRNode.objectiveCMessage(unregisterReceiver, callback.actionGetter.selector, noArguments), "!=", IRNode.literal("NULL")), IRNode.block([IRNode.expressionStatement(abortCall)]), null)); }
		unregisterAdapter.body = IRNode.block([IRNode.objectiveCAutoreleasePool(IRNode.block([
			IRNode.objectiveCExceptionBoundary(IRNode.block(nativeUnregister), IRNode.block([IRNode.expressionStatement(abortCall)]))
		]))]);
		native.functions.push(unregisterAdapter);
		var unregisterExternal = IRFunctionDecl(unregisterAdapter.name, "void", false);
		unregisterExternal.params = unregisterAdapter.params;
		module.functionDecls.push(unregisterExternal);
		var unregister = IRFunction();
		unregister.name = prefix + "_unregister";
		unregister.returnType = "bool";
		unregister.isStatic = true;
		unregister.params = [IRParam(tokenC, "token")];
		Vector<IRNode> unregisterBody = [];
		Map<string, bool> unregisterNames = {"token": true};
		IRNode unregisterCleanup = self.nativeCleanupScope(unregisterNames, unregisterBody);
		Vector<IRNode> unregisterValues = [token];
		if (paired) {
			unregisterValues = [];
			Vector<string> accessors = ["source", "value"];
			Vector<Node> accessorTypes = [sourceType, nativeTokenType];
			for index in range(accessors.len) {
				string accessor = accessors.get(index);
				Node valueType = accessorTypes.get(index);
				IRNode slot = IRNode.variableDeclaration(self.cTypes.lower(valueType), accessor, IRNode.call(tokenSymbol + "_" + accessor, [token]));
				unregisterBody.push(slot);
				unregisterBody.push(IRNode.expressionStatement(self.managedLifetime.registerCleanupSlot(slot, self.managedValues.runtimeType(valueType))));
				unregisterValues.push(IRNode.variable(accessor));
			}
		}
		unregisterBody.push(IRNode.expressionStatement(IRNode.call(unregisterAdapter.name, unregisterValues)));
		if (paired) {
			self.releaseStoredLocal(IRNode.variable("value"), nativeTokenType, "releasedValue", unregisterBody);
			self.releaseStoredLocal(IRNode.variable("source"), sourceType, "releasedSource", unregisterBody);
		}
		unregisterBody.extend([unregisterCleanup, IRNode.returnStatement(IRNode.literal("true"))]);
		unregister.body = IRNode.block(unregisterBody);
		self.appendFunction(unregister, module);
		var wrapper = IRFunction();
		wrapper.name = name;
		wrapper.returnType = contextC;
		wrapper.isStatic = true;
		Vector<Node> parameterTypes = [];
		if (paired) {
			wrapper.params.push(IRParam(self.cTypes.lower(sourceType), "self"));
			parameterTypes.push(sourceType);
		}
		for parameter in method.params { wrapper.params.push(self.cTypes.lowerParameter(parameter)); }
		for parameter in method.params { parameterTypes.push(parameter.type); }
		int receiverOffset = paired ? 1 : 0;
		var adapter = IRFunction();
		adapter.name = prefix;
		adapter.returnType = "int";
		IRNode nativeReceiver = IRNode.variable(imported.declaration.name);
		if (paired) {
			adapter.params.push(wrapper.params.get(0));
			nativeReceiver = IRNode.cast(self.objectiveCObjectType(sourceType.base), IRNode.variable("self"), "borrow");
		}
		Vector<IRNode> nativeArguments = [];
		for index in range(method.params.len - 1) {
			IRParam parameter = wrapper.params.get(index + receiverOffset);
			if (index == callback.parameterIndex) {
				for position in range(invocations.len) { adapter.params.push(IRParam(invocations.get(position).name, f"invoke{position}")); }
				adapter.params.extend([IRParam("void*", "context"), IRParam(lifetime.name, "retainContext"), IRParam(lifetime.name, "releaseContext")]);
				if (objectCallback) { nativeArguments.push(IRNode.variable("holder")); continue; }
				var invocation = invocations.get(0);
				var valueTypes = callbackTypes.get(0);
				var block = IRNode();
				block.kind = IRK_OBJECTIVE_C_BLOCK;
				block.targetType = callback.nativeReturn;
				block.params = [];
				Vector<IRNode> arguments = [];
				for position in range(callback.nativeParameters.len) {
					string localName = f"value{position}";
					block.params.push(IRParam(callback.nativeParameters.get(position), localName));
					Node valueType = valueTypes.get(position);
					IRNode value = IRNode.variable(localName);
					if (self.managedValues.isNative(valueType)) { value = IRNode.cast(self.cTypes.lower(valueType), value, "borrow"); }
					arguments.push(value);
				}
				arguments.push(IRNode.objectiveCMessage(IRNode.variable("holder"), "context", noArguments));
				IRNode call = IRNode.indirectCall(IRNode.variable("invoke0"), arguments);
				block.body = IRNode.block([invocation.returnType == "void" ? IRNode.expressionStatement(call) : IRNode.returnStatement(IRNode.cast(callback.nativeReturn, call, self.managedValues.isNative(callback.returnType) ? "transfer" : ""))]);
				nativeArguments.push(block);
			} else {
				adapter.params.push(parameter);
				Node valueType = method.params.get(index).type;
				IRNode value = IRNode.variable(parameter.name);
				nativeArguments.push(self.managedValues.isNative(valueType) ? IRNode.cast(self.objectiveCObjectType(valueType.base), value, "borrow") : self.objectiveCValue(valueType, value, true));
			}
		}
		adapter.params.push(IRParam(nativeTokenC + " volatile*", "nativeResult"));
		IRNode holder = IRNode.variable("holder");
		Vector<IRNode> configureArguments = [IRNode.variable("context"), IRNode.variable("retainContext"), IRNode.variable("releaseContext")];
		if (objectCallback) { for index in range(invokers.len) { configureArguments.push(IRNode.variable(f"invoke{index}")); } }
		if (action) { configureArguments.push(nativeReceiver); }
		Vector<IRNode> nativeBody = [];
		if (objectCallback) { nativeBody.push(IRNode.ifStatement(IRNode.binary(IRNode.objectiveCMessage(nativeReceiver, callback.slotGetter.selector, noArguments), "!=", IRNode.literal("nil")), IRNode.block([IRNode.returnStatement(IRNode.literal("3"))]), null)); }
		if (action) { nativeBody.push(IRNode.ifStatement(IRNode.binary(IRNode.objectiveCMessage(nativeReceiver, callback.actionGetter.selector, noArguments), "!=", IRNode.literal("NULL")), IRNode.block([IRNode.returnStatement(IRNode.literal("3"))]), null)); }
		nativeBody.extend([
			IRNode.variableDeclaration(holderName + "*", "holder", IRNode.objectiveCMessage(IRNode.variable(holderName), "new", noArguments)),
			IRNode.ifStatement(IRNode.binary(holder, "==", IRNode.literal("nil")), IRNode.block([IRNode.returnStatement(IRNode.literal("2"))]), null),
			IRNode.expressionStatement(IRNode.objectiveCMessage(holder, configureSelector, configureArguments))
		]);
		IRNode published = IRNode.objectiveCMessage(nativeReceiver, descriptor.selector, nativeArguments);
		if (objectCallback) {
			nativeBody.push(IRNode.expressionStatement(published));
			nativeBody.push(IRNode.ifStatement(IRNode.binary(IRNode.objectiveCMessage(nativeReceiver, callback.slotGetter.selector, noArguments), "!=", holder), IRNode.block([IRNode.returnStatement(IRNode.literal("4"))]), null));
			published = holder;
		}
		if (action) {
			nativeBody.push(IRNode.expressionStatement(IRNode.objectiveCMessage(nativeReceiver, callback.actionSetter.selector, [IRNode.objectiveCSelector("btrcInvoke:")])));
			nativeBody.push(IRNode.ifStatement(IRNode.binary(IRNode.objectiveCMessage(nativeReceiver, callback.actionGetter.selector, noArguments), "!=", IRNode.objectiveCSelector("btrcInvoke:")), IRNode.block([IRNode.returnStatement(IRNode.literal("4"))]), null));
			nativeBody.push(IRNode.ifStatement(IRNode.binary(IRNode.objectiveCMessage(nativeReceiver, callback.slotGetter.selector, noArguments), "!=", holder), IRNode.block([IRNode.returnStatement(IRNode.literal("4"))]), null));
		}
		nativeBody.push(IRNode.assignment(IRNode.dereference(IRNode.variable("nativeResult")), IRNode.cast(nativeTokenC, published, "retain")));
		nativeBody.push(IRNode.returnStatement(IRNode.literal("0")));
		adapter.body = IRNode.block([IRNode.objectiveCAutoreleasePool(IRNode.block([
			IRNode.objectiveCExceptionBoundary(IRNode.block(nativeBody), IRNode.block([IRNode.returnStatement(IRNode.literal("1"))]))
		]))]);
		native.functions.push(adapter);
		var external = IRFunctionDecl(adapter.name, "int", false);
		external.params = adapter.params;
		module.functionDecls.push(external);
		Vector<IRNode> body = [];
		Map<string, bool> parameterNames = {};
		for parameter in wrapper.params { parameterNames.put(parameter.name, true); }
		IRNode cleanup = self.nativeCleanupScope(parameterNames, body);
		Vector<IRNode> arguments = [];
		Vector<Vector<IRNode>> releases = [];
		for index in range(wrapper.params.len) {
			IRParam parameter = wrapper.params.get(index);
			Node valueType = parameterTypes.get(index);
			IRNode value = IRNode.variable(parameter.name);
			if (self.managedValues.isManaged(valueType)) {
				if (!valueType.isNullable) { body.push(self.objectiveCNullGuard(value, f"Stored callback {descriptor.name}: null {parameter.name}")); }
				value = self.emitNativeLease(index, valueType, value, parameterNames, body, releases);
			}
			arguments.push(value);
		}
		IRNode pair = IRNode.variable("cancellationToken");
		if (paired) {
			IRNode pairSlot = IRNode.variableDeclaration(tokenC, "cancellationToken", IRNode.call(tokenSymbol + "_new", [arguments.get(0)]));
			body.push(pairSlot);
			body.push(IRNode.expressionStatement(self.managedLifetime.registerCleanupSlot(pairSlot, self.managedValues.runtimeType(tokenType))));
		}
		IRNode context = IRNode.variable("context");
		IRNode contextSlot = IRNode.variableDeclaration(contextC, "context", IRNode.call(contextSymbol + "_new", [arguments.get(callback.parameterIndex + receiverOffset), IRNode.functionReference(unregister.name)]));
		body.push(contextSlot);
		body.push(IRNode.expressionStatement(self.managedLifetime.registerCleanupSlot(contextSlot, self.managedValues.runtimeType(contextType))));
		body.push(IRNode.expressionStatement(IRNode.call(contextSymbol + "_activate", [context, arguments.get(arguments.len - 1)])));
		IRNode result = IRNode.variable("nativeResult");
		IRNode tokenSlot = IRNode.variableDeclaration(nativeTokenC, "nativeResult", IRNode.literal("NULL"));
		body.push(tokenSlot);
		body.push(IRNode.expressionStatement(self.managedLifetime.registerCleanupSlot(tokenSlot, self.managedValues.runtimeType(nativeTokenType))));
		Vector<IRNode> adapterArguments = [];
		for index in range(arguments.len - 1) {
			if (index == callback.parameterIndex + receiverOffset) {
				for invoke in invokers { adapterArguments.push(IRNode.functionReference(invoke)); }
				adapterArguments.extend([IRNode.cast("void*", context), IRNode.functionReference(prefix + "_retain"), IRNode.functionReference(prefix + "_release")]);
			}
			else { adapterArguments.push(arguments.get(index)); }
		}
		adapterArguments.push(IRNode.addressOf(result));
		body.push(IRNode.variableDeclaration("int", "activationStatus", IRNode.call(prefix, adapterArguments)));
		if (objectCallback) {
			body.push(IRNode.ifStatement(IRNode.binary(IRNode.variable("activationStatus"), "==", IRNode.literal("3")), IRNode.block([
				IRNode.expressionStatement(IRNode.call(contextSymbol + "_abortActivation", [context])),
				self.objectiveCNullGuard(IRNode.literal("NULL"), action ? "Native action slots are already occupied" : "Native delegate slot is already occupied")
			]), null));
		}
		body.push(IRNode.ifStatement(IRNode.variable("activationStatus"), self.storedActivationFailure(callback, contextSymbol, context, f"Stored callback {descriptor.name}: activation failed before publication"), null));
		body.push(IRNode.ifStatement(IRNode.binary(result, "==", IRNode.literal("NULL")), self.storedActivationFailure(callback, contextSymbol, context, f"Stored callback {descriptor.name}: null cancellation token"), null));
		if (paired) { body.push(IRNode.expressionStatement(IRNode.call(tokenSymbol + "_publish", [pair, result]))); }
		body.push(IRNode.expressionStatement(IRNode.call(contextSymbol + "_publish", [context, paired ? pair : result])));
		self.releaseStoredLocal(result, nativeTokenType, "releasedToken", body);
		if (paired) { self.releaseStoredLocal(pair, tokenType, "releasedPair", body); }
		for (int index = releases.len - 1; index >= 0; index--) { body.extend(releases.get(index)); }
		body.push(cleanup);
		body.push(IRNode.returnStatement(context));
		wrapper.body = IRNode.block(body);
		self.appendFunction(wrapper, module);
	}

	private IRNode storedActivationFailure(FeNativeCallbackProjection callback, string contextSymbol, IRNode context, string message) {
		if (callback.activationFailure == "abort") {
			Vector<IRNode> noArguments = [];
			IRNode abortCall = IRNode.call("abort", noArguments);
			abortCall.neverReturns = true;
			return IRNode.block([
				IRNode.expressionStatement(IRNode.call("fputs", [IRNode.literal("\"BTRC stored callback activation failed: publication state is unknown\\n\""), IRNode.variable("stderr")])),
				IRNode.expressionStatement(abortCall)
			]);
		}
		return IRNode.block([
			IRNode.expressionStatement(IRNode.call(contextSymbol + "_abortActivation", [context])),
			self.objectiveCNullGuard(IRNode.literal("NULL"), message)
		]);
	}

	private IRNode objectiveCNullGuard(IRNode value, string message) {
		self.context.referenceHelper("__btrc_throw");
		IRNode failure = IRNode.call("__btrc_throw", [IRNode.literal("\"" + message + "\"")]);
		failure.neverReturns = true;
		return IRNode.ifStatement(IRNode.binary(value, "==", IRNode.literal("NULL")), IRNode.block([IRNode.expressionStatement(failure)]), null);
	}

	private string objectiveCObjectType(string name) { return name == "id" ? "id" : name + "*"; }

	private void emitObjectiveCLifetime(FeNativeImportedDeclaration imported, IRModule module, IRModule native) {
		Vector<string> operations = ["retain", "release"];
		for operation in operations {
			var adapter = IRFunction();
			adapter.name = "__btrc_objc_" + imported.declaration.name + "_" + operation;
			adapter.returnType = "void";
			adapter.params.push(IRParam("void*", "value"));
			string nativeType = self.objectiveCObjectType(imported.declaration.name);
			IRNode value = IRNode.variable("value");
			Vector<IRNode> body = [];
			if (operation == "retain") {
				IRNode borrowed = IRNode.cast(nativeType, value, "borrow");
				body.push(IRNode.expressionStatement(IRNode.cast("void", IRNode.cast("void*", borrowed, "retain"))));
			} else {
				body.push(IRNode.variableDeclaration(nativeType, "owned", IRNode.cast(nativeType, value, "transfer")));
				body.push(IRNode.expressionStatement(IRNode.cast("void", IRNode.variable("owned"))));
			}
			Vector<IRNode> noArguments = [];
			IRNode failure = IRNode.call("abort", noArguments);
			failure.neverReturns = true;
			IRNode boundary = IRNode.objectiveCExceptionBoundary(IRNode.block(body), IRNode.block([IRNode.expressionStatement(failure)]));
			adapter.body = IRNode.block([IRNode.objectiveCAutoreleasePool(IRNode.block([boundary]))]);
			native.functions.push(adapter);
			var prototype = IRFunctionDecl(adapter.name, "void", false);
			prototype.params = adapter.params;
			module.functionDecls.push(prototype);
		}
	}

	public void emitDeclarations(Node prog, IRModule m) {
		for name in self.analyzed.interfaceTable.keys() { self.emitInterface(name, m); }
		Map<string, bool> nativeAdapters = {};
		Map<string, bool> nativeConstants = {};
		for imported in self.analyzed.nativeDeclarations {
			if (!self.validIncludeHeader(imported.header)) { self.preprocessorFail("invalid native include header"); }
			if (imported.language == "c") { self.appendPreprocessorDecl(m, IRPreprocessorDecl.include(imported.header, false)); }
			if (imported.declaration.kind == NK_CLASS_DECL && !imported.coalesced) {
				if (!imported.invocation.isEmpty()) { continue; }
				else if (imported.resource != null) { self.emitResourceLifetime(imported, m); }
				else { self.emitObjectiveCAdapters(imported, m); }
			}
			if ((imported.language == "objective-c" || self.analyzed.nativeGlobalReturnsOwned(imported.declaration.name)) && imported.declaration.kind == NK_VAR_DECL_STMT && !nativeConstants.has(imported.declaration.name)) {
				if (imported.declaration.initializer == null) { self.emitNativeGlobal(imported, m); }
				else { self.emitGlobalVar(imported.declaration, m, false); }
				nativeConstants.put(imported.declaration.name, true);
			}
			if (imported.declaration.kind == NK_FUNCTION_DECL && imported.callContract != null && !nativeAdapters.has(imported.declaration.name)) {
				self.emitNativeAdapter(imported.declaration, imported.callContract, m);
				nativeAdapters.put(imported.declaration.name, true);
			}
		}
		Map<string, bool> externallyDefinedGlobals = {};
		int globalDeclarationIndex = 0;
		while (globalDeclarationIndex < prog.declarations.len) {
			Node declaration = prog.declarations.get(globalDeclarationIndex);
			if (declaration.kind == NK_VAR_DECL_STMT && declaration.type != null && declaration.type.isExtern && self.analyzed.globalHasDefinition.has(declaration.name)) {
				externallyDefinedGlobals.put(declaration.name, true);
			}
			globalDeclarationIndex = globalDeclarationIndex + 1;
		}
		int i = 0;
		while (i < prog.declarations.len) {
			Node d = prog.declarations.get(i);
			if (self.analyzed.isNativeDeclaration(d)) {
				i++;
				continue;
			}
			if (d.kind == NK_CLASS_DECL) {
				if (d.genericParams.len == 0) { self.emitClassDecl(d, m); }
			} else if (d.kind == NK_FUNCTION_DECL) {
				if (d.isGpu) {
					self.functions.emitGpuCpuFallback(d, m);
					i = i + 1;
					continue;
				}
				/* Bodyless FunctionDecl (e.g. `bool is_even(int n);`) is a
                 * forward declaration, NOT a definition. Emit a typed callable
                 * declaration and skip function_defs — otherwise we'd emit an
                 * empty-bodied definition that collides with the real one
                 * (mirrors functions.emit_function_decl: body is None branch). */
				if (d.bodyNode == null) {
					string fret = self.cTypes.lower(d.returnType);
					if (fret == "") { fret = "void"; }
					IRFunctionDecl declaration = IRFunctionDecl(self.semanticDeclarations.sourceFunctionSymbol(d.name), fret, false);
					int fp = 0;
					while (fp < d.params.len) {
						Node pp = d.params.get(fp);
						declaration.params.push(self.cTypes.lowerParameter(pp));
						fp = fp + 1;
					}
					m.functionDecls.push(declaration);
				} else {
					m.functions.push(self.functions.lowerFunction(d));
				}
			} else if (d.kind == NK_STRUCT_DECL) {
				/* Forward tags were emitted in phase one; complete definitions
                 * were lowered above in by-value dependency order. */
			} else if (d.kind == NK_ENUM_DECL) {
				self.emitEnumDecl(d, m);
			} else if (d.kind == NK_RICH_ENUM_DECL) {
				self.emitRichEnumDecl(d, m);
			} else if (d.kind == NK_TYPEDEF_DECL) {
				/* Already lowered above in dependency order. */
			} else if (d.kind == NK_VAR_DECL_STMT) {
				bool redundantExtern = d.type != null && d.type.isExtern && d.initializer == null && self.analyzed.globalHasDefinition.has(d.name);
				if (!redundantExtern) {
					self.emitGlobalVar(d, m, externallyDefinedGlobals.has(d.name));
				}
			} else if (d.kind == NK_PREPROCESSOR_DIRECTIVE) {
				self.emitPreprocessor(d, m);
			}
			i = i + 1;
		}
	}

	/* Raw by-value structs must be complete before a monomorphized generic
     * struct embeds them. Keep their semantic dependency order as a dedicated
     * type-declaration phase, matching the reference pipeline's _emit_structs
     * before _emit_generic_collections. */
	public void emitStructDefinitions(Node prog, IRModule m) {
		Vector<Node> ordered = DeclarationValidator.orderedStructDefinitions(prog, self.analyzed.structTable);
		int index = 0;
		while (index < ordered.len) {
			if (!self.analyzed.isNativeDeclaration(ordered.get(index))) { self.emitStructDecl(ordered.get(index), m); }
			index = index + 1;
		}
	}

	/* Emit a plain enum (NK_ENUM_DECL) as a typed enum declaration plus a
     * static `<Name>_toString` switch function. */
	public void emitEnumDecl(Node d, IRModule m) {
		CallableFlowState callableFlow = CallableFlowState();
		string name = d.name;
		IREnumDef definition = IREnumDef(name);
		Map<string, bool> priorMembers = {};
		int i = 0;
		while (i < d.values.len) {
			Node v = d.values.get(i);
			IRNode value = null;
			if (v.valueNode != null) {
				Map<string, Node> empty = {};
				self.context.enumInitializer = true;
				self.context.enumOwner = name;
				self.context.enumMembers = priorMembers;
				value = self.expressions.lowerExpr(v.valueNode, empty, callableFlow);
				self.context.enumInitializer = false;
				self.context.enumOwner = "";
				self.context.enumMembers = {};
			}
			string emittedName = v.name;
			if (name != "") { emittedName = name + "_" + v.name; }
			definition.values.push(IREnumValue(emittedName, value));
			priorMembers.put(v.name, true);
			i = i + 1;
		}
		m.enumDefs.push(definition);
		/* static const char* Name_toString(Name val) { switch (val) {...} }.
         * It is an ordinary structured function, so reachability DCE prunes it
         * when unused. An anonymous enum (empty name) has no
         * usable toString name, so skip it entirely (the reference's `_toString`
         * is always dead and removed by DCE). */
		if (name != "") {
			m.functions.push(self.enumToStringFn(name, d.values, false));
		}
	}

	/* Emit a rich (tagged-union) enum (NK_RICH_ENUM_DECL): a tag enum, per-variant
     * data structs, a tagged-union struct, variant constructors, and a toString
     * function. Mirrors enums._emit_rich_enum. */
	public void emitRichEnumDecl(Node d, IRModule m) {
		string name = d.name;
		IREnumDef tagDefinition = IREnumDef(name + "_Tag");
		int i = 0;
		while (i < d.variants.len) {
			Node v = d.variants.get(i);
			tagDefinition.values.push(IREnumValue(name + "_" + v.name + "_TAG", IRNode.literal(Strings.fromInt(i))));
			i = i + 1;
		}
		m.enumDefs.push(tagDefinition);
		IRTaggedUnionDef tagged = IRTaggedUnionDef(name, name + "_Tag");
		int v2 = 0;
		while (v2 < d.variants.len) {
			Node v = d.variants.get(v2);
			IRTaggedUnionVariant variant = IRTaggedUnionVariant(v.name);
			int p = 0;
			while (p < v.params.len) {
				Node par = v.params.get(p);
				IRStructField variantField = IRStructField(self.cTypes.lower(par.type), self.hostedAbi.lexicalBindingCName(par.name, false));
				variantField.isVolatile = par.type != null && par.type.isVolatile;
				variantField.effectiveIsVolatile = SemanticTypeSystem.typeEffectiveOuterVolatile(par.type, self.analyzed.typedefTable);
				variant.fields.push(variantField);
				p = p + 1;
			}
			tagged.variants.push(variant);
			v2 = v2 + 1;
		}
		m.taggedUnionDefs.push(tagged);
		/* Variant constructors are ordinary IR functions so their field stores
         * participate in reachability and helper analysis. */
		int v4 = 0;
		while (v4 < d.variants.len) {
			Node v = d.variants.get(v4);
			IRFunction constructor = IRFunction();
			constructor.name = name + "_" + v.name;
			constructor.returnType = name;
			constructor.isStatic = true;
			Vector<IRNode> constructorBody = [];
			constructorBody.push(IRNode.variableDeclaration(name, "__result", null));
			constructorBody.push(IRNode.assignment(IRNode.fieldAccess(IRNode.variable("__result"), "tag", false), IRNode.variable(name + "_" + v.name + "_TAG")));
			int p2 = 0;
			while (p2 < v.params.len) {
				Node par = v.params.get(p2);
				constructor.params.push(self.cTypes.lowerParameter(par));
				IRNode payload = IRNode.fieldAccess(IRNode.fieldAccess(IRNode.variable("__result"), "data", false), v.name, false);
				constructorBody.push(IRNode.assignment(IRNode.fieldAccess(payload, self.hostedAbi.lexicalBindingCName(par.name, false), false), IRNode.variable(self.lexicalBindingCName(par.name))));
				p2 = p2 + 1;
			}
			constructorBody.push(IRNode.returnStatement(IRNode.variable("__result")));
			constructor.body = IRNode.block(constructorBody);
			m.functions.push(constructor);
			v4 = v4 + 1;
		}
		/* toString over the tag field. Pushed into m.functions so DCE prunes it
         * when unused (mirrors enums._emit_rich_enum's function_defs.append). */
		m.functions.push(self.enumToStringFn(name, d.variants, true));
	}

	/* Build `<Name>_toString` as structured comparisons so aliases remain
     * valid and the function still flows through reachability DCE. */
	public IRFunction enumToStringFn(string name, Vector<Node> items, bool rich) {
		IRNode switchExpr = IRNode.variable("val");
		if (rich) { switchExpr = IRNode.fieldAccess(IRNode.variable("val"), "tag", false); }
		Vector<IRNode> bodyStmts = [];
		int i = 0;
		while (i < items.len) {
			Node it = items.get(i);
			string caseLabel = name + "_" + it.name;
			if (rich) { caseLabel = caseLabel + "_TAG"; }
			Vector<IRNode> matchBody = [];
			matchBody.push(IRNode.returnStatement(IRNode.literal("\"" + it.name + "\"")));
			bodyStmts.push(IRNode.ifStatement(IRNode.binary(switchExpr, "==", IRNode.variable(caseLabel)), IRNode.block(matchBody), null));
			i = i + 1;
		}
		bodyStmts.push(IRNode.returnStatement(IRNode.literal("\"unknown\"")));
		IRFunction fn = IRFunction();
		fn.name = name + "_toString";
		fn.returnType = "const char*";
		fn.isStatic = true;
		fn.archiveExport = true;
		fn.params.push(IRParam(name, "val"));
		fn.body = IRNode.block(bodyStmts);
		return fn;
	}

	/* Lower a source `struct` definition to IRStructDef (mirrors
     * emit_struct_decl). An array field (`int buf[8]`) keeps its bound as an
     * IR expression and drops the array-ness from the element type. */
	public void emitStructDecl(Node d, IRModule m) {
		CallableFlowState callableFlow = CallableFlowState();
		IRStructDef sd = IRStructDef();
		sd.name = d.name;
		string declarationKey = AstIdentity.key(d);
		if (self.context.packAlignments.has(declarationKey)) {
			sd.packAlignment = self.context.packAlignments.get(declarationKey);
		}
		int i = 0;
		while (i < d.fields.len) {
			Node f = d.fields.get(i);
			if (f.type != null && f.type.isArray && f.type.arraySize != null) {
				Node baseType = TypeShape.withoutOuterArray(f.type);
				Map<string, Node> empty = {};
				IRStructField field = IRStructField(self.cTypes.lower(baseType), f.name);
				field.arraySize = self.expressions.lowerExpr(f.type.arraySize, empty, callableFlow);
				field.isVolatile = f.type.isVolatile;
				field.effectiveIsVolatile = SemanticTypeSystem.typeEffectiveOuterVolatile(f.type, self.analyzed.typedefTable);
				sd.fields.push(field);
			} else {
				IRStructField field = IRStructField(self.cTypes.lower(f.type), f.name);
				field.isVolatile = f.type != null && f.type.isVolatile;
				field.effectiveIsVolatile = SemanticTypeSystem.typeEffectiveOuterVolatile(f.type, self.analyzed.typedefTable);
				sd.fields.push(field);
			}
			i = i + 1;
		}
		m.structDefs.push(sd);
	}

	/* Top-level variable -> file-scope C global (mirrors _emit_declarations'
     * VarDeclStmt branch). Default storage is `static` (file linkage). A bare
     * `extern` remains an uninitialized declaration; a separate ordinary
     * definition paired with it receives external linkage. */
	public void emitGlobalVar(Node d, IRModule m, bool forceExternal) {
		CallableFlowState callableFlow = CallableFlowState();
		if (d.initializer != null) {
			Map<string, Node> globalTypes = {};
			CallableBoundaryContext callableContext = callableFlow.boundaryContext(globalTypes, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
			bool unsafe = callableFlow.persistentStorageUnsafe(d.type, d.initializer, self.callableValues, callableContext);
			self.callableBoundaries.rejectPersistentStorage(d.type, d.initializer, callableContext, unsafe, "global storage");
		}
		bool inferredArray = d.initializer != null && (d.initializer.kind == NK_LIST_LITERAL || d.initializer.kind == NK_BRACE_INITIALIZER);
		if (d.type != null && d.type.isArray && (d.type.arraySize != null || inferredArray || d.type.isExtern)) {
			Node elementType = TypeShape.withoutOuterArray(d.type);
			IRGlobalDecl global = IRGlobalDecl(self.cTypes.lower(elementType), d.name);
			global.isExtern = d.type.isExtern && !forceExternal;
			global.isStatic = !(global.isExtern || forceExternal);
			global.isVolatile = d.type.isVolatile;
			global.effectiveIsVolatile = SemanticTypeSystem.typeEffectiveOuterVolatile(d.type, self.analyzed.typedefTable);
			Map<string, Node> empty = {};
			if (d.type.arraySize != null) {
				global.arraySize = self.expressions.lowerExpr(d.type.arraySize, empty, callableFlow);
			} else if (inferredArray) {
				global.arraySize = IRNode.literal(Strings.fromInt(d.initializer.elements.len));
			} else {
				global.isUnsizedArray = true;
			}
			if (d.initializer != null) {
				global.init = self.expressions.lowerStaticInitializer(d.initializer, d.type, empty, callableFlow);
			}
			m.globalDecls.push(global);
			return;
		}
		string ct = "int";
		if (d.type != null) { ct = self.cTypes.lower(d.type); }
		IRGlobalDecl global = IRGlobalDecl(ct, d.name);
		global.isExtern = d.type != null && d.type.isExtern && !forceExternal;
		global.isStatic = !(global.isExtern || forceExternal);
		if (d.type != null) {
			global.isVolatile = d.type.isVolatile;
			global.effectiveIsVolatile = SemanticTypeSystem.typeEffectiveOuterVolatile(d.type, self.analyzed.typedefTable);
		}
		if (d.initializer != null && !global.isExtern) {
			Map<string, Node> empty = {};
			global.init = self.expressions.lowerStaticInitializer(d.initializer, d.type, empty, callableFlow);
		}
		m.globalDecls.push(global);
	}

	/* A supported preprocessor directive becomes a validated typed declaration;
     * #pragma pack has already become per-struct metadata. */
	public void emitPreprocessor(Node d, IRModule m) {
		string text = self.preprocessorTrim(d.text);
		if (self.isPackPragma(text)) { return; }
		self.lowerPreprocessorDirective(d.text, m);
	}

	/* Emit one generic instance: struct, typed callable declarations, then
     * init/new/destroy + methods (all `static`). */
	public void emitGenericInstance(GenInstance inst, IRModule m) {
		/* The same source AST is lowered once per concrete type map. Never let
         * one instance reuse another instance's inferred expression type. */
		self.functions.resetExpressionInferenceMemo();
		Node decl = self.analyzed.genericClassTable.get(inst.base);
		string mangled = inst.mangled;
		Map<string, Node> typeMap = {};
		int g = 0;
		while (g < decl.genericParams.len && g < inst.args.len) {
			typeMap.put(decl.genericParams.get(g), inst.args.get(g));
			g = g + 1;
		}

		/* ARC header, then resolved fields. */
		IRStructDef sd = IRStructDef();
		sd.name = mangled;
		self.managedTypes.appendHeaderField(sd);
		int fi = 0;
		while (fi < decl.members.len) {
			Node mem = decl.members.get(fi);
			string storage = DeclarationRegistry.instanceStorageName(mem);
			if (storage != "") {
				sd.fields.push(self.genericField(mem, storage, typeMap));
			}
			fi = fi + 1;
		}
		m.structDefs.push(sd);

		/* Constructor params (resolved). */
		Node? ctor = self.functions.genericConstructor(decl);
		Vector<IRParam> ctorParams = [];
		if (ctor != null) {
			int p = 0;
			while (p < ctor.params.len) {
				Node pp = ctor.params.get(p);
				ctorParams.push(self.cTypes.lowerResolvedParameter(pp, SemanticTypeSystem.resolveGenericType(pp.type, typeMap, self.analyzed), self.cTypes.lowerGeneric(pp.type, typeMap)));
				p = p + 1;
			}
		}

		IRFunctionDecl initDeclaration = IRFunctionDecl(mangled + "_init", "void", true);
		initDeclaration.params.push(IRParam(mangled + "*", "self"));
		int cp = 0;
		while (cp < ctorParams.len) {
			initDeclaration.params.push(ctorParams.get(cp));
			cp = cp + 1;
		}
		m.functionDecls.push(initDeclaration);

		IRFunctionDecl newDeclaration = IRFunctionDecl(mangled + "_new", mangled + "*", true);
		int q = 0;
		while (q < ctorParams.len) {
			newDeclaration.params.push(ctorParams.get(q));
			q = q + 1;
		}
		m.functionDecls.push(newDeclaration);

		IRFunctionDecl destroyDeclaration = IRFunctionDecl(mangled + "_destroy", "void", true);
		destroyDeclaration.params.push(IRParam("void*", "object"));
		m.functionDecls.push(destroyDeclaration);
		int mi = 0;
		while (mi < decl.members.len) {
			Node mem = decl.members.get(mi);
			if (mem.kind == NK_METHOD_DECL && !mem.isConstructor && mem.name != "__del__" && mem.genericParams.len == 0) {
				string retC = self.cTypes.lowerGeneric(mem.returnType, typeMap);
				IRFunctionDecl methodDeclaration = IRFunctionDecl(mangled + "_" + mem.name, retC, true);
				methodDeclaration.params.push(IRParam(mangled + "*", "self"));
				int k = 0;
				while (k < mem.params.len) {
					Node pp = mem.params.get(k);
					methodDeclaration.params.push(self.cTypes.lowerResolvedParameter(pp, SemanticTypeSystem.resolveGenericType(pp.type, typeMap, self.analyzed), self.cTypes.lowerGeneric(pp.type, typeMap)));
					k = k + 1;
				}
				m.functionDecls.push(methodDeclaration);
			}
			mi = mi + 1;
		}
		self.emitGenericPropertyForwardDecls(inst, decl, typeMap, m);

		/* Set context for body lowering: self -> the generic instance type, and
         * mark we're inside a generic method (raw operator lowering). */
		string savedClass = self.context.currentClass;
		string savedReturnC = self.context.currentReturnCType;
		Node? savedReturnType = self.context.currentReturnType;
		bool savedReturnOwned = self.context.currentReturnOwned;
		bool savedBatchExplicitReleases = self.context.batchExplicitReleases;
		bool savedCollectionEdgeKeeps = self.context.collectionEdgeKeeps;
		self.context.currentClass = mangled;
		self.context.genericBody = true;
		self.context.activeTypeMap = typeMap;
		self.context.batchExplicitReleases = false;
		self.context.collectionEdgeKeeps = self.cycleBoundaries.publicCollectionBase(inst.base);

		/* --- _init --- */
		IRFunction initFn = IRFunction();
		initFn.name = mangled + "_init";
		initFn.returnType = "void";
		initFn.isStatic = true;
		initFn.params.push(IRParam(mangled + "*", "self"));
		int ip = 0;
		while (ip < ctorParams.len) { initFn.params.push(ctorParams.get(ip)); ip = ip + 1; }
		Vector<IRNode> ibody = [];
		self.managedTypes.appendHeaderInitialization(mangled, ibody);
		self.context.currentReturnCType = "void";
		self.context.currentReturnType = null;
		self.context.currentReturnOwned = true;
		self.functions.resetFuncVarDecls();
		Map<string, Node> genericCtorVars = self.genericInitializerVarTypes(inst, ctor);
		Vector<string> constructorSourceBindings = self.context.snapshotSourceBindings();
		Vector<string> noConstructorSourceBindings = [];
		self.context.restoreSourceBindings(noConstructorSourceBindings);
		if (ctor != null) {
			self.functions.activateSourceLexicalParameters(ctor.params);
		}
		self.appendInstanceFieldInitializers(decl, genericCtorVars, true, typeMap, ibody);
		Vector<IRNode> ctorBodyStmts = [];
		if (ctor != null && ctor.bodyNode != null) {
			IRNode blk = self.functions.lowerBody(ctor.bodyNode, genericCtorVars);
			int b = 0;
			while (b < blk.stmts.len) { ctorBodyStmts.push(blk.stmts.get(b)); b = b + 1; }
		}
		self.context.restoreSourceBindings(constructorSourceBindings);
		/* Empty ctor body -> (void)self; to avoid unused-param warning. */
		if (ctorBodyStmts.len == 0) {
			ctorBodyStmts.push(IRNode.expressionStatement(IRNode.cast("void", IRNode.variable("self"))));
		}
		int cb = 0;
		while (cb < ctorBodyStmts.len) { ibody.push(ctorBodyStmts.get(cb)); cb = cb + 1; }
		initFn.body = IRNode.block(ibody);
		m.functions.push(initFn);

		/* --- _new --- */
		IRFunction newFn = IRFunction();
		newFn.name = mangled + "_new";
		newFn.returnType = mangled + "*";
		newFn.isStatic = true;
		int np = 0;
		while (np < ctorParams.len) { newFn.params.push(ctorParams.get(np)); np = np + 1; }
		Vector<IRNode> nbody = [];
		self.context.referenceHelper("__btrc_safe_calloc");
		Vector<IRNode> callocArgs = [];
		callocArgs.push(IRNode.literal("1"));
		callocArgs.push(IRNode.sizeofType(mangled));
		nbody.push(IRNode.variableDeclaration(mangled + "*", "self", IRNode.cast(mangled + "*", IRNode.call("__btrc_safe_calloc", callocArgs))));
		string cleanupMark = self.beginConstructorCleanup("self", nbody);
		Vector<IRNode> initArgs = [];
		initArgs.push(IRNode.variable("self"));
		int ia = 0;
		while (ia < ctorParams.len) { initArgs.push(IRNode.variable(ctorParams.get(ia).name)); ia = ia + 1; }
		nbody.push(IRNode.expressionStatement(IRNode.call(mangled + "_init", initArgs)));
		self.endConstructorCleanup(cleanupMark, nbody);
		nbody.push(IRNode.returnStatement(IRNode.variable("self")));
		newFn.body = IRNode.block(nbody);
		m.functions.push(newFn);

		/* Lower source __del__ into its own function so a source return cannot
         * bypass compiler-owned terminal finalization. */
		Node? genericDestructor = self.analyzed.genericClassMethod(inst.base, "__del__");
		bool hasDestructorHook = genericDestructor != null && genericDestructor.bodyNode != null;
		if (genericDestructor != null && genericDestructor.bodyNode != null) {
			self.context.currentReturnCType = "void";
			self.context.currentReturnType = null;
			self.context.currentReturnOwned = true;
			self.functions.resetFuncVarDecls();
			Map<string, Node> destructorTypes = self.functions.genericMethodVarTypes(inst, genericDestructor);
			IRNode destructorBlock = self.functions.lowerBody(genericDestructor.bodyNode, destructorTypes);
			Vector<IRNode> hookBody = [];
			int hookStatement = 0;
			while (hookStatement < destructorBlock.stmts.len) {
				hookBody.push(destructorBlock.stmts.get(hookStatement));
				hookStatement = hookStatement + 1;
			}
			m.functions.push(self.buildDestructorHook(mangled, hookBody));
		}

		/* --- _destroy --- (terminal destructor). Source lifecycle behavior is
         * explicit in the isolated __del__ hook. An ordinary method named free
         * has no compiler meaning; terminal destruction always detaches every
         * compiler-owned managed field before freeing the instance struct. */
		IRFunction dFn = IRFunction();
		dFn.name = mangled + "_destroy";
		dFn.returnType = "void";
		dFn.isStatic = true;
		dFn.params.push(IRParam("void*", "object"));
		Vector<IRNode> dbody = [];
		dbody.push(IRNode.variableDeclaration(mangled + "*", "self", IRNode.cast(mangled + "*", IRNode.variable("object"))));
		bool hasGenericFieldReleases = self.functions.emitGenericFieldReleases(decl, typeMap, dbody);
		if (hasGenericFieldReleases) {
			self.context.referenceHelper("__btrc_mark_destroyed");
			Vector<IRNode> markArgs = [];
			markArgs.push(IRNode.variable("self"));
			dbody.push(IRNode.expressionStatement(IRNode.call("__btrc_mark_destroyed", markArgs)));
		}
		Vector<IRNode> freeArgs = [];
		freeArgs.push(IRNode.variable("self"));
		dbody.push(IRNode.expressionStatement(IRNode.call("free", freeArgs)));
		dFn.body = IRNode.block(dbody);
		m.functions.push(dFn);
		self.cycleBoundaries.emitGenericVisitor(inst, decl, typeMap, m);
		int interfaceCount = self.emitInterfaceBindings(mangled, decl, m);
		self.managedTypes.emitDescriptor(m, mangled, self.cycles.genericInstanceNeedsVisitor(inst), hasDestructorHook, interfaceCount);

		/* --- methods --- */
		int m2 = 0;
		while (m2 < decl.members.len) {
			Node mem = decl.members.get(m2);
			if (mem.kind == NK_METHOD_DECL && !mem.isConstructor && mem.name != "__del__" && mem.genericParams.len == 0) {
				IRFunction fn = IRFunction();
				fn.name = mangled + "_" + mem.name;
				Node rrt = SemanticTypeSystem.resolveGenericType(mem.returnType, typeMap, self.analyzed);
				string retC = self.cTypes.lowerGeneric(mem.returnType, typeMap);
				fn.returnType = retC;
				fn.isStatic = true;
				fn.params.push(IRParam(mangled + "*", "self"));
				int mp2 = 0;
				while (mp2 < mem.params.len) {
					Node pp = mem.params.get(mp2);
					fn.params.push(self.cTypes.lowerResolvedParameter(pp, SemanticTypeSystem.resolveGenericType(pp.type, typeMap, self.analyzed), self.cTypes.lowerGeneric(pp.type, typeMap)));
					mp2 = mp2 + 1;
				}
				self.context.currentReturnCType = retC;
				self.context.currentReturnType = rrt;
				self.context.currentReturnOwned = true;
				bool publicCollectionMethod = self.cycleBoundaries.publicCollectionBase(inst.base) && mem.access == "public";
				bool topologyCollection = self.cycleBoundaries.publicCollectionBase(inst.base) && self.cycles.genericInstanceNeedsVisitor(inst);
				self.context.batchExplicitReleases = publicCollectionMethod;
				Vector<IRNode> mbody = [];
				if (mem.bodyNode != null) {
					Vector<string> methodSourceBindings = self.functions.replaceSourceLexicalParameters(mem.params);
					self.functions.resetFuncVarDecls();
					Map<string, Node> vt = self.functions.genericMethodVarTypes(inst, mem);
					IRNode blk = self.functions.lowerBody(mem.bodyNode, vt);
					int b = 0;
					while (b < blk.stmts.len) { mbody.push(blk.stmts.get(b)); b = b + 1; }
					self.context.restoreSourceBindings(methodSourceBindings);
				}
				if (mbody.len == 0) {
					mbody.push(IRNode.expressionStatement(IRNode.cast("void", IRNode.variable("self"))));
				}
				fn.body = IRNode.block(mbody);
				if (topologyCollection) {
					self.cycleBoundaries.installCollectionTopologyBoundary(fn);
				}
				if (publicCollectionMethod) {
					self.cycleReturns.installReleaseBearingBoundary(fn);
				}
				m.functions.push(fn);
			}
			m2 = m2 + 1;
		}
		self.emitGenericProperties(inst, decl, typeMap, m);
		self.context.currentClass = savedClass;
		self.context.currentReturnCType = savedReturnC;
		self.context.currentReturnType = savedReturnType;
		self.context.currentReturnOwned = savedReturnOwned;
		self.context.batchExplicitReleases = savedBatchExplicitReleases;
		self.context.collectionEdgeKeeps = savedCollectionEdgeKeeps;
		self.context.genericBody = false;
		self.context.activeTypeMap = {};
	}

	/* Emit every monomorphized generic-METHOD function recorded by the analyzer.
     * Each is emitted with a combined type map binding both the class type
     * params (T, ...) and the method type params (U, ...) to the concrete types
     * for that call site. Bodies lower via the same generic-method machinery so
     * cross-type dispatch (e.g. building a Vector<U> inside the body) resolves.
     * Mirrors generics.methods_mono.emit_generic_method_instances. */
	private void appendFunction(IRFunction callable, IRModule module) {
		var prototype = IRFunctionDecl(callable.name, callable.returnType, true);
		prototype.params = callable.params;
		module.functionDecls.push(prototype);
		module.functions.push(callable);
	}

	private void emitInterface(string name, IRModule module) {
		if (self.analyzed.interfaceTable.get(name).genericParams.len > 0) { return; }
		string tableName = f"__btrc_interface_{name.length()}_{name}";
		var table = IRStructDef();
		table.name = tableName;
		for method in self.analyzed.interfaceMethods(name) {
			var dispatch = IRFunction();
			dispatch.name = name + "_" + method.name;
			dispatch.returnType = self.cTypes.lower(method.returnType);
			dispatch.isStatic = true;
			dispatch.params.push(IRParam(name + "*", "self"));
			var signature = IRFunctionPointerTypedef(tableName + "_" + method.name + "_fn", dispatch.returnType);
			signature.paramTypes.push("void*");
			Vector<IRNode> arguments = [IRNode.variable("self")];
			for parameter in method.params {
				var lowered = self.cTypes.lowerParameter(parameter);
				dispatch.params.push(lowered);
				signature.paramTypes.push(lowered.cType);
				arguments.push(IRNode.variable(lowered.name));
			}
			module.functionPointerTypedefs.push(signature);
			table.fields.push(IRStructField(signature.name, method.name));
			self.context.referenceHelper("__btrc_interface_methods");
			IRNode lookup = IRNode.call("__btrc_interface_methods", [IRNode.variable("self"), IRNode.literal("\"" + name + "\"")]);
			string tableType = "const struct " + tableName + "*";
			IRNode methods = IRNode.variableDeclaration(tableType, "__btrc_methods", IRNode.cast(tableType, lookup));
			IRNode call = IRNode.indirectCall(IRNode.fieldAccess(IRNode.variable("__btrc_methods"), method.name, true), arguments);
			dispatch.body = IRNode.block([methods, dispatch.returnType == "void" ? IRNode.expressionStatement(call) : IRNode.returnStatement(call)]);
			self.appendFunction(dispatch, module);
		}
		if (table.fields.len > 0) { module.structDefs.push(table); }
	}

	private int emitInterfaceBindings(string emittedName, Node declaration, IRModule module) {
		if (declaration.isAbstract) { return 0; }
		Vector<IRNode> entries = [];
		Vector<string> names = self.analyzed.interfaceTable.keys().sorted();
		for name in names {
			if (self.analyzed.interfaceTable.get(name).genericParams.len > 0 || !self.analyzed.isSubclass(declaration.name, name)) { continue; }
			Vector<Node> requirements = self.analyzed.interfaceMethods(name);
			Vector<IRNode> methods = [];
			for requirement in requirements {
				var thunk = IRFunction();
				thunk.name = f"__btrc_interface_impl_{emittedName.length()}_{emittedName}_{name.length()}_{name}_{requirement.name}";
				thunk.returnType = self.cTypes.lower(requirement.returnType);
				thunk.isStatic = true;
				thunk.params.push(IRParam("void*", "__btrc_receiver"));
				Vector<IRNode> arguments = [IRNode.cast(emittedName + "*", IRNode.variable("__btrc_receiver"))];
				for parameter in requirement.params {
					var lowered = self.cTypes.lowerParameter(parameter);
					thunk.params.push(lowered);
					arguments.push(IRNode.variable(lowered.name));
				}
				IRNode call = IRNode.call(emittedName + "_" + requirement.name, arguments);
				thunk.body = IRNode.block([thunk.returnType == "void" ? IRNode.expressionStatement(call) : IRNode.returnStatement(call)]);
				self.appendFunction(thunk, module);
				methods.push(IRNode.functionReference(thunk.name));
			}
			var table = IRGlobalDecl(methods.len > 0 ? f"const struct __btrc_interface_{name.length()}_{name}" : "const unsigned char", f"__btrc_interface_table_{emittedName.length()}_{emittedName}_{name}");
			table.init = methods.len > 0 ? IRNode.initializerList(methods) : IRNode.literal("0");
			module.globalDecls.push(table);
			entries.push(IRNode.initializerList([IRNode.literal("\"" + name + "\""), IRNode.addressOf(IRNode.variable(table.name))]));
		}
		if (entries.len > 0) {
			var directory = IRGlobalDecl("const __btrc_interface_entry", "__btrc_interfaces_" + emittedName);
			directory.isUnsizedArray = true;
			directory.init = IRNode.initializerList(entries);
			module.globalDecls.push(directory);
		}
		return entries.len;
	}

	public void emitClassDecl(Node decl, IRModule m) {
		self.context.currentClass = decl.name;
		self.emitClassStruct(decl, m);
		self.emitClassStaticFields(decl, m);
		self.emitMethodForwardDecls(decl, m);
		self.emitConstructor(decl, m);
		bool hasDestructorHook = self.emitDestructor(decl, m);
		int interfaceCount = self.emitInterfaceBindings(decl.name, decl, m);
		self.managedTypes.emitDescriptor(m, decl.name, self.cycles.classNeedsVisitor(decl.name), hasDestructorHook, interfaceCount);

		/* Own methods + properties (skip constructor + __del__). */
		Map<string, bool> ownMethods = {};
		Map<string, bool> ownProperties = {};
		int i = 0;
		while (i < decl.members.len) {
			Node mem = decl.members.get(i);
			if (mem.kind == NK_METHOD_DECL && !mem.isConstructor && mem.name != "__del__") {
				ownMethods.put(mem.name, true);
				if (mem.genericParams.len == 0 && !mem.isAbstract && mem.bodyNode != null) {
					m.functions.push(self.lowerMethod(decl, mem));
				}
			} else if (mem.kind == NK_PROPERTY_DECL) {
				self.emitProperty(decl, mem, m);
				ownProperties.put(mem.name, true);
			}
			i = i + 1;
		}

		/* Inherited method wrappers for methods not overridden. */
		string par = DeclarationRegistry.parentName(decl);
		if (par != "" && self.analyzed.isClass(par)) {
			self.emitInheritedMethods(decl, ownMethods, m);
			self.emitInheritedProperties(decl, ownProperties, m);
		}
		self.context.currentClass = "";
	}

	/* Emit the struct: ARC header first, then parent fields, then own fields, then
     * property backing fields (mirrors _emit_class_struct). */
	public void emitClassStruct(Node decl, IRModule m) {
		IRStructDef sd = IRStructDef();
		sd.name = decl.name;
		string declarationKey = AstIdentity.key(decl);
		if (self.context.packAlignments.has(declarationKey)) {
			sd.packAlignment = self.context.packAlignments.get(declarationKey);
		}
		self.managedTypes.appendHeaderField(sd);
		/* Parent fields (single-level chain handled by recursion). */
		string par = DeclarationRegistry.parentName(decl);
		if (par != "" && self.analyzed.isClass(par)) {
			self.appendParentFields(par, sd);
		}
		int i = 0;
		while (i < decl.members.len) {
			Node mem = decl.members.get(i);
			string storage = DeclarationRegistry.instanceStorageName(mem);
			if (storage != "") {
				sd.fields.push(self.field(mem, storage));
			}
			i = i + 1;
		}
		m.structDefs.push(sd);
	}

	/* Append a parent class's own fields (recursively, ancestors first) into a
     * struct def. Python copies parent.fields (which already include ancestors)
     * in insertion order; we recurse parent-first to match. */
	public void appendParentFields(string cls, IRStructDef sd) {
		if (!self.analyzed.isClass(cls)) { return; }
		Node decl = self.analyzed.classTable.get(cls);
		string par = DeclarationRegistry.parentName(decl);
		if (par != "" && self.analyzed.isClass(par)) {
			self.appendParentFields(par, sd);
		}
		int i = 0;
		while (i < decl.members.len) {
			Node mem = decl.members.get(i);
			string storage = DeclarationRegistry.instanceStorageName(mem);
			if (storage != "") {
				sd.fields.push(self.field(mem, storage));
			}
			i = i + 1;
		}
	}

	/* Forward declarations for the constructor + own methods + inherited method
     * wrappers (mirrors _emit_method_forward_decls). */
	public void emitMethodForwardDecls(Node decl, IRModule m) {
		string name = decl.name;
		Node? ctor = self.analyzed.classConstructor(name);
		IRFunctionDecl initDeclaration = IRFunctionDecl(name + "_init", "void", false);
		initDeclaration.params.push(IRParam(name + "*", "self"));
		IRFunctionDecl newDeclaration = IRFunctionDecl(name + "_new", name + "*", false);
		if (ctor != null) {
			int constructorParam = 0;
			while (constructorParam < ctor.params.len) {
				Node parameter = ctor.params.get(constructorParam);
				IRParam irParameter = self.cTypes.lowerParameter(parameter);
				initDeclaration.params.push(irParameter);
				newDeclaration.params.push(self.cTypes.copyParameter(irParameter));
				constructorParam = constructorParam + 1;
			}
		}
		m.functionDecls.push(initDeclaration);
		m.functionDecls.push(newDeclaration);
		/* Own methods. */
		Map<string, bool> own = {};
		Map<string, bool> ownProperties = {};
		int i = 0;
		while (i < decl.members.len) {
			Node mem = decl.members.get(i);
			if (mem.kind == NK_METHOD_DECL) { own.put(mem.name, true); }
			if (mem.kind == NK_METHOD_DECL && !mem.isConstructor && mem.name != "__del__" && mem.genericParams.len == 0) {
				bool isStatic = mem.access == "class";
				string ret = self.cTypes.lower(mem.returnType);
				IRFunctionDecl methodDeclaration = IRFunctionDecl(name + "_" + mem.name, ret, false);
				if (!isStatic) {
					methodDeclaration.params.push(IRParam(name + "*", "self"));
				}
				int methodParam = 0;
				while (methodParam < mem.params.len) {
					Node parameter = mem.params.get(methodParam);
					methodDeclaration.params.push(self.cTypes.lowerParameter(parameter));
					methodParam = methodParam + 1;
				}
				m.functionDecls.push(methodDeclaration);
			} else if (mem.kind == NK_PROPERTY_DECL) {
				ownProperties.put(mem.name, true);
				string propertyType = self.cTypes.lower(mem.type);
				if (mem.hasGetter) {
					IRFunctionDecl getter = IRFunctionDecl(name + "_get_" + mem.name, propertyType, false);
					getter.params.push(IRParam(name + "*", "self"));
					m.functionDecls.push(getter);
				}
				if (mem.hasSetter) {
					IRFunctionDecl setter = IRFunctionDecl(name + "_set_" + mem.name, "void", false);
					setter.params.push(IRParam(name + "*", "self"));
					setter.params.push(self.cTypes.lowerNamedParameter(mem.type, propertyType, self.lexicalBindingCName("value")));
					m.functionDecls.push(setter);
				}
			}
			i = i + 1;
		}
		/* Inherited method wrapper fwds: the immediate parent's merged method
         * set, in order, minus this class's own methods. */
		string par = DeclarationRegistry.parentName(decl);
		if (par != "" && self.analyzed.isClass(par)) {
			Vector<MethodEntry> pm = self.analyzed.mergedMethods(par);
			int k = 0;
			while (k < pm.len) {
				MethodEntry e = pm.get(k);
				if (!own.has(e.name) && e.sig.genericParams.len == 0) {
					string ret = self.cTypes.lower(e.sig.returnType);
					IRFunctionDecl wrapper = IRFunctionDecl(name + "_" + e.name, ret, false);
					if (e.sig.access != "class") {
						wrapper.params.push(IRParam(name + "*", "self"));
					}
					int wrapperParam = 0;
					while (wrapperParam < e.sig.params.len) {
						Node parameter = e.sig.params.get(wrapperParam);
						wrapper.params.push(self.cTypes.lowerParameter(parameter));
						wrapperParam = wrapperParam + 1;
					}
					m.functionDecls.push(wrapper);
				}
				k = k + 1;
			}
		}
		self.emitInheritedPropertyForwardDecls(decl, ownProperties, m);
	}

	/* "T1 n1, T2 n2, ..." for a param list (empty string for no params). */

	/* Emit X_init(self, ...) and X_new(...) (mirrors _emit_constructor). */
	public void emitConstructor(Node decl, IRModule m) {
		string name = decl.name;
		Node? ctor = self.analyzed.classConstructor(name);

		/* X_init params: self + ctor params. */
		IRFunction initFn = IRFunction();
		initFn.name = name + "_init";
		initFn.returnType = "void";
		initFn.params.push(IRParam(name + "*", "self"));
		if (ctor != null) {
			int i = 0;
			while (i < ctor.params.len) {
				Node p = ctor.params.get(i);
				initFn.params.push(self.cTypes.lowerParameter(p));
				i = i + 1;
			}
		}
		Vector<IRNode> body = [];
		self.managedTypes.appendHeaderInitialization(name, body);
		self.context.currentReturnCType = "void";
		self.context.currentReturnType = null;
		self.context.currentReturnOwned = true;
		self.functions.resetFuncVarDecls();
		Map<string, Node> ctorVars = self.ctorVarTypes(decl, ctor);
		Vector<string> sourceBindings = self.context.snapshotSourceBindings();
		Vector<string> noSourceBindings = [];
		self.context.restoreSourceBindings(noSourceBindings);
		if (ctor != null) {
			self.functions.activateSourceLexicalParameters(ctor.params);
		}
		Map<string, Node> noTypeMap = {};
		self.appendInstanceFieldInitializers(decl, ctorVars, false, noTypeMap, body);
		/* Constructor body (user code). */
		if (ctor != null && ctor.bodyNode != null) {
			IRNode blk = self.functions.lowerBody(ctor.bodyNode, ctorVars);
			int k = 0;
			while (k < blk.stmts.len) { body.push(blk.stmts.get(k)); k = k + 1; }
		}
		self.context.restoreSourceBindings(sourceBindings);
		initFn.body = IRNode.block(body);
		m.functions.push(initFn);

		/* X_new: checked zeroed allocation + init + return. */
		IRFunction newFn = IRFunction();
		newFn.name = name + "_new";
		newFn.returnType = name + "*";
		Vector<IRNode> nbody = [];
		self.context.referenceHelper("__btrc_safe_calloc");
		Vector<IRNode> callocArgs = [];
		callocArgs.push(IRNode.literal("1"));
		callocArgs.push(IRNode.sizeofType(name));
		IRNode callocCall = IRNode.cast(name + "*", IRNode.call("__btrc_safe_calloc", callocArgs));
		nbody.push(IRNode.variableDeclaration(name + "*", "self", callocCall));
		string cleanupMark = self.beginConstructorCleanup("self", nbody);
		Vector<IRNode> initArgs = [];
		initArgs.push(IRNode.variable("self"));
		if (ctor != null) {
			int p = 0;
			while (p < ctor.params.len) {
				newFn.params.push(self.cTypes.lowerParameter(ctor.params.get(p)));
				initArgs.push(IRNode.variable(self.lexicalBindingCName(ctor.params.get(p).name)));
				p = p + 1;
			}
		}
		nbody.push(IRNode.expressionStatement(IRNode.call(name + "_init", initArgs)));
		self.endConstructorCleanup(cleanupMark, nbody);
		nbody.push(IRNode.returnStatement(IRNode.variable("self")));
		newFn.body = IRNode.block(nbody);
		m.functions.push(newFn);
	}

	/* var-type map for lowering a constructor body: `self` -> class type, plus
     * each ctor param -> its declared type. */
	public Map<string, Node> ctorVarTypes(Node decl, Node? ctor) {
		Map<string, Node> vt = self.functions.seededVarTypes();
		vt.put("self", SemanticTypeSystem.classReference(SemanticTypeSystem.namedClass(decl.name)));
		if (ctor != null) {
			int i = 0;
			while (i < ctor.params.len) {
				Node p = ctor.params.get(i);
				vt.put(p.name, p.type);
				i = i + 1;
			}
		}
		return vt;
	}

	/* Emit an isolated source __del__ hook followed by X_destroy(self), whose
     * field detachment and free cannot be bypassed by a source return. */
	public bool emitDestructor(Node decl, IRModule m) {
		string name = decl.name;
		IRFunction fn = IRFunction();
		fn.name = name + "_destroy";
		fn.returnType = "void";
		fn.params.push(IRParam("void*", "object"));
		Vector<IRNode> body = [];
		body.push(IRNode.variableDeclaration(name + "*", "self", IRNode.cast(name + "*", IRNode.variable("object"))));
		Node? dtor = self.analyzed.classMethod(name, "__del__");
		if (dtor != null && dtor.kind == NK_METHOD_DECL && dtor.bodyNode != null) {
			self.context.currentReturnCType = "void";
			self.context.currentReturnType = null;
			self.context.currentReturnOwned = true;
			self.functions.resetFuncVarDecls();
			Map<string, Node> vt = self.functions.seededVarTypes();
			vt.put("self", SemanticTypeSystem.classReference(SemanticTypeSystem.namedClass(name)));
			IRNode blk = self.functions.lowerBody(dtor.bodyNode, vt);
			Vector<IRNode> hookBody = [];
			int k = 0;
			while (k < blk.stmts.len) {
				hookBody.push(blk.stmts.get(k));
				k = k + 1;
			}
			m.functions.push(self.buildDestructorHook(name, hookBody));
		}
		/* Release class-instance fields (own + inherited), in source order. */
		bool hasFieldReleases = self.emitFieldReleases(name, body);
		/* Mark cascade destruction before freeing. The helper itself checks
         * the process-wide unwind scope under the ARC mutation lock. */
		if (hasFieldReleases) {
			Vector<IRNode> mdArgs = [];
			mdArgs.push(IRNode.variable("self"));
			body.push(IRNode.expressionStatement(IRNode.call("__btrc_mark_destroyed", mdArgs)));
		}
		/* free(self) */
		Vector<IRNode> fargs = [];
		fargs.push(IRNode.variable("self"));
		body.push(IRNode.expressionStatement(IRNode.call("free", fargs)));
		fn.body = IRNode.block(body);
		m.functions.push(fn);
		/* ARC: cycle-detection visitor for cyclable classes (after the dtor so
         * the visitor's forward use of {name}_destroy is already declared).
         * Mirrors classes._emit_visitor, gated on is_cyclable. */
		if (self.cycles.classNeedsVisitor(name)) {
			self.emitVisitor(name, m);
		}
		return dtor != null && dtor.kind == NK_METHOD_DECL && dtor.bodyNode != null;
	}

	/* Emit an exactly type-erased `X_visit(void*, callback)` which calls fn on
     * the ADDRESS of each cyclable-class field, so the cycle collector can trial-
     * decrement or NULL them. A cyclable class always gets a visitor even with no
     * directly-cyclable field (the collector references X_visit unconditionally).
    * Mirrors classes._emit_visitor. */
	public void emitVisitor(string name, IRModule m) {
		self.context.referenceHelper("__btrc_arc_callback_types");
		IRFunctionDecl visitorDeclaration = IRFunctionDecl(self.cycles.visitorName(name), "void", true);
		visitorDeclaration.params.push(IRParam("void*", "object"));
		visitorDeclaration.params.push(IRParam("__btrc_field_visit_fn", "fn"));
		visitorDeclaration.params.push(IRParam("void*", "context"));
		m.functionDecls.push(visitorDeclaration);

		IRFunction fn = IRFunction();
		fn.name = self.cycles.visitorName(name);
		fn.returnType = "void";
		fn.isStatic = true;
		fn.archiveExport = true;
		fn.params.push(IRParam("void*", "object"));
		fn.params.push(IRParam("__btrc_field_visit_fn", "fn"));
		fn.params.push(IRParam("void*", "context"));
		Vector<IRNode> body = [];
		body.push(IRNode.variableDeclaration(name + "*", "self", IRNode.cast(name + "*", IRNode.variable("object"))));

		Vector<Node> fields = [];
		self.cycles.collectClassFields(name, fields);
		bool visited = false;
		int i = 0;
		while (i < fields.len) {
			Node fd = fields.get(i);
			Node ft = fd.type;
			if (ft != null) {
				IRNode field = IRNode.fieldAccess(IRNode.variable("self"), DeclarationRegistry.instanceStorageName(fd), true);
				if (self.cycleBoundaries.appendClassFieldVisit(ft, field, body)) {
					visited = true;
				}
			}
			i = i + 1;
		}
		if (!visited) {
			body.push(IRNode.expressionStatement(IRNode.cast("void", IRNode.variable("self"))));
			body.push(IRNode.expressionStatement(IRNode.cast("void", IRNode.variable("fn"))));
			body.push(IRNode.expressionStatement(IRNode.cast("void", IRNode.variable("context"))));
		}
		fn.body = IRNode.block(body);
		m.functions.push(fn);
	}

	/* Append `if (self->f) { if (--self->f->__rc <= 0) F_destroy(self->f); }` for
     * each class-instance field of `cls` (and ancestors). Mirrors emit_destructor
     * field-release loop (cls_info.fields iterates own+inherited). */
	public bool emitFieldReleases(string cls, Vector<IRNode> body) {
		/* Build the ordered field list the way Python's cls_info.fields does:
         * inherited first, then own. */
		Vector<Node> fields = [];
		self.cycles.collectClassFields(cls, fields);
		bool any = false;
		int i = 0;
		while (i < fields.len) {
			Node fd = fields.get(i);
			Node ft = fd.type;
			if (self.managedValues.isManaged(self.cTypes.resolveBodyType(ft, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))) {
				body.push(self.managedTypes.releaseField(DeclarationRegistry.instanceStorageName(fd), ft));
				if (self.managedValues.isArc(self.cTypes.resolveBodyType(ft, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))) {
					any = true;
				}
			}
			i = i + 1;
		}
		return any;
	}

	/* Lower a method to X_method(self, params...) (mirrors emit_method). */
	public IRFunction lowerMethod(Node decl, Node method) {
		string name = decl.name;
		bool isStatic = method.access == "class";
		IRFunction fn = IRFunction();
		fn.name = name + "_" + method.name;
		fn.isRealtime = method.isRealtime;
		string ret = self.cTypes.lower(method.returnType);
		fn.returnType = ret;
		Map<string, Node> vt = self.functions.seededVarTypes();
		if (!isStatic) {
			fn.params.push(IRParam(name + "*", "self"));
			vt.put("self", SemanticTypeSystem.classReference(SemanticTypeSystem.namedClass(name)));
		}
		int i = 0;
		while (i < method.params.len) {
			Node p = method.params.get(i);
			fn.params.push(self.cTypes.lowerParameter(p));
			vt.put(p.name, p.type);
			i = i + 1;
		}
		self.context.currentReturnCType = ret;
		self.context.currentReturnType = method.returnType;
		self.context.currentReturnOwned = true;
		self.functions.resetFuncVarDecls();
		if (method.bodyNode != null) {
			Vector<string> sourceBindings = self.functions.replaceSourceLexicalParameters(method.params);
			/* Hoist to a local: btrcpy double-evaluates `field = call()`. */
			IRNode mb = self.functions.lowerBody(method.bodyNode, vt);
			fn.body = mb;
			self.context.restoreSourceBindings(sourceBindings);
		} else {
			Vector<IRNode> empty = [];
			fn.body = IRNode.block(empty);
		}
		return fn;
	}

	/* Emit getter/setter for a property (mirrors emit_property). */
	/* Auto-property backing storage is declaration-owned: it is generated
     * alongside the setter and never participates in recursive expression
     * dispatch. */
	private void emitAutoPropertyStore(Node propertyType, IRNode target, IRNode value, Vector<IRNode> body) {
		Node concreteType = self.cTypes.resolveBodyType(propertyType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
		if (!self.managedValues.isManaged(concreteType)) {
			body.push(IRNode.assignment(target, value));
			return;
		}
		if (self.managedValues.isArc(concreteType)) {
			body.push(IRNode.expressionStatement(self.managedLifetime.replaceEdge(target, value, propertyType, IRNode.variable("self"), false)));
			string runtimeType = self.managedValues.runtimeType(concreteType);
			if (self.cycles.runtimeTypeMayCycle(runtimeType)) {
				body.push(IRNode.expressionStatement(self.managedLifetime.pollCycles()));
			}
			return;
		}
		string oldName = self.context.freshTemporary("__btrc_property_old");
		IRNode oldDeclaration = IRNode.variableDeclaration(self.cTypes.lower(propertyType), oldName, target);
		self.context.recordLocal(oldDeclaration);
		body.push(oldDeclaration);
		body.push(IRNode.expressionStatement(self.managedLifetime.unlinkEdge(IRNode.variable(oldName), propertyType, IRNode.variable("self"))));
		body.push(IRNode.expressionStatement(self.managedLifetime.retainEdge(value, propertyType, IRNode.variable("self"))));
		body.push(IRNode.assignment(target, value));
		body.push(IRNode.expressionStatement(self.managedLifetime.releaseEdge(IRNode.variable(oldName), propertyType, value)));
		string runtimeType = self.managedValues.runtimeType(concreteType);
		if (self.cycles.runtimeTypeMayCycle(runtimeType)) {
			body.push(IRNode.expressionStatement(self.managedLifetime.pollCycles()));
		}
	}

	public void emitProperty(Node decl, Node prop, IRModule m) {
		string name = decl.name;
		string propType = self.cTypes.lower(prop.type);
		string backing = DeclarationRegistry.instanceStorageName(prop);
		string savedReturnC = self.context.currentReturnCType;
		Node? savedReturnType = self.context.currentReturnType;
		bool savedReturnOwned = self.context.currentReturnOwned;
		string savedPropertyBacking = self.context.currentPropertyBacking;
		if (prop.hasGetter) {
			IRFunction g = IRFunction();
			g.name = name + "_get_" + prop.name;
			g.returnType = propType;
			g.params.push(IRParam(name + "*", "self"));
			Vector<IRNode> gb = [];
			if (prop.getterBody != null) {
				self.context.currentReturnCType = propType;
				self.context.currentReturnType = prop.type;
				/* Custom getters are call-shaped +1 projections. */
				self.context.currentReturnOwned = true;
				if (DeclarationRegistry.propertyNeedsBacking(prop)) {
					self.context.currentPropertyBacking = prop.name;
				} else {
					self.context.currentPropertyBacking = "";
				}
				self.functions.resetFuncVarDecls();
				Map<string, Node> vt = self.functions.seededVarTypes();
				vt.put("self", SemanticTypeSystem.classReference(SemanticTypeSystem.namedClass(name)));
				IRNode blk = self.functions.lowerBody(prop.getterBody, vt);
				self.context.currentPropertyBacking = savedPropertyBacking;
				int k = 0;
				while (k < blk.stmts.len) { gb.push(blk.stmts.get(k)); k = k + 1; }
			} else {
				gb.push(IRNode.returnStatement(IRNode.fieldAccess(IRNode.variable("self"), backing, true)));
			}
			g.body = IRNode.block(gb);
			m.functions.push(g);
		}
		if (prop.hasSetter) {
			string valueCName = self.lexicalBindingCName("value");
			IRFunction s = IRFunction();
			s.name = name + "_set_" + prop.name;
			s.returnType = "void";
			s.params.push(IRParam(name + "*", "self"));
			s.params.push(self.cTypes.lowerNamedParameter(prop.type, propType, valueCName));
			Vector<IRNode> sb = [];
			if (prop.setterBody != null) {
				self.context.currentReturnCType = "void";
				self.context.currentReturnType = null;
				self.context.currentReturnOwned = false;
				if (DeclarationRegistry.propertyNeedsBacking(prop)) {
					self.context.currentPropertyBacking = prop.name;
				} else {
					self.context.currentPropertyBacking = "";
				}
				self.functions.resetFuncVarDecls();
				Map<string, Node> vt = self.functions.seededVarTypes();
				vt.put("self", SemanticTypeSystem.classReference(SemanticTypeSystem.namedClass(name)));
				vt.put("value", prop.type);
				Vector<string> sourceBindings = self.context.snapshotSourceBindings();
				Vector<string> noSourceBindings = [];
				self.context.restoreSourceBindings(noSourceBindings);
				self.context.activateSourceName("value", self.lexicalBindingCName("value"));
				IRNode blk = self.functions.lowerBody(prop.setterBody, vt);
				self.context.currentPropertyBacking = savedPropertyBacking;
				self.context.restoreSourceBindings(sourceBindings);
				int k = 0;
				while (k < blk.stmts.len) { sb.push(blk.stmts.get(k)); k = k + 1; }
			} else {
				self.emitAutoPropertyStore(prop.type, IRNode.fieldAccess(IRNode.variable("self"), backing, true), IRNode.variable(valueCName), sb);
			}
			s.body = IRNode.block(sb);
			m.functions.push(s);
		}
		self.context.currentReturnCType = savedReturnC;
		self.context.currentReturnType = savedReturnType;
		self.context.currentReturnOwned = savedReturnOwned;
		self.context.currentPropertyBacking = savedPropertyBacking;
	}

	/* Emit wrapper functions for inherited methods not overridden (mirrors
     * emit_inherited_methods). Each wrapper casts self to the IMMEDIATE parent
     * type and calls the immediate parent's method, which itself may be a wrapper
     * (single-hop chaining). Iterates the immediate parent's merged method set. */
	public void emitInheritedMethods(Node decl, Map<string, bool> ownMethods, IRModule m) {
		string name = decl.name;
		string par = DeclarationRegistry.parentName(decl);
		if (par == "" || !self.analyzed.isClass(par)) { return; }
		Vector<MethodEntry> pm = self.analyzed.mergedMethods(par);
		int i = 0;
		while (i < pm.len) {
			MethodEntry e = pm.get(i);
			if (!ownMethods.has(e.name) && e.sig.genericParams.len == 0) {
				ownMethods.put(e.name, true);
				Node mem = e.sig;
				IRFunction fn = IRFunction();
				fn.name = name + "_" + e.name;
				string ret = self.cTypes.lower(mem.returnType);
				fn.returnType = ret;
				Vector<IRNode> callArgs = [];
				if (mem.access != "class") {
					fn.params.push(IRParam(name + "*", "self"));
					callArgs.push(IRNode.cast(par + "*", IRNode.variable("self")));
				}
				int j = 0;
				while (j < mem.params.len) {
					Node p = mem.params.get(j);
					fn.params.push(self.cTypes.lowerParameter(p));
					callArgs.push(IRNode.variable(self.lexicalBindingCName(p.name)));
					j = j + 1;
				}
				IRNode call = IRNode.call(par + "_" + e.name, callArgs);
				Vector<IRNode> wbody = [];
				if (ret == "void") {
					wbody.push(IRNode.expressionStatement(call));
				} else {
					wbody.push(IRNode.returnStatement(call));
				}
				fn.body = IRNode.block(wbody);
				m.functions.push(fn);
			}
			i = i + 1;
		}
	}

	/* Phase 1 forward declarations (mirrors _emit_forward_decls): for each
     * non-generic class, a `typedef struct X X;` and a `void X_destroy(X*);`
     * prototype; then prototypes for every non-main function with a body. Class
     * method/constructor prototypes are appended later by emitClassDecl. */
	public void appendEnumToStringForwardDecl(Node declaration, Vector<IRFunctionDecl> destination) {
		IRFunctionDecl toString = IRFunctionDecl(declaration.name + "_toString", "const char*", true);
		toString.params.push(IRParam(declaration.name, "val"));
		destination.push(toString);
	}

	public void appendRichEnumForwardDecls(Node declaration, Vector<IRFunctionDecl> destination) {
		int variantIndex = 0;
		while (variantIndex < declaration.variants.len) {
			Node variant = declaration.variants.get(variantIndex);
			IRFunctionDecl constructor = IRFunctionDecl(declaration.name + "_" + variant.name, declaration.name, true);
			int parameterIndex = 0;
			while (parameterIndex < variant.params.len) {
				Node parameter = variant.params.get(parameterIndex);
				constructor.params.push(self.cTypes.lowerParameter(parameter));
				parameterIndex = parameterIndex + 1;
			}
			destination.push(constructor);
			variantIndex = variantIndex + 1;
		}
		self.appendEnumToStringForwardDecl(declaration, destination);
	}

	public void emitForwardDecls(Node prog, IRModule m) {
		Vector<IRFunctionDecl> functionDeclarations = [];
		int i = 0;
		while (i < prog.declarations.len) {
			Node d = prog.declarations.get(i);
			if (self.analyzed.isNativeDeclaration(d) && d.kind != NK_INTERFACE_DECL) {
				i++;
				continue;
			}
			if (((d.kind == NK_CLASS_DECL || d.kind == NK_INTERFACE_DECL) && d.genericParams.len == 0) || d.kind == NK_STRUCT_DECL || d.kind == NK_RICH_ENUM_DECL) {
				/* Both non-generic classes and raw structs get a typed forward
                 * so a function prototype can name `struct X*` before X is
                 * defined (mirrors legacy forward-declaration phase-1, which
                 * tests ClassDecl OR StructDecl). Only classes get _destroy. */
				m.structForwards.push(IRStructForward(d.name));
				if (d.kind == NK_CLASS_DECL && d.genericParams.len == 0) {
					IRFunctionDecl destroyDeclaration = IRFunctionDecl(d.name + "_destroy", "void", false);
					destroyDeclaration.params.push(IRParam("void*", "object"));
					functionDeclarations.push(destroyDeclaration);
				} else if (d.kind == NK_RICH_ENUM_DECL) {
					self.appendRichEnumForwardDecls(d, functionDeclarations);
				}
			} else if (d.kind == NK_ENUM_DECL && d.name != "") {
				self.appendEnumToStringForwardDecl(d, functionDeclarations);
			} else if (d.kind == NK_FUNCTION_DECL && !d.isGpu && d.bodyNode != null && d.name != "main") {
				string ret = self.cTypes.lower(d.returnType);
				IRFunctionDecl functionDeclaration = IRFunctionDecl(self.semanticDeclarations.sourceFunctionSymbol(d.name), ret, false);
				int parameter = 0;
				while (parameter < d.params.len) {
					Node sourceParameter = d.params.get(parameter);
					functionDeclaration.params.push(self.cTypes.lowerParameter(sourceParameter));
					parameter = parameter + 1;
				}
				functionDeclarations.push(functionDeclaration);
			}
			i = i + 1;
		}
		/* Forward typedefs for concrete generic instances, in discovery order
         * (mirrors legacy forward-declaration phase-1 generic loop). These
         * come after the non-generic class typedefs and before function fwds. */
		int g = 0;
		while (g < self.analyzed.genericInstances.len) {
			GenInstance gi = self.analyzed.genericInstances.get(g);
			m.structForwards.push(IRStructForward(gi.mangled));
			g = g + 1;
		}
		/* Tuple struct definitions + typedefs (mirrors _emit_tuple_structs):
         * emitted after the generic typedefs and before the deferred function
         * forward decls, so a tuple-returning function's prototype sees the
         * tuple's typedef. */
		self.emitTupleStructs(prog, m);
		int j = 0;
		while (j < functionDeclarations.len) {
			m.functionDecls.push(functionDeclarations.get(j));
			j = j + 1;
		}
	}

	/* Scan all declarations (function return/param types, class method return
     * types) and bodies for tuple types, then emit one struct def + forward
     * typedef per unique mangled tuple. Mirrors legacy tuple emission
     * (the body walk substitutes for Python's node_types scan). */
	public void emitTupleStructs(Node prog, IRModule m) {
		Map<string, bool> seen = {};
		Vector<string> order = [];
		Vector<Node> tupleTypes = [];
		int i = 0;
		while (i < prog.declarations.len) {
			Node d = prog.declarations.get(i);
			if (d.kind == NK_FUNCTION_DECL) {
				self.collectTupleTypes(d.returnType, seen, order, tupleTypes);
				int p = 0;
				while (p < d.params.len) {
					self.collectTupleTypes(d.params.get(p).type, seen, order, tupleTypes);
					p = p + 1;
				}
				self.collectTupleTypesBody(d.bodyNode, seen, order, tupleTypes);
			} else if (d.kind == NK_CLASS_DECL) {
				int mi = 0;
				while (mi < d.members.len) {
					Node mem = d.members.get(mi);
					if (mem.kind == NK_METHOD_DECL) {
						self.collectTupleTypes(mem.returnType, seen, order, tupleTypes);
						int mp = 0;
						while (mp < mem.params.len) {
							self.collectTupleTypes(mem.params.get(mp).type, seen, order, tupleTypes);
							mp = mp + 1;
						}
						self.collectTupleTypesBody(mem.bodyNode, seen, order, tupleTypes);
					} else if (mem.kind == NK_FIELD_DECL) {
						/* A class field of tuple type (e.g. `(int,int) pos;`)
                         * references the tuple struct in the class body, so its
                         * typedef must be emitted. Python catches this via the
                         * field-access node_types scan. */
						self.collectTupleTypes(mem.type, seen, order, tupleTypes);
					} else if (mem.kind == NK_PROPERTY_DECL) {
						self.collectTupleTypes(mem.type, seen, order, tupleTypes);
					}
					mi = mi + 1;
				}
			}
			i = i + 1;
		}
		int instanceIndex = 0;
		while (instanceIndex < self.analyzed.genericInstances.len) {
			GenInstance instance = self.analyzed.genericInstances.get(instanceIndex);
			if (self.analyzed.genericClassTable.has(instance.base)) {
				Node genericDeclaration = self.analyzed.genericClassTable.get(instance.base);
				Node concreteInstanceType = SemanticTypeSystem.primitive(instance.base);
				concreteInstanceType.genericArgs = instance.args;
				Map<string, Node> substitutions = SemanticTypeSystem.genericTypeMap(self.analyzed, concreteInstanceType);
				int memberIndex = 0;
				while (memberIndex < genericDeclaration.members.len) {
					Node genericMember = genericDeclaration.members.get(memberIndex);
					if (genericMember.kind == NK_FIELD_DECL || genericMember.kind == NK_PROPERTY_DECL) {
						self.collectTupleTypes(SemanticTypeSystem.resolveGenericType(genericMember.type, substitutions, self.analyzed), seen, order, tupleTypes);
					}
					memberIndex = memberIndex + 1;
				}
			}
			instanceIndex = instanceIndex + 1;
		}
		int s = 0;
		while (s < order.len) {
			string mangled = order.get(s);
			Node tt = tupleTypes.get(s);
			IRStructDef sd = IRStructDef();
			sd.name = mangled;
			int f = 0;
			while (f < tt.genericArgs.len) {
				Node argument = tt.genericArgs.get(f);
				IRStructField tupleField = IRStructField(self.cTypes.lower(argument), f"_{f}");
				tupleField.isVolatile = argument.isVolatile;
				tupleField.effectiveIsVolatile = SemanticTypeSystem.typeEffectiveOuterVolatile(argument, self.analyzed.typedefTable);
				sd.fields.push(tupleField);
				f = f + 1;
			}
			m.structDefs.push(sd);
			m.structForwards.push(IRStructForward(mangled));
			s = s + 1;
		}
	}

	/* Recursively collect tuple types from a type expression (mirrors
     * legacy tuple collection). A tuple type has base "Tuple" with
     * generic_args holding the element types; nested tuples are collected too. */
	public void collectTupleTypes(Node? t, Map<string, bool> seen, Vector<string> order, Vector<Node> tupleTypes) {
		if (t == null) { return; }
		/* Recurse into element types FIRST so that a nested tuple used as a
         * field (e.g. the (string,bool) inside (int,(string,bool))) is emitted
         * before the enclosing struct that contains it — otherwise the outer
         * struct references an incomplete type. (Python gets this ordering
         * incidentally via its node_types scan, which sees the inner tuple's
         * standalone use first; doing dependencies-first here is robust.) */
		int i = 0;
		while (i < t.genericArgs.len) {
			self.collectTupleTypes(t.genericArgs.get(i), seen, order, tupleTypes);
			i = i + 1;
		}
		if (t.base == "Tuple" && t.genericArgs.len > 0) {
			string mangled = TypeIdentity.mangleGenericSymbol("Tuple", t.genericArgs);
			if (!seen.has(mangled)) {
				seen.put(mangled, true);
				order.push(mangled);
				tupleTypes.push(t);
			}
		}
	}

	/* Walk a function/method body for tuple types appearing on local var decls
     * and tuple literals. This stands in for the Python node_types scan, which
     * the on-demand inference design of this compiler doesn't maintain. */
	public void collectTupleTypesBody(Node? n, Map<string, bool> seen, Vector<string> order, Vector<Node> tupleTypes) {
		if (n == null) { return; }
		if (n.kind == NK_VAR_DECL_STMT) {
			self.collectTupleTypes(n.type, seen, order, tupleTypes);
			/* `var t = (1, 2)` declares t with an inferred tuple type and a null
             * annotation, so scanning n.type alone misses the tuple. Infer the
             * type from the initializer (Python catches this via node_types). */
			if (n.type == null && n.initializer != null) {
				Map<string, Node> vt = {};
				Node? it = self.expressions.resolvedExpressionType(n.initializer, vt);
				self.collectTupleTypes(it, seen, order, tupleTypes);
			}
		}
		int si = 0;
		while (si < n.statements.len) {
			self.collectTupleTypesBody(n.statements.get(si), seen, order, tupleTypes);
			si = si + 1;
		}
		self.collectTupleTypesBody(n.thenBlock, seen, order, tupleTypes);
		self.collectTupleTypesBody(n.elseBlock, seen, order, tupleTypes);
		self.collectTupleTypesBody(n.bodyNode, seen, order, tupleTypes);
		if (n.ifStmt != null) { self.collectTupleTypesBody(n.ifStmt, seen, order, tupleTypes); }
	}


	/* A fresh varTypes map pre-seeded with module-level (global) variable
     * types. Mirrors the reference's global scope being visible inside every
     * function/method body; locals and params added afterward shadow a
     * same-named global. */

	/* Child-typed wrappers for inherited property accessors. */

	private void emitInheritedPropertyForwardDecls(Node declaration, Map<string, bool> ownProperties, IRModule module) {
		string parent = DeclarationRegistry.parentName(declaration);
		if (parent == "" || !self.analyzed.isClass(parent)) { return; }
		Vector<Node> properties = DeclarationRegistry.mergedClassProperties(self.analyzed, parent);
		int index = 0;
		while (index < properties.len) {
			Node property = properties.get(index);
			if (!ownProperties.has(property.name)) {
				string propertyType = self.cTypes.lower(property.type);
				if (property.hasGetter) {
					IRFunctionDecl getter = IRFunctionDecl(declaration.name + "_get_" + property.name, propertyType, false);
					getter.params.push(IRParam(declaration.name + "*", "self"));
					module.functionDecls.push(getter);
				}
				if (property.hasSetter) {
					IRFunctionDecl setter = IRFunctionDecl(declaration.name + "_set_" + property.name, "void", false);
					setter.params.push(IRParam(declaration.name + "*", "self"));
					setter.params.push(self.cTypes.lowerNamedParameter(property.type, propertyType, self.lexicalBindingCName("value")));
					module.functionDecls.push(setter);
				}
			}
			index = index + 1;
		}
	}

	private void emitInheritedProperties(Node declaration, Map<string, bool> ownProperties, IRModule module) {
		string parent = DeclarationRegistry.parentName(declaration);
		if (parent == "" || !self.analyzed.isClass(parent)) { return; }
		Vector<Node> properties = DeclarationRegistry.mergedClassProperties(self.analyzed, parent);
		int index = 0;
		while (index < properties.len) {
			Node property = properties.get(index);
			if (!ownProperties.has(property.name)) {
				string propertyType = self.cTypes.lower(property.type);
				if (property.hasGetter) {
					IRFunction getter = IRFunction();
					getter.name = declaration.name + "_get_" + property.name;
					getter.returnType = propertyType;
					getter.params.push(IRParam(declaration.name + "*", "self"));
					Vector<IRNode> arguments = [];
					arguments.push(IRNode.cast(parent + "*", IRNode.variable("self")));
					Vector<IRNode> body = [];
					body.push(IRNode.returnStatement(IRNode.call(parent + "_get_" + property.name, arguments)));
					getter.body = IRNode.block(body);
					module.functions.push(getter);
				}
				if (property.hasSetter) {
					string valueCName = self.lexicalBindingCName("value");
					IRFunction setter = IRFunction();
					setter.name = declaration.name + "_set_" + property.name;
					setter.returnType = "void";
					setter.params.push(IRParam(declaration.name + "*", "self"));
					setter.params.push(self.cTypes.lowerNamedParameter(property.type, propertyType, valueCName));
					Vector<IRNode> arguments = [];
					arguments.push(IRNode.cast(parent + "*", IRNode.variable("self")));
					arguments.push(IRNode.variable(valueCName));
					Vector<IRNode> body = [];
					body.push(IRNode.expressionStatement(IRNode.call(parent + "_set_" + property.name, arguments)));
					setter.body = IRNode.block(body);
					module.functions.push(setter);
				}
			}
			index = index + 1;
		}
	}

	private Map<string, Node> genericPropertyVarTypes(GenInstance instance, Node property, Map<string, Node> typeMap, bool includeValue) {
		Map<string, Node> variables = self.functions.seededVarTypes();
		Node selfType = Node();
		selfType.kind = NK_TYPE_EXPR;
		selfType.base = instance.base;
		selfType.genericArgs = instance.args;
		selfType.pointerDepth = 1;
		variables.put("self", selfType);
		if (includeValue) {
			variables.put("value", SemanticTypeSystem.resolveGenericType(property.type, typeMap, self.analyzed));
		}
		return variables;
	}

	private void emitGenericPropertyForwardDecls(GenInstance instance, Node declaration, Map<string, Node> typeMap, IRModule module) {
		int index = 0;
		while (index < declaration.members.len) {
			Node property = declaration.members.get(index);
			if (property.kind == NK_PROPERTY_DECL) {
				Node resolvedType = SemanticTypeSystem.resolveGenericType(property.type, typeMap, self.analyzed);
				string propertyType = self.cTypes.lowerGeneric(property.type, typeMap);
				if (property.hasGetter) {
					IRFunctionDecl getter = IRFunctionDecl(instance.mangled + "_get_" + property.name, propertyType, true);
					getter.params.push(IRParam(instance.mangled + "*", "self"));
					module.functionDecls.push(getter);
				}
				if (property.hasSetter) {
					IRFunctionDecl setter = IRFunctionDecl(instance.mangled + "_set_" + property.name, "void", true);
					setter.params.push(IRParam(instance.mangled + "*", "self"));
					setter.params.push(self.cTypes.lowerNamedParameter(resolvedType, propertyType, self.lexicalBindingCName("value")));
					module.functionDecls.push(setter);
				}
			}
			index = index + 1;
		}
	}

	private void emitGenericProperties(GenInstance instance, Node declaration, Map<string, Node> typeMap, IRModule module) {
		string savedReturnCType = self.context.currentReturnCType;
		Node? savedReturnType = self.context.currentReturnType;
		bool savedReturnOwned = self.context.currentReturnOwned;
		string savedPropertyBacking = self.context.currentPropertyBacking;
		int index = 0;
		while (index < declaration.members.len) {
			Node property = declaration.members.get(index);
			if (property.kind == NK_PROPERTY_DECL) {
				Node resolvedType = SemanticTypeSystem.resolveGenericType(property.type, typeMap, self.analyzed);
				string propertyType = self.cTypes.lowerGeneric(property.type, typeMap);
				string backing = DeclarationRegistry.instanceStorageName(property);
				if (property.hasGetter) {
					IRFunction getter = IRFunction();
					getter.name = instance.mangled + "_get_" + property.name;
					getter.returnType = propertyType;
					getter.isStatic = true;
					getter.params.push(IRParam(instance.mangled + "*", "self"));
					Vector<IRNode> body = [];
					if (property.getterBody == null) {
						body.push(IRNode.returnStatement(IRNode.fieldAccess(IRNode.variable("self"), backing, true)));
					} else {
						self.context.currentReturnCType = propertyType;
						self.context.currentReturnType = resolvedType;
						/* Custom getters are call-shaped +1 projections. */
						self.context.currentReturnOwned = true;
						if (DeclarationRegistry.propertyNeedsBacking(property)) {
							self.context.currentPropertyBacking = property.name;
						} else {
							self.context.currentPropertyBacking = "";
						}
						self.functions.resetFuncVarDecls();
						Map<string, Node> variables = self.genericPropertyVarTypes(instance, property, typeMap, false);
						IRNode block = self.functions.lowerBody(property.getterBody, variables);
						self.context.currentPropertyBacking = savedPropertyBacking;
						int statement = 0;
						while (statement < block.stmts.len) {
							body.push(block.stmts.get(statement));
							statement = statement + 1;
						}
					}
					getter.body = IRNode.block(body);
					module.functions.push(getter);
				}
				if (property.hasSetter) {
					string valueCName = self.lexicalBindingCName("value");
					IRFunction setter = IRFunction();
					setter.name = instance.mangled + "_set_" + property.name;
					setter.returnType = "void";
					setter.isStatic = true;
					setter.params.push(IRParam(instance.mangled + "*", "self"));
					setter.params.push(self.cTypes.lowerNamedParameter(resolvedType, propertyType, valueCName));
					Vector<IRNode> body = [];
					if (property.setterBody == null) {
						self.emitAutoPropertyStore(resolvedType, IRNode.fieldAccess(IRNode.variable("self"), backing, true), IRNode.variable(valueCName), body);
					} else {
						self.context.currentReturnCType = "void";
						self.context.currentReturnType = null;
						self.context.currentReturnOwned = false;
						if (DeclarationRegistry.propertyNeedsBacking(property)) {
							self.context.currentPropertyBacking = property.name;
						} else {
							self.context.currentPropertyBacking = "";
						}
						self.functions.resetFuncVarDecls();
						Map<string, Node> variables = self.genericPropertyVarTypes(instance, property, typeMap, true);
						Vector<string> sourceBindings = self.context.snapshotSourceBindings();
						Vector<string> noSourceBindings = [];
						self.context.restoreSourceBindings(noSourceBindings);
						self.context.activateSourceName("value", self.lexicalBindingCName("value"));
						IRNode block = self.functions.lowerBody(property.setterBody, variables);
						self.context.currentPropertyBacking = savedPropertyBacking;
						self.context.restoreSourceBindings(sourceBindings);
						int statement = 0;
						while (statement < block.stmts.len) {
							body.push(block.stmts.get(statement));
							statement = statement + 1;
						}
					}
					setter.body = IRNode.block(body);
					module.functions.push(setter);
				}
			}
			index = index + 1;
		}
		self.context.currentReturnCType = savedReturnCType;
		self.context.currentReturnType = savedReturnType;
		self.context.currentReturnOwned = savedReturnOwned;
		self.context.currentPropertyBacking = savedPropertyBacking;
	}

	/* Exception guards for heap objects whose constructor is still running.
     *
     * The cleanup stack stores the address of `self`, so a longjmp through init
     * releases the partially initialized object through its concrete destructor.
     * memset makes untouched managed fields null; initialized fields are therefore
     * reclaimed by the same destructor used after a successful construction. */

	private string beginConstructorCleanup(string selfName, Vector<IRNode> output) {
		if (!self.context.exceptionsAreEnabled()) { return ""; }

		self.context.referenceHelper("__btrc_cleanup_mark");
		string marker = self.context.freshTemporary("__btrc_constructor_cleanup");
		Vector<IRNode> markArguments = [];
		output.push(IRNode.variableDeclaration("int", marker, IRNode.call("__btrc_cleanup_mark", markArguments)));

		IRNode declaration = self.cleanupSlots.requireDeclaration(output, selfName);
		self.context.referenceHelper("__btrc_arc_abandon");
		output.push(IRNode.expressionStatement(self.cleanupSlots.registerSlot(self.context, declaration, IRNode.functionReference("__btrc_arc_abandon"), IRNode.literal("NULL"), true)));
		return marker;
	}

	private void endConstructorCleanup(string marker, Vector<IRNode> output) {
		if (marker == "") { return; }
		self.context.referenceHelper("__btrc_discard_cleanups_to");
		Vector<IRNode> arguments = [];
		arguments.push(IRNode.variable(marker));
		output.push(IRNode.expressionStatement(IRNode.call("__btrc_discard_cleanups_to", arguments)));
	}

	/* Hidden source-destructor hook construction shared by ordinary and generic
     * class lowering. A source return exits this function, never the terminal
     * compiler-owned destructor that detaches fields and frees the object. */

	private IRFunction buildDestructorHook(string ownerName, Vector<IRNode> body) {
		IRFunction hook = IRFunction();
		hook.name = GenericSpecializer.destructorHookName(ownerName);
		hook.returnType = "void";
		hook.params.push(IRParam("void*", "object"));
		Vector<IRNode> hookBody = [];
		hookBody.push(IRNode.variableDeclaration(ownerName + "*", "self", IRNode.cast(ownerName + "*", IRNode.variable("object"))));
		hookBody.push(IRNode.expressionStatement(IRNode.cast("void", IRNode.variable("self"))));
		int statement = 0;
		while (statement < body.len) {
			hookBody.push(body.get(statement));
			statement = statement + 1;
		}
		hook.body = IRNode.block(hookBody);
		hook.isStatic = true;
		hook.archiveExport = true;
		return hook;
	}

	/* Source-order instance field defaults shared by ordinary and generic classes. */

	private Map<string, Node> genericInitializerVarTypes(GenInstance instance, Node? constructor) {
		Map<string, Node> variables = self.functions.seededVarTypes();
		Node selfType = Node();
		selfType.kind = NK_TYPE_EXPR;
		selfType.base = instance.base;
		selfType.genericArgs = instance.args;
		selfType.pointerDepth = 1;
		variables.put("self", selfType);
		if (constructor != null) {
			int index = 0;
			while (index < constructor.params.len) {
				Node parameter = constructor.params.get(index);
				variables.put(parameter.name, parameter.type);
				index = index + 1;
			}
		}
		return variables;
	}

	private Node instanceInitializerFieldType(Node field, bool generic, Map<string, Node> typeMap) {
		if (generic) {
			return SemanticTypeSystem.resolveGenericType(field.type, typeMap, self.analyzed);
		}
		return self.cTypes.resolveBodyType(field.type, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
	}

	private void rejectInstanceArrayDefaultAtCodegen(Node field, Node fieldType) {
		if (!fieldType.isArray || field.initializer == null) { return; }
		if (field.initializer.kind != NK_BRACE_INITIALIZER && field.initializer.kind != NK_LIST_LITERAL) { return; }
		fprintf(stderr, "error: array-valued class field default '%s' requires persistent backing storage at %d:%d\n", field.name, field.line, field.col);
		exit(1);
	}

	private void appendInstanceFieldInitializers(Node declaration, Map<string, Node> variables, bool generic, Map<string, Node> typeMap, Vector<IRNode> body) {
		CallableFlowState callableFlow = CallableFlowState();
		int index = 0;
		while (index < declaration.members.len) {
			Node field = declaration.members.get(index);
			string storage = DeclarationRegistry.instanceStorageName(field);
			if (field.kind == NK_FIELD_DECL && field.access != "class" && storage != "" && field.initializer != null) {
				Node fieldType = self.instanceInitializerFieldType(field, generic, typeMap);
				self.rejectInstanceArrayDefaultAtCodegen(field, fieldType);
				CallableBoundaryContext callableContext = callableFlow.boundaryContext(variables, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
				bool unsafe = callableFlow.persistentStorageUnsafe(fieldType, field.initializer, self.callableValues, callableContext);
				self.callableBoundaries.rejectPersistentStorage(fieldType, field.initializer, callableContext, unsafe, "instance field storage");
				PreparedValue prepared = self.expressions.prepareTargetValue(field.initializer, fieldType, variables, callableFlow);
				IRNode target = IRNode.fieldAccess(IRNode.variable("self"), storage, true);
				if (self.managedValues.isArc(self.cTypes.resolveBodyType(fieldType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))) {
					body.push(IRNode.expressionStatement(self.managedLifetime.replaceEdge(target, prepared.value, fieldType, IRNode.variable("self"), prepared.owned)));
				} else {
					body.push(IRNode.assignment(target, prepared.value));
					if (self.managedValues.isManaged(self.cTypes.resolveBodyType(fieldType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))) {
						if (prepared.owned) {
							body.push(IRNode.expressionStatement(self.managedLifetime.adoptEdge(target, fieldType, IRNode.variable("self"))));
						} else {
							body.push(IRNode.expressionStatement(self.managedLifetime.retainEdge(target, fieldType, IRNode.variable("self"))));
						}
					}
				}
			}
			index = index + 1;
		}
	}

	/* Validated lowering for the supported source preprocessor subset.
     *
     * The source compiler accepts only single-line includes and object/function
     * macros here.  #pragma pack is consumed separately as struct metadata.  Every
     * other or malformed directive fails before an IR module can be emitted. */

	private bool preprocessorSpace(char value) { return value == ' ' || value == '\t' || value == '\f' || value == '\v' || value == '\r'; }

	private bool preprocessorIdentifierStart(char value) { return TypeIdentity.asciiLetter(value) || value == '_'; }

	private bool preprocessorIdentifierPart(char value) { return self.preprocessorIdentifierStart(value) || TypeIdentity.asciiDigit(value); }

	private bool preprocessorTrigraphSuffix(char value) { return value == '=' || value == '/' || value == '\'' || value == '(' || value == ')' || value == '!' || value == '<' || value == '>' || value == '-'; }

	private bool containsPreprocessorTrigraph(string value) {
		int index = 0;
		while (index + 2 < value.length()) {
			if (value[index] == '?' && value[index + 1] == '?' && self.preprocessorTrigraphSuffix(value[index + 2])) {
				return true;
			}
			index = index + 1;
		}
		return false;
	}

	private string preprocessorTrimLeft(string value) {
		int start = 0;
		while (start < value.length() && self.preprocessorSpace(value[start])) {
			start = start + 1;
		}
		return value.substring(start, value.length() - start);
	}

	private string preprocessorTrim(string value) {
		int start = 0;
		int end = value.length();
		while (start < end && self.preprocessorSpace(value[start])) {
			start = start + 1;
		}
		while (end > start && self.preprocessorSpace(value[end - 1])) {
			end = end - 1;
		}
		return value.substring(start, end - start);
	}

	private void preprocessorFail(string message) {
		fprintf(stderr, "error: %s\n", message);
		exit(1);
	}

	private bool validPreprocessorIdentifier(string value) {
		if (value.length() == 0 || !self.preprocessorIdentifierStart(value[0])) {
			return false;
		}
		int index = 1;
		while (index < value.length()) {
			if (!self.preprocessorIdentifierPart(value[index])) {
				return false;
			}
			index = index + 1;
		}
		return true;
	}

	private bool validIncludeHeader(string header) {
		if (header.length() == 0) { return false; }
		int index = 0;
		while (index < header.length()) {
			char value = header[index];
			int code = (int)(byte)value;
			if (code < 32 || code == 127 || value == '<' || value == '>' || value == '"') {
				return false;
			}
			index = index + 1;
		}
		return !self.containsPreprocessorTrigraph(header);
	}

	private bool sameStructuredInclude(IRPreprocessorDecl left, IRPreprocessorDecl right) { return left.kind == IR_PREPROCESSOR_INCLUDE && right.kind == IR_PREPROCESSOR_INCLUDE && left.header == right.header && left.isSystem == right.isSystem; }

	/* Includes are deduplicated at production time so emission is a pure ordered
     * walk. Macros intentionally preserve every source declaration. */
	private void appendPreprocessorDecl(IRModule module, IRPreprocessorDecl declaration) {
		if (declaration.kind == IR_PREPROCESSOR_INCLUDE) {
			int index = 0;
			while (index < module.preprocessorDecls.len) {
				if (self.sameStructuredInclude(module.preprocessorDecls.get(index), declaration)) {
					return;
				}
				index = index + 1;
			}
		}
		module.preprocessorDecls.push(declaration);
	}

	public void requireSystemInclude(IRModule module, string header) {
		if (!self.validIncludeHeader(header)) {
			self.preprocessorFail("invalid generated include header");
		}
		self.appendPreprocessorDecl(module, IRPreprocessorDecl.include(header, true));
	}

	public void addStandardPreprocessorDecls(IRModule module) {
		Vector<string> noParams = [];
		self.appendPreprocessorDecl(module, IRPreprocessorDecl.macro("_DEFAULT_SOURCE", false, noParams, ""));
		Vector<string> noParams2 = [];
		self.appendPreprocessorDecl(module, IRPreprocessorDecl.macro("_DARWIN_C_SOURCE", false, noParams2, ""));

		Vector<string> headers = [
			"stdio.h", "stdlib.h", "string.h", "stdbool.h", "stdint.h",
			"ctype.h", "math.h", "assert.h", "limits.h"
		];
		int index = 0;
		while (index < headers.len) {
			self.requireSystemInclude(module, headers.get(index));
			index = index + 1;
		}
	}

	private IRPreprocessorDecl parseIncludeDirective(string payload, string source) {
		string value = self.preprocessorTrim(payload);
		if (value.length() < 3) {
			self.preprocessorFail("malformed #include directive: " + source);
		}
		char opening = value[0];
		char closing = value[value.length() - 1];
		bool isSystem = opening == '<';
		if ((!isSystem && opening != '"') || (isSystem && closing != '>') || (!isSystem && closing != '"')) {
			self.preprocessorFail("malformed #include directive: " + source);
		}
		string header = value.substring(1, value.length() - 2);
		if (!self.validIncludeHeader(header)) {
			self.preprocessorFail("malformed #include directive: " + source);
		}
		return IRPreprocessorDecl.include(header, isSystem);
	}

	private Vector<string> parseMacroParameters(string value, string source) {
		Vector<string> params = [];
		string parameterText = self.preprocessorTrim(value);
		if (parameterText == "") { return params; }
		int start = 0;
		int index = 0;
		while (index <= parameterText.length()) {
			if (index == parameterText.length() || parameterText[index] == ',') {
				string parameter = self.preprocessorTrim(parameterText.substring(start, index - start));
				bool finalVariadic = parameter == "..." && index == parameterText.length();
				if (!self.validPreprocessorIdentifier(parameter) && !finalVariadic) {
					self.preprocessorFail("invalid function-like macro parameters: " + source);
				}
				if (params.contains(parameter)) {
					self.preprocessorFail("duplicate function-like macro parameter: " + source);
				}
				params.push(parameter);
				start = index + 1;
			}
			index = index + 1;
		}
		return params;
	}

	private IRPreprocessorDecl parseMacroDirective(string payload, string source) {
		if (payload.length() == 0 || !self.preprocessorSpace(payload[0])) {
			self.preprocessorFail("malformed #define directive: " + source);
		}
		int index = 0;
		while (index < payload.length() && self.preprocessorSpace(payload[index])) {
			index = index + 1;
		}
		int nameStart = index;
		if (index >= payload.length() || !self.preprocessorIdentifierStart(payload[index])) {
			self.preprocessorFail("malformed #define directive: " + source);
		}
		index = index + 1;
		while (index < payload.length() && self.preprocessorIdentifierPart(payload[index])) {
			index = index + 1;
		}
		string name = payload.substring(nameStart, index - nameStart);
		if (index >= payload.length() || payload[index] != '(') {
			string replacement = self.preprocessorTrimLeft(payload.substring(index, payload.length() - index));
			Vector<string> noParams = [];
			return IRPreprocessorDecl.macro(name, false, noParams, replacement);
		}

		int close = index + 1;
		while (close < payload.length() && payload[close] != ')') {
			close = close + 1;
		}
		if (close >= payload.length()) {
			self.preprocessorFail("malformed function-like #define: " + source);
		}
		Vector<string> params = self.parseMacroParameters(payload.substring(index + 1, close - index - 1), source);
		string replacement = self.preprocessorTrimLeft(payload.substring(close + 1, payload.length() - close - 1));
		return IRPreprocessorDecl.macro(name, true, params, replacement);
	}

	private void lowerPreprocessorDirective(string sourceText, IRModule module) {
		if (self.containsPreprocessorTrigraph(sourceText)) {
			self.preprocessorFail("C11 trigraphs in preprocessor directives are unsupported");
		}
		int rawIndex = 0;
		while (rawIndex < sourceText.length()) {
			if (sourceText[rawIndex] == '\n' || sourceText[rawIndex] == '\r') {
				self.preprocessorFail("multi-line preprocessor directives are unsupported");
			}
			rawIndex = rawIndex + 1;
		}
		string source = self.preprocessorTrim(sourceText);
		if (source.length() == 0 || source[source.length() - 1] == '\\') {
			self.preprocessorFail("multi-line preprocessor directives are unsupported");
		}
		if (source[0] != '#') {
			self.preprocessorFail("malformed preprocessor directive: " + source);
		}
		int index = 1;
		while (index < source.length() && self.preprocessorSpace(source[index])) {
			index = index + 1;
		}
		int nameStart = index;
		if (index >= source.length() || !self.preprocessorIdentifierStart(source[index])) {
			self.preprocessorFail("malformed preprocessor directive: " + source);
		}
		index = index + 1;
		while (index < source.length() && self.preprocessorIdentifierPart(source[index])) {
			index = index + 1;
		}
		string directive = source.substring(nameStart, index - nameStart);
		string payload = source.substring(index, source.length() - index);
		if (directive == "include") {
			self.appendPreprocessorDecl(module, self.parseIncludeDirective(payload, source));
			return;
		}
		if (directive == "define") {
			self.appendPreprocessorDecl(module, self.parseMacroDirective(payload, source));
			return;
		}
		if (directive == "pragma") {
			self.preprocessorFail("unsupported #pragma directive: " + source);
		}
		self.preprocessorFail("unsupported preprocessor directive '#" + directive + "'");
	}

	/* Translation-unit storage and ARC replacement for class-access fields. */

	private void emitClassStaticFields(Node declaration, IRModule module) {
		CallableFlowState callableFlow = CallableFlowState();
		int index = 0;
		while (index < declaration.members.len) {
			Node field = declaration.members.get(index);
			if (field.kind == NK_FIELD_DECL && field.access == "class") {
				Node storageType = field.type;
				IRGlobalDecl global;
				bool materializedArray = field.type.isArray && (field.type.arraySize != null || (field.initializer != null && (field.initializer.kind == NK_LIST_LITERAL || field.initializer.kind == NK_BRACE_INITIALIZER)));
				if (materializedArray) {
					storageType = TypeShape.withoutOuterArray(field.type);
				}
				global = IRGlobalDecl(self.cTypes.lower(storageType), declaration.name + "_" + field.name);
				global.isStatic = true;
				global.isVolatile = field.type.isVolatile;
				global.effectiveIsVolatile = SemanticTypeSystem.typeEffectiveOuterVolatile(field.type, self.analyzed.typedefTable);
				Map<string, Node> empty = {};
				if (field.type.isArray) {
					if (field.type.arraySize != null) {
						global.arraySize = self.expressions.lowerExpr(field.type.arraySize, empty, callableFlow);
					} else if (field.initializer != null && (field.initializer.kind == NK_LIST_LITERAL || field.initializer.kind == NK_BRACE_INITIALIZER)) {
						global.arraySize = IRNode.literal(Strings.fromInt(field.initializer.elements.len));
					}
				}
				if (field.initializer != null) {
					CallableBoundaryContext callableContext = callableFlow.boundaryContext(empty, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
					bool unsafe = callableFlow.persistentStorageUnsafe(field.type, field.initializer, self.callableValues, callableContext);
					self.callableBoundaries.rejectPersistentStorage(field.type, field.initializer, callableContext, unsafe, "class field storage");
					global.init = self.expressions.lowerStaticInitializer(field.initializer, field.type, empty, callableFlow);
				}
				module.globalDecls.push(global);
			}
			index = index + 1;
		}
	}

	private IRStructField field(Node member, string storage) {
		Map<string, Node> noTypeMap = {};
		return self.resolvedField(member.type, storage, false, noTypeMap);
	}

	private IRStructField genericField(Node member, string storage, Map<string, Node> typeMap) {
		Node fieldType = SemanticTypeSystem.resolveGenericType(member.type, typeMap, self.analyzed);
		return self.resolvedField(fieldType, storage, true, typeMap);
	}

	private IRStructField resolvedField(Node fieldType, string storage, bool generic, Map<string, Node> typeMap) {
		CallableFlowState callableFlow = CallableFlowState();
		/* CTypeLowerer registers nested callback typedefs. Render only the resolved
         * field shape so a generic placeholder cannot escape into C. */
		IRStructField field = IRStructField(self.cTypes.lower(fieldType), storage);
		field.isVolatile = fieldType.isVolatile;
		field.effectiveIsVolatile = SemanticTypeSystem.typeEffectiveOuterVolatile(fieldType, self.analyzed.typedefTable);
		if (fieldType.isArray && fieldType.arraySize != null) {
			Node elementType = TypeShape.withoutOuterArray(fieldType);
			field.cType = self.cTypes.lower(elementType);
			Map<string, Node> noVariables = {};
			bool savedGeneric = self.context.genericBody;
			Map<string, Node> savedTypeMap = self.context.activeTypeMap;
			if (generic) {
				self.context.genericBody = true;
				self.context.activeTypeMap = typeMap;
			}
			field.arraySize = self.expressions.lowerExpr(fieldType.arraySize, noVariables, callableFlow);
			self.context.genericBody = savedGeneric;
			self.context.activeTypeMap = savedTypeMap;
		}
		return field;
	}
}
