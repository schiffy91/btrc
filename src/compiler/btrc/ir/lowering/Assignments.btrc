import Library.Map;
import Library.Vector;

import ../../analyzer/Expressions.btrc;
import ../../generated/ast/Node.btrc;
import ../Model.btrc;
import ./CallableFlow.btrc;
import ./Callables.btrc;

/* Assignment semantic planning. Recursive target/value evaluation belongs to
 * ExpressionLowerer; this owner returns the typed storage/callable decision and
 * materializes only already-lowered plain assignments. */

class AssignmentPlan {
	public Node assignment;
	public Node? targetType;
	public Node? valueType;
	public bool callableTarget;
	public int callableAbi;

	public AssignmentPlan(Node assignment) {
		self.assignment = assignment;
		self.targetType = null;
		self.valueType = null;
		self.callableTarget = false;
		self.callableAbi = 0;
	}
}

/* A physical storage target whose receiver and key were evaluated once:
 * the temporaries it declared, the assignments that fill them, and the
 * assignable C target built from them. */
class PhysicalStorageTarget {
	public Vector<IRNode> declarations;
	public Vector<IRNode> setup;
	public IRNode target;

	public PhysicalStorageTarget() {
		self.declarations = [];
		self.setup = [];
		self.target = IRNode.literal("0");
	}
}

class AssignmentLowerer {
	private ExpressionTypeResolver expressionTypes;
	private CallableValueSemantics callableValues;
	private CallableBoundaryPolicy callableBoundaries;

	public AssignmentLowerer(ExpressionTypeResolver expressionTypes, CallableValueSemantics callableValues, CallableBoundaryPolicy callableBoundaries) {
		self.expressionTypes = expressionTypes;
		self.callableValues = callableValues;
		self.callableBoundaries = callableBoundaries;
	}

	public AssignmentPlan plan(Node assignment, Map<string, Node> variableTypes, CallableBoundaryContext callableContext, CallableFlowState callableFlow) {
		AssignmentPlan plan = AssignmentPlan(assignment);
		plan.targetType = self.expressionTypes.inferSpecialization(assignment.target, variableTypes);
		plan.valueType = self.expressionTypes.inferSpecialization(assignment.valueNode, variableTypes);
		bool unsafe = callableFlow.assignmentStorageUnsafe(assignment, plan.targetType, self.callableValues, callableContext);
		self.callableBoundaries.rejectAssignment(assignment, plan.targetType, callableContext, unsafe);
		plan.callableTarget = assignment.target != null && assignment.target.kind == NK_IDENTIFIER && self.callableValues.lexicalIdentifier(assignment.target.name, callableContext);
		if (plan.callableTarget && assignment.op == "=") {
			plan.callableAbi = callableFlow.evaluatedAbi(assignment.valueNode, self.callableValues, callableContext);
		}
		return plan;
	}

	public IRNode materializePlain(AssignmentPlan plan, IRNode target, IRNode value) { return IRNode.binary(target, plan.assignment.op, value); }

	public IRNode wrapPhysical(PhysicalStorageTarget storage, IRNode operation) {
		Vector<IRNode> operations = [];
		operations.push(operation);
		return self.wrapPhysicalSequence(storage, operations);
	}

	/* The target's setup, then the operations, as one expression; Python's
	 * StorageLowerer._wrap_target. */
	public IRNode wrapPhysicalSequence(PhysicalStorageTarget storage, Vector<IRNode> operations) {
		Vector<IRNode> expressions = [];
		for setup in storage.setup { expressions.push(setup); }
		for operation in operations { expressions.push(operation); }
		IRNode result = expressions.len == 1 ? expressions.get(0) : IRNode.commaExpression(expressions);
		if (storage.declarations.len == 0) { return result; }
		return IRNode.statementExpression(storage.declarations, result);
	}
}
