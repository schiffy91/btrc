import Library.Map;
import Library.Strings;
import Library.Vector;

import ../../../analyzer/Declarations.btrc;
import ../../../analyzer/Models.btrc;
import ../../../analyzer/ownership/Cycles.btrc;
import ../../../analyzer/ownership/Values.btrc;
import ../../../analyzer/Types.btrc;
import ../../../generated/ast/Node.btrc;
import ../../Model.btrc;
import ../Context.btrc;
import ../Statements.btrc;
import ../Types.btrc;
import ./Lifetime.btrc;

/* Typed cycle visitors and deterministic topology/release boundaries. */

/* Return-path cycle flushing is a structured-IR transformation shared by
 * function lowering and whole-module optimization.  It depends only on the
 * function it rewrites, never on LoweringContext or semantic-analysis
 * services: each function numbers its return temporaries from 1, skipping
 * every name the function already declares, as Python's
 * IROptimizer._next_cycle_return_name does. */
class CycleReturnBoundaryLowerer {
	private int returnCounter = 0;
	private Map<string, bool> localNames = {};

	public CycleReturnBoundaryLowerer() {}

	private void collectDeclaredNames(IRNode? node) {
		if (node == null) { return; }
		int domain = node.payloadDomain();
		if (node.kind == IRK_VAR_DECL) { self.localNames.put(node.name, true); }
		self.collectDeclaredNames(node.left);
		self.collectDeclaredNames(node.right);
		self.collectDeclaredNames((domain == IR_PAYLOAD_UNARY ? ((IRUnaryPayload)node.payload).operand : domain == IR_PAYLOAD_CONVERSION_AGGREGATE ? ((IRConversionPayload)node.payload).operand : null));
		self.collectDeclaredNames(node.expr);
		self.collectDeclaredNames((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).obj : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).obj : null));
		self.collectDeclaredNames((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).index : null));
		self.collectDeclaredNames((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).condition : null));
		self.collectDeclaredNames((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).trueExpr : null));
		self.collectDeclaredNames((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).falseExpr : null));
		self.collectDeclaredNames((domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).arraySize : null));
		self.collectDeclaredNames((domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).init : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).init : null));
		self.collectDeclaredNames((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).value : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).value : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).value : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).value : null));
		self.collectDeclaredNames((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).target : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).target : null));
		self.collectDeclaredNames((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).thenBlock : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).thenBlock : null));
		self.collectDeclaredNames((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).elseBlock : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).elseBlock : null));
		self.collectDeclaredNames((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).body : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).body : null));
		self.collectDeclaredNames((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).update : null));
		self.collectDeclaredNames((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).result : null));
		for argument in node.args() { self.collectDeclaredNames(argument); }
		for statement in node.stmts() { self.collectDeclaredNames(statement); }
	}

	private string nextReturnName() {
		while (true) {
			self.returnCounter = self.returnCounter + 1;
			string name = "__btrc_cycle_return_" + Strings.fromInt(self.returnCounter);
			if (!self.localNames.has(name)) {
				self.localNames.put(name, true);
				return name;
			}
		}
		return "";
	}

	private bool containsCyclableRelease(IRNode? node) {
		if (node == null) { return false; }
		int domain = node.payloadDomain();
		if (node.kind == IRK_CALL && ((domain == IR_PAYLOAD_CALL ? ((IRCallPayload)node.payload).callee : "") == "__btrc_arc_release" || (domain == IR_PAYLOAD_CALL ? ((IRCallPayload)node.payload).callee : "") == "__btrc_arc_release_edge" || (domain == IR_PAYLOAD_CALL ? ((IRCallPayload)node.payload).callee : "") == "__btrc_arc_replace_edge")) {
			return true;
		}
		if (self.containsCyclableRelease(node.left) || self.containsCyclableRelease(node.right) || self.containsCyclableRelease((domain == IR_PAYLOAD_UNARY ? ((IRUnaryPayload)node.payload).operand : domain == IR_PAYLOAD_CONVERSION_AGGREGATE ? ((IRConversionPayload)node.payload).operand : null)) || self.containsCyclableRelease(node.expr) || self.containsCyclableRelease((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).obj : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).obj : null)) || self.containsCyclableRelease((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).index : null)) || self.containsCyclableRelease((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).condition : null)) || self.containsCyclableRelease((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).trueExpr : null)) || self.containsCyclableRelease((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).falseExpr : null)) || self.containsCyclableRelease((domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).arraySize : null)) || self.containsCyclableRelease((domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).init : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).init : null)) || self.containsCyclableRelease((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).value : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).value : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).value : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).value : null)) || self.containsCyclableRelease((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).target : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).target : null)) || self.containsCyclableRelease((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).thenBlock : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).thenBlock : null)) || self.containsCyclableRelease((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).elseBlock : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).elseBlock : null)) || self.containsCyclableRelease((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).body : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).body : null)) || self.containsCyclableRelease((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).update : null)) || self.containsCyclableRelease((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).result : null))) {
			return true;
		}
		int index = 0;
		while (index < node.args().len) {
			if (self.containsCyclableRelease(node.args().get(index))) {
				return true;
			}
			index = index + 1;
		}
		index = 0;
		while (index < node.stmts().len) {
			if (self.containsCyclableRelease(node.stmts().get(index))) {
				return true;
			}
			index = index + 1;
		}
		return false;
	}

	private IRNode forcedFlush() {
		Vector<IRNode> arguments = [];
		return IRNode.expressionStatement(IRNode.call("__btrc_flush_cycles", arguments));
	}

	private bool isForcedFlush(IRNode node) { return node.kind == IRK_EXPR_STMT && node.expr != null && node.expr.kind == IRK_CALL && ((IRCallPayload)node.expr.payload).callee == "__btrc_flush_cycles"; }

	private bool endsWithFlush(Vector<IRNode> statements) { return statements.len > 0 && self.isForcedFlush(statements.get(statements.len - 1)); }

	private bool isMaterializedReturn(Vector<IRNode> statements, IRNode statement) {
		if (statements.len < 2 || !self.endsWithFlush(statements) || ((IRValuePayload)statement.payload).value == null || ((IRValuePayload)statement.payload).value.kind != IRK_VAR) {
			return false;
		}
		IRNode declaration = statements.get(statements.len - 2);
		return declaration.kind == IRK_VAR_DECL && ((IRDeclarationPayload)declaration.payload).isCycleReturnTemp && declaration.name == ((IRValuePayload)statement.payload).value.name;
	}

	private void rewriteNestedReturns(IRFunction definition, IRNode node) {
		if (node.kind == IRK_BLOCK) {
			self.rewriteReturns(definition, node);
		} else if (node.kind == IRK_IF) {
			self.rewriteReturns(definition, ((IRControlPayload)node.payload).thenBlock);
			if (((IRControlPayload)node.payload).elseBlock != null) {
				self.rewriteReturns(definition, ((IRControlPayload)node.payload).elseBlock);
			}
		} else if (node.kind == IRK_WHILE || node.kind == IRK_DO_WHILE || node.kind == IRK_FOR) {
			self.rewriteReturns(definition, ((IRControlPayload)node.payload).body);
		} else if (node.kind == IRK_SWITCH) {
			int index = 0;
			while (index < node.args().len) {
				self.rewriteReturns(definition, node.args().get(index));
				index = index + 1;
			}
		} else if (node.kind == IRK_CASE) {
			self.rewriteReturns(definition, node);
		}
	}

	private void rewriteReturns(IRFunction definition, IRNode block) {
		block.requirePayload(IR_PAYLOAD_CONTROL_SEQUENCE);
		Vector<IRNode> rewritten = [];
		int index = 0;
		while (index < block.stmts().len) {
			IRNode statement = block.stmts().get(index);
			self.rewriteNestedReturns(definition, statement);
			if (statement.kind == IRK_RETURN) {
				bool materialized = self.isMaterializedReturn(rewritten, statement);
				if (((IRValuePayload)statement.payload).value != null && !materialized) {
					string result = self.nextReturnName();
					IRNode declaration = IRNode.variableDeclaration(definition.returnType, result, ((IRValuePayload)statement.payload).value);
					((IRDeclarationPayload)declaration.payload).isCycleReturnTemp = true;
					rewritten.push(declaration);
					((IRValuePayload)statement.payload).value = IRNode.variable(result);
				}
				if (!self.endsWithFlush(rewritten)) {
					rewritten.push(self.forcedFlush());
				}
			}
			rewritten.push(statement);
			index = index + 1;
		}
		((IRControlPayload)block.payload).stmtsStorage = rewritten;
	}

	private void forceBoundary(IRFunction definition) {
		self.returnCounter = 0;
		self.localNames = {};
		for parameter in definition.params { self.localNames.put(parameter.name, true); }
		self.collectDeclaredNames(definition.body);
		self.rewriteReturns(definition, definition.body);
		if (IRStatementSequence(definition.body.stmts()).mayFallThrough() && !self.endsWithFlush(definition.body.stmts())) {
			definition.body.stmtsMut().push(self.forcedFlush());
		}
	}

	public bool installReleaseBearingBoundary(IRFunction definition) {
		if (definition.body == null || !self.containsCyclableRelease(definition.body)) {
			return false;
		}
		self.forceBoundary(definition);
		return true;
	}

	/* Whether any function of `module` may release a cyclable value. */
	public bool releasesCyclableValues(IRModule module) {
		int index = 0;
		while (index < module.functions.len) {
			IRFunction definition = module.functions.get(index);
			if (definition.body != null && self.containsCyclableRelease(definition.body)) { return true; }
			index = index + 1;
		}
		return false;
	}

	public void installProgramBoundary(IRModule module) { self.installProgramBoundaryWhen(module, self.releasesCyclableValues(module)); }

	/* A module unit's entry learns from the whole program whether any unit
	 * releases cyclable values. */
	public void installProgramBoundaryWhen(IRModule module, bool hasCyclableRelease) {
		if (!hasCyclableRelease) { return; }
		int index = 0;
		while (index < module.functions.len) {
			IRFunction definition = module.functions.get(index);
			if (definition.name == "main" || definition.name == "btrc_main") {
				self.forceBoundary(definition);
			}
			index = index + 1;
		}
	}
}

class CycleBoundaryLowerer {
	private Analyzed analyzed;
	private ManagedValueSemantics managedValues;
	private CycleSemantics cycles;
	private CleanupSlotRegistry cleanupSlots;
	private LoweringContext context;
	private CTypeLowerer cTypes;
	private ManagedLifetimeLowerer lifetime;

	public CycleBoundaryLowerer(Analyzed analyzed, ManagedValueSemantics managedValues, CycleSemantics cycles, CleanupSlotRegistry cleanupSlots, LoweringContext context, CTypeLowerer cTypes, ManagedLifetimeLowerer lifetime) {
		self.analyzed = analyzed;
		self.managedValues = managedValues;
		self.cycles = cycles;
		self.cleanupSlots = cleanupSlots;
		self.context = context;
		self.cTypes = cTypes;
		self.lifetime = lifetime;
	}

	public bool publicCollectionBase(string name) { return name == "Array" || name == "List" || name == "Map" || name == "Set" || name == "Vector"; }

	private void appendCycleCallback(Node typeExpr, IRNode slot, Vector<IRNode> output) {
		Node? canonical = SemanticTypeSystem.resolveOuterTypedefType(typeExpr, self.analyzed.typedefTable);
		if (canonical == null) { return; }
		Node resolved = canonical;
		string access = self.cleanupSlots.ensureArcSlotAdapter(self.cTypes.lower(resolved));
		Vector<IRNode> arguments = [];
		arguments.push(IRNode.cast("volatile void*", IRNode.addressOf(slot)));
		arguments.push(IRNode.functionReference(access));
		arguments.push(self.lifetime.runtimeDescriptor(self.managedValues.runtimeType(resolved)));
		arguments.push(IRNode.variable("context"));
		Vector<IRNode> thenBody = [];
		thenBody.push(IRNode.expressionStatement(IRNode.indirectCall(IRNode.variable("fn"), arguments)));
		output.push(IRNode.ifStatement(slot, IRNode.block(thenBody), null));
	}

	public bool appendClassFieldVisit(Node typeExpr, IRNode slot, Vector<IRNode> output) {
		if (typeExpr == null || typeExpr.pointerDepth > 1 || typeExpr.isArray) {
			return false;
		}
		if (self.cycles.isGraphManaged(typeExpr)) {
			self.appendCycleCallback(typeExpr, slot, output);
			return true;
		}
		return false;
	}

	public bool appendGenericFieldVisit(Node typeExpr, IRNode slot, Vector<IRNode> output) {
		if (typeExpr == null || typeExpr.pointerDepth > 1 || typeExpr.isArray || !self.cycles.isGraphManaged(typeExpr)) {
			return false;
		}
		self.appendCycleCallback(typeExpr, slot, output);
		return true;
	}

	private void appendCollectionSlotVisit(Node typeExpr, IRNode slot, Vector<IRNode> output) {
		if (typeExpr == null || typeExpr.pointerDepth > 1 || typeExpr.isArray) {
			return;
		}
		if (self.cycles.isGraphManaged(typeExpr)) {
			self.appendCycleCallback(typeExpr, slot, output);
		}
	}

	private IRNode collectionIndexedLoop(string bound, Vector<string> fields, Vector<Node> types, bool occupiedOnly) {
		string index = self.context.freshTemporary("__btrc_visit_index");
		Vector<IRNode> slotBody = [];
		int slotIndex = 0;
		while (slotIndex < fields.len && slotIndex < types.len) {
			IRNode array = IRNode.fieldAccess(IRNode.variable("self"), fields.get(slotIndex), true);
			self.appendCollectionSlotVisit(types.get(slotIndex), IRNode.indexAccess(array, IRNode.variable(index)), slotBody);
			slotIndex = slotIndex + 1;
		}
		Vector<IRNode> loopBody = slotBody;
		if (occupiedOnly) {
			IRNode occupied = IRNode.indexAccess(IRNode.fieldAccess(IRNode.variable("self"), "occupied", true), IRNode.variable(index));
			loopBody = [];
			loopBody.push(IRNode.ifStatement(occupied, IRNode.block(slotBody), null));
		}
		IRNode init = IRNode.variableDeclaration("int", index, IRNode.literal("0"));
		IRNode condition = IRNode.binary(IRNode.variable(index), "<", IRNode.fieldAccess(IRNode.variable("self"), bound, true));
		IRNode update = IRNode.unary("++", IRNode.variable(index), false);
		return IRNode.forStatement(init, condition, update, IRNode.block(loopBody));
	}

	private void appendListBody(Node element, Vector<IRNode> body) {
		Node nodeType = Node();
		nodeType.kind = NK_TYPE_EXPR;
		nodeType.base = "ListNode";
		nodeType.genericArgsMut().push(element);
		self.appendCollectionSlotVisit(nodeType, IRNode.fieldAccess(IRNode.variable("self"), "head", true), body);
		self.appendCollectionSlotVisit(nodeType, IRNode.fieldAccess(IRNode.variable("self"), "tail", true), body);
	}

	private bool appendBuiltinCollectionBody(GenInstance instance, Vector<IRNode> body) {
		if (!self.cycles.isCollection(instance.base)) { return false; }
		if ((instance.base == "Map" && instance.args.len != 2) || (instance.base != "Map" && instance.args.len != 1)) {
			fprintf(stderr, "error: cannot safely traverse malformed %s instance\n", instance.base);
			exit(1);
		}
		if (instance.base == "List") {
			self.appendListBody(instance.args.get(0), body);
			return true;
		}
		Vector<string> fields = [];
		Vector<Node> types = [];
		bool occupiedOnly = false;
		string bound = "len";
		if (instance.base == "Vector" || instance.base == "Array") {
			fields.push("data");
			types.push(instance.args.get(0));
		} else {
			bound = "cap";
			occupiedOnly = true;
			fields.push("keys");
			types.push(instance.args.get(0));
			if (instance.base == "Map") {
				fields.push("values");
				types.push(instance.args.get(1));
			}
		}
		body.push(self.collectionIndexedLoop(bound, fields, types, occupiedOnly));
		return true;
	}

	public void emitGenericVisitor(GenInstance instance, Node declaration, Map<string, Node> substitutions, IRModule module) {
		if (!self.cycles.genericInstanceNeedsVisitor(instance)) { return; }
		self.context.referenceHelper("__btrc_arc_callback_types");
		IRFunctionDecl visitorDeclaration = IRFunctionDecl(self.cycles.visitorName(instance.mangled), "void", true);
		visitorDeclaration.params.push(IRParam("void*", "object"));
		visitorDeclaration.params.push(IRParam("__btrc_field_visit_fn", "fn"));
		visitorDeclaration.params.push(IRParam("void*", "context"));
		module.functionDecls.push(visitorDeclaration);

		IRFunction visitor = IRFunction();
		visitor.name = self.cycles.visitorName(instance.mangled);
		visitor.returnType = "void";
		visitor.isStatic = true;
		visitor.archiveExport = true;
		visitor.params.push(IRParam("void*", "object"));
		visitor.params.push(IRParam("__btrc_field_visit_fn", "fn"));
		visitor.params.push(IRParam("void*", "context"));
		Vector<IRNode> body = [];
		body.push(IRNode.variableDeclaration(instance.mangled + "*", "self", IRNode.cast(instance.mangled + "*", IRNode.variable("object"))));
		bool visited = self.appendBuiltinCollectionBody(instance, body);
		if (!visited) {
			int memberIndex = 0;
			while (memberIndex < declaration.members().len) {
				Node member = declaration.members().get(memberIndex);
				string storageName = DeclarationRegistry.instanceStorageName(member);
				if (storageName != "") {
					Node resolved = SemanticTypeSystem.resolveGenericType(member.type, substitutions, self.analyzed);
					if (self.cycles.isGraphManaged(resolved)) {
						IRNode field = IRNode.fieldAccess(IRNode.variable("self"), storageName, true);
						if (self.appendGenericFieldVisit(resolved, field, body)) {
							visited = true;
						}
					}
				}
				memberIndex = memberIndex + 1;
			}
		}
		if (!visited) {
			body.push(IRNode.expressionStatement(IRNode.cast("void", IRNode.variable("self"))));
			body.push(IRNode.expressionStatement(IRNode.cast("void", IRNode.variable("fn"))));
			body.push(IRNode.expressionStatement(IRNode.cast("void", IRNode.variable("context"))));
		}
		visitor.body = IRNode.block(body);
		module.functions.push(visitor);
	}

	private bool topologyAssignmentOperator(string op) { return op == "=" || op == "+=" || op == "-=" || op == "*=" || op == "/=" || op == "%=" || op == "&=" || op == "|=" || op == "^=" || op == "<<=" || op == ">>="; }

	private bool topologyRootedInSelf(IRNode? node, Map<string, bool> aliases) {
		if (node == null) { return false; }
		if (node.kind == IRK_VAR) {
			return node.name == "self" || aliases.has(node.name);
		}
		if (node.kind == IRK_FIELD_ACCESS || node.kind == IRK_INDEX) {
			return self.topologyRootedInSelf(((IRProjectionPayload)node.payload).obj, aliases);
		}
		if (node.kind == IRK_ADDRESS_OF || node.kind == IRK_CAST || node.kind == IRK_DEREF) {
			return self.topologyRootedInSelf(node.expr, aliases);
		}
		if (node.kind == IRK_UNARYOP) {
			return self.topologyRootedInSelf(((IRUnaryPayload)node.payload).operand, aliases);
		}
		if (node.kind == IRK_BINOP && (node.op == "+" || node.op == "-")) {
			return self.topologyRootedInSelf(node.left, aliases) || self.topologyRootedInSelf(node.right, aliases);
		}
		return false;
	}

	private bool selfTopologyStorage(IRNode? node, Map<string, bool> aliases) {
		if (node == null) { return false; }
		if (node.kind == IRK_FIELD_ACCESS || node.kind == IRK_INDEX) {
			return self.topologyRootedInSelf(((IRProjectionPayload)node.payload).obj, aliases);
		}
		if (node.kind == IRK_DEREF) {
			return self.topologyRootedInSelf(node.expr, aliases);
		}
		if (node.kind == IRK_UNARYOP && node.op == "*") {
			return self.topologyRootedInSelf(((IRUnaryPayload)node.payload).operand, aliases);
		}
		return false;
	}

	private bool addTopologyAlias(string name, IRNode? source, Map<string, bool> aliases) {
		if (aliases.has(name) || !self.topologyRootedInSelf(source, aliases)) {
			return false;
		}
		aliases.put(name, true);
		return true;
	}

	private bool collectTopologyAliases(IRNode? node, Map<string, bool> aliases) {
		if (node == null) { return false; }
		int domain = node.payloadDomain();
		bool changed = false;
		if (node.kind == IRK_VAR_DECL && ((IRDeclarationPayload)node.payload).init != null) {
			if (self.addTopologyAlias(node.name, ((IRDeclarationPayload)node.payload).init, aliases)) {
				changed = true;
			}
		} else if (node.kind == IRK_ASSIGN && ((IRValuePayload)node.payload).target != null && ((IRValuePayload)node.payload).target.kind == IRK_VAR) {
			if (self.addTopologyAlias(((IRValuePayload)node.payload).target.name, ((IRValuePayload)node.payload).value, aliases)) {
				changed = true;
			}
		} else if (node.kind == IRK_BINOP && node.op == "=" && node.left != null && node.left.kind == IRK_VAR) {
			if (self.addTopologyAlias(node.left.name, node.right, aliases)) {
				changed = true;
			}
		}
		if (self.collectTopologyAliases(node.left, aliases)) {
			changed = true;
		}
		if (self.collectTopologyAliases(node.right, aliases)) {
			changed = true;
		}
		if (self.collectTopologyAliases((domain == IR_PAYLOAD_UNARY ? ((IRUnaryPayload)node.payload).operand : domain == IR_PAYLOAD_CONVERSION_AGGREGATE ? ((IRConversionPayload)node.payload).operand : null), aliases)) {
			changed = true;
		}
		if (self.collectTopologyAliases(node.expr, aliases)) {
			changed = true;
		}
		if (self.collectTopologyAliases((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).obj : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).obj : null), aliases)) {
			changed = true;
		}
		if (self.collectTopologyAliases((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).index : null), aliases)) {
			changed = true;
		}
