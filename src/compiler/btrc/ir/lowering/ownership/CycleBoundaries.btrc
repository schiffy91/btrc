	private int topologyMutatingCallSlot(string callee) {
		if (callee == "__btrc_arc_replace_edge" || callee == "__btrc_safe_realloc" || callee == "free" || callee == "memcpy" || callee == "memmove" || callee == "memset" || callee == "qsort" || callee == "realloc") {
			return 0;
		}
		return -1;
	}

	private bool containsTopologyMutation(IRNode? node, Map<string, bool> aliases) {
		if (node == null) { return false; }
		int domain = node.payloadDomain();
		if (node.kind == IRK_ASSIGN && self.selfTopologyStorage(((IRValuePayload)node.payload).target, aliases)) {
			return true;
		}
		if (node.kind == IRK_BINOP && self.topologyAssignmentOperator(node.op) && self.selfTopologyStorage(node.left, aliases)) {
			return true;
		}
		if (node.kind == IRK_UNARYOP && (node.op == "++" || node.op == "--") && self.selfTopologyStorage(((IRUnaryPayload)node.payload).operand, aliases)) {
			return true;
		}
		if (node.kind == IRK_CALL) {
			int slot = self.topologyMutatingCallSlot(((IRCallPayload)node.payload).callee);
			if (slot >= 0 && slot < node.args().len && self.topologyRootedInSelf(node.args().get(slot), aliases)) {
				return true;
			}
		}
		if (self.containsTopologyMutation(node.left, aliases) || self.containsTopologyMutation(node.right, aliases) || self.containsTopologyMutation((domain == IR_PAYLOAD_UNARY ? ((IRUnaryPayload)node.payload).operand : domain == IR_PAYLOAD_CONVERSION_AGGREGATE ? ((IRConversionPayload)node.payload).operand : null), aliases) || self.containsTopologyMutation(node.expr, aliases) || self.containsTopologyMutation((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).obj : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).obj : null), aliases) || self.containsTopologyMutation((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).index : null), aliases) || self.containsTopologyMutation((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).condition : null), aliases) || self.containsTopologyMutation((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).trueExpr : null), aliases) || self.containsTopologyMutation((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).falseExpr : null), aliases) || self.containsTopologyMutation((domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).arraySize : null), aliases) || self.containsTopologyMutation((domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).init : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).init : null), aliases) || self.containsTopologyMutation((domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).value : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).value : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).value : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).value : null), aliases) || self.containsTopologyMutation((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).target : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).target : null), aliases) || self.containsTopologyMutation((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).thenBlock : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).thenBlock : null), aliases) || self.containsTopologyMutation((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).elseBlock : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).elseBlock : null), aliases) || self.containsTopologyMutation((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).body : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).body : null), aliases) || self.containsTopologyMutation((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).update : null), aliases) || self.containsTopologyMutation((domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).result : null), aliases)) {
			return true;
		}
		int index = 0;
		while (index < node.args().len) {
			if (self.containsTopologyMutation(node.args().get(index), aliases)) {
				return true;
			}
			index = index + 1;
		}
		index = 0;
		while (index < node.stmts().len) {
			if (self.containsTopologyMutation(node.stmts().get(index), aliases)) {
				return true;
			}
			index = index + 1;
		}
		return false;
	}

	public bool containsSelfTopologyMutation(IRNode? node) {
		Map<string, bool> aliases = {};
		bool changed = true;
		while (changed) {
			changed = self.collectTopologyAliases(node, aliases);
		}
		return self.containsTopologyMutation(node, aliases);
	}

	private Vector<IRNode> topologyEpilogue(string token, string marker) {
		Vector<IRNode> output = [];
		Vector<IRNode> completeArguments = [];
		completeArguments.push(IRNode.cast("void* volatile*", IRNode.addressOf(IRNode.variable(token))));
		output.push(IRNode.expressionStatement(IRNode.call("__btrc_arc_topology_complete", completeArguments)));
		if (marker != "") {
			Vector<IRNode> discardArguments = [];
			discardArguments.push(IRNode.variable(marker));
			output.push(IRNode.expressionStatement(IRNode.call("__btrc_discard_cleanups_to", discardArguments)));
		}
		return output;
	}

	private void appendTopologyEpilogue(Vector<IRNode> output, string token, string marker) {
		Vector<IRNode> epilogue = self.topologyEpilogue(token, marker);
		int index = 0;
		while (index < epilogue.len) {
			output.push(epilogue.get(index));
			index = index + 1;
		}
	}

	private void rewriteNestedTopologyReturns(IRFunction definition, IRNode node, string token, string marker) {
		if (node.kind == IRK_BLOCK) {
			self.rewriteTopologyReturns(definition, node, token, marker);
		} else if (node.kind == IRK_IF) {
			self.rewriteTopologyReturns(definition, ((IRControlPayload)node.payload).thenBlock, token, marker);
			if (((IRControlPayload)node.payload).elseBlock != null) {
				self.rewriteTopologyReturns(definition, ((IRControlPayload)node.payload).elseBlock, token, marker);
			}
		} else if (node.kind == IRK_WHILE || node.kind == IRK_DO_WHILE || node.kind == IRK_FOR) {
			self.rewriteTopologyReturns(definition, ((IRControlPayload)node.payload).body, token, marker);
		} else if (node.kind == IRK_SWITCH) {
			int index = 0;
			while (index < node.args().len) {
				self.rewriteTopologyReturns(definition, node.args().get(index), token, marker);
				index = index + 1;
			}
		} else if (node.kind == IRK_CASE) {
			self.rewriteTopologyReturns(definition, node, token, marker);
		}
	}

	private void rewriteTopologyReturns(IRFunction definition, IRNode block, string token, string marker) {
		block.requirePayload(IR_PAYLOAD_CONTROL_SEQUENCE);
		Vector<IRNode> rewritten = [];
		int index = 0;
		while (index < block.stmts().len) {
			IRNode statement = block.stmts().get(index);
			self.rewriteNestedTopologyReturns(definition, statement, token, marker);
			if (statement.kind == IRK_RETURN) {
				if (((IRValuePayload)statement.payload).value != null) {
					string result = self.context.freshTemporary("__btrc_topology_return");
					rewritten.push(IRNode.variableDeclaration(definition.returnType, result, ((IRValuePayload)statement.payload).value));
					((IRValuePayload)statement.payload).value = IRNode.variable(result);
				}
				self.appendTopologyEpilogue(rewritten, token, marker);
			}
			rewritten.push(statement);
			index = index + 1;
		}
		((IRControlPayload)block.payload).stmtsStorage = rewritten;
	}

	private Vector<IRNode> topologyPrologue(string token, string marker, bool cleanupEnabled) {
		Vector<IRNode> output = [];
		if (cleanupEnabled) {
			Vector<IRNode> markArguments = [];
			output.push(IRNode.variableDeclaration("int", marker, IRNode.call("__btrc_cleanup_mark", markArguments)));
		}
		Vector<IRNode> beginArguments = [];
		IRNode tokenDeclaration = IRNode.variableDeclaration("void*", token, IRNode.call("__btrc_arc_topology_begin", beginArguments));
		output.push(tokenDeclaration);
		if (cleanupEnabled) {
			output.push(IRNode.expressionStatement(self.cleanupSlots.registerSlot(self.context, tokenDeclaration, IRNode.functionReference("__btrc_arc_topology_cleanup"), null, true)));
		}
		return output;
	}

	public bool installCollectionTopologyBoundary(IRFunction definition) {
		if (definition.body == null || !self.containsSelfTopologyMutation(definition.body)) {
			return false;
		}
		string token = self.context.freshTemporary("__btrc_topology_scope");
		bool cleanupEnabled = self.context.exceptionsAreEnabled();
		string marker = "";
		if (cleanupEnabled) {
			marker = self.context.freshTemporary("__btrc_topology_cleanup");
		}
		self.context.referenceHelper("__btrc_arc_topology_begin");
		self.context.referenceHelper("__btrc_arc_topology_complete");
		if (cleanupEnabled) {
			self.context.referenceHelper("__btrc_cleanup_mark");
			self.context.referenceHelper("__btrc_register_direct_cleanup");
			self.context.referenceHelper("__btrc_arc_topology_cleanup");
			self.context.referenceHelper("__btrc_discard_cleanups_to");
		}
		self.rewriteTopologyReturns(definition, definition.body, token, marker);
		if (IRStatementSequence(definition.body.stmts()).mayFallThrough()) {
			self.appendTopologyEpilogue(definition.body.stmts(), token, marker);
		}
		Vector<IRNode> body = self.topologyPrologue(token, marker, cleanupEnabled);
		int index = 0;
		while (index < definition.body.stmts().len) {
			body.push(definition.body.stmts().get(index));
			index = index + 1;
		}
		definition.body.requirePayload(IR_PAYLOAD_CONTROL_SEQUENCE);
		((IRControlPayload)definition.body.payload).stmtsStorage = body;
		return true;
	}
