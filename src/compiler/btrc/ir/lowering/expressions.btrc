/* Recursive AST expression lowering and the composition boundary that
 * evaluates explicit operands before inward call/string/concurrency owners
 * materialize structured IR. */

class ExpressionLowerer {
    private Analyzed analyzed;
    private HostedAbiRepository hostedAbi;
    private DeclarationRegistry declarations;
    private OperatorSemantics operators;
    private ExpressionTypeResolver expressionTypes;
    private ManagedValueSemantics managedValues;
    private CycleSemantics cycles;
    private CallableValueSemantics callableValues;
    private CallableBoundaryPolicy callableBoundaries;
    private CallableValueLowerer callableLowering;
    private AssignmentLowerer assignments;
    private LoweringContext context;
    private OwnershipOperandPlanner operandPlanner;
    private OwnershipSemantics ownershipSemantics;
    private CallOwnershipLowerer callOwnership;
    private ManagedLifetimeLowerer managedLifetime;
    private ManagedTypeLowerer managedTypes;
    private AggregateValueLowerer aggregateValues;
    private GpuPipeline gpuPipeline;
    private CTypeLowerer cTypes;
    private CallTargetResolver callTargets;
    private CallLowerer calls;
    private StringLowerer strings;
    private ConcurrencyLowerer concurrency;

    public ExpressionLowerer(Analyzed analyzed,
            HostedAbiRepository hostedAbi,
            DeclarationRegistry declarations,
            OperatorSemantics operators,
            ExpressionTypeResolver expressionTypes,
            ManagedValueSemantics managedValues, CycleSemantics cycles,
            CallableValueSemantics callableValues,
            CallableBoundaryPolicy callableBoundaries,
            CallableValueLowerer callableLowering,
            AssignmentLowerer assignments, LoweringContext context,
            OwnershipOperandPlanner operandPlanner, OwnershipSemantics ownershipSemantics,
            CallOwnershipLowerer callOwnership,
            ManagedLifetimeLowerer managedLifetime,
            ManagedTypeLowerer managedTypes,
            AggregateValueLowerer aggregateValues,
            GpuPipeline gpuPipeline,
            CTypeLowerer cTypes, CallTargetResolver callTargets,
            CallLowerer calls, StringLowerer strings,
            ConcurrencyLowerer concurrency) {
        self.analyzed = analyzed; self.operators = operators;
        self.hostedAbi = hostedAbi;
        self.declarations = declarations;
        self.expressionTypes = expressionTypes;
        self.managedValues = managedValues; self.cycles = cycles;
        self.callableValues = callableValues;
        self.callableBoundaries = callableBoundaries;
        self.callableLowering = callableLowering;
        self.assignments = assignments; self.context = context;
        self.operandPlanner = operandPlanner; self.ownershipSemantics = ownershipSemantics;
        self.callOwnership = callOwnership; self.managedLifetime = managedLifetime;
        self.managedTypes = managedTypes;
        self.aggregateValues = aggregateValues;
        self.gpuPipeline = gpuPipeline;
        self.cTypes = cTypes; self.callTargets = callTargets;
        self.calls = calls; self.strings = strings;
        self.concurrency = concurrency;
    }

    private Node? classStaticField(Node? projection) {
        if (projection == null || projection.kind != NK_FIELD_ACCESS_EXPR
                || projection.obj == null
                || projection.obj.kind != NK_IDENTIFIER
                || !self.analyzed.isClass(projection.obj.name)) {
            return null;
        }
        Node? member = self.analyzed.classMember(
            projection.obj.name, projection.field);
        if (member == null || member.kind != NK_FIELD_DECL
                || member.access != "class") {
            return null;
        }
        return member;
    }

    private string classStaticFieldName(Node projection) {
        return projection.obj.name + "_" + projection.field;
    }

    private CallableBoundaryContext callableContext(
            Map<string, Node> variableTypes,
            CallableFlowState callableFlow) {
        return callableFlow.boundaryContext(
            variableTypes, self.context.activeTypeMap,
            self.context.genericBody
                || self.context.callDefaultTypeDepth > 0);
    }
    /* Recursive lowering integration: materialize a borrowed branch value, then
     * let the lifetime owner establish the owned result contract. */
    public IRNode promoteBorrowedValue(IRNode lowered, Node resultType) {
        string name = self.context.freshTemporary("__btrc_promoted");
        IRNode declaration = IRNode.variableDeclaration(
            self.cTypes.lower(resultType), name, null);
        self.context.recordLocal(declaration);
        IRNode value = IRNode.variable(name);
        Vector<IRNode> declarations = [];
        declarations.push(declaration);
        Vector<IRNode> sequence = [];
        sequence.push(IRNode.binary(value, "=", lowered));
        sequence.push(self.managedLifetime.retainValue(
            value, self.cTypes.resolveBodyType(resultType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0)));
        sequence.push(value);
        return IRNode.statementExpression(
            declarations, IRNode.commaExpression(sequence));
    }

    /* Recursive AST integration around ownership-domain lifetime atoms. */
    public void lowerTakenDelete(IRNode target, Node typeNode,
            IRNode edgeOwner, bool persistent,
            Vector<IRNode> statements) {
        Node resolvedType = self.cTypes.resolveBodyType(typeNode, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
        string valueC = self.cTypes.lower(resolvedType);
        string slotName = self.context.freshTemporary("__btrc_delete_slot");
        statements.push(IRNode.variableDeclaration(
            valueC + " volatile*", slotName, IRNode.addressOf(target)));
        if (self.managedValues.isArc(resolvedType)) {
            statements.push(IRNode.expressionStatement(
                self.managedLifetime.destroySlot(
                    IRNode.variable(slotName), resolvedType,
                    edgeOwner, persistent)));
            return;
        }
        string valueName = self.context.freshTemporary("__btrc_delete_value");
        statements.push(IRNode.variableDeclaration(
            valueC, valueName,
            IRNode.dereference(IRNode.variable(slotName))));
        IRNode slot = IRNode.dereference(IRNode.variable(slotName));
        IRNode value = IRNode.variable(valueName);
        statements.push(IRNode.assignment(slot, IRNode.literal("NULL")));
        Vector<IRNode> destroyBody = [];
        if (self.managedValues.isManaged(resolvedType)) {
            destroyBody.push(IRNode.expressionStatement(
                self.managedLifetime.releaseValue(
                    value, resolvedType)));
        } else {
            Vector<IRNode> destroyArgs = [];
            destroyArgs.push(value);
            destroyBody.push(IRNode.expressionStatement(
                IRNode.call("free", destroyArgs)));
        }
        statements.push(IRNode.ifStatement(
            IRNode.binary(value, "!=", IRNode.literal("NULL")),
            IRNode.block(destroyBody), null));
    }

    public string beginOwnedIteration(Node expression,
            Node typeExpr, Map<string, Node> varTypes, string name,
            Vector<IRNode> prefix, CallableFlowState callableFlow) {
        Node resolvedType = self.cTypes.resolveBodyType(typeExpr, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
        if (!self.managedValues.isManaged(resolvedType)) { return ""; }
        if (!self.ownershipSemantics.unconsumedOwnedResult(
                expression, self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()), callableFlow)) {
            prefix.push(IRNode.expressionStatement(
                self.managedLifetime.retainValue(
                    IRNode.variable(name), resolvedType)));
        }
        string runtimeType = self.managedValues.runtimeType(resolvedType);
        self.managedLifetime.registerManaged(
            name, self.context.sourceCName(name), runtimeType,
            resolvedType, self.cTypes.lower(resolvedType));
        self.managedLifetime.maybeRegisterCleanup(
            name, runtimeType, prefix);
        return runtimeType;
    }

    public void endOwnedIteration(string name,
            string runtimeType, Vector<IRNode> output) {
        if (runtimeType == "") { return; }
        self.managedLifetime.unregisterManaged(
            self.context.sourceCName(name));
        self.context.borrowedLocalBindings.put(name, true);
        output.push(IRNode.expressionStatement(
            self.managedLifetime.releaseRuntime(
                IRNode.variable(name), runtimeType)));
        output.push(IRNode.assignment(
            IRNode.variable(name), IRNode.literal("NULL")));
    }
    private void addProjectionOperands(OwnershipBoundary boundary,
            OwnershipProjectionPlan plan,
            Map<string, Node> varTypes, CallableFlowState callableFlow) {
        int index = 0;
        while (index < plan.expressions.len) {
            Node expression = plan.expressions.get(index);
            Node? typeExpr = self.resolvedExpressionType(
                expression, varTypes);
            self.operandPlanner.requireType(typeExpr, expression);
            Node concreteType = typeExpr;
            boundary.addLoweredOperand(
                expression, concreteType,
                self.lowerExpr(expression, varTypes, callableFlow),
                plan.owned.get(index),
                plan.retained.get(index));
            index = index + 1;
        }
    }

    private IRNode? lowerOwnedAssignment(
            AssignmentPlan assignmentPlan,
            Map<string, Node> varTypes, CallableFlowState callableFlow) {
        Node expression = assignmentPlan.assignment;
        OwnershipOperandEnvironment environment =
            self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive());
        OwnershipProjectionPlan plan =
            self.ownershipSemantics.assignmentTargetOperands(
                expression.target, environment,
                self.context.currentPropertyBacking, callableFlow);
        if (!plan.requiresBoundary()) { return null; }
        OwnershipBoundary boundary = self.callOwnership.boundary();
        self.addProjectionOperands(boundary, plan, varTypes, callableFlow);
        IRNode lowered = self.materializeAssignmentCore(
            assignmentPlan, varTypes, callableFlow);
        boundary.restore();
        Node? resultType = self.resolvedExpressionType(
            expression, varTypes);
        Node? virtualType =
            self.ownershipSemantics.virtualAssignmentValueType(
                expression.target, environment,
                self.context.currentPropertyBacking);
        bool rhsSuppliesResult = virtualType != null
            && self.ownershipSemantics.virtualAssignmentRhsOwnsResult(
                expression, virtualType, environment);
        boundary.resultOwned = rhsSuppliesResult;
        return boundary.finish(
            lowered, resultType,
            self.managedValues.isManaged(
                self.cTypes.resolveBodyType(resultType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))
                && !rhsSuppliesResult);
    }

    public IRNode? lowerOwnedUnaryUpdate(Node expression,
            Map<string, Node> varTypes, CallableFlowState callableFlow) {
        if (expression.op != "++" && expression.op != "--") {
            return null;
        }
        OwnershipOperandEnvironment environment =
            self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive());
        OwnershipProjectionPlan plan =
            self.ownershipSemantics.assignmentTargetOperands(
                expression.operand, environment,
                self.context.currentPropertyBacking, callableFlow);
        if (!plan.requiresBoundary()) { return null; }
        OwnershipBoundary boundary = self.callOwnership.boundary();
        self.addProjectionOperands(boundary, plan, varTypes, callableFlow);
        IRNode lowered = self.lowerUnaryCore(expression, varTypes, callableFlow);
        boundary.restore();
        Node? resultType = self.resolvedExpressionType(
            expression, varTypes);
        bool resultOwned =
            self.ownershipSemantics.expressionOwnsResult(
                expression, environment, callableFlow);
        boundary.resultOwned = resultOwned;
        return boundary.finish(
            lowered, resultType,
            self.managedValues.isManaged(
                self.cTypes.resolveBodyType(resultType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))
                && !resultOwned);
    }

    public IRNode? lowerIndexedAssignmentWithOwnership(
            Node expression, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        if (expression.op != "=" || expression.target == null
                || expression.target.kind != NK_INDEX_EXPR) {
            return null;
        }
        Node target = expression.target;
        Node? receiver = self.resolvedExpressionType(
            target.obj, varTypes);
        if (receiver == null
                || StorageValidator.rawIndexedPointer(
                    receiver, self.analyzed)) {
            return null;
        }
        Node? setter = StorageValidator.indexedMethod(
            receiver, "set", self.analyzed);
        if (!StorageValidator.validIndexedSetter(setter)) {
            return null;
        }
        Node concreteSetter = setter;
        Node indexType = StorageValidator.resolvedIndexedType(
            concreteSetter.params.get(0).type,
            receiver, self.analyzed);
        Node valueType = StorageValidator.resolvedIndexedType(
            concreteSetter.params.get(1).type,
            receiver, self.analyzed);
        Node? actualIndexType = self.resolvedExpressionType(
            target.index, varTypes);
        if (actualIndexType == null) { actualIndexType = indexType; }
        Node? actualType = self.resolvedExpressionType(
            expression.value_node, varTypes);
        if (actualType == null) { actualType = valueType; }
        bool targetManaged = self.managedValues.isManaged(
            self.cTypes.resolveBodyType(valueType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
        bool keepValue = targetManaged
            && concreteSetter.params.get(1).keep_;
        bool converted = self.strings.requiresTargetStringConversion(valueType, actualType);
        bool indexConverted = self.strings.requiresTargetStringConversion(indexType, actualIndexType);
        if (!targetManaged && !converted && !indexConverted) {
            return null;
        }

        OwnershipBoundary boundary = self.callOwnership.boundary();
        if (indexConverted) {
            PreparedValue preparedIndex = self.prepareCallTargetValue(target.index, indexType, varTypes, callableFlow);
            self.operandPlanner.requireType(
                preparedIndex.effectiveType, target.index);
            boundary.addLoweredCallOperand(
                target.index, preparedIndex.effectiveType,
                preparedIndex.value, preparedIndex.owned,
                false, false);
        }
        PreparedValue prepared = self.prepareCallTargetValue(expression.value_node, valueType, varTypes, callableFlow);
        self.operandPlanner.requireType(
            prepared.effectiveType, expression.value_node);
        bool pinBorrowed = targetManaged && !prepared.owned;
        boundary.addLoweredCallOperand(
            expression.value_node, prepared.effectiveType,
            prepared.value, prepared.owned,
            keepValue || pinBorrowed, false);
        IRNode? lowered = self.lowerIndirectAssignmentCore(
            expression, varTypes, callableFlow);
        boundary.restore();
        if (lowered == null) {
            fprintf(stderr,
                "error: indexed setter boundary has no lowering\n");
            exit(1);
        }
        return boundary.finish(
            lowered, valueType, targetManaged);
    }






    private void addOwnedProjectionRoots(
            OwnershipBoundary boundary, Node? expression,
            Map<string, Node> varTypes, CallableFlowState callableFlow) {
        Vector<Node> roots = [];
        self.ownershipSemantics.collectProjectionRoots(
            expression, self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()), roots, callableFlow);
        int index = 0;
        while (index < roots.len) {
            Node root = roots.get(index);
            Node? typeExpr = self.resolvedExpressionType(root, varTypes);
            self.operandPlanner.requireType(typeExpr, root);
            Node concreteType = typeExpr;
            boundary.addLoweredOperand(
                root, concreteType,
                self.lowerExpr(root, varTypes, callableFlow), true, false);
            index = index + 1;
        }
    }

    public IRNode lowerOwnedFieldAccess(
            Node expression, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        if (self.context.unevaluatedDepth > 0) {
            return self.lowerFieldAccessCore(expression, varTypes, callableFlow);
        }
        OwnershipOperandEnvironment environment =
            self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive());
        bool receiverOwned =
            self.ownershipSemantics.unconsumedOwnedResult(
                expression.obj, environment, callableFlow);
        Node? receiverType = self.resolvedExpressionType(
            expression.obj, varTypes);
        bool receiverPinned = !receiverOwned
            && self.managedValues.isManaged(
                self.cTypes.resolveBodyType(receiverType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))
            && self.ownershipSemantics.propertyGetterProjection(
                expression, environment);
        Vector<Node> roots = [];
        self.ownershipSemantics.collectProjectionRoots(
            expression.obj, environment, roots, callableFlow);
        if (!receiverOwned && !receiverPinned && roots.len == 0) {
            return self.lowerFieldAccessCore(expression, varTypes, callableFlow);
        }
        OwnershipBoundary boundary = self.callOwnership.boundary();
        self.addOwnedProjectionRoots(
            boundary, expression.obj, varTypes, callableFlow);
        if (receiverOwned || receiverPinned) {
            self.operandPlanner.requireType(
                receiverType, expression.obj);
            Node concreteReceiverType = receiverType;
            boundary.addLoweredOperand(
                expression.obj, concreteReceiverType,
                self.lowerExpr(expression.obj, varTypes, callableFlow),
                receiverOwned, receiverPinned);
        }
        IRNode lowered = self.lowerFieldAccessCore(
            expression, varTypes, callableFlow);
        boundary.restore();
        Node? resultType = self.resolvedExpressionType(
            expression, varTypes);
        return boundary.finish(
            lowered, resultType,
            self.managedValues.isManaged(
                self.cTypes.resolveBodyType(resultType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))
                && !self.ownershipSemantics
                    .customPropertyGetterProjection(
                        expression, environment));
    }

    public IRNode lowerOwnedIndex(
            Node expression, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        if (self.context.unevaluatedDepth > 0) {
            return self.lowerIndexCore(expression, varTypes, callableFlow);
        }
        OwnershipOperandEnvironment environment =
            self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive());
        bool objectOwned = self.ownershipSemantics
            .unconsumedOwnedResult(
                expression.obj, environment, callableFlow);
        bool indexOwned = self.ownershipSemantics
            .unconsumedOwnedResult(
                expression.index, environment, callableFlow);
        Vector<Node> orderedOperands = [];
        orderedOperands.push(expression.obj);
        orderedOperands.push(expression.index);
        bool orderingRequired = self.operandPlanner.requiresOrder(
            orderedOperands, environment);
        bool indexHasEffect = self.operandPlanner.hasEffect(
            expression.index, environment);
        Node? objectType = self.resolvedExpressionType(
            expression.obj, varTypes);
        Node? indexType = self.resolvedExpressionType(
            expression.index, varTypes);
        Node? getter = null;
        if (objectType != null
                && !StorageValidator.rawIndexedPointer(
                    objectType, self.analyzed)) {
            getter = StorageValidator.indexedMethod(
                objectType, "get", self.analyzed);
        }
        bool sourceGetter = StorageValidator.validIndexedGetter(getter);
        Node? expectedIndexType = indexType;
        if (sourceGetter) {
            Node concreteGetter = getter;
            expectedIndexType = StorageValidator.resolvedIndexedType(
                concreteGetter.params.get(0).type,
                objectType, self.analyzed);
        }
        bool indexConverted = sourceGetter
            && self.strings.requiresTargetStringConversion(expectedIndexType, indexType);
        bool objectPinned = !objectOwned
            && (sourceGetter || (orderingRequired && indexHasEffect))
            && self.managedValues.isManaged(
                self.cTypes.resolveBodyType(objectType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))
            && expression.obj.kind != NK_SELF_EXPR
            && expression.obj.kind != NK_SUPER_EXPR;
        Vector<Node> roots = [];
        self.ownershipSemantics.collectProjectionRoots(
            expression.obj, environment, roots, callableFlow);
        if (!objectOwned && !objectPinned && !indexOwned
                && !indexConverted && roots.len == 0
                && !orderingRequired) {
            return self.lowerIndexCore(expression, varTypes, callableFlow);
        }
        OwnershipBoundary boundary = self.callOwnership.boundary();
        self.addOwnedProjectionRoots(
            boundary, expression.obj, varTypes, callableFlow);
        if (objectOwned || objectPinned || roots.len > 0
                || orderingRequired) {
            self.operandPlanner.requireType(
                objectType, expression.obj);
            Node concreteObjectType = objectType;
            boundary.addLoweredOperand(
                expression.obj, concreteObjectType,
                self.lowerExpr(expression.obj, varTypes, callableFlow),
                objectOwned, objectPinned);
        }
        if (indexConverted) {
            PreparedValue preparedIndex = self.prepareCallTargetValue(expression.index,
                expectedIndexType, varTypes, callableFlow);
            self.operandPlanner.requireType(
                preparedIndex.effectiveType, expression.index);
            boundary.addLoweredCallOperand(
                expression.index, preparedIndex.effectiveType,
                preparedIndex.value, preparedIndex.owned,
                false, false);
        } else {
            self.operandPlanner.requireType(indexType, expression.index);
            Node concreteIndexType = indexType;
            boundary.addLoweredOperand(
                expression.index, concreteIndexType,
                self.lowerExpr(expression.index, varTypes, callableFlow),
                indexOwned, false);
        }
        IRNode lowered = self.lowerIndexCore(expression, varTypes, callableFlow);
        boundary.restore();
        Node? resultType = self.resolvedExpressionType(
            expression, varTypes);
        boundary.resultOwned = sourceGetter
            && self.managedValues.isManaged(
                self.cTypes.resolveBodyType(resultType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
        return boundary.finish(
            lowered, resultType,
            self.managedValues.isManaged(
                self.cTypes.resolveBodyType(resultType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))
                && !sourceGetter);
    }

    public IRNode lowerOwnedBinary(
            Node expression, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        if (self.context.unevaluatedDepth > 0) {
            return self.lowerBinaryCore(expression, varTypes, callableFlow);
        }
        IRNode? flattened = self.lowerLongStringConcat(expression, varTypes, callableFlow);
        if (flattened != null) { return flattened; }
        if (expression.op == "??" || expression.op == "&&"
                || expression.op == "||") {
            return self.lowerBinaryCore(expression, varTypes, callableFlow);
        }
        OwnershipOperandEnvironment environment =
            self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive());
        bool leftOwned = self.ownershipSemantics
            .unconsumedOwnedResult(
                expression.left, environment, callableFlow);
        Node? leftType = self.resolvedExpressionType(
            expression.left, varTypes);
        Node? rightType = self.resolvedExpressionType(
            expression.right, varTypes);
        Node? overload = self.ownershipSemantics.binaryMethod(
            leftType, expression.op);
        Node? rightTargetType = rightType;
        if (overload != null && overload.params.len > 0) {
            rightTargetType = self.cTypes.resolveBodyType(
                overload.params.get(0).type, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
            if (leftType != null && leftType.generic_args.len > 0
                    && self.analyzed.isGenericClass(leftType.base)) {
                rightTargetType = SemanticTypeSystem.resolveGenericType(
                    overload.params.get(0).type,
                    SemanticTypeSystem.genericTypeMap(
                        self.analyzed, leftType),
                    self.analyzed);
            }
        }
        bool rightOwned = self.ownershipSemantics
            .contextualUnconsumedOwnedResult(
                expression.right, rightTargetType,
                environment, callableFlow);
        bool rightConverted = self.strings.requiresTargetStringConversion(rightTargetType, rightType);
        bool leftPinned = !leftOwned
            && self.managedValues.isManaged(
                self.cTypes.resolveBodyType(leftType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))
            && (overload != null || self.operandPlanner.hasEffect(
                expression.right, environment));
        bool rightKeep = leftType != null && rightType != null
            && self.managedValues.isManaged(
                self.cTypes.resolveBodyType(rightType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))
            && self.ownershipSemantics.managedCompoundKeepsRhs(
                leftType, expression.op);
        bool lifetimeRequired = leftOwned || rightOwned
            || rightConverted || leftPinned || rightKeep;
        bool leftEffect = self.operandPlanner.hasEffect(
            expression.left, environment);
        bool rightEffect = self.operandPlanner.hasEffect(
            expression.right, environment);
        bool orderingRequired = (leftEffect
                && !self.operandPlanner.reorderInert(
                    expression.right, environment))
            || (rightEffect && !self.operandPlanner.reorderInert(
                expression.left, environment));
        if (!lifetimeRequired && !orderingRequired) {
            return self.lowerBinaryCore(expression, varTypes, callableFlow);
        }
        if (leftType == null) {
            self.ownershipSemantics.failOpaqueOperand(
                expression.left,
                "operator '" + expression.op + "'", false);
        }
        Node concreteLeftType = leftType;
        self.operandPlanner.requireType(
            concreteLeftType, expression.left);
        OwnershipBoundary boundary = self.callOwnership.boundary();
        boundary.addLoweredOperand(
            expression.left, concreteLeftType,
            self.lowerExpr(expression.left, varTypes, callableFlow),
            leftOwned, leftPinned);
        if (rightType != null || rightTargetType != null) {
            PreparedValue prepared = self.prepareCallTargetValue(expression.right,
                rightTargetType, varTypes, callableFlow);
            self.operandPlanner.requireType(
                prepared.effectiveType, expression.right);
            boundary.addLoweredOperand(
                expression.right, prepared.effectiveType,
                prepared.value, prepared.owned, rightKeep);
        }
        IRNode lowered = self.lowerBinaryCore(expression, varTypes, callableFlow);
        boundary.resultOwned = self.ownershipSemantics
            .expressionOwnsResult(
                expression, environment, callableFlow);
        boundary.restore();
        return boundary.finish(
            lowered,
            self.resolvedExpressionType(expression, varTypes), false);
    }

    private bool callOmitsBorrowedProjectionGuard(
            Node call, Vector<OwnershipCallOperand> operands,
            int index, Map<string, Node> varTypes) {
        if (!self.analyzed.hostedCallKeys.has(AstIdentity.key(call))
                || call.callee == null
                || call.callee.kind != NK_IDENTIFIER) {
            return false;
        }
        OwnershipCallOperand operand = operands.get(index);
        if (operand.parameterIndex < 0
                || !self.hostedAbi.parameterReadOnlyBorrow(
                    call.callee.name, operand.parameterIndex)) {
            return false;
        }
        int laterIndex = index + 1;
        while (laterIndex < operands.len) {
            OwnershipCallOperand later = operands.get(laterIndex);
            if (later.defaultArgument || later.needsConversion
                    || self.operandPlanner.hasEffect(
                        later.expression,
                        self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()))) {
                return false;
            }
            laterIndex = laterIndex + 1;
        }
        return true;
    }

    private bool callProjectionRoot(
            OwnershipBoundary? boundary, Node? expression,
            Map<string, Node> varTypes, bool omitBorrowedGuard, CallableFlowState callableFlow) {
        RawProjectionStorageRoot? root =
            self.ownershipSemantics.projectionStorageRoot(
                expression, self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()));
        if (root == null) { return false; }
        bool owned = root.managed
            && self.ownershipSemantics.unconsumedOwnedResult(
                root.expression, self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()), callableFlow);
        if (omitBorrowedGuard && !owned) { return false; }
        if (boundary != null) {
            Node? rootType = self.resolvedExpressionType(
                root.expression, varTypes);
            self.operandPlanner.requireType(rootType, root.expression);
            Node concreteRootType = rootType;
            boundary.addLoweredOperand(
                root.expression, concreteRootType,
                self.lowerExpr(root.expression, varTypes, callableFlow),
                owned, root.managed && !owned);
        }
        return true;
    }

    private bool callHasProjectionRoots(
            Node call, OwnershipCallPlan plan,
            Map<string, Node> varTypes, CallableFlowState callableFlow) {
        CallableFlowSnapshot incoming = callableFlow.snapshot();
        bool found = self.callProjectionRoot(
            null, plan.receiver, varTypes, false, callableFlow);
        int index = 0;
        while (!found && index < plan.operands.len) {
            OwnershipCallOperand operand = plan.operands.get(index);
            callableFlow.restore(operand.flowEntry);
            found = self.callProjectionRoot(
                null, operand.expression, varTypes,
                self.callOmitsBorrowedProjectionGuard(
                    call, plan.operands, index, varTypes), callableFlow);
            index = index + 1;
        }
        callableFlow.restore(incoming);
        return found;
    }

    private void completeCallPlan(
            OwnershipCallPlan plan, Map<string, Node> varTypes) {
        int index = 0;
        while (index < plan.operands.len) {
            OwnershipCallOperand operand = plan.operands.get(index);
            if (!operand.defaultArgument) {
                if (!operand.keepValue && !operand.transferred
                        && self.strings.hostedStringConversionMode(operand.expression,
                            operand.targetType,
                            operand.typeExpr) == "reject") {
                    operand.targetType = operand.typeExpr;
                }
                operand.needsConversion =
                    self.strings.requiresTargetValueConversion(operand.expression,
                        operand.targetType, operand.typeExpr);
            }
            index = index + 1;
        }
        index = 0;
        while (index + 1 < plan.operands.len) {
            OwnershipCallOperand operand = plan.operands.get(index);
            bool laterEffect = false;
            int laterIndex = index + 1;
            while (laterIndex < plan.operands.len) {
                OwnershipCallOperand later =
                    plan.operands.get(laterIndex);
                if (later.defaultArgument || later.needsConversion
                        || self.operandPlanner.hasEffect(
                            later.expression,
                            self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()))) {
                    laterEffect = true;
                }
                laterIndex = laterIndex + 1;
            }
            if (laterEffect && !operand.owned
                    && self.managedValues.isManaged(
                        self.cTypes.resolveBodyType(operand.typeExpr, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))) {
                operand.keepValue = true;
            }
            index = index + 1;
        }
        Node? calleeType = self.resolvedExpressionType(
            plan.call.callee, varTypes);
        bool orderedFieldCall = plan.call.callee != null
            && plan.call.callee.kind == NK_FIELD_ACCESS_EXPR
            && ((plan.receiverType != null
                    && self.managedValues.isMutex(
                        self.cTypes.resolveBodyType(plan.receiverType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0)))
                || (plan.call.callee.obj != null
                    && plan.call.callee.obj.kind == NK_IDENTIFIER
                    && self.analyzed.isRichEnum(
                        plan.call.callee.obj.name)));
        bool orderedBuiltin = plan.call.callee != null
            && plan.call.callee.kind == NK_IDENTIFIER
            && (plan.call.callee.name == "Mutex"
                || plan.call.callee.name == "print"
                || plan.call.callee.name == "printf");
        bool languageCall = plan.declaration != null
            || plan.parameters.len > 0 || orderedFieldCall
            || orderedBuiltin
            || self.analyzed.hostedCallKeys.has(
                AstIdentity.key(plan.call))
            || SemanticTypeSystem.directFunctionPointer(
                calleeType, self.analyzed) != null;
        bool materializeEffectfulCallee = plan.receiver != null
            && plan.receiver == plan.call.callee
            && self.operandPlanner.hasEffect(
                plan.receiver, self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()));
        plan.forceOrder = languageCall
            && (materializeEffectfulCallee
                || (self.callOwnership.requiresOrder(
                        plan.receiver, plan.operands,
                        self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()))
                    && plan.operands.len
                        + (plan.receiver == null ? 0 : 1) > 1));
    }

    private IRNode lowerDefaultArgumentCall(
            Node call, OwnershipCallPlan plan,
            OwnershipCallOperand operand,
            Map<string, Node> varTypes,
            CallableFlowState callableFlow) {
        CallTarget target =
            self.callTargets.defaultTarget(
                call, varTypes,
                self.callableContext(varTypes, callableFlow));
        string symbol = self.calls.ensureDefaultHelper(
            target, operand.parameterIndex);
        Vector<IRNode> arguments = [];
        if (target.selfType != null) {
            Node? receiver = plan.target.receiver;
            if (receiver == null && call.callee != null
                    && call.callee.kind == NK_FIELD_ACCESS_EXPR) {
                receiver = call.callee.obj;
            }
            if (receiver == null) {
                self.typedOperatorFail(
                    "default argument method receiver was not evaluated");
            }
            arguments.push(IRNode.cast(
                self.cTypes.lower(target.selfType),
                self.callOwnership.evaluatedDefaultValue(
                    receiver, "method receiver")));
        }
        int prior = 0;
        while (prior < operand.parameterIndex) {
            OwnershipCallOperand? bound =
                self.callOwnership.boundDefaultOperand(
                    plan.operands, prior);
            if (bound == null) {
                self.typedOperatorFail(
                    "default argument parameter '"
                        + plan.parameters.get(prior).name
                        + "' is unbound");
            }
            OwnershipCallOperand concreteBound = bound;
            arguments.push(self.callOwnership.evaluatedDefaultValue(
                concreteBound.expression,
                plan.parameters.get(prior).name));
            prior = prior + 1;
        }
        return IRNode.call(symbol, arguments);
    }

    private void addCallOperand(
            OwnershipBoundary boundary, Node call,
            OwnershipCallPlan plan, int index,
            Map<string, Node> varTypes, CallableFlowState callableFlow) {
        OwnershipCallOperand operand = plan.operands.get(index);
        self.callProjectionRoot(
            boundary, operand.expression, varTypes,
            self.callOmitsBorrowedProjectionGuard(
                call, plan.operands, index, varTypes), callableFlow);
        if (operand.typeExpr == null) {
            bool trailing = index + 1 == plan.operands.len
                && (index > 0 || plan.receiver != null)
                && !operand.owned && !operand.keepValue;
            if (!trailing) {
                self.ownershipSemantics.failOpaqueOperand(
                    operand.expression, "call arguments", true);
            }
            return;
        }
        if (operand.defaultArgument) {
            Node effectiveType = operand.targetType;
            bool managed = self.managedValues.isManaged(
                self.cTypes.resolveBodyType(effectiveType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
            boundary.addLoweredCallOperand(
                operand.expression, effectiveType,
                self.lowerDefaultArgumentCall(
                    call, plan, operand, varTypes, callableFlow),
                managed, operand.keepValue,
                managed && operand.transferred);
            return;
        }
        PreparedValue prepared = self.prepareCallTargetValue(operand.expression,
            operand.targetType, varTypes, callableFlow);
        self.operandPlanner.requireType(
            prepared.effectiveType, operand.expression);
        boundary.addLoweredCallOperand(
            operand.expression, prepared.effectiveType,
            prepared.value, prepared.owned, operand.keepValue,
            prepared.owned && operand.transferred);
    }

    private IRNode lowerImmediateLambdaCallWithOwnership(
            Node call, Map<string, Node> varTypes,
            CallableFlowState callableFlow) {
        OwnershipCallPlan plan = self.callOwnership.plan(
            call, self.context.ownershipEnvironment(
                varTypes, self.gpuPipeline.cpuActive()), callableFlow);
        if (plan.target.kind != CALL_TARGET_IMMEDIATE_LAMBDA
                || call.callee == null) {
            print("internal compiler error: immediate lambda call has no typed target");
            exit(1);
        }
        self.completeCallPlan(plan, varTypes);
        int defaultIndex = 0;
        while (defaultIndex < plan.operands.len) {
            if (plan.operands.get(defaultIndex).defaultArgument) {
                print("immediate lambda defaults require a declaration-owned helper");
                exit(1);
            }
            defaultIndex = defaultIndex + 1;
        }

        CallableLambdaPlan lambda = self.callableLowering.prepareLambda(
            call.callee, varTypes,
            self.callableContext(varTypes, callableFlow));
        OwnershipBoundary boundary = self.callOwnership.boundary();
        Vector<IRNode> captureValues = [];
        int captureIndex = 0;
        while (captureIndex < lambda.captures.len) {
            string capture = lambda.captures.get(captureIndex);
            if (!varTypes.has(capture)) {
                print("internal compiler error: immediate lambda capture has no type");
                exit(1);
            }
            Node captureType = varTypes.get(capture);
            Node concreteCaptureType = self.cTypes.resolveBodyType(
                captureType, self.context.activeTypeMap,
                self.context.genericBody
                    || self.context.callDefaultTypeDepth > 0);
            string captureCType = self.cTypes.lower(
                concreteCaptureType);
            if (self.context.genericBody
                    || self.context.callDefaultTypeDepth > 0) {
                captureCType = self.cTypes.lowerGeneric(
                    captureType, self.context.activeTypeMap);
            }
            captureValues.push(boundary.stageValue(
                concreteCaptureType, captureCType,
                IRNode.variable(self.context.sourceCName(capture)),
                false,
                self.managedValues.isManaged(concreteCaptureType),
                false));
            captureIndex = captureIndex + 1;
        }

        CallableInvocationEnvironment invocation =
            self.callableLowering.prepareInvocationEnvironment(
                lambda, captureValues);
        self.appendOwnershipNodes(
            boundary.declarations, invocation.declarations);
        self.appendOwnershipNodes(
            boundary.prefix, invocation.prefix);

        int argumentIndex = 0;
        while (argumentIndex < plan.operands.len) {
            self.addCallOperand(
                boundary, call, plan, argumentIndex,
                varTypes, callableFlow);
            argumentIndex = argumentIndex + 1;
        }
        Vector<IRNode> arguments = self.lowerResolvedCallArguments(
            plan.target, call, varTypes, callableFlow);
        IRNode lowered = self.callableLowering.materializeInvocation(
            lambda, arguments, invocation);
        Node? resultType = self.resolvedExpressionType(
            call, varTypes);
        bool promoteResult = resultType != null
            && self.managedValues.isManaged(
                self.cTypes.resolveBodyType(
                    resultType, self.context.activeTypeMap,
                    self.context.genericBody
                        || self.context.callDefaultTypeDepth > 0))
            && !plan.resultOwned;
        boundary.resultOwned = plan.resultOwned;
        boundary.restore();
        return boundary.finish(
            lowered, resultType, promoteResult,
            resultType == null, call);
    }

    public IRNode lowerCallWithOwnership(
            Node call, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        if (self.context.unevaluatedDepth > 0) {
            return self.lowerCallCore(call, varTypes, callableFlow);
        }
        self.rejectCallClosureEscapes(call, varTypes, callableFlow);
        if (call.callee != null
                && call.callee.kind == NK_LAMBDA_EXPR) {
            return self.lowerImmediateLambdaCallWithOwnership(
                call, varTypes, callableFlow);
        }
        if (call.callee != null
                && call.callee.kind == NK_FIELD_ACCESS_EXPR
                && call.callee.optional) {
            return self.lowerCallCore(call, varTypes, callableFlow);
        }
        if (call.callee != null
                && call.callee.kind == NK_IDENTIFIER
                && self.gpuPipeline.hasKernel(call.callee.name)
                && !callableFlow.hasEnvironment(call.callee.name)
                && !varTypes.has(call.callee.name)) {
            return self.lowerCallCore(call, varTypes, callableFlow);
        }
        OwnershipCallPlan plan = self.callOwnership.plan(
            call, self.context.ownershipEnvironment(
                varTypes, self.gpuPipeline.cpuActive()), callableFlow);
        self.completeCallPlan(plan, varTypes);
        bool convertsHostedResult =
            self.context.hasHostedConversion(call);
        bool projectionRoots = self.callHasProjectionRoots(
            call, plan, varTypes, callableFlow);
        if (!plan.requiresBoundary() && !projectionRoots) {
            return self.strings.lowerRequestedHostedStringResult(call, self.lowerCallCore(call, varTypes, callableFlow));
        }
        OwnershipBoundary boundary = self.callOwnership.boundary();
        if (plan.receiver != null) {
            self.callProjectionRoot(
                boundary, plan.receiver, varTypes, false, callableFlow);
            if (plan.receiverType == null) {
                self.ownershipSemantics.failOpaqueOperand(
                    plan.receiver, "call arguments", true);
            }
            Node concreteReceiverType = plan.receiverType;
            boundary.addLoweredOperand(
                plan.receiver, concreteReceiverType,
                self.lowerExpr(plan.receiver, varTypes, callableFlow),
                plan.receiverOwned, plan.receiverPinned);
        }
        int index = 0;
        while (index < plan.operands.len) {
            self.addCallOperand(
                boundary, call, plan, index, varTypes, callableFlow);
            index = index + 1;
        }
        IRNode lowered = self.strings.lowerRequestedHostedStringResult(call, self.lowerCallCore(call, varTypes, callableFlow));
        boundary.resultOwned = convertsHostedResult
            || plan.resultOwned;
        boundary.restore();
        Node? resultType = self.resolvedExpressionType(call, varTypes);
        if (convertsHostedResult) {
            resultType = SemanticTypeSystem.primitive("string");
        }
        return boundary.finish(
            lowered, resultType, false,
            resultType == null, call);
    }

    public IRNode lowerNewWithOwnership(
            Node expression, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        if (self.context.unevaluatedDepth > 0) {
            return self.lowerNewCore(expression, varTypes, callableFlow);
        }
        OwnershipCallPlan plan = self.callOwnership.plan(
            expression, self.context.ownershipEnvironment(
                varTypes, self.gpuPipeline.cpuActive()), callableFlow);
        self.completeCallPlan(plan, varTypes);
        bool projectionRoots = self.callHasProjectionRoots(
            expression, plan, varTypes, callableFlow);
        if (!plan.requiresBoundary() && !projectionRoots) {
            return self.lowerNewCore(expression, varTypes, callableFlow);
        }
        OwnershipBoundary boundary = self.callOwnership.boundary();
        int index = 0;
        while (index < plan.operands.len) {
            self.addCallOperand(
                boundary, expression, plan, index, varTypes, callableFlow);
            index = index + 1;
        }
        IRNode lowered = self.lowerNewCore(expression, varTypes, callableFlow);
        boundary.resultOwned = self.managedValues.isManaged(
            self.cTypes.resolveBodyType(
                self.resolvedExpressionType(expression, varTypes), self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
        boundary.restore();
        return boundary.finish(
            lowered,
            self.resolvedExpressionType(expression, varTypes), false);
    }

    public IRNode lowerOwnedEffectCall(string callee,
            Vector<IRNode> prefixArguments, Vector<Node> operands,
            Vector<Node> expectedTypes,
            Map<string, Node> varTypes, CallableFlowState callableFlow) {
        bool needsBoundary = false;
        OwnershipOperandEnvironment environment =
            self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive());
        int index = 0;
        while (index < operands.len) {
            Node? expectedType = null;
            if (index < expectedTypes.len) {
                expectedType = expectedTypes.get(index);
            }
            Node operand = operands.get(index);
            Node? sourceType = self.resolvedExpressionType(
                operand, varTypes);
            if (self.ownershipSemantics
                    .contextualUnconsumedOwnedResult(
                        operand, expectedType,
                        environment, callableFlow)
                    || self.strings.requiresTargetStringConversion(expectedType, sourceType)) {
                needsBoundary = true;
            }
            int laterIndex = index + 1;
            while (laterIndex < operands.len) {
                Node later = operands.get(laterIndex);
                bool operandEffect = self.operandPlanner.hasEffect(
                    operand, environment);
                bool laterEffect = self.operandPlanner.hasEffect(
                    later, environment);
                if ((operandEffect
                        && !self.operandPlanner.reorderInert(
                            later, environment))
                        || (laterEffect
                            && !self.operandPlanner.reorderInert(
                                operand, environment))) {
                    needsBoundary = true;
                }
                laterIndex = laterIndex + 1;
            }
            index = index + 1;
        }

        OwnershipBoundary boundary = self.callOwnership.boundary();
        if (needsBoundary) {
            index = 0;
            while (index < operands.len) {
                Node operand = operands.get(index);
                Node? expectedType = null;
                if (index < expectedTypes.len) {
                    expectedType = expectedTypes.get(index);
                }
                PreparedValue prepared = self.prepareCallTargetValue(operand, expectedType, varTypes, callableFlow);
                self.operandPlanner.requireType(
                    prepared.effectiveType, operand);
                bool laterEffect = false;
                int laterIndex = index + 1;
                while (laterIndex < operands.len) {
                    if (self.operandPlanner.hasEffect(
                            operands.get(laterIndex), environment)) {
                        laterEffect = true;
                    }
                    laterIndex = laterIndex + 1;
                }
                bool pinBorrowed = laterEffect
                    && !prepared.owned
                    && self.managedValues.isManaged(
                        self.cTypes.resolveBodyType(
                            prepared.effectiveType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
                boundary.addLoweredOperand(
                    operand, prepared.effectiveType,
                    prepared.value, prepared.owned, pinBorrowed);
                index = index + 1;
            }
        }

        Vector<IRNode> arguments = [];
        index = 0;
        while (index < prefixArguments.len) {
            arguments.push(prefixArguments.get(index));
            index = index + 1;
        }
        index = 0;
        while (index < operands.len) {
            if (needsBoundary) {
                arguments.push(self.lowerExpr(
                    operands.get(index), varTypes, callableFlow));
            } else if (index < expectedTypes.len) {
                Node operand = operands.get(index);
                Node targetType = expectedTypes.get(index);
                IRNode value = self.lowerAssignedValueRaw(
                    operand, targetType, varTypes, callableFlow);
                arguments.push(self.strings.upcastClassPointer(
                    targetType,
                    self.resolvedExpressionType(operand, varTypes),
                    value));
            } else {
                arguments.push(self.lowerExpr(
                    operands.get(index), varTypes, callableFlow));
            }
            index = index + 1;
        }
        IRNode call = IRNode.call(callee, arguments);
        if (!needsBoundary) { return call; }
        boundary.restore();
        return boundary.finish(
            call, SemanticTypeSystem.primitive("void"), false);
    }

    public IRNode finishOwnedConstruction(IRNode declaration,
            string runtimeType, Vector<IRNode> declarations,
            Vector<IRNode> construction) {
        IRNode value = IRNode.variable(declaration.name);
        if (!self.context.exceptionsAreEnabled()) {
            construction.push(value);
            return IRNode.statementExpression(
                declarations, IRNode.commaExpression(construction));
        }
        OwnershipBoundary cleanup = self.callOwnership.boundary();
        cleanup.registerCleanup(
            declaration, declaration.name, runtimeType);
        Vector<IRNode> sequence = [];
        int prefixIndex = 0;
        while (prefixIndex < cleanup.prefix.len) {
            sequence.push(cleanup.prefix.get(prefixIndex));
            prefixIndex = prefixIndex + 1;
        }
        int constructionIndex = 0;
        while (constructionIndex < construction.len) {
            sequence.push(construction.get(constructionIndex));
            constructionIndex = constructionIndex + 1;
        }
        string handoffName = self.context.freshTemporary(
            "__btrc_construction_handoff");
        IRNode handoffDeclaration = IRNode.variableDeclaration(
            declaration.c_type, handoffName, IRNode.literal("NULL"));
        declarations.push(handoffDeclaration);
        self.context.recordLocal(handoffDeclaration);
        IRNode handoff = IRNode.variable(handoffName);
        sequence.push(IRNode.binary(handoff, "=", value));
        sequence.push(IRNode.binary(
            value, "=", IRNode.literal("NULL")));
        sequence.push(handoff);
        return IRNode.statementExpression(
            declarations, IRNode.commaExpression(sequence));
    }

    private void appendOwnershipNodes(
            Vector<IRNode> destination, Vector<IRNode> source) {
        int index = 0;
        while (index < source.len) {
            destination.push(source.get(index));
            index = index + 1;
        }
    }

    public IRNode lowerOptionalCallWithOwnership(
            Node call, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        Node receiverExpression = call.callee.obj;
        Node? receiverType = self.resolvedExpressionType(
            receiverExpression, varTypes);
        self.operandPlanner.requireType(
            receiverType, receiverExpression);
        Node concreteReceiverType = receiverType;
        OwnershipOperandEnvironment environment =
            self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive());
        bool receiverOwned = self.ownershipSemantics
            .unconsumedOwnedResult(
                receiverExpression, environment, callableFlow);

        string receiverName = self.context.freshTemporary(
            "__btrc_optional_receiver");
        IRNode receiverDeclaration = IRNode.variableDeclaration(
            self.cTypes.lower(concreteReceiverType),
            receiverName, null);
        self.context.recordLocal(receiverDeclaration);
        IRNode receiver = IRNode.variable(receiverName);
        Vector<IRNode> declarations = [];
        declarations.push(receiverDeclaration);
        Vector<IRNode> sequence = [];
        sequence.push(IRNode.binary(
            receiver, "=",
            self.lowerExpr(receiverExpression, varTypes, callableFlow)));

        OwnershipCallPlan plan = self.callOwnership.plan(
            call, environment, callableFlow);
        self.completeCallPlan(plan, varTypes);
        bool operandsComplete =
            self.callOwnership.operandsHaveConcreteTypes(
                plan.operands);
        bool operandEffect = self.callOwnership.operandsHaveEffect(
            plan.operands, environment);
        bool receiverPinned = self.managedValues.isManaged(
                self.cTypes.resolveBodyType(concreteReceiverType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))
            && !receiverOwned
            && receiverExpression.kind != NK_SELF_EXPR
            && receiverExpression.kind != NK_SUPER_EXPR
            && ((operandEffect && operandsComplete)
                || plan.declaration != null);
        string receiverRuntimeType = "";
        IRNode receiverSaved = IRNode.literal("NULL");
        if (receiverOwned || receiverPinned) {
            receiverRuntimeType = self.managedValues.runtimeType(
                self.cTypes.resolveBodyType(concreteReceiverType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
            if (receiverPinned) {
                sequence.push(self.managedLifetime.retainValue(
                    receiver, self.cTypes.resolveBodyType(
                        concreteReceiverType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0)));
            }
            OwnershipBoundary receiverCleanup =
                self.callOwnership.boundary();
            receiverCleanup.registerCleanup(
                receiverDeclaration, receiverName,
                receiverRuntimeType);
            self.appendOwnershipNodes(
                sequence, receiverCleanup.prefix);
            string savedName = self.context.freshTemporary(
                "__btrc_optional_receiver_release");
            IRNode savedDeclaration = IRNode.variableDeclaration(
                self.cTypes.lower(concreteReceiverType),
                savedName, IRNode.literal("NULL"));
            self.context.recordLocal(savedDeclaration);
            declarations.push(savedDeclaration);
            receiverSaved = IRNode.variable(savedName);
        }

        string receiverKey = AstIdentity.key(receiverExpression);
        bool receiverHadOverride =
            self.context.hasExpressionOverrideKey(receiverKey);
        IRNode receiverPrevious = IRNode.literal("0");
        if (receiverHadOverride) {
            receiverPrevious =
                self.context.expressionOverrideForKey(receiverKey);
        }
        self.context.setExpressionOverrideKey(receiverKey, receiver);

        bool callableField = call.callee != null
            && call.callee.kind == NK_FIELD_ACCESS_EXPR
            && plan.target.kind == CALL_TARGET_CALLABLE_VALUE;
        bool callableOrder = callableField && operandsComplete
            && self.callOwnership.requiresOrder(
                call.callee, plan.operands, environment);
        bool forceArgumentOrder = operandsComplete
            && ((plan.operands.len > 1 && operandEffect)
                || callableOrder);
        bool argumentBoundary = forceArgumentOrder;
        int boundaryIndex = 0;
        while (!argumentBoundary
                && boundaryIndex < plan.operands.len) {
            OwnershipCallOperand operand =
                plan.operands.get(boundaryIndex);
            argumentBoundary = operand.defaultArgument
                || operand.owned || operand.keepValue
                || operand.needsConversion;
            boundaryIndex = boundaryIndex + 1;
        }
        OwnershipBoundary boundary = self.callOwnership.boundary();
        if (argumentBoundary) {
            if (callableField) {
                Node? projectedType = self.resolvedExpressionType(
                    call.callee, varTypes);
                self.operandPlanner.requireType(
                    projectedType, call.callee);
                Node concreteProjectedType = projectedType;
                bool wasOptional = call.callee.optional;
                call.callee.optional = false;
                IRNode projected = self.lowerExpr(
                    call.callee, varTypes, callableFlow);
                call.callee.optional = wasOptional;
                boundary.addLoweredCallOperand(
                    call.callee, concreteProjectedType,
                    projected, false, false, false);
            }
            int operandIndex = 0;
            while (operandIndex < plan.operands.len) {
                self.addCallOperand(
                    boundary, call, plan,
                    operandIndex, varTypes, callableFlow);
                operandIndex = operandIndex + 1;
            }
            self.appendOwnershipNodes(
                declarations, boundary.declarations);
        }

        IRNode lowered = self.lowerMethodCallCore(call, varTypes, callableFlow);
        if (argumentBoundary) { boundary.restore(); }
        if (receiverHadOverride) {
            self.context.setExpressionOverrideKey(
                receiverKey, receiverPrevious);
        } else {
            self.context.removeExpressionOverrideKey(receiverKey);
        }
        Vector<IRNode> trueSequence = [];
        if (argumentBoundary) {
            self.appendOwnershipNodes(
                trueSequence, boundary.prefix);
            self.appendOwnershipNodes(
                trueSequence, boundary.handoffs);
        }
        Node? resultType = self.resolvedExpressionType(call, varTypes);
        bool isVoid = resultType != null
            && resultType.base == "void"
            && resultType.pointer_depth == 0;
        if (isVoid) {
            trueSequence.push(lowered);
            if (argumentBoundary) {
                self.appendOwnershipNodes(
                    trueSequence, boundary.suffix);
            }
            trueSequence.push(IRNode.cast(
                "void", IRNode.literal("0")));
            sequence.push(IRNode.ternary(
                IRNode.binary(
                    receiver, "!=", IRNode.literal("NULL")),
                IRNode.commaExpression(trueSequence),
                IRNode.cast("void", IRNode.literal("0"))));
            if (receiverRuntimeType != "") {
                sequence.push(IRNode.binary(
                    receiverSaved, "=", receiver));
                sequence.push(IRNode.binary(
                    receiver, "=", IRNode.literal("NULL")));
                sequence.push(self.managedLifetime.optionalRelease(
                    receiverSaved, receiverRuntimeType));
            }
            sequence.push(IRNode.cast(
                "void", IRNode.literal("0")));
            return IRNode.statementExpression(
                declarations, IRNode.commaExpression(sequence));
        }

        string resultC = "int";
        if (resultType != null) {
            resultC = self.cTypes.lower(resultType);
        }
        string resultName = self.context.freshTemporary(
            "__btrc_optional_result");
        IRNode resultDeclaration = IRNode.variableDeclaration(
            resultC, resultName, null);
        self.context.recordLocal(resultDeclaration);
        declarations.push(resultDeclaration);
        trueSequence.push(IRNode.binary(
            IRNode.variable(resultName), "=", lowered));
        bool protectResult = self.context.exceptionsAreEnabled()
            && resultType != null
            && self.managedValues.isManaged(
                self.cTypes.resolveBodyType(resultType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))
            && self.ownershipSemantics.expressionOwnsResult(
                call, environment, callableFlow);
        if (protectResult) {
            string runtimeType = self.managedValues.runtimeType(
                self.cTypes.resolveBodyType(resultType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
            OwnershipBoundary resultCleanup =
                self.callOwnership.boundary();
            resultCleanup.registerCleanup(
                resultDeclaration, resultName, runtimeType);
            self.appendOwnershipNodes(
                trueSequence, resultCleanup.prefix);
        }
        if (argumentBoundary) {
            self.appendOwnershipNodes(
                trueSequence, boundary.suffix);
        }
        trueSequence.push(IRNode.variable(resultName));
        sequence.push(IRNode.ternary(
            IRNode.binary(
                receiver, "!=", IRNode.literal("NULL")),
            IRNode.commaExpression(trueSequence),
            IRNode.binary(
                IRNode.variable(resultName), "=",
                self.optionalCallZero(resultType))));
        if (receiverRuntimeType != "") {
            sequence.push(IRNode.binary(
                receiverSaved, "=", receiver));
            sequence.push(IRNode.binary(
                receiver, "=", IRNode.literal("NULL")));
            sequence.push(self.managedLifetime.optionalRelease(
                receiverSaved, receiverRuntimeType));
        }
        if (protectResult) {
            string handoffName = self.context.freshTemporary(
                "__btrc_optional_result_handoff");
            IRNode handoffDeclaration = IRNode.variableDeclaration(
                resultC, handoffName, IRNode.literal("NULL"));
            self.context.recordLocal(handoffDeclaration);
            declarations.push(handoffDeclaration);
            sequence.push(IRNode.binary(
                IRNode.variable(handoffName), "=",
                IRNode.variable(resultName)));
            sequence.push(IRNode.binary(
                IRNode.variable(resultName), "=",
                IRNode.literal("NULL")));
            sequence.push(IRNode.variable(handoffName));
        } else {
            sequence.push(IRNode.variable(resultName));
        }
        return IRNode.statementExpression(
            declarations, IRNode.commaExpression(sequence));
    }

    public ManagedReleaseSlot lowerManagedReleaseSlot(
            ManagedReleaseSlotPlan plan,
            Map<string, Node> varTypes,
            Vector<IRNode> statements, CallableFlowState callableFlow) {
        OwnershipBoundary boundary = self.callOwnership.boundary();
        ManagedReleaseSlot slot = ManagedReleaseSlot(plan, boundary);
        if (plan.persistentOwner != null
                && plan.persistentOwnerType != null) {
            Node ownerNode = plan.persistentOwner;
            Node ownerType = plan.persistentOwnerType;
            string ownerName = self.context.freshTemporary(
                "__btrc_release_owner");
            IRNode declaration = IRNode.variableDeclaration(
                self.cTypes.lower(self.cTypes.resolveBodyType(ownerType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0)),
                ownerName, self.lowerExpr(ownerNode, varTypes, callableFlow));
            boundary.declarations.push(declaration);
            self.context.recordLocal(declaration);
            slot.owner = IRNode.variable(ownerName);
            slot.persistent = true;
            boundary.rememberOverride(ownerNode, slot.owner);
        }
        if (plan.expression.kind == NK_INDEX_EXPR) {
            if (plan.orderedIndex) {
                Node objectType = plan.objectType;
                Node indexType = plan.indexType;
                boundary.addLoweredOperand(
                    plan.expression.obj, objectType,
                    self.lowerExpr(plan.expression.obj, varTypes, callableFlow),
                    false, false);
                boundary.addLoweredOperand(
                    plan.expression.index, indexType,
                    self.lowerExpr(plan.expression.index, varTypes, callableFlow),
                    false, false);
            }
            slot.target = self.lowerIndexCore(
                plan.expression, varTypes, callableFlow);
        } else {
            slot.target = self.lowerExpr(plan.expression, varTypes, callableFlow);
        }
        boundary.restore();
        slot.emitBefore(statements);
        return slot;
    }

    /* Typed arbitrary-expression cleanup at a full-expression boundary. */
    public IRNode releaseVarStmt2(IRNode target, string runtimeType) {
        Vector<IRNode> statements = [];
        statements.push(IRNode.expressionStatement(self.managedLifetime.releaseRuntime(target, runtimeType)));
        if (self.cycles.runtimeTypeMayCycle(runtimeType)) {
            statements.push(IRNode.expressionStatement(self.managedLifetime.pollCycles()));
        }
        return IRNode.block(statements);
    }

    public IRNode lowerExpr(Node node, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        if (node == null) { return IRNode.literal("0"); }
        if (self.gpuPipeline.cpuActive() && node.kind == NK_INDEX_EXPR) {
            IRNode array = self.lowerExpr(
                node.obj, varTypes, callableFlow);
            IRNode index = self.lowerExpr(
                node.index, varTypes, callableFlow);
            return self.gpuPipeline.cpuIndexExpression(
                node, array, index);
        }
        /* ARC: an owning-temporary argument hoisted into a temp var resolves to
         * that temp (mirrors expressions.lower_expr's _owning_temp_overrides
         * check). The temp is declared/initialized in the call's pre-stmts. */
        if (self.context.expressionOverrideCount() > 0) {
            string key = AstIdentity.key(node);
            if (self.context.hasExpressionOverrideKey(key)) {
                return self.context.expressionOverrideForKey(key);
            }
        }
        if (node.kind == NK_INT_LITERAL) {
            return IRNode.literal(IntegerLiteral(node.raw).cSource(node.value_int));
        }
        if (node.kind == NK_FLOAT_LITERAL) {
            string raw = node.raw;
            if (raw == "") { raw = f"{node.value_float}"; }
            if (self.gpuPipeline.cpuActive()
                    && !raw.endsWith("f") && !raw.endsWith("F")) {
                raw = raw + "f";
            }
            return IRNode.literal(raw);
        }
        if (node.kind == NK_STRING_LITERAL) { return IRNode.literal(node.value_string); }
        if (node.kind == NK_CHAR_LITERAL) { return IRNode.literal(node.value_string); }
        if (node.kind == NK_F_STRING_LITERAL) { return self.lowerFString(node, varTypes, callableFlow); }
        if (node.kind == NK_BOOL_LITERAL) {
            if (node.value_bool) { return IRNode.literal("true"); }
            return IRNode.literal("false");
        }
        if (node.kind == NK_NULL_LITERAL) { return IRNode.literal("NULL"); }
        if (node.kind == NK_IDENTIFIER) {
            if (self.context.defaultDeclarationDepth > 0) {
                if (node.name == "__func__") {
                    return IRNode.literal(
                        StringLiteral(self.context.defaultFunctionName).cSource());
                }
                if (node.name == "__LINE__") {
                    return IRNode.literal(Strings.fromInt(
                        self.context.sourceLineFor(node.line)));
                }
                if (node.name == "__FILE__") {
                    return IRNode.literal(StringLiteral(
                        self.context.sourceFileForLine(node.line)).cSource());
                }
            }
            if (self.context.sourceHelperVisible(node.name)
                    && !varTypes.has(node.name)
                    && !self.analyzed.funcTable.has(node.name)) {
                self.context.referenceHelper(node.name);
                return IRNode.functionReference(node.name);
            }
            if (self.context.enumInitializer
                    && self.context.enumMembers.has(node.name)) {
                string prefix = self.context.enumOwner;
                if (prefix != "") { prefix = prefix + "_"; }
                return IRNode.variable(prefix + node.name);
            }
            /* Bare enum value (RED -> Color_RED). Mirrors expressions.
             * _lower_identifier's enum_table scan. */
            if (self.analyzed.isEnumValue(node.name)) {
                string owner = self.analyzed.enumOwnerOf(node.name);
                if (owner != "") { owner = owner + "_"; }
                return IRNode.variable(owner + node.name);
            }
            if (self.analyzed.funcTable.has(node.name)
                    && !varTypes.has(node.name)) {
                return IRNode.functionReference(
                    self.declarations.sourceFunctionSymbol(node.name));
            }
            if (varTypes.has(node.name)) {
                Node bindingType = varTypes.get(node.name);
                return IRNode.recordArrayValue(
                    IRNode.variable(self.context.sourceCName(node.name)),
                    bindingType != null && bindingType.is_array);
            }
            return IRNode.variable(node.name);
        }
        if (node.kind == NK_SELF_EXPR) { return IRNode.variable("self"); }
        if (node.kind == NK_SUPER_EXPR) {
            Node? parentType = self.resolvedExpressionType(node, varTypes);
            if (parentType == null) {
                print("internal compiler error: unresolved super expression");
                exit(1);
            }
            return IRNode.cast(
                self.cTypes.lower(parentType), IRNode.variable("self"));
        }
        if (node.kind == NK_NEW_EXPR) {
            return self.lowerNewWithOwnership(node, varTypes, callableFlow);
        }
        if (node.kind == NK_FIELD_ACCESS_EXPR) {
            return self.lowerOwnedFieldAccess(node, varTypes, callableFlow);
        }
        if (node.kind == NK_BINARY_EXPR) {
            return self.lowerOwnedBinary(node, varTypes, callableFlow);
        }
        if (node.kind == NK_UNARY_EXPR) { return self.lowerUnary(node, varTypes, callableFlow); }
        if (node.kind == NK_CALL_EXPR) {
            return self.lowerCallWithOwnership(node, varTypes, callableFlow);
        }
        if (node.kind == NK_CAST_EXPR) {
            self.callableBoundaries.rejectNonportableCallableCast(
                node,
                self.resolvedExpressionType(
                    node.expr, varTypes),
                callableFlow.boundaryContext(
                    varTypes, self.context.activeTypeMap,
                    self.context.genericBody
                        || self.context.callDefaultTypeDepth > 0));
            string targetC = self.cTypes.lower(self.cTypes.resolveBodyType(node.target_type, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
            if (self.context.genericBody || self.context.callDefaultTypeDepth > 0) {
                targetC = self.cTypes.lowerGeneric(
                    node.target_type, self.context.activeTypeMap);
            }
            return IRNode.cast(targetC, self.lowerExpr(node.expr, varTypes, callableFlow));
        }
        if (node.kind == NK_TERNARY_EXPR) {
            return self.lowerTypedTernary(node, varTypes, callableFlow);
        }
        if (node.kind == NK_INDEX_EXPR) {
            return self.lowerOwnedIndex(node, varTypes, callableFlow);
        }
        if (node.kind == NK_ASSIGN_EXPR) {
            return self.materializeAssignment(node, varTypes, callableFlow);
        }
        if (node.kind == NK_SIZEOF_EXPR) {
            return self.lowerSizeof(node, varTypes, callableFlow);
        }
        if (node.kind == NK_LIST_LITERAL) {
            return self.lowerListLiteral(node, varTypes, null, callableFlow);
        }
        if (node.kind == NK_MAP_LITERAL) {
            return self.lowerMapLiteral(node, varTypes, null, callableFlow);
        }
        if (node.kind == NK_BRACE_INITIALIZER) {
            return self.lowerBraceInit(node, varTypes, null, callableFlow);
        }
        if (node.kind == NK_LAMBDA_EXPR) {
            CallableLambdaPlan lambda = self.callableLowering.prepareLambda(
                node, varTypes,
                self.callableContext(varTypes, callableFlow));
            return lambda.value;
        }
        if (node.kind == NK_TUPLE_LITERAL) {
            return self.lowerTupleLiteral(node, varTypes, callableFlow);
        }
        if (node.kind == NK_SPAWN_EXPR) {
            return self.lowerSpawn(node, varTypes, callableFlow);
        }
        print(f"irgen: unsupported expression kind {node.kind}");
        exit(1);
        return IRNode.literal("0");
    }

    /* Compute a lambda's captured variable names: identifiers used in the body
     * that are enclosing locals/params (present in varTypes) and are NOT lambda
     * params, sorted lexicographically. Mirrors analyzer._analyze_lambda's
     * capture computation (btrcc does it on-demand at lowering, having no
     * persistent scope). Module-level globals are visible directly inside the
     * lifted lambda (file scope), so they are NEVER captured even though they
     * appear in varTypes (the global scope is seeded into every function's
     * varTypes); mirrors the reference, where captures come from enclosing
     * function scope, not the module scope. */
    public IRNode lowerSpawn(Node node, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        self.context.referenceHelper("__btrc_thread_spawn");
        Node fn = node.fn;
        /* Non-lambda spawn: treat the operand as a function pointer value. */
        if (fn == null || fn.kind != NK_LAMBDA_EXPR) {
            if (fn != null && fn.kind == NK_IDENTIFIER
                    && callableFlow.hasEnvironment(fn.name)) {
                print(f"A capturing lambda alias cannot be spawned; pass the "
                    + f"lambda literal directly at {node.line}:{node.col}");
                exit(1);
            }
            IRNode fnExpr = self.lowerExpr(fn, varTypes, callableFlow);
            Vector<IRNode> sargs = [];
            sargs.push(IRNode.cast("void*(*)(void*)", fnExpr));
            sargs.push(IRNode.literal("NULL"));
            sargs.push(IRNode.literal("NULL"));
            Node? fnType = self.resolvedExpressionType(fn, varTypes);
            Node? resultType = null;
            if (fnType != null) {
                fnType = SemanticTypeSystem.resolveTypedefType(
                    fnType, self.analyzed.typedefTable);
                if (fnType != null && fnType.base == "__fn_ptr"
                        && fnType.generic_args.len > 0) {
                    resultType = fnType.generic_args.get(0);
                }
            }
            self.concurrency.appendThreadResultDisposal(sargs, resultType);
            return IRNode.call("__btrc_thread_spawn", sargs);
        }

        CallableSpawnPlan plan = self.callableLowering.prepareSpawn(
            node, varTypes,
            self.callableContext(varTypes, callableFlow));
        return plan.value;
    }

    /* Rewrite every return in a structured worker-entry body. The entry only
     * borrows captures; its runtime-owned argument disposer runs afterward. */
    public IRNode lowerAssignedValueRaw(Node valueNode, Node? targetType,
            Map<string, Node> varTypes, CallableFlowState callableFlow) {
        if (self.context.expressionOverrideCount() > 0) {
            string key = AstIdentity.key(valueNode);
            if (self.context.hasExpressionOverrideKey(key)) {
                return self.context.expressionOverrideForKey(key);
            }
        }
        if (valueNode.kind == NK_LIST_LITERAL) {
            return self.lowerListLiteral(valueNode, varTypes, targetType, callableFlow);
        }
        if (valueNode.kind == NK_MAP_LITERAL) {
            return self.lowerMapLiteral(valueNode, varTypes, targetType, callableFlow);
        }
        if (valueNode.kind == NK_BRACE_INITIALIZER) {
            return self.lowerBraceInit(valueNode, varTypes, targetType, callableFlow);
        }
        if (valueNode.kind == NK_TUPLE_LITERAL) {
            return self.lowerSequencedTuple(
                valueNode, targetType, varTypes, callableFlow);
        }
        return self.lowerExpr(valueNode, varTypes, callableFlow);
    }

    public IRNode lowerAssignedValue(Node valueNode, Node? targetType,
            Map<string, Node> varTypes, CallableFlowState callableFlow) {
        return self.prepareTargetValue(valueNode, targetType, varTypes, callableFlow).value;
    }

    public string directGenericTargetC(Node target, Node targetType,
            Map<string, Node> varTypes) {
        if (!self.context.genericBody && self.context.callDefaultTypeDepth == 0) {
            return self.cTypes.lower(targetType);
        }
        if (target.kind == NK_IDENTIFIER && varTypes.has(target.name)) {
            return self.cTypes.lowerGeneric(varTypes.get(target.name), self.context.activeTypeMap);
        }
        if (target.kind == NK_FIELD_ACCESS_EXPR && target.obj != null) {
            Node? receiverType = self.resolvedExpressionType(
                target.obj, varTypes);
            if (receiverType != null
                    && receiverType.generic_args.len > 0
                    && self.analyzed.isGenericClass(receiverType.base)) {
                Node? member = SemanticTypeSystem.genericMember(
                    self.analyzed, receiverType.base, target.field);
                if (member != null && member.type != null) {
                    return self.cTypes.lowerGeneric(member.type, SemanticTypeSystem.genericTypeMap(self.analyzed, receiverType));
                }
            }
        }
        return self.cTypes.lower(self.cTypes.resolveBodyType(
            targetType, self.context.activeTypeMap,
            self.context.genericBody
                || self.context.callDefaultTypeDepth > 0));
    }

    public IRNode lowerDirectCompound(string compoundOp,
            IRNode target, IRNode right, Node? targetType, Node? rightType,
            string targetC) {
        if (targetType == null || rightType == null) {
            return IRNode.binary(target, compoundOp, right);
        }
        /* The setjmp pass can qualify the backing automatic after lowering.
         * A pointer-to-volatile is valid for ordinary storage too and keeps
         * this synthesized lvalue compatible when that happens. */
        string pointerType = targetC + " volatile*";
        string pointerName = self.context.freshTemporary("__btrc_lvalue");
        string oldName = self.context.freshTemporary("__btrc_update_old");
        IRNode pointer = IRNode.variable(pointerName);
        IRNode loaded = IRNode.dereference(pointer);
        loaded.storage_root = IRNode.directStorageRoot(target);
        loaded.storage_root_known = true;
        IRNode oldValue = IRNode.variable(oldName);
        Vector<IRNode> declarations = [];
        declarations.push(IRNode.variableDeclaration(pointerType, pointerName, null));
        declarations.push(IRNode.variableDeclaration(
            targetC, oldName, null));
        Vector<IRNode> sequence = [];
        sequence.push(IRNode.binary(pointer, "=", IRNode.addressOf(target)));
        sequence.push(IRNode.binary(oldValue, "=", loaded));
        string baseOp = compoundOp.substring(0, compoundOp.length() - 1);
        IRNode? computed = self.lowerOverloadedValues(
            baseOp, oldValue, right, targetType, rightType);
        if (computed == null) {
            computed = self.lowerTypedBinaryValues(
                baseOp, oldValue, right, targetType, rightType);
        }
        if (computed == null) {
            computed = IRNode.binary(oldValue, baseOp, right);
        }
        sequence.push(IRNode.binary(loaded, "=", computed));
        return IRNode.statementExpression(declarations, IRNode.commaExpression(sequence));
    }

    public IRNode lowerDirectStore(
            IRNode target, IRNode value, Node targetType,
            string targetC) {
        string pointerType = targetC + " volatile*";
        string pointerName = self.context.freshTemporary("__btrc_lvalue");
        IRNode pointer = IRNode.variable(pointerName);
        IRNode loaded = IRNode.dereference(pointer);
        loaded.storage_root = IRNode.directStorageRoot(target);
        loaded.storage_root_known = true;
        Vector<IRNode> declarations = [];
        declarations.push(IRNode.variableDeclaration(
            pointerType, pointerName, null));
        Vector<IRNode> sequence = [];
        sequence.push(IRNode.binary(
            pointer, "=", IRNode.addressOf(target)));
        sequence.push(IRNode.binary(loaded, "=", value));
        return IRNode.statementExpression(declarations, IRNode.commaExpression(sequence));
    }

    /* Property and generic-collection targets are not C lvalues. Build an
     * explicit single-evaluation load/store plan for simple and compound
     * assignments. Direct locals, fields, pointers, and raw indexes return
     * null and remain on the ordinary C-lvalue path. */
    public IRNode? lowerIndirectAssignment(
            Node node, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        IRNode? bounded = self.lowerIndexedAssignmentWithOwnership(node, varTypes, callableFlow);
        if (bounded != null) { return bounded; }
        return self.lowerIndirectAssignmentCore(node, varTypes, callableFlow);
    }

    public IRNode? lowerIndirectAssignmentCore(
            Node node, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        Node target = node.target;
        if (target == null) { return null; }

        if (target.kind == NK_FIELD_ACCESS_EXPR
                && target.obj != null) {
            Node? receiverType = self.resolvedExpressionType(
                target.obj, varTypes);
            Node? property = DeclarationRegistry.instanceMemberForType(
                self.analyzed, receiverType, target.field);
            if (receiverType != null && property != null
                    && property.kind == NK_PROPERTY_DECL
                    && !DeclarationRegistry.propertyTargetUsesBacking(
                        target.obj, target.field,
                        self.context.currentPropertyBacking)) {
                if (target.optional) {
                    self.typedOperatorFail(
                        "optional-chain expressions are not assignable");
                }
                if (!property.has_setter) {
                    self.typedOperatorFail(
                        "property '" + target.field + "' has no setter");
                }
                if (node.op != "=" && !property.has_getter) {
                    self.typedOperatorFail(
                        "property '" + target.field + "' has no getter");
                }
                Node? valueType = self.resolvedExpressionType(target, varTypes);
                if (valueType == null) {
                    self.typedOperatorFail(
                        "cannot resolve property assignment target type");
                }
                if (node.op == "=") {
                    return self.lowerPropertyStoreWithOwnership(node, receiverType, property,
                        valueType, varTypes, callableFlow);
                }
                string receiverName = self.context.freshTemporary("__btrc_property_obj");
                string valueName = self.context.freshTemporary("__btrc_update_value");
                IRNode receiver = IRNode.variable(receiverName);
                IRNode result = IRNode.variable(valueName);
                Vector<IRNode> declarations = [];
                declarations.push(IRNode.variableDeclaration(
                    self.cTypes.lower(receiverType), receiverName, null));
                declarations.push(IRNode.variableDeclaration(
                    self.cTypes.lower(valueType), valueName, null));
                Vector<IRNode> sequence = [];
                sequence.push(IRNode.binary(
                    receiver, "=", self.lowerExpr(target.obj, varTypes, callableFlow)));
                string prefix = DeclarationRegistry.instanceFunctionPrefix(
                    self.analyzed, receiverType);
                string setter = prefix + "_set_" + target.field;
                if (node.op == "=") {
                    IRNode value = self.lowerAssignedValueRaw(
                        node.value_node, valueType, varTypes, callableFlow);
                    Node? sourceType = self.resolvedExpressionType(
                        node.value_node, varTypes);
                    value = self.strings.upcastClassPointer(
                        valueType, sourceType, value);
                    sequence.push(IRNode.binary(result, "=", value));
                } else {
                    string oldName = self.context.freshTemporary("__btrc_update_old");
                    IRNode oldValue = IRNode.variable(oldName);
                    declarations.push(IRNode.variableDeclaration(
                        self.cTypes.lower(valueType), oldName, null));
                    Vector<IRNode> getterArgs = [];
                    getterArgs.push(receiver);
                    sequence.push(IRNode.binary(
                        oldValue, "=",
                        IRNode.call(prefix + "_get_" + target.field, getterArgs)));
                    IRNode right = self.lowerAssignedValue(
                        node.value_node, valueType, varTypes, callableFlow);
                    Node? rightType = self.resolvedExpressionType(
                        node.value_node, varTypes);
                    string baseOp = node.op.substring(
                        0, node.op.length() - 1);
                    IRNode? computed = self.lowerOverloadedValues(
                        baseOp, oldValue, right, valueType, rightType);
                    if (computed == null) {
                        computed = self.lowerTypedBinaryValues(
                            baseOp, oldValue, right, valueType, rightType);
                    }
                    if (computed == null) {
                        computed = IRNode.binary(oldValue, baseOp, right);
                    }
                    sequence.push(IRNode.binary(result, "=", computed));
                }
                Vector<IRNode> setterArgs = [];
                setterArgs.push(receiver);
                setterArgs.push(result);
                sequence.push(IRNode.call(setter, setterArgs));
                sequence.push(result);
                return IRNode.statementExpression(declarations, IRNode.commaExpression(sequence));
            }
        }

        if (target.kind == NK_INDEX_EXPR) {
            Node? receiverType = self.resolvedExpressionType(
                target.obj, varTypes);
            if (receiverType != null
                    && !StorageValidator.rawIndexedPointer(
                        receiverType, self.analyzed)
                    && StorageValidator.validIndexedSetter(StorageValidator.indexedMethod(
                        receiverType, "set", self.analyzed))) {
                Node? valueType = self.resolvedExpressionType(target, varTypes);
                if (node.op == "=") {
                    Node? setter = StorageValidator.indexedMethod(
                        receiverType, "set", self.analyzed);
                    if (StorageValidator.validIndexedSetter(setter)) {
                        Node concreteSetter = setter;
                        valueType = StorageValidator.resolvedIndexedType(
                            concreteSetter.params.get(1).type,
                            receiverType, self.analyzed);
                    }
                }
                Node? indexType = self.resolvedExpressionType(
                    target.index, varTypes);
                Node? setterForIndex = StorageValidator.indexedMethod(
                    receiverType, "set", self.analyzed);
                if (StorageValidator.validIndexedSetter(setterForIndex)) {
                    Node concreteSetterForIndex = setterForIndex;
                    indexType = StorageValidator.resolvedIndexedType(
                        concreteSetterForIndex.params.get(0).type,
                        receiverType, self.analyzed);
                }
                if (valueType == null || indexType == null) {
                    self.typedOperatorFail(
                        "cannot resolve collection assignment target type");
                }
                if (node.op != "=" && StorageValidator.indexedMethod(
                        receiverType, "get", self.analyzed) == null) {
                    self.typedOperatorFail(
                        "type '" + receiverType.base
                            + "' has no indexed getter");
                }
                string receiverName = self.context.freshTemporary("__btrc_index_obj");
                string indexName = self.context.freshTemporary("__btrc_index");
                string valueName = self.context.freshTemporary("__btrc_update_value");
                IRNode receiver = IRNode.variable(receiverName);
                IRNode index = IRNode.variable(indexName);
                IRNode result = IRNode.variable(valueName);
                Vector<IRNode> declarations = [];
                declarations.push(IRNode.variableDeclaration(
                    self.cTypes.lower(receiverType), receiverName, null));
                declarations.push(IRNode.variableDeclaration(
                    self.cTypes.lower(indexType), indexName, null));
                declarations.push(IRNode.variableDeclaration(
                    self.cTypes.lower(valueType), valueName, null));
                Vector<IRNode> sequence = [];
                sequence.push(IRNode.binary(
                    receiver, "=", self.lowerExpr(target.obj, varTypes, callableFlow)));
                IRNode indexValue = self.lowerExpr(
                    target.index, varTypes, callableFlow);
                Node? sourceIndexType = self.resolvedExpressionType(
                    target.index, varTypes);
                indexValue = self.strings.upcastClassPointer(
                    indexType, sourceIndexType, indexValue);
                sequence.push(IRNode.binary(index, "=", indexValue));
                string prefix = receiverType.base;
                if (self.analyzed.isGenericClass(receiverType.base)) {
                    prefix = TypeIdentity.mangleGenericType(
                        receiverType.base, receiverType.generic_args);
                }
                if (node.op == "=") {
                    IRNode value = self.lowerAssignedValueRaw(
                        node.value_node, valueType, varTypes, callableFlow);
                    Node? sourceType = self.resolvedExpressionType(
                        node.value_node, varTypes);
                    value = self.strings.upcastClassPointer(
                        valueType, sourceType, value);
                    sequence.push(IRNode.binary(result, "=", value));
                } else {
                    string oldName = self.context.freshTemporary("__btrc_update_old");
                    IRNode oldValue = IRNode.variable(oldName);
                    declarations.push(IRNode.variableDeclaration(
                        self.cTypes.lower(valueType), oldName, null));
                    Vector<IRNode> getterArgs = [];
                    getterArgs.push(receiver);
                    getterArgs.push(index);
                    sequence.push(IRNode.binary(
                        oldValue, "=", IRNode.call(prefix + "_get", getterArgs)));
                    IRNode right = self.lowerAssignedValue(
                        node.value_node, valueType, varTypes, callableFlow);
                    Node? rightType = self.resolvedExpressionType(
                        node.value_node, varTypes);
                    string baseOp = node.op.substring(
                        0, node.op.length() - 1);
                    IRNode? computed = self.lowerOverloadedValues(
                        baseOp, oldValue, right, valueType, rightType);
                    if (computed == null) {
                        computed = self.lowerTypedBinaryValues(
                            baseOp, oldValue, right, valueType, rightType);
                    }
                    if (computed == null) {
                        computed = IRNode.binary(oldValue, baseOp, right);
                    }
                    sequence.push(IRNode.binary(result, "=", computed));
                }
                Vector<IRNode> setterArgs = [];
                setterArgs.push(receiver);
                setterArgs.push(index);
                setterArgs.push(result);
                sequence.push(IRNode.call(prefix + "_set", setterArgs));
                sequence.push(result);
                return IRNode.statementExpression(declarations, IRNode.commaExpression(sequence));
            }
        }
        return null;
    }

    public IRNode? lowerIndirectIncDec(
            Node node, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        Node target = node.operand;
        if (target == null) { return null; }
        string arithmeticOp = "+";
        if (node.op == "--") { arithmeticOp = "-"; }
        Node oneType = SemanticTypeSystem.primitive("int");

        if (target.kind == NK_FIELD_ACCESS_EXPR
                && target.obj != null) {
            Node? receiverType = self.resolvedExpressionType(
                target.obj, varTypes);
            Node? property = DeclarationRegistry.instanceMemberForType(
                self.analyzed, receiverType, target.field);
            if (receiverType != null && property != null
                    && property.kind == NK_PROPERTY_DECL
                    && !DeclarationRegistry.propertyTargetUsesBacking(
                        target.obj, target.field,
                        self.context.currentPropertyBacking)) {
                if (target.optional) {
                    self.typedOperatorFail(
                        "optional-chain expressions are not assignable");
                }
                if (!property.has_setter) {
                    self.typedOperatorFail(
                        "property '" + target.field + "' has no setter");
                }
                if (!property.has_getter) {
                    self.typedOperatorFail(
                        "property '" + target.field + "' has no getter");
                }
                Node? valueType = self.resolvedExpressionType(target, varTypes);
                if (valueType == null) {
                    self.typedOperatorFail(
                        "cannot resolve property update target type");
                }
                string receiverName = self.context.freshTemporary("__btrc_property_obj");
                string oldName = self.context.freshTemporary("__btrc_update_old");
                string newName = self.context.freshTemporary("__btrc_update_new");
                IRNode receiver = IRNode.variable(receiverName);
                IRNode oldValue = IRNode.variable(oldName);
                IRNode newValue = IRNode.variable(newName);
                Vector<IRNode> declarations = [];
                declarations.push(IRNode.variableDeclaration(
                    self.cTypes.lower(receiverType), receiverName, null));
                declarations.push(IRNode.variableDeclaration(
                    self.cTypes.lower(valueType), oldName, null));
                declarations.push(IRNode.variableDeclaration(
                    self.cTypes.lower(valueType), newName, null));
                Vector<IRNode> sequence = [];
                sequence.push(IRNode.binary(
                    receiver, "=", self.lowerExpr(target.obj, varTypes, callableFlow)));
                Vector<IRNode> getterArgs = [];
                getterArgs.push(receiver);
                string prefix = DeclarationRegistry.instanceFunctionPrefix(
                    self.analyzed, receiverType);
                sequence.push(IRNode.binary(
                    oldValue, "=", IRNode.call(
                        prefix + "_get_" + target.field,
                        getterArgs)));
                IRNode? computed = self.lowerTypedBinaryValues(
                    arithmeticOp, oldValue, IRNode.literal("1"),
                    valueType, oneType);
                if (computed == null) {
                    computed = IRNode.binary(
                        oldValue, arithmeticOp, IRNode.literal("1"));
                }
                sequence.push(IRNode.binary(newValue, "=", computed));
                Vector<IRNode> setterArgs = [];
                setterArgs.push(receiver);
                setterArgs.push(newValue);
                sequence.push(IRNode.call(
                    prefix + "_set_" + target.field,
                    setterArgs));
                if (node.prefix) { sequence.push(newValue); }
                else { sequence.push(oldValue); }
                return IRNode.statementExpression(declarations, IRNode.commaExpression(sequence));
            }
        }

        if (target.kind == NK_INDEX_EXPR) {
            Node? receiverType = self.resolvedExpressionType(
                target.obj, varTypes);
            if (receiverType != null
                    && !StorageValidator.rawIndexedPointer(
                        receiverType, self.analyzed)
                    && StorageValidator.validIndexedSetter(StorageValidator.indexedMethod(
                        receiverType, "set", self.analyzed))) {
                Node? valueType = self.resolvedExpressionType(target, varTypes);
                Node? indexType = self.resolvedExpressionType(
                    target.index, varTypes);
                if (valueType == null || indexType == null) {
                    self.typedOperatorFail(
                        "cannot resolve collection update target type");
                }
                if (StorageValidator.indexedMethod(
                        receiverType, "get", self.analyzed) == null) {
                    self.typedOperatorFail(
                        "indexed update requires get and set methods");
                }
                string receiverName = self.context.freshTemporary("__btrc_index_obj");
                string indexName = self.context.freshTemporary("__btrc_index");
                string oldName = self.context.freshTemporary("__btrc_update_old");
                string newName = self.context.freshTemporary("__btrc_update_new");
                IRNode receiver = IRNode.variable(receiverName);
                IRNode index = IRNode.variable(indexName);
                IRNode oldValue = IRNode.variable(oldName);
                IRNode newValue = IRNode.variable(newName);
                Vector<IRNode> declarations = [];
                declarations.push(IRNode.variableDeclaration(
                    self.cTypes.lower(receiverType), receiverName, null));
                declarations.push(IRNode.variableDeclaration(
                    self.cTypes.lower(indexType), indexName, null));
                declarations.push(IRNode.variableDeclaration(
                    self.cTypes.lower(valueType), oldName, null));
                declarations.push(IRNode.variableDeclaration(
                    self.cTypes.lower(valueType), newName, null));
                Vector<IRNode> sequence = [];
                sequence.push(IRNode.binary(
                    receiver, "=", self.lowerExpr(target.obj, varTypes, callableFlow)));
                sequence.push(IRNode.binary(
                    index, "=", self.lowerExpr(target.index, varTypes, callableFlow)));
                string prefix = receiverType.base;
                if (self.analyzed.isGenericClass(receiverType.base)) {
                    prefix = TypeIdentity.mangleGenericType(
                        receiverType.base, receiverType.generic_args);
                }
                Vector<IRNode> getterArgs = [];
                getterArgs.push(receiver);
                getterArgs.push(index);
                sequence.push(IRNode.binary(
                    oldValue, "=", IRNode.call(prefix + "_get", getterArgs)));
                IRNode? computed = self.lowerTypedBinaryValues(
                    arithmeticOp, oldValue, IRNode.literal("1"),
                    valueType, oneType);
                if (computed == null) {
                    computed = IRNode.binary(
                        oldValue, arithmeticOp, IRNode.literal("1"));
                }
                sequence.push(IRNode.binary(newValue, "=", computed));
                Vector<IRNode> setterArgs = [];
                setterArgs.push(receiver);
                setterArgs.push(index);
                setterArgs.push(newValue);
                sequence.push(IRNode.call(prefix + "_set", setterArgs));
                if (node.prefix) { sequence.push(newValue); }
                else { sequence.push(oldValue); }
                return IRNode.statementExpression(declarations, IRNode.commaExpression(sequence));
            }
        }
        return null;
    }

    public Node? resolvedExpressionType(
            Node? expression, Map<string, Node> varTypes) {
        return self.operandPlanner.expressionType(
            expression, self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()));
    }

    public void typedOperatorFail(string message) {
        fprintf(stderr, "error: %s\n", message);
        exit(1);
    }

    /* Nullable-safe lexicographic comparison. Both source operands are assigned
     * to temps in a comma expression, so each runs exactly once at the original
     * expression site; strcmp is reached only when both values are non-null. */
    public IRNode lowerStringComparisonValues(
            string op, IRNode left, IRNode right) {
        string leftName = self.context.freshTemporary("__btrc_cmp_left");
        string rightName = self.context.freshTemporary("__btrc_cmp_right");
        IRNode leftVar = IRNode.variable(leftName);
        IRNode rightVar = IRNode.variable(rightName);
        IRNode zero = IRNode.literal("0");
        IRNode nullValue = IRNode.literal("NULL");
        Vector<IRNode> strcmpArgs = [];
        strcmpArgs.push(leftVar);
        strcmpArgs.push(rightVar);
        IRNode compareValue = IRNode.ternary(
            IRNode.binary(leftVar, "==", rightVar),
            zero,
            IRNode.ternary(
                IRNode.binary(leftVar, "==", nullValue),
                IRNode.literal("-1"),
                IRNode.ternary(
                    IRNode.binary(rightVar, "==", nullValue),
                    IRNode.literal("1"),
                    IRNode.call("strcmp", strcmpArgs))));
        Vector<IRNode> declarations = [];
        declarations.push(IRNode.variableDeclaration("const char*", leftName, null));
        declarations.push(IRNode.variableDeclaration("const char*", rightName, null));
        Vector<IRNode> sequence = [];
        sequence.push(IRNode.binary(leftVar, "=", left));
        sequence.push(IRNode.binary(rightVar, "=", right));
        sequence.push(IRNode.binary(compareValue, op, zero));
        return IRNode.statementExpression(declarations, IRNode.commaExpression(sequence));
    }

    public IRNode lowerNumericValues(string op, IRNode left, IRNode right,
            Node leftType, Node rightType) {
        IRNode loweredLeft = left;
        IRNode loweredRight = right;
        Node? resultType = NumericSemantics.resultType(
            leftType, rightType, self.analyzed);
        if (resultType == null) {
            self.typedOperatorFail(
                "cannot resolve numeric result type for operator '" + op + "'");
        }
        string resultC = self.cTypes.lower(resultType);
        if (op == "/" || op == "%") {
            string helper = "__btrc_div";
            if (op == "%") { helper = "__btrc_mod"; }
            self.context.referenceHelper(helper);
            Vector<IRNode> args = [];
            args.push(IRNode.cast(resultC, loweredLeft));
            args.push(IRNode.cast(resultC, loweredRight));
            return IRNode.cast(resultC, IRNode.call(helper, args));
        }
        if (NumericSemantics.operandsNeedCast(leftType, rightType, self.analyzed)) {
            loweredLeft = IRNode.cast(resultC, loweredLeft);
            loweredRight = IRNode.cast(resultC, loweredRight);
        }
        return IRNode.binary(loweredLeft, op, loweredRight);
    }

    public IRNode lowerNumericComparisonValues(
            string op, IRNode left, IRNode right,
            Node leftType, Node rightType) {
        Node? resultType = NumericSemantics.resultType(
            leftType, rightType, self.analyzed);
        if (resultType == null) {
            self.typedOperatorFail(
                "cannot resolve numeric result type for operator '" + op + "'");
        }
        if (leftType.base == rightType.base) {
            return IRNode.binary(left, op, right);
        }
        string resultC = self.cTypes.lower(resultType);
        return IRNode.binary(
            IRNode.cast(resultC, left), op,
            IRNode.cast(resultC, right));
    }

    public IRNode lowerReferenceEqualityValues(string op,
            IRNode left, IRNode right, Node leftType, Node rightType) {
        if (self.operators.isNullType(leftType)
                || self.operators.isNullType(rightType)) {
            Node? functionType = null;
            if (leftType.base == "__fn_ptr") { functionType = leftType; }
            if (rightType.base == "__fn_ptr") { functionType = rightType; }
            if (functionType != null) {
                IRNode typedNull = IRNode.cast(
                    self.cTypes.lower(functionType), IRNode.literal("0"));
                if (self.operators.isNullType(leftType)) {
                    return IRNode.binary(typedNull, op, right);
                }
                return IRNode.binary(left, op, typedNull);
            }
            return IRNode.binary(left, op, right);
        }
        if (leftType.base == "__fn_ptr" && rightType.base == "__fn_ptr") {
            string leftName = self.context.freshTemporary("__btrc_fn_left");
            string rightName = self.context.freshTemporary("__btrc_fn_right");
            IRNode leftVar = IRNode.variable(leftName);
            IRNode rightVar = IRNode.variable(rightName);
            string pointerType = self.cTypes.lower(leftType);
            Vector<IRNode> declarations = [];
            declarations.push(IRNode.variableDeclaration(pointerType, leftName, null));
            declarations.push(IRNode.variableDeclaration(pointerType, rightName, null));
            Vector<IRNode> sequence = [];
            sequence.push(IRNode.binary(leftVar, "=", left));
            sequence.push(IRNode.binary(rightVar, "=", right));
            sequence.push(IRNode.binary(leftVar, op, rightVar));
            return IRNode.statementExpression(declarations, IRNode.commaExpression(sequence));
        }
        return IRNode.binary(
            IRNode.cast("const void*", left), op,
            IRNode.cast("const void*", right));
    }

    public IRNode? lowerOverloadedValues(string op, IRNode left, IRNode right,
            Node? leftType, Node? rightType) {
        if (leftType == null) { return null; }
        string magic = self.operators.binaryMethodName(op);
        if (magic == "") { return null; }
        if (self.analyzed.isClass(leftType.base)) {
            Node? method = self.analyzed.classMethod(leftType.base, magic);
            if (method == null || method.kind != NK_METHOD_DECL) { return null; }
            IRNode loweredRight = right;
            if (method.params.len > 0) {
                loweredRight = self.strings.upcastClassPointer(
                    method.params.get(0).type, rightType, loweredRight);
            }
            Vector<IRNode> args = [];
            args.push(left);
            args.push(loweredRight);
            return IRNode.call(leftType.base + "_" + magic, args);
        }
        if (leftType.generic_args.len > 0
                && self.analyzed.isGenericClass(leftType.base)) {
            Node? method = self.analyzed.genericClassMethod(
                leftType.base, magic);
            if (method == null) { return null; }
            Vector<IRNode> args = [];
            args.push(left);
            args.push(right);
            return IRNode.call(
                TypeIdentity.mangleGenericType(leftType.base, leftType.generic_args)
                    + "_" + magic,
                args);
        }
        return null;
    }

    public IRNode? lowerTypedBinaryValues(string op,
            IRNode left, IRNode right, Node? leftType, Node? rightType) {
        /* Unresolved operands from an opaque C context remain C-authoritative.
         * Preserve the operator as structured IR instead of applying source-
         * language numeric validation to a type the analyzer cannot see. */
        if (leftType == null || rightType == null) {
            return IRNode.binary(left, op, right);
        }
        if (op == "+"
                && (TypeComposition.isSemanticScalarString(leftType)
                    || self.operators.isCStringPointer(leftType))
                && (TypeComposition.isSemanticScalarString(rightType)
                    || self.operators.isCStringPointer(rightType))
                && (TypeComposition.isSemanticScalarString(leftType)
                    || TypeComposition.isSemanticScalarString(rightType))) {
            self.context.referenceHelper("__btrc_strcat");
            self.context.referenceHelper("__btrc_str_track");
            Vector<IRNode> catArgs = [];
            catArgs.push(left);
            catArgs.push(right);
            Vector<IRNode> trackArgs = [];
            trackArgs.push(IRNode.call("__btrc_strcat", catArgs));
            return IRNode.call("__btrc_str_track", trackArgs);
        }
        if (self.operators.isComparisonOperator(op)) {
            int domain = self.operators.comparisonDomain(
                op, leftType, rightType);
            if (domain == OP_DOMAIN_UNRESOLVED) {
                return IRNode.binary(left, op, right);
            }
            if (domain == OP_DOMAIN_INVALID) {
                string leftLabel = "unknown";
                string rightLabel = "unknown";
                if (leftType != null) { leftLabel = TypeIdentity.shapeKey(leftType); }
                if (rightType != null) { rightLabel = TypeIdentity.shapeKey(rightType); }
                /* Generic instances emit every method before function DCE. An
                 * invalid typed operator in an unreachable method must not
                 * reject the whole instance (for example Vector<UiNode>.min).
                 * Defer the structured diagnostic until after function DCE. */
                if (self.context.genericBody) {
                    return IRNode.invalidExpression(
                        "operator '" + op + "' is not defined for operands '"
                            + leftLabel + "' and '" + rightLabel + "'");
                }
                self.typedOperatorFail(
                    "operator '" + op + "' is not defined for operands '"
                        + leftLabel + "' and '" + rightLabel + "'");
            }
            if (domain == OP_DOMAIN_STRING) {
                return self.lowerStringComparisonValues(op, left, right);
            }
            if (domain == OP_DOMAIN_REFERENCE) {
                return self.lowerReferenceEqualityValues(
                    op, left, right, leftType, rightType);
            }
            return self.lowerNumericComparisonValues(
                op, left, right, leftType, rightType);
        }
        if ((op == "+" || op == "-" || op == "*" || op == "&"
                || op == "|" || op == "^")
                && NumericSemantics.isType(leftType, self.analyzed)
                && NumericSemantics.isType(rightType, self.analyzed)) {
            return self.lowerNumericValues(
                op, left, right, leftType, rightType);
        }
        if (op == "/" || op == "%") {
            if (!NumericSemantics.isType(leftType, self.analyzed)
                    || !NumericSemantics.isType(rightType, self.analyzed)) {
                self.typedOperatorFail(
                    "operator '" + op + "' requires numeric operands");
            }
            return self.lowerNumericValues(
                op, left, right, leftType, rightType);
        }
        return null;
    }

    public IRNode lowerTypedTernary(Node node, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        IRNode condition = self.lowerExpr(node.condition, varTypes, callableFlow);
        CallableFlowSnapshot branchEntry =
            callableFlow.snapshot();
        bool trueOwned = self.ownershipSemantics.expressionOwnsResult(node.true_expr, self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()), callableFlow);
        IRNode trueValue = self.lowerExpr(node.true_expr, varTypes, callableFlow);
        CallableFlowSnapshot trueFlow =
            callableFlow.snapshot();
        callableFlow.restore(branchEntry);
        bool falseOwned = self.ownershipSemantics.expressionOwnsResult(node.false_expr, self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()), callableFlow);
        IRNode falseValue = self.lowerExpr(node.false_expr, varTypes, callableFlow);
        CallableFlowSnapshot falseFlow =
            callableFlow.snapshot();
        callableFlow.restore(branchEntry);
        Vector<CallableFlowSnapshot> branchFlows = [];
        branchFlows.push(trueFlow);
        branchFlows.push(falseFlow);
        callableFlow.join(branchFlows);
        Node? trueType = self.resolvedExpressionType(node.true_expr, varTypes);
        Node? falseType = self.resolvedExpressionType(node.false_expr, varTypes);
        bool truePromotable = node.true_expr.kind == NK_NULL_LITERAL
            || trueOwned
            || self.managedValues.isManaged(
                self.cTypes.resolveBodyType(trueType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
        bool falsePromotable = node.false_expr.kind == NK_NULL_LITERAL
            || falseOwned
            || self.managedValues.isManaged(
                self.cTypes.resolveBodyType(falseType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
        bool conditionalOwned = self.managedValues.isManaged(
                self.cTypes.resolveBodyType(
                    self.resolvedExpressionType(node, varTypes), self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))
            && (trueOwned || falseOwned)
            && truePromotable && falsePromotable;
        if (conditionalOwned) {
            if (node.true_expr.kind != NK_NULL_LITERAL
                    && self.managedValues.isManaged(
                        self.cTypes.resolveBodyType(trueType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))
                    && !trueOwned) {
                trueValue = self.promoteBorrowedValue(trueValue, trueType);
            }
            if (node.false_expr.kind != NK_NULL_LITERAL
                    && self.managedValues.isManaged(
                        self.cTypes.resolveBodyType(falseType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))
                    && !falseOwned) {
                falseValue = self.promoteBorrowedValue(falseValue, falseType);
            }
        }
        Node? resultType = NumericSemantics.resultType(
            trueType, falseType, self.analyzed);
        if (resultType != null && trueType != null && falseType != null
                && NumericSemantics.operandsNeedCast(
                    trueType, falseType, self.analyzed)) {
            string resultC = self.cTypes.lower(resultType);
            trueValue = IRNode.cast(resultC, trueValue);
            falseValue = IRNode.cast(resultC, falseValue);
        }
        return IRNode.ternary(condition, trueValue, falseValue);
    }

    private bool optionalPresenceCondition(IRNode? condition) {
        if (condition == null || condition.kind != IRK_BINOP
                || condition.op != "!="
                || condition.left == null
                || condition.right == null) {
            return false;
        }
        return condition.left.kind == IRK_VAR
            && condition.right.kind == IRK_LITERAL
            && (condition.right.text == "NULL"
                || condition.right.text == "0");
    }

    /* Return only the variable carried by an expression's result path.  Casts,
     * assignments, statement expressions, and the final comma operand preserve
     * that path; no other operand is a def-use edge for the enclosing value. */
    private string optionalResultVariable(IRNode? node) {
        if (node == null) { return ""; }
        if (node.kind == IRK_VAR) { return node.name; }
        if (node.kind == IRK_CAST) {
            return self.optionalResultVariable(node.expr);
        }
        if (node.kind == IRK_BINOP && node.op == "=") {
            return self.optionalResultVariable(node.right);
        }
        if (node.kind == IRK_STMT_EXPR) {
            return self.optionalResultVariable(node.result);
        }
        if (node.kind == IRK_COMMA_EXPR && node.args.len > 0) {
            return self.optionalResultVariable(
                node.args.get(node.args.len - 1));
        }
        return "";
    }

    /* Find a direct definition only when it is itself on the terminal result
     * path.  In particular, this never searches a cleanup guard or an arbitrary
     * call/binary operand. */
    private IRNode? optionalResultAssignment(
            IRNode? node, string resultName) {
        if (node == null) { return null; }
        if (node.kind == IRK_BINOP && node.op == "="
                && node.left != null && node.left.kind == IRK_VAR
                && node.left.name == resultName) {
            return node;
        }
        if (node.kind == IRK_CAST) {
            return self.optionalResultAssignment(
                node.expr, resultName);
        }
        if (node.kind == IRK_STMT_EXPR) {
            return self.optionalResultAssignment(
                node.result, resultName);
        }
        if (node.kind == IRK_COMMA_EXPR && node.args.len > 0) {
            return self.optionalResultAssignment(
                node.args.get(node.args.len - 1), resultName);
        }
        return null;
    }

    /* Optional calls define their result inside the presence ternary rather
     * than through a following top-level assignment.  Require both branches to
     * carry the sought result before rewriting the absent branch.  A release
     * guard therefore cannot be mistaken for the optional value definition. */
    private bool replaceOptionalResultDefinition(
            IRNode node, string resultName, IRNode fallback) {
        if (node.kind == IRK_CAST) {
            return self.replaceOptionalResultDefinition(
                node.expr, resultName, fallback);
        }
        if (node.kind == IRK_STMT_EXPR) {
            return self.replaceOptionalResultDefinition(
                node.result, resultName, fallback);
        }
        if (node.kind == IRK_COMMA_EXPR && node.args.len > 0) {
            return self.replaceOptionalResultDefinition(
                node.args.get(node.args.len - 1),
                resultName, fallback);
        }
        if (node.kind != IRK_TERNARY
                || !self.optionalPresenceCondition(node.condition)
                || self.optionalResultVariable(node.true_expr)
                    != resultName) {
            return false;
        }
        IRNode? absentAssignment = self.optionalResultAssignment(
            node.false_expr, resultName);
        if (absentAssignment == null) { return false; }
        absentAssignment.right = fallback;
        return true;
    }

    private bool optionalNodeDefinesResult(
            IRNode node, string resultName) {
        if (self.optionalResultAssignment(
                node, resultName) != null) {
            return true;
        }
        if (node.kind == IRK_CAST) {
            return self.optionalNodeDefinesResult(
                node.expr, resultName);
        }
        if (node.kind == IRK_STMT_EXPR) {
            return self.optionalNodeDefinesResult(
                node.result, resultName);
        }
        if (node.kind == IRK_COMMA_EXPR) {
            if (node.args.len == 0
                    || self.optionalResultVariable(
                        node.args.get(node.args.len - 1))
                        != resultName) {
                return false;
            }
            int index = node.args.len - 1;
            while (index >= 0) {
                if (self.optionalNodeDefinesResult(
                        node.args.get(index), resultName)) {
                    return true;
                }
                index = index - 1;
            }
            return false;
        }
        if (node.kind != IRK_TERNARY) { return false; }
        return self.optionalNodeDefinesResult(
                node.true_expr, resultName)
            || self.optionalNodeDefinesResult(
                node.false_expr, resultName);
    }

    /* Walk one comma sequence backward along its result's def-use path.  This
     * follows handoff aliases past later clears, stops at the newest concrete
     * definition, and only inspects a ternary when its branches define the
     * value being sought. */
    private bool replaceOptionalSequenceFallback(
            IRNode sequence, IRNode fallback) {
        if (sequence.args.len == 0) { return false; }
        int resultIndex = sequence.args.len - 1;
        IRNode result = sequence.args.get(resultIndex);
        if (self.replaceOptionalFallback(result, fallback)) {
            return true;
        }
        string resultName = self.optionalResultVariable(result);
        if (resultName == "") { return false; }
        int index = resultIndex - 1;
        while (index >= 0) {
            IRNode definition = sequence.args.get(index);
            IRNode? assignment = self.optionalResultAssignment(
                definition, resultName);
            if (assignment != null) {
                if (self.replaceOptionalFallback(
                        definition, fallback)) {
                    return true;
                }
                string alias = self.optionalResultVariable(
                    assignment.right);
                if (alias == "") { return false; }
                resultName = alias;
                index = index - 1;
                continue;
            }
            if (self.replaceOptionalResultDefinition(
                    definition, resultName, fallback)) {
                return true;
            }
            if (self.optionalResultVariable(definition)
                    == resultName
                    && self.replaceOptionalFallback(
                        definition, fallback)) {
                return true;
            }
            if (self.optionalNodeDefinesResult(
                    definition, resultName)) {
                return false;
            }
            index = index - 1;
        }
        return false;
    }

    /* Fuse `??` into the optional chain's value path without inspecting
     * unrelated operands or cleanup suffixes. */
    private bool replaceOptionalFallback(
            IRNode? node, IRNode fallback) {
        if (node == null) { return false; }
        if (node.kind == IRK_TERNARY
                && self.optionalPresenceCondition(node.condition)) {
            string resultName = self.optionalResultVariable(
                node.true_expr);
            if (resultName != ""
                    && self.replaceOptionalResultDefinition(
                        node, resultName, fallback)) {
                return true;
            }
            node.false_expr = fallback;
            return true;
        }
        if (node.kind == IRK_STMT_EXPR) {
            return self.replaceOptionalFallback(
                node.result, fallback);
        }
        if (node.kind == IRK_COMMA_EXPR) {
            return self.replaceOptionalSequenceFallback(
                node, fallback);
        }
        if (node.kind == IRK_BINOP && node.op == "=") {
            return self.replaceOptionalFallback(
                node.right, fallback);
        }
        if (node.kind == IRK_CAST) {
            return self.replaceOptionalFallback(node.expr, fallback);
        }
        return false;
    }

    public IRNode lowerBinaryCore(Node node, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        string op = node.op;
        bool leftOwned = false;
        if (op == "??") {
            leftOwned = self.ownershipSemantics.expressionOwnsResult(node.left, self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()), callableFlow);
        }
        IRNode left = self.lowerExpr(node.left, varTypes, callableFlow);
        CallableFlowSnapshot rightEntry =
            callableFlow.snapshot();
        bool rightOwned = false;
        if (op == "??") {
            rightOwned = self.ownershipSemantics.expressionOwnsResult(node.right, self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()), callableFlow);
        }
        IRNode right = self.lowerExpr(node.right, varTypes, callableFlow);
        if (op == "&&" || op == "||" || op == "??") {
            CallableFlowSnapshot rightFlow =
                callableFlow.snapshot();
            callableFlow.restore(rightEntry);
            Vector<CallableFlowSnapshot> outcomes = [];
            outcomes.push(rightEntry);
            outcomes.push(rightFlow);
            callableFlow.join(outcomes);
        }
        Node? leftType = self.resolvedExpressionType(node.left, varTypes);
        Node? rightType = self.resolvedExpressionType(node.right, varTypes);

        bool leftPromotable = node.left.kind == NK_NULL_LITERAL
            || leftOwned
            || self.managedValues.isManaged(
                self.cTypes.resolveBodyType(leftType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
        bool rightPromotable = node.right.kind == NK_NULL_LITERAL
            || rightOwned
            || self.managedValues.isManaged(
                self.cTypes.resolveBodyType(rightType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
        bool coalesceOwned = op == "??"
            && self.managedValues.isManaged(
                self.cTypes.resolveBodyType(
                    self.resolvedExpressionType(node, varTypes), self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))
            && (leftOwned || rightOwned)
            && leftPromotable && rightPromotable;
        if (coalesceOwned) {
            if (node.left.kind != NK_NULL_LITERAL
                    && self.managedValues.isManaged(
                        self.cTypes.resolveBodyType(leftType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))
                    && !leftOwned) {
                left = self.promoteBorrowedValue(left, leftType);
            }
            if (node.right.kind != NK_NULL_LITERAL
                    && self.managedValues.isManaged(
                        self.cTypes.resolveBodyType(rightType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))
                    && !rightOwned) {
                right = self.promoteBorrowedValue(right, rightType);
            }
        }

        IRNode? overloaded = self.lowerOverloadedValues(
            op, left, right, leftType, rightType);
        if (overloaded != null) { return overloaded; }

        IRNode? typed = self.lowerTypedBinaryValues(
            op, left, right, leftType, rightType);
        if (typed != null) { return typed; }

        /* Null coalescing evaluates `a` once at the expression site. Only its
         * declaration may be hoisted out of an enclosing control expression. */
        if (op == "??") {
            if (self.operators.isOptionalValueCoalesce(
                    node.left, leftType, rightType)) {
                if (!self.replaceOptionalFallback(left, right)) {
                    self.typedOperatorFail(
                        "optional-chain coalescing requires a presence ternary");
                }
                return left;
            }
            string tmp = self.context.freshTemporary("__nc");
            Node? resultType = leftType;
            if (self.operators.isNullType(leftType)) { resultType = rightType; }
            string cType = "void*";
            if (resultType != null) {
                cType = self.cTypes.lower(resultType);
            }
            Vector<IRNode> declarations = [];
            declarations.push(IRNode.variableDeclaration(cType, tmp, null));
            Vector<IRNode> sequence = [];
            sequence.push(IRNode.binary(IRNode.variable(tmp), "=", left));
            sequence.push(IRNode.ternary(
                IRNode.binary(IRNode.variable(tmp), "!=", IRNode.literal("NULL")),
                IRNode.variable(tmp), right));
            return IRNode.statementExpression(declarations, IRNode.commaExpression(sequence));
        }
        return IRNode.binary(left, op, right);
    }

    public IRNode lowerUnary(Node node, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        if (node.op == "++" || node.op == "--") {
            IRNode? ownedTarget = self.lowerOwnedUnaryUpdate(node, varTypes, callableFlow);
            if (ownedTarget != null) { return ownedTarget; }
        }
        return self.lowerUnaryCore(node, varTypes, callableFlow);
    }

    public IRNode lowerUnaryCore(Node node, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        if (node.op == "++" || node.op == "--") {
            IRNode? indirect = self.lowerIndirectIncDec(node, varTypes, callableFlow);
            if (indirect != null) { return indirect; }
        }
        if (node.op == "&") {
            self.callableBoundaries.rejectAddressEscape(
                node.operand,
                self.resolvedExpressionType(
                    node.operand, varTypes),
                callableFlow.boundaryContext(
                    varTypes, self.context.activeTypeMap,
                    self.context.genericBody
                        || self.context.callDefaultTypeDepth > 0));
        }
        IRNode operand = self.lowerExpr(node.operand, varTypes, callableFlow);
        string op = node.op;
        if (op == "&") {
            IRNode address = IRNode.addressOf(operand);
            address.source_address = true;
            return address;
        }
        if (op == "*") { return IRNode.dereference(operand); }
        /* Operator overloading: -obj -> ClassName___neg__(obj) for a class with
         * a __neg__ method. */
        if (op == "-" && node.prefix) {
            Node? ot = self.resolvedExpressionType(
                node.operand, varTypes);
            if (!self.context.genericBody && ot != null && self.analyzed.isClass(ot.base)) {
                Node? mm = self.analyzed.classMethod(ot.base, "__neg__");
                if (mm != null && mm.kind == NK_METHOD_DECL) {
                    Vector<IRNode> nargs = [];
                    nargs.push(operand);
                    return IRNode.call(ot.base + "___neg__", nargs);
                }
            }
            /* Monomorphized generic-instance __neg__: -box -> <mangled>___neg__(box).
             * Mirrors operators._lower_unary's generic_args branch. */
            if (!self.context.genericBody && ot != null && ot.generic_args.len > 0
                    && self.analyzed.isGenericClass(ot.base)) {
                Node? gmm = self.analyzed.genericClassMethod(ot.base, "__neg__");
                if (gmm != null) {
                    string gmangled = TypeIdentity.mangleGenericType(ot.base, ot.generic_args);
                    Vector<IRNode> gnargs = [];
                    gnargs.push(operand);
                    return IRNode.call(gmangled + "___neg__", gnargs);
                }
            }
        }
        return IRNode.unary(op, operand, node.prefix);
    }

    public IRNode lowerSizeof(Node node, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        Node operand = node.operand;
        if (operand != null && operand.kind == NK_SIZEOF_TYPE) {
            string operandC = self.cTypes.lower(self.cTypes.resolveBodyType(operand.type, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
            if (self.context.genericBody || self.context.callDefaultTypeDepth > 0) {
                operandC = self.cTypes.lowerGeneric(
                    operand.type, self.context.activeTypeMap);
            }
            return IRNode.sizeofType(operandC);
        }
        if (operand != null && operand.kind == NK_SIZEOF_EXPR_OP) {
            Node? expressionType = self.resolvedExpressionType(
                operand.expr, varTypes);
            if (expressionType != null && !expressionType.is_array
                    && operand.expr.kind != NK_STRING_LITERAL) {
                string expressionC = self.cTypes.lower(
                    expressionType);
                if (self.context.genericBody
                        || self.context.callDefaultTypeDepth > 0) {
                    expressionC = self.cTypes.lowerGeneric(
                        expressionType, self.context.activeTypeMap);
                }
                return IRNode.sizeofType(expressionC);
            }
            self.context.unevaluatedDepth = self.context.unevaluatedDepth + 1;
            IRNode inner = self.lowerExpr(operand.expr, varTypes, callableFlow);
            self.context.unevaluatedDepth = self.context.unevaluatedDepth - 1;
            return IRNode.sizeofExpression(inner);
        }
        return IRNode.sizeofType("void");
    }

    /* Lower [a, b, c] with a hoistable declaration and an expression-local
     * allocation/push sequence (mirrors collections.lower_list_literal). */
    public IRNode lowerListLiteral(Node node, Map<string, Node> varTypes, Node? expected, CallableFlowState callableFlow) {
        string mangled = "btrc_Vector_int";
        Node? elementExpected = null;
        Node concreteExpected = self.cTypes.resolveBodyType(expected, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
        if (expected != null && concreteExpected.generic_args.len > 0) {
            mangled = TypeIdentity.mangleGenericType(
                concreteExpected.base, concreteExpected.generic_args);
            elementExpected = concreteExpected.generic_args.get(0);
        } else if (node.elements.len > 0) {
            Node? et = self.resolvedExpressionType(
                node.elements.get(0), varTypes);
            if (et != null) {
                Node vt = SemanticTypeSystem.primitive("Vector");
                Vector<Node> ga = [];
                ga.push(et);
                vt.generic_args = ga;
                /* Class element types must be upgraded to pointers so the inferred
                 * mangle matches the registered instance (`btrc_Vector_GraphNode_p1`,
                 * not `btrc_Vector_GraphNode`). */
                SemanticTypeSystem.upgradeConcreteTypeGenericArgs(vt, self.analyzed);
                mangled = TypeIdentity.mangleGenericType("Vector", vt.generic_args);
                elementExpected = vt.generic_args.get(0);
            }
        }
        string tmp = self.context.freshTemporary("__list");
        Vector<IRNode> declarations = [];
        Vector<IRNode> newArgs = [];
        IRNode declaration = IRNode.variableDeclaration(
            mangled + "*", tmp, IRNode.literal("NULL"));
        declarations.push(declaration);
        self.context.recordLocal(declaration);
        Vector<IRNode> sequence = [];
        sequence.push(IRNode.binary(
            IRNode.variable(tmp), "=", IRNode.call(mangled + "_new", newArgs)));
        int i = 0;
        while (i < node.elements.len) {
            Vector<IRNode> prefixArguments = [];
            prefixArguments.push(IRNode.variable(tmp));
            Vector<Node> operands = [];
            operands.push(node.elements.get(i));
            Vector<Node> expectedTypes = [];
            if (elementExpected != null) {
                expectedTypes.push(elementExpected);
            }
            sequence.push(self.lowerOwnedEffectCall(mangled + "_push", prefixArguments,
                operands, expectedTypes, varTypes, callableFlow));
            i = i + 1;
        }
        return self.finishOwnedConstruction(declaration, mangled, declarations, sequence);
    }

    /* Lower a tuple literal `(a, b, ...)` to a C compound literal
     * `(btrc_Tuple_T0_T1){._0 = a, ._1 = b, ...}` (mirrors
     * expressions._lower_tuple). The struct name is mangled from the inferred
     * element types; an element whose type can't be inferred falls back to
     * `int`, matching the Python fallback path. */
    public IRNode lowerTupleLiteral(Node node, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        return self.lowerSequencedTuple(node, null, varTypes, callableFlow);
    }

    public IRNode lowerTupleLiteralPlain(
            Node node, Node? expected,
            Map<string, Node> varTypes, CallableFlowState callableFlow) {
        if (expected != null) {
            Node concrete = self.cTypes.resolveBodyType(expected, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
            if (concrete.base == "Tuple") {
                Vector<string> expectedFields = [];
                Vector<IRNode> expectedValues = [];
                int expectedIndex = 0;
                while (expectedIndex < node.elements.len
                        && expectedIndex < concrete.generic_args.len) {
                    expectedFields.push(
                        "_" + Strings.fromInt(expectedIndex));
                    expectedValues.push(self.lowerAssignedValue(
                        node.elements.get(expectedIndex),
                        concrete.generic_args.get(expectedIndex),
                        varTypes, callableFlow));
                    expectedIndex = expectedIndex + 1;
                }
                return IRNode.compoundLiteral(
                    self.cTypes.lower(concrete),
                    expectedFields, expectedValues);
            }
        }
        Vector<Node> elemTypes = [];
        int i = 0;
        while (i < node.elements.len) {
            Node? et = self.resolvedExpressionType(
                node.elements.get(i), varTypes);
            if (et == null) {
                Node fallback = Node();
                fallback.kind = NK_TYPE_EXPR;
                fallback.base = "int";
                elemTypes.push(fallback);
            } else {
                elemTypes.push(TypeShape.copyTree(et));
            }
            i = i + 1;
        }
        /* Class/generic element types must be upgraded to pointers so the
         * inferred mangle matches the synthesized tuple struct + declared var
         * type (`btrc_Tuple_string_Vector_int_p1`, not
         * `btrc_Tuple_string_Vector_int`). Mirrors the list-literal path above
         * and Python's _lower_tuple, which mangles the node's (already
         * pointer-upgraded) declared type. */
        Node tt = SemanticTypeSystem.primitive("Tuple");
        tt.generic_args = elemTypes;
        SemanticTypeSystem.upgradeConcreteTypeGenericArgs(tt, self.analyzed);
        string mangled = TypeIdentity.mangleGenericSymbol("Tuple", tt.generic_args);
        Vector<string> fields = [];
        Vector<IRNode> elems = [];
        int j = 0;
        while (j < node.elements.len) {
            fields.push("_" + Strings.fromInt(j));
            elems.push(self.lowerExpr(node.elements.get(j), varTypes, callableFlow));
            j = j + 1;
        }
        return IRNode.compoundLiteral(mangled, fields, elems);
    }

    public OwnershipBoundary prepareAggregateBoundary(
            AggregateEvaluationPlan plan,
            Map<string, Node> varTypes, CallableFlowState callableFlow) {
        OwnershipBoundary boundary = self.callOwnership.boundary();
        int index = 0;
        while (index < plan.operands.len) {
            AggregateOperandPlan operand = plan.operands.get(index);
            self.operandPlanner.requireType(
                operand.effectiveType, operand.expression);
            Node concreteType = operand.effectiveType;
            bool owned = self.ownershipSemantics.unconsumedOwnedResult(operand.expression, self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()), callableFlow);
            boundary.addLoweredOperand(
                operand.expression, concreteType,
                self.lowerExpr(operand.expression, varTypes, callableFlow),
                owned, !owned && operand.pinBorrowed);
            index = index + 1;
        }
        return boundary;
    }

    public IRNode lowerSequencedTuple(
            Node node, Node? expected,
            Map<string, Node> varTypes, CallableFlowState callableFlow) {
        if (self.aggregateValues.isBuilding()
                || self.context.unevaluatedDepth > 0) {
            return self.lowerTupleLiteralPlain(
                node, expected, varTypes, callableFlow);
        }
        AggregateEvaluationPlan plan = self.aggregateValues.plan(
            node, expected, self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()));
        if (!plan.ordered) {
            return self.lowerTupleLiteralPlain(
                node, expected, varTypes, callableFlow);
        }
        OwnershipBoundary boundary = self.prepareAggregateBoundary(
            plan, varTypes, callableFlow);
        self.aggregateValues.beginBuild();
        IRNode result = self.lowerTupleLiteralPlain(
            node, expected, varTypes, callableFlow);
        self.aggregateValues.endBuild();
        boundary.restore();
        return boundary.finish(
            result, plan.resultType, false);
    }

    public AggregateDeclarationPlan lowerFixedArrayInitializer(
            Node initializer, Node arrayType,
            Map<string, Node> varTypes, CallableFlowState callableFlow) {
        AggregateDeclarationPlan declarationPlan =
            AggregateDeclarationPlan();
        AggregateEvaluationPlan evaluation = self.aggregateValues.plan(
            initializer, arrayType,
            self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()));
        if (!evaluation.ordered) {
            declarationPlan.initializer =
                self.lowerArrayInitializerPlain(initializer, varTypes, callableFlow);
            return declarationPlan;
        }
        OwnershipBoundary boundary = self.prepareAggregateBoundary(
            evaluation, varTypes, callableFlow);
        self.aggregateValues.beginBuild();
        declarationPlan.initializer =
            self.lowerArrayInitializerPlain(initializer, varTypes, callableFlow);
        self.aggregateValues.endBuild();
        boundary.restore();
        declarationPlan.declarations = boundary.declarations;
        int prefixIndex = 0;
        while (prefixIndex < boundary.prefix.len) {
            declarationPlan.prefix.push(
                boundary.prefix.get(prefixIndex));
            prefixIndex = prefixIndex + 1;
        }
        int handoffIndex = 0;
        while (handoffIndex < boundary.handoffs.len) {
            declarationPlan.prefix.push(
                boundary.handoffs.get(handoffIndex));
            handoffIndex = handoffIndex + 1;
        }
        declarationPlan.suffix = boundary.suffix;
        return declarationPlan;
    }

    public IRNode lowerArrayInitializerPlain(
            Node initializer, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        Vector<IRNode> values = [];
        int index = 0;
        while (index < initializer.elements.len) {
            values.push(self.lowerExpr(
                initializer.elements.get(index), varTypes, callableFlow));
            index = index + 1;
        }
        return IRNode.initializerList(values);
    }

    /* Lower {k: v, ...} -> Map_new() + put calls (mirrors lower_map_literal).
     * Empty map literal lowers to a bare Map_new() call. */
    public IRNode lowerMapLiteral(Node node, Map<string, Node> varTypes, Node? expected, CallableFlowState callableFlow) {
        string mangled = "btrc_Map_string_int";
        Node? keyExpected = null;
        Node? valueExpected = null;
        Node concreteExpected = self.cTypes.resolveBodyType(expected, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
        if (expected != null && concreteExpected.generic_args.len > 1) {
            mangled = TypeIdentity.mangleGenericType(
                concreteExpected.base, concreteExpected.generic_args);
            keyExpected = concreteExpected.generic_args.get(0);
            valueExpected = concreteExpected.generic_args.get(1);
        } else if (node.entries.len > 0) {
            Node ent0 = node.entries.get(0);
            Node? kt = self.resolvedExpressionType(
                ent0.key, varTypes);
            Node? vt = self.resolvedExpressionType(
                ent0.value_node, varTypes);
            if (kt != null && vt != null) {
                Node mt = SemanticTypeSystem.primitive("Map");
                Vector<Node> ga = [];
                ga.push(kt);
                ga.push(vt);
                mt.generic_args = ga;
                /* Class key/value types upgrade to pointers so the mangle matches
                 * the registered instance (e.g. `btrc_Map_int_OwnedItem_p1`). */
                SemanticTypeSystem.upgradeConcreteTypeGenericArgs(mt, self.analyzed);
                mangled = TypeIdentity.mangleGenericType("Map", mt.generic_args);
                keyExpected = mt.generic_args.get(0);
                valueExpected = mt.generic_args.get(1);
            }
        }
        if (node.entries.len == 0) {
            Vector<IRNode> newArgs = [];
            return IRNode.call(mangled + "_new", newArgs);
        }
        string tmp = self.context.freshTemporary("__map");
        Vector<IRNode> declarations = [];
        Vector<IRNode> newArgs = [];
        IRNode declaration = IRNode.variableDeclaration(
            mangled + "*", tmp, IRNode.literal("NULL"));
        declarations.push(declaration);
        self.context.recordLocal(declaration);
        Vector<IRNode> sequence = [];
        sequence.push(IRNode.binary(
            IRNode.variable(tmp), "=", IRNode.call(mangled + "_new", newArgs)));
        int i = 0;
        while (i < node.entries.len) {
            Node ent = node.entries.get(i);
            Vector<IRNode> prefixArguments = [];
            prefixArguments.push(IRNode.variable(tmp));
            Vector<Node> operands = [];
            operands.push(ent.key);
            operands.push(ent.value_node);
            Vector<Node> expectedTypes = [];
            if (keyExpected != null && valueExpected != null) {
                expectedTypes.push(keyExpected);
                expectedTypes.push(valueExpected);
            }
            sequence.push(self.lowerOwnedEffectCall(mangled + "_put", prefixArguments,
                operands, expectedTypes, varTypes, callableFlow));
            i = i + 1;
        }
        return self.finishOwnedConstruction(declaration, mangled, declarations, sequence);
    }

    /* Lower a brace initializer (mirrors expressions.lower_expr BraceInitializer):
     * empty {} with a known generic-collection expected type -> mangled_new();
     * empty {} otherwise -> NULL; non-empty -> {e1, e2, ...} raw expr. */
    public IRNode lowerBraceInit(
            Node node, Map<string, Node> varTypes, Node? expected, CallableFlowState callableFlow) {
        OwnershipOperandEnvironment environment =
            self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive());
        self.aggregateValues.rejectHeapClassBrace(
            node, expected, environment);
        if (self.aggregateValues.isBuilding()
                || self.context.unevaluatedDepth > 0) {
            return self.lowerBraceInitPlain(
                node, varTypes, expected, callableFlow);
        }
        AggregateEvaluationPlan plan = self.aggregateValues.plan(
            node, expected, environment);
        if (!plan.ordered) {
            return self.lowerBraceInitPlain(
                node, varTypes, expected, callableFlow);
        }
        OwnershipBoundary boundary = self.prepareAggregateBoundary(
            plan, varTypes, callableFlow);
        self.aggregateValues.beginBuild();
        IRNode result = self.lowerBraceInitPlain(
            node, varTypes, expected, callableFlow);
        self.aggregateValues.endBuild();
        boundary.restore();
        if (plan.resultType == null
                || result.kind == IRK_INITIALIZER_LIST) {
            fprintf(stderr,
                "error: ordered brace initializer at %d:%d "
                + "requires a concrete aggregate type\n",
                node.line, node.col);
            exit(1);
        }
        return boundary.finish(
            result, plan.resultType, false);
    }

    public IRNode lowerBraceInitPlain(
            Node node, Map<string, Node> varTypes, Node? expected, CallableFlowState callableFlow) {
        if (expected != null && expected.pointer_depth == 0) {
            Node aggregateType = self.cTypes.resolveBodyType(expected, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
            Node? resolved = SemanticTypeSystem.resolveTypedefType(
                aggregateType, self.analyzed.typedefTable);
            if (resolved != null) { aggregateType = resolved; }
            if (aggregateType.base == "Tuple") {
                Vector<string> tupleFields = [];
                Vector<IRNode> tupleValues = [];
                int tupleIndex = 0;
                while (tupleIndex < node.elements.len
                        && tupleIndex < aggregateType.generic_args.len) {
                    tupleFields.push("_" + Strings.fromInt(tupleIndex));
                    tupleValues.push(self.lowerAssignedValue(
                        node.elements.get(tupleIndex),
                        aggregateType.generic_args.get(tupleIndex),
                        varTypes, callableFlow));
                    tupleIndex = tupleIndex + 1;
                }
                return IRNode.compoundLiteral(
                    self.cTypes.lower(aggregateType),
                    tupleFields, tupleValues);
            }
            string structName = StorageValidator.structTypeName(
                aggregateType, self.analyzed);
            if (structName != ""
                    && self.analyzed.structTable.has(structName)
                    && !self.analyzed.structTable.get(structName).is_forward) {
                Node declaration = self.analyzed.structTable.get(structName);
                Vector<string> fields = [];
                Vector<IRNode> values = [];
                int fieldIndex = 0;
                while (fieldIndex < node.elements.len
                        && fieldIndex < declaration.fields.len) {
                    Node field = declaration.fields.get(fieldIndex);
                    fields.push(field.name);
                    values.push(self.lowerAssignedValue(
                        node.elements.get(fieldIndex), field.type, varTypes, callableFlow));
                    fieldIndex = fieldIndex + 1;
                }
                return IRNode.compoundLiteral(
                    self.cTypes.lower(expected), fields, values);
            }
        }
        if (node.elements.len == 0) {
            if (expected != null && expected.generic_args.len > 0
                    && self.analyzed.isGenericClass(expected.base)) {
                string mangled = TypeIdentity.mangleGenericType(expected.base, expected.generic_args);
                Vector<IRNode> newArgs = [];
                return IRNode.call(mangled + "_new", newArgs);
            }
            return IRNode.literal("NULL");
        }
        Vector<IRNode> elements = [];
        int i = 0;
        while (i < node.elements.len) {
            elements.push(self.lowerExpr(node.elements.get(i), varTypes, callableFlow));
            i = i + 1;
        }
        return IRNode.initializerList(elements);
    }

    public Node? intrinsicOperandType(Node expression, Map<string, Node> varTypes) {
        return self.resolvedExpressionType(expression, varTypes);
    }

    public IRNode? lowerGenericIntrinsic(
            string name, Node node, Vector<IRNode> args,
            Map<string, Node> varTypes) {
        bool comparison = name == "__btrc_eq" || name == "__btrc_lt"
            || name == "__btrc_gt";
        if (!comparison && name != "__btrc_hash") { return null; }

        int expected = 2;
        if (name == "__btrc_hash") { expected = 1; }
        if (args.len != expected) {
            print(f"{name} expects {expected} operand(s), got {args.len}");
            exit(1);
        }

        if (comparison) {
            string op = "==";
            if (name == "__btrc_lt") { op = "<"; }
            else if (name == "__btrc_gt") { op = ">"; }
            Node? leftType = self.intrinsicOperandType(
                node.args.get(0), varTypes);
            Node? rightType = self.intrinsicOperandType(
                node.args.get(1), varTypes);
            if (leftType == null || rightType == null) {
                self.typedOperatorFail(
                    "cannot resolve operand types for " + name
                    + " while lowering '" + self.context.currentClass + "' at "
                    + Strings.fromInt(node.line) + ":"
                    + Strings.fromInt(node.col));
            }
            return self.lowerTypedBinaryValues(
                op, args.get(0), args.get(1), leftType, rightType);
        }

        Node? operandType = self.intrinsicOperandType(
            node.args.get(0), varTypes);
        int domain = self.operators.hashDomain(operandType);
        if (domain == HASH_DOMAIN_STRING) {
            self.context.referenceHelper("__btrc_hash_str");
            Vector<IRNode> hashArgs = [];
            hashArgs.push(args.get(0));
            return IRNode.call("__btrc_hash_str", hashArgs);
        }
        if (domain == HASH_DOMAIN_FLOATING) {
            self.context.referenceHelper("__btrc_hash_real");
            Vector<IRNode> hashArgs = [];
            hashArgs.push(args.get(0));
            return IRNode.call("__btrc_hash_real", hashArgs);
        }
        if (domain == HASH_DOMAIN_INTEGRAL) {
            return IRNode.cast("unsigned int", args.get(0));
        }
        if (domain == HASH_DOMAIN_REFERENCE) {
            return IRNode.cast(
                "unsigned int", IRNode.cast("uintptr_t", args.get(0)));
        }
        if (self.context.genericBody) {
            return IRNode.invalidExpression(
                "__btrc_hash does not support this operand type portably");
        }
        self.typedOperatorFail(
            "__btrc_hash does not support this operand type portably");
        return IRNode.literal("0");
    }

    private Vector<IRNode> lowerResolvedCallArguments(
            CallTarget target, Node call,
            Map<string, Node> varTypes, CallableFlowState callableFlow) {
        CallArgumentPlan plan = self.calls.planArguments(target, call);
        Vector<IRNode> evaluated = [];
        int index = 0;
        while (index < plan.evaluations.len) {
            CallArgumentSlot slot = plan.evaluations.get(index);
            Node? expected = slot.parameter.type;
            Node? sourceType = null;
            IRNode value = IRNode.literal("0");
            if (slot.usesDefault) {
                Map<string, Node> saved = self.calls.beginDefaultTypeScope(
                    target.signature.substitutions);
                value = self.lowerAssignedValueRaw(
                    slot.expression, expected, varTypes, callableFlow);
                self.calls.endDefaultTypeScope(saved);
                sourceType = self.callTargets.defaultExpressionType(
                    slot.expression, target.signature.substitutions,
                    varTypes);
            } else {
                value = self.lowerAssignedValueRaw(
                    slot.expression, expected, varTypes, callableFlow);
                sourceType = self.resolvedExpressionType(
                    slot.expression, varTypes);
            }
            evaluated.push(self.strings.upcastClassPointer(
                expected, sourceType, value));
            index = index + 1;
        }
        return self.calls.materializeArguments(plan, evaluated);
    }

    public IRNode lowerCallCore(Node node, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        self.rejectCallClosureEscapes(node, varTypes, callableFlow);
        Node callee = node.callee;
        if (callee != null && callee.kind == NK_IDENTIFIER) {
            string name = callee.name;
            if (self.gpuPipeline.hasKernel(name)
                    && !callableFlow.hasEnvironment(name)
                    && !varTypes.has(name)) {
                GpuArgumentLedger gpuArgs = self.lowerGpuArguments(
                    node, varTypes, callableFlow);
                return self.gpuPipeline.dispatchExpression(
                    name, node, gpuArgs, self.context.module);
            }
            CallTarget target = self.callTargets.resolve(node, varTypes, self.callableContext(varTypes, callableFlow));
            Vector<IRNode> args = self.lowerResolvedCallArguments(
                target, node, varTypes, callableFlow);
            if (target.kind == CALL_TARGET_CALLABLE_VALUE) {
                IRNode? callable = null;
                if (!target.closureEnvironment) {
                    callable = self.lowerExpr(callee, varTypes, callableFlow);
                }
                IRNode? callableCall = self.calls.materializeDispatch(
                    target, callable, null, args);
                if (callableCall != null) { return callableCall; }
            }
            if (self.context.sourceHelperVisible(name)) {
                self.context.referenceHelper(name);
                return IRNode.call(name, args);
            }
            string firstGpuType = "";
            if (node.args.len > 0) {
                Node? firstType = self.resolvedExpressionType(
                    node.args.get(0), varTypes);
                if (firstType != null) {
                    firstGpuType = firstType.base;
                }
            }
            IRNode? gpuCpuBuiltin = target.kind == CALL_TARGET_FUNCTION
                ? null
                : self.gpuPipeline.cpuBuiltin(
                    name, node, args, firstGpuType);
            if (gpuCpuBuiltin != null) { return gpuCpuBuiltin; }
            IRNode? intrinsic = self.lowerGenericIntrinsic(
                name, node, args, varTypes);
            if (intrinsic != null) { return intrinsic; }
            /* Mutex(val) constructor -> __btrc_mutex_val_create(boxed_val).
             * Exact typed storage preserves every scalar, aggregate, data
             * pointer, and function-pointer representation. Checked before the
             * user-class constructor branch. */
            if (name == "Mutex" && !self.analyzed.funcNames.has(name)
                    && !self.analyzed.isClass(name)) {
                return self.concurrency.lowerMutexConstructor(node, args, varTypes);
            }
            /* Built-ins apply only when no user function shadows the name. */
            if (target.kind == CALL_TARGET_BUILTIN) {
                if (name == "print") {
                    return self.lowerPrint(node, args, varTypes);
                }
                if (name == "printf") {
                    return IRNode.call("printf", args);
                }
                if (name == "sizeof") {
                    if (node.args.len > 0) {
                        return IRNode.sizeofExpression(args.get(0));
                    }
                    return IRNode.sizeofType("void");
                }
                /* Semantic string length is nullable-safe and centralized in
                 * the checked runtime helper; collection length is a field. */
                if (name == "len" && node.args.len > 0) {
                    Node? at = self.resolvedExpressionType(
                        node.args.get(0), varTypes);
                    if (SemanticTypeSystem.isString(at)) {
                        self.context.referenceHelper("__btrc_string_length");
                        Vector<IRNode> la = [];
                        la.push(args.get(0));
                        return IRNode.call("__btrc_string_length", la);
                    }
                    return IRNode.fieldAccess(args.get(0), "len", true);
                }
            }
            IRNode? resolved = self.calls.materializeDispatch(
                target, null, null, args);
            if (resolved != null) { return resolved; }
            return IRNode.call(target.symbol, args);
        }
        if (callee != null && callee.kind == NK_FIELD_ACCESS_EXPR) {
            return self.lowerMethodCall(node, varTypes, callableFlow);
        }
        /* A lambda literal callee is an IIFE. The callable owner plans the lift
         * and materializes its capture environment from already-lowered args. */
        if (callee != null && callee.kind == NK_LAMBDA_EXPR) {
            CallableLambdaPlan lambda = self.callableLowering.prepareLambda(
                callee, varTypes,
                self.callableContext(varTypes, callableFlow));
            CallTarget target = self.callTargets.resolve(node, varTypes, self.callableContext(varTypes, callableFlow));
            if (target.kind != CALL_TARGET_IMMEDIATE_LAMBDA) {
                print("internal compiler error: immediate lambda call has no direct target");
                exit(1);
            }
            Vector<IRNode> captureValues = [];
            int captureIndex = 0;
            while (captureIndex < lambda.captures.len) {
                captureValues.push(IRNode.variable(
                    self.context.sourceCName(
                        lambda.captures.get(captureIndex))));
                captureIndex = captureIndex + 1;
            }
            CallableInvocationEnvironment invocation =
                self.callableLowering.prepareInvocationEnvironment(
                    lambda, captureValues);
            Vector<IRNode> lambdaArgs = self.lowerResolvedCallArguments(
                target, node, varTypes, callableFlow);
            IRNode call = self.callableLowering.materializeInvocation(
                lambda, lambdaArgs, invocation);
            if (invocation.declarations.len == 0
                    && invocation.prefix.len == 0) {
                return call;
            }
            Vector<IRNode> sequence = invocation.prefix;
            sequence.push(call);
            return IRNode.statementExpression(
                invocation.declarations,
                IRNode.commaExpression(sequence));
        }
        /* Other complex callees retain the generic function-pointer path. */
        CallTarget target = self.callTargets.resolve(node, varTypes, self.callableContext(varTypes, callableFlow));
        IRNode calleeExpr = self.lowerExpr(callee, varTypes, callableFlow);
        Vector<IRNode> gargs = self.lowerResolvedCallArguments(
            target, node, varTypes, callableFlow);
        IRNode? callableCall = self.calls.materializeDispatch(
            target, calleeExpr, null, gargs);
        if (callableCall != null) { return callableCall; }
        return IRNode.indirectCall(calleeExpr, gargs);
    }

    public void rejectCallClosureEscapes(
            Node call, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        Vector<Node> params = self.callTargets.resolve(
            call, varTypes, self.callableContext(varTypes, callableFlow)).signature.parameters;
        int positional = 0;
        int i = 0;
        while (i < call.args.len) {
            int paramIndex = positional;
            string argumentName = "";
            if (i < call.arg_names.len) { argumentName = call.arg_names.get(i); }
            if (argumentName != "") {
                paramIndex = -1;
                int p = 0;
                while (p < params.len) {
                    if (params.get(p).name == argumentName) { paramIndex = p; }
                    p = p + 1;
                }
            } else {
                positional = positional + 1;
            }
            if (paramIndex >= 0 && paramIndex < params.len
                    && self.callableValues.valueRequiresEnvironment(
                        params.get(paramIndex).type, call.args.get(i),
                        callableFlow.boundaryContext(
                            varTypes, self.context.activeTypeMap,
                            self.context.genericBody
                                || self.context.callDefaultTypeDepth > 0))) {
                self.callableBoundaries.rejectEnvironmentEscape(call.args.get(i));
            }
            i = i + 1;
        }
        self.callableBoundaries.rejectUnsafeArguments(
            call, params, callableFlow.boundaryContext(
                varTypes, self.context.activeTypeMap,
                self.context.genericBody
                    || self.context.callDefaultTypeDepth > 0));
    }

    public IRNode lowerMethodCall(Node node, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        Node field = node.callee;
        if (field.optional) {
            return self.lowerOptionalCallWithOwnership(node, varTypes, callableFlow);
        }
        return self.lowerMethodCallCore(node, varTypes, callableFlow);
    }

    public IRNode optionalCallZero(Node? returnType) {
        if (returnType == null) { return IRNode.literal("0"); }
        if (returnType.base == "void" && returnType.pointer_depth == 0) {
            return IRNode.cast("void", IRNode.literal("0"));
        }
        if (returnType.is_nullable
                || self.operators.isReferenceType(returnType)) {
            return IRNode.literal("NULL");
        }
        if (NumericSemantics.isType(returnType, self.analyzed)) {
            return IRNode.literal("0");
        }
        Vector<string> noFields = [];
        Vector<IRNode> noValues = [];
        return IRNode.compoundLiteral(
            self.cTypes.lower(returnType), noFields, noValues);
    }
    /* Lower obj.method(args) after optional-call guarding has been decided.
     * Static: ClassName.method(args) -> ClassName_method(args).
     * Instance: obj.method(args)    -> ClassType_method(obj, args). */
    public IRNode lowerMethodCallCore(Node node, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        Node fa = node.callee;
        string method = fa.field;
        Node objNode = fa.obj;
        CallTarget target = self.callTargets.resolve(node, varTypes, self.callableContext(varTypes, callableFlow));
        Vector<IRNode> arguments = self.lowerResolvedCallArguments(
            target, node, varTypes, callableFlow);
        if (target.kind == CALL_TARGET_CALLABLE_VALUE) {
            bool wasOptional = fa.optional;
            fa.optional = false;
            IRNode callable = self.lowerExpr(fa, varTypes, callableFlow);
            fa.optional = wasOptional;
            IRNode? callableCall = self.calls.materializeDispatch(
                target, callable, null, arguments);
            if (callableCall != null) { return callableCall; }
        }
        if (target.kind == CALL_TARGET_METHOD) {
            IRNode? receiver = null;
            if (target.receiverRequired) {
                receiver = self.lowerExpr(target.receiver, varTypes, callableFlow);
            }
            IRNode? methodCall = self.calls.materializeDispatch(
                target, null, receiver, arguments);
            if (methodCall != null) { return methodCall; }
        }
        Node? ot = target.receiverType;
        /* Builtin string instance methods (mirrors methods.lower_method_call's
         * is_string_type branches). Receiver lowered + args lowered first so the
         * fresh-temp counter advances identically. */
        if (SemanticTypeSystem.isString(ot)) {
            IRNode sobj = self.lowerExpr(objNode, varTypes, callableFlow);
            IRNode? sres = self.strings.lowerStringMethod(
                sobj, method, arguments);
            if (sres != null) { return sres; }
        }
        /* enum.toString() -> EnumName_toString(val) (mirrors methods.
         * _lower_to_string's enum_table branch). Checked before the generic
         * numeric/bool/char toString fallback. */
        if (method == "toString" && ot != null
                && (self.analyzed.isEnum(ot.base) || self.analyzed.isRichEnum(ot.base))) {
            IRNode eobj = self.lowerExpr(objNode, varTypes, callableFlow);
            Vector<IRNode> eargs = [];
            eargs.push(eobj);
            return IRNode.cast("char*", IRNode.call(
                ot.base + "_toString", eargs));
        }
        /* obj.toString() for non-class receivers -> builtin numeric/bool/char
         * conversion (mirrors methods.lower_method_call's toString branch). */
        if (method == "toString" && (ot == null || !self.analyzed.isClass(ot.base))) {
            IRNode tobj = self.lowerExpr(objNode, varTypes, callableFlow);
            return self.strings.lowerToString(tobj, ot);
        }
        /* Thread<T> methods: .join() -> __btrc_thread_join with result unboxing
         * (mirrors methods._lower_thread_method). */
        if (ot != null && ot.base == "Thread" && ot.generic_args.len > 0) {
            IRNode obj = self.lowerExpr(objNode, varTypes, callableFlow);
            return self.concurrency.lowerThreadMethod(obj, method, ot);
        }
        /* Mutex<T> methods: .get(), .set(v), .destroy() (mirrors
         * methods._lower_mutex_method). */
        if (ot != null && ot.base == "Mutex" && ot.generic_args.len > 0) {
            IRNode obj = self.lowerExpr(objNode, varTypes, callableFlow);
            return self.concurrency.lowerMutexMethod(
                obj, method, ot, arguments);
        }
        print("irgen: unsupported method call");
        exit(1);
        return IRNode.literal("0");
    }

    /* Lower a builtin string instance method (mirrors methods.py:
     * _lower_string_method, _lower_string_special, the STRING_CONVERSIONS and
     * strlen branches). `obj` is the lowered receiver, `args` the lowered args.
     * Returns null if `method` is not a known string method. */
    public IRNode lowerNewCore(Node node, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        CallTarget target = self.callTargets.resolve(node, varTypes, self.callableContext(varTypes, callableFlow));
        Vector<IRNode> args = self.lowerResolvedCallArguments(
            target, node, varTypes, callableFlow);
        if (target.receiverType != null
                && target.receiverType.base == "Mutex") {
            return self.concurrency.lowerMutexConstructor(node, args, varTypes);
        }
        IRNode? resolved = self.calls.materializeDispatch(
            target, null, null, args);
        if (resolved != null) { return resolved; }
        return IRNode.call(target.symbol, args);
    }

    /* Lower field access obj.field (mirrors fields._lower_field_access, class
     * subset). Class-instance and pointer objects use `->`; property access
     * routes through the getter except for the active accessor's own backing. */
    public string sourceFieldCName(
            Node node, Map<string, Node> varTypes) {
        if (!self.hostedAbi.macroName(node.field)
                || node.obj == null
                || node.obj.kind != NK_FIELD_ACCESS_EXPR
                || node.obj.obj == null
                || node.obj.obj.kind != NK_FIELD_ACCESS_EXPR) {
            return node.field;
        }
        Node dataAccess = node.obj.obj;
        if (dataAccess.field != "data" || dataAccess.obj == null) {
            return node.field;
        }
        Node? rootType = self.resolvedExpressionType(
            dataAccess.obj, varTypes);
        if (rootType == null
                || !self.analyzed.richEnumTable.has(rootType.base)) {
            return node.field;
        }
        Node declaration = self.analyzed.richEnumTable.get(
            rootType.base);
        int variantIndex = 0;
        while (variantIndex < declaration.variants.len) {
            Node variant = declaration.variants.get(variantIndex);
            if (variant.name == node.obj.field) {
                int parameterIndex = 0;
                while (parameterIndex < variant.params.len) {
                    if (variant.params.get(parameterIndex).name
                            == node.field) {
                        return self.hostedAbi.lexicalBindingCName(
                            node.field, false);
                    }
                    parameterIndex = parameterIndex + 1;
                }
            }
            variantIndex = variantIndex + 1;
        }
        return node.field;
    }

    public IRNode lowerFieldAccessCore(Node node, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        bool lexicalReceiver = node.obj != null
            && node.obj.kind == NK_IDENTIFIER
            && varTypes.has(node.obj.name);
        /* Namespaced enum value: Color.RED -> Color_RED (the qualified form of
         * bare RED). Mirrors fields._lower_field_access's enum_table branch. */
        if (node.obj != null && node.obj.kind == NK_IDENTIFIER
                && !lexicalReceiver
                && self.analyzed.isEnum(node.obj.name)) {
            return IRNode.variable(node.obj.name + "_" + node.field);
        }
        /* Rich enum variant tag: Color.RGB -> Color_RGB_TAG. Mirrors fields.
         * _lower_field_access's rich_enum_table branch. */
        if (node.obj != null && node.obj.kind == NK_IDENTIFIER
                && !lexicalReceiver
                && self.analyzed.isRichEnum(node.obj.name)) {
            return IRNode.variable(node.obj.name + "_" + node.field + "_TAG");
        }
        if (!lexicalReceiver && self.classStaticField(node) != null) {
            return IRNode.variable(self.classStaticFieldName(node));
        }
        /* A static method used as a value is its lowered free-function symbol,
         * not a C member projection. A lexical binding with the same spelling
         * still wins over the class namespace. */
        if (node.obj != null && node.obj.kind == NK_IDENTIFIER
                && !varTypes.has(node.obj.name)
                && self.analyzed.isClass(node.obj.name)) {
            Node? staticMethod = self.analyzed.classMethod(
                node.obj.name, node.field);
            if (staticMethod != null
                    && staticMethod.kind == NK_METHOD_DECL
                    && staticMethod.access == "class") {
                return IRNode.functionReference(
                    node.obj.name + "_" + node.field);
            }
        }
        IRNode obj = self.lowerExpr(node.obj, varTypes, callableFlow);
        Node? ot = self.resolvedExpressionType(node.obj, varTypes);
        string fieldName = self.sourceFieldCName(node, varTypes);
        Node? property = DeclarationRegistry.instanceMemberForType(
            self.analyzed, ot, node.field);
        if (property != null && property.kind == NK_PROPERTY_DECL
                && DeclarationRegistry.propertyTargetUsesBacking(
                    node.obj, node.field,
                    self.context.currentPropertyBacking)) {
            return IRNode.fieldAccess(
                obj, DeclarationRegistry.instanceStorageName(property), true);
        }
        /* Optional access is represented as a standard-C comma expression with
         * an uninitialized declaration hoisted by IRStmtExpr:
         *
         *   T *tmp; (tmp = receiver, tmp != NULL ? tmp->field : 0)
         *
         * Keeping both the guard and access on the temp is essential: a call,
         * update, or other side-effecting receiver must execute exactly once.
         * Property getters use the same guarded receiver path. */
        if (node.optional) {
            string receiverName = self.context.freshTemporary("__btrc_optional_obj");
            string receiverType = "void*";
            if (ot != null) {
                receiverType = self.cTypes.lower(ot);
            }
            IRNode receiver = IRNode.variable(receiverName);
            IRNode access = IRNode.fieldAccess(receiver, fieldName, true);
            if (ot != null && property != null
                    && property.kind == NK_PROPERTY_DECL) {
                Vector<IRNode> getterArgs = [];
                getterArgs.push(receiver);
                string prefix = DeclarationRegistry.instanceFunctionPrefix(
                    self.analyzed, ot);
                access = IRNode.call(
                    prefix + "_get_" + node.field, getterArgs);
            } else {
                access = IRNode.fieldAccess(receiver, fieldName, true);
            }
            Vector<IRNode> declarations = [];
            declarations.push(IRNode.variableDeclaration(receiverType, receiverName, null));
            Vector<IRNode> sequence = [];
            sequence.push(IRNode.binary(receiver, "=", obj));
            sequence.push(IRNode.ternary(
                IRNode.binary(receiver, "!=", IRNode.literal("NULL")),
                access, IRNode.literal("0")));
            return IRNode.statementExpression(declarations, IRNode.commaExpression(sequence));
        }
        /* Property access on a class instance. */
        if (ot != null && property != null
                && property.kind == NK_PROPERTY_DECL) {
            Vector<IRNode> gargs = [];
            gargs.push(obj);
            string prefix = DeclarationRegistry.instanceFunctionPrefix(
                self.analyzed, ot);
            return IRNode.call(prefix + "_get_" + node.field, gargs);
        }
        bool arrow = node.arrow;
        /* Class and generic-class (collection) instances are heap pointers, so a
         * member access on one (e.g. `vec.len` where vec is Vector<int>) is `->`. */
        if (ot != null && (ot.pointer_depth > 0 || self.analyzed.isClass(ot.base)
                || self.analyzed.isGenericClass(ot.base))) {
            arrow = true;
        }
        IRNode access = IRNode.fieldAccess(obj, fieldName, arrow);
        Node? resultType = self.resolvedExpressionType(node, varTypes);
        return IRNode.recordArrayProjection(
            access, resultType != null && resultType.is_array);
    }

    public IRNode lowerIndexCore(Node node, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        IRNode object = self.lowerExpr(node.obj, varTypes, callableFlow);
        IRNode index = self.lowerExpr(node.index, varTypes, callableFlow);
        Node? objectType = self.resolvedExpressionType(
            node.obj, varTypes);
        if (objectType != null
                && !StorageValidator.rawIndexedPointer(
                    objectType, self.analyzed)
                && StorageValidator.validIndexedGetter(StorageValidator.indexedMethod(
                    objectType, "get", self.analyzed))) {
            string prefix = objectType.base;
            if (self.analyzed.isGenericClass(objectType.base)) {
                prefix = TypeIdentity.mangleGenericType(
                    objectType.base, objectType.generic_args);
            }
            Vector<IRNode> arguments = [];
            arguments.push(object);
            arguments.push(index);
            return IRNode.call(prefix + "_get", arguments);
        }
        IRNode result = IRNode.indexAccess(object, index);
        result.storage_root_known = true;
        if (objectType != null && objectType.is_array) {
            result.storage_root = IRNode.directStorageRoot(object);
        }
        return result;
    }

    public GpuArgumentLedger lowerGpuArguments(Node call,
            Map<string, Node> varTypes,
            CallableFlowState callableFlow) {
        CallTarget target = self.callTargets.resolve(
            call, varTypes,
            self.callableContext(varTypes, callableFlow));
        CallArgumentPlan binding = self.calls.planArguments(
            target, call);
        GpuArgumentLedger result = GpuArgumentLedger(binding);
        OwnershipOperandEnvironment environment =
            self.context.ownershipEnvironment(
                varTypes, self.gpuPipeline.cpuActive());
        int index = 0;
        while (index < call.args.len) {
            string key = Strings.fromInt(index);
            Node argument = call.args.get(index);
            Node? argumentType = self.resolvedExpressionType(
                argument, varTypes);
            if (argumentType != null) {
                result.sourceTypes.put(key, argumentType);
            }
            result.sourceOwned.put(key,
                self.ownershipSemantics.unconsumedOwnedResult(
                    argument, environment,
                    callableFlow));
            RawProjectionStorageRoot? storage =
                self.ownershipSemantics.projectionStorageRoot(
                    argument, environment);
            if (storage != null) {
                Node? rootType = self.resolvedExpressionType(
                    storage.expression, varTypes);
                self.operandPlanner.requireType(
                    rootType, storage.expression);
                Node concreteRootType = rootType;
                bool rootOwned = storage.managed
                    && self.ownershipSemantics.unconsumedOwnedResult(
                        storage.expression, environment,
                        callableFlow);
                result.sourceProjectionRoots.put(
                    key, GpuArgumentProjectionRoot(
                        storage, concreteRootType, rootOwned));
            }
            index = index + 1;
        }
        index = 0;
        while (index < call.args.len) {
            string key = Strings.fromInt(index);
            Node argument = call.args.get(index);
            if (result.sourceProjectionRoots.has(key)) {
                GpuArgumentProjectionRoot projection =
                    result.sourceProjectionRoots.get(key);
                OwnershipBoundary boundary =
                    self.callOwnership.boundary();
                boundary.addLoweredOperand(
                    projection.storage.expression,
                    projection.type,
                    self.lowerExpr(
                        projection.storage.expression,
                        varTypes, callableFlow),
                    projection.owned,
                    projection.storage.managed
                        && !projection.owned);
                result.explicitValues.push(self.lowerExpr(
                    argument, varTypes, callableFlow));
                boundary.restore();
                projection.declarations = boundary.declarations;
                projection.prefix = boundary.prefix;
                projection.cleanup = boundary.suffix;
            } else {
                result.explicitValues.push(self.lowerExpr(
                    argument, varTypes, callableFlow));
            }
            index = index + 1;
        }
        return result;
    }

    public GpuProjectionReceiver lowerGpuProjectionReceiver(
            Node expression, Node typeExpr,
            Map<string, Node> varTypes,
            CallableFlowState callableFlow) {
        bool owned = self.ownershipSemantics.unconsumedOwnedResult(
            expression,
            self.context.ownershipEnvironment(
                varTypes, self.gpuPipeline.cpuActive()),
            callableFlow);
        return GpuProjectionReceiver(
            self.lowerExpr(expression, varTypes, callableFlow),
            typeExpr, owned);
    }

    public GpuCollectionOutputTarget lowerGpuCollectionOutputTarget(
            Node expression, Node typeExpr,
            Map<string, Node> varTypes,
            CallableFlowState callableFlow) {
        bool owned = self.ownershipSemantics.unconsumedOwnedResult(
            expression,
            self.context.ownershipEnvironment(
                varTypes, self.gpuPipeline.cpuActive()),
            callableFlow);
        return GpuCollectionOutputTarget(
            self.lowerExpr(expression, varTypes, callableFlow),
            typeExpr, owned);
    }

    /* Lower an f-string to snprintf-based string building (mirrors
     * fstrings.lower_fstring). Each interpolation is evaluated exactly once into
     * a temp reused by both the measure (snprintf NULL/0) and write passes. */
    public IRNode lowerFString(Node node, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        string tmp = self.context.freshTemporary("__fstr");
        string fmt = "";
        OwnershipBoundary interpolationBoundary =
            self.callOwnership.boundary();
        bool hasInterpolationBoundary = false;
        Vector<IRNode> argDecls = [];
        Vector<IRNode> argAssignments = [];
        Vector<IRNode> args = [];
        int i = 0;
        while (i < node.parts.len) {
            Node part = node.parts.get(i);
            if (part.kind == NK_F_STRING_TEXT) {
                fmt = fmt + self.strings.replacePercent(part.text);
            } else if (part.kind == NK_F_STRING_EXPR) {
                Node interpolation = part.expression;
                Node? sourceType = self.resolvedExpressionType(
                    interpolation, varTypes);
                Node? targetType = sourceType;
                bool converts = self.strings.requiresTargetStringConversion(SemanticTypeSystem.primitive("string"), sourceType);
                if (converts) { targetType = SemanticTypeSystem.primitive("string"); }
                bool owns = self.ownershipSemantics.contextualUnconsumedOwnedResult(interpolation, targetType, self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()), callableFlow);
                bool laterEffect = false;
                int laterPartIndex = i + 1;
                while (laterPartIndex < node.parts.len) {
                    Node laterPart = node.parts.get(laterPartIndex);
                    if (laterPart.kind == NK_F_STRING_EXPR
                            && self.operandPlanner.hasEffect(
                                laterPart.expression,
                                self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()))) {
                        laterEffect = true;
                    }
                    laterPartIndex = laterPartIndex + 1;
                }
                bool pinBorrowed = laterEffect && !owns && !converts
                    && self.managedValues.isManaged(
                        self.cTypes.resolveBodyType(sourceType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
                if (owns || converts || pinBorrowed) {
                    PreparedValue prepared = self.prepareCallTargetValue(interpolation, targetType, varTypes, callableFlow);
                    self.operandPlanner.requireType(
                        prepared.effectiveType, interpolation);
                    Node effectiveType = prepared.effectiveType;
                    interpolationBoundary.addLoweredOperand(
                        interpolation, effectiveType,
                        prepared.value, prepared.owned, pinBorrowed);
                    hasInterpolationBoundary = true;
                }
                string spec = self.lowerFStringInterp(
                    part, tmp, args.len, argDecls, argAssignments, args, varTypes, callableFlow);
                fmt = fmt + spec;
            }
            i = i + 1;
        }
        /* No interpolations: a plain string literal. */
        if (args.len == 0) {
            return IRNode.literal("\"" + fmt + "\"");
        }
        self.context.referenceHelper("__btrc_string_alloc");
        string lenVar = tmp + "_len";
        string bufVar = tmp + "_buf";
        IRNode fmtLit = IRNode.literal("\"" + fmt + "\"");
        /* int __len = snprintf(NULL, 0, "fmt", args...); */
        Vector<IRNode> measureArgs = [];
        measureArgs.push(IRNode.literal("NULL"));
        measureArgs.push(IRNode.literal("0"));
        measureArgs.push(fmtLit);
        int a = 0;
        while (a < args.len) { measureArgs.push(args.get(a)); a = a + 1; }
        /* __btrc_string_alloc already returns an adopted managed string. */
        IRNode lenPlus1 = IRNode.binary(
            IRNode.cast("size_t", IRNode.variable(lenVar)), "+", IRNode.literal("1"));
        Vector<IRNode> allocArgs = [];
        allocArgs.push(IRNode.variable(lenVar));
        IRNode allocated = IRNode.call("__btrc_string_alloc", allocArgs);
        /* snprintf(__buf, __len + 1, "fmt", args...); */
        Vector<IRNode> writeArgs = [];
        writeArgs.push(IRNode.variable(bufVar));
        writeArgs.push(lenPlus1);
        writeArgs.push(fmtLit);
        int w = 0;
        while (w < args.len) { writeArgs.push(args.get(w)); w = w + 1; }

        /* Only declarations are hoisted. All evaluations stay in a comma
         * expression so short-circuit/ternary branches and loop conditions keep
         * their source semantics under strict C11. */
        Vector<IRNode> declarations = [];
        int d = 0;
        while (d < argDecls.len) {
            declarations.push(argDecls.get(d));
            d = d + 1;
        }
        declarations.push(IRNode.variableDeclaration("int", lenVar, null));
        declarations.push(IRNode.variableDeclaration("char*", bufVar, null));

        Vector<IRNode> sequence = [];
        int si = 0;
        while (si < argAssignments.len) {
            sequence.push(argAssignments.get(si));
            si = si + 1;
        }
        sequence.push(IRNode.binary(IRNode.variable(lenVar), "=", IRNode.call("snprintf", measureArgs)));
        sequence.push(IRNode.binary(IRNode.variable(bufVar), "=", allocated));
        sequence.push(IRNode.call("snprintf", writeArgs));
        sequence.push(IRNode.variable(bufVar));
        IRNode result = IRNode.statementExpression(
            declarations, IRNode.commaExpression(sequence));
        if (!hasInterpolationBoundary) { return result; }
        interpolationBoundary.resultOwned = true;
        interpolationBoundary.restore();
        return interpolationBoundary.finish(
            result, SemanticTypeSystem.primitive("string"), false);
    }

    /* Lower one f-string interpolation. Appends an arg-decl (evaluated once) and
     * an arg ref (used by both snprintf passes), returns the format spec.
     * Mirrors fstrings._lower_interpolation. */
    public string lowerFStringInterp(Node part, string tmp, int index,
            Vector<IRNode> argDecls, Vector<IRNode> argAssignments,
            Vector<IRNode> args, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        Node ex = part.expression;
        IRNode irValue = self.lowerExpr(ex, varTypes, callableFlow);
        Node? argType = self.resolvedExpressionType(ex, varTypes);
        Node? effectiveType = argType;
        string fmt = self.strings.printfFormatSpec(argType);
        string cType = "int";
        if (argType != null) { cType = self.cTypes.lower(argType); }

        if (self.strings.requiresTargetStringConversion(SemanticTypeSystem.primitive("string"), argType)) {
            fmt = "%s";
            cType = "char*";
            effectiveType = SemanticTypeSystem.primitive("string");
        }

        /* Untracked type: force %s for string-producing expressions (mirrors
         * fstrings._lower_interp's `arg_type is None` branch). A method call
         * whose field is a known string-producing method (toString, trim, ...)
         * — e.g. an enum's `e.toString()` — formats as %s. */
        if (argType == null) {
            if (ex.kind == NK_F_STRING_LITERAL || ex.kind == NK_STRING_LITERAL) {
                fmt = "%s";
            } else if (ex.kind == NK_CALL_EXPR) {
                Node? fcallee = ex.callee;
                if (fcallee != null && fcallee.kind == NK_FIELD_ACCESS_EXPR
                        && self.strings.isStringProducingMethod(fcallee.field)) {
                    fmt = "%s";
                }
            }
            if (fmt == "%s") { cType = "char*"; } else { cType = "int"; }
        }

        /* Hoist the value into a temp so it evaluates exactly once. */
        string argVar = tmp + "_arg" + Strings.fromInt(index);
        argDecls.push(IRNode.variableDeclaration(cType, argVar, null));
        argAssignments.push(IRNode.binary(IRNode.variable(argVar), "=", irValue));
        PrintfArg adapted = self.strings.adaptPrintfArg(IRNode.variable(argVar), effectiveType, fmt);
        args.push(adapted.value);
        return adapted.formatSpec;
    }

    /* print(...) -> printf with format string (matches calls.py _lower_print). */
    public IRNode lowerPrint(Node node, Vector<IRNode> loweredArgs,
            Map<string, Node> varTypes) {
        if (node.args.len == 0) {
            Vector<IRNode> a = [];
            a.push(IRNode.literal("\"\\n\""));
            return IRNode.call("printf", a);
        }
        string fmt = "";
        Vector<IRNode> irArgs = [];
        int i = 0;
        while (i < node.args.len) {
            Node arg = node.args.get(i);
            IRNode irArg = loweredArgs.get(i);
            Node? at = self.resolvedExpressionType(arg, varTypes);
            Node? boundaryType = at;
            string spec = self.strings.printfFormatSpec(at);
            if (self.strings.requiresTargetStringConversion(SemanticTypeSystem.primitive("string"), at)) {
                spec = "%s";
                boundaryType = SemanticTypeSystem.primitive("string");
            }
            /* Force %s for known string-producing exprs when type is untracked
             * (mirrors _lower_print's arg_type is None branch). */
            if (at == null) {
                if (arg.kind == NK_STRING_LITERAL || arg.kind == NK_F_STRING_LITERAL) {
                    spec = "%s";
                } else if (arg.kind == NK_CALL_EXPR) {
                    Node? callee = arg.callee;
                    if (callee != null && callee.kind == NK_IDENTIFIER
                            && (callee.name == "toString" || callee.name == "str")) {
                        spec = "%s";
                    }
                    if (callee != null && callee.kind == NK_FIELD_ACCESS_EXPR) {
                        string mn = callee.field;
                        if (mn == "toString" || mn == "str" || mn == "trim"
                                || mn == "toUpper" || mn == "toLower" || mn == "substring"
                                || mn == "replace" || mn == "repeat" || mn == "reverse"
                                || mn == "capitalize" || mn == "split") {
                            spec = "%s";
                        }
                    }
                }
            }
            PrintfArg adapted = self.strings.adaptPrintfArg(irArg, boundaryType, spec);
            if (i > 0) { fmt = fmt + " "; }
            fmt = fmt + adapted.formatSpec;
            irArgs.push(adapted.value);
            i = i + 1;
        }
        fmt = fmt + "\\n";
        Vector<IRNode> callArgs = [];
        callArgs.push(IRNode.literal("\"" + fmt + "\""));
        int j = 0;
        while (j < irArgs.len) { callArgs.push(irArgs.get(j)); j = j + 1; }
        return IRNode.call("printf", callArgs);
    }


    private IRNode lowerPropertyStoreCore(Node assignment,
            Node receiverType, Node property, Node propertyType,
            Map<string, Node> varTypes, CallableFlowState callableFlow) {
        Node target = assignment.target;
        IRNode receiver = self.lowerExpr(target.obj, varTypes, callableFlow);
        IRNode value = self.lowerAssignedValueRaw(
            assignment.value_node, propertyType, varTypes, callableFlow);
        Node? sourceType = self.resolvedExpressionType(
            assignment.value_node, varTypes);
        value = self.strings.upcastClassPointer(
            propertyType, sourceType, value);
        if (DeclarationRegistry.propertyTargetUsesBacking(
                target.obj, target.field,
                self.context.currentPropertyBacking)) {
            return IRNode.binary(IRNode.fieldAccess(receiver,
                DeclarationRegistry.instanceStorageName(property), true), "=", value);
        }
        /* A setter is void in C, while the source assignment yields its RHS. Keep
         * that RHS in one structured temporary: embedding the same lowered IR in
         * both the call and the result would duplicate any nested declarations and
         * evaluate side effects twice. */
        string resultName = self.context.freshTemporary("__btrc_property_value");
        IRNode resultDeclaration = IRNode.variableDeclaration(
            self.cTypes.lower(propertyType), resultName, null);
        self.context.recordLocal(resultDeclaration);
        IRNode result = IRNode.variable(resultName);
        Vector<IRNode> arguments = [];
        arguments.push(receiver);
        arguments.push(result);
        Vector<IRNode> declarations = [];
        declarations.push(resultDeclaration);
        Vector<IRNode> sequence = [];
        sequence.push(IRNode.binary(result, "=", value));
        sequence.push(IRNode.call(DeclarationRegistry.instanceFunctionPrefix(
            self.analyzed, receiverType)
                + "_set_" + target.field, arguments));
        sequence.push(result);
        return IRNode.statementExpression(declarations, IRNode.commaExpression(sequence));
    }

    private IRNode lowerPropertyStoreWithOwnership(Node assignment,
            Node receiverType, Node property, Node propertyType,
            Map<string, Node> varTypes, CallableFlowState callableFlow) {
        Node target = assignment.target;
        bool directBacking = DeclarationRegistry.propertyTargetUsesBacking(
            target.obj, target.field,
            self.context.currentPropertyBacking);
        if (directBacking) {
            return self.lowerPropertyStoreCore(assignment,
                receiverType, property, propertyType, varTypes, callableFlow);
        }
        bool receiverOwned = self.ownershipSemantics.unconsumedOwnedResult(target.obj, self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()), callableFlow);
        Node? actualValueType = self.resolvedExpressionType(
            assignment.value_node, varTypes);
        bool valueConverted = self.strings.requiresTargetStringConversion(propertyType, actualValueType);
        bool managedResult = self.managedValues.isManaged(
            self.cTypes.resolveBodyType(propertyType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
        if (!receiverOwned && !managedResult && !valueConverted) {
            return self.lowerPropertyStoreCore(assignment,
                receiverType, property, propertyType, varTypes, callableFlow);
        }
        OwnershipBoundary boundary = self.callOwnership.boundary();
        boundary.addLoweredOperand(
            target.obj, receiverType,
            self.lowerExpr(target.obj, varTypes, callableFlow),
            receiverOwned, false);
        PreparedValue prepared = self.prepareCallTargetValue(assignment.value_node, propertyType, varTypes, callableFlow);
        self.operandPlanner.requireType(
            prepared.effectiveType, assignment.value_node);
        Node effectiveType = prepared.effectiveType;
        bool pinBorrowed = managedResult && !prepared.owned;
        boundary.addLoweredCallOperand(
            assignment.value_node, effectiveType, prepared.value,
            prepared.owned, pinBorrowed, false);
        IRNode lowered = self.lowerPropertyStoreCore(assignment,
            receiverType, property, propertyType, varTypes, callableFlow);
        boundary.restore();
        return boundary.finish(lowered,
            propertyType, managedResult || receiverOwned);
    }

    /* Strict-C file-scope aggregate initialization.
     *
     * Expression-position braces lower to typed compound literals. File-scope
     * declarations instead require initializer-list syntax: even a constant
     * compound literal is not a constant expression under strict C11. */

    private Node? canonicalStaticInitializerType(
            Node? typeExpr) {
        if (typeExpr == null) { return null; }
        Node? resolved = SemanticTypeSystem.resolveTypedefType(
            typeExpr, self.analyzed.typedefTable);
        if (resolved != null) { return resolved; }
        return typeExpr;
    }

    private Node? staticInitializerElementType(
            Node? aggregateType, int index) {
        Node? canonicalType = self.canonicalStaticInitializerType(aggregateType);
        if (canonicalType == null) { return null; }
        Node canonical = canonicalType;
        if (canonical.is_array) {
            return TypeShape.withoutOuterArray(canonical);
        }
        if (canonical.base == "Tuple") {
            if (index < canonical.generic_args.len) {
                return canonical.generic_args.get(index);
            }
            return null;
        }
        string structName = StorageValidator.structTypeName(
            canonical, self.analyzed);
        if (structName == "" || !self.analyzed.structTable.has(structName)) {
            return null;
        }
        Node declaration = self.analyzed.structTable.get(structName);
        if (declaration.is_forward || index >= declaration.fields.len) {
            return null;
        }
        return declaration.fields.get(index).type;
    }

    private int staticInitializerFieldCount(Node? aggregateType) {
        Node? canonicalType = self.canonicalStaticInitializerType(aggregateType);
        if (canonicalType == null) { return -1; }
        Node canonical = canonicalType;
        if (canonical.is_array) { return -1; }
        if (canonical.base == "Tuple") { return canonical.generic_args.len; }
        string structName = StorageValidator.structTypeName(
            canonical, self.analyzed);
        if (structName == "" || !self.analyzed.structTable.has(structName)) {
            return -1;
        }
        Node declaration = self.analyzed.structTable.get(structName);
        if (declaration.is_forward) { return -1; }
        return declaration.fields.len;
    }

    private IRNode zeroStaticInitializer(Node? expected) {
        Vector<IRNode> zero = [];
        Node? canonicalType = self.canonicalStaticInitializerType(expected);
        if (canonicalType != null) {
            Node canonical = canonicalType;
            if (canonical.is_array
                    || self.staticInitializerFieldCount(canonical) >= 0) {
                zero.push(IRNode.literal("0"));
                return IRNode.initializerList(zero);
            }
        }
        return IRNode.literal("0");
    }

    private IRNode lowerStaticBinaryInitializer(
            Node node, Map<string, Node> varTypes,
            CallableFlowState callableFlow) {
        IRNode left = self.lowerStaticInitializer(
            node.left, null, varTypes, callableFlow);
        IRNode right = self.lowerStaticInitializer(
            node.right, null, varTypes, callableFlow);
        Node? leftType = self.resolvedExpressionType(
            node.left, varTypes);
        Node? rightType = self.resolvedExpressionType(
            node.right, varTypes);
        if (leftType != null && rightType != null
                && NumericSemantics.isType(leftType, self.analyzed)
                && NumericSemantics.isType(rightType, self.analyzed)
                && NumericSemantics.operandsNeedCast(
                    leftType, rightType, self.analyzed)) {
            Node? resultType = NumericSemantics.resultType(
                leftType, rightType, self.analyzed);
            if (resultType != null) {
                string resultC = self.cTypes.lower(resultType);
                left = IRNode.cast(resultC, left);
                right = IRNode.cast(resultC, right);
            }
        }
        return IRNode.binary(left, node.op, right);
    }

    private IRNode lowerStaticUnaryInitializer(
            Node node, Map<string, Node> varTypes,
            CallableFlowState callableFlow) {
        IRNode operand = self.lowerStaticInitializer(
            node.operand, null, varTypes, callableFlow);
        if (node.op == "&") {
            IRNode address = IRNode.addressOf(operand);
            address.source_address = true;
            return address;
        }
        if (node.op == "*") { return IRNode.dereference(operand); }
        return IRNode.unary(node.op, operand, node.prefix);
    }

    private IRNode lowerStaticCastInitializer(
            Node node, Map<string, Node> varTypes,
            CallableFlowState callableFlow) {
        string targetC = self.cTypes.lower(
            self.cTypes.resolveBodyType(
                node.target_type, self.context.activeTypeMap,
                self.context.genericBody
                    || self.context.callDefaultTypeDepth > 0));
        if (self.context.genericBody
                || self.context.callDefaultTypeDepth > 0) {
            targetC = self.cTypes.lowerGeneric(
                node.target_type, self.context.activeTypeMap);
        }
        return IRNode.cast(targetC, self.lowerStaticInitializer(
            node.expr, node.target_type, varTypes, callableFlow));
    }

    private IRNode lowerStaticTernaryInitializer(
            Node node, Map<string, Node> varTypes,
            CallableFlowState callableFlow) {
        IRNode condition = self.lowerStaticInitializer(
            node.condition, null, varTypes, callableFlow);
        IRNode trueValue = self.lowerStaticInitializer(
            node.true_expr, null, varTypes, callableFlow);
        IRNode falseValue = self.lowerStaticInitializer(
            node.false_expr, null, varTypes, callableFlow);
        Node? trueType = self.resolvedExpressionType(
            node.true_expr, varTypes);
        Node? falseType = self.resolvedExpressionType(
            node.false_expr, varTypes);
        if (trueType != null && falseType != null
                && NumericSemantics.operandsNeedCast(
                    trueType, falseType, self.analyzed)) {
            Node? resultType = NumericSemantics.resultType(
                trueType, falseType, self.analyzed);
            if (resultType != null) {
                string resultC = self.cTypes.lower(resultType);
                trueValue = IRNode.cast(resultC, trueValue);
                falseValue = IRNode.cast(resultC, falseValue);
            }
        }
        return IRNode.ternary(
            condition, trueValue, falseValue);
    }

    private IRNode lowerStaticIndexInitializer(
            Node node, Map<string, Node> varTypes,
            CallableFlowState callableFlow) {
        IRNode object = self.lowerStaticInitializer(
            node.obj, null, varTypes, callableFlow);
        IRNode index = self.lowerStaticInitializer(
            node.index, null, varTypes, callableFlow);
        IRNode result = IRNode.indexAccess(object, index);
        result.storage_root_known = true;
        Node? objectType = self.resolvedExpressionType(
            node.obj, varTypes);
        if (objectType != null && objectType.is_array) {
            result.storage_root = IRNode.directStorageRoot(object);
        }
        return result;
    }

    public IRNode lowerStaticInitializer(Node node, Node? expected,
            Map<string, Node> varTypes, CallableFlowState callableFlow) {
        if (node.kind == NK_BINARY_EXPR) {
            return self.lowerStaticBinaryInitializer(
                node, varTypes, callableFlow);
        }
        if (node.kind == NK_UNARY_EXPR) {
            return self.lowerStaticUnaryInitializer(
                node, varTypes, callableFlow);
        }
        if (node.kind == NK_CAST_EXPR) {
            return self.lowerStaticCastInitializer(
                node, varTypes, callableFlow);
        }
        if (node.kind == NK_TERNARY_EXPR) {
            return self.lowerStaticTernaryInitializer(
                node, varTypes, callableFlow);
        }
        if (node.kind == NK_INDEX_EXPR) {
            return self.lowerStaticIndexInitializer(
                node, varTypes, callableFlow);
        }
        if (node.kind == NK_FIELD_ACCESS_EXPR) {
            return self.lowerFieldAccessCore(
                node, varTypes, callableFlow);
        }
        if (node.kind != NK_BRACE_INITIALIZER
                && node.kind != NK_LIST_LITERAL) {
            return self.lowerExpr(node, varTypes, callableFlow);
        }

        Vector<IRNode> elements = [];
        int index = 0;
        while (index < node.elements.len) {
            Node? elementType = self.staticInitializerElementType(expected, index);
            elements.push(self.lowerStaticInitializer(node.elements.get(index), elementType, varTypes, callableFlow));
            index = index + 1;
        }
        int fieldCount = self.staticInitializerFieldCount(expected);
        if (elements.len > 0) {
            while (index < fieldCount) {
                elements.push(self.zeroStaticInitializer(self.staticInitializerElementType(expected, index)));
                index = index + 1;
            }
        } else {
            elements.push(IRNode.literal("0"));
        }
        return IRNode.initializerList(elements);
    }

    /* Bounded-depth lowering for long left-associated string concatenations. */

    private bool irIsScalarStringConcat(Node node,
            Map<string, Node> varTypes) {
        if (node.kind != NK_BINARY_EXPR || node.op != "+") { return false; }
        return self.managedValues.isString(
                self.cTypes.resolveBodyType(
                    self.resolvedExpressionType(
                        node, varTypes), self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))
            && self.managedValues.isString(
                self.cTypes.resolveBodyType(
                    self.resolvedExpressionType(
                        node.left, varTypes), self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))
            && self.managedValues.isString(
                self.cTypes.resolveBodyType(
                    self.resolvedExpressionType(
                        node.right, varTypes), self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
    }

    private Vector<Node> irLeftStringConcatLeaves(Node node,
            Map<string, Node> varTypes) {
        Vector<Node> rights = [];
        Node cursor = node;
        while (self.irIsScalarStringConcat(cursor, varTypes)) {
            rights.push(cursor.right);
            cursor = cursor.left;
        }
        Vector<Node> leaves = [];
        leaves.push(cursor);
        int index = rights.len - 1;
        while (index >= 0) {
            leaves.push(rights.get(index));
            index = index - 1;
        }
        return leaves;
    }

    private IRNode irTrackedStringConcat(
            IRNode left, IRNode right) {
        self.context.referenceHelper("__btrc_strcat");
        self.context.referenceHelper("__btrc_str_track");
        Vector<IRNode> concatArguments = [];
        concatArguments.push(left);
        concatArguments.push(right);
        Vector<IRNode> trackArguments = [];
        trackArguments.push(IRNode.call("__btrc_strcat", concatArguments));
        return IRNode.call("__btrc_str_track", trackArguments);
    }

    private void irRegisterConcatCleanup(IRNode declaration,
            string name, string runtimeType, Vector<IRNode> sequence) {
        OwnershipBoundary cleanup = self.callOwnership.boundary();
        cleanup.registerCleanup(declaration, name, runtimeType);
        int index = 0;
        while (index < cleanup.prefix.len) {
            sequence.push(cleanup.prefix.get(index));
            index = index + 1;
        }
    }

    private void irReleaseConcatPart(IRNode value,
            Node typeExpr, bool released, Vector<IRNode> sequence) {
        if (!released) { return; }
        sequence.push(self.managedLifetime.releaseValue(value, self.cTypes.resolveBodyType(typeExpr, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0)));
        sequence.push(IRNode.binary(value, "=", IRNode.literal("NULL")));
    }

    private void irEvaluateConcatPart(Node expression,
            Node typeExpr, IRNode declaration, IRNode value, bool owned,
            bool pinBorrowed, Map<string, Node> varTypes,
            Vector<IRNode> sequence, CallableFlowState callableFlow) {
        sequence.push(IRNode.binary(value, "=",
            self.lowerExpr(expression, varTypes, callableFlow)));
        if (pinBorrowed) {
            sequence.push(self.managedLifetime.retainValue(value, self.cTypes.resolveBodyType(typeExpr, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0)));
        }
        if (owned || pinBorrowed) {
            self.irRegisterConcatCleanup(declaration, value.name,
                self.managedValues.runtimeType(
                    self.cTypes.resolveBodyType(typeExpr, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0)), sequence);
        }
    }

    private IRNode? lowerLongStringConcat(Node node,
            Map<string, Node> varTypes, CallableFlowState callableFlow) {
        Vector<Node> leaves = self.irLeftStringConcatLeaves(node, varTypes);
        if (leaves.len < 32) { return null; }
        Node? resultOptional = self.resolvedExpressionType(
            node, varTypes);
        self.operandPlanner.requireType(resultOptional, node);
        Node resultType = resultOptional;
        string cType = self.cTypes.lower(resultType);
        Vector<IRNode> declarations = [];
        Vector<IRNode> values = [];
        Vector<Node> types = [];
        Vector<bool> owned = [];
        Vector<bool> pinned = [];

        int index = 0;
        while (index < leaves.len) {
            Node leaf = leaves.get(index);
            Node? leafOptional = self.resolvedExpressionType(
                leaf, varTypes);
            if (leafOptional == null) { leafOptional = resultType; }
            Node leafType = leafOptional;
            string name = self.context.freshTemporary("__btrc_concat_part");
            IRNode declaration = IRNode.variableDeclaration(
                cType, name, IRNode.literal("NULL"));
            declarations.push(declaration);
            self.context.recordLocal(declaration);
            values.push(IRNode.variable(name));
            types.push(leafType);
            owned.push(self.ownershipSemantics.contextualExpressionOwnsResult(leaf, leafType, self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()), callableFlow));
            pinned.push(false);
            index = index + 1;
        }
        if (!owned.get(0) && self.operandPlanner.hasEffect(
                leaves.get(1),
                self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()))) {
            pinned.set(0, true);
        }

        string accumulatorName = self.context.freshTemporary("__btrc_concat_acc");
        string nextName = self.context.freshTemporary("__btrc_concat_next");
        string resultName = self.context.freshTemporary("__btrc_concat_result");
        IRNode accumulatorDeclaration = IRNode.variableDeclaration(
            cType, accumulatorName, IRNode.literal("NULL"));
        IRNode nextDeclaration = IRNode.variableDeclaration(
            cType, nextName, IRNode.literal("NULL"));
        IRNode resultDeclaration = IRNode.variableDeclaration(
            cType, resultName, IRNode.literal("NULL"));
        declarations.push(accumulatorDeclaration);
        declarations.push(nextDeclaration);
        declarations.push(resultDeclaration);
        self.context.recordLocal(accumulatorDeclaration);
        self.context.recordLocal(nextDeclaration);
        self.context.recordLocal(resultDeclaration);
        IRNode accumulator = IRNode.variable(accumulatorName);
        IRNode nextValue = IRNode.variable(nextName);
        IRNode result = IRNode.variable(resultName);
        Vector<IRNode> sequence = [];

        index = 0;
        while (index < 2) {
            self.irEvaluateConcatPart(leaves.get(index),
                types.get(index), declarations.get(index),
                values.get(index), owned.get(index), pinned.get(index),
                varTypes, sequence, callableFlow);
            index = index + 1;
        }
        sequence.push(IRNode.binary(accumulator, "=",
            self.irTrackedStringConcat(values.get(0), values.get(1))));
        self.irRegisterConcatCleanup(accumulatorDeclaration,
            accumulatorName, self.managedValues.runtimeType(
                self.cTypes.resolveBodyType(resultType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0)), sequence);
        self.irReleaseConcatPart(values.get(0),
            types.get(0), owned.get(0) || pinned.get(0), sequence);
        self.irReleaseConcatPart(values.get(1),
            types.get(1), owned.get(1), sequence);

        index = 2;
        while (index < leaves.len) {
            self.irEvaluateConcatPart(leaves.get(index),
                types.get(index), declarations.get(index),
                values.get(index), owned.get(index), pinned.get(index),
                varTypes, sequence, callableFlow);
            sequence.push(IRNode.binary(nextValue, "=",
                self.irTrackedStringConcat(accumulator, values.get(index))));
            sequence.push(self.managedLifetime.releaseValue(accumulator, self.cTypes.resolveBodyType(resultType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0)));
            sequence.push(IRNode.binary(accumulator, "=", IRNode.literal("NULL")));
            self.irReleaseConcatPart(values.get(index),
                types.get(index), owned.get(index), sequence);
            sequence.push(IRNode.binary(accumulator, "=", nextValue));
            sequence.push(IRNode.binary(nextValue, "=", IRNode.literal("NULL")));
            index = index + 1;
        }
        sequence.push(IRNode.binary(result, "=", accumulator));
        sequence.push(IRNode.binary(accumulator, "=", IRNode.literal("NULL")));
        sequence.push(result);
        return IRNode.statementExpression(declarations, IRNode.commaExpression(sequence));
    }
    public PreparedValue prepareTargetValue(Node expression,
            Node? targetType, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        Node? sourceType = self.resolvedExpressionType(
            expression, varTypes);
        string hostedMode = self.strings.hostedStringConversionMode(expression, targetType, sourceType);
        if (hostedMode == "reject") {
            fprintf(stderr, "error: raw char* to managed string conversion reached IR without a proven hosted ownership effect\n");
            exit(1);
        }
        if (hostedMode == "adopt" || hostedMode == "copy") {
            bool had = self.context.hasHostedConversion(expression);
            string previous = "";
            if (had) {
                previous = self.context.hostedConversion(expression);
            }
            self.context.setHostedConversion(expression, hostedMode);
            IRNode converted = self.lowerAssignedValueRaw(
                expression, targetType, varTypes, callableFlow);
            if (had) {
                self.context.setHostedConversion(expression, previous);
            } else {
                self.context.removeHostedConversion(expression);
            }
            return PreparedValue(converted,
                self.strings.preparedCanonicalType(targetType), true, true);
        }
        IRNode lowered = self.lowerAssignedValueRaw(
            expression, targetType, varTypes, callableFlow);
        bool owned = self.ownershipSemantics.contextualExpressionOwnsResult(expression, targetType, self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()), callableFlow);
        return self.strings.prepareLoweredTargetValue(expression,
            targetType, sourceType, lowered, owned, varTypes);
    }

    private PreparedValue prepareCallTargetValue(Node expression,
            Node? targetType, Map<string, Node> varTypes, CallableFlowState callableFlow) {
        Node? sourceType = self.resolvedExpressionType(
            expression, varTypes);
        string hostedMode = self.strings.hostedStringConversionMode(expression, targetType, sourceType);
        if (hostedMode == "reject") {
            fprintf(stderr, "error: raw char* to managed string conversion reached IR without a proven hosted ownership effect\n");
            exit(1);
        }
        if (hostedMode == "adopt" || hostedMode == "copy") {
            bool had = self.context.hasHostedConversion(expression);
            string previous = "";
            if (had) {
                previous = self.context.hostedConversion(expression);
            }
            self.context.setHostedConversion(expression, hostedMode);
            IRNode converted = self.lowerAssignedValueRaw(
                expression, targetType, varTypes, callableFlow);
            if (had) {
                self.context.setHostedConversion(expression, previous);
            } else {
                self.context.removeHostedConversion(expression);
            }
            return PreparedValue(converted,
                self.strings.preparedCanonicalType(targetType), true, true);
        }
        IRNode lowered = self.lowerAssignedValueRaw(
            expression, targetType, varTypes, callableFlow);
        bool owned = self.ownershipSemantics.contextualUnconsumedOwnedResult(expression, targetType, self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()), callableFlow);
        return self.strings.prepareLoweredTargetValue(expression,
            targetType, sourceType, lowered, owned, varTypes);
    }

    private IRNode materializeAssignment(
            Node assignment,
            Map<string, Node> variableTypes, CallableFlowState callableFlow) {
        CallableBoundaryContext callableContext =
            callableFlow.boundaryContext(
                variableTypes, self.context.activeTypeMap,
                self.context.genericBody
                    || self.context.callDefaultTypeDepth > 0);
        AssignmentPlan plan = self.assignments.plan(
            assignment, variableTypes, callableContext, callableFlow);

        IRNode? ownedTarget = self.lowerOwnedAssignment(
            plan, variableTypes, callableFlow);
        if (ownedTarget != null) { return ownedTarget; }
        return self.materializeAssignmentCore(plan, variableTypes, callableFlow);
    }

    private Node? concreteCompoundType(Node? typeExpr) {
        if (typeExpr == null) { return null; }
        Node resolved = self.cTypes.resolveBodyType(
            typeExpr, self.context.activeTypeMap,
            self.context.genericBody
                || self.context.callDefaultTypeDepth > 0);
        return SemanticTypeSystem.resolveTypedefType(
            resolved, self.analyzed.typedefTable);
    }

    private Node resolvedCompoundOverloadType(
            Node? declaredType, Node receiverType) {
        Node resolved = SemanticTypeSystem.primitive("void");
        if (declaredType != null) { resolved = declaredType; }
        if (receiverType.generic_args.len > 0
                && self.analyzed.isGenericClass(receiverType.base)) {
            resolved = SemanticTypeSystem.resolveGenericType(
                declaredType,
                SemanticTypeSystem.genericTypeMap(
                    self.analyzed, receiverType),
                self.analyzed);
        }
        Node? canonical = self.concreteCompoundType(resolved);
        if (canonical == null) {
            print("internal compiler error: compound overload has no canonical signature type");
            exit(1);
        }
        Node concrete = canonical;
        return concrete;
    }

    private bool compoundTypeShapeCompatible(
            Node targetType, Node sourceType) {
        return targetType.base == sourceType.base
            && self.operators.valueDepth(targetType)
                == self.operators.valueDepth(sourceType)
            && targetType.is_array == sourceType.is_array
            && self.operators.genericArgsEqual(
                targetType.generic_args, sourceType.generic_args);
    }

    private bool compoundOverloadArgumentCompatible(
            Node expectedType, Node actualType) {
        if (self.compoundTypeShapeCompatible(
                expectedType, actualType)) {
            return true;
        }
        if (self.operators.isNullType(actualType)) {
            return self.operators.isReferenceType(expectedType);
        }
        if (actualType.is_array && !expectedType.is_array
                && expectedType.base == actualType.base
                && expectedType.pointer_depth
                    == actualType.pointer_depth + 1
                && self.operators.genericArgsEqual(
                    expectedType.generic_args,
                    actualType.generic_args)) {
            return true;
        }
        if (NumericSemantics.isType(expectedType, self.analyzed)
                && NumericSemantics.isType(actualType, self.analyzed)
                && expectedType.base != "bool"
                && actualType.base != "bool") {
            return true;
        }
        if ((TypeComposition.isSemanticScalarString(expectedType)
                    && self.operators.isCStringPointer(actualType))
                || (self.operators.isCStringPointer(expectedType)
                    && TypeComposition.isSemanticScalarString(actualType))) {
            return true;
        }
        if ((self.operators.isVoidPointer(expectedType)
                    && self.operators.isReferenceType(actualType))
                || (self.operators.isVoidPointer(actualType)
                    && self.operators.isReferenceType(expectedType))) {
            return true;
        }
        bool targetNominal = self.analyzed.isClass(expectedType.base)
            || self.analyzed.isGenericClass(expectedType.base);
        bool sourceNominal = self.analyzed.isClass(actualType.base)
            || self.analyzed.isGenericClass(actualType.base);
        if (targetNominal && sourceNominal
                && self.operators.specializationIsSubtype(
                    actualType, expectedType)) {
            return true;
        }
        return TypeComposition.isSemanticScalarString(expectedType)
            && self.strings.sourceHasToString(actualType);
    }

    private bool compoundOverloadResultCompatible(
            Node targetType, Node resultType) {
        if (self.compoundTypeShapeCompatible(
                targetType, resultType)) {
            return true;
        }
        return targetType.generic_args.len == 0
            && resultType.generic_args.len == 0
            && targetType.is_array == resultType.is_array
            && self.operators.valueDepth(targetType)
                == self.operators.valueDepth(resultType)
            && (self.analyzed.isClass(targetType.base)
                || self.analyzed.isGenericClass(targetType.base))
            && (self.analyzed.isClass(resultType.base)
                || self.analyzed.isGenericClass(resultType.base))
            && self.operators.specializationIsSubtype(
                resultType, targetType);
    }

    private IRNode materializeAssignmentCore(
            AssignmentPlan plan,
            Map<string, Node> variableTypes, CallableFlowState callableFlow) {
        Node assignment = plan.assignment;
        Node? receiverType = null;
        if (assignment.target != null
                && assignment.target.kind == NK_FIELD_ACCESS_EXPR
                && assignment.target.obj != null) {
            receiverType = self.resolvedExpressionType(
                assignment.target.obj, variableTypes);
        }
        ManagedCompoundStorePlan? compoundStore =
            self.managedTypes.planCompoundStore(
                assignment, plan.targetType, receiverType,
                variableTypes);
        if (compoundStore != null) {
            ManagedCompoundStorePlan concreteStore = compoundStore;
            string baseOp = assignment.op.substring(
                0, assignment.op.length() - 1);
            Node? overload = self.ownershipSemantics.binaryMethod(
                concreteStore.valueType, baseOp);
            Node? overloadResultType = null;
            if (overload != null) {
                Node overloadResult = self.resolvedCompoundOverloadType(
                    overload.return_type, concreteStore.valueType);
                if (!self.compoundOverloadResultCompatible(
                        concreteStore.valueType, overloadResult)) {
                    print("internal compiler error: compound overload result cannot be stored in managed target after specialization");
                    exit(1);
                }
                overloadResultType = overloadResult;
            }
            Node? rightTargetType = concreteStore.valueType;
            if (overload != null && overload.params.len > 0) {
                Node expectedRightType = self.resolvedCompoundOverloadType(
                    overload.params.get(0).type,
                    concreteStore.valueType);
                rightTargetType = expectedRightType;
                Node? concreteRightType = self.concreteCompoundType(
                    plan.valueType);
                if (concreteRightType == null) {
                    print("internal compiler error: compound overload has no concrete RHS type after specialization");
                    exit(1);
                }
                Node actualRightType = concreteRightType;
                if (!self.compoundOverloadArgumentCompatible(
                        expectedRightType, actualRightType)) {
                    print("internal compiler error: compound overload argument cannot be converted after specialization");
                    exit(1);
                }
            }
            IRNode? loweredReceiver = null;
            if (concreteStore.kind
                    == MANAGED_COMPOUND_INSTANCE_FIELD) {
                loweredReceiver = self.lowerExpr(
                    assignment.target.obj,
                    variableTypes, callableFlow);
            }
            PreparedValue prepared = self.prepareTargetValue(
                assignment.value_node, rightTargetType,
                variableTypes, callableFlow);
            Node? rightType = prepared.effectiveType;
            if (rightType == null) { rightType = plan.valueType; }
            if (rightType == null) {
                print("internal compiler error: managed compound update has no RHS type");
                exit(1);
            }
            Node concreteRightType = rightType;
            bool rightKeep = self.managedValues.isManaged(
                    self.cTypes.resolveBodyType(
                        concreteRightType,
                        self.context.activeTypeMap,
                        self.context.genericBody
                            || self.context.callDefaultTypeDepth > 0))
                && overload != null && overload.params.len > 0
                && overload.params.get(0).keep_;
            ManagedCompoundStore update =
                self.managedTypes.prepareCompoundStore(
                    concreteStore, loweredReceiver,
                    prepared.value, concreteRightType,
                    prepared.owned, rightKeep);
            IRNode? computed = self.lowerOverloadedValues(
                baseOp, update.oldValue, update.rightValue,
                concreteStore.valueType, concreteRightType);
            bool computedOwned = computed != null;
            if (computed == null) {
                computed = self.lowerTypedBinaryValues(
                    baseOp, update.oldValue, update.rightValue,
                    concreteStore.valueType, concreteRightType);
                if (baseOp == "+"
                        && self.managedValues.isString(
                            concreteStore.valueType)) {
                    computedOwned = true;
                }
            }
            if (computed == null) {
                computed = IRNode.binary(
                    update.oldValue, baseOp, update.rightValue);
            }
            IRNode concreteComputed = computed;
            if (overloadResultType != null) {
                concreteComputed = self.strings.upcastClassPointer(
                    concreteStore.valueType, overloadResultType,
                    concreteComputed);
            }
            return self.managedTypes.materializeCompoundStore(
                update, concreteComputed, computedOwned);
        }
        if (self.managedTypes.requiresManagedCompoundStore(
                assignment, plan.targetType)) {
            print("internal compiler error: managed compound update has no owned physical storage plan");
            exit(1);
        }
        ManagedIdentifierStorePlan? identifierStore =
            self.managedTypes.planIdentifierStore(
                assignment, plan.targetType);
        if (identifierStore != null) {
            ManagedIdentifierStorePlan concreteStore = identifierStore;
            PreparedValue prepared = self.prepareTargetValue(
                assignment.value_node, concreteStore.valueType,
                variableTypes, callableFlow);
            IRNode value = self.strings.upcastClassPointer(
                concreteStore.valueType, prepared.effectiveType,
                prepared.value);
            return self.managedTypes.materializeIdentifierStore(
                concreteStore, value, prepared.owned);
        }
        ManagedStaticFieldStorePlan? staticFieldStore =
            self.managedTypes.planStaticFieldStore(
                assignment, variableTypes);
        if (staticFieldStore != null) {
            ManagedStaticFieldStorePlan concreteStore =
                staticFieldStore;
            PreparedValue prepared = self.prepareTargetValue(
                assignment.value_node, concreteStore.fieldType,
                variableTypes, callableFlow);
            IRNode value = self.strings.upcastClassPointer(
                concreteStore.fieldType, plan.valueType,
                prepared.value);
            return self.managedTypes.materializeStaticFieldStore(
                concreteStore, value, prepared.owned);
        }
        ManagedInstanceFieldStorePlan? fieldStore =
            self.managedTypes.planInstanceFieldStore(
                assignment, receiverType);
        if (fieldStore != null) {
            ManagedInstanceFieldStorePlan concreteStore = fieldStore;
            IRNode loweredReceiver = self.lowerExpr(
                assignment.target.obj,
                variableTypes, callableFlow);
            PreparedValue prepared = self.prepareTargetValue(
                assignment.value_node, concreteStore.fieldType,
                variableTypes, callableFlow);
            IRNode value = self.strings.upcastClassPointer(
                concreteStore.fieldType, plan.valueType,
                prepared.value);
            return self.managedTypes.materializeInstanceFieldStore(
                concreteStore,
                loweredReceiver,
                value, prepared.owned);
        }
        IRNode? indirect = self.lowerIndirectAssignment(
            assignment, variableTypes, callableFlow);
        if (indirect != null) { return indirect; }

        if (assignment.op == "=" && assignment.target != null
                && assignment.target.kind == NK_FIELD_ACCESS_EXPR) {
            Node targetExpression = assignment.target;
            Node? receiverType = self.resolvedExpressionType(
                targetExpression.obj, variableTypes);
            Node? property = DeclarationRegistry.instanceMemberForType(
                self.analyzed, receiverType, targetExpression.field);
            if (receiverType != null && property != null
                    && property.kind == NK_PROPERTY_DECL) {
                Node? propertyType =
                    DeclarationRegistry.resolvedInstanceMemberType(
                        self.analyzed, receiverType, property);
                if (propertyType == null) { propertyType = property.type; }
                return self.lowerPropertyStoreWithOwnership(
                    assignment, receiverType, property,
                    propertyType, variableTypes, callableFlow);
            }
        }

        IRNode target = self.lowerExpr(
            assignment.target, variableTypes, callableFlow);
        if (assignment.op != "=" && assignment.op.length() > 1) {
            IRNode value = self.lowerExpr(
                assignment.value_node, variableTypes, callableFlow);
            string targetC = "int";
            if (plan.targetType != null) {
                targetC = self.directGenericTargetC(
                    assignment.target, plan.targetType, variableTypes);
            }
            return self.lowerDirectCompound(
                assignment.op, target, value,
                plan.targetType, plan.valueType, targetC);
        }

        /* A typed `=` coerces its value against the target type. Lowering has
         * side effects — lifted lambdas, temporaries, helper references — so
         * the value is lowered exactly once, through whichever path applies. */
        bool coercedValue = assignment.op == "=" && plan.targetType != null;
        IRNode value = coercedValue
            ? self.strings.upcastClassPointer(
                plan.targetType, plan.valueType,
                self.lowerAssignedValue(
                    assignment.value_node,
                    plan.targetType, variableTypes, callableFlow))
            : self.lowerExpr(
                assignment.value_node, variableTypes, callableFlow);
        if (coercedValue && assignment.target.kind != NK_IDENTIFIER) {
            return self.lowerDirectStore(
                target, value, plan.targetType,
                self.directGenericTargetC(
                    assignment.target,
                    plan.targetType, variableTypes));
        }
        if (plan.callableTarget && assignment.op == "=") {
            callableFlow.setBindingAbi(
                assignment.target.name, plan.callableAbi);
            callableFlow.recordExceptional();
        }
        return self.assignments.materializePlain(plan, target, value);
    }
}
