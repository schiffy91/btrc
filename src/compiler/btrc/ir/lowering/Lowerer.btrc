import Library.Map;
import Library.Vector;

import ../../frontend/Timing.btrc;
import ../../analyzer/Declarations.btrc;
import ../../analyzer/Expressions.btrc;
import ../../analyzer/GPU.btrc;
import ../../analyzer/Generics.btrc;
import ../../analyzer/HostedAbi.btrc;
import ../../analyzer/Models.btrc;
import ../../analyzer/Operators.btrc;
import ../../analyzer/ownership/Cycles.btrc;
import ../../analyzer/ownership/Values.btrc;
import ../../frontend/Models.btrc;
import ../../generated/ast/Node.btrc;
import ../gpu/Pipeline.btrc;
import ../Model.btrc;
import ../runtime/Catalog.btrc;
import ./Aggregates.btrc;
import ./Assignments.btrc;
import ./CallableFlow.btrc;
import ./Callables.btrc;
import ./Calls.btrc;
import ./Concurrency.btrc;
import ./Context.btrc;
import ./ControlFlow.btrc;
import ./Declarations.btrc;
import ./Expressions.btrc;
import ./Functions.btrc;
import ./Generics.btrc;
import ./ownership/Calls.btrc;
import ./ownership/CycleBoundaries.btrc;
import ./ownership/Lifetime.btrc;
import ./Reachability.btrc;
import ./ownership/ManagedTypes.btrc;
import ./ownership/Operands.btrc;
import ./ownership/Semantics.btrc;
import ./Strings.btrc;
import ./Statements.btrc;
import ./Types.btrc;

/* Stage-four composition root. IRLowerer wires retained domain owners and
 * orchestrates one module operation; it owns no recursive AST lowering. */

class IRLowerer {
	private Map<string, bool>? stdlibKeys = null;
	private Analyzed analyzed;
	private ExpressionTypeResolver expressionTypes;
	private LoweringContext context;
	private CleanupSlotRegistry cleanupSlots;
	private CTypeLowerer cTypes;
	private GenericLowerer genericPlans;
	private ExpressionLowerer expressions;
	private ControlFlowLowerer controlFlow;
	private StatementLowerer statements;
	private FunctionLowerer functions;
	private DeclarationLowerer declarations;
	private GpuPipeline gpuPipeline;
	private RuntimeHelperCatalog runtimeHelpers;
	private LoweringProgramFacts? programFacts = null;

	public IRLowerer(Analyzed analyzed, HostedAbiRepository hostedAbi, DeclarationRegistry semanticDeclarations, OperatorSemantics operators, ExpressionTypeResolver expressionTypes, GpuSemantics gpuSemantics, ManagedValueSemantics managedValues, CycleSemantics cycles, RuntimeHelperCatalog runtimeHelpers, string sourceFile, int stdlibLineCount, Vector<FeLine> userLines) {
		self.analyzed = analyzed;
		self.expressionTypes = expressionTypes;
		self.runtimeHelpers = runtimeHelpers;
		self.context = LoweringContext();
		self.context.configureSource(sourceFile, stdlibLineCount, userLines);
		Map<string, bool> sourceVisibleHelpers = {};
		Vector<string> runtimeNames = runtimeHelpers.order();
		int runtimeIndex = 0;
		while (runtimeIndex < runtimeNames.len) {
			string runtimeName = runtimeNames.get(runtimeIndex);
			if (runtimeHelpers.sourceVisible(runtimeName)) {
				sourceVisibleHelpers.put(runtimeName, true);
			}
			runtimeIndex = runtimeIndex + 1;
		}
		self.context.configureSourceVisibleHelpers(sourceVisibleHelpers);
		self.cleanupSlots = CleanupSlotRegistry();
		self.cTypes = CTypeLowerer(analyzed, hostedAbi);

		CallableValueSemantics callableValues = CallableValueSemantics(analyzed, expressionTypes);
		CallableBoundaryPolicy callableBoundaries = CallableBoundaryPolicy(callableValues);
		AssignmentLowerer assignments = AssignmentLowerer(expressionTypes, callableValues, callableBoundaries);
		CallTargetResolver callTargets = CallTargetResolver(analyzed, hostedAbi, semanticDeclarations, expressionTypes, callableValues, self.cTypes, self.context);
		OwnershipOperandPlanner operandPlanner = OwnershipOperandPlanner(analyzed, operators, gpuSemantics, expressionTypes, self.cTypes);
		ManagedLifetimeLowerer managedLifetime = ManagedLifetimeLowerer(analyzed, managedValues, cycles, self.cleanupSlots, self.context, self.cTypes);
		OwnershipSemantics ownershipSemantics = OwnershipSemantics(analyzed, hostedAbi, operators, managedValues, callableValues, operandPlanner, self.context, callTargets);
		CallOwnershipLowerer callOwnership = CallOwnershipLowerer(analyzed, managedValues, ownershipSemantics, operandPlanner, callableValues, self.context, managedLifetime, self.cTypes, callTargets);
		ManagedTypeLowerer managedTypes = ManagedTypeLowerer(analyzed, managedValues, cycles, operandPlanner, self.context, managedLifetime, self.cTypes);
		CycleBoundaryLowerer cycleBoundaries = CycleBoundaryLowerer(analyzed, managedValues, cycles, self.cleanupSlots, self.context, self.cTypes, managedLifetime);
		CycleReturnBoundaryLowerer cycleReturns = CycleReturnBoundaryLowerer(self.context.temporaryNames());
		AggregateValueLowerer aggregateValues = AggregateValueLowerer(analyzed, managedValues, operandPlanner);
		CallLowerer calls = CallLowerer(callTargets, self.cTypes, self.context);
		self.gpuPipeline = GpuPipeline(analyzed, hostedAbi, gpuSemantics, managedValues, operandPlanner, managedLifetime, calls, self.cTypes);
		StringLowerer strings = StringLowerer(analyzed, hostedAbi, operators, managedValues, operandPlanner, callOwnership, self.context, self.cTypes);
		ConcurrencyLowerer concurrency = ConcurrencyLowerer(analyzed, hostedAbi, operators, expressionTypes, managedValues, self.cleanupSlots, managedLifetime, self.context, self.cTypes, runtimeHelpers);
		CallableValueLowerer callableLowering = CallableValueLowerer(analyzed, hostedAbi, callableValues, callableBoundaries, self.context, self.cTypes, managedValues, managedLifetime, concurrency);
		self.expressions = ExpressionLowerer(analyzed, hostedAbi, semanticDeclarations, operators, expressionTypes, managedValues, cycles, callableValues, callableBoundaries, callableLowering, assignments, self.context, operandPlanner, ownershipSemantics, callOwnership, managedLifetime, managedTypes, aggregateValues, self.gpuPipeline, self.cTypes, callTargets, calls, strings, concurrency);
		self.controlFlow = ControlFlowLowerer();
		self.statements = StatementLowerer(analyzed, hostedAbi, managedValues, cycles, callableValues, callableBoundaries, callableLowering, self.context, operandPlanner, ownershipSemantics, managedLifetime, managedTypes, aggregateValues, self.gpuPipeline, self.cTypes, self.expressions, concurrency, self.controlFlow);
		self.functions = FunctionLowerer(analyzed, hostedAbi, semanticDeclarations, expressionTypes, managedValues, cycles, callableLowering, calls, self.context, managedLifetime, managedTypes, cycleBoundaries, cycleReturns, self.gpuPipeline, self.cTypes, self.statements);
		self.genericPlans = GenericLowerer(analyzed);
		self.declarations = DeclarationLowerer(analyzed, hostedAbi, semanticDeclarations, managedValues, cycles, self.cleanupSlots, callableValues, callableBoundaries, self.context, managedLifetime, managedTypes, cycleBoundaries, cycleReturns, self.cTypes, self.functions, self.expressions);
	}

	/* With dead-code elimination on, the pipeline classifies the compiler-owned
	 * stdlib declarations and only the callables the program reaches enter the
	 * lowerer; the IR-level elimination stays the check. Null lowers everything. */
	public void setStdlibKeys(Map<string, bool>? keys) { self.stdlibKeys = keys; }

	public void setDebug(bool enabled) { self.context.debug = enabled; }

	/* Module units: reuse one program's shared lowering facts. The first
	 * lowering of a program publishes them; later ones only read them. */
	public void shareProgramFacts(LoweringProgramFacts facts) {
		self.programFacts = facts;
		self.context.shareSource(facts);
	}

	/* Module units: functions lowered as members of a generic instance. */
	public Map<string, bool> instanceDefinitions() { return self.context.instanceDefinitions; }

	/* Lower one compilation group's module unit (see LoweringContext). */
	public void configureModuleUnit(string ownedGroup, Map<string, string> groupOfFile, bool declarationsElsewhere) { self.context.configureModuleUnit(ownedGroup, groupOfFile, declarationsElsewhere); }

	public IRModule lower(Node program) {
		self.expressionTypes.disableMemo();
		self.cleanupSlots.reset();
		Map<string, bool>? stdlibKeys = self.stdlibKeys;
		LoweringProgramFacts? facts = self.programFacts;
		if (facts != null && facts.reachabilityComputed) {
			self.context.reachability = facts.reachability;
		} else if (stdlibKeys == null) {
			self.context.reachability = null;
		} else {
			Vector<Node> instantiated = [];
			Vector<Node> instantiatedTypes = [];
			for classPlan in self.genericPlans.classPlans() {
				instantiated.push(classPlan.declaration);
				for argument in classPlan.instance.args { instantiatedTypes.push(argument); }
			}
			for methodPlan in self.genericPlans.methodPlans() {
				instantiated.push(methodPlan.owner);
				instantiated.push(methodPlan.method);
				for argument in methodPlan.instance.classArgs { instantiatedTypes.push(argument); }
				for argument in methodPlan.instance.methodArgs { instantiatedTypes.push(argument); }
			}
			self.context.reachability = StdlibReachability(program.declarations(), stdlibKeys, instantiated, instantiatedTypes);
		}
		if (facts != null && !facts.reachabilityComputed) {
			facts.reachability = self.context.reachability;
			facts.reachabilityComputed = true;
		}
		IRModule module = IRModule();
		module.realtimeIntrinsicTargets = self.runtimeHelpers.realtimeIntrinsicTargetProvenance();
		self.context.bindModule(module);
		if (facts != null && facts.alignmentsComputed) { self.context.packAlignments = facts.packAlignments; }
		else {
			self.context.packAlignments = self.declarations.packAlignments(program);
			if (facts != null) {
				facts.packAlignments = self.context.packAlignments;
				facts.alignmentsComputed = true;
			}
		}
		self.declarations.addStandardPreprocessorDecls(module);
		if (facts != null && facts.trycatchComputed) { self.context.setExceptionsEnabled(facts.usesTrycatch); }
		else {
			bool usesTrycatch = self.statements.programUsesTrycatch(program);
			self.context.setExceptionsEnabled(usesTrycatch);
			if (facts != null) {
				facts.usesTrycatch = usesTrycatch;
				facts.trycatchComputed = true;
			}
		}

		BtrccPhaseTimer.mark("l-setup");
		/* A module unit whose declarations come from the shared program
		 * declarations lowers only what its own group defines. */
		bool shared = self.context.declarationsElsewhere;
		if (!shared) { self.declarations.emitForwardDecls(program, module); }
		self.gpuPipeline.registerKernels(program, module);
		if (!shared) {
			self.cTypes.appendTypedefs(program, module, self.context.reachability);
			self.declarations.emitStructDefinitions(program, module);
		}
		BtrccPhaseTimer.mark("l-types");

		Vector<GenericClassLoweringPlan> classPlans = self.genericPlans.classPlans();
		int classIndex = 0;
		while (classIndex < classPlans.len) {
			GenericClassLoweringPlan classPlan = classPlans.get(classIndex);
			string classOwner = self.context.groupOfLine(classPlan.declaration.line);
			if (!shared || classOwner.equals(self.context.ownedGroup)) {
				int before = module.functions.len;
				DeclarationOwnershipScope classScope = self.context.beginOwnership(module, classOwner);
				classScope.instance = true;
				string previousInstance = self.analyzed.beginInstance(GenericSpecializer.classInstanceContext(classPlan.instance));
				self.declarations.emitGenericInstance(classPlan.instance, module);
				self.analyzed.endInstance(previousInstance);
				self.context.endOwnership(module, classScope);
				self.context.stampFunctionSources(module, before, classPlan.declaration.line);
			}
			classIndex = classIndex + 1;
		}
		BtrccPhaseTimer.mark("l-generic-classes");
		Vector<GenericMethodLoweringPlan> methodPlans = self.genericPlans.methodPlans();
		int methodIndex = 0;
		while (methodIndex < methodPlans.len) {
			GenericMethodLoweringPlan methodPlan = methodPlans.get(methodIndex);
			string methodOwner = self.context.groupOfLine(methodPlan.method.line);
			if (!shared || methodOwner.equals(self.context.ownedGroup)) {
				int before = module.functions.len;
				DeclarationOwnershipScope methodScope = self.context.beginOwnership(module, methodOwner);
				methodScope.instance = true;
				string previousInstance = self.analyzed.beginInstance(GenericSpecializer.methodInstanceContext(methodPlan.instance));
				self.functions.emitOneMethodGenericInstance(methodPlan.instance, module);
				self.analyzed.endInstance(previousInstance);
				self.context.endOwnership(module, methodScope);
				self.context.stampFunctionSources(module, before, methodPlan.method.line);
			}
			methodIndex = methodIndex + 1;
		}
		BtrccPhaseTimer.mark("l-generic-methods");

		self.declarations.emitDeclarations(program, module);
		BtrccPhaseTimer.mark("l-declarations");
		self.functions.materializeDeferredClosure();
		if (self.context.declarationsElsewhere) { self.declarations.emitReferencedInterfaces(module); }
		self.cTypes.appendFunctionPointerTypedefs(module);
		self.cTypes.appendRealtimeTypeDeclarations(module);
		self.cleanupSlots.finalize(module);
		self.expressionTypes.disableMemo();
		if (self.context.moduleUnits) { self.partitionModuleUnit(module); }
		BtrccPhaseTimer.mark("l-finalize");
		return module;
	}

	/* Keep this group's definitions and declare every other group's. A
	 * definition created while lowering a declaration has a program-wide name,
	 * so its owner defines it with external linkage and every other unit sees
	 * a prototype or an extern global. Anything created outside a declaration
	 * (lambdas, cleanup adapters, default helpers, interface dispatch) is
	 * session-local and keeps its own linkage. */
	private void partitionModuleUnit(IRModule module) {
		Map<string, string> owners = self.context.definitionOwners;
		string owned = self.context.ownedGroup;
		Map<string, bool> declared = {};
		for declaration in module.functionDecls {
			declared.put(declaration.name, true);
			if (owners.has(declaration.name)) { declaration.isStatic = false; }
		}
		Vector<IRFunction> definitions = [];
		for definition in module.functions {
			if (!owners.has(definition.name)) {
				definitions.push(definition);
			} else if (owners.get(definition.name).equals(owned)) {
				definition.isStatic = false;
				definitions.push(definition);
			} else if (!declared.has(definition.name)) {
				IRFunctionDecl prototype = IRFunctionDecl(definition.name, definition.returnType, false);
				prototype.params = definition.params;
				prototype.cLinkage = definition.cLinkage;
				module.functionDecls.push(prototype);
				declared.put(definition.name, true);
			}
		}
		module.functions = definitions;
		for global in module.globalDecls {
			if (!owners.has(global.name) || global.isExtern) { continue; }
			global.isStatic = false;
			if (!owners.get(global.name).equals(owned)) {
				global.isExtern = true;
				global.init = null;
			}
		}
	}
}
