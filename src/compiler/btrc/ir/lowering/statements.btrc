/* Sole recursive owner for structured statement and block lowering. */

class LoweredCallableLoopBody {
	public IRNode body;
	public CallableFlowSnapshot head;
	public CallableFlowSnapshot fallthrough;
	public CallableLoopCapture exits;
	public bool fallsThrough;

	public LoweredCallableLoopBody() {
		self.body = null;
		self.head = CallableFlowSnapshot();
		self.fallthrough = CallableFlowSnapshot();
		self.exits = CallableLoopCapture();
		self.fallsThrough = false;
	}
}


class StatementLowerer {
	private Analyzed analyzed;
	private HostedAbiRepository hostedAbi;
	private ManagedValueSemantics managedValues;
	private CycleSemantics cycles;
	private CallableValueSemantics callableValues;
	private CallableBoundaryPolicy callableBoundaries;
	private CallableValueLowerer callableLowering;
	private LoweringContext context;
	private OwnershipOperandPlanner operandPlanner;
	private OwnershipSemantics ownershipSemantics;
	private ManagedLifetimeLowerer managedLifetime;
	private ManagedTypeLowerer managedTypes;
	private AggregateValueLowerer aggregateValues;
	private GpuPipeline gpuPipeline;
	private CTypeLowerer cTypes;
	private ExpressionLowerer expressions;
	private ConcurrencyLowerer concurrency;
	private ControlFlowLowerer controlFlow;

	public StatementLowerer(Analyzed analyzed, HostedAbiRepository hostedAbi, ManagedValueSemantics managedValues, CycleSemantics cycles, CallableValueSemantics callableValues, CallableBoundaryPolicy callableBoundaries, CallableValueLowerer callableLowering, LoweringContext context, OwnershipOperandPlanner operandPlanner, OwnershipSemantics ownershipSemantics, ManagedLifetimeLowerer managedLifetime, ManagedTypeLowerer managedTypes, AggregateValueLowerer aggregateValues, GpuPipeline gpuPipeline, CTypeLowerer cTypes, ExpressionLowerer expressions, ConcurrencyLowerer concurrency, ControlFlowLowerer controlFlow) {
		self.analyzed = analyzed;
		self.hostedAbi = hostedAbi;
		self.managedValues = managedValues; self.cycles = cycles;
		self.callableValues = callableValues;
		self.callableBoundaries = callableBoundaries;
		self.callableLowering = callableLowering;
		self.context = context;
		self.operandPlanner = operandPlanner; self.ownershipSemantics = ownershipSemantics;
		self.managedLifetime = managedLifetime;
		self.managedTypes = managedTypes;
		self.aggregateValues = aggregateValues;
		self.gpuPipeline = gpuPipeline;
		self.cTypes = cTypes; self.expressions = expressions;
		self.concurrency = concurrency;
		self.controlFlow = controlFlow;
	}

	private string lexicalBindingCName(string name) { return self.hostedAbi.lexicalBindingCName(name, self.hostedAbi.typedefName(name) || self.analyzed.lexicalBindingConflictsType(name)); }

	public IRNode lowerBlock(Node block, Map<string, Node> varTypes, CallableFlowState callableFlow) {
		Vector<IRNode> declarations = [];
		Vector<string> sourceNames = [];
		Vector<Node> types = [];
		Vector<bool> owned = [];
		return self.lowerBlockWithBindings(block, varTypes, declarations, sourceNames, types, owned, callableFlow);
	}

	/* Lower a lexical block with synthetic for-in bindings declared after the
     * cleanup marker and managed-scope entry. Managed iterGet results are local
     * +1 owners for one iteration, so ordinary scope/control/return/throw paths
     * must see them before the source body is lowered. */
	public IRNode lowerBlockWithBindings(Node block, Map<string, Node> varTypes, Vector<IRNode> declarations, Vector<string> sourceNames, Vector<Node> types, Vector<bool> owned, CallableFlowState callableFlow) {
		/* Type bindings are lexical just like C declarations.  Nested blocks,
         * loop initializers, and shadowing must not mutate the caller's view. */
		Map<string, Node> scopedVarTypes = TypeValidator.cloneTypes(varTypes);
		GpuHostSnapshot gpuHostSnapshot = self.gpuPipeline.snapshotHostCapacities();
		CallableFlowSnapshot enclosingCallables = callableFlow.beginScope();
		Vector<string> borrowedBindings = self.context.snapshotBorrowedBindings();
		Vector<string> sourceBindings = self.context.snapshotSourceBindings();
		Vector<IRNode> stmts = [];
		string cleanupMarker = self.managedLifetime.pushCleanupScope();
		self.managedLifetime.pushManagedScope();
		if (declarations.len != sourceNames.len || declarations.len != types.len || declarations.len != owned.len) {
			print("internal compiler error: incomplete synthetic binding metadata");
			exit(1);
		}
		int binding = 0;
		while (binding < declarations.len) {
			IRNode declaration = declarations.get(binding);
			string sourceName = sourceNames.get(binding);
			Node bindingType = types.get(binding);
			stmts.push(declaration);
			if (declaration.kind == IRK_VAR_DECL) {
				/* A synthetic binding remains part of the loop/catch ABI when
                 * the source body intentionally ignores it.  Emit a structured
                 * discard so strict C never diagnoses the declaration as
                 * unused. */
				stmts.push(IRNode.expressionStatement(IRNode.variable(declaration.name)));
				scopedVarTypes.put(sourceName, bindingType);
				callableFlow.declare(sourceName);
				self.context.recordLocal(declaration);
				if (owned.get(binding) && self.managedValues.isManaged(self.cTypes.resolveBodyType(bindingType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))) {
					self.context.borrowedLocalBindings.remove(sourceName);
					string runtimeType = self.managedValues.runtimeType(self.cTypes.resolveBodyType(bindingType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
					self.managedLifetime.registerManaged(sourceName, self.context.sourceCName(sourceName), runtimeType, bindingType, declaration.c_type);
					self.managedLifetime.maybeRegisterCleanup(declaration.name, runtimeType, stmts);
				} else if (self.managedValues.isManaged(self.cTypes.resolveBodyType(bindingType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))) {
					self.context.borrowedLocalBindings.put(sourceName, true);
				}
			}
			binding = binding + 1;
		}
		if (block != null) {
			int i = 0;
			while (i < block.statements.len) {
				Node s = block.statements.get(i);
				self.lowerStmtInto(s, scopedVarTypes, stmts, callableFlow);
				i = i + 1;
			}
		}
		/* ARC: a control-transfer statement already emitted the exact cleanup
         * it exits.  Do not append unreachable normal-exit cleanup after it;
         * besides being dead, that hides a case-ending break from strict GCC's
         * fallthrough analysis. */
		IRStatementSequence sequence = IRStatementSequence(stmts);
		bool fallsThrough = sequence.mayFallThrough();
		Vector<Managed> managed = self.managedLifetime.popManagedScope();
		bool markerReferenced = fallsThrough || sequence.referencesVariable(cleanupMarker);
		if (self.managedLifetime.cleanupScopeIsActive(cleanupMarker) && markerReferenced) {
			self.context.referenceHelper("__btrc_cleanup_mark");
			Vector<IRNode> markArgs = [];
			stmts.insert(0, IRNode.variableDeclaration("int", cleanupMarker, IRNode.call("__btrc_cleanup_mark", markArgs)));
		}
		if (fallsThrough) {
			self.emitScopeRelease(managed, stmts);
			self.emitCleanupScopeExit(cleanupMarker, stmts);
		}
		self.managedLifetime.popCleanupScope();
		callableFlow.finishScope(enclosingCallables);
		self.context.restoreBorrowedBindings(borrowedBindings);
		self.context.restoreSourceBindings(sourceBindings);
		self.gpuPipeline.restoreHostCapacities(gpuHostSnapshot);
		return IRNode.block(stmts);
	}

	public void emitCleanupScopeExit(string marker, Vector<IRNode> out) {
		if (!self.managedLifetime.cleanupScopeIsActive(marker)) { return; }
		self.context.referenceHelper("__btrc_discard_cleanups_to");
		Vector<IRNode> args = [];
		args.push(IRNode.variable(marker));
		out.push(IRNode.expressionStatement(IRNode.call("__btrc_discard_cleanups_to", args)));
	}

	public void emitControlCleanupExit(bool switchIsTarget, Vector<IRNode> out) { self.emitCleanupScopeExit(self.managedLifetime.controlCleanupMarker(switchIsTarget), out); }

	/* Lower a loop body with a loop-scope marker so break/continue inside it
     * release exactly the vars declared in the body. Mirrors _lower_loop_body. */
	public IRNode lowerLoopBody(Node block, Map<string, Node> varTypes, CallableFlowState callableFlow) {
		LoweredCallableLoopBody lowered = self.lowerLoopBodyRaw(block, varTypes, callableFlow);
		self.requireDirectLoopBackedges(lowered, callableFlow);
		Vector<CallableFlowSnapshot> exits = [];
		exits.push(lowered.head);
		self.appendLoopBreaks(lowered.exits, exits);
		callableFlow.restore(lowered.head);
		callableFlow.join(exits);
		return lowered.body;
	}

	public bool loopConditionCanRepeat(Node? condition) {
		if (condition == null) { return true; }
		if (condition.kind == NK_BOOL_LITERAL) {
			return condition.value_bool;
		}
		if (condition.kind == NK_INT_LITERAL) {
			return condition.value_int != 0;
		}
		return true;
	}

	public bool loopConditionCanExit(Node? condition) {
		if (condition == null) { return false; }
		if (condition.kind == NK_BOOL_LITERAL) {
			return !condition.value_bool;
		}
		if (condition.kind == NK_INT_LITERAL) {
			return condition.value_int == 0;
		}
		return true;
	}

	private void appendLoopBreaks(CallableLoopCapture capture, Vector<CallableFlowSnapshot> flows) {
		int index = 0;
		while (index < capture.breaks.len) {
			flows.push(capture.breaks.get(index));
			index = index + 1;
		}
	}

	private Vector<CallableFlowSnapshot> repeatedLoopEdges(LoweredCallableLoopBody lowered) {
		Vector<CallableFlowSnapshot> edges = [];
		if (lowered.fallsThrough) {
			edges.push(lowered.fallthrough);
		}
		int index = 0;
		while (index < lowered.exits.continues.len) {
			edges.push(lowered.exits.continues.get(index));
			index = index + 1;
		}
		return edges;
	}

	private void requireDirectLoopBackedges(LoweredCallableLoopBody lowered, CallableFlowState callableFlow) {
		Vector<CallableFlowSnapshot> edges = self.repeatedLoopEdges(lowered);
		int index = 0;
		while (index < edges.len) {
			callableFlow.requireInvariant(lowered.head, edges.get(index), "back-edge");
			index = index + 1;
		}
	}

	public LoweredCallableLoopBody lowerLoopBodyRaw(Node block, Map<string, Node> varTypes, CallableFlowState callableFlow) {
		LoweredCallableLoopBody lowered = LoweredCallableLoopBody();
		lowered.head = callableFlow.snapshot();
		CallableLoopCapture capture = callableFlow.beginLoopCaptureFor(varTypes, self.analyzed.typedefTable);
		self.managedLifetime.pushLoopScope();
		self.managedLifetime.pushControl("loop");
		lowered.body = self.lowerBlock(block, varTypes, callableFlow);
		self.managedLifetime.popControl();
		self.managedLifetime.popLoopScope();
		lowered.fallthrough = callableFlow.snapshot();
		lowered.fallsThrough = IRStatementSequence(lowered.body.stmts).mayFallThrough();
		lowered.exits = capture;
		callableFlow.finishLoopCapture(capture);
		callableFlow.restore(lowered.head);
		return lowered;
	}

	public IRNode lowerLoopBodyWithBindings(Node block, Map<string, Node> varTypes, Vector<IRNode> declarations, Vector<string> sourceNames, Vector<Node> types, Vector<bool> owned, CallableFlowState callableFlow) {
		CallableFlowSnapshot head = callableFlow.snapshot();
		CallableLoopCapture capture = callableFlow.beginLoopCaptureFor(varTypes, self.analyzed.typedefTable);
		self.managedLifetime.pushLoopScope();
		self.managedLifetime.pushControl("loop");
		IRNode body = self.lowerBlockWithBindings(block, varTypes, declarations, sourceNames, types, owned, callableFlow);
		self.managedLifetime.popControl();
		self.managedLifetime.popLoopScope();
		CallableFlowSnapshot bodyFlow = callableFlow.snapshot();
		bool fallsThrough = IRStatementSequence(body.stmts).mayFallThrough();
		callableFlow.finishLoopCapture(capture);
		if (fallsThrough) {
			callableFlow.requireInvariant(head, bodyFlow, "back-edge");
		}
		int continueIndex = 0;
		while (continueIndex < capture.continues.len) {
			callableFlow.requireInvariant(head, capture.continues.get(continueIndex), "continue edge");
			continueIndex = continueIndex + 1;
		}
		Vector<CallableFlowSnapshot> exits = [];
		exits.push(head);
		self.appendLoopBreaks(capture, exits);
		callableFlow.restore(head);
		callableFlow.join(exits);
		return body;
	}

	/* Release every owner; flush only if a release can enqueue a cycle root. */
	public void emitScopeRelease(Vector<Managed> managed, Vector<IRNode> out) {
		if (managed.len == 0) { return; }
		int i = managed.len - 1;
		while (i >= 0) {
			Managed mv = managed.get(i);
			if (mv.cleanupKind == "thread") {
				self.context.referenceHelper("__btrc_thread_free");
				Vector<IRNode> args = [];
				args.push(self.concurrency.consumeThreadHandle(IRNode.variable(mv.cName)));
				out.push(IRNode.expressionStatement(IRNode.call("__btrc_thread_free", args)));
			} else {
				string valueName = self.context.freshTemporary("__btrc_scope_released");
				string ownerCName = mv.cName;
				out.push(IRNode.variableDeclaration(self.managedValues.runtimeCType(mv.cls), valueName, IRNode.variable(ownerCName)));
				out.push(IRNode.assignment(IRNode.variable(ownerCName), IRNode.literal("NULL")));
				out.push(IRNode.expressionStatement(self.managedLifetime.releaseRuntime(IRNode.variable(valueName), mv.cls)));
			}
			i = i - 1;
		}
		if (self.managedLifetime.anyCyclable(managed)) {
			out.push(IRNode.expressionStatement(self.managedLifetime.flushCycles()));
		}
	}

	/* Return-path release: rc-- for every managed var across all open scopes
     * except `keepVar` (the returned variable, whose ownership transfers to the
     * caller). Mirrors arc.py _emit_return_release. */
	public void emitReturnRelease(string keepVar, Vector<IRNode> out) {
		Vector<Managed> all = self.managedLifetime.allManaged();
		Vector<Managed> released = [];
		string keepCName = "";
		if (keepVar != "") {
			keepCName = self.context.sourceCName(keepVar);
		}
		int i = 0;
		while (i < all.len) {
			Managed mv = all.get(i);
			if (mv.cName != keepCName) {
				released.push(mv);
			}
			i = i + 1;
		}
		self.emitScopeRelease(released, out);
	}

	/* Lower a managed instance-field store as one transactional expression.
     * The outer assignment boundary exclusively owns receiver stabilization
     * and release; this atom manages only the old and replacement field values. */
	public void lowerStmtInto(Node node, Map<string, Node> varTypes, Vector<IRNode> out, CallableFlowState callableFlow) {
		GpuStatementPlan gpuPlan = self.gpuPipeline.planStatement(node, varTypes);
		if (gpuPlan.handled) {
			GpuStatementOperands gpuOperands = GpuStatementOperands();
			if (gpuPlan.cpuReturn && gpuPlan.value != null) {
				gpuOperands.cpuReturnValue = self.expressions.lowerExpr(gpuPlan.value, varTypes, callableFlow);
			} else if (gpuPlan.call != null) {
				if (gpuPlan.outputCollection && gpuPlan.outputTarget != null && gpuPlan.outputType != null) {
					Node collectionTarget = gpuPlan.outputTarget;
					Node collectionType = gpuPlan.outputType;
					gpuOperands.collectionOutput = self.expressions.lowerGpuCollectionOutputTarget(collectionTarget, collectionType, varTypes, callableFlow);
				} else if (gpuPlan.outputAssignment && gpuPlan.outputTarget != null && !gpuPlan.outputManagedProjection) {
					gpuOperands.outputTarget = self.expressions.lowerExpr(gpuPlan.outputTarget, varTypes, callableFlow);
				}
				if (gpuPlan.outputManagedProjection && gpuPlan.outputReceiver != null && gpuPlan.outputReceiverType != null) {
					Node outputReceiver = gpuPlan.outputReceiver;
					Node outputReceiverType = gpuPlan.outputReceiverType;
					gpuOperands.outputReceiver = self.expressions.lowerGpuProjectionReceiver(outputReceiver, outputReceiverType, varTypes, callableFlow);
				}
				if ((gpuPlan.outputDeclaration || gpuPlan.outputProjection) && gpuPlan.outputSize != null) {
					gpuOperands.outputSize = self.expressions.lowerExpr(gpuPlan.outputSize, varTypes, callableFlow);
				}
				Node gpuCall = gpuPlan.call;
				GpuArgumentLedger arguments = self.expressions.lowerGpuArguments(gpuCall, varTypes, callableFlow);
				gpuOperands.callInputs = self.gpuPipeline.loweredCallInputs(gpuPlan, arguments);
			}
			GpuStatementResult gpuResult = self.gpuPipeline.materializeStatement(gpuPlan, gpuOperands, self.context.module, varTypes);
			int gpuStatementIndex = 0;
			while (gpuStatementIndex < gpuResult.statements.len) {
				out.push(gpuResult.statements.get(gpuStatementIndex));
				gpuStatementIndex = gpuStatementIndex + 1;
			}
			return;
		}
		if (node.kind == NK_VAR_DECL_STMT) {
			bool externalDeclaration = node.type != null && node.type.is_extern && node.initializer == null;
			/* C array local: `int arr[] = {5,3,1}` / `int buf[N]`. The element
             * type is the base (NOT a pointer), the name carries the `[size]`/`[]`
             * suffix, and a list literal becomes a structured IR initializer
             * list (mirrors variables._lower_var_decl's is_array branch). */
			if (node.type != null && node.type.is_array) {
				CallableBoundaryContext arrayCallableContext = callableFlow.boundaryContext(varTypes, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
				bool arrayCallableUnsafe = callableFlow.persistentStorageUnsafe(node.type, node.initializer, self.callableValues, arrayCallableContext);
				self.callableBoundaries.rejectAggregateInitializer(node.type, node.initializer, arrayCallableContext, arrayCallableUnsafe);
				/* Direct GPU result declarations return through the pipeline
                 * plan above. Every declaration reaching this
                 * branch is therefore an ordinary C array. */
				self.aggregateValues.rejectVariableArrayInitializer(node.type, node.initializer, false, "Variable '" + node.name + "'");
				Node baseType = TypeShape.withoutOuterArray(node.type);
				string baseC = self.cTypes.lower(baseType);
				if (self.context.genericBody || self.context.callDefaultTypeDepth > 0) {
					baseC = self.cTypes.lowerGeneric(baseType, self.context.activeTypeMap);
				}
				IRNode? localArraySize = null;
				if (node.type.array_size != null) {
					if (node.type.is_static) {
						localArraySize = self.expressions.lowerStaticInitializer(node.type.array_size, null, varTypes, callableFlow);
					} else {
						localArraySize = self.expressions.lowerExpr(node.type.array_size, varTypes, callableFlow);
					}
				}
				IRNode? ainit = null;
				AggregateDeclarationPlan? aggregatePlan = null;
				if (node.initializer != null) {
					if (node.initializer.kind == NK_LIST_LITERAL || node.initializer.kind == NK_BRACE_INITIALIZER) {
						if (node.type.is_static) {
							ainit = self.expressions.lowerStaticInitializer(node.initializer, node.type, varTypes, callableFlow);
						} else {
							aggregatePlan = self.expressions.lowerFixedArrayInitializer(node.initializer, node.type, varTypes, callableFlow);
							AggregateDeclarationPlan concretePlan = aggregatePlan;
							ainit = concretePlan.initializer;
						}
					} else if (node.type.is_static) {
						ainit = self.expressions.lowerStaticInitializer(node.initializer, node.type, varTypes, callableFlow);
					} else {
						ainit = self.expressions.lowerExpr(node.initializer, varTypes, callableFlow);
					}
				}
				if (node.type != null) { varTypes.put(node.name, node.type); }
				IRNode arrayDecl = IRNode.arrayDeclaration(baseC, node.name, localArraySize, ainit);
				arrayDecl.is_static = node.type.is_static;
				arrayDecl.is_extern = node.type.is_extern;
				arrayDecl.is_volatile = node.type.is_volatile;
				Node arrayStorageType = self.cTypes.resolveBodyType(node.type, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
				arrayDecl.effective_is_volatile = SemanticTypeSystem.typeEffectiveOuterVolatile(arrayStorageType, self.analyzed.typedefTable);
				if (aggregatePlan != null) {
					AggregateDeclarationPlan concretePlan = aggregatePlan;
					concretePlan.emitBefore(out);
				}
				out.push(arrayDecl);
				if (aggregatePlan != null) {
					AggregateDeclarationPlan concretePlan = aggregatePlan;
					concretePlan.emitAfter(out);
				}
				IRNode arrayLength = null;
				if (node.type.array_size != null || (node.initializer != null && (node.initializer.kind == NK_LIST_LITERAL || node.initializer.kind == NK_BRACE_INITIALIZER))) {
					arrayLength = self.gpuPipeline.bareArrayCapacity(IRNode.variable(self.context.sourceCName(node.name)));
				}
				if (arrayLength != null) {
					self.gpuPipeline.recordHostCapacity(node.name, arrayLength);
				} else {
					self.gpuPipeline.recordUnknownHostCapacity(node.name);
				}
				if (externalDeclaration) {
					out.push(IRNode.expressionStatement(IRNode.sizeofExpression(IRNode.addressOf(IRNode.variable(node.name)))));
				}
				return;
			}
			/* `var` (null type): infer from the initializer (mirrors the
             * analyzer setting stmt.type = inferred). */
			Node? declType = node.type;
			if (declType != null) { declType = self.cTypes.resolveBodyType(declType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0); }
			if (declType == null && node.initializer != null) {
				declType = self.expressions.resolvedExpressionType(node.initializer, varTypes);
			}
			CallableBoundaryContext initializerCallableContext = callableFlow.boundaryContext(varTypes, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
			bool initializerCallableUnsafe = callableFlow.persistentStorageUnsafe(declType, node.initializer, self.callableValues, initializerCallableContext);
			self.callableBoundaries.rejectAggregateInitializer(declType, node.initializer, initializerCallableContext, initializerCallableUnsafe);
			bool directInferredClosure = node.type == null && node.initializer != null && node.initializer.kind == NK_LAMBDA_EXPR;
			int callableInitializerAbi = 0;
			if (node.initializer != null) {
				callableInitializerAbi = callableFlow.evaluatedAbi(node.initializer, self.callableValues, callableFlow.boundaryContext(varTypes, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
			}
			if (!directInferredClosure && self.callableValues.valueRequiresEnvironment(declType, node.initializer, callableFlow.boundaryContext(varTypes, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))) {
				self.callableBoundaries.rejectEnvironmentEscape(node);
			}
			string ct = "int";
			if (declType != null) {
				ct = self.cTypes.lower(declType);
				if (node.type != null && (self.context.genericBody || self.context.callDefaultTypeDepth > 0)) {
					ct = self.cTypes.lowerGeneric(node.type, self.context.activeTypeMap);
				}
			}
			IRNode? init = null;
			CallableLambdaPlan? lambdaPlan = null;
			bool initializerOwned = false;
			Node? initializerEffectiveType = null;
			if (node.initializer != null) {
				Node init0 = node.initializer;
				if (init0.kind == NK_LAMBDA_EXPR) {
					CallableLambdaPlan preparedLambda = self.callableLowering.prepareLambda(init0, varTypes, callableFlow.boundaryContext(varTypes, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
					lambdaPlan = preparedLambda;
					init = preparedLambda.value;
				} else if (node.type != null && node.type.is_static) {
					init = self.expressions.lowerStaticInitializer(node.initializer, declType, varTypes, callableFlow);
					initializerEffectiveType = self.expressions.resolvedExpressionType(node.initializer, varTypes);
				} else {
					PreparedValue prepared = self.expressions.prepareTargetValue(node.initializer, declType, varTypes, callableFlow);
					init = prepared.value;
					initializerOwned = prepared.owned;
					initializerEffectiveType = prepared.effectiveType;
				}
			}
			if (init == null && declType != null && self.managedValues.isManaged(self.cTypes.resolveBodyType(declType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0)) && !externalDeclaration) {
				/* Empty managed declarations are owned lexical slots too.
                 * Initialize them before registering cleanup so a later
                 * assignment and every exit path can replace/release safely. */
				init = IRNode.literal("NULL");
			}
			if (declType != null) {
				if (node.type != null && (self.context.genericBody || self.context.callDefaultTypeDepth > 0)) {
					varTypes.put(node.name, node.type);
				} else {
					varTypes.put(node.name, declType);
				}
			}
			/* The initializer resolves in the enclosing scope; only after it
             * has been lowered does this owned source local shadow a borrowed
             * lambda/synthetic binding of the same name. */
			self.context.borrowedLocalBindings.remove(node.name);
			self.context.activateSourceName(node.name, self.lexicalBindingCName(node.name));
			string bindingCName = self.context.sourceCName(node.name);
			IRNode vdecl = IRNode.variableDeclaration(ct, bindingCName, init);
			if (node.type != null) {
				vdecl.is_static = node.type.is_static;
				vdecl.is_extern = node.type.is_extern;
				vdecl.is_volatile = node.type.is_volatile;
				vdecl.effective_is_volatile = SemanticTypeSystem.typeEffectiveOuterVolatile(declType, self.analyzed.typedefTable);
			}
			self.context.recordLocal(vdecl);
			out.push(vdecl);
			callableFlow.declare(node.name);
			/* A same-named ordinary local shadows an enclosing captured-lambda
             * binding for this lexical block. The block snapshot restores the
             * outer binding on exit. */
			if (externalDeclaration) {
				/* GCC diagnoses an otherwise legal unused block-scope extern
                 * under -Wunused-variable. Its address inside sizeof is a
                 * portable unevaluated use and needs no storage or definition.
                 * Return before managed ownership registration: an extern
                 * declaration does not introduce an owned lexical slot. */
				out.push(IRNode.expressionStatement(IRNode.sizeofExpression(IRNode.addressOf(IRNode.variable(bindingCName)))));
				return;
			}
			Node? callableDeclType = SemanticTypeSystem.resolveTypedefType(declType, self.analyzed.typedefTable);
			if (callableDeclType != null && callableDeclType.base == "__fn_ptr") {
				callableFlow.initializeBindingAbi(node.name, callableInitializerAbi);
			}
			if (lambdaPlan != null) {
				CallableLambdaPlan concreteLambda = lambdaPlan;
				CallableBindingPlan binding = self.callableLowering.bindLambda(node.name, concreteLambda);
				if (binding.replacesValueDeclaration) {
					out.pop();
					self.context.forgetLastLocal();
					int bindingIndex = 0;
					while (bindingIndex < binding.statements.len) {
						out.push(binding.statements.get(bindingIndex));
						bindingIndex = bindingIndex + 1;
					}
					callableFlow.setEnvironment(node.name, binding.functionName, binding.environmentStorage);
				}
			}
			/* A C-compatible raw pointer can still carry managed provenance,
             * notably `char* value = __btrc_string_alloc(...)` in the stdlib.
             * Preserve the prepared initializer's effective domain so lexical
             * cleanup and return transfer remain exact. */
			Node? managedSlotType = null;
			if (declType != null && self.managedValues.isManaged(self.cTypes.resolveBodyType(declType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))) {
				managedSlotType = declType;
			} else if (initializerEffectiveType != null && self.managedValues.isManaged(self.cTypes.resolveBodyType(initializerEffectiveType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))) {
				managedSlotType = initializerEffectiveType;
			}
			/* Every concrete managed local owns its lexical slot, including an
             * empty declaration assigned later. A borrowed initializer is
             * retained; a source +1 transfers directly. */
			if (managedSlotType != null) {
				string runtimeType = self.managedValues.runtimeType(self.cTypes.resolveBodyType(managedSlotType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
				if (node.initializer != null && !initializerOwned) {
					out.push(IRNode.expressionStatement(self.managedLifetime.retainValue(IRNode.variable(bindingCName), managedSlotType)));
				}
				self.managedLifetime.registerManaged(node.name, bindingCName, runtimeType, managedSlotType, vdecl.c_type);
				self.managedLifetime.maybeRegisterCleanup(bindingCName, runtimeType, out);
			}
			Node? resolvedDeclType = SemanticTypeSystem.resolveTypedefType(declType, self.analyzed.typedefTable);
			if (resolvedDeclType != null && resolvedDeclType.base == "Thread" && node.initializer != null) {
				self.managedLifetime.registerThread(node.name, self.context.sourceCName(node.name));
				self.context.referenceHelper("__btrc_thread_free");
				self.managedLifetime.maybeRegisterDirectCleanup(bindingCName, "__btrc_thread_free", out);
			}
			return;
		}
		if (node.kind == NK_RETURN_STMT) {
			if (self.callableValues.valueRequiresEnvironment(self.context.currentReturnType, node.value_node, callableFlow.boundaryContext(varTypes, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))) {
				self.callableBoundaries.rejectEnvironmentEscape(node);
			}
			self.lowerReturn(node, varTypes, out, callableFlow);
			return;
		}
		if (node.kind == NK_EXPR_STMT) {
			Node e = node.expr;
			/* The hosted C assert macro stringifies its argument.  Freeze the
             * source condition into structured IR first so deep lowering does
             * not create an overlength string literal.  The explicit discard
             * preserves btrc's eager call semantics under NDEBUG while keeping
             * strict unused-variable builds clean. */
			if (e.kind == NK_CALL_EXPR && e.callee != null && e.callee.kind == NK_IDENTIFIER && e.callee.name == "assert" && e.args.len == 1 && (e.arg_names.len == 0 || (e.arg_names.len == 1 && e.arg_names.get(0) == ""))) {
				string conditionName = self.context.freshTemporary("__btrc_assert_condition");
				IRNode conditionDeclaration = IRNode.variableDeclaration("bool", conditionName, self.expressions.lowerExpr(e.args.get(0), varTypes, callableFlow));
				self.context.recordLocal(conditionDeclaration);
				out.push(conditionDeclaration);
				out.push(IRNode.expressionStatement(IRNode.cast("void", IRNode.variable(conditionName))));
				Vector<IRNode> assertArgs = [];
				assertArgs.push(IRNode.variable(conditionName));
				out.push(IRNode.expressionStatement(IRNode.call("assert", assertArgs)));
				return;
			}
			if (e.kind == NK_CALL_EXPR && e.callee != null && e.callee.kind == NK_FIELD_ACCESS_EXPR && e.callee.field == "destroy") {
				Node? receiverType = self.expressions.resolvedExpressionType(e.callee.obj, varTypes);
				if (self.managedValues.isMutex(self.cTypes.resolveBodyType(receiverType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))) {
					self.lowerReleaseExpression(e.callee.obj, varTypes, out, callableFlow);
					return;
				}
			}
			/* Call/new boundaries consume owned operands internally. If the
             * full expression itself yields +1 and its value is discarded,
             * consume that reference at the end of this full expression. */
			IRNode loweredExpression = self.expressions.lowerExpr(e, varTypes, callableFlow);
			Node? discardedType = self.expressions.resolvedExpressionType(e, varTypes);
			if (self.concurrency.isFreshThreadResult(e, discardedType)) {
				string discardedName = self.context.freshTemporary("__btrc_discarded_thread");
				IRNode discardedDeclaration = IRNode.variableDeclaration(self.cTypes.lower(discardedType), discardedName, loweredExpression);
				self.context.recordLocal(discardedDeclaration);
				out.push(discardedDeclaration);
				self.context.referenceHelper("__btrc_thread_free");
				Vector<IRNode> freeArgs = [];
				freeArgs.push(IRNode.variable(discardedName));
				out.push(IRNode.expressionStatement(IRNode.call("__btrc_thread_free", freeArgs)));
			} else if (self.managedValues.isManaged(self.cTypes.resolveBodyType(discardedType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0)) && self.ownershipSemantics.expressionOwnsResult(e, self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()), callableFlow)) {
				string discardedName = self.context.freshTemporary("__btrc_discarded");
				IRNode discardedDeclaration = IRNode.variableDeclaration(self.cTypes.lower(discardedType), discardedName, loweredExpression);
				self.context.recordLocal(discardedDeclaration);
				out.push(discardedDeclaration);
				out.push(self.expressions.releaseVarStmt2(IRNode.variable(discardedName), self.managedValues.runtimeType(self.cTypes.resolveBodyType(discardedType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))));
			} else {
				out.push(IRNode.expressionStatement(loweredExpression));
			}
			return;
		}
		if (node.kind == NK_IF_STMT) {
			out.push(self.lowerIf(node, varTypes, callableFlow));
			return;
		}
		if (node.kind == NK_WHILE_STMT) {
			CallableFlowSnapshot conditionEntry = callableFlow.snapshot();
			IRNode cond = self.expressions.lowerExpr(node.condition, varTypes, callableFlow);
			CallableFlowSnapshot conditionExit = callableFlow.snapshot();
			callableFlow.requireInvariant(conditionEntry, conditionExit, "condition");
			IRNode body = null;
			if (self.loopConditionCanRepeat(node.condition)) {
				body = self.lowerLoopBody(node.body_node, varTypes, callableFlow);
			} else {
				LoweredCallableLoopBody unreachable = self.lowerLoopBodyRaw(node.body_node, varTypes, callableFlow);
				callableFlow.restore(unreachable.head);
				body = unreachable.body;
			}
			out.push(self.controlFlow.materializeWhile(WhilePlan(cond, body)));
			return;
		}
		if (node.kind == NK_DO_WHILE_STMT) {
			LoweredCallableLoopBody lowered = self.lowerLoopBodyRaw(node.body_node, varTypes, callableFlow);
			Vector<CallableFlowSnapshot> repeated = self.repeatedLoopEdges(lowered);
			if (repeated.len > 0) {
				CallableFlowSnapshot repeatedEntry = callableFlow.merged(repeated);
				callableFlow.restore(repeatedEntry);
			} else {
				callableFlow.restore(lowered.head);
			}
			IRNode cond = self.expressions.lowerExpr(node.condition, varTypes, callableFlow);
			CallableFlowSnapshot conditionExit = callableFlow.snapshot();
			bool conditionCanRepeat = self.loopConditionCanRepeat(node.condition);
			bool conditionCanExit = self.loopConditionCanExit(node.condition);
			if (repeated.len > 0 && conditionCanRepeat) {
				callableFlow.requireInvariant(lowered.head, conditionExit, "condition edge");
			}
			Vector<CallableFlowSnapshot> exits = [];
			self.appendLoopBreaks(lowered.exits, exits);
			if (repeated.len > 0 && conditionCanExit) {
				exits.push(conditionExit);
			}
			callableFlow.restore(lowered.head);
			if (exits.len > 0) {
				callableFlow.join(exits);
			}
			out.push(IRNode.doWhileStatement(lowered.body, cond));
			return;
		}
		if (node.kind == NK_C_FOR_STMT) {
			out.push(self.lowerCFor(node, varTypes, callableFlow));
			return;
		}
		if (node.kind == NK_FOR_IN_STMT) {
			self.lowerForIn(node, varTypes, out, callableFlow);
			return;
		}
		if (node.kind == NK_PARALLEL_FOR_STMT) {
			/* `parallel for` lowers to a sequential for-in (no GPU/threading
             * support yet), mirroring statements.lower_stmt's ParallelForStmt
             * branch which delegates to _lower_for_in. The node carries the same
             * var_name / iterable / body fields a for-in does. */
			self.lowerForIn(node, varTypes, out, callableFlow);
			return;
		}
		if (node.kind == NK_DELETE_STMT) {
			self.lowerDelete(node, varTypes, out, callableFlow);
			return;
		}
		if (node.kind == NK_BREAK_STMT) {
			callableFlow.recordControlExit(true, self.managedLifetime.controlKinds());
			self.emitScopeRelease(self.managedLifetime.controlManaged(true), out);
			self.emitControlCleanupExit(true, out);
			self.emitTryPopDepth(self.managedLifetime.exitedTryDepth(true), out);
			out.push(IRNode.breakStatement());
			return;
		}
		if (node.kind == NK_CONTINUE_STMT) {
			callableFlow.recordControlExit(false, self.managedLifetime.controlKinds());
			self.emitScopeRelease(self.managedLifetime.controlManaged(false), out);
			self.emitControlCleanupExit(false, out);
			self.emitTryPopDepth(self.managedLifetime.exitedTryDepth(false), out);
			out.push(IRNode.continueStatement());
			return;
		}
		if (node.kind == NK_KEEP_STMT) {
			Node? kt = self.expressions.resolvedExpressionType(node.expr, varTypes);
			if (self.context.genericBody) {
				kt = SemanticTypeSystem.resolveGenericType(kt, self.context.activeTypeMap, self.analyzed);
			}
			if (self.managedValues.isManaged(self.cTypes.resolveBodyType(kt, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))) {
				string valueName = self.context.freshTemporary("__btrc_keep_value");
				out.push(IRNode.variableDeclaration(self.cTypes.lower(kt), valueName, self.expressions.lowerExpr(node.expr, varTypes, callableFlow)));
				IRNode value = IRNode.variable(valueName);
				if (self.context.collectionEdgeKeeps) {
					/* Public collection methods use keep/release to mutate
                     * persistent element slots.  Those references contribute
                     * to both the total and persistent-edge counts. */
					out.push(IRNode.expressionStatement(self.managedLifetime.retainEdge(value, kt, IRNode.variable("self"))));
				} else {
					/* Ordinary keep creates an external owner (a local, return,
                     * argument, capture, or other raw ARC root). */
					out.push(IRNode.expressionStatement(self.managedLifetime.retainValue(value, kt)));
				}
			}
			return;
		}
		if (node.kind == NK_RELEASE_STMT) {
			self.lowerRelease(node, varTypes, out, callableFlow);
			return;
		}
		if (node.kind == NK_THROW_STMT) {
			/* throw expr -> __btrc_throw(expr) (mirrors control_flow._lower_throw). */
			self.context.referenceHelper("__btrc_throw");
			IRNode e = self.expressions.lowerExpr(node.expr, varTypes, callableFlow);
			Vector<IRNode> targs = [];
			targs.push(e);
			IRNode throwCall = IRNode.call("__btrc_throw", targs);
			throwCall.never_returns = true;
			out.push(IRNode.expressionStatement(throwCall));
			return;
		}
		if (node.kind == NK_TRY_CATCH_STMT) {
			self.lowerTryCatch(node, varTypes, out, callableFlow);
			return;
		}
		if (node.kind == NK_SWITCH_STMT) {
			out.push(self.lowerSwitch(node, varTypes, callableFlow));
			return;
		}
		if (node.kind == NK_BLOCK) {
			IRNode b = self.lowerBlock(node, varTypes, callableFlow);
			/* A source block is a real lexical scope.  Preserve it as a
             * structured IR statement so shadowing, lifetime cleanup, and C11
             * declaration scopes remain intact through emission. */
			out.push(b);
			return;
		}
		/* Unsupported statement kind: abort loudly (matches unsupported_node). */
		print(f"irgen: unsupported statement kind {node.kind}");
		exit(1);
	}

	/* When a `return` is lexically inside one or more open try blocks, emit the
     * try-level cleanup DISCARD + try-stack pop that the try's normal-exit tail
     * would otherwise run — but which a `return` jumps over, leaving them as dead
     * code after the `return`. Without this, the returned object's cleanup entry
     * stays registered (pointing at memory the caller will later own/free) and the
     * try level stays on the stack; a subsequent __btrc_throw then runs that stale
     * cleanup -> use-after-free. We DISCARD (not release) the cleanups: the
     * returned object escapes and must stay alive, and the non-returned managed
     * locals were already released by emitReturnRelease just before this.
     *
     * The function's open try levels occupy [base+1 .. __btrc_try_top] where
     * base = __btrc_try_top - inTryDepth; so discard every cleanup at
     * try_level >= base+1 (= __btrc_try_top - (inTryDepth - 1)) and pop inTryDepth
     * levels. Mirrors arc._emit_return_try_pop. */
	public void emitReturnTryPop(Vector<IRNode> out) { self.emitTryPopDepth(self.context.tryDepth, out); }

	public void emitReturnCleanupExit(Vector<IRNode> out) { self.emitCleanupScopeExit(self.managedLifetime.returnCleanupMarker(), out); }

	public void emitTryPopDepth(int depth, Vector<IRNode> out) {
		if (depth <= 0) { return; }
		/* Only discard cleanups if any were registered (mirrors the gate the
         * try's normal-exit tail uses); a try with no managed locals registers
         * none. */
		if (self.context.referencesHelper("__btrc_register_cleanup") || self.context.referencesHelper("__btrc_register_direct_cleanup")) {
			self.context.referenceHelper("__btrc_discard_cleanups");
			IRNode level = IRNode.variable("__btrc_try_top");
			if (depth != 1) {
				level = IRNode.binary(level, "-", IRNode.literal(Strings.fromInt(depth - 1)));
			}
			Vector<IRNode> dargs = [];
			dargs.push(level);
			out.push(IRNode.expressionStatement(IRNode.call("__btrc_discard_cleanups", dargs)));
		}
		/* Pop this function's open try levels off the try stack. */
		if (depth == 1) {
			out.push(IRNode.expressionStatement(IRNode.unary("--", IRNode.variable("__btrc_try_top"), false)));
		} else {
			out.push(IRNode.expressionStatement(IRNode.binary(IRNode.variable("__btrc_try_top"), "-=", IRNode.literal(Strings.fromInt(depth)))));
		}
	}

	/* Launder a class-pointer return value through __btrc_launder when the
     * `return` is lowered inside a try/catch construct. gcc -O2 (notably nix's
     * fortify hardening, which forces -O2) miscompiles the setjmp(...)==0 vs catch
     * branches of a try/catch: for a freshly-built object that doesn't otherwise
     * escape, its points-to / store-merging folds the two branches' field inits
     * together and drops the catch object's initialization, so the returned
     * object reads back the wrong field values. Routing the returned pointer
     * through a volatile slot makes it escape, defeating that fold. Identity at
     * runtime; only applied to managed class-pointer returns inside a try/catch.
     * Mirrors arc._maybe_launder_return. */
	public IRNode maybeLaunderReturn(IRNode value) {
		if (self.context.tryCatchDepth <= 0) { return value; }
		if (self.context.currentReturnType == null) { return value; }
		if (!self.managedValues.isManaged(self.cTypes.resolveBodyType(self.context.currentReturnType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))) {
			return value;
		}
		self.context.referenceHelper("__btrc_launder");
		Vector<IRNode> largs = [];
		largs.push(value);
		return IRNode.cast(self.context.currentReturnCType, IRNode.call("__btrc_launder", largs));
	}

	public void lowerReturn(Node node, Map<string, Node> varTypes, Vector<IRNode> out, CallableFlowState callableFlow) {
		if (node.value_node != null) {
			CallableBoundaryContext callableContext = callableFlow.boundaryContext(varTypes, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0);
			bool unsafe = callableFlow.persistentStorageUnsafe(self.context.currentReturnType, node.value_node, self.callableValues, callableContext);
			self.callableBoundaries.rejectPersistentStorage(self.context.currentReturnType, node.value_node, callableContext, unsafe, "a function return");
		}
		self.lowerOwnedReturn(node, varTypes, out, callableFlow);
	}

	private void lowerOwnedReturn(Node statement, Map<string, Node> varTypes, Vector<IRNode> output, CallableFlowState callableFlow) {
		if (statement.value_node == null) {
			self.emitReturnRelease("", output);
			self.emitReturnTryPop(output);
			self.emitReturnCleanupExit(output);
			IRNode? value = null;
			if (self.context.currentReturnCType == "int" && self.context.currentReturnType != null && self.context.currentReturnType.base == "void") {
				value = IRNode.literal("0");
			}
			output.push(IRNode.returnStatement(value));
			return;
		}

		Node expression = statement.value_node;
		Node? returnType = self.context.currentReturnType;
		if (returnType != null) {
			returnType = SemanticTypeSystem.resolveTypedefType(self.cTypes.resolveBodyType(returnType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0), self.analyzed.typedefTable);
		}
		PreparedValue prepared = self.expressions.prepareTargetValue(expression, returnType, varTypes, callableFlow);
		IRNode value = prepared.value;
		bool managedValue = self.managedValues.isManaged(self.cTypes.resolveBodyType(returnType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
		bool managedReturn = managedValue && self.context.currentReturnOwned;
		bool expressionOwned = managedValue && prepared.owned;
		bool localOwned = false;
		string returnedLocal = "";
		if (!prepared.converted && managedValue && expression.kind == NK_IDENTIFIER && self.managedLifetime.managedLocalType(self.context.sourceCName(expression.name)) != "") {
			localOwned = true;
			if (managedReturn) { returnedLocal = expression.name; }
		}
		if (!prepared.converted && returnType != null && returnType.base == "Thread" && expression.kind == NK_IDENTIFIER && self.managedLifetime.localCleanupKind(self.context.sourceCName(expression.name)) == "thread") {
			returnedLocal = expression.name;
		}

		bool ownedValue = managedReturn && (expressionOwned || localOwned);
		bool promoteBorrowed = managedReturn && !ownedValue;
		Vector<IRNode> releases = [];
		self.emitReturnRelease(returnedLocal, releases);
		bool needsTemporary = releases.len > 0 || self.context.tryDepth > 0 || self.managedLifetime.returnCleanupMarker() != "" || promoteBorrowed;
		if (!needsTemporary) {
			output.push(IRNode.returnStatement(self.maybeLaunderReturn(value)));
			return;
		}

		string temporaryName = self.context.freshTemporary("__btrc_ret");
		IRNode declaration = IRNode.variableDeclaration(self.context.currentReturnCType, temporaryName, value);
		self.context.recordLocal(declaration);
		output.push(declaration);
		IRNode result = IRNode.variable(temporaryName);
		if (promoteBorrowed) {
			output.push(IRNode.expressionStatement(self.managedLifetime.retainValue(result, self.cTypes.resolveBodyType(returnType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))));
		}
		if (managedReturn && returnedLocal == "") {
			string runtimeType = self.managedValues.runtimeType(self.cTypes.resolveBodyType(returnType, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
			self.managedLifetime.maybeRegisterCleanup(temporaryName, runtimeType, output);
		}
		int releaseIndex = 0;
		while (releaseIndex < releases.len) {
			output.push(releases.get(releaseIndex));
			releaseIndex = releaseIndex + 1;
		}
		self.emitReturnTryPop(output);
		self.emitReturnCleanupExit(output);
		output.push(IRNode.returnStatement(self.maybeLaunderReturn(result)));
	}

	/* Lower delete through the shared take-clear destruction boundary. */
	public void lowerDelete(Node node, Map<string, Node> varTypes, Vector<IRNode> out, CallableFlowState callableFlow) {
		Node? ot = self.expressions.resolvedExpressionType(node.expr, varTypes);
		/* In a generic body the operand type is `T`/`K`/`V`; resolve it so a
         * generic-instance delete dispatches to the right destructor. */
		if (self.context.genericBody) {
			ot = SemanticTypeSystem.resolveGenericType(ot, self.context.activeTypeMap, self.analyzed);
		}
		ManagedReleaseSlotPlan deletePlan = self.managedTypes.planRelease(node.expr, self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()));
		ManagedReleaseSlot deleteSlot = self.expressions.lowerManagedReleaseSlot(deletePlan, varTypes, out, callableFlow);
		self.expressions.lowerTakenDelete(deleteSlot.target, ot, deleteSlot.owner, deleteSlot.persistent, out);
		deleteSlot.emitAfter(out);
	}

	/* Remove one owned slot, then route the saved value through the shared
     * typed release atom. Clearing first keeps collector visitors from seeing
     * an ownership edge after its count has already been decremented. */
	public void lowerRelease(Node node, Map<string, Node> varTypes, Vector<IRNode> out, CallableFlowState callableFlow) { self.lowerReleaseExpression(node.expr, varTypes, out, callableFlow); }

	public void lowerReleaseExpression(Node expression, Map<string, Node> varTypes, Vector<IRNode> out, CallableFlowState callableFlow) {
		Node? et = self.expressions.resolvedExpressionType(expression, varTypes);
		/* In a monomorphized generic body the operand type is `T`/`K`/`V`; resolve
         * it to the concrete element type so the destructor (or skip) is correct. */
		if (self.context.genericBody) {
			et = SemanticTypeSystem.resolveGenericType(et, self.context.activeTypeMap, self.analyzed);
		}
		/* Primitive values have no ownership unit. Managed strings and class
         * references both dispatch through the shared ownership domain. */
		if (!self.managedValues.isManaged(self.cTypes.resolveBodyType(et, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))) {
			if (self.context.genericBody) { return; }
			print("internal compiler error: non-managed release reached IR generation");
			exit(1);
		}
		ManagedReleaseSlotPlan releasePlan = self.managedTypes.planRelease(expression, self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()));
		ManagedReleaseSlot releaseSlot = self.expressions.lowerManagedReleaseSlot(releasePlan, varTypes, out, callableFlow);
		IRNode target = releaseSlot.target;
		string slotName = self.context.freshTemporary("__btrc_release_slot");
		out.push(IRNode.variableDeclaration(self.cTypes.lower(et) + " volatile*", slotName, IRNode.addressOf(target)));
		IRNode slot = IRNode.dereference(IRNode.variable(slotName));
		string runtimeType = self.managedValues.runtimeType(self.cTypes.resolveBodyType(et, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0));
		bool persistentSlot = releaseSlot.persistent;
		if (persistentSlot && self.managedValues.isArc(self.cTypes.resolveBodyType(et, self.context.activeTypeMap, self.context.genericBody || self.context.callDefaultTypeDepth > 0))) {
			out.push(IRNode.expressionStatement(self.managedLifetime.replaceEdge(slot, IRNode.literal("NULL"), et, releaseSlot.owner, false)));
		} else {
			string valueName = self.context.freshTemporary("__btrc_release_value");
			out.push(IRNode.variableDeclaration(self.cTypes.lower(et), valueName, slot));
			if (persistentSlot) {
				out.push(IRNode.expressionStatement(self.managedLifetime.unlinkEdge(IRNode.variable(valueName), et, releaseSlot.owner)));
			}
			out.push(IRNode.assignment(slot, IRNode.literal("NULL")));
			if (persistentSlot) {
				out.push(IRNode.expressionStatement(self.managedLifetime.releaseEdge(IRNode.variable(valueName), et, IRNode.literal("NULL"))));
			} else {
				out.push(IRNode.expressionStatement(self.managedLifetime.releaseRuntime(IRNode.variable(valueName), runtimeType)));
			}
		}
		releaseSlot.emitAfter(out);
		if (self.cycles.runtimeTypeMayCycle(runtimeType)) {
			if (self.context.batchExplicitReleases) {
				out.push(IRNode.expressionStatement(self.managedLifetime.pollCycles()));
			} else {
				out.push(IRNode.expressionStatement(self.managedLifetime.flushCycles()));
			}
		}
	}

	/* Lower try/catch to setjmp/longjmp boilerplate (mirrors
     * control_flow._lower_try_catch, common catch-present subset). */
	public void lowerTryCatch(Node node, Map<string, Node> varTypes, Vector<IRNode> out, CallableFlowState callableFlow) {
		/* Mark that everything lowered for this construct (try body, catch,
         * finally) lives inside a try/catch, so class-pointer returns get
         * laundered against the gcc -O2 setjmp cross-branch miscompile (see
         * maybeLaunderReturn). Mirrors control_flow._lower_try_catch's
         * in_trycatch_depth bracket. */
		self.context.tryCatchDepth = self.context.tryCatchDepth + 1;
		self.lowerTryCatchInner(node, varTypes, out, callableFlow);
		self.context.tryCatchDepth = self.context.tryCatchDepth - 1;
	}

	public void lowerTryCatchInner(Node node, Map<string, Node> varTypes, Vector<IRNode> out, CallableFlowState callableFlow) {
		self.context.referenceHelper("__btrc_trycatch_globals");
		self.context.referenceHelper("__btrc_push_try");
		self.context.referenceHelper("__btrc_throw");
		/* try/catch needs <setjmp.h> (already added at module level when any
         * declaration uses try/catch). */

		/* A try with a `finally` but NO `catch` must run the finally and then
         * RE-THROW any pending exception to the enclosing handler (mirrors
         * control_flow._lower_try_catch finally_only). */
		bool finallyOnly = node.catch_block == null && node.finally_block != null;
		bool tryTerminates = finallyOnly && ControlFlowValidator.blockTerminates(node.try_block);
		string pendingName = "";
		string errorName = "";
		if (finallyOnly) {
			if (!tryTerminates) {
				pendingName = self.context.freshTemporary("__btrc_finally_pending");
			}
			errorName = self.context.freshTemporary("__btrc_finally_error");
		}
		CallableFlowSnapshot incoming = callableFlow.snapshot();

		Vector<IRNode> pushTryArgs = [];
		out.push(IRNode.expressionStatement(IRNode.call("__btrc_push_try", pushTryArgs)));

		/* try block. */
		self.context.tryDepth = self.context.tryDepth + 1;
		self.managedLifetime.pushControl("try");
		CallableExceptionalCapture exceptionalCapture = callableFlow.beginExceptionalCapture(varTypes, self.analyzed.typedefTable);
		IRNode tryBody = self.lowerBlock(node.try_block, varTypes, callableFlow);
		CallableFlowSnapshot tryFlow = callableFlow.snapshot();
		bool tryContinues = IRStatementSequence(tryBody.stmts).mayFallThrough();
		callableFlow.finishExceptionalCapture(exceptionalCapture);
		callableFlow.restore(incoming);
		self.managedLifetime.popControl();
		self.context.tryDepth = self.context.tryDepth - 1;
		/* Normal exit: discard the cleanup registrations (scope release already
         * freed them), then decrement the try level. Gated on whether any
         * exception cleanup is registered at all (mirrors the global-helper check
         * in control_flow._lower_try_catch). */
		if (self.context.referencesHelper("__btrc_register_cleanup") || self.context.referencesHelper("__btrc_register_direct_cleanup")) {
			self.context.referenceHelper("__btrc_discard_cleanups");
			Vector<IRNode> dargs = [];
			dargs.push(IRNode.variable("__btrc_try_top"));
			tryBody.stmts.push(IRNode.expressionStatement(IRNode.call("__btrc_discard_cleanups", dargs)));
		}
		tryBody.stmts.push(IRNode.expressionStatement(IRNode.unary("--", IRNode.variable("__btrc_try_top"), false)));

		/* Without checked throws, every callback state reached while lowering
         * the try is visible to its exceptional edge. */
		Vector<CallableFlowSnapshot> exceptionalFlows = [];
		int exceptionalFlow = 0;
		while (exceptionalFlow < exceptionalCapture.states.len) {
			exceptionalFlows.push(exceptionalCapture.states.get(exceptionalFlow));
			exceptionalFlow = exceptionalFlow + 1;
		}
		if (tryContinues) {
			exceptionalFlows.push(tryFlow);
		}
		callableFlow.join(exceptionalFlows);
		CallableFlowSnapshot exceptionalEntry = callableFlow.snapshot();

		/* Pending-exception flag + message buffer, declared before the if. */
		if (finallyOnly) {
			if (pendingName != "") {
				out.push(IRNode.variableDeclaration("bool", pendingName, IRNode.literal("false")));
			}
			out.push(IRNode.arrayDeclaration("char", errorName, IRNode.literal("1024"), IRNode.literal("\"\"")));
		}

		/* catch block. */
		Vector<IRNode> catchStmts = [];
		IRNode catchBody = IRNode.block(catchStmts);
		CallableFlowSnapshot catchFlow = exceptionalEntry;
		bool catchContinues = true;
		if (finallyOnly) {
			/* No user catch: capture the in-flight exception so the finally can
             * run, then re-throw it after. */
			Vector<IRNode> cstmts = [];
			if (pendingName != "") {
				cstmts.push(IRNode.assignment(IRNode.variable(pendingName), IRNode.literal("true")));
			}
			Vector<IRNode> copyArgs = [];
			copyArgs.push(IRNode.cast("char*", IRNode.variable(errorName)));
			copyArgs.push(IRNode.sizeofExpression(IRNode.variable(errorName)));
			copyArgs.push(IRNode.variable("__btrc_error_msg"));
			cstmts.push(IRNode.expressionStatement(IRNode.call("__btrc_copy_error_message", copyArgs)));
			catchBody = IRNode.block(cstmts);
		} else if (node.catch_block != null) {
			/* Register the catch variable's type (declared `catch_type`, else
             * `string` — exceptions are string messages) so body inference (e.g.
             * f-string format specifiers) sees `const char*`, not a default int.
             * The Python compiler gets this from analyzer-stamped node_types. */
			Vector<IRNode> catchBindings = [];
			Vector<string> catchSourceNames = [];
			Vector<Node> catchTypes = [];
			Vector<bool> catchOwned = [];
			Map<string, Node> catchVarTypes = TypeValidator.cloneTypes(varTypes);
			Vector<string> catchSourceBindings = self.context.snapshotSourceBindings();
			string catchCName = node.catch_var;
			if (node.catch_var != "") {
				/* Give the catch binding its own message storage. A pointer to
                 * the TLS buffer would be overwritten by any nested catch. */
				Node ctype = SemanticTypeSystem.primitive("string");
				if (node.catch_type != null) { ctype = node.catch_type; }
				catchVarTypes.put(node.catch_var, ctype);
				self.context.activateSourceName(node.catch_var, self.lexicalBindingCName(node.catch_var));
				catchCName = self.context.sourceCName(node.catch_var);
				self.context.referenceHelper("__btrc_strdup");
				self.context.referenceHelper("__btrc_str_track");
				Vector<IRNode> copyArgs = [];
				copyArgs.push(IRNode.variable("__btrc_error_msg"));
				Vector<IRNode> trackArgs = [];
				trackArgs.push(IRNode.call("__btrc_strdup", copyArgs));
				catchBindings.push(IRNode.variableDeclaration("char*", catchCName, IRNode.call("__btrc_str_track", trackArgs)));
				catchSourceNames.push(node.catch_var);
				catchTypes.push(ctype);
				catchOwned.push(true);
			}
			catchBody = self.lowerBlockWithBindings(node.catch_block, catchVarTypes, catchBindings, catchSourceNames, catchTypes, catchOwned, callableFlow);
			catchFlow = callableFlow.snapshot();
			catchContinues = IRStatementSequence(catchBody.stmts).mayFallThrough();
			callableFlow.restore(incoming);
			if (node.catch_var != "") {
				/* A catch binding may be intentionally ignored. Keep the C
                 * warning contract explicit without textual statement escapes. */
				int declarationIndex = 0;
				while (declarationIndex < catchBody.stmts.len && !(catchBody.stmts.get(declarationIndex).kind == IRK_VAR_DECL && catchBody.stmts.get(declarationIndex).name == catchCName)) {
					declarationIndex = declarationIndex + 1;
				}
				catchBody.stmts.insert(declarationIndex + 1, IRNode.expressionStatement(IRNode.variable(catchCName)));
			}
			self.context.restoreSourceBindings(catchSourceBindings);
		}

		Vector<CallableFlowSnapshot> tryFlows = [];
		if (tryContinues) { tryFlows.push(tryFlow); }
		if (!finallyOnly && catchContinues) {
			tryFlows.push(catchFlow);
		}
		callableFlow.restore(incoming);
		if (tryFlows.len > 0) {
			callableFlow.join(tryFlows);
		}
		CallableFlowSnapshot normalContinuation = callableFlow.snapshot();

		IRNode frame = IRNode.indexAccess(IRNode.variable("__btrc_try_stack"), IRNode.variable("__btrc_try_top"));
		Vector<IRNode> setjmpArgs = [];
		setjmpArgs.push(IRNode.fieldAccess(frame, "env", true));
		IRNode tcIf = self.controlFlow.materializeConditional(ConditionalPlan(IRNode.binary(IRNode.call("setjmp", setjmpArgs), "==", IRNode.literal("0")), tryBody, catchBody));
		out.push(tcIf);
		if (node.finally_block == null && tryFlows.len == 0) {
			/* GCC 15 with ASan can conservatively treat a setjmp-backed
			 * conditional containing a VLA as falling through even when both
			 * structured branches terminate. Materialize the impossible edge. */
			Vector<IRNode> abortArgs = [];
			IRNode abortCall = IRNode.call("abort", abortArgs);
			abortCall.never_returns = true;
			out.push(IRNode.expressionStatement(abortCall));
		}

		/* finally block: emitted inline after the if. */
		if (node.finally_block != null) {
			if (finallyOnly) {
				Vector<CallableFlowSnapshot> finallyEntries = [];
				if (tryContinues) {
					finallyEntries.push(tryFlow);
				}
				finallyEntries.push(catchFlow);
				callableFlow.restore(incoming);
				callableFlow.join(finallyEntries);
			}
			CallableMutationCapture finallyMutations = callableFlow.beginMutationCapture(varTypes, self.analyzed.typedefTable);
			IRNode fin = self.lowerBlock(node.finally_block, varTypes, callableFlow);
			CallableFlowSnapshot finallyExit = callableFlow.snapshot();
			Vector<string> mutatedBindings = callableFlow.finishMutationCapture(finallyMutations);
			int i = 0;
			while (i < fin.stmts.len) { out.push(fin.stmts.get(i)); i = i + 1; }
			/* Re-throw the captured exception (finally-only). */
			if (finallyOnly) {
				Vector<IRNode> targs = [];
				targs.push(IRNode.cast("const char*", IRNode.variable(errorName)));
				IRNode rethrowCall = IRNode.call("__btrc_throw", targs);
				rethrowCall.never_returns = true;
				IRNode rethrow = IRNode.expressionStatement(rethrowCall);
				if (pendingName == "") {
					out.push(rethrow);
				} else {
					Vector<IRNode> rethrowBody = [];
					rethrowBody.push(rethrow);
					out.push(self.controlFlow.materializeConditional(ConditionalPlan(IRNode.variable(pendingName), IRNode.block(rethrowBody), null)));
				}
			}
			if (finallyOnly && tryContinues) {
				/* The synthetic catch always rethrows. Lower finally once
                 * from the conservative all-edge join, then project only its
                 * explicit callback mutations onto the real normal edge. */
				CallableFlowSnapshot projected = callableFlow.projectMutations(finallyExit, normalContinuation, mutatedBindings);
				callableFlow.restore(projected);
			} else if (finallyOnly) {
				callableFlow.restore(incoming);
			}
		}
	}

	/* Lower a switch statement -> IRSwitch with IRCase children (mirrors
     * control_flow._lower_switch). A case with no value is the `default:` clause. */
	public IRNode lowerSwitch(Node node, Map<string, Node> varTypes, CallableFlowState callableFlow) {
		IRNode val = self.expressions.lowerExpr(node.value_node, varTypes, callableFlow);
		CallableFlowSnapshot incoming = callableFlow.snapshot();
		CallableSwitchCapture switchCapture = callableFlow.beginSwitchCapture(varTypes, self.analyzed.typedefTable);
		bool hasDefault = false;
		Vector<IRNode> cases = [];
		CallableFlowSnapshot fallthroughFlow = incoming;
		bool hasFallthroughFlow = false;
		self.managedLifetime.pushControl("switch");
		int i = 0;
		while (i < node.cases.len) {
			Node c = node.cases.get(i);
			callableFlow.restore(incoming);
			if (hasFallthroughFlow) {
				Vector<CallableFlowSnapshot> entries = [];
				entries.push(incoming);
				entries.push(fallthroughFlow);
				callableFlow.join(entries);
			}
			CallableFlowSnapshot enclosingCase = callableFlow.beginScope();
			Map<string, Node> caseTypes = TypeValidator.cloneTypes(varTypes);
			Vector<string> caseBorrowedBindings = self.context.snapshotBorrowedBindings();
			Vector<string> caseSourceBindings = self.context.snapshotSourceBindings();
			string cleanupMarker = self.managedLifetime.pushCleanupScope();
			IRNode? caseVal = null;
			if (c.value_node != null) {
				caseVal = self.expressions.lowerExpr(c.value_node, varTypes, callableFlow);
			} else {
				hasDefault = true;
			}
			Vector<IRNode> body = [];
			self.managedLifetime.pushManagedScope();
			int j = 0;
			while (j < c.body_nlist.len) {
				self.lowerStmtInto(c.body_nlist.get(j), caseTypes, body, callableFlow);
				j = j + 1;
			}
			IRStatementSequence sequence = IRStatementSequence(body);
			bool fallsThrough = sequence.mayFallThrough();
			Vector<Managed> managed = self.managedLifetime.popManagedScope();
			bool markerReferenced = fallsThrough || sequence.referencesVariable(cleanupMarker);
			if (self.managedLifetime.cleanupScopeIsActive(cleanupMarker) && markerReferenced) {
				self.context.referenceHelper("__btrc_cleanup_mark");
				Vector<IRNode> markArgs = [];
				body.insert(0, IRNode.variableDeclaration("int", cleanupMarker, IRNode.call("__btrc_cleanup_mark", markArgs)));
			}
			if (fallsThrough) {
				self.emitScopeRelease(managed, body);
				self.emitCleanupScopeExit(cleanupMarker, body);
			}
			self.managedLifetime.popCleanupScope();
			self.context.restoreBorrowedBindings(caseBorrowedBindings);
			self.context.restoreSourceBindings(caseSourceBindings);
			callableFlow.finishScope(enclosingCase);
			CallableFlowSnapshot caseFlow = callableFlow.snapshot();
			hasFallthroughFlow = fallsThrough;
			if (hasFallthroughFlow) { fallthroughFlow = caseFlow; }
			cases.push(IRNode.caseClause(caseVal, body, fallsThrough));
			i = i + 1;
		}
		self.managedLifetime.popControl();
		callableFlow.finishSwitchCapture(switchCapture);
		callableFlow.restore(incoming);
		Vector<CallableFlowSnapshot> caseFlows = [];
		int breakIndex = 0;
		while (breakIndex < switchCapture.breaks.len) {
			caseFlows.push(switchCapture.breaks.get(breakIndex));
			breakIndex = breakIndex + 1;
		}
		if (hasFallthroughFlow) {
			caseFlows.push(fallthroughFlow);
		}
		if (!hasDefault) { caseFlows.push(incoming); }
		if (caseFlows.len > 0) {
			callableFlow.join(caseFlows);
		}
		return self.controlFlow.materializeSwitch(SwitchPlan(val, cases, caseFlows.len > 0));
	}

	public IRNode lowerIf(Node node, Map<string, Node> varTypes, CallableFlowState callableFlow) {
		IRNode cond = self.expressions.lowerExpr(node.condition, varTypes, callableFlow);
		CallableFlowSnapshot incoming = callableFlow.snapshot();
		IRNode then_b = self.lowerBlock(node.then_block, varTypes, callableFlow);
		CallableFlowSnapshot thenFlow = callableFlow.snapshot();
		callableFlow.restore(incoming);
		IRNode? else_b = null;
		CallableFlowSnapshot elseFlow = incoming;
		if (node.else_block != null) {
			else_b = self.lowerElse(node.else_block, varTypes, callableFlow);
			elseFlow = callableFlow.snapshot();
			callableFlow.restore(incoming);
		}
		Vector<CallableFlowSnapshot> flows = [];
		if (IRStatementSequence(then_b.stmts).mayFallThrough()) {
			flows.push(thenFlow);
		}
		if (else_b == null || IRStatementSequence(else_b.stmts).mayFallThrough()) {
			flows.push(elseFlow);
		}
		if (flows.len > 0) {
			callableFlow.join(flows);
		}
		return self.controlFlow.materializeConditional(ConditionalPlan(cond, then_b, else_b));
	}

	/* Lower an else tail (ElseBlock or ElseIf) into an IRBlock. */
	public IRNode lowerElse(Node node, Map<string, Node> varTypes, CallableFlowState callableFlow) {
		if (node.kind == NK_ELSE_BLOCK) {
			return self.lowerBlock(node.body_node, varTypes, callableFlow);
		}
		if (node.kind == NK_ELSE_IF) {
			Vector<IRNode> stmts = [];
			stmts.push(self.lowerIf(node.if_stmt, varTypes, callableFlow));
			return IRNode.block(stmts);
		}
		Vector<IRNode> empty = [];
		return IRNode.block(empty);
	}

	public IRNode lowerCFor(Node node, Map<string, Node> varTypes, CallableFlowState callableFlow) {
		CallableFlowSnapshot enclosingCallables = callableFlow.beginScope();
		Vector<string> borrowedBindings = self.context.snapshotBorrowedBindings();
		Vector<string> sourceBindings = self.context.snapshotSourceBindings();
		Map<string, Node> loopTypes = TypeValidator.cloneTypes(varTypes);
		Vector<IRNode> prefix = [];
		bool declarationScope = false;
		string cleanupMarker = "";
		IRNode? init = null;
		if (node.init != null) {
			if (node.init.kind == NK_FOR_INIT_VAR) {
				declarationScope = true;
				cleanupMarker = self.managedLifetime.pushCleanupScope();
				self.managedLifetime.pushManagedScope();
				/* Retain/transfer, Thread registration, and exception cleanup
                 * are statement sequences, not valid C for-clause syntax.
                 * Reuse the complete declaration lowering in a lexical block. */
				self.lowerStmtInto(node.init.var_decl, loopTypes, prefix, callableFlow);
			} else if (node.init.kind == NK_FOR_INIT_EXPR) {
				init = IRNode.expressionStatement(self.expressions.lowerExpr(node.init.expression, loopTypes, callableFlow));
			}
		}
		/* Condition defaults to literal 1 when absent (matches iterations.py). */
		IRNode cond = IRNode.literal("1");
		if (node.condition != null) {
			CallableFlowSnapshot conditionEntry = callableFlow.snapshot();
			cond = self.expressions.lowerExpr(node.condition, loopTypes, callableFlow);
			CallableFlowSnapshot conditionExit = callableFlow.snapshot();
			callableFlow.requireInvariant(conditionEntry, conditionExit, "condition");
		}
		LoweredCallableLoopBody loweredBody = self.lowerLoopBodyRaw(node.body_node, loopTypes, callableFlow);
		bool conditionCanRepeat = self.loopConditionCanRepeat(node.condition);
		IRNode? update = null;
		if (node.update != null) {
			Vector<CallableFlowSnapshot> repeated = self.repeatedLoopEdges(loweredBody);
			CallableFlowSnapshot beforeUpdate = loweredBody.head;
			if (repeated.len > 0) {
				beforeUpdate = callableFlow.merged(repeated);
			}
			callableFlow.restore(beforeUpdate);
			update = self.expressions.lowerExpr(node.update, loopTypes, callableFlow);
			CallableFlowSnapshot updateFlow = callableFlow.snapshot();
			if (repeated.len > 0 && conditionCanRepeat) {
				callableFlow.requireInvariant(loweredBody.head, updateFlow, "back-edge");
			}
		} else if (conditionCanRepeat) {
			self.requireDirectLoopBackedges(loweredBody, callableFlow);
		}
		Vector<CallableFlowSnapshot> loopExits = [];
		if (node.condition != null) {
			loopExits.push(loweredBody.head);
		}
		self.appendLoopBreaks(loweredBody.exits, loopExits);
		callableFlow.restore(loweredBody.head);
		if (loopExits.len > 0) {
			callableFlow.join(loopExits);
		}
		IRNode lowered = self.controlFlow.materializeFor(ForPlan(init, cond, update, loweredBody.body));
		lowered.realtime_bounded = self.analyzed.realtimeBoundedLoopKeys.has(AstIdentity.key(node));
		if (declarationScope) {
			Vector<IRNode> scopedStatements = prefix;
			scopedStatements.push(lowered);
			IRStatementSequence sequence = IRStatementSequence(scopedStatements);
			bool fallsThrough = sequence.mayFallThrough();
			Vector<Managed> managed = self.managedLifetime.popManagedScope();
			bool markerReferenced = fallsThrough || sequence.referencesVariable(cleanupMarker);
			if (self.managedLifetime.cleanupScopeIsActive(cleanupMarker) && markerReferenced) {
				self.context.referenceHelper("__btrc_cleanup_mark");
				Vector<IRNode> markArgs = [];
				scopedStatements.insert(0, IRNode.variableDeclaration("int", cleanupMarker, IRNode.call("__btrc_cleanup_mark", markArgs)));
			}
			if (fallsThrough) {
				self.emitScopeRelease(managed, scopedStatements);
				self.emitCleanupScopeExit(cleanupMarker, scopedStatements);
			}
			self.managedLifetime.popCleanupScope();
			lowered = IRNode.block(scopedStatements);
		}
		self.context.restoreBorrowedBindings(borrowedBindings);
		self.context.restoreSourceBindings(sourceBindings);
		callableFlow.finishScope(enclosingCallables);
		return lowered;
	}

	/* Build a loop body block with `prefix` statements prepended to the lowered
     * body (the binding decls), mirroring body_block.stmts.insert(0, ...). */
	public IRNode loopBodyWithPrefix(Node bodyNode, Map<string, Node> varTypes, Vector<IRNode> prefix, Vector<string> sourceNames, Vector<Node> types, Vector<bool> owned, CallableFlowState callableFlow) { return self.lowerLoopBodyWithBindings(bodyNode, varTypes, prefix, sourceNames, types, owned, callableFlow); }

	/* Iterable-value C type for a generic arg: class values are reference types,
     * so append a pointer if not already a pointer (mirrors _iter_value_c). */
	public string iterValueC(Node t) {
		string c = self.cTypes.lower(t);
		bool isPtr = false;
		if (c.length() >= 1 && c.substring(c.length() - 1, 1) == "*") { isPtr = true; }
		if (t != null && self.analyzed.isClass(t.base) && !isPtr) {
			return c + "*";
		}
		return c;
	}

	/* Lower for-in to a C-style for loop (mirrors iterations._lower_for_in). */
	public void lowerForIn(Node node, Map<string, Node> varTypes, Vector<IRNode> out, CallableFlowState callableFlow) {
		Vector<string> sourceBindings = self.context.snapshotSourceBindings();
		Map<string, Node> loopTypes = TypeValidator.cloneTypes(varTypes);
		Node iterable = node.iterable;
		string varName = node.var_name;

		/* range(...) form. */
		if (iterable.kind == NK_CALL_EXPR && iterable.callee != null && iterable.callee.kind == NK_IDENTIFIER && iterable.callee.name == "range") {
			self.lowerRangeFor(varName, iterable.args, node.body_node, loopTypes, out, callableFlow);
			self.context.restoreSourceBindings(sourceBindings);
			return;
		}

		Node? iterType = self.expressions.resolvedExpressionType(iterable, loopTypes);
		if (self.analyzed.arrayIterationCapacityKeys.has(AstIdentity.key(iterable))) {
			self.lowerFixedArrayForIn(node, iterType, loopTypes, out, callableFlow);
			self.context.restoreSourceBindings(sourceBindings);
			return;
		}
		IRNode irIter = self.expressions.lowerExpr(iterable, loopTypes, callableFlow);

		if (iterType != null && iterType.base == "Span" && iterType.generic_args.len == 1) {
			self.lowerSpanForIn(node, irIter, iterType, varName, loopTypes, out, callableFlow);
			self.context.restoreSourceBindings(sourceBindings);
			return;
		}

		/* Iterable protocol: generic class with iterLen + iterGet methods. */
		if (iterType != null && ControlFlowValidator.iterableMethod(iterType, "iterLen", self.analyzed) != null && ControlFlowValidator.iterableMethod(iterType, "iterGet", self.analyzed) != null) {
			self.lowerIterableForIn(node, irIter, iterType, varName, loopTypes, out, callableFlow);
			self.context.restoreSourceBindings(sourceBindings);
			return;
		}

		/* String iteration: for c in str. */
		if (iterType != null && iterType.base == "string" && iterType.pointer_depth == 0 && iterType.generic_args.len == 0) {
			self.lowerStringForIn(node, irIter, varName, loopTypes, out, callableFlow);
			self.context.restoreSourceBindings(sourceBindings);
			return;
		}

		self.context.restoreSourceBindings(sourceBindings);
		print("internal compiler error: unproven for-in iterable reached IR generation");
		exit(1);
	}

	private void lowerSpanForIn(Node node, IRNode irIter, Node iterType, string varName, Map<string, Node> varTypes, Vector<IRNode> out, CallableFlowState callableFlow) {
		string indexName = self.context.freshTemporary("__i");
		string iterName = self.context.freshTemporary("__span");
		out.push(IRNode.variableDeclaration(self.cTypes.lower(iterType), iterName, irIter));
		Node elementType = iterType.generic_args.get(0);
		varTypes.put(varName, elementType);
		self.context.activateSourceName(varName, self.lexicalBindingCName(varName));
		string valueName = self.context.sourceCName(varName);
		IRNode data = IRNode.fieldAccess(IRNode.variable(iterName), "data", false);
		Vector<IRNode> prefix = [];
		prefix.push(IRNode.variableDeclaration(self.iterValueC(elementType), valueName, IRNode.indexAccess(data, IRNode.variable(indexName))));
		Vector<string> bindingNames = [];
		bindingNames.push(varName);
		Vector<Node> bindingTypes = [];
		bindingTypes.push(elementType);
		Vector<bool> bindingOwned = [];
		bindingOwned.push(false);
		IRNode body = self.loopBodyWithPrefix(node.body_node, varTypes, prefix, bindingNames, bindingTypes, bindingOwned, callableFlow);
		IRNode init = IRNode.variableDeclaration("size_t", indexName, IRNode.literal("0"));
		IRNode condition = IRNode.binary(IRNode.variable(indexName), "<", IRNode.fieldAccess(IRNode.variable(iterName), "length", false));
		IRNode update = IRNode.unary("++", IRNode.variable(indexName), false);
		out.push(self.controlFlow.materializeFor(ForPlan(init, condition, update, body)));
	}

	/* for-in via Iterable protocol (iterLen/iterGet/iterValueAt). */
	public void lowerIterableForIn(Node node, IRNode irIter, Node iterType, string varName, Map<string, Node> varTypes, Vector<IRNode> out, CallableFlowState callableFlow) {
		string calleePrefix = iterType.base;
		if (self.analyzed.isGenericClass(iterType.base)) {
			calleePrefix = TypeIdentity.mangleGenericType(iterType.base, iterType.generic_args);
		}
		string idx = self.context.freshTemporary("__i");
		string nVar = self.context.freshTemporary("__n");
		string iterVar = self.context.freshTemporary("__iter");
		out.push(IRNode.variableDeclaration(self.cTypes.lower(iterType), iterVar, irIter));
		string ownedRuntimeType = self.expressions.beginOwnedIteration(node.iterable, iterType, varTypes, iterVar, out, callableFlow);
		Node getMethod = ControlFlowValidator.iterableMethod(iterType, "iterGet", self.analyzed);
		Node elemT = ControlFlowValidator.iterableResolvedType(getMethod.return_type, iterType, self.analyzed);
		string elemC = self.iterValueC(elemT);
		varTypes.put(varName, elemT);
		self.context.activateSourceName(varName, self.lexicalBindingCName(varName));
		string varCName = self.context.sourceCName(varName);
		Vector<IRNode> bindings = [];
		Vector<string> bindingSourceNames = [];
		Vector<Node> bindingTypes = [];
		Vector<bool> bindingOwned = [];
		Vector<IRNode> gargs = [];
		gargs.push(IRNode.variable(iterVar));
		gargs.push(IRNode.variable(idx));
		bindings.push(IRNode.variableDeclaration(elemC, varCName, IRNode.call(calleePrefix + "_iterGet", gargs)));
		bindingSourceNames.push(varName);
		bindingTypes.push(elemT);
		bindingOwned.push(true);
		/* Two-variable iteration (for k, v in map). var_name2 is nullable. */
		string vn2 = "";
		if (node.var_name2 != null) { vn2 = node.var_name2; }
		Node? valueMethod = ControlFlowValidator.iterableMethod(iterType, "iterValueAt", self.analyzed);
		if (vn2 != "" && valueMethod != null) {
			Node v2T = ControlFlowValidator.iterableResolvedType(valueMethod.return_type, iterType, self.analyzed);
			string vC = self.iterValueC(v2T);
			varTypes.put(vn2, v2T);
			self.context.activateSourceName(vn2, self.lexicalBindingCName(vn2));
			string secondCName = self.context.sourceCName(vn2);
			Vector<IRNode> vargs = [];
			vargs.push(IRNode.variable(iterVar));
			vargs.push(IRNode.variable(idx));
			bindings.push(IRNode.variableDeclaration(vC, secondCName, IRNode.call(calleePrefix + "_iterValueAt", vargs)));
			bindingSourceNames.push(vn2);
			bindingTypes.push(v2T);
			bindingOwned.push(true);
		}
		IRNode body = self.loopBodyWithPrefix(node.body_node, varTypes, bindings, bindingSourceNames, bindingTypes, bindingOwned, callableFlow);
		Vector<IRNode> nargs = [];
		nargs.push(IRNode.variable(iterVar));
		Node lenMethod = ControlFlowValidator.iterableMethod(iterType, "iterLen", self.analyzed);
		Node lenType = ControlFlowValidator.iterableResolvedType(lenMethod.return_type, iterType, self.analyzed);
		out.push(IRNode.variableDeclaration(self.cTypes.lower(lenType), nVar, IRNode.call(calleePrefix + "_iterLen", nargs)));
		IRNode forInit = IRNode.variableDeclaration("int", idx, IRNode.literal("0"));
		IRNode cond = IRNode.binary(IRNode.variable(idx), "<", IRNode.variable(nVar));
		IRNode upd = IRNode.unary("++", IRNode.variable(idx), false);
		out.push(self.controlFlow.materializeFor(ForPlan(forInit, cond, upd, body)));
		self.expressions.endOwnedIteration(iterVar, ownedRuntimeType, out);
	}

	/* for c in str -> char-by-char iteration. */
	public void lowerStringForIn(Node node, IRNode irIter, string varName, Map<string, Node> varTypes, Vector<IRNode> out, CallableFlowState callableFlow) {
		string idx = self.context.freshTemporary("__i");
		string iterVar = self.context.freshTemporary("__iter");
		out.push(IRNode.variableDeclaration("char*", iterVar, irIter));
		Node stringType = SemanticTypeSystem.primitive("string");
		string ownedRuntimeType = self.expressions.beginOwnedIteration(node.iterable, stringType, varTypes, iterVar, out, callableFlow);
		varTypes.put(varName, SemanticTypeSystem.primitive("char"));
		self.context.activateSourceName(varName, self.lexicalBindingCName(varName));
		string varCName = self.context.sourceCName(varName);
		Vector<IRNode> prefix = [];
		prefix.push(IRNode.variableDeclaration("char", varCName, IRNode.indexAccess(IRNode.variable(iterVar), IRNode.variable(idx))));
		Vector<string> bindingSourceNames = [];
		bindingSourceNames.push(varName);
		Vector<Node> bindingTypes = [];
		bindingTypes.push(SemanticTypeSystem.primitive("char"));
		Vector<bool> bindingOwned = [];
		bindingOwned.push(false);
		IRNode body = self.loopBodyWithPrefix(node.body_node, varTypes, prefix, bindingSourceNames, bindingTypes, bindingOwned, callableFlow);
		IRNode forInit = IRNode.variableDeclaration("int", idx, IRNode.literal("0"));
		IRNode cond = IRNode.binary(IRNode.indexAccess(IRNode.variable(iterVar), IRNode.variable(idx)), "!=", IRNode.literal("'\\0'"));
		IRNode upd = IRNode.unary("++", IRNode.variable(idx), false);
		out.push(self.controlFlow.materializeFor(ForPlan(forInit, cond, upd, body)));
		self.expressions.endOwnedIteration(iterVar, ownedRuntimeType, out);
	}

	/* for x in range(...) -> C for loop (1, 2, or 3+ args). */
	public void lowerRangeFor(string varName, Vector<Node> args, Node bodyNode, Map<string, Node> varTypes, Vector<IRNode> out, CallableFlowState callableFlow) {
		string startName = self.context.freshTemporary("__range_start");
		string endName = self.context.freshTemporary("__range_end");
		string stepName = self.context.freshTemporary("__range_step");
		IRNode start = IRNode.literal("0");
		IRNode end = IRNode.literal("0");
		IRNode step = IRNode.literal("1");
		if (args.len == 1) {
			end = self.expressions.lowerExpr(args.get(0), varTypes, callableFlow);
			out.push(IRNode.variableDeclaration("int", endName, end));
		} else if (args.len == 2 || args.len == 3) {
			start = self.expressions.lowerExpr(args.get(0), varTypes, callableFlow);
			end = self.expressions.lowerExpr(args.get(1), varTypes, callableFlow);
			out.push(IRNode.variableDeclaration("int", startName, start));
			out.push(IRNode.variableDeclaration("int", endName, end));
			start = IRNode.variable(startName);
			if (args.len == 3) {
				step = self.expressions.lowerExpr(args.get(2), varTypes, callableFlow);
				out.push(IRNode.variableDeclaration("int", stepName, step));
				step = IRNode.variable(stepName);
				Vector<IRNode> zeroStep = [];
				Vector<IRNode> errorArgs = [];
				errorArgs.push(IRNode.literal("\"range step cannot be zero\\n\""));
				errorArgs.push(IRNode.variable("stderr"));
				zeroStep.push(IRNode.expressionStatement(IRNode.call("fputs", errorArgs)));
				Vector<IRNode> exitArgs = [];
				exitArgs.push(IRNode.literal("1"));
				zeroStep.push(IRNode.expressionStatement(IRNode.call("exit", exitArgs)));
				out.push(self.controlFlow.materializeConditional(ConditionalPlan(IRNode.binary(step, "==", IRNode.literal("0")), IRNode.block(zeroStep), null)));
			}
		} else {
			print(f"irgen: range expects 1 to 3 arguments, got {args.len}");
			exit(1);
		}
		end = IRNode.variable(endName);
		varTypes.put(varName, SemanticTypeSystem.primitive("int"));
		self.context.activateSourceName(varName, self.lexicalBindingCName(varName));
		string varCName = self.context.sourceCName(varName);
		IRNode body = self.lowerLoopBody(bodyNode, varTypes, callableFlow);
		IRNode forInit = IRNode.variableDeclaration("int", varCName, start);
		IRNode cond = IRNode.binary(IRNode.variable(varCName), "<", end);
		IRNode update = IRNode.unary("++", IRNode.variable(varCName), false);
		if (args.len == 3) {
			IRNode posCond = IRNode.binary(IRNode.variable(varCName), "<", end);
			IRNode negCond = IRNode.binary(IRNode.variable(varCName), ">", end);
			cond = IRNode.ternary(IRNode.binary(step, ">", IRNode.literal("0")), posCond, negCond);
			update = IRNode.binary(IRNode.variable(varCName), "+=", step);
		}
		out.push(self.controlFlow.materializeFor(ForPlan(forInit, cond, update, body)));
	}

	/* --- expression lowering --- */


	/* Exact-once iteration over fixed C-array storage. */

	private IRNode fixedArrayIterationCapacity(IRNode array) { return IRNode.binary(IRNode.sizeofExpression(array), "/", IRNode.sizeofExpression(IRNode.indexAccess(array, IRNode.literal("0")))); }

	private void lowerFixedArrayForIn(Node statement, Node arrayType, Map<string, Node> varTypes, Vector<IRNode> output, CallableFlowState callableFlow) {
		Vector<Node> roots = [];
		Vector<bool> owned = [];
		Vector<bool> kept = [];
		self.ownershipSemantics.collectProjectionStorage(statement.iterable, self.context.ownershipEnvironment(varTypes, self.gpuPipeline.cpuActive()), roots, owned, kept, callableFlow);
		Vector<string> rootNames = [];
		Vector<string> runtimeTypes = [];
		Vector<string> overrideKeys = [];
		Vector<int> overrideHadValues = [];
		Vector<IRNode> overridePreviousValues = [];
		int rootIndex = 0;
		while (rootIndex < roots.len) {
			Node root = roots.get(rootIndex);
			Node? rootType = self.expressions.resolvedExpressionType(root, varTypes);
			self.operandPlanner.requireType(rootType, root);
			string rootName = self.context.freshTemporary("__array_storage");
			IRNode rootDeclaration = IRNode.variableDeclaration(self.cTypes.lower(rootType), rootName, self.expressions.lowerExpr(root, varTypes, callableFlow));
			output.push(rootDeclaration);
			string runtimeType = self.expressions.beginOwnedIteration(root, rootType, varTypes, rootName, output, callableFlow);
			rootNames.push(rootName);
			runtimeTypes.push(runtimeType);

			string key = AstIdentity.key(root);
			overrideKeys.push(key);
			if (self.context.hasExpressionOverrideKey(key)) {
				overrideHadValues.push(1);
				overridePreviousValues.push(self.context.expressionOverrideForKey(key));
			} else {
				overrideHadValues.push(0);
				overridePreviousValues.push(IRNode.literal("0"));
			}
			self.context.setExpressionOverrideKey(key, IRNode.variable(rootName));
			rootIndex = rootIndex + 1;
		}

		IRNode projected = self.expressions.lowerExpr(statement.iterable, varTypes, callableFlow);
		int overrideIndex = overrideKeys.len - 1;
		while (overrideIndex >= 0) {
			string key = overrideKeys.get(overrideIndex);
			if (overrideHadValues.get(overrideIndex) != 0) {
				self.context.setExpressionOverrideKey(key, overridePreviousValues.get(overrideIndex));
			} else {
				self.context.removeExpressionOverrideKey(key);
			}
			overrideIndex = overrideIndex - 1;
		}

		string iterable = self.context.freshTemporary("__iter");
		string length = self.context.freshTemporary("__n");
		string index = self.context.freshTemporary("__i");
		output.push(IRNode.variableDeclaration(self.cTypes.lower(arrayType), iterable, projected));
		IRNode iterationLength = self.fixedArrayIterationCapacity(projected);
		if (statement.iterable.kind == NK_IDENTIFIER && self.gpuPipeline.hasHostCapacity(statement.iterable.name)) {
			iterationLength = self.gpuPipeline.hostCapacity(statement.iterable.name);
		}
		output.push(IRNode.variableDeclaration("size_t", length, iterationLength));

		Node elementType = TypeShape.withoutOuterArray(arrayType);
		string sourceName = statement.var_name;
		varTypes.put(sourceName, elementType);
		self.context.activateSourceName(sourceName, self.lexicalBindingCName(sourceName));
		string bindingName = self.context.sourceCName(sourceName);
		Vector<IRNode> bindings = [];
		bindings.push(IRNode.variableDeclaration(self.iterValueC(elementType), bindingName, IRNode.indexAccess(IRNode.variable(iterable), IRNode.variable(index))));
		Vector<string> bindingSourceNames = [];
		bindingSourceNames.push(sourceName);
		Vector<Node> bindingTypes = [];
		bindingTypes.push(elementType);
		Vector<bool> bindingOwned = [];
		bindingOwned.push(false);
		IRNode body = self.loopBodyWithPrefix(statement.body_node, varTypes, bindings, bindingSourceNames, bindingTypes, bindingOwned, callableFlow);
		output.push(self.controlFlow.materializeFor(ForPlan(IRNode.variableDeclaration("size_t", index, IRNode.literal("0")), IRNode.binary(IRNode.variable(index), "<", IRNode.variable(length)), IRNode.unary("++", IRNode.variable(index), false), body)));

		int cleanupIndex = rootNames.len - 1;
		while (cleanupIndex >= 0) {
			self.expressions.endOwnedIteration(rootNames.get(cleanupIndex), runtimeTypes.get(cleanupIndex), output);
			cleanupIndex = cleanupIndex - 1;
		}
	}

	/* True if any declaration in the program uses try/catch or throw (mirrors
     * feature_scan.program_uses_trycatch). */
	public bool programUsesTrycatch(Node prog) {
		int i = 0;
		while (i < prog.declarations.len) {
			if (self.nodeUsesTrycatch(prog.declarations.get(i))) {
				return true;
			}
			i = i + 1;
		}
		return false;
	}

	private bool nodeVectorUsesTrycatch(Vector<Node> nodes) {
		int i = 0;
		while (i < nodes.len) {
			if (self.nodeUsesTrycatch(nodes.get(i))) { return true; }
			i = i + 1;
		}
		return false;
	}

	/* Recursively scan every AST-owned Node field for exception syntax. Lambda
     * bodies are expression-owned: reaching body_node is insufficient unless the
     * walk first reaches a VarDecl initializer, call argument, or other enclosing
     * expression. The parser AST is an acyclic ownership tree. */
	private bool nodeUsesTrycatch(Node? n) {
		if (n == null) { return false; }
		if (n.kind == NK_THROW_STMT || n.kind == NK_TRY_CATCH_STMT) { return true; }
		if (self.nodeVectorUsesTrycatch(n.declarations)) { return true; }
		if (self.nodeVectorUsesTrycatch(n.members)) { return true; }
		if (self.nodeVectorUsesTrycatch(n.methods)) { return true; }
		if (self.nodeVectorUsesTrycatch(n.fields)) { return true; }
		if (self.nodeVectorUsesTrycatch(n.values)) { return true; }
		if (self.nodeVectorUsesTrycatch(n.variants)) { return true; }
		if (self.nodeVectorUsesTrycatch(n.generic_args)) { return true; }
		if (self.nodeVectorUsesTrycatch(n.params)) { return true; }
		if (self.nodeVectorUsesTrycatch(n.statements)) { return true; }
		if (self.nodeVectorUsesTrycatch(n.cases)) { return true; }
		if (self.nodeVectorUsesTrycatch(n.body_nlist)) { return true; }
		if (self.nodeVectorUsesTrycatch(n.args)) { return true; }
		if (self.nodeVectorUsesTrycatch(n.elements)) { return true; }
		if (self.nodeVectorUsesTrycatch(n.entries)) { return true; }
		if (self.nodeVectorUsesTrycatch(n.parts)) { return true; }
		if (self.nodeVectorUsesTrycatch(n.captures)) { return true; }
		if (self.nodeUsesTrycatch(n.spec)) { return true; }
		if (self.nodeUsesTrycatch(n.return_type)) { return true; }
		if (self.nodeUsesTrycatch(n.body_node)) { return true; }
		if (self.nodeUsesTrycatch(n.original)) { return true; }
		if (self.nodeUsesTrycatch(n.array_size)) { return true; }
		if (self.nodeUsesTrycatch(n.type)) { return true; }
		if (self.nodeUsesTrycatch(n.default_)) { return true; }
		if (self.nodeUsesTrycatch(n.initializer)) { return true; }
		if (self.nodeUsesTrycatch(n.getter_body)) { return true; }
		if (self.nodeUsesTrycatch(n.setter_body)) { return true; }
		if (self.nodeUsesTrycatch(n.value_node)) { return true; }
		if (self.nodeUsesTrycatch(n.condition)) { return true; }
		if (self.nodeUsesTrycatch(n.then_block)) { return true; }
		if (self.nodeUsesTrycatch(n.else_block)) { return true; }
		if (self.nodeUsesTrycatch(n.iterable)) { return true; }
		if (self.nodeUsesTrycatch(n.init)) { return true; }
		if (self.nodeUsesTrycatch(n.update)) { return true; }
		if (self.nodeUsesTrycatch(n.expr)) { return true; }
		if (self.nodeUsesTrycatch(n.try_block)) { return true; }
		if (self.nodeUsesTrycatch(n.catch_type)) { return true; }
		if (self.nodeUsesTrycatch(n.catch_block)) { return true; }
		if (self.nodeUsesTrycatch(n.finally_block)) { return true; }
		if (self.nodeUsesTrycatch(n.if_stmt)) { return true; }
		if (self.nodeUsesTrycatch(n.var_decl)) { return true; }
		if (self.nodeUsesTrycatch(n.expression)) { return true; }
		if (self.nodeUsesTrycatch(n.left)) { return true; }
		if (self.nodeUsesTrycatch(n.right)) { return true; }
		if (self.nodeUsesTrycatch(n.operand)) { return true; }
		if (self.nodeUsesTrycatch(n.callee)) { return true; }
		if (self.nodeUsesTrycatch(n.obj)) { return true; }
		if (self.nodeUsesTrycatch(n.index)) { return true; }
		if (self.nodeUsesTrycatch(n.target_type)) { return true; }
		if (self.nodeUsesTrycatch(n.true_expr)) { return true; }
		if (self.nodeUsesTrycatch(n.false_expr)) { return true; }
		if (self.nodeUsesTrycatch(n.target)) { return true; }
		if (self.nodeUsesTrycatch(n.fn)) { return true; }
		if (self.nodeUsesTrycatch(n.key)) { return true; }
		return false;
	}
}
