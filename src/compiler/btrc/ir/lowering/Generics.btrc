import Library.Map;
import Library.Vector;

import ../../analyzer/Models.btrc;
import ../../analyzer/Types.btrc;
import ../../generated/ast/Node.btrc;
import ../../syntax/Identity.btrc;

/* Immutable specialization views consumed by the ordinary declaration and
 * function lowerers.  GenericLowerer never lowers a body and never retains a
 * declaration/function/expression lowerer. */

class GenericClassLoweringPlan {
	public GenInstance instance;
	public Node declaration;

	public GenericClassLoweringPlan(GenInstance instance, Node declaration) {
		self.instance = instance;
		self.declaration = declaration;
	}
}

class GenericMethodLoweringPlan {
	public MethodGenInstance instance;
	public Node owner;
	public Node method;

	public GenericMethodLoweringPlan(MethodGenInstance instance, Node owner, Node method) {
		self.instance = instance;
		self.owner = owner;
		self.method = method;
	}
}

class GenericLowerer {
	private Analyzed analyzed;

	public GenericLowerer(Analyzed analyzed) { self.analyzed = analyzed; }

	/* Canonical lowering views, without mutating analysis/demand order. The
	 * symbols are the same injective identities used for emitted instances. */
	public Vector<GenInstance> classInstances() {
		Map<string, GenInstance> instances = {};
		for instance in self.analyzed.genericInstances { instances.put(instance.mangled, instance); }
		Vector<string> symbols = instances.keys();
		symbols.sort();
		Vector<GenInstance> ordered = [];
		for symbol in symbols { ordered.push(instances.get(symbol)); }
		return ordered;
	}

	public Vector<MethodGenInstance> methodInstances() {
		Map<string, MethodGenInstance> instances = {};
		for instance in self.analyzed.methodGenInstances {
			string symbol = TypeIdentity.mangleMethodInstanceSymbol(instance.classBase, instance.classArgs, instance.methodName, instance.methodArgs);
			instances.put(symbol, instance);
		}
		Vector<string> symbols = instances.keys();
		symbols.sort();
		Vector<MethodGenInstance> ordered = [];
		for symbol in symbols { ordered.push(instances.get(symbol)); }
		return ordered;
	}

	public Vector<GenericClassLoweringPlan> classPlans() {
		Vector<GenericClassLoweringPlan> plans = [];
		for instance in self.classInstances() {
			if (self.analyzed.genericClassTable.has(instance.base)) {
				Node declaration = self.analyzed.genericClassTable.get(instance.base);
				plans.push(GenericClassLoweringPlan(instance, declaration));
			}
		}
		return plans;
	}

	public Vector<GenericMethodLoweringPlan> methodPlans() {
		Vector<GenericMethodLoweringPlan> plans = [];
		for instance in self.methodInstances() {
			Node? owner = null;
			if (self.analyzed.genericClassTable.has(instance.classBase)) {
				owner = self.analyzed.genericClassTable.get(instance.classBase);
			} else if (self.analyzed.classTable.has(instance.classBase)) {
				owner = self.analyzed.classTable.get(instance.classBase);
			}
			if (owner != null) {
				Node concreteOwner = owner;
				Node? method = self.analyzed.genericClassMethod(instance.classBase, instance.methodName);
				if (method == null) {
					method = self.analyzed.classMethod(instance.classBase, instance.methodName);
				}
				if (method != null) {
					plans.push(GenericMethodLoweringPlan(instance, concreteOwner, method));
				}
			}
		}
		return plans;
	}

	/* Only tuple scanning needs substitutions. Reachability and body emission
	 * consume the same plans without allocating these mutable maps. */
	public Map<string, Node> classSubstitutions(GenericClassLoweringPlan plan) {
		Node instanceType = SemanticTypeSystem.primitive(plan.instance.base);
		instanceType.genericArgsStorage = plan.instance.args;
		return SemanticTypeSystem.genericTypeMap(self.analyzed, instanceType);
	}

	public Map<string, Node> methodSubstitutions(GenericMethodLoweringPlan plan) {
		Map<string, Node> substitutions = {};
		int classIndex = 0;
		while (classIndex < plan.owner.genericParams().len && classIndex < plan.instance.classArgs.len) {
			substitutions.put(plan.owner.genericParams().get(classIndex), plan.instance.classArgs.get(classIndex));
			classIndex = classIndex + 1;
		}
		int methodIndex = 0;
		while (methodIndex < plan.method.genericParams().len && methodIndex < plan.instance.methodArgs.len) {
			substitutions.put(plan.method.genericParams().get(methodIndex), plan.instance.methodArgs.get(methodIndex));
			methodIndex = methodIndex + 1;
		}
		return substitutions;
	}
}
