/* Complete typed IR model for lowering, optimization, and emission. */

import Library.Map;
import Library.Strings;
import Library.Vector;

import ../generated/ast/Node.btrc;

class IRCleanupSlot {
	public int site;
	public string name;
	public string cType;
	public string takeFunction;

	public IRCleanupSlot(int site, string name, string cType, string takeFunction) {
		self.site = site;
		self.name = name;
		self.cType = cType;
		self.takeFunction = takeFunction;
	}
}

enum IRKind {
	IRK_NONE = 0,
	/* expressions */
	IRK_LITERAL,
	IRK_VAR,
	IRK_FUNCTION_REF,
	IRK_BINOP,
	IRK_COMMA_EXPR,
	IRK_UNARYOP,
	IRK_CALL,
	IRK_CXX_NEW,
	IRK_OBJECTIVE_C_MESSAGE,
	IRK_OBJECTIVE_C_SELECTOR,
	IRK_OBJECTIVE_C_BLOCK,
	IRK_CAST,
	IRK_TERNARY,
	IRK_INDEX,
	IRK_FIELD_ACCESS,
	IRK_ADDRESS_OF,
	IRK_DEREF,
	IRK_SIZEOF,
	IRK_INITIALIZER_LIST,
	IRK_COMPOUND_LITERAL,
	IRK_DESIGNATION,
	IRK_STMT_EXPR,
	IRK_INVALID_EXPR,
	/* statements */
	IRK_VAR_DECL,
	IRK_ASSIGN,
	IRK_RETURN,
	IRK_EXPR_STMT,
	IRK_IF,
	IRK_WHILE,
	IRK_DO_WHILE,
	IRK_FOR,
	IRK_BREAK,
	IRK_CONTINUE,
	IRK_BLOCK,
	IRK_SWITCH,
	IRK_CASE,
	IRK_OBJECTIVE_C_AUTORELEASE_POOL,
	IRK_OBJECTIVE_C_EXCEPTION_BOUNDARY,
	IRK_CXX_DELETE,
	IRK_CXX_EXCEPTION_BOUNDARY,
	IRK_LINE_MARKER,
};

/* Payload ownership follows the tagged node, never a shared default.
 * Keep the node identity stable for all analysis maps. A concrete payload
 * is constructed once by IRNode and its inherited ARC metadata owns its
 * children; static dispatch does not make payloads virtual IR nodes. */
enum IRPayloadDomain {
	IR_PAYLOAD_NONE = 0,
	IR_PAYLOAD_UNARY,
	IR_PAYLOAD_CONVERSION_AGGREGATE,
	IR_PAYLOAD_PROJECTION_DESIGNATION,
	IR_PAYLOAD_CALL,
	IR_PAYLOAD_DECLARATION,
	IR_PAYLOAD_CONTROL_SEQUENCE,
	IR_PAYLOAD_NATIVE,
	IR_PAYLOAD_SOURCE,
	IR_PAYLOAD_VALUE_FLOW,
};

class IRNodePayload {
	/* Constructor-owned tag; consumers validate through IRNode before casts. */
	public int domain;
}

class IRUnaryPayload extends IRNodePayload {
	public IRNode operand;
	public bool prefix;

	public IRUnaryPayload() { self.domain = IR_PAYLOAD_UNARY; }
}

class IRConversionPayload extends IRNodePayload {
	public string targetType;
	public string bridge;
	public IRNode operand;
	public Vector<string>? fieldNamesStorage;

	public IRConversionPayload() {
		self.domain = IR_PAYLOAD_CONVERSION_AGGREGATE;
		self.targetType = "";
		self.bridge = "";
	}
}

class IRProjectionPayload extends IRNodePayload {
	public IRNode obj;
	public IRNode index;
	public string field;
	public IRNode value;
	public bool arrow;
	public bool bitField;

	public IRProjectionPayload() {
		self.domain = IR_PAYLOAD_PROJECTION_DESIGNATION;
		self.field = "";
	}
}

class IRCallPayload extends IRNodePayload {
	public string callee;
	public IRCleanupSlot cleanupSlot;
	public string helperRef;
	public string realtimeProvenance;
	public bool neverReturns;

	public IRCallPayload() {
		self.domain = IR_PAYLOAD_CALL;
		self.callee = "";
		self.helperRef = "";
		self.realtimeProvenance = "";
	}
}

class IRDeclarationPayload extends IRNodePayload {
	public string cType;
	public IRNode arraySize;
	public IRCleanupSlot cleanupSlot;
	public IRNode init;
	public bool isArrayDecl;
	public bool isVolatile;
	public bool effectiveIsVolatile;
	public bool setjmpInferredVolatile;
	public bool isStatic;
	public bool isExtern;
	public bool isCycleReturnTemp;

	public IRDeclarationPayload() {
		self.domain = IR_PAYLOAD_DECLARATION;
		self.cType = "";
	}
}

class IRControlPayload extends IRNodePayload {
	public IRNode condition;
	public IRNode trueExpr;
	public IRNode falseExpr;
	public IRNode init;
	public IRNode value;
	public IRNode target;
	public IRNode thenBlock;
	public IRNode elseBlock;
	public IRNode body;
	public IRNode update;
	public Vector<IRNode>? stmtsStorage;
	public IRNode result;
	public bool fallsThrough;
	public bool realtimeBounded;

	public IRControlPayload() { self.domain = IR_PAYLOAD_CONTROL_SEQUENCE; }
}

class IRNativePayload extends IRNodePayload {
	public Vector<IRParam> params;
	public string targetType;
	public IRNode obj;
	public IRNode body;
	public IRNode elseBlock;
	public IRNode thenBlock;
	public IRNode value;

	public IRNativePayload() {
		self.domain = IR_PAYLOAD_NATIVE;
		self.targetType = "";
	}
}

class IRSourcePayload extends IRNodePayload {
	public string sourceFile;
	public int sourceLine;

	public IRSourcePayload() {
		self.domain = IR_PAYLOAD_SOURCE;
		self.sourceFile = "";
	}
}

class IRValuePayload extends IRNodePayload {
	public IRNode target;
	public IRNode value;

	public IRValuePayload() { self.domain = IR_PAYLOAD_VALUE_FLOW; }
}

class IRNode {
	/* Stable tagged identity, hot expression fields and cross-kind provenance.
	 * The constructor alone chooses the concrete payload layout. Consumers
	 * must not replace payload or retag a constructed node. */
	public string text;
	public string name;
	public string op;
	public IRNode left;
	public IRNode right;
	public IRNode expr;
	public Vector<IRNode>? argsStorage;
	public string storageRoot;
	public string arrayStorageRoot;
	public IRNodePayload payload;
	public int kind;
	public bool sourceAddress;
	public bool storageRootKnown;
	public bool arrayStorageKnown;
	public bool canFallThrough;

	public IRNode(int kind = IRK_NONE) {
		self.kind = kind;
		self.text = "";
		self.name = "";
		self.op = "";
		self.storageRoot = "";
		self.arrayStorageRoot = "";
		self.canFallThrough = true;
		switch (IRNode.domainOfKind(kind)) {
			case IR_PAYLOAD_UNARY: self.payload = IRUnaryPayload(); break;
			case IR_PAYLOAD_CONVERSION_AGGREGATE: self.payload = IRConversionPayload(); break;
			case IR_PAYLOAD_PROJECTION_DESIGNATION: self.payload = IRProjectionPayload(); break;
			case IR_PAYLOAD_CALL: self.payload = IRCallPayload(); break;
			case IR_PAYLOAD_DECLARATION: self.payload = IRDeclarationPayload(); break;
			case IR_PAYLOAD_CONTROL_SEQUENCE: self.payload = IRControlPayload(); break;
			case IR_PAYLOAD_NATIVE: self.payload = IRNativePayload(); break;
			case IR_PAYLOAD_SOURCE: self.payload = IRSourcePayload(); break;
			case IR_PAYLOAD_VALUE_FLOW: self.payload = IRValuePayload(); break;
			default: break;
		}
	}

	/* A scalar result avoids a managed accessor return on every IR access.
	 * Validate before a family projection; absent fields are read as their
	 * original default by the consumer, never by allocating a payload. */
	public int payloadDomain() {
		int expected = IRNode.domainOfKind(self.kind);
		if (expected == IR_PAYLOAD_NONE) {
			if (self.payload != null) {
				fprintf(stderr, "internal compiler error: payload on an inline IR kind\n");
				exit(1);
			}
		} else if (self.payload == null || self.payload.domain != expected) {
			fprintf(stderr, "internal compiler error: IR kind/payload mismatch\n");
			exit(1);
		}
		return expected;
	}

	public void requirePayload(int expected) {
		if (self.payloadDomain() != expected) {
			fprintf(stderr, "internal compiler error: wrong IR payload domain\n");
			exit(1);
		}
	}

	/* One empty list of each element type answered for every unwritten
	 * field, created on first need. Nothing may mutate it: the readers check
	 * it is still empty each time they answer it. Readers read the field and
	 * the static in place: a local copy cost a retain, a cleanup registration
	 * and its discard per read. */
	class Vector<IRNode>? sharedEmptyNodes = null;
	class Vector<string>? sharedEmptyStrings = null;

	/* `args` for reading: the shared empty while unwritten. */
	public Vector<IRNode> args() {
		if (self.argsStorage != null) { return self.argsStorage; }
		if (IRNode.sharedEmptyNodes == null) { Vector<IRNode> fresh = []; IRNode.sharedEmptyNodes = fresh; return fresh; }
		if ((IRNode.sharedEmptyNodes?.len ?? 0) != 0) { fprintf(stderr, "internal compiler error: IRNode.sharedEmptyNodes is no longer empty; a list answered by a lazy field reader was mutated instead of written through its Mut()\n"); exit(1); }
		return IRNode.sharedEmptyNodes;
	}

	/* `args` for mutation: allocated on first write. */
	public Vector<IRNode> argsMut() {
		if (self.argsStorage != null) { return self.argsStorage; }
		Vector<IRNode> fresh = [];
		self.argsStorage = fresh;
		return fresh;
	}

	/* An absent statement or designator list retains the original empty read
	 * result without adding a payload or a node-to-shared-empty edge. */
	public Vector<IRNode> stmts() {
		if (self.payloadDomain() == IR_PAYLOAD_CONTROL_SEQUENCE) {
			var storage = ((IRControlPayload)self.payload).stmtsStorage;
			if (storage != null) { return storage; }
		}
		if (IRNode.sharedEmptyNodes == null) { Vector<IRNode> fresh = []; IRNode.sharedEmptyNodes = fresh; return fresh; }
		if ((IRNode.sharedEmptyNodes?.len ?? 0) != 0) { fprintf(stderr, "internal compiler error: IRNode.sharedEmptyNodes is no longer empty; a list answered by a lazy field reader was mutated instead of written through its Mut()\n"); exit(1); }
		return IRNode.sharedEmptyNodes;
	}

	public Vector<IRNode> stmtsMut() {
		self.requirePayload(IR_PAYLOAD_CONTROL_SEQUENCE);
		var storage = ((IRControlPayload)self.payload).stmtsStorage;
		if (storage != null) { return storage; }
		Vector<IRNode> fresh = [];
		((IRControlPayload)self.payload).stmtsStorage = fresh;
		return fresh;
	}

	public Vector<string> fieldNames() {
		if (self.payloadDomain() == IR_PAYLOAD_CONVERSION_AGGREGATE) {
			var storage = ((IRConversionPayload)self.payload).fieldNamesStorage;
			if (storage != null) { return storage; }
		}
		if (IRNode.sharedEmptyStrings == null) { Vector<string> fresh = []; IRNode.sharedEmptyStrings = fresh; return fresh; }
		if ((IRNode.sharedEmptyStrings?.len ?? 0) != 0) { fprintf(stderr, "internal compiler error: IRNode.sharedEmptyStrings is no longer empty; a list answered by a lazy field reader was mutated instead of written through its Mut()\n"); exit(1); }
		return IRNode.sharedEmptyStrings;
	}

	class string directStorageRoot(IRNode? node) {
		if (node == null) { return ""; }
		if (node.kind == IRK_VAR) { return node.name; }
		if (node.kind == IRK_FIELD_ACCESS) {
			node.requirePayload(IR_PAYLOAD_PROJECTION_DESIGNATION);
			if (((IRProjectionPayload)node.payload).arrow) { return ""; }
			return IRNode.directStorageRoot(((IRProjectionPayload)node.payload).obj);
		}
		if ((node.kind == IRK_INDEX || node.kind == IRK_DEREF) && node.storageRootKnown) {
			return node.storageRoot;
		}
		if (node.kind == IRK_INDEX) {
			node.requirePayload(IR_PAYLOAD_PROJECTION_DESIGNATION);
			return IRNode.directStorageRoot(((IRProjectionPayload)node.payload).obj);
		}
		return "";
	}

	/* The original automatic root an array value carries; Python's
	 * IRExpr.array_storage_root_value. */
	class string arrayStorageRootValue(IRNode node) {
		if ((node.kind == IRK_VAR || node.kind == IRK_FIELD_ACCESS) && node.arrayStorageKnown) { return node.arrayStorageRoot; }
		return IRNode.directStorageRoot(node);
	}

	class IRNode recordArrayProjection(IRNode field, bool isArray) {
		if (isArray) {
			field.arrayStorageKnown = true;
			field.arrayStorageRoot = IRNode.directStorageRoot(field);
		}
		return field;
	}

	class IRNode recordArrayValue(IRNode value, bool isArray) {
		if (isArray) {
			value.arrayStorageKnown = true;
			value.arrayStorageRoot = IRNode.directStorageRoot(value);
		}
		return value;
	}

	/* The domain mapping is independent of field occupancy. Rare forms stay
	 * supported even when absent from the current product census. */
	class int domainOfKind(int kind) {
		switch (kind) {
			case IRK_UNARYOP: return IR_PAYLOAD_UNARY;
			case IRK_CAST: case IRK_SIZEOF: case IRK_COMPOUND_LITERAL: return IR_PAYLOAD_CONVERSION_AGGREGATE;
			case IRK_INDEX: case IRK_FIELD_ACCESS: case IRK_DESIGNATION: return IR_PAYLOAD_PROJECTION_DESIGNATION;
			case IRK_CALL: return IR_PAYLOAD_CALL;
			case IRK_VAR_DECL: return IR_PAYLOAD_DECLARATION;
			case IRK_TERNARY: case IRK_IF: case IRK_WHILE: case IRK_DO_WHILE: case IRK_FOR: case IRK_BLOCK: case IRK_SWITCH: case IRK_CASE: case IRK_STMT_EXPR: return IR_PAYLOAD_CONTROL_SEQUENCE;
			case IRK_OBJECTIVE_C_MESSAGE: case IRK_OBJECTIVE_C_BLOCK: case IRK_OBJECTIVE_C_AUTORELEASE_POOL: case IRK_OBJECTIVE_C_EXCEPTION_BOUNDARY: case IRK_CXX_NEW: case IRK_CXX_DELETE: case IRK_CXX_EXCEPTION_BOUNDARY: return IR_PAYLOAD_NATIVE;
			case IRK_LINE_MARKER: return IR_PAYLOAD_SOURCE;
			case IRK_ASSIGN: case IRK_RETURN: return IR_PAYLOAD_VALUE_FLOW;
			case IRK_NONE: case IRK_LITERAL: case IRK_VAR: case IRK_FUNCTION_REF: case IRK_BINOP: case IRK_COMMA_EXPR: case IRK_ADDRESS_OF: case IRK_DEREF: case IRK_EXPR_STMT: case IRK_INITIALIZER_LIST: case IRK_INVALID_EXPR: case IRK_OBJECTIVE_C_SELECTOR: case IRK_BREAK: case IRK_CONTINUE: return IR_PAYLOAD_NONE;
			default: fprintf(stderr, "internal compiler error: unsupported IR kind for payload\n");
			exit(1);
		}
		return IR_PAYLOAD_NONE;
	}

	/* --- Typed constructors return fresh nodes and never alias. --- */

	class IRNode literal(string text) {
		IRNode n = IRNode(IRK_LITERAL);
		n.text = text;
		return n;
	}

	class IRNode initializerList(Vector<IRNode> elements) {
		IRNode n = IRNode(IRK_INITIALIZER_LIST);
		n.argsStorage = elements;
		return n;
	}

	/* A typed C compound literal with named field initializers. `field_names` and
     * `args` are parallel vectors so every initializer remains a traversable IR
     * expression (mirrors Python IRCompoundLiteral.fields). A field name ""
     * is positional (array and scalar literals); its value may be a
     * designation. */
	class IRNode compoundLiteral(string cType, Vector<string> fieldNames, Vector<IRNode> values) {
		IRNode n = IRNode(IRK_COMPOUND_LITERAL);
		((IRConversionPayload)n.payload).targetType = cType;
		((IRConversionPayload)n.payload).fieldNamesStorage = fieldNames;
		n.argsStorage = values;
		return n;
	}

	/* One designated initializer, `.field = value` or `[index] = value`
	 * (mirrors IRDesignation). Exactly one of `field` and `index` (a folded
	 * literal) is set; it appears only as an initializer-list element or as a
	 * positional compound-literal entry's value. */
	class IRNode designation(string field, IRNode? index, IRNode value) {
		IRNode n = IRNode(IRK_DESIGNATION);
		((IRProjectionPayload)n.payload).field = field;
		if (index != null) { ((IRProjectionPayload)n.payload).index = index; }
		((IRProjectionPayload)n.payload).value = value;
		return n;
	}

	class IRNode variable(string name) {
		IRNode n = IRNode(IRK_VAR);
		n.name = name;
		return n;
	}

	class IRNode functionReference(string name) {
		IRNode n = IRNode(IRK_FUNCTION_REF);
		n.name = name;
		return n;
	}

	class IRNode binary(IRNode left, string op, IRNode right) {
		IRNode n = IRNode(IRK_BINOP);
		n.left = left;
		n.op = op;
		n.right = right;
		return n;
	}

	class IRNode unary(string op, IRNode operand, bool prefix) {
		IRNode n = IRNode(IRK_UNARYOP);
		n.op = op;
		((IRUnaryPayload)n.payload).operand = operand;
		((IRUnaryPayload)n.payload).prefix = prefix;
		return n;
	}

	class IRNode call(string callee, Vector<IRNode> args) {
		IRNode n = IRNode(IRK_CALL);
		((IRCallPayload)n.payload).callee = callee;
		n.argsStorage = args;
		return n;
	}

	class IRNode indirectCall(IRNode callee, Vector<IRNode> args) {
		IRNode n = IRNode(IRK_CALL);
		n.expr = callee;
		n.argsStorage = args;
		return n;
	}

	class IRNode objectiveCMessage(IRNode receiver, string selector, Vector<IRNode> args) {
		var node = IRNode(IRK_OBJECTIVE_C_MESSAGE);
		((IRNativePayload)node.payload).obj = receiver;
		node.name = selector;
		node.argsStorage = args;
		return node;
	}

	class IRNode objectiveCSelector(string selector) {
		var node = IRNode(IRK_OBJECTIVE_C_SELECTOR);
		node.name = selector;
		return node;
	}

	class IRNode objectiveCAutoreleasePool(IRNode body) {
		var node = IRNode(IRK_OBJECTIVE_C_AUTORELEASE_POOL);
		((IRNativePayload)node.payload).body = body;
		return node;
	}

	class IRNode objectiveCExceptionBoundary(IRNode body, IRNode failure) {
		var node = IRNode(IRK_OBJECTIVE_C_EXCEPTION_BOUNDARY);
		((IRNativePayload)node.payload).body = body;
		((IRNativePayload)node.payload).elseBlock = failure;
		return node;
	}

	class IRNode cxxNew(string valueType, Vector<IRNode> args) {
		var node = IRNode(IRK_CXX_NEW);
		((IRNativePayload)node.payload).targetType = valueType; node.argsStorage = args; return node;
	}

	class IRNode cxxDelete(IRNode value) {
		var node = IRNode(IRK_CXX_DELETE); ((IRNativePayload)node.payload).value = value; return node;
	}

	class IRNode cxxExceptionBoundary(IRNode body, IRNode failure, IRNode? allocationFailure = null) {
		var node = IRNode(IRK_CXX_EXCEPTION_BOUNDARY);
		((IRNativePayload)node.payload).body = body; ((IRNativePayload)node.payload).elseBlock = failure;
		/* A fresh node's thenBlock is already null when no allocation-failure arm is given. */
		if (allocationFailure != null) { ((IRNativePayload)node.payload).thenBlock = allocationFailure; }
		return node;
	}

	class IRNode cast(string targetType, IRNode expr, string bridge = "") {
		IRNode n = IRNode(IRK_CAST);
		((IRConversionPayload)n.payload).bridge = bridge;
		((IRConversionPayload)n.payload).targetType = targetType;
		n.expr = expr;
		return n;
	}

	class IRNode ternary(IRNode condition, IRNode trueExpr, IRNode falseExpr) {
		IRNode n = IRNode(IRK_TERNARY);
		((IRControlPayload)n.payload).condition = condition;
		((IRControlPayload)n.payload).trueExpr = trueExpr;
		((IRControlPayload)n.payload).falseExpr = falseExpr;
		return n;
	}

	class IRNode indexAccess(IRNode obj, IRNode index) {
		IRNode n = IRNode(IRK_INDEX);
		((IRProjectionPayload)n.payload).obj = obj;
		((IRProjectionPayload)n.payload).index = index;
		return n;
	}

	class IRNode fieldAccess(IRNode obj, string field, bool arrow) {
		IRNode n = IRNode(IRK_FIELD_ACCESS);
		((IRProjectionPayload)n.payload).obj = obj;
		((IRProjectionPayload)n.payload).field = field;
		((IRProjectionPayload)n.payload).arrow = arrow;
		return n;
	}

	class IRNode addressOf(IRNode expr) {
		IRNode n = IRNode(IRK_ADDRESS_OF);
		n.expr = expr;
		return n;
	}

	class IRNode dereference(IRNode expr) {
		IRNode n = IRNode(IRK_DEREF);
		n.expr = expr;
		return n;
	}

	class IRNode sizeofType(string operandType) {
		IRNode n = IRNode(IRK_SIZEOF);
		((IRConversionPayload)n.payload).targetType = operandType;
		return n;
	}

	class IRNode sizeofExpression(IRNode operand) {
		IRNode n = IRNode(IRK_SIZEOF);
		((IRConversionPayload)n.payload).operand = operand;
		return n;
	}

	class IRNode variableDeclaration(string cType, string name, IRNode? init) {
		IRNode n = IRNode(IRK_VAR_DECL);
		((IRDeclarationPayload)n.payload).cType = cType;
		n.name = name;
		if (init != null) { ((IRDeclarationPayload)n.payload).init = init; }
		return n;
	}

	class IRNode arrayDeclaration(string cType, string name, IRNode? arraySize, IRNode? init) {
		IRNode n = IRNode.variableDeclaration(cType, name, init);
		((IRDeclarationPayload)n.payload).isArrayDecl = true;
		if (arraySize != null) { ((IRDeclarationPayload)n.payload).arraySize = arraySize; }
		return n;
	}

	class IRNode assignment(IRNode target, IRNode value) {
		IRNode n = IRNode(IRK_ASSIGN);
		((IRValuePayload)n.payload).target = target;
		((IRValuePayload)n.payload).value = value;
		return n;
	}

	class IRNode returnStatement(IRNode? value) {
		IRNode n = IRNode(IRK_RETURN);
		if (value != null) { ((IRValuePayload)n.payload).value = value; }
		return n;
	}

	/* --debug: the statements that follow map back to file:line. */
	class IRNode lineMarker(string file, int line) {
		IRNode n = IRNode(IRK_LINE_MARKER);
		((IRSourcePayload)n.payload).sourceFile = file;
		((IRSourcePayload)n.payload).sourceLine = line;
		return n;
	}

	class IRNode expressionStatement(IRNode expr) {
		IRNode n = IRNode(IRK_EXPR_STMT);
		n.expr = expr;
		return n;
	}

	class IRNode ifStatement(IRNode condition, IRNode thenBlock, IRNode? elseBlock) {
		IRNode n = IRNode(IRK_IF);
		((IRControlPayload)n.payload).condition = condition;
		((IRControlPayload)n.payload).thenBlock = thenBlock;
		/* Guard the field store: btrcpy's ARC emits `else_block->__rc++` on the
         * assignment, which null-derefs when no else exists. Leaving the field at
         * its constructor default (null) skips that, matching the parser's idiom. */
		if (elseBlock != null) { ((IRControlPayload)n.payload).elseBlock = elseBlock; }
		return n;
	}

	class IRNode whileStatement(IRNode condition, IRNode body) {
		IRNode n = IRNode(IRK_WHILE);
		((IRControlPayload)n.payload).condition = condition;
		((IRControlPayload)n.payload).body = body;
		return n;
	}

	class IRNode doWhileStatement(IRNode body, IRNode condition) {
		IRNode n = IRNode(IRK_DO_WHILE);
		((IRControlPayload)n.payload).body = body;
		((IRControlPayload)n.payload).condition = condition;
		return n;
	}

	class IRNode forStatement(IRNode? init, IRNode condition, IRNode? update, IRNode body) {
		IRNode n = IRNode(IRK_FOR);
		if (init != null) { ((IRControlPayload)n.payload).init = init; }
		((IRControlPayload)n.payload).condition = condition;
		if (update != null) { ((IRControlPayload)n.payload).update = update; }
		((IRControlPayload)n.payload).body = body;
		return n;
	}

	class IRNode breakStatement() {
		IRNode n = IRNode(IRK_BREAK);
		return n;
	}

	class IRNode continueStatement() {
		IRNode n = IRNode(IRK_CONTINUE);
		return n;
	}

	class IRNode block(Vector<IRNode> stmts) {
		IRNode n = IRNode(IRK_BLOCK);
		((IRControlPayload)n.payload).stmtsStorage = stmts;
		return n;
	}

	/* IRSwitch: `value` is the switch expression; `args` holds the IRCase nodes
     * (mirrors IRSwitch.value/cases). */
	class IRNode switchStatement(IRNode value, Vector<IRNode> cases) {
		IRNode n = IRNode(IRK_SWITCH);
		((IRControlPayload)n.payload).value = value;
		n.argsStorage = cases;
		return n;
	}

	/* IRCase: one switch case. `value` is the case label expression (null = the
     * `default:` clause); `stmts` is the case body (mirrors IRCase.value/body). */
	class IRNode caseClause(IRNode? value, Vector<IRNode> body, bool fallsThrough) {
		IRNode n = IRNode(IRK_CASE);
		/* Guard the field store: btrcpy's ARC emits `value->__rc++` on the
         * assignment, which null-derefs for a `default:` clause (value == null).
         * Leaving the field at its constructor default (null) skips that. */
		if (value != null) { ((IRControlPayload)n.payload).value = value; }
		((IRControlPayload)n.payload).stmtsStorage = body;
		((IRControlPayload)n.payload).fallsThrough = fallsThrough;
		return n;
	}

	/* IRStmtExpr: setup statements hoisted before the enclosing statement, then the
     * `result` expression is used in place. Mirrors IRStmtExpr (standard C11; no GCC
     * statement expressions). */
	class IRNode statementExpression(Vector<IRNode> stmts, IRNode result) {
		IRNode n = IRNode(IRK_STMT_EXPR);
		((IRControlPayload)n.payload).stmtsStorage = stmts;
		((IRControlPayload)n.payload).result = result;
		return n;
	}

	/* A standard-C comma expression. Every child is evaluated left-to-right and
     * the final child is the value of the whole expression. */
	class IRNode commaExpression(Vector<IRNode> expressions) {
		IRNode n = IRNode(IRK_COMMA_EXPR);
		n.argsStorage = expressions;
		return n;
	}

	/* A deferred typed-operator diagnostic. Generic instances initially contain
     * every method; function DCE may remove an unreachable invalid specialization.
     * If the expression survives, the emitter reports its diagnostic and stops. */
	class IRNode invalidExpression(string message) {
		IRNode n = IRNode(IRK_INVALID_EXPR);
		n.text = message;
		return n;
	}
}

/* --- IR top-level entities (functions + module) --- */

class IRParam {
	public string cType;
	public string name;
	public bool isVolatile;
	public bool effectiveIsVolatile;
	public bool setjmpInferredVolatile;
	public IRParam(string cType, string name) {
		self.cType = cType;
		self.name = name;
		self.isVolatile = false;
		self.effectiveIsVolatile = false;
		self.setjmpInferredVolatile = false;
	}
}

/* A single field within a struct or union definition (mirrors
 * IRStructField). At most one of `arraySize`, `isUnsizedArray` (a flexible
 * array member, `T name[];`), `bitWidth` (a folded bit-field width,
 * `T name : w;`) and `recordFields` (an anonymous member: an unnamed field
 * whose `cType` is the keyword `struct` or `union` and whose untagged
 * record's members are emitted inline) is set; CEmitter checks the shape.
 * The members sit on the field rather than in an IRStructDef, so a record
 * and its fields never retain each other. */
class IRStructField {
	public string cType;
	public string name;
	public IRNode? arraySize;    /* optional array bound */
	public Vector<IRStructField>? recordFields;
	public int bitWidth;         /* -1 when the field is not a bit-field */
	public bool isVolatile;
	public bool effectiveIsVolatile;
	public bool isUnsizedArray;
	public IRStructField(string cType, string name) {
		self.cType = cType;
		self.name = name;
		self.arraySize = null;
		self.bitWidth = -1;
		self.isVolatile = false;
		self.effectiveIsVolatile = false;
		self.isUnsizedArray = false;
	}
}

/* A struct or union definition (mirrors IRStructDef). */
class IRStructDef {
	public string name;
	public Vector<IRStructField> fields;
	/* Zero means natural alignment; otherwise one supported pragma-pack
     * alignment that must wrap this exact declaration during emission. */
	public int packAlignment;
	public bool isUnion;
	public IRStructDef() {
		self.name = "";
		self.fields = [];
		self.packAlignment = 0;
		self.isUnion = false;
	}
}

class IRObjectiveCMethod {
	public string selector;
	public string returnType;
	public Vector<IRParam> params;
	public IRNode body;
	public bool isClassMethod;
	public IRObjectiveCMethod(string selector, string returnType, Vector<IRParam> params, IRNode body) {
		self.selector = selector;
		self.returnType = returnType;
		self.params = params;
		self.body = body;
		self.isClassMethod = false;
	}
}

class IRObjectiveCClass {
	public string name;
	public string superclass;
	public Vector<IRStructField> fields;
	public Vector<IRObjectiveCMethod> methods;
	public Vector<string> protocols;
	public IRObjectiveCClass(string name, string superclass) {
		self.name = name;
		self.superclass = superclass;
		self.fields = [];
		self.methods = [];
		self.protocols = [];
	}
}

class IRTypedefDef {
	public string targetType;
	public string name;
	public bool isVolatile;
	public IRTypedefDef(string targetType, string name) {
		self.targetType = targetType;
		self.name = name;
		self.isVolatile = false;
	}
}

class IRTaggedUnionVariant {
	public string name;
	public Vector<IRStructField> fields;
	public IRTaggedUnionVariant(string name) {
		self.name = name;
		self.fields = [];
	}
}

class IRTaggedUnionDef {
	public string name;
	public string tagType;
	public Vector<IRTaggedUnionVariant> variants;
	public IRTaggedUnionDef(string name, string tagType) {
		self.name = name;
		self.tagType = tagType;
		self.variants = [];
	}
}

class IRGlobalDecl {
	public string cType;
	public string name;
	public IRNode? init;
	public IRNode arraySize;     /* optional; left null (zeroed storage) until set */
	public bool isUnsizedArray;
	public bool isStatic;
	public bool isExtern;
	public bool isVolatile;
	public bool effectiveIsVolatile;
	public IRGlobalDecl(string cType, string name) {
		self.cType = cType;
		self.name = name;
		self.init = null;
		self.isUnsizedArray = false;
		self.isStatic = true;
		self.isExtern = false;
		self.isVolatile = false;
		self.effectiveIsVolatile = false;
	}
}

class IRFunction {
	public string name;
	public string returnType;
	public Vector<IRParam> params;
	public IRNode body;      /* IRBlock, or null (zeroed storage) for a forward-only decl */
	public bool isStatic;
	public bool archiveExport;
	public bool isRealtime;
	public bool cLinkage = false;
	public string sourceFile = "";  /* the .btrc module this came from; "" for synthesized code */

	public IRFunction() {
		self.name = "";
		self.returnType = "void";
		self.params = [];
		self.isStatic = false;
		self.archiveExport = false;
		self.isRealtime = false;
	}
}

/* Typed translation-unit declarations for the self-hosted compiler.
 *
 * Top-level ordering and declaration categories are IR data.  Producers fill
 * these nodes; optimizer passes inspect their fields; the C emitter only
 * formats them.  In particular, no declaration category is inferred by
 * parsing pre-rendered C text. */

enum IRPreprocessorKind {
	IR_PREPROCESSOR_INCLUDE = 1,
	IR_PREPROCESSOR_MACRO = 2,
	IR_PREPROCESSOR_UNDEF = 3,
};

/* A system <header> or local "header" include, a structured single-line
 * macro, or an #undef of a source macro.  A fat tagged node preserves source order in one homogeneous Vector.
 * `function_like` distinguishes F from F(), including an empty parameter list. */
class IRPreprocessorDecl {
	public int kind;
	public string header;
	public bool isSystem;
	public string name;
	public bool functionLike;
	public Vector<string> params;
	public string replacement;

	public IRPreprocessorDecl() {
		self.kind = 0;
		self.header = "";
		self.isSystem = true;
		self.name = "";
		self.functionLike = false;
		self.params = [];
		self.replacement = "";
	}

	class IRPreprocessorDecl include(string header, bool isSystem) {
		IRPreprocessorDecl declaration = IRPreprocessorDecl();
		declaration.kind = IR_PREPROCESSOR_INCLUDE;
		declaration.header = header;
		declaration.isSystem = isSystem;
		return declaration;
	}

	class IRPreprocessorDecl macro(string name, bool functionLike, Vector<string> params, string replacement) {
		IRPreprocessorDecl declaration = IRPreprocessorDecl();
		declaration.kind = IR_PREPROCESSOR_MACRO;
		declaration.name = name;
		declaration.functionLike = functionLike;
		declaration.params = params;
		declaration.replacement = replacement;
		return declaration;
	}

	/* A source `#undef NAME`, emitted in hoisted source order. */
	class IRPreprocessorDecl undef(string name) {
		IRPreprocessorDecl declaration = IRPreprocessorDecl();
		declaration.kind = IR_PREPROCESSOR_UNDEF;
		declaration.name = name;
		return declaration;
	}
}

class IRStructForward {
	public string name;
	public bool isUnion;
	public IRStructForward(string name) {
		self.name = name;
		self.isUnion = false;
	}
}

class IRFunctionPointerTypedef {
	public string name;
	public string returnType;
	public Vector<string> paramTypes;
	public IRFunctionPointerTypedef(string name, string returnType) {
		self.name = name;
		self.returnType = returnType;
		self.paramTypes = [];
	}
}

class IRFunctionDecl {
	public string name;
	public string returnType;
	public Vector<IRParam> params;
	public bool isStatic;
	public bool cLinkage = false;
	public IRFunctionDecl(string name, string returnType, bool isStatic) {
		self.name = name;
		self.returnType = returnType;
		self.params = [];
		self.isStatic = isStatic;
	}
}

class IREnumValue {
	public string name;
	public IRNode? value;     /* explicit `= value`, or null for an implicit member */
	public IREnumValue(string name, IRNode? value) {
		self.name = name;
		self.value = value;
	}
}

class IREnumDef {
	public string name;
	public Vector<IREnumValue> values;
	public IREnumDef(string name) {
		self.name = name;
		self.values = [];
	}
}

/* GPU translation-unit declarations are IR schema. The GPU pipeline builds
 * these values; optimizers and emitters consume them without depending on the
 * pipeline implementation. */
class IRGpuBuffer {
	public string name;
	public string elemType;
	public int binding;

	public IRGpuBuffer(string name, string elemType, int binding) {
		self.name = name;
		self.elemType = elemType;
		self.binding = binding;
	}
}

class IRGpuUniform {
	public string name;
	public string storageType;

	public IRGpuUniform(string name, string storageType) {
		self.name = name;
		self.storageType = storageType;
	}
}

class IRGpuKernel {
	public string name;
	public string wgslSource;
	public int workgroupSize;
	public Vector<IRGpuBuffer> paramBuffers;
	public IRGpuBuffer? outputBuffer;
	public Vector<IRGpuUniform> uniformParams;
	public Node declaration;

	public IRGpuKernel(string name, Node declaration) {
		self.name = name;
		self.wgslSource = "";
		self.workgroupSize = 64;
		self.paramBuffers = [];
		self.uniformParams = [];
		self.declaration = declaration;
	}
}

/* Deterministic temporary-name state shared by every transformation of one
 * module.  Lowering and later IR normalization both allocate from this owner,
 * so stage boundaries never exchange a lowering context or guess at names. */
class IRTemporaryNames {
	private int nextIdentity;
	/* Every name `fresh` returned; the optimizer renumbers them per function. */
	public Map<string, bool> generated = {};

	public IRTemporaryNames() { self.nextIdentity = 0; }

	public string fresh(string prefix) {
		self.nextIdentity = self.nextIdentity + 1;
		string name = prefix + "_" + Strings.fromInt(self.nextIdentity);
		self.generated.put(name, true);
		return name;
	}
}

class IRModule {
	public string language;
	/* --debug: emit #line directives; the generated file's own path for resets. */
	public bool debug = false;
	public string debugCfile = "";
	public Map<string, IRModule> nativeUnits;
	public Vector<IRPreprocessorDecl> preprocessorDecls;
	public Vector<IREnumDef> enumDefs;
	public Vector<IRStructForward> structForwards;
	public Vector<IRFunctionPointerTypedef> functionPointerTypedefs;
	public Vector<IRFunctionDecl> functionDecls;
	public Vector<IRTypedefDef> typedefDefs;
	public Vector<IRTaggedUnionDef> taggedUnionDefs;
	public Vector<IRStructDef> structDefs;
	public Vector<IRGlobalDecl> globalDecls;
	public Vector<IRObjectiveCClass> objectiveCClasses;
	public Vector<IRFunction> functions;
	public Vector<IRGpuKernel> gpuKernels;
	public Map<string, bool> realtimeSafeExternals;
	public Map<string, string> realtimeIntrinsicTargets;
	public IRTemporaryNames temporaryNames;
	/* Runtime helper bodies remain registry-owned C source at the deliberate
     * runtime seam. They are never parsed to recover declaration structure. */
	public Vector<string> helpers;

	public IRModule() {
		self.language = "c";
		self.nativeUnits = {};
		self.preprocessorDecls = [];
		self.enumDefs = [];
		self.structForwards = [];
		self.functionPointerTypedefs = [];
		self.functionDecls = [];
		self.typedefDefs = [];
		self.taggedUnionDefs = [];
		self.structDefs = [];
		self.globalDecls = [];
		self.objectiveCClasses = [];
		self.functions = [];
		self.gpuKernels = [];
		self.realtimeSafeExternals = {};
		self.realtimeIntrinsicTargets = {};
		self.temporaryNames = IRTemporaryNames();
		self.helpers = [];
	}
}

/* Serializes one complete structured IR module without consulting a backend
 * (mirrors IRCanonicalRenderer in src/compiler/python/ir/nodes.py). The two
 * compilers' IR models differ, so the formats differ too; each is
 * deterministic and names every IR field that differs from a fresh node's,
 * so two dumps from one compiler are equal exactly when the IR is. Left out:
 * the temporary-name counter and a GPU kernel's source AST declaration. */
class IRCanonicalRenderer {
	private Vector<string> lines = [];

	public string render(IRModule module) {
		self.lines = ["$format btrcc-ir-v1"];
		self.module(module, 0);
		return Strings.join(self.lines, "\n") + "\n";
	}

	private void line(int depth, string text) { self.lines.push("  ".repeat(depth) + text); }

	private string quoted(string value) {
		Vector<string> pieces = ["\""];
		int start = 0;
		for (int index = 0; index < value.length(); index++) {
			char letter = value[index];
			string escape = "";
			if (letter == '\\') { escape = "\\\\"; }
			else if (letter == '"') { escape = "\\\""; }
			else if (letter == '\n') { escape = "\\n"; }
			else if (letter == '\r') { escape = "\\r"; }
			else if (letter == '\t') { escape = "\\t"; }
			if (!escape.isEmpty()) {
				pieces.push(value.substring(start, index - start));
				pieces.push(escape);
				start = index + 1;
			}
		}
		pieces.push(value.substring(start, value.length() - start));
		pieces.push("\"");
		return Strings.join(pieces, "");
	}

	private string text(string name, string value) { return value.isEmpty() ? "" : f" {name}={self.quoted(value)}"; }

	private string flag(string name, bool value) { return value ? f" {name}" : ""; }

	private void module(IRModule module, int depth) {
		self.line(depth, f"module language={self.quoted(module.language)}{self.flag("debug", module.debug)}{self.text("debugCfile", module.debugCfile)}");
		for declaration in module.preprocessorDecls {
			self.line(depth + 1, f"preprocessor kind={declaration.kind}{self.text("header", declaration.header)}{self.flag("system", declaration.isSystem)}{self.text("name", declaration.name)}{self.flag("functionLike", declaration.functionLike)}{self.text("replacement", declaration.replacement)}");
			self.strings(depth + 2, "param", declaration.params);
		}
		for definition in module.enumDefs {
			self.line(depth + 1, f"enum name={self.quoted(definition.name)}");
			for value in definition.values {
				self.line(depth + 2, f"value name={self.quoted(value.name)}");
				self.child(depth + 3, "value", value.value);
			}
		}
		for forward in module.structForwards { self.line(depth + 1, f"structForward name={self.quoted(forward.name)}{self.flag("union", forward.isUnion)}"); }
		for pointer in module.functionPointerTypedefs {
			self.line(depth + 1, f"functionPointerTypedef name={self.quoted(pointer.name)} returnType={self.quoted(pointer.returnType)}");
			self.strings(depth + 2, "paramType", pointer.paramTypes);
		}
		for declaration in module.functionDecls {
			self.line(depth + 1, f"functionDecl name={self.quoted(declaration.name)} returnType={self.quoted(declaration.returnType)}{self.flag("static", declaration.isStatic)}{self.flag("cLinkage", declaration.cLinkage)}");
			self.params(depth + 2, declaration.params);
		}
		for typedefinition in module.typedefDefs {
			self.line(depth + 1, f"typedef name={self.quoted(typedefinition.name)} targetType={self.quoted(typedefinition.targetType)}{self.flag("volatile", typedefinition.isVolatile)}");
		}
		for tagged in module.taggedUnionDefs {
			self.line(depth + 1, f"taggedUnion name={self.quoted(tagged.name)} tagType={self.quoted(tagged.tagType)}");
			for variant in tagged.variants {
				self.line(depth + 2, f"variant name={self.quoted(variant.name)}");
				self.fields(depth + 3, variant.fields);
			}
		}
		for structure in module.structDefs { self.structure(depth + 1, structure); }
		for global in module.globalDecls {
			self.line(depth + 1, f"global name={self.quoted(global.name)} cType={self.quoted(global.cType)}{self.flag("unsizedArray", global.isUnsizedArray)}{self.flag("static", global.isStatic)}{self.flag("extern", global.isExtern)}{self.flag("volatile", global.isVolatile)}{self.flag("effectiveVolatile", global.effectiveIsVolatile)}");
			self.child(depth + 2, "init", global.init);
			self.child(depth + 2, "arraySize", global.arraySize);
		}
		for objective in module.objectiveCClasses {
			self.line(depth + 1, f"objectiveCClass name={self.quoted(objective.name)} superclass={self.quoted(objective.superclass)}");
			self.strings(depth + 2, "protocol", objective.protocols);
			self.fields(depth + 2, objective.fields);
			for method in objective.methods {
				self.line(depth + 2, f"method selector={self.quoted(method.selector)} returnType={self.quoted(method.returnType)}{self.flag("classMethod", method.isClassMethod)}");
				self.params(depth + 3, method.params);
				self.child(depth + 3, "body", method.body);
			}
		}
		for owner in module.functions {
			self.line(depth + 1, f"function name={self.quoted(owner.name)} returnType={self.quoted(owner.returnType)}{self.flag("static", owner.isStatic)}{self.flag("archiveExport", owner.archiveExport)}{self.flag("realtime", owner.isRealtime)}{self.flag("cLinkage", owner.cLinkage)}{self.text("sourceFile", owner.sourceFile)}");
			self.params(depth + 2, owner.params);
			self.child(depth + 2, "body", owner.body);
		}
		for kernel in module.gpuKernels {
			IRGpuBuffer? output = kernel.outputBuffer;
			string outputText = output == null ? "" : f" output={self.quoted(output.name)}:{self.quoted(output.elemType)}:{output.binding}";
			self.line(depth + 1, f"gpuKernel name={self.quoted(kernel.name)} workgroupSize={kernel.workgroupSize}{outputText} wgsl={self.quoted(kernel.wgslSource)}");
			for buffer in kernel.paramBuffers { self.line(depth + 2, f"buffer name={self.quoted(buffer.name)} elemType={self.quoted(buffer.elemType)} binding={buffer.binding}"); }
			for uniform in kernel.uniformParams { self.line(depth + 2, f"uniform name={self.quoted(uniform.name)} storageType={self.quoted(uniform.storageType)}"); }
		}
		for name in module.realtimeSafeExternals.keys().sorted() {
			self.line(depth + 1, f"realtimeSafeExternal name={self.quoted(name)} value={module.realtimeSafeExternals.get(name)}");
		}
		for name in module.realtimeIntrinsicTargets.keys().sorted() {
			self.line(depth + 1, f"realtimeIntrinsicTarget name={self.quoted(name)} target={self.quoted(module.realtimeIntrinsicTargets.get(name))}");
		}
		for helper in module.helpers { self.line(depth + 1, f"helper {self.quoted(helper)}"); }
		for name in module.nativeUnits.keys().sorted() {
			self.line(depth + 1, f"nativeUnit name={self.quoted(name)}");
			self.module(module.nativeUnits.get(name), depth + 2);
		}
	}

	/* One line per element, so no separator can make two lists render alike. */
	private void strings(int depth, string role, Vector<string> values) {
		for value in values { self.line(depth, f"{role} {self.quoted(value)}"); }
	}

	private void params(int depth, Vector<IRParam>? params) {
		if (params == null) { return; }
		for param in params {
			self.line(depth, f"param cType={self.quoted(param.cType)} name={self.quoted(param.name)}{self.flag("volatile", param.isVolatile)}{self.flag("effectiveVolatile", param.effectiveIsVolatile)}{self.flag("setjmpInferredVolatile", param.setjmpInferredVolatile)}");
		}
	}

	private void structure(int depth, IRStructDef structure) {
		self.line(depth, f"struct name={self.quoted(structure.name)} packAlignment={structure.packAlignment}{self.flag("union", structure.isUnion)}");
		self.fields(depth + 1, structure.fields);
	}

	private void fields(int depth, Vector<IRStructField> fields) {
		for field in fields {
			string bitWidth = field.bitWidth < 0 ? "" : f" bitWidth={field.bitWidth}";
			self.line(depth, f"field cType={self.quoted(field.cType)} name={self.quoted(field.name)}{self.flag("volatile", field.isVolatile)}{self.flag("effectiveVolatile", field.effectiveIsVolatile)}{self.flag("unsizedArray", field.isUnsizedArray)}{bitWidth}");
			self.child(depth + 1, "arraySize", field.arraySize);
			Vector<IRStructField>? record = field.recordFields;
			if (record != null) { self.fields(depth + 1, record); }
		}
	}

	private void child(int depth, string role, IRNode? node) {
		if (node == null) { return; }
		IRKind kind = (IRKind)node.kind;
		int domain = node.payloadDomain();
		string scalars = f"{self.flag("prefix", (domain == IR_PAYLOAD_UNARY && ((IRUnaryPayload)node.payload).prefix))}{self.flag("arrow", (domain == IR_PAYLOAD_PROJECTION_DESIGNATION && ((IRProjectionPayload)node.payload).arrow))}{self.flag("storageRootKnown", node.storageRootKnown)}{self.flag("sourceAddress", node.sourceAddress)}{self.flag("arrayStorageKnown", node.arrayStorageKnown)}{self.flag("arrayDecl", (domain == IR_PAYLOAD_DECLARATION && ((IRDeclarationPayload)node.payload).isArrayDecl))}{self.flag("volatile", (domain == IR_PAYLOAD_DECLARATION && ((IRDeclarationPayload)node.payload).isVolatile))}{self.flag("effectiveVolatile", (domain == IR_PAYLOAD_DECLARATION && ((IRDeclarationPayload)node.payload).effectiveIsVolatile))}{self.flag("setjmpInferredVolatile", (domain == IR_PAYLOAD_DECLARATION && ((IRDeclarationPayload)node.payload).setjmpInferredVolatile))}{self.flag("static", (domain == IR_PAYLOAD_DECLARATION && ((IRDeclarationPayload)node.payload).isStatic))}{self.flag("extern", (domain == IR_PAYLOAD_DECLARATION && ((IRDeclarationPayload)node.payload).isExtern))}{self.flag("cycleReturnTemp", (domain == IR_PAYLOAD_DECLARATION && ((IRDeclarationPayload)node.payload).isCycleReturnTemp))}{self.flag("fallsThrough", (domain == IR_PAYLOAD_CONTROL_SEQUENCE && ((IRControlPayload)node.payload).fallsThrough))}{self.flag("noFallThrough", !node.canFallThrough)}{self.flag("neverReturns", (domain == IR_PAYLOAD_CALL && ((IRCallPayload)node.payload).neverReturns))}{self.flag("realtimeBounded", (domain == IR_PAYLOAD_CONTROL_SEQUENCE && ((IRControlPayload)node.payload).realtimeBounded))}{self.flag("bitField", (domain == IR_PAYLOAD_PROJECTION_DESIGNATION && ((IRProjectionPayload)node.payload).bitField))}";
		string texts = f"{self.text("text", node.text)}{self.text("name", node.name)}{self.text("callee", (domain == IR_PAYLOAD_CALL ? ((IRCallPayload)node.payload).callee : ""))}{self.text("op", node.op)}{self.text("targetType", (domain == IR_PAYLOAD_CONVERSION_AGGREGATE ? ((IRConversionPayload)node.payload).targetType : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).targetType : ""))}{self.text("bridge", (domain == IR_PAYLOAD_CONVERSION_AGGREGATE ? ((IRConversionPayload)node.payload).bridge : ""))}{self.text("field", (domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).field : ""))}{self.text("storageRoot", node.storageRoot)}{self.text("arrayStorageRoot", node.arrayStorageRoot)}{self.text("cType", (domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).cType : ""))}{self.text("sourceFile", (domain == IR_PAYLOAD_SOURCE ? ((IRSourcePayload)node.payload).sourceFile : ""))}{self.text("helperRef", (domain == IR_PAYLOAD_CALL ? ((IRCallPayload)node.payload).helperRef : ""))}{self.text("realtimeProvenance", (domain == IR_PAYLOAD_CALL ? ((IRCallPayload)node.payload).realtimeProvenance : ""))}";
		string line = (domain == IR_PAYLOAD_SOURCE ? ((IRSourcePayload)node.payload).sourceLine : 0) == 0 ? "" : f" line={(domain == IR_PAYLOAD_SOURCE ? ((IRSourcePayload)node.payload).sourceLine : 0)}";
		self.line(depth, f"{role}: {kind.toString()}{texts}{scalars}{line}");
		IRCleanupSlot? slot = (domain == IR_PAYLOAD_CALL ? ((IRCallPayload)node.payload).cleanupSlot : domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).cleanupSlot : null);
		if (slot != null) { self.line(depth + 1, f"cleanupSlot site={slot.site} name={self.quoted(slot.name)} cType={self.quoted(slot.cType)} takeFunction={self.quoted(slot.takeFunction)}"); }
		self.strings(depth + 1, "fieldName", node.fieldNames());
		self.params(depth + 1, (domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).params : null));
		self.child(depth + 1, "left", node.left);
		self.child(depth + 1, "right", node.right);
		self.child(depth + 1, "operand", (domain == IR_PAYLOAD_UNARY ? ((IRUnaryPayload)node.payload).operand : domain == IR_PAYLOAD_CONVERSION_AGGREGATE ? ((IRConversionPayload)node.payload).operand : null));
		self.child(depth + 1, "expr", node.expr);
		self.child(depth + 1, "obj", (domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).obj : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).obj : null));
		self.child(depth + 1, "index", (domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).index : null));
		self.child(depth + 1, "condition", (domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).condition : null));
		self.child(depth + 1, "trueExpr", (domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).trueExpr : null));
		self.child(depth + 1, "falseExpr", (domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).falseExpr : null));
		self.child(depth + 1, "arraySize", (domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).arraySize : null));
		self.child(depth + 1, "init", (domain == IR_PAYLOAD_DECLARATION ? ((IRDeclarationPayload)node.payload).init : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).init : null));
		self.child(depth + 1, "target", (domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).target : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).target : null));
		self.child(depth + 1, "value", (domain == IR_PAYLOAD_PROJECTION_DESIGNATION ? ((IRProjectionPayload)node.payload).value : domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).value : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).value : domain == IR_PAYLOAD_VALUE_FLOW ? ((IRValuePayload)node.payload).value : null));
		self.child(depth + 1, "thenBlock", (domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).thenBlock : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).thenBlock : null));
		self.child(depth + 1, "elseBlock", (domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).elseBlock : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).elseBlock : null));
		self.child(depth + 1, "body", (domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).body : domain == IR_PAYLOAD_NATIVE ? ((IRNativePayload)node.payload).body : null));
		self.child(depth + 1, "update", (domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).update : null));
		for argument in node.args() { self.child(depth + 1, "arg", argument); }
		for statement in node.stmts() { self.child(depth + 1, "stmt", statement); }
		self.child(depth + 1, "result", (domain == IR_PAYLOAD_CONTROL_SEQUENCE ? ((IRControlPayload)node.payload).result : null));
	}
}
