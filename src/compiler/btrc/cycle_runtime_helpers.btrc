class CycleRuntimeCatalog {
    private CycleRuntimeSourceCatalog sources;
    private CycleRuntimeDependencyCatalog dependencyCatalog;
    private Map<string, bool> members;
    private Vector<string> emissionOrder;

    public CycleRuntimeCatalog(
            CycleRuntimeSourceCatalog sources,
            CycleRuntimeDependencyCatalog dependencyCatalog) {
        self.sources = sources;
        self.dependencyCatalog = dependencyCatalog;
        self.emissionOrder = [
            "__btrc_arc_callback_types",
            "__btrc_arc_header_of",
            "__btrc_arc_type_of",
            "__btrc_arc_validate",
            "__btrc_destroyed_tracking",
            "__btrc_arc_lock_state",
            "__btrc_arc_snapshot_state",
            "__btrc_arc_snapshot_gate_state",
            "__btrc_arc_abandon_callback_state",
            "__btrc_arc_abandon_queue_state",
            "__btrc_arc_shutdown_state",
            "__btrc_arc_active_drains_state",
            "__btrc_arc_active_unwinds_state",
            "__btrc_arc_mutation_lock",
            "__btrc_destroyed_tracking_scope",
            "__btrc_is_destroyed",
            "__btrc_destroyed_capacity",
            "__btrc_mark_destroyed",
            "__btrc_suspect_state",
            "__btrc_suspect_capacity",
            "__btrc_ptr_hash",
            "__btrc_suspect_locked",
            "__btrc_suspect",
            "__btrc_arc_topology_state",
            "__btrc_arc_topology_depth_state",
            "__btrc_arc_exclusive_snapshot",
            "__btrc_arc_topology_begin",
            "__btrc_arc_topology_leave",
            "__btrc_arc_deferred_state",
            "__btrc_cycle_collector_state",
            "__btrc_arc_graph_primitives",
            "__btrc_arc_unregister_incoming",
            "__btrc_forget_suspect",
            "__btrc_collect_cycles_once",
            "__btrc_arc_drain",
            "__btrc_arc_abandon_graph",
            "__btrc_flush_cycles",
            "__btrc_arc_abandon_queue_drain",
            "__btrc_arc_topology_cleanup",
            "__btrc_arc_topology_complete",
            "__btrc_arc_reverse_state",
            "__btrc_arc_register_incoming",
            "__btrc_arc_incoming_teardown_pending",
            "__btrc_arc_reverse_proves_live",
            "__btrc_arc_retain",
            "__btrc_arc_retain_edge",
            "__btrc_arc_adopt_edge",
            "__btrc_arc_unlink_edge",
            "__btrc_arc_release_impl",
            "__btrc_arc_replace_edge",
            "__btrc_arc_release",
            "__btrc_arc_release_edge",
            "__btrc_arc_release_acyclic",
            "__btrc_arc_invalidate",
            "__btrc_arc_destroy_slot",
            "__btrc_arc_destroy_edge",
            "__btrc_arc_abandon",
            "__btrc_collect_cycles",
            "__btrc_poll_cycles",
            "__btrc_arc_thread_state_cleanup",
            "__btrc_cycle_state_cleanup"
        ];
        self.members = {};
        int index = 0;
        while (index < self.emissionOrder.len) {
            self.members.put(self.emissionOrder.get(index), true);
            index = index + 1;
        }
    }

    public bool has(string name) { return self.members.has(name); }

    public string source(string name) {
        string source = self.sources.stateSource(name);
        if (source != "") { return source; }
        source = self.sources.lockSource(name);
        if (source != "") { return source; }
        source = self.sources.snapshotSource(name);
        if (source != "") { return source; }
        source = self.sources.incomingSource(name);
        if (source != "") { return source; }
        source = self.sources.retainSource(name);
        if (source != "") { return source; }
        source = self.sources.releaseSource(name);
        if (source != "") { return source; }
        source = self.sources.lifecycleSource(name);
        if (source != "") { return source; }
        source = self.sources.graphSource(name);
        if (source != "") { return source; }
        source = self.sources.abandonSource(name);
        if (source != "") { return source; }
        source = self.sources.abandonQueueSource(name);
        if (source != "") { return source; }
        source = self.sources.collectorSource(name);
        if (source != "") { return source; }
        source = self.sources.drainSource(name);
        if (source != "") { return source; }
        return self.sources.boundarySource(name);
    }

    public Vector<string> dependencies(string name) {
        return self.dependencyCatalog.dependencies(name);
    }

    public Vector<string> headers(string name) {
        Vector<string> out = [];
        if (name == "__btrc_arc_lock_state"
                || name == "__btrc_arc_snapshot_state"
                || name == "__btrc_arc_snapshot_gate_state") {
            out.push("stdatomic.h");
        } else if (name == "__btrc_arc_exclusive_snapshot") {
            out.push("limits.h");
            out.push("stdio.h");
            out.push("stdlib.h");
        } else if (name == "__btrc_arc_abandon_graph") {
            out.push("stdlib.h");
        } else if (name == "__btrc_arc_abandon") {
            out.push("limits.h");
            out.push("stdint.h");
            out.push("stdio.h");
            out.push("stdlib.h");
        } else if (name == "__btrc_arc_topology_begin") {
            out.push("limits.h");
            out.push("stdio.h");
            out.push("stdlib.h");
        } else if (name == "__btrc_arc_topology_leave"
                || name == "__btrc_arc_deferred_state") {
            out.push("stdio.h");
            out.push("stdlib.h");
        } else if (name == "__btrc_arc_drain") {
            out.push("limits.h");
            out.push("stdio.h");
            out.push("stdlib.h");
            out.push("string.h");
        }
        return out;
    }

    public void appendOrder(Vector<string> order) {
        int index = 0;
        while (index < self.emissionOrder.len) {
            order.push(self.emissionOrder.get(index));
            index = index + 1;
        }
    }
}
