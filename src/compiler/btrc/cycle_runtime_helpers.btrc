string cycleRuntimeHelperSource(string name) {
    string source = cycleRuntimeStateSource(name);
    if (source != "") { return source; }
    source = cycleRuntimeLockSource(name);
    if (source != "") { return source; }
    source = cycleRuntimeIncomingSource(name);
    if (source != "") { return source; }
    if (name == "__btrc_collect_cycles") {
        return cycleRuntimeCollectorPrefix()
            + cycleRuntimeCollectorSuffix();
    }
    return cycleRuntimeReleaseSource(name);
}

