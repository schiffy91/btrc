/* Contextual aggregate/collection initializer shape and element contracts. */

Node semanticArrayElementType(Node arrayType) {
    Node element = copyTypeExpr(arrayType);
    element.is_array = false;
    element.array_size = null;
    element.is_static = false;
    element.is_extern = false;
    return element;
}

void semanticValidateInitializerValue(Node expected, Node value,
        string subject, SemanticValidationState state,
        Map<string, Node> vars);

void semanticValidateInitializerElements(Node expected,
        Vector<Node> elements, string subject,
        SemanticValidationState state, Map<string, Node> vars) {
    int index = 0;
    while (index < elements.len) {
        semanticValidateInitializerValue(expected, elements.get(index),
            subject + " element " + Strings.fromInt(index), state, vars);
        index = index + 1;
    }
}

void semanticValidateStructInitializer(Node expected, Node initializer,
        string subject, SemanticValidationState state,
        Map<string, Node> vars) {
    string name = semanticStructTypeName(expected, state.analyzed);
    if (name == "" || !state.analyzed.structTable.has(name)) { return; }
    Node declaration = state.analyzed.structTable.get(name);
    if (declaration.is_forward) {
        semanticValidationFail("Incomplete struct '" + name
            + "' cannot be initialized by value", initializer);
    }
    if (initializer.kind != NK_BRACE_INITIALIZER) {
        semanticValidationFail(subject + " requires a brace initializer for "
            + "struct '" + name + "'", initializer);
    }
    if (initializer.elements.len > declaration.fields.len) {
        semanticValidationFail(subject + " has "
            + Strings.fromInt(initializer.elements.len)
            + " initializer elements but struct '" + name + "' has "
            + Strings.fromInt(declaration.fields.len) + " fields", initializer);
    }
    int index = 0;
    while (index < initializer.elements.len) {
        Node field = declaration.fields.get(index);
        semanticValidateInitializerValue(field.type,
            initializer.elements.get(index),
            subject + " field '" + field.name + "'", state, vars);
        index = index + 1;
    }
}

void semanticValidateMapInitializer(Node expected, Node initializer,
        string subject, SemanticValidationState state,
        Map<string, Node> vars) {
    if (expected.base != "Map" || expected.generic_args.len != 2) {
        semanticValidationFail(subject
            + " uses a map literal for a non-Map type", initializer);
    }
    int index = 0;
    while (index < initializer.entries.len) {
        Node entry = initializer.entries.get(index);
        semanticValidateInitializerValue(expected.generic_args.get(0),
            entry.key, subject + " key", state, vars);
        semanticValidateInitializerValue(expected.generic_args.get(1),
            entry.value_node, subject + " value", state, vars);
        index = index + 1;
    }
}

void semanticValidateInitializerValue(Node expected, Node value,
        string subject, SemanticValidationState state,
        Map<string, Node> vars) {
    Node? canonical = semanticResolveAliases(expected, state);
    if (canonical == null) { return; }
    if (value.kind == NK_MAP_LITERAL) {
        semanticValidateMapInitializer(
            canonical, value, subject, state, vars);
        return;
    }
    if (canonical.is_array) {
        if (value.kind != NK_BRACE_INITIALIZER
                && value.kind != NK_LIST_LITERAL) {
            semanticValidationFail(subject
                + " requires an array initializer", value);
        }
        /* A fixed-bound empty initializer is normalized by structured IR to
         * strict-C11 `{0}`.  Only an unsized array lacks enough information
         * to form an object. */
        if (value.elements.len == 0 && canonical.array_size == null) {
            semanticValidationFail(subject
                + " cannot infer an array bound from an empty initializer",
                value);
        }
        semanticValidateInitializerElements(
            semanticArrayElementType(canonical), value.elements,
            subject, state, vars);
        return;
    }
    string structName = semanticStructTypeName(canonical, state.analyzed);
    if (structName != "" && canonical.pointer_depth == 0
            && value.kind == NK_BRACE_INITIALIZER) {
        semanticValidateStructInitializer(
            canonical, value, subject, state, vars);
        return;
    }
    if (value.kind == NK_BRACE_INITIALIZER
            || value.kind == NK_LIST_LITERAL) {
        if (canonical.generic_args.len == 1
                && (canonical.base == "Array" || canonical.base == "List"
                    || canonical.base == "Set"
                    || canonical.base == "Vector")) {
            semanticValidateInitializerElements(
                canonical.generic_args.get(0), value.elements,
                subject, state, vars);
            return;
        }
        if (value.kind == NK_BRACE_INITIALIZER && value.elements.len == 0
                && canonical.generic_args.len > 0
                && state.analyzed.isGenericClass(canonical.base)) {
            return;
        }
        semanticValidationFail(subject + " uses an aggregate initializer for '"
            + semanticFormatType(canonical) + "'", value);
    }
    Node? actual = semanticInferType(value, state, vars);
    if (actual != null
            && !semanticAssignmentCompatible(canonical, actual, state)) {
        semanticValidationFail(subject + " expects '"
            + semanticFormatType(canonical) + "' but got '"
            + semanticFormatType(actual) + "'", value);
    }
}

void semanticValidateTypedInitializer(Node? expected, Node? initializer,
        string subject, SemanticValidationState state,
        Map<string, Node> vars) {
    if (expected == null || initializer == null) { return; }
    semanticRejectShallowInitializer(
        expected, initializer, state, vars);
    Node? canonical = semanticResolveAliases(expected, state);
    bool aggregate = initializer.kind == NK_BRACE_INITIALIZER
        || initializer.kind == NK_LIST_LITERAL
        || initializer.kind == NK_MAP_LITERAL;
    /* Ordinary scalar/reference compatibility already has context-specific
     * diagnostics at every call site.  This layer owns only contextual
     * aggregate shapes and nested aggregate element checks. */
    if (!aggregate && (canonical == null || !canonical.is_array)) { return; }
    semanticValidateInitializerValue(
        expected, initializer, subject, state, vars);
}
