/* ARC cycle metadata and visitor lowering for monomorphized classes. */

Node genericCycleRootType(GenInstance instance) {
    Node root = Node();
    root.kind = NK_TYPE_EXPR;
    root.base = instance.base;
    int index = 0;
    while (index < instance.args.len) {
        root.generic_args.push(instance.args.get(index));
        index = index + 1;
    }
    return root;
}

string genericCycleTypeKey(Node typeExpr) {
    if (typeExpr.generic_args.len > 0) {
        return "generic:" + genericInstanceKey(
            typeExpr.base, typeExpr.generic_args);
    }
    return "class:" + typeIdentityField(
        "b", typeIdentityUtf8Hex(typeExpr.base));
}

bool genericCycleManagedType(Analyzed analyzed, Node? typeExpr) {
    if (typeExpr == null || typeExpr.pointer_depth > 1) { return false; }
    return analyzed.isClass(typeExpr.base)
        || (typeExpr.generic_args.len > 0
            && analyzed.isGenericClass(typeExpr.base));
}

void genericCycleAppendRuntimeTypes(
        Analyzed analyzed, Node typeExpr, Vector<Node> output) {
    Node? mutexPayload = mutexPayloadType(analyzed, typeExpr);
    if (mutexPayload != null) {
        genericCycleAppendRuntimeTypes(
            analyzed, mutexPayload, output);
        return;
    }
    if (!genericCycleManagedType(analyzed, typeExpr)) { return; }
    if (typeExpr.generic_args.len == 0
            && analyzed.isClass(typeExpr.base)) {
        Vector<string> runtimeClasses = analyzed.classTable.keys();
        int index = 0;
        while (index < runtimeClasses.len) {
            string runtimeClass = runtimeClasses.get(index);
            if (analyzed.isSubclass(runtimeClass, typeExpr.base)) {
                output.push(makePrimType(runtimeClass));
            }
            index = index + 1;
        }
        return;
    }
    output.push(typeExpr);
}

void genericCycleCollectClassFields(
        Analyzed analyzed, string className, Vector<Node> output) {
    if (!analyzed.isClass(className)) { return; }
    Node declaration = analyzed.classTable.get(className);
    string parent = parentName(declaration);
    if (parent != "" && analyzed.isClass(parent)) {
        genericCycleCollectClassFields(analyzed, parent, output);
    }
    int index = 0;
    while (index < declaration.members.len) {
        Node member = declaration.members.get(index);
        if (instanceStorageName(member) != "") { output.push(member); }
        index = index + 1;
    }
}

void genericCycleAppendRefs(
        Analyzed analyzed, Node typeExpr, Vector<Node> output) {
    if (typeExpr.generic_args.len > 0
            && analyzed.isGenericClass(typeExpr.base)) {
        Node declaration =
            analyzed.genericClassTable.get(typeExpr.base);
        Map<string, Node> substitutions = {};
        int parameter = 0;
        while (parameter < declaration.generic_params.len
                && parameter < typeExpr.generic_args.len) {
            substitutions.put(declaration.generic_params.get(parameter),
                typeExpr.generic_args.get(parameter));
            parameter = parameter + 1;
        }
        int memberIndex = 0;
        while (memberIndex < declaration.members.len) {
            Node member = declaration.members.get(memberIndex);
            if (instanceStorageName(member) != "") {
                Node resolved = resolveGenericType(
                    member.type, substitutions);
                genericCycleAppendRuntimeTypes(
                    analyzed, resolved, output);
            }
            memberIndex = memberIndex + 1;
        }
    } else if (analyzed.isClass(typeExpr.base)) {
        Vector<Node> fields = [];
        genericCycleCollectClassFields(analyzed, typeExpr.base, fields);
        int fieldIndex = 0;
        while (fieldIndex < fields.len) {
            Node fieldType = fields.get(fieldIndex).type;
            genericCycleAppendRuntimeTypes(
                analyzed, fieldType, output);
            fieldIndex = fieldIndex + 1;
        }
    }

    /* Generic arguments are conservative graph edges, matching analyzer cycle
     * eligibility for wrappers whose element storage is runtime-managed. */
    int argumentIndex = 0;
    while (argumentIndex < typeExpr.generic_args.len) {
        Node argument = typeExpr.generic_args.get(argumentIndex);
        genericCycleAppendRuntimeTypes(analyzed, argument, output);
        argumentIndex = argumentIndex + 1;
    }
}

bool genericCycleReaches(
        Analyzed analyzed, Node initial, string targetKey) {
    Vector<Node> stack = [];
    stack.push(initial);
    Map<string, bool> visited = {};
    while (stack.len > 0) {
        Node current = stack.pop();
        string currentKey = genericCycleTypeKey(current);
        if (currentKey == targetKey) { return true; }
        if (!visited.has(currentKey)) {
            visited.put(currentKey, true);
            genericCycleAppendRefs(analyzed, current, stack);
        }
    }
    return false;
}

bool genericInstanceIsCyclable(Analyzed analyzed, GenInstance instance) {
    Node root = genericCycleRootType(instance);
    string rootKey = genericCycleTypeKey(root);
    Vector<Node> references = [];
    genericCycleAppendRefs(analyzed, root, references);
    int index = 0;
    while (index < references.len) {
        if (genericCycleReaches(
                analyzed, references.get(index), rootKey)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

bool genericInstanceNeedsVisitor(Analyzed analyzed, GenInstance instance) {
    if (isCycleCollection(instance.base)) {
        if (instance.base == "List") { return instance.args.len == 1; }
        int argument = 0;
        while (argument < instance.args.len) {
            if (genericCycleManagedType(
                    analyzed, instance.args.get(argument))) {
                return true;
            }
            argument = argument + 1;
        }
        return false;
    }
    if (!analyzed.isGenericClass(instance.base)) { return false; }
    Node declaration = analyzed.genericClassTable.get(instance.base);
    Map<string, Node> substitutions = {};
    int parameter = 0;
    while (parameter < declaration.generic_params.len
            && parameter < instance.args.len) {
        substitutions.put(declaration.generic_params.get(parameter),
            instance.args.get(parameter));
        parameter = parameter + 1;
    }
    int member = 0;
    while (member < declaration.members.len) {
        Node field = declaration.members.get(member);
        if (instanceStorageName(field) != "") {
            Node resolved = resolveGenericType(field.type, substitutions);
            if (genericCycleManagedType(analyzed, resolved)
                    || mutexPayloadIsManagedClass(
                        analyzed, resolved)) {
                return true;
            }
        }
        member = member + 1;
    }
    return false;
}

bool classNeedsCycleVisitor(IRGen generator, string className) {
    if (!generator.analyzed.isClass(className)) { return false; }
    Vector<Node> fields = [];
    genericCycleCollectClassFields(
        generator.analyzed, className, fields);
    int field = 0;
    while (field < fields.len) {
        Node fieldType = fields.get(field).type;
        if (genericCycleManagedType(
                generator.analyzed, fieldType)
                || mutexPayloadIsManagedClass(
                    generator.analyzed, fieldType)) {
            return true;
        }
        field = field + 1;
    }
    return false;
}

bool managedClassIsCyclable(IRGen generator, string emittedName) {
    if (generator.analyzed.isClass(emittedName)) {
        Vector<string> runtimeClasses =
            generator.analyzed.classTable.keys();
        int runtimeIndex = 0;
        while (runtimeIndex < runtimeClasses.len) {
            string runtimeClass = runtimeClasses.get(runtimeIndex);
            if (generator.analyzed.isSubclass(runtimeClass, emittedName)
                    && generator.isCyclable(runtimeClass)) {
                return true;
            }
            runtimeIndex = runtimeIndex + 1;
        }
        return false;
    }
    int index = 0;
    while (index < generator.analyzed.genericInstances.len) {
        GenInstance instance =
            generator.analyzed.genericInstances.get(index);
        if (instance.mangled == emittedName) {
            return genericInstanceIsCyclable(generator.analyzed, instance);
        }
        index = index + 1;
    }
    return false;
}

void emitGenericCycleVisitor(IRGen generator, GenInstance instance,
        Node declaration, Map<string, Node> substitutions, IRModule module) {
    if (!genericInstanceNeedsVisitor(generator.analyzed, instance)) { return; }
    generator.useHelper("__btrc_arc_callback_types");

    IRFunctionDecl visitorDeclaration = IRFunctionDecl(
        cycleVisitorName(instance.mangled), "void", true);
    visitorDeclaration.params.push(IRParam("void*", "object"));
    visitorDeclaration.params.push(IRParam(
        "__btrc_field_visit_fn", "fn"));
    visitorDeclaration.params.push(IRParam("void*", "context"));
    module.function_decls.push(visitorDeclaration);

    IRFunction visitorFn = IRFunction();
    visitorFn.name = cycleVisitorName(instance.mangled);
    visitorFn.return_type = "void";
    visitorFn.is_static = true;
    visitorFn.archive_export = true;
    visitorFn.params.push(IRParam("void*", "object"));
    visitorFn.params.push(IRParam("__btrc_field_visit_fn", "fn"));
    visitorFn.params.push(IRParam("void*", "context"));
    Vector<IRNode> body = [];
    body.push(irVarDecl(instance.mangled + "*", "self",
        irCast(instance.mangled + "*", irVar("object"))));

    bool visited = appendBuiltinCollectionCycleBody(
        generator, instance, body);
    if (!visited) {
        int memberIndex = 0;
        while (memberIndex < declaration.members.len) {
            Node member = declaration.members.get(memberIndex);
            string storageName = instanceStorageName(member);
            if (storageName != "") {
                Node resolved = resolveGenericType(member.type, substitutions);
                if (genericCycleManagedType(generator.analyzed, resolved)
                        || mutexPayloadIsManagedClass(
                            generator.analyzed, resolved)) {
                    IRNode field = irFieldAccess(
                        irVar("self"), storageName, true);
                    if (appendGenericCycleFieldVisit(generator, resolved,
                            field, body)) {
                        visited = true;
                    }
                }
            }
            memberIndex = memberIndex + 1;
        }
    }
    if (!visited) {
        body.push(irExprStmt(irCast("void", irVar("self"))));
        body.push(irExprStmt(irCast("void", irVar("fn"))));
        body.push(irExprStmt(irCast("void", irVar("context"))));
    }
    visitorFn.body = irBlock(body);
    module.functions.push(visitorFn);
}
