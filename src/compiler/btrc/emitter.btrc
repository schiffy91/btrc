/* Stage 6 — C emitter (minimal).
 *
 * Mirrors src/compiler/python/ir/emitter.py + emitter_exprs.py for the
 * supported IR subset. A simple recursive tree walk over IR nodes producing C
 * text byte-identical to the Python reference. NO lowering here — just
 * formatting. Output ends with a trailing newline (lines joined by "\n" + "\n").
 */

class CEmitter {
    public Vector<string> lines;
    public int indent;

    public CEmitter() {
        self.lines = [];
        self.indent = 0;
    }

    public string emit(IRModule m) {
        self.lines = [];
        self.indent = 0;

        /* Header comment (suppressed when raw_sections are present, mirroring
         * emitter.py's `if not module.raw_sections`). */
        if (m.raw_sections.len == 0) {
            self.line("/* Generated by btrc */");
        }

        /* Reserve the include slot (filled after body is known). */
        int includeSlot = self.lines.len;

        /* Runtime helpers (raw C source, blank line after each). */
        int h = 0;
        while (h < m.helpers.len) {
            self.raw(m.helpers.get(h));
            self.line("");
            h = h + 1;
        }

        /* Split raw_sections into #define sections (which must precede the
         * struct defs that may reference them, e.g. `entries[HT_CAP]`) and
         * other sections (emitted after struct defs). Mirrors emitter.py's
         * define_sections/other_sections split. */
        Vector<string> defineSections = [];
        Vector<string> otherSections = [];
        int rs = 0;
        while (rs < m.raw_sections.len) {
            string sec = m.raw_sections.get(rs);
            if (sec.length() >= 7 && sec.substring(0, 7) == "#define") {
                defineSections.push(sec);
            } else {
                otherSections.push(sec);
            }
            rs = rs + 1;
        }

        /* Preprocessor defines (before forward decls / struct defs). */
        int ds = 0;
        while (ds < defineSections.len) {
            self.raw(defineSections.get(ds));
            self.line("");
            ds = ds + 1;
        }

        /* Forward declarations. */
        int i = 0;
        while (i < m.forward_decls.len) {
            self.line(m.forward_decls.get(i));
            i = i + 1;
        }
        if (m.forward_decls.len > 0) { self.line(""); }

        /* Struct definitions. */
        i = 0;
        while (i < m.struct_defs.len) {
            self.emitStruct(m.struct_defs.get(i));
            i = i + 1;
        }

        /* Raw sections (pre-rendered C text: generic macros + method fwd-decls),
         * each followed by a blank line (mirrors emitter.py other_sections). */
        i = 0;
        while (i < otherSections.len) {
            self.raw(otherSections.get(i));
            self.line("");
            i = i + 1;
        }

        /* Function definitions. */
        i = 0;
        while (i < m.functions.len) {
            self.emitFunction(m.functions.get(i));
            i = i + 1;
        }

        /* Build and splice in the include prologue at the reserved slot. */
        Vector<string> incLines = self.buildIncludeLines(m);
        self.spliceLines(includeSlot, incLines);

        return self.joinLines();
    }

    public Vector<string> buildIncludeLines(IRModule m) {
        Vector<string> out = [];
        /* dedup, order-preserving */
        Map<string, bool> seen = {};
        int i = 0;
        while (i < m.includes.len) {
            string inc = m.includes.get(i);
            if (!seen.has(inc)) {
                seen.put(inc, true);
                if (inc.length() >= 1 && inc.substring(0, 1) == "#") {
                    out.push(inc);
                } else {
                    out.push(f"#include <{inc}>");
                }
            }
            i = i + 1;
        }
        if (out.len > 0) { out.push(""); }
        return out;
    }

    /* Insert `ins` lines into self.lines at index `at`. */
    public void spliceLines(int at, Vector<string> ins) {
        Vector<string> rebuilt = [];
        int i = 0;
        while (i < at) { rebuilt.push(self.lines.get(i)); i = i + 1; }
        int j = 0;
        while (j < ins.len) { rebuilt.push(ins.get(j)); j = j + 1; }
        int k = at;
        while (k < self.lines.len) { rebuilt.push(self.lines.get(k)); k = k + 1; }
        self.lines = rebuilt;
    }

    public string joinLines() {
        string out = "";
        int i = 0;
        while (i < self.lines.len) {
            out = out + self.lines.get(i) + "\n";
            i = i + 1;
        }
        return out;
    }

    /* --- struct emission (matches emitter.py _emit_struct) --- */

    public void emitStruct(IRStructDef s) {
        self.line(f"struct {s.name} {{");
        self.indent = self.indent + 1;
        int i = 0;
        while (i < s.fields.len) {
            IRStructField f = s.fields.get(i);
            self.line(f"{f.c_type} {f.name};");
            i = i + 1;
        }
        self.indent = self.indent - 1;
        self.line("};");
        self.line("");
    }

    /* --- function emission --- */

    public void emitFunction(IRFunction fn) {
        string params = "";
        if (fn.params.len == 0) {
            params = "void";
        } else {
            int i = 0;
            while (i < fn.params.len) {
                IRParam p = fn.params.get(i);
                if (i > 0) { params = params + ", "; }
                params = params + p.c_type + " " + p.name;
                i = i + 1;
            }
        }
        string prefix = "";
        if (fn.is_static) { prefix = "static "; }
        self.line(f"{prefix}{fn.return_type} {fn.name}({params}) {{");
        if (fn.body != null) {
            self.indent = self.indent + 1;
            self.emitBlockContents(fn.body);
            self.indent = self.indent - 1;
        }
        self.line("}");
        self.line("");
    }

    public void emitBlockContents(IRNode block) {
        int i = 0;
        while (i < block.stmts.len) {
            self.emitStmt(block.stmts.get(i));
            i = i + 1;
        }
    }

    /* --- statement emission --- */

    public void emitStmt(IRNode s) {
        if (s.kind == IRK_VAR_DECL) {
            if (s.init != null) {
                self.line(f"{s.c_type} {s.name} = {self.expr(s.init)};");
            } else {
                self.line(f"{s.c_type} {s.name};");
            }
            return;
        }
        if (s.kind == IRK_ASSIGN) {
            self.line(f"{self.expr(s.target)} = {self.expr(s.value)};");
            return;
        }
        if (s.kind == IRK_RETURN) {
            if (s.value != null) {
                self.line(f"return {self.expr(s.value)};");
            } else {
                self.line("return;");
            }
            return;
        }
        if (s.kind == IRK_EXPR_STMT) {
            self.line(f"{self.expr(s.expr)};");
            return;
        }
        if (s.kind == IRK_IF) {
            self.line(f"if ({self.condExpr(s.condition)}) {{");
            if (s.then_block != null) {
                self.indent = self.indent + 1;
                self.emitBlockContents(s.then_block);
                self.indent = self.indent - 1;
            }
            self.emitElseTail(s);
            return;
        }
        if (s.kind == IRK_WHILE) {
            self.line(f"while ({self.condExpr(s.condition)}) {{");
            if (s.body != null) {
                self.indent = self.indent + 1;
                self.emitBlockContents(s.body);
                self.indent = self.indent - 1;
            }
            self.line("}");
            return;
        }
        if (s.kind == IRK_DO_WHILE) {
            self.line("do {");
            if (s.body != null) {
                self.indent = self.indent + 1;
                self.emitBlockContents(s.body);
                self.indent = self.indent - 1;
            }
            self.line(f"}} while ({self.condExpr(s.condition)});");
            return;
        }
        if (s.kind == IRK_FOR) {
            string initText = self.forInitText(s.init);
            string condText = "";
            if (s.condition != null) { condText = self.expr(s.condition); }
            string updateText = "";
            if (s.update != null) {
                if (s.update.kind == IRK_ASSIGN) {
                    updateText = f"{self.expr(s.update.target)} = {self.expr(s.update.value)}";
                } else {
                    updateText = self.expr(s.update);
                }
            }
            self.line(f"for ({initText}; {condText}; {updateText}) {{");
            if (s.body != null) {
                self.indent = self.indent + 1;
                self.emitBlockContents(s.body);
                self.indent = self.indent - 1;
            }
            self.line("}");
            return;
        }
        if (s.kind == IRK_BREAK) { self.line("break;"); return; }
        if (s.kind == IRK_CONTINUE) { self.line("continue;"); return; }
        if (s.kind == IRK_RAW_C) {
            /* Raw C text: emit each non-blank line at the current indentation
             * (mirrors emitter IRRawC). */
            Vector<string> parts = splitLines(s.text);
            int i = 0;
            while (i < parts.len) {
                string ln = parts.get(i);
                if (strStripped(ln) != "") { self.line(ln); }
                i = i + 1;
            }
            return;
        }
        if (s.kind == IRK_SWITCH) {
            /* switch (val) { case V: <body> default: <body> } — mirrors the
             * IRSwitch branch of emitter._emit_stmt. */
            self.line(f"switch ({self.expr(s.value)}) {{");
            self.indent = self.indent + 1;
            int ci = 0;
            while (ci < s.args.len) {
                IRNode c = s.args.get(ci);
                if (c.value != null) {
                    self.line(f"case {self.expr(c.value)}:");
                } else {
                    self.line("default:");
                }
                self.indent = self.indent + 1;
                int j = 0;
                while (j < c.stmts.len) { self.emitStmt(c.stmts.get(j)); j = j + 1; }
                self.indent = self.indent - 1;
                ci = ci + 1;
            }
            self.indent = self.indent - 1;
            self.line("}");
            return;
        }
    }

    public string forInitText(IRNode init) {
        if (init == null) { return ""; }
        if (init.kind == IRK_VAR_DECL) {
            if (init.init != null) {
                return f"{init.c_type} {init.name} = {self.expr(init.init)}";
            }
            return f"{init.c_type} {init.name}";
        }
        if (init.kind == IRK_ASSIGN) {
            return f"{self.expr(init.target)} = {self.expr(init.value)}";
        }
        if (init.kind == IRK_EXPR_STMT) {
            return self.expr(init.expr);
        }
        return "";
    }

    /* Emit the else / else-if tail of an IRIf, recursing for chains. */
    public void emitElseTail(IRNode s) {
        if (s.else_block == null || s.else_block.stmts.len == 0) {
            self.line("}");
            return;
        }
        /* else-if: single IRIf inside the else block */
        if (s.else_block.stmts.len == 1 && s.else_block.stmts.get(0).kind == IRK_IF) {
            IRNode inner = s.else_block.stmts.get(0);
            self.line(f"}} else if ({self.condExpr(inner.condition)}) {{");
            if (inner.then_block != null) {
                self.indent = self.indent + 1;
                self.emitBlockContents(inner.then_block);
                self.indent = self.indent - 1;
            }
            self.emitElseTail(inner);
            return;
        }
        self.line("} else {");
        self.indent = self.indent + 1;
        self.emitBlockContents(s.else_block);
        self.indent = self.indent - 1;
        self.line("}");
    }

    /* --- expression emission (matches emitter_exprs.py exactly) --- */

    public string condExpr(IRNode e) {
        string result = self.expr(e);
        int n = result.length();
        if (n >= 2 && result.substring(0, 1) == "(" && result.substring(n - 1, 1) == ")") {
            int depth = 0;
            bool stripsOuter = true;
            int i = 0;
            while (i < n) {
                char ch = result[i];
                if (ch == '(') { depth = depth + 1; }
                else if (ch == ')') { depth = depth - 1; }
                if (depth == 0 && i < n - 1) { stripsOuter = false; i = n; }
                else { i = i + 1; }
            }
            if (stripsOuter) {
                result = result.substring(1, n - 2);
            }
        }
        return result;
    }

    public string expr(IRNode e) {
        if (e == null) { return "/* null expr */"; }
        if (e.kind == IRK_LITERAL) { return e.text; }
        if (e.kind == IRK_RAW_EXPR) { return e.text; }
        if (e.kind == IRK_VAR) { return e.name; }
        if (e.kind == IRK_BINOP) {
            return f"({self.expr(e.left)} {e.op} {self.expr(e.right)})";
        }
        if (e.kind == IRK_UNARYOP) {
            if (e.prefix) {
                return f"({e.op}{self.expr(e.operand)})";
            }
            return f"({self.expr(e.operand)}{e.op})";
        }
        if (e.kind == IRK_CALL) {
            string args = "";
            int i = 0;
            while (i < e.args.len) {
                if (i > 0) { args = args + ", "; }
                args = args + self.expr(e.args.get(i));
                i = i + 1;
            }
            return f"{e.callee}({args})";
        }
        if (e.kind == IRK_FIELD_ACCESS) {
            string op = ".";
            if (e.arrow) { op = "->"; }
            return f"{self.expr(e.obj)}{op}{e.field}";
        }
        if (e.kind == IRK_CAST) {
            return f"(({e.target_type}){self.expr(e.expr)})";
        }
        if (e.kind == IRK_TERNARY) {
            return f"({self.expr(e.condition)} ? {self.expr(e.true_expr)} : {self.expr(e.false_expr)})";
        }
        if (e.kind == IRK_SIZEOF) {
            return f"sizeof({e.target_type})";
        }
        if (e.kind == IRK_INDEX) {
            return f"{self.expr(e.obj)}[{self.expr(e.index)}]";
        }
        if (e.kind == IRK_ADDRESS_OF) {
            return f"(&{self.expr(e.expr)})";
        }
        if (e.kind == IRK_DEREF) {
            return f"(*{self.expr(e.expr)})";
        }
        if (e.kind == IRK_STMT_EXPR) {
            /* Hoist setup statements before the enclosing statement (standard
             * C11 — no GCC statement expressions). Mirrors emitter_exprs.py. */
            int i = 0;
            while (i < e.stmts.len) {
                self.emitStmt(e.stmts.get(i));
                i = i + 1;
            }
            return self.expr(e.result);
        }
        if (e.kind == IRK_TUPLE_LITERAL) {
            /* C compound literal: (btrc_Tuple_int_int){._0 = a, ._1 = b}. */
            string inits = "";
            int i = 0;
            while (i < e.args.len) {
                if (i > 0) { inits = inits + ", "; }
                inits = inits + f"._{i} = " + self.expr(e.args.get(i));
                i = i + 1;
            }
            return f"({e.text})" + "{" + inits + "}";
        }
        return "/* unknown expr */";
    }

    /* --- output helpers (matches emitter.py _line) --- */

    public void line(string text) {
        if (strStripped(text) != "") {
            self.lines.push(indentStr(self.indent) + text);
        } else {
            self.lines.push("");
        }
    }

    /* Emit raw text without indentation (mirrors emitter.py _raw): strip
     * trailing newlines, then push each \n-separated line verbatim. */
    public void raw(string text) {
        string t = rstripNewlines(text);
        Vector<string> parts = splitLines(t);
        int i = 0;
        while (i < parts.len) { self.lines.push(parts.get(i)); i = i + 1; }
    }
}

string rstripNewlines(string s) {
    int end = s.length();
    while (end > 0 && s[end - 1] == '\n') { end = end - 1; }
    return s.substring(0, end);
}

/* Split a string on '\n' into its lines (no trailing empty element unless the
 * original ended with a separator, matching Python str.split("\n")). */
Vector<string> splitLines(string s) {
    Vector<string> out = [];
    int n = s.length();
    int start = 0;
    int i = 0;
    while (i < n) {
        if (s[i] == '\n') {
            out.push(s.substring(start, i - start));
            start = i + 1;
        }
        i = i + 1;
    }
    out.push(s.substring(start, n - start));
    return out;
}

string indentStr(int n) {
    string s = "";
    int i = 0;
    while (i < n) { s = s + "    "; i = i + 1; }
    return s;
}

/* Whitespace-stripped copy, used to detect blank lines. */
string strStripped(string s) {
    int n = s.length();
    int start = 0;
    while (start < n && isWsChar(s[start])) { start = start + 1; }
    int end = n;
    while (end > start && isWsChar(s[end - 1])) { end = end - 1; }
    return s.substring(start, end - start);
}

bool isWsChar(char c) {
    return c == ' ' || c == '\t' || c == '\n' || c == '\r';
}
