/* Call-scoped ownership planning for source calls and constructors. */

class OwnershipCallOperand {
    public Node expression;
    public Node? typeExpr;
    public Node? targetType;
    public bool owned;
    public bool keepValue;
    public bool transferred;
    public bool needsConversion;
    public bool defaultArgument;
    public int parameterIndex;

    public OwnershipCallOperand(Node expression, Node? typeExpr,
            Node? targetType, bool owned, bool keepValue,
            bool transferred, bool needsConversion,
            bool defaultArgument, int parameterIndex) {
        self.expression = expression;
        self.typeExpr = typeExpr;
        self.targetType = targetType;
        self.owned = owned;
        self.keepValue = keepValue;
        self.transferred = transferred;
        self.needsConversion = needsConversion;
        self.defaultArgument = defaultArgument;
        self.parameterIndex = parameterIndex;
    }
}

Node ownershipSyntheticParam(string name, Node typeExpr) {
    Node parameter = Node();
    parameter.kind = NK_PARAM;
    parameter.name = name;
    parameter.type = typeExpr;
    return parameter;
}

Vector<Node> ownershipBuiltinParamsForCall(IRGen generator, Node call,
        Map<string, Node> varTypes) {
    Vector<Node> result = [];
    Node? callee = call.callee;
    Node? callableType = directFunctionPointerType(
        generator.resolvedExpressionType(callee, varTypes),
        generator.analyzed);
    if (callableType != null) {
        int callableIndex = 1;
        while (callableIndex < callableType.generic_args.len) {
            result.push(ownershipSyntheticParam(
                Strings.fromInt(callableIndex),
                callableType.generic_args.get(callableIndex)));
            callableIndex = callableIndex + 1;
        }
        return result;
    }

    Node? mutexType = null;
    string method = "";
    if (call.kind == NK_NEW_EXPR) {
        mutexType = generator.resolveBodyType(call.type);
    } else if (callee != null && callee.kind == NK_IDENTIFIER
            && callee.name == "Mutex"
            && !varTypes.has(callee.name)
            && !generator.analyzed.funcNames.has(callee.name)
            && !generator.analyzed.isClass(callee.name)) {
        mutexType = generator.resolvedExpressionType(call, varTypes);
    } else if (callee != null
            && callee.kind == NK_FIELD_ACCESS_EXPR) {
        mutexType = generator.resolvedExpressionType(
            callee.obj, varTypes);
        method = callee.field;
    }
    Node? payload = mutexPayloadType(generator.analyzed, mutexType);
    if (payload != null && (method == "" || method == "set")) {
        result.push(ownershipSyntheticParam("value", payload));
        return result;
    }

    if (callee != null && callee.kind == NK_FIELD_ACCESS_EXPR) {
        Node? receiverType = generator.resolvedExpressionType(
            callee.obj, varTypes);
        if (isStringType(receiverType)) {
            if (semanticOneStringArgMethod(callee.field)) {
                result.push(ownershipSyntheticParam(
                    "value", makePrimType("string")));
            } else if (callee.field == "charAt"
                    || callee.field == "repeat"
                    || callee.field == "zfill") {
                result.push(ownershipSyntheticParam(
                    "value", makePrimType("int")));
            } else if (callee.field == "substring") {
                result.push(ownershipSyntheticParam(
                    "start", makePrimType("int")));
                result.push(ownershipSyntheticParam(
                    "length", makePrimType("int")));
            } else if (callee.field == "find") {
                result.push(ownershipSyntheticParam(
                    "value", makePrimType("string")));
                result.push(ownershipSyntheticParam(
                    "start", makePrimType("int")));
            } else if (callee.field == "replace") {
                result.push(ownershipSyntheticParam(
                    "old", makePrimType("string")));
                result.push(ownershipSyntheticParam(
                    "replacement", makePrimType("string")));
            } else if (callee.field == "padLeft"
                    || callee.field == "padRight"
                    || callee.field == "center") {
                result.push(ownershipSyntheticParam(
                    "width", makePrimType("int")));
                result.push(ownershipSyntheticParam(
                    "fill", makePrimType("char")));
            }
            return result;
        }
    }

    if (callee != null && callee.kind == NK_IDENTIFIER
            && callee.name == "print"
            && !varTypes.has(callee.name)
            && !generator.analyzed.funcNames.has(callee.name)
            && !generator.analyzed.isClass(callee.name)) {
        int printIndex = 0;
        while (printIndex < call.args.len) {
            Node argument = call.args.get(printIndex);
            Node? sourceType = generator.resolvedExpressionType(
                argument, varTypes);
            Node? targetType = sourceType;
            if (requiresTargetStringConversion(
                    generator, makePrimType("string"), sourceType)) {
                targetType = makePrimType("string");
            }
            if (targetType == null) { targetType = makePrimType("int"); }
            result.push(ownershipSyntheticParam(
                Strings.fromInt(printIndex), targetType));
            printIndex = printIndex + 1;
        }
    }
    return result;
}

Vector<Node> ownershipParamsForCall(IRGen generator, Node call,
        Map<string, Node> varTypes) {
    if (call.callee != null && call.callee.kind == NK_IDENTIFIER
            && generator.analyzed.hostedCallKeys.has(astNodeKey(call))
            && hostedAbiExactFunction(call.callee.name)) {
        Vector<Node> hosted = [];
        int index = 0;
        while (index < hostedAbiParameterCount(call.callee.name)) {
            Node typeExpr = makePrimType(
                hostedAbiParameterBase(call.callee.name, index));
            typeExpr.pointer_depth = hostedAbiParameterPointerDepth(
                call.callee.name, index);
            typeExpr.is_const = hostedAbiParameterConst(
                call.callee.name, index);
            hosted.push(ownershipSyntheticParam(
                Strings.fromInt(index), typeExpr));
            index = index + 1;
        }
        return hosted;
    }
    Node? declaration = ownershipCallableForCall(
        generator, call, varTypes);
    if (declaration != null) {
        return callTargetResolvedParameters(
            generator.analyzed, declaration.params,
            callTargetTypeMap(generator, call, varTypes));
    }
    return ownershipBuiltinParamsForCall(generator, call, varTypes);
}

Node ownershipResolveParamType(IRGen generator, Node call,
        Node paramType, Map<string, Node> varTypes) {
    Node result = generator.resolveBodyType(paramType);
    Node? instanceType = null;
    if (call.kind == NK_NEW_EXPR) {
        instanceType = generator.resolveBodyType(call.type);
    } else if (call.callee != null
            && call.callee.kind == NK_FIELD_ACCESS_EXPR) {
        instanceType = generator.resolvedExpressionType(
            call.callee.obj, varTypes);
    } else {
        instanceType = generator.resolvedExpressionType(call, varTypes);
    }
    if (instanceType != null && instanceType.generic_args.len > 0
            && generator.analyzed.isGenericClass(instanceType.base)) {
        result = resolveGenericType(paramType,
            genericTypeMap(generator.analyzed, instanceType),
            generator.analyzed);
    }
    return result;
}

int ownershipNamedParamIndex(Vector<Node> params, string name) {
    int index = 0;
    while (index < params.len) {
        if (params.get(index).name == name) { return index; }
        index = index + 1;
    }
    return -1;
}

Vector<OwnershipCallOperand> ownershipCallOperands(IRGen generator,
        Node call, Vector<Node> params, Map<string, Node> varTypes) {
    Vector<OwnershipCallOperand> result = [];
    Map<int, bool> transferredParams = ownershipOwnedTransferParams(
        ownershipCallableForCall(generator, call, varTypes));
    Map<int, bool> bound = {};
    int positional = 0;
    int index = 0;
    while (index < call.args.len) {
        Node argument = call.args.get(index);
        int paramIndex = positional;
        string argumentName = "";
        if (index < call.arg_names.len) {
            argumentName = call.arg_names.get(index);
        }
        if (argumentName != "") {
            paramIndex = ownershipNamedParamIndex(params, argumentName);
        } else {
            positional = positional + 1;
        }
        Node? argumentType = generator.resolvedExpressionType(
            argument, varTypes);
        Node? targetType = argumentType;
        bool keepValue = false;
        if (paramIndex >= 0 && paramIndex < params.len) {
            bound.put(paramIndex, true);
            Node parameter = params.get(paramIndex);
            targetType = ownershipResolveParamType(
                generator, call, parameter.type, varTypes);
            if (argumentType == null) { argumentType = targetType; }
            keepValue = parameter.keep_;
        }
        bool transferred = transferredParams.has(paramIndex);
        if (!keepValue && !transferred
                && hostedStringConversionMode(generator, argument,
                    targetType, argumentType) == "reject") {
            targetType = argumentType;
        }
        bool managed = irManagedType(generator, argumentType);
        bool owned = managed && irContextualUnconsumedOwnedResult(
            generator, argument, argumentType, varTypes);
        bool targetManaged = irManagedType(generator, targetType);
        result.push(OwnershipCallOperand(argument, argumentType,
            targetType, owned, targetManaged && keepValue,
            transferred,
            requiresTargetValueConversion(
                generator, argument, targetType, argumentType), false,
            paramIndex));
        index = index + 1;
    }
    int parameterIndex = 0;
    while (parameterIndex < params.len) {
        Node parameter = params.get(parameterIndex);
        if (!bound.has(parameterIndex) && parameter.default_ != null) {
            Node argument = parameter.default_;
            Node targetType = ownershipResolveParamType(
                generator, call, parameter.type, varTypes);
            bool keepValue = parameter.keep_;
            bool transferred = transferredParams.has(parameterIndex);
            bool managed = irManagedType(generator, targetType);
            result.push(OwnershipCallOperand(argument, targetType,
                targetType, managed, managed && keepValue,
                transferred,
                false, true,
                parameterIndex));
        }
        parameterIndex = parameterIndex + 1;
    }
    int pinIndex = 0;
    while (pinIndex + 1 < result.len) {
        OwnershipCallOperand operand = result.get(pinIndex);
        bool laterEffect = false;
        int laterIndex = pinIndex + 1;
        while (laterIndex < result.len) {
            OwnershipCallOperand later = result.get(laterIndex);
            if (later.defaultArgument || later.needsConversion
                    || ownershipExpressionHasEffect(
                        generator, later.expression, varTypes)) {
                laterEffect = true;
            }
            laterIndex = laterIndex + 1;
        }
        if (laterEffect && !operand.owned
                && irManagedType(generator, operand.typeExpr)) {
            operand.keepValue = true;
        }
        pinIndex = pinIndex + 1;
    }
    return result;
}

bool ownershipOperandsHaveConcreteTypes(
        Vector<OwnershipCallOperand> operands) {
    int index = 0;
    while (index < operands.len) {
        if (operands.get(index).typeExpr == null) { return false; }
        index = index + 1;
    }
    return true;
}

bool ownershipOperandsHaveEffect(IRGen generator,
        Vector<OwnershipCallOperand> operands,
        Map<string, Node> varTypes) {
    int index = 0;
    while (index < operands.len) {
        OwnershipCallOperand operand = operands.get(index);
        if (operand.defaultArgument || ownershipExpressionHasEffect(
                generator, operand.expression, varTypes)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

bool ownershipCallRequiresOrder(IRGen generator, Node? receiver,
        Vector<OwnershipCallOperand> operands,
        Map<string, Node> varTypes) {
    Vector<Node> expressions = [];
    if (receiver != null) { expressions.push(receiver); }
    int operandIndex = 0;
    while (operandIndex < operands.len) {
        expressions.push(operands.get(operandIndex).expression);
        operandIndex = operandIndex + 1;
    }
    int leftIndex = 0;
    while (leftIndex < expressions.len) {
        Node left = expressions.get(leftIndex);
        bool leftEffect = ownershipExpressionHasEffect(
            generator, left, varTypes);
        int rightIndex = leftIndex + 1;
        while (rightIndex < expressions.len) {
            Node right = expressions.get(rightIndex);
            bool rightEffect = ownershipExpressionHasEffect(
                generator, right, varTypes);
            if ((leftEffect
                    && !ownershipExpressionReorderInert(generator, right))
                    || (rightEffect
                        && !ownershipExpressionReorderInert(
                            generator, left))) {
                return true;
            }
            rightIndex = rightIndex + 1;
        }
        leftIndex = leftIndex + 1;
    }
    return false;
}

Node? ownershipInstanceReceiver(IRGen generator, Node call) {
    if (call.callee == null
            || call.callee.kind != NK_FIELD_ACCESS_EXPR) { return null; }
    Node receiver = call.callee.obj;
    if (receiver != null && receiver.kind == NK_IDENTIFIER
            && (generator.analyzed.isClass(receiver.name)
                || generator.analyzed.isGenericClass(receiver.name)
                || generator.analyzed.isRichEnum(receiver.name))) {
        return null;
    }
    return receiver;
}

Node? ownershipEvaluatedCallee(IRGen generator, Node call,
        Map<string, Node> varTypes) {
    Node? callee = call.callee;
    if (callee == null) { return null; }
    if (callee.kind == NK_IDENTIFIER) {
        if (generator.hasClosureEnv(callee.name)
                || !varTypes.has(callee.name)
                || directFunctionPointerType(
                    generator.resolvedExpressionType(callee, varTypes),
                    generator.analyzed) == null) {
            return null;
        }
        return callee;
    }
    if (callee.kind == NK_FIELD_ACCESS_EXPR
            || callee.kind == NK_LAMBDA_EXPR) {
        return null;
    }
    return callee;
}

bool ownershipCallableFieldCall(IRGen generator, Node call,
        Map<string, Node> varTypes) {
    return call.callee != null
        && call.callee.kind == NK_FIELD_ACCESS_EXPR
        && directFunctionPointerType(
            generator.resolvedExpressionType(call.callee, varTypes),
            generator.analyzed) != null;
}

bool ownershipCallNeedsBoundary(bool receiverGuarded, bool forceOrder,
        Vector<OwnershipCallOperand> operands) {
    if (receiverGuarded || forceOrder) { return true; }
    int index = 0;
    while (index < operands.len) {
        OwnershipCallOperand operand = operands.get(index);
        if (operand.defaultArgument || operand.owned || operand.keepValue
                || operand.needsConversion) { return true; }
        index = index + 1;
    }
    return false;
}

IRNode lowerCallWithOwnership(IRGen generator, Node call,
        Map<string, Node> varTypes) {
    if (generator.unevaluatedDepth > 0) {
        return generator.lowerCallCore(call, varTypes);
    }
    generator.rejectCallClosureEscapes(call, varTypes);
    if (call.callee != null
            && call.callee.kind == NK_FIELD_ACCESS_EXPR
            && call.callee.optional) {
        return generator.lowerCallCore(call, varTypes);
    }
    if (call.callee != null
            && call.callee.kind == NK_IDENTIFIER
            && generator.gpu.kernels.has(call.callee.name)
            && !generator.hasClosureEnv(call.callee.name)
            && !varTypes.has(call.callee.name)) {
        return generator.lowerCallCore(call, varTypes);
    }
    Node? declaration = ownershipCallableForCall(
        generator, call, varTypes);
    Vector<Node> params = ownershipParamsForCall(
        generator, call, varTypes);
    Vector<OwnershipCallOperand> operands = ownershipCallOperands(
        generator, call, params, varTypes);
    Node? receiver = null;
    if (ownershipCallableFieldCall(generator, call, varTypes)) {
        /* A callable projection is the actual leading call operand. Freezing
         * only its receiver would let argument side effects replace the field
         * before C chooses the function pointer. */
        receiver = call.callee;
    } else {
        receiver = ownershipInstanceReceiver(generator, call);
    }
    if (receiver == null) {
        receiver = ownershipEvaluatedCallee(generator, call, varTypes);
    }
    Node? receiverType = null;
    bool receiverOwned = false;
    if (receiver != null) {
        receiverType = generator.resolvedExpressionType(
            receiver, varTypes);
        receiverOwned = irManagedType(generator, receiverType)
            && irUnconsumedOwnedResult(generator, receiver, varTypes);
    }
    bool operandEffect = ownershipOperandsHaveEffect(
        generator, operands, varTypes);
    bool receiverPinned = receiver != null
        && irManagedType(generator, receiverType)
        && !receiverOwned
        && receiver.kind != NK_SELF_EXPR
        && receiver.kind != NK_SUPER_EXPR
        && (operandEffect || declaration != null);
    Node? calleeType = generator.resolvedExpressionType(
        call.callee, varTypes);
    bool orderedFieldCall = call.callee != null
        && call.callee.kind == NK_FIELD_ACCESS_EXPR
        && ((receiverType != null
                && irManagedMutexType(generator, receiverType))
            || (call.callee.obj != null
                && call.callee.obj.kind == NK_IDENTIFIER
                && generator.analyzed.isRichEnum(
                    call.callee.obj.name)));
    bool orderedBuiltin = call.callee != null
        && call.callee.kind == NK_IDENTIFIER
        && (call.callee.name == "Mutex"
            || call.callee.name == "print"
            || call.callee.name == "printf");
    bool orderedHosted = generator.analyzed.hostedCallKeys.has(
        astNodeKey(call));
    bool languageCall = declaration != null || params.len > 0
        || orderedFieldCall
        || orderedBuiltin
        || orderedHosted
        || directFunctionPointerType(
            calleeType, generator.analyzed) != null;
    bool forceOrder = languageCall
        && ownershipCallRequiresOrder(
            generator, receiver, operands, varTypes)
        && operands.len + (receiver == null ? 0 : 1) > 1;
    string callKey = astNodeKey(call);
    bool convertsHostedResult =
        generator.hostedResultConversionModes.has(callKey);
    bool hasProjectionRoots = ownershipCallHasProjectionRoots(
        generator, call, receiver, operands, varTypes);
    if (!ownershipCallNeedsBoundary(
            receiverOwned || receiverPinned || hasProjectionRoots,
            forceOrder, operands)) {
        return lowerRequestedHostedStringResult(
            generator, call,
            generator.lowerCallCore(call, varTypes));
    }
    OwnershipBoundary boundary = OwnershipBoundary();
    if (receiver != null) {
        ownershipAddCallProjectionRoots(
            boundary, generator, receiver, varTypes);
        if (receiverType == null) {
            opaqueOperandOrderFail(
                receiver, "call arguments", true);
        }
        boundary.addOperand(generator, receiver, receiverType,
            receiverOwned, receiverPinned, varTypes);
    }
    int index = 0;
    while (index < operands.len) {
        OwnershipCallOperand operand = operands.get(index);
        ownershipAddCallProjectionRootsWithPolicy(
            boundary, generator, operand.expression, varTypes,
            ownershipCallOmitsBorrowedProjectionGuard(
                generator, call, operands, index, varTypes));
        if (operand.typeExpr == null) {
            bool trailing = index + 1 == operands.len
                && (index > 0 || receiver != null)
                && !operand.owned && !operand.keepValue;
            if (!trailing) {
                opaqueOperandOrderFail(
                    operand.expression, "call arguments", true);
            }
        } else {
            if (operand.defaultArgument) {
                Node effectiveType = operand.targetType;
                boundary.addLoweredCallOperand(generator,
                    operand.expression, effectiveType,
                    lowerDefaultArgumentCall(generator, call,
                        params, operands, operand, varTypes),
                    irManagedType(generator, effectiveType),
                    operand.keepValue,
                    irManagedType(generator, effectiveType)
                        && operand.transferred);
            } else {
                PreparedValue prepared = prepareCallTargetValue(
                    generator, operand.expression,
                    operand.targetType, varTypes);
                ownershipRequireType(
                    prepared.effectiveType, operand.expression);
                Node effectiveType = prepared.effectiveType;
                boundary.addLoweredCallOperand(generator,
                    operand.expression, effectiveType, prepared.value,
                    prepared.owned, operand.keepValue,
                    prepared.owned && operand.transferred);
            }
        }
        index = index + 1;
    }
    IRNode lowered = lowerRequestedHostedStringResult(
        generator, call,
        generator.lowerCallCore(call, varTypes));
    boundary.resultOwned = convertsHostedResult
        || irExpressionOwnsResult(generator, call, varTypes);
    boundary.restore(generator);
    Node? resultType = generator.resolvedExpressionType(call, varTypes);
    if (convertsHostedResult) { resultType = makePrimType("string"); }
    return boundary.finish(generator, lowered,
        resultType, false);
}

IRNode lowerNewWithOwnership(IRGen generator, Node expression,
        Map<string, Node> varTypes) {
    if (generator.unevaluatedDepth > 0) {
        return generator.lowerNewCore(expression, varTypes);
    }
    Vector<Node> params = ownershipParamsForCall(
        generator, expression, varTypes);
    Vector<OwnershipCallOperand> operands = ownershipCallOperands(
        generator, expression, params, varTypes);
    bool forceOrder = operands.len > 1
        && ownershipOperandsHaveConcreteTypes(operands)
        && ownershipOperandsHaveEffect(generator, operands, varTypes);
    bool hasProjectionRoots = ownershipCallHasProjectionRoots(
        generator, expression, null, operands, varTypes);
    if (!ownershipCallNeedsBoundary(
            hasProjectionRoots, forceOrder, operands)) {
        return generator.lowerNewCore(expression, varTypes);
    }
    OwnershipBoundary boundary = OwnershipBoundary();
    int index = 0;
    while (index < operands.len) {
        OwnershipCallOperand operand = operands.get(index);
        ownershipAddCallProjectionRootsWithPolicy(
            boundary, generator, operand.expression, varTypes,
            ownershipCallOmitsBorrowedProjectionGuard(
                generator, expression, operands, index, varTypes));
        if (operand.defaultArgument) {
            Node effectiveType = operand.targetType;
            boundary.addLoweredCallOperand(generator,
                operand.expression, effectiveType,
                lowerDefaultArgumentCall(generator, expression,
                    params, operands, operand, varTypes),
                irManagedType(generator, effectiveType),
                operand.keepValue,
                irManagedType(generator, effectiveType)
                    && operand.transferred);
        } else {
            PreparedValue prepared = prepareCallTargetValue(
                generator, operand.expression,
                operand.targetType, varTypes);
            ownershipRequireType(
                prepared.effectiveType, operand.expression);
            Node effectiveType = prepared.effectiveType;
            boundary.addLoweredCallOperand(generator,
                operand.expression, effectiveType, prepared.value,
                prepared.owned, operand.keepValue,
                prepared.owned && operand.transferred);
        }
        index = index + 1;
    }
    IRNode lowered = generator.lowerNewCore(expression, varTypes);
    boundary.resultOwned = irManagedType(generator,
        generator.resolvedExpressionType(expression, varTypes));
    boundary.restore(generator);
    return boundary.finish(generator, lowered,
        generator.resolvedExpressionType(expression, varTypes), false);
}
