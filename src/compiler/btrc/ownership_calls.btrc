/* Call-scoped ownership planning for source calls and constructors. */

class OwnershipCallOperand {
    public Node expression;
    public Node typeExpr;
    public bool owned;
    public bool keepValue;
    public bool transferred;

    public OwnershipCallOperand(Node expression, Node typeExpr,
            bool owned, bool keepValue, bool transferred) {
        self.expression = expression;
        self.typeExpr = typeExpr;
        self.owned = owned;
        self.keepValue = keepValue;
        self.transferred = transferred;
    }
}

Vector<Node> ownershipParamsForCall(IRGen generator, Node call,
        Map<string, Node> varTypes) {
    Vector<Node> empty = [];
    Node? declaration = ownershipCallableForCall(
        generator, call, varTypes);
    if (declaration == null) { return empty; }
    return declaration.params;
}

Node ownershipResolveParamType(IRGen generator, Node call,
        Node paramType, Map<string, Node> varTypes) {
    Node result = generator.resolveBodyType(paramType);
    Node? instanceType = null;
    if (call.kind == NK_NEW_EXPR) {
        instanceType = generator.resolveBodyType(call.type);
    } else if (call.callee != null
            && call.callee.kind == NK_FIELD_ACCESS_EXPR) {
        instanceType = generator.resolvedExpressionType(
            call.callee.obj, varTypes);
    } else {
        instanceType = generator.resolvedExpressionType(call, varTypes);
    }
    if (instanceType != null && instanceType.generic_args.len > 0
            && generator.analyzed.isGenericClass(instanceType.base)) {
        result = resolveGenericType(paramType,
            genericTypeMap(generator.analyzed, instanceType));
    }
    return result;
}

int ownershipNamedParamIndex(Vector<Node> params, string name) {
    int index = 0;
    while (index < params.len) {
        if (params.get(index).name == name) { return index; }
        index = index + 1;
    }
    return -1;
}

Vector<OwnershipCallOperand> ownershipCallOperands(IRGen generator,
        Node call, Vector<Node> params, Map<string, Node> varTypes) {
    Vector<OwnershipCallOperand> result = [];
    Map<int, bool> transferredParams = ownershipOwnedTransferParams(
        ownershipCallableForCall(generator, call, varTypes));
    Map<int, bool> bound = {};
    int positional = 0;
    int index = 0;
    while (index < call.args.len) {
        Node argument = call.args.get(index);
        int paramIndex = positional;
        string argumentName = "";
        if (index < call.arg_names.len) {
            argumentName = call.arg_names.get(index);
        }
        if (argumentName != "") {
            paramIndex = ownershipNamedParamIndex(params, argumentName);
        } else {
            positional = positional + 1;
        }
        Node? argumentType = generator.resolvedExpressionType(
            argument, varTypes);
        bool keepValue = false;
        if (paramIndex >= 0 && paramIndex < params.len) {
            bound.put(paramIndex, true);
            Node parameter = params.get(paramIndex);
            if (argumentType == null) {
                argumentType = ownershipResolveParamType(
                    generator, call, parameter.type, varTypes);
            }
            keepValue = parameter.keep_;
        }
        bool managed = irManagedType(generator, argumentType);
        bool owned = managed && irContextualUnconsumedOwnedResult(
            generator, argument, argumentType, varTypes);
        result.push(OwnershipCallOperand(argument, argumentType,
            owned, managed && keepValue,
            owned && transferredParams.has(paramIndex)));
        index = index + 1;
    }
    int parameterIndex = 0;
    while (parameterIndex < params.len) {
        Node parameter = params.get(parameterIndex);
        if (!bound.has(parameterIndex) && parameter.default_ != null) {
            Node argument = parameter.default_;
            Node? argumentType = generator.resolvedExpressionType(
                argument, varTypes);
            if (argumentType == null) {
                argumentType = ownershipResolveParamType(
                    generator, call, parameter.type, varTypes);
            }
            bool managed = irManagedType(generator, argumentType);
            bool owned = managed && irContextualUnconsumedOwnedResult(
                generator, argument, argumentType, varTypes);
            result.push(OwnershipCallOperand(argument, argumentType,
                owned, managed && parameter.keep_,
                owned && transferredParams.has(parameterIndex)));
        }
        parameterIndex = parameterIndex + 1;
    }
    int pinIndex = 0;
    while (pinIndex + 1 < result.len) {
        OwnershipCallOperand operand = result.get(pinIndex);
        bool laterEffect = false;
        int laterIndex = pinIndex + 1;
        while (laterIndex < result.len) {
            if (ownershipExpressionHasEffect(generator,
                    result.get(laterIndex).expression, varTypes)) {
                laterEffect = true;
            }
            laterIndex = laterIndex + 1;
        }
        if (laterEffect && !operand.owned
                && irManagedType(generator, operand.typeExpr)) {
            operand.keepValue = true;
        }
        pinIndex = pinIndex + 1;
    }
    return result;
}

bool ownershipOperandsHaveConcreteTypes(
        Vector<OwnershipCallOperand> operands) {
    int index = 0;
    while (index < operands.len) {
        if (operands.get(index).typeExpr == null) { return false; }
        index = index + 1;
    }
    return true;
}

bool ownershipOperandsHaveEffect(IRGen generator,
        Vector<OwnershipCallOperand> operands,
        Map<string, Node> varTypes) {
    int index = 0;
    while (index < operands.len) {
        if (ownershipExpressionHasEffect(
                generator, operands.get(index).expression, varTypes)) {
            return true;
        }
        index = index + 1;
    }
    return false;
}

bool ownershipCallRequiresOrder(IRGen generator, Node? receiver,
        Vector<OwnershipCallOperand> operands,
        Map<string, Node> varTypes) {
    Vector<Node> expressions = [];
    if (receiver != null) { expressions.push(receiver); }
    int operandIndex = 0;
    while (operandIndex < operands.len) {
        expressions.push(operands.get(operandIndex).expression);
        operandIndex = operandIndex + 1;
    }
    int leftIndex = 0;
    while (leftIndex < expressions.len) {
        Node left = expressions.get(leftIndex);
        bool leftEffect = ownershipExpressionHasEffect(
            generator, left, varTypes);
        int rightIndex = leftIndex + 1;
        while (rightIndex < expressions.len) {
            Node right = expressions.get(rightIndex);
            bool rightEffect = ownershipExpressionHasEffect(
                generator, right, varTypes);
            if ((leftEffect
                    && !ownershipExpressionReorderInert(generator, right))
                    || (rightEffect
                        && !ownershipExpressionReorderInert(
                            generator, left))) {
                return true;
            }
            rightIndex = rightIndex + 1;
        }
        leftIndex = leftIndex + 1;
    }
    return false;
}

Node? ownershipInstanceReceiver(IRGen generator, Node call) {
    if (call.callee == null
            || call.callee.kind != NK_FIELD_ACCESS_EXPR) { return null; }
    Node receiver = call.callee.obj;
    if (receiver != null && receiver.kind == NK_IDENTIFIER
            && (generator.analyzed.isClass(receiver.name)
                || generator.analyzed.isGenericClass(receiver.name)
                || generator.analyzed.isRichEnum(receiver.name))) {
        return null;
    }
    return receiver;
}

Node? ownershipEvaluatedCallee(Node call) {
    Node? callee = call.callee;
    if (callee == null || callee.kind == NK_IDENTIFIER
            || callee.kind == NK_FIELD_ACCESS_EXPR
            || callee.kind == NK_LAMBDA_EXPR) {
        return null;
    }
    return callee;
}

bool ownershipCallNeedsBoundary(bool receiverGuarded, bool forceOrder,
        Vector<OwnershipCallOperand> operands) {
    if (receiverGuarded || forceOrder) { return true; }
    int index = 0;
    while (index < operands.len) {
        OwnershipCallOperand operand = operands.get(index);
        if (operand.owned || operand.keepValue) { return true; }
        index = index + 1;
    }
    return false;
}

IRNode lowerCallWithOwnership(IRGen generator, Node call,
        Map<string, Node> varTypes) {
    if (call.callee != null
            && call.callee.kind == NK_FIELD_ACCESS_EXPR
            && call.callee.optional) {
        return generator.lowerCallCore(call, varTypes);
    }
    Node? declaration = ownershipCallableForCall(
        generator, call, varTypes);
    Vector<Node> params = [];
    if (declaration != null) { params = declaration.params; }
    Vector<OwnershipCallOperand> operands = ownershipCallOperands(
        generator, call, params, varTypes);
    Node? receiver = ownershipInstanceReceiver(generator, call);
    if (receiver == null) {
        receiver = ownershipEvaluatedCallee(call);
    }
    Node? receiverType = null;
    bool receiverOwned = false;
    if (receiver != null) {
        receiverType = generator.resolvedExpressionType(
            receiver, varTypes);
        receiverOwned = irManagedType(generator, receiverType)
            && irUnconsumedOwnedResult(generator, receiver, varTypes);
    }
    bool operandEffect = ownershipOperandsHaveEffect(
        generator, operands, varTypes);
    bool receiverPinned = receiver != null && operandEffect
        && irManagedType(generator, receiverType)
        && !receiverOwned;
    Node? calleeType = generator.resolvedExpressionType(
        call.callee, varTypes);
    bool languageCall = declaration != null
        || (calleeType != null && calleeType.base == "__fn_ptr");
    bool forceOrder = languageCall
        && ownershipCallRequiresOrder(
            generator, receiver, operands, varTypes)
        && operands.len + (receiver == null ? 0 : 1) > 1;
    if (!ownershipCallNeedsBoundary(
            receiverOwned || receiverPinned, forceOrder, operands)) {
        return generator.lowerCallCore(call, varTypes);
    }
    OwnershipBoundary boundary = OwnershipBoundary();
    if (receiver != null) {
        if (receiverType == null) {
            opaqueOperandOrderFail(
                receiver, "call arguments", true);
        }
        boundary.addOperand(generator, receiver, receiverType,
            receiverOwned, receiverPinned, varTypes);
    }
    int index = 0;
    while (index < operands.len) {
        OwnershipCallOperand operand = operands.get(index);
        if (operand.typeExpr == null) {
            bool trailing = index + 1 == operands.len
                && (index > 0 || receiver != null)
                && !operand.owned && !operand.keepValue;
            if (!trailing) {
                opaqueOperandOrderFail(
                    operand.expression, "call arguments", true);
            }
        } else {
            boundary.addCallOperand(generator, operand.expression,
                operand.typeExpr, operand.owned, operand.keepValue,
                operand.transferred, varTypes);
        }
        index = index + 1;
    }
    IRNode lowered = generator.lowerCallCore(call, varTypes);
    boundary.restore(generator);
    return boundary.finish(generator, lowered,
        generator.resolvedExpressionType(call, varTypes), false);
}

IRNode lowerNewWithOwnership(IRGen generator, Node expression,
        Map<string, Node> varTypes) {
    Node? constructor = generator.analyzed.classConstructor(
        expression.type.base);
    if (constructor == null) {
        constructor = generator.analyzed.genericClassConstructor(
            expression.type.base);
    }
    Vector<Node> params = [];
    if (constructor != null) { params = constructor.params; }
    Vector<OwnershipCallOperand> operands = ownershipCallOperands(
        generator, expression, params, varTypes);
    bool forceOrder = operands.len > 1
        && ownershipOperandsHaveConcreteTypes(operands)
        && ownershipOperandsHaveEffect(generator, operands, varTypes);
    if (!ownershipCallNeedsBoundary(false, forceOrder, operands)) {
        return generator.lowerNewCore(expression, varTypes);
    }
    OwnershipBoundary boundary = OwnershipBoundary();
    int index = 0;
    while (index < operands.len) {
        OwnershipCallOperand operand = operands.get(index);
        boundary.addCallOperand(generator, operand.expression,
            operand.typeExpr, operand.owned, operand.keepValue,
            operand.transferred, varTypes);
        index = index + 1;
    }
    IRNode lowered = generator.lowerNewCore(expression, varTypes);
    boundary.restore(generator);
    return boundary.finish(generator, lowered,
        generator.resolvedExpressionType(expression, varTypes), false);
}
