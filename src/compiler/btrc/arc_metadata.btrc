/* Concrete ARC metadata attached to every managed object representation. */

string arcDescriptorSymbol(string emittedName) {
    return "__btrc_" + emittedName + "_arc_type";
}

IRNode arcHeaderMember(IRNode value, string member) {
    return irFieldAccess(
        irFieldAccess(value, "__arc", true), member, false);
}

void appendArcHeaderField(IRGen generator, IRStructDef definition) {
    generator.useHelper("__btrc_arc_callback_types");
    definition.fields.push(IRStructField("__btrc_arc_header", "__arc"));
}

void appendArcHeaderInitialization(
        string emittedName, Vector<IRNode> output) {
    output.push(irAssign(
        arcHeaderMember(irVar("self"), "rc"), irLiteral("1")));
    output.push(irAssign(
        arcHeaderMember(irVar("self"), "edge_rc"), irLiteral("0")));
    output.push(irAssign(
        arcHeaderMember(irVar("self"), "live_witness"), irLiteral("NULL")));
    output.push(irAssign(
        arcHeaderMember(irVar("self"), "type"),
        irAddressOf(irVar(arcDescriptorSymbol(emittedName)))));
    output.push(irAssign(
        arcHeaderMember(irVar("self"), "incoming"), irLiteral("NULL")));
}

void emitArcDescriptor(IRGen generator, IRModule module,
        string emittedName, bool hasVisitor) {
    generator.useHelper("__btrc_arc_callback_types");
    IRGlobalDecl descriptor = IRGlobalDecl(
        "const __btrc_arc_type", arcDescriptorSymbol(emittedName));
    Vector<IRNode> values = [];
    if (hasVisitor) {
        values.push(irVar(cycleVisitorName(emittedName)));
    } else {
        values.push(irLiteral("NULL"));
    }
    values.push(irVar(emittedName + "_destroy"));
    descriptor.init = irInitializerList(values);
    module.global_decls.push(descriptor);
}
