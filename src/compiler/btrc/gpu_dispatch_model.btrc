/* Per-call argument evaluation and capacity metadata for GPU dispatch. */

class GpuPreparedCall {
    public Vector<IRNode> declarations;
    public Vector<IRNode> sequence;
    public Vector<IRNode> cleanup;
    public Vector<IRNode> helper_args;
    public IRNode dispatch_length;

    public GpuPreparedCall() {
        self.declarations = [];
        self.sequence = [];
        self.cleanup = [];
        self.helper_args = [];
        self.dispatch_length = irLiteral("1");
    }
}

class GpuOutputTargetPlan {
    public Vector<IRNode> declarations;
    public Vector<IRNode> sequence;
    public Vector<IRNode> cleanup;
    public IRNode data;
    public IRNode capacity;

    public GpuOutputTargetPlan() {
        self.declarations = [];
        self.sequence = [];
        self.cleanup = [];
        self.data = null;
        self.capacity = null;
    }
}

IRNode gpuBareArrayCapacity(IRNode target) {
    IRNode denominator = irSizeofExpr(
        irIndex(target, irLiteral("0")));
    return irBinOp(irSizeofExpr(target), "/", denominator);
}

IRNode? gpuBackedGlobalArrayCapacity(IRGen gen, IRNode storage) {
    if (storage == null || storage.kind != IRK_VAR) { return null; }
    int index = 0;
    while (index < gen.curModule.global_decls.len) {
        IRGlobalDecl declaration = gen.curModule.global_decls.get(index);
        if (declaration.name == storage.name) {
            if (declaration.array_size != null) {
                return gpuBareArrayCapacity(storage);
            }
            return null;
        }
        index = index + 1;
    }
    return null;
}

IRNode gpuKnownArrayLength(IRGen gen, Node expression) {
    if (expression == null || expression.kind != NK_IDENTIFIER) {
        gpuLoweringFail(expression,
            "GPU array argument must be a named array with a known capacity");
    }
    string name = expression.name;
    if (gen.gpuHost.array_lengths.has(name)) {
        return gen.gpuHost.array_lengths.get(name);
    }
    if (gen.gpuHost.unknown_array_lengths.has(name)) {
        gpuLoweringFail(expression,
            "GPU array argument has no provable capacity in this scope");
    }
    string cName = gen.sourceLexicalReferenceCName(name);
    IRNode? globalCapacity = gpuBackedGlobalArrayCapacity(
        gen, irVar(cName));
    if (globalCapacity != null) { return globalCapacity; }
    gpuLoweringFail(expression,
        "GPU array argument has no provable capacity in this scope");
    return irLiteral("0");
}

IRNode lowerGpuDefaultArgumentCall(IRGen gen, Node call,
        Vector<Node> parameters, Vector<OwnershipCallOperand> operands,
        OwnershipCallOperand operand, Map<string, IRNode> parameterValues,
        Map<string, Node> varTypes) {
    Map<string, IRNode> saved = {};
    Vector<string> changed = [];
    int prior = 0;
    while (prior < operand.parameterIndex) {
        OwnershipCallOperand? bound = defaultArgumentBoundOperand(
            operands, prior);
        string parameterKey = Strings.fromInt(prior);
        if (bound != null && parameterValues.has(parameterKey)) {
            OwnershipCallOperand concrete = bound;
            string expressionKey = astNodeKey(concrete.expression);
            if (gen.owningTempOverrides.has(expressionKey)) {
                if (!saved.has(expressionKey)) {
                    saved.put(expressionKey,
                        gen.owningTempOverrides.get(expressionKey));
                    changed.push(expressionKey);
                }
                gen.owningTempOverrides.put(
                    expressionKey, parameterValues.get(parameterKey));
            }
        }
        prior = prior + 1;
    }
    IRNode result = lowerDefaultArgumentCall(
        gen, call, parameters, operands, operand, varTypes);
    int index = 0;
    while (index < changed.len) {
        string key = changed.get(index);
        gen.owningTempOverrides.put(key, saved.get(key));
        index = index + 1;
    }
    return result;
}

GpuPreparedCall prepareGpuCall(IRGen gen, IRGpuKernel kernel, Node call,
        Vector<IRNode> loweredArgs, Map<string, Node> varTypes,
        bool lowerExplicitArguments) {
    GpuPreparedCall prepared = GpuPreparedCall();
    Node declaration = kernel.declaration;
    Vector<OwnershipCallOperand> operands = ownershipCallOperands(
        gen, call, declaration.params, varTypes);
    OwnershipBoundary boundary = OwnershipBoundary();
    Map<string, IRNode> values = {};
    Map<string, IRNode> lengths = {};
    int sourceIndex = 0;
    int a = 0;
    while (a < operands.len) {
        OwnershipCallOperand operand = operands.get(a);
        int slot = operand.parameterIndex;
        if (slot < 0 || slot >= declaration.params.len) {
            gpuLoweringFail(call, "GPU argument has no parameter binding");
        }
        Node parameter = declaration.params.get(slot);
        string key = Strings.fromInt(slot);
        Node expression = operand.expression;
        string expressionKey = astNodeKey(expression);
        bool preLowered = gen.owningTempOverrides.has(expressionKey);
        IRNode lowered = null;
        if (preLowered) {
            lowered = gen.owningTempOverrides.get(expressionKey);
        } else if (operand.defaultArgument) {
            lowered = lowerGpuDefaultArgumentCall(
                gen, call, declaration.params,
                operands, operand, values, varTypes);
        } else if (lowerExplicitArguments) {
            gpuAddInputProjectionRoots(
                boundary, gen, expression, varTypes);
            lowered = gen.lowerExpr(expression, varTypes);
        } else {
            if (sourceIndex >= loweredArgs.len) {
                gpuLoweringFail(call,
                    "GPU argument was not lowered exactly once");
            }
            lowered = loweredArgs.get(sourceIndex);
            sourceIndex = sourceIndex + 1;
        }
        Node argumentType = parameter.type;
        if (operand.typeExpr != null) {
            argumentType = operand.typeExpr;
        }
        boundary.addLoweredOperand(gen, expression, argumentType,
            lowered, operand.owned && !preLowered,
            operand.keepValue);
        IRNode stable = gen.owningTempOverrides.get(expressionKey);
        values.put(key, stable);
        if (parameter.type.is_array) {
            int inheritedLengthSlot = -1;
            if (operand.defaultArgument
                    && expression.kind == NK_IDENTIFIER) {
                int prior = 0;
                while (prior < slot) {
                    Node priorParameter = declaration.params.get(prior);
                    if (priorParameter.name == expression.name
                            && priorParameter.type.is_array) {
                        inheritedLengthSlot = prior;
                    }
                    prior = prior + 1;
                }
            }
            if (gpuHeapCollection(argumentType)) {
                string dataName = gen.freshTemp("__btrc_gpu_data");
                string lengthName = gen.freshTemp("__btrc_gpu_len");
                IRNode dataDeclaration = irVarDecl(
                    typeToC(parameter.type, gen.analyzed),
                    dataName, null);
                IRNode lengthDeclaration = irVarDecl(
                    "int", lengthName, null);
                boundary.declarations.push(dataDeclaration);
                boundary.declarations.push(lengthDeclaration);
                gen.funcVarDecls.push(dataDeclaration);
                gen.funcVarDecls.push(lengthDeclaration);
                boundary.prefix.push(irBinOp(irVar(dataName), "=",
                    irFieldAccess(stable, "data", true)));
                boundary.prefix.push(irBinOp(irVar(lengthName), "=",
                    irFieldAccess(stable, "len", true)));
                values.put(key, irVar(dataName));
                lengths.put(key, irVar(lengthName));
            } else if (inheritedLengthSlot >= 0
                    && lengths.has(Strings.fromInt(
                        inheritedLengthSlot))) {
                lengths.put(key, lengths.get(Strings.fromInt(
                    inheritedLengthSlot)));
            } else {
                string lengthName = gen.freshTemp("__btrc_gpu_len");
                IRNode lengthDeclaration = irVarDecl(
                    "int", lengthName, null);
                boundary.declarations.push(lengthDeclaration);
                gen.funcVarDecls.push(lengthDeclaration);
                boundary.prefix.push(irBinOp(irVar(lengthName), "=",
                    gpuArrayArgumentCapacity(
                        gen, expression, lowered,
                        varTypes)));
                lengths.put(key, irVar(lengthName));
            }
        }
        a = a + 1;
    }
    if (!lowerExplicitArguments
            && sourceIndex != loweredArgs.len) {
        gpuLoweringFail(call,
            "GPU arguments were not bound exactly once");
    }
    prepared.declarations = boundary.declarations;
    prepared.sequence = boundary.prefix;
    prepared.cleanup = boundary.suffix;
    boundary.restore(gen);
    bool hasDispatchLength = false;
    int p = 0;
    while (p < declaration.params.len) {
        string key = Strings.fromInt(p);
        Node parameter = declaration.params.get(p);
        if (!values.has(key)) {
            gpuLoweringFail(call, "missing GPU argument '"
                + parameter.name + "'");
        }
        prepared.helper_args.push(values.get(key));
        if (parameter.type.is_array) {
            if (!lengths.has(key)) {
                gpuLoweringFail(call, "GPU array length is unavailable");
            }
            prepared.helper_args.push(lengths.get(key));
            if (!hasDispatchLength) {
                prepared.dispatch_length = lengths.get(key);
                hasDispatchLength = true;
            }
        }
        p = p + 1;
    }
    return prepared;
}

bool gpuHeapCollection(Node? typeExpr) {
    return typeExpr != null
        && (typeExpr.base == "Array" || typeExpr.base == "Vector")
        && typeExpr.generic_args.len > 0;
}

Node? gpuResolvedHostType(IRGen gen, Node expression,
        Map<string, Node> varTypes) {
    Node? result = gen.resolvedExpressionType(expression, varTypes);
    if (result == null) { return null; }
    result = gen.resolveBodyType(result);
    return resolveOuterTypedefType(
        result, gen.analyzed.typedefTable);
}

IRNode gpuArrayArgumentCapacity(IRGen gen, Node expression,
        IRNode loweredExpression, Map<string, Node> varTypes) {
    if (expression != null && expression.kind == NK_IDENTIFIER) {
        return gpuKnownArrayLength(gen, expression);
    }
    Node? argumentType = gpuResolvedHostType(
        gen, expression, varTypes);
    if (argumentType != null && argumentType.pointer_depth == 0
            && argumentType.is_array) {
        if (argumentType.array_size != null) {
            return gpuBareArrayCapacity(loweredExpression);
        }
        IRNode? globalCapacity = gpuBackedGlobalArrayCapacity(
            gen, loweredExpression);
        if (globalCapacity != null) { return globalCapacity; }
    }
    gpuLoweringFail(expression,
        "GPU array argument has no provable capacity in this scope");
    return irLiteral("0");
}

string gpuCElementType(IRGpuKernel kernel) {
    if (kernel.output_buffer != null
            && kernel.output_buffer.elem_type == "f32") { return "float"; }
    return "int";
}
