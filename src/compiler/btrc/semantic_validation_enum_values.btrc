/* Simple-enum initializer contracts and partial value evaluation. */

void semanticStoreEnumConstant(string owner, string member,
        SemanticIntegerConstant value, SemanticValidationState state) {
    string key = semanticEnumConstantKey(owner, member);
    state.enumConstantKnown.put(key, value.known);
    if (value.known) {
        state.enumConstantValues.put(key, (int)value.value);
    }
}

void semanticValidateEnumValues(
        Node declaration, SemanticValidationState state) {
    Map<string, bool> prior = {};
    bool previousKnown = true;
    long long previous = -1;
    int index = 0;
    while (index < declaration.values.len) {
        Node value = declaration.values.get(index);
        SemanticIntegerConstant result = semanticUnknownConstant();
        if (value.value_node != null) {
            result = semanticIntegerConstant(value.value_node, state,
                true, declaration.name, prior);
            if (!result.valid) {
                semanticValidationFail("Enum value '" + value.name
                    + "' requires an integral constant expression using only "
                    + "earlier members", value);
            }
        } else if (previousKnown) {
            if (previous >= INT_MAX) {
                semanticValidationFail("Implicit enum value '" + value.name
                    + "' is outside the strict-C11 int range", value);
            }
            result = semanticKnownConstant(previous + 1);
        }
        if (result.known
                && (result.value < INT_MIN || result.value > INT_MAX)) {
            semanticValidationFail("Enum value '" + value.name
                + "' is outside the strict-C11 int range", value);
        }
        semanticStoreEnumConstant(
            declaration.name, value.name, result, state);
        previousKnown = result.known;
        if (result.known) { previous = result.value; }
        prior.put(value.name, true);
        index = index + 1;
    }
}

void semanticValidateProgramEnumValues(
        Node program, SemanticValidationState state) {
    int index = 0;
    while (index < program.declarations.len) {
        Node declaration = program.declarations.get(index);
        if (declaration.kind == NK_ENUM_DECL) {
            semanticValidateEnumValues(declaration, state);
        }
        index = index + 1;
    }
}
