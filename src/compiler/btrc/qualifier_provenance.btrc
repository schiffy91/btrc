/* Declarator-aware const/volatile provenance through typedef boundaries.
 * Depth zero is the declared object; depth one is reached through one
 * pointer/array layer.  Keeping this query separate from alias flattening
 * prevents `typedef volatile int V; V*` from becoming a volatile pointer. */

int qualifierAppliedStorageLayers(Node typeExpr, Node? target) {
    bool referenceShape = target != null
        && TypeComposition.resolvedReferenceShape(target);
    int pointerDepth = typeExpr.pointer_depth;
    if (TypeComposition.nullableCollapsesReferenceLayer(
            typeExpr, referenceShape)) {
        pointerDepth = pointerDepth - 1;
    }
    return pointerDepth + (typeExpr.is_array ? 1 : 0);
}

bool typeVolatileAtDepthInner(Node? typeExpr,
        Map<string, Node> typedefs, int depth,
        Map<string, bool> visiting) {
    if (typeExpr == null || depth < 0) { return false; }
    int directDepth = typeExpr.is_array ? 1 : 0;
    if (typeExpr.is_volatile && depth == directDepth) { return true; }
    if (typeExpr.generic_args.len > 0
            || !typedefs.has(typeExpr.base)
            || visiting.has(typeExpr.base)) {
        return false;
    }
    visiting.put(typeExpr.base, true);
    Node target = typedefs.get(typeExpr.base);
    int shift = qualifierAppliedStorageLayers(typeExpr, target);
    bool result = typeVolatileAtDepthInner(
        target, typedefs, depth - shift, visiting);
    visiting.remove(typeExpr.base);
    return result;
}

bool typeVolatileAtDepth(Node? typeExpr,
        Map<string, Node> typedefs, int depth) {
    Map<string, bool> visiting = {};
    return typeVolatileAtDepthInner(
        typeExpr, typedefs, depth, visiting);
}

bool typeConstAtDepthInner(Node? typeExpr,
        Map<string, Node> typedefs, int depth,
        Map<string, bool> visiting) {
    if (typeExpr == null || depth < 0) { return false; }
    Node? target = null;
    if (typeExpr.generic_args.len == 0
            && typedefs.has(typeExpr.base)
            && !visiting.has(typeExpr.base)) {
        target = typedefs.get(typeExpr.base);
    }
    int shift = qualifierAppliedStorageLayers(typeExpr, target);
    int implicitDepth = 0;
    if (target == null && (typeExpr.base == "string"
            || typeExpr.base == "Thread"
            || typeExpr.base == "Mutex")) {
        implicitDepth = 1;
    }
    if (typeExpr.is_const && depth == shift + implicitDepth) {
        return true;
    }
    if (target == null) { return false; }
    visiting.put(typeExpr.base, true);
    bool result = typeConstAtDepthInner(
        target, typedefs, depth - shift, visiting);
    visiting.remove(typeExpr.base);
    return result;
}

bool typeConstAtDepth(Node? typeExpr,
        Map<string, Node> typedefs, int depth) {
    Map<string, bool> visiting = {};
    return typeConstAtDepthInner(
        typeExpr, typedefs, depth, visiting);
}

bool typeEffectiveOuterVolatile(Node? typeExpr,
        Map<string, Node> typedefs) {
    if (typeExpr == null) { return false; }
    if (typeExpr.is_volatile) { return true; }
    if (typeExpr.generic_args.len > 0
            || !typedefs.has(typeExpr.base)) {
        return false;
    }
    Node target = typedefs.get(typeExpr.base);
    bool referenceShape = TypeComposition.resolvedReferenceShape(target);
    int pointerDepth = typeExpr.pointer_depth;
    if (TypeComposition.nullableCollapsesReferenceLayer(
            typeExpr, referenceShape)) {
        pointerDepth = pointerDepth - 1;
    }
    if (pointerDepth > 0) { return false; }
    Map<string, bool> visiting = {};
    return typeEffectiveOuterVolatileInner(
        target, typedefs, visiting);
}

bool typeEffectiveOuterVolatileInner(Node? typeExpr,
        Map<string, Node> typedefs,
        Map<string, bool> visiting) {
    if (typeExpr == null) { return false; }
    if (typeExpr.is_volatile) { return true; }
    if (typeExpr.generic_args.len > 0
            || !typedefs.has(typeExpr.base)
            || visiting.has(typeExpr.base)) {
        return false;
    }
    visiting.put(typeExpr.base, true);
    Node target = typedefs.get(typeExpr.base);
    bool referenceShape = TypeComposition.resolvedReferenceShape(target);
    int pointerDepth = typeExpr.pointer_depth;
    if (TypeComposition.nullableCollapsesReferenceLayer(
            typeExpr, referenceShape)) {
        pointerDepth = pointerDepth - 1;
    }
    bool result = false;
    if (pointerDepth == 0) {
        result = typeEffectiveOuterVolatileInner(
            target, typedefs, visiting);
    }
    visiting.remove(typeExpr.base);
    return result;
}

bool typeEffectiveOuterConst(Node? typeExpr,
        Map<string, Node> typedefs) {
    return typeConstAtDepth(typeExpr, typedefs, 0);
}

int typeVolatileMaxDepthInner(Node? typeExpr,
        Map<string, Node> typedefs,
        Map<string, bool> visiting) {
    if (typeExpr == null) { return -1; }
    int result = -1;
    if (typeExpr.is_volatile) {
        result = typeExpr.is_array ? 1 : 0;
    }
    if (typeExpr.generic_args.len > 0
            || !typedefs.has(typeExpr.base)
            || visiting.has(typeExpr.base)) {
        return result;
    }
    visiting.put(typeExpr.base, true);
    Node target = typedefs.get(typeExpr.base);
    int nested = typeVolatileMaxDepthInner(
        target, typedefs, visiting);
    visiting.remove(typeExpr.base);
    if (nested < 0) { return result; }
    int inherited = qualifierAppliedStorageLayers(
        typeExpr, target) + nested;
    if (inherited > result) { return inherited; }
    return result;
}

int typeVolatileMaxDepth(Node? typeExpr,
        Map<string, Node> typedefs) {
    Map<string, bool> visiting = {};
    return typeVolatileMaxDepthInner(
        typeExpr, typedefs, visiting);
}
