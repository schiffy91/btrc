/* Ownership-domain dispatch shared by class references and managed strings. */

string irManagedStringRuntimeType() {
    return "__btrc_managed_string";
}

string irManagedRuntimeCType(string runtimeType) {
    if (runtimeType == irManagedStringRuntimeType()) { return "char*"; }
    /* A lexical value may legally shadow the class typedef (Box Box). The
     * struct tag remains visible in C's separate tag namespace. */
    return "struct " + runtimeType + "*";
}

Node irManagedResolvedType(IRGen generator, Node typeExpr) {
    Node resolved = generator.resolveBodyType(typeExpr);
    Map<string, bool> visited = {};
    /* Resolve the owning alias chain without collapsing typedef spellings
     * inside generic arguments, which remain specialization identities. */
    while (resolved.generic_args.len == 0
            && generator.analyzed.typedefTable.has(resolved.base)) {
        if (visited.has(resolved.base)) {
            typedefSemanticFail(
                "Cyclic typedef involving '" + resolved.base + "'",
                typeExpr);
        }
        visited.put(resolved.base, true);
        resolved = composeTypedefType(
            resolved,
            generator.analyzed.typedefTable.get(resolved.base));
    }
    return resolved;
}

bool irManagedStringType(IRGen generator, Node? typeExpr) {
    if (typeExpr == null) { return false; }
    Node resolved = irManagedResolvedType(generator, typeExpr);
    return isStringType(resolved);
}

bool irManagedClassType(IRGen generator, Node? typeExpr) {
    if (typeExpr == null) { return false; }
    Node resolved = irManagedResolvedType(generator, typeExpr);
    /* Substitution can add an indirection: inside Vector<T>, the template
     * field T* resolves to Item** for T = Item*. Raw backing storage is not a
     * managed Item value. */
    if (resolved.is_array || resolved.pointer_depth > 1) { return false; }
    return generator.analyzed.isClass(resolved.base)
        || (resolved.generic_args.len > 0
            && generator.analyzed.isGenericClass(resolved.base));
}

bool irManagedType(IRGen generator, Node? typeExpr) {
    return irManagedStringType(generator, typeExpr)
        || irManagedClassType(generator, typeExpr);
}

string irManagedRuntimeType(IRGen generator, Node typeExpr) {
    Node resolved = irManagedResolvedType(generator, typeExpr);
    if (isStringType(resolved)) { return irManagedStringRuntimeType(); }
    if (resolved.generic_args.len > 0
            && generator.analyzed.isGenericClass(resolved.base)) {
        return mangleGenericType(resolved.base, resolved.generic_args);
    }
    return resolved.base;
}

bool irManagedRuntimeCanCycle(IRGen generator, string runtimeType) {
    return runtimeType != irManagedStringRuntimeType()
        && managedClassIsCyclable(generator, runtimeType);
}

string irManagedCleanupSymbol(IRGen generator, string runtimeType) {
    if (runtimeType == irManagedStringRuntimeType()) {
        generator.useHelper("__btrc_string_release_cleanup");
        return "__btrc_string_release_cleanup";
    }
    return runtimeType + "_destroy";
}

IRNode irManagedNoOp() {
    return irCast("void", irLiteral("0"));
}

IRNode irManagedRetainValue(
        IRGen generator, IRNode value, Node typeExpr) {
    if (irManagedStringType(generator, typeExpr)) {
        generator.useHelper("__btrc_string_retain");
        Vector<IRNode> arguments = [];
        arguments.push(value);
        return irCall("__btrc_string_retain", arguments);
    }
    return managedArcRetain(generator, value);
}

IRNode irManagedRetainEdge(IRGen generator, IRNode value,
        Node typeExpr, IRNode owner) {
    if (irManagedStringType(generator, typeExpr)) {
        return irManagedRetainValue(generator, value, typeExpr);
    }
    return managedArcRetainEdge(generator, value, owner);
}

IRNode irManagedAdoptEdge(IRGen generator, IRNode value,
        Node typeExpr, IRNode owner) {
    if (irManagedStringType(generator, typeExpr)) {
        /* A fresh string already carries +1; storing it transfers that unit. */
        return irManagedNoOp();
    }
    return managedArcAdoptEdge(generator, value, owner);
}

IRNode irManagedUnlinkEdge(IRGen generator, IRNode value,
        Node typeExpr, IRNode owner) {
    if (irManagedStringType(generator, typeExpr)) {
        /* Strings are side-table values, not class-cycle graph edges. */
        return irManagedNoOp();
    }
    return managedArcUnlinkEdge(generator, value, owner);
}

IRNode irManagedReleaseRuntime(
        IRGen generator, IRNode value, string runtimeType) {
    if (runtimeType == irManagedStringRuntimeType()) {
        generator.useHelper("__btrc_string_release");
        Vector<IRNode> arguments = [];
        arguments.push(value);
        return irCall("__btrc_string_release", arguments);
    }
    return managedArcRelease(generator, value, runtimeType);
}

IRNode irManagedReleaseValue(
        IRGen generator, IRNode value, Node typeExpr) {
    return irManagedReleaseRuntime(
        generator, value, irManagedRuntimeType(generator, typeExpr));
}

IRNode irManagedReleaseEdge(IRGen generator, IRNode value,
        Node typeExpr, IRNode replacement) {
    if (irManagedStringType(generator, typeExpr)) {
        return irManagedReleaseValue(generator, value, typeExpr);
    }
    return managedArcReleaseEdge(generator, value,
        irManagedRuntimeType(generator, typeExpr), replacement);
}

IRNode irManagedReplaceEdge(IRGen generator, IRNode slot,
        IRNode replacement, Node typeExpr, IRNode owner, bool adopt) {
    if (!irManagedClassType(generator, typeExpr)) {
        print("internal compiler error: transactional edge is not a class");
        abortGen();
    }
    return managedArcReplaceEdge(generator, slot, replacement,
        irManagedRuntimeType(generator, typeExpr), owner, adopt);
}

IRNode irManagedDestroyValue(
        IRGen generator, IRNode value, Node typeExpr) {
    if (irManagedStringType(generator, typeExpr)) {
        return irManagedReleaseValue(generator, value, typeExpr);
    }
    return managedArcDestroy(generator, value,
        irManagedRuntimeType(generator, typeExpr));
}

IRNode irRetainExpression(
        IRGen generator, IRNode value, Node typeExpr) {
    return irManagedRetainValue(generator, value, typeExpr);
}
