import ./parser/stage.btrc;

#include "driver_output.btrc"
int main(int argc, char** argv) {
  BtrccOutput output = BtrccOutput(stdout);
  FeSourceFileReader sourceFiles = FeSourceFileReader();
  if (argc < 2) { print("usage: parse <file.btrc>"); return 1; }
  string gt = sourceFiles.readRequired("src/language/grammar.ebnf");
  GrammarInfo g = parseGrammar(gt);
  string src = sourceFiles.readRequired(Strings.copy(argv[1]));
  Lexer lx = Lexer(src, g);
  Vector<Token> toks = lx.tokenize();
  if (lx.failed) {
    fprintf(stderr, "error: %s\n", lx.diagnostic);
    return 1;
  }
  Parser p = Parser(toks, g);
  Node prog = p.parseProgram();
  if (p.failed) {
    fprintf(stderr, "error: %s\n", p.diagnostic);
    return 1;
  }
  if (output.writeLine(prog.canon(0))) { return 0; }
  fprintf(stderr, "parse: error: cannot write standard output\n");
  return 1;
}
