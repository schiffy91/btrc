#include "tokens.btrc"
#include "ast/node.btrc"
#include "ebnf.btrc"
#include "lexer.btrc"
#include "parser.btrc"
int main(int argc, char** argv) {
  if (argc < 2) { print("usage: parse <file.btrc>"); return 1; }
  string gt = Path.readAll("src/language/grammar.ebnf");
  GrammarInfo g = parseGrammar(gt);
  string src = Path.readAll(Strings.copy(argv[1]));
  Lexer lx = Lexer(src, g);
  Vector<Token> toks = lx.tokenize();
  Parser p = Parser(toks, g);
  Node prog = p.parseProgram();
  print(prog.canon(0));
  return 0;
}
