/* Generic-constructor result inference for analyzer call expressions. */

/* Infer a bare generic-class constructor call from its bound argument types.
 * During monomorphized body lowering, `varTypes` already contains the concrete
 * specialization, so Pair(value, 1) inside Maker<T> resolves to Pair<T, int>
 * in the template and Pair<string, int> in Maker<string>. */
Node? inferGenericConstructorCallType(
        Node call, string name, Analyzed a, Map<string, Node> varTypes) {
    if (!a.isGenericClass(name)) { return null; }
    Node declaration = a.genericClassTable.get(name);
    Node? constructor = a.genericClassConstructor(name);
    Map<string, Node> substitutions = {};
    Map<string, bool> parameters = typeParameterSet(
        declaration.generic_params);
    if (constructor != null) {
        int positional = 0;
        int argumentIndex = 0;
        while (argumentIndex < call.args.len) {
            int parameterIndex = positional;
            string argumentName = "";
            if (argumentIndex < call.arg_names.len) {
                argumentName = call.arg_names.get(argumentIndex);
            }
            if (argumentName != "") {
                parameterIndex = -1;
                int search = 0;
                while (search < constructor.params.len) {
                    if (constructor.params.get(search).name == argumentName) {
                        parameterIndex = search;
                    }
                    search = search + 1;
                }
            } else {
                positional = positional + 1;
            }
            if (parameterIndex >= 0
                    && parameterIndex < constructor.params.len) {
                Node? actual = argTypeForInference(
                    call.args.get(argumentIndex), a, varTypes);
                unifyTypeParam(
                    constructor.params.get(parameterIndex).type,
                    actual, parameters, substitutions);
            }
            argumentIndex = argumentIndex + 1;
        }
    }

    Node instance = makePrimType(name);
    int typeIndex = 0;
    while (typeIndex < declaration.generic_params.len) {
        string parameter = declaration.generic_params.get(typeIndex);
        if (!substitutions.has(parameter)) {
            if (varTypes.has("self")) {
                Node selfType = varTypes.get("self");
                if (selfType.base == name
                        && selfType.generic_args.len
                            == declaration.generic_params.len) {
                    return selfType;
                }
            }
            return null;
        }
        instance.generic_args.push(substitutions.get(parameter));
        typeIndex = typeIndex + 1;
    }
    return classPtrType(instance);
}
