/* C11 setjmp qualification based on visibility and direct mutation.
 * Mirrors compiler/python/ir/gen/setjmp_volatility.py. */

Vector<IRNode> copySetjmpVisible(Vector<IRNode> source) {
    Vector<IRNode> result = [];
    int index = 0;
    while (index < source.len) {
        result.push(source.get(index));
        index = index + 1;
    }
    return result;
}

void addSetjmpVisible(Vector<IRNode> visible, IRNode? declaration) {
    if (declaration == null || declaration.kind != IRK_VAR_DECL) {
        return;
    }
    visible.push(declaration);
}

string setjmpVisibleDeclarationKey(
        IRNode declaration, SetjmpCallEffects effects) {
    SetjmpStorage? storage =
        setjmpDeclarationStorage(effects.flow, declaration);
    return storage == null ? "" : setjmpStorageKey(storage);
}

string setjmpVisibleParameterKey(
        IRParam parameter, SetjmpCallEffects effects) {
    SetjmpStorage? storage =
        setjmpParameterStorage(effects.flow, parameter);
    return storage == null ? "" : setjmpStorageKey(storage);
}

void markSetjmpVisible(Vector<IRNode> visible, Vector<IRParam> params,
        Map<string, bool> modified, bool filterModified,
        SetjmpCallEffects effects) {
    Map<string, bool> remaining = copyNameSet(modified);
    int index = 0;
    if (!filterModified) {
        while (index < params.len) {
            string key = setjmpVisibleParameterKey(
                params.get(index), effects);
            if (key != "") { remaining.put(key, true); }
            index = index + 1;
        }
        index = 0;
        while (index < visible.len) {
            string key = setjmpVisibleDeclarationKey(
                visible.get(index), effects);
            if (key != "") { remaining.put(key, true); }
            index = index + 1;
        }
    } else {
        /* GCC diagnoses generated temporaries that are initialized before a
         * setjmp and consumed after its branch even without a direct write. */
        while (index < visible.len) {
            IRNode declaration = visible.get(index);
            if (setjmpCompilerOwnedStorage(declaration.name)) {
                string key = setjmpVisibleDeclarationKey(
                    declaration, effects);
                if (key != "") { remaining.put(key, true); }
            }
            index = index + 1;
        }
    }
    index = visible.len - 1;
    while (index >= 0) {
        IRNode declaration = visible.get(index);
        string key = setjmpVisibleDeclarationKey(declaration, effects);
        if (key != "" && remaining.has(key)) {
            if (!declaration.is_static && !declaration.is_extern) {
                if (!declaration.is_volatile) {
                    declaration.setjmp_inferred_volatile = true;
                }
                declaration.is_volatile = true;
                declaration.effective_is_volatile = true;
            }
            remaining.remove(key);
        }
        index = index - 1;
    }
    index = 0;
    while (index < params.len) {
        IRParam parameter = params.get(index);
        string key = setjmpVisibleParameterKey(parameter, effects);
        if (key != "" && remaining.has(key)) {
            if (!parameter.is_volatile) {
                parameter.setjmp_inferred_volatile = true;
            }
            parameter.is_volatile = true;
            parameter.effective_is_volatile = true;
        }
        index = index + 1;
    }
}

void scanSetjmpResidual(IRNode? node, Vector<IRNode> visible,
        Vector<IRParam> params, Map<string, bool> modified,
        bool filterModified, SetjmpCallEffects effects) {
    if (node == null) { return; }
    if (node.kind == IRK_CALL && node.callee == "setjmp") {
        markSetjmpVisible(
            visible, params, modified, filterModified, effects);
        return;
    }
    if (node.kind == IRK_STMT_EXPR) {
        scanSetjmpResidual(
            node.result, visible, params, modified, filterModified, effects);
        return;
    }
    scanSetjmpResidual(node.left, visible, params, modified, filterModified, effects);
    scanSetjmpResidual(node.right, visible, params, modified, filterModified, effects);
    scanSetjmpResidual(node.operand, visible, params, modified, filterModified, effects);
    scanSetjmpResidual(node.expr, visible, params, modified, filterModified, effects);
    scanSetjmpResidual(node.obj, visible, params, modified, filterModified, effects);
    scanSetjmpResidual(node.index, visible, params, modified, filterModified, effects);
    scanSetjmpResidual(node.condition, visible, params, modified, filterModified, effects);
    scanSetjmpResidual(node.true_expr, visible, params, modified, filterModified, effects);
    scanSetjmpResidual(node.false_expr, visible, params, modified, filterModified, effects);
    scanSetjmpResidual(node.array_size, visible, params, modified, filterModified, effects);
    scanSetjmpResidual(node.init, visible, params, modified, filterModified, effects);
    scanSetjmpResidual(node.value, visible, params, modified, filterModified, effects);
    scanSetjmpResidual(node.target, visible, params, modified, filterModified, effects);
    scanSetjmpResidual(node.update, visible, params, modified, filterModified, effects);
    scanSetjmpResidual(node.result, visible, params, modified, filterModified, effects);
    int index = 0;
    while (index < node.args.len) {
        scanSetjmpResidual(node.args.get(index), visible, params,
            modified, filterModified, effects);
        index = index + 1;
    }
}

void prepareSetjmpDeclaration(IRNode declaration,
        Vector<IRNode> visible, Vector<IRParam> params,
        Map<string, bool> modified, bool filterModified,
        SetjmpCallEffects effects) {
    prepareSetjmpHoists(declaration.array_size, visible, params,
        modified, filterModified, effects);
    prepareSetjmpHoists(declaration.init, visible, params,
        modified, filterModified, effects);
    scanSetjmpResidual(declaration.array_size, visible, params,
        modified, filterModified, effects);
    addSetjmpVisible(visible, declaration);
    scanSetjmpResidual(declaration.init, visible, params,
        modified, filterModified, effects);
}

void prepareSetjmpHoists(IRNode? node, Vector<IRNode> visible,
        Vector<IRParam> params, Map<string, bool> modified,
        bool filterModified, SetjmpCallEffects effects) {
    if (node == null) { return; }
    if (node.kind == IRK_STMT_EXPR) {
        int index = 0;
        while (index < node.stmts.len) {
            IRNode declaration = node.stmts.get(index);
            if (declaration.kind == IRK_VAR_DECL) {
                prepareSetjmpDeclaration(declaration, visible, params,
                    modified, filterModified, effects);
            }
            index = index + 1;
        }
        prepareSetjmpHoists(node.result, visible, params,
            modified, filterModified, effects);
        return;
    }
    prepareSetjmpHoists(node.left, visible, params, modified, filterModified, effects);
    prepareSetjmpHoists(node.right, visible, params, modified, filterModified, effects);
    prepareSetjmpHoists(node.operand, visible, params, modified, filterModified, effects);
    prepareSetjmpHoists(node.expr, visible, params, modified, filterModified, effects);
    prepareSetjmpHoists(node.obj, visible, params, modified, filterModified, effects);
    prepareSetjmpHoists(node.index, visible, params, modified, filterModified, effects);
    prepareSetjmpHoists(node.condition, visible, params, modified, filterModified, effects);
    prepareSetjmpHoists(node.true_expr, visible, params, modified, filterModified, effects);
    prepareSetjmpHoists(node.false_expr, visible, params, modified, filterModified, effects);
    prepareSetjmpHoists(node.array_size, visible, params, modified, filterModified, effects);
    prepareSetjmpHoists(node.init, visible, params, modified, filterModified, effects);
    prepareSetjmpHoists(node.value, visible, params, modified, filterModified, effects);
    prepareSetjmpHoists(node.target, visible, params, modified, filterModified, effects);
    prepareSetjmpHoists(node.update, visible, params, modified, filterModified, effects);
    prepareSetjmpHoists(node.result, visible, params, modified, filterModified, effects);
    int index = 0;
    while (index < node.args.len) {
        prepareSetjmpHoists(node.args.get(index), visible, params,
            modified, filterModified, effects);
        index = index + 1;
    }
}

void processSetjmpExpression(IRNode? node, Vector<IRNode> visible,
        Vector<IRParam> params, Map<string, bool> modified,
        bool filterModified, SetjmpCallEffects effects) {
    prepareSetjmpHoists(
        node, visible, params, modified, filterModified, effects);
    scanSetjmpResidual(
        node, visible, params, modified, filterModified, effects);
}

void prepareSetjmpSimple(IRNode? first, IRNode? second,
        Vector<IRNode> visible, Vector<IRParam> params,
        SetjmpCallEffects effects) {
    Map<string, bool> all = {};
    prepareSetjmpHoists(first, visible, params, all, false, effects);
    prepareSetjmpHoists(second, visible, params, all, false, effects);
    scanSetjmpResidual(first, visible, params, all, false, effects);
    scanSetjmpResidual(second, visible, params, all, false, effects);
}
