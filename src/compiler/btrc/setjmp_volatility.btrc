/* C11 setjmp qualification based on visibility and direct mutation.
 * Mirrors compiler/python/ir/gen/setjmp_volatility.py. */

Vector<IRNode> copySetjmpVisible(Vector<IRNode> source) {
    Vector<IRNode> result = [];
    int index = 0;
    while (index < source.len) {
        result.push(source.get(index));
        index = index + 1;
    }
    return result;
}

void addSetjmpVisible(Vector<IRNode> visible, IRNode? declaration) {
    if (declaration == null || declaration.kind != IRK_VAR_DECL
            || declaration.is_static || declaration.is_extern) {
        return;
    }
    visible.push(declaration);
}

void markSetjmpVisible(Vector<IRNode> visible, Vector<IRParam> params,
        Map<string, bool> modified, bool filterModified) {
    Map<string, bool> remaining = copyNameSet(modified);
    int index = 0;
    if (!filterModified) {
        while (index < params.len) {
            remaining.put(params.get(index).name, true);
            index = index + 1;
        }
        index = 0;
        while (index < visible.len) {
            remaining.put(visible.get(index).name, true);
            index = index + 1;
        }
    } else {
        /* GCC diagnoses generated temporaries that are initialized before a
         * setjmp and consumed after its branch even without a direct write. */
        while (index < visible.len) {
            IRNode declaration = visible.get(index);
            if (declaration.name.startsWith("__btrc_")) {
                remaining.put(declaration.name, true);
            }
            index = index + 1;
        }
    }
    index = visible.len - 1;
    while (index >= 0) {
        IRNode declaration = visible.get(index);
        if (remaining.has(declaration.name)) {
            declaration.is_volatile = true;
            remaining.remove(declaration.name);
        }
        index = index - 1;
    }
    index = 0;
    while (index < params.len) {
        IRParam parameter = params.get(index);
        if (remaining.has(parameter.name)) {
            parameter.is_volatile = true;
        }
        index = index + 1;
    }
}

void scanSetjmpResidual(IRNode? node, Vector<IRNode> visible,
        Vector<IRParam> params, Map<string, bool> modified,
        bool filterModified) {
    if (node == null) { return; }
    if (node.kind == IRK_CALL && node.callee == "setjmp") {
        markSetjmpVisible(visible, params, modified, filterModified);
        return;
    }
    if (node.kind == IRK_STMT_EXPR) {
        scanSetjmpResidual(
            node.result, visible, params, modified, filterModified);
        return;
    }
    scanSetjmpResidual(node.left, visible, params, modified, filterModified);
    scanSetjmpResidual(node.right, visible, params, modified, filterModified);
    scanSetjmpResidual(node.operand, visible, params, modified, filterModified);
    scanSetjmpResidual(node.expr, visible, params, modified, filterModified);
    scanSetjmpResidual(node.obj, visible, params, modified, filterModified);
    scanSetjmpResidual(node.index, visible, params, modified, filterModified);
    scanSetjmpResidual(node.condition, visible, params, modified, filterModified);
    scanSetjmpResidual(node.true_expr, visible, params, modified, filterModified);
    scanSetjmpResidual(node.false_expr, visible, params, modified, filterModified);
    scanSetjmpResidual(node.array_size, visible, params, modified, filterModified);
    scanSetjmpResidual(node.init, visible, params, modified, filterModified);
    scanSetjmpResidual(node.value, visible, params, modified, filterModified);
    scanSetjmpResidual(node.target, visible, params, modified, filterModified);
    scanSetjmpResidual(node.update, visible, params, modified, filterModified);
    scanSetjmpResidual(node.result, visible, params, modified, filterModified);
    int index = 0;
    while (index < node.args.len) {
        scanSetjmpResidual(node.args.get(index), visible, params,
            modified, filterModified);
        index = index + 1;
    }
}

void prepareSetjmpDeclaration(IRNode declaration,
        Vector<IRNode> visible, Vector<IRParam> params,
        Map<string, bool> modified, bool filterModified) {
    prepareSetjmpHoists(declaration.array_size, visible, params,
        modified, filterModified);
    prepareSetjmpHoists(declaration.init, visible, params,
        modified, filterModified);
    scanSetjmpResidual(declaration.array_size, visible, params,
        modified, filterModified);
    addSetjmpVisible(visible, declaration);
    scanSetjmpResidual(declaration.init, visible, params,
        modified, filterModified);
}

void prepareSetjmpHoists(IRNode? node, Vector<IRNode> visible,
        Vector<IRParam> params, Map<string, bool> modified,
        bool filterModified) {
    if (node == null) { return; }
    if (node.kind == IRK_STMT_EXPR) {
        int index = 0;
        while (index < node.stmts.len) {
            IRNode declaration = node.stmts.get(index);
            if (declaration.kind == IRK_VAR_DECL) {
                prepareSetjmpDeclaration(declaration, visible, params,
                    modified, filterModified);
            }
            index = index + 1;
        }
        prepareSetjmpHoists(node.result, visible, params,
            modified, filterModified);
        return;
    }
    prepareSetjmpHoists(node.left, visible, params, modified, filterModified);
    prepareSetjmpHoists(node.right, visible, params, modified, filterModified);
    prepareSetjmpHoists(node.operand, visible, params, modified, filterModified);
    prepareSetjmpHoists(node.expr, visible, params, modified, filterModified);
    prepareSetjmpHoists(node.obj, visible, params, modified, filterModified);
    prepareSetjmpHoists(node.index, visible, params, modified, filterModified);
    prepareSetjmpHoists(node.condition, visible, params, modified, filterModified);
    prepareSetjmpHoists(node.true_expr, visible, params, modified, filterModified);
    prepareSetjmpHoists(node.false_expr, visible, params, modified, filterModified);
    prepareSetjmpHoists(node.array_size, visible, params, modified, filterModified);
    prepareSetjmpHoists(node.init, visible, params, modified, filterModified);
    prepareSetjmpHoists(node.value, visible, params, modified, filterModified);
    prepareSetjmpHoists(node.target, visible, params, modified, filterModified);
    prepareSetjmpHoists(node.update, visible, params, modified, filterModified);
    prepareSetjmpHoists(node.result, visible, params, modified, filterModified);
    int index = 0;
    while (index < node.args.len) {
        prepareSetjmpHoists(node.args.get(index), visible, params,
            modified, filterModified);
        index = index + 1;
    }
}

void processSetjmpExpression(IRNode? node, Vector<IRNode> visible,
        Vector<IRParam> params, Map<string, bool> modified,
        bool filterModified) {
    prepareSetjmpHoists(node, visible, params, modified, filterModified);
    scanSetjmpResidual(node, visible, params, modified, filterModified);
}

void prepareSetjmpSimple(IRNode? first, IRNode? second,
        Vector<IRNode> visible, Vector<IRParam> params) {
    Map<string, bool> all = {};
    prepareSetjmpHoists(first, visible, params, all, false);
    prepareSetjmpHoists(second, visible, params, all, false);
    scanSetjmpResidual(first, visible, params, all, false);
    scanSetjmpResidual(second, visible, params, all, false);
}

void scanSetjmpBlock(IRNode? block, Vector<IRNode> inherited,
        Vector<IRParam> params) {
    if (block == null) { return; }
    Vector<IRNode> visible = copySetjmpVisible(inherited);
    int index = 0;
    while (index < block.stmts.len) {
        scanSetjmpStatement(block.stmts.get(index), visible, params);
        index = index + 1;
    }
}

void scanSetjmpStatement(IRNode statement, Vector<IRNode> visible,
        Vector<IRParam> params) {
    Map<string, bool> all = {};
    if (statement.kind == IRK_VAR_DECL) {
        prepareSetjmpDeclaration(statement, visible, params, all, false);
    } else if (statement.kind == IRK_ASSIGN) {
        prepareSetjmpSimple(statement.target, statement.value, visible, params);
    } else if (statement.kind == IRK_RETURN) {
        prepareSetjmpSimple(statement.value, null, visible, params);
    } else if (statement.kind == IRK_EXPR_STMT) {
        prepareSetjmpSimple(statement.expr, null, visible, params);
    } else if (statement.kind == IRK_IF) {
        if (expressionContainsSetjmp(statement.condition)) {
            Map<string, bool> modified = setjmpMutatedNames(
                statement.then_block);
            Map<string, bool> catchModified = setjmpMutatedNames(
                statement.else_block);
            Vector<string> catchNames = catchModified.keys();
            int catchIndex = 0;
            while (catchIndex < catchNames.len) {
                modified.put(catchNames.get(catchIndex), true);
                catchIndex = catchIndex + 1;
            }
            processSetjmpExpression(statement.condition, visible, params,
                modified, true);
        } else {
            processSetjmpExpression(statement.condition, visible, params,
                all, false);
        }
        scanSetjmpBlock(statement.then_block, visible, params);
        scanSetjmpBlock(statement.else_block, visible, params);
    } else if (statement.kind == IRK_WHILE) {
        prepareSetjmpSimple(statement.condition, null, visible, params);
        scanSetjmpBlock(statement.body, visible, params);
    } else if (statement.kind == IRK_DO_WHILE) {
        processSetjmpExpression(statement.condition, visible, params,
            all, false);
        scanSetjmpBlock(statement.body, visible, params);
    } else if (statement.kind == IRK_FOR) {
        scanSetjmpFor(statement, visible, params);
    } else if (statement.kind == IRK_SWITCH) {
        prepareSetjmpSimple(statement.value, null, visible, params);
        int index = 0;
        while (index < statement.args.len) {
            IRNode caseNode = statement.args.get(index);
            Vector<IRNode> caseVisible = copySetjmpVisible(visible);
            prepareSetjmpSimple(caseNode.value, null, caseVisible, params);
            int child = 0;
            while (child < caseNode.stmts.len) {
                scanSetjmpStatement(
                    caseNode.stmts.get(child), caseVisible, params);
                child = child + 1;
            }
            index = index + 1;
        }
    } else if (statement.kind == IRK_BLOCK) {
        scanSetjmpBlock(statement, visible, params);
    }
}

void prepareSetjmpForInit(IRNode? init, Vector<IRNode> visible,
        Vector<IRParam> params) {
    if (init == null) { return; }
    Map<string, bool> all = {};
    if (init.kind == IRK_ASSIGN) {
        prepareSetjmpHoists(init.target, visible, params, all, false);
        prepareSetjmpHoists(init.value, visible, params, all, false);
    } else if (init.kind == IRK_EXPR_STMT) {
        prepareSetjmpHoists(init.expr, visible, params, all, false);
    }
}

void scanSetjmpForInit(IRNode? init, Vector<IRNode> visible,
        Vector<IRParam> params) {
    if (init == null) { return; }
    Map<string, bool> all = {};
    if (init.kind == IRK_ASSIGN) {
        scanSetjmpResidual(init.target, visible, params, all, false);
        scanSetjmpResidual(init.value, visible, params, all, false);
    } else if (init.kind == IRK_EXPR_STMT) {
        scanSetjmpResidual(init.expr, visible, params, all, false);
    }
}

void scanSetjmpFor(IRNode statement, Vector<IRNode> visible,
        Vector<IRParam> params) {
    Map<string, bool> all = {};
    if (statement.init != null && statement.init.kind == IRK_VAR_DECL) {
        prepareSetjmpHoists(statement.init.array_size, visible, params, all, false);
        prepareSetjmpHoists(statement.init.init, visible, params, all, false);
    } else { prepareSetjmpForInit(statement.init, visible, params); }
    prepareSetjmpHoists(statement.condition, visible, params, all, false);
    prepareSetjmpHoists(statement.update, visible, params, all, false);

    Vector<IRNode> loopVisible = copySetjmpVisible(visible);
    if (statement.init != null && statement.init.kind == IRK_VAR_DECL) {
        scanSetjmpResidual(statement.init.array_size, visible, params, all, false);
        addSetjmpVisible(loopVisible, statement.init);
        scanSetjmpResidual(statement.init.init, loopVisible, params, all, false);
    } else { scanSetjmpForInit(statement.init, loopVisible, params); }
    scanSetjmpResidual(statement.condition, loopVisible, params, all, false);
    scanSetjmpResidual(statement.update, loopVisible, params, all, false);
    scanSetjmpBlock(statement.body, loopVisible, params);
}

void applySetjmpVolatility(IRModule module) {
    int index = 0;
    while (index < module.functions.len) {
        IRFunction definition = module.functions.get(index);
        Vector<IRNode> visible = [];
        scanSetjmpBlock(definition.body, visible, definition.params);
        index = index + 1;
    }
}
