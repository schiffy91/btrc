/* Executable-descriptor helper mirror for compiler/python/ir/helpers. */

string processRuntimeDescriptorSource(string name) {
    if (name == "__btrc_validate_executable_descriptor") {
        return """static int __btrc_validate_executable_descriptor(int descriptor) {
#if defined(__linux__)
    struct stat status;
    if (descriptor < 0) { errno = EBADF; return -1; }
    if (fstat(descriptor, &status) != 0) return -1;
    if (!S_ISREG(status.st_mode)) { errno = EACCES; return -1; }
    return 0;
#else
    (void)descriptor;
    errno = ENOTSUP;
    return -1;
#endif
}""";
    }
    if (name == "__btrc_exec_signal_guard_begin") {
        return """static int __btrc_exec_signal_guard_begin(
        sigset_t* previous_mask) {
    if (previous_mask == NULL) { errno = EINVAL; return -1; }
    sigset_t blocked;
    if (sigfillset(&blocked) != 0) return -1;
    int error = pthread_sigmask(SIG_BLOCK, &blocked, previous_mask);
    if (error != 0) { errno = error; return -1; }
    return 0;
}""";
    }
    if (name == "__btrc_exec_signal_guard_parent_end") {
        return """static int __btrc_exec_signal_guard_parent_end(
        const sigset_t* previous_mask) {
    if (previous_mask == NULL) { errno = EINVAL; return -1; }
    int error = pthread_sigmask(SIG_SETMASK, previous_mask, NULL);
    if (error != 0) { errno = error; return -1; }
    return 0;
}""";
    }
    if (name == "__btrc_exec_signal_guard_child_end") {
        return """static int __btrc_exec_signal_guard_child_end(
        const sigset_t* previous_mask) {
    if (previous_mask == NULL) { errno = EINVAL; return -1; }
    for (int signal_number = 1; signal_number < NSIG; signal_number++) {
        struct sigaction current;
        if (sigaction(signal_number, NULL, &current) != 0) {
            if (errno == EINVAL) continue;
            return -1;
        }
        if (current.sa_handler == SIG_IGN) continue;
        struct sigaction reset;
        memset(&reset, 0, sizeof(reset));
        reset.sa_handler = SIG_DFL;
        if (sigemptyset(&reset.sa_mask) != 0
                || sigaction(signal_number, &reset, NULL) != 0) {
            if (errno == EINVAL) continue;
            return -1;
        }
    }
    if (sigprocmask(SIG_SETMASK, previous_mask, NULL) != 0)
        return -1;
    return 0;
}""";
    }
    if (name == "__btrc_exec_executable_descriptor") {
        return """static int __btrc_exec_executable_descriptor(
        int descriptor, char** argv, char** envp) {
#if defined(__linux__)
    return fexecve(descriptor, argv, envp);
#else
    (void)descriptor; (void)argv; (void)envp;
    errno = ENOTSUP;
    return -1;
#endif
}""";
    }
    return "";
}
