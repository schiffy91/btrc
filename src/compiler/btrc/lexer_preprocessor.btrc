/* Translation-phase helpers for preprocessor directive lexing. */

char lexerPreprocessorChar(string source, int index) {
    if (index < 0 || index >= source.length()) { return '\0'; }
    return source[index];
}

int lexerPreprocessorSpliceWidth(string source, int index) {
    char first = lexerPreprocessorChar(source, index);
    int markerWidth = first == '\\' ? 1
        : (first == '?'
            && lexerPreprocessorChar(source, index + 1) == '?'
            && lexerPreprocessorChar(source, index + 2) == '/' ? 3 : 0);
    if (markerWidth > 0
            && lexerPreprocessorChar(source, index + markerWidth) == '\n') {
        return markerWidth + 1;
    }
    if (markerWidth > 0
            && lexerPreprocessorChar(source, index + markerWidth) == '\r'
            && lexerPreprocessorChar(source, index + markerWidth + 1) == '\n') {
        return markerWidth + 2;
    }
    return 0;
}
