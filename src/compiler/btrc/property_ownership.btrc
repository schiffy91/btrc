/* ARC-safe bodies for generated auto-property setters. */

void emitAutoPropertyStore(IRGen generator, Node propertyType,
        IRNode target, Vector<IRNode> body) {
    if (!irManagedType(generator, propertyType)) {
        body.push(irAssign(target, irVar("value")));
        return;
    }
    if (irManagedArcType(generator, propertyType)) {
        body.push(irExprStmt(irManagedReplaceEdge(
            generator, target, irVar("value"), propertyType,
            irVar("self"), false)));
        string runtimeType = irManagedRuntimeType(
            generator, propertyType);
        if (irManagedRuntimeCanCycle(generator, runtimeType)) {
            body.push(irExprStmt(managedArcPoll(generator)));
        }
        return;
    }
    string oldName = generator.freshTemp("__btrc_property_old");
    IRNode oldDeclaration = irVarDecl(
        typeToC(propertyType, generator.analyzed),
        oldName, target);
    generator.funcVarDecls.push(oldDeclaration);
    body.push(oldDeclaration);
    body.push(irExprStmt(irManagedUnlinkEdge(
        generator, irVar(oldName), propertyType, irVar("self"))));
    body.push(irExprStmt(irManagedRetainEdge(
        generator, irVar("value"), propertyType, irVar("self"))));
    body.push(irAssign(target, irVar("value")));
    string runtimeType = irManagedRuntimeType(generator, propertyType);
    body.push(irExprStmt(irManagedReleaseEdge(
        generator, irVar(oldName), propertyType, irVar("value"))));
    if (irManagedRuntimeCanCycle(generator, runtimeType)) {
        body.push(irExprStmt(managedArcPoll(generator)));
    }
}

IRNode lowerPropertyStoreCore(IRGen generator, Node assignment,
        Node receiverType, Node property, Node propertyType,
        Map<string, Node> varTypes) {
    Node target = assignment.target;
    IRNode receiver = generator.lowerExpr(target.obj, varTypes);
    IRNode value = generator.lowerAssignedValueRaw(
        assignment.value_node, propertyType, varTypes);
    Node? sourceType = generator.resolvedExpressionType(
        assignment.value_node, varTypes);
    value = generator.upcastClassPointer(
        propertyType, sourceType, value);
    if (target.obj.kind == NK_SELF_EXPR
            && propertyNeedsBacking(property)) {
        return irBinOp(irFieldAccess(receiver,
            instanceStorageName(property), true), "=", value);
    }
    /* A setter is void in C, while the source assignment yields its RHS. Keep
     * that RHS in one structured temporary: embedding the same lowered IR in
     * both the call and the result would duplicate any nested declarations and
     * evaluate side effects twice. */
    string resultName = generator.freshTemp("__btrc_property_value");
    IRNode resultDeclaration = irVarDecl(
        typeToC(propertyType, generator.analyzed), resultName, null);
    generator.funcVarDecls.push(resultDeclaration);
    IRNode result = irVar(resultName);
    Vector<IRNode> arguments = [];
    arguments.push(receiver);
    arguments.push(result);
    Vector<IRNode> declarations = [];
    declarations.push(resultDeclaration);
    Vector<IRNode> sequence = [];
    sequence.push(irBinOp(result, "=", value));
    sequence.push(irCall(instanceFunctionPrefix(
        generator.analyzed, receiverType)
            + "_set_" + target.field, arguments));
    sequence.push(result);
    return irStmtExpr(declarations, irCommaExpr(sequence));
}

IRNode lowerPropertyStoreWithOwnership(IRGen generator, Node assignment,
        Node receiverType, Node property, Node propertyType,
        Map<string, Node> varTypes) {
    Node target = assignment.target;
    bool directBacking = target.obj.kind == NK_SELF_EXPR
        && propertyNeedsBacking(property);
    if (directBacking) {
        return lowerPropertyStoreCore(generator, assignment,
            receiverType, property, propertyType, varTypes);
    }
    bool receiverOwned = irUnconsumedOwnedResult(
        generator, target.obj, varTypes);
    Node? actualValueType = generator.resolvedExpressionType(
        assignment.value_node, varTypes);
    bool valueConverted = requiresTargetStringConversion(
        generator, propertyType, actualValueType);
    bool managedResult = irManagedType(generator, propertyType);
    if (!receiverOwned && !managedResult && !valueConverted) {
        return lowerPropertyStoreCore(generator, assignment,
            receiverType, property, propertyType, varTypes);
    }
    OwnershipBoundary boundary = OwnershipBoundary();
    boundary.addOperand(generator, target.obj, receiverType,
        receiverOwned, false, varTypes);
    PreparedValue prepared = prepareCallTargetValue(
        generator, assignment.value_node, propertyType, varTypes);
    ownershipRequireType(
        prepared.effectiveType, assignment.value_node);
    Node effectiveType = prepared.effectiveType;
    bool pinBorrowed = managedResult && !prepared.owned;
    boundary.addLoweredCallOperand(generator,
        assignment.value_node, effectiveType, prepared.value,
        prepared.owned, pinBorrowed, false);
    IRNode lowered = lowerPropertyStoreCore(generator, assignment,
        receiverType, property, propertyType, varTypes);
    boundary.restore(generator);
    return boundary.finish(generator, lowered,
        propertyType, managedResult || receiverOwned);
}
