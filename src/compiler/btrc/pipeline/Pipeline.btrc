/* Instance-owned orchestration for the self-hosted compiler pipeline. */

import Library.BackgroundJobs.WorkerPools;
import Library.FileSystem;
import Library.Map;
import Library.Strings;
import Library.Vector;

import ../frontend/Models.btrc;
import ../frontend/Packages.btrc;
import ../frontend/NativeImports.btrc;
import ../frontend/Resolver.btrc;
import ../frontend/Visibility.btrc;
import ../parser/SourceMacros.btrc;
import ../ir/Stage.btrc;
import ./Models.btrc;
import ./ModuleUnits.btrc;
import ../frontend/SourceIo.btrc;
import ../frontend/Timing.btrc;
import ../ir/lowering/Reachability.btrc;

class CompilerPipeline {
	private GrammarInfo grammar;
	private FeStdlibRepository stdlib;
	private FeStdlibSymbolIndex stdlibSymbols;
	private HostedAbiRepository hostedAbi;
	private FeSourceFileReader sourceFiles;
	private FeNativeHeaderReader nativeHeaderReader;
	private FeDirectiveCache? directiveCache;
	private IBtrccArtifactCache? moduleUnitStore = null;
	/* The last resolve's native bindings, read and digested but not imported. */
	private FeNativeDeclarationImporter? pendingNatives = null;
	private IWorkerPoolFactory? workerPools = null;
	private SourceMacroRules? macroRulesValue = null;
	private Vector<FeConditionalEnvironment>? targetEnvironmentsValue = null;

	public CompilerPipeline(GrammarInfo grammar, string stdlibDirectory, FeSourceFileReader sourceFiles, FeNativeHeaderReader nativeHeaderReader = (FeNativeHeaderReader)null, FeDirectiveCache? directiveCache = null) {
		self.grammar = grammar;
		self.stdlib = FeStdlibRepository(stdlibDirectory, sourceFiles);
		self.stdlibSymbols = FeStdlibSymbolIndex();
		self.hostedAbi = HostedAbiRepository(GeneratedHostedAbiData());
		self.sourceFiles = sourceFiles;
		self.nativeHeaderReader = nativeHeaderReader;
		self.directiveCache = directiveCache;
		BtrccPhaseTimer.mark("tables");
	}

	private BtrccCompilationResult failure(string diagnostic) { return BtrccCompilationResult(false, "", diagnostic, ""); }

	/* Where module-unit records persist between builds; null disables reuse. */
	public void setModuleUnitStore(IBtrccArtifactCache? store) { self.moduleUnitStore = store; }

	/* Starts module-unit worker processes; null lowers every group here. */
	public void setWorkerPools(IWorkerPoolFactory? pools) { self.workerPools = pools; }

	/* A lexer or parser diagnostic ("<message> at <line>:<col>") at its own
	 * file's position. */
	private string positionedDiagnostic(string diagnostic) {
		FeLexFailure failure = FeLexFailure(diagnostic);
		if (failure.line <= 0) { return "error: " + diagnostic; }
		return FeDiagnosticSources.render(failure.message, failure.line, failure.col);
	}

	private string visibilityDiagnostic(Vector<FeVisibilityDiagnostic> diagnostics) {
		Vector<string> rendered = [];
		int index = 0;
		while (index < diagnostics.len) {
			rendered.push(diagnostics.get(index).render());
			index++;
		}
		return Strings.join(rendered, "\n");
	}

	/* Analyzer warnings rendered exactly as the reference CLI renders them:
	 * the message, the file (the input as named, any other source by its
	 * absolute path), the line and column, and the source line with a caret. */
	private string renderedWarnings(Analyzed analyzed, FeResolvedSource resolved, string sourcePath) {
		Vector<string> rendered = [];
		for warning in analyzed.warnings {
			int line = warning.site.line;
			int col = warning.site.col;
			FeLine? source = resolved.userLineForCombined(line);
			if (source == null) {
				rendered.push(f"warning: {warning.message}\n --> {PathTools.basename(sourcePath)}:{line}:{col}");
				continue;
			}
			string display = source.sourceFile.equals(resolved.rootSourcePath) ? sourcePath : source.sourceFile;
			string lineText = f"{source.lineNumber}";
			string pad = " ".repeat(lineText.length());
			string caret = " ".repeat(col > 0 ? col - 1 : 0) + "^";
			rendered.push(f"warning: {warning.message}\n {pad}--> {display}:{source.lineNumber}:{col}\n {pad} |\n {lineText} | {source.text}\n {pad} | {caret}");
		}
		return Strings.join(rendered, "\n");
	}

	/* --emit-ir / --emit-optimized-ir: the module's canonical dump in place of C. */
	private BtrccCompilationResult irDump(IRModule module, Analyzed analyzed, FeResolvedSource resolved, BtrccResolvedCompilation input, FeResolvedPackages packages) {
		string dump = IRCanonicalRenderer().render(module);
		keep module;
		BtrccPhaseTimer.print();
		BtrccCompilationResult result = BtrccCompilationResult(true, dump, self.renderedWarnings(analyzed, resolved, input.sourcePath), packages.linkPlan.canonicalJson());
		result.inputPaths = input.inputPaths;
		return result;
	}

	/* The #define/#undef name rules, shared by conditioning and the analyzer. */
	public SourceMacroRules macroRules() {
		SourceMacroRules? existing = self.macroRulesValue;
		if (existing != null) { return existing; }
		SourceMacroRules built = FeConditionalEnvironment.macroRulesFor(self.grammar.vocabulary, self.hostedAbi.ownedNameSet(), self.hostedAbi.tables());
		self.macroRulesValue = built;
		return built;
	}

	/* The environment every file of one compile is conditioned with: the
	 * packages' target and every package -D name of their graph. */
	public FeConditionalEnvironment conditionalEnvironment(FeResolvedPackages packages) { return FeConditionalEnvironment.forPackages(packages, self.macroRules(), self.hostedAbi.tables()); }

	/* One environment per spec target, for the stdlib symbol-index union. */
	private Vector<FeConditionalEnvironment> targetEnvironments() {
		Vector<FeConditionalEnvironment>? existing = self.targetEnvironmentsValue;
		if (existing != null) { return existing; }
		Map<string, string> none = {};
		Vector<FeConditionalEnvironment> built = FeConditionalEnvironment("", "", "", self.macroRules(), self.hostedAbi.tables(), none).everyTarget();
		self.targetEnvironmentsValue = built;
		return built;
	}

	public BtrccCompilationResult compile(string source, string sourcePath, BtrccOptions options) { return self.compileResolved(self.resolve(source, sourcePath, options), options); }

	public BtrccResolvedCompilation resolve(string source, string sourcePath, BtrccOptions options) {
		/* Canonical paths are memoized for one compile: a process that compiles
		 * repeatedly must not answer from a tree that has changed since. */
		FeCanonicalPath.reset();
		FeResolvedPackages packages = FePackageGraphResolver(self.sourceFiles).resolveFor(sourcePath, options.target);
		BtrccPhaseTimer.mark("packages");
		FeFrontendResolver resolver = FeFrontendResolver(self.grammar, self.stdlib, options.includeStdlib, options.strictImports, packages, options.useCache ? self.directiveCache : null, self.conditionalEnvironment(packages));
		FeResolvedSource resolved = resolver.resolve(source, sourcePath);
		BtrccPhaseTimer.mark("resolve");
		Vector<string> sources = resolved.dependencies.sourceIdentities();
		packages.linkPlan.restrictToSources(sources);
		packages.linkPlan.includeStdlib(self.stdlib.directory(), sources, self.sourceFiles);
		var nativeImporter = FeNativeDeclarationImporter(self.nativeHeaderReader, self.sourceFiles);
		nativeImporter.prepare(packages.linkPlan, options.useCache);
		/* Imported once compileResolved runs: a stored generation needs only
		 * the identity. */
		self.pendingNatives = nativeImporter;
		BtrccPhaseTimer.mark("native");
		var inputs = self.sourceFiles.inputPaths();
		inputs.push(sourcePath);
		for path in packages.linkPlan.inputPaths() { inputs.push(path); }
		return BtrccResolvedCompilation(resolved, packages, sourcePath, self.sourceFiles.contentIdentity(), nativeImporter.cacheIdentity(), inputs);
	}

	public BtrccCompilationResult compileResolved(BtrccResolvedCompilation input, BtrccOptions options) {
		var resolved = input.source;
		FeNativeDeclarationImporter? natives = self.pendingNatives;
		if (natives != null) {
			self.pendingNatives = null;
			resolved.nativeDeclarations = natives.complete();
		}
		var packages = input.packages;
		string sourcePath = input.sourcePath;

		/* Every later stage reports at combined positions; the diagnostic
		 * owner maps them back to their own files. */
		FeDiagnosticSources.configure(resolved, sourcePath);
		Lexer lexer = Lexer(resolved.source, self.grammar);
		Vector<Token> tokens = lexer.tokenize();
		BtrccPhaseTimer.mark("lex");
		if (lexer.failed) {
			return self.failure(self.positionedDiagnostic(lexer.diagnostic));
		}

		Parser parser = Parser(tokens, self.grammar);
		Node program = parser.parseProgram();
		BtrccPhaseTimer.mark("parse");
		if (parser.failed) {
			return self.failure(self.positionedDiagnostic(parser.diagnostic));
		}

		self.hostedAbi.stampProgramSources(program, resolved.stdlibLineCount, resolved.userLines, sourcePath, self.stdlib.directory());
		Vector<Node> sourceDeclarations = program.declarations();
		Vector<Node> declarations = [];
		for imported in resolved.nativeDeclarations { declarations.push(imported.declaration); }
		for declaration in program.declarations() { declarations.push(declaration); }
		program.declarationsStorage = declarations;

		FeConditionalFailure? tested = FeConditionalTestChecker().verify(program, resolved, packages.linkPlan);
		if (tested != null) { return self.failure(tested.render()); }

		Map<string, bool>? visibleTypeParameters = null;
		if (options.strictImports) {
			FeImportVisibilityChecker visibility = FeImportVisibilityChecker(program, resolved, self.stdlib, self.stdlibSymbols, self.grammar, self.hostedAbi.sourceSymbolShadows(program), self.targetEnvironments());
			FeVisibilityCheckResult checked = visibility.check();
			if (!checked.success) {
				return self.failure("error: " + checked.diagnostic);
			}
			if (checked.diagnostics.len > 0) {
				return self.failure(self.visibilityDiagnostic(checked.diagnostics));
			}
			visibleTypeParameters = checked.visibleTypeParameters;
		}

		declarations = [];
		Vector<FeNativeImportedDeclaration> nativeDeclarations = [];
		for imported in resolved.nativeDeclarations {
			if (imported.coalesced) { continue; }
			declarations.push(imported.declaration);
			if (!imported.generatedInput) { nativeDeclarations.push(imported); }
		}
		for declaration in sourceDeclarations { declarations.push(declaration); }
		program.declarationsStorage = declarations;
		resolved.nativeDeclarations = nativeDeclarations;

		BtrccPhaseTimer.mark("visibility");
		GeneratedRuntimeCatalogData runtimeData = GeneratedRuntimeCatalogData();
		SourceRuntimeSymbols sourceRuntimeSymbols = SourceRuntimeSymbols(runtimeData.rows, runtimeData.intrinsicEffects);
		RuntimeHelperCatalog runtimeHelpers = RuntimeHelperCatalog(runtimeData.rows, runtimeData.intrinsicEffects);
		SemanticAnalyzer analyzer = SemanticAnalyzer(sourceRuntimeSymbols, self.macroRules(), packages.linkPlan.target.row());
		analyzer.configureNativeDeclarations(resolved.nativeDeclarations);
		analyzer.configureVisibleTypeParameters(visibleTypeParameters);
		analyzer.configureUnmodeledIncludes(program, resolved.stdlibLineCount, resolved.userLines);
		BtrccPhaseTimer.mark("catalog");
		/* Stage B: with module units and a store, unchanged groups replay
		 * their body-validation records instead of validating again. */
		ValidationRecords? records = null;
		IBtrccArtifactCache? store = self.moduleUnitStore;
		if (options.moduleUnits && !options.unitsPrefix.isEmpty() && options.useCache && store != null && resolved.strictImports) {
			records = ValidationRecords(program, sourceDeclarations, resolved, options, store, input.nativeIdentity);
			analyzer.configureValidationRecords(records);
			BtrccPhaseTimer.mark("a-records");
		}
		Analyzed analyzed = analyzer.analyze(program, self.hostedAbi);
		BtrccPhaseTimer.mark("analyze");
		if (records != null) {
			records.persist();
			BtrccPhaseTimer.mark(f"a-records-stored(replayed={records.replayed},journaled={records.journaled})");
			BtrccPhaseTimer.mark(f"a-instances(replayed={records.instancesReplayed})");
		}
		if (options.moduleUnits && !options.unitsPrefix.isEmpty()) {
			if (!resolved.strictImports) { return self.failure("error: module units require strict imports"); }
			Map<string, bool>? stdlibKeys = options.runDce ? StdlibReachability.classify(program.declarations(), self.hostedAbi) : null;
			ModuleUnitProgram unitProgram = ModuleUnitProgram(program, analyzed, analyzer, self.hostedAbi, runtimeHelpers, resolved, sourcePath, stdlibKeys);
			if (records != null) {
				unitProgram.interfaceDigest = records.interfaceDigest;
				unitProgram.knownSourceDigests = records.groupSourceDigests;
			}
			ModuleUnitBuild build = ModuleUnitCompiler(unitProgram, options, options.useCache ? self.moduleUnitStore : null, self.workerPools).compile();
			IRModule? programModule = build.program;
			if (programModule != null) {
				for name in programModule.nativeUnits.keys() {
					IRModule unit = programModule.nativeUnits.get(name);
					if ((unit.language != "objective-c" && unit.language != "c++") || unit.nativeUnits.len > 0) { throw "native adapter must be a standalone Objective-C or C++ unit"; }
					packages.linkPlan.generatedUnits.push(FeNativeGeneratedUnit(name, unit.language, unit.language == "c++" ? "c++17" : "c11", unit.language == "c++" ? "raii" : "arc", CEmitter().emit(unit)));
				}
			}
			string modulePrefix = FeNativeLinkPlan.outputPrefix(options.unitsPrefix);
			for (int unitIndex = 0; unitIndex < build.unitNames.len; unitIndex++) { packages.linkPlan.addEmittedUnit(modulePrefix + "." + build.unitNames.get(unitIndex) + ".c", build.units.get(unitIndex)); }
			keep program;
			keep resolved;
			keep analyzer;
			keep analyzed;
			BtrccPhaseTimer.print();
			BtrccCompilationResult moduleResult = BtrccCompilationResult(true, build.primary, self.renderedWarnings(analyzed, resolved, sourcePath), packages.linkPlan.canonicalJson());
			moduleResult.units = build.units;
			moduleResult.unitKeys = build.unitKeys;
			moduleResult.unitPaths = packages.linkPlan.emittedUnits;
			moduleResult.inputPaths = input.inputPaths;
			moduleResult.moduleUnitsLowered = build.lowered;
			moduleResult.moduleUnitsReused = build.reused;
			return moduleResult;
		}

		IRLowerer lowerer = IRLowerer(analyzed, self.hostedAbi, analyzer.declarationRegistry(), analyzer.operatorSemantics(), analyzer.expressionTypes(), analyzer.gpuSemantics(), analyzer.managedValueSemantics(), analyzer.cycleSemantics(), runtimeHelpers, sourcePath, resolved.stdlibLineCount, resolved.userLines);
		if (options.runDce) { lowerer.setStdlibKeys(StdlibReachability.classify(program.declarations(), self.hostedAbi)); }
		lowerer.setDebug(options.debug);
		IRModule module = lowerer.lower(program);
		module.debug = options.debug;
		if (options.debug && !options.outputPath.isEmpty()) { module.debugCfile = FeCanonicalPath.absolute(options.outputPath); }
		BtrccPhaseTimer.mark("lower");
		if (options.irDump == "ir") {
			/* As below: the graphs stay alive until the process exits. */
			keep program;
			keep resolved;
			keep analyzer;
			keep analyzed;
			keep lowerer;
			return self.irDump(module, analyzed, resolved, input, packages);
		}
		bool hasRealtimeRoot = false;
		int realtimeIndex = 0;
		while (realtimeIndex < module.functions.len) {
			if (module.functions.get(realtimeIndex).isRealtime) {
				hasRealtimeRoot = true;
			}
			realtimeIndex = realtimeIndex + 1;
		}
		if (hasRealtimeRoot) {
			/* Lowering already recorded generated realtime operations; the hosted
			 * and runtime allowlists join that set rather than replacing it. */
			Map<string, bool> hostedRealtimeSafe = self.hostedAbi.realtimeSafeFunctions();
			Vector<string> hostedSafeNames = hostedRealtimeSafe.keys();
			int hostedSafeIndex = 0;
			while (hostedSafeIndex < hostedSafeNames.len) {
				module.realtimeSafeExternals.put(hostedSafeNames.get(hostedSafeIndex), true);
				hostedSafeIndex = hostedSafeIndex + 1;
			}
			Map<string, bool> runtimeRealtimeSafe = runtimeHelpers.realtimeSafeFunctions();
			Vector<string> runtimeSafeNames = runtimeRealtimeSafe.keys();
			int runtimeSafeIndex = 0;
			while (runtimeSafeIndex < runtimeSafeNames.len) {
				module.realtimeSafeExternals.put(runtimeSafeNames.get(runtimeSafeIndex), true);
				runtimeSafeIndex = runtimeSafeIndex + 1;
			}
		}
		SetjmpEffectAnalysis setjmpEffects = SetjmpEffectAnalysis(self.hostedAbi);
		for imported in resolved.nativeDeclarations {
			var contract = imported.callContract;
			if (contract != null && contract.realtimeSafe) {
				module.realtimeSafeExternals.put(imported.declaration.name, true);
				if (!contract.adapterSymbol(imported.declaration.name).equals(imported.declaration.name)) { module.realtimeSafeExternals.put("__builtin_trap", true); }
			}
		}
		BtrccPhaseTimer.mark("setjmp-analysis");
		SetjmpSafetyPlanner setjmpSafety = SetjmpSafetyPlanner(setjmpEffects);
		IROptimizer optimizer = IROptimizer(setjmpSafety, runtimeHelpers);
		optimizer.optimize(module, options.runDce);
		BtrccPhaseTimer.mark("optimize");
		if (options.irDump == "optimized-ir") {
			/* As below: the graphs stay alive until the process exits. */
			keep program;
			keep resolved;
			keep analyzer;
			keep analyzed;
			keep lowerer;
			return self.irDump(module, analyzed, resolved, input, packages);
		}
		CEmitter emitter = CEmitter();
		for name in module.nativeUnits.keys() {
			IRModule unit = module.nativeUnits.get(name);
			if ((unit.language != "objective-c" && unit.language != "c++") || unit.nativeUnits.len > 0) { throw "native adapter must be a standalone Objective-C or C++ unit"; }
			packages.linkPlan.generatedUnits.push(FeNativeGeneratedUnit(name, unit.language, unit.language == "c++" ? "c++17" : "c11", unit.language == "c++" ? "raii" : "arc", CEmitter().emit(unit)));
		}
		Vector<string> units = [];
		string emitted = "";
		if (options.unitsPrefix.isEmpty()) { emitted = emitter.emit(module); }
		else {
			char* configuredUnitLines = getenv("BTRC_UNIT_LINES");
			string unitsPrefix = FeNativeLinkPlan.outputPrefix(options.unitsPrefix);
			units = emitter.emitUnits(module, configuredUnitLines == null ? 40000 : atoi(configuredUnitLines), unitsPrefix);
			emitted = units.get(0);
			units.remove(0);
			for (int index = 0; index < units.len; index++) {
				packages.linkPlan.addEmittedUnit(unitsPrefix + ".unit-" + Strings.fromInt(index + 1) + ".c", units.get(index));
			}
		}
		BtrccPhaseTimer.mark("emit");
		/* One compile is one process. Releasing the program, its analysis and
		 * the IR would cost the ARC runtime a reverse-reachability proof per
		 * reference (tens of seconds on a large program) for memory the exit
		 * frees anyway, so the graphs stay alive. */
		keep program;
		keep resolved;
		keep analyzer;
		keep analyzed;
		keep lowerer;
		keep module;
		BtrccPhaseTimer.print();
		BtrccCompilationResult result = BtrccCompilationResult(true, emitted, self.renderedWarnings(analyzed, resolved, sourcePath), packages.linkPlan.canonicalJson());
		result.units = units;
		result.unitPaths = packages.linkPlan.emittedUnits;
		result.inputPaths = input.inputPaths;
		return result;
	}
}
