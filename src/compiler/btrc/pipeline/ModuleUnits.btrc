/* Module units: one C unit per source compilation group, reused by key. */

import Library.BackgroundJobs.WorkerPools;
import Library.Timer;
import Library.Digest.SHA256;
import Library.JSON;
import Library.Map;
import Library.Platform;
import Library.Strings;
import Library.Vector;

import ../frontend/Models.btrc;
import ../frontend/SourceIo.btrc;
import ../frontend/Timing.btrc;
import ../ir/Stage.btrc;
import ./Models.btrc;

/* Interface renderings keep what lowering reads from a foreign body: that it
 * exists and which parameters its leading statements consume. */
class ModuleUnitInterfaceSummary implements IAstInterfaceSummary {
	public ModuleUnitInterfaceSummary() {}

	public string callableBody(Node callable) {
		Map<int, bool> consumed = DeclarationRegistry.ownedTransferParameters(callable);
		Vector<int> indices = consumed.keys();
		indices.sort();
		Vector<string> rendered = [];
		for index in indices { rendered.push(Strings.fromInt(index)); }
		return "defined consumed=" + Strings.join(rendered, ",");
	}
}

/* A unit's function reference graph: which functions each definition calls
 * or names, the unit's roots (entry, non-instance exports, global
 * initializers) and its generic-instance members, which are kept only where
 * some unit of the program needs them. */
class ModuleUnitGraph {
	public Map<string, Vector<string>> edges = {};
	public Vector<string> roots = [];
	public Map<string, bool> instances = {};

	public ModuleUnitGraph() {}

	class void references(IRNode? node, Map<string, bool> out) {
		if (node == null) { return; }
		if (node.kind == IRK_CALL && !node.callee.isEmpty()) { out.put(node.callee, true); }
		if ((node.kind == IRK_FUNCTION_REF || node.kind == IRK_VAR) && !node.name.isEmpty()) { out.put(node.name, true); }
		/* Visited field by field: a child list per node would allocate for
		 * every node of every unit. */
		ModuleUnitGraph.references(node.left, out);
		ModuleUnitGraph.references(node.right, out);
		ModuleUnitGraph.references(node.operand, out);
		ModuleUnitGraph.references(node.expr, out);
		ModuleUnitGraph.references(node.obj, out);
		ModuleUnitGraph.references(node.index, out);
		ModuleUnitGraph.references(node.condition, out);
		ModuleUnitGraph.references(node.trueExpr, out);
		ModuleUnitGraph.references(node.falseExpr, out);
		ModuleUnitGraph.references(node.init, out);
		ModuleUnitGraph.references(node.value, out);
		ModuleUnitGraph.references(node.target, out);
		ModuleUnitGraph.references(node.thenBlock, out);
		ModuleUnitGraph.references(node.elseBlock, out);
		ModuleUnitGraph.references(node.body, out);
		ModuleUnitGraph.references(node.update, out);
		ModuleUnitGraph.references(node.result, out);
		ModuleUnitGraph.references(node.arraySize, out);
		for argument in node.args() { ModuleUnitGraph.references(argument, out); }
		for statement in node.stmts() { ModuleUnitGraph.references(statement, out); }
	}

	/* Adds this graph to a record or worker reply: one line per function, its
	 * name then the names it references, tab-separated (C identifiers contain
	 * neither separator). */
	public void writeTo(JSONValue root) {
		Vector<string> lines = [];
		Vector<string> sources = self.edges.keys();
		sources.sort();
		for name in sources {
			Vector<string> row = [name];
			row.extend(self.edges.get(name));
			lines.push(Strings.join(row, "\t"));
		}
		root.set("graph-edges", JSONValue.makeString(Strings.join(lines, "\n")));
		root.set("graph-roots", ModuleUnitRecord.stringsJson(self.roots));
		Vector<string> instances = self.instances.keys();
		instances.sort();
		root.set("graph-instances", ModuleUnitRecord.stringsJson(instances));
	}

	/* Reads what writeTo wrote into `graph`; false for anything malformed. */
	class bool readFrom(JSONValue root, ModuleUnitGraph graph) {
		if (!root.get("graph-edges").isString()) { return false; }
		string edges = root.get("graph-edges").asString();
		if (!edges.isEmpty()) {
			for line in Strings.split(edges, "\n") {
				Vector<string> row = Strings.split(line, "\t");
				string name = row.get(0);
				if (name.isEmpty() || graph.edges.has(name)) { return false; }
				Vector<string> targets = [];
				for (int index = 1; index < row.len; index++) { targets.push(row.get(index)); }
				graph.edges.put(name, targets);
			}
		}
		if (!ModuleUnitRecord.stringsFrom(root.get("graph-roots"), graph.roots)) { return false; }
		Vector<string> instances = [];
		if (!ModuleUnitRecord.stringsFrom(root.get("graph-instances"), instances)) { return false; }
		for name in instances { graph.instances.put(name, true); }
		return true;
	}

	class ModuleUnitGraph fromUnit(IRModule unit, Map<string, bool> instanceNames) {
		ModuleUnitGraph graph = ModuleUnitGraph();
		for definition in unit.functions {
			Map<string, bool> refs = {};
			ModuleUnitGraph.references(definition.body, refs);
			Vector<string> names = refs.keys();
			names.sort();
			graph.edges.put(definition.name, names);
			if (instanceNames.has(definition.name) && !definition.isStatic) { graph.instances.put(definition.name, true); }
			else if (!definition.isStatic || definition.name == "main" || definition.name == "btrc_main") { graph.roots.push(definition.name); }
		}
		Map<string, bool> globalRefs = {};
		for global in unit.globalDecls {
			if (!global.isExtern) { ModuleUnitGraph.references(global.init, globalRefs); }
		}
		for name in globalRefs.keys() { graph.roots.push(name); }
		graph.roots.sort();
		return graph;
	}
}

/* Setjmp summaries between the owner and its workers, as text: one line per
 * function, its name, a tab, then writes, captures and returns (each a comma
 * list of index:depth) and whether its return is unknown, separated by '|'. */
class ModuleUnitSummaries {
	class string parameters(Vector<SetjmpParameterEffect> effects) {
		Vector<string> items = [];
		for effect in effects { items.push(Strings.fromInt(effect.index) + ":" + Strings.fromInt(effect.depth)); }
		return Strings.join(items, ",");
	}

	class string encode(Map<string, SetjmpFunctionEffect> effects) {
		Vector<string> names = effects.keys();
		names.sort();
		Vector<string> lines = [];
		for name in names {
			SetjmpFunctionEffect effect = effects.get(name);
			lines.push(name + "\t" + ModuleUnitSummaries.parameters(effect.writes) + "|" + ModuleUnitSummaries.parameters(effect.captures) + "|" + ModuleUnitSummaries.parameters(effect.returns) + "|" + (effect.unknownReturn ? "1" : "0"));
		}
		return Strings.join(lines, "\n");
	}

	class bool parametersFrom(string text, Vector<SetjmpParameterEffect> out) {
		if (text.isEmpty()) { return true; }
		for item in Strings.split(text, ",") {
			int separator = item.indexOf(":");
			if (separator <= 0 || separator >= item.length() - 1) { return false; }
			out.push(SetjmpParameterEffect(Strings.toInt(item.substring(0, separator)), Strings.toInt(item.substring(separator + 1, item.length() - separator - 1))));
		}
		return true;
	}

	/* Decodes what encode wrote into `out`; false for anything malformed. */
	class bool decode(string text, Map<string, SetjmpFunctionEffect> out) {
		if (text.isEmpty()) { return true; }
		for line in Strings.split(text, "\n") {
			if (!ModuleUnitSummaries.decodeLine(line, out)) { return false; }
		}
		return true;
	}

	class bool decodeLine(string line, Map<string, SetjmpFunctionEffect> out) {
		int tab = line.indexOf("\t");
		if (tab <= 0) { return false; }
		Vector<string> fields = Strings.split(line.substring(tab + 1, line.length() - tab - 1), "|");
		if (fields.len != 4 || !(fields.get(3).equals("0") || fields.get(3).equals("1"))) { return false; }
		SetjmpFunctionEffect effect = SetjmpFunctionEffect();
		if (!ModuleUnitSummaries.parametersFrom(fields.get(0), effect.writes) || !ModuleUnitSummaries.parametersFrom(fields.get(1), effect.captures) || !ModuleUnitSummaries.parametersFrom(fields.get(2), effect.returns)) { return false; }
		effect.unknownReturn = fields.get(3).equals("1");
		out.put(line.substring(0, tab), effect);
		return true;
	}
}

/* Everything later builds need from one group's finished unit. The emitted
 * text is final; the remaining fields are the program facts the unit
 * published or consulted, so a later build can decide whether reusing the
 * text is still exact without lowering the group again. */
class ModuleUnitRecord {
	public string group = "";
	public string text = "";
	public bool kept = false;
	public Vector<string> exports = [];
	public bool hasSetjmp = false;
	public bool effectsSolved = false;
	public Map<string, SetjmpFunctionEffect> exportedEffects = {};
	public Map<string, SetjmpFunctionEffect> consultedEffects = {};
	public bool releasesCyclable = false;
	public bool definesEntry = false;
	public bool programRelease = false;
	public Vector<string> helpers = [];
	/* This unit's realtime roots, and for every function of it a realtime
	 * proof has checked, the calls that proof left for the program to
	 * resolve: the unit's own part of any proof through it. */
	public Vector<string> realtimeRoots = [];
	public Map<string, Vector<string>> realtimeProofs = {};
	public ModuleUnitGraph graph = ModuleUnitGraph();
	/* The generic-instance members this unit's text defines. */
	public Vector<string> keptInstances = [];
	/* Every other group whose declaration bodies or source positions the unit
	 * copied, with that group's source digest when it was lowered: a kernel's
	 * WGSL, an inherited `__del__`, a `#line` or `__LINE__` position. None of
	 * them is in the program interface. */
	public Map<string, string> consultedSources = {};

	public ModuleUnitRecord() {}

	class JSONValue stringsJson(Vector<string> values) {
		JSONValue array = JSONValue.makeArray();
		for value in values { array.push(JSONValue.makeString(value)); }
		return array;
	}

	/* One line per proven function: its name, then the calls its proof left,
	 * tab-separated. */
	class string encodeProofs(Map<string, Vector<string>> proofs) {
		Vector<string> names = proofs.keys();
		names.sort();
		Vector<string> lines = [];
		for name in names {
			Vector<string> row = [name];
			Vector<string> callees = proofs.get(name).sorted();
			row.extend(callees);
			lines.push(Strings.join(row, "\t"));
		}
		return Strings.join(lines, "\n");
	}

	class bool decodeProofLine(string line, Map<string, Vector<string>> out) {
		Vector<string> row = Strings.split(line, "\t");
		if (row.get(0).isEmpty() || out.has(row.get(0))) { return false; }
		Vector<string> callees = [];
		for (int index = 1; index < row.len; index++) { callees.push(row.get(index)); }
		out.put(row.get(0), callees);
		return true;
	}

	/* One line per field and one counted section per table, tab-separated,
	 * so reading a record back is a split per line with nothing to unescape.
	 * Empty when a value cannot be carried in the format, and then nothing
	 * is stored. */
	public string toText() {
		Vector<string> lines = ["btrc-module-unit-record\t5", "group\t" + self.group];
		Vector<string> flags = ["flags"];
		for flag in [self.kept, self.hasSetjmp, self.effectsSolved, self.releasesCyclable, self.definesEntry, self.programRelease] { flags.push(flag ? "1" : "0"); }
		lines.push(Strings.join(flags, "\t"));
		lines.push(ModuleUnitRecord.listLine("exports", self.exports));
		lines.push(ModuleUnitRecord.listLine("helpers", self.helpers));
		lines.push(ModuleUnitRecord.listLine("realtime-roots", self.realtimeRoots));
		lines.push(ModuleUnitRecord.listLine("kept-instances", self.keptInstances));
		lines.push(ModuleUnitRecord.listLine("graph-roots", self.graph.roots));
		Vector<string> instances = self.graph.instances.keys();
		instances.sort();
		lines.push(ModuleUnitRecord.listLine("graph-instances", instances));
		ModuleUnitRecord.section(lines, "exported-effects", ModuleUnitSummaries.encode(self.exportedEffects));
		ModuleUnitRecord.section(lines, "consulted-effects", ModuleUnitSummaries.encode(self.consultedEffects));
		ModuleUnitRecord.section(lines, "realtime-proofs", ModuleUnitRecord.encodeProofs(self.realtimeProofs));
		Vector<string> edges = [];
		Vector<string> sources = self.graph.edges.keys();
		sources.sort();
		for name in sources {
			Vector<string> row = [name];
			row.extend(self.graph.edges.get(name));
			edges.push(Strings.join(row, "\t"));
		}
		ModuleUnitRecord.section(lines, "graph-edges", Strings.join(edges, "\n"));
		Vector<string> consulted = [];
		Vector<string> groups = self.consultedSources.keys();
		groups.sort();
		for group in groups {
			if (group.indexOf("\t") >= 0 || group.indexOf("\n") >= 0) { return ""; }
			consulted.push(group + "\t" + self.consultedSources.get(group));
		}
		ModuleUnitRecord.section(lines, "consulted-sources", Strings.join(consulted, "\n"));
		if (self.group.indexOf("\t") >= 0 || self.group.indexOf("\n") >= 0) { return ""; }
		return Strings.join(lines, "\n");
	}

	class string listLine(string name, Vector<string> values) {
		Vector<string> row = [name];
		row.extend(values);
		return Strings.join(row, "\t");
	}

	class void section(Vector<string> lines, string name, string text) {
		Vector<string> rows = [];
		if (!text.isEmpty()) { rows = Strings.split(text, "\n"); }
		lines.push("@" + name + "\t" + Strings.fromInt(rows.len));
		lines.extend(rows);
	}

	class bool listFrom(string line, string name, Vector<string> out) {
		Vector<string> row = Strings.split(line, "\t");
		if (!row.get(0).equals(name)) { return false; }
		for (int index = 1; index < row.len; index++) {
			if (row.get(index).isEmpty()) { return false; }
			out.push(row.get(index));
		}
		return true;
	}

	/* The row count of section `name` at `cursor[0]`, advancing past its header;
	 * -1 when the header is not that section or the rows run past the end. */
	class int sectionRows(Vector<string> lines, string name, Vector<int> cursor) {
		int at = cursor.get(0);
		if (at >= lines.len || !lines.get(at).startsWith("@" + name + "\t")) { return -1; }
		int count = Strings.toInt(lines.get(at).substring(name.length() + 2, lines.get(at).length() - name.length() - 2));
		if (count < 0 || at + 1 + count > lines.len) { return -1; }
		cursor.set(0, at + 1);
		return count;
	}

	class bool stringsFrom(JSONValue value, Vector<string> out) {
		if (!value.isArray()) { return false; }
		for (int index = 0; index < value.size(); index++) {
			if (!value.at(index).isString()) { return false; }
			out.push(value.at(index).asString());
		}
		return true;
	}

	/* A stored unit's record, or null for anything not exactly well formed. */
	class ModuleUnitRecord? fromPayload(BtrccModuleUnitPayload? payload, string group) {
		if (payload == null) { return null; }
		Vector<string> lines = Strings.split(payload.record, "\n");
		if (lines.len < 9 || !lines.get(0).equals("btrc-module-unit-record\t5") || !lines.get(1).equals("group\t" + group)) { return null; }
		Vector<string> flags = Strings.split(lines.get(2), "\t");
		if (flags.len != 7 || !flags.get(0).equals("flags")) { return null; }
		for (int index = 1; index < 7; index++) {
			if (!flags.get(index).equals("0") && !flags.get(index).equals("1")) { return null; }
		}
		ModuleUnitRecord record = ModuleUnitRecord();
		record.group = group;
		record.text = payload.text;
		record.kept = flags.get(1).equals("1");
		record.hasSetjmp = flags.get(2).equals("1");
		record.effectsSolved = flags.get(3).equals("1");
		record.releasesCyclable = flags.get(4).equals("1");
		record.definesEntry = flags.get(5).equals("1");
		record.programRelease = flags.get(6).equals("1");
		Vector<string> instances = [];
		if (!ModuleUnitRecord.listFrom(lines.get(3), "exports", record.exports) || !ModuleUnitRecord.listFrom(lines.get(4), "helpers", record.helpers) || !ModuleUnitRecord.listFrom(lines.get(5), "realtime-roots", record.realtimeRoots) || !ModuleUnitRecord.listFrom(lines.get(6), "kept-instances", record.keptInstances) || !ModuleUnitRecord.listFrom(lines.get(7), "graph-roots", record.graph.roots) || !ModuleUnitRecord.listFrom(lines.get(8), "graph-instances", instances)) { return null; }
		for name in instances { record.graph.instances.put(name, true); }
		Vector<int> cursor = [9];
		int count = ModuleUnitRecord.sectionRows(lines, "exported-effects", cursor);
		if (count < 0) { return null; }
		for (int index = 0; index < count; index++) { if (!ModuleUnitSummaries.decodeLine(lines.get(cursor.get(0) + index), record.exportedEffects)) { return null; } }
		cursor.set(0, cursor.get(0) + count);
		count = ModuleUnitRecord.sectionRows(lines, "consulted-effects", cursor);
		if (count < 0) { return null; }
		for (int index = 0; index < count; index++) { if (!ModuleUnitSummaries.decodeLine(lines.get(cursor.get(0) + index), record.consultedEffects)) { return null; } }
		cursor.set(0, cursor.get(0) + count);
		count = ModuleUnitRecord.sectionRows(lines, "realtime-proofs", cursor);
		if (count < 0) { return null; }
		for (int index = 0; index < count; index++) { if (!ModuleUnitRecord.decodeProofLine(lines.get(cursor.get(0) + index), record.realtimeProofs)) { return null; } }
		cursor.set(0, cursor.get(0) + count);
		count = ModuleUnitRecord.sectionRows(lines, "graph-edges", cursor);
		if (count < 0) { return null; }
		for (int index = 0; index < count; index++) {
			Vector<string> row = Strings.split(lines.get(cursor.get(0) + index), "\t");
			string name = row.get(0);
			if (name.isEmpty() || record.graph.edges.has(name)) { return null; }
			Vector<string> targets = [];
			for (int target = 1; target < row.len; target++) { targets.push(row.get(target)); }
			record.graph.edges.put(name, targets);
		}
		cursor.set(0, cursor.get(0) + count);
		count = ModuleUnitRecord.sectionRows(lines, "consulted-sources", cursor);
		if (count < 0) { return null; }
		for (int index = 0; index < count; index++) {
			Vector<string> row = Strings.split(lines.get(cursor.get(0) + index), "\t");
			if (row.len != 2 || row.get(0).isEmpty() || record.consultedSources.has(row.get(0))) { return null; }
			record.consultedSources.put(row.get(0), row.get(1));
		}
		if (cursor.get(0) + count != lines.len) { return null; }
		return record;
	}
}

/* The program's declaration-level IR, drawn from by every module unit. One
 * declarations-only lowering produces every type, prototype and extern global;
 * a unit lowers only what its group owns and then takes, by name closure, the
 * shared declarations its own IR references. Every unit lowers the program's
 * whole directive list itself, in source order. */
class ModuleUnitDeclarations {
	private IRModule shared;
	/* Entry kinds: 0 forward, 1 enum, 2 function-pointer typedef, 3 typedef,
	 * 4 tagged union, 5 struct, 6 prototype, 7 extern global. */
	private Vector<int> kinds = [];
	private Vector<int> positions = [];
	private Vector<Map<string, bool>> provides = [];
	private Vector<Map<string, bool>> references = [];
	private Map<string, Vector<int>> providers = {};

	public ModuleUnitDeclarations(IRModule shared) {
		self.shared = shared;
		int index = 0;
		while (index < shared.structForwards.len) { self.add(0, index, shared.structForwards.get(index).name, null, null); index++; }
		index = 0;
		while (index < shared.enumDefs.len) {
			IREnumDef definition = shared.enumDefs.get(index);
			Map<string, bool> names = {};
			Map<string, bool> refs = {};
			if (!definition.name.isEmpty()) { names.put(definition.name, true); }
			for value in definition.values {
				names.put(value.name, true);
				ModuleUnitDeclarations.collectNode(value.value, refs);
			}
			self.addNames(1, index, names, refs);
			index++;
		}
		index = 0;
		while (index < shared.functionPointerTypedefs.len) {
			IRFunctionPointerTypedef alias = shared.functionPointerTypedefs.get(index);
			Map<string, bool> refs = {};
			ModuleUnitDeclarations.collectText(alias.returnType, refs);
			for parameter in alias.paramTypes { ModuleUnitDeclarations.collectText(parameter, refs); }
			self.add(2, index, alias.name, refs, null);
			index++;
		}
		index = 0;
		while (index < shared.typedefDefs.len) {
			IRTypedefDef alias = shared.typedefDefs.get(index);
			Map<string, bool> refs = {};
			ModuleUnitDeclarations.collectText(alias.targetType, refs);
			self.add(3, index, alias.name, refs, null);
			index++;
		}
		index = 0;
		while (index < shared.taggedUnionDefs.len) {
			IRTaggedUnionDef tagged = shared.taggedUnionDefs.get(index);
			Map<string, bool> names = {};
			Map<string, bool> refs = {};
			names.put(tagged.name, true);
			ModuleUnitDeclarations.collectText(tagged.tagType, refs);
			for variant in tagged.variants {
				if (variant.fields.len > 0) { names.put(tagged.name + "_" + variant.name + "_Data", true); }
				for field in variant.fields { ModuleUnitDeclarations.collectField(field, refs); }
			}
			self.addNames(4, index, names, refs);
			index++;
		}
		index = 0;
		while (index < shared.structDefs.len) {
			IRStructDef definition = shared.structDefs.get(index);
			Map<string, bool> refs = {};
			for field in definition.fields { ModuleUnitDeclarations.collectField(field, refs); }
			self.add(5, index, definition.name, refs, null);
			index++;
		}
		index = 0;
		while (index < shared.functionDecls.len) {
			IRFunctionDecl declaration = shared.functionDecls.get(index);
			Map<string, bool> refs = {};
			ModuleUnitDeclarations.collectText(declaration.returnType, refs);
			for parameter in declaration.params { ModuleUnitDeclarations.collectText(parameter.cType, refs); }
			self.add(6, index, declaration.name, refs, null);
			index++;
		}
		index = 0;
		while (index < shared.globalDecls.len) {
			IRGlobalDecl global = shared.globalDecls.get(index);
			if (global.isExtern) {
				Map<string, bool> refs = {};
				ModuleUnitDeclarations.collectText(global.cType, refs);
				ModuleUnitDeclarations.collectNode(global.arraySize, refs);
				self.add(7, index, global.name, refs, null);
			}
			index++;
		}
	}

	private void add(int kind, int position, string name, Map<string, bool>? refs, Map<string, bool>? unused) {
		Map<string, bool> names = {};
		names.put(name, true);
		Map<string, bool> resolved = {};
		if (refs != null) { resolved = refs; }
		self.addNames(kind, position, names, resolved);
	}

	private void addNames(int kind, int position, Map<string, bool> names, Map<string, bool> refs) {
		int entry = self.kinds.len;
		self.kinds.push(kind);
		self.positions.push(position);
		self.provides.push(names);
		self.references.push(refs);
		for name in names.keys() {
			if (!self.providers.has(name)) {
				Vector<int> none = [];
				self.providers.put(name, none);
			}
			self.providers.get(name).push(entry);
		}
	}

	class bool identifierCharacter(char value) { return (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z') || (value >= '0' && value <= '9') || value == '_'; }

	/* Every identifier token of C text. */
	class void collectText(string text, Map<string, bool> out) {
		int length = text.length();
		int index = 0;
		while (index < length) {
			while (index < length && !ModuleUnitDeclarations.identifierCharacter(text[index])) { index++; }
			int start = index;
			while (index < length && ModuleUnitDeclarations.identifierCharacter(text[index])) { index++; }
			if (start < index && !(text[start] >= '0' && text[start] <= '9')) { out.put(text.substring(start, index - start), true); }
		}
	}

	class void collectField(IRStructField field, Map<string, bool> out) {
		ModuleUnitDeclarations.collectText(field.cType, out);
		ModuleUnitDeclarations.collectNode(field.arraySize, out);
	}

	/* Every name and C type an IR subtree mentions. */
	class void collectNode(IRNode? node, Map<string, bool> out) {
		if (node == null) { return; }
		if (!node.name.isEmpty()) { out.put(node.name, true); }
		if (!node.callee.isEmpty()) { out.put(node.callee, true); }
		ModuleUnitDeclarations.collectText(node.targetType, out);
		ModuleUnitDeclarations.collectText(node.cType, out);
		ModuleUnitDeclarations.collectText(node.text, out);
		Vector<IRParam>? parameters = node.params;
		if (parameters != null) { for parameter in parameters { ModuleUnitDeclarations.collectText(parameter.cType, out); } }
		ModuleUnitDeclarations.collectNode(node.left, out);
		ModuleUnitDeclarations.collectNode(node.right, out);
		ModuleUnitDeclarations.collectNode(node.operand, out);
		ModuleUnitDeclarations.collectNode(node.expr, out);
		ModuleUnitDeclarations.collectNode(node.obj, out);
		ModuleUnitDeclarations.collectNode(node.index, out);
		ModuleUnitDeclarations.collectNode(node.condition, out);
		ModuleUnitDeclarations.collectNode(node.trueExpr, out);
		ModuleUnitDeclarations.collectNode(node.falseExpr, out);
		ModuleUnitDeclarations.collectNode(node.arraySize, out);
		ModuleUnitDeclarations.collectNode(node.init, out);
		ModuleUnitDeclarations.collectNode(node.value, out);
		ModuleUnitDeclarations.collectNode(node.target, out);
		ModuleUnitDeclarations.collectNode(node.thenBlock, out);
		ModuleUnitDeclarations.collectNode(node.elseBlock, out);
		ModuleUnitDeclarations.collectNode(node.body, out);
		ModuleUnitDeclarations.collectNode(node.update, out);
		ModuleUnitDeclarations.collectNode(node.result, out);
		for argument in node.args() { ModuleUnitDeclarations.collectNode(argument, out); }
		for statement in node.stmts() { ModuleUnitDeclarations.collectNode(statement, out); }
	}

	private Map<string, bool> unitProvided(IRModule unit, int kind) {
		Map<string, bool> names = {};
		if (kind == 0) { for item in unit.structForwards { names.put(item.name, true); } }
		else if (kind == 1) { for item in unit.enumDefs { if (!item.name.isEmpty()) { names.put(item.name, true); } for value in item.values { names.put(value.name, true); } } }
		else if (kind == 2) { for item in unit.functionPointerTypedefs { names.put(item.name, true); } }
		else if (kind == 3) { for item in unit.typedefDefs { names.put(item.name, true); } }
		else if (kind == 4) {
			for item in unit.taggedUnionDefs {
				names.put(item.name, true);
				for variant in item.variants { if (variant.fields.len > 0) { names.put(item.name + "_" + variant.name + "_Data", true); } }
			}
		}
		else if (kind == 5) { for item in unit.structDefs { names.put(item.name, true); } }
		else if (kind == 6) { for item in unit.functionDecls { names.put(item.name, true); } }
		else { for item in unit.globalDecls { names.put(item.name, true); } }
		return names;
	}

	/* Add the shared declarations `unit` needs that it does not provide. */
	/* Native binding headers and the C names each declares. A group unit
	 * keeps only the headers whose names its final C mentions: every unit
	 * otherwise includes every binding header of the program, and the SDK
	 * headers behind them dominate each unit's preprocessing and compile. */
	private Map<string, Map<string, bool>> nativeHeaderNames = {};

	public void configureNativeHeaders(Vector<FeNativeImportedDeclaration> imported) {
		for native in imported {
			if (native.language != "c") { continue; }
			if (!self.nativeHeaderNames.has(native.header)) { self.nativeHeaderNames.put(native.header, {}); }
			Map<string, bool> names = self.nativeHeaderNames.get(native.header);
			Node declaration = native.declaration;
			if (!declaration.name.isEmpty()) { names.put(declaration.name, true); }
			if (declaration.alias != null && !declaration.alias.isEmpty()) { names.put(declaration.alias, true); }
			for value in declaration.values() { if (!value.name.isEmpty()) { names.put(value.name, true); } }
			/* A type spelling such as `struct AudioBuffer` names the type; its C
			 * keywords and built-in types name nothing the header declares. */
			Map<string, bool> spelled = {};
			ModuleUnitDeclarations.collectText(native.typeSpelling, spelled);
			for word in spelled.keys() { if (!ModuleUnitDeclarations.builtinWord(word)) { names.put(word, true); } }
		}
	}

	class bool builtinWord(string word) { return word == "struct" || word == "union" || word == "enum" || word == "const" || word == "volatile" || word == "restrict" || word == "signed" || word == "unsigned" || word == "char" || word == "short" || word == "int" || word == "long" || word == "float" || word == "double" || word == "void" || word == "bool" || word == "_Bool"; }

	/* The runtime unit's module: `unit`'s helpers under its prologue, without
	 * the native binding headers no helper reads. */
	public IRModule runtimeModule(IRModule unit) {
		IRModule runtime = IRModule();
		for declaration in unit.preprocessorDecls { if (!self.nativeInclude(declaration)) { runtime.preprocessorDecls.push(declaration); } }
		for helper in unit.helpers { runtime.helpers.push(helper); }
		return runtime;
	}

	private bool nativeInclude(IRPreprocessorDecl declaration) { return declaration.kind == IR_PREPROCESSOR_INCLUDE && !declaration.isSystem && self.nativeHeaderNames.has(declaration.header); }

	/* Keeps a native binding include only when the unit's C, emitted without
	 * any of them, names something the header declares; a header whose names
	 * are unknown stays. The draft emission is the complete inventory of the
	 * identifiers the C compiler will see. */
	public void trimNativeIncludes(IRModule unit) {
		if (self.nativeHeaderNames.len == 0) { return; }
		Vector<IRPreprocessorDecl> all = unit.preprocessorDecls;
		Vector<IRPreprocessorDecl> others = [];
		for declaration in all { if (!self.nativeInclude(declaration)) { others.push(declaration); } }
		if (others.len == all.len) { return; }
		unit.preprocessorDecls = others;
		Map<string, bool> used = {};
		ModuleUnitDeclarations.collectText(CEmitter().emitModuleUnit(unit), used);
		Vector<IRPreprocessorDecl> kept = [];
		for declaration in all {
			if (self.nativeInclude(declaration)) {
				Map<string, bool> names = self.nativeHeaderNames.get(declaration.header);
				bool needed = names.len == 0;
				for name in names.keys() { if (used.has(name)) { needed = true; } }
				if (!needed) { continue; }
			}
			kept.push(declaration);
		}
		unit.preprocessorDecls = kept;
	}

	public void mergeInto(IRModule unit) {
		Vector<Map<string, bool>> provided = [];
		for (int kind = 0; kind < 8; kind++) { provided.push(self.unitProvided(unit, kind)); }
		Map<string, bool> roots = {};
		for item in unit.enumDefs { for value in item.values { ModuleUnitDeclarations.collectNode(value.value, roots); } }
		for item in unit.functionPointerTypedefs {
			ModuleUnitDeclarations.collectText(item.returnType, roots);
			for parameter in item.paramTypes { ModuleUnitDeclarations.collectText(parameter, roots); }
		}
		for item in unit.typedefDefs { ModuleUnitDeclarations.collectText(item.targetType, roots); }
		for item in unit.taggedUnionDefs {
			ModuleUnitDeclarations.collectText(item.tagType, roots);
			for variant in item.variants { for field in variant.fields { ModuleUnitDeclarations.collectField(field, roots); } }
		}
		for item in unit.structDefs { for field in item.fields { ModuleUnitDeclarations.collectField(field, roots); } }
		for item in unit.functionDecls {
			ModuleUnitDeclarations.collectText(item.returnType, roots);
			for parameter in item.params { ModuleUnitDeclarations.collectText(parameter.cType, roots); }
		}
		for item in unit.globalDecls {
			ModuleUnitDeclarations.collectText(item.cType, roots);
			ModuleUnitDeclarations.collectNode(item.init, roots);
			ModuleUnitDeclarations.collectNode(item.arraySize, roots);
		}
		for definition in unit.functions {
			ModuleUnitDeclarations.collectText(definition.returnType, roots);
			for parameter in definition.params { ModuleUnitDeclarations.collectText(parameter.cType, roots); }
			ModuleUnitDeclarations.collectNode(definition.body, roots);
		}
		for declaration in unit.objectiveCClasses {
			for field in declaration.fields { ModuleUnitDeclarations.collectField(field, roots); }
			for method in declaration.methods {
				ModuleUnitDeclarations.collectText(method.returnType, roots);
				for parameter in method.params { ModuleUnitDeclarations.collectText(parameter.cType, roots); }
				ModuleUnitDeclarations.collectNode(method.body, roots);
			}
		}
		for helper in unit.helpers { ModuleUnitDeclarations.collectText(helper, roots); }
		for declaration in self.shared.preprocessorDecls { ModuleUnitDeclarations.collectText(declaration.replacement, roots); }
		for declaration in unit.preprocessorDecls { ModuleUnitDeclarations.collectText(declaration.replacement, roots); }
		Map<int, bool> included = {};
		Vector<string> pending = roots.keys();
		Map<string, bool> seen = {};
		for name in pending { seen.put(name, true); }
		while (pending.len > 0) {
			string name = pending.pop();
			if (!self.providers.has(name)) { continue; }
			for entry in self.providers.get(name) {
				if (included.has(entry)) { continue; }
				Map<string, bool> own = provided.get(self.kinds.get(entry));
				bool alreadyOwned = own.len > 0;
				for providedName in self.provides.get(entry).keys() {
					if (!own.has(providedName)) { alreadyOwned = false; }
				}
				if (alreadyOwned) { continue; }
				included.put(entry, true);
				for reference in self.references.get(entry).keys() {
					if (!seen.has(reference)) {
						seen.put(reference, true);
						pending.push(reference);
					}
				}
			}
		}
		Vector<int> entries = included.keys();
		entries.sort();
		for entry in entries {
			int kind = self.kinds.get(entry);
			int position = self.positions.get(entry);
			if (kind == 0) { unit.structForwards.push(self.shared.structForwards.get(position)); }
			else if (kind == 1) { unit.enumDefs.push(self.shared.enumDefs.get(position)); }
			else if (kind == 2) { unit.functionPointerTypedefs.push(self.shared.functionPointerTypedefs.get(position)); }
			else if (kind == 3) { unit.typedefDefs.push(self.shared.typedefDefs.get(position)); }
			else if (kind == 4) { unit.taggedUnionDefs.push(self.shared.taggedUnionDefs.get(position)); }
			else if (kind == 5) { unit.structDefs.push(self.shared.structDefs.get(position)); }
			else if (kind == 6) { unit.functionDecls.push(self.shared.functionDecls.get(position)); }
			else { unit.globalDecls.push(self.shared.globalDecls.get(position)); }
		}
		/* The unit already lowered the program's whole directive list in source
		 * order. A runtime header the shared declarations need is added once;
		 * only identical includes are deduplicated, and macros never are. */
		for declaration in self.shared.preprocessorDecls {
			if (declaration.kind != IR_PREPROCESSOR_INCLUDE) { continue; }
			bool present = false;
			for existing in unit.preprocessorDecls {
				if (existing.kind == declaration.kind && existing.header.equals(declaration.header) && existing.isSystem == declaration.isSystem && existing.name.equals(declaration.name) && existing.replacement.equals(declaration.replacement)) { present = true; }
			}
			if (!present) { unit.preprocessorDecls.push(declaration); }
		}
	}
}

/* One group's state during a module-unit compile. A stale group's unit
 * lives in the worker that lowered it; the owner keeps what the worker
 * reported about it. */
class ModuleUnitGroupState {
	public string name;
	public string key;
	public int lines = 0;
	public ModuleUnitRecord? record = null;
	/* Whether the store holds the record's text under this state's key. */
	public bool stored = false;
	public bool stale = false;
	public int worker = -1;
	public Vector<string> exports = [];
	public bool releasesCyclable = false;
	public Vector<string> realtimeRoots = [];
	public Vector<string> realtimeSafe = [];
	public Vector<string> realtimeReached = [];
	public int analyzedRound = -1;
	public Map<string, bool> consulted = {};
	public Map<string, Vector<string>> realtimeProofs = {};
	public bool hasSetjmp = false;
	public Vector<string> helpers = [];
	public ModuleUnitGraph graph = ModuleUnitGraph();
	public Map<string, bool> keptInstances = {};

	public ModuleUnitGroupState(string name, string key) {
		self.name = name;
		self.key = key;
	}
}

/* The finished units of one module-unit compile and how they were made. */
class ModuleUnitBuild {
	public string primary = "";
	public Vector<string> units = [];
	public Vector<string> unitNames = [];
	/* Per unit, the module-unit identity its text is stored under, or empty. */
	public Vector<string> unitKeys = [];
	public Vector<string> lowered = [];
	public Vector<string> reused = [];
	public IRModule? program = null;

	public ModuleUnitBuild() {}
}

/* The analyzed program and services each module-unit lowering consumes. */
class ModuleUnitProgram {
	public Node program;
	public Analyzed analyzed;
	public DeclarationRegistry declarations;
	public OperatorSemantics operators;
	public ExpressionTypeResolver expressionTypes;
	public GpuSemantics gpuSemantics;
	public ManagedValueSemantics managedValues;
	public CycleSemantics cycles;
	public HostedAbiRepository hostedAbi;
	public RuntimeHelperCatalog runtimeHelpers;
	public FeResolvedSource resolved;
	public string sourcePath;
	public Map<string, bool>? stdlibKeys;
	/* The program's pre-analysis interface digest when validation records
	 * computed it (per-group, cached); empty otherwise. */
	public string interfaceDigest = "";
	/* Source digests of groups already taken, by module-unit group name; a
	 * group's digest is of its lines, in order, as groupSourceDigests takes. */
	public Map<string, string> knownSourceDigests = {};

	public ModuleUnitProgram(Node program, Analyzed analyzed, SemanticAnalyzer analyzer, HostedAbiRepository hostedAbi, RuntimeHelperCatalog runtimeHelpers, FeResolvedSource resolved, string sourcePath, Map<string, bool>? stdlibKeys) {
		self.program = program;
		self.analyzed = analyzed;
		self.declarations = analyzer.declarationRegistry();
		self.operators = analyzer.operatorSemantics();
		self.expressionTypes = analyzer.expressionTypes();
		self.gpuSemantics = analyzer.gpuSemantics();
		self.managedValues = analyzer.managedValueSemantics();
		self.cycles = analyzer.cycleSemantics();
		self.hostedAbi = hostedAbi;
		self.runtimeHelpers = runtimeHelpers;
		self.resolved = resolved;
		self.sourcePath = sourcePath;
		self.stdlibKeys = stdlibKeys;
	}
}

/* Lower, optimize and emit one C unit per group, reusing unchanged units.
 * Every stale group is lowered on its own against the whole analyzed program,
 * so a unit's text depends only on its group's inputs. Program facts that
 * whole-program lowering reads from every body are combined across units:
 * setjmp call effects are solved over the stale units with reused units'
 * published summaries fixed, and a reused unit whose consulted facts moved, or
 * that shares a summary cycle or realtime proof with a stale group, is lowered
 * again. */
class ModuleUnitCompiler {
	private ModuleUnitProgram input;
	private BtrccOptions options;
	private IBtrccArtifactCache? store;
	private FeCompilationGroups groups;
	private Map<string, string> groupOfFile = {};
	private LoweringProgramFacts facts;
	private Vector<FeLine> noLines = [];
	private IWorkerPoolFactory? pools;
	private int workers;

	/* `pools` starts worker processes where the host can fork; without it,
	 * or with one worker, the owner answers every request itself. */
	public ModuleUnitCompiler(ModuleUnitProgram input, BtrccOptions options, IBtrccArtifactCache? store, IWorkerPoolFactory? pools) {
		self.input = input;
		self.options = options;
		self.store = store;
		self.pools = pools;
		self.workers = options.moduleJobs;
		if (self.workers < 1) {
			/* One per CPU, at most four (the pool's suggestion). Each worker
			 * copies much of the analyzed program as ARC touches it; since the
			 * IR nodes stopped allocating unused lists, four keep a cold
			 * BTRSmith transpile at a sampled 4.97 GiB aggregate, inside the
			 * 6 GiB budget, and take it from 65.6 s with two to 52.6 s. */
			self.workers = pools != null ? pools.suggestedWorkers() : 1;
		}
		self.facts = LoweringProgramFacts();
		FeSourcePathPolicy paths = FeSourcePathPolicy();
		self.groups = input.resolved.dependencies.compilationGroups(paths.identity(input.resolved.rootSourcePath));
		for line in input.resolved.userLines {
			if (!self.groupOfFile.has(line.sourceFile)) { self.groupOfFile.put(line.sourceFile, self.groups.groupOfIdentity(paths.identity(line.sourceFile))); }
		}
	}

	/* The unit that defines every runtime helper of the program; a group's
	 * unit is named for its path hash and so never takes this name. */
	class string runtimeUnitName() { return "unit-runtime"; }

	/* A stable output name for a group's unit: its file stem and path hash. */
	class string unitName(string group) {
		string stem = group;
		int slash = stem.lastIndexOf("/");
		if (slash >= 0) { stem = stem.substring(slash + 1, stem.length() - slash - 1); }
		if (stem.endsWith(".btrc")) { stem = stem.substring(0, stem.length() - 5); }
		string slug = "";
		for (int index = 0; index < stem.length(); index++) {
			char value = stem[index];
			bool alphanumeric = (value >= 'a' && value <= 'z') || (value >= 'A' && value <= 'Z') || (value >= '0' && value <= '9');
			slug = slug + (alphanumeric ? stem.substring(index, 1) : "-");
		}
		if (slug.isEmpty() || slug.startsWith("-")) { slug = "group" + slug; }
		return "unit-" + slug + "-" + SHA256.digest(group).substring(0, 12);
	}

	private IRLowerer lowerer(string ownedGroup, bool declarationsElsewhere) {
		ModuleUnitProgram input = self.input;
		Vector<FeLine> lines = self.facts.sourceConfigured ? self.noLines : input.resolved.userLines;
		IRLowerer lowerer = IRLowerer(input.analyzed, input.hostedAbi, input.declarations, input.operators, input.expressionTypes, input.gpuSemantics, input.managedValues, input.cycles, input.runtimeHelpers, input.sourcePath, input.resolved.stdlibLineCount, lines);
		lowerer.shareProgramFacts(self.facts);
		if (self.options.runDce) { lowerer.setStdlibKeys(input.stdlibKeys); }
		lowerer.setDebug(self.options.debug);
		lowerer.configureModuleUnit(ownedGroup, self.groupOfFile, declarationsElsewhere);
		return lowerer;
	}

	private Map<string, bool> lastInstances = {};
	private Map<string, bool> lastConsulted = {};

	/* The generic-instance members the last lowered group defines. */
	public Map<string, bool> lastInstanceNames() { return self.lastInstances; }

	/* The files whose declaration bodies or positions the last lowered group copied. */
	public Map<string, bool> lastConsultedSources() { return self.lastConsulted; }

	public HostedAbiRepository hostedAbi() { return self.input.hostedAbi; }

	public RuntimeHelperCatalog runtimeHelpers() { return self.input.runtimeHelpers; }

	public bool runsDce() { return self.options.runDce; }

	/* Debug builds map a unit's generated lines back to its own file. */
	public void prepareDebugPaths(IRModule unit, string group) {
		if (self.options.debug) { unit.debugCfile = FeNativeLinkPlan.outputPrefix(self.options.unitsPrefix) + "." + ModuleUnitCompiler.unitName(group) + ".c"; }
	}

	/* Realtime-safe externals every unit shares: native realtime contracts and
	 * the hosted and runtime allowlists. */
	private Map<string, bool>? baseSafe = null;

	public Map<string, bool> baseRealtimeSafe() {
		Map<string, bool>? known = self.baseSafe;
		if (known != null) { return known; }
		IRModule probe = IRModule();
		self.addNativeRealtimeExternals(probe);
		for name in self.input.hostedAbi.realtimeSafeFunctions().keys() { probe.realtimeSafeExternals.put(name, true); }
		for name in self.input.runtimeHelpers.realtimeSafeFunctions().keys() { probe.realtimeSafeExternals.put(name, true); }
		self.baseSafe = probe.realtimeSafeExternals;
		return probe.realtimeSafeExternals;
	}

	public IRModule lowerGroup(string name, ModuleUnitDeclarations shared) {
		BtrccPhaseTimer.mark("u-between");
		IRLowerer lowerer = self.lowerer(name, true);
		BtrccPhaseTimer.mark("u-construct");
		IRModule unit = lowerer.lower(self.input.program);
		self.lastInstances = lowerer.instanceDefinitions();
		self.lastConsulted = lowerer.consultedSources();
		unit.debug = self.options.debug;
		shared.mergeInto(unit);
		self.addNativeRealtimeExternals(unit);
		BtrccPhaseTimer.mark("u-merge");
		/* As in whole-program compiles, a session's object graph lives until the
		 * process exits: releasing it would prove each entry unreachable. */
		keep lowerer;
		return unit;
	}

	/* Which generic-instance members each unit must keep: the fixed point of
	 * every unit's roots through the program's reference graphs. */
	private void demandInstances(Vector<ModuleUnitGroupState> states, ModuleUnitGraph programGraph) {
		Map<string, string> instanceOwner = {};
		Map<string, ModuleUnitGraph> graphs = {};
		for state in states {
			ModuleUnitGraph graph = state.graph;
			ModuleUnitRecord? record = state.record;
			if (!state.stale && record != null) { graph = record.graph; }
			graphs.put(state.name, graph);
			state.keptInstances = {};
			for name in graph.instances.keys() { if (!instanceOwner.has(name)) { instanceOwner.put(name, state.name); } }
		}
		graphs.put("", programGraph);
		Map<string, Map<string, bool>> kept = {};
		Vector<string> pendingGroups = [];
		Vector<string> pendingNames = [];
		for group in graphs.keys() {
			Map<string, bool> none = {};
			kept.put(group, none);
			for root in graphs.get(group).roots {
				pendingGroups.push(group);
				pendingNames.push(root);
			}
		}
		while (pendingNames.len > 0) {
			string group = pendingGroups.pop();
			string name = pendingNames.pop();
			ModuleUnitGraph graph = graphs.get(group);
			if (!graph.edges.has(name)) {
				if (instanceOwner.has(name) && !instanceOwner.get(name).equals(group)) {
					pendingGroups.push(instanceOwner.get(name));
					pendingNames.push(name);
				}
				continue;
			}
			Map<string, bool> marked = kept.get(group);
			if (marked.has(name)) { continue; }
			marked.put(name, true);
			for reference in graph.edges.get(name) {
				pendingGroups.push(group);
				pendingNames.push(reference);
			}
		}
		for state in states {
			ModuleUnitGraph graph = graphs.get(state.name);
			Map<string, bool> marked = kept.get(state.name);
			for name in graph.instances.keys() { if (marked.has(name)) { state.keptInstances.put(name, true); } }
		}
	}

	private bool sameInstances(Map<string, bool> current, Vector<string> recorded) {
		if (current.len != recorded.len) { return false; }
		for name in recorded { if (!current.has(name)) { return false; } }
		return true;
	}

	private void addNativeRealtimeExternals(IRModule unit) {
		ModuleUnitProgram input = self.input;
		for imported in input.analyzed.nativeDeclarations {
			var contract = imported.callContract;
			if (contract != null && contract.realtimeSafe) {
				unit.realtimeSafeExternals.put(imported.declaration.name, true);
				if (!contract.adapterSymbol(imported.declaration.name).equals(imported.declaration.name)) { unit.realtimeSafeExternals.put("__builtin_trap", true); }
			}
		}
	}

	public void addHostedRealtimeExternals(IRModule unit) {
		bool hasRealtimeRoot = false;
		for definition in unit.functions { if (definition.isRealtime) { hasRealtimeRoot = true; } }
		if (!hasRealtimeRoot) { return; }
		for name in self.input.hostedAbi.realtimeSafeFunctions().keys() { unit.realtimeSafeExternals.put(name, true); }
		for name in self.input.runtimeHelpers.realtimeSafeFunctions().keys() { unit.realtimeSafeExternals.put(name, true); }
	}

	private bool containsSetjmp(IRNode? node) {
		if (node == null) { return false; }
		if (node.kind == IRK_CALL && node.callee == "setjmp") { return true; }
		if (self.containsSetjmp(node.left) || self.containsSetjmp(node.right) || self.containsSetjmp(node.operand) || self.containsSetjmp(node.expr) || self.containsSetjmp(node.obj) || self.containsSetjmp(node.index) || self.containsSetjmp(node.condition) || self.containsSetjmp(node.trueExpr) || self.containsSetjmp(node.falseExpr) || self.containsSetjmp(node.init) || self.containsSetjmp(node.value) || self.containsSetjmp(node.target) || self.containsSetjmp(node.thenBlock) || self.containsSetjmp(node.elseBlock) || self.containsSetjmp(node.body) || self.containsSetjmp(node.update) || self.containsSetjmp(node.result)) { return true; }
		for argument in node.args() { if (self.containsSetjmp(argument)) { return true; } }
		for statement in node.stmts() { if (self.containsSetjmp(statement)) { return true; } }
		return false;
	}

	public bool unitHasSetjmp(IRModule unit) {
		for definition in unit.functions { if (self.containsSetjmp(definition.body)) { return true; } }
		return false;
	}

	/* The context, the group's resolved lines with their original positions,
	 * and the program interface and facts digests. */
	private string programDigest() {
		ModuleUnitProgram input = self.input;
		SHA256 digest = SHA256();
		/* Analysis changes interfaces only as a function of the whole
		 * program's pre-analysis source (generic-argument upgrades, merged
		 * defaults), and the facts below follow it, so the pre-analysis
		 * interface digest identifies the program as well as a rendering after
		 * analysis does. */
		if (!input.interfaceDigest.isEmpty()) {
			digest.appendText("interface:" + input.interfaceDigest);
		} else {
			AstCanonicalRenderer renderer = AstCanonicalRenderer.interfaceRenderer(ModuleUnitInterfaceSummary());
			for declaration in input.program.declarations() { digest.appendText(SHA256.digest(renderer.render(declaration))); }
		}
		AstCanonicalRenderer positionFree = AstCanonicalRenderer.positionFreeRenderer();
		digest.appendText("\nfacts\n");
		digest.appendText(self.facts.usesTrycatch ? "trycatch" : "no-trycatch");
		for instance in input.analyzed.genericInstances { digest.appendText("class:" + instance.mangled + "\n"); }
		for instance in input.analyzed.methodGenInstances {
			digest.appendText("method:" + instance.classBase + "." + instance.methodName + "<");
			for argument in instance.classArgs { digest.appendText(positionFree.render(argument) + ","); }
			digest.appendText(";");
			for argument in instance.methodArgs { digest.appendText(positionFree.render(argument) + ","); }
			digest.appendText(">\n");
		}
		StdlibReachability? reachability = self.facts.reachability;
		if (reachability != null) {
			for declaration in input.program.declarations() {
				if (reachability.isStdlibDeclaration(declaration) && reachability.reaches(declaration)) {
					digest.appendText("reached:" + self.fileOfLine(declaration.line) + ":" + Strings.fromInt((int)declaration.kind) + ":" + declaration.name + "\n");
				}
			}
			Vector<string> names = reachability.mentionedNameList();
			names.sort();
			for name in names { digest.appendText("name:" + name + "\n"); }
		}
		return digest.finish();
	}

	/* The source file a combined line belongs to, or "". */
	public string fileOfLine(int line) {
		FeLine? source = self.input.resolved.userLineForCombined(line);
		if (source == null) { return ""; }
		return source.sourceFile;
	}

	private Map<string, int> groupLines = {};

	/* A digest validation records already took of the same lines is reused;
	 * only the other groups are hashed here. */
	private Map<string, string> groupSourceDigests() {
		Map<string, SHA256> digests = {};
		Map<string, string> known = self.input.knownSourceDigests;
		for line in self.input.resolved.userLines {
			string group = self.groupOfFile.get(line.sourceFile);
			if (!self.groupLines.has(group)) { self.groupLines.put(group, 0); }
			self.groupLines.put(group, self.groupLines.get(group) + 1);
			if (known.has(group)) { continue; }
			if (!digests.has(group)) { digests.put(group, SHA256()); }
			digests.get(group).appendText(line.sourceFile + "\t" + Strings.fromInt(line.lineNumber) + "\t" + line.text + "\n");
		}
		Map<string, string> result = {};
		for group in self.groupLines.keys() {
			if (known.has(group)) { result.put(group, known.get(group)); }
			else { result.put(group, digests.get(group).finish()); }
		}
		return result;
	}

	private ModuleUnitGroupState stateNamed(Vector<ModuleUnitGroupState> states, string name) {
		for state in states { if (state.name.equals(name)) { return state; } }
		return states.get(0);
	}

	private Map<string, string> exporters(Vector<ModuleUnitGroupState> states) {
		Map<string, string> result = {};
		for state in states {
			ModuleUnitRecord? record = state.record;
			Vector<string> exported = state.exports;
			if (!state.stale && record != null) { exported = record.exports; }
			for name in exported { if (!result.has(name)) { result.put(name, state.name); } }
		}
		return result;
	}

	/* Reused groups that share a summary-dependency cycle with a stale group:
	 * solving a cycle with some members fixed at an earlier fixed point can
	 * keep a stale, larger solution, so the whole cycle is lowered again. */
	private Vector<ModuleUnitGroupState> summaryCycles(Vector<ModuleUnitGroupState> states, Map<string, string> exporters) {
		Map<string, Vector<string>> edges = {};
		for state in states {
			Vector<string> targets = [];
			Vector<string> consulted = [];
			ModuleUnitRecord? record = state.record;
			if (state.stale) { consulted = state.consulted.keys(); }
			else if (record != null) { consulted = record.consultedEffects.keys(); }
			for name in consulted {
				if (exporters.has(name) && !exporters.get(name).equals(state.name) && !targets.contains(exporters.get(name))) { targets.push(exporters.get(name)); }
			}
			targets.sort();
			edges.put(state.name, targets);
		}
		Vector<string> nodes = edges.keys();
		nodes.sort();
		Map<string, int> index = {};
		Map<string, int> lowlink = {};
		Map<string, bool> onStack = {};
		Vector<string> stack = [];
		Vector<string> workNodes = [];
		Vector<int> workNext = [];
		Vector<ModuleUnitGroupState> result = [];
		for start in nodes {
			if (index.has(start)) { continue; }
			index.put(start, index.size());
			lowlink.put(start, index.get(start));
			stack.push(start);
			onStack.put(start, true);
			workNodes.push(start);
			workNext.push(0);
			while (workNodes.len > 0) {
				int top = workNodes.len - 1;
				string node = workNodes.get(top);
				Vector<string> successors = edges.get(node);
				int next = workNext.get(top);
				if (next < successors.len) {
					workNext.set(top, next + 1);
					string successor = successors.get(next);
					if (!edges.has(successor)) { continue; }
					if (!index.has(successor)) {
						index.put(successor, index.size());
						lowlink.put(successor, index.get(successor));
						stack.push(successor);
						onStack.put(successor, true);
						workNodes.push(successor);
						workNext.push(0);
					} else if (onStack.has(successor) && onStack.get(successor)) {
						if (index.get(successor) < lowlink.get(node)) { lowlink.put(node, index.get(successor)); }
					}
					continue;
				}
				workNodes.pop();
				workNext.pop();
				if (workNodes.len > 0) {
					string parent = workNodes.get(workNodes.len - 1);
					if (lowlink.get(node) < lowlink.get(parent)) { lowlink.put(parent, lowlink.get(node)); }
				}
				if (lowlink.get(node) == index.get(node)) {
					Vector<string> members = [];
					while (true) {
						string member = stack.pop();
						onStack.put(member, false);
						members.push(member);
						if (member.equals(node)) { break; }
					}
					if (members.len < 2) { continue; }
					bool anyStale = false;
					for member in members { if (self.stateNamed(states, member).stale) { anyStale = true; } }
					if (!anyStale) { continue; }
					for member in members {
						ModuleUnitGroupState state = self.stateNamed(states, member);
						if (!state.stale) { result.push(state); }
					}
				}
			}
		}
		return result;
	}

	/* Workers are started on first need and live for the rest of the compile:
	 * a group lowered again later goes to the same pool. */
	private IWorkerPool? workerPool = null;
	/* Whether the pool runs its worker in this process, where that worker
	 * takes summaries as values. */
	private bool inlinePool = false;

	private IWorkerPool pool(ModuleUnitWorker local, ModuleUnitDeclarations shared, int stale) {
		IWorkerPool? existing = self.workerPool;
		if (existing != null) { return existing; }
		int count = self.workers < stale ? self.workers : stale;
		IWorkerPoolFactory? factory = self.pools;
		IWorkerPool? opened = null;
		if (count > 1 && factory != null) { opened = factory.open(count, ModuleUnitWorker(self, shared)); }
		if (opened == null) {
			opened = InlineWorkerPool(local);
			self.inlinePool = true;
		}
		IWorkerPool started = opened;
		self.workerPool = started;
		BtrccPhaseTimer.note(f"module-unit-workers={started.size()}");
		return started;
	}

	/* Deliver requests and collect their replies in request order. A request
	 * with an affinity goes to that worker (which holds its group's unit);
	 * the others go to whichever worker is idle, and `assigned` records which
	 * one answered. A worker failure fails the compile. */
	private Vector<string> exchange(IWorkerPool workers, Vector<string> requests, Vector<int> affinity, Vector<int> assigned) {
		Vector<string> replies = [];
		Vector<bool> sent = [];
		for request in requests {
			replies.push("");
			sent.push(false);
			assigned.push(-1);
		}
		Vector<int> serving = [];
		for (int worker = 0; worker < workers.size(); worker++) { serving.push(-1); }
		int done = 0;
		int first = 0;
		while (done < requests.len) {
			for (int worker = 0; worker < workers.size(); worker++) {
				if (serving.get(worker) >= 0) { continue; }
				while (first < requests.len && sent.get(first)) { first = first + 1; }
				for (int index = first; index < requests.len; index++) {
					if (sent.get(index) || (affinity.get(index) >= 0 && affinity.get(index) != worker)) { continue; }
					sent.set(index, true);
					serving.set(worker, index);
					if (!workers.send(worker, requests.get(index))) { self.workersFailed(workers, "a module-unit worker stopped accepting requests"); }
					break;
				}
			}
			WorkerReply reply = workers.awaitReply();
			/* What a worker's request threw, such as a lowering diagnostic, is
			 * thrown again here, whether the worker is a forked process or the
			 * owner itself, so it surfaces as it would from one compile. */
			if (reply.kind == WorkerReplyKind.WORKER_REPLY_RAISED) {
				workers.terminate();
				throw reply.error;
			}
			if (reply.kind != WorkerReplyKind.WORKER_REPLY_READY) {
				self.workersFailed(workers, reply.kind == WorkerReplyKind.WORKER_REPLY_EMPTY ? "no module-unit request could be delivered" : reply.error);
			}
			int index = serving.get(reply.worker);
			replies.set(index, reply.payload);
			assigned.set(index, reply.worker);
			serving.set(reply.worker, -1);
			done = done + 1;
		}
		return replies;
	}

	/* Each forked worker's own timing report, in worker order. Only the owner
	 * writes to stderr, so lines from several workers never interleave. */
	private Vector<string> workerTimings(IWorkerPool workers) {
		Vector<string> requests = [];
		Vector<int> affinity = [];
		for (int worker = 0; worker < workers.size(); worker++) {
			requests.push(self.request("timing", "").stringify());
			affinity.push(worker);
		}
		Vector<int> assigned = [];
		return self.exchange(workers, requests, affinity, assigned);
	}

	/* A worker's report with `usage=user:Nus,sys:Nus,maxrss:NKiB` appended:
	 * what the worker process used over its whole life, as close() reaped
	 * it. A host that reports no usage leaves the report as it was. */
	class string withUsage(string report, WorkerUsage? used) {
		if (used == null) { return report; }
		return f"{report} usage=user:{used.userMicros}us,sys:{used.systemMicros}us,maxrss:{used.maxResidentKibibytes}KiB";
	}

	private int solveGeneration = 0;

	/* Why reused records were lowered again, for BTRC_TIMING. */
	private Map<string, int> relowerReasons = {};

	private void relowered(string reason) { self.relowerReasons.put(reason, (self.relowerReasons.has(reason) ? self.relowerReasons.get(reason) : 0) + 1); }

	private void workersFailed(IWorkerPool workers, string reason) {
		workers.terminate();
		fprintf(stderr, "error: module-unit worker failed: %s\n", reason);
		exit(1);
	}

	private JSONValue request(string operation, string group) {
		JSONValue message = JSONValue.makeObject();
		message.set("op", JSONValue.makeString(operation));
		message.set("group", JSONValue.makeString(group));
		return message;
	}

	private JSONValue parseReply(string payload, string group) {
		JSONValue reply = JSONValue.parse(payload);
		if (!reply.isObject()) {
			fprintf(stderr, "internal compiler error: malformed module-unit reply for group '%s'\n", group);
			exit(1);
		}
		return reply;
	}

	/* Lower every group in `toLower` on the workers, largest first. */
	private void lowerGroups(IWorkerPool workers, Vector<ModuleUnitGroupState> toLower, Map<string, bool> lowered) {
		Vector<ModuleUnitGroupState> order = [];
		for state in toLower { order.push(state); }
		/* Largest groups start first so one long group does not end the run alone. */
		for (int outer = 1; outer < order.len; outer++) {
			int inner = outer;
			while (inner > 0 && order.get(inner - 1).lines < order.get(inner).lines) {
				ModuleUnitGroupState swapped = order.get(inner - 1);
				order.set(inner - 1, order.get(inner));
				order.set(inner, swapped);
				inner = inner - 1;
			}
		}
		Vector<string> requests = [];
		Vector<int> affinity = [];
		for state in order {
			requests.push(self.request("lower", state.name).stringify());
			affinity.push(-1);
		}
		Vector<int> assigned = [];
		Vector<string> replies = self.exchange(workers, requests, affinity, assigned);
		for (int index = 0; index < order.len; index++) {
			ModuleUnitGroupState state = order.get(index);
			JSONValue reply = self.parseReply(replies.get(index), state.name);
			state.stale = true;
			state.worker = assigned.get(index);
			state.exports = [];
			state.realtimeRoots = [];
			state.realtimeSafe = [];
			state.graph = ModuleUnitGraph();
			if (!ModuleUnitRecord.stringsFrom(reply.get("exports"), state.exports) || !ModuleUnitRecord.stringsFrom(reply.get("realtime-roots"), state.realtimeRoots) || !ModuleUnitRecord.stringsFrom(reply.get("realtime-safe"), state.realtimeSafe) || !reply.get("setjmp").isBool() || !reply.get("releases").isBool() || !ModuleUnitGraph.readFrom(reply, state.graph)) {
				fprintf(stderr, "internal compiler error: malformed lowering reply for group '%s'\n", state.name);
				exit(1);
			}
			state.hasSetjmp = reply.get("setjmp").asBool();
			state.releasesCyclable = reply.get("releases").asBool();
			state.analyzedRound = -1;
			lowered.put(state.name, true);
		}
	}

	private bool movedSince(Map<string, bool> consulted, Map<string, int> movedAt, int round) {
		for name in consulted.keys() { if (movedAt.has(name) && movedAt.get(name) >= round) { return true; } }
		return false;
	}

	/* Setjmp dependency levels of the units being solved: a unit's level is
	 * one more than that of every other unit it calls into, and units whose
	 * calls form a cycle share a level. The program unit is named "". */
	private Map<string, int> setjmpLevels(Vector<ModuleUnitGroupState> stale, ModuleUnitGraph programGraph, Map<string, string> owners) {
		Map<string, ModuleUnitGraph> graphs = {};
		graphs.put("", programGraph);
		for state in stale { graphs.put(state.name, state.graph); }
		Map<string, Vector<string>> edges = {};
		for node in graphs.keys() {
			Map<string, bool> targets = {};
			ModuleUnitGraph graph = graphs.get(node);
			for source in graph.edges.keys() {
				for name in graph.edges.get(source) {
					if (owners.has(name) && !owners.get(name).equals(node)) { targets.put(owners.get(name), true); }
				}
			}
			Vector<string> sorted = targets.keys();
			sorted.sort();
			edges.put(node, sorted);
		}
		Vector<string> nodes = edges.keys();
		nodes.sort();
		Map<string, int> index = {};
		Map<string, int> lowlink = {};
		Map<string, bool> onStack = {};
		Map<string, int> component = {};
		Vector<int> componentLevel = [];
		Vector<string> stack = [];
		Vector<string> workNodes = [];
		Vector<int> workNext = [];
		for start in nodes {
			if (index.has(start)) { continue; }
			index.put(start, index.size());
			lowlink.put(start, index.get(start));
			stack.push(start);
			onStack.put(start, true);
			workNodes.push(start);
			workNext.push(0);
			while (workNodes.len > 0) {
				string node = workNodes.get(workNodes.len - 1);
				Vector<string> successors = edges.get(node);
				int next = workNext.get(workNext.len - 1);
				if (next < successors.len) {
					workNext.set(workNext.len - 1, next + 1);
					string successor = successors.get(next);
					if (!index.has(successor)) {
						index.put(successor, index.size());
						lowlink.put(successor, index.get(successor));
						stack.push(successor);
						onStack.put(successor, true);
						workNodes.push(successor);
						workNext.push(0);
					} else if (onStack.has(successor) && onStack.get(successor) && index.get(successor) < lowlink.get(node)) {
						lowlink.put(node, index.get(successor));
					}
					continue;
				}
				workNodes.pop();
				workNext.pop();
				if (workNodes.len > 0) {
					string parent = workNodes.get(workNodes.len - 1);
					if (lowlink.get(node) < lowlink.get(parent)) { lowlink.put(parent, lowlink.get(node)); }
				}
				if (lowlink.get(node) == index.get(node)) {
					/* Tarjan emits a component after every component it reaches,
					 * so its callees' levels are already known. */
					int id = componentLevel.len;
					Vector<string> members = [];
					while (true) {
						string member = stack.pop();
						onStack.put(member, false);
						component.put(member, id);
						members.push(member);
						if (member.equals(node)) { break; }
					}
					int level = 0;
					for member in members {
						for successor in edges.get(member) {
							int other = component.get(successor);
							if (other != id && componentLevel.get(other) + 1 > level) { level = componentLevel.get(other) + 1; }
						}
					}
					componentLevel.push(level);
				}
			}
		}
		Map<string, int> levels = {};
		for node in nodes { levels.put(node, componentLevel.get(component.get(node))); }
		return levels;
	}

	/* The setjmp least fixed point across units: the program unit is analyzed
	 * here and each stale unit by the worker holding it, with reused units'
	 * published summaries fixed. Each round walks the dependency levels in
	 * order, analyzing a level's units together, so a unit already sees what
	 * its callees published in the same round; a unit is analyzed again only
	 * when a summary it consulted moved in or after the wave that last
	 * analyzed it (a call back into a lower level). Summaries only grow, so
	 * any order reaches the same least fixed point. Each worker receives the
	 * summaries that moved since it last heard. Returns the program unit's
	 * call effects; `solved` holds the summaries. */
	private Map<string, SetjmpCallEffects> solveSetjmp(IWorkerPool workers, ModuleUnitWorker local, IRModule programUnit, ModuleUnitGraph programGraph, Vector<ModuleUnitGroupState> stale, Map<string, SetjmpFunctionEffect> fixed, Map<string, SetjmpFunctionEffect> solved) {
		for name in fixed.keys() { solved.put(name, fixed.get(name)); }
		Map<string, string> owners = {};
		for definition in programUnit.functions {
			if (!definition.isStatic && definition.body != null) {
				solved.put(definition.name, SetjmpFunctionEffect());
				owners.put(definition.name, "");
			}
		}
		for state in stale {
			state.analyzedRound = -1;
			state.consulted = {};
			for name in state.exports {
				solved.put(name, SetjmpFunctionEffect());
				if (!owners.has(name)) { owners.put(name, state.name); }
			}
		}
		Map<string, int> levels = self.setjmpLevels(stale, programGraph, owners);
		/* Workers keep summaries between requests of one solve only. */
		self.solveGeneration = self.solveGeneration + 1;
		int deepest = 0;
		for name in levels.keys() { if (levels.get(name) > deepest) { deepest = levels.get(name); } }
		Map<string, int> movedAt = {};
		Vector<string> movedLog = [];
		Vector<int> movedLogWave = [];
		Vector<int> synced = [];
		for (int worker = 0; worker < workers.size(); worker++) { synced.push(-2); }
		Map<string, SetjmpCallEffects> programEffects = {};
		Map<string, bool> programConsulted = {};
		SetjmpEffectAnalysis programAnalysis = SetjmpEffectAnalysis(self.input.hostedAbi);
		keep programAnalysis;
		int programWave = -1;
		int analyses = 0;
		int wave = 0;
		int rounds = 0;
		bool changed = true;
		while (changed) {
			changed = false;
			rounds = rounds + 1;
			for (int level = 0; level <= deepest; level++) {
				Map<string, SetjmpFunctionEffect> moves = {};
				if (levels.get("") == level && (programWave < 0 || self.movedSince(programConsulted, movedAt, programWave))) {
					SetjmpEffectAnalysis analysis = programAnalysis;
					programEffects = analysis.analyzeIncrementally(programUnit, solved);
					programConsulted = analysis.consultedSolvedNames();
					programWave = wave;
					analyses = analyses + 1;
					Map<string, SetjmpFunctionEffect> summaries = analysis.definitionSummaries();
					for definition in programUnit.functions {
						if (definition.isStatic || definition.body == null) { continue; }
						SetjmpFunctionEffect summary = summaries.get(definition.name);
						if (!summary.same(solved.get(definition.name))) { moves.put(definition.name, summary.snapshot()); }
					}
					keep analysis;
				}
				Vector<string> requests = [];
				Vector<int> affinity = [];
				Vector<ModuleUnitGroupState> analyzed = [];
				Map<int, bool> primed = {};
				for state in stale {
					if (levels.get(state.name) != level) { continue; }
					if (state.analyzedRound >= 0 && !self.movedSince(state.consulted, movedAt, state.analyzedRound)) { continue; }
					JSONValue message = self.request("setjmp", state.name);
					message.set("generation", JSONValue.makeInt(self.solveGeneration));
					Map<string, SetjmpFunctionEffect> delta = {};
					if (!primed.has(state.worker)) {
						int since = synced.get(state.worker);
						if (since == -2) {
							for name in solved.keys() { delta.put(name, solved.get(name)); }
						} else {
							/* The move log is in wave order: read back to `since`. */
							int entry = movedLog.len - 1;
							while (entry >= 0 && movedLogWave.get(entry) > since) {
								string name = movedLog.get(entry);
								delta.put(name, solved.get(name));
								entry = entry - 1;
							}
						}
						primed.put(state.worker, true);
					}
					/* An inline worker takes the summaries as values: encoding every
					 * export's summary to cross a call was most of a small solve. */
					if (self.inlinePool) {
						local.acceptSolved(self.solveGeneration, delta);
						message.set("solved", JSONValue.makeString(""));
					} else {
						message.set("solved", JSONValue.makeString(ModuleUnitSummaries.encode(delta)));
					}
					requests.push(message.stringify());
					affinity.push(state.worker);
					analyzed.push(state);
				}
				for worker in primed.keys() { synced.set(worker, wave - 1); }
				Vector<int> assigned = [];
				Vector<string> replies = self.exchange(workers, requests, affinity, assigned);
				for (int index = 0; index < analyzed.len; index++) {
					ModuleUnitGroupState state = analyzed.get(index);
					JSONValue reply = self.parseReply(replies.get(index), state.name);
					Map<string, SetjmpFunctionEffect> summaries = {};
					Vector<string> consulted = [];
					if (!reply.get("summaries").isString() || !ModuleUnitSummaries.decode(reply.get("summaries").asString(), summaries) || !ModuleUnitRecord.stringsFrom(reply.get("consulted"), consulted)) {
						fprintf(stderr, "internal compiler error: malformed setjmp reply for group '%s'\n", state.name);
						exit(1);
					}
					state.analyzedRound = wave;
					state.consulted = {};
					for name in consulted { state.consulted.put(name, true); }
					for name in summaries.keys() {
						if (!summaries.get(name).same(solved.get(name))) { moves.put(name, summaries.get(name)); }
					}
					analyses = analyses + 1;
				}
				for name in moves.keys() {
					solved.put(name, moves.get(name));
					movedAt.put(name, wave);
					movedLog.push(name);
					movedLogWave.push(wave);
					changed = true;
				}
				wave = wave + 1;
			}
		}
		BtrccPhaseTimer.note(f"setjmp-analyses={analyses}/{stale.len + 1},rounds={rounds},levels={deepest + 1}");
		return programEffects;
	}

	/* Realtime proofs across units. Each unit proves functions through its own
	 * definitions (the program unit here, stale units in their workers) and
	 * returns the calls it cannot resolve; a reused unit's part of a proof is
	 * the one its record kept, since its code has not changed. A call into
	 * another unit's export continues the proof there; any other call must be
	 * a program-wide realtime-safe external; calls between units must not form
	 * a cycle. Roots are the realtime functions of every unit. Records each
	 * stale unit's proofs and reached callees, adds the program unit's reached
	 * callees to its safe externals, and returns the reused groups whose
	 * function a proof reached without a recorded proof: those are lowered
	 * again. */
	private Map<string, bool> proveRealtime(IWorkerPool workers, IRModule programUnit, Vector<ModuleUnitGroupState> states) {
		Map<string, bool> needed = {};
		Map<string, string> exporters = {};
		Map<string, bool> programSafe = {};
		for definition in programUnit.functions { if (!definition.isStatic) { exporters.put(definition.name, ""); } }
		Map<string, string> unitExports = self.exporters(states);
		for name in unitExports.keys() { if (!exporters.has(name)) { exporters.put(name, unitExports.get(name)); } }
		for name in programUnit.realtimeSafeExternals.keys() { programSafe.put(name, true); }
		for name in self.baseRealtimeSafe().keys() { programSafe.put(name, true); }
		Map<string, ModuleUnitGroupState> byName = {};
		for state in states {
			byName.put(state.name, state);
			if (state.stale) {
				for name in state.realtimeSafe { programSafe.put(name, true); }
				state.realtimeProofs = {};
			}
		}
		Vector<string> groups = [];
		Vector<string> names = [];
		Vector<string> paths = [];
		Map<string, bool> proven = {};
		for definition in programUnit.functions {
			if (definition.isRealtime) {
				groups.push("");
				names.push(definition.name);
				paths.push(definition.name);
				proven.put("\t" + definition.name, true);
			}
		}
		for state in states {
			ModuleUnitRecord? record = state.record;
			Vector<string> roots = state.realtimeRoots;
			if (!state.stale && record != null) { roots = record.realtimeRoots; }
			if (!state.stale && record == null) { continue; }
			for root in roots {
				groups.push(state.name);
				names.push(root);
				paths.push(root);
				proven.put(state.name + "\t" + root, true);
			}
		}
		Map<string, Vector<string>> edges = {};
		Map<string, Map<string, bool>> reached = {};
		while (names.len > 0) {
			Vector<string> startGroups = [];
			Vector<string> starts = [];
			Vector<string> callees = [];
			Vector<string> callPaths = [];
			Vector<string> programNames = [];
			Vector<string> programPaths = [];
			Map<string, Vector<string>> groupNames = {};
			Map<string, Vector<string>> groupPaths = {};
			Vector<string> requested = [];
			for (int index = 0; index < names.len; index++) {
				string group = groups.get(index);
				string name = names.get(index);
				if (group.isEmpty()) {
					programNames.push(name);
					programPaths.push(paths.get(index));
					continue;
				}
				ModuleUnitGroupState owner = byName.get(group);
				if (!owner.stale) {
					/* A reused unit resumes the proof from its record. */
					ModuleUnitRecord? record = owner.record;
					if (record == null || !record.realtimeProofs.has(name)) {
						needed.put(group, true);
						continue;
					}
					for callee in record.realtimeProofs.get(name) {
						startGroups.push(group);
						starts.push(name);
						callees.push(callee);
						callPaths.push(paths.get(index));
					}
					continue;
				}
				if (!groupNames.has(group)) {
					Vector<string> noNames = [];
					Vector<string> noPaths = [];
					groupNames.put(group, noNames);
					groupPaths.put(group, noPaths);
					requested.push(group);
				}
				groupNames.get(group).push(name);
				groupPaths.get(group).push(paths.get(index));
				Vector<string> none = [];
				owner.realtimeProofs.put(name, none);
			}
			groups = [];
			names = [];
			paths = [];
			if (programNames.len > 0) {
				RealtimeUnitProof proof = RealtimeIRVerifier.proveWithin(programUnit, programNames, programPaths);
				for (int index = 0; index < proof.callees.len; index++) {
					startGroups.push("");
					starts.push(proof.starts.get(index));
					callees.push(proof.callees.get(index));
					callPaths.push(proof.paths.get(index));
				}
			}
			Vector<string> requests = [];
			Vector<int> affinity = [];
			for group in requested {
				JSONValue message = self.request("realtime", group);
				message.set("names", ModuleUnitRecord.stringsJson(groupNames.get(group)));
				message.set("paths", ModuleUnitRecord.stringsJson(groupPaths.get(group)));
				requests.push(message.stringify());
				affinity.push(byName.get(group).worker);
			}
			Vector<int> assigned = [];
			Vector<string> replies = self.exchange(workers, requests, affinity, assigned);
			for (int index = 0; index < requested.len; index++) {
				string group = requested.get(index);
				JSONValue reply = self.parseReply(replies.get(index), group);
				Vector<string> replyStarts = [];
				Vector<string> replyCallees = [];
				Vector<string> replyPaths = [];
				if (!ModuleUnitRecord.stringsFrom(reply.get("starts"), replyStarts) || !ModuleUnitRecord.stringsFrom(reply.get("callees"), replyCallees) || !ModuleUnitRecord.stringsFrom(reply.get("paths"), replyPaths) || replyStarts.len != replyCallees.len || replyCallees.len != replyPaths.len) {
					fprintf(stderr, "internal compiler error: malformed realtime reply for group '%s'\n", group);
					exit(1);
				}
				Map<string, Vector<string>> proofs = byName.get(group).realtimeProofs;
				for (int item = 0; item < replyCallees.len; item++) {
					startGroups.push(group);
					starts.push(replyStarts.get(item));
					callees.push(replyCallees.get(item));
					callPaths.push(replyPaths.get(item));
					if (proofs.has(replyStarts.get(item)) && !proofs.get(replyStarts.get(item)).contains(replyCallees.get(item))) { proofs.get(replyStarts.get(item)).push(replyCallees.get(item)); }
				}
			}
			for (int index = 0; index < callees.len; index++) {
				string group = startGroups.get(index);
				string callee = callees.get(index);
				string from = group + "\t" + starts.get(index);
				if (!reached.has(group)) {
					Map<string, bool> none = {};
					reached.put(group, none);
				}
				if (exporters.has(callee) && !exporters.get(callee).equals(group)) {
					string owner = exporters.get(callee);
					reached.get(group).put(callee, true);
					string to = owner + "\t" + callee;
					if (!edges.has(from)) {
						Vector<string> none = [];
						edges.put(from, none);
					}
					edges.get(from).push(to);
					if (!proven.has(to)) {
						proven.put(to, true);
						groups.push(owner);
						names.push(callee);
						paths.push(callPaths.get(index) + " -> " + callee);
					}
				} else if (programSafe.has(callee)) {
					reached.get(group).put(callee, true);
				} else {
					fprintf(stderr, "internal compiler error: IR realtime backstop rejected external/runtime call '%s' via %s\n", callee, callPaths.get(index));
					exit(1);
				}
			}
		}
		self.rejectRealtimeCycles(edges);
		for state in states {
			if (!state.stale) { continue; }
			state.realtimeReached = [];
			if (reached.has(state.name)) { state.realtimeReached = reached.get(state.name).keys(); }
			state.realtimeReached.sort();
		}
		if (reached.has("")) { for name in reached.get("").keys() { programUnit.realtimeSafeExternals.put(name, true); } }
		return needed;
	}

	/* A realtime call chain that leaves a unit and comes back is recursion the
	 * units could not see alone. */
	private void rejectRealtimeCycles(Map<string, Vector<string>> edges) {
		Map<string, int> color = {};
		Vector<string> nodes = edges.keys();
		nodes.sort();
		for start in nodes {
			if (color.has(start)) { continue; }
			Vector<string> stack = [start];
			Vector<int> next = [0];
			color.put(start, 1);
			while (stack.len > 0) {
				string node = stack.get(stack.len - 1);
				int position = next.get(next.len - 1);
				Vector<string> successors = [];
				if (edges.has(node)) { successors = edges.get(node); }
				if (position >= successors.len) {
					color.put(node, 2);
					stack.pop();
					next.pop();
					continue;
				}
				next.set(next.len - 1, position + 1);
				string successor = successors.get(position);
				if (color.has(successor) && color.get(successor) == 1) {
					Vector<string> path = [];
					for member in stack { path.push(member.substring(member.indexOf("\t") + 1, member.length() - member.indexOf("\t") - 1)); }
					path.push(successor.substring(successor.indexOf("\t") + 1, successor.length() - successor.indexOf("\t") - 1));
					fprintf(stderr, "internal compiler error: IR realtime backstop rejected recursive call cycle via %s\n", Strings.join(path, " -> "));
					exit(1);
				}
				if (!color.has(successor)) {
					color.put(successor, 1);
					stack.push(successor);
					next.push(0);
				}
			}
		}
	}

	public ModuleUnitBuild compile() {
		ModuleUnitProgram input = self.input;
		ModuleUnitBuild build = ModuleUnitBuild();
		BtrccPhaseTimer.mark("u-start");
		/* One declarations-only lowering produces every declaration without
		 * bodies and computes the facts every later lowering shares. */
		IRLowerer declarationsLowerer = self.lowerer("<declarations>", false);
		IRModule declarations = declarationsLowerer.lower(input.program);
		keep declarationsLowerer;
		ModuleUnitDeclarations shared = ModuleUnitDeclarations(declarations);
		shared.configureNativeHeaders(input.analyzed.nativeDeclarations);
		BtrccPhaseTimer.mark("u-declarations");
		/* The program unit is always lowered here: it owns native adapters and
		 * gathers every helper any unit uses, which the runtime unit defines. */
		IRModule programUnit = self.lowerGroup("", shared);
		ModuleUnitGraph programGraph = ModuleUnitGraph.fromUnit(programUnit, self.lastInstances);
		self.addHostedRealtimeExternals(programUnit);
		bool programSetjmp = self.unitHasSetjmp(programUnit);
		CycleReturnBoundaryLowerer programBoundaries = CycleReturnBoundaryLowerer();
		bool programReleases = programBoundaries.releasesCyclableValues(programUnit);
		BtrccPhaseTimer.mark("u-program-unit");
		string programIdentity = self.programDigest();
		BtrccPhaseTimer.mark("u-digest");
		Map<string, string> sources = self.groupSourceDigests();
		BtrccPhaseTimer.mark("u-sources");
		string context = f"debug={self.options.debug};dce={self.options.runDce};target={self.options.target};prefix={self.options.debug ? self.options.unitsPrefix : ""};output={self.options.debug ? self.options.outputPath : ""}";
		Vector<ModuleUnitGroupState> states = [];
		for name in self.groups.names() {
			string source = sources.has(name) ? sources.get(name) : "";
			string identity = SHA256.digest("module-unit-v6\n" + context + "\n" + name + "\n" + source + "\n" + programIdentity);
			ModuleUnitGroupState state = ModuleUnitGroupState(name, identity);
			if (self.groupLines.has(name)) { state.lines = self.groupLines.get(name); }
			IBtrccArtifactCache? store = self.store;
			if (store != null) {
				BtrccPhaseTimer.mark("u-keys");
				BtrccModuleUnitPayload? payload = store.loadModuleUnit(identity);
				BtrccPhaseTimer.mark("u-record-load");
				state.record = ModuleUnitRecord.fromPayload(payload, name);
				state.stored = state.record != null;
				/* A unit that copied another group's bodies or positions is
				 * exact only while that group's source is unchanged. */
				ModuleUnitRecord? loaded = state.record;
				if (loaded != null) {
					for group in loaded.consultedSources.keys() {
						if (state.record != null && (!sources.has(group) || !sources.get(group).equals(loaded.consultedSources.get(group)))) {
							state.record = null;
							state.stored = false;
							self.relowered("consulted-source");
						}
					}
				}
				BtrccPhaseTimer.mark("u-record-parse");
			}
			states.push(state);
		}
		BtrccPhaseTimer.mark("u-plan");

		ModuleUnitWorker local = ModuleUnitWorker(self, shared);
		Map<string, bool> lowered = {};
		Map<string, SetjmpFunctionEffect> solved = {};
		Map<string, SetjmpCallEffects> programEffects = {};
		Vector<ModuleUnitGroupState> stale = [];
		bool releases = false;
		bool needsSolve = false;
		while (true) {
			Vector<ModuleUnitGroupState> toLower = [];
			for state in states { if (state.record == null && !state.stale) { toLower.push(state); } }
			if (toLower.len > 0) { self.lowerGroups(self.pool(local, shared, toLower.len), toLower, lowered); }
			BtrccPhaseTimer.mark("u-lowered");
			stale = [];
			releases = programReleases;
			needsSolve = programSetjmp;
			for state in states {
				ModuleUnitRecord? record = state.record;
				if (state.stale) {
					stale.push(state);
					if (state.releasesCyclable) { releases = true; }
					if (state.hasSetjmp) { needsSolve = true; }
				} else if (record != null) {
					if (record.releasesCyclable) { releases = true; }
					if (record.hasSetjmp) { needsSolve = true; }
				}
			}
			/* The entry unit consults the program-wide cyclable-release fact; a
			 * reused record solved without effects cannot serve a solve. */
			bool again = false;
			for state in states {
				ModuleUnitRecord? record = state.record;
				if (!state.stale && record != null && ((record.definesEntry && record.programRelease != releases) || (needsSolve && !record.effectsSolved))) {
					state.record = null;
					state.stored = false;
					again = true;
					self.relowered("entry-or-unsolved");
				}
			}
			if (again) { continue; }
			Map<string, SetjmpFunctionEffect> fixed = {};
			for state in states {
				ModuleUnitRecord? record = state.record;
				if (!state.stale && record != null) {
					for name in record.exportedEffects.keys() { fixed.put(name, record.exportedEffects.get(name)); }
				}
			}
			solved = {};
			programEffects = {};
			if (needsSolve) {
				IWorkerPool workers = self.pool(local, shared, stale.len);
				programEffects = self.solveSetjmp(workers, local, programUnit, programGraph, stale, fixed, solved);
			}
			Map<string, string> exporters = self.exporters(states);
			for state in states {
				ModuleUnitRecord? record = state.record;
				if (state.stale || record == null) { continue; }
				for name in record.consultedEffects.keys() {
					if (!solved.has(name) || !solved.get(name).same(record.consultedEffects.get(name))) {
						if (state.record != null) { self.relowered("consulted-summary"); }
						state.record = null;
						state.stored = false;
						again = true;
					}
				}
			}
			for state in self.summaryCycles(states, exporters) {
				state.record = null;
				state.stored = false;
				again = true;
				self.relowered("summary-cycle");
			}
			BtrccPhaseTimer.mark("u-solve");
			if (again) { continue; }
			Map<string, bool> needed = self.proveRealtime(self.pool(local, shared, stale.len), programUnit, states);
			BtrccPhaseTimer.mark("u-realtime");
			for state in states {
				ModuleUnitRecord? record = state.record;
				if (state.stale || record == null) { continue; }
				if (needed.has(state.name)) {
					state.record = null;
					state.stored = false;
					again = true;
					self.relowered("realtime");
				}
			}
			if (again) { continue; }
			/* A reused unit is exact only for the instance members it kept. */
			self.demandInstances(states, programGraph);
			BtrccPhaseTimer.mark("u-demand");
			for state in states {
				ModuleUnitRecord? record = state.record;
				if (!state.stale && record != null && !self.sameInstances(state.keptInstances, record.keptInstances)) {
					state.record = null;
					state.stored = false;
					again = true;
					self.relowered("kept-instances");
				}
			}
			if (again) { continue; }
			break;
		}
		BtrccPhaseTimer.mark("u-lower");

		/* Every stale unit is optimized and emitted by the worker holding it. */
		Map<string, bool> helperNames = {};
		Vector<string> requests = [];
		Vector<int> affinity = [];
		for state in stale {
			JSONValue message = self.request("finish", state.name);
			message.set("releases", JSONValue.makeBool(releases));
			Vector<string> unneeded = [];
			for name in state.graph.instances.keys() { if (!state.keptInstances.has(name)) { unneeded.push(name); } }
			unneeded.sort();
			message.set("unneeded", ModuleUnitRecord.stringsJson(unneeded));
			message.set("realtime-safe", ModuleUnitRecord.stringsJson(state.realtimeReached));
			requests.push(message.stringify());
			affinity.push(state.worker);
		}
		Vector<string> finished = [];
		if (requests.len > 0) {
			Vector<int> assigned = [];
			finished = self.exchange(self.pool(local, shared, stale.len), requests, affinity, assigned);
		}
		BtrccPhaseTimer.mark("u-optimize");
		for (int index = 0; index < stale.len; index++) {
			ModuleUnitGroupState state = stale.get(index);
			string reply = finished.get(index);
			int newline = reply.indexOf("\n");
			int headerLength = newline > 0 ? Strings.toInt(reply.substring(0, newline)) : -1;
			if (headerLength <= 0 || newline + 1 + headerLength > reply.length()) {
				fprintf(stderr, "internal compiler error: malformed finish reply for group '%s'\n", state.name);
				exit(1);
			}
			JSONValue header = self.parseReply(reply.substring(newline + 1, headerLength), state.name);
			ModuleUnitRecord record = ModuleUnitRecord();
			record.group = state.name;
			Vector<string> consultedFiles = [];
			if (!header.get("kept").isBool() || !header.get("releases").isBool() || !header.get("entry").isBool() || !ModuleUnitRecord.stringsFrom(header.get("exports"), record.exports) || !ModuleUnitRecord.stringsFrom(header.get("helpers"), record.helpers) || !ModuleUnitRecord.stringsFrom(header.get("sources"), consultedFiles) || !header.get("dropped").isObject()) {
				fprintf(stderr, "internal compiler error: malformed finish reply for group '%s'\n", state.name);
				exit(1);
			}
			record.kept = header.get("kept").asBool();
			record.text = reply.substring(newline + 1 + headerLength, reply.length() - newline - 1 - headerLength);
			record.hasSetjmp = state.hasSetjmp;
			record.effectsSolved = needsSolve;
			for name in record.exports { if (solved.has(name)) { record.exportedEffects.put(name, solved.get(name)); } }
			for name in state.consulted.keys() { if (solved.has(name)) { record.consultedEffects.put(name, solved.get(name)); } }
			record.releasesCyclable = header.get("releases").asBool();
			record.definesEntry = header.get("entry").asBool();
			record.programRelease = releases;
			record.realtimeRoots = state.realtimeRoots;
			record.realtimeProofs = state.realtimeProofs;
			record.graph = state.graph;
			record.keptInstances = state.keptInstances.keys();
			record.keptInstances.sort();
			for file in consultedFiles {
				string group = self.groupOfFile.has(file) ? self.groupOfFile.get(file) : "";
				if (!group.isEmpty() && !group.equals(state.name) && sources.has(group)) { record.consultedSources.put(group, sources.get(group)); }
			}
			/* A dropped member another unit still needs would have been kept
			 * alive by whole-program DCE: report its deferred diagnostic. */
			JSONValue dropped = header.get("dropped");
			for name in dropped.keys() {
				if (state.keptInstances.has(name)) {
					fprintf(stderr, "error: %s\n", dropped.get(name).asString());
					exit(1);
				}
			}
			state.helpers = record.helpers;
			for helper in record.helpers { helperNames.put(helper, true); }
			IBtrccArtifactCache? store = self.store;
			string recordText = record.toText();
			if (store != null && !recordText.isEmpty()) { store.storeModuleUnit(state.key, BtrccModuleUnitPayload(recordText, record.text)); }
			state.stored = store != null && !recordText.isEmpty();
			state.record = record;
		}
		IWorkerPool? started = self.workerPool;
		Vector<string> workerTimings = [];
		if (started != null && BtrccPhaseTimer.enabled && !self.inlinePool) { workerTimings = self.workerTimings(started); }
		if (started != null && !started.close()) {
			fprintf(stderr, "error: module-unit worker failed: a worker exited abnormally\n");
			exit(1);
		}
		if (started != null) {
			for (int index = 0; index < workerTimings.len; index++) { BtrccPhaseTimer.worker(index, ModuleUnitCompiler.withUsage(workerTimings.get(index), started.usage(index))); }
		}
		BtrccPhaseTimer.mark("u-records");
		/* The program unit gathers every helper any unit uses; the runtime
		 * unit defines them. */
		for state in states {
			ModuleUnitRecord? record = state.record;
			if (!state.stale && record != null) { for helper in record.helpers { helperNames.put(helper, true); } }
		}
		IROptimizer optimizer = IROptimizer(SetjmpSafetyPlanner(SetjmpEffectAnalysis(input.hostedAbi)), input.runtimeHelpers);
		Map<string, bool> programUnneeded = {};
		optimizer.optimizeModuleUnit(programUnit, self.options.runDce, programEffects, releases, programUnneeded);
		RuntimeReferenceCollector references = RuntimeReferenceCollector(input.runtimeHelpers);
		for helper in references.requiredBy(programUnit).keys() { helperNames.put(helper, true); }
		input.runtimeHelpers.materializeInto(programUnit, helperNames, references.requiredHeaders());
		if (programUnit.helpers.len > 0) {
			build.units.push(CEmitter().emitRuntimeUnit(shared.runtimeModule(programUnit)));
			build.unitNames.push(ModuleUnitCompiler.runtimeUnitName());
			build.unitKeys.push("");
		}
		for state in states {
			ModuleUnitRecord? finishedRecord = state.record;
			if (finishedRecord != null && finishedRecord.kept) {
				build.units.push(finishedRecord.text);
				build.unitNames.push(ModuleUnitCompiler.unitName(state.name));
				build.unitKeys.push(state.stored ? state.key : "");
			}
			if (lowered.has(state.name)) { build.lowered.push(state.name); }
			else { build.reused.push(state.name); }
		}
		if (self.options.debug && !self.options.outputPath.isEmpty()) { programUnit.debugCfile = FeCanonicalPath.absolute(self.options.outputPath); }
		build.primary = CEmitter().emitModuleUnit(programUnit);
		build.program = programUnit;
		keep states;
		keep shared;
		keep declarations;
		keep optimizer;
		/* An in-process worker holds every unit it lowered: releasing that
		 * graph would run a reverse-reachability proof over all of it. */
		keep local;
		BtrccPhaseTimer.note(f"module-units=lowered:{build.lowered.len},reused:{build.reused.len}");
		for reason in self.relowerReasons.keys() { BtrccPhaseTimer.note(f"relowered-{reason}={self.relowerReasons.get(reason)}"); }
		BtrccPhaseTimer.mark("u-emit");
		return build;
	}
}

/* The worker side of a module-unit compile. It lowers the groups it is given
 * and keeps their units, then answers the owner's setjmp, realtime and finish
 * requests about them. It runs in a forked copy of the owner, which shares the
 * analyzed program and shared declarations, or in the owner itself. */
class ModuleUnitWorker implements IWorkerRequestHandler {
	private ModuleUnitCompiler compiler;
	private ModuleUnitDeclarations shared;
	private Map<string, IRModule> units = {};
	/* Per group, the files whose bodies or positions its lowering copied. */
	private Map<string, Map<string, bool>> consulted = {};
	private Map<string, Map<string, SetjmpCallEffects>> effects = {};
	private Map<string, SetjmpFunctionEffect> solved = {};
	/* Each group's setjmp analysis, continued across one solve's rounds. */
	private Map<string, SetjmpEffectAnalysis> analyses = {};
	/* The summaries this worker last reported for each export, within the
	 * owner's current solve; a new solve starts both maps again. */
	private Map<string, SetjmpFunctionEffect> reported = {};
	private int solveGeneration = -1;
	/* The process that made this worker. A forked copy runs elsewhere and,
	 * under BTRC_TIMING, keeps its own report for the owner to print. */
	private int ownerProcess;
	private bool timingStarted = false;
	private Map<string, int> requestCounts = {};
	private Map<string, int> busyMicros = {};

	public ModuleUnitWorker(ModuleUnitCompiler compiler, ModuleUnitDeclarations shared) {
		self.compiler = compiler;
		self.shared = shared;
		self.ownerProcess = Platform.pid();
	}

	class Vector<string> timedOperations() { return ["lower", "setjmp", "realtime", "finish"]; }

	/* Summaries handed over directly by an owner in the same process, as
	 * copies, exactly as a request's decoded text would be. */
	public void acceptSolved(int generation, Map<string, SetjmpFunctionEffect> delta) {
		if (generation != self.solveGeneration) {
			self.solveGeneration = generation;
			self.solved = {};
			self.reported = {};
			self.analyses = {};
		}
		for name in delta.keys() { self.solved.put(name, delta.get(name).snapshot()); }
	}

	/* A forked worker under BTRC_TIMING starts its report at its first
	 * request, marks the idle time before each request (`w-wait`) and the
	 * time after a request's last inner mark (`w-reply`), and keeps each
	 * operation's request count and busy time; the owner asks for the report
	 * just before it closes the pool. An in-process worker's marks fold into
	 * the owner's own report. */
	public string handle(string request) {
		bool timed = BtrccPhaseTimer.enabled && Platform.pid() != self.ownerProcess;
		if (timed && !self.timingStarted) {
			BtrccPhaseTimer.restart();
			self.timingStarted = true;
		}
		if (timed) { BtrccPhaseTimer.mark("w-wait"); }
		JSONValue message = JSONValue.parse(request);
		string operation = message.get("op").asString();
		if (!timed) { return self.answer(operation, message); }
		if (operation.equals("timing")) { return self.timingReport(); }
		Timer busy = Timer();
		busy.start();
		string reply = self.answer(operation, message);
		busy.stop();
		int micros = (int)(busy.elapsed() * 1000000.0f);
		self.requestCounts.put(operation, (self.requestCounts.has(operation) ? self.requestCounts.get(operation) : 0) + 1);
		self.busyMicros.put(operation, (self.busyMicros.has(operation) ? self.busyMicros.get(operation) : 0) + micros);
		BtrccPhaseTimer.mark("w-reply");
		return reply;
	}

	/* `pid=<pid> requests=lower:n,... busy=lower:Nus,...` and then the marks
	 * this worker recorded. */
	private string timingReport() {
		Vector<string> counts = [];
		Vector<string> busy = [];
		for operation in ModuleUnitWorker.timedOperations() {
			int count = self.requestCounts.has(operation) ? self.requestCounts.get(operation) : 0;
			int micros = self.busyMicros.has(operation) ? self.busyMicros.get(operation) : 0;
			counts.push(f"{operation}:{count}");
			busy.push(f"{operation}:{micros}us");
		}
		return f"pid={Platform.pid()} requests={Strings.join(counts, ",")} busy={Strings.join(busy, ",")} {BtrccPhaseTimer.rendered()}";
	}

	private string answer(string operation, JSONValue message) {
		string group = message.get("group").asString();
		if (operation.equals("lower")) { return self.lower(group); }
		if (!self.units.has(group)) {
			fprintf(stderr, "internal compiler error: module-unit worker does not hold group '%s'\n", group);
			exit(1);
		}
		if (operation.equals("setjmp")) {
			int generation = message.get("generation").asInt();
			if (generation != self.solveGeneration) {
				self.solveGeneration = generation;
				self.solved = {};
				self.reported = {};
				self.analyses = {};
			}
			return self.analyze(group, message.get("solved").asString());
		}
		if (operation.equals("realtime")) { return self.prove(group, message); }
		if (operation.equals("finish")) { return self.finish(group, message); }
		fprintf(stderr, "internal compiler error: unknown module-unit request '%s'\n", operation);
		exit(1);
		return "";
	}

	/* Lower one group; report its exports, graph and the facts the owner
	 * combines across units. */
	private string lower(string group) {
		IRModule unit = self.compiler.lowerGroup(group, self.shared);
		ModuleUnitGraph graph = ModuleUnitGraph.fromUnit(unit, self.compiler.lastInstanceNames());
		self.compiler.addHostedRealtimeExternals(unit);
		self.units.put(group, unit);
		self.consulted.put(group, self.compiler.lastConsultedSources());
		JSONValue reply = JSONValue.makeObject();
		Vector<string> exports = [];
		Vector<string> roots = [];
		for definition in unit.functions {
			if (!definition.isStatic && definition.body != null) { exports.push(definition.name); }
			if (definition.isRealtime) { roots.push(definition.name); }
		}
		Vector<string> safe = [];
		Map<string, bool> base = self.compiler.baseRealtimeSafe();
		for name in unit.realtimeSafeExternals.keys() { if (!base.has(name)) { safe.push(name); } }
		safe.sort();
		CycleReturnBoundaryLowerer boundaries = CycleReturnBoundaryLowerer();
		reply.set("exports", ModuleUnitRecord.stringsJson(exports));
		reply.set("realtime-roots", ModuleUnitRecord.stringsJson(roots));
		reply.set("realtime-safe", ModuleUnitRecord.stringsJson(safe));
		reply.set("setjmp", JSONValue.makeBool(self.compiler.unitHasSetjmp(unit)));
		reply.set("releases", JSONValue.makeBool(boundaries.releasesCyclableValues(unit)));
		graph.writeTo(reply);
		return reply.stringify();
	}

	/* One setjmp analysis of a unit against the summaries solved so far; the
	 * request carries the summaries that moved since this worker last heard,
	 * and the reply the unit's summaries that moved since it last reported. */
	private string analyze(string group, string moved) {
		Map<string, SetjmpFunctionEffect> updates = {};
		if (!ModuleUnitSummaries.decode(moved, updates)) {
			fprintf(stderr, "internal compiler error: malformed setjmp summaries for group '%s'\n", group);
			exit(1);
		}
		for name in updates.keys() { self.solved.put(name, updates.get(name)); }
		IRModule unit = self.units.get(group);
		if (!self.analyses.has(group)) { self.analyses.put(group, SetjmpEffectAnalysis(self.compiler.hostedAbi())); }
		SetjmpEffectAnalysis analysis = self.analyses.get(group);
		self.effects.put(group, analysis.analyzeIncrementally(unit, self.solved));
		Map<string, SetjmpFunctionEffect> summaries = analysis.definitionSummaries();
		Map<string, SetjmpFunctionEffect> changed = {};
		for definition in unit.functions {
			if (definition.isStatic || definition.body == null) { continue; }
			SetjmpFunctionEffect summary = summaries.get(definition.name);
			SetjmpFunctionEffect previous = self.reported.has(definition.name) ? self.reported.get(definition.name) : SetjmpFunctionEffect();
			if (!summary.same(previous)) {
				changed.put(definition.name, summary);
				self.reported.put(definition.name, summary.snapshot());
			}
		}
		JSONValue reply = JSONValue.makeObject();
		reply.set("summaries", JSONValue.makeString(ModuleUnitSummaries.encode(changed)));
		Vector<string> consulted = analysis.consultedSolvedNames().keys();
		consulted.sort();
		reply.set("consulted", ModuleUnitRecord.stringsJson(consulted));
		keep analysis;
		return reply.stringify();
	}

	/* Realtime proofs of the named functions through this unit alone. */
	private string prove(string group, JSONValue message) {
		Vector<string> names = [];
		Vector<string> paths = [];
		if (!ModuleUnitRecord.stringsFrom(message.get("names"), names) || !ModuleUnitRecord.stringsFrom(message.get("paths"), paths) || names.len != paths.len) {
			fprintf(stderr, "internal compiler error: malformed realtime request for group '%s'\n", group);
			exit(1);
		}
		RealtimeUnitProof proof = RealtimeIRVerifier.proveWithin(self.units.get(group), names, paths);
		JSONValue reply = JSONValue.makeObject();
		reply.set("starts", ModuleUnitRecord.stringsJson(proof.starts));
		reply.set("callees", ModuleUnitRecord.stringsJson(proof.callees));
		reply.set("paths", ModuleUnitRecord.stringsJson(proof.paths));
		return reply.stringify();
	}

	/* Optimize and emit the unit with the program facts the owner settled.
	 * The reply is the decimal length of a JSON header, a newline, the header
	 * and then the unit's C text. */
	private string finish(string group, JSONValue message) {
		IRModule unit = self.units.get(group);
		Vector<string> unneededNames = [];
		Vector<string> reached = [];
		if (!message.get("releases").isBool() || !ModuleUnitRecord.stringsFrom(message.get("unneeded"), unneededNames) || !ModuleUnitRecord.stringsFrom(message.get("realtime-safe"), reached)) {
			fprintf(stderr, "internal compiler error: malformed finish request for group '%s'\n", group);
			exit(1);
		}
		Map<string, bool> unneeded = {};
		for name in unneededNames { unneeded.put(name, true); }
		for name in reached { unit.realtimeSafeExternals.put(name, true); }
		Map<string, SetjmpCallEffects> unitEffects = {};
		if (self.effects.has(group)) { unitEffects = self.effects.get(group); }
		IROptimizer optimizer = IROptimizer(SetjmpSafetyPlanner(SetjmpEffectAnalysis(self.compiler.hostedAbi())), self.compiler.runtimeHelpers());
		optimizer.optimizeModuleUnit(unit, self.compiler.runsDce(), unitEffects, message.get("releases").asBool(), unneeded);
		Map<string, string> dropped = optimizer.droppedInvalidExports();
		keep optimizer;
		Vector<string> helpers = RuntimeReferenceCollector(self.compiler.runtimeHelpers()).requiredBy(unit).keys();
		helpers.sort();
		bool kept = false;
		Vector<string> exports = [];
		bool definesEntry = false;
		for definition in unit.functions {
			if (!definition.isStatic) {
				kept = true;
				exports.push(definition.name);
			}
			if (definition.name == "main" || definition.name == "btrc_main") { definesEntry = true; }
		}
		for global in unit.globalDecls { if (!global.isExtern) { kept = true; } }
		exports.sort();
		string text = "";
		if (kept) {
			self.compiler.prepareDebugPaths(unit, group);
			self.shared.trimNativeIncludes(unit);
			text = CEmitter().emitModuleUnit(unit);
		}
		CycleReturnBoundaryLowerer boundaries = CycleReturnBoundaryLowerer();
		JSONValue header = JSONValue.makeObject();
		header.set("kept", JSONValue.makeBool(kept));
		header.set("exports", ModuleUnitRecord.stringsJson(exports));
		header.set("releases", JSONValue.makeBool(boundaries.releasesCyclableValues(unit)));
		header.set("entry", JSONValue.makeBool(definesEntry));
		header.set("helpers", ModuleUnitRecord.stringsJson(helpers));
		/* The WGSL of each kernel the unit dispatches is built from its body. */
		Map<string, bool> files = {};
		if (self.consulted.has(group)) { for file in self.consulted.get(group).keys() { files.put(file, true); } }
		for kernel in unit.gpuKernels {
			string file = self.compiler.fileOfLine(kernel.declaration.line);
			if (!file.isEmpty()) { files.put(file, true); }
		}
		Vector<string> sources = files.keys();
		sources.sort();
		header.set("sources", ModuleUnitRecord.stringsJson(sources));
		JSONValue invalid = JSONValue.makeObject();
		for name in dropped.keys() { invalid.set(name, JSONValue.makeString(dropped.get(name))); }
		header.set("dropped", invalid);
		string rendered = header.stringify();
		return Strings.fromInt(rendered.length()) + "\n" + rendered + text;
	}
}

/* Nodes of some declarations by identity: each node's running pre-order
 * position, and where each declaration's positions start. */
class ValidationNodeIndex {
	private Map<Node, int> positions = {};
	private Vector<int> starts = [];
	private Vector<string> slots = [];
	private int running = 0;

	public ValidationNodeIndex() {}

	/* Indexes a declaration's nodes, or only its type nodes. */
	public void add(string slot, Vector<Node> nodes, bool typesOnly) {
		self.starts.push(self.running);
		self.slots.push(slot);
		int at = 0;
		while (at < nodes.len) {
			Node node = nodes.get(at);
			if ((!typesOnly || node.kind == NK_TYPE_EXPR) && !self.positions.has(node)) { self.positions.put(node, self.running + at); }
			at = at + 1;
		}
		self.running = self.running + nodes.len;
	}

	/* "file\tordinal\tindex" for an indexed node, or null. */
	public string? locate(Node node) {
		if (!self.positions.has(node)) { return null; }
		int position = self.positions.get(node);
		int low = 0;
		int high = self.starts.len - 1;
		while (low < high) {
			int middle = (low + high + 1) / 2;
			if (self.starts.get(middle) <= position) { low = middle; } else { high = middle - 1; }
		}
		return self.slots.get(low) + "\t" + Strings.fromInt(position - self.starts.get(low));
	}
}

/* Stage B positions: a node's top-level declaration, named by its file and
 * its ordinal among that file's declarations, and its pre-order index within
 * the declaration (AstStructure). A reused group's files are unchanged, so
 * its positions name the same nodes in every build. */
class ValidationRecordCodec {
	private Map<string, string> slotOfDeclaration = {};
	private Map<string, Node> declarationAt = {};
	private Map<string, string> fileOfSlot = {};
	private Vector<string> slots = [];
	private Map<string, Vector<Node>> preorders = {};
	private Map<string, Map<Node, int>> ownPositions = {};
	/* Foreign nodes are found first among declarations with parameter
	 * defaults (a callee's defaults are read at its call sites), then among
	 * every declaration's type nodes (instance arguments name parameter,
	 * field and return types), then anywhere; each index is built on first
	 * need, and the fixed order keeps positions canonical. */
	private ValidationNodeIndex? defaultsIndex = null;
	private ValidationNodeIndex? typesIndex = null;
	private ValidationNodeIndex? everyIndex = null;

	/* `files`: declaration identity -> the file it was read from. */
	public ValidationRecordCodec(Vector<Node> declarations, Map<string, string> files) {
		Map<string, int> ordinals = {};
		Map<string, string> tags = {};
		for declaration in declarations {
			string key = AstIdentity.key(declaration);
			string file = files.has(key) ? files.get(key) : "<other>";
			int ordinal = ordinals.has(file) ? ordinals.get(file) : 0;
			ordinals.put(file, ordinal + 1);
			/* Records repeat a position on every line, so a file is named by a
			 * short stable tag of its path rather than the path itself. */
			if (!tags.has(file)) { tags.put(file, SHA256.digest(file).substring(0, 12)); }
			string slot = tags.get(file) + "\t" + Strings.fromInt(ordinal);
			self.slotOfDeclaration.put(key, slot);
			self.declarationAt.put(slot, declaration);
			self.fileOfSlot.put(slot, file);
			self.slots.push(slot);
		}
	}

	public string slot(Node declaration) { return self.slotOfDeclaration.get(AstIdentity.key(declaration)); }

	private Vector<Node> preorder(string slot) {
		if (!self.preorders.has(slot)) { self.preorders.put(slot, AstStructure.preorder(self.declarationAt.get(slot))); }
		return self.preorders.get(slot);
	}

	/* Built on the first node found outside the declaration being encoded. */
	/* 0: declarations with defaults; 1: every type node; 2: every node. */
	private ValidationNodeIndex index(int scope) {
		ValidationNodeIndex? existing = scope == 0 ? self.defaultsIndex : (scope == 1 ? self.typesIndex : self.everyIndex);
		if (existing != null) { return existing; }
		ValidationNodeIndex built = ValidationNodeIndex();
		for slot in self.slots {
			if (scope == 0 && !ValidationRecordCodec.hasDefaults(self.declarationAt.get(slot))) { continue; }
			built.add(slot, self.preorder(slot), scope == 1);
		}
		if (scope == 0) { self.defaultsIndex = built; } else if (scope == 1) { self.typesIndex = built; } else { self.everyIndex = built; }
		return built;
	}

	class bool hasDefaults(Node declaration) {
		for parameter in declaration.params() { if (parameter.default_ != null) { return true; } }
		for member in declaration.members() {
			for parameter in member.params() { if (parameter.default_ != null) { return true; } }
		}
		return false;
	}

	/* "file\tordinal\tindex\tkind", or null for a node in no declaration.
	 * Files other than the encoded declaration's are added to `foreign`. */
	private string? position(Node node, string ownSlot, Map<Node, int> own, Map<string, bool> foreign) {
		string kind = Strings.fromInt((int)node.kind);
		if (own.has(node)) { return ownSlot + "\t" + Strings.fromInt(own.get(node)) + "\t" + kind; }
		string? located = self.index(0).locate(node);
		/* The type index holds every declaration's type nodes at the same
		 * positions as the full index, so a type node it lacks is in no
		 * declaration: only other nodes need the full index. */
		if (located == null && node.kind == NK_TYPE_EXPR) { located = self.index(1).locate(node); }
		else if (located == null) { located = self.index(2).locate(node); }
		if (located == null) { return null; }
		string slot = located.substring(0, located.lastIndexOf("\t"));
		foreign.put(self.fileOfSlot.get(slot), true);
		return located + "\t" + kind;
	}

	/* A type: "@" and its position when the node is in the tree (replay then
	 * yields the shared node later phases may mutate), else "=" and its
	 * TypeIdentity encoding; null when it is neither. */
	private string? typeText(Node type, string ownSlot, Map<Node, int> own, Map<string, bool> foreign) {
		string? at = self.position(type, ownSlot, own, foreign);
		if (at != null) { return "@\t" + at; }
		if (TypeIdentity.encodable(type)) { return "=\t" + TypeIdentity.encode(type); }
		return null;
	}

	private string? typesText(Vector<Node> types, string ownSlot, Map<Node, int> own, Map<string, bool> foreign) {
		string text = Strings.fromInt(types.len);
		for type in types {
			string? item = self.typeText(type, ownSlot, own, foreign);
			if (item == null) { return null; }
			text = text + "\t" + item;
		}
		return text;
	}

	/* One declaration's journal as record text, or null when a fact cannot be
	 * named by position (a synthetic node) or a type cannot be encoded. */
	public string? encode(Node declaration, ValidationJournal journal, Map<string, bool> foreign) {
		string ownSlot = self.slot(declaration);
		/* Every phase encodes the same declarations; index each once. */
		if (!self.ownPositions.has(ownSlot)) { self.ownPositions.put(ownSlot, AstStructure.positions(declaration)); }
		Map<Node, int> own = self.ownPositions.get(ownSlot);
		StringBuilder out = StringBuilder();
		for fact in journal.facts {
			string line = Strings.fromInt(fact.kind);
			if (fact.kind == VALIDATION_GENERIC_CLASS) {
				string? arguments = self.typesText(fact.arguments, ownSlot, own, foreign);
				if (arguments == null) { return null; }
				line = line + "\t" + fact.name + "\t" + arguments;
			} else if (fact.kind == VALIDATION_GENERIC_METHOD) {
				string? classArguments = self.typesText(fact.arguments, ownSlot, own, foreign);
				string? methodArguments = self.typesText(fact.moreArguments, ownSlot, own, foreign);
				if (classArguments == null || methodArguments == null) { return null; }
				line = line + "\t" + fact.name + "\t" + fact.member + "\t" + classArguments + "\t" + methodArguments;
			} else {
				Node? node = fact.node;
				if (node == null) { return null; }
				string? at = self.position(node, ownSlot, own, foreign);
				if (at == null) { return null; }
				line = line + "\t" + at;
				if (fact.kind == VALIDATION_GENERIC_CONSTRUCTOR) {
					Node? value = fact.value;
					if (value == null) { return null; }
					string? valueText = self.typeText(value, ownSlot, own, foreign);
					if (valueText == null) { return null; }
					line = line + "\t" + valueText;
				} else if (fact.kind == VALIDATION_GENERATED_REFERENCE) {
					line = line + "\t" + (fact.directCall ? "1" : "0") + "\t" + (fact.sourceKnown ? "1" : "0");
				} else if (fact.kind == VALIDATION_RAW_BORROW) {
					line = line + "\t" + Strings.fromInt(fact.parameter) + "\t" + node.name;
				} else if (fact.kind == VALIDATION_CALL_ARGUMENTS) {
					string? arguments = self.typesText(fact.arguments, ownSlot, own, foreign);
					if (arguments == null) { return null; }
					line = line + "\t" + arguments;
				} else if (fact.kind == VALIDATION_REALTIME_EFFECT || fact.kind == VALIDATION_REALTIME_EDGE) {
					if (!ValidationRecordCodec.plain(fact.name) || !ValidationRecordCodec.plain(fact.member) || !ValidationRecordCodec.plain(fact.detail)) { return null; }
					line = line + "\t" + fact.name + "\t" + fact.member;
					if (fact.kind == VALIDATION_REALTIME_EFFECT) { line = line + "\t" + fact.detail; }
				} else if (fact.kind == VALIDATION_WARNING) {
					if (!ValidationRecordCodec.plain(fact.detail)) { return null; }
					line = line + "\t" + fact.detail;
				} else if (fact.kind == VALIDATION_DIVERGENCE) {
					if (!ValidationRecordCodec.plain(fact.detail) || !ValidationRecordCodec.plain(fact.name) || !ValidationRecordCodec.plain(fact.member)) { return null; }
					line = line + "\t" + fact.detail + "\t" + fact.name + "\t" + fact.member + "\t" + Strings.fromInt(fact.parameter);
				}
			}
			out.append(line);
			out.append("\n");
		}
		return out.toString();
	}

	/* Text a record field can carry as is. */
	class bool plain(string text) { return text.indexOf("\t") < 0 && text.indexOf("\n") < 0; }

	/* The node at fields[at .. at+3], or null when it names nothing here. */
	/* Facts of one declaration mostly name its own nodes: remember the last
	 * slot resolved. */
	private string lastTag = "";
	private string lastOrdinal = "";
	private Vector<Node> lastNodes = [];

	private Node? resolve(Vector<string> fields, int at) {
		if (at + 4 > fields.len) { return null; }
		Vector<Node> nodes = self.lastNodes;
		if (!fields.get(at).equals(self.lastTag) || !fields.get(at + 1).equals(self.lastOrdinal)) {
			string slot = fields.get(at) + "\t" + fields.get(at + 1);
			if (!self.declarationAt.has(slot)) { return null; }
			nodes = self.preorder(slot);
			self.lastTag = fields.get(at);
			self.lastOrdinal = fields.get(at + 1);
			self.lastNodes = nodes;
		}
		int index = Strings.toInt(fields.get(at + 2));
		if (index < 0 || index >= nodes.len) { return null; }
		Node node = nodes.get(index);
		if ((int)node.kind != Strings.toInt(fields.get(at + 3))) { return null; }
		return node;
	}

	/* The type at fields[cursor]: "@" and a position, or "=" and an encoding. */
	private Node? typeAt(Vector<string> fields, Vector<int> cursor) {
		int at = cursor.get(0);
		if (at + 2 > fields.len) { return null; }
		if (fields.get(at).equals("@")) {
			cursor.set(0, at + 5);
			return self.resolve(fields, at + 1);
		}
		if (!fields.get(at).equals("=")) { return null; }
		cursor.set(0, at + 2);
		return TypeIdentity.decode(fields.get(at + 1));
	}

	private Vector<Node>? typesAt(Vector<string> fields, Vector<int> cursor) {
		int at = cursor.get(0);
		if (at >= fields.len) { return null; }
		int count = Strings.toInt(fields.get(at));
		cursor.set(0, at + 1);
		Vector<Node> types = [];
		int index = 0;
		while (index < count) {
			Node? type = self.typeAt(fields, cursor);
			if (type == null) { return null; }
			types.push(type);
			index = index + 1;
		}
		return types;
	}

	/* A declaration's record text resolved to this program's nodes, or null
	 * when any fact no longer names a node of the recorded kind. */
	public Vector<ValidationFact>? decode(string text) {
		Vector<ValidationFact> facts = [];
		for line in Strings.split(text, "\n") {
			if (line.isEmpty()) { continue; }
			Vector<string> fields = Strings.split(line, "\t");
			int kind = Strings.toInt(fields.get(0));
			Vector<int> cursor = [1];
			if (kind == VALIDATION_GENERIC_CLASS || kind == VALIDATION_GENERIC_METHOD) {
				if (fields.len < 3) { return null; }
				ValidationFact demand = ValidationFact(kind, null);
				demand.name = fields.get(1);
				cursor.set(0, 2);
				if (kind == VALIDATION_GENERIC_METHOD) {
					demand.member = fields.get(2);
					cursor.set(0, 3);
				}
				Vector<Node>? arguments = self.typesAt(fields, cursor);
				if (arguments == null) { return null; }
				demand.arguments = arguments;
				if (kind == VALIDATION_GENERIC_METHOD) {
					Vector<Node>? methodArguments = self.typesAt(fields, cursor);
					if (methodArguments == null) { return null; }
					demand.moreArguments = methodArguments;
				}
				if (cursor.get(0) != fields.len) { return null; }
				facts.push(demand);
				continue;
			}
			Node? node = self.resolve(fields, 1);
			if (node == null) { return null; }
			ValidationFact fact = ValidationFact(kind, node);
			cursor.set(0, 5);
			if (kind == VALIDATION_GENERIC_CONSTRUCTOR) {
				Node? value = self.typeAt(fields, cursor);
				if (value == null || cursor.get(0) != fields.len) { return null; }
				fact.value = value;
			} else if (kind == VALIDATION_GENERATED_REFERENCE) {
				if (fields.len != 7) { return null; }
				fact.directCall = fields.get(5).equals("1");
				fact.sourceKnown = fields.get(6).equals("1");
			} else if (kind == VALIDATION_RAW_BORROW) {
				if (fields.len != 7 || (node.kind != NK_FUNCTION_DECL && node.kind != NK_METHOD_DECL) || !node.name.equals(fields.get(6))) { return null; }
				fact.parameter = Strings.toInt(fields.get(5));
			} else if (kind == VALIDATION_CALL_ARGUMENTS) {
				Vector<Node>? arguments = self.typesAt(fields, cursor);
				if (arguments == null || cursor.get(0) != fields.len) { return null; }
				fact.arguments = arguments;
			} else if (kind == VALIDATION_REALTIME_EFFECT) {
				if (fields.len != 8) { return null; }
				fact.name = fields.get(5);
				fact.member = fields.get(6);
				fact.detail = fields.get(7);
			} else if (kind == VALIDATION_REALTIME_EDGE) {
				if (fields.len != 7) { return null; }
				fact.name = fields.get(5);
				fact.member = fields.get(6);
			} else if (kind == VALIDATION_BOUNDED_LOOP) {
				if (fields.len != 5) { return null; }
			} else if (kind == VALIDATION_WARNING) {
				if (fields.len != 6) { return null; }
				fact.detail = fields.get(5);
			} else if (kind == VALIDATION_DIVERGENCE) {
				if (fields.len != 9 || (!fields.get(8).equals("0") && !fields.get(8).equals("1"))) { return null; }
				fact.detail = fields.get(5);
				fact.name = fields.get(6);
				fact.member = fields.get(7);
				fact.parameter = Strings.toInt(fields.get(8));
			} else if (kind != VALIDATION_HOSTED_CALL && kind != VALIDATION_CONSTANT_BOUND && kind != VALIDATION_ITERATION_CAPACITY) {
				return null;
			} else if (fields.len != 5) {
				return null;
			}
			facts.push(fact);
		}
		return facts;
	}
}

/* Stage B validation records: one per compilation group, keyed by the
 * group's source, the whole program's interface and the options that shape
 * validation. The inline standard library is one durable group; native
 * declarations are bodyless and never recorded. A record is written only
 * when every function and class of its group was validated live. With
 * BTRC_VERIFY_VALIDATION_RECORDS set, every declaration is validated live
 * and compared with its group's record. */
class ValidationRecords implements IValidationRecords {
	private ValidationRecordCodec codec;
	private IBtrccArtifactCache store;
	private bool verify;
	private Map<string, string> fileOfDeclaration = {};
	private Map<string, string> groupOfFile = {};
	private Map<string, string> keys = {};
	private Map<string, Map<string, string>> loaded = {};
	private Map<string, StringBuilder> writing = {};
	private Map<string, Map<string, bool>> foreign = {};
	private Map<string, bool> unwritable = {};
	private Map<string, bool> abandoned = {};
	public int replayed = 0;
	public int journaled = 0;
	public string interfaceDigest = "";
	/* Each group's source digest, by module-unit group name. */
	public Map<string, string> groupSourceDigests = {};
	/* Generic instance scans: one rewritable record per template group, loaded
	 * on first use; sections journaled this build are merged in on persist.
	 * Each section names the groups outside its template's that its facts
	 * came from, so an edit discards only the instances that read the edited
	 * group: a Vector<AlbumCell> scan, not every Vector scan in the program. */
	private Map<string, Map<string, string>> instancesLoaded = {};
	/* Per template group, each valid section's text as persisted: its
	 * dependency lines, then its facts. */
	private Map<string, Map<string, string>> instanceSections = {};
	private Map<string, Map<string, string>> instancesWritten = {};
	private Map<string, bool> instancesUnwritable = {};
	public int instancesReplayed = 0;

	/* `nativeIdentity` identifies the imported native declarations (as the
	 * artifact cache keys them), or is empty when they are not cacheable. */
	public ValidationRecords(Node program, Vector<Node> sourceDeclarations, FeResolvedSource resolved, BtrccOptions options, IBtrccArtifactCache store, string nativeIdentity) {
		self.store = store;
		self.verify = getenv("BTRC_VERIFY_VALIDATION_RECORDS") != null;
		FeSourcePathPolicy paths = FeSourcePathPolicy();
		FeCompilationGroups groups = resolved.dependencies.compilationGroups(paths.identity(resolved.rootSourcePath));
		Map<string, SHA256> digests = {};
		for line in resolved.userLines {
			if (!self.groupOfFile.has(line.sourceFile)) {
				string group = groups.groupOfIdentity(paths.identity(line.sourceFile));
				self.groupOfFile.put(line.sourceFile, group.isEmpty() ? "" : "group:" + group);
			}
			string group = self.groupOfFile.get(line.sourceFile);
			if (group.isEmpty()) { continue; }
			if (!digests.has(group)) { digests.put(group, SHA256()); }
			/* The same digest as of the joined line, without building it. */
			SHA256 digest = digests.get(group);
			digest.appendText(line.sourceFile);
			digest.appendText("\t");
			digest.appendText(Strings.fromInt(line.lineNumber));
			digest.appendText("\t");
			digest.appendText(line.text);
			digest.appendText("\n");
		}
		self.groupOfFile.put("<stdlib>", "<stdlib>");
		for declaration in sourceDeclarations {
			string file = "<other>";
			if (resolved.stdlibLineCount > 0 && declaration.line >= 1 && declaration.line <= resolved.stdlibLineCount) {
				file = "<stdlib>";
			} else {
				int userLine = declaration.line - resolved.stdlibLineCount;
				if (userLine >= 1 && userLine <= resolved.userLines.len) { file = resolved.userLines.get(userLine - 1).sourceFile; }
			}
			self.fileOfDeclaration.put(AstIdentity.key(declaration), file);
		}
		for declaration in program.declarations() {
			string key = AstIdentity.key(declaration);
			if (!self.fileOfDeclaration.has(key)) { self.fileOfDeclaration.put(key, "<native>"); }
		}
		self.codec = ValidationRecordCodec(program.declarations(), self.fileOfDeclaration);
		string context = f"validation-record-v5;target={options.target};strict={options.strictImports};stdlib={options.includeStdlib}";
		Map<string, string> sources = {};
		for group in digests.keys() { sources.put(group, digests.get(group).finish()); }
		if (resolved.stdlibLineCount > 0) { sources.put("<stdlib>", SHA256.digest(resolved.stdlibSource)); }
		string interfaceDigest = self.programInterface(program, context, sources, nativeIdentity);
		self.interfaceDigest = interfaceDigest;
		for group in sources.keys() {
			if (group.startsWith("group:")) { self.groupSourceDigests.put(group.substring(6, group.length() - 6), sources.get(group)); }
		}
		for group in sources.keys() { self.keys.put(group, SHA256.digest(context + "\n" + group + "\n" + sources.get(group) + "\n" + interfaceDigest)); }
		for group in self.keys.keys() { self.load(group); }
	}

	/* The position-free interface of every declaration. A group's interface
	 * is a function of its source alone, so its digest is cached under the
	 * group's source digest and only changed groups are rendered again;
	 * native declarations have no source of their own and are rendered each
	 * time. */
	private string programInterface(Node program, string context, Map<string, string> sources, string nativeIdentity) {
		AstCanonicalRenderer renderer = AstCanonicalRenderer.interfaceRenderer(ModuleUnitInterfaceSummary());
		Map<string, SHA256> rendered = {};
		Map<string, string> cached = {};
		for group in sources.keys() {
			BtrccModuleUnitPayload? payload = self.store.loadModuleUnit(self.interfaceKey(context, group, sources.get(group)));
			if (payload != null && payload.record.equals("validation-interface-v1")) { cached.put(group, payload.text); }
		}
		/* Native declarations are a function of the native imports, whose
		 * identity keys their digest when it is known. */
		string nativesKey = nativeIdentity.isEmpty() ? "" : SHA256.digest("validation-natives-v1\n" + context + "\n" + nativeIdentity);
		string nativesDigest = "";
		if (!nativesKey.isEmpty()) {
			BtrccModuleUnitPayload? payload = self.store.loadModuleUnit(nativesKey);
			if (payload != null && payload.record.equals("validation-natives-v1")) { nativesDigest = payload.text; }
		}
		SHA256 natives = SHA256();
		SHA256 others = SHA256();
		for declaration in program.declarations() {
			string group = self.groupAmong(declaration, sources);
			if (group.isEmpty()) {
				string key = AstIdentity.key(declaration);
				bool native = self.fileOfDeclaration.has(key) && self.fileOfDeclaration.get(key).equals("<native>");
				if (!native) {
					others.appendText(SHA256.digest(renderer.render(declaration)));
				} else if (nativesDigest.isEmpty()) {
					natives.appendText(SHA256.digest(renderer.render(declaration)));
				}
			} else if (!cached.has(group)) {
				if (!rendered.has(group)) { rendered.put(group, SHA256()); }
				rendered.get(group).appendText(SHA256.digest(renderer.render(declaration)));
			}
		}
		for group in rendered.keys() {
			string digest = rendered.get(group).finish();
			cached.put(group, digest);
			self.store.storeModuleUnit(self.interfaceKey(context, group, sources.get(group)), BtrccModuleUnitPayload("validation-interface-v1", digest));
		}
		Vector<string> names = [];
		for group in cached.keys() { names.push(group); }
		names.sort();
		SHA256 result = SHA256();
		for group in names { result.appendText(group + "\t" + cached.get(group) + "\n"); }
		if (nativesDigest.isEmpty()) {
			nativesDigest = natives.finish();
			if (!nativesKey.isEmpty()) { self.store.storeModuleUnit(nativesKey, BtrccModuleUnitPayload("validation-natives-v1", nativesDigest)); }
		}
		result.appendText("<native>\t" + nativesDigest + "\n");
		result.appendText("<other>\t" + others.finish() + "\n");
		return result.finish();
	}

	private string interfaceKey(string context, string group, string source) { return SHA256.digest("validation-interface-v1\n" + context + "\n" + group + "\n" + source); }

	/* The recordable group a declaration was read from, among `groups`, or "". */
	private string groupAmong(Node declaration, Map<string, string> groups) {
		string key = AstIdentity.key(declaration);
		if (!self.fileOfDeclaration.has(key)) { return ""; }
		string file = self.fileOfDeclaration.get(key);
		if (!self.groupOfFile.has(file)) { return ""; }
		string group = self.groupOfFile.get(file);
		return groups.has(group) ? group : "";
	}

	/* The group a declaration's record belongs to, or "" when none can. */
	private string groupOf(Node declaration) {
		string key = AstIdentity.key(declaration);
		if (!self.fileOfDeclaration.has(key)) { return ""; }
		string file = self.fileOfDeclaration.get(key);
		if (!self.groupOfFile.has(file)) { return ""; }
		string group = self.groupOfFile.get(file);
		return self.keys.has(group) ? group : "";
	}

	private void load(string group) {
		BtrccModuleUnitPayload? payload = self.store.loadModuleUnit(self.keys.get(group));
		if (payload == null || !payload.record.equals("validation-record-v5")) { return; }
		Map<string, string> declarations = {};
		string slot = "";
		StringBuilder facts = StringBuilder();
		bool open = false;
		for line in Strings.split(payload.text, "\n") {
			if (line.startsWith("dep\t")) {
				Vector<string> fields = Strings.split(line, "\t");
				if (fields.len != 3 || !self.keys.has(fields.get(1)) || !self.keys.get(fields.get(1)).equals(fields.get(2))) { return; }
			} else if (line.startsWith("d\t")) {
				if (open) { declarations.put(slot, facts.toString()); }
				slot = line.substring(2, line.length() - 2);
				facts = StringBuilder();
				open = true;
			} else if (!line.isEmpty() && open) {
				facts.append(line);
				facts.append("\n");
			}
		}
		if (open) { declarations.put(slot, facts.toString()); }
		self.loaded.put(group, declarations);
	}

	/* A declaration's section of its group's record: phase, then slot. */
	private string section(int phase, Node declaration) { return Strings.fromInt(phase) + "\t" + self.codec.slot(declaration); }

	public Vector<ValidationFact>? recorded(int phase, Node declaration) {
		if (self.verify) { return null; }
		string group = self.groupOf(declaration);
		if (group.isEmpty() || !self.loaded.has(group)) { return null; }
		/* The closure scan reads validation's facts, so it follows a group
		 * whose validation replay was abandoned back to live analysis. */
		if (phase == RECORD_PHASE_CLOSE && self.abandoned.has(group)) { return null; }
		Map<string, string> declarations = self.loaded.get(group);
		string slot = self.section(phase, declaration);
		if (!declarations.has(slot)) { return null; }
		Vector<ValidationFact>? facts = self.codec.decode(declarations.get(slot));
		if (facts != null && phase == RECORD_PHASE_VALIDATE) { self.replayed = self.replayed + 1; }
		return facts;
	}

	public bool journals(int phase, Node declaration) {
		string group = self.groupOf(declaration);
		if (phase == RECORD_PHASE_VALIDATE && getenv("BTRC_DEBUG_RECORDS") != null) {
			fprintf(stderr, "records: live %s (group %s, loaded %d)\n", self.codec.slot(declaration), group, self.loaded.has(group) ? 1 : 0);
		}
		if (group.isEmpty() || self.unwritable.has(group)) { return false; }
		return self.verify || !self.loaded.has(group);
	}

	public bool finish(int phase, Node declaration, ValidationJournal journal) {
		string group = self.groupOf(declaration);
		if (!self.foreign.has(group)) { self.foreign.put(group, {}); }
		string? text = self.codec.encode(declaration, journal, self.foreign.get(group));
		if (phase == RECORD_PHASE_VALIDATE) { self.journaled = self.journaled + 1; }
		string slot = self.section(phase, declaration);
		if (self.loaded.has(group)) {
			/* Verifying: the record must equal the live journal, and must
			 * resolve to nodes that encode back to the same text. */
			Map<string, string> declarations = self.loaded.get(group);
			if (text == null || !declarations.has(slot) || !declarations.get(slot).equals(text)) { return false; }
			Vector<ValidationFact>? decoded = self.codec.decode(text);
			if (decoded == null) { return false; }
			ValidationJournal replayed = ValidationJournal();
			replayed.facts = decoded;
			Map<string, bool> files = {};
			string? again = self.codec.encode(declaration, replayed, files);
			return again != null && again.equals(text);
		}
		if (text == null) {
			self.unwritable.put(group, true);
			return true;
		}
		if (!self.writing.has(group)) { self.writing.put(group, StringBuilder()); }
		StringBuilder out = self.writing.get(group);
		out.append("d\t" + slot + "\n");
		out.append(text);
		return true;
	}

	public bool reusable(Node declaration) {
		if (self.verify) { return false; }
		string group = self.groupOf(declaration);
		return !group.isEmpty() && self.loaded.has(group) && !self.abandoned.has(group);
	}

	private string instanceKey(string group) { return SHA256.digest("validation-instances-v2\n" + self.keys.get(group)); }

	/* A group's instance sections, loaded on first use, without any section
	 * whose dependency changed. */
	private Map<string, string> instances(string group) {
		if (self.instancesLoaded.has(group)) { return self.instancesLoaded.get(group); }
		Map<string, string> sections = {};
		Map<string, string> texts = {};
		self.instancesLoaded.put(group, sections);
		self.instanceSections.put(group, texts);
		BtrccModuleUnitPayload? payload = self.store.loadModuleUnit(self.instanceKey(group));
		if (payload == null || !payload.record.equals("validation-instances-v2")) { return sections; }
		string section = "";
		StringBuilder facts = StringBuilder();
		StringBuilder text = StringBuilder();
		bool open = false;
		bool current = true;
		for line in Strings.split(payload.text, "\n") {
			if (line.startsWith("i\t")) {
				if (open && current) { sections.put(section, facts.toString()); texts.put(section, text.toString()); }
				section = line.substring(2, line.length() - 2);
				facts = StringBuilder();
				text = StringBuilder();
				open = true;
				current = true;
			} else if (open && line.startsWith("dep\t")) {
				Vector<string> fields = Strings.split(line, "\t");
				if (fields.len != 3 || !self.keys.has(fields.get(1)) || !self.keys.get(fields.get(1)).equals(fields.get(2))) { current = false; }
				text.append(line);
				text.append("\n");
			} else if (!line.isEmpty() && open) {
				facts.append(line);
				facts.append("\n");
				text.append(line);
				text.append("\n");
			}
		}
		if (open && current) { sections.put(section, facts.toString()); texts.put(section, text.toString()); }
		return sections;
	}

	public Vector<ValidationFact>? recordedInstance(Node template, string section) {
		if (self.verify) { return null; }
		string group = self.groupOf(template);
		/* After validation, an instance scan reads validation's facts. */
		if (group.isEmpty() || (section.startsWith("after\t") && self.abandoned.has(group))) { return null; }
		Map<string, string> sections = self.instances(group);
		if (!sections.has(section)) { return null; }
		Vector<ValidationFact>? facts = self.codec.decode(sections.get(section));
		if (facts != null) { self.instancesReplayed = self.instancesReplayed + 1; }
		return facts;
	}

	public bool journalsInstance(Node template) {
		string group = self.groupOf(template);
		return !group.isEmpty() && !self.instancesUnwritable.has(group);
	}

	public bool finishInstance(Node template, string section, ValidationJournal journal) {
		string group = self.groupOf(template);
		Map<string, bool> files = {};
		string? text = self.codec.encode(template, journal, files);
		if (self.verify) {
			Map<string, string> sections = self.instances(group);
			if (sections.has(section)) { return text != null && sections.get(section).equals(text); }
		}
		if (text == null) {
			self.instancesUnwritable.put(group, true);
			return true;
		}
		/* A section whose facts name a file without a key cannot be checked
		 * later, so it is not written; the others still are. */
		string? dependencies = self.dependencyLines(group, files);
		if (dependencies == null) { return true; }
		if (!self.instancesWritten.has(group)) { self.instancesWritten.put(group, {}); }
		self.instancesWritten.get(group).put(section, dependencies + text);
		return true;
	}

	/* The dependency lines for the files one section names outside its
	 * template's group, or null when one of them has no key. */
	private string? dependencyLines(string group, Map<string, bool> files) {
		Vector<string> lines = [];
		Map<string, bool> seen = {};
		for file in files.keys() {
			if (file.equals("<native>")) { continue; }
			string other = self.groupOfFile.has(file) ? self.groupOfFile.get(file) : "";
			if (!self.keys.has(other)) { return null; }
			if (!other.equals(group) && !seen.has(other)) {
				seen.put(other, true);
				lines.push("dep\t" + other + "\t" + self.keys.get(other) + "\n");
			}
		}
		/* Sorted, so a section's text does not depend on map order. */
		lines.sort();
		return Strings.join(lines, "");
	}

	public void abandon(Node declaration) {
		string group = self.groupOf(declaration);
		if (!group.isEmpty()) { self.abandoned.put(group, true); }
	}

	/* After analysis succeeded: stores every complete new record, and voids
	 * any record a replay had to abandon. */
	public void persist() {
		for group in self.abandoned.keys() { self.store.storeModuleUnit(self.keys.get(group), BtrccModuleUnitPayload("validation-record-void", "")); }
		for group in self.writing.keys() {
			if (self.unwritable.has(group) || self.loaded.has(group)) { continue; }
			StringBuilder text = StringBuilder();
			bool complete = true;
			Map<string, bool> files = {};
			if (self.foreign.has(group)) { files = self.foreign.get(group); }
			for file in files.keys() {
				if (file.equals("<native>") || file.equals("<other>")) {
					/* Native declarations are bodyless: the interface digest in
					 * every key already covers their positions. */
					if (file.equals("<other>")) { complete = false; }
					continue;
				}
				string other = self.groupOfFile.has(file) ? self.groupOfFile.get(file) : "";
				if (!self.keys.has(other)) {
					complete = false;
				} else if (!other.equals(group)) {
					text.append("dep\t" + other + "\t" + self.keys.get(other) + "\n");
				}
			}
			if (!complete) { continue; }
			text.append(self.writing.get(group).toString());
			self.store.storeModuleUnit(self.keys.get(group), BtrccModuleUnitPayload("validation-record-v5", text.toString()));
		}
		for group in self.instancesWritten.keys() {
			if (self.instancesUnwritable.has(group) || self.verify) { continue; }
			StringBuilder text = StringBuilder();
			/* Earlier builds' sections stay valid under their own dependencies. */
			self.instances(group);
			Map<string, string> previous = self.instanceSections.get(group);
			Map<string, string> written = self.instancesWritten.get(group);
			for section in previous.keys() {
				if (!written.has(section)) { text.append("i\t" + section + "\n" + previous.get(section)); }
			}
			for section in written.keys() { text.append("i\t" + section + "\n" + written.get(section)); }
			self.store.storeModuleUnit(self.instanceKey(group), BtrccModuleUnitPayload("validation-instances-v2", text.toString()));
		}
	}
}
