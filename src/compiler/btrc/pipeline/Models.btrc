/* Cross-stage application models for the self-hosted compiler. */
import Library.Vector;

import ../frontend/Models.btrc;
import ../frontend/Packages.btrc;

/* The application may reuse emitted artifacts only after fresh resolution. */
class BtrccResolvedCompilation {
	public FeResolvedSource source;
	public FeResolvedPackages packages;
	public string sourcePath;
	public string contentIdentity;
	public string nativeIdentity;
	public Vector<string> inputPaths;

	public BtrccResolvedCompilation(FeResolvedSource source, FeResolvedPackages packages, string sourcePath, string contentIdentity, string nativeIdentity, Vector<string> inputPaths) {
		self.source = source;
		self.packages = packages;
		self.sourcePath = sourcePath;
		self.contentIdentity = contentIdentity;
		self.nativeIdentity = nativeIdentity;
		self.inputPaths = inputPaths;
	}
}

/* One module unit as stored: its record (the facts it published or
 * consulted) and its C text, kept apart so the text is never re-encoded. */
class BtrccModuleUnitPayload {
	public string record;
	public string text;

	public BtrccModuleUnitPayload(string record, string text) {
		self.record = record;
		self.text = text;
	}
}

interface IBtrccArtifactCache {
	BtrccCompilationResult? load(string identity);
	void store(string identity, BtrccCompilationResult result);
	/* Module units: one group's verified payload, or null for a miss. */
	BtrccModuleUnitPayload? loadModuleUnit(string identity);
	void storeModuleUnit(string identity, BtrccModuleUnitPayload payload);
}

class BtrccOptions {
	public bool valid;
	public bool includeStdlib;
	public bool strictImports;
	public bool runDce;
	public bool showHelp;
	public bool showStdlibDirectory;
	public string target;
	public string linkPlanPath;
	/* Split the emitted C into units written as <prefix>.unit-<k>.c; empty means one unit. */
	public string unitsPrefix = "";
	/* With unitsPrefix: lower and emit one unit per compilation group. */
	public bool moduleUnits = false;
	/* --jobs: module-unit worker processes; 0 picks the host's suggestion, at most two. */
	public int moduleJobs = 0;
	/* -o: write the generated C here instead of stdout; --debug: #line directives. */
	public string outputPath = "";
	public bool debug = false;
	public bool useCache = true;
	public int inputIndex;
	public string diagnostic;

	public BtrccOptions() {
		self.valid = true;
		self.includeStdlib = true;
		self.strictImports = true;
		self.runDce = true;
		self.showHelp = false;
		self.showStdlibDirectory = false;
		self.target = "";
		self.linkPlanPath = "";
		self.inputIndex = 1;
		self.diagnostic = "";
	}
}

class BtrccCompilationResult {
	public bool success;
	public string output;
	public string diagnostic;
	public string linkPlan;
	/* Secondary units in order; empty for a single-unit program. */
	public Vector<string> units = [];
	/* Exact destinations accompany the units; the CLI does not rederive them. */
	public Vector<string> unitPaths = [];
	/* Module units: groups lowered by this compile and those reused unchanged. */
	public Vector<string> moduleUnitsLowered = [];
	public Vector<string> moduleUnitsReused = [];
	/* Successful source reads plus declared native/package inputs. */
	public Vector<string> inputPaths = [];

	public BtrccCompilationResult(bool success, string output, string diagnostic, string linkPlan) {
		self.success = success;
		self.output = output;
		self.diagnostic = diagnostic;
		self.linkPlan = linkPlan;
	}
}
