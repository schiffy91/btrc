    order.push("__btrc_poll_cycles");
    order.push("__btrc_arc_thread_state_cleanup");
    order.push("__btrc_cycle_state_cleanup");
    /* run_cleanups + throw are emitted AFTER the cycles machinery: the
     * cycle-safe unwinder calls __btrc_collect_cycles / __btrc_suspect and
     * references the __btrc_visit_fn / __btrc_destroy_fn typedefs declared by
     * the cycles helpers, so those must precede it. */
    order.push("__btrc_cleanup_types");
    order.push("__btrc_register_cleanup_kind");
    order.push("__btrc_register_cleanup");
    order.push("__btrc_register_direct_cleanup");
    order.push("__btrc_discard_cleanups");
    order.push("__btrc_cleanup_mark");
    order.push("__btrc_discard_cleanups_to");
    order.push("__btrc_arc_guard_hook");
    order.push("__btrc_raise_captured");
    order.push("__btrc_run_cleanup_guarded");
    order.push("__btrc_flush_cycles_guarded");
    order.push("__btrc_run_cleanups");
    order.push("__btrc_throw");
    order.push("__btrc_try_state_cleanup");
    /* process helpers. */
    appendProcessRuntimeHelperOrder(order);
    /* pthread/Mutex helpers. */
    appendThreadRuntimeHelperOrder(order);
    return order;
