    order.push("__btrc_suspect_locked");
    order.push("__btrc_suspect");
    order.push("__btrc_arc_topology_state");
    order.push("__btrc_arc_topology_depth_state");
    order.push("__btrc_arc_exclusive_snapshot");
    order.push("__btrc_arc_topology_begin");
    order.push("__btrc_arc_topology_leave");
    order.push("__btrc_arc_deferred_state");
    order.push("__btrc_cycle_collector_state");
    order.push("__btrc_arc_graph_primitives");
    order.push("__btrc_arc_unregister_incoming");
    order.push("__btrc_forget_suspect");
    order.push("__btrc_collect_cycles_once");
    order.push("__btrc_arc_drain");
    order.push("__btrc_arc_abandon_graph");
    order.push("__btrc_flush_cycles");
    order.push("__btrc_arc_abandon_queue_drain");
    order.push("__btrc_arc_topology_cleanup");
    order.push("__btrc_arc_topology_complete");
    order.push("__btrc_arc_reverse_state");
    order.push("__btrc_arc_register_incoming");
    order.push("__btrc_arc_incoming_teardown_pending");
    order.push("__btrc_arc_reverse_proves_live");
    order.push("__btrc_arc_retain");
    order.push("__btrc_arc_retain_edge");
    order.push("__btrc_arc_adopt_edge");
    order.push("__btrc_arc_unlink_edge");
    order.push("__btrc_arc_release_impl");
    order.push("__btrc_arc_replace_edge");
    order.push("__btrc_arc_release");
    order.push("__btrc_arc_release_edge");
