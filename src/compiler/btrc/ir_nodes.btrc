/* Stage 4-6 support — IR node definitions for the self-hosted btrc compiler.
 *
 * Mirrors src/compiler/python/ir/nodes.py. btrc lacks dynamic dispatch, so the
 * IR is a fat tagged node: one IRNode with a `kind` tag (IRKind enum) plus the
 * union of every field any IR node needs. The emitter dispatches on `kind`.
 *
 * Only the subset needed for the pure-int --no-stdlib programs is modelled;
 * grow the enum + the constructors as the supported language grows.
 */

enum IRKind {
    IRK_NONE = 0,
    /* expressions */
    IRK_LITERAL,
    IRK_VAR,
    IRK_BINOP,
    IRK_UNARYOP,
    IRK_CALL,
    IRK_CAST,
    IRK_TERNARY,
    IRK_INDEX,
    IRK_FIELD_ACCESS,
    IRK_ADDRESS_OF,
    IRK_DEREF,
    IRK_SIZEOF,
    IRK_RAW_EXPR,
    IRK_STMT_EXPR,
    IRK_TUPLE_LITERAL,
    /* statements */
    IRK_VAR_DECL,
    IRK_ASSIGN,
    IRK_RETURN,
    IRK_EXPR_STMT,
    IRK_IF,
    IRK_WHILE,
    IRK_DO_WHILE,
    IRK_FOR,
    IRK_BREAK,
    IRK_CONTINUE,
    IRK_BLOCK,
    IRK_RAW_C,
    IRK_SWITCH,
    IRK_CASE,
};

class IRNode {
    public int kind;

    /* IRLiteral / IRRawExpr: literal C text */
    public string text;

    /* IRVar: name. IRCall: callee. IRBinOp/IRUnaryOp/IRAssign op handling */
    public string name;
    public string callee;
    public string op;
    public bool prefix;

    /* sub-expressions */
    public IRNode left;
    public IRNode right;
    public IRNode operand;
    public IRNode expr;          /* IRCast/IRAddressOf/IRDeref/IRExprStmt operand */
    public IRNode obj;
    public IRNode index;
    public IRNode condition;
    public IRNode true_expr;
    public IRNode false_expr;
    public Vector<IRNode> args;

    /* IRCast / IRSizeof */
    public string target_type;

    /* IRFieldAccess */
    public string field;
    public bool arrow;

    /* statements */
    public string c_type;        /* IRVarDecl type text */
    public bool is_volatile;     /* IRVarDecl: emit `volatile` (setjmp/longjmp rule) */
    public IRNode init;          /* IRVarDecl initializer / IRFor init */
    public IRNode value;         /* IRReturn / IRAssign value */
    public IRNode target;        /* IRAssign target */
    public IRNode then_block;    /* IRIf */
    public IRNode else_block;    /* IRIf */
    public IRNode body;          /* IRWhile/IRDoWhile/IRFor body */
    public IRNode update;        /* IRFor update */
    public Vector<IRNode> stmts; /* IRBlock / IRStmtExpr setup statements */
    public IRNode result;        /* IRStmtExpr result expression */

    public IRNode() {
        self.kind = IRK_NONE;
        self.text = "";
        self.name = "";
        self.callee = "";
        self.op = "";
        self.prefix = false;
        self.left = null;
        self.right = null;
        self.operand = null;
        self.expr = null;
        self.obj = null;
        self.index = null;
        self.condition = null;
        self.true_expr = null;
        self.false_expr = null;
        self.args = [];
        self.target_type = "";
        self.field = "";
        self.arrow = false;
        self.c_type = "";
        self.is_volatile = false;
        self.init = null;
        self.value = null;
        self.target = null;
        self.then_block = null;
        self.else_block = null;
        self.body = null;
        self.update = null;
        self.stmts = [];
        self.result = null;
    }
}

/* --- IR construction helpers (return a freshly-built node, never alias) --- */

IRNode irLiteral(string text) {
    IRNode n = IRNode();
    n.kind = IRK_LITERAL;
    n.text = text;
    return n;
}

IRNode irRawExpr(string text) {
    IRNode n = IRNode();
    n.kind = IRK_RAW_EXPR;
    n.text = text;
    return n;
}

/* Tuple literal: a C compound literal `(mangled){._0 = a, ._1 = b, ...}`.
 * `text` holds the mangled struct name (btrc_Tuple_int_int), `args` the lowered
 * element expressions. Reusing `args` lets the DCE/helper walkers cover the
 * element subtrees for free. Mirrors expressions._lower_tuple. */
IRNode irTupleLiteral(string mangled, Vector<IRNode> elems) {
    IRNode n = IRNode();
    n.kind = IRK_TUPLE_LITERAL;
    n.text = mangled;
    n.args = elems;
    return n;
}

IRNode irVar(string name) {
    IRNode n = IRNode();
    n.kind = IRK_VAR;
    n.name = name;
    return n;
}

IRNode irBinOp(IRNode left, string op, IRNode right) {
    IRNode n = IRNode();
    n.kind = IRK_BINOP;
    n.left = left;
    n.op = op;
    n.right = right;
    return n;
}

IRNode irUnaryOp(string op, IRNode operand, bool prefix) {
    IRNode n = IRNode();
    n.kind = IRK_UNARYOP;
    n.op = op;
    n.operand = operand;
    n.prefix = prefix;
    return n;
}

IRNode irCall(string callee, Vector<IRNode> args) {
    IRNode n = IRNode();
    n.kind = IRK_CALL;
    n.callee = callee;
    n.args = args;
    return n;
}

IRNode irCast(string target_type, IRNode expr) {
    IRNode n = IRNode();
    n.kind = IRK_CAST;
    n.target_type = target_type;
    n.expr = expr;
    return n;
}

IRNode irTernary(IRNode condition, IRNode true_expr, IRNode false_expr) {
    IRNode n = IRNode();
    n.kind = IRK_TERNARY;
    n.condition = condition;
    n.true_expr = true_expr;
    n.false_expr = false_expr;
    return n;
}

IRNode irIndex(IRNode obj, IRNode index) {
    IRNode n = IRNode();
    n.kind = IRK_INDEX;
    n.obj = obj;
    n.index = index;
    return n;
}

IRNode irFieldAccess(IRNode obj, string field, bool arrow) {
    IRNode n = IRNode();
    n.kind = IRK_FIELD_ACCESS;
    n.obj = obj;
    n.field = field;
    n.arrow = arrow;
    return n;
}

IRNode irAddressOf(IRNode expr) {
    IRNode n = IRNode();
    n.kind = IRK_ADDRESS_OF;
    n.expr = expr;
    return n;
}

IRNode irDeref(IRNode expr) {
    IRNode n = IRNode();
    n.kind = IRK_DEREF;
    n.expr = expr;
    return n;
}

IRNode irSizeof(string operand_text) {
    IRNode n = IRNode();
    n.kind = IRK_SIZEOF;
    n.target_type = operand_text;
    return n;
}

IRNode irVarDecl(string c_type, string name, IRNode? init) {
    IRNode n = IRNode();
    n.kind = IRK_VAR_DECL;
    n.c_type = c_type;
    n.name = name;
    if (init != null) { n.init = init; }
    return n;
}

IRNode irAssign(IRNode target, IRNode value) {
    IRNode n = IRNode();
    n.kind = IRK_ASSIGN;
    n.target = target;
    n.value = value;
    return n;
}

IRNode irReturn(IRNode? value) {
    IRNode n = IRNode();
    n.kind = IRK_RETURN;
    if (value != null) { n.value = value; }
    return n;
}

IRNode irExprStmt(IRNode expr) {
    IRNode n = IRNode();
    n.kind = IRK_EXPR_STMT;
    n.expr = expr;
    return n;
}

IRNode irIf(IRNode condition, IRNode then_block, IRNode? else_block) {
    IRNode n = IRNode();
    n.kind = IRK_IF;
    n.condition = condition;
    n.then_block = then_block;
    /* Guard the field store: btrcpy's ARC emits `else_block->__rc++` on the
     * assignment, which null-derefs when no else exists. Leaving the field at
     * its constructor default (null) skips that, matching the parser's idiom. */
    if (else_block != null) { n.else_block = else_block; }
    return n;
}

IRNode irWhile(IRNode condition, IRNode body) {
    IRNode n = IRNode();
    n.kind = IRK_WHILE;
    n.condition = condition;
    n.body = body;
    return n;
}

IRNode irDoWhile(IRNode body, IRNode condition) {
    IRNode n = IRNode();
    n.kind = IRK_DO_WHILE;
    n.body = body;
    n.condition = condition;
    return n;
}

IRNode irFor(IRNode? init, IRNode condition, IRNode? update, IRNode body) {
    IRNode n = IRNode();
    n.kind = IRK_FOR;
    if (init != null) { n.init = init; }
    n.condition = condition;
    if (update != null) { n.update = update; }
    n.body = body;
    return n;
}

IRNode irBreak() {
    IRNode n = IRNode();
    n.kind = IRK_BREAK;
    return n;
}

IRNode irContinue() {
    IRNode n = IRNode();
    n.kind = IRK_CONTINUE;
    return n;
}

IRNode irBlock(Vector<IRNode> stmts) {
    IRNode n = IRNode();
    n.kind = IRK_BLOCK;
    n.stmts = stmts;
    return n;
}

/* IRRawC: a raw C statement (multi-line). The emitter writes each non-blank
 * line at the current indentation (mirrors emitter IRRawC). Used only for the
 * setjmp/longjmp try/catch boilerplate. */
IRNode irRawC(string text) {
    IRNode n = IRNode();
    n.kind = IRK_RAW_C;
    n.text = text;
    return n;
}

/* IRSwitch: `value` is the switch expression; `args` holds the IRCase nodes
 * (mirrors IRSwitch.value/cases). */
IRNode irSwitch(IRNode value, Vector<IRNode> cases) {
    IRNode n = IRNode();
    n.kind = IRK_SWITCH;
    n.value = value;
    n.args = cases;
    return n;
}

/* IRCase: one switch case. `value` is the case label expression (null = the
 * `default:` clause); `stmts` is the case body (mirrors IRCase.value/body). */
IRNode irCase(IRNode? value, Vector<IRNode> body) {
    IRNode n = IRNode();
    n.kind = IRK_CASE;
    /* Guard the field store: btrcpy's ARC emits `value->__rc++` on the
     * assignment, which null-derefs for a `default:` clause (value == null).
     * Leaving the field at its constructor default (null) skips that. */
    if (value != null) { n.value = value; }
    n.stmts = body;
    return n;
}

/* IRStmtExpr: setup statements hoisted before the enclosing statement, then the
 * `result` expression is used in place. Mirrors IRStmtExpr (standard C11; no GCC
 * statement expressions). */
IRNode irStmtExpr(Vector<IRNode> stmts, IRNode result) {
    IRNode n = IRNode();
    n.kind = IRK_STMT_EXPR;
    n.stmts = stmts;
    n.result = result;
    return n;
}

/* --- IR top-level entities (functions + module) --- */

class IRParam {
    public string c_type;
    public string name;
    public IRParam(string c_type, string name) {
        self.c_type = c_type;
        self.name = name;
    }
}

/* A single field within a struct definition (mirrors IRStructField). */
class IRStructField {
    public string c_type;
    public string name;
    public IRStructField(string c_type, string name) {
        self.c_type = c_type;
        self.name = name;
    }
}

/* A struct definition (mirrors IRStructDef). */
class IRStructDef {
    public string name;
    public Vector<IRStructField> fields;
    public IRStructDef() {
        self.name = "";
        self.fields = [];
    }
}

class IRFunction {
    public string name;
    public string return_type;
    public Vector<IRParam> params;
    public IRNode body;      /* IRBlock, or null for a forward-only decl */
    public bool is_static;

    public IRFunction() {
        self.name = "";
        self.return_type = "void";
        self.params = [];
        self.body = null;
        self.is_static = false;
    }
}

class IRModule {
    public Vector<string> includes;
    /* Pre-rendered `typedef enum {...} Name;` blocks, emitted BEFORE forward
     * decls (mirrors module.enum_defs / emitter._emit_enum_def). Functions and
     * function-pointer typedefs may reference an enum type by name, so the enum
     * typedef must be declared first. */
    public Vector<string> enum_defs;
    public Vector<string> forward_decls;
    public Vector<IRStructDef> struct_defs;
    public Vector<IRFunction> functions;
    /* Pre-rendered C text blocks emitted after struct defs and before functions
     * (mirrors module.raw_sections): generic _Generic macros and generic-method
     * forward-declaration blocks. */
    public Vector<string> raw_sections;
    /* Ordered, deduplicated runtime-helper C source blocks (post-DCE: only the
     * ones actually referenced are present). Mirrors module.helper_decls. */
    public Vector<string> helpers;

    public IRModule() {
        self.includes = [];
        self.enum_defs = [];
        self.forward_decls = [];
        self.struct_defs = [];
        self.functions = [];
        self.raw_sections = [];
        self.helpers = [];
    }
}

/* Runtime-helper C source text (mirrors src/compiler/python/ir/helpers/*). Only
 * the int-subset helpers are modelled; grow as the language widens. Returns ""
 * for an unknown helper name. */
string helperSource(string name) {
    if (name == "__btrc_div_int") {
        return "static inline int __btrc_div_int(int a, int b) {\n"
            + "    if (b == 0) { fprintf(stderr, \"Division by zero\\n\"); exit(1); }\n"
            + "    return a / b;\n"
            + "}";
    }
    if (name == "__btrc_div_double") {
        return "static inline double __btrc_div_double(double a, double b) {\n"
            + "    if (b == 0.0) { fprintf(stderr, \"Division by zero\\n\"); exit(1); }\n"
            + "    return a / b;\n"
            + "}";
    }
    if (name == "__btrc_mod_int") {
        return "static inline int __btrc_mod_int(int a, int b) {\n"
            + "    if (b == 0) { fprintf(stderr, \"Modulo by zero\\n\"); exit(1); }\n"
            + "    return a % b;\n"
            + "}";
    }
    /* --- alloc category --- */
    if (name == "__btrc_strdup") {
        return "static inline char* __btrc_strdup(const char* s) {\n"
            + "    if (!s) return NULL;\n"
            + "    size_t len = strlen(s) + 1;\n"
            + "    char* copy = (char*)malloc(len);\n"
            + "    if (!copy) { fprintf(stderr, \"btrc: out of memory (strdup %zu bytes)\\n\", len); exit(1); }\n"
            + "    memcpy(copy, s, len);\n"
            + "    return copy;\n"
            + "}";
    }
    if (name == "__btrc_safe_realloc") {
        return "static inline void* __btrc_safe_realloc(void* ptr, size_t size) {\n"
            + "    void* result = realloc(ptr, size);\n"
            + "    if (!result && size > 0) { fprintf(stderr, \"btrc: out of memory (realloc %zu bytes)\\n\", size); exit(1); }\n"
            + "    return result;\n"
            + "}";
    }
    if (name == "__btrc_safe_calloc") {
        return "static inline void* __btrc_safe_calloc(size_t count, size_t size) {\n"
            + "    void* result = calloc(count, size);\n"
            + "    if (!result && count > 0) { fprintf(stderr, \"btrc: out of memory (calloc %zu bytes)\\n\", count * size); exit(1); }\n"
            + "    return result;\n"
            + "}";
    }
    /* --- string_pool category --- */
    if (name == "__btrc_str_pool_globals") {
        return "/* btrc string temp pool (dynamic) */\n"
            + "static int __btrc_str_pool_cap = 256;\n"
            + "static char** __btrc_str_pool = NULL;\n"
            + "static int __btrc_str_pool_top = 0;";
    }
    if (name == "__btrc_str_track") {
        return "static inline char* __btrc_str_track(char* s) {\n"
            + "    if (!__btrc_str_pool) {\n"
            + "        __btrc_str_pool = (char**)malloc(sizeof(char*) * __btrc_str_pool_cap);\n"
            + "    }\n"
            + "    if (__btrc_str_pool_top >= __btrc_str_pool_cap) {\n"
            + "        __btrc_str_pool_cap *= 2;\n"
            + "        __btrc_str_pool = (char**)realloc(__btrc_str_pool, sizeof(char*) * __btrc_str_pool_cap);\n"
            + "        if (!__btrc_str_pool) { fprintf(stderr, \"btrc: string pool OOM\\n\"); exit(1); }\n"
            + "    }\n"
            + "    __btrc_str_pool[__btrc_str_pool_top++] = s;\n"
            + "    return s;\n"
            + "}";
    }
    /* --- string category (STRING_OPS) --- */
    if (name == "__btrc_substring") {
        return "static inline char* __btrc_substring(const char* s, int start, int len) {\n"
            + "    if (!s) { char* r = (char*)malloc(1); r[0] = '\\0'; return r; }\n"
            + "    int slen = (int)strlen(s);\n"
            + "    if (start < 0) start = 0;\n"
            + "    if (start > slen) start = slen;\n"
            + "    if (start + len > slen) len = slen - start;\n"
            + "    if (len < 0) len = 0;\n"
            + "    char* result = (char*)malloc(len + 1);\n"
            + "    strncpy(result, s + start, len);\n"
            + "    result[len] = '\\0';\n"
            + "    return result;\n"
            + "}";
    }
    if (name == "__btrc_trim") {
        return "static inline char* __btrc_trim(const char* s) {\n"
            + "    if (!s) { char* r = (char*)malloc(1); r[0] = '\\0'; return r; }\n"
            + "    while (*s && isspace((unsigned char)*s)) s++;\n"
            + "    if (*s == '\\0') { char* r = (char*)malloc(1); r[0]='\\0'; return r; }\n"
            + "    const char* end = s + strlen(s) - 1;\n"
            + "    while (end > s && isspace((unsigned char)*end)) end--;\n"
            + "    int len = (int)(end - s + 1);\n"
            + "    char* result = (char*)malloc(len + 1);\n"
            + "    strncpy(result, s, len);\n"
            + "    result[len] = '\\0';\n"
            + "    return result;\n"
            + "}";
    }
    if (name == "__btrc_toUpper") {
        return "static inline char* __btrc_toUpper(const char* s) {\n"
            + "    if (!s) { char* r = (char*)malloc(1); r[0] = '\\0'; return r; }\n"
            + "    int len = (int)strlen(s);\n"
            + "    char* result = (char*)malloc(len + 1);\n"
            + "    for (int i = 0; i < len; i++) result[i] = (char)toupper((unsigned char)s[i]);\n"
            + "    result[len] = '\\0';\n"
            + "    return result;\n"
            + "}";
    }
    if (name == "__btrc_toLower") {
        return "static inline char* __btrc_toLower(const char* s) {\n"
            + "    if (!s) { char* r = (char*)malloc(1); r[0] = '\\0'; return r; }\n"
            + "    int len = (int)strlen(s);\n"
            + "    char* result = (char*)malloc(len + 1);\n"
            + "    for (int i = 0; i < len; i++) result[i] = (char)tolower((unsigned char)s[i]);\n"
            + "    result[len] = '\\0';\n"
            + "    return result;\n"
            + "}";
    }
    if (name == "__btrc_replace") {
        return "static inline char* __btrc_replace(const char* s, const char* old, const char* rep) {\n"
            + "    if (!s) { char* r = (char*)malloc(1); r[0] = '\\0'; return r; }\n"
            + "    if (!old || !old[0]) return __btrc_strdup(s);\n"
            + "    if (!rep) rep = \"\";\n"
            + "    int slen = (int)strlen(s);\n"
            + "    int oldlen = (int)strlen(old);\n"
            + "    int replen = (int)strlen(rep);\n"
            + "    int cap = slen * 2 + 1;\n"
            + "    char* result = (char*)malloc(cap);\n"
            + "    int rlen = 0, i = 0;\n"
            + "    while (i < slen) {\n"
            + "        if (i + oldlen <= slen && strncmp(s + i, old, oldlen) == 0) {\n"
            + "            while (rlen + replen >= cap) { cap *= 2; result = (char*)__btrc_safe_realloc(result, cap); }\n"
            + "            memcpy(result + rlen, rep, replen);\n"
            + "            rlen += replen; i += oldlen;\n"
            + "        } else {\n"
            + "            if (rlen + 1 >= cap) { cap *= 2; result = (char*)__btrc_safe_realloc(result, cap); }\n"
            + "            result[rlen++] = s[i++];\n"
            + "        }\n"
            + "    }\n"
            + "    result[rlen] = '\\0';\n"
            + "    return result;\n"
            + "}";
    }
    if (name == "__btrc_split") {
        return "static inline char** __btrc_split(const char* s, const char* delim) {\n"
            + "    if (!s || !delim) { char** r = (char**)__btrc_safe_realloc(NULL, sizeof(char*)); r[0] = NULL; return r; }\n"
            + "    int dlen = (int)strlen(delim);\n"
            + "    if (dlen == 0) { fprintf(stderr, \"Empty delimiter in split()\\n\"); exit(1); }\n"
            + "    int cap = 8;\n"
            + "    char** result = (char**)__btrc_safe_realloc(NULL, sizeof(char*) * cap);\n"
            + "    int count = 0;\n"
            + "    const char* p = s;\n"
            + "    while (*p) {\n"
            + "        const char* found = strstr(p, delim);\n"
            + "        int seglen = found ? (int)(found - p) : (int)strlen(p);\n"
            + "        if (count + 2 > cap) { cap *= 2; result = (char**)__btrc_safe_realloc(result, sizeof(char*) * cap); }\n"
            + "        result[count] = (char*)__btrc_safe_realloc(NULL, seglen + 1);\n"
            + "        memcpy(result[count], p, seglen);\n"
            + "        result[count][seglen] = '\\0';\n"
            + "        count++;\n"
            + "        if (!found) break;\n"
            + "        p = found + dlen;\n"
            + "    }\n"
            + "    result[count] = NULL;\n"
            + "    return result;\n"
            + "}";
    }
    if (name == "__btrc_repeat") {
        return "static inline char* __btrc_repeat(const char* s, int count) {\n"
            + "    if (!s) { char* r = (char*)malloc(1); r[0] = '\\0'; return r; }\n"
            + "    if (count < 0) { fprintf(stderr, \"repeat count must be non-negative\\n\"); exit(1); }\n"
            + "    if (count == 0) { char* r = (char*)malloc(1); r[0] = '\\0'; return r; }\n"
            + "    int slen = (int)strlen(s);\n"
            + "    if (slen > 0 && count > (INT_MAX - 1) / slen) {\n"
            + "        fprintf(stderr, \"btrc: string repeat overflow\\n\"); exit(1);\n"
            + "    }\n"
            + "    char* result = (char*)malloc((size_t)slen * count + 1);\n"
            + "    for (int i = 0; i < count; i++) memcpy(result + i * slen, s, slen);\n"
            + "    result[slen * count] = '\\0';\n"
            + "    return result;\n"
            + "}";
    }
    if (name == "__btrc_reverse") {
        return "static inline char* __btrc_reverse(const char* s) {\n"
            + "    if (!s) { char* r = (char*)malloc(1); r[0] = '\\0'; return r; }\n"
            + "    int len = (int)strlen(s);\n"
            + "    char* r = (char*)malloc(len + 1);\n"
            + "    for (int i = 0; i < len; i++) r[i] = s[len - 1 - i];\n"
            + "    r[len] = '\\0';\n"
            + "    return r;\n"
            + "}";
    }
    if (name == "__btrc_removePrefix") {
