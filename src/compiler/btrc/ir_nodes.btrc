/* Stage 4-6 support — IR node definitions for the self-hosted btrc compiler.
 *
 * Mirrors src/compiler/python/ir/nodes.py. btrc lacks dynamic dispatch, so the
 * IR is a fat tagged node: one IRNode with a `kind` tag (IRKind enum) plus the
 * union of every field any IR node needs. The emitter dispatches on `kind`.
 *
 * Only the subset needed for the pure-int --no-stdlib programs is modelled;
 * grow the enum + the constructors as the supported language grows.
 */

enum IRKind {
    IRK_NONE = 0,
    /* expressions */
    IRK_LITERAL,
    IRK_VAR,
    IRK_BINOP,
    IRK_COMMA_EXPR,
    IRK_UNARYOP,
    IRK_CALL,
    IRK_CAST,
    IRK_TERNARY,
    IRK_INDEX,
    IRK_FIELD_ACCESS,
    IRK_ADDRESS_OF,
    IRK_DEREF,
    IRK_SIZEOF,
    IRK_INITIALIZER_LIST,
    IRK_COMPOUND_LITERAL,
    IRK_STMT_EXPR,
    IRK_INVALID_EXPR,
    /* statements */
    IRK_VAR_DECL,
    IRK_ASSIGN,
    IRK_RETURN,
    IRK_EXPR_STMT,
    IRK_IF,
    IRK_WHILE,
    IRK_DO_WHILE,
    IRK_FOR,
    IRK_BREAK,
    IRK_CONTINUE,
    IRK_BLOCK,
    IRK_SWITCH,
    IRK_CASE,
};

class IRNode {
    public int kind;

    /* IRLiteral: C literal text */
    public string text;

    /* IRVar: name. IRCall: named callee. IRBinOp/IRUnaryOp/IRAssign op handling */
    public string name;
    public string callee;
    public string op;
    public bool prefix;

    /* sub-expressions */
    public IRNode left;
    public IRNode right;
    public IRNode operand;
    public IRNode expr;          /* cast/address/deref/expr-stmt/call-callee operand */
    public IRNode obj;
    public IRNode index;
    public IRNode condition;
    public IRNode true_expr;
    public IRNode false_expr;
    public Vector<IRNode> args;
    public Vector<string> field_names; /* IRCompoundLiteral designators */

    /* IRCast / IRSizeof */
    public string target_type;

    /* IRFieldAccess */
    public string field;
    public bool arrow;

    /* statements */
    public string c_type;        /* IRVarDecl type text */
    public bool is_array_decl;   /* IRVarDecl declarator carries [] */
    public IRNode array_size;    /* optional local array/VLA bound */
    public bool is_volatile;     /* IRVarDecl: emit `volatile` (setjmp/longjmp rule) */
    public bool is_static;       /* IRVarDecl storage class */
    public bool is_extern;       /* IRVarDecl storage class */
    /* Typed unwind-slot identity shared by one declaration and its calls. */
    public IRCleanupSlot cleanup_slot;
    public string helper_ref;    /* Explicit runtime-helper edge on IRCall. */
    public IRNode init;          /* IRVarDecl initializer / IRFor init */
    public IRNode value;         /* IRReturn / IRAssign value */
    public IRNode target;        /* IRAssign target */
    public IRNode then_block;    /* IRIf */
    public IRNode else_block;    /* IRIf */
    public IRNode body;          /* IRWhile/IRDoWhile/IRFor body */
    public IRNode update;        /* IRFor update */
    public Vector<IRNode> stmts; /* IRBlock / IRStmtExpr setup statements */
    public IRNode result;        /* IRStmtExpr result expression */

    public IRNode() {
        self.kind = IRK_NONE;
        self.text = "";
        self.name = "";
        self.callee = "";
        self.op = "";
        self.prefix = false;
        self.left = null;
        self.right = null;
        self.operand = null;
        self.expr = null;
        self.obj = null;
        self.index = null;
        self.condition = null;
        self.true_expr = null;
        self.false_expr = null;
        self.args = [];
        self.field_names = [];
        self.target_type = "";
        self.field = "";
        self.arrow = false;
        self.c_type = "";
        self.is_array_decl = false;
        self.array_size = null;
        self.is_volatile = false;
        self.is_static = false;
        self.is_extern = false;
        self.cleanup_slot = null;
        self.helper_ref = "";
        self.init = null;
        self.value = null;
        self.target = null;
        self.then_block = null;
        self.else_block = null;
        self.body = null;
        self.update = null;
        self.stmts = [];
        self.result = null;
    }
}

/* --- IR construction helpers (return a freshly-built node, never alias) --- */

IRNode irLiteral(string text) {
    IRNode n = IRNode();
    n.kind = IRK_LITERAL;
    n.text = text;
    return n;
}

IRNode irInitializerList(Vector<IRNode> elements) {
    IRNode n = IRNode();
    n.kind = IRK_INITIALIZER_LIST;
    n.args = elements;
    return n;
}

/* A typed C compound literal with named field initializers. `field_names` and
 * `args` are parallel vectors so every initializer remains a traversable IR
 * expression (mirrors Python IRCompoundLiteral.fields). */
IRNode irCompoundLiteral(string c_type, Vector<string> field_names,
        Vector<IRNode> values) {
    IRNode n = IRNode();
    n.kind = IRK_COMPOUND_LITERAL;
    n.target_type = c_type;
    n.field_names = field_names;
    n.args = values;
    return n;
}

IRNode irVar(string name) {
    IRNode n = IRNode();
    n.kind = IRK_VAR;
    n.name = name;
    return n;
}

IRNode irBinOp(IRNode left, string op, IRNode right) {
    IRNode n = IRNode();
    n.kind = IRK_BINOP;
    n.left = left;
    n.op = op;
    n.right = right;
    return n;
}

IRNode irUnaryOp(string op, IRNode operand, bool prefix) {
    IRNode n = IRNode();
    n.kind = IRK_UNARYOP;
    n.op = op;
    n.operand = operand;
    n.prefix = prefix;
    return n;
}

IRNode irCall(string callee, Vector<IRNode> args) {
    IRNode n = IRNode();
    n.kind = IRK_CALL;
    n.callee = callee;
    n.args = args;
    return n;
}

IRNode irCallExpr(IRNode callee, Vector<IRNode> args) {
    IRNode n = IRNode();
    n.kind = IRK_CALL;
    n.expr = callee;
    n.args = args;
    return n;
}

IRNode irCast(string target_type, IRNode expr) {
    IRNode n = IRNode();
    n.kind = IRK_CAST;
    n.target_type = target_type;
    n.expr = expr;
    return n;
}

IRNode irTernary(IRNode condition, IRNode true_expr, IRNode false_expr) {
    IRNode n = IRNode();
    n.kind = IRK_TERNARY;
    n.condition = condition;
    n.true_expr = true_expr;
    n.false_expr = false_expr;
    return n;
}

IRNode irIndex(IRNode obj, IRNode index) {
    IRNode n = IRNode();
    n.kind = IRK_INDEX;
    n.obj = obj;
    n.index = index;
    return n;
}

IRNode irFieldAccess(IRNode obj, string field, bool arrow) {
    IRNode n = IRNode();
    n.kind = IRK_FIELD_ACCESS;
    n.obj = obj;
    n.field = field;
    n.arrow = arrow;
    return n;
}

IRNode irAddressOf(IRNode expr) {
    IRNode n = IRNode();
    n.kind = IRK_ADDRESS_OF;
    n.expr = expr;
    return n;
}

IRNode irDeref(IRNode expr) {
    IRNode n = IRNode();
    n.kind = IRK_DEREF;
    n.expr = expr;
    return n;
}

IRNode irSizeofType(string operand_type) {
    IRNode n = IRNode();
    n.kind = IRK_SIZEOF;
    n.target_type = operand_type;
    return n;
}

IRNode irSizeofExpr(IRNode operand) {
    IRNode n = IRNode();
    n.kind = IRK_SIZEOF;
    n.operand = operand;
    return n;
}

IRNode irVarDecl(string c_type, string name, IRNode? init) {
    IRNode n = IRNode();
    n.kind = IRK_VAR_DECL;
    n.c_type = c_type;
    n.name = name;
    if (init != null) { n.init = init; }
    return n;
}

IRNode irArrayVarDecl(string c_type, string name, IRNode? arraySize,
        IRNode? init) {
    IRNode n = irVarDecl(c_type, name, init);
    n.is_array_decl = true;
    if (arraySize != null) { n.array_size = arraySize; }
    return n;
}

IRNode irAssign(IRNode target, IRNode value) {
    IRNode n = IRNode();
    n.kind = IRK_ASSIGN;
    n.target = target;
    n.value = value;
    return n;
}

IRNode irReturn(IRNode? value) {
    IRNode n = IRNode();
    n.kind = IRK_RETURN;
    if (value != null) { n.value = value; }
    return n;
}

IRNode irExprStmt(IRNode expr) {
    IRNode n = IRNode();
    n.kind = IRK_EXPR_STMT;
    n.expr = expr;
    return n;
}

IRNode irIf(IRNode condition, IRNode then_block, IRNode? else_block) {
    IRNode n = IRNode();
    n.kind = IRK_IF;
    n.condition = condition;
    n.then_block = then_block;
    /* Guard the field store: btrcpy's ARC emits `else_block->__rc++` on the
     * assignment, which null-derefs when no else exists. Leaving the field at
     * its constructor default (null) skips that, matching the parser's idiom. */
    if (else_block != null) { n.else_block = else_block; }
    return n;
}

IRNode irWhile(IRNode condition, IRNode body) {
    IRNode n = IRNode();
    n.kind = IRK_WHILE;
    n.condition = condition;
    n.body = body;
    return n;
}

IRNode irDoWhile(IRNode body, IRNode condition) {
    IRNode n = IRNode();
    n.kind = IRK_DO_WHILE;
    n.body = body;
    n.condition = condition;
    return n;
}

IRNode irFor(IRNode? init, IRNode condition, IRNode? update, IRNode body) {
    IRNode n = IRNode();
    n.kind = IRK_FOR;
    if (init != null) { n.init = init; }
    n.condition = condition;
    if (update != null) { n.update = update; }
    n.body = body;
    return n;
}

IRNode irBreak() {
    IRNode n = IRNode();
    n.kind = IRK_BREAK;
    return n;
}

IRNode irContinue() {
    IRNode n = IRNode();
    n.kind = IRK_CONTINUE;
    return n;
}

IRNode irBlock(Vector<IRNode> stmts) {
    IRNode n = IRNode();
    n.kind = IRK_BLOCK;
    n.stmts = stmts;
    return n;
}

/* IRSwitch: `value` is the switch expression; `args` holds the IRCase nodes
 * (mirrors IRSwitch.value/cases). */
IRNode irSwitch(IRNode value, Vector<IRNode> cases) {
    IRNode n = IRNode();
    n.kind = IRK_SWITCH;
    n.value = value;
    n.args = cases;
    return n;
}

/* IRCase: one switch case. `value` is the case label expression (null = the
 * `default:` clause); `stmts` is the case body (mirrors IRCase.value/body). */
IRNode irCase(IRNode? value, Vector<IRNode> body) {
    IRNode n = IRNode();
    n.kind = IRK_CASE;
    /* Guard the field store: btrcpy's ARC emits `value->__rc++` on the
     * assignment, which null-derefs for a `default:` clause (value == null).
     * Leaving the field at its constructor default (null) skips that. */
    if (value != null) { n.value = value; }
    n.stmts = body;
    return n;
}

/* IRStmtExpr: setup statements hoisted before the enclosing statement, then the
 * `result` expression is used in place. Mirrors IRStmtExpr (standard C11; no GCC
 * statement expressions). */
IRNode irStmtExpr(Vector<IRNode> stmts, IRNode result) {
    IRNode n = IRNode();
    n.kind = IRK_STMT_EXPR;
    n.stmts = stmts;
    n.result = result;
    return n;
}

/* A standard-C comma expression. Every child is evaluated left-to-right and
 * the final child is the value of the whole expression. */
IRNode irCommaExpr(Vector<IRNode> expressions) {
    IRNode n = IRNode();
    n.kind = IRK_COMMA_EXPR;
    n.args = expressions;
    return n;
}

/* A deferred typed-operator diagnostic. Generic instances initially contain
 * every method; function DCE may remove an unreachable invalid specialization.
 * If the expression survives, the emitter reports its diagnostic and stops. */
IRNode irInvalidExpr(string message) {
    IRNode n = IRNode();
    n.kind = IRK_INVALID_EXPR;
    n.text = message;
    return n;
}

/* --- IR top-level entities (functions + module) --- */

class IRParam {
    public string c_type;
    public string name;
    public bool is_volatile;
    public IRParam(string c_type, string name) {
        self.c_type = c_type;
        self.name = name;
        self.is_volatile = false;
    }
}

/* A single field within a struct definition (mirrors IRStructField). */
class IRStructField {
    public string c_type;
    public string name;
    public IRStructField(string c_type, string name) {
        self.c_type = c_type;
        self.name = name;
    }
}

/* A struct definition (mirrors IRStructDef). */
class IRStructDef {
    public string name;
    public Vector<IRStructField> fields;
    /* Zero means natural alignment; otherwise one supported pragma-pack
     * alignment that must wrap this exact declaration during emission. */
    public int pack_alignment;
    public IRStructDef() {
        self.name = "";
        self.fields = [];
        self.pack_alignment = 0;
    }
}

class IRTypedefDef {
    public string target_type;
    public string name;
    public IRTypedefDef(string target_type, string name) {
        self.target_type = target_type;
        self.name = name;
    }
}

class IRTaggedUnionVariant {
    public string name;
    public Vector<IRStructField> fields;
    public IRTaggedUnionVariant(string name) {
        self.name = name;
        self.fields = [];
    }
}

class IRTaggedUnionDef {
    public string name;
    public string tag_type;
    public Vector<IRTaggedUnionVariant> variants;
    public IRTaggedUnionDef(string name, string tag_type) {
        self.name = name;
        self.tag_type = tag_type;
        self.variants = [];
    }
}

class IRGlobalDecl {
    public string c_type;
    public string name;
    public IRNode init;
    public IRNode array_size;
    public bool is_static;
    public bool is_extern;
    public bool is_volatile;
    public IRGlobalDecl(string c_type, string name) {
        self.c_type = c_type;
        self.name = name;
        self.init = null;
        self.array_size = null;
        self.is_static = true;
        self.is_extern = false;
        self.is_volatile = false;
    }
}

class IRFunction {
    public string name;
    public string return_type;
    public Vector<IRParam> params;
    public IRNode body;      /* IRBlock, or null for a forward-only decl */
    public bool is_static;
    public bool archive_export;

    public IRFunction() {
        self.name = "";
        self.return_type = "void";
        self.params = [];
        self.body = null;
        self.is_static = false;
        self.archive_export = false;
    }
}

/* Runtime-helper C source text (mirrors src/compiler/python/ir/helpers/*).
 * Concrete helpers are modelled here; collection templates are instantiated by
 * their generic lowering paths. Returns "" for an unknown helper name. */
string helperSource(string name) {
    if (cycleRuntimeHasHelper(name)) {
        return cycleRuntimeHelperSource(name);
    }
    if (stringOwnershipRuntimeHasHelper(name)) {
        return stringOwnershipRuntimeHelperSource(name);
    }
    if (trycatchRuntimeHasHelper(name)) {
        return trycatchRuntimeHelperSource(name);
    }
    if (name == "__btrc_div") {
        return "static inline int __btrc_div_g_int(int a, int b) {\n"
            + "    if (b == 0) { fprintf(stderr, \"Division by zero\\n\"); exit(1); }\n"
            + "    if (a == INT_MIN && b == -1) { fprintf(stderr, \"Integer division overflow\\n\"); exit(1); }\n"
            + "    return a / b;\n}\n"
            + "static inline unsigned int __btrc_div_g_uint(unsigned int a, unsigned int b) {\n"
            + "    if (b == 0U) { fprintf(stderr, \"Division by zero\\n\"); exit(1); }\n"
            + "    return a / b;\n}\n"
            + "static inline long __btrc_div_g_long(long a, long b) {\n"
            + "    if (b == 0L) { fprintf(stderr, \"Division by zero\\n\"); exit(1); }\n"
            + "    if (a == LONG_MIN && b == -1L) { fprintf(stderr, \"Integer division overflow\\n\"); exit(1); }\n"
            + "    return a / b;\n}\n"
            + "static inline unsigned long __btrc_div_g_ulong(unsigned long a, unsigned long b) {\n"
            + "    if (b == 0UL) { fprintf(stderr, \"Division by zero\\n\"); exit(1); }\n"
            + "    return a / b;\n}\n"
            + "static inline long long __btrc_div_g_llong(long long a, long long b) {\n"
            + "    if (b == 0LL) { fprintf(stderr, \"Division by zero\\n\"); exit(1); }\n"
            + "    if (a == LLONG_MIN && b == -1LL) { fprintf(stderr, \"Integer division overflow\\n\"); exit(1); }\n"
            + "    return a / b;\n}\n"
            + "static inline unsigned long long __btrc_div_g_ullong(unsigned long long a, unsigned long long b) {\n"
            + "    if (b == 0ULL) { fprintf(stderr, \"Division by zero\\n\"); exit(1); }\n"
            + "    return a / b;\n}\n"
            + "static inline float __btrc_div_g_float(float a, float b) {\n"
            + "    if (b == 0.0F) { fprintf(stderr, \"Division by zero\\n\"); exit(1); }\n"
            + "    return a / b;\n}\n"
            + "static inline double __btrc_div_g_double(double a, double b) {\n"
            + "    if (b == 0.0) { fprintf(stderr, \"Division by zero\\n\"); exit(1); }\n"
            + "    return a / b;\n}\n"
            + "static inline long double __btrc_div_g_ldouble(long double a, long double b) {\n"
            + "    if (b == 0.0L) { fprintf(stderr, \"Division by zero\\n\"); exit(1); }\n"
            + "    return a / b;\n}\n"
            + "#define __btrc_div(a, b) (_Generic(((a) + (b)), \\\n"
            + "    int: __btrc_div_g_int, unsigned int: __btrc_div_g_uint, \\\n"
            + "    long: __btrc_div_g_long, unsigned long: __btrc_div_g_ulong, \\\n"
            + "    long long: __btrc_div_g_llong, unsigned long long: __btrc_div_g_ullong, \\\n"
            + "    float: __btrc_div_g_float, double: __btrc_div_g_double, \\\n"
            + "    long double: __btrc_div_g_ldouble)((a), (b)))";
    }
    if (name == "__btrc_mod") {
        return "static inline int __btrc_mod_g_int(int a, int b) {\n"
            + "    if (b == 0) { fprintf(stderr, \"Modulo by zero\\n\"); exit(1); }\n"
            + "    if (a == INT_MIN && b == -1) return 0;\n"
            + "    return a % b;\n}\n"
            + "static inline unsigned int __btrc_mod_g_uint(unsigned int a, unsigned int b) {\n"
            + "    if (b == 0U) { fprintf(stderr, \"Modulo by zero\\n\"); exit(1); }\n"
            + "    return a % b;\n}\n"
            + "static inline long __btrc_mod_g_long(long a, long b) {\n"
            + "    if (b == 0L) { fprintf(stderr, \"Modulo by zero\\n\"); exit(1); }\n"
            + "    if (a == LONG_MIN && b == -1L) return 0L;\n"
            + "    return a % b;\n}\n"
            + "static inline unsigned long __btrc_mod_g_ulong(unsigned long a, unsigned long b) {\n"
            + "    if (b == 0UL) { fprintf(stderr, \"Modulo by zero\\n\"); exit(1); }\n"
            + "    return a % b;\n}\n"
            + "static inline long long __btrc_mod_g_llong(long long a, long long b) {\n"
            + "    if (b == 0LL) { fprintf(stderr, \"Modulo by zero\\n\"); exit(1); }\n"
            + "    if (a == LLONG_MIN && b == -1LL) return 0LL;\n"
            + "    return a % b;\n}\n"
            + "static inline unsigned long long __btrc_mod_g_ullong(unsigned long long a, unsigned long long b) {\n"
            + "    if (b == 0ULL) { fprintf(stderr, \"Modulo by zero\\n\"); exit(1); }\n"
            + "    return a % b;\n}\n"
            + "static inline int __btrc_mod_g_real(long double a, long double b) {\n"
            + "    /* Converting a real to int is defined exactly when its truncated value is\n"
            + "       representable.  Reject NaN/infinity and the two open boundary regions\n"
            + "       before casting, without requiring hosted libm helpers. */\n"
            + "    const long double lower = (long double)INT_MIN - 1.0L;\n"
            + "    const long double upper = (long double)INT_MAX + 1.0L;\n"
            + "    if (a != a || b != b || a <= lower || a >= upper\n"
            + "            || b <= lower || b >= upper) {\n"
            + "        fprintf(stderr, \"Floating modulo conversion out of range\\n\"); exit(1);\n"
            + "    }\n"
            + "    return __btrc_mod_g_int((int)a, (int)b);\n}\n"
            + "#define __btrc_mod(a, b) (_Generic(((a) + (b)), \\\n"
            + "    int: __btrc_mod_g_int, unsigned int: __btrc_mod_g_uint, \\\n"
            + "    long: __btrc_mod_g_long, unsigned long: __btrc_mod_g_ulong, \\\n"
            + "    long long: __btrc_mod_g_llong, unsigned long long: __btrc_mod_g_ullong, \\\n"
            + "    float: __btrc_mod_g_real, double: __btrc_mod_g_real, \\\n"
            + "    long double: __btrc_mod_g_real)((a), (b)))";
    }
    if (name == "__btrc_div_int") {
        return "static inline int __btrc_div_int(int a, int b) {\n"
            + "    if (b == 0) { fprintf(stderr, \"Division by zero\\n\"); exit(1); }\n"
            + "    if (a == INT_MIN && b == -1) { fprintf(stderr, \"Integer division overflow\\n\"); exit(1); }\n"
            + "    return a / b;\n"
            + "}";
    }
    if (name == "__btrc_div_double") {
        return "static inline double __btrc_div_double(double a, double b) {\n"
            + "    if (b == 0.0) { fprintf(stderr, \"Division by zero\\n\"); exit(1); }\n"
            + "    return a / b;\n"
            + "}";
    }
    if (name == "__btrc_mod_int") {
        return "static inline int __btrc_mod_int(int a, int b) {\n"
            + "    if (b == 0) { fprintf(stderr, \"Modulo by zero\\n\"); exit(1); }\n"
            + "    if (a == INT_MIN && b == -1) return 0;\n"
            + "    return a % b;\n"
            + "}";
    }
    /* --- alloc category --- */
    if (name == "__btrc_strdup") {
        return "static inline char* __btrc_strdup(const char* s) {\n"
            + "    if (!s) return NULL;\n"
            + "    size_t len = strlen(s);\n"
            + "    if (len == SIZE_MAX) { fprintf(stderr, \"btrc: strdup size overflow\\n\"); exit(1); }\n"
            + "    len++;\n"
            + "    char* copy = (char*)malloc(len);\n"
            + "    if (!copy) { fprintf(stderr, \"btrc: out of memory (strdup %zu bytes)\\n\", len); exit(1); }\n"
            + "    memcpy(copy, s, len);\n"
            + "    return copy;\n"
            + "}";
    }
    if (name == "__btrc_safe_realloc") {
        return "static inline void* __btrc_safe_realloc(void* ptr, size_t size) {\n"
            + "    if (size == 0) { free(ptr); return NULL; }\n"
            + "    void* result = realloc(ptr, size);\n"
            + "    if (!result) { fprintf(stderr, \"btrc: out of memory (realloc %zu bytes)\\n\", size); exit(1); }\n"
            + "    return result;\n"
            + "}";
    }
    if (name == "__btrc_safe_calloc") {
        return "static inline void* __btrc_safe_calloc(size_t count, size_t size) {\n"
            + "    if (size != 0 && count > SIZE_MAX / size) { fprintf(stderr, \"btrc: calloc size overflow\\n\"); exit(1); }\n"
