/* Stage 4-6 support — IR node definitions for the self-hosted btrc compiler.
 *
 * Mirrors src/compiler/python/ir/nodes.py. btrc lacks dynamic dispatch, so the
 * IR is a fat tagged node: one IRNode with a `kind` tag (IRKind enum) plus the
 * union of every field any IR node needs. The emitter dispatches on `kind`.
 *
 * The schema covers the production self-hosted surface and grows alongside
 * the Python IR; source expressions remain typed nodes through C emission.
 */

enum IRKind {
    IRK_NONE = 0,
    /* expressions */
    IRK_LITERAL,
    IRK_VAR,
    IRK_FUNCTION_REF,
    IRK_BINOP,
    IRK_COMMA_EXPR,
    IRK_UNARYOP,
    IRK_CALL,
    IRK_CAST,
    IRK_TERNARY,
    IRK_INDEX,
    IRK_FIELD_ACCESS,
    IRK_ADDRESS_OF,
    IRK_DEREF,
    IRK_SIZEOF,
    IRK_INITIALIZER_LIST,
    IRK_COMPOUND_LITERAL,
    IRK_STMT_EXPR,
    IRK_INVALID_EXPR,
    /* statements */
    IRK_VAR_DECL,
    IRK_ASSIGN,
    IRK_RETURN,
    IRK_EXPR_STMT,
    IRK_IF,
    IRK_WHILE,
    IRK_DO_WHILE,
    IRK_FOR,
    IRK_BREAK,
    IRK_CONTINUE,
    IRK_BLOCK,
    IRK_SWITCH,
    IRK_CASE,
};

class IRNode {
    public int kind;

    /* IRLiteral: C literal text */
    public string text;

    /* IRVar/IRFunctionRef: name. IRCall: named callee. */
    public string name;
    public string callee;
    public string op;
    public bool prefix;

    /* sub-expressions */
    public IRNode left;
    public IRNode right;
    public IRNode operand;
    public IRNode expr;          /* cast/address/deref/expr-stmt/call-callee operand */
    public IRNode obj;
    public IRNode index;
    public IRNode condition;
    public IRNode true_expr;
    public IRNode false_expr;
    public Vector<IRNode> args;
    public Vector<string> field_names; /* IRCompoundLiteral designators */

    /* IRCast / IRSizeof */
    public string target_type;

    /* IRFieldAccess */
    public string field;
    public bool arrow;
    /* Resolved direct-storage identity for source indexes and lowered derefs.
     * An empty known root means the lvalue changes a pointee, not the pointer
     * automatic itself. */
    public string storage_root;
    public bool storage_root_known;
    public bool source_address;
    public string array_storage_root;
    public bool array_storage_known;

    /* statements */
    public string c_type;        /* IRVarDecl type text */
    public bool is_array_decl;   /* IRVarDecl declarator carries [] */
    public IRNode array_size;    /* optional local array/VLA bound */
    public bool is_volatile;     /* Physical qualifier emitted in this declarator. */
    public bool effective_is_volatile; /* Semantic outer-object qualification. */
    public bool setjmp_inferred_volatile;
    public bool is_static;       /* IRVarDecl storage class */
    public bool is_extern;       /* IRVarDecl storage class */
    public bool is_cycle_return_temp; /* Boundary-pass provenance marker. */
    public bool falls_through;   /* IRCase: intentionally reaches next case. */
    /* Typed unwind-slot identity shared by one declaration and its calls. */
    public IRCleanupSlot cleanup_slot;
    public string helper_ref;    /* Explicit runtime-helper edge on IRCall. */
    public IRNode init;          /* IRVarDecl initializer / IRFor init */
    public IRNode value;         /* IRReturn / IRAssign value */
    public IRNode target;        /* IRAssign target */
    public IRNode then_block;    /* IRIf */
    public IRNode else_block;    /* IRIf */
    public IRNode body;          /* IRWhile/IRDoWhile/IRFor body */
    public IRNode update;        /* IRFor update */
    public Vector<IRNode> stmts; /* IRBlock / IRStmtExpr setup statements */
    public IRNode result;        /* IRStmtExpr result expression */

    public IRNode() {
        self.kind = IRK_NONE;
        self.text = "";
        self.name = "";
        self.callee = "";
        self.op = "";
        self.prefix = false;
        self.left = null;
        self.right = null;
        self.operand = null;
        self.expr = null;
        self.obj = null;
        self.index = null;
        self.condition = null;
        self.true_expr = null;
        self.false_expr = null;
        self.args = [];
        self.field_names = [];
        self.target_type = "";
        self.field = "";
        self.arrow = false;
        self.storage_root = "";
        self.storage_root_known = false;
        self.source_address = false;
        self.array_storage_root = "";
        self.array_storage_known = false;
        self.c_type = "";
        self.is_array_decl = false;
        self.array_size = null;
        self.is_volatile = false;
        self.effective_is_volatile = false;
        self.setjmp_inferred_volatile = false;
        self.is_static = false;
        self.is_extern = false;
        self.is_cycle_return_temp = false;
        self.falls_through = false;
        self.cleanup_slot = null;
        self.helper_ref = "";
        self.init = null;
        self.value = null;
        self.target = null;
        self.then_block = null;
        self.else_block = null;
        self.body = null;
        self.update = null;
        self.stmts = [];
        self.result = null;
    }
}

string irDirectStorageRoot(IRNode? node) {
    if (node == null) { return ""; }
    if (node.kind == IRK_VAR) { return node.name; }
    if (node.kind == IRK_FIELD_ACCESS) {
        if (node.arrow) { return ""; }
        return irDirectStorageRoot(node.obj);
    }
    if ((node.kind == IRK_INDEX || node.kind == IRK_DEREF)
            && node.storage_root_known) {
        return node.storage_root;
    }
    if (node.kind == IRK_INDEX) {
        return irDirectStorageRoot(node.obj);
    }
    return "";
}

IRNode irRecordArrayProjection(IRNode field, bool isArray) {
    if (isArray) {
        field.array_storage_known = true;
        field.array_storage_root = irDirectStorageRoot(field);
    }
    return field;
}

IRNode irRecordArrayValue(IRNode value, bool isArray) {
    if (isArray) {
        value.array_storage_known = true;
        value.array_storage_root = irDirectStorageRoot(value);
    }
    return value;
}

/* --- IR construction helpers (return a freshly-built node, never alias) --- */

IRNode irLiteral(string text) {
    IRNode n = IRNode();
    n.kind = IRK_LITERAL;
    n.text = text;
    return n;
}

IRNode irInitializerList(Vector<IRNode> elements) {
    IRNode n = IRNode();
    n.kind = IRK_INITIALIZER_LIST;
    n.args = elements;
    return n;
}

/* A typed C compound literal with named field initializers. `field_names` and
 * `args` are parallel vectors so every initializer remains a traversable IR
 * expression (mirrors Python IRCompoundLiteral.fields). */
IRNode irCompoundLiteral(string c_type, Vector<string> field_names,
        Vector<IRNode> values) {
    IRNode n = IRNode();
    n.kind = IRK_COMPOUND_LITERAL;
    n.target_type = c_type;
    n.field_names = field_names;
    n.args = values;
    return n;
}

IRNode irVar(string name) {
    IRNode n = IRNode();
    n.kind = IRK_VAR;
    n.name = name;
    return n;
}

IRNode irFunctionRef(string name) {
    IRNode n = IRNode();
    n.kind = IRK_FUNCTION_REF;
    n.name = name;
    return n;
}

IRNode irBinOp(IRNode left, string op, IRNode right) {
    IRNode n = IRNode();
    n.kind = IRK_BINOP;
    n.left = left;
    n.op = op;
    n.right = right;
    return n;
}

IRNode irUnaryOp(string op, IRNode operand, bool prefix) {
    IRNode n = IRNode();
    n.kind = IRK_UNARYOP;
    n.op = op;
    n.operand = operand;
    n.prefix = prefix;
    return n;
}

IRNode irCall(string callee, Vector<IRNode> args) {
    IRNode n = IRNode();
    n.kind = IRK_CALL;
    n.callee = callee;
    n.args = args;
    return n;
}

IRNode irCallExpr(IRNode callee, Vector<IRNode> args) {
    IRNode n = IRNode();
    n.kind = IRK_CALL;
    n.expr = callee;
    n.args = args;
    return n;
}

IRNode irCast(string target_type, IRNode expr) {
    IRNode n = IRNode();
    n.kind = IRK_CAST;
    n.target_type = target_type;
    n.expr = expr;
    return n;
}

IRNode irTernary(IRNode condition, IRNode true_expr, IRNode false_expr) {
    IRNode n = IRNode();
    n.kind = IRK_TERNARY;
    n.condition = condition;
    n.true_expr = true_expr;
    n.false_expr = false_expr;
    return n;
}

IRNode irIndex(IRNode obj, IRNode index) {
    IRNode n = IRNode();
    n.kind = IRK_INDEX;
    n.obj = obj;
    n.index = index;
    return n;
}

IRNode irFieldAccess(IRNode obj, string field, bool arrow) {
    IRNode n = IRNode();
    n.kind = IRK_FIELD_ACCESS;
    n.obj = obj;
    n.field = field;
    n.arrow = arrow;
    return n;
}

IRNode irAddressOf(IRNode expr) {
    IRNode n = IRNode();
    n.kind = IRK_ADDRESS_OF;
    n.expr = expr;
    return n;
}

IRNode irDeref(IRNode expr) {
    IRNode n = IRNode();
    n.kind = IRK_DEREF;
    n.expr = expr;
    return n;
}

IRNode irSizeofType(string operand_type) {
    IRNode n = IRNode();
    n.kind = IRK_SIZEOF;
    n.target_type = operand_type;
    return n;
}

IRNode irSizeofExpr(IRNode operand) {
    IRNode n = IRNode();
    n.kind = IRK_SIZEOF;
    n.operand = operand;
    return n;
}

IRNode irVarDecl(string c_type, string name, IRNode? init) {
    IRNode n = IRNode();
    n.kind = IRK_VAR_DECL;
    n.c_type = c_type;
    n.name = name;
    if (init != null) { n.init = init; }
    return n;
}

IRNode irArrayVarDecl(string c_type, string name, IRNode? arraySize,
        IRNode? init) {
    IRNode n = irVarDecl(c_type, name, init);
    n.is_array_decl = true;
    if (arraySize != null) { n.array_size = arraySize; }
    return n;
}

IRNode irAssign(IRNode target, IRNode value) {
    IRNode n = IRNode();
    n.kind = IRK_ASSIGN;
    n.target = target;
    n.value = value;
    return n;
}

IRNode irReturn(IRNode? value) {
    IRNode n = IRNode();
    n.kind = IRK_RETURN;
    if (value != null) { n.value = value; }
    return n;
}

IRNode irExprStmt(IRNode expr) {
    IRNode n = IRNode();
    n.kind = IRK_EXPR_STMT;
    n.expr = expr;
    return n;
}

IRNode irIf(IRNode condition, IRNode then_block, IRNode? else_block) {
    IRNode n = IRNode();
    n.kind = IRK_IF;
    n.condition = condition;
    n.then_block = then_block;
    /* Guard the field store: btrcpy's ARC emits `else_block->__rc++` on the
     * assignment, which null-derefs when no else exists. Leaving the field at
     * its constructor default (null) skips that, matching the parser's idiom. */
    if (else_block != null) { n.else_block = else_block; }
    return n;
}

IRNode irWhile(IRNode condition, IRNode body) {
    IRNode n = IRNode();
    n.kind = IRK_WHILE;
    n.condition = condition;
    n.body = body;
    return n;
}

IRNode irDoWhile(IRNode body, IRNode condition) {
    IRNode n = IRNode();
    n.kind = IRK_DO_WHILE;
    n.body = body;
    n.condition = condition;
    return n;
}

IRNode irFor(IRNode? init, IRNode condition, IRNode? update, IRNode body) {
    IRNode n = IRNode();
    n.kind = IRK_FOR;
    if (init != null) { n.init = init; }
    n.condition = condition;
    if (update != null) { n.update = update; }
    n.body = body;
    return n;
}

IRNode irBreak() {
    IRNode n = IRNode();
    n.kind = IRK_BREAK;
    return n;
}

IRNode irContinue() {
    IRNode n = IRNode();
    n.kind = IRK_CONTINUE;
    return n;
}

IRNode irBlock(Vector<IRNode> stmts) {
    IRNode n = IRNode();
    n.kind = IRK_BLOCK;
    n.stmts = stmts;
    return n;
}

/* IRSwitch: `value` is the switch expression; `args` holds the IRCase nodes
 * (mirrors IRSwitch.value/cases). */
IRNode irSwitch(IRNode value, Vector<IRNode> cases) {
    IRNode n = IRNode();
    n.kind = IRK_SWITCH;
    n.value = value;
    n.args = cases;
    return n;
}

/* IRCase: one switch case. `value` is the case label expression (null = the
 * `default:` clause); `stmts` is the case body (mirrors IRCase.value/body). */
IRNode irCase(IRNode? value, Vector<IRNode> body, bool fallsThrough) {
    IRNode n = IRNode();
    n.kind = IRK_CASE;
    /* Guard the field store: btrcpy's ARC emits `value->__rc++` on the
     * assignment, which null-derefs for a `default:` clause (value == null).
     * Leaving the field at its constructor default (null) skips that. */
    if (value != null) { n.value = value; }
    n.stmts = body;
    n.falls_through = fallsThrough;
    return n;
}

/* IRStmtExpr: setup statements hoisted before the enclosing statement, then the
 * `result` expression is used in place. Mirrors IRStmtExpr (standard C11; no GCC
 * statement expressions). */
IRNode irStmtExpr(Vector<IRNode> stmts, IRNode result) {
    IRNode n = IRNode();
    n.kind = IRK_STMT_EXPR;
    n.stmts = stmts;
    n.result = result;
    return n;
}

/* A standard-C comma expression. Every child is evaluated left-to-right and
 * the final child is the value of the whole expression. */
IRNode irCommaExpr(Vector<IRNode> expressions) {
    IRNode n = IRNode();
    n.kind = IRK_COMMA_EXPR;
    n.args = expressions;
    return n;
}

/* A deferred typed-operator diagnostic. Generic instances initially contain
 * every method; function DCE may remove an unreachable invalid specialization.
 * If the expression survives, the emitter reports its diagnostic and stops. */
IRNode irInvalidExpr(string message) {
    IRNode n = IRNode();
    n.kind = IRK_INVALID_EXPR;
    n.text = message;
    return n;
}

/* --- IR top-level entities (functions + module) --- */

class IRParam {
    public string c_type;
    public string name;
    public bool is_volatile;
    public bool effective_is_volatile;
    public bool setjmp_inferred_volatile;
    public IRParam(string c_type, string name) {
        self.c_type = c_type;
        self.name = name;
        self.is_volatile = false;
        self.effective_is_volatile = false;
        self.setjmp_inferred_volatile = false;
    }
}

/* A single field within a struct definition (mirrors IRStructField). */
class IRStructField {
    public string c_type;
    public string name;
    public IRNode array_size;
    public bool is_volatile;
    public bool effective_is_volatile;
    public IRStructField(string c_type, string name) {
        self.c_type = c_type;
        self.name = name;
        self.array_size = null;
        self.is_volatile = false;
        self.effective_is_volatile = false;
    }
}

/* A struct definition (mirrors IRStructDef). */
class IRStructDef {
    public string name;
    public Vector<IRStructField> fields;
    /* Zero means natural alignment; otherwise one supported pragma-pack
     * alignment that must wrap this exact declaration during emission. */
    public int pack_alignment;
    public IRStructDef() {
        self.name = "";
        self.fields = [];
        self.pack_alignment = 0;
    }
}

class IRTypedefDef {
    public string target_type;
    public string name;
    public bool is_volatile;
    public IRTypedefDef(string target_type, string name) {
        self.target_type = target_type;
        self.name = name;
        self.is_volatile = false;
    }
}

class IRTaggedUnionVariant {
    public string name;
    public Vector<IRStructField> fields;
    public IRTaggedUnionVariant(string name) {
        self.name = name;
        self.fields = [];
    }
}

class IRTaggedUnionDef {
    public string name;
    public string tag_type;
    public Vector<IRTaggedUnionVariant> variants;
    public IRTaggedUnionDef(string name, string tag_type) {
        self.name = name;
        self.tag_type = tag_type;
        self.variants = [];
    }
}

class IRGlobalDecl {
    public string c_type;
    public string name;
    public IRNode init;
    public IRNode array_size;
    public bool is_unsized_array;
    public bool is_static;
    public bool is_extern;
    public bool is_volatile;
    public bool effective_is_volatile;
    public IRGlobalDecl(string c_type, string name) {
        self.c_type = c_type;
        self.name = name;
        self.init = null;
        self.array_size = null;
        self.is_unsized_array = false;
        self.is_static = true;
        self.is_extern = false;
        self.is_volatile = false;
        self.effective_is_volatile = false;
    }
}

class IRFunction {
    public string name;
    public string return_type;
    public Vector<IRParam> params;
    public IRNode body;      /* IRBlock, or null for a forward-only decl */
    public bool is_static;
    public bool archive_export;

    public IRFunction() {
        self.name = "";
        self.return_type = "void";
        self.params = [];
        self.body = null;
        self.is_static = false;
        self.archive_export = false;
    }
}
Vector<string> helperHeaders(string name) {
    if (stringOwnershipRuntimeHasHelper(name)) {
        return stringOwnershipRuntimeHelperHeaders(name);
    }
    if (processRuntimeHasHelper(name)) {
        return processRuntimeHelperHeaders(name);
    }
    if (threadRuntimeHasHelper(name)) {
        return threadRuntimeHelperHeaders(name);
    }
    Vector<string> out = [];
    if (name == "__btrc_arc_lock_state"
            || name == "__btrc_arc_snapshot_state"
            || name == "__btrc_arc_snapshot_gate_state") {
        out.push("stdatomic.h");
    }
    else if (name == "__btrc_arc_exclusive_snapshot") {
        out.push("limits.h");
        out.push("stdio.h");
        out.push("stdlib.h");
    }
    else if (name == "__btrc_arc_abandon_graph") {
        out.push("stdlib.h");
    }
    else if (name == "__btrc_arc_abandon") {
        out.push("limits.h");
        out.push("stdint.h");
        out.push("stdio.h");
        out.push("stdlib.h");
    }
    else if (name == "__btrc_arc_topology_begin") {
        out.push("limits.h");
        out.push("stdio.h");
        out.push("stdlib.h");
    }
    else if (name == "__btrc_arc_topology_leave") {
        out.push("stdio.h");
        out.push("stdlib.h");
    }
    else if (name == "__btrc_arc_deferred_state") {
        out.push("stdio.h");
        out.push("stdlib.h");
    }
    else if (name == "__btrc_arc_drain") {
        out.push("limits.h");
        out.push("stdio.h");
        out.push("stdlib.h");
        out.push("string.h");
    }
    else if (name == "__btrc_raise_captured") {
        out.push("stdio.h");
        out.push("stdlib.h");
    }
    else if (name == "__btrc_copy_error_message") { out.push("string.h"); }
    else if (name == "__btrc_trycatch_globals") { out.push("setjmp.h"); }
    else if (name == "__btrc_thread_spawn"
            || name == "__btrc_mutex_val_create") {
        out.push("pthread.h");
        out.push("string.h");
    }
    return out;
}

/* Canonical emission order of concrete runtime helpers (mirrors registry.py
 * aggregation order). The emitter walks this list and emits helpers marked used
 * after dependency closure (DCE). */
Vector<string> canonicalHelperOrder() {
    Vector<string> order = [];
    /* alloc */
    order.push("__btrc_strdup");
    order.push("__btrc_safe_realloc");
    order.push("__btrc_safe_calloc");
    /* divmod */
    order.push("__btrc_div");
    order.push("__btrc_mod");
    order.push("__btrc_div_int");
    order.push("__btrc_div_double");
    order.push("__btrc_mod_int");
    /* string ownership + compatibility spellings */
    appendStringOwnershipRuntimeHelperOrder(order);
    /* string — STRING_COMMON */
    order.push("__btrc_string_or_empty");
    order.push("__btrc_string_length");
    order.push("__btrc_string_alloc");
    order.push("__btrc_ascii_upper");
    order.push("__btrc_ascii_lower");
    order.push("__btrc_ascii_space");
    /* string — STRING_OPS (insertion order in strings_ops.py) */
    order.push("__btrc_substring");
    order.push("__btrc_trim");
    order.push("__btrc_toUpper");
    order.push("__btrc_toLower");
    order.push("__btrc_replace");
    order.push("__btrc_split");
    order.push("__btrc_repeat");
    order.push("__btrc_reverse");
    order.push("__btrc_removePrefix");
    order.push("__btrc_removeSuffix");
    order.push("__btrc_capitalize");
    order.push("__btrc_title");
    order.push("__btrc_swapCase");
    order.push("__btrc_padLeft");
    order.push("__btrc_padRight");
    order.push("__btrc_center");
    order.push("__btrc_lstrip");
    order.push("__btrc_rstrip");
    order.push("__btrc_zfill");
    order.push("__btrc_strcat");
    order.push("__btrc_join");
    /* string — STRING_QUERY (insertion order in strings_query.py) */
    order.push("__btrc_charAt");
    order.push("__btrc_indexOf");
    order.push("__btrc_lastIndexOf");
    order.push("__btrc_isEmpty");
    order.push("__btrc_startsWith");
    order.push("__btrc_endsWith");
    order.push("__btrc_strContains");
    order.push("__btrc_count");
    order.push("__btrc_find");
    order.push("__btrc_isDigitStr");
    order.push("__btrc_isAlphaStr");
    order.push("__btrc_isBlank");
    order.push("__btrc_isUpper");
    order.push("__btrc_isLower");
    order.push("__btrc_isAlnumStr");
    order.push("__btrc_utf8_charlen");
    order.push("__btrc_charLen");
    /* string — STRING_CONVERT (insertion order in strings_convert.py) */
    order.push("__btrc_parseLong");
    order.push("__btrc_parseInt");
    order.push("__btrc_parseBool");
    order.push("__btrc_intToString");
    order.push("__btrc_longToString");
    order.push("__btrc_longLongToString");
    order.push("__btrc_uintToString");
    order.push("__btrc_ulongToString");
    order.push("__btrc_ulongLongToString");
    order.push("__btrc_floatToString");
    order.push("__btrc_doubleToString");
    order.push("__btrc_longDoubleToString");
    order.push("__btrc_charToString");
    order.push("__btrc_fromInt");
    order.push("__btrc_fromFloat");
    /* math */
    order.push("__btrc_math_factorial");
    order.push("__btrc_math_gcd");
    order.push("__btrc_math_lcm");
    order.push("__btrc_math_fibonacci");
    order.push("__btrc_math_isPrime");
    order.push("__btrc_math_sum_int");
    order.push("__btrc_math_fsum");
    /* trycatch (registry.py category order: after string/math, before hash) */
    order.push("__btrc_try_level");
    order.push("__btrc_trycatch_globals");
    order.push("__btrc_copy_error_message");
    order.push("__btrc_try_capacity");
    order.push("__btrc_cleanup_capacity");
    order.push("__btrc_launder_state");
    order.push("__btrc_launder");
    order.push("__btrc_push_try");
    /* hash */
    order.push("__btrc_hash_real");
    order.push("__btrc_hash_str");
    /* cycles (ARC cycle detection; roots first so their globals/typedefs
     * precede the dependent collector). Mirrors registry.py cycles category. */
    order.push("__btrc_arc_callback_types");
    order.push("__btrc_arc_header_of");
    order.push("__btrc_arc_type_of");
    order.push("__btrc_arc_validate");
