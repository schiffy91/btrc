            + "     * but skip any object already cascade-freed by an earlier destroy. */\n"
            + "    for (int i = __btrc_cleanup_top; i >= base; i--) {\n"
            + "        __btrc_cleanup_entry* e = &__btrc_cleanup_stack[i];\n"
            + "        if (e->visit) { continue; }\n"
            + "        if (e->fn && e->ptr_ref && *e->ptr_ref && !__btrc_is_destroyed(*e->ptr_ref)) {\n"
            + "            e->fn(*e->ptr_ref);\n"
            + "            *e->ptr_ref = NULL;\n"
            + "        }\n"
            + "    }\n"
            + "    /* Cyclable entries: phased release + cycle collection.\n"
            + "     * Phase 1 -- drop each managed local's own reference (rc--). */\n"
            + "    for (int i = __btrc_cleanup_top; i >= base; i--) {\n"
            + "        __btrc_cleanup_entry* e = &__btrc_cleanup_stack[i];\n"
            + "        if (e->visit && e->ptr_ref && *e->ptr_ref) { (*(int*)*e->ptr_ref)--; }\n"
            + "    }\n"
            + "    /* Phase 2 -- destroy objects whose rc hit zero (destroyed-log guarded). */\n"
            + "    for (int i = __btrc_cleanup_top; i >= base; i--) {\n"
            + "        __btrc_cleanup_entry* e = &__btrc_cleanup_stack[i];\n"
            + "        if (e->visit && e->fn && e->ptr_ref && *e->ptr_ref\n"
            + "                && !__btrc_is_destroyed(*e->ptr_ref)\n"
            + "                && *(int*)*e->ptr_ref <= 0) {\n"
            + "            e->fn(*e->ptr_ref);\n"
            + "            *e->ptr_ref = NULL;\n"
            + "        }\n"
            + "    }\n"
            + "    /* Phase 3 -- still-referenced survivors are cycle suspects. */\n"
            + "    for (int i = __btrc_cleanup_top; i >= base; i--) {\n"
            + "        __btrc_cleanup_entry* e = &__btrc_cleanup_stack[i];\n"
            + "        if (e->visit && e->fn && e->ptr_ref && *e->ptr_ref\n"
            + "                && !__btrc_is_destroyed(*e->ptr_ref)\n"
            + "                && *(int*)*e->ptr_ref > 0) {\n"
            + "            __btrc_suspect(*e->ptr_ref, (__btrc_visit_fn)e->visit,\n"
            + "                           (__btrc_destroy_fn)e->fn);\n"
            + "        }\n"
            + "    }\n"
            + "    /* Phase 4 -- trial-deletion cycle collection over the suspects. */\n"
            + "    if (__btrc_suspect_count > 0) { __btrc_collect_cycles(); }\n"
            + "    __btrc_tracking = 0;\n"
            + "    __btrc_cleanup_top = base - 1;\n"
            + "}";
    }
    if (name == "__btrc_discard_cleanups") {
        return "static inline void __btrc_discard_cleanups(int level) {\n"
            + "    while (__btrc_cleanup_top >= 0 &&\n"
            + "           __btrc_cleanup_stack[__btrc_cleanup_top].try_level >= level) {\n"
            + "        __btrc_cleanup_top--;\n"
            + "    }\n"
            + "}";
    }
    if (name == "__btrc_throw") {
        return "static inline void __btrc_throw(const char* msg) {\n"
            + "    if (__btrc_try_top < 0) {\n"
            + "        fprintf(stderr, \"Unhandled exception: %s\\n\", msg);\n"
            + "        exit(1);\n"
            + "    }\n"
            + "    strncpy(__btrc_error_msg, msg, 1023);\n"
            + "    __btrc_error_msg[1023] = '\\0';\n"
            + "    __btrc_run_cleanups(__btrc_try_top);\n"
            + "    longjmp(__btrc_try_stack[__btrc_try_top--], 1);\n"
            + "}";
    }
    /* --- hash category --- */
    if (name == "__btrc_hash_str") {
        return "static inline unsigned int __btrc_hash_str(const char* s) {\n"
            + "    unsigned int h = 5381;\n"
            + "    while (*s) { h = ((h << 5) + h) + (unsigned char)*s++; }\n"
            + "    return h;\n"
            + "}";
    }
    /* --- cycles category (ARC cycle detection; mirrors helpers/cycles.py) --- */
    if (name == "__btrc_destroyed_tracking") {
        return "/* ARC cascade-destroy tracking: avoid reading freed memory */\n"
            + "static int __btrc_tracking = 0;\n"
            + "static void** __btrc_destroyed = NULL;\n"
            + "static int __btrc_destroyed_count = 0;\n"
            + "static int __btrc_destroyed_cap = 0;\n"
            + "static void __btrc_mark_destroyed(void* ptr) {\n"
            + "    if (__btrc_destroyed_count >= __btrc_destroyed_cap) {\n"
            + "        __btrc_destroyed_cap = __btrc_destroyed_cap ? __btrc_destroyed_cap * 2 : 256;\n"
            + "        __btrc_destroyed = (void**)__btrc_safe_realloc(__btrc_destroyed, sizeof(void*) * __btrc_destroyed_cap);\n"
            + "    }\n"
            + "    __btrc_destroyed[__btrc_destroyed_count++] = ptr;\n"
            + "}\n"
            + "static int __btrc_is_destroyed(void* ptr) {\n"
            + "    for (int i = 0; i < __btrc_destroyed_count; i++)\n"
            + "        if (__btrc_destroyed[i] == ptr) return 1;\n"
            + "    return 0;\n"
            + "}";
    }
    if (name == "__btrc_suspect_buf") {
        return "/* ARC cycle detection: suspect buffer */\n"
            + "static void** __btrc_suspects = NULL;\n"
            + "static int __btrc_suspect_count = 0;\n"
            + "static int __btrc_suspect_cap = 0;\n"
            + "typedef void (*__btrc_visit_fn)(void*, void (*)(void**));\n"
            + "typedef void (*__btrc_destroy_fn)(void*);\n"
            + "static __btrc_visit_fn* __btrc_visit_table = NULL;\n"
            + "static __btrc_destroy_fn* __btrc_destroy_table = NULL;\n"
            + "static void __btrc_suspect(void* obj, __btrc_visit_fn visit,\n"
            + "                           __btrc_destroy_fn destroy) {\n"
            + "    if (__btrc_suspect_count >= __btrc_suspect_cap) {\n"
            + "        __btrc_suspect_cap = __btrc_suspect_cap ? __btrc_suspect_cap * 2 : 256;\n"
            + "        __btrc_suspects = (void**)__btrc_safe_realloc(__btrc_suspects, sizeof(void*) * __btrc_suspect_cap);\n"
            + "        __btrc_visit_table = (__btrc_visit_fn*)__btrc_safe_realloc(__btrc_visit_table, sizeof(__btrc_visit_fn) * __btrc_suspect_cap);\n"
            + "        __btrc_destroy_table = (__btrc_destroy_fn*)__btrc_safe_realloc(__btrc_destroy_table, sizeof(__btrc_destroy_fn) * __btrc_suspect_cap);\n"
            + "    }\n"
            + "    __btrc_suspects[__btrc_suspect_count] = obj;\n"
            + "    __btrc_visit_table[__btrc_suspect_count] = visit;\n"
            + "    __btrc_destroy_table[__btrc_suspect_count] = destroy;\n"
            + "    __btrc_suspect_count++;\n"
            + "}";
    }
    if (name == "__btrc_collect_cycles") {
        return "/* ARC cycle collector: trial deletion with cycle-breaking */\n"
            + "static void __btrc_trial_dec(void** fp) {\n"
            + "    if (*fp) { int* rc = (int*)*fp; (*rc)--; }\n"
            + "}\n"
            + "static void __btrc_trial_restore(void** fp) {\n"
            + "    if (*fp) { int* rc = (int*)*fp; (*rc)++; }\n"
            + "}\n"
            + "static void __btrc_clear_field(void** fp) {\n"
            + "    *fp = NULL;\n"
            + "}\n"
            + "static void __btrc_collect_cycles(void) {\n"
            + "    int n = __btrc_suspect_count;\n"
            + "    if (n == 0) return;\n"
            + "    /* Phase 1: trial decrement all suspects' cyclable children */\n"
            + "    for (int i = 0; i < n; i++) {\n"
            + "        if (__btrc_suspects[i] && __btrc_visit_table[i])\n"
            + "            __btrc_visit_table[i](__btrc_suspects[i], __btrc_trial_dec);\n"
            + "    }\n"
            + "    /* Phase 2: break cycles by NULLing cyclable fields, then destroy */\n"
            + "    for (int i = 0; i < n; i++) {\n"
            + "        void* obj = __btrc_suspects[i];\n"
            + "        if (!obj) continue;\n"
            + "        int rc = *(int*)obj;\n"
            + "        if (rc <= 0) {\n"
            + "            /* NULL cyclable fields to prevent cascade recursion */\n"
            + "            if (__btrc_visit_table[i])\n"
            + "                __btrc_visit_table[i](obj, __btrc_clear_field);\n"
            + "            /* Restore rc for destroy to work, then destroy */\n"
            + "            *(int*)obj = 1;\n"
            + "            if (__btrc_destroy_table[i])\n"
            + "                __btrc_destroy_table[i](obj);\n"
            + "            __btrc_suspects[i] = NULL;\n"
            + "        } else {\n"
            + "            /* Restore trial decrements for still-live objects */\n"
            + "            if (__btrc_visit_table[i])\n"
            + "                __btrc_visit_table[i](obj, __btrc_trial_restore);\n"
            + "        }\n"
            + "    }\n"
            + "    __btrc_suspect_count = 0;\n"
            + "}";
    }
    /* --- threads category (pthread wrappers; mirrors helpers/threads.py) --- */
    if (name == "__btrc_thread_spawn") {
        return "typedef struct {\n"
            + "    void* (*fn)(void*);\n"
            + "    void* arg;\n"
            + "    void* result;\n"
            + "    pthread_t handle;\n"
            + "} __btrc_thread_t;\n"
            + "\n"
            + "static void* __btrc_thread_wrapper(void* raw) {\n"
            + "    __btrc_thread_t* t = (__btrc_thread_t*)raw;\n"
            + "    t->result = t->fn(t->arg);\n"
            + "    return NULL;\n"
            + "}\n"
            + "\n"
            + "static __btrc_thread_t* __btrc_thread_spawn(void* (*fn)(void*), void* arg) {\n"
            + "    __btrc_thread_t* t = (__btrc_thread_t*)malloc(sizeof(__btrc_thread_t));\n"
            + "    if (!t) { fprintf(stderr, \"btrc: thread alloc failed\\n\"); exit(1); }\n"
            + "    t->fn = fn;\n"
            + "    t->arg = arg;\n"
            + "    t->result = NULL;\n"
            + "    int err = pthread_create(&t->handle, NULL, __btrc_thread_wrapper, t);\n"
            + "    if (err != 0) { fprintf(stderr, \"btrc: pthread_create failed\\n\"); free(t); exit(1); }\n"
            + "    return t;\n"
            + "}";
    }
    if (name == "__btrc_thread_join") {
        return "static void* __btrc_thread_join(__btrc_thread_t* t) {\n"
            + "    pthread_join(t->handle, NULL);\n"
            + "    return t->result;\n"
            + "}";
    }
    if (name == "__btrc_thread_free") {
        return "static void __btrc_thread_free(__btrc_thread_t* t) {\n"
            + "    free(t);\n"
            + "}";
    }
    if (name == "__btrc_mutex_val_create") {
        return "typedef struct {\n"
            + "    pthread_mutex_t lock;\n"
            + "    void* value;\n"
            + "} __btrc_mutex_val_t;\n"
            + "\n"
            + "static __btrc_mutex_val_t* __btrc_mutex_val_create(void* initial) {\n"
            + "    __btrc_mutex_val_t* m = (__btrc_mutex_val_t*)malloc(sizeof(__btrc_mutex_val_t));\n"
            + "    if (!m) { fprintf(stderr, \"btrc: mutex alloc failed\\n\"); exit(1); }\n"
            + "    if (pthread_mutex_init(&m->lock, NULL) != 0) { fprintf(stderr, \"btrc: mutex init failed\\n\"); free(m); exit(1); }\n"
            + "    m->value = initial;\n"
            + "    return m;\n"
            + "}";
    }
    if (name == "__btrc_mutex_val_get") {
        return "static void* __btrc_mutex_val_get(__btrc_mutex_val_t* m) {\n"
            + "    pthread_mutex_lock(&m->lock);\n"
            + "    void* v = m->value;\n"
            + "    pthread_mutex_unlock(&m->lock);\n"
            + "    return v;\n"
            + "}";
    }
    if (name == "__btrc_mutex_val_set") {
        return "static void __btrc_mutex_val_set(__btrc_mutex_val_t* m, void* val) {\n"
            + "    pthread_mutex_lock(&m->lock);\n"
            + "    m->value = val;\n"
            + "    pthread_mutex_unlock(&m->lock);\n"
            + "}";
    }
    if (name == "__btrc_mutex_val_destroy") {
        return "static void __btrc_mutex_val_destroy(__btrc_mutex_val_t* m) {\n"
            + "    pthread_mutex_destroy(&m->lock);\n"
            + "    free(m);\n"
            + "}";
    }
    return "";
}

/* Transitive helper dependencies (mirrors HelperDef.depends_on). Returns the
 * list of helpers `name` requires to be emitted first. */
Vector<string> helperDeps(string name) {
    Vector<string> out = [];
    if (name == "__btrc_strcat") { out.push("__btrc_strdup"); }
    else if (name == "__btrc_str_track") { out.push("__btrc_str_pool_globals"); }
    else if (name == "__btrc_str_flush") { out.push("__btrc_str_pool_globals"); }
    else if (name == "__btrc_replace") {
        out.push("__btrc_safe_realloc");
        out.push("__btrc_strdup");
    }
    else if (name == "__btrc_split") { out.push("__btrc_safe_realloc"); }
    else if (name == "__btrc_removePrefix") { out.push("__btrc_strdup"); }
    else if (name == "__btrc_removeSuffix") { out.push("__btrc_strdup"); }
    else if (name == "__btrc_zfill") { out.push("__btrc_strdup"); }
    /* trycatch category dependency edges (mirrors trycatch.py depends_on). */
    else if (name == "__btrc_cleanup_types") { out.push("__btrc_trycatch_globals"); }
    else if (name == "__btrc_register_cleanup") { out.push("__btrc_cleanup_types"); }
    else if (name == "__btrc_run_cleanups") {
        out.push("__btrc_cleanup_types");
        /* Cycle-safe unwinding reuses the trial-deletion collector + the
         * destroyed-object tracking, so pull the whole cycles machinery in. */
        out.push("__btrc_destroyed_tracking");
        out.push("__btrc_suspect_buf");
        out.push("__btrc_collect_cycles");
    }
    else if (name == "__btrc_discard_cleanups") { out.push("__btrc_cleanup_types"); }
    else if (name == "__btrc_throw") {
        out.push("__btrc_trycatch_globals");
        out.push("__btrc_run_cleanups");
    }
    /* threads dependency edges (mirrors helpers/threads.py depends_on): the
     * join/free/mutex-accessor helpers reference the typedef + globals declared
     * by their spawn/create root helper. */
    /* cycles category dependency edges (mirrors helpers/cycles.py depends_on). */
    else if (name == "__btrc_destroyed_tracking") { out.push("__btrc_safe_realloc"); }
    else if (name == "__btrc_suspect_buf") {
        out.push("__btrc_destroyed_tracking");
        out.push("__btrc_safe_realloc");
    }
    else if (name == "__btrc_collect_cycles") { out.push("__btrc_suspect_buf"); }
    else if (name == "__btrc_thread_join") { out.push("__btrc_thread_spawn"); }
    else if (name == "__btrc_thread_free") { out.push("__btrc_thread_spawn"); }
    else if (name == "__btrc_mutex_val_get") { out.push("__btrc_mutex_val_create"); }
    else if (name == "__btrc_mutex_val_set") { out.push("__btrc_mutex_val_create"); }
    else if (name == "__btrc_mutex_val_destroy") { out.push("__btrc_mutex_val_create"); }
    return out;
}

/* Canonical emission order of runtime helpers (mirrors registry.py aggregation
 * order, restricted to the modelled int subset). The emitter walks this list
 * and emits the ones marked used (DCE). */
Vector<string> canonicalHelperOrder() {
    Vector<string> order = [];
    /* alloc */
    order.push("__btrc_strdup");
    order.push("__btrc_safe_realloc");
    order.push("__btrc_safe_calloc");
    /* divmod */
    order.push("__btrc_div_int");
    order.push("__btrc_div_double");
    order.push("__btrc_mod_int");
    /* string_pool */
    order.push("__btrc_str_pool_globals");
    order.push("__btrc_str_track");
    order.push("__btrc_str_flush");
    /* string — STRING_OPS (insertion order in strings_ops.py) */
    order.push("__btrc_substring");
    order.push("__btrc_trim");
    order.push("__btrc_toUpper");
    order.push("__btrc_toLower");
    order.push("__btrc_replace");
    order.push("__btrc_split");
    order.push("__btrc_repeat");
    order.push("__btrc_reverse");
    order.push("__btrc_removePrefix");
    order.push("__btrc_removeSuffix");
    order.push("__btrc_capitalize");
    order.push("__btrc_title");
    order.push("__btrc_swapCase");
    order.push("__btrc_padLeft");
    order.push("__btrc_padRight");
    order.push("__btrc_center");
    order.push("__btrc_lstrip");
    order.push("__btrc_rstrip");
    order.push("__btrc_zfill");
    order.push("__btrc_strcat");
    order.push("__btrc_join");
    /* string — STRING_QUERY (insertion order in strings_query.py) */
    order.push("__btrc_charAt");
    order.push("__btrc_indexOf");
    order.push("__btrc_lastIndexOf");
    order.push("__btrc_isEmpty");
    order.push("__btrc_startsWith");
    order.push("__btrc_endsWith");
    order.push("__btrc_strContains");
    order.push("__btrc_count");
    order.push("__btrc_find");
    order.push("__btrc_isDigitStr");
    order.push("__btrc_isAlphaStr");
    order.push("__btrc_isBlank");
    order.push("__btrc_isUpper");
    order.push("__btrc_isLower");
    order.push("__btrc_isAlnumStr");
    order.push("__btrc_utf8_charlen");
    order.push("__btrc_charLen");
    /* string — STRING_CONVERT (insertion order in strings_convert.py) */
    order.push("__btrc_intToString");
    order.push("__btrc_longToString");
    order.push("__btrc_floatToString");
    order.push("__btrc_doubleToString");
    order.push("__btrc_charToString");
    order.push("__btrc_fromInt");
    order.push("__btrc_fromFloat");
    /* trycatch (registry.py category order: after string/math, before hash) */
    order.push("__btrc_trycatch_globals");
    order.push("__btrc_cleanup_types");
    order.push("__btrc_launder");
    order.push("__btrc_register_cleanup");
    order.push("__btrc_discard_cleanups");
    /* hash */
    order.push("__btrc_hash_str");
    /* cycles (ARC cycle detection; roots first so their globals/typedefs
     * precede the dependent collector). Mirrors registry.py cycles category. */
    order.push("__btrc_destroyed_tracking");
    order.push("__btrc_suspect_buf");
    order.push("__btrc_collect_cycles");
    /* run_cleanups + throw are emitted AFTER the cycles machinery: the
     * cycle-safe unwinder calls __btrc_collect_cycles / __btrc_suspect and
     * references the __btrc_visit_fn / __btrc_destroy_fn typedefs declared by
     * the cycles helpers, so those must precede it. */
    order.push("__btrc_run_cleanups");
    order.push("__btrc_throw");
    /* threads (pthread wrappers; spawn/create roots first so their typedefs +
     * globals precede the dependent accessors). */
    order.push("__btrc_thread_spawn");
    order.push("__btrc_thread_join");
    order.push("__btrc_thread_free");
    order.push("__btrc_mutex_val_create");
    order.push("__btrc_mutex_val_get");
    order.push("__btrc_mutex_val_set");
    order.push("__btrc_mutex_val_destroy");
    return order;
}
