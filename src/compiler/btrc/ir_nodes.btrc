        return "static inline void __btrc_thread_string_dispose(\n"
            + "        void* result, void* context) {\n"
            + "    (void)context;\n"
            + "    __btrc_string_release((char*)result);\n"
            + "}";
    }
    if (name == "__btrc_thread_join") {
        return "static void* __btrc_thread_join(__btrc_thread_t* t) {\n"
            + "    if (!t) { fprintf(stderr, \"btrc: cannot join a consumed thread handle\\n\"); exit(1); }\n"
            + "    __btrc_thread_finish(t);\n"
            + "    void* result = t->result;\n"
            + "    __btrc_thread_destroy_handle(t);\n"
            + "    return result;\n"
            + "}";
    }
    if (name == "__btrc_thread_free") {
        return "static void __btrc_thread_free(void* raw) {\n"
            + "    __btrc_thread_t* t = (__btrc_thread_t*)raw;\n"
            + "    if (!t) return;\n"
            + "    __btrc_thread_finish(t);\n"
            + "    if (t->dispose_result)\n"
            + "        t->dispose_result(t->result, t->result_context);\n"
            + "    __btrc_thread_destroy_handle(t);\n"
            + "}";
    }
    if (name == "__btrc_mutex_val_create") {
        return "typedef void (*__btrc_mutex_value_callback)(\n"
            + "    void*, void*);\n"
            + "typedef struct {\n"
            + "    pthread_mutex_t lock;\n"
            + "    void* value;\n"
            + "    size_t size;\n"
            + "    void* context;\n"
            + "    __btrc_mutex_value_callback retain;\n"
            + "    __btrc_mutex_value_callback release;\n"
            + "} __btrc_mutex_val_t;\n"
            + "\n"
            + "static __btrc_mutex_val_t* __btrc_mutex_val_create(\n"
            + "        void* initial, size_t size,\n"
            + "        const void* context, size_t context_size,\n"
            + "        __btrc_mutex_value_callback retain,\n"
            + "        __btrc_mutex_value_callback release) {\n"
            + "    if (!initial || size == 0) { fprintf(stderr, \"btrc: Mutex requires an initial value\\n\"); exit(1); }\n"
            + "    if ((!retain) != (!release)) { fprintf(stderr, \"btrc: invalid Mutex ownership callbacks\\n\"); free(initial); exit(1); }\n"
            + "    if ((!context) != (context_size == 0)) { fprintf(stderr, \"btrc: invalid Mutex ownership context\\n\"); free(initial); exit(1); }\n"
            + "    __btrc_mutex_val_t* m = (__btrc_mutex_val_t*)__btrc_safe_realloc(\n"
            + "        NULL, sizeof(__btrc_mutex_val_t));\n"
            + "    int err = pthread_mutex_init(&m->lock, NULL);\n"
            + "    if (err != 0) { fprintf(stderr, \"btrc: mutex init failed (%d)\\n\", err); free(initial); free(m); exit(1); }\n"
            + "    m->value = initial;\n"
            + "    m->size = size;\n"
            + "    m->context = NULL;\n"
            + "    if (context_size != 0) {\n"
            + "        m->context = __btrc_safe_realloc(NULL, context_size);\n"
            + "        memcpy(m->context, context, context_size);\n"
            + "    }\n"
            + "    m->retain = retain;\n"
            + "    m->release = release;\n"
            + "    if (m->retain) m->retain(*(void**)m->value, m->context);\n"
            + "    return m;\n"
            + "}";
    }
    if (name == "__btrc_mutex_arc_retain") {
        return "static void __btrc_mutex_arc_retain(\n"
            + "        void* value, void* context) {\n"
            + "    (void)context;\n"
            + "    (void)__btrc_arc_retain(value);\n"
            + "}";
    }
    if (name == "__btrc_mutex_arc_release") {
        return "static void __btrc_mutex_arc_release(\n"
            + "        void* value, void* context) {\n"
            + "    __btrc_arc_release(value, (const __btrc_arc_type*)context);\n"
            + "    __btrc_poll_cycles();\n"
            + "}";
    }
    if (name == "__btrc_mutex_string_retain") {
        return "static void __btrc_mutex_string_retain(\n"
            + "        void* value, void* context) {\n"
            + "    (void)context;\n"
            + "    (void)__btrc_string_retain((char*)value);\n"
            + "}";
    }
    if (name == "__btrc_mutex_string_release") {
        return "static void __btrc_mutex_string_release(\n"
            + "        void* value, void* context) {\n"
            + "    (void)context;\n"
            + "    __btrc_string_release((char*)value);\n"
            + "}";
    }
    if (name == "__btrc_mutex_val_get") {
        return "static void* __btrc_mutex_val_get(__btrc_mutex_val_t* m) {\n"
            + "    if (!m) { fprintf(stderr, \"btrc: cannot get a null Mutex\\n\"); exit(1); }\n"
            + "    void* copy = __btrc_safe_realloc(NULL, m->size);\n"
            + "    int err = pthread_mutex_lock(&m->lock);\n"
            + "    if (err != 0) { fprintf(stderr, \"btrc: mutex lock failed (%d)\\n\", err); exit(1); }\n"
            + "    memcpy(copy, m->value, m->size);\n"
            + "    if (m->retain) m->retain(*(void**)copy, m->context);\n"
            + "    err = pthread_mutex_unlock(&m->lock);\n"
            + "    if (err != 0) { fprintf(stderr, \"btrc: mutex unlock failed (%d)\\n\", err); exit(1); }\n"
            + "    return copy;\n"
            + "}";
    }
    if (name == "__btrc_mutex_val_set") {
        return "static void __btrc_mutex_val_set(__btrc_mutex_val_t* m, void* val) {\n"
            + "    if (!m || !val) { fprintf(stderr, \"btrc: cannot set a null Mutex\\n\"); free(val); exit(1); }\n"
            + "    if (m->retain) m->retain(*(void**)val, m->context);\n"
            + "    int err = pthread_mutex_lock(&m->lock);\n"
            + "    if (err != 0) { fprintf(stderr, \"btrc: mutex lock failed (%d)\\n\", err); exit(1); }\n"
            + "    void* old = m->value;\n"
            + "    m->value = val;\n"
            + "    err = pthread_mutex_unlock(&m->lock);\n"
            + "    if (err != 0) { fprintf(stderr, \"btrc: mutex unlock failed (%d)\\n\", err); exit(1); }\n"
            + "    if (m->release) m->release(*(void**)old, m->context);\n"
            + "    free(old);\n"
            + "}";
    }
    if (name == "__btrc_mutex_val_destroy") {
        return "static void __btrc_mutex_val_destroy(__btrc_mutex_val_t* m) {\n"
            + "    if (!m) return;\n"
            + "    int err = pthread_mutex_lock(&m->lock);\n"
            + "    if (err != 0) { fprintf(stderr, \"btrc: mutex lock failed (%d)\\n\", err); exit(1); }\n"
            + "    void* old = m->value;\n"
            + "    m->value = NULL;\n"
            + "    err = pthread_mutex_unlock(&m->lock);\n"
            + "    if (err != 0) { fprintf(stderr, \"btrc: mutex unlock failed (%d)\\n\", err); exit(1); }\n"
            + "    err = pthread_mutex_destroy(&m->lock);\n"
            + "    if (err != 0) { fprintf(stderr, \"btrc: mutex destroy failed (%d)\\n\", err); exit(1); }\n"
            + "    if (m->release) m->release(*(void**)old, m->context);\n"
            + "    free(old);\n"
            + "    free(m->context);\n"
            + "    free(m);\n"
            + "}";
    }
    return "";
}

/* Transitive helper dependencies (mirrors HelperDef.depends_on). Returns the
 * list of helpers `name` requires to be emitted first. */
Vector<string> helperDeps(string name) {
    if (cycleRuntimeHasHelper(name)) {
        return cycleRuntimeHelperDependencies(name);
    }
    if (stringOwnershipRuntimeHasHelper(name)) {
        return stringOwnershipRuntimeHelperDependencies(name);
    }
    Vector<string> out = [];
    if (name == "__btrc_parseInt") { out.push("__btrc_parseLong"); }
    else if (name == "__btrc_string_alloc") { out.push("__btrc_safe_realloc"); }
    else if (name == "__btrc_str_track") {
        out.push("__btrc_str_pool_globals");
        out.push("__btrc_safe_realloc");
    }
    else if (name == "__btrc_str_flush") { out.push("__btrc_str_pool_globals"); }
    else if (name == "__btrc_substring" || name == "__btrc_reverse"
            || name == "__btrc_padLeft" || name == "__btrc_padRight"
            || name == "__btrc_center" || name == "__btrc_zfill"
            || name == "__btrc_join") {
        out.push("__btrc_string_length");
        out.push("__btrc_string_alloc");
    }
    else if (name == "__btrc_trim" || name == "__btrc_lstrip"
            || name == "__btrc_rstrip") {
        out.push("__btrc_string_length");
        out.push("__btrc_string_alloc");
        out.push("__btrc_ascii_space");
    }
    else if (name == "__btrc_toUpper") {
        out.push("__btrc_string_length");
        out.push("__btrc_string_alloc");
        out.push("__btrc_ascii_upper");
    }
    else if (name == "__btrc_toLower") {
        out.push("__btrc_string_length");
        out.push("__btrc_string_alloc");
        out.push("__btrc_ascii_lower");
    }
    else if (name == "__btrc_strcat" || name == "__btrc_replace"
            || name == "__btrc_removePrefix" || name == "__btrc_removeSuffix") {
        out.push("__btrc_string_length");
        out.push("__btrc_string_alloc");
        out.push("__btrc_strdup");
    }
    else if (name == "__btrc_split" || name == "__btrc_repeat") {
        out.push("__btrc_safe_realloc");
        out.push("__btrc_string_length");
        out.push("__btrc_string_alloc");
    }
    else if (name == "__btrc_capitalize" || name == "__btrc_swapCase") {
        out.push("__btrc_string_length");
        out.push("__btrc_string_alloc");
        out.push("__btrc_ascii_lower");
        out.push("__btrc_ascii_upper");
    }
    else if (name == "__btrc_title") {
        out.push("__btrc_string_length");
        out.push("__btrc_string_alloc");
        out.push("__btrc_ascii_lower");
        out.push("__btrc_ascii_space");
        out.push("__btrc_ascii_upper");
    }
    else if (name == "__btrc_charAt" || name == "__btrc_indexOf"
            || name == "__btrc_lastIndexOf" || name == "__btrc_startsWith"
            || name == "__btrc_endsWith" || name == "__btrc_strContains"
            || name == "__btrc_count" || name == "__btrc_find"
            || name == "__btrc_utf8_charlen") {
        out.push("__btrc_string_length");
    }
    else if (name == "__btrc_isBlank" || name == "__btrc_isUpper"
            || name == "__btrc_isLower") {
        out.push("__btrc_ascii_space");
    }
    else if (name == "__btrc_charLen") { out.push("__btrc_utf8_charlen"); }
    else if (name == "__btrc_intToString" || name == "__btrc_longToString"
            || name == "__btrc_longLongToString" || name == "__btrc_uintToString"
            || name == "__btrc_ulongToString" || name == "__btrc_ulongLongToString"
            || name == "__btrc_floatToString" || name == "__btrc_doubleToString"
            || name == "__btrc_longDoubleToString" || name == "__btrc_charToString"
            || name == "__btrc_fromInt" || name == "__btrc_fromFloat") {
        out.push("__btrc_string_alloc");
    }
    /* math category dependency edges (mirrors math.py depends_on). */
    else if (name == "__btrc_math_lcm") { out.push("__btrc_math_gcd"); }
    /* trycatch category dependency edges (mirrors trycatch.py depends_on). */
    else if (name == "__btrc_trycatch_globals") {
        out.push("__btrc_try_level");
    }
    else if (name == "__btrc_push_try") {
        out.push("__btrc_trycatch_globals");
        out.push("__btrc_try_capacity");
        out.push("__btrc_safe_realloc");
    }
    else if (name == "__btrc_cleanup_types") {
        out.push("__btrc_try_level");
        out.push("__btrc_arc_callback_types");
    }
    else if (name == "__btrc_register_cleanup_kind") {
        out.push("__btrc_cleanup_types");
        out.push("__btrc_cleanup_capacity");
        out.push("__btrc_safe_realloc");
    }
    else if (name == "__btrc_register_cleanup") {
        out.push("__btrc_register_cleanup_kind");
    }
    else if (name == "__btrc_register_direct_cleanup") {
        out.push("__btrc_register_cleanup_kind");
    }
    else if (name == "__btrc_run_cleanup_guarded") {
        out.push("__btrc_cleanup_types");
        out.push("__btrc_push_try");
        out.push("__btrc_arc_release");
        out.push("__btrc_arc_release_acyclic");
    }
    else if (name == "__btrc_flush_cycles_guarded") {
        out.push("__btrc_push_try");
        out.push("__btrc_flush_cycles");
    }
    else if (name == "__btrc_run_cleanups") {
        out.push("__btrc_cleanup_types");
        out.push("__btrc_safe_realloc");
        out.push("__btrc_destroyed_tracking_scope");
        out.push("__btrc_is_destroyed");
        out.push("__btrc_run_cleanup_guarded");
        out.push("__btrc_flush_cycles_guarded");
    }
    else if (name == "__btrc_discard_cleanups"
            || name == "__btrc_cleanup_mark"
            || name == "__btrc_discard_cleanups_to") {
        out.push("__btrc_cleanup_types");
    }
    else if (name == "__btrc_throw") {
        out.push("__btrc_trycatch_globals");
        out.push("__btrc_run_cleanups");
    }
    else if (name == "__btrc_try_state_cleanup") {
        out.push("__btrc_trycatch_globals");
        out.push("__btrc_try_capacity");
        out.push("__btrc_cleanup_types");
        out.push("__btrc_cleanup_capacity");
        out.push("__btrc_launder_state");
    }
    /* threads dependency edges (mirrors helpers/threads.py depends_on): the
     * join/free/mutex-accessor helpers reference the typedef + globals declared
     * by their spawn/create root helper. */
    else if (name == "__btrc_thread_spawn") {
        out.push("__btrc_safe_realloc");
        out.push("__btrc_try_state_cleanup");
    }
    else if (name == "__btrc_thread_finish") {
        out.push("__btrc_thread_spawn");
    }
    else if (name == "__btrc_thread_destroy_handle") {
        out.push("__btrc_thread_spawn");
    }
    else if (name == "__btrc_thread_box_dispose") {
        out.push("__btrc_thread_spawn");
    }
    else if (name == "__btrc_thread_arc_dispose") {
        out.push("__btrc_thread_spawn");
        out.push("__btrc_arc_release");
        out.push("__btrc_poll_cycles");
    }
    else if (name == "__btrc_thread_string_dispose") {
        out.push("__btrc_thread_spawn");
        out.push("__btrc_string_release");
    }
    else if (name == "__btrc_thread_join") {
        out.push("__btrc_thread_finish");
        out.push("__btrc_thread_destroy_handle");
    }
    else if (name == "__btrc_thread_free") {
        out.push("__btrc_thread_finish");
        out.push("__btrc_thread_destroy_handle");
    }
    else if (name == "__btrc_mutex_val_create") {
        out.push("__btrc_safe_realloc");
    }
    else if (name == "__btrc_mutex_arc_retain") {
        out.push("__btrc_mutex_val_create");
        out.push("__btrc_arc_retain");
    }
    else if (name == "__btrc_mutex_arc_release") {
        out.push("__btrc_mutex_val_create");
        out.push("__btrc_arc_release");
        out.push("__btrc_poll_cycles");
    }
    else if (name == "__btrc_mutex_string_retain") {
        out.push("__btrc_mutex_val_create");
        out.push("__btrc_string_retain");
    }
    else if (name == "__btrc_mutex_string_release") {
        out.push("__btrc_mutex_val_create");
        out.push("__btrc_string_release");
    }
    else if (name == "__btrc_mutex_val_get") { out.push("__btrc_mutex_val_create"); }
    else if (name == "__btrc_mutex_val_set"
            || name == "__btrc_mutex_val_destroy") {
        out.push("__btrc_mutex_val_create");
    }
    return out;
}

/* Hosted C headers owned by a concrete runtime helper. Dependency closure is
 * resolved before this metadata is collected, so transitive consumers inherit
 * the headers of the helpers they keep. Mirrors HelperDef.required_headers. */
Vector<string> helperHeaders(string name) {
    if (stringOwnershipRuntimeHasHelper(name)) {
        return stringOwnershipRuntimeHelperHeaders(name);
    }
    Vector<string> out = [];
    if (name == "__btrc_arc_lock_state"
            || name == "__btrc_arc_snapshot_state"
            || name == "__btrc_destroyed_tracking") {
        out.push("stdatomic.h");
    }
    else if (name == "__btrc_arc_topology_begin") {
        out.push("limits.h");
        out.push("stdio.h");
        out.push("stdlib.h");
    }
    else if (name == "__btrc_arc_topology_leave") {
        out.push("stdio.h");
        out.push("stdlib.h");
    }
    else if (name == "__btrc_trycatch_globals") { out.push("setjmp.h"); }
    else if (name == "__btrc_thread_spawn"
            || name == "__btrc_mutex_val_create") {
        out.push("pthread.h");
        out.push("string.h");
    }
    return out;
}

/* Canonical emission order of concrete runtime helpers (mirrors registry.py
 * aggregation order). The emitter walks this list and emits helpers marked used
 * after dependency closure (DCE). */
Vector<string> canonicalHelperOrder() {
    Vector<string> order = [];
    /* alloc */
    order.push("__btrc_strdup");
    order.push("__btrc_safe_realloc");
    order.push("__btrc_safe_calloc");
    /* divmod */
    order.push("__btrc_div");
    order.push("__btrc_mod");
    order.push("__btrc_div_int");
    order.push("__btrc_div_double");
    order.push("__btrc_mod_int");
    /* string ownership + compatibility spellings */
    appendStringOwnershipRuntimeHelperOrder(order);
    /* string — STRING_COMMON */
    order.push("__btrc_string_length");
    order.push("__btrc_string_alloc");
    order.push("__btrc_ascii_upper");
    order.push("__btrc_ascii_lower");
    order.push("__btrc_ascii_space");
    /* string — STRING_OPS (insertion order in strings_ops.py) */
    order.push("__btrc_substring");
    order.push("__btrc_trim");
    order.push("__btrc_toUpper");
    order.push("__btrc_toLower");
    order.push("__btrc_replace");
    order.push("__btrc_split");
    order.push("__btrc_repeat");
    order.push("__btrc_reverse");
    order.push("__btrc_removePrefix");
    order.push("__btrc_removeSuffix");
    order.push("__btrc_capitalize");
    order.push("__btrc_title");
    order.push("__btrc_swapCase");
    order.push("__btrc_padLeft");
    order.push("__btrc_padRight");
    order.push("__btrc_center");
    order.push("__btrc_lstrip");
    order.push("__btrc_rstrip");
    order.push("__btrc_zfill");
    order.push("__btrc_strcat");
    order.push("__btrc_join");
    /* string — STRING_QUERY (insertion order in strings_query.py) */
    order.push("__btrc_charAt");
    order.push("__btrc_indexOf");
    order.push("__btrc_lastIndexOf");
    order.push("__btrc_isEmpty");
    order.push("__btrc_startsWith");
    order.push("__btrc_endsWith");
    order.push("__btrc_strContains");
    order.push("__btrc_count");
    order.push("__btrc_find");
    order.push("__btrc_isDigitStr");
    order.push("__btrc_isAlphaStr");
    order.push("__btrc_isBlank");
    order.push("__btrc_isUpper");
    order.push("__btrc_isLower");
    order.push("__btrc_isAlnumStr");
    order.push("__btrc_utf8_charlen");
    order.push("__btrc_charLen");
    /* string — STRING_CONVERT (insertion order in strings_convert.py) */
    order.push("__btrc_parseLong");
    order.push("__btrc_parseInt");
    order.push("__btrc_parseBool");
    order.push("__btrc_intToString");
    order.push("__btrc_longToString");
    order.push("__btrc_longLongToString");
    order.push("__btrc_uintToString");
    order.push("__btrc_ulongToString");
    order.push("__btrc_ulongLongToString");
    order.push("__btrc_floatToString");
    order.push("__btrc_doubleToString");
    order.push("__btrc_longDoubleToString");
    order.push("__btrc_charToString");
    order.push("__btrc_fromInt");
    order.push("__btrc_fromFloat");
    /* math */
    order.push("__btrc_math_factorial");
    order.push("__btrc_math_gcd");
    order.push("__btrc_math_lcm");
    order.push("__btrc_math_fibonacci");
    order.push("__btrc_math_isPrime");
    order.push("__btrc_math_sum_int");
    order.push("__btrc_math_fsum");
    /* trycatch (registry.py category order: after string/math, before hash) */
    order.push("__btrc_try_level");
    order.push("__btrc_trycatch_globals");
    order.push("__btrc_try_capacity");
    order.push("__btrc_cleanup_capacity");
    order.push("__btrc_launder_state");
    order.push("__btrc_launder");
    order.push("__btrc_push_try");
    /* hash */
    order.push("__btrc_hash_real");
    order.push("__btrc_hash_str");
    /* cycles (ARC cycle detection; roots first so their globals/typedefs
     * precede the dependent collector). Mirrors registry.py cycles category. */
    order.push("__btrc_arc_callback_types");
    order.push("__btrc_arc_header_of");
    order.push("__btrc_arc_type_of");
    order.push("__btrc_arc_validate");
    order.push("__btrc_arc_lock_state");
    order.push("__btrc_arc_snapshot_state");
    order.push("__btrc_arc_mutation_lock");
    order.push("__btrc_arc_topology_state");
    order.push("__btrc_arc_topology_depth_state");
    order.push("__btrc_arc_topology_begin");
    order.push("__btrc_arc_topology_leave");
    order.push("__btrc_arc_topology_cleanup");
    order.push("__btrc_arc_deferred_state");
    order.push("__btrc_destroyed_tracking");
    order.push("__btrc_destroyed_tracking_scope");
    order.push("__btrc_is_destroyed");
    order.push("__btrc_destroyed_capacity");
