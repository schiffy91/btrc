/* Stage 0 — EBNF grammar parser.
 *
 * Faithful port of src/compiler/python/ebnf.py. Extracts the keyword set,
 * operator list (sorted longest-first for trie matching), and the
 * keyword/operator/annotation -> token-name maps from src/language/grammar.ebnf.
 * No regex (the Python version's re uses are replaced by manual scanning).
 */

class GrammarInfo {
    public Map<string, string> keywordToToken;   // "int"  -> "INT"
    public Vector<string> operators;             // sorted longest-first
    public Map<string, string> opToToken;        // "+"    -> "PLUS"
    public Map<string, string> annotationToToken; // "gpu" -> "AT_GPU"

    public GrammarInfo() {
        self.keywordToToken = {};
        self.operators = [];
        self.opToToken = {};
        self.annotationToToken = {};
    }
}

/* Operator character -> TokenType-name fragment (Python _CHAR_NAMES). */
string charName(char c) {
    if (c == '+') { return "PLUS"; }
    if (c == '-') { return "MINUS"; }
    if (c == '*') { return "STAR"; }
    if (c == '/') { return "SLASH"; }
    if (c == '%') { return "PERCENT"; }
    if (c == '=') { return "EQ"; }
    if (c == '<') { return "LT"; }
    if (c == '>') { return "GT"; }
    if (c == '!') { return "BANG"; }
    if (c == '&') { return "AMP"; }
    if (c == '|') { return "PIPE"; }
    if (c == '^') { return "CARET"; }
    if (c == '~') { return "TILDE"; }
    if (c == '?') { return "QUESTION"; }
    if (c == '.') { return "DOT"; }
    if (c == ',') { return "COMMA"; }
    if (c == ';') { return "SEMICOLON"; }
    if (c == ':') { return "COLON"; }
    if (c == '(') { return "LPAREN"; }
    if (c == ')') { return "RPAREN"; }
    if (c == '[') { return "LBRACKET"; }
    if (c == ']') { return "RBRACKET"; }
    if (c == '{') { return "LBRACE"; }
    if (c == '}') { return "RBRACE"; }
    return "UNKNOWN";
}

/* Operator string -> TokenType name (Python _op_to_token_name). */
string opToTokenName(string op) {
    if (op == "->") { return "ARROW"; }
    if (op == "=>") { return "FAT_ARROW"; }
    string out = "";
    int i = 0;
    int n = op.length();
    while (i < n) {
        if (i > 0) { out = out + "_"; }
        out = out + charName(op[i]);
        i = i + 1;
    }
    return out;
}

/* Extract the body of `@marker { ... }`, honoring nested braces and skipping
 * line/block comments, regex literals, and quoted strings (Python
 * _extract_brace_block). Returns "" if not found. */
string extractBraceBlock(string text, string marker) {
    int mpos = text.indexOf(marker);
    if (mpos < 0) { return ""; }
    int n = text.length();
    int i = mpos + marker.length();
    while (i < n && text[i] != '{') { i = i + 1; }
    if (i >= n) { return ""; }
    int bodyStart = i + 1;
    int depth = 1;
    i = bodyStart;
    while (i < n && depth > 0) {
        char c = text[i];
        if (c == '-' && i + 1 < n && text[i + 1] == '-') {
            while (i < n && text[i] != '\n') { i = i + 1; }
        } else if (c == '(' && i + 1 < n && text[i + 1] == '*') {
            i = i + 2;
            while (i + 1 < n && !(text[i] == '*' && text[i + 1] == ')')) { i = i + 1; }
            i = i + 2;
        } else if (c == '/' && i + 1 < n && text[i + 1] != '/') {
            i = i + 1;
            while (i < n && text[i] != '/') {
                if (text[i] == '\\') { i = i + 1; }
                i = i + 1;
            }
            i = i + 1;
        } else if (c == '"') {
            i = i + 1;
            while (i < n && text[i] != '"') {
                if (text[i] == '\\') { i = i + 1; }
                i = i + 1;
            }
            i = i + 1;
        } else if (c == '{') {
            depth = depth + 1;
            i = i + 1;
        } else if (c == '}') {
            depth = depth - 1;
            if (depth == 0) { return text.substring(bodyStart, i - bodyStart); }
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    return "";
}

/* Identifier words in a block, skipping `--` line comments. */
Vector<string> extractWords(string body) {
    Vector<string> words = [];
    int i = 0;
    int n = body.length();
    while (i < n) {
        char c = body[i];
        if (c == '-' && i + 1 < n && body[i + 1] == '-') {
            while (i < n && body[i] != '\n') { i = i + 1; }
        } else if (Strings.isAlpha(c) || c == '_') {
            int start = i;
            while (i < n && (Strings.isAlnum(body[i]) || body[i] == '_')) { i = i + 1; }
            words.push(body.substring(start, i - start));
        } else {
            i = i + 1;
        }
    }
    return words;
}

/* Quoted-string contents in a block, skipping `--` line comments. */
Vector<string> extractQuoted(string body) {
    Vector<string> out = [];
    int i = 0;
    int n = body.length();
    while (i < n) {
        char c = body[i];
        if (c == '-' && i + 1 < n && body[i + 1] == '-') {
            while (i < n && body[i] != '\n') { i = i + 1; }
        } else if (c == '"') {
            int start = i + 1;
            i = i + 1;
            while (i < n && body[i] != '"') { i = i + 1; }
            out.push(body.substring(start, i - start));
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    return out;
}

GrammarInfo parseGrammar(string text) {
    GrammarInfo info = GrammarInfo();
    string lexical = extractBraceBlock(text, "@lexical");

    string kwBody = extractBraceBlock(lexical, "@keywords");
    Vector<string> kws = extractWords(kwBody);
    int i = 0;
    while (i < kws.len) {
        string kw = kws.get(i);
        info.keywordToToken.put(kw, kw.toUpper());
        i = i + 1;
    }

    string opBody = extractBraceBlock(lexical, "@operators");
    Vector<string> ops = extractQuoted(opBody);
    // longest-first so the trie prefers the longest match; intra-length order
    // is irrelevant to the trie and the token output.
    ops.sortBy((string a, string b) => a.length() > b.length());
    i = 0;
    while (i < ops.len) {
        string op = ops.get(i);
        info.operators.push(op);
        info.opToToken.put(op, opToTokenName(op));
        i = i + 1;
    }

    string annBody = extractBraceBlock(lexical, "@annotations");
    Vector<string> anns = extractWords(annBody);
    i = 0;
    while (i < anns.len) {
        string a = anns.get(i);
        info.annotationToToken.put(a, "AT_" + a.toUpper());
        i = i + 1;
    }
    return info;
}
