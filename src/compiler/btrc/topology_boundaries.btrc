/* Snapshot exclusion for multi-store generic collection shape mutations. */

Vector<IRNode> irTopologyEpilogue(string token, string marker) {
    Vector<IRNode> output = [];
    Vector<IRNode> completeArguments = [];
    completeArguments.push(irCast(
        "void* volatile*", irAddressOf(irVar(token))));
    output.push(irExprStmt(irCall(
        "__btrc_arc_topology_complete", completeArguments)));
    if (marker != "") {
        Vector<IRNode> discardArguments = [];
        discardArguments.push(irVar(marker));
        output.push(irExprStmt(irCall(
            "__btrc_discard_cleanups_to", discardArguments)));
    }
    return output;
}

void appendIrTopologyEpilogue(
        Vector<IRNode> output, string token, string marker) {
    Vector<IRNode> epilogue = irTopologyEpilogue(token, marker);
    int index = 0;
    while (index < epilogue.len) {
        output.push(epilogue.get(index));
        index = index + 1;
    }
}

void rewriteNestedTopologyReturns(IRGen generator, IRFunction definition,
        IRNode node, string token, string marker) {
    if (node.kind == IRK_BLOCK) {
        rewriteTopologyReturns(generator, definition, node, token, marker);
    } else if (node.kind == IRK_IF) {
        rewriteTopologyReturns(
            generator, definition, node.then_block, token, marker);
        if (node.else_block != null) {
            rewriteTopologyReturns(
                generator, definition, node.else_block, token, marker);
        }
    } else if (node.kind == IRK_WHILE || node.kind == IRK_DO_WHILE
            || node.kind == IRK_FOR) {
        rewriteTopologyReturns(
            generator, definition, node.body, token, marker);
    } else if (node.kind == IRK_SWITCH) {
        int index = 0;
        while (index < node.args.len) {
            rewriteTopologyReturns(generator, definition,
                node.args.get(index), token, marker);
            index = index + 1;
        }
    } else if (node.kind == IRK_CASE) {
        rewriteTopologyReturns(generator, definition, node, token, marker);
    }
}

void rewriteTopologyReturns(IRGen generator, IRFunction definition,
        IRNode block, string token, string marker) {
    Vector<IRNode> rewritten = [];
    int index = 0;
    while (index < block.stmts.len) {
        IRNode statement = block.stmts.get(index);
        rewriteNestedTopologyReturns(
            generator, definition, statement, token, marker);
        if (statement.kind == IRK_RETURN) {
            if (statement.value != null) {
                string result = generator.freshTemp(
                    "__btrc_topology_return");
                rewritten.push(irVarDecl(
                    definition.return_type, result, statement.value));
                statement.value = irVar(result);
            }
            appendIrTopologyEpilogue(rewritten, token, marker);
        }
        rewritten.push(statement);
        index = index + 1;
    }
    block.stmts = rewritten;
}

Vector<IRNode> irTopologyPrologue(
        IRGen generator, string token, string marker,
        bool cleanupEnabled) {
    Vector<IRNode> output = [];
    if (cleanupEnabled) {
        Vector<IRNode> markArguments = [];
        output.push(irVarDecl("int", marker,
            irCall("__btrc_cleanup_mark", markArguments)));
    }
    Vector<IRNode> beginArguments = [];
    IRNode tokenDeclaration = irVarDecl("void*", token,
        irCall("__btrc_arc_topology_begin", beginArguments));
    output.push(tokenDeclaration);
    if (cleanupEnabled) {
        output.push(irExprStmt(registerCleanupSlot(generator,
            tokenDeclaration,
            irFunctionRef("__btrc_arc_topology_cleanup"),
            null, true)));
    }
    return output;
}

bool installCollectionTopologyBoundary(
        IRGen generator, IRFunction definition) {
    if (definition.body == null
            || !irContainsSelfTopologyMutation(definition.body)) {
        return false;
    }
    string token = generator.freshTemp("__btrc_topology_scope");
    bool cleanupEnabled = generator.programHasExceptions;
    string marker = "";
    if (cleanupEnabled) {
        marker = generator.freshTemp("__btrc_topology_cleanup");
    }
    generator.useHelper("__btrc_arc_topology_begin");
    generator.useHelper("__btrc_arc_topology_complete");
    if (cleanupEnabled) {
        generator.useHelper("__btrc_cleanup_mark");
        generator.useHelper("__btrc_register_direct_cleanup");
        generator.useHelper("__btrc_arc_topology_cleanup");
        generator.useHelper("__btrc_discard_cleanups_to");
    }

    rewriteTopologyReturns(
        generator, definition, definition.body, token, marker);
    if (irSequenceMayFallThrough(definition.body.stmts)) {
        appendIrTopologyEpilogue(definition.body.stmts, token, marker);
    }
    Vector<IRNode> body = irTopologyPrologue(
        generator, token, marker, cleanupEnabled);
    int index = 0;
    while (index < definition.body.stmts.len) {
        body.push(definition.body.stmts.get(index));
        index = index + 1;
    }
    definition.body.stmts = body;
    return true;
}
