/* Collision checks for the ordinary C identifier namespace after lowering. */

void semanticClaimSymbol(Map<string, string> symbols, string symbol,
        string owner, Node site) {
    if (symbol == "") { return; }
    if (symbols.has(symbol) && symbols.get(symbol) != owner) {
        semanticValidationFail("Emitted C symbol '" + symbol
            + "' collides between " + symbols.get(symbol)
            + " and " + owner, site);
    }
    symbols.put(symbol, owner);
}

void semanticClaimGeneratedSymbol(SemanticValidationState state,
        Map<string, string> symbols, string symbol,
        string owner, Node site) {
    if (hostedAbiOwnedName(symbol)) {
        semanticValidationFail("Emitted C symbol '" + symbol + "' for "
            + owner + " collides with compiler-owned hosted C symbol", site);
    }
    semanticClaimSymbol(symbols, symbol, owner, site);
    state.generatedSymbols.put(symbol, owner);
}

void semanticClaimTopLevelSymbol(
        Node declaration, Map<string, string> symbols) {
    if (!semanticNamedTopLevel(declaration)) { return; }
    string name = semanticTopLevelName(declaration);
    string owner = "top-level declaration '" + name + "'";
    semanticClaimSymbol(symbols, name, owner, declaration);
}

void semanticValidateEmittedSymbols(
        Node program, SemanticValidationState state) {
    Map<string, string> symbols = {};
    semanticClaimSourceMacroSymbols(program, symbols);
    int index = 0;
    while (index < program.declarations.len) {
        semanticClaimTopLevelSymbol(program.declarations.get(index), symbols);
        index = index + 1;
    }
    index = 0;
    while (index < program.declarations.len) {
        Node declaration = program.declarations.get(index);
        if (declaration.kind == NK_FUNCTION_DECL && declaration.is_gpu) {
            semanticClaimGpuSymbols(state, symbols, declaration);
        } else if (declaration.kind == NK_CLASS_DECL
                && declaration.generic_params.len == 0) {
            semanticClaimClassSymbols(declaration, state, symbols);
        } else if (declaration.kind == NK_ENUM_DECL) {
            semanticClaimEnumSymbols(declaration, state, symbols);
        } else if (declaration.kind == NK_RICH_ENUM_DECL) {
            semanticClaimRichEnumSymbols(declaration, state, symbols);
        }
        index = index + 1;
    }
    semanticClaimGenericInstanceSymbols(state, symbols);
    semanticClaimGenericMethodSymbols(state, symbols);
    semanticValidatePreprocessorSymbolReferences(program, state);
}
