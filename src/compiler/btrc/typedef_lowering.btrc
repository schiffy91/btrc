/* Dependency-ordered typedef lowering.
 *
 * Semantic registration intentionally permits aliases to reference a later
 * alias. C does not, so order the typed IR declarations before emission. */

void lowerTypedefVisit(string alias, Map<string, Node> declarations,
        Map<string, int> states, Vector<Node> ordered);

void lowerTypedefTypeDependencies(Node? typeExpr,
        Map<string, Node> declarations, Map<string, int> states,
        Vector<Node> ordered) {
    if (typeExpr == null) { return; }
    if (typeExpr.generic_args.len == 0
            && declarations.has(typeExpr.base)) {
        lowerTypedefVisit(typeExpr.base, declarations, states, ordered);
    }
    int index = 0;
    while (index < typeExpr.generic_args.len) {
        lowerTypedefTypeDependencies(typeExpr.generic_args.get(index),
            declarations, states, ordered);
        index = index + 1;
    }
}

void lowerTypedefVisit(string alias, Map<string, Node> declarations,
        Map<string, int> states, Vector<Node> ordered) {
    if (states.has(alias) && states.get(alias) == 2) { return; }
    if (states.has(alias) && states.get(alias) == 1) {
        fprintf(stderr, "error: Cyclic typedef involving '%s'\n", alias);
        exit(1);
    }
    states.put(alias, 1);
    Node declaration = declarations.get(alias);
    lowerTypedefTypeDependencies(
        declaration.original, declarations, states, ordered);
    states.put(alias, 2);
    ordered.push(declaration);
}

void lowerTypedefDeclarations(
        Node program, IRModule module, Analyzed analyzed) {
    Map<string, Node> declarations = {};
    Vector<string> sourceOrder = [];
    int index = 0;
    while (index < program.declarations.len) {
        Node declaration = program.declarations.get(index);
        if (declaration.kind == NK_TYPEDEF_DECL) {
            declarations.put(declaration.alias, declaration);
            sourceOrder.push(declaration.alias);
        }
        index = index + 1;
    }
    Map<string, int> states = {};
    Vector<Node> ordered = [];
    index = 0;
    while (index < sourceOrder.len) {
        lowerTypedefVisit(
            sourceOrder.get(index), declarations, states, ordered);
        index = index + 1;
    }
    index = 0;
    while (index < ordered.len) {
        Node declaration = ordered.get(index);
        module.typedef_defs.push(IRTypedefDef(
            typeToC(declaration.original, analyzed), declaration.alias));
        index = index + 1;
    }
}
