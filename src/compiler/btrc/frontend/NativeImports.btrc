/* Checked SDK projections and managed C/Objective-C imports. Unknown ownership
 * and unsupported native shapes fail before structured adapter lowering. */

import Library.Bytes;
import Library.JSON;
import Library.Digest.SHA256;
import Library.FileSystem;
import Library.Map;
import Library.Platform;
import Library.Result;
import Library.Strings;
import Library.Vector;

import ../generated/hosted_abi/Tables.btrc;
import ../generated/native_abi/Models.btrc;
import ../generated/ast/Node.btrc;
import ../syntax/Grammar.btrc;
import ../syntax/Literals.btrc;
import ../syntax/Identity.btrc;
import ./Models.btrc;
import ./Packages.btrc;
import ./SourceIo.btrc;
import ./Timing.btrc;

/* Validate one target row's native sysroot from files alone. The process that
 * starts a compile resolves the path; a compiler never runs a toolchain to
 * discover it. The identity digests the file that names the SDK's version, so
 * a different SDK at the same path is a different import. */
class FeNativeSysroot {
	private GeneratedTargetRow row;
	private string path;

	public FeNativeSysroot(GeneratedTargetRow row, string path) {
		self.row = row;
		self.path = path;
	}

	private void fail(string reason) { throw "native imports require a valid " + self.row.sysrootKind + " sysroot for " + self.row.label + ": " + reason; }

	private string read(string relative) {
		string file = PathTools.join(self.path, relative);
		if (!FileSystem.isFile(file)) { self.fail(relative + " is missing"); }
		return FeSourceFileReader().readRequired(file);
	}

	/* Dotted decimal components, or an empty vector when one is not a number. */
	private Vector<int> version(string text) {
		Vector<int> components = [];
		for part in Strings.split(text, ".") {
			if (part.isEmpty()) { return []; }
			for index in range(part.length()) { if (!Strings.isDigit(part[index])) { return []; } }
			components.push(Strings.toInt(part));
		}
		return components;
	}

	private bool older(Vector<int> found, Vector<int> minimum) {
		for index in range(found.len < minimum.len ? found.len : minimum.len) {
			if (found.get(index) != minimum.get(index)) { return found.get(index) < minimum.get(index); }
		}
		return found.len < minimum.len;
	}

	/* The sysroot's 64-hex identity, or an error naming what is wrong. */
	public string validate() {
		if (!FileSystem.isDir(self.path)) { throw "native imports require an explicit available BTRC_NATIVE_SYSROOT"; }
		string kind = self.row.sysrootKind;
		if (kind == "none") { return ""; }
		string identityFile = "";
		string content = "";
		if (kind == "xcrun") {
			identityFile = "SDKSettings.json";
			content = self.read(identityFile);
			JSONValue settings = JSONValue.parse(content);
			if (settings.isError() || !settings.isObject()) { self.fail(identityFile + " is not JSON"); }
			JSONValue canonical = settings.get("CanonicalName");
			if (!canonical.isString() || !canonical.asString().startsWith(self.row.sysrootName)) { self.fail("its CanonicalName is not a " + self.row.sysrootName + " SDK"); }
			JSONValue version = settings.get("Version");
			Vector<int> found = version.isString() ? self.version(version.asString()) : [];
			Vector<int> minimum = self.version(self.row.minimumVersion);
			if (found.len == 0 || minimum.len == 0 || self.older(found, minimum)) { self.fail("its Version is older than " + self.row.minimumVersion); }
		} else if (kind == "ndk") {
			identityFile = "usr/include/android/api-level.h";
			content = self.read(identityFile);
			string library = PathTools.join(self.path, "usr/lib/" + self.row.architecture + "-linux-android/" + self.row.minimumVersion);
			if (!FileSystem.isDir(library)) { self.fail("usr/lib/" + self.row.architecture + "-linux-android/" + self.row.minimumVersion + " is missing"); }
		} else if (kind == "zig-mingw") {
			self.read("include/any-windows-any/windows.h");
			identityFile = "include/any-windows-any/_mingw_mac.h";
			content = self.read(identityFile);
		} else {
			self.fail("this sysroot kind is validated only on its runner");
		}
		/* SHA-256 over kind NUL identity-file NUL bytes, as the reference
		 * NativeSysroot computes it, so both compilers' link plans and the
		 * plan builder agree on one identity. */
		Bytes separator = Bytes();
		separator.append(0);
		SHA256 identity = SHA256();
		identity.appendText(kind);
		identity.appendBytes(separator);
		identity.appendText(identityFile);
		identity.appendBytes(separator);
		identity.appendText(content);
		return identity.finish();
	}
}

class FeNativeDeclarationImporter {
	private GrammarInfo grammar;
	private SHA256 resolvedIdentity = SHA256();
	private FeSourceFileReader sourceFiles;
	private bool cacheable = true;

	/* Only consumed after resolve succeeds, so unchecked reader responses can
	 * never authorize reuse. Binding policy is covered by source-file identity. */
	public string cacheIdentity() { return self.cacheable ? self.resolvedIdentity.finish() : ""; }
	private Vector<FeNativeImportedDeclaration> declarations;
	private Map<string, string> typeIdentities;
	private string module;
	private string header;
	private string language;
	private Map<string, NativeNode> layouts;
	private Map<string, Node> records;
	private Map<string, bool> expandedRecords;
	private FeNativeHeaderReader headerReader;
	private Map<string, bool> borrows;
	private Map<string, bool> realtime;
	private Map<string, string> layoutIdentities;
	private Map<string, NativeNode> nativeInterfaces;
	private Map<string, string> interfaceNames;
	private Map<string, NativeNode> recordLayouts;
	private Vector<FeNativeImportedDeclaration> inputClasses;
	private bool requiresSelector = false;
	private Map<string, FeNativeResourceBinding> resources = {};
	private Map<string, Vector<string>> cxxToolchainIncludeCache = {};
	private Map<string, NativeNode> resourceTypes = {};
	private Map<string, string> resourceRecords = {};
	private Map<string, string> ownedOutputs = {};
	private Map<string, string> ownedOutputStatuses = {};
	private Map<string, string> statusResults = {};
	private Map<string, string> copiedOutputs = {};
	/* The binding's Objective-C NSError** outputs not yet consumed (F1). */
	private Map<string, bool> errorOutputs = {};
	/* Generated COM adapters count their claims and check their apartment
	 * through Library.COM's COM.h (native-interop-ownership.md section 2.4). */
	private bool comRuntime = false;
	/* A binding with COM interfaces never aggregates: no call may pass pUnkOuter. */
	private bool comBinding = false;
	/* Each COM interface's record, lpVtbl table layout and lpVtbl field, which
	 * COM sinks implement (projectComSinks). */
	private Map<string, NativeNode> comRecords = {};
	private Map<string, NativeNode> comTables = {};
	private Map<string, NativeNode> comFirsts = {};
	private Map<string, FeNativeInitializerBinding> initializers = {};
	private Map<string, FeNativeInitializerBinding> resourceInitializers = {};
	private Map<string, FeNativeCopiedInputBinding> copiedInputs = {};
	private Map<string, bool> attachedResources = {};
	private Map<string, FeNativeResourceOutputBinding> ownedOutputResources = {};
	private Map<string, FeNativeVariadicBinding> variadicCalls = {};
	private Map<string, FeNativeOutputOffsetBinding> outputOffsets = {};
	private Map<string, FeNativeCopiedResultBinding> copiedResults = {};
	private Map<string, bool> resourceOperations = {};
	private Map<string, bool> bindingOperations = {};
	private int pointerBits = 64;
	private Map<string, string> unmanagedHandles = {};
	private Map<string, string> unmanagedOwners = {};
	private Map<string, bool> ownedResults = {};
	private Map<string, string> borrowedResults = {};
	private Map<string, bool> resourceBorrows = {};
	private Map<string, FeNativeCallbackBinding> callbacks = {};
	private Map<string, bool> callbackOperations = {};
	private Map<string, NativeNode> callbackExports = {};
	private Map<string, bool> mainThreadGlobals = {};
	private Map<string, bool> staticGlobals = {};
	private Map<string, string> resourceParameters = {};
	private Map<string, string> resourceResults = {};
	private Map<string, bool> recordPrivateFields = {};
	private Map<string, FeNativeRecordInputField> recordResourceFields = {};
	private Map<string, FeNativeStringView> stringViews = {};
	private Map<string, bool> usedStringViews = {};

	public FeNativeDeclarationImporter(GrammarInfo grammar, FeNativeHeaderReader headerReader = (FeNativeHeaderReader)null, FeSourceFileReader? sourceFiles = null) {
		self.grammar = grammar;
		self.sourceFiles = sourceFiles == null ? FeSourceFileReader() : sourceFiles;
		self.nativeInterfaces = {};
		self.interfaceNames = {};
		self.recordLayouts = {};
		self.inputClasses = [];
		self.declarations = [];
		self.typeIdentities = {};
		self.module = "";
		self.header = "";
		self.language = "c";
		self.layouts = {};
		self.records = {};
		self.expandedRecords = {};
		self.headerReader = headerReader;
		self.borrows = {};
		self.realtime = {};
		self.layoutIdentities = {};
	}

	private void fail(string message) { throw f"{self.module}: native header: {message}"; }

	private Node node(int kind) {
		var result = Node();
		result.kind = kind;
		return result;
	}

	private string qualifierIdentity(NativeNode qualifiers) { return f"{qualifiers.isConst}:{qualifiers.isVolatile}:{qualifiers.isRestrict}:{qualifiers.nullability}"; }

	/* Compare native shapes, including private SDK layouts. Comparison does not
	 * imply that a type can be projected into a source-level BTRC value. */
	private string typeIdentity(NativeNode native) {
		/* Transparent typedef/spelling layers are not distinct C types. Keep
		 * qualifier changes and nominal pointer/record identities intact. */
		while ((native.kind == NNK_NATIVE_ALIAS || native.kind == NNK_NATIVE_QUALIFIED_TYPE) && self.qualifierIdentity(native.qualifiers).equals(self.qualifierIdentity(native.underlying.qualifiers))) { native = native.underlying; }
		string identity = f"{native.kind}:{self.qualifierIdentity(native.qualifiers)}:";
		if (native.kind == NNK_NATIVE_QUALIFIED_TYPE) { return identity + self.typeIdentity(native.underlying); }
		if (native.kind == NNK_NATIVE_BUILTIN) { return identity + f"{native.name}:{native.bits}:{native.alignmentBitsInt}:{native.signedness}"; }
		/* Opaque describes this use of the record, not a distinct C type. */
		if (native.kind == NNK_NATIVE_RECORD_TYPE) { return identity + native.identity + ":" + native.recordKind; }
		if (native.kind == NNK_NATIVE_OBJECTIVE_C_OBJECT) {
			identity = identity + f"{native.identity}:{native.name}:{native.classObject}";
			for protocol in native.protocols { identity = identity + ":" + protocol; }
			for argument in native.typeArguments { identity = identity + ":" + self.typeIdentity(argument); }
			return identity;
		}
		if (native.kind == NNK_NATIVE_FUNCTION_TYPE) {
			identity = identity + f"{native.variadic}:{native.callingConvention}:{self.typeIdentity(native.returnType)}";
			for parameter in native.parameters { identity = identity + ":" + self.typeIdentity(parameter); }
			return identity;
		}
		if (native.kind == NNK_NATIVE_POINTER) { return identity + self.typeIdentity(native.pointee); }
		if (native.kind == NNK_NATIVE_OBJECTIVE_C_BLOCK) { return identity + self.typeIdentity(native.signature); }
		if (native.kind == NNK_NATIVE_ALIAS) { return identity + native.name + ":" + self.typeIdentity(native.underlying); }
		if (native.kind == NNK_NATIVE_ARRAY_TYPE) { return identity + (native.count == null ? "<flexible>" : native.count) + ":" + self.typeIdentity(native.element); }
		if (native.kind == NNK_NATIVE_ENUM_TYPE) { return identity + native.identity + ":" + self.typeIdentity(native.underlying); }
		self.fail("unsupported native type identity");
		return "";
	}

	private void add(string name, Node declaration, string identity, string typeSpelling = "", bool readOnly = false, FeNativeCallContract? callContract = null, FeNativeResourceBinding? resource = null, bool valueOnly = false) {
		string key = self.module + "\x1f" + name;
		if (self.typeIdentities.has(key)) {
			if (identity.isEmpty() || !self.typeIdentities.get(key).equals(identity)) { self.fail(f"conflicting native declaration '{name}'"); }
			for previous in self.declarations {
				Node prior = previous.declaration;
				string priorName = prior.kind == NK_TYPEDEF_DECL ? prior.alias : prior.name;
				if (previous.module == self.module && priorName == name && !self.sameResource(previous.resource, resource)) { self.fail(f"conflicting native resource '{name}'"); }
				if (previous.module.equals(self.module) && priorName.equals(name) && (prior.kind != declaration.kind || !previous.typeSpelling.equals(typeSpelling) || previous.readOnly != readOnly || previous.valueOnly != valueOnly || !self.sameCallContract(previous.callContract, callContract))) { self.fail(f"conflicting native declaration '{name}'"); }
			}
			return;
		}
		declaration.sourceFile = self.module;
		self.typeIdentities.put(key, identity);
		var imported = FeNativeImportedDeclaration(declaration, self.module, self.header, typeSpelling, readOnly, callContract);
		imported.language = self.language;
		imported.resource = resource;
		imported.valueOnly = valueOnly;
		self.declarations.push(imported);
	}

	private bool sameResource(FeNativeResourceBinding? left, FeNativeResourceBinding? right) {
		if (left == null || right == null) { return left == right; }
		return left.identity() == right.identity();
	}

	private bool resourcePointerAccepts(NativeNode target, NativeNode source) {
		NativeNode targetPointer = self.unqualifiedNative(target);
		NativeNode sourcePointer = self.unqualifiedNative(source);
		if (targetPointer.kind != NNK_NATIVE_POINTER || sourcePointer.kind != NNK_NATIVE_POINTER) { return false; }
		NativeNode targetValue = self.unqualifiedNative(targetPointer.pointee);
		NativeNode sourceValue = self.unqualifiedNative(sourcePointer.pointee);
		if (self.nativeIsConst(sourcePointer.pointee) && !self.nativeIsConst(targetPointer.pointee)) { return false; }
		return (targetValue.kind == NNK_NATIVE_BUILTIN && targetValue.name == "void") || (targetValue.kind == NNK_NATIVE_RECORD_TYPE && sourceValue.kind == NNK_NATIVE_RECORD_TYPE && targetValue.identity == sourceValue.identity);
	}

	private bool nativeIsConst(NativeNode value) {
		while (true) {
			if (value.qualifiers.isConst) { return true; }
			if (value.kind != NNK_NATIVE_ALIAS && value.kind != NNK_NATIVE_QUALIFIED_TYPE) { return false; }
			value = value.underlying;
		}
		return false;
	}

	private void prepareRecordFields(FeNativeBinding binding) {
		self.recordPrivateFields = {};
		for name in binding.ownedRecords {
			if (!self.callbackExports.has(name)) { continue; }
			NativeNode declaration = self.callbackExports.get(name);
			if (declaration.kind != NNK_NATIVE_TYPEDEF && declaration.kind != NNK_NATIVE_RECORD_DECLARATION) { continue; }
			NativeNode record = self.unqualifiedNative(declaration.kind == NNK_NATIVE_TYPEDEF ? declaration.underlying : declaration.recordType);
			if (record.kind != NNK_NATIVE_RECORD_TYPE || !self.layouts.has(record.identity)) { continue; }
			for field in self.layouts.get(record.identity).fields {
				string resource = self.resourceName(field.fieldType);
				if (resource.isEmpty()) { continue; }
				if (field.fieldType.qualifiers.isConst || self.unqualifiedNative(field.fieldType).qualifiers.isConst) { self.fail("owning resource fields require assignable storage"); }
				var projected = FeNativeRecordInputField(field.name, self.resourceCallType(field.fieldType));
				projected.resourceType = resource;
				string key = record.identity + "\x1f" + field.name;
				self.recordResourceFields.put(binding.module + "\x1f" + key, projected);
				self.recordPrivateFields.put(key, true);
			}
		}
		for key in binding.callbacks.keys() {
			var callback = binding.callbacks.get(key);
			if (callback.field.isEmpty()) { continue; }
			if (callback.realtime != null) {
				string name = callback.realtime.record;
				if (!self.callbackExports.has(name) || self.callbackExports.get(name).kind != NNK_NATIVE_TYPEDEF) { self.fail("realtime callback record requires a complete selected SDK struct typedef"); }
				NativeNode record = self.unqualifiedNative(self.callbackExports.get(name).underlying);
				if (record.kind != NNK_NATIVE_RECORD_TYPE || !self.layouts.has(record.identity)) { self.fail("realtime callback record requires a complete selected SDK struct typedef"); }
				self.recordPrivateFields.put(record.identity + "\x1f" + callback.field, true);
				for context in callback.contexts { self.recordPrivateFields.put(record.identity + "\x1f" + context, true); }
				continue;
			}
			var parts = Strings.split(callback.parameter, ".");
			if (!self.callbackExports.has(parts.get(0))) { self.fail("callback field requires a selected native function"); }
			NativeNode declaration = self.callbackExports.get(parts.get(0));
			if (declaration.kind != NNK_NATIVE_FUNCTION) { self.fail("callback field requires a selected native function"); }
			for index in range(declaration.parameterSemantics.len) {
				if (declaration.parameterSemantics.get(index).name != parts.get(1)) { continue; }
				NativeNode record = self.unqualifiedNative(declaration.signature.parameters.get(index));
				if (record.kind != NNK_NATIVE_RECORD_TYPE) { continue; }
				self.recordPrivateFields.put(record.identity + "\x1f" + callback.field, true);
				for context in callback.contexts { self.recordPrivateFields.put(record.identity + "\x1f" + context, true); }
			}
		}
		for name in self.callbackExports.keys() {
			NativeNode declaration = self.callbackExports.get(name);
			if (declaration.kind != NNK_NATIVE_FUNCTION) { continue; }
			if (self.recordContainsResources(declaration.signature.returnType)) { self.fail("resource-bearing record results require a checked output ownership mapping"); }
			for index in range(declaration.signature.parameters.len) {
				string key = declaration.name + "." + declaration.parameterSemantics.get(index).name;
				if (self.recordContainsResources(declaration.signature.parameters.get(index)) && !binding.recordInputs.contains(key) && !binding.recordOutputs.contains(key) && !binding.ownedOutputs.has(key)) { self.fail("resource-bearing record parameters require record-inputs or record-outputs"); }
			}
		}
	}

	private bool recordContainsResources(NativeNode input, Vector<string> active = []) {
		if (!self.resourceName(input).isEmpty()) { return false; }
		NativeNode native = self.unqualifiedNative(input);
		while (native.kind == NNK_NATIVE_POINTER || native.kind == NNK_NATIVE_ARRAY_TYPE) { native = self.unqualifiedNative(native.kind == NNK_NATIVE_POINTER ? native.pointee : native.element); }
		if (native.kind != NNK_NATIVE_RECORD_TYPE || active.contains(native.identity) || !self.layouts.has(native.identity)) { return false; }
		Vector<string> ancestors = [];
		ancestors.extend(active); ancestors.push(native.identity);
		for field in self.layouts.get(native.identity).fields { if (!self.resourceName(field.fieldType).isEmpty() || self.recordContainsResources(field.fieldType, ancestors)) { return true; } }
		return false;
	}

	private void prepareStringViews(FeNativeBinding binding) {
		self.stringViews = {};
		self.usedStringViews = {};
		for name in binding.stringViews.keys() {
			var facts = binding.stringViews.get(name);
			NativeNode declaration = self.callbackExports.get(name);
			if (declaration.kind != NNK_NATIVE_TYPEDEF && declaration.kind != NNK_NATIVE_RECORD_DECLARATION) { self.fail("string-views requires a complete selected struct"); }
			NativeNode record = self.unqualifiedNative(declaration.kind == NNK_NATIVE_TYPEDEF ? declaration.underlying : declaration.recordType);
			if (record.kind != NNK_NATIVE_RECORD_TYPE || !self.layouts.has(record.identity)) { self.fail("string-views requires a complete selected struct"); }
			NativeNode layout = self.layouts.get(record.identity);
			if (layout.recordKind != "struct" || layout.fields.len != 2) { self.fail("string-views requires a complete two-field struct"); }
			Map<string, NativeNode> fields = {};
			for field in layout.fields {
				if (field.isAnonymous || field.isBitfield) { self.fail("string-view data/length must name its two ordinary fields"); }
				fields.put(field.name, field.fieldType);
			}
			if (!fields.has(facts.data) || !fields.has(facts.length)) { self.fail("string-view data/length must name its two ordinary fields"); }
			NativeNode data = self.unqualifiedNative(fields.get(facts.data));
			if (data.kind != NNK_NATIVE_POINTER) { self.fail("string-view data requires a char pointer"); }
			NativeNode element = self.unqualifiedNative(data.pointee);
			if (element.kind != NNK_NATIVE_BUILTIN || element.name != "char") { self.fail("string-view data requires a char pointer"); }
			NativeNode length = self.unqualifiedNative(fields.get(facts.length));
			Vector<string> unsignedTypes = ["unsigned char", "unsigned short", "unsigned int", "unsigned long", "unsigned long long"];
			if (length.kind != NNK_NATIVE_BUILTIN || length.signedness != "unsigned" || !unsignedTypes.contains(length.name)) { self.fail("string-view length requires an unsigned integer byte count"); }
			for field in layout.fields {
				NativeNode value = field.fieldType;
				while (true) {
					if (value.qualifiers.isVolatile || value.qualifiers.isRestrict) { self.fail("string-view fields cannot be volatile or restrict-qualified"); }
					if (value.kind == NNK_NATIVE_ALIAS || value.kind == NNK_NATIVE_QUALIFIED_TYPE) { value = value.underlying; }
					else if (value.kind == NNK_NATIVE_POINTER) { value = value.pointee; }
					else { break; }
				}
			}
			var view = FeNativeStringView(name, facts.data, facts.length, facts.nullMaximum);
			view.nativeSpelling = record.tagName.isEmpty() ? name : "struct " + record.tagName;
			view.lengthSpelling = length.name;
			if (self.stringViews.has(record.identity) && self.stringViews.get(record.identity).identity() != view.identity()) { self.fail("conflicting string-view mappings for the same native record"); }
			self.stringViews.put(record.identity, view);
		}
	}

	private bool realtimeScalar(NativeNode native) {
		NativeNode value = self.unqualifiedNative(native);
		if (value.kind == NNK_NATIVE_ENUM_TYPE) { value = self.unqualifiedNative(value.underlying); }
		Vector<string> names = ["bool", "_Bool", "char", "signed char", "unsigned char", "short", "unsigned short", "int", "unsigned int", "long", "unsigned long", "long long", "unsigned long long"];
		return value.kind == NNK_NATIVE_BUILTIN && names.contains(value.name);
	}

	private bool realtimePod(NativeNode native, Vector<string> seen) {
		if (!self.resourceName(native).isEmpty()) { return false; }
		NativeNode value = self.unqualifiedNative(native);
		if (value.kind == NNK_NATIVE_BUILTIN || value.kind == NNK_NATIVE_ENUM_TYPE) { return true; }
		if (value.kind == NNK_NATIVE_POINTER) { return self.realtimePod(value.pointee, seen); }
		if (value.kind == NNK_NATIVE_ARRAY_TYPE) {
			var count = value.count;
			if (count == null || count.isEmpty()) { return false; }
			/* Index a non-null local: the self-host types an element of a nullable
			 * string as a string, which no char literal compares against. */
			string digits = count;
			bool positive = false;
			for index in range(digits.length()) { if (!Strings.isDigit(digits[index])) { return false; } if (digits[index] != '0') { positive = true; } }
			return positive && self.realtimePod(value.element, seen);
		}
		if (value.kind != NNK_NATIVE_RECORD_TYPE) { return false; }
		if (seen.contains(value.identity)) { return true; }
		if (!self.layouts.has(value.identity)) { return false; }
		var nested = seen.copy(); nested.push(value.identity);
		for field in self.layouts.get(value.identity).fields { if (!self.realtimePod(field.fieldType, nested)) { return false; } }
		return true;
	}

	private Node realtimeParameter(NativeNode native) {
		NativeNode value = self.unqualifiedNative(native);
		if (value.kind == NNK_NATIVE_BUILTIN || value.kind == NNK_NATIVE_ENUM_TYPE) { return self.callType(native, true); }
		if (value.kind == NNK_NATIVE_POINTER) {
			NativeNode pointee = self.unqualifiedNative(value.pointee);
			Vector<string> seen = [];
			if ((pointee.kind == NNK_NATIVE_BUILTIN || pointee.kind == NNK_NATIVE_ENUM_TYPE || pointee.kind == NNK_NATIVE_RECORD_TYPE) && self.realtimePod(native, seen)) { return self.callType(native, true); }
		}
		self.fail("realtime callback arguments require SDK scalar or POD data-pointer types"); return null;
	}

	private string realtimeNativeSpelling(NativeNode native) {
		if (native.kind == NNK_NATIVE_QUALIFIED_TYPE) { return self.realtimeNativeSpelling(native.underlying); }
		string prefix = native.qualifiers.isConst ? "const " : "";
		if (native.kind == NNK_NATIVE_POINTER) { return self.realtimeNativeSpelling(native.pointee) + "*" + (prefix.isEmpty() ? "" : " const"); }
		if (native.kind == NNK_NATIVE_RECORD_TYPE && !native.tagName.isEmpty()) { return prefix + native.recordKind + " " + native.tagName; }
		return prefix + self.blockTypeSpelling(native);
	}

	private void projectRealtimeCallbacks(FeNativeBinding binding) {
		for selectedKey in binding.callbacks.keys() {
			FeNativeCallbackBinding selected = binding.callbacks.get(selectedKey);
			FeNativeRealtimeCallbackBinding? shape = selected.realtime;
			if (shape == null) { continue; }
			var parts = Strings.split(selected.parameter, ".");
			if (!self.callbackExports.has(parts.get(0))) { self.fail("realtime registration requires a selected fixed-arity status function"); }
			NativeNode native = self.callbackExports.get(parts.get(0));
			if (native.kind != NNK_NATIVE_FUNCTION || native.signature.variadic || !self.realtimeScalar(native.signature.returnType)) { self.fail("realtime registration requires a selected fixed-arity status function"); }
			var names = self.parameterNames(native);
			int index = names.indexOf(parts.get(1)); int ownerIndex = names.indexOf(shape.owner); int sizeIndex = names.indexOf(shape.size);
			if (index < 0 || ownerIndex < 0 || sizeIndex < 0 || index == ownerIndex || index == sizeIndex || ownerIndex == sizeIndex) { self.fail("realtime registration requires distinct callback, owner and size parameters"); }
			NativeNode storage = self.unqualifiedNative(native.signature.parameters.get(index));
			NativeNode? pointee = storage.kind == NNK_NATIVE_POINTER ? self.unqualifiedNative(storage.pointee) : null;
			if (pointee == null || pointee.kind != NNK_NATIVE_BUILTIN || pointee.name != "void" || !pointee.qualifiers.isConst) { self.fail("realtime callback record requires const void* SDK input storage"); }
			NativeNode size = self.unqualifiedNative(native.signature.parameters.get(sizeIndex));
			if (size.kind != NNK_NATIVE_BUILTIN || size.signedness != "unsigned" || !self.realtimeScalar(size)) { self.fail("realtime callback record requires an unsigned SDK size parameter"); }
			string resource = self.resourceName(native.signature.parameters.get(ownerIndex));
			if (resource.isEmpty() || self.resources.get(resource).ownership != "unique") { self.fail("realtime callback owner requires a declared unique resource"); }
			if (selected.contexts.len != 1 || selected.contextIndices.len != 1) { self.fail("realtime callback requires one compiler-owned context slot"); }
			NativeNode record = self.unqualifiedNative(self.callbackExports.get(shape.record).underlying);
			Map<string, NativeNode> fields = {};
			for field in self.layouts.get(record.identity).fields { fields.put(field.name, field.fieldType); }
			if (fields.len != 2 || !fields.has(selected.field) || !fields.has(selected.contexts.get(0)) || selected.field == selected.contexts.get(0)) { self.fail("realtime callback field/context must identify distinct SDK fields"); }
			NativeNode callbackPointer = self.unqualifiedNative(fields.get(selected.field));
			NativeNode? signature = callbackPointer.kind == NNK_NATIVE_POINTER ? self.unqualifiedNative(callbackPointer.pointee) : null;
			if (signature == null || signature.kind != NNK_NATIVE_FUNCTION_TYPE || signature.variadic || !self.realtimeScalar(signature.returnType)) { self.fail("realtime callback requires a fixed-arity scalar-result function pointer"); }
			int contextIndex = selected.contextIndices.get(0);
			NativeNode context = self.unqualifiedNative(fields.get(selected.contexts.get(0)));
			NativeNode? contextType = context.kind == NNK_NATIVE_POINTER ? self.unqualifiedNative(context.pointee) : null;
			if (contextIndex >= signature.parameters.len || contextType == null || contextType.kind != NNK_NATIVE_BUILTIN || contextType.name != "void" || contextType.qualifiers.isConst) { self.fail("realtime callback context requires unqualified void* SDK storage"); }
			NativeNode callbackContext = self.unqualifiedNative(signature.parameters.get(contextIndex));
			NativeNode? callbackPointee = callbackContext.kind == NNK_NATIVE_POINTER ? self.unqualifiedNative(callbackContext.pointee) : null;
			if (callbackPointee == null || callbackPointee.kind != NNK_NATIVE_BUILTIN || callbackPointee.name != "void" || callbackPointee.qualifiers.isConst) { self.fail("realtime callback context-index must identify an unqualified void* argument"); }
			var invocation = FeNativeRealtimeRegistration(shape.name, shape.invocation, resource, native.name, ownerIndex, sizeIndex, self.callType(native.signature.returnType));
			for parameter in native.signature.parameters { invocation.nativeParameters.push(self.realtimeNativeSpelling(parameter)); }
			for method in shape.operations.keys() {
				string key = shape.operations.get(method); var operationParts = Strings.split(key, ".");
				if (!self.callbackExports.has(operationParts.get(0))) { self.fail("callback operation requires an explicitly realtime-safe fixed-arity SDK function"); }
				NativeNode operation = self.callbackExports.get(operationParts.get(0));
				if (operation.kind != NNK_NATIVE_FUNCTION || operation.signature.variadic || !self.realtime.has(operation.name)) { self.fail("callback operation requires an explicitly realtime-safe fixed-arity SDK function"); }
				var operationNames = self.parameterNames(operation); int position = operationNames.indexOf(operationParts.get(1));
				if (position < 0) { self.fail("callback operation owner names an unknown SDK parameter"); }
				if (self.resourceName(operation.signature.parameters.get(position)) != resource || !self.resourceBorrows.has(key) || !self.resourcePointerAccepts(operation.signature.parameters.get(position), self.resourceTypes.get(resource))) { self.fail("callback operation requires a borrowed parameter of its registration owner"); }
				if (!self.realtimeScalar(operation.signature.returnType)) { self.fail("callback operations require non-consuming scalar-result calls"); }
				for parameter in operation.parameterSemantics { if (parameter.cfConsumed || parameter.nsConsumed) { self.fail("callback operations require non-consuming scalar-result calls"); } }
				var projected = FeNativeRealtimeOperation(method, operation.name, position, self.callType(operation.signature.returnType));
				for slot in range(operation.signature.parameters.len) { if (slot != position) { Node parameter = self.node(NK_PARAM); parameter.name = operationNames.get(slot); parameter.type = self.realtimeParameter(operation.signature.parameters.get(slot)); projected.parameters.push(parameter); } }
				invocation.operations.push(projected); self.resourceBorrows.remove(key); self.realtime.remove(operation.name);
			}
			if (!self.callbackExports.has(selected.unregister)) { self.fail("realtime unregister requires one borrowed owner and a scalar status"); }
			NativeNode unregister = self.callbackExports.get(selected.unregister);
			if (unregister.kind != NNK_NATIVE_FUNCTION || unregister.signature.variadic || unregister.signature.parameters.len != 1 || !self.realtimeScalar(unregister.signature.returnType)) { self.fail("realtime unregister requires one borrowed owner and a scalar status"); }
			string unregisterKey = unregister.name + "." + self.parameterNames(unregister).get(0);
			if (self.resourceName(unregister.signature.parameters.get(0)) != resource || !self.resourceBorrows.has(unregisterKey) || !self.resourcePointerAccepts(unregister.signature.parameters.get(0), self.resourceTypes.get(resource))) { self.fail("realtime unregister must borrow its registration owner without consumption"); }
			for parameter in unregister.parameterSemantics { if (parameter.cfConsumed || parameter.nsConsumed) { self.fail("realtime unregister must borrow its registration owner without consumption"); } }
			self.resourceBorrows.remove(unregisterKey);
			Node result = self.callType(signature.returnType);
			var projection = FeNativeCallbackProjection(selected.interfaceName, index, -1, contextIndex, result);
			projection.unregister = unregister; projection.activationFailure = selected.activationFailure; projection.field = selected.field; projection.record = shape.record; projection.contextFields = selected.contexts; projection.callbackContextIndices = selected.contextIndices; projection.realtime = invocation;
			Node callbackMethod = self.node(NK_METHOD_SIG); callbackMethod.name = "invoke"; callbackMethod.returnType = result;
			Node capability = self.node(NK_PARAM); capability.name = "invocation"; capability.type = self.node(NK_TYPE_EXPR); capability.type.base = shape.invocation; callbackMethod.paramsMut().push(capability);
			Node fallback = self.node(NK_TYPE_EXPR); fallback.base = "__realtime_fn_ptr"; fallback.genericArgsMut().push(result);
			for slot in range(signature.parameters.len) {
				Node value = slot == contextIndex ? self.node(NK_TYPE_EXPR) : self.realtimeParameter(signature.parameters.get(slot));
				if (slot == contextIndex) { value.base = "void"; value.pointerDepth = 1; }
				projection.parameters.push(value);
				if (slot != contextIndex) { Node parameter = self.node(NK_PARAM); parameter.name = f"argument{slot}"; parameter.type = value; callbackMethod.paramsMut().push(parameter); fallback.genericArgsMut().push(value); }
			}
			Node projectedInterface = self.node(NK_INTERFACE_DECL); projectedInterface.name = selected.interfaceName; projectedInterface.methodsMut().push(callbackMethod);
			self.add(selected.interfaceName, projectedInterface, "realtime-callback:" + self.typeIdentity(signature));
			Node owner = self.node(NK_CLASS_DECL); owner.name = shape.invocation; owner.isAbstract = true; owner.sourceFile = self.module;
			Node contextField = self.node(NK_FIELD_DECL); contextField.access = "private"; contextField.name = "_context"; contextField.type = self.node(NK_TYPE_EXPR); contextField.type.base = "void"; contextField.type.pointerDepth = 1; owner.membersMut().push(contextField);
			var generated = FeNativeImportedDeclaration(owner, self.module, self.header); generated.language = ""; generated.invocation = shape.invocation;
			for operation in invocation.operations {
				Node method = self.node(NK_METHOD_DECL); method.access = "public"; method.name = operation.name; method.returnType = operation.returnType; method.paramsStorage = operation.parameters; method.sourceFile = self.module; owner.membersMut().push(method);
				var contract = FeNativeCallContract(); contract.realtimeSafe = true; generated.methods.put(method.name, contract);
			}
			self.inputClasses.push(generated);
			Node alias = self.node(NK_FUNCTION_DECL); alias.name = shape.name; alias.returnType = self.node(NK_TYPE_EXPR); alias.returnType.base = "CallbackState";
			for slot in range(names.len) {
				if (slot == index || slot == sizeIndex) { continue; }
				Node parameter = self.node(NK_PARAM); parameter.name = names.get(slot); parameter.type = slot == ownerIndex ? self.resourceCallType(native.signature.parameters.get(slot)) : self.callType(native.signature.parameters.get(slot), true); alias.paramsMut().push(parameter);
			}
			Vector<string> additionalNames = ["receiver", "denied", "scope"];
			Node receiverType = self.node(NK_TYPE_EXPR); receiverType.base = selected.interfaceName;
			Node scopeType = self.node(NK_TYPE_EXPR); scopeType.base = "CallbackScope";
			Vector<Node> additionalTypes = [receiverType, fallback, scopeType];
			for slot in range(3) { string name = additionalNames.get(slot); while (names.contains(name)) { name = name + "_"; } names.push(name); Node parameter = self.node(NK_PARAM); parameter.name = name; parameter.type = additionalTypes.get(slot); alias.paramsMut().push(parameter); }
			var contract = FeNativeCallContract(); contract.callbacks.push(projection); self.add(shape.name, alias, "realtime-registration:" + selected.parameter, "", false, contract);
			self.callbacks.remove(selected.parameter);
		}
	}

	private Node tableParameter(NativeNode native, string what = "callback table method") {
		NativeNode value = self.unqualifiedNative(native);
		if (value.kind == NNK_NATIVE_BUILTIN || value.kind == NNK_NATIVE_ENUM_TYPE) { return self.callType(native, true); }
		if (value.kind == NNK_NATIVE_POINTER) {
			NativeNode pointee = self.unqualifiedNative(value.pointee);
			Vector<string> seen = [];
			if ((pointee.kind == NNK_NATIVE_BUILTIN || pointee.kind == NNK_NATIVE_ENUM_TYPE || pointee.kind == NNK_NATIVE_RECORD_TYPE) && self.realtimePod(native, seen)) { return self.callType(native, true); }
		}
		self.fail(what + " arguments require SDK scalar or POD data-pointer types"); return null;
	}

	private NativeNode tableFunctionType(NativeNode fieldType, string what) {
		NativeNode pointer = self.unqualifiedNative(fieldType);
		if (pointer.kind != NNK_NATIVE_POINTER) { self.fail(f"callback table {what} requires a fixed-arity function pointer field"); }
		NativeNode signature = self.unqualifiedNative(pointer.pointee);
		if (signature.kind != NNK_NATIVE_FUNCTION_TYPE || signature.variadic) { self.fail(f"callback table {what} requires a fixed-arity function pointer field"); }
		return signature;
	}

	private void tableContextArgument(NativeNode native, string what) {
		NativeNode pointer = self.unqualifiedNative(native);
		if (pointer.kind != NNK_NATIVE_POINTER) { self.fail(f"callback table {what} requires an unqualified void* context"); }
		NativeNode pointee = self.unqualifiedNative(pointer.pointee);
		if (pointee.kind != NNK_NATIVE_BUILTIN || pointee.name != "void" || pointee.qualifiers.isConst) { self.fail(f"callback table {what} requires an unqualified void* context"); }
	}

	private void tableRecordPointer(NativeNode native, string identity, string what) {
		NativeNode pointer = self.unqualifiedNative(native);
		if (pointer.kind != NNK_NATIVE_POINTER) { self.fail(f"callback table {what} requires a mutable pointer to the table record"); }
		NativeNode pointee = self.unqualifiedNative(pointer.pointee);
		if (pointee.kind != NNK_NATIVE_RECORD_TYPE || pointee.identity != identity || self.nativeIsConst(pointer.pointee)) { self.fail(f"callback table {what} requires a mutable pointer to the table record"); }
	}

	private void tableTextPointer(NativeNode native, string what) {
		NativeNode pointer = self.unqualifiedNative(native);
		if (pointer.kind != NNK_NATIVE_POINTER) { self.fail(f"callback table {what} requires const char* text"); }
		NativeNode pointee = self.unqualifiedNative(pointer.pointee);
		if (pointee.kind != NNK_NATIVE_BUILTIN || pointee.name != "char" || !self.nativeIsConst(pointer.pointee)) { self.fail(f"callback table {what} requires const char* text"); }
	}

	/* A unique SDK callback record becomes one ordinary interface plus a factory
	 * returning the ordinary unique owner; every live native table holds one
	 * receiver claim, so SDK reopen clones outlive the BTRC-side close. */
	private void projectCallbackTables(FeNativeBinding binding) {
		for name in binding.resources.keys() {
			FeNativeResourceBinding resource = binding.resources.get(name);
			FeNativeCallbackTable? table = resource.table;
			if (table == null) { continue; }
			NativeNode pointer = self.resourceTypes.get(name);
			NativeNode record = self.unqualifiedNative(pointer.pointee);
			if (resource.ownership != "unique" || !resource.storage.isEmpty() || record.kind != NNK_NATIVE_RECORD_TYPE || !self.layouts.has(record.identity) || !self.resourceRecords.has(record.identity)) { self.fail("callback table requires a unique pointer resource over a complete SDK struct"); }
			NativeNode layout = self.layouts.get(record.identity);
			if (layout.recordKind != "struct") { self.fail("callback table requires a unique pointer resource over a complete SDK struct"); }
			Map<string, NativeNode> fields = {};
			for field in layout.fields {
				if (field.isAnonymous || field.isBitfield) { self.fail("callback table fields must be ordinary named SDK fields"); }
				fields.put(field.name, field.fieldType);
			}
			Vector<string> mapped = [table.context];
			mapped.extend(table.methodFields);
			for optional in [table.label, table.reopen, table.releaseField] { if (!optional.isEmpty()) { mapped.push(optional); } }
			Map<string, bool> seen = {};
			for mappedName in mapped {
				if (!fields.has(mappedName) || seen.has(mappedName)) { self.fail("callback table must map every SDK field exactly once"); }
				seen.put(mappedName, true);
			}
			if (mapped.len != layout.fields.len) { self.fail("callback table must map every SDK field exactly once"); }
			for mappedName in mapped {
				NativeNode storage = fields.get(mappedName);
				while (true) {
					if (storage.qualifiers.isConst || storage.qualifiers.isVolatile || storage.qualifiers.isRestrict) { self.fail("callback table fields require assignable unqualified storage"); }
					if (storage.kind != NNK_NATIVE_ALIAS && storage.kind != NNK_NATIVE_QUALIFIED_TYPE) { break; }
					storage = storage.underlying;
				}
			}
			self.tableContextArgument(fields.get(table.context), "context field");
			NativeNode exported = self.callbackExports.get(name);
			string nativeType = exported.kind == NNK_NATIVE_TYPEDEF ? name : record.recordKind + " " + record.tagName;
			var projection = FeNativeCallbackTableProjection(name, table.interfaceName, nativeType, table.context, table.contextIndex);
			projection.label = table.label; projection.reopen = table.reopen; projection.releaseField = table.releaseField;
			Node projectedInterface = self.node(NK_INTERFACE_DECL); projectedInterface.name = table.interfaceName;
			for index in range(table.methodNames.len) {
				string method = table.methodNames.get(index); string field = table.methodFields.get(index);
				NativeNode signature = self.tableFunctionType(fields.get(field), "method " + method);
				if (table.contextIndex >= signature.parameters.len) { self.fail("callback table context-index is outside a method signature"); }
				self.tableContextArgument(signature.parameters.get(table.contextIndex), "method " + method);
				NativeNode result = self.unqualifiedNative(signature.returnType);
				bool voidResult = result.kind == NNK_NATIVE_BUILTIN && result.name == "void";
				if (!voidResult && !self.realtimeScalar(signature.returnType)) { self.fail("callback table methods require scalar or void results"); }
				var projected = FeNativeCallbackTableMethod(method, field, self.callType(signature.returnType), self.realtimeNativeSpelling(signature.returnType));
				Node callbackMethod = self.node(NK_METHOD_SIG); callbackMethod.name = method; callbackMethod.returnType = projected.returnType;
				int position = 0;
				for slot in range(signature.parameters.len) {
					projected.nativeParameters.push(self.realtimeNativeSpelling(signature.parameters.get(slot)));
					if (slot == table.contextIndex) { continue; }
					Node value = self.tableParameter(signature.parameters.get(slot));
					projected.parameters.push(value);
					Node parameter = self.node(NK_PARAM); parameter.name = f"argument{position}"; parameter.type = value; callbackMethod.paramsMut().push(parameter);
					position = position + 1;
				}
				projection.methods.push(projected); projectedInterface.methodsMut().push(callbackMethod);
			}
			if (!table.label.isEmpty()) {
				NativeNode signature = self.tableFunctionType(fields.get(table.label), "label");
				if (signature.parameters.len != 1) { self.fail("callback table label requires exactly the context argument"); }
				self.tableContextArgument(signature.parameters.get(0), "label");
				self.tableTextPointer(signature.returnType, "label result");
			}
			if (!table.reopen.isEmpty()) {
				NativeNode signature = self.tableFunctionType(fields.get(table.reopen), "reopen");
				if (signature.parameters.len != 2) { self.fail("callback table reopen requires context and name arguments"); }
				self.tableContextArgument(signature.parameters.get(0), "reopen");
				self.tableTextPointer(signature.parameters.get(1), "reopen name");
				self.tableRecordPointer(signature.returnType, record.identity, "reopen result");
			}
			if (!table.releaseField.isEmpty()) {
				NativeNode signature = self.tableFunctionType(fields.get(table.releaseField), "release");
				NativeNode result = self.unqualifiedNative(signature.returnType);
				if (signature.parameters.len != 1 || result.kind != NNK_NATIVE_BUILTIN || result.name != "void") { self.fail("callback table release requires one table argument and void result"); }
				self.tableRecordPointer(signature.parameters.get(0), record.identity, "release");
			}
			self.add(table.interfaceName, projectedInterface, "callback-table:" + name + ":" + self.typeIdentity(pointer));
			Node factory = self.node(NK_FUNCTION_DECL); factory.name = table.name;
			factory.returnType = self.node(NK_TYPE_EXPR); factory.returnType.base = name;
			var contract = FeNativeCallContract(); contract.nonnullReturn = true; contract.resourceResult = name; contract.callbackTable = projection;
			Node receiverParameter = self.node(NK_PARAM); receiverParameter.name = "receiver"; receiverParameter.type = self.node(NK_TYPE_EXPR); receiverParameter.type.base = table.interfaceName; factory.paramsMut().push(receiverParameter);
			contract.nonnullParameters.push(true); contract.readOnlyBorrows.push(false); contract.resourceParameters.push(""); contract.recordInputs.push(null);
			if (!table.label.isEmpty()) {
				Node labelParameter = self.node(NK_PARAM); labelParameter.name = "label"; labelParameter.type = self.node(NK_TYPE_EXPR); labelParameter.type.base = "string"; factory.paramsMut().push(labelParameter);
				contract.nonnullParameters.push(true); contract.readOnlyBorrows.push(false); contract.resourceParameters.push(""); contract.recordInputs.push(null);
			}
			self.add(table.name, factory, "callback-table-factory:" + name, "", false, contract);
		}
	}

	/* COM's 32-bit integer: an HRESULT (signed) or a ULONG (unsigned). */
	private bool comInteger(NativeNode native, string signedness) {
		NativeNode value = self.unqualifiedNative(native);
		return value.kind == NNK_NATIVE_BUILTIN && ["int", "unsigned int", "long", "unsigned long"].contains(value.name) && value.bits == 32 && value.signedness == signedness;
	}

	/* Whether a REFIID parameter is `const IID*`, a pointer to a const record. */
	private bool comIidShaped(NativeNode native) {
		NativeNode pointer = self.unqualifiedNative(native);
		return pointer.kind == NNK_NATIVE_POINTER && self.nativeIsConst(pointer.pointee) && self.unqualifiedNative(pointer.pointee).kind == NNK_NATIVE_RECORD_TYPE;
	}

	/* Whether QueryInterface's last parameter is a mutable `void**`. */
	private bool comVoidOutput(NativeNode native) {
		NativeNode output = self.unqualifiedNative(native);
		if (output.kind != NNK_NATIVE_POINTER || self.nativeIsConst(output.pointee)) { return false; }
		NativeNode target = self.unqualifiedNative(output.pointee);
		if (target.kind != NNK_NATIVE_POINTER) { return false; }
		NativeNode value = self.unqualifiedNative(target.pointee);
		return value.kind == NNK_NATIVE_BUILTIN && value.name == "void";
	}

	/* Whether slot `index` of a COM table is the named fixed-arity function-pointer field. */
	private bool comSlotShaped(NativeNode table, int index, string name) {
		if (index >= table.fields.len) { return false; }
		NativeNode field = table.fields.get(index);
		if (field.name != name || field.isBitfield) { return false; }
		NativeNode pointer = self.unqualifiedNative(field.fieldType);
		if (pointer.kind != NNK_NATIVE_POINTER) { return false; }
		NativeNode signature = self.unqualifiedNative(pointer.pointee);
		return signature.kind == NNK_NATIVE_FUNCTION_TYPE && !signature.variadic;
	}

	/* The signature of a COM table slot that comSlotShaped accepted. */
	private NativeNode comSlotSignature(NativeNode table, int index) { return self.unqualifiedNative(self.unqualifiedNative(table.fields.get(index).fieldType).pointee); }

	/* The COM interface an [out] `IFoo**` parameter receives, or empty. */
	private string comOutput(NativeNode native) {
		NativeNode pointer = self.unqualifiedNative(native);
		if (pointer.kind != NNK_NATIVE_POINTER || self.nativeIsConst(pointer.pointee)) { return ""; }
		NativeNode inner = self.unqualifiedNative(pointer.pointee);
		if (inner.kind != NNK_NATIVE_POINTER || self.nativeIsConst(inner.pointee)) { return ""; }
		string name = self.resourceName(pointer.pointee);
		return !name.isEmpty() && self.resources.get(name).ownership == "com" ? name : "";
	}

	/* A slot's receiver argument takes a pointer to the dispatching object. */
	private bool dispatchReceiver(NativeNode native, NativeNode record) {
		NativeNode pointer = self.unqualifiedNative(native);
		if (pointer.kind != NNK_NATIVE_POINTER) { return false; }
		NativeNode pointee = self.unqualifiedNative(pointer.pointee);
		return pointee.kind == NNK_NATIVE_RECORD_TYPE && pointee.identity == record.identity;
	}

	/* A derived table's slot repeats its base's: same name and signature except This. */
	private bool comSlotMatches(NativeNode table, NativeNode baseTable, int index, NativeNode record, NativeNode baseRecord) {
		string name = baseTable.fields.get(index).name;
		if (!self.comSlotShaped(table, index, name) || !self.comSlotShaped(baseTable, index, name)) { return false; }
		NativeNode mine = self.comSlotSignature(table, index);
		NativeNode theirs = self.comSlotSignature(baseTable, index);
		if (mine.parameters.len != theirs.parameters.len || theirs.parameters.len < 1 || mine.callingConvention != theirs.callingConvention) { return false; }
		if (!self.dispatchReceiver(mine.parameters.get(0), record) || !self.dispatchReceiver(theirs.parameters.get(0), baseRecord)) { return false; }
		if (self.typeIdentity(mine.returnType) != self.typeIdentity(theirs.returnType)) { return false; }
		for position in range(1, mine.parameters.len) { if (self.typeIdentity(mine.parameters.get(position)) != self.typeIdentity(theirs.parameters.get(position))) { return false; } }
		return true;
	}

	/* Whether `name` is a selected read-only global of the GUID record `identity`. */
	private bool guidGlobal(string name, string identity) {
		if (!self.callbackExports.has(name)) { return false; }
		NativeNode selected = self.callbackExports.get(name);
		if (selected.kind != NNK_NATIVE_GLOBAL || !selected.readOnly) { return false; }
		NativeNode value = self.unqualifiedNative(selected.valueType);
		return value.kind == NNK_NATIVE_RECORD_TYPE && value.identity == identity;
	}

	/* Check each COM interface's lpVtbl slots 0-2 against IUnknown, and its base
	 * prefix. The importer reads the table's real layout: QueryInterface(This,
	 * REFIID, void**) returning a 32-bit signed HRESULT, then AddRef(This) and
	 * Release(This) returning a 32-bit unsigned ULONG. A declared base must be a
	 * slot-by-slot prefix whose signatures differ only in This, so widening to
	 * the base is static (native-interop-ownership.md section 2.4). */
	private void projectComInterfaces(FeNativeBinding binding) {
		Vector<string> interfaces = [];
		for name in binding.resources.keys() { if (binding.resources.get(name).ownership == "com") { interfaces.push(name); } }
		interfaces.sortBy((string left, string right) => Strings.lessThan(left, right));
		Map<string, NativeNode> records = {};
		Map<string, NativeNode> tables = {};
		Map<string, NativeNode> firsts = {};
		for name in interfaces {
			NativeNode record = self.unqualifiedNative(self.resourceTypes.get(name).pointee);
			if (self.layouts.has(record.identity) && self.layouts.get(record.identity).recordKind == "struct" && self.layouts.get(record.identity).fields.len > 0) {
				NativeNode first = self.layouts.get(record.identity).fields.get(0);
				NativeNode pointer = self.unqualifiedNative(first.fieldType);
				if (first.name == "lpVtbl" && pointer.kind == NNK_NATIVE_POINTER) {
					NativeNode tableRecord = self.unqualifiedNative(pointer.pointee);
					if (tableRecord.kind == NNK_NATIVE_RECORD_TYPE && self.layouts.has(tableRecord.identity) && self.layouts.get(tableRecord.identity).recordKind == "struct") {
						records.put(name, record); tables.put(name, self.layouts.get(tableRecord.identity)); firsts.put(name, first);
					}
				}
			}
			if (!tables.has(name)) { self.fail(f"resource {name}: com requires a complete record whose first field lpVtbl points to a complete SDK table"); }
		}
		/* COM sinks implement these tables (projectComSinks). */
		self.comRecords = records; self.comTables = tables; self.comFirsts = firsts;
		for name in interfaces {
			FeNativeResourceBinding resource = binding.resources.get(name);
			NativeNode record = records.get(name);
			NativeNode table = tables.get(name);
			bool shaped = self.comSlotShaped(table, 0, "QueryInterface") && self.comSlotShaped(table, 1, "AddRef") && self.comSlotShaped(table, 2, "Release");
			if (shaped) {
				NativeNode slotQuery = self.comSlotSignature(table, 0);
				NativeNode slotAddRef = self.comSlotSignature(table, 1);
				NativeNode slotRelease = self.comSlotSignature(table, 2);
				shaped = slotQuery.parameters.len == 3 && slotAddRef.parameters.len == 1 && slotRelease.parameters.len == 1 && self.comIidShaped(slotQuery.parameters.get(1)) && self.comVoidOutput(slotQuery.parameters.get(2)) && self.dispatchReceiver(slotQuery.parameters.get(0), record) && self.dispatchReceiver(slotAddRef.parameters.get(0), record) && self.dispatchReceiver(slotRelease.parameters.get(0), record) && self.comInteger(slotQuery.returnType, "signed") && self.comInteger(slotAddRef.returnType, "unsigned") && self.comInteger(slotRelease.returnType, "unsigned");
			}
			if (!shaped) { self.fail(f"resource {name}: lpVtbl slots 0-2 are not IUnknown-shaped (QueryInterface, AddRef, Release)"); }
			NativeNode query = self.comSlotSignature(table, 0);
			for index in range(3) { self.requireQualifiedConvention(self.comSlotSignature(table, index)); }
			string iidIdentity = self.unqualifiedNative(self.unqualifiedNative(query.parameters.get(1)).pointee).identity;
			if (!self.guidGlobal(resource.iid, iidIdentity)) { self.fail(f"resource {name}: iid {resource.iid} is not a read-only GUID global"); }
			if (!resource.base.isEmpty()) {
				NativeNode baseTable = tables.get(resource.base);
				bool prefix = baseTable.fields.len <= table.fields.len;
				for index in range(baseTable.fields.len) { if (prefix && !self.comSlotMatches(table, baseTable, index, record, records.get(resource.base))) { prefix = false; } }
				if (!prefix) { self.fail(f"resource {name}: base {resource.base} is not a slot-by-slot prefix of its lpVtbl table"); }
			}
			var owner = self.resourceDeclaration(name);
			/* sameObject asks each object for its IUnknown identity. */
			string unknown = self.guidGlobal("IID_IUnknown", iidIdentity) ? "IID_IUnknown" : "";
			var projected = FeNativeComInterface(name, owner.typeSpelling, self.realtimeNativeSpelling(firsts.get(name).fieldType), self.realtimeNativeSpelling(query.returnType), self.realtimeNativeSpelling(query.parameters.get(1)), resource.iid, unknown);
			var contract = FeNativeCallContract(); contract.comInterface = projected;
			owner.methods.put("", contract);
			if (!unknown.isEmpty()) {
				Node member = self.node(NK_METHOD_DECL); member.access = "class"; member.name = "sameObject";
				member.returnType = self.node(NK_TYPE_EXPR); member.returnType.base = "bool";
				for parameterName in ["first", "second"] {
					Node parameter = self.node(NK_PARAM); parameter.name = parameterName;
					parameter.type = self.node(NK_TYPE_EXPR); parameter.type.base = name; parameter.type.isNullable = true; parameter.type.pointerDepth = 1;
					member.paramsMut().push(parameter);
				}
				owner.declaration.membersMut().push(member);
				var identity = FeNativeCallContract(); identity.comInterface = projected;
				owner.methods.put("sameObject", identity);
			}
		}
	}

	/* How a COM method's HRESULT and its one [out] interface reach BTRC. With
	 * status-results a failing (negative) HRESULT throws after the adopted
	 * output is released, and the method returns that output, or else the
	 * nonnegative HRESULT. An owned-outputs result class carries the HRESULT
	 * and the adopted output instead. An [out] interface with neither form is
	 * rejected (native-interop-ownership.md section 2.4). A copied [out]
	 * string (copied-outputs) takes the status-results form. */
	private void comMethodStatus(string resourceName, FeNativeDispatchMethod method, NativeNode signature, Vector<string> names, Vector<int> outputs, Vector<int> copies) {
		string key = resourceName + "." + method.name;
		bool throws = self.statusResults.has(key) && self.statusResults.get(key) == "hresult";
		if (self.statusResults.has(key)) { self.statusResults.remove(key); }
		if (outputs.len > 1) { self.fail(f"dispatch method {key} adopts at most one [out] interface"); }
		string outputKey = "";
		string resultClass = "";
		if (outputs.len > 0) {
			outputKey = key + "." + (names.len > 0 ? names.get(outputs.get(0)) : f"argument{outputs.get(0)}");
			if (self.ownedOutputs.has(outputKey)) { resultClass = self.ownedOutputs.get(outputKey); self.ownedOutputs.remove(outputKey); }
		}
		if ((throws || !resultClass.isEmpty()) && !self.comInteger(signature.returnType, "signed")) { self.fail(f"dispatch method {key}: status = hresult and status-results require a 32-bit signed result"); }
		if (copies.len > 0) {
			if (outputs.len > 0 || copies.len > 1) { self.fail(f"dispatch method {key} adopts at most one [out] value"); }
			self.comCopiedOutput(key, method, signature, copies.get(0), names, throws);
			return;
		}
		if (outputs.len == 0) {
			if (throws) { method.status = "throw"; }
			return;
		}
		if (!throws && resultClass.isEmpty()) { self.fail(f"dispatch method {key}: an [out] interface requires status-results or owned-outputs"); }
		NativeNode native = signature.parameters.get(outputs.get(0));
		string output = self.comOutput(native);
		method.outputPosition = outputs.get(0);
		method.outputResource = output;
		method.outputSpelling = self.realtimeNativeSpelling(self.unqualifiedNative(native).pointee);
		if (throws) {
			method.status = "throw";
			Node value = self.node(NK_TYPE_EXPR); value.base = output; value.isNullable = true; value.pointerDepth = 1;
			method.returnType = value;
			return;
		}
		if (!self.ownedOutputStatuses.has(outputKey) || self.ownedOutputStatuses.get(outputKey) != "hresult") { self.fail("owned-outputs status = hresult pairs with a com interface output"); }
		self.ownedOutputClass(resultClass, self.type(signature.returnType), output, null);
		method.status = "result";
		method.resultClass = resultClass;
		Node result = self.node(NK_TYPE_EXPR); result.base = resultClass;
		method.returnType = result;
	}

	/* A copied [out] UTF-16 string: a BSTR or CoTaskMemAlloc text the adapter
	 * copies and frees. The slot writes a mutable 16-bit-unit string pointer;
	 * the method returns its copy as `string?` (null when the slot left it
	 * null), and the declared free function, which must take that pointer and
	 * return void, releases it inside the adapter on every HRESULT. */
	private void comCopiedOutput(string key, FeNativeDispatchMethod method, NativeNode signature, int index, Vector<string> names, bool throws) {
		string parameter = names.len > 0 ? names.get(index) : f"argument{index}";
		string free = self.copiedOutputs.get(key + "." + parameter);
		self.copiedOutputs.remove(key + "." + parameter);
		if (!throws) { self.fail(f"dispatch method {key}: a copied output requires status-results"); }
		NativeNode outer = self.unqualifiedNative(signature.parameters.get(index));
		bool shaped = outer.kind == NNK_NATIVE_POINTER && !self.nativeIsConst(outer.pointee);
		if (shaped) {
			NativeNode inner = self.unqualifiedNative(outer.pointee);
			shaped = inner.kind == NNK_NATIVE_POINTER && !self.nativeIsConst(inner.pointee);
			if (shaped) {
				NativeNode unit = self.unqualifiedNative(inner.pointee);
				shaped = unit.kind == NNK_NATIVE_BUILTIN && unit.bits == 16 && unit.signedness == "unsigned";
			}
		}
		if (!shaped) { self.fail(f"copied-outputs {key}.{parameter} requires a mutable UTF-16 string pointer output"); }
		bool matches = false;
		bool voidResult = false;
		NativeNode? freeSignature = null;
		if (self.callbackExports.has(free) && self.callbackExports.get(free).kind == NNK_NATIVE_FUNCTION) {
			NativeNode exported = self.callbackExports.get(free);
			freeSignature = exported.signature;
		}
		if (freeSignature != null && !freeSignature.variadic && freeSignature.parameters.len == 1) {
			NativeNode accepted = freeSignature.parameters.get(0);
			NativeNode argument = self.unqualifiedNative(accepted);
			NativeNode result = self.unqualifiedNative(freeSignature.returnType);
			voidResult = result.kind == NNK_NATIVE_BUILTIN && result.name == "void";
			/* SysFreeString takes the BSTR itself; CoTaskMemFree any task-allocated block as void*. */
			if (free == "SysFreeString") { matches = self.typeIdentity(accepted) == self.typeIdentity(outer.pointee); }
			else if (argument.kind == NNK_NATIVE_POINTER) {
				NativeNode pointee = self.unqualifiedNative(argument.pointee);
				matches = pointee.kind == NNK_NATIVE_BUILTIN && pointee.name == "void" && !self.nativeIsConst(argument.pointee);
			}
			if (matches && voidResult) { self.requireQualifiedConvention(freeSignature); }
		}
		if (!matches || !voidResult) { self.fail(f"copied-outputs free {free} must take the string and return void"); }
		method.status = "throw";
		method.outputPosition = index;
		method.outputSpelling = self.realtimeNativeSpelling(outer.pointee);
		method.outputFree = free;
		Node text = self.node(NK_TYPE_EXPR); text.base = "string"; text.isNullable = true;
		method.returnType = text;
	}

	/* The generated class an owning output returns: its status, the adopted resource and any offset. */
	private void ownedOutputClass(string resultName, Node statusType, string resource, FeNativeOutputOffset? offset) {
		for existing in self.declarations { if (existing.declaration.name == resultName) { self.fail(f"conflicting owned-output result class '{resultName}'"); } }
		for existing in self.inputClasses { if (existing.declaration.name == resultName) { self.fail(f"conflicting owned-output result class '{resultName}'"); } }
		Node owner = self.node(NK_CLASS_DECL); owner.name = resultName; owner.sourceFile = self.module;
		Node statusField = self.node(NK_FIELD_DECL); statusField.name = "status"; statusField.access = "public"; statusField.type = statusType;
		Node valueField = self.node(NK_FIELD_DECL); valueField.name = "value"; valueField.access = "public";
		valueField.type = self.node(NK_TYPE_EXPR); valueField.type.base = resource; valueField.type.isNullable = true; valueField.type.pointerDepth = 1;
		owner.membersStorage = [statusField, valueField];
		if (offset != null) { Node field = self.node(NK_FIELD_DECL); field.name = offset.field; field.access = "public"; field.type = self.node(NK_TYPE_EXPR); field.type.base = "int"; owner.membersMut().push(field); }
		var generated = FeNativeImportedDeclaration(owner, self.module, self.header); generated.generatedInput = true;
		self.inputClasses.push(generated);
	}

	/* The argument at context-index takes the context field, or the object itself. */
	private void dispatchContext(string resourceName, FeNativeDispatchTable dispatch, NativeNode record, NativeNode signature, string what) {
		if (dispatch.contextIndex >= signature.parameters.len) { self.fail(f"resource {resourceName}: dispatch context-index is outside {what}"); }
		NativeNode argument = signature.parameters.get(dispatch.contextIndex);
		if (!dispatch.context.isEmpty()) { self.tableContextArgument(argument, what); return; }
		NativeNode pointer = self.unqualifiedNative(argument);
		NativeNode? pointee = pointer.kind == NNK_NATIVE_POINTER ? self.unqualifiedNative(pointer.pointee) : null;
		if (pointee == null || pointee.kind != NNK_NATIVE_RECORD_TYPE || pointee.identity != record.identity) { self.fail(f"resource {resourceName}: {what} must take the object at context-index"); }
	}

	/* Project each mapped slot of an SDK-owned table as a method of its unique
	 * owner. The object owns its table: every call reloads the table pointer
	 * and the slot and checks both for null, so a table swapped by the SDK is
	 * honored and nothing is cached (native-interop-ownership.md section 2.1). */
	private void projectDispatchTables(FeNativeBinding binding) {
		for name in binding.resources.keys() {
			FeNativeResourceBinding resource = binding.resources.get(name);
			FeNativeDispatchTable? selected = resource.dispatch;
			if (selected == null) { continue; }
			FeNativeDispatchTable dispatch = selected;
			NativeNode pointer = self.resourceTypes.get(name);
			NativeNode record = self.unqualifiedNative(pointer.pointee);
			if (!resource.storage.isEmpty() || record.kind != NNK_NATIVE_RECORD_TYPE || !self.layouts.has(record.identity) || self.layouts.get(record.identity).recordKind != "struct") { self.fail(f"resource {name}: dispatch requires a unique pointer resource over a complete SDK struct"); }
			Map<string, NativeNode> fields = {};
			for field in self.layouts.get(record.identity).fields { fields.put(field.name, field); }
			NativeNode? tableLayout = null;
			if (fields.has(dispatch.table)) {
				NativeNode tablePointer = self.unqualifiedNative(fields.get(dispatch.table).fieldType);
				if (tablePointer.kind == NNK_NATIVE_POINTER) {
					NativeNode tableRecord = self.unqualifiedNative(tablePointer.pointee);
					if (tableRecord.kind == NNK_NATIVE_RECORD_TYPE && self.layouts.has(tableRecord.identity) && self.layouts.get(tableRecord.identity).recordKind == "struct") { tableLayout = self.layouts.get(tableRecord.identity); }
				}
			}
			if (tableLayout == null) { self.fail(f"resource {name}: dispatch table {dispatch.table} must point to a complete SDK struct"); }
			if (!dispatch.context.isEmpty()) {
				if (!fields.has(dispatch.context)) { self.fail(f"resource {name}: dispatch context {dispatch.context} is not a field"); }
				self.tableContextArgument(fields.get(dispatch.context).fieldType, "dispatch context field");
			}
			string tableType = self.realtimeNativeSpelling(fields.get(dispatch.table).fieldType);
			Map<string, NativeNode> slots = {};
			for field in tableLayout.fields { slots.put(field.name, field); }
			var owner = self.resourceDeclaration(name);
			for index in range(dispatch.methodNames.len) {
				string method = dispatch.methodNames.get(index); string slot = dispatch.methodSlots.get(index);
				if (!slots.has(slot)) { self.fail(f"resource {name}: dispatch slot {slot} is not a table field"); }
				NativeNode field = slots.get(slot);
				NativeNode signature = self.tableFunctionType(field.fieldType, "dispatch method " + method);
				self.requireQualifiedConvention(signature);
				self.dispatchContext(name, dispatch, record, signature, "dispatch method " + method);
				NativeNode result = self.unqualifiedNative(signature.returnType);
				bool voidResult = result.kind == NNK_NATIVE_BUILTIN && result.name == "void";
				if (!voidResult && !self.realtimeScalar(signature.returnType)) { self.fail("dispatch methods require scalar or void results"); }
				Vector<string> names = field.callbackParameters.len > 0 ? self.semanticNames(field.callbackParameters) : [];
				var projected = FeNativeDispatchMethod(method, slot, self.callType(signature.returnType), self.realtimeNativeSpelling(signature.returnType), tableType);
				Vector<int> outputs = [];
				Vector<int> copies = [];
				for position in range(signature.parameters.len) {
					if (position == dispatch.contextIndex) { continue; }
					NativeNode native = signature.parameters.get(position);
					string borrowed = "";
					if (resource.ownership == "com") {
						/* Aggregation is never supported, so no call passes an outer IUnknown. */
						string parameterName = names.len > 0 ? names.get(position) : f"argument{position}";
						if (parameterName == "pUnkOuter") { self.fail(f"dispatch method {name}.{method}: COM aggregation is not supported; pUnkOuter must be hidden or null"); }
						/* A copied [out] string is hidden and returned as a BTRC string. */
						if (self.copiedOutputs.has(name + "." + method + "." + parameterName)) { copies.push(position); continue; }
						/* An [in] interface is borrowed for the call; an [out] IFoo**
						 * is adopted under a declared status form. */
						borrowed = self.resourceName(native);
						if (!borrowed.isEmpty() && self.resources.get(borrowed).ownership != "com") { borrowed = ""; }
						if (borrowed.isEmpty() && !self.comOutput(native).isEmpty()) { outputs.push(position); continue; }
					}
					Node value = borrowed.isEmpty() ? self.tableParameter(native, "dispatch method") : self.resourceCallType(native, borrowed);
					if (resource.ownership == "com") { projected.resources.push(borrowed); }
					projected.names.push(names.len > 0 ? names.get(position) : f"argument{position}");
					projected.parameters.push(value);
					projected.nativeParameters.push(self.realtimeNativeSpelling(native));
				}
				if (resource.ownership == "com") { self.comMethodStatus(name, projected, signature, names, outputs, copies); }
				Node member = self.node(NK_METHOD_DECL); member.access = "public"; member.name = method; member.returnType = projected.returnType;
				for index in range(projected.names.len) {
					Node parameter = self.node(NK_PARAM); parameter.name = projected.names.get(index); parameter.type = projected.parameters.get(index); member.paramsMut().push(parameter);
				}
				var contract = FeNativeCallContract(); contract.dispatchMethod = projected;
				owner.methods.put(method, contract);
				owner.declaration.membersMut().push(member);
			}
			if (!dispatch.releaseSlot.isEmpty()) {
				if (!slots.has(dispatch.releaseSlot)) { self.fail(f"resource {name}: dispatch release slot {dispatch.releaseSlot} is not a table field"); }
				NativeNode signature = self.tableFunctionType(slots.get(dispatch.releaseSlot).fieldType, "dispatch release");
				self.requireQualifiedConvention(signature);
				NativeNode result = self.unqualifiedNative(signature.returnType);
				if (signature.parameters.len != 1 || result.kind != NNK_NATIVE_BUILTIN || result.name != "void") { self.fail("dispatch release requires one object argument and a void result"); }
				self.dispatchContext(name, dispatch, record, signature, "dispatch release");
				Node voidType = self.node(NK_TYPE_EXPR); voidType.base = "void";
				var contract = FeNativeCallContract(); contract.dispatchMethod = FeNativeDispatchMethod("", dispatch.releaseSlot, voidType, "void", tableType);
				owner.methods.put("", contract);
			}
		}
	}

	/* The signature of a named slot of a COM resource's lpVtbl table. */
	private NativeNode comNamedSlot(string resource, string slot, string what) {
		NativeNode table = self.comTables.get(resource);
		for index in range(table.fields.len) {
			if (table.fields.get(index).name == slot && self.comSlotShaped(table, index, slot)) { return self.comSlotSignature(table, index); }
		}
		self.fail(f"{what}: slot {slot} is not a function pointer of {resource}'s table");
		return null;
	}

	/* Generate each COM sink: its handler interface and its registration
	 * factory (M2). The sink implements a selected `com` resource's table.
	 * Every slot after IUnknown's becomes a method of the BTRC handler
	 * interface, named by the slot with a lowercase first letter, and must
	 * return a 32-bit signed HRESULT. QueryInterface answers IID_IUnknown, the
	 * resource's IID and its bases'. `register` is the source's Advise(sink,
	 * cookie*) and `unregister` its Unadvise(cookie)
	 * (native-interop-ownership.md section 2.4). */
	private void projectComSinks(FeNativeBinding binding) {
		for sink in binding.comSinks {
			string what = "com-sinks " + sink.resource;
			NativeNode record = self.comRecords.get(sink.resource);
			NativeNode table = self.comTables.get(sink.resource);
			NativeNode first = self.comFirsts.get(sink.resource);
			FeNativeComInterface? selected = self.resourceDeclaration(sink.resource).methods.get("").comInterface;
			if (selected == null) { self.fail(f"{what}: the sink requires its com interface"); }
			FeNativeComInterface comInterface = selected;
			if (comInterface.unknownIid.isEmpty()) { self.fail(f"{what}: a com sink answers IID_IUnknown, which must be a read-only GUID global"); }
			NativeNode tableRecord = self.unqualifiedNative(self.unqualifiedNative(first.fieldType).pointee);
			if (tableRecord.tagName.isEmpty()) { self.fail(f"{what}: the sink's lpVtbl table must be a tagged struct"); }
			NativeNode query = self.comSlotSignature(table, 0);
			NativeNode addRef = self.comSlotSignature(table, 1);
			var projection = FeNativeComSink(sink.resource, sink.handler);
			Node handler = self.node(NK_INTERFACE_DECL); handler.name = sink.handler;
			for index in range(3, table.fields.len) {
				NativeNode field = table.fields.get(index);
				if (!self.comSlotShaped(table, index, field.name)) { self.fail(f"{what}: sink slot {field.name} is not a fixed-arity function pointer"); }
				NativeNode signature = self.comSlotSignature(table, index);
				self.requireQualifiedConvention(signature);
				string name = field.name.substring(0, 1).toLower() + field.name.substring(1, field.name.length() - 1);
				if (name == "queryInterface" || name == "addRef" || name == "release") { self.fail(f"{what}: sink method {field.name} collides with IUnknown"); }
				for existing in projection.methods { if (existing.name == name) { self.fail(f"{what}: sink methods {name} must have distinct names"); } }
				if (signature.parameters.len == 0 || !self.dispatchReceiver(signature.parameters.get(0), record)) { self.fail(f"{what}: sink method {field.name} must take the sink first"); }
				if (!self.comInteger(signature.returnType, "signed")) { self.fail(f"{what}: sink method {field.name} must return a 32-bit signed HRESULT"); }
				Vector<string> names = field.callbackParameters.len > 0 ? self.semanticNames(field.callbackParameters) : [];
				Node member = self.node(NK_METHOD_SIG); member.name = name;
				for position in range(1, signature.parameters.len) {
					Node parameter = self.node(NK_PARAM);
					parameter.type = self.tableParameter(signature.parameters.get(position), f"{what}: sink method {field.name}");
					parameter.name = names.len > 0 ? names.get(position) : f"argument{position}";
					member.paramsMut().push(parameter);
				}
				var method = FeNativeComSinkMethod(name, field.name, self.realtimeNativeSpelling(signature.returnType));
				for value in signature.parameters { method.nativeParameters.push(self.realtimeNativeSpelling(value)); }
				projection.methods.push(method);
				member.returnType = self.callType(signature.returnType);
				handler.methodsMut().push(member);
			}
			self.add(sink.handler, handler, "com-sink:" + sink.resource + ":" + self.typeIdentity(self.resourceTypes.get(sink.resource)));
			/* QueryInterface answers IID_IUnknown, the sink's IID and its bases'. */
			Vector<string> chain = [];
			projection.iids.push("IID_IUnknown");
			string current = sink.resource;
			while (!current.isEmpty()) {
				FeNativeResourceBinding link = binding.resources.get(current);
				chain.push(link.name);
				if (link.iid != "IID_IUnknown") { projection.iids.push(link.iid); }
				current = link.base;
			}
			/* Advise(sink, cookie*) and Unadvise(cookie) on the source. */
			var registerParts = Strings.split(sink.registerMethod, ".");
			string sourceName = registerParts.get(0);
			string registerName = registerParts.get(1);
			string unregisterName = Strings.split(sink.unregisterMethod, ".").get(1);
			var source = self.resourceDeclaration(sourceName);
			FeNativeDispatchMethod? registerSelected = source.methods.get(registerName).dispatchMethod;
			FeNativeDispatchMethod? unregisterSelected = source.methods.get(unregisterName).dispatchMethod;
			if (registerSelected == null || unregisterSelected == null) { self.fail(f"{what}: register and unregister require dispatched methods"); }
			FeNativeDispatchMethod registerMethod = registerSelected;
			FeNativeDispatchMethod unregisterMethod = unregisterSelected;
			Vector<int> sinks = [];
			for position in range(registerMethod.resources.len) { if (!registerMethod.resources.get(position).isEmpty()) { sinks.push(position); } }
			NativeNode advise = self.comNamedSlot(sourceName, registerMethod.slot, what);
			int cookieIndex = registerMethod.parameters.len == 2 && sinks.len == 1 ? 1 - sinks.get(0) : -1;
			bool registerShaped = registerMethod.outputPosition < 0 && cookieIndex >= 0;
			NativeNode cookieValue = advise.returnType;
			if (registerShaped) {
				NativeNode cookie = self.unqualifiedNative(advise.parameters.get(cookieIndex + 1));
				registerShaped = chain.contains(registerMethod.resources.get(sinks.get(0))) && cookie.kind == NNK_NATIVE_POINTER;
				if (registerShaped) {
					cookieValue = cookie.pointee;
					NativeNode unit = self.unqualifiedNative(cookie.pointee);
					registerShaped = unit.kind == NNK_NATIVE_BUILTIN && self.realtimeScalar(unit) && unit.name != "bool" && unit.name != "_Bool" && !self.nativeIsConst(cookie.pointee);
				}
			}
			if (!registerShaped || !self.comInteger(advise.returnType, "signed")) { self.fail(f"{what}: register {sink.registerMethod} must take the sink and a cookie pointer and return an HRESULT"); }
			NativeNode unadvise = self.comNamedSlot(sourceName, unregisterMethod.slot, what);
			bool unregisterShaped = unregisterMethod.parameters.len == 1 && unregisterMethod.outputPosition < 0 && unadvise.parameters.len == 2;
			for value in unregisterMethod.resources { if (!value.isEmpty()) { unregisterShaped = false; } }
			if (!unregisterShaped || self.typeIdentity(cookieValue) != self.typeIdentity(unadvise.parameters.get(1)) || !self.comInteger(unadvise.returnType, "signed")) { self.fail(f"{what}: unregister {sink.unregisterMethod} must take the register's cookie and return an HRESULT"); }
			FeNativeComInterface? sourceSelected = source.methods.get("").comInterface;
			if (sourceSelected == null) { self.fail(f"{what}: the source requires its com interface"); }
			FeNativeComInterface sourceInterface = sourceSelected;
			projection.nativeType = comInterface.nativeType;
			projection.tableType = comInterface.tableType;
			projection.tableRecord = "struct " + tableRecord.tagName;
			for value in query.parameters { projection.queryParameters.push(self.realtimeNativeSpelling(value)); }
			projection.countParameter = self.realtimeNativeSpelling(addRef.parameters.get(0));
			projection.countType = self.realtimeNativeSpelling(addRef.returnType);
			projection.statusType = comInterface.statusType;
			projection.source = sourceName;
			projection.sourceType = sourceInterface.nativeType;
			projection.sourceTable = sourceInterface.tableType;
			projection.registerMethod = registerName;
			projection.registerSlot = registerMethod.slot;
			projection.registerStatus = registerMethod.nativeReturn;
			projection.sinkPosition = sinks.get(0);
			projection.sinkSpelling = registerMethod.nativeParameters.get(sinks.get(0));
			projection.cookieType = self.realtimeNativeSpelling(cookieValue);
			projection.unregisterMethod = unregisterName;
			projection.unregisterSlot = unregisterMethod.slot;
			projection.unregisterStatus = unregisterMethod.nativeReturn;
			projection.activationFailure = sink.activationFailure;
			Node voidResult = self.node(NK_TYPE_EXPR); voidResult.base = "void";
			Node voidPointer = self.node(NK_TYPE_EXPR); voidPointer.base = "void"; voidPointer.pointerDepth = 1;
			/* CFunction<void, void*>, in the parser's exact callback spelling. */
			Node destroyType = self.node(NK_TYPE_EXPR); destroyType.base = "__fn_ptr"; destroyType.genericArgsStorage = [voidResult, voidPointer];
			Node token = self.node(NK_TYPE_EXPR); token.base = "OwnedClosure"; token.genericArgsStorage = [destroyType];
			Node receiver = self.node(NK_TYPE_EXPR); receiver.base = sink.handler;
			Node factory = self.node(NK_FUNCTION_DECL); factory.name = sink.name;
			factory.returnType = self.node(NK_TYPE_EXPR); factory.returnType.base = "CallbackContext"; factory.returnType.genericArgsStorage = [receiver, token];
			var contract = FeNativeCallContract(); contract.nonnullReturn = true; contract.comSink = projection;
			Vector<string> parameterNames = ["source", "receiver", "scope"];
			Vector<string> parameterTypes = [sourceName, sink.handler, "CallbackScope"];
			for index in range(3) {
				Node parameter = self.node(NK_PARAM); parameter.name = parameterNames.get(index);
				parameter.type = self.node(NK_TYPE_EXPR); parameter.type.base = parameterTypes.get(index);
				factory.paramsMut().push(parameter);
				contract.nonnullParameters.push(true); contract.readOnlyBorrows.push(false); contract.resourceParameters.push(""); contract.recordInputs.push(null);
			}
			self.add(sink.name, factory, "com-sink-factory:" + sink.resource, "", false, contract);
		}
	}

	private Vector<FeNativeCallbackProjection> projectCallbacks(NativeNode declaration) {
		Vector<FeNativeCallbackProjection> projections = [];
		Map<int, bool> occupied = {};
		string prefix = declaration.name + ".";
		Map<string, bool> known = {};
		for parameter in declaration.parameterSemantics { known.put(prefix + parameter.name, true); }
		for key in self.callbacks.keys() {
			if (key.startsWith(prefix) && !known.has(key)) { self.fail(f"callbacks names an unknown function parameter: {key}"); }
		}
		for index in range(declaration.parameterSemantics.len) {
			string key = declaration.name + "." + declaration.parameterSemantics.get(index).name;
			if (!self.callbacks.has(key)) { continue; }
			var binding = self.callbacks.get(key);
			if (binding.realtime != null) { continue; }
			self.callbacks.remove(key);
			if (!binding.actionParameter.isEmpty()) {
				if (occupied.has(index)) { self.fail("callback parameters must be distinct"); }
				occupied.put(index, true);
				projections.push(self.projectControlAction(declaration, binding, index));
				continue;
			}
			if (!binding.actionSetter.isEmpty()) {
				if (occupied.has(index)) { self.fail("callback parameters must be distinct"); }
				occupied.put(index, true);
				projections.push(self.projectAction(declaration, binding, index));
				continue;
			}
			if (binding.lifetime == "instantiated") {
				if (occupied.has(index)) { self.fail("callback parameters must be distinct"); }
				occupied.put(index, true);
				projections.push(self.projectInstantiated(declaration, binding, index));
				continue;
			}
			if (binding.methods.len > 0) {
				if (occupied.has(index)) { self.fail("callback parameters must be distinct"); }
				occupied.put(index, true);
				projections.push(self.projectDelegate(declaration, binding, index));
				continue;
			}
			NativeNode native = self.unqualifiedNative(declaration.signature.parameters.get(index));
			string recordName = "";
			Vector<NativeNode> recordContexts = [];
			if (!binding.field.isEmpty()) {
				if (native.kind != NNK_NATIVE_RECORD_TYPE || !self.layouts.has(native.identity)) { self.fail("callback field requires a complete by-value record parameter"); }
				NativeNode layout = self.layouts.get(native.identity);
				Map<string, NativeNode> fields = {};
				for field in layout.fields { fields.put(field.name, field.fieldType); }
				if (layout.recordKind != "struct" || !fields.has(binding.field)) { self.fail("callback field/context must identify fields of the native struct"); }
				if (binding.contexts.contains(binding.field)) { self.fail("callback field and context must be distinct"); }
				Vector<NativeNode> fieldTypes = [fields.get(binding.field)];
				for context in binding.contexts {
					if (!fields.has(context)) { self.fail("callback field/context must identify fields of the native struct"); }
					fieldTypes.push(fields.get(context));
					recordContexts.push(fields.get(context));
				}
				for fieldType in fieldTypes {
					NativeNode storage = fieldType;
					while (true) {
						if (storage.qualifiers.isConst || storage.qualifiers.isVolatile || storage.qualifiers.isRestrict) { self.fail("callback fields require assignable unqualified storage"); }
						if (storage.kind != NNK_NATIVE_ALIAS && storage.kind != NNK_NATIVE_QUALIFIED_TYPE) { break; }
						storage = storage.underlying;
					}
				}
				recordName = self.callType(declaration.signature.parameters.get(index)).base;
				native = self.unqualifiedNative(fields.get(binding.field));
			}
			bool isBlock = native.kind == NNK_NATIVE_OBJECTIVE_C_BLOCK;
			if (isBlock != (declaration.kind == NNK_NATIVE_OBJECTIVE_C_METHOD)) { self.fail("Objective-C method callbacks require block parameters"); }
			int contextIndex = -1;
			Vector<int> callbackContextIndices = binding.contextIndices;
			int callbackContextIndex = callbackContextIndices.len > 0 ? callbackContextIndices.get(0) : -1;
			NativeNode? signature = null;
			if (isBlock) {
				NativeNode qualified = declaration.signature.parameters.get(index);
				while (true) {
					if (qualified.qualifiers.isVolatile || qualified.qualifiers.isRestrict) { self.fail("unsupported Objective-C block qualifiers"); }
					string nullability = qualified.qualifiers.nullability;
					if (nullability != "unannotated" && nullability != "nullable" && nullability != "nonnull") { self.fail("unsupported Objective-C block nullability"); }
					if (qualified.kind != NNK_NATIVE_ALIAS && qualified.kind != NNK_NATIVE_QUALIFIED_TYPE) { break; }
					qualified = qualified.underlying;
				}
				if (binding.contexts.len > 0 || binding.contextIndices.len > 0) { self.fail("block context is compiler-owned; omit context/context-index"); }
				signature = self.unqualifiedNative(native.signature);
			} else {
				for position in range(binding.field.isEmpty() ? declaration.parameterSemantics.len : 0) {
					if (declaration.parameterSemantics.get(position).name != binding.contexts.get(0)) { continue; }
					if (contextIndex >= 0) { self.fail("callback context must identify one native parameter"); }
					contextIndex = position;
				}
				if (contextIndex < 0 && binding.field.isEmpty()) { self.fail("callback context must identify one native parameter"); }
				if (native.kind != NNK_NATIVE_POINTER) { self.fail("callback expected a nonvariadic function pointer"); }
				signature = self.unqualifiedNative(native.pointee);
			}
			bool storedC = binding.lifetime == "stored" && !isBlock;
			Vector<int> registrationContexts = [];
			if (storedC) {
				Vector<string> registrationNames = self.parameterNames(declaration);
				for context in binding.contexts {
					int found = -1;
					for position in range(registrationNames.len) {
						if (registrationNames.get(position) != context) { continue; }
						if (found >= 0) { self.fail("callback context must identify one native parameter"); }
						found = position;
					}
					if (found < 0) { self.fail("callback context must identify one native parameter"); }
					registrationContexts.push(found);
				}
			}
			if (index == contextIndex || occupied.has(index) || (contextIndex >= 0 && occupied.has(contextIndex))) { self.fail("callback and context parameters must be distinct and unshared"); }
			occupied.put(index, true);
			if (contextIndex >= 0) { occupied.put(contextIndex, true); }
			for position in registrationContexts {
				if (position == index || (position != contextIndex && occupied.has(position))) { self.fail("callback and context parameters must be distinct and unshared"); }
				occupied.put(position, true);
			}
			if (signature.kind != NNK_NATIVE_FUNCTION_TYPE || signature.variadic) { self.fail("callback expected a nonvariadic function pointer"); }
			if (isBlock) { callbackContextIndex = signature.parameters.len; callbackContextIndices = [callbackContextIndex]; }
			string contextSpelling = "";
			if (!isBlock) {
				Vector<NativeNode> contexts = [];
				if (!binding.field.isEmpty()) { contexts.extend(recordContexts); }
				else if (storedC) { for position in registrationContexts { contexts.push(declaration.signature.parameters.get(position)); } }
				else { contexts.push(declaration.signature.parameters.get(contextIndex)); }
				for position in callbackContextIndices {
					if (position < 0 || position >= signature.parameters.len) { self.fail("callback context-index is outside the native signature"); }
					contexts.push(signature.parameters.get(position));
				}
				string slotMessage = storedC ? "callback context must be an unqualified void pointer or a pointer-width integer" : "callback context must be an unqualified void pointer";
				for context in contexts {
					string spelling = "pointer";
					if (storedC && self.pointerWidthInteger(context)) {
						/* Slots may spell different typedefs of one integer
						 * (UINT_PTR, DWORD_PTR); conversions use the shared type. */
						spelling = self.unqualifiedNative(context).name;
					} else {
						NativeNode pointer = self.unqualifiedNative(context);
						if (pointer.kind != NNK_NATIVE_POINTER) { self.fail(slotMessage); }
						NativeNode pointee = self.unqualifiedNative(pointer.pointee);
						if (pointee.kind != NNK_NATIVE_BUILTIN || pointee.name != "void" || pointee.qualifiers.isConst) { self.fail(slotMessage); }
					}
					if (!contextSpelling.isEmpty() && spelling != contextSpelling) { self.fail("callback context slots must share one type"); }
					contextSpelling = spelling;
				}
			}
			NativeNode result = self.unqualifiedNative(signature.returnType);
			bool objectResult = isBlock && result.kind == NNK_NATIVE_OBJECTIVE_C_OBJECT;
			if (objectResult && binding.lifetime != "stored") { self.fail("object callback results require a stored Objective-C block"); }
			if (!objectResult && result.kind != NNK_NATIVE_BUILTIN && result.kind != NNK_NATIVE_ENUM_TYPE) { self.fail("callback non-scalar results require an ownership mapping"); }
			var projection = FeNativeCallbackProjection(binding.interfaceName, index, contextIndex, callbackContextIndex, objectResult ? self.objectiveCType(signature.returnType) : isBlock ? self.objectiveCScalar(signature.returnType) : self.callType(signature.returnType));
			projection.field = binding.field;
			projection.record = recordName;
			if (!binding.field.isEmpty()) { projection.contextFields = binding.contexts; }
			projection.callbackContextIndices = callbackContextIndices;
			if (binding.lifetime == "one-shot") {
				NativeNode nativeResult = self.unqualifiedNative(declaration.signature.returnType);
				if (isBlock && declaration.parameterSemantics.get(index).noEscape) { self.fail("one-shot requires an escaping Objective-C block"); }
				if (result.kind != NNK_NATIVE_BUILTIN || result.name != "void") { self.fail(isBlock ? "one-shot currently requires void native and callback results" : "one-shot currently requires void callback results"); }
				if (isBlock) {
					if (nativeResult.kind != NNK_NATIVE_BUILTIN || nativeResult.name != "void") { self.fail("one-shot currently requires void native and callback results"); }
				} else { self.requireCompletionValue(declaration.signature.returnType); }
				projection.oneShot = true;
				projection.activationFailure = binding.activationFailure;
			}
			if (storedC) {
				projection.registrationContexts = registrationContexts;
				projection.contextSpelling = contextSpelling;
				projection.registrationStatus = binding.registrationStatus;
				projection.unregisterStatus = binding.unregisterStatus;
				projection.activationFailure = binding.activationFailure;
				self.storedCUnregister(declaration, binding, index, registrationContexts, projection);
			} else if (binding.lifetime == "stored") {
				if (!isBlock || declaration.parameterSemantics.get(index).noEscape) { self.fail("stored callbacks require an escaping Objective-C block"); }
				if (!self.callbackExports.has(binding.unregister)) { self.fail("stored callback unregister must be a selected instance method"); }
				NativeNode unregister = self.callbackExports.get(binding.unregister);
				if (unregister.kind != NNK_NATIVE_OBJECTIVE_C_METHOD || unregister.signature.variadic || unregister.signature.parameters.len > 1) { self.fail("stored callback unregister must be a method with at most one token argument"); }
				NativeNode cancelled = self.unqualifiedNative(unregister.signature.returnType);
				if (cancelled.kind != NNK_NATIVE_BUILTIN || cancelled.name != "void" || unregister.consumesSelf) { self.fail("stored callback unregister must return void without consuming its receiver"); }
				for parameter in unregister.parameterSemantics { if (parameter.cfConsumed || parameter.nsConsumed) { self.fail("stored callback unregister requires a non-consuming token"); } }
				NativeNode token = self.unqualifiedNative(declaration.signature.returnType);
				string owner = declaration.relatedResult ? declaration.receiver : token.name;
				if (token.kind != NNK_NATIVE_OBJECTIVE_C_OBJECT) { self.fail("stored callback requires a native object cancellation token"); }
				if (unregister.signature.parameters.len == 1) {
					self.objectiveCType(unregister.signature.parameters.get(0), true);
					NativeNode argument = self.unqualifiedNative(unregister.signature.parameters.get(0));
					if (declaration.classMethod != unregister.classMethod || declaration.receiver != unregister.receiver || argument.kind != NNK_NATIVE_OBJECTIVE_C_OBJECT || argument.classObject || argument.protocols.len > 0 || argument.typeArguments.len > 0 || (argument.name != owner && argument.name != "id" && !argument.name.isEmpty())) { self.fail("stored callback unregister must accept the token on its registration receiver"); }
				} else if (unregister.classMethod || !declaration.classMethod || owner != unregister.receiver) { self.fail("stored callback factory must return the unregister receiver type"); }
				projection.unregister = unregister;
				projection.activationFailure = binding.activationFailure;
			}
			if (binding.executor == "main" && (!isBlock || binding.lifetime != "stored")) { self.fail(f"callback {binding.parameter}: executor main requires a stored Objective-C block"); }
			projection.mainExecutor = binding.executor == "main";
			Node method = self.node(NK_METHOD_SIG);
			method.name = "invoke";
			method.returnType = projection.returnType;
			for position in binding.ownedArguments {
				if (position >= signature.parameters.len || callbackContextIndices.contains(position)) { self.fail("callback owned-arguments must identify resource payload parameters"); }
				if (self.resourceName(signature.parameters.get(position)).isEmpty()) { self.fail("callback owned-arguments requires a declared native resource"); }
			}
			projection.ownedArguments = binding.ownedArguments;
			string identity = "callback-interface:" + self.typeIdentity(signature.returnType);
			for position in range(signature.parameters.len) {
				Node parameter = self.node(NK_PARAM);
				parameter.name = f"argument{method.params().len}";
				if (callbackContextIndices.contains(position)) {
					if (!contextSpelling.isEmpty() && contextSpelling != "pointer") { parameter.type = self.callType(signature.parameters.get(position), true); }
					else {
						parameter.type = self.node(NK_TYPE_EXPR);
						parameter.type.base = "void";
						parameter.type.pointerDepth = 1;
					}
				} else {
					NativeNode scalar = self.unqualifiedNative(signature.parameters.get(position));
					if (storedC && self.opaqueHandle(signature.parameters.get(position))) {
						/* Borrowed for the call: BTRC can neither dereference nor own it. */
						parameter.type = self.callType(signature.parameters.get(position), true);
					} else if (scalar.kind == NNK_NATIVE_RECORD_TYPE && self.stringViews.has(scalar.identity)) {
						if (isBlock || binding.lifetime != "one-shot") { self.fail("string-views currently requires a C one-shot callback"); }
						projection.stringArguments.put(position, self.stringViews.get(scalar.identity));
						self.usedStringViews.put(scalar.identity, true);
						parameter.type = self.node(NK_TYPE_EXPR);
						parameter.type.base = "string";
					} else if (binding.ownedArguments.contains(position)) {
						parameter.type = self.resourceCallType(signature.parameters.get(position));
					} else if (isBlock && scalar.kind == NNK_NATIVE_OBJECTIVE_C_OBJECT) {
						parameter.type = self.objectiveCType(signature.parameters.get(position), true);
					}
					else {
						if (scalar.kind != NNK_NATIVE_BUILTIN && scalar.kind != NNK_NATIVE_ENUM_TYPE) { self.fail("callback non-scalar arguments require a borrow mapping"); }
						parameter.type = isBlock ? self.objectiveCScalar(signature.parameters.get(position)) : self.callType(signature.parameters.get(position), true);
					}
					method.paramsMut().push(parameter);
					identity = identity + ":" + self.typeIdentity(signature.parameters.get(position));
				}
				projection.parameters.push(parameter.type);
			}
			if (isBlock) {
				Node context = self.node(NK_TYPE_EXPR);
				context.base = "void";
				context.pointerDepth = 1;
				projection.parameters.push(context);
				for parameter in signature.parameters { projection.nativeParameters.push(self.blockTypeSpelling(parameter)); }
				projection.nativeReturn = self.blockTypeSpelling(signature.returnType);
			}
			Node projectedInterface = self.node(NK_INTERFACE_DECL);
			projectedInterface.name = binding.interfaceName;
			projectedInterface.methodsMut().push(method);
			self.add(binding.interfaceName, projectedInterface, identity);
			projections.push(projection);
		}
		return projections;
	}

	/* An unqualified, non-enum integer of the target's pointer width (uintptr_t, DWORD_PTR). */
	private bool pointerWidthInteger(NativeNode native) {
		if (native.qualifiers.isConst || native.qualifiers.isVolatile) { return false; }
		NativeNode scalar = self.unqualifiedNative(native);
		return scalar.kind == NNK_NATIVE_BUILTIN && !["bool", "_Bool", "char", "signed char", "unsigned char", "float", "double"].contains(scalar.name) && (scalar.signedness == "signed" || scalar.signedness == "unsigned") && scalar.bits == self.pointerBits;
	}

	/* A pointer to an SDK record reached only through pointers (HWND, ALooper*). */
	private bool opaqueHandle(NativeNode native) {
		NativeNode pointer = self.unqualifiedNative(native);
		if (pointer.kind != NNK_NATIVE_POINTER) { return false; }
		NativeNode record = self.unqualifiedNative(pointer.pointee);
		return record.kind == NNK_NATIVE_RECORD_TYPE && (record.opaque || !record.complete);
	}

	/* Check a stored C registration's unregister call and how each argument is
	 * supplied. Each unregister parameter repeats the registration parameter of
	 * the same name and type: the callback becomes the same generated function,
	 * a context slot the same context, and any other parameter a value the
	 * registration captures (`captured-handles`). */
	private void storedCUnregister(NativeNode declaration, FeNativeCallbackBinding binding, int index, Vector<int> registrationContexts, FeNativeCallbackProjection projection) {
		if (declaration.parameterSemantics.get(index).noEscape) { self.fail("a stored C registration requires an escaping callback parameter"); }
		if (!self.callbackExports.has(binding.unregister) || self.callbackExports.get(binding.unregister).kind != NNK_NATIVE_FUNCTION || self.callbackExports.get(binding.unregister).signature.variadic) { self.fail("stored C registration unregister requires a selected C function"); }
		NativeNode unregister = self.callbackExports.get(binding.unregister);
		self.requireQualifiedConvention(unregister.signature);
		Vector<NativeNode> functions = [declaration, unregister];
		Vector<string> statuses = [binding.registrationStatus, binding.unregisterStatus];
		Vector<string> keys = ["registration-status", "unregister-status"];
		for position in range(2) {
			NativeNode operation = functions.get(position);
			NativeNode result = self.unqualifiedNative(operation.signature.returnType);
			bool isVoid = result.kind == NNK_NATIVE_BUILTIN && result.name == "void";
			bool integral = !isVoid && (result.kind == NNK_NATIVE_ENUM_TYPE || (result.kind == NNK_NATIVE_BUILTIN && (result.signedness == "signed" || result.signedness == "unsigned")));
			string status = statuses.get(position);
			if ((isVoid && !status.isEmpty()) || (integral && status.isEmpty()) || !(isVoid || integral)) { self.fail(f"{operation.name}: {keys.get(position)} must describe an integral result, or be omitted for void"); }
			if (operation.returnedOwnership != "unspecified") { self.fail(f"{operation.name}: stored C registrations require non-consuming functions"); }
			for parameter in operation.parameterSemantics { if (parameter.cfConsumed || parameter.nsConsumed) { self.fail(f"{operation.name}: stored C registrations require non-consuming functions"); } }
		}
		Vector<string> names = self.parameterNames(declaration);
		Vector<string> unregisterNames = self.parameterNames(unregister);
		Map<string, bool> captured = {};
		for position in range(unregisterNames.len) {
			string name = unregisterNames.get(position);
			int source = -1;
			for candidate in range(names.len) { if (names.get(candidate) == name) { source = candidate; } }
			if (source < 0) { self.fail(f"unregister parameter {name} must repeat a registration parameter"); }
			if (self.typeIdentity(unregister.signature.parameters.get(position)) != self.typeIdentity(declaration.signature.parameters.get(source))) { self.fail(f"unregister parameter {name} must have its registration parameter's type"); }
			if (source == index) { projection.unregisterArguments.push("callback"); }
			else if (registrationContexts.contains(source)) { projection.unregisterArguments.push("context"); }
			else {
				if (!binding.capturedHandles.contains(name)) { self.fail(f"unregister parameter {name} must be listed in captured-handles"); }
				NativeNode native = declaration.signature.parameters.get(source);
				NativeNode scalar = self.unqualifiedNative(native);
				if (!self.opaqueHandle(native) && scalar.kind != NNK_NATIVE_BUILTIN && scalar.kind != NNK_NATIVE_ENUM_TYPE) { self.fail(f"captured-handles.{name} must be a scalar or an opaque handle"); }
				captured.put(name, true);
				projection.unregisterArguments.push(f"captured:{source}");
			}
		}
		for name in binding.capturedHandles { if (!captured.has(name)) { self.fail("captured-handles must name registration parameters the unregister call takes"); } }
		projection.unregister = unregister;
		projection.registrationResult = self.callType(declaration.signature.returnType);
		projection.unregisterResult = self.callType(unregister.signature.returnType);
	}

	private FeNativeCallbackProjection projectAction(NativeNode declaration, FeNativeCallbackBinding binding, int index) {
		if (!self.callbackExports.has(binding.slotGetter) || !self.callbackExports.has(binding.actionSetter) || !self.callbackExports.has(binding.actionGetter)) { self.fail("action binding requires selected target/action accessors"); }
		NativeNode getter = self.callbackExports.get(binding.slotGetter);
		NativeNode setter = self.callbackExports.get(binding.actionSetter);
		NativeNode actionGetter = self.callbackExports.get(binding.actionGetter);
		Vector<NativeNode> operations = [declaration, getter, setter, actionGetter];
		Vector<int> arities = [1, 0, 1, 0];
		Map<string, bool> names = {};
		for position in range(operations.len) {
			NativeNode operation = operations.get(position);
			if (index != 0 || operation.kind != NNK_NATIVE_OBJECTIVE_C_METHOD || operation.classMethod || operation.protocolOwner || operation.optional || operation.receiver != declaration.receiver || operation.signature.variadic || operation.signature.parameters.len != arities.get(position) || operation.consumesSelf || operation.returnsInnerPointer || operation.returnedOwnership != "unspecified" || names.has(operation.name)) { self.fail("action binding requires distinct non-consuming instance target/action accessors"); }
			names.put(operation.name, true);
			for parameter in operation.parameterSemantics { if (parameter.cfConsumed || parameter.nsConsumed) { self.fail("action accessors must not consume their parameters"); } }
		}
		if (self.objectiveCScalar(declaration.signature.returnType).base != "void" || self.objectiveCScalar(setter.signature.returnType).base != "void") { self.fail("action setters must return void"); }
		for native in [declaration.signature.parameters.get(0), getter.signature.returnType] {
			NativeNode value = self.unqualifiedNative(native);
			if (value.kind != NNK_NATIVE_OBJECTIVE_C_OBJECT || (!value.name.isEmpty() && value.name != "id") || value.protocols.len > 0 || value.classObject || value.typeArguments.len > 0 || self.callNullability(native) != "nullable") { self.fail("action target requires nullable id setter and getter"); }
			self.objectiveCType(native, false, "", false, true);
		}
		for native in [setter.signature.parameters.get(0), actionGetter.signature.returnType] {
			NativeNode value = self.unqualifiedNative(native);
			if (value.kind != NNK_NATIVE_POINTER || value.pointee.kind != NNK_NATIVE_BUILTIN || value.pointee.name != "SEL" || self.callNullability(native) != "nullable") { self.fail("action selector requires nullable SEL setter and getter"); }
		}
		Node returnType = self.node(NK_TYPE_EXPR);
		returnType.base = "void";
		Node signature = self.node(NK_METHOD_SIG);
		signature.name = "invoke";
		signature.returnType = returnType;
		Node projectedInterface = self.node(NK_INTERFACE_DECL);
		projectedInterface.name = binding.interfaceName;
		projectedInterface.methodsStorage = [signature];
		self.add(binding.interfaceName, projectedInterface, "action-interface");
		var projection = FeNativeCallbackProjection(binding.interfaceName, index, -1, -1, returnType);
		projection.unregister = declaration;
		projection.activationFailure = binding.activationFailure;
		projection.slotGetter = getter;
		projection.actionSetter = setter;
		projection.actionGetter = actionGetter;
		var invocation = FeNativeCallbackProjection(binding.interfaceName, index, -1, 0, returnType);
		Node context = self.node(NK_TYPE_EXPR);
		context.base = "void";
		context.pointerDepth = 1;
		invocation.parameters = [context];
		invocation.nativeReturn = "void";
		projection.delegateMethods = [invocation];
		return projection;
	}

	/* A control that keeps any number of target/action pairs (UIKit's
	 * addTarget:action:forControlEvents:). The remove call repeats every
	 * registration parameter by name; the compiler supplies the selector. */
	private FeNativeCallbackProjection projectControlAction(NativeNode declaration, FeNativeCallbackBinding binding, int index) {
		if (!self.callbackExports.has(binding.unregister)) { self.fail("control action requires void instance add and remove methods with the same parameters"); }
		NativeNode unregister = self.callbackExports.get(binding.unregister);
		Vector<string> names = [];
		for parameter in declaration.parameterSemantics { names.push(parameter.name); }
		bool valid = declaration.kind == NNK_NATIVE_OBJECTIVE_C_METHOD && unregister.kind == NNK_NATIVE_OBJECTIVE_C_METHOD && unregister.receiver == declaration.receiver && unregister.name != declaration.name && unregister.parameterSemantics.len == names.len;
		for operation in [declaration, unregister] {
			if (!valid) { break; }
			if (operation.classMethod || operation.protocolOwner || operation.optional || operation.signature.variadic || operation.consumesSelf || operation.returnsInnerPointer || operation.returnedOwnership != "unspecified" || self.objectiveCScalar(operation.signature.returnType).base != "void") { valid = false; }
			for parameter in operation.parameterSemantics { if (parameter.cfConsumed || parameter.nsConsumed) { valid = false; } }
		}
		if (valid) { for position in range(names.len) { if (unregister.parameterSemantics.get(position).name != names.get(position)) { valid = false; } } }
		if (!valid) { self.fail("control action requires void instance add and remove methods with the same parameters"); }
		int actionIndex = names.indexOf(binding.actionParameter);
		if (actionIndex < 0 || actionIndex == index) { self.fail("control action-parameter must name the registration's selector parameter"); }
		for operation in [declaration, unregister] {
			NativeNode target = self.unqualifiedNative(operation.signature.parameters.get(index));
			if (target.kind != NNK_NATIVE_OBJECTIVE_C_OBJECT || (!target.name.isEmpty() && target.name != "id") || target.protocols.len > 0 || target.classObject || target.typeArguments.len > 0 || self.callNullability(operation.signature.parameters.get(index)) != "nullable") { self.fail("control action target requires nullable id"); }
			self.objectiveCType(operation.signature.parameters.get(index), false, "", false, true);
			NativeNode action = self.unqualifiedNative(operation.signature.parameters.get(actionIndex));
			if (action.kind != NNK_NATIVE_POINTER || action.pointee.kind != NNK_NATIVE_BUILTIN || action.pointee.name != "SEL") { self.fail("control action-parameter requires SEL"); }
		}
		Vector<int> captured = [];
		Map<string, bool> capturedNames = {};
		for position in range(names.len) {
			if (position == index || position == actionIndex) { continue; }
			string name = names.get(position);
			if (!binding.capturedHandles.contains(name)) { self.fail(f"control action parameter {name} must be listed in captured-handles"); }
			NativeNode native = declaration.signature.parameters.get(position);
			if (self.typeIdentity(native) != self.typeIdentity(unregister.signature.parameters.get(position))) { self.fail(f"unregister parameter {name} must repeat the registration's type"); }
			NativeNode scalar = self.unqualifiedNative(native);
			if (scalar.kind != NNK_NATIVE_BUILTIN && scalar.kind != NNK_NATIVE_ENUM_TYPE) { self.fail(f"captured-handles.{name} must be a scalar"); }
			captured.push(position);
			capturedNames.put(name, true);
		}
		for name in binding.capturedHandles { if (!capturedNames.has(name)) { self.fail("captured-handles must name registration parameters the unregister call takes"); } }
		Node returnType = self.node(NK_TYPE_EXPR);
		returnType.base = "void";
		Node signature = self.node(NK_METHOD_SIG);
		signature.name = "invoke";
		signature.returnType = returnType;
		Node projectedInterface = self.node(NK_INTERFACE_DECL);
		projectedInterface.name = binding.interfaceName;
		projectedInterface.methodsStorage = [signature];
		self.add(binding.interfaceName, projectedInterface, "action-interface");
		var projection = FeNativeCallbackProjection(binding.interfaceName, index, -1, -1, returnType);
		projection.unregister = unregister;
		projection.activationFailure = binding.activationFailure;
		projection.controlActionIndex = actionIndex;
		projection.capturedPositions = captured;
		var invocation = FeNativeCallbackProjection(binding.interfaceName, index, -1, 0, returnType);
		Node context = self.node(NK_TYPE_EXPR);
		context.base = "void";
		context.pointerDepth = 1;
		invocation.parameters = [context];
		invocation.nativeReturn = "void";
		projection.delegateMethods = [invocation];
		return projection;
	}

	private FeNativeCallbackProjection projectDelegate(NativeNode declaration, FeNativeCallbackBinding binding, int index) {
		if (!self.callbackExports.has(binding.slotGetter)) { self.fail("delegate slot requires a selected getter"); }
		NativeNode getter = self.callbackExports.get(binding.slotGetter);
		if (declaration.kind != NNK_NATIVE_OBJECTIVE_C_METHOD || declaration.classMethod || index != 0 || declaration.signature.parameters.len != 1 || self.objectiveCScalar(declaration.signature.returnType).base != "void" || getter.kind != NNK_NATIVE_OBJECTIVE_C_METHOD || getter.classMethod || getter.optional || getter.signature.parameters.len != 0 || getter.signature.variadic || getter.receiver != declaration.receiver || getter.consumesSelf || getter.returnsInnerPointer || getter.returnedOwnership != "unspecified") { self.fail("delegate slot requires an instance void setter and matching non-consuming getter"); }
		NativeNode argument = self.unqualifiedNative(declaration.signature.parameters.get(0));
		NativeNode result = self.unqualifiedNative(getter.signature.returnType);
		if (argument.kind != NNK_NATIVE_OBJECTIVE_C_OBJECT || (!argument.name.isEmpty() && argument.name != "id") || argument.classObject || argument.typeArguments.len > 0 || argument.protocols.len != 1 || result.kind != NNK_NATIVE_OBJECTIVE_C_OBJECT || self.typeIdentity(argument) != self.typeIdentity(result) || !self.objectiveCType(declaration.signature.parameters.get(0), false, "", false, true).isNullable || !self.objectiveCType(getter.signature.returnType, false, "", false, true).isNullable) { self.fail("delegate slot requires matching nullable id<Protocol> setter and getter"); }
		var projection = FeNativeCallbackProjection(binding.interfaceName, index, -1, -1, self.objectiveCScalar(declaration.signature.returnType));
		projection.unregister = declaration;
		projection.activationFailure = binding.activationFailure;
		projection.slotGetter = getter;
		projection.delegateProtocol = argument.protocols.get(0);
		Vector<NativeNode> noOverrides = [];
		self.protocolMethods(binding, index, projection, false, noOverrides);
		return projection;
	}

	/* The SDK instantiates a generated adapter class from its name or its class
	 * object. With scope = "process" the NSString class-name parameter of a C
	 * entry (UIApplicationMain) names the class. With scope = "instance" the
	 * Class parameter of a void Objective-C instance method
	 * (-[UISceneConfiguration setDelegateClass:]) receives it, and BTRC passes
	 * I<Interface>Factory, a generated interface whose create() supplies each
	 * instance's receiver.
	 *
	 * Either form may extend an SDK class (`superclass`, such as a
	 * UIResponder app delegate). Its instance overrides join the receiver
	 * interface after the protocol methods; class overrides join the factory,
	 * so only the instance form takes them. */
	private FeNativeCallbackProjection projectInstantiated(NativeNode declaration, FeNativeCallbackBinding binding, int index) {
		NativeNode argument = self.unqualifiedNative(declaration.signature.parameters.get(index));
		Node voidType = self.node(NK_TYPE_EXPR);
		voidType.base = "void";
		Vector<NativeNode> instanceOverrides = [];
		Vector<NativeNode> classOverrides = [];
		if (binding.scope == "instance") {
			NativeNode result = self.unqualifiedNative(declaration.signature.returnType);
			if (declaration.kind != NNK_NATIVE_OBJECTIVE_C_METHOD || declaration.classMethod || declaration.signature.parameters.len != 1 || result.kind != NNK_NATIVE_BUILTIN || result.name != "void" || argument.kind != NNK_NATIVE_OBJECTIVE_C_OBJECT || !argument.classObject || argument.protocols.len > 0 || argument.typeArguments.len > 0) { self.fail("instance-scoped instantiated adapters require a Class parameter of a void Objective-C instance method"); }
			if (!binding.superclass.isEmpty()) { self.superclassOverrides(binding, instanceOverrides, classOverrides); }
			var instance = FeNativeCallbackProjection(binding.interfaceName, index, -1, -1, voidType);
			instance.instantiatedScope = binding.scope;
			self.protocolMethods(binding, index, instance, true, instanceOverrides);
			self.instantiatedTerminal(binding, instance);
			self.instantiatedFactory(binding, instance, classOverrides);
			instance.superclass = binding.superclass;
			return instance;
		}
		if (declaration.kind != NNK_NATIVE_FUNCTION || argument.kind != NNK_NATIVE_OBJECTIVE_C_OBJECT || argument.name != "NSString" || argument.protocols.len > 0 || argument.classObject || argument.typeArguments.len > 0) { self.fail("instantiated adapters require an NSString class-name parameter of a C function"); }
		if (!binding.superclass.isEmpty()) { self.superclassOverrides(binding, instanceOverrides, classOverrides); }
		/* The process form has no factory to answer a class method. */
		if (classOverrides.len > 0) { self.fail(f"class-method overrides require an instance-scoped adapter: {classOverrides.get(0).name}"); }
		var projection = FeNativeCallbackProjection(binding.interfaceName, index, -1, -1, voidType);
		projection.instantiatedScope = binding.scope;
		self.protocolMethods(binding, index, projection, true, instanceOverrides);
		projection.superclass = binding.superclass;
		return projection;
	}

	private string callbackMethodName(FeNativeCallbackBinding binding, NativeNode method) {
		if (!binding.methodNames.has(method.name)) { return Strings.split(method.selector, ":").get(0); }
		string name = binding.methodNames.get(method.name);
		if (!self.grammar.vocabulary.keywordToken(name).isEmpty() || name.startsWith("__") || (name.length() > 1 && name[0] == '_' && name[1] >= 'A' && name[1] <= 'Z')) { self.fail(f"callback method-names requires a nonreserved BTRC identifier: {name}"); }
		return name;
	}

	/* Project the selected protocol methods into the binding's interface. Each
	 * is a non-consuming instance requirement of the projection's protocol; an
	 * empty protocol takes the first method's. Instantiated adapters may also
	 * return managed Objective-C objects (`objectResults`): the receiver's
	 * claim is transferred to the SDK. A subclass adapter's checked instance
	 * `overrides` join the same interface after the protocol methods. */
	private void protocolMethods(FeNativeCallbackBinding binding, int index, FeNativeCallbackProjection projection, bool objectResults, Vector<NativeNode> overrides) {
		Node projectedInterface = self.node(NK_INTERFACE_DECL);
		projectedInterface.name = binding.interfaceName;
		Map<string, bool> names = {};
		string identity = "delegate-interface";
		Vector<NativeNode> selected = [];
		for symbol in binding.methods {
			if (!self.callbackExports.has(symbol)) { self.fail(f"delegate method not selected: {symbol}"); }
			NativeNode method = self.callbackExports.get(symbol);
			if (projection.delegateProtocol.isEmpty() && method.kind == NNK_NATIVE_OBJECTIVE_C_METHOD && method.protocolOwner) { projection.delegateProtocol = method.receiver; }
			if (method.kind != NNK_NATIVE_OBJECTIVE_C_METHOD || !method.protocolOwner || method.receiver != projection.delegateProtocol || method.classMethod || method.signature.variadic || method.consumesSelf || method.returnsInnerPointer || method.returnedOwnership != "unspecified") { self.fail(f"delegate method requires a non-consuming instance method of {projection.delegateProtocol}: {symbol}"); }
			for parameter in method.parameterSemantics { if (parameter.cfConsumed || parameter.nsConsumed) { self.fail("delegate method parameters must not consume"); } }
			selected.push(method);
		}
		selected.extend(overrides);
		for method in selected {
			string name = self.callbackMethodName(binding, method);
			if (names.has(name)) { self.fail(f"ambiguous delegate method projection: {name}"); }
			names.put(name, true);
			Node returnType = objectResults && self.unqualifiedNative(method.signature.returnType).kind == NNK_NATIVE_OBJECTIVE_C_OBJECT ? self.objectiveCType(method.signature.returnType) : self.objectiveCScalar(method.signature.returnType);
			var callback = FeNativeCallbackProjection(binding.interfaceName, index, -1, method.signature.parameters.len, returnType);
			callback.methodName = name;
			callback.nativeMethod = method;
			callback.nativeReturn = self.blockTypeSpelling(method.signature.returnType);
			Node signature = self.node(NK_METHOD_SIG);
			signature.name = name;
			signature.returnType = returnType;
			for position in range(method.signature.parameters.len) {
				NativeNode parameter = method.signature.parameters.get(position);
				Node value = self.objectiveCType(parameter, true);
				callback.parameters.push(value);
				callback.nativeParameters.push(self.blockTypeSpelling(parameter));
				Node projected = self.node(NK_PARAM);
				projected.name = f"argument{position}";
				projected.type = value;
				signature.paramsMut().push(projected);
			}
			Node context = self.node(NK_TYPE_EXPR);
			context.base = "void";
			context.pointerDepth = 1;
			callback.parameters.push(context);
			projectedInterface.methodsMut().push(signature);
			projection.delegateMethods.push(callback);
			identity = identity + ":" + method.name + ":" + name + ":" + self.typeIdentity(method.signature);
		}
		self.add(binding.interfaceName, projectedInterface, identity);
	}

	private string blockTypeSpelling(NativeNode native) {
		while (native.kind == NNK_NATIVE_QUALIFIED_TYPE) { native = native.underlying; }
		if (native.kind == NNK_NATIVE_BUILTIN || native.kind == NNK_NATIVE_ALIAS) { return native.name; }
		if (native.kind == NNK_NATIVE_OBJECTIVE_C_OBJECT) {
			/* The SDK's own type arguments, so a generated implementation
			 * matches its declaration although BTRC erases them. */
			string arguments = "";
			if (native.typeArguments.len > 0) {
				Vector<string> spelled = [];
				for value in native.typeArguments { spelled.push(self.blockTypeSpelling(value)); }
				arguments = "<" + Strings.join(spelled, ", ") + ">";
			}
			return native.name.isEmpty() || native.name == "id" ? "id" : native.name + arguments + "*";
		}
		if (native.kind == NNK_NATIVE_ENUM_TYPE && !native.name.isEmpty()) { return "enum " + native.name; }
		self.fail("anonymous native block scalar requires a named SDK type");
		return "";
	}

	/* The C++ standard library belongs to the adapter toolchain, not the SDK sysroot. The same
	 * Clang driver that later builds the generated C++ unit reports the directories it searches;
	 * the header reader must see identical headers. BTRC_NATIVE_CXX names that driver. */
	private Vector<string> cxxToolchainIncludes(string standard, string target, string sysroot) {
		Vector<string> compiler = [];
		for part in Strings.split(Environment.get("BTRC_NATIVE_CXX", ""), " ") { if (!part.isEmpty()) { compiler.push(part); } }
		if (compiler.len == 0) { compiler.push("clang++"); }
		string spelled = Strings.join(compiler, " ");
		string key = spelled + "\x1f" + standard + "\x1f" + target + "\x1f" + sysroot;
		if (self.cxxToolchainIncludeCache.has(key)) { return self.cxxToolchainIncludeCache.get(key); }
		Vector<string> arguments = [];
		for index in range(1, compiler.len) { arguments.push(compiler.get(index)); }
		arguments.extend(["-x", "c++", "-std=" + standard, "--target=" + target, "-isysroot", sysroot, "-E", "-v", "/dev/null"]);
		var request = FeNativeHeaderRead(compiler.get(0), arguments);
		request.captureStderr = true;
		/* A driver's search-list probe, not a reader: the reference's 60 s. */
		request.timeoutMilliseconds = 60000;
		var batch = FeNativeHeaderBatch();
		batch.append(request);
		self.headerReader(batch);
		var result = request.result();
		Vector<string> directories = [];
		bool listing = false;
		if (result.isOk()) {
			for line in Strings.split(result.unwrap(), "\n") {
				if (line.startsWith("#include <...> search starts here:")) { listing = true; continue; }
				if (line.startsWith("End of search list.")) { break; }
				if (listing && line.startsWith(" ") && !line.contains("(framework directory)")) { directories.push(line.trim()); }
			}
		}
		if (result.isErr() || directories.len == 0) { self.fail(f"C++ bindings require a Clang C++ driver reporting its include search list (BTRC_NATIVE_CXX={spelled})"); }
		self.cxxToolchainIncludeCache.put(key, directories);
		return directories;
	}

	/* C++ bindings publish opaque owners, owner-bound views and scoped constants only. */
	private void importCxxBinding(FeNativeBinding binding, NativeNode header) {
		if (binding.callbacks.len > 0 || binding.recordSnapshots.len > 0 || binding.stringViews.len > 0 || binding.variadicCalls.len > 0) { self.fail("C++ bindings support resources, initializers, copied strings and constants"); }
		self.prepareCxxResources(binding, header);
		for declaration in header.exports {
			if (declaration.kind == NNK_NATIVE_CONSTANT) { self.importCxxConstant(declaration); }
			else if (declaration.kind != NNK_NATIVE_CXX_CLASS && declaration.kind != NNK_NATIVE_CXX_METHOD && declaration.kind != NNK_NATIVE_RECORD_DECLARATION) { self.fail("C++ header declarations require opaque class, method or constant lowering"); }
		}
		if (self.borrows.len > 0) {
			Vector<string> paths = [];
			for path in self.borrows.keys() { paths.push(path); }
			paths.sortBy((string left, string right) => Strings.lessThan(left, right));
			self.fail(f"read-only-borrows names unknown method parameter: {paths.get(0)}");
		}
	}

	/* A scoped C++ constant is visible under its `::`-joined identifier with its underlying scalar type. */
	private void importCxxConstant(NativeNode declaration) {
		string name = declaration.name.replace("::", "_");
		for existing in self.declarations {
			Node prior = existing.declaration;
			string priorName = prior.kind == NK_TYPEDEF_DECL ? prior.alias : prior.name;
			if (priorName == name) { self.fail(f"C++ constant {declaration.name} projects to an occupied name '{name}'"); }
		}
		for existing in self.inputClasses { if (existing.declaration.name == name) { self.fail(f"C++ constant {declaration.name} projects to an occupied name '{name}'"); } }
		Node imported = self.node(NK_VAR_DECL_STMT);
		imported.name = name;
		imported.type = self.objectiveCScalar(declaration.valueType);
		imported.type.isConst = true;
		NativeNode native = declaration.valueType;
		while (native.kind == NNK_NATIVE_ALIAS || native.kind == NNK_NATIVE_QUALIFIED_TYPE || native.kind == NNK_NATIVE_ENUM_TYPE) { native = native.underlying; }
		imported.initializer = self.integer(declaration.decimalValue, native.kind == NNK_NATIVE_BUILTIN && native.signedness == "unsigned" ? "U" : "");
		self.add(name, imported, "c++-constant:" + declaration.name + ":" + declaration.decimalValue, "", true);
	}

	/* Authenticate opaque C++ owners before projecting any callable surface. Published document
	 * owners have no mutation entry point. Value views carry their originating owner, rather than
	 * acquiring a new native lifetime or deriving ownership from the immediately preceding view. */
	private void prepareCxxResources(FeNativeBinding binding, NativeNode header) {
		Map<string, NativeNode> exports = {};
		for declaration in header.exports { exports.put(declaration.name, declaration); }
		Map<string, FeNativeResourceBinding> classes = {};
		self.layouts = {};
		for layout in header.records { self.layouts.put(layout.identity, layout); }
		/* Map iteration is unordered; both compilers publish resources, factories and copies by name. */
		Vector<string> resourceNames = [];
		for name in binding.resources.keys() { resourceNames.push(name); }
		resourceNames.sortBy((string left, string right) => Strings.lessThan(left, right));
		Vector<string> factoryNames = [];
		for key in binding.initializers.keys() { factoryNames.push(key); }
		factoryNames.sortBy((string left, string right) => Strings.lessThan(left, right));
		for name in resourceNames {
			var resource = binding.resources.get(name);
			if (!exports.has(name)) { self.fail(f"C++ resource {name}: expected a complete selected SDK class"); }
			NativeNode declaration = exports.get(name);
			if (declaration.kind != NNK_NATIVE_CXX_CLASS || !declaration.recordType.complete) { self.fail(f"C++ resource {name}: expected a complete selected SDK class"); }
			if (!declaration.publicDestructor) { self.fail(f"C++ resource {name}: a public nondeleted destructor is required"); }
			if (resource.ownership == "unique") {
				if (!declaration.defaultConstructor) { self.fail("C++ unique resource requires an available public default constructor"); }
				if (resource.constructor != "default" || resource.releaseFunction != "delete") { self.fail("C++ unique resource requires checked default/delete lifetime"); }
			} else if (resource.ownership == "owner-bound-value") {
				if (!declaration.triviallyCopyable || !declaration.triviallyDestructible) { self.fail("C++ owner-bound values require trivial copy and destruction"); }
				if (!binding.resources.has(resource.owner) || binding.resources.get(resource.owner).ownership != "unique") { self.fail("C++ value requires a selected unique originating owner"); }
			} else { self.fail("unsupported C++ resource lifetime"); }
			if (classes.has(declaration.recordType.identity)) { self.fail("one SDK C++ class cannot declare multiple managed resources"); }
			classes.put(declaration.recordType.identity, resource);
			Node imported = self.node(NK_CLASS_DECL);
			imported.name = resource.alias;
			imported.isAbstract = true;
			if (resource.ownership == "unique") {
				for methodName in ["close", "isOpen"] {
					Node method = self.node(NK_METHOD_DECL);
					method.name = methodName;
					method.access = "public";
					method.returnType = self.node(NK_TYPE_EXPR);
					method.returnType.base = methodName == "close" ? "void" : "bool";
					imported.membersMut().push(method);
				}
			}
			self.add(resource.alias, imported, "c++-resource:" + name + ":" + resource.identity(), "void*", false, null, resource);
		}
		Vector<string> selectedNames = [];
		Map<string, FeNativeResourceBinding> selected = {};
		for name in resourceNames {
			for method in binding.resources.get(name).methods {
				string key = name + "::" + method;
				if (!selected.has(key)) { selectedNames.push(key); }
				selected.put(key, binding.resources.get(name));
			}
		}
		for key in factoryNames {
			if (!selected.has(key)) { selectedNames.push(key); }
			selected.put(key, binding.resources.get(binding.initializers.get(key).resource));
		}
		Map<string, FeNativeCopiedResultBinding> copies = {};
		for key in binding.copiedResults.keys() { copies.put(key, binding.copiedResults.get(key)); }
		for name in selectedNames {
			var resource = selected.get(name);
			if (!exports.has(name)) { self.fail(f"C++ method {name}: expected its selected SDK receiver"); }
			NativeNode method = exports.get(name);
			if (method.kind != NNK_NATIVE_CXX_METHOD || method.receiver != resource.name) { self.fail(f"C++ method {name}: expected its selected SDK receiver"); }
			FeNativeInitializerBinding? factory = binding.initializers.has(name) ? binding.initializers.get(name) : null;
			bool consuming = false;
			for item in method.parameterSemantics { if (item.cfConsumed || item.nsConsumed) { consuming = true; } }
			if (method.signature.variadic || consuming) { self.fail("C++ methods require fixed, non-consuming SDK parameters"); }
			if (factory == null && !method.constMethod) { self.fail("published C++ owners and views expose only const traversal methods"); }
			var root = resource.ownership == "unique" ? resource : binding.resources.get(resource.owner);
			Vector<Node> parameters = [];
			Vector<bool> borrows = [];
			Vector<string> names = self.parameterNames(method);
			string bareName = name.endsWith("()") ? name.substring(0, name.length() - 2) : name;
			for index in range(method.signature.parameters.len) {
				NativeNode native = method.signature.parameters.get(index);
				string path = bareName + "." + names.get(index);
				NativeNode pointer = self.unqualifiedNative(native);
				Node projected = self.node(NK_TYPE_EXPR);
				if (pointer.kind == NNK_NATIVE_POINTER) {
					NativeNode pointee = self.unqualifiedNative(pointer.pointee);
					if (!self.nativeIsConst(pointer.pointee) || pointee.kind != NNK_NATIVE_BUILTIN || !["void", "char", "unsigned char"].contains(pointee.name) || !binding.readOnlyBorrows.contains(path)) { self.fail("C++ pointer inputs require explicit read-only byte borrows"); }
					projected.base = pointee.name;
					projected.pointerDepth = 1;
					projected.isConst = true;
					self.borrows.remove(path);
					borrows.push(true);
				} else {
					projected = self.objectiveCScalar(native);
					projected.isConst = false;
					borrows.push(false);
				}
				Node parameter = self.node(NK_PARAM);
				parameter.name = names.get(index);
				parameter.type = projected;
				parameters.push(parameter);
			}
			NativeNode nativeResult = self.unqualifiedNative(method.signature.returnType);
			FeNativeRecordInput? record = null;
			string resultResource = "";
			FeNativeCopiedResult? copied = null;
			Node returnType = self.node(NK_TYPE_EXPR);
			if (factory != null) {
				if (resource.ownership != "unique" || method.constMethod) { self.fail("C++ factory requires its private mutable document receiver"); }
				FeNativeRecordInput resultRecord = self.cxxResultRecord(nativeResult, binding, exports, factory.result + "Status");
				record = resultRecord;
				NativeNode statusNative = method.signature.returnType;
				bool statusFound = false;
				for field in self.layouts.get(nativeResult.identity).fields { if (!statusFound && field.name == factory.statusField) { statusNative = field.fieldType; statusFound = true; } }
				if (!statusFound || !exports.has(factory.success)) { self.fail("C++ initializer success must belong to exactly the SDK status field enum"); }
				NativeNode statusEnum = self.unqualifiedNative(statusNative);
				NativeNode success = exports.get(factory.success);
				if (statusEnum.kind != NNK_NATIVE_ENUM_TYPE || success.kind != NNK_NATIVE_CONSTANT || success.enumIdentity != statusEnum.identity) { self.fail("C++ initializer success must belong to exactly the SDK status field enum"); }
				returnType.base = factory.result;
				Vector<FeNativeRecordInputField> fields = [];
				Node calledType = self.node(NK_TYPE_EXPR);
				calledType.base = "bool";
				fields.push(FeNativeRecordInputField("called", calledType));
				Node statusType = self.node(NK_TYPE_EXPR);
				statusType.base = resultRecord.name;
				fields.push(FeNativeRecordInputField("status", statusType));
				Node valueType = self.node(NK_TYPE_EXPR);
				valueType.base = resource.alias;
				valueType.isNullable = true;
				valueType.pointerDepth = 1;
				fields.push(FeNativeRecordInputField("value", valueType));
				self.cxxValueClass(factory.result, fields);
			} else if (nativeResult.kind == NNK_NATIVE_RECORD_TYPE) {
				if (!classes.has(nativeResult.identity)) { self.fail("C++ returned views must retain exactly the same originating owner"); }
				var target = classes.get(nativeResult.identity);
				if (target.ownership != "owner-bound-value" || target.owner != root.name) { self.fail("C++ returned views must retain exactly the same originating owner"); }
				resultResource = target.alias;
				returnType.base = target.alias;
			} else if (nativeResult.kind == NNK_NATIVE_POINTER) {
				NativeNode pointee = self.unqualifiedNative(nativeResult.pointee);
				bool copyable = false;
				if (copies.has(bareName)) {
					var copy = copies.get(bareName);
					copyable = copy.kind == "string" && copy.owner == "self";
					copies.remove(bareName);
				}
				if (!copyable || !self.nativeIsConst(nativeResult.pointee) || pointee.kind != NNK_NATIVE_BUILTIN || pointee.name != "char") { self.fail("C++ pointer results require checked receiver-owned string copying"); }
				Vector<int> noLengthArguments = [];
				copied = FeNativeCopiedResult("string", -1, "", noLengthArguments);
				returnType.base = "string";
				returnType.isNullable = true;
				returnType.pointerDepth = 1;
			} else {
				returnType = self.objectiveCScalar(method.signature.returnType);
				returnType.isConst = false;
			}
			var projection = FeNativeCxxProjection(method, resource.alias, root.alias);
			projection.resultRecord = record;
			if (factory != null) {
				projection.factoryResult = factory.result;
				projection.success = factory.success;
				projection.statusField = factory.statusField;
			}
			var contract = FeNativeCallContract();
			contract.readOnlyBorrows = borrows;
			contract.resourceResult = resultResource;
			contract.copiedResult = copied;
			contract.cxxMethod = projection;
			var owner = self.resourceDeclaration(resource.alias);
			if (owner.methods.has(method.methodName)) { self.fail("ambiguous C++ method source projection"); }
			owner.methods.put(method.methodName, contract);
			Node member = self.node(NK_METHOD_DECL);
			member.access = factory != null ? "class" : "public";
			member.name = method.methodName;
			member.returnType = returnType;
			member.paramsStorage = parameters;
			owner.declaration.membersMut().push(member);
		}
		if (copies.len > 0) { self.fail("C++ copied-results names a method without a copied pointer result"); }
	}

	private void cxxValueClass(string name, Vector<FeNativeRecordInputField> fields) {
		for existing in self.declarations {
			Node prior = existing.declaration;
			string priorName = prior.kind == NK_TYPEDEF_DECL ? prior.alias : prior.name;
			if (priorName == name) { self.fail(f"conflicting C++ copied result class '{name}'"); }
		}
		for existing in self.inputClasses { if (existing.declaration.name == name) { self.fail(f"conflicting C++ copied result class '{name}'"); } }
		Node owner = self.node(NK_CLASS_DECL);
		owner.name = name;
		owner.sourceFile = self.module;
		for field in fields {
			Node member = self.node(NK_FIELD_DECL);
			member.access = "public";
			member.name = field.name;
			member.type = field.valueType;
			owner.membersMut().push(member);
		}
		var generated = FeNativeImportedDeclaration(owner, self.module, self.header);
		generated.generatedInput = true;
		self.inputClasses.push(generated);
	}

	private FeNativeRecordInput cxxResultRecord(NativeNode native, FeNativeBinding binding, Map<string, NativeNode> exports, string name) {
		if (native.kind != NNK_NATIVE_RECORD_TYPE || native.opaque || !self.layouts.has(native.identity)) { self.fail("C++ factory result requires an explicitly selected scalar SDK record"); }
		NativeNode selected = native;
		bool selectedFound = false;
		for item in binding.ownedRecords {
			if (selectedFound || !exports.has(item)) { continue; }
			NativeNode candidate = exports.get(item);
			if (candidate.kind == NNK_NATIVE_CXX_CLASS && candidate.recordType.identity == native.identity) { selected = candidate; selectedFound = true; }
		}
		if (!selectedFound || !selected.triviallyCopyable || !selected.triviallyDestructible) { self.fail("C++ factory result requires a trivial selected scalar SDK record"); }
		NativeNode layout = self.layouts.get(native.identity);
		if (layout.fields.len == 0) { self.fail("C++ factory result requires nonempty public scalar fields"); }
		Vector<FeNativeRecordInputField> fields = [];
		for field in layout.fields {
			Node valueType = self.objectiveCScalar(field.fieldType);
			valueType.isConst = false;
			fields.push(FeNativeRecordInputField(field.name, valueType));
		}
		self.cxxValueClass(name, fields);
		var result = FeNativeRecordInput(name, selected.name, true);
		result.fields = fields;
		return result;
	}

	/* A raw record-pointer handle released directly by one selected lifetime
	 * operation. The release joins the reserved operations, so it is never an
	 * ordinary call; the analyzer admits only a call passing such a handle. */
	private void prepareUnmanagedHandles(FeNativeBinding binding) {
		for name in binding.resources.keys() {
			var resource = binding.resources.get(name);
			if (!resource.retainFunction.isEmpty()) { self.bindingOperations.put(resource.retainFunction, true); }
			if (!resource.releaseFunction.isEmpty()) { self.bindingOperations.put(resource.releaseFunction, true); }
		}
		for handle in binding.unmanagedHandles.keys() {
			string releaseName = binding.unmanagedHandles.get(handle);
			self.unmanagedHandles.put(handle, releaseName);
			bool handleRecord = false;
			if (self.callbackExports.has(handle) && self.callbackExports.get(handle).kind == NNK_NATIVE_TYPEDEF) {
				NativeNode pointer = self.unqualifiedNative(self.callbackExports.get(handle).underlying);
				handleRecord = pointer.kind == NNK_NATIVE_POINTER && self.unqualifiedNative(pointer.pointee).kind == NNK_NATIVE_RECORD_TYPE;
			}
			if (!handleRecord) { self.fail(f"unmanaged-handles.{handle} requires a selected record-pointer typedef that is not a resource"); }
			bool valid = false;
			if (self.callbackExports.has(releaseName)) {
				NativeNode releaser = self.callbackExports.get(releaseName);
				if (releaser.kind == NNK_NATIVE_FUNCTION && releaser.signature.parameters.len == 1 && !releaser.signature.variadic && self.unqualifiedNative(releaser.signature.parameters.get(0)).kind == NNK_NATIVE_POINTER && releaser.returnedOwnership == "unspecified") {
					NativeNode result = self.unqualifiedNative(releaser.signature.returnType);
					valid = result.kind == NNK_NATIVE_BUILTIN && result.name == "void";
					for parameter in releaser.parameterSemantics { if (parameter.nsConsumed) { valid = false; } }
					if (valid) { self.requireQualifiedConvention(releaser.signature); }
				}
			}
			if (!valid) { self.fail(f"unmanaged-handles.{handle}: release {releaseName} must take one pointer and return void"); }
			if (self.unmanagedOwners.has(handle) && self.unmanagedOwners.get(handle) != releaseName) { self.fail(f"unmanaged handle '{handle}' declares releases {self.unmanagedOwners.get(handle)} and {releaseName}"); }
			self.unmanagedOwners.put(handle, releaseName);
			self.resourceOperations.put(releaseName, true);
			self.bindingOperations.put(releaseName, true);
		}
	}

	private void prepareResources(FeNativeBinding binding, NativeNode header) {
		self.copiedInputs = {}; self.resourceInitializers = {}; self.attachedResources = {};
		for name in binding.copiedInputs.keys() { self.copiedInputs.put(name, binding.copiedInputs.get(name)); }
		for name in binding.initializers.keys() { var initializer = binding.initializers.get(name); self.resourceInitializers.put(initializer.resource, initializer); }
		self.initializers = {};
		for name in binding.initializers.keys() { self.initializers.put(name, binding.initializers.get(name)); }
		self.variadicCalls = {};
		for name in binding.variadicCalls.keys() { self.variadicCalls.put(name, binding.variadicCalls.get(name)); }
		self.resourceParameters = {};
		for name in binding.resourceParameters.keys() { self.resourceParameters.put(name, binding.resourceParameters.get(name)); }
		self.resourceResults = {};
		for name in binding.resourceResults.keys() { self.resourceResults.put(name, binding.resourceResults.get(name)); }
		self.ownedOutputs = {};
		for name in binding.ownedOutputs.keys() { self.ownedOutputs.put(name, binding.ownedOutputs.get(name)); }
		self.ownedOutputStatuses = {};
		for name in binding.ownedOutputStatuses.keys() { self.ownedOutputStatuses.put(name, binding.ownedOutputStatuses.get(name)); }
		self.statusResults = {};
		for name in binding.statusResults.keys() { self.statusResults.put(name, binding.statusResults.get(name)); }
		self.copiedOutputs = {};
		for name in binding.copiedOutputs.keys() { self.copiedOutputs.put(name, binding.copiedOutputs.get(name)); }
		self.comBinding = false;
		for name in binding.resources.keys() { if (binding.resources.get(name).ownership == "com") { self.comBinding = true; } }
		self.ownedOutputResources = {};
		for name in binding.ownedOutputResources.keys() { self.ownedOutputResources.put(name, binding.ownedOutputResources.get(name)); }
		self.outputOffsets = {};
		self.copiedResults = {};
		for name in binding.copiedResults.keys() { self.copiedResults.put(name, binding.copiedResults.get(name)); }
		for name in binding.outputOffsets.keys() { self.outputOffsets.put(name, binding.outputOffsets.get(name)); }
		self.resources = binding.resources;
		self.resourceTypes = {};
		self.resourceRecords = {};
		self.ownedResults = {};
		self.borrowedResults = {};
		for name in binding.borrowedResults.keys() { self.borrowedResults.put(name, binding.borrowedResults.get(name)); }
		self.resourceBorrows = {};
		for name in binding.ownedResults { self.ownedResults.put(name, true); }
		for name in binding.borrowedParameters { self.resourceBorrows.put(name, true); }
		Map<string, NativeNode> exports = {};
		for declaration in header.exports { exports.put(declaration.name, declaration); }
		for name in binding.resources.keys() {
			FeNativeResourceBinding resource = binding.resources.get(name);
			if (resource.ownership == "com") {
				/* A COM interface is a record typedef: `typedef struct IStream IStream;`
				 * represents IStream* (native-interop-ownership.md section 2.4). */
				if (!exports.has(name) || exports.get(name).kind != NNK_NATIVE_TYPEDEF || self.unqualifiedNative(exports.get(name).underlying).kind != NNK_NATIVE_RECORD_TYPE) { self.fail(f"resource {name}: com resources require a record typedef"); }
				if (!self.comRuntime) { self.fail("COM resources require import Library.COM.COMApartment"); }
			}
			if (!exports.has(name)) { self.fail(f"resource {name}: expected a selected pointer typedef or unique record"); }
			NativeNode declaration = exports.get(name);
			NativeNode native = declaration.underlying;
			string spelling = name;
			if (resource.ownership == "unique" && declaration.kind == NNK_NATIVE_RECORD_DECLARATION) {
				native = declaration.recordType; spelling = native.recordKind + " " + native.tagName;
			} else if (declaration.kind != NNK_NATIVE_TYPEDEF) { self.fail(f"resource {name}: expected a selected pointer typedef or unique record"); }
			NativeNode pointer = self.unqualifiedNative(native);
			string recordSpelling = "";
			if ((resource.ownership == "unique" || resource.ownership == "com") && pointer.kind == NNK_NATIVE_RECORD_TYPE) {
				if (self.resourceRecords.has(pointer.identity)) { self.fail("one SDK record cannot declare multiple unique owners"); }
				self.resourceRecords.put(pointer.identity, name);
				pointer = NativeNode(); pointer.kind = NNK_NATIVE_POINTER; pointer.pointee = native;
				pointer.qualifiers = NativeNode(); pointer.qualifiers.kind = NNK_NATIVE_QUALIFIERS; pointer.qualifiers.nullability = "unannotated";
				recordSpelling = spelling + "*";
			}
			if (pointer.kind != NNK_NATIVE_POINTER || (self.unqualifiedNative(pointer.pointee).kind != NNK_NATIVE_RECORD_TYPE && !(resource.ownership == "reference-counted" && self.unqualifiedNative(pointer.pointee).kind == NNK_NATIVE_BUILTIN && self.unqualifiedNative(pointer.pointee).name == "void"))) { self.fail(f"resource {name}: expected a record-pointer typedef"); }
			self.resourceTypes.put(name, pointer);
			if (!resource.storage.isEmpty()) {
				bool complete = false;
				for record in header.records { if (record.identity == self.unqualifiedNative(pointer.pointee).identity) { complete = true; } }
				if (self.nativeIsConst(pointer.pointee) || !complete) { self.fail("inline resource storage requires a complete mutable SDK record"); }
			}
			if (resource.ownership == "unique") {
				if (binding.ownedRecords.len > 0 || binding.recordInputs.len > 0 || binding.recordOutputs.len > 0) { self.fail("unique resource records and completion payloads require owning projections"); }
				for callbackName in binding.callbacks.keys() { if (binding.callbacks.get(callbackName).realtime == null && (binding.callbacks.get(callbackName).ownedArguments.len > 0 || binding.callbacks.get(callbackName).lifetime != "call")) { self.fail("unique resource records and completion payloads require owning projections"); } }
			}
			Node closeType = self.node(NK_TYPE_EXPR); closeType.base = "void";
			string resourceIdentity = self.typeIdentity(pointer);
			/* AddRef and Release are table slots, checked with the table when the interface is projected. */
			if (resource.ownership == "com") { resourceIdentity = resourceIdentity + ":com:" + resource.iid + ":" + resource.base; }
			for operation in [resource.retainFunction, resource.releaseFunction] {
				if ((resource.ownership == "unique" || resource.ownership == "com") && operation.isEmpty()) { continue; }
				if (!exports.has(operation) || exports.get(operation).kind != NNK_NATIVE_FUNCTION) { self.fail(f"resource {name}: lifetime operation {operation} requires one pointer parameter"); }
				NativeNode nativeFunction = exports.get(operation);
				if (nativeFunction.signature.variadic || nativeFunction.signature.parameters.len != 1) { self.fail(f"resource {name}: lifetime operation {operation} requires one pointer parameter"); }
				if (!self.resourcePointerAccepts(nativeFunction.signature.parameters.get(0), pointer)) { self.fail(f"resource {name}: incompatible lifetime parameter in {operation}"); }
				NativeNode result = self.unqualifiedNative(nativeFunction.signature.returnType);
				bool returnsVoid = result.kind == NNK_NATIVE_BUILTIN && result.name == "void";
				bool statusRelease = resource.ownership == "unique" && !resource.releaseConsumption.isEmpty();
				if (statusRelease) {
					NativeNode scalar = result.kind == NNK_NATIVE_ENUM_TYPE ? self.unqualifiedNative(result.underlying) : result;
					if (scalar.kind != NNK_NATIVE_BUILTIN || !["bool", "_Bool", "char", "signed char", "unsigned char", "short", "unsigned short", "int", "unsigned int", "long", "unsigned long", "long long", "unsigned long long"].contains(scalar.name)) { self.fail(f"resource {name}: status policy requires an integral or enum destructor result"); }
					closeType = self.type(nativeFunction.signature.returnType);
				} else if (!returnsVoid && (operation == resource.releaseFunction || !self.resourcePointerAccepts(result, pointer))) { self.fail(f"resource {name}: unsupported lifetime result in {operation}"); }
				if (resource.ownership == "unique") { resourceIdentity = resourceIdentity + ":" + self.typeIdentity(nativeFunction.signature); }
				if (nativeFunction.returnedOwnership != "unspecified" && nativeFunction.returnedOwnership != "cf_retained") { self.fail(f"resource {name}: conflicting lifetime ownership in {operation}"); }
				for parameter in nativeFunction.parameterSemantics { if (parameter.nsConsumed || (parameter.cfConsumed && operation != resource.releaseFunction)) { self.fail(f"resource {name}: conflicting lifetime ownership in {operation}"); } }
				self.resourceOperations.put(operation, true);
			}
			Node imported = self.node(NK_CLASS_DECL);
			imported.name = name;
			imported.isAbstract = true;
			if (resource.ownership == "unique") {
				for methodName in ["close", "isOpen"] {
					Node method = self.node(NK_METHOD_DECL);
					method.name = methodName;
					method.access = "public";
					method.returnType = self.node(NK_TYPE_EXPR);
					method.returnType.base = "bool";
					if (methodName == "close") { method.returnType = closeType; }
					imported.membersMut().push(method);
				}
			}
			self.add(name, imported, resourceIdentity, recordSpelling, false, null, resource);
		}
	}

	private FeNativeImportedDeclaration resourceDeclaration(string name) {
		for imported in self.declarations { if (imported.module == self.module && imported.declaration.kind == NK_CLASS_DECL && imported.declaration.name == name) { return imported; } }
		throw "Missing imported resource declaration";
	}

	private void prepareResourceConversions(FeNativeBinding binding, NativeNode header) {
		Map<string, NativeNode> exports = {};
		for declaration in header.exports { exports.put(declaration.name, declaration); }
		for name in binding.resources.keys() {
			var resource = binding.resources.get(name);
			if (resource.ownership == "com") {
				/* A COM interface widens statically along its declared base chain;
				 * the table prefix is checked when the interface is projected. */
				Vector<string> ancestors = [];
				string base = resource.base;
				while (!base.isEmpty()) { ancestors.push(base); base = binding.resources.get(base).base; }
				self.resourceDeclaration(name).nativeAncestors = ancestors;
				continue;
			}
			if (resource.ownership != "reference-counted") { continue; }
			var origin = self.resourceDeclaration(name);
			origin.nativeAncestors = [];
			for otherName in binding.resources.keys() {
				var other = binding.resources.get(otherName);
				if (otherName != name && other.ownership == "reference-counted" && other.retainFunction == resource.retainFunction && other.releaseFunction == resource.releaseFunction && self.resourcePointerAccepts(self.resourceTypes.get(otherName), self.resourceTypes.get(name))) { origin.nativeAncestors.push(otherName); }
			}
			if (resource.typeQuery.isEmpty()) { continue; }
			if (!exports.has(resource.typeQuery) || !exports.has(resource.typeTag)) { self.fail("resource type-query/type-tag require selected functions"); }
			NativeNode query = exports.get(resource.typeQuery); NativeNode tag = exports.get(resource.typeTag);
			if (query.kind != NNK_NATIVE_FUNCTION || tag.kind != NNK_NATIVE_FUNCTION || query.signature.variadic || tag.signature.variadic || query.signature.parameters.len != 1 || tag.signature.parameters.len != 0 || self.typeIdentity(query.signature.returnType) != self.typeIdentity(tag.signature.returnType)) { self.fail("resource type-query/type-tag require one-parameter/zero-parameter functions with the same scalar result"); }
			NativeNode result = self.unqualifiedNative(query.signature.returnType);
			if (result.kind == NNK_NATIVE_ENUM_TYPE) { result = self.unqualifiedNative(result.underlying); }
			if (result.kind != NNK_NATIVE_BUILTIN || !["bool", "_Bool", "char", "signed char", "unsigned char", "short", "unsigned short", "int", "unsigned int", "long", "unsigned long", "long long", "unsigned long long"].contains(result.name)) { self.fail("resource type discriminator must return an integral SDK type"); }
			string source = self.resourceName(query.signature.parameters.get(0));
			if (source.isEmpty() || self.resources.get(source).ownership != "reference-counted" || self.resources.get(source).retainFunction != resource.retainFunction || self.resources.get(source).releaseFunction != resource.releaseFunction || !self.resourcePointerAccepts(query.signature.parameters.get(0), self.resourceTypes.get(name)) || !self.resourceBorrows.has(query.name + "." + self.parameterNames(query).get(0))) { self.fail("resource type-query requires a compatible borrowed reference-counted source"); }
			origin.resourceQueryType = source;
		}
	}

	private string projectResourcePosition(string key, NativeNode native, bool result = false, bool consume = true) {
		Map<string, string> mappings = result ? self.resourceResults : self.resourceParameters;
		string inferred = self.resourceName(native);
		if (!mappings.has(key)) { return inferred; }
		string selected = mappings.get(key);
		if (consume) { mappings.remove(key); }
		var resource = self.resources.get(selected);
		NativeNode pointer = self.unqualifiedNative(native);
		if (resource.ownership != "reference-counted" || !inferred.isEmpty() || pointer.kind != NNK_NATIVE_POINTER || self.unqualifiedNative(pointer.pointee).kind != NNK_NATIVE_BUILTIN || self.unqualifiedNative(pointer.pointee).name != "void" || !self.resourcePointerAccepts(native, self.resourceTypes.get(selected))) { self.fail("resource projection requires an unprojected compatible erased pointer and reference-counted resource"); }
		return selected;
	}

	private string resourceName(NativeNode native) {
		while (native.kind == NNK_NATIVE_ALIAS || native.kind == NNK_NATIVE_QUALIFIED_TYPE) {
			if (native.kind == NNK_NATIVE_ALIAS && self.resources.has(native.name) && self.unqualifiedNative(native).kind == NNK_NATIVE_POINTER) { return native.name; }
			native = native.underlying;
		}
		if (native.kind == NNK_NATIVE_POINTER) {
			NativeNode pointee = self.unqualifiedNative(native.pointee);
			if (pointee.kind == NNK_NATIVE_RECORD_TYPE && self.resourceRecords.has(pointee.identity)) { return self.resourceRecords.get(pointee.identity); }
		} else if (native.kind == NNK_NATIVE_RECORD_TYPE && self.resourceRecords.has(native.identity)) { self.fail("unique record resource requires pointer use, not by-value storage"); }
		return "";
	}

	private void requireCompletionValue(NativeNode native) {
		NativeNode value = self.unqualifiedNative(native);
		if (value.kind == NNK_NATIVE_BUILTIN || value.kind == NNK_NATIVE_ENUM_TYPE) { return; }
		if (value.kind == NNK_NATIVE_RECORD_TYPE && value.complete && !value.opaque) {
			NativeNode layout = self.layouts.get(value.identity);
			if (layout.recordKind == "struct" && layout.fields.len > 0) {
				for field in layout.fields { self.requireCompletionValue(field.fieldType); }
				return;
			}
		}
		self.fail("C one-shot native result requires a pointer-free scalar or record value");
	}

	private Node resourceCallType(NativeNode native, string projected = "") {
		string name = projected.isEmpty() ? self.resourceName(native) : projected;
		if (name.isEmpty()) { return self.callType(native); }
		NativeNode current = native;
		while (current.kind == NNK_NATIVE_ALIAS || current.kind == NNK_NATIVE_QUALIFIED_TYPE || current.kind == NNK_NATIVE_POINTER) {
			if (current.qualifiers.isVolatile || current.qualifiers.isRestrict) { self.fail("resource qualifiers require managed native lowering"); }
			current = current.kind == NNK_NATIVE_POINTER ? current.pointee : current.underlying;
		}
		Node result = self.node(NK_TYPE_EXPR);
		result.base = name;
		result.isNullable = self.callNullability(native) != "nonnull";
		result.pointerDepth = result.isNullable ? 1 : 0;
		return result;
	}

	private Node qualify(Node projected, NativeNode native, bool callBoundary = false) {
		NativeNode qualifiers = native.qualifiers;
		if (qualifiers.isRestrict || qualifiers.isVolatile || (!callBoundary && !qualifiers.nullability.equals("unannotated"))) { self.fail("native qualifier requires native-type lowering; refusing a lossy projection"); }
		NativeNode qualifiedType = native;
		while (qualifiedType.kind == NNK_NATIVE_ALIAS || qualifiedType.kind == NNK_NATIVE_QUALIFIED_TYPE) { qualifiedType = qualifiedType.underlying; }
		NativeNode? handleRecord = qualifiedType.kind == NNK_NATIVE_POINTER ? self.withoutSpellingWrappers(qualifiedType.pointee) : null;
		bool handleAlias = native.kind == NNK_NATIVE_ALIAS && projected.base == native.name && projected.pointerDepth == 0 && handleRecord != null && handleRecord.kind == NNK_NATIVE_RECORD_TYPE && !handleRecord.complete;
		if (qualifiers.isConst && !handleAlias && qualifiedType.kind != NNK_NATIVE_BUILTIN && qualifiedType.kind != NNK_NATIVE_RECORD_TYPE && qualifiedType.kind != NNK_NATIVE_ENUM_TYPE) { self.fail("pointer/alias const requires native-type lowering; refusing a lossy projection"); }
		projected.isConst = projected.isConst || qualifiers.isConst;
		return projected;
	}

	private Node record(NativeNode native, string alias = "") {
		string key = self.module + "\x1f" + native.identity;
		if (!self.records.has(key)) {
			string name = native.name.isEmpty() ? alias : native.name;
			if (name.isEmpty()) { self.fail("anonymous native record requires a named typedef"); }
			Node declaration = self.node(NK_STRUCT_DECL);
			declaration.name = name;
			/* Complete SDK types own storage without mirroring private fields. */
			declaration.isForward = !native.complete;
			declaration.isUnion = native.recordKind == "union";
			string spelling = native.tagName.isEmpty() ? name : native.recordKind + " " + native.tagName;
			self.add(name, declaration, native.identity + ":" + native.recordKind, spelling);
			self.records.put(key, declaration);
		}
		Node declaration = self.records.get(key);
		if (!native.opaque && !self.expandedRecords.has(key)) {
			NativeNode layout = self.layouts.get(native.identity);
			self.recordLayouts.put(self.module + "\x1f" + declaration.name, layout);
			if (!layout.recordKind.equals("struct") || !layout.recordKind.equals(native.recordKind)) { self.fail("native union values require native-type lowering"); }
			/* Register before walking fields: recursive pointers share this owner. */
			declaration.isForward = false;
			self.expandedRecords.put(key, true);
			for field in layout.fields {
				if (field.isAnonymous || field.isBitfield || field.name.isEmpty()) { self.fail("anonymous fields and bitfields require native-type lowering"); }
				if (self.managedCallbackSignature(field.fieldType)) { self.recordPrivateFields.put(native.identity + "\x1f" + field.name, true); }
				if (self.recordPrivateFields.has(native.identity + "\x1f" + field.name)) {
					for imported in self.declarations { if (imported.declaration == declaration) { imported.privateFields = true; } }
					continue;
				}
				Node member = self.node(NK_FIELD_DEF);
				member.name = field.name;
				if (self.language == "objective-c") {
					member.type = self.objectiveCValue(field.fieldType);
					if (member.type.isConst) { self.fail("Objective-C const record fields require initialization-only lowering"); }
					declaration.fieldsMut().push(member);
					continue;
				}
				Node? callbackType = self.callbackField(declaration, field.name, field.fieldType);
				member.type = callbackType == null ? self.fieldType(field.fieldType) : callbackType;
				declaration.fieldsMut().push(member);
			}
		}
		Node projected = self.node(NK_TYPE_EXPR);
		projected.base = declaration.name;
		return projected;
	}

	private Node fieldType(NativeNode input) {
		NativeNode native = self.withoutSpellingWrappers(self.withoutNestedNullable(input));
		if (native.kind == NNK_NATIVE_ARRAY_TYPE) {
			string? count = native.count;
			if (count == null || count == "0" || count.len() > 10 || (count.len() == 10 && count > "2147483647")) { self.fail("native array field requires a positive representable fixed bound"); }
			Node element = self.fieldType(native.element);
			if (element.isArray) { self.fail("multidimensional native array fields require native-type lowering"); }
			element.isArray = true;
			element.arraySize = self.integer(count);
			return self.qualify(element, native);
		}
		return self.type(native);
	}

	private bool managedCallbackSignature(NativeNode input) {
		NativeNode pointer = self.unqualifiedNative(input);
		if (pointer.kind != NNK_NATIVE_POINTER) { return false; }
		NativeNode signature = self.unqualifiedNative(pointer.pointee);
		if (signature.kind != NNK_NATIVE_FUNCTION_TYPE) { return false; }
		if (!self.resourceName(signature.returnType).isEmpty()) { return true; }
		for parameter in signature.parameters { if (!self.resourceName(parameter).isEmpty()) { return true; } }
		return false;
	}

	private Node? callbackField(Node owner, string name, NativeNode input) {
		NativeNode pointer = input;
		while (pointer.kind == NNK_NATIVE_ALIAS || pointer.kind == NNK_NATIVE_QUALIFIED_TYPE) { pointer = pointer.underlying; }
		if (pointer.kind != NNK_NATIVE_POINTER) { return null; }
		NativeNode signature = pointer.pointee;
		while (signature.kind == NNK_NATIVE_ALIAS || signature.kind == NNK_NATIVE_QUALIFIED_TYPE) { signature = signature.underlying; }
		if (signature.kind != NNK_NATIVE_FUNCTION_TYPE) { return null; }
		self.requireQualifiedConvention(signature);
		if (self.callNullability(input).equals("nonnull")) { self.fail("nested native non-null contracts require native-type lowering"); }
		if (signature.variadic) { self.fail("variadic native callbacks require adapter lowering"); }
		if (self.callNullability(signature.returnType).equals("nonnull")) { self.fail("native callback non-null results require adapter lowering"); }
		var contract = FeNativeCallContract();
		Node projected = self.node(NK_TYPE_EXPR);
		projected.base = "__fn_ptr";
		projected.genericArgsMut().push(self.type(self.withoutCallNullability(signature.returnType, false)));
		bool checked = false;
		for parameter in signature.parameters {
			bool nonnull = self.callNullability(parameter).equals("nonnull");
			contract.nonnullParameters.push(nonnull);
			checked = checked || nonnull;
			projected.genericArgsMut().push(self.type(self.withoutCallNullability(parameter, true)));
		}
		if (checked) {
			for imported in self.declarations {
				if (imported.declaration == owner) { imported.fieldContracts.put(name, contract); }
			}
		}
		NativeNode current = input;
		while (true) {
			projected = self.qualify(projected, current, true);
			if (current.kind != NNK_NATIVE_ALIAS && current.kind != NNK_NATIVE_QUALIFIED_TYPE) { break; }
			current = current.underlying;
		}
		return self.qualify(projected, signature);
	}

	private Node alias(string name, NativeNode underlying) {
		Node original = underlying.kind == NNK_NATIVE_RECORD_TYPE ? self.qualify(self.record(underlying, name), underlying) : underlying.kind == NNK_NATIVE_ENUM_TYPE ? self.enumeration(underlying, name) : self.type(underlying);
		if (!original.base.equals(name)) {
			Node declaration = self.node(NK_TYPEDEF_DECL);
			declaration.alias = name;
			declaration.original = original;
			self.add(name, declaration, self.typeIdentity(underlying));
		}
		Node projected = self.node(NK_TYPE_EXPR);
		projected.base = name;
		return projected;
	}

	private NativeNode withoutSpellingWrappers(NativeNode input) {
		NativeNode native = input;
		while (native.kind == NNK_NATIVE_QUALIFIED_TYPE) {
			if (!self.qualifierIdentity(native.qualifiers).equals(self.qualifierIdentity(native.underlying.qualifiers))) { self.fail("qualified native wrapper requires native-type lowering"); }
			native = native.underlying;
		}
		return native;
	}

	private Node type(NativeNode input) {
		if (!self.resourceName(input).isEmpty()) { self.fail("resource storage requires a checked managed call boundary"); }
		for name in self.resourceTypes.keys() { if (self.unqualifiedNative(self.resourceTypes.get(name).pointee).kind != NNK_NATIVE_BUILTIN && self.typeIdentity(input) == self.typeIdentity(self.resourceTypes.get(name))) { self.fail("resource storage requires a checked managed call boundary"); } }
		NativeNode native = self.withoutSpellingWrappers(input);
		Node projected = self.node(NK_TYPE_EXPR);
		if (native.kind == NNK_NATIVE_BUILTIN) {
			if (!Strings.split("void,bool,_Bool,char,signed char,unsigned char,short,unsigned short,int,unsigned int,long,unsigned long,long long,unsigned long long,float,double", ",").contains(native.name)) { self.fail(f"unsupported native scalar '{native.name}'"); }
			projected.base = native.name == "bool" || native.name == "_Bool" ? "bool" : native.name;
		} else if (native.kind == NNK_NATIVE_ALIAS) {
			projected = self.alias(native.name, native.underlying);
		} else if (native.kind == NNK_NATIVE_ENUM_TYPE) {
			projected = self.enumeration(native);
		} else if (native.kind == NNK_NATIVE_POINTER) {
			NativeNode pointee = self.withoutSpellingWrappers(native.pointee);
			if (pointee.kind == NNK_NATIVE_FUNCTION_TYPE) {
				NativeNode signature = pointee;
				self.requireQualifiedConvention(signature);
				if (signature.variadic) { self.fail("variadic native callbacks require adapter lowering"); }
				projected.base = "__fn_ptr";
				projected.genericArgsMut().push(self.type(signature.returnType));
				for parameter in signature.parameters { projected.genericArgsMut().push(self.type(parameter)); }
				projected = self.qualify(projected, signature);
			} else {
				projected = self.type(native.pointee);
				projected.pointerDepth++;
			}
		} else if (native.kind == NNK_NATIVE_RECORD_TYPE) {
			projected = self.record(native);
		} else { self.fail("native type requires native-type lowering"); }
		return self.qualify(projected, native);
	}

	private Node enumeration(NativeNode native, string alias = "") {
		Node underlying = self.type(native.underlying);
		string name = native.name.isEmpty() ? alias : native.name;
		if (name.isEmpty()) { return self.qualify(underlying, native); }
		Node declaration = self.node(NK_TYPEDEF_DECL);
		declaration.alias = name;
		declaration.original = underlying;
		self.add(name, declaration, "native-enum:" + native.identity + ":" + self.typeIdentity(native.underlying), native.name.isEmpty() ? alias : "enum " + native.name);
		Node projected = self.node(NK_TYPE_EXPR);
		projected.base = name;
		return self.qualify(projected, native);
	}

	private Node integer(string decimal, string suffix = "") {
		bool negative = decimal.startsWith("-");
		string magnitude = negative ? decimal.substring(1, decimal.length() - 1) : decimal;
		var literal = IntegerLiteral(magnitude + suffix);
		if (!literal.representable()) { self.fail("native constant exceeds supported integer storage"); }
		Node result = self.node(NK_INT_LITERAL);
		result.raw = magnitude + suffix;
		result.valueInt = literal.storedValue();
		if (!negative) { return result; }
		Node negated = self.node(NK_UNARY_EXPR);
		negated.op = "-";
		negated.prefix = true;
		negated.operand = result;
		return negated;
	}

	private void validateCopyQualifiers(NativeNode value) {
		NativeNode native = value;
		while (true) {
			if (native.qualifiers.isVolatile || native.qualifiers.isRestrict) { self.fail("copied-results/output-offsets does not support volatile or restrict storage"); }
			if (native.kind == NNK_NATIVE_ALIAS || native.kind == NNK_NATIVE_QUALIFIED_TYPE) { native = native.underlying; }
			else if (native.kind == NNK_NATIVE_POINTER) { native = native.pointee; }
			else { return; }
		}
	}

	private FeNativeCopiedResult? projectCopiedResult(NativeNode declaration, Vector<string> parameterNames) {
		if (!self.copiedResults.has(declaration.name)) { return null; }
		FeNativeCopiedResultBinding binding = self.copiedResults.get(declaration.name);
		self.validateCopyQualifiers(declaration.signature.returnType);
		NativeNode pointer = self.unqualifiedNative(declaration.signature.returnType);
		if (pointer.kind != NNK_NATIVE_POINTER) { self.fail("copied-results requires a const character/byte pointer result"); }
		NativeNode element = self.unqualifiedNative(pointer.pointee);
		Vector<string> accepted = binding.kind == "string" ? ["char"] : ["char", "signed char", "unsigned char", "void"];
		if (element.kind != NNK_NATIVE_BUILTIN || !accepted.contains(element.name) || !self.nativeIsConst(pointer.pointee)) { self.fail("copied-results requires a const character/byte pointer result"); }
		int ownerIndex = -1;
		if (!binding.owner.isEmpty()) {
			for index in range(parameterNames.len) { if (parameterNames.get(index) == binding.owner) { ownerIndex = index; } }
			if (ownerIndex < 0) { self.fail("copied-results names an unknown owner parameter"); }
			string key = declaration.name + "." + binding.owner;
			if (!self.resourceBorrows.has(key) || self.projectResourcePosition(key, declaration.signature.parameters.get(ownerIndex), false, false).isEmpty()) { self.fail("copied-results owner requires a borrowed native resource"); }
		}
		Vector<int> indices = [];
		if (binding.kind == "bytes") {
			if (!self.callbackExports.has(binding.lengthFunction) || self.resourceOperations.has(binding.lengthFunction)) { self.fail("copied-results length-function requires a selected non-consuming C function"); }
			NativeNode lengthFunction = self.callbackExports.get(binding.lengthFunction);
			if (lengthFunction.kind != NNK_NATIVE_FUNCTION || lengthFunction.signature.variadic) { self.fail("copied-results length-function requires a selected non-consuming C function"); }
			for parameter in lengthFunction.parameterSemantics { if (parameter.cfConsumed || parameter.nsConsumed) { self.fail("copied-results length-function requires a selected non-consuming C function"); } }
			NativeNode result = self.unqualifiedNative(lengthFunction.signature.returnType);
			if (result.kind != NNK_NATIVE_BUILTIN || result.name != "int") { self.fail("copied-results length-function requires a signed int byte count"); }
			if (binding.lengthArguments.len != lengthFunction.signature.parameters.len) { self.fail("copied-results length-arguments must match the length-function arity and parameters"); }
			for index in range(binding.lengthArguments.len) {
				int sourceIndex = -1;
				for position in range(parameterNames.len) { if (parameterNames.get(position) == binding.lengthArguments.get(index)) { sourceIndex = position; } }
				if (sourceIndex < 0) { self.fail("copied-results length-arguments must match the length-function arity and parameters"); }
				if (self.typeIdentity(lengthFunction.signature.parameters.get(index)) != self.typeIdentity(declaration.signature.parameters.get(sourceIndex))) { self.fail("copied-results length argument has incompatible SDK type"); }
				indices.push(sourceIndex);
			}
			if (!indices.contains(ownerIndex)) { self.fail("copied-results length-function must use the original owner"); }
		}
		self.copiedResults.remove(declaration.name);
		return FeNativeCopiedResult(binding.kind, ownerIndex, binding.lengthFunction, indices);
	}

	private FeNativeOutputOffset? projectOutputOffset(NativeNode declaration, Vector<string> parameterNames, int ownedIndex) {
		string selected = "";
		for key in self.outputOffsets.keys() { if (key.startsWith(declaration.name + ".")) { selected = key; break; } }
		if (selected.isEmpty()) { return null; }
		FeNativeOutputOffsetBinding binding = self.outputOffsets.get(selected);
		string outputName = selected.substring(declaration.name.length() + 1, selected.length() - declaration.name.length() - 1);
		int outputIndex = -1; int inputIndex = -1; int lengthIndex = -1;
		for index in range(parameterNames.len) {
			string name = parameterNames.get(index);
			if (name == outputName) { outputIndex = index; }
			if (name == binding.input) { inputIndex = index; }
			if (name == binding.length) { lengthIndex = index; }
		}
		if (outputIndex < 0 || inputIndex < 0 || lengthIndex < 0) { self.fail("output-offsets names an unknown parameter"); }
		if (ownedIndex == outputIndex || ownedIndex == inputIndex || ownedIndex == lengthIndex) { self.fail("output-offsets cannot reuse an owned resource output"); }
		for index in [outputIndex, inputIndex, lengthIndex] { self.validateCopyQualifiers(declaration.signature.parameters.get(index)); }
		NativeNode output = self.unqualifiedNative(declaration.signature.parameters.get(outputIndex));
		if (output.kind != NNK_NATIVE_POINTER || self.unqualifiedNative(output.pointee).kind != NNK_NATIVE_POINTER || self.nativeIsConst(output.pointee)) { self.fail("output-offsets requires a mutable const-char-pointer output slot"); }
		NativeNode pointer = self.unqualifiedNative(output.pointee);
		NativeNode element = self.unqualifiedNative(pointer.pointee);
		if (element.kind != NNK_NATIVE_BUILTIN || element.name != "char" || !self.nativeIsConst(pointer.pointee)) { self.fail("output-offsets requires a mutable const-char-pointer output slot"); }
		NativeNode input = self.unqualifiedNative(declaration.signature.parameters.get(inputIndex));
		if (input.kind != NNK_NATIVE_POINTER || !self.nativeIsConst(input.pointee)) { self.fail("output-offsets input requires a const char pointer"); }
		NativeNode inputElement = self.unqualifiedNative(input.pointee);
		if (inputElement.kind != NNK_NATIVE_BUILTIN || inputElement.name != "char") { self.fail("output-offsets input requires a const char pointer"); }
		NativeNode length = self.unqualifiedNative(declaration.signature.parameters.get(lengthIndex));
		if (length.kind != NNK_NATIVE_BUILTIN || length.name != "int") { self.fail("output-offsets length requires the supported signed int byte count"); }
		if (!self.borrows.has(declaration.name + "." + binding.input)) { self.fail("output-offsets input requires read-only-borrows"); }
		self.outputOffsets.remove(selected);
		return FeNativeOutputOffset(outputIndex, inputIndex, lengthIndex, binding.field);
	}

	private FeNativeOwnedOutput? projectOwnedOutput(NativeNode declaration, Vector<string> parameterNames) {
		if (self.initializers.has(declaration.name)) { return self.projectInitializer(declaration, parameterNames); }
		string selected = ""; string resultName = "";
		/* A dispatched COM method's "<R>.<method>.<parameter>" output is projected
		 * with its table, not by a function of the same name. */
		for key in self.ownedOutputs.keys() {
			if (key.startsWith(declaration.name + ".") && Strings.split(key, ".").len == 2) { selected = key; resultName = self.ownedOutputs.get(key); break; }
		}
		if (selected.isEmpty() || self.ownedOutputResources.has(selected)) { return null; }
		string parameterName = selected.substring(declaration.name.length() + 1, selected.length() - declaration.name.length() - 1);
		int position = -1;
		for index in range(parameterNames.len) { if (parameterNames.get(index) == parameterName) { position = index; } }
		if (position < 0) { self.fail("owned-outputs names an unknown parameter"); }
		NativeNode pointer = self.unqualifiedNative(declaration.signature.parameters.get(position));
		if (pointer.kind != NNK_NATIVE_POINTER || self.unqualifiedNative(pointer.pointee).kind != NNK_NATIVE_POINTER || self.nativeIsConst(pointer.pointee)) { self.fail("owned-outputs requires a mutable resource pointer output slot"); }
		string resource = self.resourceName(pointer.pointee);
		if (resource.isEmpty() || (self.resources.get(resource).ownership != "unique" && self.resources.get(resource).ownership != "com")) { self.fail("owned-outputs requires a declared unique resource"); }
		if (!self.resources.get(resource).storage.isEmpty()) { self.fail("inline resources require checked initializers, not owned pointer outputs"); }
		if (!self.resourcePointerAccepts(self.resourceTypes.get(resource), pointer.pointee) || !self.resourcePointerAccepts(pointer.pointee, self.resourceTypes.get(resource))) { self.fail("owned-outputs has incompatible resource pointer qualifiers"); }
		NativeNode nativeStatus = self.unqualifiedNative(declaration.signature.returnType);
		if (nativeStatus.kind == NNK_NATIVE_ENUM_TYPE) { nativeStatus = self.unqualifiedNative(nativeStatus.underlying); }
		if (nativeStatus.kind != NNK_NATIVE_BUILTIN || !["bool", "_Bool", "char", "signed char", "unsigned char", "short", "unsigned short", "int", "unsigned int", "long", "unsigned long", "long long", "unsigned long long"].contains(nativeStatus.name)) { self.fail("owned-outputs requires an integral or enum status result"); }
		/* A COM [out] interface reports an HRESULT (native-interop-ownership.md section 2.4). */
		bool hresult = self.ownedOutputStatuses.has(selected) && self.ownedOutputStatuses.get(selected) == "hresult";
		if ((self.resources.get(resource).ownership == "com") != hresult) { self.fail("owned-outputs status = hresult pairs with a com interface output"); }
		if (hresult && !self.comInteger(declaration.signature.returnType, "signed")) { self.fail(f"owned-outputs {selected}: status = hresult and status-results require a 32-bit signed result"); }
		Node statusType = self.type(declaration.signature.returnType);
		FeNativeOutputOffset? offset = self.projectOutputOffset(declaration, parameterNames, position);
		self.ownedOutputClass(resultName, statusType, resource, offset);
		self.ownedOutputs.remove(selected);
		FeNativeOwnedOutput projected = FeNativeOwnedOutput(position, resultName, resource, statusType); projected.offset = offset;
		return projected;
	}

	private FeNativeCopiedInput? projectCopiedInput(NativeNode declaration, Vector<string> names) {
		string selected = "";
		for key in self.copiedInputs.keys() { if (key.startsWith(declaration.name + ".")) { selected = key; break; } }
		if (selected.isEmpty()) { return null; }
		FeNativeCopiedInputBinding binding = self.copiedInputs.get(selected);
		string input = Strings.split(selected, ".").get(1);
		int ownerIndex = -1; int inputIndex = -1; int lengthIndex = -1;
		for index in range(names.len) {
			if (names.get(index) == binding.owner) { ownerIndex = index; }
			if (names.get(index) == input) { inputIndex = index; }
			if (names.get(index) == binding.length) { lengthIndex = index; }
		}
		NativeNode nativeReturn = self.unqualifiedNative(declaration.signature.returnType);
		if (declaration.signature.variadic || names.len != 3 || ownerIndex < 0 || inputIndex < 0 || lengthIndex < 0 || nativeReturn.kind != NNK_NATIVE_BUILTIN || nativeReturn.name != "void") { self.fail("copied-inputs requires a void SDK setter with exactly owner, byte pointer and length"); }
		string resource = self.resourceName(declaration.signature.parameters.get(ownerIndex));
		if (resource.isEmpty() || self.resources.get(resource).storage != "inline" || !self.resourceInitializers.has(resource)) { self.fail("copied-inputs requires an initialized inline resource owner"); }
		if (!self.resourceInitializers.get(resource).copiedInput.isEmpty() || self.attachedResources.has(resource)) { self.fail("copied-inputs requires one write-once attachment per resource without initializer input"); }
		NativeNode pointer = self.unqualifiedNative(declaration.signature.parameters.get(inputIndex));
		if (pointer.kind != NNK_NATIVE_POINTER || !self.nativeIsConst(pointer.pointee)) { self.fail("copied-inputs requires a const byte pointer"); }
		NativeNode scalar = self.unqualifiedNative(pointer.pointee);
		if (scalar.kind != NNK_NATIVE_BUILTIN || !["void", "char", "signed char", "unsigned char"].contains(scalar.name)) { self.fail("copied-inputs requires a const byte pointer"); }
		self.validateCopyQualifiers(declaration.signature.parameters.get(inputIndex));
		NativeNode size = self.unqualifiedNative(declaration.signature.parameters.get(lengthIndex));
		if (size.kind != NNK_NATIVE_BUILTIN || !["unsigned int", "unsigned long", "unsigned long long"].contains(size.name)) { self.fail("copied-inputs requires an unsigned byte length"); }
		self.attachedResources.put(resource, true); self.copiedInputs.remove(selected);
		return FeNativeCopiedInput(ownerIndex, inputIndex, lengthIndex, resource);
	}

	private FeNativeOwnedOutput projectInitializer(NativeNode declaration, Vector<string> names) {
		FeNativeInitializerBinding binding = self.initializers.get(declaration.name);
		int position = -1; int copiedInput = -1; int length = -1;
		for index in range(names.len) {
			if (names.get(index) == binding.parameter) { position = index; }
			if (names.get(index) == binding.copiedInput) { copiedInput = index; }
			if (names.get(index) == binding.length) { length = index; }
		}
		if (position < 0) { self.fail("initializer names an unknown storage parameter"); }
		NativeNode native = declaration.signature.parameters.get(position);
		NativeNode resourceType = self.resourceTypes.get(binding.resource);
		if (!self.resourcePointerAccepts(native, resourceType) || !self.resourcePointerAccepts(resourceType, native)) { self.fail("initializer requires exactly its mutable inline resource pointer"); }
		NativeNode successType = declaration.signature.returnType;
		if (!binding.success.isEmpty()) {
			if (!self.callbackExports.has(binding.success)) { self.fail("initializer success requires a selected read-only SDK constant"); }
			NativeNode success = self.callbackExports.get(binding.success);
			if (success.kind != NNK_NATIVE_CONSTANT && !(success.kind == NNK_NATIVE_GLOBAL && success.readOnly)) { self.fail("initializer success requires a selected read-only SDK constant"); }
			successType = success.valueType;
		}
		Vector<string> statuses = [];
		for value in [declaration.signature.returnType, successType] {
			NativeNode scalar = self.unqualifiedNative(value);
			if (scalar.kind == NNK_NATIVE_ENUM_TYPE) { scalar = self.unqualifiedNative(scalar.underlying); }
			if (scalar.kind != NNK_NATIVE_BUILTIN || !["bool", "_Bool", "char", "signed char", "unsigned char", "short", "unsigned short", "int", "unsigned int", "long", "unsigned long", "long long", "unsigned long long"].contains(scalar.name)) { self.fail("initializer status and success require matching integral SDK types"); }
			statuses.push(scalar.name);
		}
		if (statuses.get(0) != statuses.get(1)) { self.fail("initializer status and success require matching integral SDK types"); }
		if (!binding.copiedInput.isEmpty()) {
			if (copiedInput < 0 || length < 0) { self.fail("initializer copied input names an unknown parameter"); }
			NativeNode pointer = self.unqualifiedNative(declaration.signature.parameters.get(copiedInput));
			if (pointer.kind != NNK_NATIVE_POINTER || !self.nativeIsConst(pointer.pointee)) { self.fail("initializer copied input requires a const byte pointer"); }
			NativeNode scalar = self.unqualifiedNative(pointer.pointee);
			if (scalar.kind != NNK_NATIVE_BUILTIN || !["void", "char", "signed char", "unsigned char"].contains(scalar.name)) { self.fail("initializer copied input requires a const byte pointer"); }
			self.validateCopyQualifiers(declaration.signature.parameters.get(copiedInput));
			NativeNode nativeLength = self.unqualifiedNative(declaration.signature.parameters.get(length));
			if (nativeLength.kind != NNK_NATIVE_BUILTIN || !["unsigned int", "unsigned long", "unsigned long long"].contains(nativeLength.name)) { self.fail("initializer copied input requires an unsigned byte length"); }
			if (!self.borrows.has(declaration.name + "." + binding.copiedInput)) { self.fail("initializer copied input requires read-only-borrows"); }
		}
		for index in range(declaration.signature.parameters.len) {
			if (index == position || index == copiedInput) { continue; }
			NativeNode parameter = self.unqualifiedNative(declaration.signature.parameters.get(index));
			string resource = self.resourceName(declaration.signature.parameters.get(index));
			bool borrowed = !resource.isEmpty() && self.resourceBorrows.has(declaration.name + "." + names.get(index));
			if (!borrowed && parameter.kind != NNK_NATIVE_BUILTIN && parameter.kind != NNK_NATIVE_ENUM_TYPE) { self.fail("initializer additional parameters require SDK scalars; retained dependencies need an explicit contract"); }
		}
		for existing in self.declarations { if (existing.declaration.name == binding.result) { self.fail("conflicting initializer result class"); } }
		for existing in self.inputClasses { if (existing.declaration.name == binding.result) { self.fail("conflicting initializer result class"); } }
		Node statusType = self.type(declaration.signature.returnType);
		Node owner = self.node(NK_CLASS_DECL); owner.name = binding.result; owner.sourceFile = self.module;
		Node called = self.node(NK_FIELD_DECL); called.name = "called"; called.access = "public"; called.type = self.node(NK_TYPE_EXPR); called.type.base = "bool";
		Node status = self.node(NK_FIELD_DECL); status.name = "status"; status.access = "public"; status.type = statusType;
		Node value = self.node(NK_FIELD_DECL); value.name = "value"; value.access = "public"; value.type = self.node(NK_TYPE_EXPR); value.type.base = binding.resource; value.type.isNullable = true; value.type.pointerDepth = 1;
		owner.membersStorage = [called, status, value];
		var generated = FeNativeImportedDeclaration(owner, self.module, self.header); generated.generatedInput = true; self.inputClasses.push(generated);
		self.initializers.remove(declaration.name);
		FeNativeOwnedOutput output = FeNativeOwnedOutput(position, binding.result, binding.resource, statusType);
		output.initializer = FeNativeInitializer(binding.success, copiedInput, length);
		return output;
	}

	private string variadicIntegerType(NativeNode native) {
		while (native.kind == NNK_NATIVE_ALIAS || native.kind == NNK_NATIVE_QUALIFIED_TYPE || native.kind == NNK_NATIVE_ENUM_TYPE) { native = native.underlying; }
		if (native.kind != NNK_NATIVE_BUILTIN || !["int", "unsigned int", "long", "unsigned long", "long long", "unsigned long long"].contains(native.name)) { self.fail("variadic-calls selector and value must be promoted integral SDK types"); }
		return native.name;
	}

	private Vector<Node> projectVariadic(NativeNode declaration, Vector<string> parameterNames, FeNativeCallContract contract) {
		string selected = "";
		for key in self.variadicCalls.keys() { if (key == declaration.name || key.startsWith(declaration.name + ".")) { selected = key; break; } }
		if (selected.isEmpty()) {
			if (declaration.signature.variadic) { self.fail("variadic native calls require a selected variadic-calls shape"); }
			Vector<Node> empty = [];
			return empty;
		}
		if (!declaration.signature.variadic) { self.fail("variadic-calls requires an SDK variadic function"); }
		FeNativeVariadicBinding binding = self.variadicCalls.get(selected);
		/* A whole-function shape keeps every fixed parameter visible and
		 * fixes the tail for every call, whatever the fixed arguments say. */
		if (selected != declaration.name) {
			string name = selected.substring(declaration.name.length() + 1, selected.length() - declaration.name.length() - 1);
			int position = -1;
			for index in range(parameterNames.len) { if (parameterNames.get(index) == name) { position = index; } }
			if (position < 0) { self.fail("variadic-calls names an unknown selector parameter"); }
			if (!self.callbackExports.has(binding.value)) { self.fail("variadic-calls value must be a selected read-only SDK integer constant"); }
			NativeNode constant = self.callbackExports.get(binding.value);
			if (constant.kind != NNK_NATIVE_CONSTANT && !(constant.kind == NNK_NATIVE_GLOBAL && constant.readOnly)) { self.fail("variadic-calls value must be a selected read-only SDK integer constant"); }
			if (self.variadicIntegerType(declaration.signature.parameters.get(position)) != self.variadicIntegerType(constant.valueType)) { self.fail("variadic-calls selector and value must have the same SDK integer type"); }
			contract.boundParameter = position; contract.boundConstant = binding.value;
		}
		contract.variadicArguments = binding.arguments;
		Vector<Node> parameters = [];
		Map<string, bool> occupied = {};
		for parameterName in parameterNames { occupied.put(parameterName, true); }
		for index in range(binding.arguments.len) {
			string spelling = binding.arguments.get(index);
			bool pointer = spelling.endsWith("*");
			string scalar = pointer ? spelling.substring(0, spelling.length() - 1).trim() : spelling;
			bool constantScalar = scalar.startsWith("const ");
			Node parameter = self.node(NK_PARAM); parameter.name = f"variadicArgument{index}";
			while (occupied.has(parameter.name)) { parameter.name = parameter.name + "_"; }
			occupied.put(parameter.name, true);
			parameter.type = self.node(NK_TYPE_EXPR);
			parameter.type.base = constantScalar ? scalar.substring(6, scalar.length() - 6) : scalar;
			parameter.type.isConst = constantScalar; parameter.type.pointerDepth = pointer ? 1 : 0;
			parameters.push(parameter);
		}
		self.variadicCalls.remove(selected);
		return parameters;
	}

	/* The first member of a GNU transparent-union parameter, else null. GCC
	 * passes such an argument with its first member's convention and converts
	 * any member type at the call, so that member is the projected parameter
	 * type (glibc's `__CONST_SOCKADDR_ARG` becomes the portable
	 * `const struct sockaddr*`). Every other by-value union stays refused. */
	private NativeNode? transparentUnionMember(NativeNode native) {
		NativeNode record = self.unqualifiedNative(native);
		if (record.kind != NNK_NATIVE_RECORD_TYPE || record.opaque || !self.layouts.has(record.identity)) { return null; }
		NativeNode layout = self.layouts.get(record.identity);
		if (!layout.transparentUnion) { return null; }
		NativeNode member = layout.fields.get(0);
		if (member.isAnonymous || member.isBitfield) { self.fail("transparent-union parameters require a named first member"); }
		return member.fieldType;
	}

	private Vector<string> parameterNames(NativeNode declaration) { return self.semanticNames(declaration.parameterSemantics); }

	private Vector<string> semanticNames(Vector<NativeNode> semantics) {
		Map<string, bool> occupied = {};
		for parameter in semantics { if (!parameter.name.isEmpty()) { occupied.put(parameter.name, true); } }
		Vector<string> names = [];
		for index in range(semantics.len) {
			string name = semantics.get(index).name;
			if (name.isEmpty()) {
				name = f"argument{index}";
				while (occupied.has(name)) { name = name + "_"; }
				occupied.put(name, true);
			}
			names.push(name);
		}
		return names;
	}

	private void importResourceOutput(NativeNode declaration, Node imported, FeNativeCallContract contract) {
		string selected = "";
		for key in self.ownedOutputResources.keys() { if (key.startsWith(declaration.name + ".")) { selected = key; break; } }
		if (selected.isEmpty()) { return; }
		var projection = self.ownedOutputResources.get(selected);
		Vector<string> names = self.parameterNames(declaration);
		string outputName = Strings.split(selected, ".").get(1);
		int position = -1; int sizeIndex = -1;
		for index in range(names.len) { if (names.get(index) == outputName) { position = index; } if (names.get(index) == projection.sizeParameter) { sizeIndex = index; } }
		if (position < 0 || sizeIndex < 0) { self.fail("erased owned-outputs names an unknown output or size parameter"); }
		NativeNode outputPointer = self.unqualifiedNative(declaration.signature.parameters.get(position));
		NativeNode sizePointer = self.unqualifiedNative(declaration.signature.parameters.get(sizeIndex));
		if (outputPointer.kind != NNK_NATIVE_POINTER || self.nativeIsConst(outputPointer.pointee) || self.unqualifiedNative(outputPointer.pointee).kind != NNK_NATIVE_BUILTIN || self.unqualifiedNative(outputPointer.pointee).name != "void") { self.fail("erased owned-outputs requires mutable void-pointer output storage"); }
		if (sizePointer.kind != NNK_NATIVE_POINTER || self.nativeIsConst(sizePointer.pointee)) { self.fail("erased owned-outputs requires an unsigned integral mutable size pointer"); }
		NativeNode sizeValue = self.unqualifiedNative(sizePointer.pointee);
		if (sizeValue.kind != NNK_NATIVE_BUILTIN || !["unsigned char", "unsigned short", "unsigned int", "unsigned long", "unsigned long long"].contains(sizeValue.name)) { self.fail("erased owned-outputs requires an unsigned integral mutable size pointer"); }
		NativeNode status = self.unqualifiedNative(declaration.signature.returnType);
		if (status.kind == NNK_NATIVE_ENUM_TYPE) { status = self.unqualifiedNative(status.underlying); }
		if (status.kind != NNK_NATIVE_BUILTIN || !["bool", "_Bool", "char", "signed char", "unsigned char", "short", "unsigned short", "int", "unsigned int", "long", "unsigned long", "long long", "unsigned long long"].contains(status.name)) { self.fail("owned-outputs requires an integral or enum status result"); }
		if (contract.callbacks.len > 0 || contract.realtimeSafe || contract.ownedOutput != null || contract.recordOutput != null) { self.fail("erased owned-outputs cannot combine callbacks, realtime, record outputs or output-offsets"); }
		for input in contract.recordInputs { if (input != null) { self.fail("erased owned-outputs cannot combine record inputs"); } }
		for offset in self.outputOffsets.keys() { if (offset.startsWith(declaration.name + ".")) { self.fail("erased owned-outputs cannot combine output-offsets"); } }
		string resource = projection.resource;
		if (!self.resources.has(resource) || self.resources.get(resource).ownership != "reference-counted") { self.fail("erased owned-outputs requires a declared reference-counted resource"); }
		string resultName = self.ownedOutputs.get(selected);
		for prior in self.declarations { if (prior.declaration.name == resultName || prior.declaration.name == projection.alias) { self.fail("conflicting erased owned-output alias or result class"); } }
		for prior in self.inputClasses { if (prior.declaration.name == resultName || prior.declaration.name == projection.alias) { self.fail("conflicting erased owned-output alias or result class"); } }
		Node sizeType = self.type(sizePointer.pointee);
		Node owner = self.node(NK_CLASS_DECL); owner.name = resultName; owner.sourceFile = self.module;
		Node valueType = self.node(NK_TYPE_EXPR); valueType.base = resource; valueType.isNullable = true; valueType.pointerDepth = 1;
		Node boolType = self.node(NK_TYPE_EXPR); boolType.base = "bool";
		Vector<string> fields = ["status", "size", "sizeValid", "value"];
		Vector<Node> fieldTypes = [imported.returnType, sizeType, boolType, valueType];
		for index in range(fields.len) { Node field = self.node(NK_FIELD_DECL); field.access = "public"; field.name = fields.get(index); field.type = fieldTypes.get(index); owner.membersMut().push(field); }
		var generated = FeNativeImportedDeclaration(owner, self.module, self.header); generated.generatedInput = true;
		self.inputClasses.push(generated);
		var output = FeNativeOwnedOutput(position, resultName, resource, imported.returnType);
		output.sizedResource = FeNativeSizedResourceOutput(sizeIndex, sizeType, declaration.name);
		var aliasContract = FeNativeCallContract(); aliasContract.ownedOutput = output;
		Node alias = self.node(NK_FUNCTION_DECL); alias.name = projection.alias; alias.returnType = self.node(NK_TYPE_EXPR); alias.returnType.base = resultName;
		for index in range(names.len) {
			if (output.hides(index)) { continue; }
			alias.paramsMut().push(imported.params().get(index));
			aliasContract.nonnullParameters.push(contract.nonnullParameters.get(index));
			aliasContract.readOnlyBorrows.push(contract.readOnlyBorrows.get(index));
			aliasContract.resourceParameters.push(contract.resourceParameters.get(index));
		}
		self.add(projection.alias, alias, "sized-resource-output:" + declaration.name + ":" + selected + ":" + resource + ":" + projection.sizeParameter, "", false, aliasContract);
		self.ownedOutputs.remove(selected); self.ownedOutputResources.remove(selected);
	}

	/* A C entry naming an SDK-instantiated adapter class, such as
	 * UIApplicationMain. The class-name parameter becomes the receiver
	 * interface; the call runs in the Objective-C adapter unit, where the
	 * generated class is named. Other arguments are C scalars and pointers or
	 * borrowed Objective-C objects, and the result is a scalar or void. */
	private void importInstantiatedEntry(NativeNode declaration) {
		NativeNode signature = declaration.signature;
		self.requireQualifiedConvention(signature);
		bool consuming = false;
		for semantics in declaration.parameterSemantics { if (semantics.cfConsumed || semantics.nsConsumed) { consuming = true; } }
		if (signature.variadic || declaration.returnedOwnership != "unspecified" || consuming) { self.fail("instantiated entry functions require a non-variadic, non-consuming signature"); }
		var contract = FeNativeCallContract();
		contract.callbacks = self.projectCallbacks(declaration);
		if (contract.callbacks.len != 1 || contract.callbacks.get(0).instantiatedScope.isEmpty()) { self.fail("an instantiated entry function takes exactly one instantiated adapter"); }
		FeNativeCallbackProjection callback = contract.callbacks.get(0);
		Vector<string> parameterNames = self.parameterNames(declaration);
		Node imported = self.node(NK_FUNCTION_DECL);
		imported.name = declaration.name;
		for index in range(signature.parameters.len) {
			Node parameter = self.node(NK_PARAM);
			parameter.name = parameterNames.get(index);
			NativeNode native = signature.parameters.get(index);
			if (index == callback.parameterIndex) {
				parameter.type = self.node(NK_TYPE_EXPR);
				parameter.type.base = callback.interfaceName;
				contract.nonnullParameters.push(true);
			} else {
				parameter.type = self.unqualifiedNative(native).kind == NNK_NATIVE_OBJECTIVE_C_OBJECT ? self.objectiveCType(native, true) : self.callType(native, true);
				contract.nonnullParameters.push(self.callNullability(native).equals("nonnull"));
			}
			contract.readOnlyBorrows.push(false);
			contract.resourceParameters.push("");
			imported.paramsMut().push(parameter);
		}
		NativeNode result = self.unqualifiedNative(signature.returnType);
		if (result.kind == NNK_NATIVE_OBJECTIVE_C_OBJECT || result.kind == NNK_NATIVE_POINTER) { self.fail("instantiated entry functions require a scalar or void result"); }
		imported.returnType = self.callType(signature.returnType);
		self.add(declaration.name, imported, self.declarationIdentity(declaration), "", false, contract, null, false);
	}

	/* Only the C convention is qualified; the reader reports the others. */
	private void requireQualifiedConvention(NativeNode signature) {
		if (signature.callingConvention != "c") { self.fail("native calling convention '" + signature.callingConvention + "' is not supported"); }
	}

	private void importDeclaration(NativeNode declaration) {
		if (self.callbackOperations.has(declaration.name)) { return; }
		if (self.language == "objective-c" && declaration.kind == NNK_NATIVE_FUNCTION) {
			for key in self.callbacks.keys() {
				if (key.startsWith(declaration.name + ".") && self.callbacks.get(key).lifetime == "instantiated") {
					self.importInstantiatedEntry(declaration);
					return;
				}
			}
		}
		if (self.language == "objective-c" && declaration.kind != NNK_NATIVE_OBJECTIVE_C_METHOD && declaration.kind != NNK_NATIVE_CONSTANT && declaration.kind != NNK_NATIVE_STRING_CONSTANT && declaration.kind != NNK_NATIVE_GLOBAL) { self.fail("Objective-C header declarations require adapter lowering"); }
		Node imported = Node();
		FeNativeCallContract? contract = null;
		if (declaration.kind == NNK_NATIVE_FUNCTION) {
			if (self.resourceOperations.has(declaration.name)) {
				/* Only the binding that declares the operation hides it; an
				 * ordinary selection elsewhere is the reserved conflict,
				 * whichever binding is resolved first. */
				if (!self.bindingOperations.has(declaration.name)) { self.fail("resource lifetime operations are reserved across native bindings"); }
				return;
			}
			var callContract = FeNativeCallContract();
			callContract.realtimeSafe = self.realtime.has(declaration.name);
			self.realtime.remove(declaration.name);
			NativeNode signature = declaration.signature;
			self.requireQualifiedConvention(signature);
			if (self.comBinding) {
				for parameter in declaration.parameterSemantics { if (parameter.name == "pUnkOuter") { self.fail(f"{declaration.name}: COM aggregation is not supported; pUnkOuter must be hidden or null"); } }
			}
			/* The included SDK header owns asm labels. Calls use its source name,
			 * never a reconstructed declaration or the native linker spelling. */
			callContract.resourceResult = self.projectResourcePosition(declaration.name, signature.returnType, true);
			Vector<string> parameterNames = self.parameterNames(declaration);
			Vector<Node> variadicParameters = self.projectVariadic(declaration, parameterNames, callContract);
			callContract.ownedOutput = self.projectOwnedOutput(declaration, parameterNames);
			callContract.copiedInput = self.projectCopiedInput(declaration, parameterNames);
			callContract.copiedResult = self.projectCopiedResult(declaration, parameterNames);
			string borrowedOwner = self.borrowedResults.has(declaration.name) ? self.borrowedResults.get(declaration.name) : "";
			int borrowedOwnerIndex = -1;
			if (!borrowedOwner.isEmpty()) {
				if (callContract.resourceResult.isEmpty() || self.resources.get(callContract.resourceResult).ownership != "reference-counted") { self.fail("borrowed-results requires a reference-counted result"); }
				if (declaration.returnedOwnership != "unspecified" && declaration.returnedOwnership != "cf_not_retained") { self.fail("borrowed-results contradicts SDK retained ownership"); }
				for index in range(declaration.parameterSemantics.len) {
					if (parameterNames.get(index) != borrowedOwner) { continue; }
					string ownerResource = self.projectResourcePosition(declaration.name + "." + parameterNames.get(index), signature.parameters.get(index), false, false);
					if (ownerResource.isEmpty() || self.resources.get(ownerResource).ownership != "reference-counted") { self.fail("borrowed-results owner must be a borrowed reference-counted parameter"); }
					borrowedOwnerIndex = index;
				}
				if (borrowedOwnerIndex < 0) { self.fail("borrowed-results names an unknown owner parameter"); }
				self.borrowedResults.remove(declaration.name);
			}
			if (declaration.returnedOwnership != "unspecified" && callContract.resourceResult.isEmpty()) { self.fail("annotated native ownership requires managed native lowering"); }
			if (!callContract.resourceResult.isEmpty() && borrowedOwner.isEmpty()) {
				if (!self.resources.get(callContract.resourceResult).storage.isEmpty()) { self.fail("inline resources require checked initializers, not owned pointer results"); }
				if (self.resources.get(callContract.resourceResult).ownership == "unique" && !self.resourcePointerAccepts(self.resourceTypes.get(callContract.resourceResult), signature.returnType)) { self.fail("unique resource result has incompatible pointer qualifiers"); }
				if (declaration.returnedOwnership != "unspecified" && declaration.returnedOwnership != "cf_retained") { self.fail("resource result contradicts owned ownership; borrowed results require an owner"); }
				if (!self.ownedResults.has(declaration.name) && declaration.returnedOwnership != "cf_retained") { self.fail("resource result requires owned-results or SDK retained ownership"); }
				self.ownedResults.remove(declaration.name);
			}
			for semantics in declaration.parameterSemantics {
				if (semantics.cfConsumed || semantics.nsConsumed) { self.fail("annotated native ownership requires managed native lowering"); }
			}
			imported = self.node(NK_FUNCTION_DECL);
			imported.name = declaration.name;
			callContract.callbacks = self.projectCallbacks(declaration);
			if (callContract.copiedInput != null && (callContract.callbacks.len > 0 || callContract.ownedOutput != null || callContract.copiedResult != null || !callContract.resourceResult.isEmpty() || callContract.realtimeSafe || callContract.variadicArguments.len > 0)) { self.fail("copied-inputs cannot combine callbacks, other result mappings or realtime calls"); }
			if (callContract.copiedResult != null && (callContract.callbacks.len > 0 || callContract.ownedOutput != null || !callContract.resourceResult.isEmpty() || callContract.realtimeSafe || callContract.variadicArguments.len > 0)) { self.fail("copied-results does not support callbacks, other owned results, variadic, or realtime calls"); }
			if (callContract.variadicArguments.len > 0 && (callContract.callbacks.len > 0 || callContract.ownedOutput != null || !callContract.resourceResult.isEmpty() || callContract.realtimeSafe)) { self.fail("variadic-calls does not support callbacks, owned outputs/results, or realtime calls"); }
			if (callContract.ownedOutput != null && (callContract.callbacks.len > 0 || callContract.realtimeSafe)) { self.fail("owned-outputs does not support callbacks or realtime calls"); }
			Map<int, FeNativeCallbackProjection> callbackParameters = {};
			Map<int, bool> callbackContexts = {};
			for callback in callContract.callbacks {
				callbackParameters.put(callback.parameterIndex, callback);
				if (callback.contextIndex >= 0) { callbackContexts.put(callback.contextIndex, true); }
				for position in callback.registrationContexts { callbackContexts.put(position, true); }
			}
			for index in range(signature.parameters.len) {
				if (callContract.ownedOutput != null && callContract.ownedOutput.hides(index)) { continue; }
				string name = parameterNames.get(index);
				Node parameter = self.node(NK_PARAM);
				parameter.name = name;
				string key = declaration.name + "." + name;
				string resourceParameter = self.projectResourcePosition(key, signature.parameters.get(index));
				if (index == callContract.boundParameter) {
					if (self.borrows.has(key) || !resourceParameter.isEmpty()) { self.fail("variadic-calls selector cannot carry a resource or borrow mapping"); }
					continue;
				}
				if (callbackContexts.has(index)) {
					if (self.borrows.has(key) || !resourceParameter.isEmpty()) { self.fail("callback context cannot also declare a borrow or resource mapping"); }
					continue;
				}
				if (!resourceParameter.isEmpty()) {
					if (self.resources.get(resourceParameter).ownership == "unique" && !self.resourcePointerAccepts(signature.parameters.get(index), self.resourceTypes.get(resourceParameter))) { self.fail("unique resource parameter has incompatible pointer qualifiers"); }
					if (!self.resourceBorrows.has(key)) { self.fail(f"resource parameter {key} requires borrowed-parameters"); }
					self.resourceBorrows.remove(key);
				}
				callContract.resourceParameters.push(resourceParameter);
				if (index == borrowedOwnerIndex) { callContract.borrowedResultOwner = imported.params().len; }
				NativeNode? member = self.transparentUnionMember(signature.parameters.get(index));
				callContract.transparentParameters.push(member != null);
				if (callbackParameters.has(index) && callbackParameters.get(index).field.isEmpty()) {
					parameter.type = self.node(NK_TYPE_EXPR);
					parameter.type.base = callbackParameters.get(index).interfaceName;
				} else if (!resourceParameter.isEmpty()) { parameter.type = self.resourceCallType(signature.parameters.get(index), resourceParameter); }
				else if (member != null) { parameter.type = self.callType(member, true); }
				else { parameter.type = self.callType(signature.parameters.get(index), true); }
				bool borrowed = self.borrows.has(key);
				if (borrowed) {
					NativeNode scalar = signature.parameters.get(index);
					while (scalar.kind == NNK_NATIVE_ALIAS || scalar.kind == NNK_NATIVE_QUALIFIED_TYPE) { scalar = scalar.underlying; }
					if (scalar.kind == NNK_NATIVE_POINTER) { scalar = scalar.pointee; }
					while (scalar.kind == NNK_NATIVE_ALIAS || scalar.kind == NNK_NATIVE_QUALIFIED_TYPE) { scalar = scalar.underlying; }
					if (parameter.type.pointerDepth != 1 || !parameter.type.isConst || scalar.kind != NNK_NATIVE_BUILTIN) { self.fail("read-only-borrows requires a const scalar pointer parameter"); }
					self.borrows.remove(key);
				}
				callContract.readOnlyBorrows.push(borrowed);
				callContract.nonnullParameters.push(callbackParameters.has(index) || (!(callContract.copiedInput != null && index == callContract.copiedInput.inputIndex) && self.callNullability(signature.parameters.get(index)).equals("nonnull")));
				imported.paramsMut().push(parameter);
			}
			if (callContract.transparentParameters.contains(true)) {
				bool borrowed = callContract.readOnlyBorrows.contains(true);
				bool resource = false;
				for value in callContract.resourceParameters { if (!value.isEmpty()) { resource = true; } }
				if (callContract.callbacks.len > 0 || callContract.ownedOutput != null || callContract.copiedInput != null || callContract.copiedResult != null || !callContract.resourceResult.isEmpty() || borrowed || resource || callContract.realtimeSafe) { self.fail("transparent-union parameters do not support callbacks, borrows, resources, owned or copied results, or realtime calls"); }
			}
			for parameter in variadicParameters {
				imported.paramsMut().push(parameter); callContract.resourceParameters.push(""); callContract.readOnlyBorrows.push(false); callContract.nonnullParameters.push(false); callContract.transparentParameters.push(false);
			}
			imported.returnType = self.resourceCallType(signature.returnType, callContract.resourceResult);
			if (callContract.copiedInput != null) { imported.returnType = self.node(NK_TYPE_EXPR); imported.returnType.base = "bool"; }
			var ownedOutput = callContract.ownedOutput;
			if (ownedOutput != null) { imported.returnType = self.node(NK_TYPE_EXPR); imported.returnType.base = ownedOutput.resultName; }
			var copiedResult = callContract.copiedResult;
			if (copiedResult != null) { imported.returnType = self.node(NK_TYPE_EXPR); imported.returnType.base = copiedResult.kind == "string" ? "string" : "Bytes"; imported.returnType.isNullable = true; }
			for callback in callContract.callbacks {
				if (callback.registrationContexts.len == 0) { continue; }
				/* A stored C registration returns its managed registration; the
				 * native status is consumed by the generated adapter. */
				if (!borrowedOwner.isEmpty() || !callContract.resourceResult.isEmpty() || callContract.callbacks.len != 1) { self.fail("a stored C registration takes exactly one callback and no result mapping"); }
				Node receiver = self.node(NK_TYPE_EXPR);
				receiver.base = callback.interfaceName;
				Node voidResult = self.node(NK_TYPE_EXPR);
				voidResult.base = "void";
				Node voidPointer = self.node(NK_TYPE_EXPR);
				voidPointer.base = "void";
				voidPointer.pointerDepth = 1;
				/* CFunction<void, void*>, in the parser's exact callback spelling. */
				Node destroyType = self.node(NK_TYPE_EXPR);
				destroyType.base = "__fn_ptr";
				destroyType.genericArgsStorage = [voidResult, voidPointer];
				Node token = self.node(NK_TYPE_EXPR);
				token.base = "OwnedClosure";
				token.genericArgsStorage = [destroyType];
				imported.returnType = self.node(NK_TYPE_EXPR);
				imported.returnType.base = "CallbackContext";
				imported.returnType.genericArgsStorage = [receiver, token];
				Node scope = self.node(NK_PARAM);
				scope.name = "scope";
				while (parameterNames.contains(scope.name)) { scope.name = scope.name + "_"; }
				scope.type = self.node(NK_TYPE_EXPR);
				scope.type.base = "CallbackScope";
				imported.paramsMut().push(scope);
				callContract.nonnullParameters.push(true);
				callContract.readOnlyBorrows.push(false);
				callContract.resourceParameters.push("");
			}
			for callback in callContract.callbacks {
				if (!callback.oneShot) { continue; }
				if (!borrowedOwner.isEmpty()) { self.fail("borrowed-results does not support one-shot callback registration"); }
				if (callContract.callbacks.len != 1) { self.fail("one-shot currently requires exactly one callback"); }
				Node receiver = self.node(NK_TYPE_EXPR);
				receiver.base = callback.interfaceName;
				Node requestType = self.node(NK_TYPE_EXPR);
				requestType.base = "CallbackRequest";
				requestType.genericArgsStorage = [receiver];
				if (imported.returnType.base == "void") { imported.returnType = requestType; }
				else {
					Node pair = self.node(NK_TYPE_EXPR);
					pair.base = "CallbackResult";
					pair.genericArgsStorage = [imported.returnType, requestType];
					imported.returnType = pair;
				}
				Node scope = self.node(NK_PARAM);
				scope.name = "scope";
				while (parameterNames.contains(scope.name)) { scope.name = scope.name + "_"; }
				scope.type = self.node(NK_TYPE_EXPR);
				scope.type.base = "CallbackScope";
				imported.paramsMut().push(scope);
				callContract.nonnullParameters.push(true);
				callContract.readOnlyBorrows.push(false);
				callContract.resourceParameters.push("");
			}
			if (callContract.realtimeSafe) {
				if (callContract.callbacks.len > 0) { self.fail("managed callback adapters are not realtime-safe"); }
				if (!callContract.resourceResult.isEmpty()) { self.fail("managed resource adapters are not realtime-safe"); }
				for resource in callContract.resourceParameters { if (!resource.isEmpty()) { self.fail("managed resource adapters are not realtime-safe"); } }
			}
			callContract.nonnullReturn = self.callNullability(signature.returnType).equals("nonnull");
			contract = callContract;
		} else if (declaration.kind == NNK_NATIVE_GLOBAL) {
			string resourceGlobal = "";
			if (self.staticGlobals.has(declaration.name)) {
				resourceGlobal = self.resourceName(declaration.valueType);
				if (resourceGlobal.isEmpty() || self.resources.get(resourceGlobal).ownership != "reference-counted") { self.fail("static-globals requires reference-counted resource globals"); }
				if (!declaration.readOnly) { self.fail("static-globals requires read-only SDK storage"); }
				contract = FeNativeCallContract(); contract.resourceResult = resourceGlobal;
				contract.nonnullReturn = self.callNullability(declaration.valueType) == "nonnull";
				self.staticGlobals.remove(declaration.name);
			}
			imported = self.node(NK_VAR_DECL_STMT);
			imported.name = declaration.name;
			NativeNode native = declaration.valueType;
			while (native.kind == NNK_NATIVE_ALIAS || native.kind == NNK_NATIVE_QUALIFIED_TYPE) { native = native.underlying; }
			bool objectGlobal = self.language == "objective-c" && native.kind == NNK_NATIVE_OBJECTIVE_C_OBJECT;
			if (self.mainThreadGlobals.has(declaration.name)) {
				if (!objectGlobal) { self.fail("main-thread-globals requires Objective-C object globals"); }
				contract = FeNativeCallContract();
				contract.executor = "main";
				self.mainThreadGlobals.remove(declaration.name);
			}
			if (objectGlobal && !declaration.readOnly && contract == null) { self.fail("Mutable Objective-C object globals require managed storage lowering"); }
			imported.type = !resourceGlobal.isEmpty() ? self.resourceCallType(declaration.valueType) : objectGlobal ? self.objectiveCType(declaration.valueType, false, "", true) : self.language == "objective-c" ? self.objectiveCScalar(declaration.valueType) : self.type(declaration.valueType);
			imported.type.isExtern = true;
			if (declaration.readOnly && !objectGlobal && resourceGlobal.isEmpty() && native.kind != NNK_NATIVE_POINTER) { imported.type.isConst = true; }
		} else if (declaration.kind == NNK_NATIVE_CONSTANT) {
			imported = self.node(NK_VAR_DECL_STMT);
			imported.name = declaration.name;
			imported.type = self.language == "objective-c" ? self.objectiveCScalar(declaration.valueType) : self.type(declaration.valueType);
			imported.type.isConst = true;
			NativeNode native = declaration.valueType;
			while (native.kind == NNK_NATIVE_ALIAS || native.kind == NNK_NATIVE_QUALIFIED_TYPE || native.kind == NNK_NATIVE_ENUM_TYPE) { native = native.underlying; }
			imported.initializer = self.integer(declaration.decimalValue, native.kind == NNK_NATIVE_BUILTIN && native.signedness == "unsigned" ? "U" : "");
		} else if (declaration.kind == NNK_NATIVE_POINTER_CONSTANT) {
			if (self.language != "c") { self.fail("native pointer constants require C header visibility"); }
			// The SDK owns the value expression; the decimal address is identity,
			// never an initializer or a synthesized storage declaration.
			imported = self.node(NK_VAR_DECL_STMT);
			imported.name = declaration.name;
			imported.type = self.type(declaration.valueType);
			imported.type.isExtern = true;
		} else if (declaration.kind == NNK_NATIVE_STRING_CONSTANT) {
			// The C use names the macro, whose literal decays to `const char*`: the
			// same projection, and the same read-only protection, as an SDK
			// `const char* const` global.
			NativeNode? pointee = declaration.valueType.kind == NNK_NATIVE_POINTER ? declaration.valueType.pointee : null;
			if (pointee == null || pointee.kind != NNK_NATIVE_BUILTIN || pointee.name != "char" || !pointee.qualifiers.isConst || declaration.valueType.qualifiers.isConst) { self.fail("native string constant requires its literal's const char pointer"); }
			if (self.language == "objective-c") { self.fail("Objective-C string constants require adapter lowering"); }
			imported = self.node(NK_VAR_DECL_STMT);
			imported.name = declaration.name;
			imported.type = self.type(declaration.valueType);
			imported.type.isExtern = true;
		} else if (declaration.kind == NNK_NATIVE_TYPEDEF) {
			if (self.resources.has(declaration.name)) { return; }
			self.alias(declaration.name, declaration.underlying);
			if (self.unmanagedHandles.has(declaration.name)) {
				bool marked = false;
				for imported in self.declarations {
					if (imported.module == self.module && imported.declaration.kind == NK_TYPEDEF_DECL && imported.declaration.alias == declaration.name) {
						imported.unmanagedRelease = self.unmanagedHandles.get(declaration.name);
						marked = true;
					}
				}
				if (!marked) { self.fail(f"unmanaged-handles.{declaration.name} requires a selected record-pointer typedef that is not a resource"); }
			}
			return;
		} else if (declaration.kind == NNK_NATIVE_RECORD_DECLARATION) {
			if (self.resources.has(declaration.name)) { return; }
			self.type(declaration.recordType);
			return;
		} else if (declaration.kind == NNK_NATIVE_OBJECTIVE_C_METHOD) { self.importObjectiveCMethod(declaration); return; }
		else { self.fail("selected native records require native-type lowering"); }
		self.add(declaration.name, imported, self.declarationIdentity(declaration), "", declaration.kind == NNK_NATIVE_STRING_CONSTANT || declaration.kind == NNK_NATIVE_POINTER_CONSTANT || (declaration.kind == NNK_NATIVE_GLOBAL && (declaration.readOnly || contract != null)), contract, null, declaration.kind == NNK_NATIVE_POINTER_CONSTANT);
		if (declaration.kind == NNK_NATIVE_FUNCTION) {
			if (contract == null) { self.fail("internal compiler error: native function import has no call contract"); }
			self.importResourceOutput(declaration, imported, contract);
		}
	}

	private string declarationIdentity(NativeNode declaration) {
		string identity = f"{declaration.kind}:";
		if (declaration.kind == NNK_NATIVE_FUNCTION) {
			identity = identity + declaration.linkName + ":" + self.typeIdentity(declaration.signature) + ":" + declaration.returnedOwnership;
			for parameter in declaration.parameterSemantics { identity = identity + f":{parameter.cfConsumed}:{parameter.nsConsumed}:{parameter.noEscape}"; }
			return identity;
		}
		identity = identity + self.typeIdentity(declaration.valueType);
		if (declaration.kind == NNK_NATIVE_POINTER_CONSTANT) { return identity + f":{declaration.pointerBits}:" + declaration.decimalValue; }
		if (declaration.kind == NNK_NATIVE_STRING_CONSTANT) { return identity + ":" + declaration.stringValue; }
		return identity + (declaration.kind == NNK_NATIVE_GLOBAL ? f":{declaration.readOnly}" : ":" + declaration.decimalValue);
	}

	private Node objectiveCScalar(NativeNode native) {
		bool constant = false;
		while (native.kind == NNK_NATIVE_ALIAS || native.kind == NNK_NATIVE_QUALIFIED_TYPE || native.kind == NNK_NATIVE_ENUM_TYPE) {
			if (native.qualifiers.isVolatile || native.qualifiers.isRestrict) { self.fail("Objective-C scalar qualifiers require native-type lowering"); }
			constant = constant || native.qualifiers.isConst;
			native = native.underlying;
		}
		if (native.kind != NNK_NATIVE_BUILTIN) { self.fail("Objective-C objects, pointers and aggregates require managed native lowering"); }
		Node projected = self.node(NK_TYPE_EXPR);
		if (native.name == "bool" || native.name == "_Bool") { projected.base = "bool"; projected = self.qualify(projected, native); }
		else { projected = self.type(native); }
		projected.isConst = projected.isConst || constant;
		return projected;
	}

	private Node objectiveCValue(NativeNode native) {
		NativeNode original = native;
		bool constant = false;
		while (native.kind == NNK_NATIVE_ALIAS || native.kind == NNK_NATIVE_QUALIFIED_TYPE) {
			if (native.qualifiers.isVolatile || native.qualifiers.isRestrict) { self.fail("Objective-C value qualifiers require native-type lowering"); }
			constant = constant || native.qualifiers.isConst;
			native = native.underlying;
		}
		if (native.kind != NNK_NATIVE_RECORD_TYPE) { return self.objectiveCScalar(original); }
		if (!native.complete || native.opaque || self.layouts.get(native.identity).fields.len == 0) { self.fail("Objective-C record values require complete nonempty fields"); }
		Node projected = self.qualify(self.record(native), native);
		projected.isConst = constant || projected.isConst;
		return projected;
	}

	private FeNativeImportedDeclaration objectiveCClass(string name) {
		string key = self.module + "\x1f" + name;
		if (!self.typeIdentities.has(key)) {
			var owner = self.node(NK_CLASS_DECL);
			owner.name = name;
			owner.isAbstract = true;
			self.add(name, owner, "objective-c-class:" + name);
		}
		for imported in self.declarations {
			if (imported.module != self.module || imported.declaration.name != name) { continue; }
			if (imported.declaration.kind != NK_CLASS_DECL || imported.language != "objective-c" || imported.objectiveCProtocol) { self.fail(f"conflicting native declaration '{name}'"); }
			return imported;
		}
		self.fail(f"missing native class '{name}'");
		return (FeNativeImportedDeclaration)null;
	}

	/* The handle of an Objective-C protocol P: a managed object that conforms
	 * to P. Its methods are the protocol's selected instance requirements. It
	 * converts to id unchecked, and `(P?)value` asks conformsToProtocol: (M3,
	 * native-interop-ownership.md section 2.2). The generated unit spells it
	 * id<P>. */
	private FeNativeImportedDeclaration objectiveCProtocol(string name) {
		string key = self.module + "\x1f" + name;
		bool created = !self.typeIdentities.has(key);
		if (created) {
			var owner = self.node(NK_CLASS_DECL);
			owner.name = name;
			owner.isAbstract = true;
			self.add(name, owner, "objective-c-protocol:" + name);
		}
		for imported in self.declarations {
			if (imported.module != self.module || imported.declaration.name != name) { continue; }
			if (created) { imported.objectiveCProtocol = true; }
			if (imported.declaration.kind != NK_CLASS_DECL || imported.language != "objective-c" || !imported.objectiveCProtocol) { self.fail(f"conflicting native declaration '{name}'"); }
			return imported;
		}
		self.fail(f"missing native protocol '{name}'");
		return (FeNativeImportedDeclaration)null;
	}

	private Node objectiveCType(NativeNode native, bool parameter = false, string relatedOwner = "", bool readOnlySlot = false, bool cancellationToken = false) {
		NativeNode original = native;
		string nullability = "unannotated";
		bool qualified = false;
		while (true) {
			qualified = qualified || (native.qualifiers.isConst && !readOnlySlot) || native.qualifiers.isVolatile || native.qualifiers.isRestrict;
			string annotation = native.qualifiers.nullability;
			if (annotation != "unannotated") {
				if (nullability != "unannotated" && nullability != annotation) { self.fail("conflicting Objective-C nullability"); }
				nullability = annotation;
			}
			if (native.kind != NNK_NATIVE_ALIAS && native.kind != NNK_NATIVE_QUALIFIED_TYPE) { break; }
			native = native.underlying;
		}
		if (native.kind == NNK_NATIVE_POINTER && native.pointee.kind == NNK_NATIVE_BUILTIN && native.pointee.name == "SEL") {
			NativeNode qualifiers = native.pointee.qualifiers;
			if (qualified || qualifiers.isConst || qualifiers.isVolatile || qualifiers.isRestrict || qualifiers.nullability != "unannotated" || (nullability != "unannotated" && nullability != "nullable" && nullability != "nonnull")) { self.fail("unsupported Objective-C selector qualifiers"); }
			self.requiresSelector = true;
			var projected = self.node(NK_TYPE_EXPR);
			projected.base = "SEL";
			projected.isNullable = nullability != "nonnull";
			projected.pointerDepth = projected.isNullable ? 1 : 0;
			return projected;
		}
		if (parameter && native.kind == NNK_NATIVE_POINTER) {
			if (qualified || (nullability != "unannotated" && nullability != "nullable" && nullability != "nonnull")) { self.fail("unsupported Objective-C pointer qualifiers"); }
			Node projected = self.objectiveCScalar(native.pointee);
			projected.pointerDepth = 1;
			projected.isNullable = nullability != "nonnull";
			return projected;
		}
		if (native.kind != NNK_NATIVE_OBJECTIVE_C_OBJECT) { return self.objectiveCValue(original); }
		string name = relatedOwner != "" ? relatedOwner : native.name;
		bool opaqueToken = cancellationToken && (name.isEmpty() || name == "id");
		/* Lightweight generics are erased to their bound: NSArray<NSString *> *
		 * is NSArray, whose elements are its type parameter's bound (id), as
		 * the reader reports them. Only object type arguments exist. */
		for value in native.typeArguments {
			if (self.unqualifiedNative(value).kind != NNK_NATIVE_OBJECTIVE_C_OBJECT) { self.fail("Objective-C protocol/generic/dynamic objects require managed native lowering"); }
		}
		if (native.classObject || (native.protocols.len > 0 && !opaqueToken) || name == "Class") { self.fail("Objective-C protocol/generic/dynamic objects require managed native lowering"); }
		if (name.isEmpty()) { name = "id"; }
		if ((nullability != "unannotated" && nullability != "nullable" && nullability != "nonnull") || qualified) { self.fail("unsupported Objective-C object qualifiers"); }
		if (relatedOwner.isEmpty() && self.nativeInterfaces.has(name) && self.nativeInterfaces.get(name).identity != native.identity) { self.fail(f"conflicting Objective-C object identity '{name}'"); }
		self.objectiveCClass(name);
		var projected = self.node(NK_TYPE_EXPR);
		projected.base = name;
		projected.isNullable = nullability != "nonnull";
		projected.pointerDepth = projected.isNullable ? 1 : 0;
		return projected;
	}

	private string objectiveCIdentity(NativeNode method) {
		string identity = f"{method.identity}:{method.owner}:{method.receiver}:{method.selector}:{method.classMethod}:{self.typeIdentity(method.signature)}:{method.returnedOwnership}:{method.methodFamily}:{method.consumesSelf}:{method.relatedResult}:{method.returnsInnerPointer}:{method.protocolOwner}:{method.optional}";
		for parameter in method.parameterSemantics { identity = identity + f":{parameter.name}:{parameter.cfConsumed}:{parameter.nsConsumed}:{parameter.noEscape}"; }
		return identity;
	}

	private void importObjectiveCMethod(NativeNode declaration) {
		bool initializer = declaration.methodFamily == "init" && !declaration.classMethod && declaration.relatedResult;
		/* A method of a protocol that names no class (the reader resolves a
		 * class first) belongs to the protocol's handle, P: a managed object
		 * that a checked (P?)value cast proved to conform (M3). */
		bool protocolHandle = declaration.protocolOwner && !self.nativeInterfaces.has(declaration.receiver);
		if (protocolHandle && (declaration.classMethod || declaration.methodFamily == "init")) { self.fail(f"Objective-C protocol handles take instance methods outside the init family: {declaration.name}"); }
		if (declaration.optional) { self.fail(f"Optional Objective-C calls require an availability check: {declaration.name}"); }
		if (declaration.signature.variadic || (declaration.consumesSelf && !initializer) || declaration.returnsInnerPointer) { self.fail("Objective-C instance/ownership calls require managed native lowering"); }
		for parameter in declaration.parameterSemantics { if (parameter.cfConsumed || parameter.nsConsumed) { self.fail("Objective-C instance/ownership calls require managed native lowering"); } }
		string subclassKey = declaration.name + ".self";
		if (self.callbacks.has(subclassKey)) {
			var subclass = self.callbacks.get(subclassKey);
			self.callbacks.remove(subclassKey);
			self.importObjectiveCSubclass(declaration, subclass, initializer);
			return;
		}
		var contract = FeNativeCallContract();
		contract.objectiveCMethod = declaration;
		contract.errorOutputs = self.objectiveCErrorOutputs(declaration);
		contract.callbacks = self.projectCallbacks(declaration);
		if (initializer && contract.callbacks.len > 0) { self.fail("Objective-C initializer callbacks require an explicit publication contract"); }
		if (contract.errorOutputs.len > 0 && contract.callbacks.len > 0) { self.fail(f"error-outputs require a method without callback parameters: {declaration.name}"); }
		if (protocolHandle && contract.callbacks.len > 0) { self.fail(f"Objective-C protocol handle methods take no callbacks: {declaration.name}"); }
		bool opaqueToken = false;
		for callback in contract.callbacks {
			if (callback.unregister != null && callback.unregister.signature.parameters.len > 0) {
				string tokenName = self.unqualifiedNative(callback.unregister.signature.parameters.get(0)).name;
				opaqueToken = tokenName.isEmpty() || tokenName == "id";
			}
		}
		Map<int, FeNativeCallbackProjection> callbacks = {};
		Map<int, bool> hidden = {};
		for callback in contract.callbacks {
			callbacks.put(callback.parameterIndex, callback);
			// The compiler supplies a control action's selector itself.
			if (callback.controlActionIndex >= 0) { hidden.put(callback.controlActionIndex, true); }
		}
		/* The adapter supplies its own NSError** output. */
		for position in contract.errorOutputs { hidden.put(position, true); }
		var method = self.node(NK_METHOD_DECL);
		method.access = declaration.classMethod || initializer ? "class" : "public";
		method.name = Strings.split(declaration.selector, ":").get(0);
		/* A protocol's instancetype is any conforming class: its result stays id. */
		method.returnType = self.objectiveCType(declaration.signature.returnType, false, declaration.relatedResult && !protocolHandle ? declaration.receiver : "", false, opaqueToken);
		for index in range(declaration.signature.parameters.len) {
			if (hidden.has(index)) { continue; }
			var parameter = self.node(NK_PARAM);
			parameter.name = f"argument{index}";
			if (callbacks.has(index)) {
				parameter.type = self.node(NK_TYPE_EXPR);
				/* An instance-scoped instantiated adapter takes its factory. */
				parameter.type.base = callbacks.get(index).factoryInterface.isEmpty() ? callbacks.get(index).interfaceName : callbacks.get(index).factoryInterface;
			} else { parameter.type = self.objectiveCType(declaration.signature.parameters.get(index), true); }
			method.paramsMut().push(parameter);
		}
		for callback in contract.callbacks {
			if (callback.oneShot) {
				if (contract.callbacks.len != 1) { self.fail("one-shot currently requires exactly one callback"); }
				Node receiver = self.node(NK_TYPE_EXPR);
				receiver.base = callback.interfaceName;
				method.returnType = self.node(NK_TYPE_EXPR);
				method.returnType.base = "CallbackRequest";
				method.returnType.genericArgsStorage = [receiver];
				Node scope = self.node(NK_PARAM);
				scope.name = "scope";
				scope.type = self.node(NK_TYPE_EXPR);
				scope.type.base = "CallbackScope";
				method.paramsMut().push(scope);
				continue;
			}
			NativeNode? cancellation = callback.unregister;
			if (cancellation == null) { continue; }
			if (contract.callbacks.len != 1) { self.fail("stored callback factory currently requires exactly one callback"); }
			Node token = method.returnType;
			if (callback.slotGetter != null || callback.controlActionIndex >= 0) { token = self.node(NK_TYPE_EXPR); token.base = "id"; }
			token.isNullable = false;
			token.pointerDepth = 0;
			if (cancellation.signature.parameters.len > 0 && !cancellation.classMethod) {
				self.objectiveCClass(declaration.receiver);
				Node source = self.node(NK_TYPE_EXPR);
				source.base = declaration.receiver;
				Node pair = self.node(NK_TYPE_EXPR);
				pair.base = "CallbackToken";
				pair.genericArgsStorage = [source, token];
				token = pair;
			}
			Node receiver = self.node(NK_TYPE_EXPR);
			receiver.base = callback.interfaceName;
			method.returnType = self.node(NK_TYPE_EXPR);
			method.returnType.base = "CallbackContext";
			method.returnType.genericArgsStorage = [receiver, token];
			Node scope = self.node(NK_PARAM);
			scope.name = "scope";
			scope.type = self.node(NK_TYPE_EXPR);
			scope.type.base = "CallbackScope";
			method.paramsMut().push(scope);
		}
		FeNativeImportedDeclaration imported = protocolHandle ? self.objectiveCProtocol(declaration.receiver) : self.objectiveCClass(declaration.receiver);
		if (imported.methods.has(method.name)) {
			if (!self.sameCallContract(imported.methods.get(method.name), contract)) { self.fail(f"ambiguous Objective-C method projection {declaration.receiver}.{method.name}"); }
			return;
		}
		imported.methods.put(method.name, contract);
		imported.declaration.membersMut().push(method);
	}

	/* The native positions of the NSError** parameters error-outputs maps
	 * (F1). The adapter supplies each such output itself, so the BTRC method
	 * omits it; an NSError** parameter that error-outputs does not map has no
	 * BTRC projection. */
	private Vector<int> objectiveCErrorOutputs(NativeNode declaration) {
		string prefix = declaration.name + ".";
		Map<string, bool> names = {};
		for parameter in declaration.parameterSemantics { names.put(parameter.name, true); }
		for key in self.errorOutputs.keys() {
			if (key.startsWith(prefix) && !names.has(key.substring(prefix.length(), key.length() - prefix.length()))) { self.fail(f"error-outputs names an unknown Objective-C method parameter: {key}"); }
		}
		Vector<int> positions = [];
		for position in range(declaration.parameterSemantics.len) {
			string key = prefix + declaration.parameterSemantics.get(position).name;
			bool mapped = self.errorOutputs.has(key);
			if (mapped) { self.errorOutputs.remove(key); }
			string shape = self.errorOutputShape(declaration.signature.parameters.get(position));
			if (mapped && shape != "output") { self.fail(f"error-outputs require an NSError** parameter of an Objective-C method: {key}"); }
			if (!shape.isEmpty() && !mapped) { self.fail(f"NSError** parameters require error-outputs: {declaration.name}"); }
			if (mapped) { positions.push(position); }
		}
		if (positions.len > 1) { self.fail(f"error-outputs take one NSError** parameter per method: {declaration.name}"); }
		return positions;
	}

	/* "output" for an unqualified NSError**, "other" for another NSError**
	 * form, else "". */
	private string errorOutputShape(NativeNode native) {
		bool qualified = false;
		while (native.kind == NNK_NATIVE_ALIAS || native.kind == NNK_NATIVE_QUALIFIED_TYPE) {
			qualified = qualified || native.qualifiers.isConst || native.qualifiers.isVolatile || native.qualifiers.isRestrict;
			native = native.underlying;
		}
		if (native.kind != NNK_NATIVE_POINTER) { return ""; }
		qualified = qualified || native.qualifiers.isConst || native.qualifiers.isVolatile || native.qualifiers.isRestrict;
		NativeNode error = native.pointee;
		string nullability = "unannotated";
		while (error.kind == NNK_NATIVE_ALIAS || error.kind == NNK_NATIVE_QUALIFIED_TYPE) {
			qualified = qualified || error.qualifiers.isConst || error.qualifiers.isVolatile || error.qualifiers.isRestrict;
			if (error.qualifiers.nullability != "unannotated") { nullability = error.qualifiers.nullability; }
			error = error.underlying;
		}
		if (error.kind != NNK_NATIVE_OBJECTIVE_C_OBJECT || error.name != "NSError") { return ""; }
		if (error.qualifiers.nullability != "unannotated") { nullability = error.qualifiers.nullability; }
		string pointer = native.qualifiers.nullability;
		if (qualified || error.classObject || error.protocols.len > 0 || error.typeArguments.len > 0 || (nullability != "unannotated" && nullability != "nullable") || (pointer != "unannotated" && pointer != "nullable")) { return "other"; }
		return "output";
	}

	/* A generated subclass of an SDK class, created by BTRC through the
	 * superclass's designated initializer: the key maps the initializer's
	 * implicit self (`-[UIView initWithFrame:].self`). Instance overrides and
	 * protocol methods join the receiver interface; class overrides, which
	 * must return Class, join I<Interface>Factory beside create() and return
	 * the runtime name of an Objective-C class. The initializer becomes a
	 * class method that takes the factory first and returns the new instance
	 * (native-interop-ownership.md section 2.2). */
	private void importObjectiveCSubclass(NativeNode declaration, FeNativeCallbackBinding binding, bool initializer) {
		if (!initializer || declaration.protocolOwner || !declaration.designatedInitializer) { self.fail(f"subclass adapters require a designated initializer of their superclass: {declaration.name}"); }
		string superclass = binding.superclass;
		if (declaration.receiver != superclass) { self.fail(f"subclass adapter superclass must be the initializer's class: {declaration.name}"); }
		Vector<NativeNode> instanceOverrides = [];
		Vector<NativeNode> classOverrides = [];
		self.superclassOverrides(binding, instanceOverrides, classOverrides);
		string own = declaration.name + ".";
		for key in self.callbacks.keys() { if (key.startsWith(own)) { self.fail(f"subclass adapter initializers take no other mapping: {declaration.name}"); } }
		for key in self.errorOutputs.keys() { if (key.startsWith(own)) { self.fail(f"subclass adapter initializers take no other mapping: {declaration.name}"); } }
		Node voidType = self.node(NK_TYPE_EXPR);
		voidType.base = "void";
		var projection = FeNativeCallbackProjection(binding.interfaceName, 0, -1, -1, voidType);
		projection.instantiatedScope = binding.scope;
		if (binding.methods.len > 0 && self.callbackExports.has(binding.methods.get(0))) {
			NativeNode first = self.callbackExports.get(binding.methods.get(0));
			if (first.kind == NNK_NATIVE_OBJECTIVE_C_METHOD && first.protocolOwner) { projection.delegateProtocol = first.receiver; }
		}
		self.protocolMethods(binding, 0, projection, true, instanceOverrides);
		self.instantiatedTerminal(binding, projection);
		self.instantiatedFactory(binding, projection, classOverrides);
		projection.superclass = superclass;
		projection.initializer = declaration;
		for parameter in declaration.signature.parameters { projection.initializerParameters.push(self.blockTypeSpelling(parameter)); }
		var method = self.node(NK_METHOD_DECL);
		method.access = "class";
		method.name = Strings.split(declaration.selector, ":").get(0);
		method.returnType = self.objectiveCType(declaration.signature.returnType, false, declaration.receiver);
		var factoryParameter = self.node(NK_PARAM);
		factoryParameter.name = "factory";
		factoryParameter.type = self.node(NK_TYPE_EXPR);
		factoryParameter.type.base = projection.factoryInterface;
		method.paramsMut().push(factoryParameter);
		for index in range(declaration.signature.parameters.len) {
			var parameter = self.node(NK_PARAM);
			parameter.name = f"argument{index}";
			parameter.type = self.objectiveCType(declaration.signature.parameters.get(index), true);
			method.paramsMut().push(parameter);
		}
		var contract = FeNativeCallContract();
		contract.objectiveCMethod = declaration;
		contract.callbacks = [projection];
		FeNativeImportedDeclaration imported = self.objectiveCClass(declaration.receiver);
		if (imported.methods.has(method.name)) { self.fail(f"ambiguous Objective-C method projection {declaration.receiver}.{method.name}"); }
		imported.methods.put(method.name, contract);
		imported.declaration.membersMut().push(method);
	}

	/* The checked instance and class overrides of an adapter that extends
	 * `binding.superclass`. The superclass needs a complete interface. Each
	 * override is selected on the superclass (including inherited methods and
	 * adopted protocol requirements) outside the init, alloc, new, copy and
	 * dealloc families, non-variadic and non-consuming. A class override
	 * returns Class and takes no parameters; an override the SDK marks
	 * NS_REQUIRES_SUPER returns void. */
	private void superclassOverrides(FeNativeCallbackBinding binding, Vector<NativeNode> instanceOverrides, Vector<NativeNode> classOverrides) {
		string superclass = binding.superclass;
		if (!self.nativeInterfaces.has(superclass) || !self.nativeInterfaces.get(superclass).complete) { self.fail(f"subclass adapters require a complete superclass interface: {superclass}"); }
		for symbol in binding.overrides {
			if (!self.callbackExports.has(symbol)) { self.fail(f"overrides require a method of the superclass {superclass}: {symbol}"); }
			NativeNode method = self.callbackExports.get(symbol);
			// Clang checks the selected class receiver through its superclass,
			// categories and adopted protocols; the declaration keeps its owner.
			if (method.kind != NNK_NATIVE_OBJECTIVE_C_METHOD || method.receiver != superclass) { self.fail(f"overrides require a method of the superclass {superclass}: {symbol}"); }
			if (method.methodFamily != "none") { self.fail(f"overrides cannot name an initializer, allocator, copy or dealloc method: {symbol}"); }
			bool consuming = method.signature.variadic || method.consumesSelf || method.returnsInnerPointer || method.returnedOwnership != "unspecified";
			for parameter in method.parameterSemantics { if (parameter.cfConsumed || parameter.nsConsumed) { consuming = true; } }
			if (consuming) { self.fail(f"overrides require a non-consuming, non-variadic method: {symbol}"); }
			NativeNode result = self.unqualifiedNative(method.signature.returnType);
			if (method.classMethod) {
				if (method.signature.parameters.len > 0 || result.kind != NNK_NATIVE_OBJECTIVE_C_OBJECT || !result.classObject || result.protocols.len > 0) { self.fail(f"class-method overrides require a Class result and no parameters: {symbol}"); }
				if (method.requiresSuper) { self.fail(f"overrides that require super must return void: {symbol}"); }
				classOverrides.push(method);
			} else {
				if (method.requiresSuper && (result.kind != NNK_NATIVE_BUILTIN || result.name != "void")) { self.fail(f"overrides that require super must return void: {symbol}"); }
				instanceOverrides.push(method);
			}
		}
	}

	/* The position of `binding.terminal` among the projected instance
	 * methods, which an instance releases its receiver after. */
	private void instantiatedTerminal(FeNativeCallbackBinding binding, FeNativeCallbackProjection projection) {
		if (binding.terminal.isEmpty()) { return; }
		for position in range(projection.delegateMethods.len) {
			var nativeMethod = projection.delegateMethods.get(position).nativeMethod;
			if (nativeMethod != null && nativeMethod.name == binding.terminal) { projection.terminalIndex = position; }
		}
		if (projection.terminalIndex < 0) { self.fail(f"terminal must name an instance method: {binding.terminal}"); }
	}

	/* I<Interface>Factory: create() and one class-name method per class
	 * override. A class override returns the runtime name of the
	 * Objective-C class it answers; the factory is the class's receiver. */
	private void instantiatedFactory(FeNativeCallbackBinding binding, FeNativeCallbackProjection projection, Vector<NativeNode> classOverrides) {
		projection.factoryInterface = binding.interfaceName + "Factory";
		Node receiver = self.node(NK_TYPE_EXPR);
		receiver.base = binding.interfaceName;
		Node create = self.node(NK_METHOD_SIG);
		create.name = "create";
		create.returnType = receiver;
		Node factory = self.node(NK_INTERFACE_DECL);
		factory.name = projection.factoryInterface;
		factory.methodsStorage = [create];
		Map<string, bool> names = {"create": true};
		string identity = "instantiated-factory:" + binding.interfaceName;
		for method in classOverrides {
			string name = self.callbackMethodName(binding, method);
			if (names.has(name)) { self.fail(f"ambiguous delegate method projection: {name}"); }
			names.put(name, true);
			Node text = self.node(NK_TYPE_EXPR);
			text.base = "string";
			Node signature = self.node(NK_METHOD_SIG);
			signature.name = name;
			signature.returnType = text;
			factory.methodsMut().push(signature);
			var classMethod = FeNativeCallbackProjection(projection.factoryInterface, 0, -1, 0, text);
			classMethod.methodName = name;
			classMethod.nativeMethod = method;
			classMethod.nativeReturn = "Class";
			Node context = self.node(NK_TYPE_EXPR);
			context.base = "void";
			context.pointerDepth = 1;
			classMethod.parameters.push(context);
			projection.classMethods.push(classMethod);
			identity = identity + ":" + method.name + ":" + name;
		}
		self.add(projection.factoryInterface, factory, identity);
	}

	private void mergeObjectiveCMethods(FeNativeImportedDeclaration selected, FeNativeImportedDeclaration imported) {
		for name in imported.methods.keys() {
			if (selected.methods.has(name) && !self.sameCallContract(selected.methods.get(name), imported.methods.get(name))) { self.fail(f"conflicting native declaration '{imported.declaration.name}', method '{name}', imported by {selected.module} and {imported.module}"); }
		}
		for member in imported.declaration.members() {
			if (!selected.methods.has(member.name)) { selected.declaration.membersMut().push(member); }
		}
		for name in imported.methods.keys() { selected.methods.put(name, imported.methods.get(name)); }
		for header in imported.headers {
			if (!selected.headers.contains(header)) { selected.headers.push(header); }
		}
	}

	private string layoutIdentity(NativeNode layout) {
		string identity = layout.recordKind + f":{layout.transparentUnion}:" + layout.sizeBits + ":" + layout.alignmentBitsString;
		for field in layout.fields { identity = identity + ":" + field.name + ":" + self.typeIdentity(field.fieldType) + f":{field.offsetBits}:{field.isAnonymous}:{field.isBitfield}:{field.widthBits}"; }
		return identity;
	}

	private bool sameCallContract(FeNativeCallContract? left, FeNativeCallContract? right) {
		if (left == null || right == null) { return left == right; }
		if (left.copiedInput == null || right.copiedInput == null) { if (left.copiedInput != right.copiedInput) { return false; } }
		else if (left.copiedInput.ownerIndex != right.copiedInput.ownerIndex || left.copiedInput.inputIndex != right.copiedInput.inputIndex || left.copiedInput.lengthIndex != right.copiedInput.lengthIndex || left.copiedInput.resource != right.copiedInput.resource) { return false; }
		if (left.recordSnapshot == null || right.recordSnapshot == null) { if (left.recordSnapshot != right.recordSnapshot) { return false; } }
		else if (left.recordSnapshot.identity() != right.recordSnapshot.identity()) { return false; }
		if (left.copiedResult == null || right.copiedResult == null) { if (left.copiedResult != right.copiedResult) { return false; } }
		else {
			FeNativeCopiedResult first = left.copiedResult; FeNativeCopiedResult second = right.copiedResult;
			if (first.kind != second.kind || first.ownerIndex != second.ownerIndex || first.lengthFunction != second.lengthFunction || first.lengthArguments.len != second.lengthArguments.len) { return false; }
			for index in range(first.lengthArguments.len) { if (first.lengthArguments.get(index) != second.lengthArguments.get(index)) { return false; } }
		}
		if (left.boundParameter != right.boundParameter || left.boundConstant != right.boundConstant) { return false; }
		if (left.callbackTable == null || right.callbackTable == null) { if (left.callbackTable != right.callbackTable) { return false; } }
		else if (left.callbackTable.identity() != right.callbackTable.identity()) { return false; }
		if (left.cxxMethod == null || right.cxxMethod == null) { if (left.cxxMethod != right.cxxMethod) { return false; } }
		else if (left.cxxMethod.identity() != right.cxxMethod.identity()) { return false; }
		if (left.javaMember == null || right.javaMember == null) { if (left.javaMember != right.javaMember) { return false; } }
		else if (left.javaMember.key() != right.javaMember.key()) { return false; }
		if (left.javaNatives == null || right.javaNatives == null) { if (left.javaNatives != right.javaNatives) { return false; } }
		else if (left.javaNatives.key() != right.javaNatives.key()) { return false; }
		if (left.variadicArguments.len != right.variadicArguments.len || left.transparentParameters.len != right.transparentParameters.len) { return false; }
		for index in range(left.transparentParameters.len) { if (left.transparentParameters.get(index) != right.transparentParameters.get(index)) { return false; } }

		for index in range(left.variadicArguments.len) { if (left.variadicArguments.get(index) != right.variadicArguments.get(index)) { return false; } }
		if (left.errorOutputs.len != right.errorOutputs.len) { return false; }
		for index in range(left.errorOutputs.len) { if (left.errorOutputs.get(index) != right.errorOutputs.get(index)) { return false; } }
		if (left.executor != right.executor || left.borrowedResultOwner != right.borrowedResultOwner) { return false; }
		if (left.ownedOutput == null || right.ownedOutput == null) {
			if (left.ownedOutput != right.ownedOutput) { return false; }
		} else if (left.ownedOutput.parameterIndex != right.ownedOutput.parameterIndex || left.ownedOutput.resultName != right.ownedOutput.resultName || left.ownedOutput.resource != right.ownedOutput.resource || left.ownedOutput.statusType.base != right.ownedOutput.statusType.base || left.ownedOutput.statusType.isConst != right.ownedOutput.statusType.isConst) { return false; }
		if (left.ownedOutput != null && right.ownedOutput != null) {
			FeNativeInitializer? firstInitializer = left.ownedOutput.initializer;
			FeNativeInitializer? secondInitializer = right.ownedOutput.initializer;
			if (firstInitializer == null || secondInitializer == null) { if (firstInitializer != secondInitializer) { return false; } }
			else if (firstInitializer.success != secondInitializer.success || firstInitializer.copiedInput != secondInitializer.copiedInput || firstInitializer.length != secondInitializer.length) { return false; }
			FeNativeSizedResourceOutput? firstSized = left.ownedOutput.sizedResource;
			FeNativeSizedResourceOutput? secondSized = right.ownedOutput.sizedResource;
			if (firstSized == null || secondSized == null) { if (firstSized != secondSized) { return false; } }
			else if (firstSized.sizeIndex != secondSized.sizeIndex || firstSized.nativeFunction != secondSized.nativeFunction || firstSized.sizeType.base != secondSized.sizeType.base || firstSized.sizeType.isConst != secondSized.sizeType.isConst) { return false; }
			FeNativeOutputOffset? first = left.ownedOutput.offset;
			FeNativeOutputOffset? second = right.ownedOutput.offset;
			if (first == null || second == null) { if (first != second) { return false; } }
			else if (first.parameterIndex != second.parameterIndex || first.inputIndex != second.inputIndex || first.lengthIndex != second.lengthIndex || first.field != second.field) { return false; }
		}
		if (left.recordOutput == null || right.recordOutput == null) {
			if (left.recordOutput != right.recordOutput) { return false; }
		} else if (left.recordOutput.identity() != right.recordOutput.identity()) { return false; }
		if (left.objectiveCMethod == null || right.objectiveCMethod == null) {
			if (left.objectiveCMethod != right.objectiveCMethod) { return false; }
		} else if (self.objectiveCIdentity(left.objectiveCMethod) != self.objectiveCIdentity(right.objectiveCMethod)) { return false; }
		if (left.callbacks.len != right.callbacks.len) { return false; }
		for index in range(left.callbacks.len) {
			var first = left.callbacks.get(index);
			var second = right.callbacks.get(index);
			if (first.realtime == null || second.realtime == null) { if (first.realtime != second.realtime) { return false; } }
			else {
				var one = first.realtime; var two = second.realtime;
				if (one.name != two.name || one.invocation != two.invocation || one.resource != two.resource || one.nativeFunction != two.nativeFunction || one.ownerIndex != two.ownerIndex || one.sizeIndex != two.sizeIndex || one.nativeParameters.len != two.nativeParameters.len || one.operations.len != two.operations.len || TypeIdentity.shapeKey(one.statusType) != TypeIdentity.shapeKey(two.statusType)) { return false; }
				for slot in range(one.nativeParameters.len) { if (one.nativeParameters.get(slot) != two.nativeParameters.get(slot)) { return false; } }

				for slot in range(one.operations.len) {
					var a = one.operations.get(slot); var b = two.operations.get(slot);
					if (a.name != b.name || a.nativeFunction != b.nativeFunction || a.ownerIndex != b.ownerIndex || a.parameters.len != b.parameters.len || TypeIdentity.shapeKey(a.returnType) != TypeIdentity.shapeKey(b.returnType)) { return false; }
					for argument in range(a.parameters.len) { if (a.parameters.get(argument).name != b.parameters.get(argument).name || TypeIdentity.shapeKey(a.parameters.get(argument).type) != TypeIdentity.shapeKey(b.parameters.get(argument).type)) { return false; } }
				}
			}
			if (first.activationFailure != second.activationFailure || first.oneShot != second.oneShot || first.mainExecutor != second.mainExecutor || first.superclass != second.superclass) { return false; }
			if (first.controlActionIndex != second.controlActionIndex || first.capturedPositions.len != second.capturedPositions.len) { return false; }
			for position in range(first.capturedPositions.len) { if (first.capturedPositions.get(position) != second.capturedPositions.get(position)) { return false; } }
			if (first.delegateProtocol != second.delegateProtocol || first.delegateMethods.len != second.delegateMethods.len) { return false; }
			Vector<NativeNode?> firstOperations = [first.slotGetter, first.actionSetter, first.actionGetter];
			Vector<NativeNode?> secondOperations = [second.slotGetter, second.actionSetter, second.actionGetter];
			for operationIndex in range(firstOperations.len) {
				NativeNode? firstOperation = firstOperations.get(operationIndex);
				NativeNode? secondOperation = secondOperations.get(operationIndex);
				if (firstOperation == null || secondOperation == null) {
					if (firstOperation != secondOperation) { return false; }
				} else if (self.objectiveCIdentity(firstOperation) != self.objectiveCIdentity(secondOperation)) { return false; }
			}

			for methodIndex in range(first.delegateMethods.len) {
				var leftMethod = first.delegateMethods.get(methodIndex);
				var rightMethod = second.delegateMethods.get(methodIndex);
				if (leftMethod.methodName != rightMethod.methodName) { return false; }
				if (leftMethod.nativeMethod == null || rightMethod.nativeMethod == null) {
					if (leftMethod.nativeMethod != rightMethod.nativeMethod) { return false; }
				} else if (self.objectiveCIdentity(leftMethod.nativeMethod) != self.objectiveCIdentity(rightMethod.nativeMethod)) { return false; }
			}
			if (first.interfaceName != second.interfaceName || first.parameterIndex != second.parameterIndex || first.contextIndex != second.contextIndex || first.callbackContextIndex != second.callbackContextIndex) { return false; }
			if (first.field != second.field || first.record != second.record || first.contextFields.len != second.contextFields.len || first.callbackContextIndices.len != second.callbackContextIndices.len) { return false; }
			if (first.stringArguments.len != second.stringArguments.len) { return false; }
			for index in first.stringArguments.keys() { if (!second.stringArguments.has(index) || first.stringArguments.get(index).identity() != second.stringArguments.get(index).identity()) { return false; } }
			for position in range(first.contextFields.len) { if (first.contextFields.get(position) != second.contextFields.get(position)) { return false; } }

			for position in range(first.callbackContextIndices.len) { if (first.callbackContextIndices.get(position) != second.callbackContextIndices.get(position)) { return false; } }
			if (first.unregister == null || second.unregister == null) {
				if (first.unregister != second.unregister) { return false; }
			} else if (self.objectiveCIdentity(first.unregister) != self.objectiveCIdentity(second.unregister)) { return false; }
		}
		if (left.resourceResult != right.resourceResult || left.resourceParameters.len != right.resourceParameters.len) { return false; }
		for index in range(left.resourceParameters.len) { if (left.resourceParameters.get(index) != right.resourceParameters.get(index)) { return false; } }
		if (left.nonnullReturn != right.nonnullReturn || left.realtimeSafe != right.realtimeSafe || left.nonnullParameters.len != right.nonnullParameters.len || left.readOnlyBorrows.len != right.readOnlyBorrows.len) { return false; }
		for index in range(left.nonnullParameters.len) { if (left.nonnullParameters.get(index) != right.nonnullParameters.get(index)) { return false; } }

		for index in range(left.readOnlyBorrows.len) { if (left.readOnlyBorrows.get(index) != right.readOnlyBorrows.get(index)) { return false; } }
		if (left.recordInputs.len != right.recordInputs.len) { return false; }
		if (left.recordTypes.len != right.recordTypes.len) { return false; }
		for name in left.recordTypes.keys() {
			if (!right.recordTypes.has(name)) { return false; }
			FeNativeRecordInput firstType = left.recordTypes.get(name);
			FeNativeRecordInput secondType = right.recordTypes.get(name);
			if (firstType.identity() != secondType.identity()) { return false; }
		}
		for index in range(left.recordInputs.len) {
			var first = left.recordInputs.get(index);
			var second = right.recordInputs.get(index);
			if (first == null || second == null) { if (first != second) { return false; } }
			else if (first.identity() != second.identity()) { return false; }
		}
		return true;
	}

	private bool sameFieldContracts(FeNativeImportedDeclaration left, FeNativeImportedDeclaration right) {
		if (left.fieldContracts.len != right.fieldContracts.len) { return false; }
		for name in left.fieldContracts.keys() {
			if (!right.fieldContracts.has(name) || !self.sameCallContract(left.fieldContracts.get(name), right.fieldContracts.get(name))) { return false; }
		}
		return true;
	}

	private void mergeInterfaces(Vector<NativeNode> interfaces) {
		for entry in interfaces {
			if (self.interfaceNames.has(entry.identity) && self.interfaceNames.get(entry.identity) != entry.name) { self.fail(f"conflicting Objective-C interface '{entry.name}'"); }
			self.interfaceNames.put(entry.identity, entry.name);
			if (self.nativeInterfaces.has(entry.name)) {
				NativeNode previous = self.nativeInterfaces.get(entry.name);
				if (previous.identity != entry.identity || (previous.complete && entry.complete && previous.superclass != entry.superclass)) { self.fail(f"conflicting Objective-C interface '{entry.name}'"); }
				if (!entry.complete) { continue; }
			}
			self.nativeInterfaces.put(entry.name, entry);
		}
	}

	private void coalesce() {
		Map<string, FeNativeImportedDeclaration> selected = {};
		for imported in self.declarations {
			Node declaration = imported.declaration;
			string name = declaration.kind == NK_TYPEDEF_DECL ? declaration.alias : declaration.name;
			if (declaration.kind == NK_CLASS_DECL && imported.language == "objective-c" && self.nativeInterfaces.has(name)) {
				NativeNode current = self.nativeInterfaces.get(name);
				while (!current.superclass.isEmpty()) {
					current = self.nativeInterfaces.get(self.interfaceNames.get(current.superclass));
					imported.nativeAncestors.push(current.name);
				}
			}
			if (declaration.kind == NK_CLASS_DECL && imported.language == "objective-c" && name != "id") { imported.nativeAncestors.push("id"); }
			if (!selected.has(name)) { selected.put(name, imported); continue; }
			FeNativeImportedDeclaration previous = selected.get(name);
			if (!self.sameResource(previous.resource, imported.resource)) { self.fail(f"conflicting native resource '{name}'"); }
			Node prior = previous.declaration;
			string identity = self.typeIdentities.get(imported.module + "\x1f" + name);
			string priorIdentity = self.typeIdentities.get(previous.module + "\x1f" + name);
			bool sharedCRecord = prior.kind == NK_STRUCT_DECL && declaration.kind == NK_STRUCT_DECL && prior.fields().len > 0 && declaration.fields().len > 0 && ((previous.language == "c" && imported.language == "objective-c") || (previous.language == "objective-c" && imported.language == "c"));
			if (prior.kind != declaration.kind || (previous.language != imported.language && !sharedCRecord) || !identity.equals(priorIdentity) || !previous.typeSpelling.equals(imported.typeSpelling) || previous.readOnly != imported.readOnly || previous.valueOnly != imported.valueOnly || !self.sameCallContract(previous.callContract, imported.callContract) || (declaration.kind == NK_STRUCT_DECL && prior.fields().len > 0 && declaration.fields().len > 0 && !self.sameFieldContracts(previous, imported))) { self.fail(f"conflicting native declaration '{name}' imported by {previous.module} and {imported.module}"); }
			if (sharedCRecord) {
				/* Matching complete SDK layouts share C storage, not an ObjC-only projection. */
				if (imported.language == "c") { previous.coalesced = true; selected.put(name, imported); }
				else { imported.coalesced = true; }
				continue;
			}
			if (declaration.kind == NK_CLASS_DECL && imported.language == "objective-c") {
				self.mergeObjectiveCMethods(previous, imported);
				imported.coalesced = true;
				continue;
			}
			if (declaration.kind == NK_CLASS_DECL && imported.resource != null) {
				for ancestor in imported.nativeAncestors { if (!previous.nativeAncestors.contains(ancestor)) { previous.nativeAncestors.push(ancestor); } }
				if (!imported.resourceQueryType.isEmpty()) { previous.resourceQueryType = imported.resourceQueryType; }
			}
			/* Preserve visibility owners; selected SDK fields beat a record
			 * first encountered only as a parameter type. */
			if (declaration.kind == NK_STRUCT_DECL && ((prior.isForward && !declaration.isForward) || (prior.fields().len == 0 && declaration.fields().len > 0))) {
				previous.coalesced = true;
				selected.put(name, imported);
			} else { imported.coalesced = true; }
		}
	}

	private void validateSelectorStorage() {
		if (!self.requiresSelector) { return; }
		for imported in self.declarations {
			Node declaration = imported.declaration;
			if (declaration.kind != NK_TYPEDEF_DECL || declaration.alias != "SEL" || imported.language != "c") { continue; }
			Node target = declaration.original;
			if (target.pointerDepth != 1 || target.isConst) { continue; }
			for candidate in self.declarations {
				if (candidate.module == imported.module && candidate.declaration.kind == NK_STRUCT_DECL && candidate.declaration.name == target.base && candidate.declaration.isForward) { return; }
			}
		}
		self.fail("Objective-C selectors require an imported opaque C SEL typedef from the SDK");
	}

	private string callNullability(NativeNode input) {
		NativeNode native = input;
		string nullability = "unannotated";
		while (true) {
			string annotation = native.qualifiers.nullability;
			if (!annotation.equals("unannotated")) {
				if ((!annotation.equals("nullable") && !annotation.equals("nonnull")) || (!nullability.equals("unannotated") && !nullability.equals(annotation))) { self.fail("conflicting/unsupported native nullability requires native-type lowering"); }
				nullability = annotation;
			}
			if (native.kind != NNK_NATIVE_ALIAS && native.kind != NNK_NATIVE_QUALIFIED_TYPE) { break; }
			native = native.underlying;
		}
		if (!nullability.equals("unannotated") && native.kind != NNK_NATIVE_POINTER && native.kind != NNK_NATIVE_OBJECTIVE_C_OBJECT) { self.fail("native nullability on non-pointer requires native-type lowering"); }
		return nullability;
	}

	private NativeNode withoutCallNullability(NativeNode native, bool parameter) {
		if (parameter && native.qualifiers.isRestrict && native.kind != NNK_NATIVE_ALIAS && native.kind != NNK_NATIVE_QUALIFIED_TYPE && native.kind != NNK_NATIVE_POINTER) { self.fail("native restrict parameter must be a pointer"); }
		if (native.kind != NNK_NATIVE_ALIAS && native.kind != NNK_NATIVE_QUALIFIED_TYPE && native.kind != NNK_NATIVE_POINTER && native.kind != NNK_NATIVE_FUNCTION_TYPE && native.qualifiers.nullability.equals("unannotated") && (!parameter || !native.qualifiers.isRestrict)) { return native; }
		var result = NativeNode();
		result.kind = native.kind;
		result.name = native.name;
		var qualifiers = NativeNode();
		qualifiers.kind = NNK_NATIVE_QUALIFIERS;
		qualifiers.isConst = native.qualifiers.isConst;
		qualifiers.isVolatile = native.qualifiers.isVolatile;
		/* Only the outer parameter pointer loses restrict for compatible type
		 * projection. The SDK call keeps the declaration and aliasing contract. */
		qualifiers.isRestrict = native.qualifiers.isRestrict;
		if (parameter) { qualifiers.isRestrict = false; }
		qualifiers.nullability = "unannotated";
		result.qualifiers = qualifiers;
		if (native.kind == NNK_NATIVE_ALIAS || native.kind == NNK_NATIVE_QUALIFIED_TYPE) { result.underlying = self.withoutCallNullability(native.underlying, parameter); }
		else if (native.kind == NNK_NATIVE_POINTER) { result.pointee = self.withoutNestedNullable(native.pointee); }
		else if (native.kind == NNK_NATIVE_FUNCTION_TYPE) {
			result.returnType = self.withoutNestedNullable(native.returnType);
			for item in native.parameters { result.parameters.push(self.withoutNestedNullable(item, true)); }
			result.variadic = native.variadic;
			result.callingConvention = native.callingConvention;
		}
		else { self.fail("native nullability on non-pointer requires native-type lowering"); }
		return result;
	}

	private NativeNode withoutNestedNullable(NativeNode native, bool parameter = false) {
		/* Raw pointers admit null, including output slots and callback values.
		 * Do not infer non-null or change pointer depth. Stronger nested promises
		 * need directional output/callback validation, not erasure. */
		if (self.callNullability(native).equals("nonnull")) { self.fail("nested native non-null contracts require native-type lowering"); }
		return self.withoutCallNullability(native, parameter);
	}

	private Node callType(NativeNode native, bool parameter = false) {
		string nullability = self.callNullability(native);
		Node projected = self.type(self.withoutCallNullability(native, parameter));
		if (nullability.equals("nullable")) {
			if (projected.isNullable) { self.fail("nested native nullability requires native-type lowering"); }
			projected.isNullable = true;
			if (projected.pointerDepth == 0 && !projected.base.equals("__fn_ptr")) { projected.pointerDepth = 1; }
		}
		return projected;
	}

	private NativeNode unqualifiedNative(NativeNode value) {
		while (value.kind == NNK_NATIVE_ALIAS || value.kind == NNK_NATIVE_QUALIFIED_TYPE) { value = value.underlying; }
		return value;
	}

	private FeNativeImportedDeclaration selectedDeclaration(string module, string name) {
		for imported in self.declarations {
			if (imported.module == module && imported.declaration.name == name) { return imported; }
		}
		self.fail(f"missing selected native declaration '{name}'");
		return (FeNativeImportedDeclaration)null;
	}

	private FeNativeRecordInput recordInput(FeNativeBinding binding, string name, Map<string, FeNativeRecordInput> projections, Map<string, string> objectFields, Map<string, FeNativeCallbackProjection> callbackFields, Vector<string> active) {
		if (projections.has(name)) { return projections.get(name); }
		if (active.contains(name)) { self.fail(f"cyclic native record input projection: {name}"); }
		var imported = self.selectedDeclaration(binding.module, name);
		Node declaration = imported.declaration;
		if (declaration.kind != NK_STRUCT_DECL || declaration.isForward) { self.fail(f"owned-records requires a complete selected struct: {name}"); }
		NativeNode layout = self.recordLayouts.get(binding.module + "\x1f" + name);
		var projection = FeNativeRecordInput(name, imported.typeSpelling);
		Vector<string> ancestors = [];
		ancestors.extend(active);
		ancestors.push(name);
		Map<string, bool> hidden = {};
		for key in callbackFields.keys() { var callback = callbackFields.get(key); if (callback.record == name) { for field in callback.contextFields { hidden.put(field, true); } } }
		Map<string, Node> importedFields = {};
		for field in declaration.fields() { importedFields.put(field.name, field); }
		for index in range(layout.fields.len) {
			string fieldName = layout.fields.get(index).name;
			string key = name + "." + fieldName;
			if (hidden.has(fieldName)) { continue; }
			if (callbackFields.has(key)) {
				Node type = self.node(NK_TYPE_EXPR);
				type.base = callbackFields.get(key).interfaceName;
				var mapped = FeNativeRecordInputField(fieldName, type);
				mapped.callback = true;
				projection.fields.push(mapped);
				continue;
			}
			string resourceKey = binding.module + "\x1f" + layout.identity + "\x1f" + fieldName;
			if (self.recordResourceFields.has(resourceKey)) {
				if (objectFields.has(key)) { self.fail("resource field type/nullability comes from its SDK declaration"); }
				projection.fields.push(self.recordResourceFields.get(resourceKey));
				continue;
			}
			Node field = importedFields.get(fieldName);
			NativeNode native = self.unqualifiedNative(layout.fields.get(index).fieldType);
			string target = objectFields.has(key) ? objectFields.get(key) : "";
			if (objectFields.has(key)) { objectFields.remove(key); }
			if (target.isEmpty() && native.kind == NNK_NATIVE_RECORD_TYPE && binding.ownedRecords.contains(field.type.base)) { target = field.type.base; }
			if (field.type.isArray || (field.type.isConst && field.type.pointerDepth == 0)) { self.fail(f"{key}: owning input requires assignable non-array fields"); }
			if (target.isEmpty()) {
				if (self.recordContainsResources(native)) { self.fail(f"{key}: embedded resource record requires owned-records"); }
				projection.fields.push(FeNativeRecordInputField(field.name, field.type));
				continue;
			}
			bool nullable = target.endsWith("?");
			if (nullable) { target = target.substring(0, target.length() - 1); }
			bool byValue = native.kind == NNK_NATIVE_RECORD_TYPE;
			if (native.kind != NNK_NATIVE_POINTER && !byValue) { self.fail(f"{key}: object projection requires a pointer field or record value"); }
			NativeNode pointee = byValue ? native : self.unqualifiedNative(native.pointee);
			Node valueType = self.node(NK_TYPE_EXPR);
			valueType.isNullable = nullable;
			valueType.pointerDepth = nullable ? 1 : 0;
			if (binding.ownedRecords.contains(target)) {
				if (byValue && nullable) { self.fail(f"{key}: embedded record input cannot be nullable"); }
				var child = self.recordInput(binding, target, projections, objectFields, callbackFields, ancestors);
				for field in child.fields { if (field.callback) { self.fail("callback fields currently require a root by-value record input"); } }
				NativeNode childLayout = self.recordLayouts.get(binding.module + "\x1f" + target);
				string prefix = "";
				if (pointee.kind != NNK_NATIVE_RECORD_TYPE || pointee.identity != childLayout.identity) {
					if (byValue) { self.fail(f"{key}: incompatible projected record value"); }
					NativeNode first = childLayout.fields.get(0);
					NativeNode firstType = self.unqualifiedNative(first.fieldType);
					if (pointee.kind != NNK_NATIVE_RECORD_TYPE || firstType.kind != NNK_NATIVE_RECORD_TYPE || first.offsetBits != "0" || firstType.identity != pointee.identity) { self.fail(f"{key}: incompatible projected record pointer"); }
					prefix = first.name;
				}
				valueType.base = child.inputName();
				var mapped = FeNativeRecordInputField(field.name, valueType, child.name, prefix);
				mapped.byValue = byValue;
				projection.fields.push(mapped);
			} else {
				bool selected = false;
				for owner in self.declarations { if (owner.language == "objective-c" && owner.declaration.kind == NK_CLASS_DECL && owner.declaration.name == target) { selected = true; } }
				if (pointee.kind != NNK_NATIVE_BUILTIN || pointee.name != "void" || !selected) { self.fail(f"{key}: expected an erased pointer to a selected Objective-C object"); }
				valueType.base = target;
				projection.fields.push(FeNativeRecordInputField(field.name, valueType, "", "", target));
			}
		}
		projections.put(name, projection);
		return projection;
	}

	private NativeNode snapshotUnqualified(NativeNode native) {
		while (native.kind == NNK_NATIVE_ALIAS || native.kind == NNK_NATIVE_QUALIFIED_TYPE) {
			if (native.qualifiers.isVolatile || native.qualifiers.isRestrict) { self.fail("record snapshot paths cannot be volatile or restrict-qualified"); }
			native = native.underlying;
		}
		if (native.qualifiers.isVolatile || native.qualifiers.isRestrict) { self.fail("record snapshot paths cannot be volatile or restrict-qualified"); }
		return native;
	}

	private FeNativeRecordPath snapshotPath(string owner, string path, string kind = "scalar", bool guarded = false) {
		NativeNode native = self.resourceTypes.get(owner);
		var projected = FeNativeRecordPath();
		Vector<string> visited = [];
		for name in Strings.split(path, ".") {
			native = self.snapshotUnqualified(native);
			bool pointer = native.kind == NNK_NATIVE_POINTER;
			NativeNode record = pointer ? self.snapshotUnqualified(native.pointee) : native;
			if (record.kind != NNK_NATIVE_RECORD_TYPE || !self.layouts.has(record.identity)) { self.fail("record snapshot path requires a complete SDK record"); }
			if (visited.contains(record.identity)) { self.fail("record snapshot path cannot traverse cyclic SDK records"); }
			visited.push(record.identity);
			NativeNode layout = self.layouts.get(record.identity);
			NativeNode? selected = null;
			for field in layout.fields { if (field.name == name) { if (selected != null) { self.fail("ambiguous record snapshot field"); } selected = field; } }
			if ((layout.recordKind != "struct" && !(guarded && layout.recordKind == "union")) || selected == null || selected.isAnonymous || selected.isBitfield) { self.fail("record snapshot path names an unavailable SDK field"); }
			projected.fields.push(name); projected.pointers.push(pointer);
			native = selected.fieldType;
		}
		native = self.snapshotUnqualified(native);
		if (native.kind == NNK_NATIVE_ENUM_TYPE) { projected.enumIdentity = native.identity; }
		NativeNode scalar = native.kind == NNK_NATIVE_ENUM_TYPE ? self.snapshotUnqualified(native.underlying) : native;
		if (kind == "pointer") {
			NativeNode? element = native.kind == NNK_NATIVE_POINTER ? self.snapshotUnqualified(native.pointee) : null;
			if (element == null || element.kind != NNK_NATIVE_BUILTIN || !["char", "signed char", "unsigned char"].contains(element.name)) { self.fail("record snapshot byte plane requires a byte pointer"); }
			projected.valueType = self.node(NK_TYPE_EXPR); projected.valueType.base = "unsigned char"; projected.valueType.pointerDepth = 1; projected.valueType.isConst = true;
		} else {
			if (scalar.kind != NNK_NATIVE_BUILTIN || scalar.name == "void") { self.fail("record snapshot leaves must be scalar SDK fields"); }
			if (["width", "rows", "pitch", "length"].contains(kind) && (["float", "double", "bool", "_Bool"].contains(scalar.name) || scalar.bits > 64)) { self.fail("record snapshot plane dimensions require integral fields of at most 64 bits"); }
			if (kind == "pitch" && scalar.signedness != "signed") { self.fail("record snapshot pitch requires a signed integral field"); }
			projected.valueType = self.type(scalar); projected.valueType.isConst = false;
		}
		return projected;
	}

	private void projectRecordSnapshots(FeNativeBinding binding) {
		for selected in binding.recordSnapshots {
			for imported in self.declarations { if (imported.declaration.name == selected.result || imported.declaration.name == selected.name) { self.fail("conflicting native record snapshot name"); } }
			for imported in self.inputClasses { if (imported.declaration.name == selected.result || imported.declaration.name == selected.name) { self.fail("conflicting native record snapshot name"); } }
			if (!self.resourceTypes.has(selected.owner)) { self.fail("record snapshot requires an authenticated selected native owner"); }
			var projection = FeNativeRecordSnapshot(); projection.resultName = selected.result;
			if (selected.guard.len > 0) {
				var guardPath = self.snapshotPath(selected.owner, selected.guard.get(0));
				projection.guardPath = guardPath;
				projection.guardConstant = selected.guard.get(1);
				NativeNode? constant = self.callbackExports.has(projection.guardConstant) ? self.callbackExports.get(projection.guardConstant) : null;
				if (guardPath.enumIdentity.isEmpty() || constant == null || constant.kind != NNK_NATIVE_CONSTANT || constant.enumIdentity != guardPath.enumIdentity) { self.fail("record snapshot guard requires a selected constant of exactly the field's SDK enum"); }
			}
			Node owner = self.node(NK_CLASS_DECL); owner.name = selected.result; owner.sourceFile = self.module;
			var fields = selected.fields.keys(); fields.sortBy((string left, string right) => Strings.lessThan(left, right));
			for name in fields {
				var path = self.snapshotPath(selected.owner, selected.fields.get(name), "scalar", projection.guardPath != null);
				projection.paths.push(path); projection.fields.push(FeNativeRecordInputField(name, path.valueType));
				Node field = self.node(NK_FIELD_DECL); field.name = name; field.access = "public"; field.type = path.valueType; owner.membersMut().push(field);
			}
			var stringNames = selected.strings.keys(); stringNames.sortBy((string left, string right) => Strings.lessThan(left, right));
			for name in stringNames {
				projection.strings.put(name, self.snapshotPath(selected.owner, selected.strings.get(name), "pointer", projection.guardPath != null));
				Node field = self.node(NK_FIELD_DECL); field.name = name; field.access = "public"; field.type = self.node(NK_TYPE_EXPR); field.type.base = "string"; field.type.isNullable = true; owner.membersMut().push(field);
			}
			if (selected.bytePlane.len > 0) {
				projection.byteField = selected.bytePlane.get(0);
				Vector<string> kinds = ["pointer", "width", "rows", "pitch"];
				for index in range(kinds.len) { projection.bytePaths.push(self.snapshotPath(selected.owner, selected.bytePlane.get(index + 1), kinds.get(index), projection.guardPath != null)); }
			}
			if (selected.byteSpan.len > 0) {
				projection.byteField = selected.byteSpan.get(0); projection.byteSpan = true;
				Vector<string> kinds = ["pointer", "length"];
				for index in range(kinds.len) { projection.bytePaths.push(self.snapshotPath(selected.owner, selected.byteSpan.get(index + 1), kinds.get(index), projection.guardPath != null)); }
			}
			if (!projection.byteField.isEmpty()) {
				Node field = self.node(NK_FIELD_DECL); field.name = projection.byteField; field.access = "public"; field.type = self.node(NK_TYPE_EXPR); field.type.base = "Bytes"; owner.membersMut().push(field);
			}
			var generated = FeNativeImportedDeclaration(owner, self.module, self.header); generated.generatedInput = true; self.inputClasses.push(generated);
			Node declaration = self.node(NK_FUNCTION_DECL); declaration.name = selected.name; declaration.returnType = self.node(NK_TYPE_EXPR); declaration.returnType.base = selected.result; declaration.returnType.isNullable = true; declaration.returnType.pointerDepth = 1;
			Node parameter = self.node(NK_PARAM); parameter.name = "owner"; parameter.type = self.node(NK_TYPE_EXPR); parameter.type.base = selected.owner; declaration.paramsMut().push(parameter);
			var contract = FeNativeCallContract(); contract.nonnullParameters.push(true); contract.resourceParameters.push(selected.owner); contract.recordSnapshot = projection;
			if (!projection.byteField.isEmpty() || projection.strings.len > 0) {
				Node maximum = self.node(NK_PARAM); maximum.name = "maximumBytes"; maximum.type = self.node(NK_TYPE_EXPR); maximum.type.base = "int"; declaration.paramsMut().push(maximum);
				contract.nonnullParameters.push(false); contract.resourceParameters.push("");
			}
			self.add(selected.name, declaration, "record-snapshot:" + projection.identity(), "", false, contract);
		}
	}

	private void projectRecordInputs(Vector<FeNativeBinding> bindings) {
		Map<string, bool> generated = {};
		Map<string, FeNativeRecordOutput> outputs = {};
		for binding in bindings {
			if (binding.ownedRecords.len == 0 && binding.recordInputs.len == 0 && binding.recordOutputs.len == 0) { continue; }
			/* C++ owned records are scalar factory results, already copied by the opaque-owner projection; they never become record inputs. */
			if (binding.language == "c++") { continue; }
			self.module = binding.module;
			Map<string, FeNativeRecordInput> projections = {};
			Map<string, string> objectFields = {};
			for key in binding.objectFields.keys() { objectFields.put(key, binding.objectFields.get(key)); }
			Map<string, FeNativeCallbackProjection> callbackFields = {};
			for imported in self.declarations {
				var callContract = imported.callContract;
				if (imported.module != binding.module || imported.declaration.kind != NK_FUNCTION_DECL || callContract == null || !binding.symbols.contains(imported.declaration.name)) { continue; }
				for callback in callContract.callbacks {
					if (callback.field.isEmpty()) { continue; }
					string parameter = imported.declaration.name + "." + imported.declaration.params().get(callback.parameterIndex).name;
					if (!binding.ownedRecords.contains(callback.record) || !binding.recordInputs.contains(parameter)) { self.fail("callback fields require owned-records and record-inputs"); }
					string key = callback.record + "." + callback.field;
					if (callbackFields.has(key)) {
						var previous = callbackFields.get(key);
						if (previous.interfaceName != callback.interfaceName || previous.contextFields.len != callback.contextFields.len) { self.fail("conflicting callback field projection"); }
						for position in range(previous.contextFields.len) { if (previous.contextFields.get(position) != callback.contextFields.get(position)) { self.fail("conflicting callback field projection"); } }
					}
					callbackFields.put(key, callback);
				}
			}
			Vector<string> active = [];
			for name in binding.ownedRecords { self.recordInput(binding, name, projections, objectFields, callbackFields, active); }
			if (objectFields.len > 0) { self.fail("unknown projected object field"); }
			for name in projections.keys() {
				FeNativeRecordInput projection = projections.get(name);
				string inputName = projection.inputName();
				if (generated.has(inputName)) { self.fail(f"conflicting native input class '{inputName}'"); }
				for imported in self.declarations { if (imported.declaration.name == inputName) { self.fail(f"conflicting native input class '{inputName}'"); } }
				generated.put(inputName, true);
				Node declaration = self.node(NK_CLASS_DECL);
				declaration.name = inputName;
				declaration.sourceFile = binding.module;
				for field in projection.fields {
					Node member = self.node(NK_FIELD_DECL);
					member.access = "public";
					member.name = field.name;
					member.type = field.valueType;
					declaration.membersMut().push(member);
				}
				var imported = FeNativeImportedDeclaration(declaration, binding.module, binding.header);
				imported.generatedInput = true;
				self.inputClasses.push(imported);
			}
			Map<string, Vector<string>> byFunction = {};
			for input in binding.recordInputs {
				var parts = Strings.split(input, ".");
				if (!byFunction.has(parts.get(0))) { Vector<string> parameters = []; byFunction.put(parts.get(0), parameters); }
				byFunction.get(parts.get(0)).push(parts.get(1));
			}
			for name in byFunction.keys() {
				var imported = self.selectedDeclaration(binding.module, name);
				Node declaration = imported.declaration;
				if (declaration.kind != NK_FUNCTION_DECL) { self.fail(f"record-inputs requires a function: {name}"); }
				FeNativeCallContract? contract = imported.callContract;
				if (contract == null) { self.fail(f"internal compiler error: record-inputs function {name} has no call contract"); }
				contract.recordTypes = projections;
				if (contract.realtimeSafe) { self.fail("owning record input adapters are not realtime-safe"); }
				Vector<string> selected = byFunction.get(name);
				int found = 0;
				for index in range(declaration.params().len) {
					Node parameter = declaration.params().get(index);
					if (!selected.contains(parameter.name)) { contract.recordInputs.push(null); continue; }
					found++;
					Node original = parameter.type;
					if (!projections.has(original.base) || !(original.pointerDepth == 0 || (original.pointerDepth == 1 && original.isConst)) || original.isArray) { self.fail(f"{name}.{parameter.name}: record-inputs requires a const pointer to an owned record or a record value"); }
					FeNativeRecordInput recordType = projections.get(original.base);
					var projection = FeNativeRecordInput(recordType.name, recordType.nativeSpelling, original.pointerDepth == 0);
					projection.fields = recordType.fields;
					for field in projection.fields {
						if (!field.callback) { continue; }
						bool mapped = false;
						for callback in contract.callbacks { if (callback.field == field.name && callback.parameterIndex == index) { mapped = true; } }
						if (!mapped) { self.fail("record callback fields require a callback mapping on every input call"); }
					}
					Node valueType = self.node(NK_TYPE_EXPR);
					valueType.base = projection.inputName();
					valueType.isNullable = original.isNullable;
					valueType.pointerDepth = original.isNullable ? 1 : 0;
					parameter.type = valueType;
					contract.nonnullParameters.set(index, !original.isNullable);
					contract.recordInputs.push(projection);
				}
				if (found != selected.len) { self.fail(f"{name}: record-inputs names an unknown parameter"); }
			}
			self.projectRecordOutputs(binding, projections, outputs);
		}
	}

	private void projectRecordOutputs(FeNativeBinding binding, Map<string, FeNativeRecordInput> projections, Map<string, FeNativeRecordOutput> outputs) {
		Map<string, bool> functions = {};
		for selected in binding.recordOutputs {
			var parts = Strings.split(selected, ".");
			string name = parts.get(0);
			string parameterName = parts.get(1);
			var imported = self.selectedDeclaration(binding.module, name);
			Node declaration = imported.declaration;
			if (declaration.kind != NK_FUNCTION_DECL || functions.has(name)) { self.fail("record-outputs requires one output parameter per selected function"); }
			functions.put(name, true);
			FeNativeCallContract? contract = imported.callContract;
			if (contract == null) { self.fail(f"internal compiler error: record-outputs function {name} has no call contract"); }
			if (contract.variadicArguments.len > 0) { self.fail("record-outputs cannot combine a selected variadic-calls shape"); }
			if (contract.transparentParameters.contains(true)) { self.fail("record-outputs cannot combine transparent-union parameters"); }
			if (contract.callbacks.len > 0 || contract.realtimeSafe || !contract.resourceResult.isEmpty()) { self.fail("record-outputs cannot combine callbacks, realtime or a managed native result"); }
			int index = -1;
			for position in range(declaration.params().len) { if (declaration.params().get(position).name == parameterName) { index = position; } }
			if (index < 0) { self.fail("record-outputs names an unknown parameter"); }
			Node original = declaration.params().get(index).type;
			if (!projections.has(original.base) || original.pointerDepth != 1 || original.isConst || original.isArray) { self.fail("record-outputs requires a mutable pointer to an owned record"); }
			FeNativeRecordInput projection = projections.get(original.base);
			Vector<string> owned = [];
			Vector<string> nulls = [];
			for value in binding.ownedOutputFields { if (value.startsWith(selected + ".")) { owned.push(Strings.split(value, ".").get(2)); } }
			for value in binding.nullOutputFields { if (value.startsWith(selected + ".")) { nulls.push(Strings.split(value, ".").get(2)); } }
			nulls.sort();
			int resourceCount = 0;
			for field in projection.fields {
				if (field.resourceType.isEmpty()) { continue; }
				resourceCount++;
				if (!owned.contains(field.name)) { self.fail("owned-output-fields must declare every resource field exactly"); }
			}
			if (owned.len != resourceCount) { self.fail("owned-output-fields must declare every resource field exactly"); }
			NativeNode layout = self.recordLayouts.get(binding.module + "\x1f" + original.base);
			Map<string, NativeNode> nativeFields = {};
			for field in layout.fields { nativeFields.put(field.name, field.fieldType); }
			var record = FeNativeRecordInput(projection.name, projection.nativeSpelling);
			for field in projection.fields {
				if (field.callback || !field.record.isEmpty() || !field.objectType.isEmpty()) { self.fail("record-outputs supports scalar fields and declared C resources"); }
				NativeNode native = self.unqualifiedNative(nativeFields.get(field.name));
				if (!field.resourceType.isEmpty()) { record.fields.push(field); }
				else if (nulls.contains(field.name)) {
					if (native.kind != NNK_NATIVE_POINTER) { self.fail("null-output-fields requires unmanaged pointer fields"); }
				} else if (native.kind == NNK_NATIVE_BUILTIN || native.kind == NNK_NATIVE_ENUM_TYPE) { record.fields.push(field); }
				else { self.fail("record-outputs requires null-output-fields for pointer storage; aggregates are unsupported"); }
			}
			for field in nulls { if (!nativeFields.has(field)) { self.fail("null-output-fields names an unknown field"); } }
			Node nativeReturn = declaration.returnType;
			if (nativeReturn.base != "void" || nativeReturn.pointerDepth > 0 || nativeReturn.isArray) { self.fail("record-outputs currently requires a void native result; managed tuple cleanup is not supported"); }
			var output = FeNativeRecordOutput(index, record, nulls);
			string outputName = output.outputName();
			if (outputs.has(outputName)) {
				if (outputs.get(outputName).record.identity() != record.identity()) { self.fail("conflicting native output class"); }
			} else {
				for candidate in self.declarations { if (candidate.declaration.name == outputName) { self.fail("conflicting native output class"); } }
				outputs.put(outputName, output);
				Node owner = self.node(NK_CLASS_DECL);
				owner.name = outputName;
				owner.sourceFile = binding.module;
				for field in record.fields {
					Node member = self.node(NK_FIELD_DECL);
					member.access = "public";
					member.name = field.name;
					member.type = field.valueType;
					owner.membersMut().push(member);
				}
				var generated = FeNativeImportedDeclaration(owner, binding.module, binding.header);
				generated.generatedInput = true;
				self.inputClasses.push(generated);
			}
			declaration.paramsMut().remove(index);
			Node result = self.node(NK_TYPE_EXPR);
			result.base = outputName;
			declaration.returnType = result;
			contract.nonnullParameters.remove(index);
			contract.nonnullReturn = false;
			contract.readOnlyBorrows.remove(index);
			contract.resourceParameters.remove(index);
			if (contract.recordInputs.len > 0) { contract.recordInputs.remove(index); }
			contract.recordOutput = output;
		}
	}

	private void validateRecordCallbacks() {
		for imported in self.declarations {
			if (imported.declaration.kind != NK_FUNCTION_DECL || imported.callContract == null) { continue; }
			var contract = imported.callContract;
			for callback in contract.callbacks {
				if (callback.field.isEmpty() || callback.realtime != null) { continue; }
				if (callback.parameterIndex >= contract.recordInputs.len || contract.recordInputs.get(callback.parameterIndex) == null) { self.fail("callback fields require owned-records and record-inputs"); }
			}
		}
	}

	private Vector<string> readerGroup(Vector<string> arguments) {
		Vector<string> result = [];
		bool compileFlags = false;
		for argument in arguments {
			if (argument.equals("--")) { compileFlags = true; }
			if (!compileFlags && (argument.startsWith("--symbol=") || argument.startsWith("--record-path=") || argument.startsWith("--record-value="))) { continue; }
			result.push(argument);
		}
		return result;
	}

	private string readerGroupKey(Vector<string> arguments) {
		var value = JSONValue.makeArray();
		for argument in self.readerGroup(arguments) { value.push(JSONValue.makeString(argument)); }
		return value.stringify();
	}

	private JSONValue readerSelection(Vector<string> arguments, string identity) {
		var value = JSONValue.makeObject();
		value.set("id", JSONValue.makeString(identity));
		var symbols = JSONValue.makeArray();
		var paths = JSONValue.makeArray();
		var records = JSONValue.makeArray();
		for argument in arguments {
			if (argument.equals("--")) { break; }
			if (argument.startsWith("--symbol=")) { symbols.push(JSONValue.makeString(argument.substring(9, argument.length() - 9))); }
			else if (argument.startsWith("--record-path=")) { paths.push(JSONValue.makeString(argument.substring(14, argument.length() - 14))); }
			else if (argument.startsWith("--record-value=")) { records.push(JSONValue.makeString(argument.substring(15, argument.length() - 15))); }
		}
		value.set("symbols", symbols);
		value.set("record_paths", paths);
		value.set("record_values", records);
		return value;
	}

	private Vector<int> readerMembers(int index, Vector<Vector<string>> commands, Map<string, Vector<int>> groups) {
		Vector<int> members = [];
		/* Preserve the 8 MiB allowance per selection within int32 captures. */
		for member in groups.get(self.readerGroupKey(commands.get(index))) {
			if (member < index) { continue; }
			members.push(member);
			if (members.len == 255) { break; }
		}
		return members;
	}

	private FeNativeHeaderRead readerRequest(string reader, Vector<Vector<string>> commands, Vector<int> members) {
		var arguments = commands.get(members.get(0));
		if (members.len == 1) { return FeNativeHeaderRead(reader, arguments); }
		var selections = JSONValue.makeArray();
		for member in members { selections.push(self.readerSelection(commands.get(member), Strings.fromInt(member))); }
		var payload = JSONValue.makeObject();
		payload.set("schema", JSONValue.makeString("btrc.native-requests.v1"));
		payload.set("requests", selections);
		Vector<string> batchArguments = ["--batch=-"];
		batchArguments.extend(self.readerGroup(arguments));
		var request = FeNativeHeaderRead(reader, batchArguments, payload.stringify());
		request.maxStdoutBytes = members.len * 8388608;
		request.timeoutMilliseconds = members.len * 300000;
		return request;
	}

	private Map<string, FeNativeHeaderRead> prepareReaders(string reader, Vector<Vector<string>> commands, Map<string, Vector<int>> groups) {
		Map<string, FeNativeHeaderRead> prepared = {};
		string root = Environment.get("BTRC_CACHE_DIR", "");
		if (root.isEmpty()) { root = PathTools.join(Environment.get("HOME", ""), ".cache/btrc"); }
		if (!PathTools.isAbsolute(root)) { return prepared; }
		string directory = PathTools.join(root, "native-headers-v1");
		Vector<FeNativeHeaderRead> requests = [];
		Vector<string> identities = [];
		Map<string, bool> selected = {};
		var encoded = JSONValue.makeArray();
		for index in range(commands.len) {
			string identity = Strings.fromInt(index);
			if (selected.has(identity)) { continue; }
			var members = self.readerMembers(index, commands, groups);
			var request = self.readerRequest(reader, commands, members);
			requests.push(request); identities.push(identity);
			for member in members { selected.put(Strings.fromInt(member), true); }
			var group = JSONValue.makeObject();
			group.set("id", JSONValue.makeString(identity));
			group.set("input", request.input().isEmpty() ? JSONValue.makeNull() : JSONValue.makeString(request.input()));
			group.set("output_limit", JSONValue.makeInt(request.maxStdoutBytes));
			var arguments = JSONValue.makeArray();
			for argument in request.argv() { arguments.push(JSONValue.makeString(argument)); }
			group.set("arguments", arguments); encoded.push(group);
		}
		if (requests.len == 0) { return prepared; }
		var document = JSONValue.makeObject();
		document.set("schema", JSONValue.makeString("btrc.native-session-requests.v1"));
		document.set("compact", JSONValue.makeBool(true));
		document.set("cache_directory", JSONValue.makeString(directory));
		document.set("groups", encoded);
		string payload = document.stringify();
		if (payload.length() > 8388608) { return prepared; }
		try {
			var control = FeNativeHeaderRead(reader, ["--prepare-native-session=-"], payload);
			var batch = FeNativeHeaderBatch(); batch.append(control); self.headerReader(batch);
			var result = control.result(); if (result.isErr()) { return prepared; }
			var response = JSONValue.parse(result.unwrap());
			if (!response.isObject() || !response.get("schema").asString().equals("btrc.native-session-prepared.v1") || !response.get("runtime_stable").asBool()) { return prepared; }
			if (!response.get("launcher").asString().equals(reader) || !response.get("eligible_launcher").asBool()) { return prepared; }
			var rows = response.get("groups");
			if (!rows.isArray() || rows.size() != requests.len) { return prepared; }
			for index in range(requests.len) {
				var row = rows.at(index);
				if (!row.isObject() || !row.get("id").asString().equals(identities.get(index))) { return new Map<string, FeNativeHeaderRead>(); }
			}

			for index in range(requests.len) {
				var row = rows.at(index);
				if (!row.get("prepared").asBool() || !row.get("cache_eligible").asBool()) { continue; }
				var request = requests.get(index); request.cacheDirectory = directory;
				if (row.get("cache_hit").asBool()) { request.cachedResponse = row.get("response").stringify(); }
				prepared.put(identities.get(index), request);
			}
		} catch (string error) { return new Map<string, FeNativeHeaderRead>(); }
		return prepared;
	}

	private string readHeader(int index, string reader, Vector<Vector<string>> commands, Map<string, Vector<int>> groups, Map<string, FeNativeHeaderRead> prepared, Map<string, FeNativeHeaderRead> pending, Map<string, Result<string, string>> responses) {
		string identity = Strings.fromInt(index);
		if (!responses.has(identity)) {
			if (!pending.has(identity)) {
				var batch = FeNativeHeaderBatch();
				/* No worker escapes this dispatch. Retain at most one bounded wave
				 * of unread groups; failures are consumed in declaration order. */
				for candidate in range(index, commands.len) {
					string key = Strings.fromInt(candidate);
					if (pending.has(key) || responses.has(key)) { continue; }
					var members = self.readerMembers(candidate, commands, groups);
					var request = prepared.has(key) ? prepared.get(key) : self.readerRequest(reader, commands, members);
					if (!batch.append(request)) { break; }
					for member in members { pending.put(Strings.fromInt(member), request); }
				}
				self.headerReader(batch);
			}
			var result = pending.get(identity).result();
			var members = self.readerMembers(index, commands, groups);
			for member in members { pending.remove(Strings.fromInt(member)); }
			if (result.isErr()) { self.fail(result.unwrapErr()); }
			if (members.len == 1) { responses.put(identity, result); }
			else {
				Vector<string> identities = [];
				for member in members { identities.push(Strings.fromInt(member)); }
				var decoded = FeNativeHeaderCodec().decodeBatch(result.unwrap(), identities);
				for position in range(members.len) { responses.put(identities.get(position), decoded.get(position)); }
			}
		}
		var result = responses.get(identity);
		responses.remove(identity);
		if (result.isErr()) { self.fail(result.unwrapErr()); }
		return result.unwrap();
	}

	private Vector<string> readerArguments(FeNativeBinding binding, FeNativeLinkPlan plan, string target, string sysroot) {
		Vector<string> arguments = [];
		for name in binding.symbols { arguments.push("--symbol=" + name); }
		if (binding.language == "c++") {
			/* C++ resources select their methods (including explicit zero-argument selectors) beside the class; by-value records are read as scalar layouts. */
			for name in binding.resources.keys() { for method in binding.resources.get(name).methods { arguments.push("--symbol=" + name + "::" + method); } }
			for name in binding.ownedRecords { arguments.push("--record-value=" + name); }
		}
		Vector<string> snapshotPaths = [];
		for snapshot in binding.recordSnapshots {
			for name in snapshot.fields.keys() { string path = snapshot.owner + "." + snapshot.fields.get(name); if (!snapshotPaths.contains(path)) { snapshotPaths.push(path); } }
			for index in range(1, snapshot.bytePlane.len) { string path = snapshot.owner + "." + snapshot.bytePlane.get(index); if (!snapshotPaths.contains(path)) { snapshotPaths.push(path); } }
			for name in snapshot.strings.keys() { string path = snapshot.owner + "." + snapshot.strings.get(name); if (!snapshotPaths.contains(path)) { snapshotPaths.push(path); } }
			for index in range(1, snapshot.byteSpan.len) { string path = snapshot.owner + "." + snapshot.byteSpan.get(index); if (!snapshotPaths.contains(path)) { snapshotPaths.push(path); } }
			if (snapshot.guard.len > 0) { string path = snapshot.owner + "." + snapshot.guard.get(0); if (!snapshotPaths.contains(path)) { snapshotPaths.push(path); } }
		}
		/* A dispatched slot's path reads its table's layout without exporting the table itself. */
		for resourceName in binding.resources.keys() {
			FeNativeDispatchTable? dispatch = binding.resources.get(resourceName).dispatch;
			if (dispatch == null) { continue; }
			Vector<string> slots = [];
			slots.extend(dispatch.methodSlots);
			if (!dispatch.releaseSlot.isEmpty()) { slots.push(dispatch.releaseSlot); }
			for slot in slots { string path = resourceName + "." + dispatch.table + "." + slot; if (!snapshotPaths.contains(path)) { snapshotPaths.push(path); } }
		}
		/* A COM interface's IUnknown slots are checked against its table. */
		for resourceName in binding.resources.keys() {
			if (binding.resources.get(resourceName).ownership != "com") { continue; }
			for slot in ["QueryInterface", "AddRef", "Release"] { string path = resourceName + ".lpVtbl." + slot; if (!snapshotPaths.contains(path)) { snapshotPaths.push(path); } }
		}
		snapshotPaths.sortBy((string left, string right) => Strings.lessThan(left, right));
		for path in snapshotPaths { arguments.push("--record-path=" + path); }
		Vector<string> packages = [];
		for declaration in plan.declarations {
			if (declaration.kind == "pkg-config" && declaration.selectedFor(plan.target) && !packages.contains(declaration.value)) { packages.push(declaration.value); }
		}
		packages.sortBy((string left, string right) => Strings.lessThan(left, right));
		for package in packages { arguments.push("--pkg-config=" + package); }
		arguments.extend([binding.header, "--", "-x", binding.language, "-std=" + binding.standard, "--target=" + target]);
		/* The NDK sysroot is a whole sysroot: clang then searches its usr/include
		 * and per-architecture headers itself. */
		if (plan.target.row().sysrootKind == "ndk") { arguments.push("--sysroot=" + sysroot); }
		else { arguments.extend(["-isysroot", sysroot]); }
		if (binding.language == "objective-c") {
			if (!plan.target.row().objectiveC) { self.fail("Objective-C adapters require an Apple target"); }
			arguments.extend(["-fblocks", "-fobjc-arc"]);
		}
		if (plan.target.operatingSystem.equals("linux")) { arguments.extend(["-isystem", PathTools.join(sysroot, "usr/include")]); }
		// A zig MinGW sysroot keeps the Windows SDK headers where its
		// validation found windows.h (FeNativeSysroot.validate).
		else if (plan.target.operatingSystem.equals("windows")) { arguments.extend(["-isystem", PathTools.join(PathTools.join(sysroot, "include"), "any-windows-any")]); }
		if (binding.language == "c++") { for directory in self.cxxToolchainIncludes(binding.standard, target, sysroot) { arguments.extend(["-isystem", directory]); } }
		for declaration in plan.declarations {
			if (!declaration.selectedFor(plan.target)) { continue; }
			if (declaration.kind.equals("include-directory")) { arguments.extend(["-I", declaration.value]); }
			if (declaration.kind.equals("define")) { arguments.push("-D" + declaration.value + (declaration.detail.isEmpty() ? "" : "=" + declaration.detail)); }
		}
		return arguments;
	}

	private Vector<FeNativeBinding> pendingBindings = [];
	private Vector<string> pendingResponses = [];
	private string pendingTarget = "";

	/* Reads every binding's header response and digests it into the cache
	 * identity; complete() decodes and imports them. A compile answered from
	 * the artifact cache needs only the identity, and a response's content is
	 * fixed by its digest, so it is decoded only when a compile runs. */
	public void prepare(FeNativeLinkPlan plan, bool useCache = false) {
		Vector<FeNativeBinding> bindings = plan.bindingImports();
		if (bindings.len == 0) { return; }
		for binding in bindings {
			if (binding.packageName == "btrc_stdlib_com" && binding.language == "c" && PathTools.basename(binding.header) == "COM.h") { self.comRuntime = true; }
			for key in binding.callbacks.keys() {
				var callback = binding.callbacks.get(key);
				if (!callback.slotGetter.isEmpty()) {
					self.callbackOperations.put(callback.slotGetter, true);
					if (!callback.actionSetter.isEmpty()) { self.callbackOperations.put(callback.actionSetter, true); }
					if (!callback.actionGetter.isEmpty()) { self.callbackOperations.put(callback.actionGetter, true); }
					for method in callback.methods { self.callbackOperations.put(method, true); }
				} else if (callback.lifetime == "instantiated") {
					for method in callback.methods { self.callbackOperations.put(method, true); }
					/* A subclass adapter's own initializer is imported, as its constructor. */
					string initializer = Strings.split(key, ".").get(0);
					for method in callback.overrides { if (method != initializer) { self.callbackOperations.put(method, true); } }
				} else if (!callback.unregister.isEmpty()) { self.callbackOperations.put(callback.unregister, true); }
				var realtime = callback.realtime;
				if (realtime != null) { for method in realtime.operations.keys() { self.callbackOperations.put(Strings.split(realtime.operations.get(method), ".").get(0), true); } }
			}
		}
		string reader = Environment.get("BTRC_NATIVE_HEADER_READER", "");
		if (reader.isEmpty()) { plan.requireResolvedBindings(); }
		string readerIdentity = PathTools.isAbsolute(reader) ? self.sourceFiles.binaryIdentity(reader) : "";
		self.cacheable = !readerIdentity.isEmpty();
		self.resolvedIdentity.appendText(readerIdentity);
		/* The row names the triple; BTRC_NATIVE_TARGET must spell it or one of
		 * its aliases. The reader always receives, and reports, the row's
		 * canonical cc1 triple. */
		GeneratedTargetRow row = plan.target.row();
		self.pointerBits = row.sizeofPointer * 8;
		string requested = Environment.get("BTRC_NATIVE_TARGET", "");
		if (requested != row.triple && !row.tripleAliases.contains(requested)) { throw "native imports for " + row.label + " require BTRC_NATIVE_TARGET " + row.triple; }
		string target = row.triple;
		string sysroot = Environment.get("BTRC_NATIVE_SYSROOT", "");
		string sysrootIdentity = FeNativeSysroot(row, sysroot).validate();
		/* The link plan records which sysroot the headers were read through. */
		plan.sysrootIdentity = sysrootIdentity;
		self.resolvedIdentity.appendText("sysroot\x1f" + sysrootIdentity);
		Vector<Vector<string>> commands = [];
		Map<string, Vector<int>> groups = {};
		Map<string, Result<string, string>> responses = {};
		Map<string, FeNativeHeaderRead> pending = {};
		/* Java bindings read class files through their own reader, never this session. */
		Vector<FeNativeBinding> javaBindings = [];
		Vector<FeNativeBinding> headerBindings = [];
		for binding in bindings {
			if (binding.language == "java") { javaBindings.push(binding); }
			else { headerBindings.push(binding); }
		}
		Vector<FeNativeBinding> allBindings = bindings;
		bindings = headerBindings;
		for index in range(bindings.len) {
			var binding = bindings.get(index);
			self.module = binding.module;
			if (binding.language != "c" && binding.language != "objective-c" && binding.language != "c++") { self.fail("Objective-C++ call adapters are not implemented"); }
			if (self.headerReader == null) { self.fail("SDK header scanning is unavailable in this compiler host build"); }
			var arguments = self.readerArguments(binding, plan, target, sysroot);
			commands.push(arguments);
			string key = self.readerGroupKey(arguments);
			if (!groups.has(key)) { groups.put(key, new Vector<int>()); }
			groups.get(key).push(index);
		}

		Map<string, FeNativeHeaderRead> prepared = useCache ? self.prepareReaders(reader, commands, groups) : new Map<string, FeNativeHeaderRead>();
		BtrccPhaseTimer.mark("n-prepare");

		for index in range(bindings.len) {
			var binding = bindings.get(index);
			self.module = binding.module;
			string response = self.readHeader(index, reader, commands, groups, prepared, pending, responses);
			self.resolvedIdentity.appendText(SHA256.digest(response));
			self.resolvedIdentity.appendText(SHA256.digest(reader));
			for argument in commands.get(index) { self.resolvedIdentity.appendText(SHA256.digest(argument)); }
			self.pendingResponses.push(response);
		}
		self.pendingBindings = bindings;
		self.pendingTarget = target;
		for binding in javaBindings { self.prepareJavaBinding(binding, allBindings, target); }
		BtrccPhaseTimer.mark("n-bindings");
	}

	private Vector<FeNativeBinding> pendingJavaBindings = [];
	private Vector<string> pendingJavaResponses = [];
	private string javaRuntimeHeader = "";

	/* Reads one Java binding's classes with the build target's triple, never
	 * through the header session or its cache. The reader's identity and its
	 * document enter the resolution identity, so a C-only program's identity is
	 * unchanged. Every generated adapter calls JNI through Library.Java's JNI.h,
	 * which the program must import (native-interop-ownership.md 2.3). */
	private void prepareJavaBinding(FeNativeBinding binding, Vector<FeNativeBinding> bindings, string target) {
		self.module = binding.module;
		string reader = Environment.get("BTRC_JAVA_CLASS_READER", "");
		if (reader.isEmpty()) { self.fail("Java bindings require BTRC_JAVA_CLASS_READER"); }
		string classpath = Environment.get("BTRC_JAVA_CLASSPATH", "");
		if (classpath.isEmpty()) { self.fail("Java bindings require BTRC_JAVA_CLASSPATH"); }
		string runtime = "";
		for candidate in bindings {
			if (runtime.isEmpty() && candidate.packageName == "btrc_stdlib_java" && candidate.language == "c" && PathTools.basename(candidate.header) == "JNI.h") { runtime = candidate.header; }
		}
		if (runtime.isEmpty()) { self.fail("Java bindings require import Library.Java.JavaVirtualMachine"); }
		if (self.headerReader == null) { self.fail("SDK header scanning is unavailable in this compiler host build"); }
		Vector<string> arguments = ["--target=" + target, "--classpath=" + classpath];
		/* The binding's symbols, then each natives method its registrations name, once each. */
		Vector<string> symbols = [];
		for symbol in binding.symbols { symbols.push(symbol); }
		for natives in binding.javaNatives {
			for method in natives.methods {
				string symbol = natives.className + "." + method;
				if (!symbols.contains(symbol)) { symbols.push(symbol); }
			}
		}
		for symbol in symbols { arguments.push("--symbol=" + symbol); }
		var request = FeNativeHeaderRead(reader, arguments);
		var batch = FeNativeHeaderBatch();
		batch.append(request);
		self.headerReader(batch);
		var result = request.result();
		if (result.isErr()) { self.fail(result.unwrapErr()); }
		string identity = PathTools.isAbsolute(reader) ? self.sourceFiles.binaryIdentity(reader) : "";
		if (identity.isEmpty()) { self.cacheable = false; }
		self.resolvedIdentity.appendText("java\x1f" + identity);
		self.resolvedIdentity.appendText(SHA256.digest(result.unwrap()));
		for argument in arguments { self.resolvedIdentity.appendText(SHA256.digest(argument)); }
		self.pendingJavaBindings.push(binding);
		self.pendingJavaResponses.push(result.unwrap());
		self.javaRuntimeHeader = runtime;
	}

	private string javaSimpleName(string binaryName) {
		var parts = Strings.split(binaryName, "/");
		return parts.get(parts.len - 1);
	}

	/* Each selected class is an abstract unique owner of one JNI global reference. */
	private void projectJavaClasses(NativeNode header, Map<string, string> classes, Map<string, NativeNode> declarations, Map<string, string> simpleNames) {
		for declaration in header.exports {
			if (declaration.kind != NNK_NATIVE_JAVA_CLASS) { continue; }
			string name = declaration.name;
			if (classes.has(name)) { self.fail(f"Java class {name} is selected by two bindings"); }
			if (declaration.binaryName.contains("$")) { self.fail(f"Java nested classes are not projected yet: {name}"); }
			if (declaration.binaryName == "java/lang/String") { self.fail("java.lang.String projects to string, not to a class"); }
			string simple = self.javaSimpleName(declaration.binaryName);
			if (simpleNames.has(simple)) { self.fail(f"Java classes {simpleNames.get(simple)} and {name} project to the same BTRC name {simple}"); }
			classes.put(name, simple);
			declarations.put(name, declaration);
			simpleNames.put(simple, name);
			Node imported = self.node(NK_CLASS_DECL);
			imported.name = simple;
			imported.isAbstract = true;
			for methodName in ["close", "isOpen"] {
				Node method = self.node(NK_METHOD_DECL);
				method.name = methodName;
				method.access = "public";
				method.returnType = self.node(NK_TYPE_EXPR);
				method.returnType.base = methodName == "close" ? "void" : "bool";
				imported.membersMut().push(method);
			}
			var resource = FeNativeResourceBinding(simple, "unique", "", "");
			self.add(simple, imported, "java-class:" + declaration.identity, "jobject", false, null, resource);
		}
	}

	private Node javaType(string base, bool nullable) {
		Node projected = self.node(NK_TYPE_EXPR);
		projected.base = base;
		if (nullable) { projected.isNullable = true; projected.pointerDepth = 1; }
		return projected;
	}

	private Vector<string> javaPrimitiveNames() { return ["jboolean", "jbyte", "jchar", "jshort", "jint", "jlong", "jfloat", "jdouble"]; }

	private Vector<string> javaPrimitiveKinds() { return ["Z", "B", "C", "S", "I", "J", "F", "D"]; }

	private Vector<string> javaPrimitiveBases() { return ["bool", "signed char", "unsigned short", "short", "int", "long long", "float", "double"]; }

	/* Each primitive array's generated owner, in javaPrimitiveKinds() order
	 * (native-interop-ownership.md 2.3, "Arrays"). */
	private Vector<string> javaArrayNames() { return ["JavaBooleanArray", "JavaByteArray", "JavaCharArray", "JavaShortArray", "JavaIntArray", "JavaLongArray", "JavaFloatArray", "JavaDoubleArray"]; }

	/* The array owners already projected, by element descriptor letter. */
	private Map<string, bool> javaArrays = {};

	private Node javaSpan(string base, bool readOnly) {
		Node elements = self.javaType(base, false);
		elements.isConst = readOnly;
		Node span = self.javaType("Span", false);
		span.genericArgsStorage = [elements];
		return span;
	}

	/* A Java value's kind; `projected` receives its BTRC type, a nullable owner
	 * for a selected class. A primitive array is a nullable owner of its
	 * generated array class, except a natives parameter (`span` is 1 when it is
	 * writable, 0 when read-only, -1 otherwise), which is a borrowed Span of its
	 * elements whose kind is its descriptor. */
	private string javaValue(NativeNode native, string member, Map<string, string> classes, Vector<Node> projected, bool result = false, int span = -1) {
		if (native.kind == NNK_NATIVE_BUILTIN) {
			if (result && native.name == "void") { projected.push(self.javaType("void", false)); return "V"; }
			int index = self.javaPrimitiveNames().indexOf(native.name);
			if (index < 0) { self.fail(f"Java member {member} uses unsupported type {native.name}"); }
			projected.push(self.javaType(self.javaPrimitiveBases().get(index), false));
			return self.javaPrimitiveKinds().get(index);
		}
		if (native.kind == NNK_NATIVE_JAVA_ARRAY) {
			NativeNode element = native.element;
			int index = element.kind == NNK_NATIVE_BUILTIN ? self.javaPrimitiveNames().indexOf(element.name) : -1;
			if (index < 0) { self.fail(f"Java arrays of objects or arrays are not projected yet: {member}"); }
			string letter = self.javaPrimitiveKinds().get(index);
			if (span >= 0) {
				projected.push(self.javaSpan(self.javaPrimitiveBases().get(index), span == 0));
				return "[" + letter;
			}
			projected.push(self.javaType(self.projectJavaArray(index, classes), true));
			return "object";
		}
		if (native.kind != NNK_NATIVE_JAVA_OBJECT) { self.fail(f"Java member {member} uses an unsupported type"); }
		if (native.binaryName == "java/lang/String") { projected.push(self.javaType("string", true)); return "string"; }
		if (!classes.has(native.name)) { self.fail(f"Java member {member} uses unselected class {native.name}"); }
		projected.push(self.javaType(classes.get(native.name), true));
		return "object";
	}

	private void addJavaMember(FeNativeImportedDeclaration owner, Map<string, string> names, NativeNode declaration, NativeNode ownerClass, string kind, string name, string access, Vector<string> kinds, string result, Node returnType, Vector<Node> parameters, string memberName, string executor) {
		if (names.has(name)) { self.fail(f"Java members {names.get(name)} and {declaration.name} project to the same BTRC name {name}"); }
		names.put(name, declaration.name);
		var contract = FeNativeCallContract();
		var java = FeNativeJavaMember(kind, owner.declaration.name, ownerClass.binaryName, memberName, declaration.descriptor, declaration.identity, declaration.staticMember, kinds, result);
		java.executor = executor;
		contract.javaMember = java;
		owner.methods.put(name, contract);
		Node member = self.node(NK_METHOD_DECL);
		member.access = access;
		member.name = name;
		member.returnType = returnType;
		member.paramsStorage = parameters;
		owner.declaration.membersMut().push(member);
	}

	private Node javaParameter(string name, Node type) {
		Node parameter = self.node(NK_PARAM);
		parameter.name = name;
		parameter.type = type;
		return parameter;
	}

	/* A generated Java resource: a unique owner of one JNI reference and its
	 * generated members, each declared by `addJavaGenerated`; its adapters are
	 * generated from the member kinds (native-interop-ownership.md section 2.3). */
	private FeNativeImportedDeclaration projectJavaGenerated(string name, string subject, Map<string, string> classes, string spelling, string identity) {
		for other in classes.keys() {
			if (classes.get(other) == name) { self.fail(f"Java class {other} and {subject} project to the same BTRC name {name}"); }
		}
		Node imported = self.node(NK_CLASS_DECL);
		imported.name = name;
		imported.isAbstract = true;
		for methodName in ["close", "isOpen"] {
			Node method = self.node(NK_METHOD_DECL);
			method.name = methodName;
			method.access = "public";
			method.returnType = self.node(NK_TYPE_EXPR);
			method.returnType.base = methodName == "close" ? "void" : "bool";
			imported.membersMut().push(method);
		}
		var resource = FeNativeResourceBinding(name, "unique", "", "");
		self.add(name, imported, identity, spelling, false, null, resource);
		return self.resourceDeclaration(name);
	}

	private void addJavaGenerated(FeNativeImportedDeclaration owner, string kind, string name, bool isStatic, Vector<Node> parameters, Node returnType, Vector<string> kinds, string result, string binaryName, string descriptor) {
		var contract = FeNativeCallContract();
		contract.javaMember = FeNativeJavaMember(kind, owner.declaration.name, binaryName, "", descriptor, binaryName, isStatic, kinds, result);
		owner.methods.put(name, contract);
		Node member = self.node(NK_METHOD_DECL);
		member.access = isStatic ? "class" : "public";
		member.name = name;
		member.returnType = returnType;
		member.paramsStorage = parameters;
		owner.declaration.membersMut().push(member);
	}

	/* The owner of one primitive array kind, projected the first time a member
	 * uses it. create copies a Span into a new Java array through
	 * Set<X>ArrayRegion; read and write copy a Span's elements out of and into
	 * it through Get<X>ArrayRegion and Set<X>ArrayRegion, from `start`
	 * (native-interop-ownership.md section 2.3, "Arrays"). */
	private string projectJavaArray(int index, Map<string, string> classes) {
		string name = self.javaArrayNames().get(index);
		string letter = self.javaPrimitiveKinds().get(index);
		if (self.javaArrays.has(letter)) { return name; }
		self.javaArrays.put(letter, true);
		string base = self.javaPrimitiveBases().get(index);
		string descriptor = "[" + letter;
		var owner = self.projectJavaGenerated(name, descriptor, classes, self.javaPrimitiveNames().get(index) + "Array", "java-array:" + descriptor);
		Vector<string> spanKind = ["span"];
		Vector<string> regionKinds = ["I", "span"];
		Vector<string> noKinds = [];
		Vector<Node> noParameters = [];
		self.addJavaGenerated(owner, "array-create", "create", true, [self.javaParameter("elements", self.javaSpan(base, true))], self.javaType(name, false), spanKind, "object", descriptor, descriptor);
		self.addJavaGenerated(owner, "array-length", "length", false, noParameters, self.javaType("int", false), noKinds, "I", descriptor, descriptor);
		self.addJavaGenerated(owner, "array-read", "read", false, [self.javaParameter("start", self.javaType("int", false)), self.javaParameter("elements", self.javaSpan(base, false))], self.javaType("void", false), regionKinds, "V", descriptor, descriptor);
		self.addJavaGenerated(owner, "array-write", "write", false, [self.javaParameter("start", self.javaType("int", false)), self.javaParameter("elements", self.javaSpan(base, true))], self.javaType("void", false), regionKinds, "V", descriptor, descriptor);
		return name;
	}

	/* JavaWeak<Class>: a unique owner of one weak global reference to an object
	 * of a selected class. create(referent) takes NewWeakGlobalRef of a live
	 * owner; get() returns a new owner of a new global reference (NewLocalRef,
	 * then a null check, then NewGlobalRef), or null once the object has been
	 * collected (native-interop-ownership.md section 2.3, "Global refs"). */
	private void projectJavaWeak(string className, Map<string, string> classes, Map<string, NativeNode> declarations) {
		string simple = classes.get(className);
		string binaryName = declarations.get(className).binaryName;
		string name = "JavaWeak" + simple;
		var owner = self.projectJavaGenerated(name, "the weak reference class of " + className, classes, "jweak", "java-weak:" + binaryName);
		Vector<string> objectKind = ["object"];
		Vector<string> noKinds = [];
		Vector<Node> noParameters = [];
		self.addJavaGenerated(owner, "weak-create", "create", true, [self.javaParameter("referent", self.javaType(simple, false))], self.javaType(name, false), objectKind, "object", binaryName, "");
		self.addJavaGenerated(owner, "weak-get", "get", false, noParameters, self.javaType(simple, true), noKinds, "object", binaryName, "");
	}

	/* Constructors, methods and fields of the selected classes, by JNI
	 * descriptor. A constructor is the class method create(); a static member
	 * is a class method; a field is a getter named for it plus set<Field>
	 * unless final. A native method only a natives registration names is not
	 * callable. A member of a class whose executor is "main" checks its
	 * thread. */
	private void projectJavaMembers(NativeNode header, Map<string, string> classes, Map<string, NativeNode> declarations, Vector<string> selected, Map<string, string> executors) {
		Map<string, Map<string, string>> projected = {};
		for declaration in header.exports {
			if (declaration.kind == NNK_NATIVE_JAVA_CLASS) { continue; }
			if (declaration.kind != NNK_NATIVE_JAVA_METHOD && declaration.kind != NNK_NATIVE_JAVA_FIELD) { self.fail("Java class documents declare only classes, methods and fields"); }
			if (!selected.contains(declaration.name)) { continue; }
			string simple = classes.get(declaration.owner);
			NativeNode ownerClass = declarations.get(declaration.owner);
			var owner = self.resourceDeclaration(simple);
			if (!projected.has(simple)) {
				Map<string, string> reserved = {};
				reserved.put("close", declaration.owner + ".close");
				reserved.put("isOpen", declaration.owner + ".isOpen");
				projected.put(simple, reserved);
			}
			Map<string, string> names = projected.get(simple);
			string access = declaration.staticMember ? "class" : "public";
			string executor = executors.has(declaration.owner) ? executors.get(declaration.owner) : "";
			if (declaration.kind == NNK_NATIVE_JAVA_METHOD) {
				Vector<string> kinds = [];
				Vector<Node> parameters = [];
				for index in range(declaration.signature.parameters.len) {
					Vector<Node> projectedType = [];
					kinds.push(self.javaValue(declaration.signature.parameters.get(index), declaration.name, classes, projectedType));
					Node parameter = self.node(NK_PARAM);
					parameter.name = f"argument{index}";
					parameter.type = projectedType.get(0);
					parameters.push(parameter);
				}
				if (declaration.constructor) {
					if (ownerClass.interfaceClass || ownerClass.abstractClass) { self.fail(f"Java constructor {declaration.name} cannot create an abstract class or interface"); }
					self.addJavaMember(owner, names, declaration, ownerClass, "constructor", "create", "class", kinds, "object", self.javaType(simple, false), parameters, declaration.methodName, executor);
				} else {
					Vector<Node> returnType = [];
					string result = self.javaValue(declaration.signature.returnType, declaration.name, classes, returnType, true);
					self.addJavaMember(owner, names, declaration, ownerClass, "method", declaration.methodName, access, kinds, result, returnType.get(0), parameters, declaration.methodName, executor);
				}
				continue;
			}
			Vector<Node> valueType = [];
			string kind = self.javaValue(declaration.valueType, declaration.name, classes, valueType);
			string field = declaration.fieldName;
			Vector<string> noKinds = [];
			Vector<Node> noParameters = [];
			self.addJavaMember(owner, names, declaration, ownerClass, "getter", field, access, noKinds, kind, valueType.get(0), noParameters, field, executor);
			if (!declaration.readOnly) {
				Node parameter = self.node(NK_PARAM);
				parameter.name = "value";
				parameter.type = self.javaType(valueType.get(0).base, valueType.get(0).isNullable);
				Vector<Node> setterParameters = [parameter];
				Vector<string> setterKinds = [kind];
				string setter = "set" + field.substring(0, 1).toUpper() + field.substring(1, field.length() - 1);
				self.addJavaMember(owner, names, declaration, ownerClass, "setter", setter, access, setterKinds, "V", self.javaType("void", false), setterParameters, field, executor);
			}
		}
	}

	/* Each natives registration: its receiver interface and its registration
	 * factory (M2, R3). Every method must be one of the class's ACC_NATIVE
	 * methods and becomes the interface method of its Java name. Parameters and
	 * results project as for calls into Java; an instance method's own object
	 * reaches the receiver first, as an owner of its class. The factory takes
	 * the receiver and a CallbackScope and returns the registration
	 * (native-interop-ownership.md section 2.3, "Java -> btrc"). */
	private void projectJavaNatives(FeNativeBinding binding, NativeNode header, Map<string, string> classes, Map<string, NativeNode> declarations) {
		Map<string, NativeNode> exports = {};
		for declaration in header.exports { exports.put(declaration.name, declaration); }
		for natives in binding.javaNatives {
			if (!classes.has(natives.className)) { self.fail(f"Java natives {natives.className} require a class the reader reports"); }
			string simple = classes.get(natives.className);
			NativeNode ownerClass = declarations.get(natives.className);
			var projection = FeNativeJavaNatives(simple, ownerClass.binaryName, natives.className, natives.handler, natives.failure);
			projection.executor = natives.executor;
			Node handler = self.node(NK_INTERFACE_DECL); handler.name = natives.handler;
			Map<string, string> names = {};
			string identities = "";
			for method in natives.methods {
				string symbol = natives.className + "." + method;
				if (!exports.has(symbol) || exports.get(symbol).kind != NNK_NATIVE_JAVA_METHOD || exports.get(symbol).constructor) { self.fail(f"Java natives method {symbol} is not a method the reader reports"); }
				NativeNode declaration = exports.get(symbol);
				if (!declaration.nativeMethod) { self.fail(f"Java RegisterNatives target {symbol} is not ACC_NATIVE"); }
				Vector<int> writable = [];
				for entry in natives.writableArrays {
					int split = entry.lastIndexOf(".argument");
					if (entry.substring(0, split) == method) { writable.push(Strings.toInt(entry.substring(split + 9, entry.length() - split - 9))); }
				}
				writable.sortBy((int left, int right) => left < right);
				Vector<string> kinds = [];
				Vector<Node> parameters = [];
				for index in range(declaration.signature.parameters.len) {
					Vector<Node> projectedType = [];
					kinds.push(self.javaValue(declaration.signature.parameters.get(index), symbol, classes, projectedType, false, writable.contains(index) ? 1 : 0));
					Node parameter = self.node(NK_PARAM);
					parameter.name = f"argument{index}";
					parameter.type = projectedType.get(0);
					parameters.push(parameter);
				}
				for position in writable {
					if (position >= kinds.len || !kinds.get(position).startsWith("[")) { self.fail(f"Java natives {symbol}: argument{position} is not a primitive array parameter, so writable-arrays cannot name it"); }
				}
				Vector<Node> returnType = [];
				string result = self.javaValue(declaration.signature.returnType, symbol, classes, returnType, true);
				string name = declaration.methodName;
				if (names.has(name)) { self.fail(f"Java natives {names.get(name)} and {symbol} project to the same BTRC name {name}"); }
				names.put(name, symbol);
				Node member = self.node(NK_METHOD_SIG); member.name = name;
				if (!declaration.staticMember) {
					Node instance = self.node(NK_PARAM);
					instance.name = "instance";
					instance.type = self.javaType(simple, false);
					member.paramsMut().push(instance);
				}
				for parameter in parameters { member.paramsMut().push(parameter); }
				member.returnType = returnType.get(0);
				handler.methodsMut().push(member);
				var native = FeNativeJavaNative(name, declaration.descriptor, declaration.identity, declaration.staticMember, kinds, result);
				native.writable = writable;
				projection.methods.push(native);
				identities = identities + ";" + declaration.identity;
			}
			self.add(natives.handler, handler, "java-natives:" + ownerClass.identity + identities);
			Node voidResult = self.node(NK_TYPE_EXPR); voidResult.base = "void";
			Node voidPointer = self.node(NK_TYPE_EXPR); voidPointer.base = "void"; voidPointer.pointerDepth = 1;
			/* CFunction<void, void*>, in the parser's exact callback spelling. */
			Node destroyType = self.node(NK_TYPE_EXPR); destroyType.base = "__fn_ptr"; destroyType.genericArgsStorage = [voidResult, voidPointer];
			Node token = self.node(NK_TYPE_EXPR); token.base = "OwnedClosure"; token.genericArgsStorage = [destroyType];
			Node receiver = self.node(NK_TYPE_EXPR); receiver.base = natives.handler;
			Node factory = self.node(NK_FUNCTION_DECL); factory.name = natives.name;
			factory.returnType = self.node(NK_TYPE_EXPR); factory.returnType.base = "CallbackContext"; factory.returnType.genericArgsStorage = [receiver, token];
			var contract = FeNativeCallContract(); contract.nonnullReturn = true; contract.javaNatives = projection;
			Vector<string> parameterNames = ["receiver", "scope"];
			Vector<string> parameterTypes = [natives.handler, "CallbackScope"];
			for index in range(2) {
				Node parameter = self.node(NK_PARAM); parameter.name = parameterNames.get(index);
				parameter.type = self.node(NK_TYPE_EXPR); parameter.type.base = parameterTypes.get(index);
				factory.paramsMut().push(parameter);
				contract.nonnullParameters.push(true); contract.readOnlyBorrows.push(false); contract.resourceParameters.push(""); contract.recordInputs.push(null);
			}
			self.add(natives.name, factory, "java-natives-factory:" + ownerClass.identity, "", false, contract);
		}
	}

	/* Every Java binding's classes, then their members, so one binding's
	 * member may use another's class. */
	private void completeJavaBindings(string target) {
		Map<string, string> classes = {};
		Map<string, NativeNode> declarations = {};
		Map<string, string> simpleNames = {};
		Vector<NativeNode> documents = [];
		string priorModule = self.module;
		string priorHeader = self.header;
		string priorLanguage = self.language;
		self.language = "java";
		self.header = self.javaRuntimeHeader;
		self.javaArrays = {};
		Map<string, string> executors = {};
		for binding in self.pendingJavaBindings {
			for options in binding.javaClasses { executors.put(options.className, options.executor); }
		}
		for index in range(self.pendingJavaBindings.len) {
			self.module = self.pendingJavaBindings.get(index).module;
			NativeNode document = FeNativeHeaderCodec().decode(self.pendingJavaResponses.get(index), target);
			documents.push(document);
			self.projectJavaClasses(document, classes, declarations, simpleNames);
		}

		for index in range(documents.len) {
			self.module = self.pendingJavaBindings.get(index).module;
			for options in self.pendingJavaBindings.get(index).javaClasses {
				if (options.weak) { self.projectJavaWeak(options.className, classes, declarations); }
			}
		}

		for index in range(documents.len) {
			self.module = self.pendingJavaBindings.get(index).module;
			self.projectJavaMembers(documents.get(index), classes, declarations, self.pendingJavaBindings.get(index).symbols, executors);
		}

		for index in range(documents.len) {
			self.module = self.pendingJavaBindings.get(index).module;
			self.projectJavaNatives(self.pendingJavaBindings.get(index), documents.get(index), classes, declarations);
		}
		self.pendingJavaBindings = [];
		self.pendingJavaResponses = [];
		self.module = priorModule;
		self.header = priorHeader;
		self.language = priorLanguage;
	}

	/* The prepared bindings' declarations, decoded and imported once. */
	public Vector<FeNativeImportedDeclaration> complete() {
		Vector<FeNativeBinding> bindings = self.pendingBindings;
		if (bindings.len == 0 && self.pendingJavaBindings.len == 0) { return self.declarations; }
		self.pendingBindings = [];
		string target = self.pendingTarget;
		for index in range(bindings.len) {
			var binding = bindings.get(index);
			self.staticGlobals = {};
			for name in binding.staticGlobals { self.staticGlobals.put(name, true); }
			self.borrows = {};
			self.realtime = {};
			for name in binding.realtimeSafe { self.realtime.put(name, true); }
			for borrow in binding.readOnlyBorrows { self.borrows.put(borrow, true); }
			self.module = binding.module;
			self.header = binding.header;
			self.language = binding.language;
			if (self.language != "c" && self.language != "objective-c" && self.language != "c++") { self.fail("Objective-C++ call adapters are not implemented"); }
			if (self.headerReader == null) { self.fail("SDK header scanning is unavailable in this compiler host build"); }
			NativeNode decoded = FeNativeHeaderCodec().decode(self.pendingResponses.get(index), target);
			self.callbackExports = {};
			for declaration in decoded.exports { self.callbackExports.put(declaration.name, declaration); }
			self.bindingOperations = {};
			self.unmanagedHandles = {};
			if (self.language == "c++") { self.importCxxBinding(binding, decoded); continue; }
			self.prepareResources(binding, decoded);
			self.prepareUnmanagedHandles(binding);
			self.prepareResourceConversions(binding, decoded);
			self.callbacks = {};
			self.mainThreadGlobals = {};
			for name in binding.mainThreadGlobals { self.mainThreadGlobals.put(name, true); }
			for key in binding.callbacks.keys() { self.callbacks.put(key, binding.callbacks.get(key)); }
			self.errorOutputs = {};
			for name in binding.errorOutputs { self.errorOutputs.put(name, true); }
			self.mergeInterfaces(decoded.interfaces);
			self.layouts = {};
			for layout in decoded.records {
				string identity = self.layoutIdentity(layout);
				if (self.layoutIdentities.has(layout.identity) && !self.layoutIdentities.get(layout.identity).equals(identity)) { self.fail(f"conflicting native layout '{layout.name}'"); }
				self.layoutIdentities.put(layout.identity, identity);
				self.layouts.put(layout.identity, layout);
			}
			self.prepareRecordFields(binding);
			self.prepareStringViews(binding);
			for declaration in decoded.exports { self.importDeclaration(declaration); }
			self.projectRealtimeCallbacks(binding);
			self.projectCallbackTables(binding);
			self.projectComInterfaces(binding);
			self.projectDispatchTables(binding);
			self.projectComSinks(binding);
			self.projectRecordSnapshots(binding);
			if (self.statusResults.len > 0) { self.fail("status-results names an unknown dispatched method"); }
			if (self.copiedOutputs.len > 0) { self.fail("copied-outputs names an unknown dispatched method parameter"); }
			for key in self.errorOutputs.keys() { self.fail(f"error-outputs names an unknown Objective-C method parameter: {key}"); }
			if (self.borrows.len > 0) { self.fail("read-only-borrows names unknown function parameter"); }
			if (self.realtime.len > 0) { self.fail("realtime-safe names a non-function declaration"); }
			if (self.variadicCalls.len > 0) { self.fail("variadic-calls names an unknown function or parameter"); }
			if (self.ownedResults.len > 0 || self.resourceBorrows.len > 0 || self.borrowedResults.len > 0 || self.ownedOutputs.len > 0 || self.outputOffsets.len > 0 || self.copiedResults.len > 0 || self.initializers.len > 0 || self.copiedInputs.len > 0) { self.fail("resource ownership names an unknown or non-resource result/parameter"); }
			if (self.staticGlobals.len > 0) { self.fail("static-globals names a non-resource-global declaration"); }
			if (self.resourceParameters.len > 0 || self.resourceResults.len > 0) { self.fail("resource projections name an unknown native position"); }
			if (self.callbacks.len > 0) { self.fail("callbacks names an unknown function parameter"); }
			if (self.mainThreadGlobals.len > 0) { self.fail("main-thread-globals names a non-object-global declaration"); }
			for identity in self.stringViews.keys() { if (!self.usedStringViews.has(identity)) { self.fail("string-views requires a mapped C one-shot callback argument"); } }
		}
		self.pendingResponses = [];
		if (self.pendingJavaBindings.len > 0) { self.completeJavaBindings(target); }
		BtrccPhaseTimer.mark("n-import");
		for imported in self.declarations { if (self.resourceOperations.has(imported.declaration.name)) { self.fail("resource lifetime operations are reserved across native bindings"); } }
		for handle in self.unmanagedOwners.keys() {
			for imported in self.declarations {
				if (imported.declaration.kind == NK_CLASS_DECL && imported.declaration.name == handle && imported.resource != null) { self.fail(f"unmanaged handle '{handle}' is a managed resource in {imported.module}"); }
			}
		}
		self.projectRecordInputs(bindings);
		self.validateRecordCallbacks();
		self.coalesce();
		/* One handle has one release program-wide; every import of its typedef
		 * carries the mark the analyzer admits calls by. */
		for imported in self.declarations {
			if (imported.declaration.kind == NK_TYPEDEF_DECL && self.unmanagedOwners.has(imported.declaration.alias)) { imported.unmanagedRelease = self.unmanagedOwners.get(imported.declaration.alias); }
		}
		self.validateSelectorStorage();
		self.declarations.extend(self.inputClasses);
		return self.declarations;
	}
}

class FeNativeHeaderCodec {
	private void fail(string message) { throw f"native header: {message}"; }

	private NativeNode node(int kind) {
		var result = NativeNode();
		result.kind = kind;
		return result;
	}

	private void fields(JSONValue value, string required, string optional = "") {
		if (!value.isObject()) { self.fail("expected native object"); }
		var requiredNames = Strings.split(required, ",");
		var optionalNames = Strings.split(optional, ",");
		for name in requiredNames {
			if (!name.isEmpty() && !value.has(name)) { self.fail(f"missing field '{name}'"); }
		}
		for name in value.keys() {
			if (!requiredNames.contains(name) && !optionalNames.contains(name)) { self.fail(f"unexpected field '{name}'"); }
		}
	}

	private string text(JSONValue value, bool empty = false) {
		if (!value.isString() || (!empty && value.asString().isEmpty())) { self.fail("expected native text"); }
		return value.asString();
	}

	private bool boolean(JSONValue value) {
		if (!value.isBool()) { self.fail("expected native boolean"); }
		return value.asBool();
	}

	private int integer(JSONValue value) {
		if (!value.isInt() || value.asFloat() < 0.0 || value.asFloat() > 2147483647.0) { self.fail("expected nonnegative native int32"); }
		return value.asInt();
	}

	private string decimal(JSONValue value, bool signedValue = false) {
		string result = self.text(value);
		int start = signedValue && result.startsWith("-") ? 1 : 0;
		if (start == result.length() || (result[start] == '0' && (start != 0 || result.length() != 1))) { self.fail("expected canonical native decimal text"); }
		for index in range(start, result.length()) {
			if (!Strings.isDigit(result[index])) { self.fail("expected canonical native decimal text"); }
		}
		return result;
	}

	private unsigned long long layoutInteger(string value) {
		unsigned long long result = 0ULL;
		for index in range(value.length()) {
			unsigned long long digit = (unsigned long long)(value[index] - '0');
			if (result > (18446744073709551615ULL - digit) / 10ULL) { self.fail("native layout exceeds uint64"); }
			result = result * 10ULL + digit;
		}
		return result;
	}

	private Vector<JSONValue> array(JSONValue value) {
		if (!value.isArray()) { self.fail("expected native array"); }
		return value.elements();
	}

	/* The reader reports every calling convention by name; the importer, not
	 * the codec, decides which ones it has qualified. */
	private string convention(JSONValue value) {
		string result = self.text(value);
		bool spelled = result.length() > 0 && result[0] >= 'a' && result[0] <= 'z';
		for index in range(result.length()) {
			char character = result[index];
			if (!((character >= 'a' && character <= 'z') || (character >= '0' && character <= '9') || character == '_')) { spelled = false; }
		}
		if (!spelled) { self.fail(f"unsupported native calling convention spelling: {result}"); }
		return result;
	}

	private NativeNode parameterSemantics(JSONValue parameter) {
		self.fields(parameter, "name,cf_consumed,ns_consumed,no_escape");
		var semantics = self.node(NNK_NATIVE_PARAMETER_SEMANTICS);
		semantics.name = self.text(parameter.get("name"), true);
		semantics.cfConsumed = self.boolean(parameter.get("cf_consumed"));
		semantics.nsConsumed = self.boolean(parameter.get("ns_consumed"));
		semantics.noEscape = self.boolean(parameter.get("no_escape"));
		return semantics;
	}

	/* The function a field's type points to, through aliases and qualifiers. */
	private NativeNode? callbackSignature(NativeNode native) {
		while (native.kind == NNK_NATIVE_ALIAS || native.kind == NNK_NATIVE_QUALIFIED_TYPE) { native = native.underlying; }
		if (native.kind != NNK_NATIVE_POINTER) { return null; }
		NativeNode pointee = native.pointee;
		while (pointee.kind == NNK_NATIVE_ALIAS || pointee.kind == NNK_NATIVE_QUALIFIED_TYPE) { pointee = pointee.underlying; }
		return pointee.kind == NNK_NATIVE_FUNCTION_TYPE ? pointee : null;
	}

	private string choice(JSONValue value, string choices) {
		string result = self.text(value);
		if (!Strings.split(choices, ",").contains(result)) { self.fail(f"unsupported native semantic value '{result}'"); }
		return result;
	}

	private NativeNode qualifiers(JSONValue value) {
		var result = self.node(NNK_NATIVE_QUALIFIERS);
		result.isConst = self.boolean(value.get("const"));
		result.isVolatile = self.boolean(value.get("volatile"));
		result.isRestrict = self.boolean(value.get("restrict"));
		result.nullability = self.choice(value.get("nullability"), "unannotated,nonnull,nullable,nullable_result,unspecified");
		return result;
	}

	private NativeNode type(JSONValue value) {
		string kind = self.text(value.get("kind"));
		string common = "kind,const,volatile,restrict,nullability";
		var result = NativeNode();
		result.qualifiers = self.qualifiers(value);
		if (kind.equals("builtin")) {
			self.fields(value, common + ",name", "bits,alignment_bits,signed");
			result.kind = NNK_NATIVE_BUILTIN;
			result.name = self.text(value.get("name"));
			result.signedness = "not_integer";
			if (result.name.equals("void")) {
				if (value.has("bits") || value.has("alignment_bits") || value.has("signed")) { self.fail("void must not have native storage or signedness"); }
			} else {
				result.bits = self.integer(value.get("bits"));
				result.alignmentBitsInt = self.integer(value.get("alignment_bits"));
				if (result.bits == 0 || result.alignmentBitsInt == 0) { self.fail("native scalar storage must be positive"); }
				if (value.has("signed")) { result.signedness = self.boolean(value.get("signed")) ? "signed" : "unsigned"; }
			}
		} else if (kind.equals("pointer")) {
			self.fields(value, common + ",pointee");
			result.kind = NNK_NATIVE_POINTER;
			result.pointee = self.type(value.get("pointee"));
		} else if (kind.equals("typedef")) {
			self.fields(value, common + ",name,underlying");
			result.kind = NNK_NATIVE_ALIAS;
			result.name = self.text(value.get("name"));
			result.underlying = self.type(value.get("underlying"));
		} else if (kind.equals("record")) {
			self.fields(value, common + ",name,tag_name,identity,record_kind,complete,opaque");
			result.kind = NNK_NATIVE_RECORD_TYPE;
			result.recordKind = self.choice(value.get("record_kind"), "struct,union");
			result.tagName = self.text(value.get("tag_name"), true);
			result.name = self.text(value.get("name"), true);
			result.identity = self.text(value.get("identity"));
			result.complete = self.boolean(value.get("complete"));
			result.opaque = self.boolean(value.get("opaque"));
			if (!result.opaque && !result.complete) { self.fail("incomplete native record used by value"); }
		} else if (kind.equals("enum")) {
			self.fields(value, common + ",name,identity,underlying");
			result.kind = NNK_NATIVE_ENUM_TYPE;
			result.name = self.text(value.get("name"), true);
			result.identity = self.text(value.get("identity"));
			result.underlying = self.type(value.get("underlying"));
		} else if (kind.equals("function")) {
			self.fields(value, common + ",return_type,parameters,variadic,calling_convention");
			result.kind = NNK_NATIVE_FUNCTION_TYPE;
			result.returnType = self.type(value.get("return_type"));
			for parameter in self.array(value.get("parameters")) { result.parameters.push(self.type(parameter)); }
			result.variadic = self.boolean(value.get("variadic"));
			result.callingConvention = self.convention(value.get("calling_convention"));
		} else if (kind.equals("array")) {
			self.fields(value, common + ",element,count");
			result.kind = NNK_NATIVE_ARRAY_TYPE;
			result.element = self.type(value.get("element"));
			if (!value.get("count").isNull()) { result.count = self.decimal(value.get("count")); }
		} else if (kind.equals("qualified")) {
			self.fields(value, common + ",underlying");
			result.kind = NNK_NATIVE_QUALIFIED_TYPE;
			result.underlying = self.type(value.get("underlying"));
		} else if (kind.equals("objc_object")) {
			self.fields(value, common + ",name,identity,class_object,protocols,type_arguments");
			result.kind = NNK_NATIVE_OBJECTIVE_C_OBJECT;
			result.name = self.text(value.get("name"), true);
			result.identity = self.text(value.get("identity"), true);
			if (result.name.isEmpty() != result.identity.isEmpty()) { self.fail("Objective-C interface name and identity must agree"); }
			result.classObject = self.boolean(value.get("class_object"));
			for protocol in self.array(value.get("protocols")) {
				string name = self.text(protocol);
				if (result.protocols.contains(name)) { self.fail("duplicate Objective-C protocol"); }
				result.protocols.push(name);
			}
			for argument in self.array(value.get("type_arguments")) { result.typeArguments.push(self.type(argument)); }
		} else if (kind.equals("objc_block")) {
			self.fields(value, common + ",signature");
			result.kind = NNK_NATIVE_OBJECTIVE_C_BLOCK;
			result.signature = self.type(value.get("signature"));
			NativeNode signatureType = result.signature;
			while (signatureType.kind == NNK_NATIVE_ALIAS || signatureType.kind == NNK_NATIVE_QUALIFIED_TYPE) { signatureType = signatureType.underlying; }
			if (signatureType.kind != NNK_NATIVE_FUNCTION_TYPE) { self.fail("Objective-C block requires a function signature"); }
		} else if (kind.equals("java_object")) {
			self.fields(value, common + ",name,binary_name");
			result.kind = NNK_NATIVE_JAVA_OBJECT;
			result.name = self.text(value.get("name"));
			result.binaryName = self.text(value.get("binary_name"));
			if (result.binaryName != result.name.replace(".", "/")) { self.fail("Java object name does not match its binary name"); }
		} else if (kind.equals("java_array")) {
			self.fields(value, common + ",element");
			result.kind = NNK_NATIVE_JAVA_ARRAY;
			result.element = self.type(value.get("element"));
		} else { self.fail(f"unsupported native type '{kind}'"); }
		return result;
	}

	private NativeNode declaration(JSONValue value) {
		string kind = self.text(value.get("kind"));
		string required = "kind,name,type";
		if (kind.equals("function")) { required = required + ",link_name,returned_ownership,parameter_semantics"; }
		else if (kind.equals("cxx_class")) { required = required + ",default_constructor,public_destructor,trivially_copyable,trivially_destructible"; }
		else if (kind.equals("cxx_method")) { required = required + ",identity,owner,receiver,method_name,parameter_semantics,const_method"; }
		else if (kind.equals("objc_method")) { required = required + ",identity,owner,receiver,selector,class_method,returned_ownership,parameter_semantics,method_family,consumes_self,related_result,returns_inner_pointer"; }
		else if (kind.equals("pointer_constant")) { required = required + ",pointer_bits,value"; }
		else if (kind.equals("enum_constant") || kind.equals("string_constant")) { required = required + ",value"; }
		else if (kind.equals("global")) { required = required + ",read_only"; }
		else if (kind.equals("java_class")) { required = required + ",identity,binary_name,super_name,super_interfaces,interface_class,abstract_class,complete"; }
		else if (kind.equals("java_method")) { required = required + ",identity,owner,method_name,descriptor,static_member,constructor,native_method"; }
		else if (kind.equals("java_field")) { required = required + ",identity,owner,field_name,descriptor,static_member,read_only"; }
		else if (!kind.equals("typedef") && !kind.equals("record")) { self.fail(f"unsupported native declaration '{kind}'"); }
		self.fields(value, required, kind.equals("objc_method") ? "source,line,column,protocol_owner,optional,designated_initializer,requires_super" : (kind.equals("enum_constant") ? "source,line,column,enum_identity" : "source,line,column"));
		var result = NativeNode();
		result.name = self.text(value.get("name"));
		if (value.has("source")) { result.sourceFile = self.text(value.get("source"), true); }
		if (value.has("line")) { result.line = self.integer(value.get("line")); }
		if (value.has("column")) { result.column = self.integer(value.get("column")); }
		NativeNode nativeType = self.type(value.get("type"));
		if (kind.startsWith("java_")) {
			self.javaDeclaration(kind, value, result, nativeType);
			return result;
		}
		if (kind.equals("cxx_class")) {
			if (nativeType.kind != NNK_NATIVE_RECORD_TYPE || !nativeType.complete || nativeType.name != result.name) { self.fail("C++ class requires its complete SDK record identity"); }
			result.kind = NNK_NATIVE_CXX_CLASS; result.recordType = nativeType;
			result.defaultConstructor = self.boolean(value.get("default_constructor"));
			result.publicDestructor = self.boolean(value.get("public_destructor"));
			result.triviallyCopyable = self.boolean(value.get("trivially_copyable"));
			result.triviallyDestructible = self.boolean(value.get("trivially_destructible"));
		} else if (kind.equals("function") || kind.equals("objc_method") || kind.equals("cxx_method")) {
			result.kind = kind.equals("function") ? NNK_NATIVE_FUNCTION : NNK_NATIVE_OBJECTIVE_C_METHOD;
			result.signature = nativeType;
			if (kind.equals("function")) { result.linkName = self.text(value.get("link_name")); }
			if (!kind.equals("cxx_method")) { result.returnedOwnership = self.choice(value.get("returned_ownership"), "unspecified,cf_retained,cf_not_retained,ns_retained,ns_not_retained,ns_autoreleased"); }
			for parameter in self.array(value.get("parameter_semantics")) { result.parameterSemantics.push(self.parameterSemantics(parameter)); }
			if (nativeType.kind != NNK_NATIVE_FUNCTION_TYPE || result.parameterSemantics.len != nativeType.parameters.len) { self.fail("native function semantics do not match its signature"); }
			if (kind.equals("cxx_method")) {
				result.kind = NNK_NATIVE_CXX_METHOD;
				result.identity = self.text(value.get("identity")); result.owner = self.text(value.get("owner"));
				result.receiver = self.text(value.get("receiver")); result.methodName = self.text(value.get("method_name"));
				result.constMethod = self.boolean(value.get("const_method"));
				bool identifier = !result.methodName.isEmpty();
				int index = 0;
				for character in result.methodName {
					if (!((character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z') || character == '_' || (index > 0 && character >= '0' && character <= '9'))) { identifier = false; }
					index++;
				}
				if ((result.name != f"{result.receiver}::{result.methodName}" && result.name != f"{result.receiver}::{result.methodName}()") || !identifier || nativeType.variadic || (result.name.endsWith("()") && result.parameterSemantics.len > 0)) { self.fail("C++ method must match its receiver and fixed signature"); }
			}
			if (kind.equals("objc_method")) {
				result.identity = self.text(value.get("identity"));
				result.owner = self.text(value.get("owner"));
				result.receiver = self.text(value.get("receiver"));
				result.selector = self.text(value.get("selector"));
				result.classMethod = self.boolean(value.get("class_method"));
				if (value.has("protocol_owner")) { result.protocolOwner = self.boolean(value.get("protocol_owner")); }
				if (value.has("optional")) { result.optional = self.boolean(value.get("optional")); }
				if (result.optional && !result.protocolOwner) { self.fail("optional Objective-C method requires a protocol owner"); }
				/* Step 6's override facts (native-interop-ownership.md section 3). */
				if (value.has("designated_initializer")) { result.designatedInitializer = self.boolean(value.get("designated_initializer")); }
				if (value.has("requires_super")) { result.requiresSuper = self.boolean(value.get("requires_super")); }
				if (result.designatedInitializer && (result.classMethod || result.protocolOwner || self.text(value.get("method_family")) != "init")) { self.fail("Objective-C designated initializer requires an instance init method"); }
				string prefix = result.classMethod ? "+" : "-";
				int arguments = 0;
				for character in result.selector { if (character == ':') { arguments++; } }
				if (!result.name.equals(f"{prefix}[{result.receiver} {result.selector}]") || arguments != result.parameterSemantics.len) { self.fail("Objective-C selector does not match its receiver or signature"); }
				result.methodFamily = self.choice(value.get("method_family"), "none,alloc,init,initialize,copy,mutable_copy,new,autorelease,dealloc,finalize,release,retain,retain_count,self,perform_selector");
				result.consumesSelf = self.boolean(value.get("consumes_self"));
				result.relatedResult = self.boolean(value.get("related_result"));
				result.returnsInnerPointer = self.boolean(value.get("returns_inner_pointer"));
			}
		} else if (kind.equals("typedef")) {
			result.kind = NNK_NATIVE_TYPEDEF;
			result.underlying = nativeType;
		} else if (kind.equals("global")) {
			result.kind = NNK_NATIVE_GLOBAL;
			result.valueType = nativeType;
			result.readOnly = self.boolean(value.get("read_only"));
		} else if (kind.equals("pointer_constant")) {
			NativeNode pointer = nativeType;
			while (pointer.kind == NNK_NATIVE_ALIAS || pointer.kind == NNK_NATIVE_QUALIFIED_TYPE) { pointer = pointer.underlying; }
			if (pointer.kind != NNK_NATIVE_POINTER) { self.fail("native pointer constant requires an object or void pointer"); }
			NativeNode pointee = pointer.pointee;
			while (pointee.kind == NNK_NATIVE_ALIAS || pointee.kind == NNK_NATIVE_QUALIFIED_TYPE) { pointee = pointee.underlying; }
			if (pointee.kind == NNK_NATIVE_FUNCTION_TYPE || pointee.kind == NNK_NATIVE_OBJECTIVE_C_OBJECT || pointee.kind == NNK_NATIVE_OBJECTIVE_C_BLOCK) { self.fail("native pointer constant requires an object or void pointer"); }
			result.kind = NNK_NATIVE_POINTER_CONSTANT;
			result.valueType = nativeType;
			result.pointerBits = self.integer(value.get("pointer_bits"));
			result.decimalValue = self.decimal(value.get("value"));
			if (result.pointerBits != 32 && result.pointerBits != 64) { self.fail("native pointer constant value exceeds its supported target width"); }
			string maximum = result.pointerBits == 32 ? "4294967295" : "18446744073709551615";
			if (result.decimalValue.length() > maximum.length() || (result.decimalValue.length() == maximum.length() && Strings.lessThan(maximum, result.decimalValue))) { self.fail("native pointer constant value exceeds its supported target width"); }
		} else if (kind.equals("string_constant")) {
			result.kind = NNK_NATIVE_STRING_CONSTANT;
			result.valueType = nativeType;
			result.stringValue = self.text(value.get("value"), true);
		} else if (kind.equals("enum_constant")) {
			result.kind = NNK_NATIVE_CONSTANT;
			result.valueType = nativeType;
			result.decimalValue = self.decimal(value.get("value"), true);
			if (value.has("enum_identity")) { result.enumIdentity = self.text(value.get("enum_identity"), true); }
		} else {
			result.kind = NNK_NATIVE_RECORD_DECLARATION;
			result.recordType = nativeType;
		}
		return result;
	}

	private NativeNode record(JSONValue value) {
		self.fields(value, "identity,name,kind,size_bits,alignment_bits,fields", "transparent_union");
		var result = self.node(NNK_NATIVE_RECORD_LAYOUT);
		result.identity = self.text(value.get("identity"));
		result.name = self.text(value.get("name"), true);
		result.recordKind = self.choice(value.get("kind"), "struct,union");
		result.sizeBits = self.decimal(value.get("size_bits"));
		result.alignmentBitsString = self.decimal(value.get("alignment_bits"));
		unsigned long long size = self.layoutInteger(result.sizeBits);
		if (self.layoutInteger(result.alignmentBitsString) == 0ULL) { self.fail("native record alignment must be positive"); }
		for entry in self.array(value.get("fields")) {
			self.fields(entry, "name,type,offset_bits,anonymous,callback_parameters", "width_bits");
			var field = self.node(NNK_NATIVE_FIELD);
			field.name = self.text(entry.get("name"), true);
			field.fieldType = self.type(entry.get("type"));
			for parameter in self.array(entry.get("callback_parameters")) { field.callbackParameters.push(self.parameterSemantics(parameter)); }
			NativeNode? slotSignature = self.callbackSignature(field.fieldType);
			int slotCount = slotSignature == null ? 0 : slotSignature.parameters.len;
			if (field.callbackParameters.len != slotCount) { self.fail("native callback parameters do not match the field's function type"); }
			field.offsetBits = self.decimal(entry.get("offset_bits"));
			field.isAnonymous = self.boolean(entry.get("anonymous"));
			field.isBitfield = entry.has("width_bits");
			field.widthBits = field.isBitfield ? self.decimal(entry.get("width_bits")) : "0";
			unsigned long long offset = self.layoutInteger(field.offsetBits);
			unsigned long long width = self.layoutInteger(field.widthBits);
			if (offset > size || width > size - offset) { self.fail("native field extends beyond its record"); }
			result.fields.push(field);
		}
		// Present only on a GNU transparent union, and then only as true.
		result.transparentUnion = value.has("transparent_union");
		if (result.transparentUnion && (!self.boolean(value.get("transparent_union")) || result.recordKind != "union" || result.fields.len == 0)) { self.fail("a transparent native record must be a union with members"); }
		return result;
	}

	/* A class-file declaration: its identity is a JVM descriptor or the smali
	 * member form Lpkg/C;->name(D)R. */
	private void javaDeclaration(string kind, JSONValue value, NativeNode result, NativeNode nativeType) {
		if (kind.equals("java_class")) {
			result.kind = NNK_NATIVE_JAVA_CLASS;
			result.identity = self.text(value.get("identity"));
			result.binaryName = self.text(value.get("binary_name"));
			if (!value.get("super_name").isNull()) { result.superName = self.text(value.get("super_name")); }
			for entry in self.array(value.get("super_interfaces")) { result.superInterfaces.push(self.text(entry)); }
			result.interfaceClass = self.boolean(value.get("interface_class"));
			result.abstractClass = self.boolean(value.get("abstract_class"));
			result.complete = self.boolean(value.get("complete"));
			if (nativeType.kind != NNK_NATIVE_JAVA_OBJECT || nativeType.name != result.name || nativeType.binaryName != result.binaryName || result.identity != "L" + result.binaryName + ";") { self.fail("Java class must match its own object type and descriptor"); }
			return;
		}
		result.identity = self.text(value.get("identity"));
		result.owner = self.text(value.get("owner"));
		result.descriptor = self.text(value.get("descriptor"));
		string ownerPath = result.owner.replace(".", "/");
		if (kind.equals("java_method")) {
			result.kind = NNK_NATIVE_JAVA_METHOD;
			result.methodName = self.text(value.get("method_name"));
			result.signature = nativeType;
			result.staticMember = self.boolean(value.get("static_member"));
			result.constructor = self.boolean(value.get("constructor"));
			result.nativeMethod = self.boolean(value.get("native_method"));
			if (nativeType.kind != NNK_NATIVE_FUNCTION_TYPE || nativeType.callingConvention != "java" || nativeType.variadic || !result.descriptor.startsWith("(") || result.name != result.owner + "." + result.methodName + result.descriptor || result.identity != "L" + ownerPath + ";->" + result.methodName + result.descriptor || result.constructor != (result.methodName == "<init>")) { self.fail("Java method must match its owner, descriptor and signature"); }
			return;
		}
		result.kind = NNK_NATIVE_JAVA_FIELD;
		result.fieldName = self.text(value.get("field_name"));
		result.valueType = nativeType;
		result.staticMember = self.boolean(value.get("static_member"));
		result.readOnly = self.boolean(value.get("read_only"));
		if (nativeType.kind == NNK_NATIVE_FUNCTION_TYPE || result.name != result.owner + "." + result.fieldName + ":" + result.descriptor || result.identity != "L" + ownerPath + ";->" + result.fieldName + ":" + result.descriptor) { self.fail("Java field must match its owner and descriptor"); }
	}

	private void verifyLayoutReferences(NativeNode nativeType, Map<string, bool> layouts) {
		if (nativeType.kind == NNK_NATIVE_RECORD_TYPE) {
			if (!nativeType.opaque && !layouts.has(nativeType.identity)) { self.fail("native record layout is missing"); }
		} else if (nativeType.kind == NNK_NATIVE_ALIAS || nativeType.kind == NNK_NATIVE_QUALIFIED_TYPE || nativeType.kind == NNK_NATIVE_ENUM_TYPE) {
			self.verifyLayoutReferences(nativeType.underlying, layouts);
		} else if (nativeType.kind == NNK_NATIVE_POINTER) {
			self.verifyLayoutReferences(nativeType.pointee, layouts);
		} else if (nativeType.kind == NNK_NATIVE_ARRAY_TYPE) {
			self.verifyLayoutReferences(nativeType.element, layouts);
		} else if (nativeType.kind == NNK_NATIVE_FUNCTION_TYPE) {
			self.verifyLayoutReferences(nativeType.returnType, layouts);
			for parameter in nativeType.parameters { self.verifyLayoutReferences(parameter, layouts); }
		} else if (nativeType.kind == NNK_NATIVE_OBJECTIVE_C_OBJECT) {
			for argument in nativeType.typeArguments { self.verifyLayoutReferences(argument, layouts); }
		} else if (nativeType.kind == NNK_NATIVE_JAVA_ARRAY) {
			self.verifyLayoutReferences(nativeType.element, layouts);
		} else if (nativeType.kind == NNK_NATIVE_OBJECTIVE_C_BLOCK) {
			self.verifyLayoutReferences(nativeType.signature, layouts);
		}
	}

	private NativeNode interfaceDeclaration(JSONValue value) {
		self.fields(value, "name,identity,complete,superclass");
		var result = self.node(NNK_NATIVE_OBJECTIVE_C_INTERFACE);
		result.name = self.text(value.get("name"));
		result.identity = self.text(value.get("identity"));
		result.complete = self.boolean(value.get("complete"));
		result.superclass = self.text(value.get("superclass"), true);
		if (!result.complete && !result.superclass.isEmpty()) { self.fail("incomplete Objective-C interface has a superclass"); }
		return result;
	}

	private void verifyInterfaces(Vector<NativeNode> interfaces) {
		Map<string, NativeNode> byIdentity = {};
		Map<string, bool> names = {};
		for entry in interfaces {
			if (byIdentity.has(entry.identity) || names.has(entry.name)) { self.fail("duplicate Objective-C interface name or identity"); }
			byIdentity.put(entry.identity, entry);
			names.put(entry.name, true);
		}
		for entry in interfaces {
			Map<string, bool> visited = {};
			visited.put(entry.identity, true);
			string parent = entry.superclass;
			while (!parent.isEmpty()) {
				if (!byIdentity.has(parent)) { self.fail("missing Objective-C superclass declaration"); }
				if (visited.has(parent)) { self.fail("cyclic Objective-C inheritance"); }
				visited.put(parent, true);
				NativeNode ancestor = byIdentity.get(parent);
				if (!ancestor.complete) { self.fail("incomplete Objective-C superclass declaration"); }
				parent = ancestor.superclass;
			}
		}
	}

	private JSONValue document(string source) {
		/* Library.JSON strings are NUL-terminated. Reject an escaped NUL before it can disappear. */
		int length = source.length();
		for index in range(length) {
			if (source[index] == '\\') {
				if (length - index > 5 && source[index + 1] == 'u' && source[index + 2] == '0' && source[index + 3] == '0' && source[index + 4] == '0' && source[index + 5] == '0') { self.fail("native text contains NUL"); }
				index++;
			}
		}
		return JSONValue.parse(source);
	}

	public Vector<Result<string, string>> decodeBatch(string source, Vector<string> identities) {
		var value = self.document(source);
		self.fields(value, "schema,results");
		if (!self.text(value.get("schema")).equals("btrc.native-responses.v1")) { self.fail("unsupported native batch schema"); }
		var entries = self.array(value.get("results"));
		if (entries.len != identities.len) { self.fail("native batch result count does not match requests"); }
		Map<string, bool> seen = {};
		Vector<Result<string, string>> results = [];
		for index in range(entries.len) {
			var entry = entries.get(index);
			self.fields(entry, "id,errors,document");
			string identity = self.text(entry.get("id"));
			if (!identity.equals(identities.get(index)) || seen.has(identity)) { self.fail("native batch result identity does not match request order"); }
			seen.put(identity, true);
			var errors = self.array(entry.get("errors"));
			var document = entry.get("document");
			if ((errors.len > 0 && !document.isNull()) || (errors.len == 0 && !document.isObject())) { self.fail("native batch result must contain either a document or errors"); }
			var diagnostic = StringBuilder();
			for position in range(errors.len) {
				if (position > 0) { diagnostic.append("\n"); }
				diagnostic.append("error: " + self.text(errors.get(position)));
			}
			results.push(new Result<string, string>(errors.len == 0, errors.len == 0 ? document.stringify() : "", diagnostic.toString()));
		}
		return results;
	}

	public NativeNode decode(string source, string expectedTarget = "") {
		JSONValue value = self.document(source);
		self.fields(value, "schema,target,clang,big_endian,character_bits,declarations,records", "interfaces");
		if (!self.text(value.get("schema")).equals("btrc.native-declarations.v3")) { self.fail("unsupported native header schema"); }
		var result = self.node(NNK_NATIVE_HEADER);
		result.targetTriple = self.text(value.get("target"));
		if (!expectedTarget.isEmpty() && !result.targetTriple.equals(expectedTarget)) { self.fail("native header target does not match the requested target"); }
		result.compilerVersion = self.text(value.get("clang"));
		result.bigEndian = self.boolean(value.get("big_endian"));
		result.characterBits = self.integer(value.get("character_bits"));
		if (result.characterBits == 0) { self.fail("native character width must be positive"); }
		if (value.has("interfaces")) {
			for entry in self.array(value.get("interfaces")) { result.interfaces.push(self.interfaceDeclaration(entry)); }
		}
		self.verifyInterfaces(result.interfaces);
		Map<string, bool> names = {};
		Map<string, bool> layouts = {};
		for entry in self.array(value.get("declarations")) {
			NativeNode declaration = self.declaration(entry);
			if (names.has(declaration.name)) { self.fail("duplicate native declaration or record identity"); }
			names.put(declaration.name, true);
			result.exports.push(declaration);
		}
		for entry in self.array(value.get("records")) {
			NativeNode record = self.record(entry);
			if (layouts.has(record.identity)) { self.fail("duplicate native declaration or record identity"); }
			layouts.put(record.identity, true);
			result.records.push(record);
		}
		for entry in result.exports {
			if (entry.kind == NNK_NATIVE_JAVA_CLASS) { continue; }
			if (entry.kind == NNK_NATIVE_FUNCTION || entry.kind == NNK_NATIVE_OBJECTIVE_C_METHOD || entry.kind == NNK_NATIVE_CXX_METHOD || entry.kind == NNK_NATIVE_JAVA_METHOD) { self.verifyLayoutReferences(entry.signature, layouts); }
			else if (entry.kind == NNK_NATIVE_TYPEDEF) { self.verifyLayoutReferences(entry.underlying, layouts); }
			else if (entry.kind == NNK_NATIVE_CONSTANT || entry.kind == NNK_NATIVE_STRING_CONSTANT || entry.kind == NNK_NATIVE_POINTER_CONSTANT || entry.kind == NNK_NATIVE_GLOBAL || entry.kind == NNK_NATIVE_JAVA_FIELD) { self.verifyLayoutReferences(entry.valueType, layouts); }
			else { self.verifyLayoutReferences(entry.recordType, layouts); }
		}
		for record in result.records {
			for field in record.fields { self.verifyLayoutReferences(field.fieldType, layouts); }
		}
		return result;
	}
}
