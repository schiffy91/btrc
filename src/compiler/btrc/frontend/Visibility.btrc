/* Strict per-file import visibility owners. */

import Library.Map;
import Library.Strings;
import Library.Vector;

import ../generated/ast/Node.btrc;
import ../lexer/Lexer.btrc;
import ../parser/Parser.btrc;
import ../parser/SourceMacros.btrc;
import ../syntax/Grammar.btrc;
import ../syntax/Tokens.btrc;
import ./Models.btrc;
import ./Timing.btrc;
import ./Packages.btrc;
import ./SourceIo.btrc;
import ./Stdlib.btrc;

class FeImportReference {
	public string name;
	public int line;
	public int col;

	public FeImportReference(string name, int line, int col) {
		self.name = name;
		self.line = line > 0 ? line : 1;
		self.col = col > 0 ? col : 1;
	}
}

class FeImportReferenceCollector {
	public Vector<FeImportReference> references;
	public Map<string, bool> genericParameters;
	public Vector<Map<string, bool>> scopes;

	public FeImportReferenceCollector(Vector<string> genericParameters) {
		self.references = [];
		self.genericParameters = {};
		int index = 0;
		while (index < genericParameters.len) {
			self.genericParameters.put(genericParameters.get(index), true);
			index++;
		}
		Map<string, bool> root = {};
		self.scopes = [root];
	}

	public bool isBound(string name) {
		int index = self.scopes.len - 1;
		while (index >= 0) {
			if (self.scopes.get(index).has(name)) { return true; }
			index--;
		}
		return false;
	}

	public void add(string name, int line, int col, bool typeName) {
		if (name == null || name.isEmpty() || self.genericParameters.has(name)) { return; }
		if (!typeName && self.isBound(name)) { return; }
		self.references.push(FeImportReference(name, line, col));
	}

	public void pushScope(Vector<string> names) {
		Map<string, bool> frame = {};
		int index = 0;
		while (index < names.len) {
			string name = names.get(index);
			if (name != null && !name.isEmpty()) { frame.put(name, true); }
			index++;
		}
		self.scopes.push(frame);
	}

	public void popScope() { self.scopes.pop(); }

	public void bind(string name) {
		if (name == null || name.isEmpty()) { return; }
		Map<string, bool> frame = self.scopes.get(self.scopes.len - 1);
		frame.put(name, true);
	}

	public void visitParameters(Vector<Node> parameters) {
		int index = 0;
		while (index < parameters.len) {
			Node parameter = parameters.get(index);
			self.visit(parameter.type);
			self.visit(parameter.default_);
			self.bind(parameter.name);
			index++;
		}
	}

	public Vector<string> addGenericParameters(Vector<string> parameters) {
		Vector<string> added = [];
		int index = 0;
		while (index < parameters.len) {
			string name = parameters.get(index);
			if (!self.genericParameters.has(name)) {
				self.genericParameters.put(name, true);
				added.push(name);
			}
			index++;
		}
		return added;
	}

	public void removeGenericParameters(Vector<string> parameters) {
		int index = 0;
		while (index < parameters.len) {
			self.genericParameters.remove(parameters.get(index));
			index++;
		}
	}

	public void visitList(Vector<Node> nodes) {
		int index = 0;
		while (index < nodes.len) {
			self.visit(nodes.get(index));
			index++;
		}
	}

	public void visit(Node? node) {
		if (node == null) { return; }
		if (node.kind == NK_TYPE_EXPR) {
			self.add(node.base, node.line, node.col, true);
			self.visitList(node.genericArgs());
			self.visit(node.arraySize);
			return;
		}
		if (node.kind == NK_IDENTIFIER) {
			self.add(node.name, node.line, node.col, false);
			return;
		}
		if (node.kind == NK_CLASS_DECL || node.kind == NK_INTERFACE_DECL) {
			Vector<string> added = self.addGenericParameters(node.genericParams());
			if (node.parent != null) {
				self.add(node.parent, node.line, node.col, true);
			}
			int interfaceIndex = 0;
			while (interfaceIndex < node.interfaces().len) {
				self.add(node.interfaces().get(interfaceIndex), node.line, node.col, true);
				interfaceIndex++;
			}
			if (node.kind == NK_CLASS_DECL) { self.visitList(node.members()); }
			else { self.visitList(node.methods()); }
			self.removeGenericParameters(added);
			return;
		}
		if (node.kind == NK_FUNCTION_DECL || node.kind == NK_METHOD_DECL || node.kind == NK_METHOD_SIG) {
			Vector<string> added = self.addGenericParameters(node.genericParams());
			self.visit(node.returnType);
			Vector<string> empty = [];
			self.pushScope(empty);
			self.visitParameters(node.params());
			self.visit(node.bodyNode);
			self.popScope();
			self.removeGenericParameters(added);
			return;
		}
		if (node.kind == NK_LAMBDA_EXPR) {
			self.visit(node.returnType);
			self.visitList(node.captures());
			Vector<string> empty = [];
			self.pushScope(empty);
			self.visitParameters(node.params());
			self.visit(node.bodyNode);
			self.popScope();
			return;
		}
		if (node.kind == NK_PROPERTY_DECL) {
			self.visit(node.type);
			self.visit(node.getterBody);
			Vector<string> setterNames = ["value"];
			self.pushScope(setterNames);
			self.visit(node.setterBody);
			self.popScope();
			return;
		}
		if (node.kind == NK_RICH_ENUM_VARIANT) {
			Vector<string> empty = [];
			self.pushScope(empty);
			self.visitParameters(node.params());
			self.popScope();
			return;
		}
		if (node.kind == NK_BLOCK) {
			Vector<string> empty = [];
			self.pushScope(empty);
			self.visitList(node.statements());
			self.popScope();
			return;
		}
		if (node.kind == NK_VAR_DECL_STMT) {
			self.visit(node.type);
			self.visit(node.initializer);
			self.bind(node.name);
			return;
		}
		if (node.kind == NK_FOR_IN_STMT || node.kind == NK_PARALLEL_FOR_STMT) {
			self.visit(node.iterable);
			Vector<string> names = [node.varName];
			if (node.varName2 != null) { names.push(node.varName2); }
			self.pushScope(names);
			self.visit(node.bodyNode);
			self.popScope();
			return;
		}
		if (node.kind == NK_C_FOR_STMT) {
			Vector<string> empty = [];
			self.pushScope(empty);
			self.visit(node.init);
			self.visit(node.condition);
			self.visit(node.update);
			self.visit(node.bodyNode);
			self.popScope();
			return;
		}
		if (node.kind == NK_SWITCH_STMT) {
			self.visit(node.valueNode);
			int caseIndex = 0;
			while (caseIndex < node.cases().len) {
				Node clause = node.cases().get(caseIndex);
				self.visit(clause.valueNode);
				Vector<string> empty = [];
				self.pushScope(empty);
				self.visitList(clause.bodyNodeList());
				self.popScope();
				caseIndex++;
			}
			return;
		}
		if (node.kind == NK_TRY_CATCH_STMT) {
			self.visit(node.tryBlock);
			self.visit(node.catchType);
			Vector<string> names = [node.catchVar];
			self.pushScope(names);
			self.visit(node.catchBlock);
			self.popScope();
			self.visit(node.finallyBlock);
			return;
		}
		if (node.kind == NK_PREPROCESSOR_DIRECTIVE) {
			SourceMacroDefinition definition = SourceMacroDefinition(node.text);
			Vector<string> identifiers = definition.replacementIdentifiers();
			int identifierIndex = 0;
			while (identifierIndex < identifiers.len) {
				string identifier = identifiers.get(identifierIndex);
				if (definition.replacementUsesBareName(identifier)) {
					self.add(identifier, node.line, node.col, false);
				}
				identifierIndex++;
			}
			return;
		}

		/* Every node of the program passes here: skip unset fields and unwritten
		 * lists without a call. */
		if (node.spec != null) { self.visit(node.spec); }
		if (node.returnType != null) { self.visit(node.returnType); }
		if (node.bodyNode != null) { self.visit(node.bodyNode); }
		if (node.original != null) { self.visit(node.original); }
		if (node.arraySize != null) { self.visit(node.arraySize); }
		if (node.type != null) { self.visit(node.type); }
		if (node.default_ != null) { self.visit(node.default_); }
		if (node.initializer != null) { self.visit(node.initializer); }
		if (node.getterBody != null) { self.visit(node.getterBody); }
		if (node.setterBody != null) { self.visit(node.setterBody); }
		if (node.valueNode != null) { self.visit(node.valueNode); }
		if (node.condition != null) { self.visit(node.condition); }
		if (node.thenBlock != null) { self.visit(node.thenBlock); }
		if (node.elseBlock != null) { self.visit(node.elseBlock); }
		if (node.iterable != null) { self.visit(node.iterable); }
		if (node.init != null) { self.visit(node.init); }
		if (node.update != null) { self.visit(node.update); }
		if (node.expr != null) { self.visit(node.expr); }
		if (node.tryBlock != null) { self.visit(node.tryBlock); }
		if (node.catchType != null) { self.visit(node.catchType); }
		if (node.catchBlock != null) { self.visit(node.catchBlock); }
		if (node.finallyBlock != null) { self.visit(node.finallyBlock); }
		if (node.ifStmt != null) { self.visit(node.ifStmt); }
		if (node.varDecl != null) { self.visit(node.varDecl); }
		if (node.expression != null) { self.visit(node.expression); }
		if (node.left != null) { self.visit(node.left); }
		if (node.right != null) { self.visit(node.right); }
		if (node.operand != null) { self.visit(node.operand); }
		if (node.callee != null) { self.visit(node.callee); }
		if (node.obj != null) { self.visit(node.obj); }
		if (node.index != null) { self.visit(node.index); }
		if (node.targetType != null) { self.visit(node.targetType); }
		if (node.trueExpr != null) { self.visit(node.trueExpr); }
		if (node.falseExpr != null) { self.visit(node.falseExpr); }
		if (node.target != null) { self.visit(node.target); }
		if (node.fn != null) { self.visit(node.fn); }
		if (node.key != null) { self.visit(node.key); }
		if (node.declarationsStorage != null) { self.visitList(node.declarationsStorage); }
		if (node.membersStorage != null) { self.visitList(node.membersStorage); }
		if (node.methodsStorage != null) { self.visitList(node.methodsStorage); }
		if (node.paramsStorage != null) { self.visitList(node.paramsStorage); }
		if (node.fieldsStorage != null) { self.visitList(node.fieldsStorage); }
		if (node.valuesStorage != null) { self.visitList(node.valuesStorage); }
		if (node.variantsStorage != null) { self.visitList(node.variantsStorage); }
		if (node.genericArgsStorage != null) { self.visitList(node.genericArgsStorage); }
		if (node.statementsStorage != null) { self.visitList(node.statementsStorage); }
		if (node.casesStorage != null) { self.visitList(node.casesStorage); }
		if (node.argsStorage != null) { self.visitList(node.argsStorage); }
		if (node.elementsStorage != null) { self.visitList(node.elementsStorage); }
		if (node.entriesStorage != null) { self.visitList(node.entriesStorage); }
		if (node.partsStorage != null) { self.visitList(node.partsStorage); }
		if (node.capturesStorage != null) { self.visitList(node.capturesStorage); }
		if (node.bodyNodeListStorage != null) { self.visitList(node.bodyNodeListStorage); }
	}
}

class FeDeclarationSymbolExtractor {
	public bool isNamedDeclaration(Node declaration) { return declaration.kind == NK_CLASS_DECL || declaration.kind == NK_INTERFACE_DECL || declaration.kind == NK_FUNCTION_DECL || declaration.kind == NK_STRUCT_DECL || declaration.kind == NK_ENUM_DECL || declaration.kind == NK_RICH_ENUM_DECL || declaration.kind == NK_TYPEDEF_DECL || declaration.kind == NK_VAR_DECL_STMT; }

	private string declarationName(Node declaration) { return declaration.kind == NK_TYPEDEF_DECL ? declaration.alias : declaration.name; }

	public Vector<string> names(Node declaration) {
		Vector<string> names = [];
		if (self.isNamedDeclaration(declaration)) {
			names.push(self.declarationName(declaration));
		}
		if (declaration.kind == NK_ENUM_DECL) {
			int valueIndex = 0;
			while (valueIndex < declaration.values().len) {
				names.push(declaration.values().get(valueIndex).name);
				valueIndex++;
			}
		}
		if (declaration.kind == NK_RICH_ENUM_DECL) {
			int variantIndex = 0;
			while (variantIndex < declaration.variants().len) {
				names.push(declaration.variants().get(variantIndex).name);
				variantIndex++;
			}
		}
		if (declaration.kind == NK_PREPROCESSOR_DIRECTIVE) {
			SourceMacroDefinition definition = SourceMacroDefinition(declaration.text);
			if (definition.isDefinition()) { names.push(definition.name()); }
		}
		return names;
	}
}

class FeImportVisibilityChecker {
	private Node program;
	private FeResolvedSource resolved;
	private FeStdlibRepository stdlib;
	private FeStdlibSymbolIndex stdlibSymbols;
	private FeDeclarationSymbolExtractor symbolExtractor;
	private Map<string, bool> compilerImplicitSymbols;
	private GrammarInfo grammar;
	private FeSourcePathPolicy sourcePaths;
	private FePackageImportPolicy packageAccess;
	/* Per source identity: every file its imports reach, and the package
	 * policy's answer for each file a reference has asked about. */
	private Map<string, Map<string, bool>> visibleFiles;
	private Map<string, Map<string, bool>> permittedFiles = {};
	/* Whether a source file lies inside the compiler's stdlib, by path. The
	 * answer needs two canonical-path lookups (system calls), and the checker
	 * asks it for every reference it visits. */
	private Map<string, bool> stdlibSourceFiles;

	public FeImportVisibilityChecker(Node program, FeResolvedSource resolved, FeStdlibRepository stdlib, FeStdlibSymbolIndex stdlibSymbols, GrammarInfo grammar, Map<string, bool> compilerImplicitSymbols) {
		self.program = program;
		self.resolved = resolved;
		self.stdlib = stdlib;
		self.stdlibSymbols = stdlibSymbols;
		self.symbolExtractor = FeDeclarationSymbolExtractor();
		self.compilerImplicitSymbols = compilerImplicitSymbols;
		self.grammar = grammar;
		self.sourcePaths = FeSourcePathPolicy();
		self.packageAccess = FePackageImportPolicy();
		self.visibleFiles = {};
		self.stdlibSourceFiles = {};
	}

	private bool containsPath(Vector<string> paths, string path) {
		int index = 0;
		while (index < paths.len) {
			if (paths.get(index).equals(path)) { return true; }
			index++;
		}
		return false;
	}

	private void addSymbolOwner(Map<string, Vector<string>> symbols, string name, string owner) {
		if (name == null || name.isEmpty()) { return; }
		string ownerIdentity = self.sourcePaths.identity(owner);
		Vector<string> owners = [];
		if (symbols.has(name)) { owners = symbols.get(name); }
		if (!self.containsPath(owners, ownerIdentity)) {
			owners.push(ownerIdentity);
		}
		symbols.put(name, owners);
	}

	private void addDeclarationSymbols(Map<string, Vector<string>> symbols, Node declaration, string owner) {
		Vector<string> names = self.symbolExtractor.names(declaration);
		int index = 0;
		while (index < names.len) {
			self.addSymbolOwner(symbols, names.get(index), owner);
			index++;
		}
	}

	private Map<string, Vector<string>> localSymbolFiles() {
		Map<string, Vector<string>> symbols = {};
		for imported in self.resolved.nativeDeclarations {
			/* SDK typedefs refine an existing hosted type without making it
			 * private to this module. New aliases and source declarations stay scoped. */
			if (imported.declaration.kind == NK_TYPEDEF_DECL && self.compilerImplicitSymbols.has(imported.declaration.alias)) { continue; }
			self.addDeclarationSymbols(symbols, imported.declaration, imported.module);
		}
		int index = 0;
		while (index < self.program.declarations().len) {
			Node declaration = self.program.declarations().get(index);
			FeLine? line = self.resolved.userLineForCombined(declaration.line);
			if (line != null) {
				self.addDeclarationSymbols(symbols, declaration, line.sourceFile);
			}
			index++;
		}
		return symbols;
	}

	/* A reachable owner is visible when the package policy permits the
	 * reference; the policy is asked only about owners references name. */
	private bool anyOwnerVisible(string start, Vector<string> owners, Map<string, bool> reachable) {
		if (!self.permittedFiles.has(start)) { self.permittedFiles.put(start, {}); }
		Map<string, bool> permitted = self.permittedFiles.get(start);
		int index = 0;
		while (index < owners.len) {
			string owner = owners.get(index);
			index++;
			if (!reachable.has(owner)) { continue; }
			if (!permitted.has(owner)) { permitted.put(owner, self.packageAccess.permitsReference(start, owner)); }
			if (permitted.get(owner)) { return true; }
		}
		return false;
	}

	private void queueUnseen(string path, Map<string, bool> seen, Vector<string> pending) {
		if (!seen.has(path)) { pending.push(path); }
	}

	private Map<string, bool> visibilityReachable(string sourceFile) {
		string start = self.sourcePaths.identity(sourceFile);
		if (self.visibleFiles.has(start)) { return self.visibleFiles.get(start); }
		Map<string, bool> seen = {};
		Vector<string> pending = [start];
		int index = 0;
		while (index < pending.len) {
			string current = pending.get(index);
			index++;
			if (seen.has(current)) { continue; }
			seen.put(current, true);
			Vector<FeDependencyEdge> edges = self.resolved.dependencies.outgoingFrom(current);
			int edgeIndex = 0;
			while (edgeIndex < edges.len) {
				self.queueUnseen(edges.get(edgeIndex).target, seen, pending);
				edgeIndex++;
			}
			Vector<string> parents = self.resolved.dependencies.includeParentsOf(current);
			int parentIndex = 0;
			while (parentIndex < parents.len) {
				self.queueUnseen(parents.get(parentIndex), seen, pending);
				parentIndex++;
			}
		}
		self.visibleFiles.put(start, seen);
		return seen;
	}

	private bool compilerStdlibSource(string sourceFile) {
		if (self.stdlibSourceFiles.has(sourceFile)) { return self.stdlibSourceFiles.get(sourceFile); }
		bool inside = !self.sourcePaths.identity(sourceFile).equals(self.sourcePaths.identity(self.resolved.rootSourcePath)) && self.stdlib.snapshotContainsSource(self.resolved.stdlibSnapshot, sourceFile);
		self.stdlibSourceFiles.put(sourceFile, inside);
		return inside;
	}

	private FeStdlibSymbolIndexResult ensureStdlibIndex() {
		FeStdlibRootSnapshot snapshot = self.resolved.stdlibSnapshot;
		if (self.stdlibSymbols.currentFor(snapshot)) {
			return FeStdlibSymbolIndexResult(true, "");
		}
		Map<string, Vector<string>>? generated = self.stdlib.loadSymbolIndex(snapshot);
		if (generated != null) {
			self.stdlibSymbols.replace(snapshot, generated);
			return FeStdlibSymbolIndexResult(true, "");
		}
		Map<string, Vector<string>> nextSymbolFiles = {};
		int fileIndex = 0;
		while (fileIndex < snapshot.count()) {
			string path = snapshot.pathAt(fileIndex);
			string source = snapshot.sourceAt(fileIndex);
			fileIndex++;
			Lexer lexer = Lexer(source, self.grammar);
			Vector<Token> tokens = lexer.tokenize();
			if (lexer.failed) {
				return FeStdlibSymbolIndexResult(false, f"cannot index standard-library source '{path}': " + lexer.diagnostic);
			}
			Parser parser = Parser(tokens, self.grammar);
			Node stdlibProgram = parser.parseProgram();
			if (parser.failed) {
				return FeStdlibSymbolIndexResult(false, f"cannot index standard-library source '{path}': " + parser.diagnostic);
			}
			int declarationIndex = 0;
			while (declarationIndex < stdlibProgram.declarations().len) {
				self.addDeclarationSymbols(nextSymbolFiles, stdlibProgram.declarations().get(declarationIndex), path);
				declarationIndex++;
			}
		}
		self.stdlibSymbols.replace(snapshot, nextSymbolFiles);
		return FeStdlibSymbolIndexResult(true, "");
	}

	public FeVisibilityCheckResult check() {
		Map<string, Vector<string>> symbols = self.localSymbolFiles();
		FeStdlibSymbolIndexResult indexed = self.ensureStdlibIndex();
		BtrccPhaseTimer.mark("visibility-index");
		if (!indexed.success) {
			Vector<FeVisibilityDiagnostic> emptyDiagnostics = [];
			return FeVisibilityCheckResult(false, indexed.diagnostic, emptyDiagnostics);
		}
		self.stdlibSymbols.mergeInto(symbols);
		Vector<FeVisibilityDiagnostic> diagnostics = [];
		int declarationIndex = 0;
		while (declarationIndex < self.program.declarations().len) {
			Node declaration = self.program.declarations().get(declarationIndex);
			declarationIndex++;
			bool native = false;
			string generatedModule = "";
			for imported in self.resolved.nativeDeclarations {
				if (imported.declaration != declaration) { continue; }
				if (imported.generatedInput) { generatedModule = imported.module; }
				else { native = true; }
				break;
			}
			if (native) { continue; }
			if (!self.symbolExtractor.isNamedDeclaration(declaration) && declaration.kind != NK_PREPROCESSOR_DIRECTIVE) {
				continue;
			}
			FeLine? declarationLine = self.resolved.userLineForCombined(declaration.line);
			string sourceFile = generatedModule;
			if (sourceFile.isEmpty()) {
				if (declarationLine == null) { continue; }
				sourceFile = declarationLine.sourceFile;
			}
			Map<string, bool> reachable = self.visibilityReachable(sourceFile);
			string sourceIdentity = self.sourcePaths.identity(sourceFile);
			FeImportReferenceCollector collector = FeImportReferenceCollector(declaration.genericParams());
			collector.visit(declaration);
			Map<string, bool> seen = {};
			int referenceIndex = 0;
			while (referenceIndex < collector.references.len) {
				FeImportReference reference = collector.references.get(referenceIndex);
				referenceIndex++;
				string key = f"{reference.name}|{reference.line}|{reference.col}";
				if (seen.has(key)) { continue; }
				seen.put(key, true);
				if (!symbols.has(reference.name)) { continue; }
				if (self.compilerStdlibSource(sourceFile) && self.compilerImplicitSymbols.has(reference.name)) {
					continue;
				}
				Vector<string> owners = symbols.get(reference.name);
				if (self.anyOwnerVisible(sourceIdentity, owners, reachable)) { continue; }
				owners.sortBy((string left, string right) => Strings.lessThan(left, right));
				string owner = self.sourcePaths.baseName(owners.get(0));
				string message = f"'{reference.name}' is defined in {owner} but " + f"{self.sourcePaths.baseName(sourceFile)} does not import it";
				FeLine? referenceLine = self.resolved.userLineForCombined(reference.line);
				if (referenceLine == null) {
					diagnostics.push(FeVisibilityDiagnostic(message, sourceFile, reference.line, reference.col, ""));
				} else {
					diagnostics.push(FeVisibilityDiagnostic(message, referenceLine.sourceFile, referenceLine.lineNumber, reference.col, referenceLine.text));
				}
			}
		}
		return FeVisibilityCheckResult(true, "", diagnostics);
	}
}
