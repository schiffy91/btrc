/* Versioned package graph and native link-plan ownership. */

import Library.FileSystem;
import Library.JSON;
import Library.Map;
import Library.Platform;
import Library.SHA256;
import Library.Strings;
import Library.TOML;
import Library.Vector;

import ./SourceIo.btrc;
import ./Models.btrc;

class FePackageFailure {
	class void fail(string diagnostic) {
		fprintf(stderr, "error: package resolution failed: %s\n", diagnostic);
		exit(1);
	}
}

class FePackageTarget {
	public string operatingSystem;
	public string architecture;

	public FePackageTarget(string operatingSystem, string architecture) {
		self.operatingSystem = operatingSystem;
		self.architecture = architecture;
	}

	private bool validOperatingSystem(string value) { return value.equals("linux") || value.equals("macos") || value.equals("windows"); }

	private bool validArchitecture(string value) { return value.equals("x86_64") || value.equals("aarch64"); }

	class FePackageTarget parse(string raw) {
		if (raw == null || raw.isEmpty()) {
			FePackageFailure.fail("version-1 package manifests require --target OS-ARCH");
		}
		int separator = raw.indexOf("-");
		if (separator < 1 || separator + 1 >= raw.length()) {
			FePackageFailure.fail(f"unsupported package target '{raw}'; expected OS-ARCH");
		}
		string os = raw.substring(0, separator);
		string arch = raw.substring(separator + 1, raw.length() - separator - 1);
		if (arch.equals("x64")) { arch = "x86_64"; }
		else if (arch.equals("arm64")) { arch = "aarch64"; }
		FePackageTarget target = FePackageTarget(os, arch);
		if (!target.validOperatingSystem(os) || !target.validArchitecture(arch)) {
			FePackageFailure.fail(f"unsupported package target '{raw}'; expected linux, macos, " + "or windows with x86_64 or aarch64");
		}
		return target;
	}
}

class FeNativeDeclaration {
	public string kind;
	public string packageName;
	public string value;
	public string detail;
	public string language;
	public string standard;
	public Vector<string> operatingSystems;
	public Vector<string> architectures;
	public Vector<string> modules;

	public FeNativeDeclaration(string kind, string packageName, string value, string detail, string language, string standard, Vector<string> operatingSystems, Vector<string> architectures, Vector<string> modules) {
		self.kind = kind;
		self.packageName = packageName;
		self.value = value;
		self.detail = detail;
		self.language = language;
		self.standard = standard;
		self.operatingSystems = operatingSystems;
		self.architectures = architectures;
		self.modules = modules;
	}

	private bool contains(Vector<string> values, string expected) {
		int index = 0;
		while (index < values.len) {
			if (values.get(index).equals(expected)) { return true; }
			index++;
		}
		return false;
	}

	public bool selectedFor(FePackageTarget target) { return (self.operatingSystems.len == 0 || self.contains(self.operatingSystems, target.operatingSystem)) && (self.architectures.len == 0 || self.contains(self.architectures, target.architecture)); }

	private bool sameValues(Vector<string> left, Vector<string> right) {
		if (left.len != right.len) { return false; }
		int index = 0;
		while (index < left.len) {
			if (!left.get(index).equals(right.get(index))) { return false; }
			index++;
		}
		return true;
	}

	public bool sameIdentity(FeNativeDeclaration other) { return self.kind.equals(other.kind) && self.packageName.equals(other.packageName) && self.value.equals(other.value) && self.detail.equals(other.detail) && self.language.equals(other.language) && self.standard.equals(other.standard) && self.sameValues(self.operatingSystems, other.operatingSystems) && self.sameValues(self.architectures, other.architectures); }

	public string sortKey() { return self.packageName + "\x1f" + self.kind + "\x1f" + self.value + "\x1f" + self.detail + "\x1f" + self.language; }
}

