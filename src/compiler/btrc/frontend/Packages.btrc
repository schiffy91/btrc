	public Vector<string> arguments;
	public FeNativeVariadicBinding(string value, Vector<string> arguments) { self.value = value; self.arguments = arguments; }
}

class FeNativeRecordSnapshotBinding {
	public string result;
	public string owner;
	public string name;
	public Map<string, string> fields = {};
	public Vector<string> bytePlane = [];
	public Vector<string> guard = [];
	public Map<string, string> strings = {};
	public Vector<string> byteSpan = [];
}

class FeNativeBinding {
	public Map<string, FeNativeCopiedInputBinding> copiedInputs = {};
	public Map<string, FeNativeInitializerBinding> initializers = {};
	public Vector<FeNativeRecordSnapshotBinding> recordSnapshots = [];
	public Map<string, FeNativeCopiedResultBinding> copiedResults = {};
	public Map<string, FeNativeVariadicBinding> variadicCalls = {};
	public Map<string, FeNativeOutputOffsetBinding> outputOffsets = {};
	public Map<string, FeNativeStringView> stringViews = {};
	public Map<string, FeNativeCallbackBinding> callbacks = {};
	public Vector<string> mainThreadGlobals = [];
	public string packageName;
	public string module;
	public string header;
	public string language;
	public string standard;
	public Vector<string> symbols;
	public Vector<string> operatingSystems;
	public Vector<string> architectures;
	public Vector<string> readOnlyBorrows;
	public Vector<string> realtimeSafe;
	public Vector<string> ownedRecords;
	public Vector<string> recordInputs;
	public Vector<string> recordOutputs = [];
	public Vector<string> ownedOutputFields = [];
	public Vector<string> nullOutputFields = [];
	public Map<string, string> objectFields;
	public Map<string, FeNativeResourceBinding> resources;
	public Vector<string> ownedResults;
	public Map<string, string> borrowedResults = {};
	public Vector<string> staticGlobals = [];
	public Map<string, string> resourceParameters = {};
	public Map<string, string> resourceResults = {};
	public Map<string, string> ownedOutputs = {};
	public Map<string, FeNativeResourceOutputBinding> ownedOutputResources = {};
	public Vector<string> borrowedParameters;

	public FeNativeBinding(string packageName, string module, string header, string language, string standard, Vector<string> symbols, Vector<string> operatingSystems, Vector<string> architectures) {
		self.packageName = packageName;
		self.module = module;
		self.header = header;
		self.language = language;
		self.standard = standard;
		self.symbols = symbols;
		self.operatingSystems = operatingSystems;
		self.architectures = architectures;
		self.readOnlyBorrows = [];
		self.realtimeSafe = [];
		self.ownedRecords = [];
		self.recordInputs = [];
		self.objectFields = {};
		self.resources = {};
		self.ownedResults = [];
		self.borrowedParameters = [];
	}

	private bool intersects(Vector<string> left, Vector<string> right) {
		for first in left {
			for second in right {
				if (first.equals(second)) { return true; }
			}
		}
		return false;
	}

	private bool targetsOverlap(Vector<string> left, Vector<string> right) { return left.len == 0 || right.len == 0 || self.intersects(left, right); }

	public bool selectedFor(FePackageTarget target) {
		Vector<string> operatingSystem = [target.operatingSystem];
		Vector<string> architecture = [target.architecture];
		return self.targetsOverlap(self.operatingSystems, operatingSystem) && self.targetsOverlap(self.architectures, architecture);
	}

	public bool overlaps(FeNativeBinding other) { return self.module.equals(other.module) && self.intersects(self.symbols, other.symbols) && self.targetsOverlap(self.operatingSystems, other.operatingSystems) && self.targetsOverlap(self.architectures, other.architectures); }

	public string sortKey() { return self.packageName + "\x1f" + self.module + "\x1f" + self.header + "\x1f" + Strings.join(self.symbols, ",") + "\x1f" + Strings.join(self.operatingSystems, ",") + "\x1f" + Strings.join(self.architectures, ","); }
}

class FeNativeInitializerBinding {
	public string resource;
	public string parameter;
	public string result;
	public string success;
	public string copiedInput = "";
	public string length = "";
	public string statusField = "";
}

class FeNativeCopiedInputBinding {
	public string owner;
	public string length;
	public FeNativeCopiedInputBinding(string owner, string length) { self.owner = owner; self.length = length; }
}

class FeModuleProvider {
	public string module;
	public string implementation;
	public Vector<string> operatingSystems;
	public Vector<string> architectures;

	public FeModuleProvider(string module, string implementation, Vector<string> operatingSystems, Vector<string> architectures) {
		self.module = module;
		self.implementation = implementation;
		self.operatingSystems = operatingSystems;
		self.architectures = architectures;
	}

	private bool overlapsValues(Vector<string> left, Vector<string> right) {
		if (left.len == 0 || right.len == 0) { return true; }
		for first in left { for second in right { if (first == second) { return true; } } }
		return false;
	}

	public bool overlaps(FeModuleProvider other) { return self.module == other.module && self.overlapsValues(self.operatingSystems, other.operatingSystems) && self.overlapsValues(self.architectures, other.architectures); }

	public bool selectedFor(FePackageTarget target) {
		bool osMatches = self.operatingSystems.len == 0;
		bool archMatches = self.architectures.len == 0;
		for os in self.operatingSystems { if (os == target.operatingSystem) { osMatches = true; } }
		for arch in self.architectures { if (arch == target.architecture) { archMatches = true; } }
		return osMatches && archMatches;
	}
}

