class FePackageFailure {
	class void fail(string diagnostic) {
		fprintf(stderr, "error: package resolution failed: %s\n", diagnostic);
		exit(1);
	}
}

/* One selected target row, as the frontend's value. Parsing, canonical
 * labels and host inference read the generated targets.toml rows, as the
 * reference compiler's TargetRepository does (platform-target-contract.md
 * §1.4-§1.7). An unrecognized host is the one target that names no row: its
 * fields are empty, and every compile refuses it before reading a source. */
class FePackageTarget {
	public string operatingSystem;
	public string architecture;
	public string environment;

	public FePackageTarget(string operatingSystem, string architecture, string environment) {
		self.operatingSystem = operatingSystem;
		self.architecture = architecture;
		self.environment = environment;
	}

	class string unknownHostMessage() { return "cannot infer a supported target from this host; pass --target"; }

	/* Every canonical label, sorted; the generated rows are in label order. */
	class Vector<string> labels() {
		Vector<string> labels = [];
		for row in GeneratedHostedAbiData().targetRows() { labels.push(row.label); }
		labels.sortBy((string left, string right) => Strings.lessThan(left, right));
		return labels;
	}

	class string unsupportedMessage(string raw) { return f"unsupported target '{raw}'; expected one of " + Strings.join(FePackageTarget.labels(), ", "); }

	class string defaultEnvironment(GeneratedHostedAbiData data, string operatingSystem) {
		Map<string, string> defaults = data.defaultEnvironments();
		return defaults.has(operatingSystem) ? defaults.get(operatingSystem) : "";
	}

	class GeneratedTargetRow? find(GeneratedHostedAbiData data, string operatingSystem, string architecture, string environment) {
		for row in data.targetRows() {
			if (row.operatingSystem.equals(operatingSystem) && row.architecture.equals(architecture) && row.environment.equals(environment)) { return row; }
		}
		return null;
	}

	/* The row OS-ARCH[-ENV] names, through the architecture aliases and the
	 * OS's default environment; anything else throws the shared message. */
	class FePackageTarget parse(string raw) {
		GeneratedHostedAbiData data = GeneratedHostedAbiData();
		Vector<string> parts = Strings.split(raw == null ? "" : raw, "-");
		bool shaped = parts.len == 2 || parts.len == 3;
		for part in parts { if (part.isEmpty()) { shaped = false; } }
		if (shaped) {
			string os = parts.get(0);
			string arch = parts.get(1);
			Map<string, string> aliases = data.architectureAliases();
			if (aliases.has(arch)) { arch = aliases.get(arch); }
			string environment = parts.len == 3 ? parts.get(2) : FePackageTarget.defaultEnvironment(data, os);
			GeneratedTargetRow? row = FePackageTarget.find(data, os, arch, environment);
			if (row != null) { return FePackageTarget(row.operatingSystem, row.architecture, row.environment); }
		}
		throw FePackageTarget.unsupportedMessage(raw == null ? "" : raw);
	}

	/* The host seam: __btrc_target_platform() codes 1/2/3 and
	 * __btrc_target_architecture() codes 1/2 name the normalized tokens; code
	 * 0 names nothing. A btrcc binary's host is the target its C compiler
	 * built it for. */
	class FePackageTarget hostFrom(int platform, int architecture) {
		string os = platform == 1 ? "macos" : (platform == 2 ? "linux" : (platform == 3 ? "windows" : ""));
		string arch = architecture == 1 ? "x86_64" : (architecture == 2 ? "aarch64" : "");
		if (os.isEmpty() || arch.isEmpty()) { return FePackageTarget("", "", ""); }
		GeneratedHostedAbiData data = GeneratedHostedAbiData();
		GeneratedTargetRow? row = FePackageTarget.find(data, os, arch, FePackageTarget.defaultEnvironment(data, os));
		if (row == null || !row.compilerHost) { return FePackageTarget("", "", ""); }
		return FePackageTarget(row.operatingSystem, row.architecture, row.environment);
	}

	class FePackageTarget host() { return FePackageTarget.hostFrom(__btrc_target_platform(), __btrc_target_architecture()); }

	/* Whether this target names a row; only an unrecognized host does not. */
	public bool known() { return !self.operatingSystem.isEmpty(); }

	public GeneratedTargetRow row() {
		GeneratedTargetRow? row = FePackageTarget.find(GeneratedHostedAbiData(), self.operatingSystem, self.architecture, self.environment);
		if (row == null) { throw FePackageTarget.unknownHostMessage(); }
		return row;
	}

	public string label() { return self.known() ? self.row().label : ""; }
}

/* One manifest os/arch/env predicate over the rows of targets.toml. An empty
 * value array matches every value, so the empty selector selects every row;
 * two selectors overlap when some row satisfies both. */
class FeTargetSelector {
	public Vector<string> operatingSystems;
	public Vector<string> architectures;
	public Vector<string> environments;

	public FeTargetSelector(Vector<string> operatingSystems, Vector<string> architectures, Vector<string> environments) {
		self.operatingSystems = operatingSystems;
		self.architectures = architectures;
		self.environments = environments;
	}

	private bool admits(Vector<string> values, string value) { return values.len == 0 || values.contains(value); }

	public bool selects(string operatingSystem, string architecture, string environment) { return self.admits(self.operatingSystems, operatingSystem) && self.admits(self.architectures, architecture) && self.admits(self.environments, environment); }

	public bool selectedFor(FePackageTarget target) { return self.selects(target.operatingSystem, target.architecture, target.environment); }

	public Vector<GeneratedTargetRow> rows() {
		Vector<GeneratedTargetRow> selected = [];
		for row in GeneratedHostedAbiData().targetRows() { if (self.selects(row.operatingSystem, row.architecture, row.environment)) { selected.push(row); } }
		return selected;
	}

	public bool overlaps(FeTargetSelector other) {
		for row in self.rows() { if (other.selects(row.operatingSystem, row.architecture, row.environment)) { return true; } }
		return false;
	}

	/* The values a manifest predicate may name: those of the target rows. */
	class Vector<string> rowValues(string field) {
		Vector<string> values = [];
		for row in GeneratedHostedAbiData().targetRows() {
			string value = field == "os" ? row.operatingSystem : (field == "arch" ? row.architecture : row.environment);
			if (!values.contains(value)) { values.push(value); }
		}
		return values;
	}
}

class FeNativeDeclaration {
	public string kind;
	public string packageName;
	public string value;
	public string detail;
	public string language;
	public string standard;
	public Vector<string> operatingSystems;
	public Vector<string> architectures;
	public Vector<string> modules;
	public Vector<string> environments = [];

	public FeNativeDeclaration(string kind, string packageName, string value, string detail, string language, string standard, Vector<string> operatingSystems, Vector<string> architectures, Vector<string> modules) {
		self.kind = kind;
		self.packageName = packageName;
		self.value = value;
		self.detail = detail;
		self.language = language;
		self.standard = standard;
		self.operatingSystems = operatingSystems;
		self.architectures = architectures;
		self.modules = modules;
	}

	public bool selectedFor(FePackageTarget target) { return FeTargetSelector(self.operatingSystems, self.architectures, self.environments).selectedFor(target); }

	private bool sameValues(Vector<string> left, Vector<string> right) {
		if (left.len != right.len) { return false; }
		int index = 0;
		while (index < left.len) {
			if (!left.get(index).equals(right.get(index))) { return false; }
			index++;
		}
		return true;
	}

	public bool sameIdentity(FeNativeDeclaration other) { return self.kind.equals(other.kind) && self.packageName.equals(other.packageName) && self.value.equals(other.value) && self.detail.equals(other.detail) && self.language.equals(other.language) && self.standard.equals(other.standard) && self.sameValues(self.operatingSystems, other.operatingSystems) && self.sameValues(self.architectures, other.architectures) && self.sameValues(self.environments, other.environments); }

	public string sortKey() { return self.packageName + "\x1f" + self.kind + "\x1f" + self.value + "\x1f" + self.detail + "\x1f" + self.language; }
}

class FeNativeCopiedResultBinding {
	public string kind;
	public string owner;
	public string lengthFunction;
	public Vector<string> lengthArguments;
	public FeNativeCopiedResultBinding(string kind, string owner, string lengthFunction, Vector<string> lengthArguments) {
