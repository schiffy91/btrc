	public string input;
	public string length;
	public string field;
	public FeNativeOutputOffsetBinding(string input, string length, string field) {
		self.input = input; self.length = length; self.field = field;
	}
}

class FeNativeVariadicBinding {
	public string value;
	public Vector<string> arguments;
	public FeNativeVariadicBinding(string value, Vector<string> arguments) { self.value = value; self.arguments = arguments; }
}

class FeNativeRecordSnapshotBinding {
	public string result;
	public string owner;
	public string name;
	public Map<string, string> fields = {};
	public Vector<string> bytePlane = [];
	public Vector<string> guard = [];
	public Map<string, string> strings = {};
	public Vector<string> byteSpan = [];
}

class FeNativeBinding {
	/* Raw record-pointer handles released directly by one selected lifetime
	 * operation, beside managed resources sharing that name. */
	public Map<string, string> unmanagedHandles = {};
	public Map<string, FeNativeCopiedInputBinding> copiedInputs = {};
	public Map<string, FeNativeInitializerBinding> initializers = {};
	public Vector<FeNativeRecordSnapshotBinding> recordSnapshots = [];
	public Map<string, FeNativeCopiedResultBinding> copiedResults = {};
	public Map<string, FeNativeVariadicBinding> variadicCalls = {};
	public Map<string, FeNativeOutputOffsetBinding> outputOffsets = {};
	public Map<string, FeNativeStringView> stringViews = {};
	public Map<string, FeNativeCallbackBinding> callbacks = {};
	public Vector<string> mainThreadGlobals = [];
	public string packageName;
	public string module;
	public string header;
	public string language;
	public string standard;
	public Vector<string> symbols;
	public Vector<string> operatingSystems;
	public Vector<string> architectures;
	public Vector<string> environments = [];
	public Vector<string> readOnlyBorrows;
	public Vector<string> realtimeSafe;
	public Vector<string> ownedRecords;
	public Vector<string> recordInputs;
	public Vector<string> recordOutputs = [];
	public Vector<string> ownedOutputFields = [];
	public Vector<string> nullOutputFields = [];
	public Map<string, string> objectFields;
	public Map<string, FeNativeResourceBinding> resources;
	public Vector<string> ownedResults;
	public Map<string, string> borrowedResults = {};
	public Vector<string> staticGlobals = [];
	public Map<string, string> resourceParameters = {};
	public Map<string, string> resourceResults = {};
	public Map<string, string> ownedOutputs = {};
	public Map<string, FeNativeResourceOutputBinding> ownedOutputResources = {};
	/* Dispatched COM methods ("<R>.<method>") whose failing HRESULT throws, and
	 * owned outputs whose result class carries an HRESULT status. */
	public Map<string, string> statusResults = {};
	public Map<string, string> ownedOutputStatuses = {};
	/* Dispatched COM [out] strings ("<R>.<method>.<parameter>") copied into BTRC
	 * strings, with the allocator's free function, and generated COM sinks in
	 * resource order. */
	public Map<string, string> copiedOutputs = {};
	public Vector<FeNativeComSinkBinding> comSinks = [];
	/* Java natives registrations, by their class's BTRC name. */
	public Vector<FeNativeJavaNativesBinding> javaNatives = [];
	/* Per-class options of a Java binding (executor, weak), by BTRC name. */
	public Vector<FeNativeJavaClassBinding> javaClasses = [];
	/* Objective-C NSError** parameters ("<method>.<parameter>") whose non-nil
	 * error throws after the call (F1). */
	public Vector<string> errorOutputs = [];
	public Vector<string> borrowedParameters;

	public FeNativeBinding(string packageName, string module, string header, string language, string standard, Vector<string> symbols, Vector<string> operatingSystems, Vector<string> architectures) {
		self.packageName = packageName;
		self.module = module;
		self.header = header;
		self.language = language;
		self.standard = standard;
		self.symbols = symbols;
		self.operatingSystems = operatingSystems;
		self.architectures = architectures;
		self.readOnlyBorrows = [];
		self.realtimeSafe = [];
		self.ownedRecords = [];
		self.recordInputs = [];
		self.objectFields = {};
		self.resources = {};
		self.ownedResults = [];
		self.borrowedParameters = [];
	}

	private bool intersects(Vector<string> left, Vector<string> right) {
		for first in left {
			for second in right {
				if (first.equals(second)) { return true; }
			}
		}
		return false;
	}

	public FeTargetSelector selector() { return FeTargetSelector(self.operatingSystems, self.architectures, self.environments); }

	public bool selectedFor(FePackageTarget target) { return self.selector().selectedFor(target); }

	public bool overlaps(FeNativeBinding other) { return self.module.equals(other.module) && self.intersects(self.symbols, other.symbols) && self.selector().overlaps(other.selector()); }

	public string sortKey() { return self.packageName + "\x1f" + self.module + "\x1f" + self.header + "\x1f" + Strings.join(self.symbols, ",") + "\x1f" + Strings.join(self.operatingSystems, ",") + "\x1f" + Strings.join(self.architectures, ",") + "\x1f" + Strings.join(self.environments, ","); }
}

/* A generated COM sink: the `com` resource it implements and the source's
 * Advise and Unadvise. `name` is the factory and `handler` the BTRC handler
 * interface; the factory takes the source, the handler and a CallbackScope
 * and returns the registration (native-interop-ownership.md section 2.4, M2). */
class FeNativeComSinkBinding {
	public string resource;
	public string name;
	public string handler;
	public string registerMethod;
	public string unregisterMethod;
	public string activationFailure;
	public FeNativeComSinkBinding(string resource, string name, string handler, string registerMethod, string unregisterMethod, string activationFailure) {
		self.resource = resource; self.name = name; self.handler = handler;
		self.registerMethod = registerMethod; self.unregisterMethod = unregisterMethod; self.activationFailure = activationFailure;
	}
}

/* A Java class's native methods, bound to a BTRC receiver through
 * RegisterNatives. `owner` is the class's BTRC name and `className` its
 * dotted binary name; `methods` names each native by name and JNI descriptor.
 * `name` is the factory, which takes the receiver and a CallbackScope and
 * returns the registration, and `handler` the generated receiver interface
 * (native-interop-ownership.md section 2.3, "Java -> btrc"). */
class FeNativeJavaNativesBinding {
	public string owner;
	public string className;
	public string name;
	public string handler;
	public Vector<string> methods;
	public string failure;
	public string executor = "caller";
	/* "<method>.argument<N>": array parameters whose borrowed span is writable. */
	public Vector<string> writableArrays = [];
	public FeNativeJavaNativesBinding(string owner, string className, string name, string handler, Vector<string> methods, string failure) {
		self.owner = owner; self.className = className; self.name = name; self.handler = handler;
		self.methods = methods; self.failure = failure;
	}
}

/* Options for one selected Java class, keyed by its BTRC name. `executor` is
 * "main" when every call into the class must run on the main Looper's thread,
 * or "" for any thread; `weak` generates the class's JavaWeak resource,
 * JavaWeak<owner> (native-interop-ownership.md 2.3). */
class FeNativeJavaClassBinding {
	public string owner;
	public string className;
	public string executor;
	public bool weak;
	public FeNativeJavaClassBinding(string owner, string className, string executor, bool weak) {
		self.owner = owner; self.className = className; self.executor = executor; self.weak = weak;
	}
}

class FeNativeInitializerBinding {
	public string resource;
	public string parameter;
	public string result;
	public string success;
	public string copiedInput = "";
	public string length = "";
	public string statusField = "";
}

class FeNativeCopiedInputBinding {
	public string owner;
	public string length;
	public FeNativeCopiedInputBinding(string owner, string length) { self.owner = owner; self.length = length; }
}

class FeModuleProvider {
	public string module;
	public string implementation;
	public Vector<string> operatingSystems;
	public Vector<string> architectures;
	public Vector<string> environments;

	public FeModuleProvider(string module, string implementation, FeTargetSelector selector) {
		self.module = module;
		self.implementation = implementation;
		self.operatingSystems = selector.operatingSystems;
		self.architectures = selector.architectures;
		self.environments = selector.environments;
	}

	public FeTargetSelector selector() { return FeTargetSelector(self.operatingSystems, self.architectures, self.environments); }

	public bool overlaps(FeModuleProvider other) { return self.module == other.module && self.selector().overlaps(other.selector()); }

	public bool selectedFor(FePackageTarget target) { return self.selector().selectedFor(target); }
}

class FeManifestDependency {
	public string alias;
	public string path;
	public string git;
	public string revision;

	public FeManifestDependency(string alias, string path, string git, string revision) {
		self.alias = alias;
		self.path = path;
		self.git = git;
		self.revision = revision;
	}
}

class FePackageNode {
	public string name;
	public string root;
	public Map<string, string> dependencies;
	public string sourcePath;
	public string manifestHash;
	public Vector<FeNativeDeclaration> nativeDeclarations;
	public Vector<FeNativeBinding> bindings;

	public FePackageNode(string name, string root, Map<string, string> dependencies, string sourcePath, string manifestHash, Vector<FeNativeDeclaration> nativeDeclarations) {
		self.name = name;
		self.root = root;
		self.dependencies = dependencies;
		self.sourcePath = sourcePath;
		self.manifestHash = manifestHash;
		self.nativeDeclarations = nativeDeclarations;
		self.bindings = [];
	}
}

class FeParsedPackageManifest {
	public Vector<FeModuleProvider> providers;
	public string name;
	public Vector<FeManifestDependency> dependencies;
	public Vector<FeNativeDeclaration> nativeDeclarations;
	public Vector<FeNativeBinding> bindings;
	public bool restrictedExports = false;
	public Vector<string> exportedModules;
	/* Native blocks, providers and exported module paths finish on demand:
	 * a stdlib group the program never reaches costs its manifest parse only.
	 * User packages finish as soon as they are parsed. */
	public Vector<FeManifestBlock> nativeBlocks;
	public FeManifestBlock? packageFields = null;
	public FePackageManifestParser? finisher = null;
	public bool finished = false;

	public FeParsedPackageManifest(string name, Vector<FeManifestDependency> dependencies, Vector<FeNativeDeclaration> nativeDeclarations) {
		self.providers = [];
		self.name = name;
		self.dependencies = dependencies;
		self.nativeDeclarations = nativeDeclarations;
		self.bindings = [];
		self.exportedModules = [];
		self.nativeBlocks = [];
	}

	public void ensureFinished() {
		FePackageManifestParser? finisher = self.finisher;
		if (finisher != null) { finisher.finishNative(self); }
	}
}

class FeManifestBlock {
	private string tableName;
	private string manifestPath;
	private Map<string, string> fields;
	private Map<string, Map<string, bool>>? inventories = null;

	public FeManifestBlock(string tableName, string manifestPath) {
		self.tableName = tableName;
		self.manifestPath = manifestPath;
		self.fields = {};
	}

	/* Empty blocks carry no optional inventories. Reads must not materialize
	 * storage: most stdlib blocks never declare any of these tables. */
	private bool hasInventory(string kind) { return self.inventories != null && self.inventories.has(kind); }

	private bool hasInventoryName(string kind, string name) {
		Map<string, Map<string, bool>>? inventories = self.inventories;
		if (inventories == null) { return false; }
		return inventories.has(kind) && inventories.get(kind).has(name);
	}

	private int inventoryCount(string kind) {
		Map<string, Map<string, bool>>? inventories = self.inventories;
		if (inventories == null) { return 0; }
		return inventories.has(kind) ? inventories.get(kind).len : 0;
	}

	private Map<string, Map<string, bool>> writableInventories() {
		Map<string, Map<string, bool>>? existing = self.inventories;
		if (existing != null) { return existing; }
		Map<string, Map<string, bool>> inventories = {};
		self.inventories = inventories;
		return inventories;
	}

	private void rememberInventoryName(string kind, string name) {
		var inventories = self.writableInventories();
		if (!inventories.has(kind)) { inventories.put(kind, {}); }
		inventories.get(kind).put(name, true);
	}

	/* Call only for a present inventory, so absent reads allocate no keys. */
	private Vector<string> inventoryNames(string kind) {
		Map<string, Map<string, bool>>? inventories = self.inventories;
		if (inventories == null) { throw "Cannot enumerate an absent manifest inventory"; }
		assert(inventories.has(kind));
		return inventories.get(kind).keys();
	}

	public void declareResource(string name) {
		if (self.hasInventoryName("resourceNames", name)) { FePackageFailure.fail(f"duplicate resource table '{name}'"); }
		self.rememberInventoryName("resourceNames", name);
	}

	public void declareInitializer(string name) {
		if (self.hasInventoryName("initializerTables", name)) { FePackageFailure.fail("duplicate initializer table"); }
		self.rememberInventoryName("initializerTables", name);
	}

	public void declareCopiedInput(string name) {
		if (self.hasInventoryName("copiedInputNames", name)) { FePackageFailure.fail("duplicate copied-inputs table"); }
		self.rememberInventoryName("copiedInputNames", name);
	}

	public void declareCallback(string name) {
		if (self.hasInventoryName("callbackNames", name)) { FePackageFailure.fail(f"duplicate callback table '{name}'"); }
		self.rememberInventoryName("callbackNames", name);
	}

	public void declareCallbackOperations(string name) {
		if (!self.hasInventoryName("callbackNames", name) || self.hasInventoryName("callbackOperationNames", name)) { FePackageFailure.fail("callback operations requires one preceding callback table"); }
		self.rememberInventoryName("callbackOperationNames", name);
	}

	public void declareCallbackMethodNames(string name) {
		if (!self.hasInventoryName("callbackNames", name) || self.hasInventoryName("callbackMethodNameTables", name) || self.fields.has("callbacks." + name + ".method-names")) { FePackageFailure.fail("callback method-names requires one preceding callback table and may not be duplicated"); }
		self.rememberInventoryName("callbackMethodNameTables", name);
	}

	public void declareOwnedOutput(string name) {
		if (self.hasInventoryName("ownedOutputNames", name)) { FePackageFailure.fail(f"duplicate owned-output table '{name}'"); }
		self.rememberInventoryName("ownedOutputNames", name);
	}

	public void declareCopiedOutput(string name) {
		if (self.hasInventoryName("copiedOutputNames", name)) { FePackageFailure.fail(f"duplicate copied-outputs table '{name}'"); }
		self.rememberInventoryName("copiedOutputNames", name);
	}

	public void declareComSink(string name) {
		if (self.hasInventoryName("comSinkNames", name)) { FePackageFailure.fail(f"duplicate com-sinks table '{name}'"); }
		self.rememberInventoryName("comSinkNames", name);
	}

	public void declareJavaNatives(string name) {
		if (self.hasInventoryName("javaNativesNames", name)) { FePackageFailure.fail(f"duplicate natives table '{name}'"); }
		self.rememberInventoryName("javaNativesNames", name);
	}

	/* A Java class options table, which may declare no fields at all. */
	public void declareJavaClass(string name) {
		if (self.hasInventoryName("javaClassNames", name)) { FePackageFailure.fail(f"duplicate classes table '{name}'"); }
		self.rememberInventoryName("javaClassNames", name);
	}

	public void declareOutputOffset(string name) {
		if (self.hasInventoryName("outputOffsetNames", name)) { FePackageFailure.fail(f"duplicate output-offset table '{name}'"); }
		self.rememberInventoryName("outputOffsetNames", name);
	}

	public void declareCopiedResult(string name) {
		if (self.hasInventoryName("copiedResultNames", name)) { FePackageFailure.fail(f"duplicate copied-results table '{name}'"); }
		self.rememberInventoryName("copiedResultNames", name);
	}

	public void declareRecordSnapshot(string name) {
		if (self.hasInventoryName("recordSnapshotNames", name)) { FePackageFailure.fail(f"duplicate record-snapshots table '{name}'"); }
		self.rememberInventoryName("recordSnapshotNames", name);
	}

	public void declareVariadicCall(string name) {
		if (self.hasInventoryName("variadicCallNames", name)) { FePackageFailure.fail(f"duplicate variadic-call table '{name}'"); }
		self.rememberInventoryName("variadicCallNames", name);
	}

	public void declareUnmanagedHandle(string name) {
		if (self.hasInventoryName("unmanagedHandleNames", name)) { FePackageFailure.fail(f"duplicate unmanaged-handles table '{name}'"); }
		self.rememberInventoryName("unmanagedHandleNames", name);
	}

	public void declareStringView(string name) {
		if (self.hasInventoryName("stringViewNames", name)) { FePackageFailure.fail(f"duplicate string-view table '{name}'"); }
		self.rememberInventoryName("stringViewNames", name);
	}

	public void set(string key, string raw) {
		if (self.fields.has(key)) {
			FePackageFailure.fail(f"package manifest '{self.manifestPath}' {self.tableName} " + f"duplicates field '{key}'");
		}
		self.fields.put(key, raw);
	}

	private string context() { return f"package manifest '{self.manifestPath}' {self.tableName}"; }

	private bool allowedField(string key) {
		if (self.isProvider()) { return key == "module" || key == "implementation" || key == "os" || key == "arch" || key == "env"; }
		if (self.isBinding()) {
			if (key.startsWith("record-snapshots.")) { return true; }
			if (key.startsWith("owned-outputs.") || key.startsWith("status-results.")) { return true; }
			if (key.startsWith("copied-outputs.") || key.startsWith("com-sinks.")) { return true; }
			if (key.startsWith("output-offsets.")) { return true; }
			if (key.startsWith("copied-results.") || key.startsWith("initializers.") || key.startsWith("copied-inputs.")) { return true; }
			if (key.startsWith("variadic-calls.")) { return true; }
			if (key.startsWith("string-views.")) { return true; }
			if (key.startsWith("unmanaged-handles.")) { return true; }
			if (key == "main-thread-globals" || key == "error-outputs") { return true; }
			if (key.startsWith("callbacks.")) { return true; }
			if (key.startsWith("resources.") || key.startsWith("borrowed-results.") || key.startsWith("resource-parameters.") || key.startsWith("resource-results.") || key == "owned-results" || key == "borrowed-parameters" || key == "static-globals") { return true; }
			return key.equals("module") || key.equals("header") || key.equals("symbols") || key.equals("language") || key.equals("standard") || key.equals("os") || key.equals("arch") || key.equals("env") || key.equals("read-only-borrows") || key.equals("realtime-safe") || key.equals("owned-records") || key.equals("record-inputs") || key.equals("record-outputs") || key.equals("owned-output-fields") || key.equals("null-output-fields") || key.startsWith("object-fields.");
		}
		if (key.equals("os") || key.equals("arch") || key.equals("env") || key.equals("modules")) { return true; }
		if (self.tableName.equals("native.sources")) {
			return key.equals("path") || key.equals("language") || key.equals("standard");
		}
		if (self.tableName.equals("native.headers") || self.tableName.equals("native.include-directories")) {
			return key.equals("path");
		}
		if (self.tableName.equals("native.defines")) {
			return key.equals("name") || key.equals("value");
		}
		return key.equals("name");
	}

	private string requiredText(string key, bool allowEmpty = false) {
		if (!self.fields.has(key)) {
			FePackageFailure.fail(f"{self.context()} requires field '{key}'");
		}
		string raw = self.fields.get(key).trim();
		int length = raw.length();
		if (length < 2 || !((raw[0] == '"' && raw[length - 1] == '"') || (raw[0] == '\'' && raw[length - 1] == '\''))) {
			FePackageFailure.fail(f"{self.context()}.{key} must be a TOML string");
		}
		string value = TOML.unquote(raw);
		if (value.isEmpty() && !allowEmpty) {
			FePackageFailure.fail(f"{self.context()}.{key} must not be empty");
		}
		return value;
	}

	private bool identifier(string value) {
		if (value.isEmpty() || (!Strings.isAlpha(value[0]) && value[0] != '_')) {
			return false;
		}
		int index = 1;
		while (index < value.length()) {
			if (!Strings.isAlnum(value[index]) && value[index] != '_') {
				return false;
			}
			index++;
		}
		return true;
	}

	private bool nativeName(string value) {
		if (value.isEmpty()) { return false; }
		int index = 0;
		while (index < value.length()) {
			char current = value[index];
			if (!Strings.isAlnum(current) && current != '_' && current != '.' && current != '+' && current != '-') {
				return false;
			}
			index++;
		}
		return true;
	}

	private Vector<string> stringArray(string key, bool ordered = false) {
		Vector<string> values = [];
		if (!self.fields.has(key)) { return values; }
		string raw = self.fields.get(key).trim();
		int length = raw.length();
		if (length < 2 || raw[0] != '[' || raw[length - 1] != ']') {
			FePackageFailure.fail(f"{self.context()}.{key} must be an array of strings");
		}
		string body = raw.substring(1, length - 2).trim();
		if (body.isEmpty()) { return values; }
		Vector<string> parts = Strings.split(body, ",");
		int index = 0;
		while (index < parts.len) {
			string part = parts.get(index).trim();
			if (part.isEmpty() && index == parts.len - 1) {
				index++;
				continue;
			}
			int partLength = part.length();
			if (partLength < 2 || !((part[0] == '"' && part[partLength - 1] == '"') || (part[0] == '\'' && part[partLength - 1] == '\''))) {
				FePackageFailure.fail(f"{self.context()}.{key} must be an array of strings");
			}
			values.push(TOML.unquote(part));
			index++;
		}
		if (!ordered) {
			/* Sorted output makes the duplicate check a neighbour comparison
			 * instead of a scan of every earlier value per element. */
			values.sortBy((string left, string right) => Strings.lessThan(left, right));
			int prior = 1;
			while (prior < values.len) {
				if (values.get(prior - 1).equals(values.get(prior))) {
					FePackageFailure.fail(f"{self.context()}.{key} contains a duplicate value");
				}
				prior++;
			}
		}
		return values;
	}

	private Vector<int> indexArray(string key) {
		Vector<int> values = [];
		if (!self.fields.has(key)) { return values; }
		string raw = self.fields.get(key).trim();
		if (raw.length() < 2 || raw[0] != '[' || raw[raw.length() - 1] != ']') { FePackageFailure.fail(f"{key} requires distinct nonnegative native parameter indices"); }
		string body = raw.substring(1, raw.length() - 2).trim();
		if (body.isEmpty()) { return values; }
		var parts = Strings.split(body, ",");
		for position in range(parts.len) {
			string part = parts.get(position).trim();
			if (part.isEmpty() && position == parts.len - 1) { continue; }
			if (part.isEmpty() || part.length() > 9) { FePackageFailure.fail(f"{key} requires distinct nonnegative native parameter indices"); }
			for character in part { if (character < '0' || character > '9') { FePackageFailure.fail(f"{key} requires distinct nonnegative native parameter indices"); } }
			int value = Strings.toInt(part);
			if (values.contains(value)) { FePackageFailure.fail(f"{key} requires distinct nonnegative native parameter indices"); }
			values.push(value);
		}
		values.sortBy((int left, int right) => left < right);
		return values;
	}

	private Vector<string> targetArray(string key, Vector<string> allowed) {
		Vector<string> values = self.stringArray(key);
		int index = 0;
		while (index < values.len) {
			string value = values.get(index);
			bool accepted = false;
			int allowedIndex = 0;
			while (allowedIndex < allowed.len) {
				if (allowed.get(allowedIndex).equals(value)) {
					accepted = true;
				}
				allowedIndex++;
			}
			if (!accepted) {
				FePackageFailure.fail(f"{self.context()}.{key} contains unsupported value '{value}'");
			}
			index++;
		}
		return values;
	}

	private FeTargetSelector targetSelector() { return FeTargetSelector(self.targetArray("os", FeTargetSelector.rowValues("os")), self.targetArray("arch", FeTargetSelector.rowValues("arch")), self.targetArray("env", FeTargetSelector.rowValues("env"))); }

	/* A module under a platform directory selects exactly that platform. */
	private void requirePlatformDirectories(Vector<string> modules, FeTargetSelector selector) {
		Vector<string> platforms = FeTargetSelector.rowValues("os");
		for module in modules {
			Vector<string> segments = Strings.split(module, ".");
			int index = 0;
			while (index < segments.len - 1) {
				string segment = segments.get(index);
				string platform = segment.toLower();
				if (platforms.contains(platform) && (selector.operatingSystems.len != 1 || selector.operatingSystems.get(0) != platform)) {
					FePackageFailure.fail(self.context() + ": module '" + module + "' lives under " + segment + "/ and must select os = [\"" + platform + "\"]");
				}
				index++;
			}
		}
	}

	private bool moduleName(string value) {
		Vector<string> segments = Strings.split(value, ".");
		if (segments.len == 0) { return false; }
		int index = 0;
		while (index < segments.len) {
			if (!self.identifier(segments.get(index))) { return false; }
			index++;
		}
		return true;
	}

	public Vector<string> modulePaths(string root, string field = "modules", bool allowEmpty = false) {
		Vector<string> result = [];
		Vector<string> modules = [];
		if (self.isProvider()) { modules.push(self.requiredText(field)); }
		else if (self.isBinding()) { modules.push(self.requiredText("module")); }
		else {
			if (!self.fields.has(field)) { return result; }
			modules = self.stringArray(field);
		}
		if (modules.len == 0 && !allowEmpty) {
			FePackageFailure.fail(f"{self.context()}.{field} must not be empty");
		}
		string canonicalRoot = FeCanonicalPath.absolute(root);
		string prefix = canonicalRoot.endsWith(Platform.pathSeparator()) ? canonicalRoot : canonicalRoot + Platform.pathSeparator();
		string comparedRoot = Platform.isWindows() ? canonicalRoot.toLower() : canonicalRoot;
		string comparedPrefix = Platform.isWindows() ? prefix.toLower() : prefix;
		/* A package without a src/ directory cannot hold modules there, so
		 * one directory probe replaces one failed file probe per module. */
		string sourceRoot = PathTools.join(root, "src");
		bool hasSourceRoot = FileSystem.isDir(sourceRoot);
		int index = 0;
		while (index < modules.len) {
			string module = modules.get(index);
			if (!self.moduleName(module)) {
				FePackageFailure.fail(f"{self.context()}.{field} contains invalid module '{module}'");
			}
			string relative = module.replace(".", Platform.pathSeparator()) + ".btrc";
			string underSource = PathTools.join(sourceRoot, relative);
			string underRoot = PathTools.join(root, relative);
			string selected = hasSourceRoot && FileSystem.isFile(underSource) ? underSource : (FileSystem.isFile(underRoot) ? underRoot : "");
			if (selected.isEmpty()) {
				FePackageFailure.fail(f"{self.context()}.{field} names unknown module '{module}'");
			}
			string canonical = FeCanonicalPath.absolute(selected);
			string compared = Platform.isWindows() ? canonical.toLower() : canonical;
			if (!compared.equals(comparedRoot) && !compared.startsWith(comparedPrefix)) {
				FePackageFailure.fail(f"{self.context()}.{field} module '{module}' escapes " + f"package root '{canonicalRoot}'");
			}
			result.push(canonical);
			index++;
		}
		return result;
	}

	private string packagePath(string root, string key, bool directory) {
		string relative = self.requiredText(key);
		if (PathTools.isAbsolute(relative)) {
			FePackageFailure.fail(f"{self.context()}.{key} must be package-relative");
		}
		string canonicalRoot = FeCanonicalPath.absolute(root);
		string candidate = FeCanonicalPath.absolute(PathTools.join(root, relative));
		string prefix = canonicalRoot.endsWith(Platform.pathSeparator()) ? canonicalRoot : canonicalRoot + Platform.pathSeparator();
		string comparedRoot = Platform.isWindows() ? canonicalRoot.toLower() : canonicalRoot;
		string comparedCandidate = Platform.isWindows() ? candidate.toLower() : candidate;
		string comparedPrefix = Platform.isWindows() ? prefix.toLower() : prefix;
		if (!comparedCandidate.equals(comparedRoot) && !comparedCandidate.startsWith(comparedPrefix)) {
			FePackageFailure.fail(f"{self.context()}.{key} escapes package root '{canonicalRoot}'");
		}
		bool present = false;
		if (directory) { present = FileSystem.isDir(candidate); }
		else { present = FileSystem.isFile(candidate); }
		if (!present) {
			string kind = directory ? "directory" : "file";
			FePackageFailure.fail(f"{self.context()}.{key} does not name a {kind}: '{relative}'");
		}
		return candidate;
	}

	private void validateFields() {
		Vector<string> keys = self.fields.keys();
		int keyIndex = 0;
		while (keyIndex < keys.len) {
			if (!self.allowedField(keys.get(keyIndex))) {
				FePackageFailure.fail(f"{self.context()} contains unexpected field " + f"'{keys.get(keyIndex)}'");
			}
			keyIndex++;
		}
	}

	private void validateLanguage(string language, string standard) {
		bool valid = false;
		if (language.equals("c") || language.equals("objective-c")) { valid = standard.equals("c11"); }
		else if (language.equals("c++") || language.equals("objective-c++")) { valid = standard.equals("c++17") || standard.equals("c++20"); }
		if (!valid) { FePackageFailure.fail(f"{self.context()} has unsupported language/standard '{language}/{standard}'"); }
	}

	public bool isBinding() { return self.tableName.equals("native.bindings"); }

	public bool isProvider() { return self.tableName == "package.providers"; }

	public FeModuleProvider finishProvider(string root) {
		self.validateFields();
		string module = self.modulePaths(root, "module").get(0);
		string implementation = self.modulePaths(root, "implementation").get(0);
		if (module == implementation) { FePackageFailure.fail(f"{self.context()} cannot select its own module as implementation"); }
		FeTargetSelector selector = self.targetSelector();
		Vector<string> implementations = [self.requiredText("implementation")];
		self.requirePlatformDirectories(implementations, selector);
		return FeModuleProvider(module, implementation, selector);
	}

	private bool nativeSymbol(string symbol, string language) {
		if ((language == "objective-c" || language == "objective-c++") && (symbol.startsWith("+[") || symbol.startsWith("-[")) && symbol.endsWith("]")) {
			var parts = Strings.split(symbol.substring(2, symbol.length() - 3), " ");
			if (parts.len != 2 || !self.identifier(parts.get(0))) { return false; }
			string selector = parts.get(1);
			if (self.identifier(selector)) { return true; }
			if (!selector.endsWith(":")) { return false; }
			for label in Strings.split(selector.substring(0, selector.length() - 1), ":") { if (!self.identifier(label)) { return false; } }
			return true;
		}
		for component in Strings.split(symbol, "::") { if (!self.identifier(component)) { return false; } }
		return !symbol.isEmpty();
	}

	private void finishCallbacks(FeNativeBinding binding) {
		for key in self.fields.keys() {
			if (!key.startsWith("callbacks.")) { continue; }
			var parts = Strings.split(key, ".");
			if ((parts.len == 5 || parts.len == 6) && (parts.get(3) == "method-names" || parts.get(3) == "super-admission") && binding.symbols.contains(parts.get(1)) && self.identifier(parts.get(2))) { continue; }
			if (parts.len == 5 && parts.get(3) == "operations" && self.identifier(parts.get(4)) && binding.symbols.contains(parts.get(1)) && self.identifier(parts.get(2))) { continue; }
			if (parts.len != 4 || !binding.symbols.contains(parts.get(1)) || !self.identifier(parts.get(2))) { FePackageFailure.fail("callbacks must name selected function.parameter pairs"); }
			string field = parts.get(3);
			if (field != "context" && field != "context-index" && field != "interface" && field != "lifetime" && field != "failure" && field != "executor" && field != "unregister" && field != "activation-failure" && field != "cancellation" && field != "methods" && field != "method-names" && field != "super-admission" && field != "slot-getter" && field != "action-setter" && field != "action-getter" && field != "action-parameter" && field != "owned-arguments" && field != "field" && field != "name" && field != "record" && field != "size" && field != "owner" && field != "invocation" && field != "scope" && field != "registration-status" && field != "unregister-status" && field != "captured-handles" && field != "terminal" && field != "superclass" && field != "overrides") { FePackageFailure.fail(f"unexpected callback field '{field}'"); }
			self.rememberInventoryName("callbackNames", parts.get(1) + "." + parts.get(2));
		}
		if (!self.hasInventory("callbackNames")) { return; }
		for name in self.inventoryNames("callbackNames") {
			var parts = Strings.split(name, ".");
			if (parts.len != 2 || !binding.symbols.contains(parts.get(0)) || !self.identifier(parts.get(1))) { FePackageFailure.fail("callbacks must name selected function.parameter pairs"); }
			string prefix = "callbacks." + name + ".";
			bool hasContext = self.fields.has(prefix + "context") || self.fields.has(prefix + "context-index") || binding.language == "c";
			Vector<string> contexts = [];
			if (hasContext) {
				if (self.fields.getOrDefault(prefix + "context", "").trim().startsWith("[")) { contexts = self.stringArray(prefix + "context"); }
				else { contexts.push(self.requiredText(prefix + "context")); }
				for context in contexts { if (!self.identifier(context)) { FePackageFailure.fail("callback context must be an identifier"); } }
			}
			string interfaceName = self.requiredText(prefix + "interface");
			if (!self.identifier(interfaceName)) { FePackageFailure.fail("callback interface must be an identifier"); }
			if (binding.symbols.contains(interfaceName)) { FePackageFailure.fail("callback interface conflicts with another imported name"); }
			string lifetime = self.requiredText(prefix + "lifetime");
			if (lifetime != "call" && lifetime != "stored" && lifetime != "one-shot" && lifetime != "instantiated") { FePackageFailure.fail("callback lifetime requires call, stored, one-shot or instantiated"); }
			string scope = self.fields.has(prefix + "scope") ? self.requiredText(prefix + "scope") : "";
			/* A subclass adapter maps the implicit self of its superclass's
			 * designated initializer: BTRC creates the instance there. */
			bool subclass = parts.get(1) == "self";
			bool subclassFacts = self.fields.has(prefix + "superclass") || self.fields.has(prefix + "overrides");
			if (subclassFacts && lifetime != "instantiated") { FePackageFailure.fail("superclass and overrides require an instantiated adapter"); }
			if (lifetime == "instantiated") {
				/* The SDK creates the adapter from a class name (UIApplicationMain)
				 * or a class (a scene configuration); the binding only names the
				 * protocol methods it answers. */
				if (binding.language != "objective-c" || hasContext) { FePackageFailure.fail("instantiated adapters require an Objective-C binding without context"); }
				if (scope != "process" && scope != "instance") { FePackageFailure.fail("instantiated adapter scope requires process or instance"); }
				if (subclass) {
					if (!self.fields.has(prefix + "superclass")) { FePackageFailure.fail("an initializer's self parameter requires superclass"); }
					if (scope != "instance") { FePackageFailure.fail("subclass adapters require scope instance"); }
				}
				/* The forms the SDK instantiates (a class name, a Class) may
				 * extend an SDK class too, such as a UIResponder app delegate. */
				if (self.fields.has(prefix + "overrides") && !self.fields.has(prefix + "superclass")) { FePackageFailure.fail("callback overrides require superclass"); }
				if (self.fields.has(prefix + "superclass") && !self.identifier(self.requiredText(prefix + "superclass"))) { FePackageFailure.fail("callback superclass must be an identifier"); }
				for field in ["unregister", "activation-failure", "cancellation", "slot-getter", "action-setter", "action-getter", "action-parameter", "owned-arguments", "field"] {
					if (self.fields.has(prefix + field) && !(field == "cancellation" && (self.fields.has(prefix + "super-admission") || self.hasInventoryName("callbackSuperTables", name)))) { FePackageFailure.fail("instantiated adapters take only methods, scope, terminal, failure and executor"); }
				}
			} else if (self.fields.has(prefix + "scope") || self.fields.has(prefix + "terminal")) { FePackageFailure.fail("callback scope and terminal require an instantiated adapter"); }
			var realtime = self.realtimeCallback(binding, prefix, lifetime, interfaceName);
			bool controlAction = self.fields.has(prefix + "action-parameter");
			if (controlAction) {
				/* The control keeps every target it is given and calls the
				 * compiler's selector; the unregister call names the same pair. */
				if (lifetime != "stored" || binding.language != "objective-c" || hasContext) { FePackageFailure.fail("control actions require a stored Objective-C callback"); }
				if (self.fields.has(prefix + "methods") || self.fields.has(prefix + "slot-getter") || self.fields.has(prefix + "action-setter") || self.fields.has(prefix + "action-getter")) { FePackageFailure.fail("control actions take no methods, slot-getter or action accessors"); }
			}
			string unregister = "";
			string activationFailure = "";
			if (lifetime == "stored") {
				if (binding.language != "objective-c" && binding.language != "c" && realtime == null) { FePackageFailure.fail("stored callbacks require C functions or Objective-C blocks"); }
				unregister = self.requiredText(prefix + "unregister");
				if (!binding.symbols.contains(unregister)) { FePackageFailure.fail("callback unregister must name a selected native method"); }
				activationFailure = self.requiredText(prefix + "activation-failure");
				if (activationFailure != "unpublished" && activationFailure != "abort") { FePackageFailure.fail("callback activation-failure requires unpublished or abort"); }
				if (self.requiredText(prefix + "cancellation") != "entry-barrier") { FePackageFailure.fail("callback cancellation requires entry-barrier"); }
			} else if (lifetime == "one-shot") {
				if (self.fields.has(prefix + "unregister") || (binding.language == "objective-c" && hasContext)) { FePackageFailure.fail("one-shot requires an Objective-C block without unregister/context"); }
				activationFailure = self.requiredText(prefix + "activation-failure");
				if (activationFailure != "unpublished" && activationFailure != "abort") { FePackageFailure.fail("callback activation-failure requires unpublished or abort"); }
				if (self.requiredText(prefix + "cancellation") != "abandon") { FePackageFailure.fail("one-shot cancellation requires abandon"); }
			} else if (lifetime != "instantiated" && (self.fields.has(prefix + "unregister") || self.fields.has(prefix + "activation-failure") || self.fields.has(prefix + "cancellation"))) { FePackageFailure.fail("cancellation facts require a stored callback"); }
			if (controlAction && (unregister == parts.get(0) || activationFailure != "abort")) { FePackageFailure.fail("control actions require a separate unregister and activation-failure abort"); }
			if (self.requiredText(prefix + "failure") != "abort") { FePackageFailure.fail("callback failure currently requires abort"); }
			/* A stored Objective-C block may be bound to the main thread, as a
			 * main-queue notification observer is (native-interop-ownership.md
			 * section 1, rules 3 and 4): registration and every entry are checked
			 * there, and a final holder release elsewhere is posted to it. */
			string executor = self.requiredText(prefix + "executor");
			bool delegateFacts = self.fields.has(prefix + "methods") || self.fields.has(prefix + "slot-getter") || self.fields.has(prefix + "action-setter") || self.fields.has(prefix + "action-getter");
			bool mainBlock = executor == "main" && lifetime == "stored" && binding.language == "objective-c" && !hasContext && !controlAction && !delegateFacts;
			if (executor != "caller" && realtime == null && !mainBlock) { FePackageFailure.fail("callback executor currently requires caller, or main for a stored Objective-C block"); }
			string raw = self.fields.getOrDefault(prefix + "context-index", "").trim();
			Vector<int> contextIndices = [];
			if (hasContext) {
				if (raw.startsWith("[")) { contextIndices = self.indexArray(prefix + "context-index"); }
				else {
					if (raw.isEmpty() || raw.length() > 9) { FePackageFailure.fail("callback context-index must be a nonnegative native parameter index"); }
					for character in raw { if (character < '0' || character > '9') { FePackageFailure.fail("callback context-index must be a nonnegative native parameter index"); } }
					contextIndices.push(Strings.toInt(raw));
				}
				if (contexts.len == 0 || contexts.len != contextIndices.len) { FePackageFailure.fail("context/context-index require equally sized nonempty distinct slots"); }
			}
			var callback = FeNativeCallbackBinding(name, contexts, contextIndices, interfaceName, lifetime, unregister, activationFailure);
			callback.realtime = realtime;
			callback.executor = executor;
			if (self.fields.has(prefix + "field")) {
				callback.field = self.requiredText(prefix + "field");
				if (!self.identifier(callback.field) || binding.language != "c" || (lifetime != "one-shot" && realtime == null)) { FePackageFailure.fail("callback field requires a C one-shot callback and a field identifier"); }
			}
			bool storedC = lifetime == "stored" && binding.language == "c" && realtime == null;
			if (contextIndices.len > 1 && callback.field.isEmpty() && !storedC) { FePackageFailure.fail("multiple context slots require a callback field"); }
			bool registrationFacts = self.fields.has(prefix + "registration-status") || self.fields.has(prefix + "unregister-status");
			if (registrationFacts && !storedC) { FePackageFailure.fail("registration and unregister facts require a stored C registration"); }
			if (self.fields.has(prefix + "captured-handles") && !storedC && !controlAction) { FePackageFailure.fail("captured-handles requires a stored C registration or control action"); }
			if (storedC) {
				Vector<string> statuses = ["nonzero", "positive", "nonnegative", "zero"];
				if (self.fields.has(prefix + "registration-status")) { callback.registrationStatus = self.requiredText(prefix + "registration-status"); }
				if (self.fields.has(prefix + "unregister-status")) { callback.unregisterStatus = self.requiredText(prefix + "unregister-status"); }
				if ((!callback.registrationStatus.isEmpty() && !statuses.contains(callback.registrationStatus)) || (!callback.unregisterStatus.isEmpty() && !statuses.contains(callback.unregisterStatus))) { FePackageFailure.fail("callback statuses require nonzero, positive, nonnegative or zero"); }
				if (contexts.len == 0) { FePackageFailure.fail("a stored C registration requires its context slots"); }
			}
			if (storedC || controlAction) {
				callback.capturedHandles = self.stringArray(prefix + "captured-handles");
				Map<string, bool> captured = {};
				for name in callback.capturedHandles {
					if (!self.identifier(name) || captured.has(name)) { FePackageFailure.fail("callback captured-handles must list distinct registration parameters"); }
					captured.put(name, true);
				}
			}
			if (controlAction) {
				callback.actionParameter = self.requiredText(prefix + "action-parameter");
				if (!self.identifier(callback.actionParameter)) { FePackageFailure.fail("callback action-parameter must be an identifier"); }
			}
			if (self.fields.has(prefix + "owned-arguments") && (binding.language != "c" || lifetime != "one-shot")) { FePackageFailure.fail("owned-arguments requires a C one-shot callback"); }
			callback.ownedArguments = self.indexArray(prefix + "owned-arguments");
			bool action = self.fields.has(prefix + "action-setter") || self.fields.has(prefix + "action-getter");
			if (lifetime == "instantiated") {
				callback.scope = scope;
				Map<string, bool> overridden = {};
				if (self.fields.has(prefix + "superclass")) {
					callback.superclass = self.requiredText(prefix + "superclass");
					if (self.fields.has(prefix + "overrides")) {
						callback.overrides = self.stringArray(prefix + "overrides");
						if (callback.overrides.len == 0) { FePackageFailure.fail("callback overrides must name selected native methods"); }
						for method in callback.overrides {
							if (!binding.symbols.contains(method)) { FePackageFailure.fail("callback overrides must name selected native methods"); }
							if (overridden.has(method)) { FePackageFailure.fail("callback overrides contains a duplicate value"); }
							overridden.put(method, true);
						}
					}
				}
				callback.methods = self.stringArray(prefix + "methods");
				/* A subclass adapter may answer only superclass methods. */
				if (callback.methods.len == 0 && (!subclass || callback.overrides.len == 0)) { FePackageFailure.fail("instantiated methods must name selected native methods"); }
				Map<string, bool> seen = {};
				for method in callback.methods {
					if (!binding.symbols.contains(method)) { FePackageFailure.fail("instantiated methods must name selected native methods"); }
					if (seen.has(method)) { FePackageFailure.fail("instantiated methods contains duplicate methods"); }
					if (overridden.has(method)) { FePackageFailure.fail("callback methods and overrides must be distinct"); }
					seen.put(method, true);
				}
				/* An instance-scoped adapter releases its receiver after the
				 * terminal method; a process root is never released. A subclass
				 * instance without one releases it at dealloc. */
				bool terminal = self.fields.has(prefix + "terminal");
				if (scope == "instance" && !terminal && !subclass) { FePackageFailure.fail("instance-scoped instantiated adapters require terminal"); }
				if (scope == "process" && terminal) { FePackageFailure.fail("callback terminal requires scope instance"); }
				if (terminal) {
					callback.terminal = self.requiredText(prefix + "terminal");
					if (!seen.has(callback.terminal) && !overridden.has(callback.terminal)) { FePackageFailure.fail("callback terminal must name one of methods"); }
				}
			} else if (self.fields.has(prefix + "methods") || self.fields.has(prefix + "slot-getter") || action) {
				if (lifetime != "stored" || binding.language != "objective-c" || hasContext) { FePackageFailure.fail("delegate methods require a stored Objective-C callback"); }
				if (action) {
					callback.actionSetter = self.requiredText(prefix + "action-setter");
					callback.actionGetter = self.requiredText(prefix + "action-getter");
					if (self.fields.has(prefix + "methods") || !binding.symbols.contains(callback.actionSetter) || !binding.symbols.contains(callback.actionGetter)) { FePackageFailure.fail("actions require selected action-setter/action-getter and no methods"); }
				} else {
					callback.methods = self.stringArray(prefix + "methods");
					if (callback.methods.len == 0) { FePackageFailure.fail("delegate methods must name selected native methods"); }
					for method in callback.methods { if (!binding.symbols.contains(method)) { FePackageFailure.fail("delegate methods must name selected native methods"); } }
				}
				callback.slotGetter = self.requiredText(prefix + "slot-getter");
				if (!binding.symbols.contains(callback.slotGetter)) { FePackageFailure.fail("slot-getter must name a selected native method"); }
				if (unregister != parts.get(0) || activationFailure != "abort") { FePackageFailure.fail("delegate cancellation requires its setter and activation-failure abort"); }
			}
			self.finishCallbackMethodNames(binding, callback, name);
			self.finishCallbackSuper(binding, callback, name);
			binding.callbacks.put(name, callback);
		}
		if (binding.callbacks.len > 0 && binding.language != "c" && binding.language != "objective-c") { FePackageFailure.fail("callback mappings currently require C or Objective-C"); }
	}

	/* Inline maps here have two known levels: selected selector and its hooks.
	 * Split only at this table's depth, preserving quoted selectors. */
	private Map<string, string> callbackInlineTable(string raw) {
		string value = raw.trim();
		if (!value.startsWith("{") || !value.endsWith("}")) { FePackageFailure.fail("super-admission requires a method table"); }
		string body = value.substring(1, value.length() - 2).trim();
		Map<string, string> fields = {};
		while (!body.isEmpty()) {
			int depth = 0;
			char quote = (char)0;
			bool escaped = false;
			int comma = -1;
			for index in range(body.length()) {
				char c = body[index];
				if (quote != (char)0) {
					if (!escaped && c == quote) { quote = (char)0; }
					escaped = quote == '"' && !escaped && c == '\\';
					continue;
				}
				if (c == '"' || c == (char)39) { quote = c; }
				else if (c == '{') { depth++; }
				else if (c == '}') { depth--; }
				else if (c == ',' && depth == 0) { comma = index; break; }
				if (depth < 0) { FePackageFailure.fail("super-admission requires a method table"); }
			}
			if (quote != (char)0 || depth != 0) { FePackageFailure.fail("super-admission requires a method table"); }
			string entry = comma < 0 ? body : body.substring(0, comma);
			int separator = TOML.unquotedPosition(entry, '=');
			if (separator < 0) { FePackageFailure.fail("super-admission requires named hooks"); }
			string name = TOML.unquote(entry.substring(0, separator).trim());
			if (name.isEmpty() || fields.has(name)) { FePackageFailure.fail("super-admission contains duplicate or empty names"); }
			fields.put(name, entry.substring(separator + 1, entry.length() - separator - 1).trim());
			body = comma < 0 ? "" : body.substring(comma + 1, body.length() - comma - 1).trim();
			if (comma >= 0 && body.isEmpty()) { FePackageFailure.fail("super-admission inline table has a trailing comma"); }
		}
		return fields;
	}

	public void declareCallbackSuper(string name) {
		if (!self.hasInventoryName("callbackNames", name) || self.hasInventoryName("callbackSuperDeclaredTables", name) || self.fields.has("callbacks." + name + ".super-admission")) { FePackageFailure.fail("super-admission requires one preceding callback table and may not be duplicated"); }
		self.rememberInventoryName("callbackSuperTables", name);
		self.rememberInventoryName("callbackSuperDeclaredTables", name);
	}

	public void declareCallbackSuperHook(string name, string symbol) {
		string key = name + "." + symbol;
		if (!self.hasInventoryName("callbackNames", name) || self.hasInventoryName("callbackSuperHookTables", key) || self.fields.has("callbacks." + name + ".super-admission") || self.fields.has("callbacks." + name + ".super-admission." + symbol)) { FePackageFailure.fail("super-admission hook table is duplicated or has no callback"); }
		self.rememberInventoryName("callbackSuperTables", name);
		self.rememberInventoryName("callbackSuperHookTables", key);
	}

	private void finishCallbackSuper(FeNativeBinding binding, FeNativeCallbackBinding callback, string name) {
		string prefix = "callbacks." + name + ".super-admission";
		Map<string, Map<string, string>> entries = {};
		bool present = self.fields.has(prefix) || self.hasInventoryName("callbackSuperTables", name);
		if (self.fields.has(prefix)) {
			var raw = self.callbackInlineTable(self.fields.get(prefix));
			for symbol in raw.keys() { entries.put(symbol, self.callbackInlineTable(raw.get(symbol))); }
		}
		string tablePrefix = name + ".";
		if (self.hasInventory("callbackSuperHookTables")) {
			for key in self.inventoryNames("callbackSuperHookTables") {
				if (key.startsWith(tablePrefix)) { entries.put(key.substring(tablePrefix.length(), key.length() - tablePrefix.length()), {}); }
			}
		}
		for key in self.fields.keys() {
			if (!key.startsWith(prefix + ".")) { continue; }
			if (self.fields.has(prefix)) { FePackageFailure.fail("super-admission table is duplicated"); }
			present = true;
			var path = Strings.split(key.substring(prefix.length() + 1, key.length() - prefix.length() - 1), ".");
			if (path.len == 1) {
				if (entries.has(path.get(0))) { FePackageFailure.fail("super-admission hook table is duplicated"); }
				entries.put(path.get(0), self.callbackInlineTable(self.fields.get(key)));
			} else if (path.len == 2) {
				if (self.fields.has(prefix + "." + path.get(0))) { FePackageFailure.fail("super-admission hook table is duplicated"); }
				if (!entries.has(path.get(0))) { entries.put(path.get(0), {}); }
				entries.get(path.get(0)).put(path.get(1), self.fields.get(key));
			} else { FePackageFailure.fail("super-admission requires before and after names"); }
		}
		if (!present) { return; }
		if (entries.len == 0) { FePackageFailure.fail("super-admission requires a nonempty method table"); }
		string base = "callbacks." + name + ".";
		if (binding.language != "objective-c" || callback.lifetime != "instantiated" || !name.endsWith(".self") || callback.scope != "instance") { FePackageFailure.fail("super-admission requires a designated-initializer instance adapter"); }
		if (!self.fields.has(base + "cancellation") || self.requiredText(base + "cancellation") != "entry-barrier") { FePackageFailure.fail("super-admission requires cancellation entry-barrier"); }
		if (self.fields.has(base + "methods") || self.fields.has(base + "terminal") || self.fields.has(base + "method-names") || self.hasInventoryName("callbackMethodNameTables", name)) { FePackageFailure.fail("super-admission cannot combine methods, terminal or method-names"); }
		if (entries.len != callback.overrides.len) { FePackageFailure.fail("super-admission must map every override exactly once"); }
		Map<string, bool> names = {};
		for symbol in entries.keys() {
			if (!callback.overrides.contains(symbol)) { FePackageFailure.fail("super-admission must map every override exactly once"); }
			var hooks = entries.get(symbol);
			if (!hooks.has("before") || !hooks.has("after") || hooks.len != 2 + (hooks.has("refused-result") ? 1 : 0) + (hooks.has("before-arguments") ? 1 : 0)) { FePackageFailure.fail("super-admission requires before and after names"); }
			if (hooks.has("refused-result")) {
				string value = hooks.get("refused-result");
				if (value != "true" && value != "false") { FePackageFailure.fail("super-admission refused-result must be a bool"); }
				callback.superRefusedResult.put(symbol, value == "true");
			}
			if (hooks.has("before-arguments")) {
				string value = hooks.get("before-arguments");
				if (value.length() < 2 || !((value[0] == '"' && value[value.length()-1] == '"') || (value[0] == (char)39 && value[value.length()-1] == (char)39))) { FePackageFailure.fail("super-admission before-arguments must be all or none"); }
				string mode = TOML.unquote(value);
				if (mode != "all" && mode != "none") { FePackageFailure.fail("super-admission before-arguments must be all or none"); }
				callback.superBeforeArguments.put(symbol, mode == "all");
			}
			for hook in ["before", "after"] {
				string value = hooks.get(hook);
				if (value.length() < 2 || !((value[0] == '"' && value[value.length()-1] == '"') || (value[0] == (char)39 && value[value.length()-1] == (char)39))) { FePackageFailure.fail("super-admission hook names must be strings"); }
				string projected = TOML.unquote(value);
				if (!self.identifier(projected)) { FePackageFailure.fail("super-admission hook names must be identifiers"); }
				if (names.has(projected)) { FePackageFailure.fail("super-admission hook names must be distinct"); }
				names.put(projected, true);
				if (hook == "before") { callback.superBefore.put(symbol, projected); }
				else { callback.superAfter.put(symbol, projected); }
			}
		}
	}

	private void callbackMethodName(FeNativeCallbackBinding callback, string symbol, string name) {
		if (!callback.methods.contains(symbol) && !callback.overrides.contains(symbol)) { FePackageFailure.fail("callback method-names must name selected callback methods or overrides"); }
		if (!self.identifier(name)) { FePackageFailure.fail("callback method-names must be an ASCII identifier"); }
		if (callback.methodNames.has(symbol)) { FePackageFailure.fail("callback method-names contains a duplicate method"); }
		callback.methodNames.put(symbol, name);
	}

	private void finishCallbackMethodNames(FeNativeBinding binding, FeNativeCallbackBinding callback, string name) {
		string prefix = "callbacks." + name + ".method-names";
		bool table = self.hasInventoryName("callbackMethodNameTables", name);
		for key in self.fields.keys() { if (key.startsWith(prefix + ".")) { table = true; } }
		if (!table && !self.fields.has(prefix)) { return; }
		if (binding.language != "objective-c" || (callback.methods.len == 0 && callback.overrides.len == 0)) { FePackageFailure.fail("callback method-names requires Objective-C methods or overrides"); }
		if (self.fields.has(prefix)) {
			if (table) { FePackageFailure.fail("callback method-names table is duplicated"); }
			string raw = self.fields.get(prefix).trim();
			if (!raw.startsWith("{") || !raw.endsWith("}")) { FePackageFailure.fail("callback method-names must be a table"); }
			string body = raw.substring(1, raw.length() - 2).trim();
			while (!body.isEmpty()) {
				int comma = TOML.unquotedPosition(body, ',');
				string entry = comma < 0 ? body : body.substring(0, comma);
				int separator = TOML.unquotedPosition(entry, '=');
				if (separator < 0) { FePackageFailure.fail("callback method-names requires string entries"); }
				string key = entry.substring(0, separator).trim();
				int keyLength = key.length();
				if (keyLength < 2 || !((key[0] == '"' && key[keyLength - 1] == '"') || (key[0] == '\'' && key[keyLength - 1] == '\''))) { FePackageFailure.fail("callback method-names requires quoted method symbols"); }
				string symbol = TOML.unquote(key);
				string value = entry.substring(separator + 1, entry.length() - separator - 1).trim();
				int length = value.length();
				if (length < 2 || !((value[0] == '"' && value[length - 1] == '"') || (value[0] == '\'' && value[length - 1] == '\''))) { FePackageFailure.fail("callback method-names requires string entries"); }
				self.callbackMethodName(callback, symbol, TOML.unquote(value));
				body = comma < 0 ? "" : body.substring(comma + 1, body.length() - comma - 1).trim();
				if (comma >= 0 && body.isEmpty()) { FePackageFailure.fail("callback method-names inline table has a trailing comma"); }
			}
		}
		for key in self.fields.keys() {
			if (!key.startsWith(prefix + ".")) { continue; }
			string symbol = key.substring(prefix.length() + 1, key.length() - prefix.length() - 1);
			self.callbackMethodName(callback, symbol, self.requiredText(key));
		}
	}

	private FeNativeRealtimeCallbackBinding? realtimeCallback(FeNativeBinding binding, string prefix, string lifetime, string interfaceName) {
		Vector<string> names = ["name", "record", "size", "owner", "invocation"];
		if (self.requiredText(prefix + "executor") != "realtime") {
			for name in names { if (self.fields.has(prefix + name)) { FePackageFailure.fail("callback operation facts require executor realtime"); } }
			for key in self.fields.keys() { if (key.startsWith(prefix + "operations.")) { FePackageFailure.fail("callback operation facts require executor realtime"); } }
			return null;
		}
		if (binding.language != "c" || lifetime != "stored" || !self.fields.has(prefix + "field") || self.requiredText(prefix + "activation-failure") != "abort") { FePackageFailure.fail("realtime requires a stored C callback record, owner, invocation and operations"); }
		for field in ["methods", "slot-getter", "action-setter", "action-getter", "action-parameter", "owned-arguments"] { if (self.fields.has(prefix + field)) { FePackageFailure.fail("realtime callback cannot combine other callback projections"); } }
		for name in names { if (!self.identifier(self.requiredText(prefix + name))) { FePackageFailure.fail("realtime callback fields require identifiers"); } }
		var result = FeNativeRealtimeCallbackBinding(self.requiredText(prefix + "name"), self.requiredText(prefix + "record"), self.requiredText(prefix + "size"), self.requiredText(prefix + "owner"), self.requiredText(prefix + "invocation"));
		if (!binding.symbols.contains(result.record) || binding.symbols.contains(result.name) || binding.symbols.contains(result.invocation) || result.name == result.invocation || result.name == interfaceName || result.invocation == interfaceName || result.size == result.owner) { FePackageFailure.fail("realtime callback names or selected record conflict"); }
		string operations = prefix + "operations.";
		for key in self.fields.keys() {
			if (!key.startsWith(operations)) { continue; }
			string method = key.substring(operations.length(), key.length() - operations.length());
			string parameter = self.requiredText(key);
			var parts = Strings.split(parameter, ".");
			if (!self.identifier(method) || parts.len != 2 || !binding.symbols.contains(parts.get(0)) || !self.identifier(parts.get(1))) { FePackageFailure.fail("callback operations requires named selected function.parameter pairs"); }
			result.operations.put(method, parameter);
		}
		if (result.operations.len == 0) { FePackageFailure.fail("callback operations requires named selected function.parameter pairs"); }
		return result;
	}

	private void finishStringViews(FeNativeBinding binding) {
		for key in self.fields.keys() {
			if (!key.startsWith("string-views.")) { continue; }
			var parts = Strings.split(key, ".");
			if (parts.len != 3 || !self.identifier(parts.get(1)) || !binding.symbols.contains(parts.get(1)) || binding.language != "c") { FePackageFailure.fail("string-views must map selected C records to text facts"); }
			string field = parts.get(2);
			if (field != "data" && field != "length" && field != "null-length") { FePackageFailure.fail("unexpected string-view field"); }
			self.rememberInventoryName("stringViewNames", parts.get(1));
		}
		if (!self.hasInventory("stringViewNames")) { return; }
		for name in self.inventoryNames("stringViewNames") {
			if (!binding.symbols.contains(name) || binding.language != "c") { FePackageFailure.fail("string-views must map selected C records to text facts"); }
			string prefix = "string-views." + name + ".";
			string data = self.requiredText(prefix + "data");
			string length = self.requiredText(prefix + "length");
			string nullLength = self.requiredText(prefix + "null-length");
			if (!self.identifier(data) || !self.identifier(length) || data == length || (nullLength != "zero" && nullLength != "zero-or-max")) { FePackageFailure.fail("string views require distinct fields and null-length zero or zero-or-max"); }
			binding.stringViews.put(name, FeNativeStringView(name, data, length, nullLength == "zero-or-max"));
		}
	}

	private void finishVariadicCalls(FeNativeBinding binding) {
		Map<string, bool> extraFields = {};
		for key in self.fields.keys() {
			if (!key.startsWith("variadic-calls.")) { continue; }
			var parts = Strings.split(key, ".");
			// `function.selector` binds an opcode constant; a bare `function`
			// fixes one tail for every call and keeps the selector visible.
			if (parts.len == 3) {
				if (parts.get(2) != "arguments") { extraFields.put(parts.get(1), true); }
				self.rememberInventoryName("variadicCallNames", parts.get(1));
				continue;
			}
			if (parts.len != 4 || !["value", "arguments"].contains(parts.get(3))) { FePackageFailure.fail("variadic-calls requires value and arguments"); }
			self.rememberInventoryName("variadicCallNames", parts.get(1) + "." + parts.get(2));
		}
		Map<string, bool> functions = {};
		Vector<string> promoted = ["int", "unsigned int", "long", "unsigned long", "long long", "unsigned long long", "double"];
		Vector<string> pointees = ["int", "unsigned int", "long", "unsigned long", "long long", "unsigned long long", "double", "char", "signed char", "unsigned char", "short", "unsigned short", "float"];
		if (!self.hasInventory("variadicCallNames")) { return; }
		for name in self.inventoryNames("variadicCallNames") {
			var parts = Strings.split(name, ".");
			bool whole = parts.len == 1;
			string prefix = "variadic-calls." + name + ".";
			if (whole) {
				if (binding.language != "c" || !binding.symbols.contains(name)) { FePackageFailure.fail("variadic-calls must name selected functions"); }
				if (extraFields.has(name) || !self.fields.has(prefix + "arguments")) { FePackageFailure.fail("variadic-calls requires only arguments for a whole function"); }
			} else if (binding.language != "c" || parts.len > 2 || !binding.symbols.contains(parts.get(0)) || !self.identifier(parts.get(1))) { FePackageFailure.fail("variadic-calls requires selected C function.parameter paths"); }
			string value = whole ? "" : self.requiredText(prefix + "value");
			Vector<string> arguments = self.stringArray(prefix + "arguments", true);
			if (!whole && !binding.symbols.contains(value)) { FePackageFailure.fail("variadic-calls value must name a selected SDK constant"); }
			if (arguments.len == 0) { FePackageFailure.fail("variadic-calls arguments must be a nonempty native scalar type list"); }
			for argument in arguments {
				string pointee = argument.endsWith("*") ? argument.substring(0, argument.length() - 1) : "";
				if (pointee.startsWith("const ")) { pointee = pointee.substring(6, pointee.length() - 6); }
				if (!promoted.contains(argument) && !pointees.contains(pointee)) { FePackageFailure.fail("variadic-calls requires promoted scalars or scalar pointers"); }
			}
			if (functions.has(parts.get(0))) { FePackageFailure.fail("variadic-calls selects exactly one shape per function"); }
			functions.put(parts.get(0), true);
			binding.variadicCalls.put(name, FeNativeVariadicBinding(value, arguments));
		}
	}

	private void finishOwnedOutputs(FeNativeBinding binding) {
		for key in self.fields.keys() {
			if (!key.startsWith("owned-outputs.")) { continue; }
			var parts = Strings.split(key, ".");
			string field = parts.get(parts.len - 1);
			/* A dispatched COM method's output is named "<R>.<method>.<parameter>". */
			if ((parts.len != 4 && parts.len != 5) || !["result", "resource", "size", "name", "status"].contains(field)) { FePackageFailure.fail("owned-outputs requires only a result class; adoption is unconditional"); }
			self.rememberInventoryName("ownedOutputNames", key.substring(14, key.length() - 15 - field.length()));
		}
		Map<string, bool> functions = {};
		Map<string, bool> results = {};
		if (!self.hasInventory("ownedOutputNames")) { return; }
		for name in self.inventoryNames("ownedOutputNames") {
			var parts = Strings.split(name, ".");
			bool dispatched = parts.len == 3 && self.identifier(parts.get(2)) && self.dispatchedMethod(binding, parts.get(0) + "." + parts.get(1));
			if (!dispatched && (parts.len != 2 || !binding.symbols.contains(parts.get(0)) || !self.identifier(parts.get(1)))) { FePackageFailure.fail("owned-outputs must name selected function.parameter paths"); }
			string method = dispatched ? parts.get(0) + "." + parts.get(1) : parts.get(0);
			string result = self.requiredText("owned-outputs." + name + ".result");
			if (!self.identifier(result)) { FePackageFailure.fail("owned-outputs result must be an identifier"); }
			if (functions.has(method) || results.has(result) || binding.symbols.contains(result)) { FePackageFailure.fail("owned-outputs requires one output per function and distinct result classes"); }
			functions.put(method, true); results.put(result, true);
			binding.ownedOutputs.put(name, result);
			string prefix = "owned-outputs." + name + ".";
			if (self.fields.has(prefix + "status")) {
				if (self.fields.has(prefix + "resource") || self.fields.has(prefix + "size") || self.fields.has(prefix + "name")) { FePackageFailure.fail("owned-outputs requires only a result class; adoption is unconditional"); }
				if (self.requiredText(prefix + "status") != "hresult") { FePackageFailure.fail("owned-outputs status must be hresult"); }
				binding.ownedOutputStatuses.put(name, "hresult");
			}
		}
		Map<string, bool> aliases = {};
		for name in self.inventoryNames("ownedOutputNames") {
			string prefix = "owned-outputs." + name + ".";
			if (!self.fields.has(prefix + "resource") && !self.fields.has(prefix + "size") && !self.fields.has(prefix + "name")) { continue; }
			string resource = self.requiredText(prefix + "resource"); string size = self.requiredText(prefix + "size"); string alias = self.requiredText(prefix + "name");
			if (!self.identifier(resource) || !self.identifier(size) || !self.identifier(alias)) { FePackageFailure.fail("erased owned-outputs fields must be identifiers"); }
			if (!binding.resources.has(resource) || binding.resources.get(resource).ownership != "reference-counted") { FePackageFailure.fail("erased owned-outputs requires a declared reference-counted resource"); }
			if (binding.symbols.contains(alias) || results.has(alias) || aliases.has(alias) || size == Strings.split(name, ".").get(1)) { FePackageFailure.fail("erased owned-outputs requires distinct alias, result and output parameters"); }
			aliases.put(alias, true); binding.ownedOutputResources.put(name, FeNativeResourceOutputBinding(resource, size, alias));
		}
		if (self.inventoryCount("ownedOutputNames") > 0 && (binding.language != "c" || binding.resources.len == 0)) { FePackageFailure.fail("owned-outputs requires declared C resources"); }
	}

	private void finishRecordSnapshots(FeNativeBinding binding) {
		Map<string, bool> results = {};
		Map<string, bool> names = {};
		for name in binding.symbols { names.put(name, true); }
		if (self.hasInventory("recordSnapshotNames")) {
			for table in self.inventoryNames("recordSnapshotNames") {
				var parts = Strings.split(table, ".");
				if (parts.len > 2 || (parts.len == 2 && !["fields", "byte-plane", "guard", "strings", "byte-span"].contains(parts.get(1)))) { FePackageFailure.fail("invalid record-snapshots table"); }
				results.put(parts.get(0), true);
			}
		}
		for key in self.fields.keys() {
			if (!key.startsWith("record-snapshots.")) { continue; }
			var parts = Strings.split(key, ".");
			bool scalar = parts.len == 3 && ["owner", "name", "fields", "strings", "guard", "byte-span"].contains(parts.get(2));
			bool field = parts.len == 4 && ["fields", "strings"].contains(parts.get(2)) && self.identifier(parts.get(3));
			bool plane = parts.len == 4 && parts.get(2) == "byte-plane" && ["field", "pointer", "width", "rows", "pitch"].contains(parts.get(3));
			bool guard = parts.len == 4 && parts.get(2) == "guard" && ["field", "equals"].contains(parts.get(3));
			bool span = parts.len == 4 && parts.get(2) == "byte-span" && ["field", "pointer", "length"].contains(parts.get(3));
			if ((!scalar && !field && !plane && !guard && !span) || !self.identifier(parts.get(1))) { FePackageFailure.fail("invalid record-snapshots field"); }
			results.put(parts.get(1), true);
		}
		var ordered = results.keys();
		ordered.sortBy((string left, string right) => Strings.lessThan(left, right));
		for result in ordered {
			if (binding.language != "c" || names.has(result) || !self.identifier(result)) { FePackageFailure.fail("record-snapshots requires distinct C result class names"); }
			string prefix = "record-snapshots." + result + ".";
			var snapshot = FeNativeRecordSnapshotBinding();
			snapshot.result = result;
			snapshot.owner = self.requiredText(prefix + "owner");
			snapshot.name = self.requiredText(prefix + "name");
			if (!binding.resources.has(snapshot.owner) || !self.identifier(snapshot.name) || names.has(snapshot.name) || snapshot.name == result) { FePackageFailure.fail("record-snapshots requires a selected resource and distinct function name"); }
			bool declaredFields = self.hasInventoryName("recordSnapshotNames", result + ".fields");
			if (self.fields.has(prefix + "fields")) {
				if (declaredFields) { FePackageFailure.fail("record-snapshots fields table is duplicated"); }
				declaredFields = true;
				string raw = self.fields.get(prefix + "fields").trim();
				if (!raw.startsWith("{") || !raw.endsWith("}")) { FePackageFailure.fail("record-snapshots fields requires a table"); }
				string body = raw.substring(1, raw.length() - 2).trim();
				if (!body.isEmpty()) {
					for part in Strings.split(body, ",") {
						string alias = TOML.key(part);
						int separator = part.indexOf("=");
						string value = separator < 0 ? "" : part.substring(separator + 1, part.length() - separator - 1).trim();
						int length = value.length();
						if (length < 2 || !((value[0] == '"' && value[length - 1] == '"') || (value[0] == '\'' && value[length - 1] == '\''))) { FePackageFailure.fail("record-snapshots field paths must be TOML strings"); }
						string path = TOML.value(part);
						if (!self.identifier(alias) || snapshot.fields.has(alias) || !self.moduleName(path)) { FePackageFailure.fail("record-snapshots requires distinct scalar aliases and dotted SDK paths"); }
						snapshot.fields.put(alias, path);
					}
				}
			}
			for key in self.fields.keys() {
				if (!key.startsWith(prefix + "fields.")) { continue; }
				declaredFields = true;
				string alias = key.substring(prefix.length() + 7, key.length() - prefix.length() - 7);
				string path = self.requiredText(key);
				if (!self.identifier(alias) || snapshot.fields.has(alias) || !self.moduleName(path)) { FePackageFailure.fail("record-snapshots requires distinct scalar aliases and dotted SDK paths"); }
				snapshot.fields.put(alias, path);
			}
			if (!declaredFields) { FePackageFailure.fail("record-snapshots requires a fields table"); }
			snapshot.strings = self.snapshotTable(result, "strings");
			for alias in snapshot.strings.keys() { if (!self.identifier(alias) || snapshot.fields.has(alias) || !self.moduleName(snapshot.strings.get(alias))) { FePackageFailure.fail("record-snapshots strings requires distinct aliases and SDK paths"); } }
			var guard = self.snapshotTable(result, "guard");
			if (guard.len > 0 || self.hasInventoryName("recordSnapshotNames", result + ".guard") || self.fields.has(prefix + "guard")) {
				if (guard.len != 2 || !guard.has("field") || !guard.has("equals")) { FePackageFailure.fail("record-snapshots guard requires field and equals"); }
				if (!self.moduleName(guard.get("field")) || !binding.symbols.contains(guard.get("equals"))) { FePackageFailure.fail("record-snapshots guard requires an SDK path and selected constant"); }
				snapshot.guard.push(guard.get("field")); snapshot.guard.push(guard.get("equals"));
			}
			var span = self.snapshotTable(result, "byte-span");
			if (span.len > 0 || self.hasInventoryName("recordSnapshotNames", result + ".byte-span") || self.fields.has(prefix + "byte-span")) {
				if (span.len != 3 || !span.has("field") || !span.has("pointer") || !span.has("length")) { FePackageFailure.fail("record-snapshots byte-span requires field, pointer and length"); }
				if (!self.identifier(span.get("field")) || snapshot.fields.has(span.get("field")) || snapshot.strings.has(span.get("field")) || !self.moduleName(span.get("pointer")) || !self.moduleName(span.get("length"))) { FePackageFailure.fail("record-snapshots byte-span requires a distinct byte field and SDK paths"); }
				for field in ["field", "pointer", "length"] { snapshot.byteSpan.push(span.get(field)); }
			}
			bool plane = self.hasInventoryName("recordSnapshotNames", result + ".byte-plane");
			for key in self.fields.keys() { if (key.startsWith(prefix + "byte-plane.")) { plane = true; } }
			if (plane) {
				if (snapshot.byteSpan.len > 0) { FePackageFailure.fail("record-snapshots cannot combine byte-span and byte-plane"); }
				for field in ["field", "pointer", "width", "rows", "pitch"] {
					string value = self.requiredText(prefix + "byte-plane." + field);
					if ((field == "field" && (!self.identifier(value) || snapshot.fields.has(value) || snapshot.strings.has(value))) || (field != "field" && !self.moduleName(value))) { FePackageFailure.fail("record-snapshots requires a distinct byte field and dotted SDK paths"); }
					snapshot.bytePlane.push(value);
				}
			}
			if (snapshot.fields.len == 0 && !plane && snapshot.strings.len == 0 && snapshot.byteSpan.len == 0) { FePackageFailure.fail("record-snapshots requires copied fields"); }
			names.put(result, true); names.put(snapshot.name, true);
			binding.recordSnapshots.push(snapshot);
		}
	}

	private Map<string, string> snapshotTable(string result, string table) {
		string prefix = "record-snapshots." + result + "." + table;
		Map<string, string> values = {};
		if (self.fields.has(prefix)) {
			if (self.hasInventoryName("recordSnapshotNames", result + "." + table)) { FePackageFailure.fail("record-snapshots table is duplicated"); }
			string raw = self.fields.get(prefix).trim();
			if (!raw.startsWith("{") || !raw.endsWith("}")) { FePackageFailure.fail("record-snapshots requires TOML tables"); }
			string body = raw.substring(1, raw.length() - 2).trim();
			if (!body.isEmpty()) {
				for part in Strings.split(body, ",") {
					string alias = TOML.key(part); int separator = part.indexOf("=");
					string value = separator < 0 ? "" : part.substring(separator + 1, part.length() - separator - 1).trim();
					int length = value.length();
					if (length < 2 || !((value[0] == '"' && value[length - 1] == '"') || (value[0] == '\'' && value[length - 1] == '\'')) || values.has(alias)) { FePackageFailure.fail("record-snapshots values must be distinct TOML strings"); }
					values.put(alias, TOML.value(part));
				}
			}
		}
		for key in self.fields.keys() {
			if (!key.startsWith(prefix + ".")) { continue; }
			string alias = key.substring(prefix.length() + 1, key.length() - prefix.length() - 1);
			if (values.has(alias)) { FePackageFailure.fail("record-snapshots values are duplicated"); }
			values.put(alias, self.requiredText(key));
		}
		return values;
	}

	private void finishCopiedResults(FeNativeBinding binding) {
		for key in self.fields.keys() {
			if (!key.startsWith("copied-results.")) { continue; }
			var parts = Strings.split(key, ".");
			if (parts.len != 3 || !["kind", "owner", "lifetime", "length-function", "length-arguments", "length-preserves-result"].contains(parts.get(2))) { FePackageFailure.fail("invalid copied-results field"); }
			self.rememberInventoryName("copiedResultNames", parts.get(1));
		}
		if (!self.hasInventory("copiedResultNames")) { return; }
		for name in self.inventoryNames("copiedResultNames") {
			bool cppMethod = false;
			if (binding.language == "c++") {
				for resource in binding.resources.keys() {
					for selected in binding.resources.get(resource).methods {
						string method = selected.endsWith("()") ? selected.substring(0, selected.length() - 2) : selected;
						if (name == resource + "::" + method) { cppMethod = true; }
					}
				}
			}
			if (!cppMethod && (binding.language != "c" || !binding.symbols.contains(name))) { FePackageFailure.fail("copied-results requires selected C functions or C++ methods"); }
			string prefix = "copied-results." + name + ".";
			string kind = self.requiredText(prefix + "kind");
			string owner = self.fields.has(prefix + "owner") ? self.requiredText(prefix + "owner") : "";
			bool lifetime = self.fields.has(prefix + "lifetime");
			if (kind != "string" && kind != "bytes") { FePackageFailure.fail("copied-results kind must be string or bytes"); }
			if (cppMethod && (kind != "string" || owner != "self" || lifetime)) { FePackageFailure.fail("C++ copied-results requires selected instance strings with owner = self"); }
			if ((!owner.isEmpty() && (!self.identifier(owner) || lifetime)) || (owner.isEmpty() && (!lifetime || self.requiredText(prefix + "lifetime") != "static"))) { FePackageFailure.fail("copied-results requires one owner or static lifetime"); }
			string lengthFunction = ""; Vector<string> arguments = [];
			if (kind == "bytes") {
				if (owner.isEmpty()) { FePackageFailure.fail("copied bytes require a resource owner"); }
				lengthFunction = self.requiredText(prefix + "length-function");
				arguments = self.stringArray(prefix + "length-arguments", true);
				if (!binding.symbols.contains(lengthFunction) || !self.fields.has(prefix + "length-preserves-result") || self.fields.get(prefix + "length-preserves-result") != "true") { FePackageFailure.fail("copied bytes require a selected length-function and explicit no-invalidation promise"); }
				for argument in arguments { if (!self.identifier(argument)) { FePackageFailure.fail("copied bytes length-arguments must name parameters"); } }
			} else if (self.fields.has(prefix + "length-function") || self.fields.has(prefix + "length-arguments") || self.fields.has(prefix + "length-preserves-result")) { FePackageFailure.fail("copied strings do not accept byte length fields"); }
			binding.copiedResults.put(name, FeNativeCopiedResultBinding(kind, owner, lengthFunction, arguments));
		}
	}

	private void finishOutputOffsets(FeNativeBinding binding) {
		for key in self.fields.keys() {
			if (!key.startsWith("output-offsets.")) { continue; }
			var parts = Strings.split(key, ".");
			if (parts.len != 4 || !["input", "length", "field"].contains(parts.get(3))) { FePackageFailure.fail("output-offsets requires input, length, and field"); }
			self.rememberInventoryName("outputOffsetNames", parts.get(1) + "." + parts.get(2));
		}
		Map<string, bool> functions = {};
		if (!self.hasInventory("outputOffsetNames")) { return; }
		for name in self.inventoryNames("outputOffsetNames") {
			var parts = Strings.split(name, ".");
			if (parts.len != 2 || !binding.symbols.contains(parts.get(0)) || !self.identifier(parts.get(1))) { FePackageFailure.fail("output-offsets must name selected function.parameter paths"); }
			string prefix = "output-offsets." + name + ".";
			if (!self.fields.has(prefix + "input") || !self.fields.has(prefix + "length") || !self.fields.has(prefix + "field")) { FePackageFailure.fail("output-offsets requires input, length, and field"); }
			string input = self.requiredText(prefix + "input");
			string length = self.requiredText(prefix + "length");
			string field = self.requiredText(prefix + "field");
			if (!self.identifier(input) || !self.identifier(length) || !self.identifier(field)) { FePackageFailure.fail("output-offsets fields must be identifiers"); }
			bool hasOwner = false;
			for owned in binding.ownedOutputs.keys() { if (owned.startsWith(parts.get(0) + ".")) { hasOwner = true; } }
			if (!hasOwner || functions.has(parts.get(0))) { FePackageFailure.fail("output-offsets requires one offset alongside an owned output"); }
			if (parts.get(1) == input || parts.get(1) == length || input == length || field == "status" || field == "value") { FePackageFailure.fail("output-offsets requires distinct parameters and a fresh result field"); }
			functions.put(parts.get(0), true);
			binding.outputOffsets.put(name, FeNativeOutputOffsetBinding(input, length, field));
		}
	}

	/* Raw handles whose selected lifetime operation BTRC may call directly: a
	 * Core Foundation run-loop timer held in plain data is released with
	 * CFRelease while other bindings manage CF objects through it. Only a call
	 * passing exactly such a handle is admitted; the operation stays reserved
	 * everywhere else. */
	private void finishUnmanagedHandles(FeNativeBinding binding) {
		for key in self.fields.keys() {
			if (!key.startsWith("unmanaged-handles.")) { continue; }
			var parts = Strings.split(key, ".");
			if (parts.len != 3 || parts.get(2) != "release") { FePackageFailure.fail(f"{self.context()}.{key} is not an unmanaged-handles field"); }
			string handle = parts.get(1);
			string releaseName = self.requiredText(key);
			if (!binding.symbols.contains(handle) || binding.resources.has(handle) || !binding.symbols.contains(releaseName) || releaseName == handle) {
				FePackageFailure.fail(f"{self.context()}.unmanaged-handles.{handle} requires a selected record-pointer typedef that is not a resource and a selected release");
			}
			binding.unmanagedHandles.put(handle, releaseName);
		}
		if (self.hasInventory("unmanagedHandleNames")) {
			for name in self.inventoryNames("unmanagedHandleNames") {
				if (!binding.unmanagedHandles.has(name)) { FePackageFailure.fail(f"{self.context()}.unmanaged-handles.{name} must declare its release"); }
			}
		}
		if (binding.unmanagedHandles.len > 0 && binding.language != "c") { FePackageFailure.fail(f"{self.context()}.unmanaged-handles requires a C binding"); }
		for handle in binding.unmanagedHandles.keys() {
			string releaseName = binding.unmanagedHandles.get(handle);
			if (binding.ownedResults.contains(releaseName)) { FePackageFailure.fail("resource lifetime operations are reserved"); }
			for parameter in binding.borrowedParameters { if (Strings.split(parameter, ".").get(0) == releaseName) { FePackageFailure.fail("resource lifetime operations are reserved"); } }
		}
	}

	private void finishResources(FeNativeBinding binding) {
		Map<string, bool> operations = {};
		Map<string, bool> aliases = {};
		for key in self.fields.keys() {
			if (!key.startsWith("resources.")) { continue; }
			var parts = Strings.split(key, ".");
			if (parts.len >= 4 && (parts.get(2) == "table" || parts.get(2) == "dispatch")) {
				if (binding.language == "c++" || !self.identifier(parts.get(1)) || !binding.symbols.contains(parts.get(1))) { FePackageFailure.fail("callback tables require a selected C resource"); }
				self.rememberInventoryName("resourceNames", parts.get(1));
				continue;
			}
			if (parts.len != 3 || !(binding.language == "c++" ? self.nativeSymbol(parts.get(1), binding.language) : self.identifier(parts.get(1))) || !binding.symbols.contains(parts.get(1))) { FePackageFailure.fail("resources must name selected SDK types"); }
			string field = parts.get(2);
			if (binding.language == "c++") {
				if (!["name", "ownership", "methods", "constructor", "release", "owner"].contains(field)) { FePackageFailure.fail(f"unexpected C++ resource field '{field}'"); }
			} else if (field != "ownership" && field != "retain" && field != "release" && field != "release-consumption" && field != "cleanup-status" && field != "type-query" && field != "type-tag" && field != "storage" && field != "iid" && field != "base" && field != "release-executor") { FePackageFailure.fail(f"unexpected resource field '{field}'"); }
			self.rememberInventoryName("resourceNames", parts.get(1));
		}
		/* Resources finish in name order so both compilers publish the same declaration order. */
		Vector<string> orderedNames = [];
		if (self.hasInventory("resourceNames")) {
			for name in self.inventoryNames("resourceNames") { orderedNames.push(name); }
		}
		orderedNames.sortBy((string left, string right) => Strings.lessThan(left, right));
		for name in orderedNames {
			if (binding.language == "c++") {
				self.finishCppResource(binding, name, aliases);
				continue;
			}
			if (!self.identifier(name) || !binding.symbols.contains(name)) { FePackageFailure.fail("resources must name selected typedefs"); }
			string prefix = "resources." + name + ".";
			string ownership = self.requiredText(prefix + "ownership");
			if (ownership != "reference-counted" && ownership != "unique" && ownership != "com") { FePackageFailure.fail("resource ownership requires reference-counted, unique or com"); }
			if (ownership == "com") {
				binding.resources.put(name, self.comResource(binding, name));
				continue;
			}
			if (self.fields.has(prefix + "iid") || self.fields.has(prefix + "base")) { FePackageFailure.fail("iid and base require a com resource"); }
			self.releaseExecutor(prefix, ownership);
			if (ownership == "unique" && self.fields.has(prefix + "retain")) { FePackageFailure.fail("unique resources must not declare retain"); }
			string consumption = self.fields.has(prefix + "release-consumption") ? self.requiredText(prefix + "release-consumption") : "";
			string cleanup = self.fields.has(prefix + "cleanup-status") ? self.requiredText(prefix + "cleanup-status") : "";
			string storage = self.fields.has(prefix + "storage") ? self.requiredText(prefix + "storage") : "";
			if (self.fields.has(prefix + "storage") && (storage != "inline" || ownership != "unique")) { FePackageFailure.fail("storage requires inline unique ownership"); }
			if (!storage.isEmpty() && consumption == "success-or-indeterminate") { FePackageFailure.fail("inline storage does not support indeterminate destruction"); }
			if (self.fields.has(prefix + "release-consumption") || self.fields.has(prefix + "cleanup-status")) {
				if (ownership != "unique" || !((consumption == "always" && cleanup == "discard") || (consumption == "success-or-indeterminate" && cleanup == "abort"))) { FePackageFailure.fail("status release requires unique and matching release-consumption/cleanup-status: always/discard or success-or-indeterminate/abort"); }
			}
			string retainFunction = ownership == "unique" ? "" : self.requiredText(prefix + "retain");
			FeNativeDispatchTable? dispatch = self.hasKeyPrefix(prefix + "dispatch.") ? self.dispatchTable(prefix + "dispatch.", ownership, storage) : null;
			bool releaseSlot = dispatch != null && !dispatch.releaseSlot.isEmpty();
			/* A dispatch release slot is the destructor in place of a release function. */
			if (releaseSlot && (self.fields.has(prefix + "release") || !consumption.isEmpty())) { FePackageFailure.fail("a dispatch release slot replaces the resource release function"); }
			string releaseFunction = releaseSlot ? "" : self.requiredText(prefix + "release");
			if (retainFunction == releaseFunction && !releaseFunction.isEmpty()) { FePackageFailure.fail("resource lifetime operations must be distinct"); }
			for operation in [retainFunction, releaseFunction] {
				if (ownership == "unique" && operation.isEmpty()) { continue; }
				if (!self.identifier(operation) || !binding.symbols.contains(operation)) { FePackageFailure.fail("resource retain/release must name selected functions"); }
				if (self.hasInventoryName("resourceNames", operation)) { FePackageFailure.fail("resource lifetime operations must be distinct from resource types"); }
				operations.put(operation, true);
			}
			string query = self.fields.has(prefix + "type-query") ? self.requiredText(prefix + "type-query") : "";
			string tag = self.fields.has(prefix + "type-tag") ? self.requiredText(prefix + "type-tag") : "";
			if (self.fields.has(prefix + "type-query") || self.fields.has(prefix + "type-tag")) {
				if (ownership != "reference-counted" || !binding.symbols.contains(query) || !binding.symbols.contains(tag) || query == tag) { FePackageFailure.fail("type-query/type-tag require distinct selected functions on a reference-counted resource"); }
			}
			var resource = FeNativeResourceBinding(name, ownership, retainFunction, releaseFunction, consumption, cleanup, query, tag, storage);
			if (self.hasKeyPrefix(prefix + "table.")) { resource.table = self.callbackTable(binding, prefix + "table.", ownership, storage); }
			if (resource.table != null && dispatch != null) { FePackageFailure.fail("a resource either implements a table or dispatches through one"); }
			resource.dispatch = dispatch;
			binding.resources.put(name, resource);
		}
		binding.ownedResults = self.stringArray("owned-results");
		binding.borrowedParameters = self.stringArray("borrowed-parameters");
		for key in self.fields.keys() {
			if (!key.startsWith("borrowed-results.")) { continue; }
			string symbol = key.substring(17, key.length() - 17);
			string owner = self.requiredText(key);
			if (!binding.symbols.contains(symbol) || !self.identifier(owner) || !binding.borrowedParameters.contains(symbol + "." + owner)) { FePackageFailure.fail("borrowed-results must map selected functions to declared borrowed owner parameters"); }
			if (binding.ownedResults.contains(symbol)) { FePackageFailure.fail("owned-results and borrowed-results must be distinct"); }
			binding.borrowedResults.put(symbol, owner);
		}
		for name in binding.ownedResults {
			if (!binding.symbols.contains(name)) { FePackageFailure.fail("owned-results must name selected functions"); }
			if (operations.has(name)) { FePackageFailure.fail("resource lifetime operations are reserved"); }
		}
		for parameter in binding.borrowedParameters {
			var parts = Strings.split(parameter, ".");
			if (parts.len != 2 || !binding.symbols.contains(parts.get(0)) || !self.identifier(parts.get(1))) { FePackageFailure.fail("borrowed-parameters must name selected function.parameter pairs"); }
			if (operations.has(parts.get(0))) { FePackageFailure.fail("resource lifetime operations are reserved"); }
		}
		/* Objective-C NSError** outputs the adapter supplies (F1). */
		binding.errorOutputs = self.stringArray("error-outputs");
		Map<string, bool> errorOutputs = {};
		for parameter in binding.errorOutputs {
			var parts = Strings.split(parameter, ".");
			if (parts.len != 2 || !binding.symbols.contains(parts.get(0)) || !self.identifier(parts.get(1))) { FePackageFailure.fail("error-outputs must name selected function.parameter pairs"); }
			if (errorOutputs.has(parameter)) { FePackageFailure.fail("error-outputs contains a duplicate value"); }
			errorOutputs.put(parameter, true);
		}
		if (binding.errorOutputs.len > 0 && binding.language != "objective-c") { FePackageFailure.fail("error-outputs require an Objective-C binding"); }
		if (binding.resources.len > 0 || binding.ownedResults.len > 0 || binding.borrowedParameters.len > 0 || binding.borrowedResults.len > 0) {
			if (binding.language != "c" && binding.language != "c++") { FePackageFailure.fail("resource bindings require C or C++"); }
			if (binding.language == "c++" && (binding.ownedResults.len > 0 || binding.borrowedParameters.len > 0 || binding.borrowedResults.len > 0)) { FePackageFailure.fail("C++ resource methods carry ownership through their receiver"); }
			if (binding.resources.len == 0) { FePackageFailure.fail("resource ownership requires declared resources"); }
		}
	}

	private bool hasKeyPrefix(string prefix) {
		for key in self.fields.keys() { if (key.startsWith(prefix)) { return true; } }
		return false;
	}

	/* A resource's final-release executor, from the closed executor vocabulary
	 * (native-interop-ownership.md section 1, rule 3): today only a COM
	 * interface declares one, `apartment`. */
	private string releaseExecutor(string prefix, string ownership) {
		bool declared = self.fields.has(prefix + "release-executor");
		string executor = declared ? self.requiredText(prefix + "release-executor") : "";
		if (declared && !["caller", "main", "main-context", "apartment", "any"].contains(executor)) { FePackageFailure.fail("release-executor must be caller, main, main-context, apartment or any"); }
		if ((declared || ownership == "com") && (ownership != "com" || executor != "apartment")) { FePackageFailure.fail("release-executor currently requires apartment on a com resource"); }
		return executor;
	}

	/* A COM interface record whose AddRef, Release and QueryInterface are its lpVtbl slots 0-2. */
	private FeNativeResourceBinding comResource(FeNativeBinding binding, string name) {
		string prefix = "resources." + name + ".";
		for key in self.fields.keys() {
			if (!key.startsWith(prefix)) { continue; }
			string field = key.substring(prefix.length(), key.length() - prefix.length());
			if (field != "ownership" && field != "iid" && field != "base" && field != "release-executor" && !field.startsWith("dispatch.")) { FePackageFailure.fail("com resources take AddRef, Release and QueryInterface from lpVtbl"); }
		}
		string iid = self.fields.has(prefix + "iid") ? self.requiredText(prefix + "iid") : "";
		if (!self.identifier(iid) || !binding.symbols.contains(iid)) { FePackageFailure.fail("com resources require a selected iid"); }
		string base = self.fields.has(prefix + "base") ? self.requiredText(prefix + "base") : "";
		if (self.fields.has(prefix + "base") && (base == name || !self.hasInventoryName("resourceNames", base) || !self.fields.has("resources." + base + ".ownership") || self.requiredText("resources." + base + ".ownership") != "com")) { FePackageFailure.fail("com base requires another com resource of the binding"); }
		Map<string, bool> visited = {};
		visited.put(name, true);
		string current = base;
		while (!current.isEmpty()) {
			if (visited.has(current)) { FePackageFailure.fail("com base chain must not be cyclic"); }
			visited.put(current, true);
			string following = self.fields.has("resources." + current + ".base") ? self.requiredText("resources." + current + ".base") : "";
			current = self.hasInventoryName("resourceNames", following) ? following : "";
		}
		string executor = self.releaseExecutor(prefix, "com");
		var resource = FeNativeResourceBinding(name, "com", "", "");
		resource.iid = iid; resource.base = base; resource.releaseExecutor = executor;
		if (self.hasKeyPrefix(prefix + "dispatch.")) { resource.dispatch = self.dispatchTable(prefix + "dispatch.", "com", ""); }
		return resource;
	}

	/* Whether `name` is "<R>.<method>", a mapped method of a dispatching COM resource. */
	private bool dispatchedMethod(FeNativeBinding binding, string name) {
		var parts = Strings.split(name, ".");
		if (parts.len != 2 || !binding.resources.has(parts.get(0)) || binding.resources.get(parts.get(0)).ownership != "com") { return false; }
		FeNativeDispatchTable? dispatch = binding.resources.get(parts.get(0)).dispatch;
		if (dispatch == null) { return false; }
		return dispatch.methodNames.contains(parts.get(1));
	}

	/* Dispatched COM methods whose failing HRESULT throws (F1); a method takes
	 * this form or an owned-outputs result class, not both. */
	private void finishStatusResults(FeNativeBinding binding) {
		for key in self.fields.keys() {
			if (!key.startsWith("status-results.")) { continue; }
			string name = key.substring(15, key.length() - 15);
			if (!self.dispatchedMethod(binding, name)) { FePackageFailure.fail("status-results currently requires a dispatched com method R.method"); }
			if (self.requiredText(key) != "hresult") { FePackageFailure.fail("status-results kind must be hresult"); }
			binding.statusResults.put(name, "hresult");
		}
		for output in binding.ownedOutputs.keys() {
			var parts = Strings.split(output, ".");
			if (parts.len == 3 && binding.statusResults.has(parts.get(0) + "." + parts.get(1))) { FePackageFailure.fail("a method declares one status form, status-results or owned-outputs"); }
		}
	}

	/* UTF-16 strings a dispatched COM method returns through an [out] slot:
	 * each "<R>.<method>.<parameter>" names a BSTR (free = "SysFreeString") or
	 * CoTaskMemAlloc string (free = "CoTaskMemFree") that the adapter copies
	 * into a BTRC string and frees itself. The method reports failure through
	 * status-results (native-interop-ownership.md section 2.4). */
	private void finishCopiedOutputs(FeNativeBinding binding) {
		Map<string, bool> names = {};
		for key in self.fields.keys() {
			if (!key.startsWith("copied-outputs.")) { continue; }
			var parts = Strings.split(key, ".");
			if (parts.len != 5) { FePackageFailure.fail("copied-outputs currently requires a dispatched com method R.method.parameter"); }
			names.put(parts.get(1) + "." + parts.get(2) + "." + parts.get(3), true);
		}
		Vector<string> ordered = names.keys();
		ordered.sortBy((string left, string right) => Strings.lessThan(left, right));
		Map<string, bool> methods = {};
		for name in ordered {
			var parts = Strings.split(name, ".");
			string method = parts.get(0) + "." + parts.get(1);
			if (!self.identifier(parts.get(2)) || !self.dispatchedMethod(binding, method)) { FePackageFailure.fail("copied-outputs currently requires a dispatched com method R.method.parameter"); }
			string prefix = "copied-outputs." + name + ".";
			for key in self.fields.keys() {
				if (key.startsWith(prefix) && key != prefix + "encoding" && key != prefix + "free") { FePackageFailure.fail("copied-outputs requires exactly encoding and free"); }
			}
			if (!self.fields.has(prefix + "encoding") || !self.fields.has(prefix + "free")) { FePackageFailure.fail("copied-outputs requires exactly encoding and free"); }
			if (self.requiredText(prefix + "encoding") != "utf-16") { FePackageFailure.fail("copied-outputs encoding must be utf-16"); }
			string free = self.requiredText(prefix + "free");
			if (free != "SysFreeString" && free != "CoTaskMemFree") { FePackageFailure.fail("copied-outputs free must be SysFreeString or CoTaskMemFree"); }
			if (!binding.symbols.contains(free)) { FePackageFailure.fail(f"copied-outputs free {free} must be a selected function"); }
			if (methods.has(method)) { FePackageFailure.fail("copied-outputs requires one output per method"); }
			if (!binding.statusResults.has(method)) { FePackageFailure.fail("copied-outputs requires status-results on its method"); }
			methods.put(method, true);
			binding.copiedOutputs.put(name, free);
		}
		for output in binding.ownedOutputs.keys() {
			var parts = Strings.split(output, ".");
			if (parts.len == 3 && methods.has(parts.get(0) + "." + parts.get(1))) { FePackageFailure.fail("a method adopts at most one [out] value"); }
		}
	}

	/* BTRC receivers behind generated COM sinks (M2). The key names a com
	 * resource of the binding, whose IID and bases' IIDs the sink answers;
	 * `register` and `unregister` are the source's dispatched Advise and
	 * Unadvise (native-interop-ownership.md section 2.4). */
	private void finishComSinks(FeNativeBinding binding) {
		Vector<string> known = ["activation-failure", "cancellation", "executor", "failure", "interface", "name", "register", "unregister"];
		Map<string, bool> names = {};
		for key in self.fields.keys() {
			if (!key.startsWith("com-sinks.")) { continue; }
			var parts = Strings.split(key, ".");
			if (parts.len != 3) { FePackageFailure.fail("com-sinks requires a com resource of the binding"); }
			names.put(parts.get(1), true);
		}
		Vector<string> ordered = names.keys();
		ordered.sortBy((string left, string right) => Strings.lessThan(left, right));
		Map<string, bool> identifiers = {};
		Map<string, bool> declared = {};
		for name in ordered {
			string location = "com-sinks." + name;
			if (!binding.resources.has(name) || binding.resources.get(name).ownership != "com") { FePackageFailure.fail(location + ": com-sinks requires a com resource of the binding"); }
			string prefix = location + ".";
			for key in self.fields.keys() {
				if (!key.startsWith(prefix)) { continue; }
				string field = key.substring(prefix.length(), key.length() - prefix.length());
				if (!known.contains(field)) { FePackageFailure.fail(f"{location} contains unexpected field '{field}'"); }
			}
			for field in known { if (!self.fields.has(prefix + field)) { FePackageFailure.fail(f"{location} requires {field}"); } }
			string factory = self.requiredText(prefix + "name");
			if (!self.identifier(factory)) { FePackageFailure.fail(f"{location}.name must be an ASCII identifier"); }
			string handler = self.requiredText(prefix + "interface");
			if (!self.identifier(handler)) { FePackageFailure.fail(f"{location}.interface must be an ASCII identifier"); }
			if (factory == handler || binding.symbols.contains(factory) || binding.symbols.contains(handler) || identifiers.has(factory) || identifiers.has(handler)) { FePackageFailure.fail(location + ": the factory and interface names must be distinct from selected symbols"); }
			identifiers.put(factory, true); identifiers.put(handler, true);
			string registerMethod = self.requiredText(prefix + "register");
			string unregisterMethod = self.requiredText(prefix + "unregister");
			if (!self.dispatchedMethod(binding, registerMethod) || !self.dispatchedMethod(binding, unregisterMethod) || Strings.split(registerMethod, ".").get(0) != Strings.split(unregisterMethod, ".").get(0) || registerMethod == unregisterMethod) {
				FePackageFailure.fail(location + ": register and unregister require two methods of one dispatching com resource");
			}
			if (self.requiredText(prefix + "executor") != "apartment") { FePackageFailure.fail(location + ".executor currently requires apartment"); }
			if (self.requiredText(prefix + "failure") != "abort") { FePackageFailure.fail(location + ".failure currently requires abort"); }
			string activationFailure = self.requiredText(prefix + "activation-failure");
			if (activationFailure != "unpublished" && activationFailure != "abort") { FePackageFailure.fail(location + ".activation-failure requires unpublished or abort"); }
			if (self.requiredText(prefix + "cancellation") != "entry-barrier") { FePackageFailure.fail(location + ".cancellation requires entry-barrier"); }
			/* QueryInterface answers IID_IUnknown, the sink's IID and its bases';
			 * each sink alone answers its own IID, and its chain names each once. */
			if (!binding.symbols.contains("IID_IUnknown")) { FePackageFailure.fail(location + ": a com sink answers IID_IUnknown, which the binding must select"); }
			Vector<string> chain = [];
			string current = name;
			while (!current.isEmpty()) {
				FeNativeResourceBinding resource = binding.resources.get(current);
				if (chain.contains(resource.iid) || (current == name && declared.has(resource.iid))) { FePackageFailure.fail(f"{location}: duplicate sink IID {resource.iid}"); }
				chain.push(resource.iid);
				current = resource.base;
			}
			declared.put(binding.resources.get(name).iid, true);
			binding.comSinks.push(FeNativeComSinkBinding(name, factory, handler, registerMethod, unregisterMethod, activationFailure));
		}
	}

	private FeNativeDispatchTable dispatchTable(string prefix, string ownership, string storage) {
		if ((ownership != "unique" && ownership != "com") || !storage.isEmpty()) { FePackageFailure.fail("dispatch requires a unique pointer resource and a dispatch declaration"); }
		Vector<string> known = ["table", "context", "context-index", "executor", "failure", "release"];
		Map<string, string> methods = {};
		for key in self.fields.keys() {
			if (!key.startsWith(prefix)) { continue; }
			string field = key.substring(prefix.length(), key.length() - prefix.length());
			if (field.startsWith("methods.")) {
				string method = field.substring(8, field.length() - 8);
				if (!self.identifier(method)) { FePackageFailure.fail("dispatch methods must map BTRC method names to table slots"); }
				methods.put(method, self.requiredText(key));
				continue;
			}
			if (!known.contains(field)) { FePackageFailure.fail(f"unexpected dispatch field '{field}'"); }
		}
		for required in ["table", "executor", "failure"] { if (!self.fields.has(prefix + required)) { FePackageFailure.fail("dispatch requires table, methods, executor and failure"); } }
		if (methods.len == 0) { FePackageFailure.fail("dispatch methods must map BTRC method names to table slots"); }
		string tableField = self.requiredText(prefix + "table");
		if (!self.identifier(tableField)) { FePackageFailure.fail("dispatch fields require identifiers"); }
		int contextIndex = 0;
		if (self.fields.has(prefix + "context-index")) {
			string raw = self.fields.get(prefix + "context-index").trim();
			if (raw.isEmpty() || raw.length() > 9) { FePackageFailure.fail("dispatch context-index must be a nonnegative native parameter index"); }
			for character in raw { if (character < '0' || character > '9') { FePackageFailure.fail("dispatch context-index must be a nonnegative native parameter index"); } }
			contextIndex = Strings.toInt(raw);
		}
		/* A COM method runs on its apartment's thread; a C table on its creating thread. */
		string executor = ownership == "com" ? "apartment" : "caller";
		if (self.requiredText(prefix + "executor") != executor) { FePackageFailure.fail(f"dispatch executor currently requires {executor}"); }
		if (self.requiredText(prefix + "failure") != "abort") { FePackageFailure.fail("dispatch failure currently requires abort"); }
		var dispatch = FeNativeDispatchTable(tableField, contextIndex);
		Vector<string> slots = [];
		Vector<string> methodNames = methods.keys();
		methodNames.sortBy((string left, string right) => Strings.lessThan(left, right));
		for method in methodNames {
			string slot = methods.get(method);
			if (!self.identifier(slot)) { FePackageFailure.fail("dispatch methods must map BTRC method names to table slots"); }
			bool reserved = (ownership == "com" && method == "sameObject") || (ownership != "com" && (method == "close" || method == "isOpen"));
			if (reserved) { FePackageFailure.fail("dispatch methods cannot shadow resource operations"); }
			dispatch.methodNames.push(method); dispatch.methodSlots.push(slot); slots.push(slot);
		}
		if (self.fields.has(prefix + "context")) {
			dispatch.context = self.requiredText(prefix + "context");
			if (!self.identifier(dispatch.context)) { FePackageFailure.fail("dispatch fields require identifiers"); }
			if (dispatch.context == tableField) { FePackageFailure.fail("dispatch context and table fields must be distinct"); }
		}
		if (self.fields.has(prefix + "release")) {
			dispatch.releaseSlot = self.requiredText(prefix + "release");
			if (!self.identifier(dispatch.releaseSlot)) { FePackageFailure.fail("dispatch fields require identifiers"); }
			slots.push(dispatch.releaseSlot);
		}
		if (ownership == "com") {
			if (tableField != "lpVtbl") { FePackageFailure.fail("com dispatch requires table = lpVtbl"); }
			if (!dispatch.context.isEmpty() || !dispatch.releaseSlot.isEmpty() || contextIndex != 0) { FePackageFailure.fail("com dispatch passes the object first and releases through Release"); }
			for slot in dispatch.methodSlots { if (slot == "QueryInterface" || slot == "AddRef" || slot == "Release") { FePackageFailure.fail("com dispatch cannot map the IUnknown slots"); } }
		}
		Map<string, bool> seen = {};
		for slot in slots {
			if (seen.has(slot)) { FePackageFailure.fail("dispatch method and release slots must be distinct"); }
			seen.put(slot, true);
		}
		return dispatch;
	}

	private FeNativeCallbackTable callbackTable(FeNativeBinding binding, string prefix, string ownership, string storage) {
		if (ownership != "unique" || !storage.isEmpty()) { FePackageFailure.fail("callback table requires a unique pointer resource and a table declaration"); }
		Vector<string> known = ["name", "interface", "context", "context-index", "executor", "failure", "label", "reopen", "release"];
		Map<string, string> methods = {};
		for key in self.fields.keys() {
			if (!key.startsWith(prefix)) { continue; }
			string field = key.substring(prefix.length(), key.length() - prefix.length());
			if (field.startsWith("methods.")) {
				string method = field.substring(8, field.length() - 8);
				if (!self.identifier(method)) { FePackageFailure.fail("callback table methods must map BTRC method names to callback fields"); }
				methods.put(method, self.requiredText(key));
				continue;
			}
			if (!known.contains(field)) { FePackageFailure.fail(f"unexpected callback table field '{field}'"); }
		}
		for required in ["name", "interface", "context", "executor", "failure"] { if (!self.fields.has(prefix + required)) { FePackageFailure.fail("callback table requires name, interface, context, methods, executor and failure"); } }
		if (methods.len == 0) { FePackageFailure.fail("callback table methods must map BTRC method names to callback fields"); }
		string name = self.requiredText(prefix + "name");
		string interfaceName = self.requiredText(prefix + "interface");
		string context = self.requiredText(prefix + "context");
		if (!self.identifier(name) || !self.identifier(interfaceName) || !self.identifier(context)) { FePackageFailure.fail("callback table fields require identifiers"); }
		int contextIndex = 0;
		if (self.fields.has(prefix + "context-index")) {
			string raw = self.fields.get(prefix + "context-index").trim();
			if (raw.isEmpty() || raw.length() > 9) { FePackageFailure.fail("callback table context-index must be a nonnegative native parameter index"); }
			for character in raw { if (character < '0' || character > '9') { FePackageFailure.fail("callback table context-index must be a nonnegative native parameter index"); } }
			contextIndex = Strings.toInt(raw);
		}
		if (self.requiredText(prefix + "executor") != "caller") { FePackageFailure.fail("callback table executor currently requires caller"); }
		if (self.requiredText(prefix + "failure") != "abort") { FePackageFailure.fail("callback table failure currently requires abort"); }
		var table = FeNativeCallbackTable(name, interfaceName, context, contextIndex);
		Vector<string> fields = [context];
		Vector<string> methodNames = methods.keys();
		methodNames.sortBy((string left, string right) => Strings.lessThan(left, right));
		for method in methodNames {
			string field = methods.get(method);
			if (!self.identifier(field)) { FePackageFailure.fail("callback table methods must map BTRC method names to callback fields"); }
			if (method == "close" || method == "isOpen") { FePackageFailure.fail("callback table methods cannot shadow resource operations"); }
			table.methodNames.push(method); table.methodFields.push(field); fields.push(field);
		}
		for optional in ["label", "reopen", "release"] {
			if (!self.fields.has(prefix + optional)) { continue; }
			string value = self.requiredText(prefix + optional);
			if (!self.identifier(value)) { FePackageFailure.fail("callback table fields require identifiers"); }
			if (optional == "label") { table.label = value; } else if (optional == "reopen") { table.reopen = value; } else { table.releaseField = value; }
			fields.push(value);
		}
		Map<string, bool> seen = {};
		for field in fields {
			if (seen.has(field)) { FePackageFailure.fail("callback table context, method, label, reopen and release fields must be distinct"); }
			seen.put(field, true);
		}
		if (!table.reopen.isEmpty() && table.label.isEmpty()) { FePackageFailure.fail("callback table reopen requires a label field to answer"); }
		if (binding.symbols.contains(name) || binding.symbols.contains(interfaceName) || name == interfaceName) { FePackageFailure.fail("callback table name and interface must be distinct from selected symbols"); }
		return table;
	}

	private void finishCppResource(FeNativeBinding binding, string name, Map<string, bool> aliases) {
		if (!self.nativeSymbol(name, binding.language) || !binding.symbols.contains(name)) { FePackageFailure.fail("C++ resources require selected SDK classes"); }
		string prefix = "resources." + name + ".";
		string ownership = self.requiredText(prefix + "ownership");
		if (ownership != "unique" && ownership != "owner-bound-value") { FePackageFailure.fail("C++ resources require unique/default/delete or owner-bound-value facts"); }
		string alias = self.requiredText(prefix + "name");
		if (!self.identifier(alias) || aliases.has(alias) || binding.symbols.contains(alias)) { FePackageFailure.fail("C++ resource aliases must be distinct"); }
		if (!self.fields.has(prefix + "methods")) { FePackageFailure.fail("C++ resources require selected methods"); }
		Vector<string> methods = self.stringArray(prefix + "methods");
		Map<string, bool> methodNames = {};
		for method in methods {
			string selected = method.endsWith("()") ? method.substring(0, method.length() - 2) : method;
			if (!self.identifier(selected) || selected == "create" || selected == "close" || methodNames.has(selected)) { FePackageFailure.fail("C++ methods require distinct unambiguous public method names"); }
			methodNames.put(selected, true);
		}
		string constructor = ""; string releaseFunction = ""; string owner = "";
		if (ownership == "unique") {
			constructor = self.requiredText(prefix + "constructor"); releaseFunction = self.requiredText(prefix + "release");
			if (constructor != "default" || releaseFunction != "delete" || self.fields.has(prefix + "owner")) { FePackageFailure.fail("C++ unique construction/destruction requires default/delete"); }
		} else {
			owner = self.requiredText(prefix + "owner");
			if (owner == name || !binding.symbols.contains(owner) || self.fields.has(prefix + "constructor") || self.fields.has(prefix + "release") || self.requiredText("resources." + owner + ".ownership") != "unique") { FePackageFailure.fail("owner-bound values require a selected unique originating document"); }
		}
		var resource = FeNativeResourceBinding(name, ownership, "", releaseFunction);
		resource.alias = alias; resource.constructor = constructor; resource.owner = owner; resource.methods = methods;
		aliases.put(alias, true); binding.resources.put(name, resource);
	}

	private void finishCopiedInputs(FeNativeBinding binding) {
		for key in self.fields.keys() {
			if (!key.startsWith("copied-inputs.")) { continue; }
			var parts = Strings.split(key, ".");
			if (parts.len != 4 || !binding.symbols.contains(parts.get(1)) || !self.identifier(parts.get(2)) || !["owner", "length", "assignment"].contains(parts.get(3))) { FePackageFailure.fail("copied-inputs requires selected function.parameter tables"); }
			self.rememberInventoryName("copiedInputNames", parts.get(1) + "." + parts.get(2));
		}
		Map<string, bool> functions = {};
		if (!self.hasInventory("copiedInputNames")) { return; }
		for name in self.inventoryNames("copiedInputNames") {
			var parts = Strings.split(name, ".");
			if (parts.len != 2 || !binding.symbols.contains(parts.get(0)) || !self.identifier(parts.get(1))) { FePackageFailure.fail("copied-inputs requires selected function.parameter tables"); }
			string prefix = "copied-inputs." + name + ".";
			string owner = self.requiredText(prefix + "owner"); string length = self.requiredText(prefix + "length");
			if (!self.identifier(owner) || !self.identifier(length) || self.requiredText(prefix + "assignment") != "once") { FePackageFailure.fail("copied-inputs requires owner, length and assignment = once"); }
			if (owner == length || owner == parts.get(1) || length == parts.get(1) || !binding.borrowedParameters.contains(parts.get(0) + "." + owner) || !binding.readOnlyBorrows.contains(name)) { FePackageFailure.fail("copied-inputs requires distinct declared resource-owner and read-only byte parameters"); }
			if (functions.has(parts.get(0))) { FePackageFailure.fail("copied-inputs requires one copied span per SDK setter"); }
			functions.put(parts.get(0), true); binding.copiedInputs.put(name, FeNativeCopiedInputBinding(owner, length));
		}
	}

	private void finishInitializers(FeNativeBinding binding) {
		Map<string, bool> names = {};
		Vector<string> scalarFields = ["resource", "parameter", "result", "success", "success-nonzero", "failure"];
		if (binding.language == "c++") { scalarFields = ["resource", "result", "success", "status-field", "failure"]; }
		if (self.hasInventory("initializerTables")) {
			for table in self.inventoryNames("initializerTables") { names.put(Strings.split(table, ".").get(0), true); }
		}
		for key in self.fields.keys() {
			if (!key.startsWith("initializers.")) { continue; }
			var parts = Strings.split(key, ".");
			bool scalar = parts.len == 3 && scalarFields.contains(parts.get(2));
			bool copy = binding.language == "c" && parts.len == 5 && parts.get(2) == "copied-inputs" && self.identifier(parts.get(3)) && parts.get(4) == "length";
			if ((!scalar && !copy) || !(binding.language == "c++" ? self.nativeSymbol(parts.get(1), "c++") : self.identifier(parts.get(1))) || !binding.symbols.contains(parts.get(1))) { FePackageFailure.fail("initializers requires selected function tables"); }
			names.put(parts.get(1), true);
		}
		Map<string, bool> results = {}; Map<string, bool> owners = {};
		for name in names.keys() {
			if (binding.language == "c++") {
				self.finishCppInitializer(binding, name, results, owners);
				continue;
			}
			string prefix = "initializers." + name + ".";
			var shape = FeNativeInitializerBinding();
			shape.resource = self.requiredText(prefix + "resource"); shape.parameter = self.requiredText(prefix + "parameter");
			shape.result = self.requiredText(prefix + "result"); shape.success = self.fields.has(prefix + "success") ? self.requiredText(prefix + "success") : "";
			if (self.fields.has(prefix + "success") == self.fields.has(prefix + "success-nonzero")) { FePackageFailure.fail("initializer requires exactly one success or success-nonzero predicate"); }
			if (self.fields.has(prefix + "success-nonzero") && self.fields.get(prefix + "success-nonzero") != "true") { FePackageFailure.fail("initializer success-nonzero requires true"); }
			for value in [shape.resource, shape.parameter, shape.result] { if (!self.identifier(value)) { FePackageFailure.fail("initializer names require identifiers"); } }
			if (self.fields.has(prefix + "success") && !self.identifier(shape.success)) { FePackageFailure.fail("initializer success requires an identifier"); }
			if (binding.language != "c" || !binding.resources.has(shape.resource) || binding.resources.get(shape.resource).storage != "inline") { FePackageFailure.fail("initializers requires a declared inline C resource"); }
			if (self.requiredText(prefix + "failure") != "rolled-back") { FePackageFailure.fail("initializers requires fully rolled-back SDK failure"); }
			if (results.has(shape.result) || binding.symbols.contains(shape.result) || owners.has(shape.resource) || (!shape.success.isEmpty() && !binding.symbols.contains(shape.success))) { FePackageFailure.fail("initializers requires one initializer per resource, a distinct result and selected success constant"); }
			if (binding.ownedResults.contains(name)) { FePackageFailure.fail("initializers cannot combine other owned outputs/results"); }
			for output in binding.ownedOutputs.keys() { if (output.startsWith(name + ".")) { FePackageFailure.fail("initializers cannot combine other owned outputs/results"); } }
			for key in self.fields.keys() {
				if (!key.startsWith(prefix + "copied-inputs.")) { continue; }
				if (!shape.copiedInput.isEmpty()) { FePackageFailure.fail("initializers currently supports at most one immutable copied input"); }
				shape.copiedInput = Strings.split(key, ".").get(3); shape.length = self.requiredText(key);
				if (!self.identifier(shape.length) || shape.copiedInput == shape.length || shape.copiedInput == shape.parameter || shape.length == shape.parameter) { FePackageFailure.fail("initializer storage, copied input and length must be distinct"); }
			}
			results.put(shape.result, true); owners.put(shape.resource, true); binding.initializers.put(name, shape);
		}
		for name in binding.resources.keys() {
			if (binding.language == "c++") {
				if (binding.resources.get(name).ownership == "unique" && !owners.has(name)) { FePackageFailure.fail("every C++ unique resource requires one checked initialization factory"); }
			} else if (!binding.resources.get(name).storage.isEmpty() && !owners.has(name)) { FePackageFailure.fail("every inline resource requires one checked initializer"); }
		}
	}

	private void finishCppInitializer(FeNativeBinding binding, string name, Map<string, bool> results, Map<string, bool> owners) {
		string prefix = "initializers." + name + ".";
		var shape = FeNativeInitializerBinding();
		shape.resource = self.requiredText(prefix + "resource"); shape.result = self.requiredText(prefix + "result");
		shape.success = self.requiredText(prefix + "success"); shape.statusField = self.requiredText(prefix + "status-field");
		shape.parameter = "";
		if (!self.identifier(shape.result) || !self.identifier(shape.statusField)) { FePackageFailure.fail("C++ initializer result and status-field require identifiers"); }
		if (!binding.resources.has(shape.resource) || binding.resources.get(shape.resource).ownership != "unique" || !name.startsWith(shape.resource + "::") || self.requiredText(prefix + "failure") != "destroy") { FePackageFailure.fail("C++ initializer requires its unique SDK receiver and failure = destroy"); }
		if (!binding.symbols.contains(shape.success) || owners.has(shape.resource) || results.has(shape.result) || binding.symbols.contains(shape.result)) { FePackageFailure.fail("C++ initializer requires one factory per owner, a distinct result and selected success constant"); }
		for resource in binding.resources.keys() { if (binding.resources.get(resource).alias == shape.result) { FePackageFailure.fail("C++ initializer result must not shadow a resource alias"); } }
		string method = name.substring(shape.resource.length() + 2, name.length() - shape.resource.length() - 2);
		if (binding.resources.get(shape.resource).methods.contains(method) || binding.resources.get(shape.resource).methods.contains(method + "()")) { FePackageFailure.fail("C++ initialization cannot also expose an instance mutation method"); }
		results.put(shape.result, true); owners.put(shape.resource, true); binding.initializers.put(name, shape);
	}

	private bool javaIdentifier(string value) {
		if (value.isEmpty() || (!Strings.isAlpha(value[0]) && value[0] != '_' && value[0] != '$')) { return false; }
		for character in value { if (!Strings.isAlnum(character) && character != '_' && character != '$') { return false; } }
		return true;
	}

	private bool javaClassName(string value, string separator) {
		for segment in Strings.split(value, separator) { if (!self.javaIdentifier(segment)) { return false; } }
		return true;
	}

	/* One JNI field descriptor at `start`: its end, or -1. */
	private int javaDescriptorEnd(string text, int start) {
		int index = start;
		while (index < text.length() && text[index] == '[') { index++; }
		if (index >= text.length()) { return -1; }
		if ("ZBCSIJFD".contains(text.substring(index, 1))) { return index + 1; }
		if (text[index] != 'L') { return -1; }
		int end = text.find(";", index);
		if (end < 0 || !self.javaClassName(text.substring(index + 1, end - index - 1), "/")) { return -1; }
		return end + 1;
	}

	/* A class by its dotted binary name, a method or constructor by its JNI
	 * descriptor, or a field by its type descriptor, so an overload is never
	 * guessed (native-interop-ownership.md section 2.3). */
	private bool javaSymbol(string symbol) {
		int open = symbol.indexOf("(");
		int colon = symbol.indexOf(":");
		int split = open < 0 ? colon : (colon < 0 ? open : (open < colon ? open : colon));
		if (split < 0) { return self.javaClassName(symbol, "."); }
		string head = symbol.substring(0, split);
		int dot = head.lastIndexOf(".");
		if (dot <= 0) { return false; }
		string member = head.substring(dot + 1, head.length() - dot - 1);
		if (!self.javaClassName(head.substring(0, dot), ".")) { return false; }
		if (split == colon) { return self.javaIdentifier(member) && self.javaDescriptorEnd(symbol, colon + 1) == symbol.length(); }
		bool constructor = member == "<init>";
		if (!constructor && !self.javaIdentifier(member)) { return false; }
		int index = open + 1;
		while (index < symbol.length() && symbol[index] != ')') {
			index = self.javaDescriptorEnd(symbol, index);
			if (index < 0) { return false; }
		}
		if (index >= symbol.length()) { return false; }
		string result = symbol.substring(index + 1, symbol.length() - index - 1);
		if (result == "V") { return true; }
		return !constructor && self.javaDescriptorEnd(symbol, index + 1) == symbol.length();
	}

	/* An argument index: 0, or digits without a leading zero. */
	private bool javaArgumentIndex(string text) {
		if (text.isEmpty() || (text[0] == '0' && text.length() > 1)) { return false; }
		for index in range(text.length()) { if (!Strings.isDigit(text[index])) { return false; } }
		return true;
	}

	private bool javaBinding() {
		if (!self.fields.has("language")) { return false; }
		string raw = self.fields.get("language").trim();
		return raw == "\"java\"" || raw == "'java'";
	}

	/* A class-file binding: no header, standard or C ownership map, and never a
	 * source-unit language. Its symbols name classes, or members by JNI
	 * descriptor; the Java class reader supplies their semantics. */
	private FeNativeBinding finishJavaBinding(string root, string packageName) {
		if (self.fields.has("header") || self.fields.has("standard")) { FePackageFailure.fail(f"{self.context()}: Java bindings take no header or standard"); }
		Vector<string> keys = self.fields.keys();
		keys.sortBy((string left, string right) => Strings.lessThan(left, right));
		Vector<string> allowed = ["module", "language", "symbols", "os", "arch", "env"];
		for key in keys { if (!allowed.contains(key) && !key.startsWith("natives.") && !key.startsWith("classes.")) { FePackageFailure.fail(f"{self.context()} contains unexpected field '{key}'"); } }
		if (!self.moduleName(self.requiredText("module"))) { FePackageFailure.fail(f"{self.context()}.module must be a dotted module name"); }
		Vector<string> modules = self.modulePaths(root);
		FeTargetSelector selector = self.targetSelector();
		Vector<string> boundModules = [self.requiredText("module")];
		self.requirePlatformDirectories(boundModules, selector);
		Vector<string> symbols = self.stringArray("symbols");
		if (symbols.len == 0) { FePackageFailure.fail(f"{self.context()}.symbols must name Java classes, or members by JNI descriptor"); }
		for symbol in symbols { if (!self.javaSymbol(symbol)) { FePackageFailure.fail(f"{self.context()}.symbols must name Java classes, or members by JNI descriptor"); } }
		var binding = FeNativeBinding(packageName, modules.get(0), "", "java", "", symbols, selector.operatingSystems, selector.architectures);
		binding.environments = selector.environments;
		Map<string, string> classes = {};
		for symbol in binding.symbols {
			if (!symbol.contains("(") && !symbol.contains(":")) {
				var parts = Strings.split(symbol, ".");
				classes.put(parts.get(parts.len - 1), symbol);
			}
		}
		Map<string, bool> identifiers = {};
		self.finishJavaNatives(binding, classes, identifiers);
		self.finishJavaClasses(binding, classes, identifiers);
		return binding;
	}

	/* Per-class options, keyed by the BTRC name of a class the binding selects.
	 * `executor = "main"` makes every call into the class check that it runs
	 * on the main Looper's thread; `weak = true` generates the class's
	 * JavaWeak resource, named JavaWeak<Class> (native-interop-ownership.md
	 * section 2.3, "Executors" and "Global refs"). */
	private void finishJavaClasses(FeNativeBinding binding, Map<string, string> classes, Map<string, bool> identifiers) {
		if (!self.hasInventory("javaClassNames")) { return; }
		Vector<string> known = ["executor", "weak"];
		Vector<string> ordered = self.inventoryNames("javaClassNames");
		ordered.sortBy((string left, string right) => Strings.lessThan(left, right));
		for owner in ordered {
			string location = f"{self.context()}.classes.{owner}";
			if (!classes.has(owner)) { FePackageFailure.fail(location + ": classes requires a Java class the binding selects"); }
			string prefix = "classes." + owner + ".";
			Vector<string> fields = [];
			for key in self.fields.keys() { if (key.startsWith(prefix)) { fields.push(key.substring(prefix.length(), key.length() - prefix.length())); } }
			fields.sortBy((string left, string right) => Strings.lessThan(left, right));
			for field in fields { if (!known.contains(field)) { FePackageFailure.fail(f"{location} contains unexpected field '{field}'"); } }
			if (fields.len == 0) { FePackageFailure.fail(location + " requires executor or weak"); }
			string executor = "";
			if (self.fields.has(prefix + "executor")) {
				executor = self.fields.get(prefix + "executor").trim();
				executor = executor == "\"main\"" || executor == "'main'" ? "main" : "";
				if (executor.isEmpty()) { FePackageFailure.fail(location + ".executor requires main"); }
			}
			bool weak = false;
			if (self.fields.has(prefix + "weak")) {
				string raw = self.fields.get(prefix + "weak").trim();
				if (raw != "true" && raw != "false") { FePackageFailure.fail(location + ".weak must be true or false"); }
				weak = raw == "true";
			}
			if (weak && (classes.has("JavaWeak" + owner) || identifiers.has("JavaWeak" + owner))) {
				FePackageFailure.fail(location + ": the weak reference class JavaWeak" + owner + " must be distinct from selected classes and natives");
			}
			binding.javaClasses.push(FeNativeJavaClassBinding(owner, classes.get(owner), executor, weak));
		}
	}

	/* Java natives registrations, keyed by the BTRC name of a class the binding
	 * selects. Each names its factory, its generated receiver interface and
	 * the class's native methods by name and JNI descriptor. The executor is
	 * the registering thread (`caller`) or the main Looper's (`main`); a BTRC
	 * exception escaping a native either becomes a Java RuntimeException
	 * (`throw`) or terminates (`abort`). Cancellation is an entry barrier.
	 * `writable-arrays` names the array parameters whose borrowed span is
	 * writable (native-interop-ownership.md section 2.3, "Java -> btrc"). */
	private void finishJavaNatives(FeNativeBinding binding, Map<string, string> classes, Map<string, bool> identifiers) {
		Vector<string> known = ["cancellation", "executor", "failure", "interface", "methods", "name", "writable-arrays"];
		Vector<string> required = ["cancellation", "executor", "failure", "interface", "methods", "name"];
		Map<string, bool> owners = {};
		for key in self.fields.keys() {
			if (!key.startsWith("natives.")) { continue; }
			int field = key.lastIndexOf(".");
			if (field > 8) { owners.put(key.substring(8, field - 8), true); }
		}
		Vector<string> ordered = owners.keys();
		ordered.sortBy((string left, string right) => Strings.lessThan(left, right));
		for owner in ordered {
			string location = f"{self.context()}.natives.{owner}";
			if (!classes.has(owner)) { FePackageFailure.fail(location + ": natives requires a Java class the binding selects"); }
			string prefix = "natives." + owner + ".";
			Vector<string> fields = [];
			for key in self.fields.keys() { if (key.startsWith(prefix)) { fields.push(key.substring(prefix.length(), key.length() - prefix.length())); } }
			fields.sortBy((string left, string right) => Strings.lessThan(left, right));
			for field in fields { if (!known.contains(field)) { FePackageFailure.fail(f"{location} contains unexpected field '{field}'"); } }
			for field in required { if (!self.fields.has(prefix + field)) { FePackageFailure.fail(f"{location} requires {field}"); } }
			string factory = self.requiredText(prefix + "name");
			if (!self.identifier(factory)) { FePackageFailure.fail(f"{location}.name must be an ASCII identifier"); }
			string handler = self.requiredText(prefix + "interface");
			if (!self.identifier(handler)) { FePackageFailure.fail(f"{location}.interface must be an ASCII identifier"); }
			if (factory == handler || classes.has(factory) || classes.has(handler) || identifiers.has(factory) || identifiers.has(handler)) {
				FePackageFailure.fail(location + ": the factory and interface names must be distinct from selected classes and other natives");
			}
			identifiers.put(factory, true);
			identifiers.put(handler, true);
			Vector<string> methods = self.stringArray(prefix + "methods", true);
			bool shaped = methods.len > 0;
			for method in methods { if (!method.contains("(") || method.startsWith("<") || !self.javaSymbol("C." + method)) { shaped = false; } }
			if (!shaped) { FePackageFailure.fail(f"{location}.methods must name methods by JNI descriptor"); }
			for index in range(methods.len) {
				for earlier in range(index) {
					if (methods.get(earlier) == methods.get(index)) { FePackageFailure.fail(f"{location}.methods registers {methods.get(index)} twice"); }
				}
			}
			string executor = self.requiredText(prefix + "executor");
			if (executor != "caller" && executor != "main") { FePackageFailure.fail(location + ".executor requires caller or main"); }
			string failure = self.requiredText(prefix + "failure");
			if (failure != "throw" && failure != "abort") { FePackageFailure.fail(location + ".failure requires throw or abort"); }
			if (self.requiredText(prefix + "cancellation") != "entry-barrier") { FePackageFailure.fail(location + ".cancellation requires entry-barrier"); }
			string writableMessage = location + ".writable-arrays must name array parameters of its methods as <method>.argument<N>";
			Vector<string> writable = [];
			if (self.fields.has(prefix + "writable-arrays")) {
				string raw = self.fields.get(prefix + "writable-arrays").trim();
				if (raw.length() < 2 || raw[0] != '[' || raw[raw.length() - 1] != ']') { FePackageFailure.fail(writableMessage); }
				writable = self.stringArray(prefix + "writable-arrays", true);
			}
			for parameter in writable {
				int split = parameter.lastIndexOf(".argument");
				if (split < 0 || !methods.contains(parameter.substring(0, split)) || !self.javaArgumentIndex(parameter.substring(split + 9, parameter.length() - split - 9))) { FePackageFailure.fail(writableMessage); }
			}
			for index in range(writable.len) {
				for earlier in range(index) {
					if (writable.get(earlier) == writable.get(index)) { FePackageFailure.fail(location + ".writable-arrays contains a duplicate value"); }
				}
			}
			var registration = FeNativeJavaNativesBinding(owner, classes.get(owner), factory, handler, methods, failure);
			registration.executor = executor;
			registration.writableArrays = writable;
			binding.javaNatives.push(registration);
		}
	}

	public FeNativeBinding finishBinding(string root, string packageName) {
		if (self.javaBinding()) { return self.finishJavaBinding(root, packageName); }
		self.validateFields();
		if (!self.moduleName(self.requiredText("module"))) { FePackageFailure.fail(f"{self.context()}.module must be a dotted module name"); }
		Vector<string> modules = self.modulePaths(root);
		FeTargetSelector selector = self.targetSelector();
		Vector<string> boundModules = [self.requiredText("module")];
		self.requirePlatformDirectories(boundModules, selector);
		string header = self.packagePath(root, "header", false);
		Vector<string> symbols = self.stringArray("symbols");
		if (symbols.len == 0) { FePackageFailure.fail(f"{self.context()}.symbols must be a non-empty array of qualified native names"); }
		string language = self.requiredText("language");
		for symbol in symbols { if (!self.nativeSymbol(symbol, language)) { FePackageFailure.fail(f"{self.context()}.symbols must be a non-empty array of qualified native names"); } }
		string standard = self.requiredText("standard");
		self.validateLanguage(language, standard);
		var binding = FeNativeBinding(packageName, modules.get(0), header, language, standard, symbols, selector.operatingSystems, selector.architectures);
		binding.environments = selector.environments;
		self.finishResources(binding);
		self.finishUnmanagedHandles(binding);
		self.finishOwnedOutputs(binding);
		self.finishStatusResults(binding);
		self.finishCopiedOutputs(binding);
		self.finishComSinks(binding);
		self.finishInitializers(binding);
		self.finishCopiedResults(binding);
		self.finishOutputOffsets(binding);
		for output in binding.ownedOutputResources.keys() {
			for offset in binding.outputOffsets.keys() { if (Strings.split(output, ".").get(0) == Strings.split(offset, ".").get(0)) { FePackageFailure.fail("erased owned-outputs cannot combine output-offsets"); } }
		}
		self.finishVariadicCalls(binding);
		self.finishCallbacks(binding);
		self.finishStringViews(binding);
		self.finishRecordSnapshots(binding);
		binding.mainThreadGlobals = self.stringArray("main-thread-globals");
		binding.staticGlobals = self.stringArray("static-globals");
		for key in self.fields.keys() {
			bool parameter = key.startsWith("resource-parameters.");
			if (!parameter && !key.startsWith("resource-results.")) { continue; }
			string prefix = parameter ? "resource-parameters." : "resource-results.";
			string position = key.substring(prefix.length(), key.length() - prefix.length());
			string resource = self.requiredText(key);
			var parts = Strings.split(position, ".");
			if (language != "c" || !binding.resources.has(resource) || parts.len != (parameter ? 2 : 1) || !symbols.contains(parts.get(0)) || (parameter && !self.identifier(parts.get(1)))) { FePackageFailure.fail("resource projections must map selected native positions to declared C resources"); }
			if (parameter) { binding.resourceParameters.put(position, resource); }
			else { binding.resourceResults.put(position, resource); }
		}
		if (binding.staticGlobals.len > 0 && (language != "c" || binding.resources.len == 0)) { FePackageFailure.fail("static-globals requires declared C resources"); }
		for name in binding.staticGlobals { if (!symbols.contains(name)) { FePackageFailure.fail("static-globals must name selected globals"); } }
		if (binding.mainThreadGlobals.len > 0 && language != "objective-c") { FePackageFailure.fail("main-thread-globals requires Objective-C object globals"); }
		for name in binding.mainThreadGlobals { if (!symbols.contains(name)) { FePackageFailure.fail("main-thread-globals must name selected globals"); } }
		binding.readOnlyBorrows = self.stringArray("read-only-borrows");
		self.finishCopiedInputs(binding);
		binding.realtimeSafe = self.stringArray("realtime-safe");
		binding.ownedRecords = self.stringArray("owned-records");
		binding.recordInputs = self.stringArray("record-inputs");
		binding.recordOutputs = self.stringArray("record-outputs");
		binding.ownedOutputFields = self.stringArray("owned-output-fields");
		binding.nullOutputFields = self.stringArray("null-output-fields");
		if (binding.recordOutputs.len > 0 && language != "c") { FePackageFailure.fail("record-outputs currently requires C"); }
		for output in binding.recordOutputs {
			var parts = Strings.split(output, ".");
			if (parts.len != 2 || !symbols.contains(parts.get(0)) || !self.identifier(parts.get(1))) { FePackageFailure.fail("record-outputs must name selected function.parameter pairs"); }
			if (binding.recordInputs.contains(output)) { FePackageFailure.fail("record input/output parameters must be distinct"); }
		}
		for field in ["owned-output-fields", "null-output-fields"] {
			for value in self.stringArray(field) {
				var parts = Strings.split(value, ".");
				if (parts.len != 3 || !binding.recordOutputs.contains(parts.get(0) + "." + parts.get(1)) || !self.identifier(parts.get(2))) { FePackageFailure.fail(f"{field} requires distinct declared function.parameter.field names"); }
			}
		}
		for field in binding.ownedOutputFields { if (binding.nullOutputFields.contains(field)) { FePackageFailure.fail("owned/null output fields must be distinct"); } }
		for name in binding.ownedRecords {
			if (!(language == "c++" ? self.nativeSymbol(name, language) : self.identifier(name)) || !symbols.contains(name)) { FePackageFailure.fail(f"{self.context()}.owned-records must name selected records"); }
		}
		for input in binding.recordInputs {
			var parts = Strings.split(input, ".");
			if (parts.len != 2 || !symbols.contains(parts.get(0)) || !self.identifier(parts.get(1))) { FePackageFailure.fail(f"{self.context()}.record-inputs must name selected function.parameter pairs"); }
		}
		for key in self.fields.keys() {
			if (!key.startsWith("object-fields.")) { continue; }
			string field = key.substring(14, key.length() - 14);
			var parts = Strings.split(field, ".");
			string target = self.requiredText(key);
			string typeName = target.endsWith("?") ? target.substring(0, target.length() - 1) : target;
			if (parts.len != 2 || !binding.ownedRecords.contains(parts.get(0)) || !self.identifier(parts.get(1)) || !self.identifier(typeName)) { FePackageFailure.fail(f"{self.context()}.object-fields requires owned record.field and object type names"); }
			binding.objectFields.put(field, target);
		}
		if ((language != "c" && language != "c++" && binding.ownedRecords.len > 0) || (language != "c" && (binding.recordInputs.len > 0 || binding.objectFields.len > 0))) { FePackageFailure.fail("owning record inputs currently require a C binding"); }
		for name in binding.realtimeSafe {
			if (!symbols.contains(name)) { FePackageFailure.fail(f"{self.context()}.realtime-safe must name selected functions"); }
		}
		for borrow in binding.readOnlyBorrows {
			var parts = Strings.split(borrow, ".");
			if (parts.len != 2 || !symbols.contains(parts.get(0)) || !self.identifier(parts.get(1))) { FePackageFailure.fail(f"{self.context()}.read-only-borrows must name selected function.parameter pairs"); }
		}
		return binding;
	}

	private FeNativeDeclaration selected(FeNativeDeclaration declaration, FeTargetSelector selector) {
		declaration.environments = selector.environments;
		return declaration;
	}

	public FeNativeDeclaration finish(string root, string packageName) {
		self.validateFields();
		FeTargetSelector selector = self.targetSelector();
		Vector<string> operatingSystems = selector.operatingSystems;
		Vector<string> architectures = selector.architectures;
		Vector<string> modules = self.modulePaths(root);
		self.requirePlatformDirectories(self.stringArray("modules"), selector);
		if (self.tableName.equals("native.sources")) {
			string language = self.requiredText("language");
			string standard = self.requiredText("standard");
			self.validateLanguage(language, standard);
			return self.selected(FeNativeDeclaration("source", packageName, self.packagePath(root, "path", false), "", language, standard, operatingSystems, architectures, modules), selector);
		}
		if (self.tableName.equals("native.headers")) {
			return self.selected(FeNativeDeclaration("header", packageName, self.packagePath(root, "path", false), "", "", "", operatingSystems, architectures, modules), selector);
		}
		if (self.tableName.equals("native.include-directories")) {
			return self.selected(FeNativeDeclaration("include-directory", packageName, self.packagePath(root, "path", true), "", "", "", operatingSystems, architectures, modules), selector);
		}
		if (self.tableName.equals("native.defines")) {
			string name = self.requiredText("name");
			if (!self.identifier(name)) {
				FePackageFailure.fail(f"{self.context()}.name must be an ASCII identifier");
			}
			string value = self.requiredText("value", true);
			return self.selected(FeNativeDeclaration("define", packageName, name, value, "", "", operatingSystems, architectures, modules), selector);
		}
		string name = self.requiredText("name");
		if (!self.nativeName(name)) {
			FePackageFailure.fail(f"{self.context()}.name contains unsupported characters");
		}
		string kind = self.tableName.equals("native.frameworks") ? "framework" : self.tableName.equals("native.libraries") ? "library" : "pkg-config";
		return self.selected(FeNativeDeclaration(kind, packageName, name, "", "", "", operatingSystems, architectures, modules), selector);
	}
}

class FePackageManifestParser {
	private string source;
	private string manifestPath;
	private string root;

	public FePackageManifestParser(string source, string manifestPath, string root) {
		self.source = source;
		self.manifestPath = manifestPath;
		self.root = root;
	}

	private bool identifier(string value) {
		if (value.isEmpty() || (!Strings.isAlpha(value[0]) && value[0] != '_')) {
			return false;
		}
		int index = 1;
		while (index < value.length()) {
			if (!Strings.isAlnum(value[index]) && value[index] != '_') {
				return false;
			}
			index++;
		}
		return true;
	}

	private string textValue(string raw, string context) {
		string value = raw.trim();
		int length = value.length();
		if (length < 2 || !((value[0] == '"' && value[length - 1] == '"') || (value[0] == '\'' && value[length - 1] == '\''))) {
			FePackageFailure.fail(f"{context} must be a TOML string");
		}
		return TOML.unquote(value);
	}

	private FeManifestDependency dependency(string alias, string raw) {
		if (!self.identifier(alias)) {
			FePackageFailure.fail(f"package manifest '{self.manifestPath}' dependency alias " + f"'{alias}' must be an ASCII identifier");
		}
		string value = raw.trim();
		int length = value.length();
		if (length < 2 || value[0] != '{' || value[length - 1] != '}') {
			FePackageFailure.fail(f"dependency '{alias}' in '{self.manifestPath}' must be an inline table");
		}
		Map<string, string> fields = {};
		string body = value.substring(1, length - 2).trim();
		Vector<string> parts = Strings.split(body, ",");
		int index = 0;
		while (index < parts.len) {
			string part = parts.get(index).trim();
			string key = TOML.key(part);
			if (key.isEmpty() || fields.has(key)) {
				FePackageFailure.fail(f"dependency '{alias}' in '{self.manifestPath}' has invalid fields");
			}
			int separator = TOML.unquotedPosition(part, '=');
			fields.put(key, part.substring(separator + 1, part.length() - separator - 1).trim());
			index++;
		}
		Vector<string> keys = fields.keys();
		int sourceCount = (fields.has("path") ? 1 : 0) + (fields.has("git") ? 1 : 0);
		if (sourceCount != 1) {
			FePackageFailure.fail(f"dependency '{alias}' in '{self.manifestPath}' must specify " + "exactly one of path or git");
		}
		int refCount = (fields.has("rev") ? 1 : 0) + (fields.has("tag") ? 1 : 0) + (fields.has("branch") ? 1 : 0);
		if (refCount > 1) {
			FePackageFailure.fail(f"dependency '{alias}' in '{self.manifestPath}' may specify only one Git ref");
		}
		int keyIndex = 0;
		while (keyIndex < keys.len) {
			string key = keys.get(keyIndex);
			bool allowed = key.equals("path") || key.equals("git") || key.equals("rev") || key.equals("tag") || key.equals("branch");
			if (!allowed || (fields.has("path") && !key.equals("path"))) {
				FePackageFailure.fail(f"dependency '{alias}' in '{self.manifestPath}' " + f"contains unexpected field '{key}'");
			}
			keyIndex++;
		}
		string path = fields.has("path") ? self.textValue(fields.get("path"), f"dependency '{alias}' path") : "";
		string git = fields.has("git") ? self.textValue(fields.get("git"), f"dependency '{alias}' git") : "";
		string revision = "HEAD";
		for refName in ["rev", "tag", "branch"] {
			if (fields.has(refName)) {
				revision = self.textValue(fields.get(refName), f"dependency '{alias}' Git ref");
			}
		}
		return FeManifestDependency(alias, path, git, revision);
	}

	private bool nativeTable(string name) { return name.equals("native.sources") || name.equals("native.headers") || name.equals("native.include-directories") || name.equals("native.defines") || name.equals("native.frameworks") || name.equals("native.pkg-config") || name.equals("native.libraries") || name.equals("native.bindings"); }

	/* Library.TOML throws on a malformed basic string. A manifest is user
	 * input, so that becomes a package failure, as tomllib's decode error does
	 * in the Python compiler, rather than an uncaught exception. */
	public FeParsedPackageManifest parse(bool deferNative = false) {
		try {
			return self.parseManifest(deferNative);
		} catch (string error) {
			FePackageFailure.fail(f"cannot parse package manifest '{self.manifestPath}': {error}");
		}
		return null;
	}

	private FeParsedPackageManifest parseManifest(bool deferNative) {
		string section = "";
		FeManifestBlock? block = null;
		var packageFields = FeManifestBlock("package", self.manifestPath);
		bool restrictedExports = false;
		bool sawVersion = false;
		bool sawName = false;
		string packageName = "";
		Vector<FeManifestDependency> dependencies = [];
		Vector<FeManifestBlock> nativeBlocks = [];
		Vector<string> lines = Strings.split(self.source, "\n");
		int index = 0;
		while (index < lines.len) {
			string line = TOML.stripInlineComment(lines.get(index));
			index++;
			if (line.isEmpty()) { continue; }
			/* The line is already comment-free and trimmed, so only a bracketed
			 * line can open a table and every other line is scanned for its
			 * key/value separator exactly once. */
			bool bracketed = line[0] == '[';
			string tableArray = bracketed ? TOML.tableArrayName(line) : "";
			if (!tableArray.isEmpty()) {
				if (!self.nativeTable(tableArray) && tableArray != "package.providers") {
					FePackageFailure.fail(f"package manifest '{self.manifestPath}' contains " + f"unexpected table array '{tableArray}'");
				}
				block = FeManifestBlock(tableArray, self.manifestPath);
				nativeBlocks.push(block);
				section = tableArray;
				continue;
			}
			string table = bracketed ? TOML.sectionName(line) : "";
			if (!table.isEmpty()) {
				string copiedInputPrefix = "native.bindings.copied-inputs.";
				if (table.startsWith(copiedInputPrefix)) {
					string name = TOML.unquote(table.substring(copiedInputPrefix.length(), table.length() - copiedInputPrefix.length()));
					if (block == null || !block.isBinding()) { FePackageFailure.fail("copied-inputs requires a preceding native binding"); }
					block.declareCopiedInput(name); section = copiedInputPrefix + name; continue;
				}
				string initializerPrefix = "native.bindings.initializers.";
				if (table.startsWith(initializerPrefix)) {
					/* C++ factories are selected by their quoted scoped method name. */
					string name = TOML.unquote(table.substring(initializerPrefix.length(), table.length() - initializerPrefix.length()));
					var parts = Strings.split(name, ".");
					bool selectedName = !parts.get(0).isEmpty();
					for component in Strings.split(parts.get(0), "::") { if (!self.identifier(component)) { selectedName = false; } }
					if (block == null || !block.isBinding() || !selectedName || (parts.len != 1 && !(parts.len == 3 && parts.get(1) == "copied-inputs" && self.identifier(parts.get(2))))) { FePackageFailure.fail("initializers requires a preceding native binding and selected function table"); }
					block.declareInitializer(name); section = initializerPrefix + name; continue;
				}
				string snapshotPrefix = "native.bindings.record-snapshots.";
				if (table.startsWith(snapshotPrefix)) {
					string name = table.substring(snapshotPrefix.length(), table.length() - snapshotPrefix.length());
					var parts = Strings.split(name, ".");
					if (block == null || !block.isBinding() || parts.len > 2 || !self.identifier(parts.get(0)) || (parts.len == 2 && !["fields", "byte-plane"].contains(parts.get(1)))) { FePackageFailure.fail("record-snapshots requires a preceding binding and a named snapshot table"); }
					block.declareRecordSnapshot(name); section = snapshotPrefix + name; continue;
				}
				string stringPrefix = "native.bindings.string-views.";
				string copiedPrefix = "native.bindings.copied-results.";
				if (table.startsWith(copiedPrefix)) {
					string name = TOML.unquote(table.substring(copiedPrefix.length(), table.length() - copiedPrefix.length()));
					bool selectedName = !name.isEmpty();
					for component in Strings.split(name, "::") { if (!self.identifier(component)) { selectedName = false; } }
					if (block == null || !block.isBinding() || !selectedName) { FePackageFailure.fail("copied-results requires a preceding native binding and function name"); }
					block.declareCopiedResult(name); section = copiedPrefix + name; continue;
				}
				if (table.startsWith(stringPrefix)) {
					string name = table.substring(stringPrefix.length(), table.length() - stringPrefix.length());
					if (block == null || !block.isBinding() || !self.identifier(name)) { FePackageFailure.fail("string-views requires a preceding native binding and a record name"); }
					block.declareStringView(name);
					section = table;
					continue;
				}
				string callbackPrefix = "native.bindings.callbacks.";
				string outputPrefix = "native.bindings.owned-outputs.";
				string offsetPrefix = "native.bindings.output-offsets.";
				string variadicPrefix = "native.bindings.variadic-calls.";
				if (table.startsWith(variadicPrefix)) {
					string name = TOML.unquote(table.substring(variadicPrefix.length(), table.length() - variadicPrefix.length()));
					if (block == null || !block.isBinding()) { FePackageFailure.fail("variadic-calls requires a preceding native binding"); }
					block.declareVariadicCall(name); section = variadicPrefix + name; continue;
				}
				if (table.startsWith(offsetPrefix)) {
					string name = TOML.unquote(table.substring(offsetPrefix.length(), table.length() - offsetPrefix.length()));
					if (block == null || !block.isBinding()) { FePackageFailure.fail("output-offsets requires a preceding native binding"); }
					block.declareOutputOffset(name); section = offsetPrefix + name; continue;
				}
				if (table.startsWith(outputPrefix)) {
					string name = TOML.unquote(table.substring(outputPrefix.length(), table.length() - outputPrefix.length()));
					if (block == null || !block.isBinding()) { FePackageFailure.fail("owned-outputs requires a preceding native binding"); }
					block.declareOwnedOutput(name); section = outputPrefix + name; continue;
				}
				string copiedOutputPrefix = "native.bindings.copied-outputs.";
				if (table.startsWith(copiedOutputPrefix)) {
					string name = TOML.unquote(table.substring(copiedOutputPrefix.length(), table.length() - copiedOutputPrefix.length()));
					if (block == null || !block.isBinding()) { FePackageFailure.fail("copied-outputs requires a preceding native binding"); }
					block.declareCopiedOutput(name); section = copiedOutputPrefix + name; continue;
				}
				string nativesPrefix = "native.bindings.natives.";
				if (table.startsWith(nativesPrefix)) {
					string name = TOML.unquote(table.substring(nativesPrefix.length(), table.length() - nativesPrefix.length()));
					if (block == null || !block.isBinding() || name.isEmpty()) { FePackageFailure.fail("natives requires a preceding native binding and a class name"); }
					block.declareJavaNatives(name); section = nativesPrefix + name; continue;
				}
				string classesPrefix = "native.bindings.classes.";
				if (table.startsWith(classesPrefix)) {
					string name = TOML.unquote(table.substring(classesPrefix.length(), table.length() - classesPrefix.length()));
					if (block == null || !block.isBinding() || name.isEmpty()) { FePackageFailure.fail("classes requires a preceding native binding and a class name"); }
					block.declareJavaClass(name); section = classesPrefix + name; continue;
				}
				string sinkPrefix = "native.bindings.com-sinks.";
				if (table.startsWith(sinkPrefix)) {
					string name = TOML.unquote(table.substring(sinkPrefix.length(), table.length() - sinkPrefix.length()));
					if (block == null || !block.isBinding() || !self.identifier(name)) { FePackageFailure.fail("com-sinks requires a preceding native binding and a resource name"); }
					block.declareComSink(name); section = sinkPrefix + name; continue;
				}
				if (table.startsWith(callbackPrefix)) {
					if (block == null || !block.isBinding()) { FePackageFailure.fail("callbacks requires a preceding native binding"); }
					string suffix = table.substring(callbackPrefix.length(), table.length() - callbackPrefix.length());
					var admissionPath = Strings.split(suffix, ".super-admission.");
					if (admissionPath.len == 2) {
						string name = TOML.unquote(admissionPath.get(0)); string symbol = TOML.unquote(admissionPath.get(1));
						block.declareCallbackSuperHook(name, symbol); section = callbackPrefix + name + ".super-admission." + symbol; continue;
					}
					if (suffix.endsWith(".super-admission")) {
						string name = TOML.unquote(suffix.substring(0, suffix.length() - 16));
						block.declareCallbackSuper(name); section = callbackPrefix + name + ".super-admission"; continue;
					}
					if (suffix.endsWith(".method-names")) {
						string name = TOML.unquote(suffix.substring(0, suffix.length() - 13));
						block.declareCallbackMethodNames(name); section = callbackPrefix + name + ".method-names"; continue;
					}
					if (suffix.endsWith(".operations")) {
						string name = TOML.unquote(suffix.substring(0, suffix.length() - 11));
						block.declareCallbackOperations(name); section = callbackPrefix + name + ".operations"; continue;
					}
					string name = TOML.unquote(suffix);
					block.declareCallback(name);
					section = callbackPrefix + name;
					continue;
				}
				string unmanagedPrefix = "native.bindings.unmanaged-handles.";
				if (table.startsWith(unmanagedPrefix)) {
					string name = table.substring(unmanagedPrefix.length(), table.length() - unmanagedPrefix.length());
					if (block == null || !block.isBinding() || !self.identifier(name)) { FePackageFailure.fail("unmanaged-handles requires a preceding native binding and a typedef name"); }
					block.declareUnmanagedHandle(name);
					section = table;
					continue;
				}
				if (table.startsWith("native.bindings.resources.")) {
					string name = table.substring(26, table.length() - 26);
					/* A unique resource may carry its callback table and that table's
					 * method map as sub-tables of the same resource declaration. */
					bool subTable = name.endsWith(".table") || name.endsWith(".table.methods") || name.endsWith(".dispatch") || name.endsWith(".dispatch.methods");
					if (name.endsWith(".table.methods")) { name = name.substring(0, name.length() - 14); }
					else if (name.endsWith(".table")) { name = name.substring(0, name.length() - 6); }
					else if (name.endsWith(".dispatch.methods")) { name = name.substring(0, name.length() - 17); }
					else if (name.endsWith(".dispatch")) { name = name.substring(0, name.length() - 9); }
					/* C++ classes are selected by their quoted scoped name. */
					name = TOML.unquote(name);
					bool selectedName = !name.isEmpty();
					for component in Strings.split(name, "::") { if (!self.identifier(component)) { selectedName = false; } }
					if (block == null || !block.isBinding() || !selectedName) { FePackageFailure.fail("resources requires a preceding native binding and a typedef name"); }
					if (!subTable) { block.declareResource(name); }
					string subsection = "";
					for suffix in [".table.methods", ".table", ".dispatch.methods", ".dispatch"] { if (subsection.isEmpty() && table.endsWith(suffix)) { subsection = suffix; } }
					section = "native.bindings.resources." + name + subsection;
					continue;
				}
				if (table.equals("native.bindings.object-fields") || table.equals("native.bindings.borrowed-results") || table.equals("native.bindings.resource-parameters") || table.equals("native.bindings.resource-results") || table.equals("native.bindings.status-results")) {
					if (block == null || !block.isBinding() || section.equals(table)) { FePackageFailure.fail("object-fields requires a preceding native binding"); }
					section = table;
					continue;
				}
				if (!table.equals("package") && !table.equals("dependencies")) {
					FePackageFailure.fail(f"package manifest '{self.manifestPath}' contains " + f"unexpected table '{table}'");
				}
				section = table;
				block = null;
				continue;
			}
			int separator = TOML.unquotedPosition(line, '=');
			string key = separator < 0 ? "" : TOML.unquote(line.substring(0, separator).trim());
			if (key.isEmpty()) {
				FePackageFailure.fail(f"cannot parse package manifest '{self.manifestPath}' line {index}");
			}
			string raw = line.substring(separator + 1, line.length() - separator - 1).trim();
			while (raw.startsWith("[") && TOML.unquotedPosition(raw, ']') < 0 && index < lines.len) {
				string continuation = TOML.stripInlineComment(lines.get(index));
				index++;
				if (!continuation.isEmpty()) {
					raw = raw + continuation;
				}
			}
			if (section.isEmpty()) {
				if (!key.equals("manifest-version") || sawVersion || !raw.equals("1")) {
					FePackageFailure.fail(f"package manifest '{self.manifestPath}' must declare " + "only integer manifest-version = 1 at its root");
				}
				sawVersion = true;
			} else if (section.equals("package")) {
				if (key == "exports") {
					packageFields.set(key, raw);
					restrictedExports = true;
					continue;
				}
				if (!key.equals("name") || sawName) {
					FePackageFailure.fail(f"package manifest '{self.manifestPath}' [package] " + f"contains unexpected or duplicate field '{key}'");
				}
				packageName = self.textValue(raw, f"package manifest '{self.manifestPath}' package.name");
				if (!self.identifier(packageName)) {
					FePackageFailure.fail(f"package manifest '{self.manifestPath}' package.name " + "must be an ASCII identifier");
				}
				sawName = true;
			} else if (section.equals("dependencies")) {
				dependencies.push(self.dependency(key, raw));
			} else {
				string prefix = section.startsWith("native.bindings.copied-results.") || section.startsWith("native.bindings.resources.") || section.startsWith("native.bindings.callbacks.") || section.startsWith("native.bindings.string-views.") || section.startsWith("native.bindings.owned-outputs.") || section.startsWith("native.bindings.output-offsets.") || section.startsWith("native.bindings.variadic-calls.") || section.startsWith("native.bindings.unmanaged-handles.") ? section.substring(16, section.length() - 16) + "." : section.equals("native.bindings.object-fields") ? "object-fields." : section.equals("native.bindings.borrowed-results") ? "borrowed-results." : section.equals("native.bindings.resource-parameters") ? "resource-parameters." : section.equals("native.bindings.resource-results") ? "resource-results." : section.equals("native.bindings.status-results") ? "status-results." : "";
				if (section.startsWith("native.bindings.record-snapshots.")) { prefix = section.substring(16, section.length() - 16) + "."; }
				if (section.startsWith("native.bindings.initializers.")) { prefix = section.substring(16, section.length() - 16) + "."; }
				if (section.startsWith("native.bindings.copied-inputs.")) { prefix = section.substring(16, section.length() - 16) + "."; }
				if (section.startsWith("native.bindings.copied-outputs.") || section.startsWith("native.bindings.com-sinks.") || section.startsWith("native.bindings.natives.") || section.startsWith("native.bindings.classes.")) { prefix = section.substring(16, section.length() - 16) + "."; }
				if (block == null) { FePackageFailure.fail(f"package manifest '{self.manifestPath}' field '{key}' requires a preceding native binding"); }
				block.set(prefix + TOML.unquote(key), raw);
			}
		}
		if (!sawVersion || !sawName) {
			FePackageFailure.fail(f"package manifest '{self.manifestPath}' requires " + "manifest-version = 1 and [package].name");
		}
		Map<string, bool> aliases = {};
		int dependencyIndex = 0;
		while (dependencyIndex < dependencies.len) {
			string alias = dependencies.get(dependencyIndex).alias;
			if (aliases.has(alias)) {
				FePackageFailure.fail(f"package manifest '{self.manifestPath}' duplicates dependency '{alias}'");
			}
			aliases.put(alias, true);
			dependencyIndex++;
		}
		Vector<FeNativeDeclaration> none = [];
		FeParsedPackageManifest parsed = FeParsedPackageManifest(packageName, dependencies, none);
		parsed.restrictedExports = restrictedExports;
		parsed.nativeBlocks = nativeBlocks;
		parsed.packageFields = packageFields;
		parsed.finisher = self;
		if (!deferNative) { parsed.ensureFinished(); }
		return parsed;
	}

	public void finishNative(FeParsedPackageManifest parsed) {
		if (parsed.finished) { return; }
		parsed.finished = true;
		string packageName = parsed.name;
		Vector<FeManifestBlock> nativeBlocks = parsed.nativeBlocks;
		Vector<FeNativeDeclaration> nativeDeclarations = [];
		Vector<FeModuleProvider> providers = [];
		Vector<FeNativeBinding> bindings = [];
		int nativeIndex = 0;
		while (nativeIndex < nativeBlocks.len) {
			if (nativeBlocks.get(nativeIndex).isProvider()) {
				var provider = nativeBlocks.get(nativeIndex).finishProvider(self.root);
				for previous in providers { if (provider.overlaps(previous)) { FePackageFailure.fail("package.providers overlaps a provider for the same module and target"); } }
				providers.push(provider);
				nativeIndex++;
				continue;
			}
			if (nativeBlocks.get(nativeIndex).isBinding()) {
				FeNativeBinding binding = nativeBlocks.get(nativeIndex).finishBinding(self.root, packageName);
				for previous in bindings {
					if (binding.overlaps(previous)) { FePackageFailure.fail(f"package manifest '{self.manifestPath}' overlaps a native binding for the same module and target"); }
				}
				bindings.push(binding);
				nativeIndex++;
				continue;
			}
			FeNativeDeclaration declaration = nativeBlocks.get(nativeIndex).finish(self.root, packageName);
			int prior = 0;
			while (prior < nativeDeclarations.len) {
				if (nativeDeclarations.get(prior).sameIdentity(declaration)) {
					FePackageFailure.fail(f"package manifest '{self.manifestPath}' duplicates " + "a native declaration");
				}
				prior++;
			}
			nativeDeclarations.push(declaration);
			nativeIndex++;
		}
		parsed.nativeDeclarations = nativeDeclarations;
		parsed.bindings = bindings;
		parsed.providers = providers;
		FeManifestBlock? packageFields = parsed.packageFields;
		if (packageFields != null) { parsed.exportedModules = packageFields.modulePaths(self.root, "exports", true); }
	}
}

/* Check every source edge before deduplication. Canonical package ownership
 * makes relative imports, includes and symlinks obey the same export boundary. */
class FePackageImportPolicy {
	private FePackageTarget? target;
	private Map<string, Vector<FeModuleProvider>> providers;
	private Map<string, string> owners;
	/* Every manifest read so far; only versioned ones have a parsed entry. */
	private Map<string, bool> loadedManifests = {};
	private Map<string, FeParsedPackageManifest> manifests;
	private FeSourcePathPolicy paths;
	private FeSourceFileReader files;
	/* Visibility asks for the manifest of every file each source reaches:
	 * a file's answer is remembered, as its directory's owner already is. */
	private Map<string, string> manifestOf = {};

	public FePackageImportPolicy(FePackageTarget? target = null) {
		self.target = target;
		self.providers = {};
		self.owners = {};
		self.manifests = {};
		self.paths = FeSourcePathPolicy();
		self.files = FeSourceFileReader();
	}

	private FeParsedPackageManifest? loadManifest(string manifestPath) {
		if (!self.loadedManifests.has(manifestPath)) {
			string content = self.files.readRequired(manifestPath);
			FeParsedPackageManifest? parsed = null;
			bool versioned = false;
			try {
				versioned = TOML.rootMap(content).has("manifest-version");
			} catch (string error) {
				FePackageFailure.fail(f"cannot parse package manifest '{manifestPath}': {error}");
			}
			if (versioned) { parsed = FePackageManifestParser(content, manifestPath, PathTools.dirname(manifestPath)).parse(); }
			self.loadedManifests.put(manifestPath, true);
			if (parsed != null) {
				self.manifests.put(manifestPath, parsed);
				for provider in parsed.providers {
					string identity = self.paths.identity(provider.module);
					if (!self.providers.has(identity)) { Vector<FeModuleProvider> empty = []; self.providers.put(identity, empty); }
					self.providers.get(identity).push(provider);
				}
			}
		}
		if (!self.manifests.has(manifestPath)) { return null; }
		return self.manifests.get(manifestPath);
	}

	public Vector<string> providersFor(string source) {
		Vector<string> result = [];
		string identity = self.paths.identity(source);
		string manifestPath = self.manifestFor(identity);
		if (manifestPath.isEmpty()) { return result; }
		self.loadManifest(manifestPath);
		if (!self.providers.has(identity)) { return result; }
		FePackageTarget? target = self.target;
		if (target == null) { FePackageFailure.fail(f"module '{source}' requires a compilation target for provider selection"); }
		Vector<FeModuleProvider> candidates = self.providers.get(identity);
		for provider in candidates {
			if (provider.selectedFor(target)) { result.push(provider.implementation); return result; }
		}
		FePackageFailure.fail(f"module '{source}' has no provider for target {target.label()}");
		return result;
	}

	private string manifestFor(string source) {
		if (self.manifestOf.has(source)) { return self.manifestOf.get(source); }
		string directory = PathTools.dirname(self.paths.absolute(source));
		Vector<string> visited = [];
		while (!self.owners.has(directory)) {
			visited.push(directory);
			string candidate = PathTools.join(directory, "btrc.toml");
			if (FileSystem.exists(candidate)) { self.owners.put(directory, self.paths.identity(candidate)); break; }
			string parent = PathTools.dirname(directory);
			if (parent == directory || parent.isEmpty()) { self.owners.put(directory, ""); break; }
			directory = parent;
		}
		string owner = self.owners.get(directory);
		for path in visited { self.owners.put(path, owner); }
		self.manifestOf.put(source, owner);
		return owner;
	}

	public void check(string source, string target) {
		self.checkOwner(source, target);
		self.checkOwner(self.paths.identity(source), self.paths.identity(target));
	}

	private void checkOwner(string source, string target) {
		string owner = self.privateOwner(source, target);
		if (!owner.isEmpty()) { FePackageFailure.fail(f"module '{target}' is private to package '{owner}'; import an exported module"); }
	}

	public bool permitsReference(string source, string target) { return self.privateOwner(source, target).isEmpty() && self.privateOwner(self.paths.identity(source), self.paths.identity(target)).isEmpty(); }

	private string privateOwner(string source, string target) {
		string manifestPath = self.manifestFor(target);
		if (manifestPath.isEmpty() || manifestPath == self.manifestFor(source)) { return ""; }
		var manifest = self.loadManifest(manifestPath);
		if (manifest == null || !manifest.restrictedExports) { return ""; }
		string identity = self.paths.identity(target);
		for exported in manifest.exportedModules { if (self.paths.identity(exported) == identity) { return ""; } }
		return manifest.name;
	}
}

class FeNativeGeneratedUnit {
	public string name;
	public string language;
	public string standard;
	public string memoryManagement;
	public string source;

	public FeNativeGeneratedUnit(string name, string language, string standard, string memoryManagement, string source) {
		self.name = name;
		self.language = language;
		self.standard = standard;
		self.memoryManagement = memoryManagement;
		self.source = source;
	}
}

class FeNativeLinkPlan {
	public FePackageTarget target;
	public Vector<FePackageNode> packages;
	public Vector<FeNativeDeclaration> declarations;
	public Vector<FeNativeGeneratedUnit> generatedUnits;
	/* Ordered absolute paths of secondary compiler outputs (emitted-units). */
	public Vector<string> emittedUnits = [];
	/* SHA-256 of each secondary output's text, in `emittedUnits` order, so
	 * the plan changes whenever any unit of the program does. */
	public Vector<string> emittedUnitDigests = [];
	/* The validated sysroot's identity (FeNativeSysroot) when the compile read
	 * native headers through one, else empty. The plan never holds the path. */
	public string sysrootIdentity = "";

	/* Record one secondary output and the digest of its text. */
	public void addEmittedUnit(string path, string source) {
		self.emittedUnits.push(path);
		self.emittedUnitDigests.push(SHA256.digest(source));
	}

	/* Resolve a complete filename before removing its suffix: '/', '.' and
	 * '..' at the end of a prefix are not yet directory components. Resolve the
	 * parent, not the output itself, so existing files cannot change the plan. */
	class string outputPrefix(string prefix) {
		string suffix = ".unit-1.c";
		string filename = prefix + suffix;
		string parent = PathTools.absolute(PathTools.dirname(filename));
		string first = PathTools.join(parent, PathTools.basename(filename));
		return first.substring(0, first.length() - suffix.length());
	}

	public FeNativeLinkPlan(FePackageTarget target, Vector<FePackageNode> packages, Vector<FeNativeDeclaration> declarations) {
		self.target = target;
		self.packages = packages;
		self.declarations = declarations;
		self.generatedUnits = [];
	}

	/* Known native/package inputs also belong to the output exclusion set,
	 * even when a C compiler rather than this frontend reads their contents. */
	public Vector<string> inputPaths() {
		Map<string, bool> paths = {};
		for package in self.packages {
			paths.put(PathTools.join(package.root, "btrc.toml"), true);
			paths.put(PathTools.join(package.root, "btrc.lock"), true);
			for binding in package.bindings {
				/* A Java binding reads class files through the Java class reader, not a header. */
				if (binding.selectedFor(self.target) && binding.language != "java") { paths.put(binding.header, true); }
			}
		}
		for declaration in self.declarations {
			if ((declaration.kind.equals("source") || declaration.kind.equals("header")) && declaration.selectedFor(self.target)) {
				paths.put(declaration.value, true);
			}
		}
		return paths.keys();
	}

	public Map<string, string> preprocessorDefinitions() {
		Map<string, string> definitions = {};
		for item in self.declarations {
			if (item.kind != "define" || !item.selectedFor(self.target)) { continue; }
			string value = item.detail.isEmpty() ? "1" : item.detail;
			if (definitions.has(item.value) && definitions.get(item.value) != value) { FePackageFailure.fail(f"conflicting native definitions for '{item.value}'"); }
			definitions.put(item.value, value);
		}
		return definitions;
	}

	public Vector<FeNativeBinding> bindingImports() {
		Vector<FeNativeBinding> bindings = [];
		for package in self.packages {
			for binding in package.bindings {
				if (!self.target.known()) { FePackageFailure.fail(FePackageTarget.unknownHostMessage()); }
				if (binding.selectedFor(self.target)) { bindings.push(binding); }
			}
		}
		bindings.sortBy((FeNativeBinding left, FeNativeBinding right) => Strings.lessThan(left.sortKey(), right.sortKey()));
		return bindings;
	}

	public void requireResolvedBindings() {
		Vector<FeNativeBinding> bindings = self.bindingImports();
		if (bindings.len > 0) { FePackageFailure.fail(f"native binding for module '{bindings.get(0).module}' requires BTRC_NATIVE_HEADER_READER for typed header imports"); }
	}

	/* The packages whose root owns one of the program's sources: the deepest
	 * owning root wins for each source. */
	class Map<string, bool> reachedPackages(Vector<FePackageNode> packages, Vector<string> sourcePaths) {
		FeSourcePathPolicy sourcePolicy = FeSourcePathPolicy();
		Map<string, string> roots = {};
		int packageIndex = 0;
		while (packageIndex < packages.len) {
			FePackageNode package = packages.get(packageIndex);
			roots.put(package.name, sourcePolicy.identity(package.root));
			packageIndex++;
		}
		Map<string, bool> reached = {};
		int sourceIndex = 0;
		while (sourceIndex < sourcePaths.len) {
			string source = sourcePolicy.identity(sourcePaths.get(sourceIndex));
			FePackageNode? owner = null;
			int ownerLength = -1;
			packageIndex = 0;
			while (packageIndex < packages.len) {
				FePackageNode candidate = packages.get(packageIndex);
				string root = roots.get(candidate.name);
				if (FeNativeLinkPlan.rootOwns(source, root) && root.length() > ownerLength) {
					owner = candidate;
					ownerLength = root.length();
				}
				packageIndex++;
			}
			if (owner != null) { reached.put(owner.name, true); }
			sourceIndex++;
		}
		return reached;
	}

	class bool rootOwns(string source, string root) {
		string prefix = root.endsWith(Platform.pathSeparator()) ? root : root + Platform.pathSeparator();
		return source.equals(root) || source.startsWith(prefix);
	}

	public void restrictToSources(Vector<string> sourcePaths) {
		FeSourcePathPolicy sourcePolicy = FeSourcePathPolicy();
		Map<string, bool> reached = FeNativeLinkPlan.reachedPackages(self.packages, sourcePaths);
		Map<string, bool> sources = {};
		int sourceIndex = 0;
		while (sourceIndex < sourcePaths.len) {
			sources.put(sourcePolicy.identity(sourcePaths.get(sourceIndex)), true);
			sourceIndex++;
		}
		int packageIndex = 0;

		Vector<FePackageNode> selectedPackages = [];
		packageIndex = 0;
		while (packageIndex < self.packages.len) {
			FePackageNode package = self.packages.get(packageIndex);
			if (reached.has(package.name)) {
				Map<string, string> dependencies = {};
				Vector<string> aliases = package.dependencies.keys();
				int aliasIndex = 0;
				while (aliasIndex < aliases.len) {
					string alias = aliases.get(aliasIndex);
					string target = package.dependencies.get(alias);
					if (reached.has(target)) {
						dependencies.put(alias, target);
					}
					aliasIndex++;
				}
				FePackageNode selected = FePackageNode(package.name, package.root, dependencies, package.sourcePath, package.manifestHash, package.nativeDeclarations);
				for binding in package.bindings {
					if (sources.has(sourcePolicy.identity(binding.module))) { selected.bindings.push(binding); }
				}
				selectedPackages.push(selected);
			}
			packageIndex++;
		}

		Vector<FeNativeDeclaration> selectedDeclarations = [];
		int declarationIndex = 0;
		while (declarationIndex < self.declarations.len) {
			FeNativeDeclaration declaration = self.declarations.get(declarationIndex);
			bool moduleReached = declaration.modules.len == 0;
			int moduleIndex = 0;
			while (moduleIndex < declaration.modules.len) {
				if (sources.has(sourcePolicy.identity(declaration.modules.get(moduleIndex)))) {
					moduleReached = true;
				}
				moduleIndex++;
			}
			if (reached.has(declaration.packageName) && moduleReached) {
				selectedDeclarations.push(declaration);
			}
			declarationIndex++;
		}
		self.packages = selectedPackages;
		self.declarations = selectedDeclarations;
	}

	/* The stdlib root manifest names btrc_stdlib_runtime and depends only on path packages
	 * inside the stdlib tree, one per group folder; every package in that graph carries a
	 * reserved btrc_stdlib_ identity and keeps its native metadata beside its modules. */
	public void includeStdlib(string stdlibDirectory, Vector<string> sources, FeSourceFileReader sourceFiles) {
		string root = FeCanonicalPath.absolute(stdlibDirectory);
		string path = PathTools.join(root, "btrc.toml");
		if (!FileSystem.exists(path)) { return; }
		Vector<FePackageNode> libraryPackages = [];
		Map<string, string> namesByRoot = {};
		Vector<string> loading = [];
		Map<string, FeParsedPackageManifest> manifestsByName = {};
		Map<string, string> sourcesByName = {};
		self.loadStdlibPackage(root, path, "", sourceFiles, libraryPackages, namesByRoot, loading, manifestsByName, sourcesByName);
		BtrccPhaseTimer.mark("stdlib-manifests");
		/* Only a package whose root owns one of the program's sources can
		 * contribute native metadata (restrictToSources drops the rest), so
		 * only those finish their native blocks and hash their manifest text. */
		Map<string, bool> reached = FeNativeLinkPlan.reachedPackages(libraryPackages, sources);
		for package in libraryPackages {
			if (!reached.has(package.name)) { continue; }
			FeParsedPackageManifest manifest = manifestsByName.get(package.name);
			manifest.ensureFinished();
			package.nativeDeclarations = manifest.nativeDeclarations;
			package.bindings = manifest.bindings;
			package.manifestHash = SHA256.digest(sourcesByName.get(package.name));
		}
		BtrccPhaseTimer.mark("stdlib-finish");
		Vector<FeNativeDeclaration> declarations = [];
		for package in libraryPackages { declarations.extend(package.nativeDeclarations); }
		var selected = FeNativeLinkPlan(self.target, libraryPackages, declarations);
		selected.restrictToSources(sources);
		BtrccPhaseTimer.mark("stdlib-restrict");
		if (selected.declarations.len == 0 && selected.bindingImports().len == 0) { return; }
		for existing in self.packages {
			if (!existing.name.startsWith("btrc_stdlib_")) { continue; }
			for package in libraryPackages {
				if (!package.name.equals(existing.name)) { continue; }
				if (package.manifestHash.isEmpty()) { package.manifestHash = SHA256.digest(sourcesByName.get(package.name)); }
				if (FeSourcePathPolicy().identity(existing.root).equals(FeSourcePathPolicy().identity(package.root)) && existing.manifestHash.equals(package.manifestHash)) { return; }
			}
			FePackageFailure.fail(f"package identity '{existing.name}' is reserved for compiler-owned stdlib runtimes");
		}
		self.packages.extend(selected.packages);
		self.declarations.extend(selected.declarations);
	}

	private string loadStdlibPackage(string root, string path, string alias, FeSourceFileReader sourceFiles, Vector<FePackageNode> packages, Map<string, string> namesByRoot, Vector<string> loading, Map<string, FeParsedPackageManifest> manifestsByName, Map<string, string> sourcesByName) {
		string packageRoot = PathTools.dirname(path);
		if (loading.contains(packageRoot)) { FePackageFailure.fail(f"stdlib package dependency cycle through '{path}'"); }
		loading.push(packageRoot);
		string source = sourceFiles.readRequired(path);
		FeParsedPackageManifest manifest = FePackageManifestParser(source, path, packageRoot).parse(true);
		if (alias.isEmpty() && !manifest.name.equals("btrc_stdlib_runtime")) { FePackageFailure.fail("stdlib manifest must declare btrc_stdlib_runtime"); }
		if (!alias.isEmpty() && !manifest.name.startsWith("btrc_stdlib_")) { FePackageFailure.fail(f"stdlib group '{alias}' must declare a btrc_stdlib_ package identity"); }
		for package in packages { if (package.name.equals(manifest.name)) { FePackageFailure.fail(f"duplicate stdlib package identity '{manifest.name}'"); } }
		Map<string, string> dependencies = {};
		for dependency in manifest.dependencies {
			if (dependency.path.isEmpty()) { FePackageFailure.fail(f"stdlib dependency '{dependency.alias}' must be a path package inside the stdlib"); }
			string targetRoot = FeCanonicalPath.absolute(PathTools.join(packageRoot, dependency.path));
			/* Compare path identities: they use one separator and one case on
			 * every host, where the native spelling on Windows does not. */
			FeSourcePathPolicy identities = FeSourcePathPolicy();
			if (!identities.identity(targetRoot).startsWith(identities.identity(root) + "/")) { FePackageFailure.fail(f"stdlib dependency '{dependency.alias}' must stay inside the stdlib tree"); }
			string targetName = namesByRoot.has(targetRoot) ? namesByRoot.get(targetRoot) : self.loadStdlibPackage(root, PathTools.join(targetRoot, "btrc.toml"), dependency.alias, sourceFiles, packages, namesByRoot, loading, manifestsByName, sourcesByName);
			dependencies.put(dependency.alias, targetName);
		}
		Vector<FeNativeDeclaration> none = [];
		var package = FePackageNode(manifest.name, packageRoot, dependencies, packageRoot, "", none);
		packages.push(package);
		manifestsByName.put(manifest.name, manifest);
		sourcesByName.put(manifest.name, source);
		namesByRoot.put(packageRoot, manifest.name);
		loading.pop();
		return manifest.name;
	}

	private Vector<FeNativeDeclaration> selected(string kind) {
		Vector<FeNativeDeclaration> values = [];
		int index = 0;
		while (index < self.declarations.len) {
			FeNativeDeclaration declaration = self.declarations.get(index);
			if (declaration.kind.equals(kind) && declaration.selectedFor(self.target)) {
				values.push(declaration);
			}
			index++;
		}
		values.sortBy((FeNativeDeclaration left, FeNativeDeclaration right) => Strings.lessThan(left.sortKey(), right.sortKey()));
		return values;
	}

	private JSONValue pathRecords(string kind) {
		JSONValue result = JSONValue.makeArray();
		Vector<FeNativeDeclaration> values = self.selected(kind);
		int index = 0;
		while (index < values.len) {
			FeNativeDeclaration declaration = values.get(index);
			JSONValue record = JSONValue.makeObject();
			record.set("package", JSONValue.makeString(declaration.packageName));
			record.set("path", JSONValue.makeString(declaration.value));
			result.push(record);
			index++;
		}
		return result;
	}

	private JSONValue nameRecords(string kind) {
		JSONValue result = JSONValue.makeArray();
		Vector<FeNativeDeclaration> values = self.selected(kind);
		int index = 0;
		while (index < values.len) {
			FeNativeDeclaration declaration = values.get(index);
			JSONValue record = JSONValue.makeObject();
			record.set("name", JSONValue.makeString(declaration.value));
			record.set("package", JSONValue.makeString(declaration.packageName));
			result.push(record);
			index++;
		}
		return result;
	}

	private JSONValue defineRecords() {
		JSONValue result = JSONValue.makeArray();
		Vector<FeNativeDeclaration> values = self.selected("define");
		int index = 0;
		while (index < values.len) {
			FeNativeDeclaration declaration = values.get(index);
			JSONValue record = JSONValue.makeObject();
			record.set("name", JSONValue.makeString(declaration.value));
			record.set("package", JSONValue.makeString(declaration.packageName));
			record.set("value", JSONValue.makeString(declaration.detail));
			result.push(record);
			index++;
		}
		return result;
	}

	private JSONValue unitRecords() {
		JSONValue result = JSONValue.makeArray();
		Vector<FeNativeDeclaration> values = self.selected("source");
		int index = 0;
		while (index < values.len) {
			FeNativeDeclaration declaration = values.get(index);
			JSONValue record = JSONValue.makeObject();
			record.set("language", JSONValue.makeString(declaration.language));
			record.set("package", JSONValue.makeString(declaration.packageName));
			record.set("path", JSONValue.makeString(declaration.value));
			record.set("standard", JSONValue.makeString(declaration.standard));
			result.push(record);
			index++;
		}
		return result;
	}

	private JSONValue packageRecords() {
		Vector<FePackageNode> sorted = [];
		int copyIndex = 0;
		while (copyIndex < self.packages.len) {
			sorted.push(self.packages.get(copyIndex));
			copyIndex++;
		}
		sorted.sortBy((FePackageNode left, FePackageNode right) => Strings.lessThan(left.name, right.name));
		JSONValue result = JSONValue.makeArray();
		int index = 0;
		while (index < sorted.len) {
			FePackageNode package = sorted.get(index);
			JSONValue dependencies = JSONValue.makeObject();
			Vector<string> aliases = package.dependencies.keys();
			aliases.sortBy((string left, string right) => Strings.lessThan(left, right));
			int aliasIndex = 0;
			while (aliasIndex < aliases.len) {
				string alias = aliases.get(aliasIndex);
				dependencies.set(alias, JSONValue.makeString(package.dependencies.get(alias)));
				aliasIndex++;
			}
			JSONValue record = JSONValue.makeObject();
			record.set("dependencies", dependencies);
			record.set("name", JSONValue.makeString(package.name));
			record.set("root", JSONValue.makeString(package.root));
			result.push(record);
			index++;
		}
		return result;
	}

	public string linkerLanguage() {
		for unit in self.generatedUnits {
			if (unit.language == "c++" || unit.language == "objective-c++") { return "c++"; }
		}
		Vector<FeNativeDeclaration> sources = self.selected("source");
		int index = 0;
		while (index < sources.len) {
			string language = sources.get(index).language;
			if (language.equals("c++") || language.equals("objective-c++")) {
				return "c++";
			}
			index++;
		}
		return "c";
	}

	private bool generatedIdentifier(string name) {
		if (name.isEmpty()) { return false; }
		for (int index = 0; index < name.length(); index++) {
			char c = name[index];
			if (c == '_' || (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')) { continue; }
			if (index > 0 && c >= '0' && c <= '9') { continue; }
			return false;
		}
		return true;
	}

	/* Reconstruct generated parts over today's resolved package facts. Exact
	 * canonical equality rejects stale targets, roots, flags and unknown fields. */
	public FeNativeLinkPlan? withCachedArtifacts(string serialized, int count, string prefix, Vector<string> unitSources) {
		if (count < 0 || (count > 0 && prefix.isEmpty()) || unitSources.len != count) { return null; }
		var document = JSONValue.parse(serialized);
		if (!document.isObject()) { return null; }
		var restored = FeNativeLinkPlan(self.target, self.packages, self.declarations);
		restored.sysrootIdentity = self.sysrootIdentity;
		var names = new Map<string, bool>();
		if (document.has("generated-units")) {
			var records = document.get("generated-units");
			if (!records.isArray()) { return null; }
			for (int index = 0; index < records.size(); index++) {
				var row = records.at(index);
				if (!row.isObject() || row.size() != 5) { return null; }
				for key in ["name", "language", "standard", "memory-management", "source"] {
					if (!row.get(key).isString() || row.get(key).asString().isEmpty()) { return null; }
				}
				string name = row.get("name").asString();
				string language = row.get("language").asString();
				string standard = row.get("standard").asString();
				string memory = row.get("memory-management").asString();
				if (!self.generatedIdentifier(name) || names.has(name)) { return null; }
				if (!((language == "objective-c" && standard == "c11" && memory == "arc") || (language == "c++" && standard == "c++17" && memory == "raii"))) { return null; }
				names.put(name, true);
				restored.generatedUnits.push(FeNativeGeneratedUnit(name, language, standard, memory, row.get("source").asString()));
			}
		}
		Vector<string>? units = FeNativeLinkPlan.cachedUnitPaths(document, prefix, count);
		if (units == null) { return null; }
		for (int index = 0; index < units.len; index++) { restored.addEmittedUnit(units.get(index), unitSources.get(index)); }
		return restored.canonicalJson().equals(serialized) ? restored : null;
	}

	/* A secondary unit is written as <prefix>.<name>.c: numbered for packed
	 * units, named for its compilation group in a module-unit program. */
	class bool validUnitName(string name) {
		if (!name.startsWith("unit-") || name.length() <= 5) { return false; }
		int index = 5;
		while (index < name.length()) {
			char letter = name[index];
			bool alphanumeric = (letter >= 'a' && letter <= 'z') || (letter >= 'A' && letter <= 'Z') || (letter >= '0' && letter <= '9');
			if (!alphanumeric && (index == 5 || (letter != '-' && letter != '_'))) { return false; }
			index = index + 1;
		}
		return true;
	}

	/* The emitted unit paths a stored plan records under the current prefix,
	 * or null unless there are exactly `count` distinct well-formed ones. */
	class Vector<string>? cachedUnitPaths(JSONValue document, string prefix, int count) {
		Vector<string> paths = [];
		if (count == 0) {
			if (document.has("emitted-units")) { return null; }
			return paths;
		}
		if (prefix.isEmpty() || !document.has("emitted-units")) { return null; }
		var emitted = document.get("emitted-units");
		if (!emitted.isArray() || emitted.size() != count) { return null; }
		string head = FeNativeLinkPlan.outputPrefix(prefix) + ".";
		Map<string, bool> seen = {};
		for (int index = 0; index < count; index++) {
			if (!emitted.at(index).isString()) { return null; }
			string path = emitted.at(index).asString();
			if (!path.startsWith(head) || !path.endsWith(".c") || path.length() <= head.length() + 2) { return null; }
			string name = path.substring(head.length(), path.length() - head.length() - 2);
			if (!FeNativeLinkPlan.validUnitName(name) || seen.has(name)) { return null; }
			seen.put(name, true);
			paths.push(path);
		}
		return paths;
	}

	/* The schema-5 target identity: the selected row, never a host fact. */
	private JSONValue targetRecord() {
		GeneratedTargetRow row = self.target.row();
		JSONValue record = JSONValue.makeObject();
		record.set("arch", JSONValue.makeString(row.architecture));
		record.set("environment", JSONValue.makeString(row.environment));
		record.set("label", JSONValue.makeString(row.label));
		record.set("minimum", JSONValue.makeString(row.minimumVersion));
		record.set("os", JSONValue.makeString(row.operatingSystem));
		record.set("triple", JSONValue.makeString(row.triple));
		return record;
	}

	/* The row's clang target arguments and sysroot identity, with no path. */
	private JSONValue toolchainRecord() {
		GeneratedTargetRow row = self.target.row();
		JSONValue sysroot = JSONValue.makeObject();
		sysroot.set("identity", JSONValue.makeString(self.sysrootIdentity));
		sysroot.set("kind", JSONValue.makeString(row.sysrootKind));
		sysroot.set("name", JSONValue.makeString(row.sysrootName));
		JSONValue arguments = JSONValue.makeArray();
		for argument in row.targetArguments { arguments.push(JSONValue.makeString(argument)); }
		JSONValue record = JSONValue.makeObject();
		record.set("sysroot", sysroot);
		record.set("target-arguments", arguments);
		return record;
	}

	/* The frozen schema-5 plan (platform-target-contract.md section 4.1),
	 * byte-identical to the reference compiler's NativeLinkPlan.as_dict. */
	public string canonicalJson() {
		JSONValue root = JSONValue.makeObject();
		root.set("defines", self.defineRecords());
		if (self.emittedUnits.len > 0) {
			var digests = JSONValue.makeArray();
			for digest in self.emittedUnitDigests { digests.push(JSONValue.makeString(digest)); }
			root.set("emitted-unit-digests", digests);
			var emitted = JSONValue.makeArray();
			for path in self.emittedUnits { emitted.push(JSONValue.makeString(path)); }
			root.set("emitted-units", emitted);
		}
		root.set("frameworks", self.nameRecords("framework"));
		if (self.generatedUnits.len > 0) {
			Vector<FeNativeGeneratedUnit> ordered = [];
			for unit in self.generatedUnits { ordered.push(unit); }
			ordered.sortBy((FeNativeGeneratedUnit left, FeNativeGeneratedUnit right) => Strings.lessThan(left.name, right.name));
			var generated = JSONValue.makeArray();
			for unit in ordered {
				var record = JSONValue.makeObject();
				record.set("language", JSONValue.makeString(unit.language));
				record.set("memory-management", JSONValue.makeString(unit.memoryManagement));
				record.set("name", JSONValue.makeString(unit.name));
				record.set("source", JSONValue.makeString(unit.source));
				record.set("standard", JSONValue.makeString(unit.standard));
				generated.push(record);
			}
			root.set("generated-units", generated);
		}
		root.set("headers", self.pathRecords("header"));
		root.set("include-directories", self.pathRecords("include-directory"));
		/* System libraries the program links (`-l<name>`), present exactly when a
		 * selected package declares one, so plans without them are unchanged. */
		JSONValue libraries = self.nameRecords("library");
		if (libraries.size() > 0) { root.set("libraries", libraries); }
		root.set("linker-language", JSONValue.makeString(self.linkerLanguage()));
		root.set("packages", self.packageRecords());
		root.set("pkg-config", self.nameRecords("pkg-config"));
		root.set("schema", JSONValue.makeInt(5));
		root.set("target", self.targetRecord());
		root.set("toolchain", self.toolchainRecord());
		root.set("units", self.unitRecords());
		return root.stringify() + "\n";
	}
}

/* One owned, flushed candidate. Publication consumes its name; cleanup never
 * removes an unrelated replacement placed at that name. Group publication
 * stages every payload before consuming any candidate. */
class FeStagedFile {
	private string destination;
	private string temporaryPath;
	private FileSnapshot identity;
	private FileSnapshot directoryIdentity;

	public FeStagedFile(string destination, string temporaryPath, FileSnapshot identity, FileSnapshot directoryIdentity) {
		self.destination = destination;
		self.temporaryPath = temporaryPath;
		self.identity = identity;
		self.directoryIdentity = directoryIdentity;
	}

	private FileSystemError? syncDirectory() {
		string directory = PathTools.dirname(self.destination);
		int descriptor = open(directory, (int)O_RDONLY | (int)O_DIRECTORY | (int)O_CLOEXEC | (int)O_NOFOLLOW);
		if (descriptor < 0) { return FileSystemError.fromNative("open publication directory", directory, errno); }
		struct stat opened;
		struct stat current;
		errno = 0;
		if (fstat(descriptor, &opened) != 0 || lstat(directory, &current) != 0) {
			int nativeCode = errno;
			close(descriptor);
			return FileSystemError.fromNative("inspect publication directory", directory, nativeCode);
		}
		var openedIdentity = FileSnapshot.fromStatus(&opened);
		var currentIdentity = FileSnapshot.fromStatus(&current);
		if (openedIdentity.kind() != FILE_DIRECTORY || currentIdentity.kind() != FILE_DIRECTORY || !self.directoryIdentity.sameObject(openedIdentity) || !self.directoryIdentity.sameObject(currentIdentity)) {
			close(descriptor);
			return FileSystemError.changed("flush publication directory", directory);
		}
		int flushed = -1;
		do { errno = 0; flushed = fsync(descriptor); } while (flushed != 0 && errno == EINTR);
		int flushError = flushed == 0 ? 0 : errno;
		errno = 0;
		int closed = close(descriptor);
		int closeError = closed == 0 ? 0 : errno;
		if (flushError != 0 || closeError != 0) { return FileSystemError.fromNative("flush publication directory", directory, flushError != 0 ? flushError : closeError); }
		return null;
	}

	public DurableReplaceOutcome publish() {
		if (self.temporaryPath.isEmpty()) { return DurableReplaceOutcome.failed(FileSystemError.closed("publish candidate", self.destination)); }
		var current = FileSystem.inspectExact(self.temporaryPath);
		if (!current.ok() || !self.identity.sameVersion(current.value())) {
			return DurableReplaceOutcome.failed(FileSystemError.changed("validate publication candidate", self.temporaryPath));
		}
		var parent = FileSystem.inspectExact(PathTools.dirname(self.destination));
		if (!parent.ok() || parent.value().kind() != FILE_DIRECTORY || !self.directoryIdentity.sameObject(parent.value())) {
			return DurableReplaceOutcome.failed(FileSystemError.changed("validate publication directory", self.destination));
		}
		errno = 0;
		if (rename(self.temporaryPath, self.destination) != 0) {
			int nativeCode = errno;
			return DurableReplaceOutcome.failed(FileSystemError.fromNative("publish candidate", self.destination, nativeCode));
		}
		self.temporaryPath = "";
		var error = self.syncDirectory();
		if (error != null) { return DurableReplaceOutcome.durabilityUncertain(error); }
		return DurableReplaceOutcome.succeeded();
	}

	public bool discard() {
		if (self.temporaryPath.isEmpty()) { return true; }
		var current = FileSystem.inspectExact(self.temporaryPath);
		if (!current.ok()) {
			if (current.error().kind() != FS_NOT_FOUND) { return false; }
			self.temporaryPath = "";
			return true;
		}
		if (current.value().kind() != FILE_REGULAR || !self.identity.sameObject(current.value())) { return false; }
		if (unlink(self.temporaryPath) != 0) { return false; }
		self.temporaryPath = "";
		return true;
	}

	public void __del__() { self.discard(); }
}

/* Same-filesystem candidates for package state and compiler outputs. Manifests
 * never supply an output path or command-shaped data. */
class FePackageFileStore {
	public FeStagedFile? stage(string path, string content, int mode = 0644) {
		if (path == null || path.isEmpty() || content == null || mode < 0 || mode > 07777) { return null; }
		string directory = PathTools.absolute(PathTools.dirname(path));
		var parent = FileSystem.inspectExact(directory);
		if (!parent.ok() || parent.value().kind() != FILE_DIRECTORY) { return null; }
		string destination = PathTools.join(directory, PathTools.basename(path));
		string templatePath = PathTools.join(directory, ".btrc-package-XXXXXX");
		int templateLength = templatePath.length();
		char* mutablePath = (char*)__btrc_safe_realloc(NULL, (size_t)templateLength + (size_t)1);
		memcpy(mutablePath, templatePath, (size_t)templateLength + (size_t)1);
		int descriptor = mkstemp(mutablePath);
		if (descriptor < 0) { free(mutablePath); return null; }
		string temporaryPath = Strings.copy(mutablePath);
		free(mutablePath);
		struct stat created;
		bool identified = fstat(descriptor, &created) == 0;
		bool written = identified && fcntl(descriptor, F_SETFD, FD_CLOEXEC) == 0 && fchmod(descriptor, (mode_t)mode) == 0;
		size_t length = strlen(content);
		size_t offset = (size_t)0;
		while (written && offset < length) {
			ssize_t count = write(descriptor, (char*)content + offset, length - offset);
			if (count > (ssize_t)0) { offset = offset + (size_t)count; }
			else if (count < (ssize_t)0 && errno == EINTR) { continue; }
			else { written = false; }
		}
		int flushed = -1;
		if (written) { do { errno = 0; flushed = fsync(descriptor); } while (flushed != 0 && errno == EINTR); }
		struct stat staged;
		bool inspected = fstat(descriptor, &staged) == 0;
		bool closed = close(descriptor) == 0;
		if (!written || flushed != 0 || !inspected || !closed) {
			/* The name can change even when writing fails. Only discard the
			 * inode observed through our own descriptor; if neither metadata
			 * read succeeded, preserve the uncertain candidate for inspection. */
			if (inspected) { FeStagedFile(destination, temporaryPath, FileSnapshot.fromStatus(&staged), parent.value()).discard(); }
			else if (identified) { FeStagedFile(destination, temporaryPath, FileSnapshot.fromStatus(&created), parent.value()).discard(); }
			return null;
		}
		return FeStagedFile(destination, temporaryPath, FileSnapshot.fromStatus(&staged), parent.value());
	}

	public bool writeAtomically(string path, string content) {
		var candidate = self.stage(path, content);
		if (candidate == null) { return false; }
		var published = candidate.publish();
		bool discarded = candidate.discard();
		return published.committed() && discarded;
	}
}

class FePackageLock {
	private FeSourceFileReader sourceFiles;

	public FePackageLock(FeSourceFileReader sourceFiles) { self.sourceFiles = sourceFiles; }

	private bool exactKeys(JSONValue value, Vector<string> expected) {
		if (!value.isObject() || value.size() != expected.len) { return false; }
		int index = 0;
		while (index < expected.len) {
			if (!value.has(expected.get(index))) { return false; }
			index++;
		}
		return true;
	}

	private bool identifier(string value) {
		if (value.isEmpty() || (!Strings.isAlpha(value[0]) && value[0] != '_')) {
			return false;
		}
		int index = 1;
		while (index < value.length()) {
			if (!Strings.isAlnum(value[index]) && value[index] != '_') {
				return false;
			}
			index++;
		}
		return true;
	}

	private bool hexadecimal(string value, int length) {
		if (value.length() != length) { return false; }
		int index = 0;
		while (index < length) {
			char current = value[index];
			if (!((current >= '0' && current <= '9') || (current >= 'a' && current <= 'f'))) {
				return false;
			}
			index++;
		}
		return true;
	}

	private bool validPathSource(JSONValue source) { return self.exactKeys(source, ["path"]) && source.get("path").isString() && !source.get("path").asString().isEmpty() && !PathTools.isAbsolute(source.get("path").asString()); }

	private bool validGitSource(JSONValue source) { return self.exactKeys(source, ["commit", "git", "rev"]) && source.get("commit").isString() && source.get("git").isString() && source.get("rev").isString() && self.hexadecimal(source.get("commit").asString(), 40) && !source.get("git").asString().isEmpty() && !source.get("rev").asString().isEmpty() && !source.get("rev").asString().startsWith("-"); }

	private bool validPackage(JSONValue package) {
		if (!self.exactKeys(package, ["dependencies", "manifest-hash", "name", "source"])) {
			return false;
		}
		if (!package.get("dependencies").isObject() || !package.get("manifest-hash").isString() || !self.hexadecimal(package.get("manifest-hash").asString(), 64) || !package.get("name").isString() || !self.identifier(package.get("name").asString())) {
			return false;
		}
		Vector<string> aliases = package.get("dependencies").keys();
		int aliasIndex = 0;
		while (aliasIndex < aliases.len) {
			string alias = aliases.get(aliasIndex);
			JSONValue target = package.get("dependencies").get(alias);
			if (!self.identifier(alias) || !target.isString() || !self.identifier(target.asString())) { return false; }
			aliasIndex++;
		}
		JSONValue source = package.get("source");
		return self.validPathSource(source) || self.validGitSource(source);
	}

	public string validatedExisting(string path) {
		if (!FileSystem.exists(path)) { return ""; }
		if (!FileSystem.isFile(path)) {
			FePackageFailure.fail(f"strict package lock '{path}' is not a file");
		}
		string source = self.sourceFiles.readRequired(path);
		JSONValue lock = JSONValue.parse(source);
		if (!lock.isObject() || lock.isError()) {
			FePackageFailure.fail(f"cannot parse strict package lock '{path}' as UTF-8 JSON");
		}
		JSONValue schema = lock.get("schema");
		if (!schema.isInt()) {
			FePackageFailure.fail(f"invalid package lock schema in '{path}'");
		}
		if (schema.asInt() == 1 || schema.asInt() == 2) { return ""; }
		if (schema.asInt() != 3) {
			FePackageFailure.fail(f"unsupported btrc.lock schema {schema.asInt()} in '{path}' " + "(this compiler supports schema 3 for version-1 manifests)");
		}
		if (!self.exactKeys(lock, ["manifest-hash", "packages", "root", "schema"]) || !lock.get("manifest-hash").isString() || !self.hexadecimal(lock.get("manifest-hash").asString(), 64) || !lock.get("root").isString() || !self.identifier(lock.get("root").asString()) || !lock.get("packages").isArray()) {
			FePackageFailure.fail(f"invalid schema-3 package lock '{path}'");
		}
		Map<string, bool> names = {};
		Vector<string> dependencyTargets = [];
		int index = 0;
		while (index < lock.get("packages").size()) {
			JSONValue package = lock.get("packages").at(index);
			if (!self.validPackage(package) || names.has(package.get("name").asString())) {
				FePackageFailure.fail(f"invalid schema-3 package in '{path}'");
			}
			names.put(package.get("name").asString(), true);
			Vector<string> aliases = package.get("dependencies").keys();
			int aliasIndex = 0;
			while (aliasIndex < aliases.len) {
				dependencyTargets.push(package.get("dependencies").get(aliases.get(aliasIndex)).asString());
				aliasIndex++;
			}
			index++;
		}
		if (!names.has(lock.get("root").asString())) {
			FePackageFailure.fail(f"invalid schema-3 package graph in '{path}'");
		}
		int targetIndex = 0;
		while (targetIndex < dependencyTargets.len) {
			if (!names.has(dependencyTargets.get(targetIndex))) {
				FePackageFailure.fail(f"invalid schema-3 package graph in '{path}'");
			}
			targetIndex++;
		}
		return source;
	}

	private string relativePath(string root, string target) {
		bool windows = Platform.isWindows();
		string rootSlash = root.replace("\\", "/");
		string targetSlash = target.replace("\\", "/");
		int rootPrefixLength = PathTools.rootLengthFor(rootSlash, windows);
		int targetPrefixLength = PathTools.rootLengthFor(targetSlash, windows);
		string rootPrefix = rootSlash.substring(0, rootPrefixLength);
		string targetPrefix = targetSlash.substring(0, targetPrefixLength);
		bool samePrefix = false;
		if (windows) {
			samePrefix = rootPrefix.toLower().equals(targetPrefix.toLower());
		} else {
			samePrefix = rootPrefix.equals(targetPrefix);
		}
		if (!samePrefix) {
			FePackageFailure.fail(f"package path '{target}' is not portable relative to '{root}'");
		}
		Vector<string> rootParts = Strings.split(rootSlash.substring(rootPrefixLength, rootSlash.length() - rootPrefixLength), "/");
		Vector<string> targetParts = Strings.split(targetSlash.substring(targetPrefixLength, targetSlash.length() - targetPrefixLength), "/");
		int common = 0;
		int rootCount = rootParts.len;
		int targetCount = targetParts.len;
		while (common < rootCount && common < targetCount) {
			string left = rootParts.get(common);
			string right = targetParts.get(common);
			bool equal = false;
			if (windows) { equal = left.toLower().equals(right.toLower()); }
			else { equal = left.equals(right); }
			if (!equal) { break; }
			common++;
		}
		Vector<string> result = [];
		int rootIndex = common;
		while (rootIndex < rootCount) {
			if (!rootParts.get(rootIndex).isEmpty()) { result.push(".."); }
			rootIndex++;
		}
		int targetIndex = common;
		while (targetIndex < targetCount) {
			if (!targetParts.get(targetIndex).isEmpty()) {
				result.push(targetParts.get(targetIndex));
			}
			targetIndex++;
		}
		return result.len == 0 ? "." : Strings.join(result, Platform.pathSeparator());
	}

	public string payload(string root, string rootPackage, Vector<FePackageNode> packages) {
		Vector<FePackageNode> sorted = [];
		int copyIndex = 0;
		while (copyIndex < packages.len) {
			sorted.push(packages.get(copyIndex));
			copyIndex++;
		}
		sorted.sortBy((FePackageNode left, FePackageNode right) => Strings.lessThan(left.name, right.name));
		JSONValue packageValues = JSONValue.makeArray();
		int packageIndex = 0;
		while (packageIndex < sorted.len) {
			FePackageNode package = sorted.get(packageIndex);
			JSONValue dependencies = JSONValue.makeObject();
			Vector<string> aliases = package.dependencies.keys();
			aliases.sortBy((string left, string right) => Strings.lessThan(left, right));
			int aliasIndex = 0;
			while (aliasIndex < aliases.len) {
				string alias = aliases.get(aliasIndex);
				dependencies.set(alias, JSONValue.makeString(package.dependencies.get(alias)));
				aliasIndex++;
			}
			JSONValue source = JSONValue.makeObject();
			source.set("path", JSONValue.makeString(self.relativePath(root, package.sourcePath)));
			JSONValue record = JSONValue.makeObject();
			record.set("dependencies", dependencies);
			record.set("manifest-hash", JSONValue.makeString(package.manifestHash));
			record.set("name", JSONValue.makeString(package.name));
			record.set("source", source);
			packageValues.push(record);
			packageIndex++;
		}
		string graphHash = SHA256.digest(packageValues.stringify());
		JSONValue lock = JSONValue.makeObject();
		lock.set("manifest-hash", JSONValue.makeString(graphHash));
		lock.set("packages", packageValues);
		lock.set("root", JSONValue.makeString(rootPackage));
		lock.set("schema", JSONValue.makeInt(3));
		return lock.stringify();
	}
}

class FeResolvedPackages {
	public bool versioned;
	public string manifestPath;
	public string rootPackage;
	public Map<string, FePackageNode> nodes;
	public FeNativeLinkPlan linkPlan;

	public FeResolvedPackages(bool versioned, string manifestPath, string rootPackage, Map<string, FePackageNode> nodes, FeNativeLinkPlan linkPlan) {
		self.versioned = versioned;
		self.manifestPath = manifestPath;
		self.rootPackage = rootPackage;
		self.nodes = nodes;
		self.linkPlan = linkPlan;
	}

	private FePackageNode? ownerFor(string sourcePath) {
		string source = FeCanonicalPath.absolute(sourcePath);
		Vector<string> names = self.nodes.keys();
		FePackageNode? best = null;
		int bestLength = -1;
		int index = 0;
		while (index < names.len) {
			FePackageNode package = self.nodes.get(names.get(index));
			string prefix = package.root.endsWith(Platform.pathSeparator()) ? package.root : package.root + Platform.pathSeparator();
			string comparedSource = Platform.isWindows() ? source.toLower() : source;
			string comparedRoot = Platform.isWindows() ? package.root.toLower() : package.root;
			string comparedPrefix = Platform.isWindows() ? prefix.toLower() : prefix;
			if ((comparedSource.equals(comparedRoot) || comparedSource.startsWith(comparedPrefix)) && package.root.length() > bestLength) {
				best = package;
				bestLength = package.root.length();
			}
			index++;
		}
		return best;
	}

	public Vector<string> pathsForImport(string spec, string sourcePath) {
		Vector<string> result = [];
		if (!self.versioned) { return result; }
		int separator = spec.indexOf(".");
		string alias = separator < 0 ? spec : spec.substring(0, separator);
		string rest = separator < 0 ? "" : spec.substring(separator + 1, spec.length() - separator - 1);
		FePackageNode? owner = self.ownerFor(sourcePath);
		if (owner == null || !owner.dependencies.has(alias)) { return result; }
		string targetName = owner.dependencies.get(alias);
		if (!self.nodes.has(targetName)) {
			FePackageFailure.fail(f"package graph is missing dependency target '{targetName}'");
		}
		FePackageNode target = self.nodes.get(targetName);
		string module = rest.isEmpty() ? target.name : rest;
		string relative = module.replace(".", "/") + ".btrc";
		string underSource = PathTools.join(PathTools.join(target.root, "src"), relative);
		string underRoot = PathTools.join(target.root, relative);
		if (FileSystem.isFile(underSource)) {
			result.push(underSource);
			return result;
		}
		if (FileSystem.isFile(underRoot)) {
			result.push(underRoot);
			return result;
		}
		FePackageFailure.fail(f"package import '{spec}' not found in dependency '{alias}'\n" + f"  package root: {target.root}");
		return result;
	}
}

class FePackageGraphResolver {
	private FeSourceFileReader sourceFiles;
	private Map<string, FePackageNode> nodesByRoot;
	private Map<string, string> rootsByName;
	private Map<string, bool> visiting;
	private Vector<string> visitingOrder;

	public FePackageGraphResolver(FeSourceFileReader sourceFiles) {
		self.sourceFiles = sourceFiles;
		self.nodesByRoot = {};
		self.rootsByName = {};
		self.visiting = {};
		self.visitingOrder = [];
	}

	private string findManifest(string sourcePath) {
		string directory = FeCanonicalPath.absolute(PathTools.dirname(sourcePath));
		while (!directory.isEmpty()) {
			string manifest = PathTools.join(directory, "btrc.toml");
			if (FileSystem.isFile(manifest)) { return manifest; }
			string parent = PathTools.dirname(directory);
			if (parent.equals(directory)) { break; }
			directory = parent;
		}
		return "";
	}

	private string cycleDiagnostic(string repeated) {
		Vector<string> names = [];
		bool collecting = false;
		int index = 0;
		while (index < self.visitingOrder.len) {
			string root = self.visitingOrder.get(index);
			if (root.equals(repeated)) { collecting = true; }
			if (collecting) { names.push(PathTools.basename(root)); }
			index++;
		}
		names.push(PathTools.basename(repeated));
		return Strings.join(names, " -> ");
	}

	private string resolveNode(string root) {
		string canonical = FeCanonicalPath.absolute(root);
		if (self.nodesByRoot.has(canonical)) {
			return self.nodesByRoot.get(canonical).name;
		}
		if (self.visiting.has(canonical)) {
			FePackageFailure.fail("package dependency cycle: " + self.cycleDiagnostic(canonical));
		}
		string manifestPath = PathTools.join(canonical, "btrc.toml");
		if (!FileSystem.isFile(manifestPath)) {
			FePackageFailure.fail(f"package dependency root '{canonical}' is missing btrc.toml");
		}
		string source = self.sourceFiles.readRequired(manifestPath);
		FeParsedPackageManifest manifest = FePackageManifestParser(source, manifestPath, canonical).parse();
		if (self.rootsByName.has(manifest.name) && !self.rootsByName.get(manifest.name).equals(canonical)) {
			FePackageFailure.fail(f"package name '{manifest.name}' resolves to both " + f"'{self.rootsByName.get(manifest.name)}' and '{canonical}'");
		}
		self.rootsByName.put(manifest.name, canonical);
		self.visiting.put(canonical, true);
		self.visitingOrder.push(canonical);
		Map<string, string> dependencies = {};
		Vector<FeManifestDependency> sortedDependencies = [];
		int copyIndex = 0;
		while (copyIndex < manifest.dependencies.len) {
			sortedDependencies.push(manifest.dependencies.get(copyIndex));
			copyIndex++;
		}
		sortedDependencies.sortBy((FeManifestDependency left, FeManifestDependency right) => Strings.lessThan(left.alias, right.alias));
		int index = 0;
		while (index < sortedDependencies.len) {
			FeManifestDependency dependency = sortedDependencies.get(index);
			if (!dependency.git.isEmpty()) {
				FePackageFailure.fail(f"Git dependency '{dependency.alias}' is not yet supported by btrcc");
			}
			if (PathTools.isAbsolute(dependency.path)) {
				FePackageFailure.fail(f"path dependency '{dependency.alias}' must be relative");
			}
			string dependencyRoot = FeCanonicalPath.absolute(PathTools.join(canonical, dependency.path));
			if (!FileSystem.isDir(dependencyRoot)) {
				FePackageFailure.fail(f"path dependency '{dependency.alias}' does not name a directory: " + f"'{dependency.path}'");
			}
			dependencies.put(dependency.alias, self.resolveNode(dependencyRoot));
			index++;
		}
		self.visiting.remove(canonical);
		self.visitingOrder.pop();
		FePackageNode node = FePackageNode(manifest.name, canonical, dependencies, canonical, SHA256.digest(source), manifest.nativeDeclarations);
		node.bindings = manifest.bindings;
		self.nodesByRoot.put(canonical, node);
		return manifest.name;
	}

	/* The driver selects and checks the target before reading a source;
	 * other callers get the same message through the package failure. */
	private FePackageTarget planTarget(string targetValue) {
		if (targetValue == null || targetValue.isEmpty()) {
			return FePackageTarget.host();
		}
		FePackageTarget selected = FePackageTarget("", "", "");
		try {
			selected = FePackageTarget.parse(targetValue);
		} catch (string error) {
			FePackageFailure.fail(error);
		}
		return selected;
	}

	public FeResolvedPackages resolveFor(string sourcePath, string targetValue) {
		FePackageTarget target = self.planTarget(targetValue);
		string manifestPath = self.findManifest(sourcePath);
		if (manifestPath.isEmpty()) {
			Map<string, FePackageNode> emptyNodes = {};
			Vector<FePackageNode> emptyPackages = [];
			Vector<FeNativeDeclaration> emptyDeclarations = [];
			FeNativeLinkPlan emptyPlan = FeNativeLinkPlan(target, emptyPackages, emptyDeclarations);
			return FeResolvedPackages(false, "", "", emptyNodes, emptyPlan);
		}
		string rootSource = self.sourceFiles.readRequired(manifestPath);
		if (rootSource.indexOf("manifest-version") < 0) {
			Map<string, FePackageNode> legacyNodes = {};
			Vector<FePackageNode> legacyPackages = [];
			Vector<FeNativeDeclaration> legacyDeclarations = [];
			FeNativeLinkPlan legacyPlan = FeNativeLinkPlan(target, legacyPackages, legacyDeclarations);
			return FeResolvedPackages(false, manifestPath, "", legacyNodes, legacyPlan);
		}
		if (!target.known()) { FePackageFailure.fail(FePackageTarget.unknownHostMessage()); }
		string root = FeCanonicalPath.absolute(PathTools.dirname(manifestPath));
		string lockPath = PathTools.join(root, "btrc.lock");
		/* The old lock is validated derived state, not the input version this
		 * compile publishes against. Record the resulting lock below, after any
		 * compiler-owned rewrite, so first and subsequent lookups agree. */
		FePackageLock lock = FePackageLock(FeSourceFileReader());
		string existingLock = lock.validatedExisting(lockPath);
		string rootPackage = self.resolveNode(root);
		Map<string, FePackageNode> nodes = {};
		Vector<FePackageNode> packages = [];
		Vector<FeNativeDeclaration> declarations = [];
		Vector<string> roots = self.nodesByRoot.keys();
		int index = 0;
		while (index < roots.len) {
			FePackageNode node = self.nodesByRoot.get(roots.get(index));
			nodes.put(node.name, node);
			packages.push(node);
			int nativeIndex = 0;
			while (nativeIndex < node.nativeDeclarations.len) {
				declarations.push(node.nativeDeclarations.get(nativeIndex));
				nativeIndex++;
			}
			index++;
		}
		FeNativeLinkPlan plan = FeNativeLinkPlan(target, packages, declarations);
		string lockPayload = lock.payload(root, rootPackage, packages);
		if (!existingLock.equals(lockPayload) && !FePackageFileStore().writeAtomically(lockPath, lockPayload)) {
			FePackageFailure.fail(f"cannot atomically publish package lock '{lockPath}'");
		}
		if (!self.sourceFiles.readRequired(lockPath).equals(lockPayload)) {
			FePackageFailure.fail(f"package lock changed during resolution: '{lockPath}'");
		}
		return FeResolvedPackages(true, manifestPath, rootPackage, nodes, plan);
	}
}
