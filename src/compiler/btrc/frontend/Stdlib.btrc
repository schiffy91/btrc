/* Standard-library snapshots, lookup, and symbol-index owners. */

import Library.FileSystem;
import Library.Map;
import Library.Strings;
import Library.Vector;

import ./Models.btrc;
import ./SourceIo.btrc;

class FeStdlibLookup {
	public bool found;
	public string path;
	public string diagnostic;

	public FeStdlibLookup(bool found, string path, string diagnostic) {
		self.found = found;
		self.path = path;
		self.diagnostic = diagnostic;
	}
}

class FeStdlibRepository {
	private string directoryPath;
	private FeSourceDirectoryScanner sourceDirectories;
	private FeSourceFileReader sourceFiles;
	private FeSourcePathPolicy sourcePaths;

	public FeStdlibRepository(string directory, FeSourceFileReader sourceFiles) {
		self.sourcePaths = FeSourcePathPolicy();
		self.directoryPath = self.sourcePaths.absolute(directory);
		self.sourceDirectories = FeSourceDirectoryScanner();
		self.sourceFiles = sourceFiles;
	}

	public string directory() { return self.directoryPath; }

	private int snapshotIndexOf(FeStdlibRootSnapshot snapshot, string path) {
		string identity = self.sourcePaths.identity(path);
		int index = 0;
		while (index < snapshot.count()) {
			if (self.sourcePaths.identity(snapshot.pathAt(index)).equals(identity)) {
				return index;
			}
			index++;
		}
		return -1;
	}

	public bool snapshotContains(FeStdlibRootSnapshot snapshot, string path) { return self.snapshotIndexOf(snapshot, path) >= 0; }

	public bool snapshotContainsSource(FeStdlibRootSnapshot snapshot, string path) {
		if (snapshot.count() == 0) { return false; }
		string directory = self.sourcePaths.identity(self.sourcePaths.directoryName(snapshot.pathAt(0)));
		string source = self.sourcePaths.identity(path);
		return source.startsWith(directory + "/");
	}

	private bool containsPath(Vector<string> paths, string target) {
		int index = 0;
		while (index < paths.len) {
			if (paths.get(index).equals(target)) { return true; }
			index++;
		}
		return false;
	}

	private Vector<string> discoverFiles() {
		Vector<string> ordered = [];
		if (!FileSystem.isDir(self.directoryPath)) { return ordered; }
		Vector<string> files = self.sourceDirectories.sortedNamesWithSuffix(self.directoryPath, ".btrc");
		Vector<string> priority = [
			"Vector.btrc",
			"List.btrc",
			"Strings.btrc",
			"Platform.btrc",
			"Process.btrc",
		];
		int priorityIndex = 0;
		while (priorityIndex < priority.len) {
			string name = priority.get(priorityIndex);
			if (self.containsPath(files, name)) { ordered.push(name); }
			priorityIndex++;
		}
		int index = 0;
		while (index < files.len) {
			string name = files.get(index);
			if (!self.containsPath(priority, name)) { ordered.push(name); }
			index++;
		}
		return ordered;
	}

	/* The generated symbol index beside the root modules, when it describes
	 * exactly the snapshot on disk. Null means missing, stale or malformed, and
	 * the caller derives the index by parsing instead; nothing is written. */
	public Map<string, Vector<string>>? loadSymbolIndex(FeStdlibRootSnapshot snapshot) {
		string indexPath = self.sourcePaths.join(self.directoryPath, "btrc.symbols");
		if (!FileSystem.isFile(indexPath)) { return null; }
		string text = self.sourceFiles.readRequired(indexPath);
		string header = "btrc-symbols 1 " + FeStdlibSymbolDigest.describe(snapshot);
		int length = text.length();
		int lineStart = 0;
		int lineEnd = 0;
		while (lineEnd < length && text[lineEnd] != '\n') { lineEnd++; }
		if (lineEnd >= length || !text.substring(0, lineEnd).equals(header)) { return null; }
		Map<string, Vector<string>> symbols = {};
		lineStart = lineEnd + 1;
		while (lineStart < length) {
			lineEnd = lineStart;
			int tab = -1;
			while (lineEnd < length && text[lineEnd] != '\n') {
				if (tab < 0 && text[lineEnd] == '\t') { tab = lineEnd; }
				lineEnd++;
			}
			if (lineEnd > lineStart) {
				if (tab <= lineStart || tab + 1 >= lineEnd) { return null; }
				string name = text.substring(lineStart, tab - lineStart);
				string relative = text.substring(tab + 1, lineEnd - tab - 1);
				if (relative.indexOf("/") >= 0 || relative.indexOf("\\") >= 0 || relative[0] == '.') { return null; }
				string path = self.sourcePaths.join(self.directoryPath, relative);
				if (!symbols.has(name)) {
					Vector<string> owners = [];
					symbols.put(name, owners);
				}
				symbols.get(name).push(path);
			}
			lineStart = lineEnd + 1;
		}
		return symbols;
	}

	public FeStdlibRootSnapshot rootSnapshot() {
		Vector<string> paths = [];
		Vector<string> sources = [];
		Vector<string> files = self.discoverFiles();
		int index = 0;
		while (index < files.len) {
			string path = self.sourcePaths.join(self.directoryPath, files.get(index));
			if (FileSystem.isFile(path)) {
				string source = self.sourceFiles.readRequired(path);
				paths.push(path);
				sources.push(source);
			}
			index++;
		}
		return FeStdlibRootSnapshot(paths, sources);
	}

	/* Prefer captured root-module paths. The one-level nested fallback mirrors
     * Python's stdlib lookup; its source is read once into this compilation's
     * resolved AST and never enters the external root-symbol index. */
	public string findFileForCompilation(string includePath, FeStdlibRootSnapshot snapshot) {
		string direct = self.sourcePaths.join(self.directoryPath, includePath);
		if (self.snapshotContains(snapshot, direct)) { return direct; }
		if (FileSystem.isFile(direct)) { return direct; }
		string base = self.sourcePaths.baseName(includePath);
		if (!FileSystem.isDir(self.directoryPath)) { return ""; }
		return self.sourceDirectories.firstEntryWithChildFile(self.directoryPath, base);
	}

	public FeStdlibLookup requiredModuleForCompilation(string name, FeStdlibRootSnapshot snapshot) {
		if (name.contains(".")) {
			string nested = self.sourcePaths.join(self.directoryPath, Strings.replace(name, ".", "/") + ".btrc");
			if (FileSystem.isFile(nested)) { return FeStdlibLookup(true, nested, ""); }
			return FeStdlibLookup(false, "", f"stdlib import 'Library.{name}' not found\n  searched: {self.directoryPath}");
		}
		string filename = name.endsWith(".btrc") ? name : name + ".btrc";
		string path = self.findFileForCompilation(filename, snapshot);
		if (!path.isEmpty()) { return FeStdlibLookup(true, path, ""); }
		return FeStdlibLookup(false, "", f"stdlib import 'Library.{name}' not found\n  searched: {self.directoryPath}");
	}

	/* Every native adapter and nested source graph now lives in a group folder
	 * (src/stdlib/README.md), so no root module needs an exemption today. */
	private bool explicitModulePath(string path) { return false; }

	/* Legacy relaxed composition and the core archive strip imports before
     * concatenating root modules. Native adapters with nested source-graph or
     * compiler-owned native-link dependencies remain explicit imports so the
     * resolver retains those requirements. */
	public bool relaxedCompositionPath(string path) { return !self.explicitModulePath(path); }

	public Vector<string> relaxedRootPaths(FeStdlibRootSnapshot snapshot) {
		Vector<string> paths = [];
		int index = 0;
		while (index < snapshot.count()) {
			string path = snapshot.pathAt(index);
			if (self.relaxedCompositionPath(path)) { paths.push(path); }
			index++;
		}
		return paths;
	}

	public string readSourceForCompilation(string path, FeStdlibRootSnapshot snapshot) {
		int index = self.snapshotIndexOf(snapshot, path);
		if (index >= 0) { return snapshot.sourceAt(index); }
		return self.sourceFiles.readRequired(path);
	}
}

/* Digest of the root stdlib snapshot as the generated symbol index records it:
 * CRC-32 (zlib semantics) over each module's file name, a zero byte, its bytes
 * and a zero byte, in discovery order, then the byte and file counts. Mirrors
 * src/compiler/python/frontend/symbol_index.py, which writes the index. */
class FeStdlibSymbolDigest {
	class Vector<unsigned int> crcTable() {
		Vector<unsigned int> table = [];
		for (int index = 0; index < 256; index++) {
			unsigned int entry = (unsigned int)index;
			for (int bit = 0; bit < 8; bit++) {
				entry = (entry & 1U) != 0U ? (0xedb88320U ^ (entry >> 1)) : (entry >> 1);
			}
			table.push(entry);
		}
		return table;
	}

	class unsigned int updateByte(Vector<unsigned int> table, unsigned int crc, unsigned int value) {
		unsigned int state = crc ^ 0xffffffffU;
		state = table.get((int)((state ^ value) & 0xffU)) ^ (state >> 8);
		return state ^ 0xffffffffU;
	}

	class unsigned int updateText(Vector<unsigned int> table, unsigned int crc, string text) {
		unsigned int state = crc ^ 0xffffffffU;
		int length = text.length();
		for (int index = 0; index < length; index++) {
			unsigned int value = (unsigned int)((unsigned char)text[index]);
			state = table.get((int)((state ^ value) & 0xffU)) ^ (state >> 8);
		}
		return state ^ 0xffffffffU;
	}

	class string hex8(unsigned int value) {
		string digits = "0123456789abcdef";
		string rendered = "";
		for (int shift = 28; shift >= 0; shift -= 4) {
			rendered += digits.substring((int)((value >> shift) & 0xfU), 1);
		}
		return rendered;
	}

	class string describe(FeStdlibRootSnapshot snapshot) {
		Vector<unsigned int> table = FeStdlibSymbolDigest.crcTable();
		unsigned int crc = 0U;
		int byteCount = 0;
		int fileCount = snapshot.count();
		for (int index = 0; index < fileCount; index++) {
			string source = snapshot.sourceAt(index);
			crc = FeStdlibSymbolDigest.updateText(table, crc, PathTools.basename(snapshot.pathAt(index)));
			crc = FeStdlibSymbolDigest.updateByte(table, crc, 0U);
			crc = FeStdlibSymbolDigest.updateText(table, crc, source);
			crc = FeStdlibSymbolDigest.updateByte(table, crc, 0U);
			byteCount += source.length();
		}
		return FeStdlibSymbolDigest.hex8(crc) + "-" + Strings.fromInt(byteCount) + "-" + Strings.fromInt(fileCount);
	}
}

class FeStdlibSymbolIndex {
	private Map<string, Vector<string>> symbolFiles;
	private FeStdlibRootSnapshot indexedSnapshot;
	private bool initialized;

	public FeStdlibSymbolIndex() {
		self.symbolFiles = {};
		Vector<string> emptyPaths = [];
		Vector<string> emptySources = [];
		self.indexedSnapshot = FeStdlibRootSnapshot(emptyPaths, emptySources);
		self.initialized = false;
	}

	public bool currentFor(FeStdlibRootSnapshot snapshot) { return self.initialized && self.indexedSnapshot.sameContents(snapshot); }

	public void replace(FeStdlibRootSnapshot snapshot, Map<string, Vector<string>> symbolFiles) {
		self.indexedSnapshot = snapshot;
		self.symbolFiles = symbolFiles;
		self.initialized = true;
	}

	private bool containsPath(Vector<string> paths, string path) {
		int index = 0;
		while (index < paths.len) {
			if (paths.get(index).equals(path)) { return true; }
			index++;
		}
		return false;
	}

	public void mergeInto(Map<string, Vector<string>> target) {
		Vector<string> names = self.symbolFiles.keys();
		int nameIndex = 0;
		while (nameIndex < names.len) {
			string name = names.get(nameIndex);
			Vector<string> owners = self.symbolFiles.get(name);
			Vector<string> merged = [];
			if (target.has(name)) { merged = target.get(name); }
			int ownerIndex = 0;
			while (ownerIndex < owners.len) {
				string owner = owners.get(ownerIndex);
				if (!self.containsPath(merged, owner)) { merged.push(owner); }
				ownerIndex++;
			}
			target.put(name, merged);
			nameIndex++;
		}
	}
}
