/* Bounded source filesystem, path, and decoding owners. */

import Library.Bytes;
import Library.Digest.SHA256;
import Library.FileSystem;
import Library.FileSystem.FileSystemHandles;
import Library.Map;
import Library.IO;
import Library.Platform;
import Library.Strings;
import Library.Vector;

import ./Models.btrc;

/* Canonical absolute paths, memoized for the process. Every realpath walks
 * the whole path (about 15 microseconds on a cloud-synced volume) and the
 * package loaders ask for the same package roots hundreds of times in one
 * compile. The compiler is single-threaded and the tree is stable while one
 * compile runs, so one answer per spelling is exact for that compile; the
 * pipeline resets the memo before each compile. */
class FeCanonicalPath {
	class Map<string, string>? memo = null;

	/* Forget every answer; the pipeline calls this at the start of a compile. */
	class void reset() { FeCanonicalPath.memo = null; }

	class string absolute(string path) {
		Map<string, string>? memo = FeCanonicalPath.memo;
		if (memo == null) { memo = {}; FeCanonicalPath.memo = memo; }
		if (memo.has(path)) { return memo.get(path); }
		string result = PathTools.absolute(path);
		memo.put(path, result);
		return result;
	}
}

class FeSourcePathPolicy {
	private bool windows;
	private string currentDirectory;
	/* Canonical identities by the path as asked. Each answer costs a
	 * realpath system call, and the import checks ask for the same handful
	 * of files once per reference. */
	private Map<string, string> identities;

	public FeSourcePathPolicy() {
		self.windows = Platform.isWindows();
		self.currentDirectory = FileSystem.currentDirectory();
		self.identities = {};
	}

	public bool isSeparatorFor(char value, bool windows) { return value == '/' || (windows && value == '\\'); }

	public bool hasDriveFor(string path, bool windows) {
		if (!windows || path == null || path.length() < 2) { return false; }
		char drive = path[0];
		return ((drive >= 'A' && drive <= 'Z') || (drive >= 'a' && drive <= 'z')) && path[1] == ':';
	}

	public bool isAbsoluteFor(string path, bool windows) {
		if (path == null || path.isEmpty()) { return false; }
		if (!windows) { return path[0] == '/'; }
		if (self.hasDriveFor(path, true)) {
			return path.length() >= 3 && self.isSeparatorFor(path[2], true);
		}
		return path.length() >= 2 && self.isSeparatorFor(path[0], true) && self.isSeparatorFor(path[1], true);
	}

	public bool isRootRelativeFor(string path, bool windows) { return windows && path != null && !path.isEmpty() && self.isSeparatorFor(path[0], true) && !self.isAbsoluteFor(path, true); }

	public string slashFormFor(string path, bool windows) {
		if (path == null) { return ""; }
		return windows ? Strings.replace(path, "\\", "/") : Strings.copy(path);
	}

	public string composeFor(string path, string current, bool windows) {
		string input = self.slashFormFor(path, windows);
		string cwd = self.slashFormFor(current, windows);
		if (self.isAbsoluteFor(input, windows)) { return input; }
		if (self.isRootRelativeFor(input, windows)) {
			if (self.hasDriveFor(cwd, true)) {
				return cwd.substring(0, 2) + input;
			}
			return input;
		}
		if (self.hasDriveFor(input, windows)) {
			string drive = input.substring(0, 2);
			string suffix = input.substring(2, input.length() - 2);
			if (self.hasDriveFor(cwd, true) && cwd.substring(0, 2).toLower().equals(drive.toLower())) {
				return cwd + "/" + suffix;
			}
			return drive + "/" + suffix;
		}
		if (cwd.isEmpty()) { return input; }
		if (cwd.endsWith("/")) { return cwd + input; }
		return cwd + "/" + input;
	}

	public string normalizeAbsoluteFor(string path, string current, bool windows) {
		string composed = self.composeFor(path, current, windows);
		bool driveRoot = self.hasDriveFor(composed, windows) && composed.length() >= 3 && composed[2] == '/';
		bool uncRoot = windows && composed.startsWith("//");
		bool posixRoot = !windows && composed.startsWith("/");
		int start = driveRoot ? 3 : (uncRoot ? 2 : (posixRoot ? 1 : 0));
		int floor = uncRoot ? 2 : 0;
		Vector<string> parts = Strings.split(composed.substring(start, composed.length() - start), "/");
		Vector<string> stack = [];
		int i = 0;
		while (i < parts.len) {
			string segment = parts.get(i);
			if (segment.isEmpty() || segment.equals(".")) {
				/* Empty and current-directory components have no path identity. */
			} else if (segment.equals("..")) {
				if (stack.len > floor) { stack.pop(); }
			} else {
				stack.push(segment);
			}
			i++;
		}
		string out = driveRoot ? composed.substring(0, 3) : (uncRoot ? "//" : (posixRoot ? "/" : ""));
		int index = 0;
		while (index < stack.len) {
			if (!out.isEmpty() && !out.endsWith("/")) { out = out + "/"; }
			out = out + stack.get(index);
			index++;
		}
		if (out.isEmpty()) {
			if (driveRoot) { return composed.substring(0, 3); }
			if (uncRoot) { return "//"; }
			if (posixRoot) { return "/"; }
			return ".";
		}
		return out;
	}

	public string absolute(string path) {
		string input = path;
		/* _fullpath resolves drive-relative paths and the current drive for a
         * root-relative path.  POSIX stays lexical so source-map spellings do not
         * unexpectedly follow a symlink. */
		if (self.windows) {
			string nativeAbsolute = PathTools.absolute(path);
			if (!nativeAbsolute.isEmpty()) { input = nativeAbsolute; }
		}
		return self.normalizeAbsoluteFor(input, self.currentDirectory, self.windows);
	}

	public string identity(string path) {
		if (self.identities.has(path)) { return self.identities.get(path); }
		string canonical = FeCanonicalPath.absolute(path);
		if (canonical.isEmpty()) { canonical = self.absolute(path); }
		string normalized = self.normalizeAbsoluteFor(canonical, self.currentDirectory, self.windows);
		string result = self.windows ? normalized.toLower() : normalized;
		self.identities.put(path, result);
		return result;
	}

	public string directoryName(string path) { return PathTools.dirname(path); }

	public string baseName(string path) { return PathTools.basename(path); }

	public string join(string left, string right) { return PathTools.join(left, right); }
}
class FeUtf8SourceDecoder {
	private bool continuation(int value) { return value >= 128 && value <= 191; }

	private bool validAt(Bytes data, int index, int width) {
		if (index + width > data.len) { return false; }
		int lead = data.get(index);
		int second = data.get(index + 1);
		if (!self.continuation(second)) { return false; }
		if (width == 2) { return lead >= 194 && lead <= 223; }
		int third = data.get(index + 2);
		if (!self.continuation(third)) { return false; }
		if (width == 3) {
			if (lead == 224 && second < 160) { return false; }
			if (lead == 237 && second > 159) { return false; }
			return lead >= 224 && lead <= 239;
		}
		int fourth = data.get(index + 3);
		if (!self.continuation(fourth)) { return false; }
		if (lead == 240 && second < 144) { return false; }
		if (lead == 244 && second > 143) { return false; }
		return lead >= 240 && lead <= 244;
	}

	private int widthAt(Bytes data, int index) {
		int lead = data.get(index);
		if (lead == 0) { return 0; }
		if (lead <= 127) { return 1; }
		if (lead >= 194 && lead <= 223 && self.validAt(data, index, 2)) { return 2; }
		if (lead >= 224 && lead <= 239 && self.validAt(data, index, 3)) { return 3; }
		if (lead >= 240 && lead <= 244 && self.validAt(data, index, 4)) { return 4; }
		return 0;
	}

	/* Validate over the raw buffer and copy in runs: a byte-at-a-time walk
	 * through the checked accessor cost more than reading the file. */
	public string decode(Bytes data, string path) {
		int length = data.len;
		char* raw = data.data;
		int index = 0;
		if (length >= 3 && (unsigned char)raw[0] == 239 && (unsigned char)raw[1] == 187 && (unsigned char)raw[2] == 191) {
			index = 3;
		}
		Bytes normalized = Bytes();
		int runStart = index;
		while (index < length) {
			int lead = (int)((unsigned char)raw[index]);
			if (lead == 0) {
				fprintf(stderr, "error: source file '%s' is not valid UTF-8 at byte %d\n", path, index);
				exit(1);
			}
			if (lead == 13) {
				if (index > runStart) { normalized.appendRaw(raw + runStart, index - runStart); }
				normalized.append(10);
				index++;
				if (index < length && (unsigned char)raw[index] == 10) { index++; }
				runStart = index;
				continue;
			}
			if (lead <= 127) {
				index++;
				continue;
			}
			int width = self.widthAt(data, index);
			if (width == 0) {
				fprintf(stderr, "error: source file '%s' is not valid UTF-8 at byte %d\n", path, index);
				exit(1);
			}
			index = index + width;
		}
		if (index > runStart) { normalized.appendRaw(raw + runStart, index - runStart); }
		return normalized.toStringLossy();
	}
}

/* Source bytes and their original path binding travel together. No native
 * descriptor is retained for the duration of compilation. */
class FeSourceReadIdentity {
	private string path;
	private string canonical;
	private FileSnapshot version;

	public FeSourceReadIdentity(string path, FileSnapshot version) {
		self.path = PathTools.isAbsolute(path) ? path : PathTools.join(FileSystem.currentDirectory(), path);
		self.canonical = PathTools.absolute(self.path);
		self.version = version;
	}

	public string validate() {
		if (!PathTools.absolute(self.path).equals(self.canonical)) { return "source input changed after read: " + self.path; }
		var current = FileSystem.inspectExact(self.canonical);
		if (!current.ok() || !self.version.sameVersion(current.snapshot())) { return "source input changed after read: " + self.path; }
		return "";
	}

	public bool sameVersion(FileSnapshot version) { return self.version.sameVersion(version); }
}

/* Fail-closed source-file input for one compiler application.  A source file is
 * read until the operating system reports end of file; only real open, read,
 * close, decoding, and allocation failures are diagnosed.  Buffer growth keeps
 * its own integer-overflow protection. */
class FeSourceFileReader {
	private FeUtf8SourceDecoder decoder;
	private Map<string, bool> readPaths = {};
	private Map<string, FeSourceReadIdentity> readIdentities = {};
	private Map<string, string> contentDigests = {};

	public FeSourceFileReader() { self.decoder = FeUtf8SourceDecoder(); }

	/* Copied inventory of successful reads, including grammar, manifests and
	 * stdlib metadata as well as source text. Output validation consumes it. */
	public Vector<string> inputPaths() { return self.readPaths.keys(); }

	/* Content and requested/canonical names, never modification times. Fresh
	 * resolution discovers removed imports and newly shadowing files first. */
	public string contentIdentity() {
		var digest = SHA256();
		var paths = self.contentDigests.keys();
		paths.sortBy((string left, string right) => Strings.lessThan(left, right));
		for path in paths {
			digest.appendText(SHA256.digest(path));
			digest.appendText(self.contentDigests.get(path));
		}
		return digest.finish();
	}

	/* Optional tool identity: binary bytes are never decoded as source. Missing
	 * or unstable executables disable reuse; normal execution owns diagnostics. */
	public string binaryIdentity(string path) {
		if (path.isEmpty() || Platform.isWindows()) { return ""; }
		var opened = RegularFileSnapshot.open(PathTools.absolute(path), 9223372036854775807LL);
		if (!opened.ok()) { return ""; }
		var file = opened.snapshot();
		var identity = FeSourceReadIdentity(path, file.revision());
		var digest = SHA256();
		long long offset = 0LL;
		bool valid = identity.validate().isEmpty();
		while (valid && offset < file.size()) {
			int count = file.size() - offset > 65536LL ? 65536 : (int)(file.size() - offset);
			var part = file.readExactAt(offset, count);
			if (!part.ok()) { valid = false; break; }
			digest.appendBytes(part.bytes());
			offset = offset + (long long)count;
		}
		bool closed = file.close().ok();
		if (!valid || !closed || !identity.validate().isEmpty()) { return ""; }
		if (!self.readIdentities.has(path)) { self.readIdentities.put(path, identity); }
		self.readPaths.put(path, true);
		string result = digest.finish();
		self.contentDigests.put(path, SHA256.digest(PathTools.absolute(path)) + result);
		return result;
	}

	public string validateInputs() {
		for path in self.readIdentities.keys() {
			string diagnostic = self.readIdentities.get(path).validate();
			if (!diagnostic.isEmpty()) { return diagnostic; }
		}
		return "";
	}

	private void fail(string path, string reason) {
		fprintf(stderr, "error: cannot read source file '%s': %s\n", path, reason);
		exit(1);
	}

	public string readRequired(string path) {
		File source = File(path, "rb");
		if (!source.ok()) { self.fail(path, "open failed"); }
		FeSourceReadIdentity? identity = null;
		/* Named-primary Windows publication is already unavailable until native
		 * private storage/locks exist. Do not fabricate identity from CRT stat. */
		if (!Platform.isWindows()) {
			var before = source.snapshot();
			if (!before.ok()) { source.close(); self.fail(path, "cannot inspect opened source"); }
			identity = FeSourceReadIdentity(path, before.snapshot());
			string diagnostic = identity.validate();
			if (!diagnostic.isEmpty()) { source.close(); self.fail(path, diagnostic); }
		}
		Bytes encoded = source.readBytes();
		bool readFailed = source.failed();
		string changed = "";
		if (identity != null) {
			var after = source.snapshot();
			if (!after.ok() || !identity.sameVersion(after.snapshot())) { changed = "source input changed during read"; }
		}
		bool closed = source.close();
		if (readFailed) { self.fail(path, "read failed"); }
		if (!closed || source.failed()) { self.fail(path, "close failed"); }
		if (!changed.isEmpty()) { self.fail(path, changed); }
		if (identity != null) {
			string diagnostic = identity.validate();
			if (!diagnostic.isEmpty()) { self.fail(path, diagnostic); }
			/* Reusable repositories may read a newer snapshot. Keep the original
			 * identity so a later read cannot bless a mixed output generation;
			 * publication validates the complete reader inventory separately. */
			if (!self.readIdentities.has(path)) { self.readIdentities.put(path, identity); }
		}
		string decoded = self.decoder.decode(encoded, path);
		self.readPaths.put(path, true);
		self.contentDigests.put(path, SHA256.digest(PathTools.absolute(path)) + SHA256.digest(decoded));
		return decoded;
	}
}

/* Directory traversal streams through the operating system's own iterator.  The
 * compiler imposes no entry ceiling; callers keep only what they select. */
class FeSourceDirectoryScanner {
	private FeSourcePathPolicy sourcePaths;

	public FeSourceDirectoryScanner() { self.sourcePaths = FeSourcePathPolicy(); }

	private void fail(string path) {
		fprintf(stderr, "error: cannot scan source directory '%s'\n", path);
		exit(1);
	}

	private void sort(Vector<string> entries) { entries.sortBy((string left, string right) => Strings.lessThan(left, right)); }

	/* Split one directory into its child directories and the source files a
     * caller selected, retaining only those names.  Symlinked children are
     * never descended into. */
	public void partition(string root, Vector<string> childDirectories, Vector<string> sourceFiles, Vector<string> suffixes, bool wantChildren) {
		DirectoryStream stream = Directory(root).stream();
		if (!stream.ok()) { self.fail(root); }
		while (stream.next()) {
			string name = stream.name();
			string path = self.sourcePaths.join(root, name);
			if (wantChildren && FileSystem.isDir(path) && !FileSystem.isSymlink(path)) {
				childDirectories.push(path);
			} else if (self.matchesSuffix(name, suffixes) && FileSystem.isFile(path)) {
				sourceFiles.push(path);
			}
		}
		if (!stream.close()) { self.fail(root); }
	}

	private bool matchesSuffix(string name, Vector<string> suffixes) {
		int index = 0;
		while (index < suffixes.len) {
			if (name.endsWith(suffixes.get(index))) { return true; }
			index++;
		}
		return false;
	}

	/* Return the lexicographically first entry naming an existing child file,
     * or "" when none matches.  Exactly one candidate is retained, so the
     * listing itself never has to be materialized. */
	public string firstEntryWithChildFile(string root, string childName) {
		DirectoryStream stream = Directory(root).stream();
		if (!stream.ok()) { return ""; }
		string best = "";
		string bestPath = "";
		while (stream.next()) {
			string name = stream.name();
			if (best.isEmpty() || Strings.lessThan(name, best)) {
				string candidate = self.sourcePaths.join(self.sourcePaths.join(root, name), childName);
				if (FileSystem.isFile(candidate)) {
					best = name;
					bestPath = candidate;
				}
			}
		}
		if (!stream.close()) { self.fail(root); }
		return bestPath;
	}

	/* Stream one directory and keep only the names carrying a suffix. */
	public Vector<string> sortedNamesWithSuffix(string root, string suffix) {
		Vector<string> names = [];
		DirectoryStream stream = Directory(root).stream();
		if (!stream.ok()) { self.fail(root); }
		while (stream.next()) {
			string name = stream.name();
			if (name.endsWith(suffix)) { names.push(name); }
		}
		if (!stream.close()) { self.fail(root); }
		self.sort(names);
		return names;
	}
}
