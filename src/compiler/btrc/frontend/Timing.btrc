import Library.Datetime;
import Library.Strings;
import Library.Vector;

/* Opt-in phase timing for the self-hosted compiler: with BTRCC_TIMING set,
 * one line per compile reports each phase's wall time in microseconds on
 * stderr. A latency budget is only meetable when every phase's share is
 * visible, and a whole compile is now too short for a sampling profiler to
 * attach to. Off by default and never part of a compile's output. */
class BtrccPhaseTimer {
	class bool enabled = false;
	class Timer? clock = null;
	class Vector<string>? report = null;

	class void begin() {
		BtrccPhaseTimer.enabled = getenv("BTRC_TIMING") != null || getenv("BTRCC_TIMING") != null;
		Vector<string> empty = [];
		BtrccPhaseTimer.report = empty;
		Timer clock = Timer();
		clock.start();
		BtrccPhaseTimer.clock = clock;
	}

	/* Each mark restarts the stopwatch, so a phase's elapsed time is a small
	 * number and the stdlib Timer's float seconds keep microsecond precision. */
	class void mark(string phase) {
		if (!BtrccPhaseTimer.enabled) { return; }
		Vector<string>? report = BtrccPhaseTimer.report;
		Timer? clock = BtrccPhaseTimer.clock;
		if (report == null || clock == null) { return; }
		clock.stop();
		long long micros = (long long)(clock.elapsed() * 1000000.0f);
		clock.reset();
		clock.start();
		report.push(phase + "=" + Strings.fromInt((int)micros) + "us");
	}

	class void print() {
		Vector<string>? report = BtrccPhaseTimer.report;
		if (!BtrccPhaseTimer.enabled || report == null) { return; }
		string rendered = Strings.join(report, " ");
		fprintf(stderr, "btrcc timing: %s\n", rendered);
	}
}
