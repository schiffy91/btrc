/* Frontend source, dependency, policy, and result value types. */

import Library.IO;
import Library.Map;
import Library.Result;
import Library.Strings;
import Library.Vector;

import ../generated/ast/Node.btrc;
import ../generated/native_abi/Models.btrc;

/* A synchronous host capability borrows the request. Its result remains owned
 * by the request instead of crossing a bare C callback's return ABI. */
class FeNativeHeaderRead {
	private string executable;
	private Vector<string> arguments;
	private Result<string, string> outcome;

	public FeNativeHeaderRead(string executable, Vector<string> arguments) {
		self.executable = executable;
		self.arguments = arguments;
		self.outcome = new Result<string, string>(false, "", "native header reader did not complete");
	}

	public string command() { return self.executable; }

	public Vector<string> argv() { return self.arguments; }

	public void complete(Result<string, string> outcome) { self.outcome = outcome; }

	public Result<string, string> result() { return self.outcome; }
}

typedef CFunction<void, FeNativeHeaderRead> FeNativeHeaderReader;

class FeSourceText {
	private string content;

	public FeSourceText(string content) { self.content = content; }

	/* Matches Python str.split("\n"), including the final empty line when
     * the source ends in a newline. */
	public Vector<string> lines() {
		Vector<string> result = [];
		int start = 0;
		int index = 0;
		while (index < self.content.length()) {
			if (self.content[index] == '\n') {
				result.push(self.content.substring(start, index - start));
				start = index + 1;
			}
			index++;
		}
		result.push(self.content.substring(start, self.content.length() - start));
		return result;
	}

	public int lineCount() {
		int count = 1;
		int index = 0;
		while (index < self.content.length()) {
			if (self.content[index] == '\n') { count++; }
			index++;
		}
		return count;
	}

	/* Prefix check at an exact source offset without allocating a suffix. */
	public bool startsWithAt(int position, string prefix) {
		if (position < 0 || position + prefix.length() > self.content.length()) {
			return false;
		}
		int index = 0;
		while (index < prefix.length()) {
			if (self.content[position + index] != prefix[index]) {
				return false;
			}
			index++;
		}
		return true;
	}

	class string joinLines(Vector<string> lines) { return Strings.join(lines, "\n"); }
}

class FeLine {
	public string text;
	public string sourceFile;  /* absolute path */
	public int lineNumber;     /* 1-based, in sourceFile */

	public FeLine(string text, string sourceFile, int lineNumber) {
		self.text = text;
		self.sourceFile = sourceFile;
		self.lineNumber = lineNumber;
	}
}

enum FeDependencyKind {
	FE_DEPENDENCY_IMPORT = 1,
	FE_DEPENDENCY_INCLUDE = 2,
};

class FeDependencyEdge {
	public string target;
	public int kind;

	public FeDependencyEdge(string target, int kind) {
		self.target = target;
		self.kind = kind;
	}
}

/* Typed dependency graph for per-file visibility. Language imports remain
 * directed; legacy #include edges are traversed in both directions because
 * their source fragments form one compilation unit. */
class FeDependencyGraph {
	private Map<string, Vector<FeDependencyEdge>> outgoing;
	private Map<string, Vector<string>> includeParents;

	public FeDependencyGraph(Map<string, Vector<FeDependencyEdge>> outgoing, Map<string, Vector<string>> includeParents) {
		self.outgoing = outgoing;
		self.includeParents = includeParents;
	}

	public Vector<string> sourceIdentities() { return self.outgoing.keys(); }

	public Vector<FeDependencyEdge> outgoingFrom(string sourceIdentity) {
		if (self.outgoing.has(sourceIdentity)) {
			return self.outgoing.get(sourceIdentity);
		}
		Vector<FeDependencyEdge> empty = [];
		return empty;
	}

	public Vector<string> includeParentsOf(string sourceIdentity) {
		if (self.includeParents.has(sourceIdentity)) {
			return self.includeParents.get(sourceIdentity);
		}
		Vector<string> empty = [];
		return empty;
	}
}

/* Immutable-by-API capture of the standard-library roots used for one
 * frontend resolution. Filesystem identity and membership policy belong to
 * FeStdlibRepository; this value owns only captured paths, sources, and
 * content equality. */
class FeStdlibRootSnapshot {
	private Vector<string> paths;
	private Vector<string> sources;

	public FeStdlibRootSnapshot(Vector<string> paths, Vector<string> sources) {
		self.paths = paths;
		self.sources = sources;
	}

	public int count() { return self.paths.len; }

	public string pathAt(int index) { return self.paths.get(index); }

	public string sourceAt(int index) { return self.sources.get(index); }

	public bool sameContents(FeStdlibRootSnapshot other) {
		if (self.count() != other.count()) { return false; }
		int index = 0;
		while (index < self.count()) {
			if (!self.pathAt(index).equals(other.pathAt(index)) || !self.sourceAt(index).equals(other.sourceAt(index))) {
				return false;
			}
			index++;
		}
		return true;
	}
}

class FeNativeRecordInputField {
	public string name;
	public Node valueType;
	public string record;
	public string prefix;
	public string objectType;
	public FeNativeRecordInputField(string name, Node valueType, string record = "", string prefix = "", string objectType = "") {
		self.name = name;
		self.valueType = valueType;
		self.record = record;
		self.prefix = prefix;
		self.objectType = objectType;
	}
}

class FeNativeRecordInput {
	public string name;
	public string nativeSpelling;
	public Vector<FeNativeRecordInputField> fields;
	public FeNativeRecordInput(string name, string nativeSpelling) {
		self.name = name;
		self.nativeSpelling = nativeSpelling;
		self.fields = [];
	}

	public string inputName() { return self.name + "Input"; }

	public string identity() {
		string result = self.nativeSpelling;
		for field in self.fields {
			result = result + f"|{field.name}:{field.valueType.base}:{field.valueType.isNullable}:{field.prefix}:{field.objectType}:{field.record}";
		}
		return result;
	}
}

/* Checked call boundaries also apply when a native function is used as a value. */
class FeNativeResourceBinding {
	public string name;
	public string ownership;
	public string retainFunction;
	public string releaseFunction;
	public FeNativeResourceBinding(string name, string ownership, string retainFunction, string releaseFunction) {
		self.name = name;
		self.ownership = ownership;
		self.retainFunction = retainFunction;
		self.releaseFunction = releaseFunction;
	}

	public string identity() { return f"{self.name}:{self.ownership}:{self.retainFunction}:{self.releaseFunction}"; }
}

class FeNativeCallbackBinding {
	public string parameter;
	public string context;
	public int contextIndex;
	public string interfaceName;
	public FeNativeCallbackBinding(string parameter, string context, int contextIndex, string interfaceName) {
		self.parameter = parameter;
		self.context = context;
		self.contextIndex = contextIndex;
		self.interfaceName = interfaceName;
	}
}

class FeNativeCallbackProjection {
	public string interfaceName;
	public int parameterIndex;
	public int contextIndex;
	public int callbackContextIndex;
	public Vector<Node> parameters = [];
	public Node returnType;
	public FeNativeCallbackProjection(string interfaceName, int parameterIndex, int contextIndex, int callbackContextIndex, Node returnType) {
		self.interfaceName = interfaceName;
		self.parameterIndex = parameterIndex;
		self.contextIndex = contextIndex;
		self.callbackContextIndex = callbackContextIndex;
		self.returnType = returnType;
	}
}

class FeNativeCallContract {
	public Vector<FeNativeCallbackProjection> callbacks = [];
	public Vector<string> resourceParameters = [];
	public string resourceResult = "";
	public Vector<bool> nonnullParameters;
	public Vector<bool> readOnlyBorrows;
	public bool nonnullReturn;
	public bool realtimeSafe;
	public Vector<FeNativeRecordInput?> recordInputs;
	public Map<string, FeNativeRecordInput> recordTypes;
	public FeNativeCallContract() {
		self.nonnullParameters = [];
		self.readOnlyBorrows = [];
		self.nonnullReturn = false;
		self.realtimeSafe = false;
		self.recordInputs = [];
		self.recordTypes = {};
	}

	public string adapterSymbol(string name) {
		if (self.callbacks.len > 0) { return "__btrc_native_" + name; }
		if (!self.resourceResult.isEmpty()) { return "__btrc_native_" + name; }
		for resource in self.resourceParameters { if (!resource.isEmpty()) { return "__btrc_native_" + name; } }
		if (self.nonnullReturn) { return "__btrc_native_" + name; }
		for input in self.recordInputs { if (input != null) { return "__btrc_native_" + name; } }
		for nonnull in self.nonnullParameters {
			if (nonnull) { return "__btrc_native_" + name; }
		}
		return name;
	}
}

/* SDK provenance is attached to the actual imported node, never inferred from
 * its spelling, line number, or a user-controlled source marker. */
class FeNativeImportedDeclaration {
	public FeNativeResourceBinding? resource = null;
	public Node declaration;
	public string module;
	public string header;
	public Vector<string> headers;
	public string typeSpelling;
	public bool readOnly;
	public FeNativeCallContract? callContract;
	public Map<string, FeNativeCallContract> fieldContracts;
	public bool coalesced;
	public bool generatedInput;
	public string language;
	public Map<string, NativeNode> methods;
	public Vector<string> nativeAncestors;
	public FeNativeImportedDeclaration(Node declaration, string module, string header, string typeSpelling = "", bool readOnly = false, FeNativeCallContract? callContract = null) {
		self.declaration = declaration;
		self.module = module;
		self.header = header;
		self.headers = [header];
		self.typeSpelling = typeSpelling;
		self.readOnly = readOnly;
		self.callContract = callContract;
		self.fieldContracts = {};
		self.coalesced = false;
		self.generatedInput = false;
		self.language = "c";
		self.methods = {};
		self.nativeAncestors = [];
	}
}

class FeResolvedSource {
	public Vector<FeNativeImportedDeclaration> nativeDeclarations;
	public string userSource;
	public string source;
	public string stdlibSource;
	public Vector<FeLine> userLines;
	public FeDependencyGraph dependencies;
	public bool strictImports;
	public int stdlibLineCount;
	public string rootSourcePath;
	public FeStdlibRootSnapshot stdlibSnapshot;

	public FeResolvedSource(string userSource, string source, string stdlibSource, Vector<FeLine> userLines, FeDependencyGraph dependencies, bool strictImports, int stdlibLineCount, string rootSourcePath, FeStdlibRootSnapshot stdlibSnapshot) {
		self.nativeDeclarations = [];
		self.userSource = userSource;
		self.source = source;
		self.stdlibSource = stdlibSource;
		self.userLines = userLines;
		self.dependencies = dependencies;
		self.strictImports = strictImports;
		self.stdlibLineCount = stdlibLineCount;
		self.rootSourcePath = rootSourcePath;
		self.stdlibSnapshot = stdlibSnapshot;
	}

	public FeLine? userLineForCombined(int line) {
		int index = line - self.stdlibLineCount - 1;
		if (index < 0 || index >= self.userLines.len) { return null; }
		return self.userLines.get(index);
	}
}

class FeDirective {
	public string kind;     /* "import" or "btrc_include" */
	public string payload;  /* import: raw spec text; include: the .btrc path */
	public int start;       /* 1-based start line (inclusive) */
	public int end;         /* 1-based end line (inclusive) */

	public FeDirective(string kind, string payload, int start, int end) {
		self.kind = kind;
		self.payload = payload;
		self.start = start;
		self.end = end;
	}
}

class FeVisibilityDiagnostic {
	public string message;
	public string sourceFile;
	public int line;
	public int col;
	public string sourceLine;

	public FeVisibilityDiagnostic(string message, string sourceFile, int line, int col, string sourceLine) {
		self.message = message;
		self.sourceFile = sourceFile;
		self.line = line;
		self.col = col;
		self.sourceLine = sourceLine;
	}

	public string render() {
		string lineText = f"{self.line}";
		string pad = Strings.repeat(" ", lineText.length());
		string caret = Strings.repeat(" ", self.col > 0 ? self.col - 1 : 0) + "^";
		return f"error: {self.message}\n {pad}--> {self.sourceFile}:{self.line}:{self.col}" + f"\n {pad} |\n {lineText} | {self.sourceLine}\n {pad} | {caret}";
	}
}

class FeStdlibSymbolIndexResult {
	public bool success;
	public string diagnostic;

	public FeStdlibSymbolIndexResult(bool success, string diagnostic) {
		self.success = success;
		self.diagnostic = diagnostic;
	}
}

class FeVisibilityCheckResult {
	public bool success;
	public string diagnostic;
	public Vector<FeVisibilityDiagnostic> diagnostics;

	public FeVisibilityCheckResult(bool success, string diagnostic, Vector<FeVisibilityDiagnostic> diagnostics) {
		self.success = success;
		self.diagnostic = diagnostic;
		self.diagnostics = diagnostics;
	}
}
