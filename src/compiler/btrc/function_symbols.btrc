/* C symbols for concrete source-defined top-level functions. */

string sourceFunctionCName(Analyzed analyzed, string name) {
    if (!analyzed.funcTable.has(name)) { return name; }
    Node declaration = analyzed.funcTable.get(name);
    /* Foreign/body-less declarations retain their ABI spelling. Only concrete
     * source definitions that overlap a hosted-runtime seam are isolated in
     * the compiler-reserved namespace. */
    if (declaration.body_node == null || declaration.is_gpu) { return name; }
    return HostedAbi.sourceFunctionSymbol(name);
}

string sourceCallCName(Analyzed analyzed, string name, Node call) {
    if (analyzed.hostedCallKeys.has(astNodeKey(call))) { return name; }
    return sourceFunctionCName(analyzed, name);
}
