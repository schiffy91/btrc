/* Source parameter lowering with object-qualifier metadata.
 *
 * `typeToC` deliberately renders the structural C type and `IRParam` carries
 * outer volatile storage separately.  Keeping that split in one helper avoids
 * silently dropping explicit volatile on prototypes, definitions, generic
 * specializations, rich-enum constructors, and lifted lambdas. */

IRParam lowerResolvedSourceParam(Node parameter, Node? resolvedType,
        string cType, Analyzed analyzed) {
    IRParam result = IRParam(cType,
        HostedAbi.lexicalBindingCNameForAnalysis(parameter.name, analyzed));
    result.is_volatile = resolvedType != null
        && resolvedType.is_volatile;
    result.effective_is_volatile = typeEffectiveOuterVolatile(
        resolvedType, analyzed.typedefTable);
    return result;
}

IRParam lowerRenderedSourceParam(Node parameter, string cType,
        Analyzed analyzed) {
    return lowerResolvedSourceParam(
        parameter, parameter.type, cType, analyzed);
}

IRParam lowerSourceParam(Node parameter, Analyzed analyzed) {
    return lowerRenderedSourceParam(
        parameter, typeToC(parameter.type, analyzed), analyzed);
}

IRParam copyIRParam(IRParam parameter) {
    IRParam result = IRParam(parameter.c_type, parameter.name);
    result.is_volatile = parameter.is_volatile;
    result.effective_is_volatile = parameter.effective_is_volatile;
    result.setjmp_inferred_volatile = parameter.setjmp_inferred_volatile;
    return result;
}

IRParam lowerNamedSourceTypeParam(Node? typeExpr, string cType,
        string name, Analyzed analyzed) {
    IRParam result = IRParam(cType, name);
    result.is_volatile = typeExpr != null && typeExpr.is_volatile;
    result.effective_is_volatile = typeEffectiveOuterVolatile(
        typeExpr, analyzed.typedefTable);
    return result;
}
