/* Fail closed when setjmp pointer escapes cross unmodelled storage. */

void rejectUnmodelledSetjmpCaptures(
        IRFunction definition, SetjmpCallEffects effects) {
    if (!expressionContainsSetjmp(definition.body)) { return; }
    int index = 0;
    while (index < effects.flow.unknownPointerValues.len) {
        SetjmpStorage storage =
            effects.flow.unknownPointerValues.get(index);
        fprintf(stderr,
            "error: pointer storage object '%s' receives an unmodelled "
            + "pointer value in a function containing try/setjmp\n",
            storage.name);
        exit(1);
    }
    Vector<SetjmpOrigin> escaped =
        copySetjmpOrigins(effects.flow.captures);
    index = 0;
    while (index < effects.flow.returns.len) {
        SetjmpOrigin origin = effects.flow.returns.get(index);
        if (origin.depth == 0) { setjmpAddOrigin(escaped, origin); }
        index = index + 1;
    }
    index = 0;
    while (index < escaped.len) {
        SetjmpOrigin origin = escaped.get(index);
        SetjmpStorage storage = origin.storage;
        if (origin.depth == 0 && origin.sourceExposed
                && storage.automatic() && !storage.compilerOwned) {
            fprintf(stderr,
                "error: automatic storage object '%s' escapes into "
                + "unmodelled storage in a function containing try/setjmp\n",
                storage.name);
            exit(1);
        }
        index = index + 1;
    }
}
