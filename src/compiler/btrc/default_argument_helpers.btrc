/* Declaration-scoped runtime evaluators for omitted source arguments. */

class DefaultArgumentTarget {
    public Node declaration;
    public string cName;
    public string ownerName;
    public string classPrefix;
    public Node? selfType;
    public Map<string, Node> substitutions;

    public DefaultArgumentTarget(Node declaration, string cName) {
        self.declaration = declaration;
        self.cName = cName;
        self.ownerName = "";
        self.classPrefix = "";
        self.selfType = null;
        self.substitutions = {};
    }
}

string defaultArgumentMethodOwner(Analyzed analyzed,
        string receiverClass, Node method) {
    string current = receiverClass;
    string key = astNodeKey(method);
    while (current != "" && analyzed.classTable.has(current)) {
        Node declaration = analyzed.classTable.get(current);
        int index = 0;
        while (index < declaration.members.len) {
            if (astNodeKey(declaration.members.get(index)) == key) {
                return current;
            }
            index = index + 1;
        }
        current = parentName(declaration);
    }
    return receiverClass;
}

Vector<Node> defaultArgumentConcreteTypes(Node declaration,
        Map<string, Node> substitutions) {
    Vector<string> names = declaration.generic_params;
    Vector<Node> result = [];
    int index = 0;
    while (index < names.len) {
        string name = names.get(index);
        if (substitutions.has(name)) {
            result.push(substitutions.get(name));
        }
        index = index + 1;
    }
    return result;
}

Node defaultArgumentSelfType(string owner, Vector<Node> arguments) {
    Node result = makeClassTypeExpr(owner);
    result.pointer_depth = 1;
    int index = 0;
    while (index < arguments.len) {
        result.generic_args.push(arguments.get(index));
        index = index + 1;
    }
    return result;
}

DefaultArgumentTarget defaultArgumentConstructorTypeTarget(
        IRGen generator, Node instance,
        Map<string, Node> substitutions) {
    Node? declaration = null;
    Node? owner = null;
    if (generator.analyzed.isGenericClass(instance.base)) {
        declaration = generator.analyzed.genericClassConstructor(
            instance.base);
        owner = generator.analyzed.genericClassTable.get(instance.base);
    } else if (generator.analyzed.isClass(instance.base)) {
        declaration = generator.analyzed.classConstructor(instance.base);
        owner = generator.analyzed.classTable.get(instance.base);
    }
    if (declaration == null || owner == null) {
        generator.typedOperatorFail(
            "cannot resolve constructor default declaration scope");
    }
    string prefix = instance.base;
    if (instance.generic_args.len > 0) {
        prefix = TypeIdentity.mangleGenericType(instance.base, instance.generic_args);
    }
    DefaultArgumentTarget target = DefaultArgumentTarget(
        declaration, prefix + "_new");
    target.ownerName = instance.base;
    target.classPrefix = prefix;
    target.substitutions = substitutions;
    return target;
}

DefaultArgumentTarget defaultArgumentMethodTarget(IRGen generator,
        Node call, Node callee, Map<string, Node> varTypes,
        Map<string, Node> substitutions) {
    string ownerName = "";
    Node? method = null;
    Node? owner = null;
    Vector<Node> classArguments = [];
    bool staticCall = callee.obj != null
        && callee.obj.kind == NK_IDENTIFIER
        && !varTypes.has(callee.obj.name)
        && (generator.analyzed.isClass(callee.obj.name)
            || generator.analyzed.isGenericClass(callee.obj.name));
    if (staticCall && generator.analyzed.isClass(callee.obj.name)) {
        method = generator.analyzed.classMethod(
            callee.obj.name, callee.field);
        if (method != null) {
            ownerName = defaultArgumentMethodOwner(
                generator.analyzed, callee.obj.name, method);
            owner = generator.analyzed.classTable.get(ownerName);
        }
    } else {
        Node? receiverType = generator.resolvedExpressionType(
            callee.obj, varTypes);
        if (receiverType != null
                && generator.analyzed.isGenericClass(receiverType.base)) {
            ownerName = receiverType.base;
            owner = generator.analyzed.genericClassTable.get(ownerName);
            method = generator.analyzed.genericClassMethod(
                ownerName, callee.field);
            classArguments = receiverType.generic_args;
        } else if (receiverType != null
                && generator.analyzed.isClass(receiverType.base)) {
            method = generator.analyzed.classMethod(
                receiverType.base, callee.field);
            if (method != null) {
                ownerName = defaultArgumentMethodOwner(
                    generator.analyzed, receiverType.base, method);
                owner = generator.analyzed.classTable.get(ownerName);
            }
        }
    }
    if (method == null || owner == null) {
        generator.typedOperatorFail(
            "cannot resolve method default declaration scope");
    }
    Node concreteMethod = method;
    Node concreteOwner = owner;
    if (classArguments.len == 0
            && concreteOwner.generic_params.len > 0) {
        classArguments = defaultArgumentConcreteTypes(
            concreteOwner, substitutions);
    }
    string prefix = ownerName;
    if (classArguments.len > 0) {
        prefix = TypeIdentity.mangleGenericType(ownerName, classArguments);
    }
    string cName = prefix + "_" + concreteMethod.name;
    if (concreteMethod.generic_params.len > 0) {
        cName = genericMethodInstanceName(
            ownerName, classArguments, concreteMethod.name,
            defaultArgumentConcreteTypes(
                concreteMethod, substitutions));
    }
    DefaultArgumentTarget target = DefaultArgumentTarget(
        concreteMethod, cName);
    target.ownerName = ownerName;
    target.classPrefix = prefix;
    target.substitutions = substitutions;
    if (concreteMethod.access != "class") {
        target.selfType = defaultArgumentSelfType(
            ownerName, classArguments);
    }
    return target;
}

DefaultArgumentTarget defaultArgumentTarget(IRGen generator, Node call,
        Map<string, Node> varTypes) {
    Map<string, Node> substitutions = callTargetTypeMap(
        generator, call, varTypes);
    if (call.kind == NK_NEW_EXPR) {
        return defaultArgumentConstructorTypeTarget(
            generator, generator.resolveBodyType(call.type),
            substitutions);
    }
    Node? callee = call.callee;
    if (callee != null && callee.kind == NK_IDENTIFIER
            && (generator.analyzed.isClass(callee.name)
                || generator.analyzed.isGenericClass(callee.name))) {
        Node? instance = generator.resolvedExpressionType(
            call, varTypes);
        if (instance == null) {
            generator.typedOperatorFail(
                "cannot resolve constructor default instance type");
        }
        Node concreteInstance = instance;
        return defaultArgumentConstructorTypeTarget(
            generator, concreteInstance, substitutions);
    }
    if (callee != null && callee.kind == NK_IDENTIFIER
            && generator.analyzed.funcTable.has(callee.name)) {
        DefaultArgumentTarget target = DefaultArgumentTarget(
            generator.analyzed.funcTable.get(callee.name),
            sourceFunctionCName(generator.analyzed, callee.name));
        target.substitutions = substitutions;
        return target;
    }
    if (callee != null && callee.kind == NK_FIELD_ACCESS_EXPR) {
        if (callee.obj != null
                && callee.obj.kind == NK_IDENTIFIER
                && !varTypes.has(callee.obj.name)
                && generator.analyzed.isRichEnum(callee.obj.name)) {
            Node? variant = semanticResolveRichEnumVariant(
                callee.obj.name, callee.field, generator.analyzed);
            if (variant == null) {
                generator.typedOperatorFail(
                    "cannot resolve rich-enum variant default scope");
            }
            Node concreteVariant = variant;
            DefaultArgumentTarget target = DefaultArgumentTarget(
                concreteVariant,
                callee.obj.name + "_" + callee.field);
            target.ownerName = callee.obj.name;
            target.substitutions = substitutions;
            return target;
        }
        return defaultArgumentMethodTarget(
            generator, call, callee, varTypes, substitutions);
    }
    generator.typedOperatorFail(
        "cannot resolve declaration scope for a default argument");
    return DefaultArgumentTarget(Node(), "");
}

string defaultArgumentHelperSymbol(
        DefaultArgumentTarget target, int parameterIndex) {
    return "__btrc_default_" + target.cName + "_"
        + Strings.fromInt(parameterIndex + 1);
}

void defaultArgumentAppendParameters(Vector<IRParam> destination,
        DefaultArgumentTarget target, Vector<Node> parameters,
        int parameterIndex, Analyzed analyzed) {
    if (target.selfType != null) {
        destination.push(IRParam(
            typeToC(target.selfType, analyzed), "self"));
    }
    int index = 0;
    while (index < parameterIndex) {
        Node parameter = parameters.get(index);
        destination.push(lowerSourceParam(parameter, analyzed));
        index = index + 1;
    }
}

string ensureDefaultArgumentHelper(IRGen generator, Node call,
        Vector<Node> parameters, int parameterIndex,
        Map<string, Node> varTypes) {
    DefaultArgumentTarget target = defaultArgumentTarget(
        generator, call, varTypes);
    string symbol = defaultArgumentHelperSymbol(target, parameterIndex);
    if (generator.defaultArgumentHelpers.has(symbol)) { return symbol; }
    generator.defaultArgumentHelpers.put(symbol, true);
    Node parameter = parameters.get(parameterIndex);
    string returnType = typeToC(parameter.type, generator.analyzed);
    IRFunctionDecl declaration = IRFunctionDecl(
        symbol, returnType, true);
    defaultArgumentAppendParameters(
        declaration.params, target, parameters,
        parameterIndex, generator.analyzed);
    generator.curModule.function_decls.push(declaration);

    IRFunction helperFunction = IRFunction();
    helperFunction.name = symbol;
    helperFunction.return_type = returnType;
    helperFunction.is_static = true;
    defaultArgumentAppendParameters(
        helperFunction.params, target, parameters,
        parameterIndex, generator.analyzed);
    ScopeSnapshot snapshot = generator.enterIsolatedScope(
        returnType, parameter.type);
    string previousClass = generator.currentClass;
    bool previousGeneric = generator.inGenericMethod;
    Map<string, Node> previousTypes = generator.activeTypeMap;
    int previousDeclarationDepth = generator.defaultDeclarationDepth;
    string previousFunction = generator.defaultFunctionName;
    generator.currentClass = target.classPrefix;
    generator.inGenericMethod = target.substitutions.len > 0;
    generator.activeTypeMap = target.substitutions;
    generator.defaultDeclarationDepth = previousDeclarationDepth + 1;
    generator.defaultFunctionName = target.cName;

    Map<string, Node> bodyTypes = generator.seededVarTypes();
    if (target.selfType != null) {
        bodyTypes.put("self", target.selfType);
        generator.borrowedLocalBindings.put("self", true);
    }
    int prior = 0;
    while (prior < parameterIndex) {
        Node priorParameter = parameters.get(prior);
        bodyTypes.put(priorParameter.name, priorParameter.type);
        generator.borrowedLocalBindings.put(
            priorParameter.name, true);
        generator.activateSourceLexicalBinding(
            priorParameter.name);
        prior = prior + 1;
    }
    Node returnNode = Node();
    returnNode.kind = NK_RETURN_STMT;
    returnNode.value_node = parameter.default_;
    Node bodyNode = Node();
    bodyNode.kind = NK_BLOCK;
    bodyNode.statements.push(returnNode);
    helperFunction.body = generator.lowerBlock(bodyNode, bodyTypes);

    generator.defaultFunctionName = previousFunction;
    generator.defaultDeclarationDepth = previousDeclarationDepth;
    generator.activeTypeMap = previousTypes;
    generator.inGenericMethod = previousGeneric;
    generator.currentClass = previousClass;
    generator.exitIsolatedScope(snapshot);
    generator.curModule.functions.push(helperFunction);
    return symbol;
}
