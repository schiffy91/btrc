/* Production self-hosted compiler process entry point. */

import Library.BackgroundJobs.ProcessWorkers;

import ./cli/Driver.btrc;
import ./frontend/NativeHeaderProcess.btrc;

int main(int argc, char** argv) {
	BtrccDriver driver = BtrccDriver(argc, argv, FeNativeHeaderProcess.read, null, ForkedWorkerPools());
	return driver.run();
}
