/* Production self-hosted compiler process entry point. */

import Library.BackgroundJobs.HostWorkerPools;

import ./cli/Driver.btrc;
import ./frontend/NativeHeaderProcess.btrc;

int main(int argc, char** argv) { return BtrccCompilerStack.run((int count, char** values) => BtrccDriver(count, values, FeNativeHeaderProcess.read, null, HostWorkerPools()).run(), argc, argv); }
