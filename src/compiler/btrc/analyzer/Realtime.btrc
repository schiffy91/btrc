/* Transitive, fail-closed realtime-effect analysis. */

import Library.Map;
import Library.Strings;
import Library.Vector;

import ../frontend/Timing.btrc;
import ../frontend/Models.btrc;
import ../generated/ast/Node.btrc;
import ../syntax/Identity.btrc;
import ./Expressions.btrc;
import ./HostedAbi.btrc;
import ./Models.btrc;
import ./Operators.btrc;

class RealtimeEvent {
	public bool isEffect;
	public string target;
	public string category;
	public string operation;
	public int line;
	public int col;

	public RealtimeEvent() {
		self.isEffect = false;
		self.target = "";
		self.category = "";
		self.operation = "";
		self.line = 0;
		self.col = 0;
	}
}

class RealtimeCallable {
	public string key;
	public string label;
	public Node declaration;
	public Node? body;
	public Map<string, Node> variables;
	public Map<string, bool> localNames;
	public Vector<RealtimeEvent> events;
	/* After its first effect a callable's verdict and witness are fixed; see
	 * RealtimeAnalyzer.effect. */
	public bool settled;
	/* The bindings a lexical scope displaced in variables, innermost last,
	 * so closing the scope restores each name's enclosing type. */
	private Vector<string> displacedNames;
	private Vector<Node> displacedTypes;
	private Vector<bool> displacedPresent;
	private Vector<int> scopeMarks;

	public RealtimeCallable(string key, string label, Node declaration) {
		self.key = key;
		self.label = label;
		self.declaration = declaration;
		self.body = null;
		self.variables = {};
		self.localNames = {};
		self.events = [];
		self.settled = false;
		self.displacedNames = [];
		self.displacedTypes = [];
		self.displacedPresent = [];
		self.scopeMarks = [];
	}

	public void openScope() { self.scopeMarks.push(self.displacedNames.len); }

	public void closeScope() {
		int mark = self.scopeMarks.pop();
		while (self.displacedNames.len > mark) {
			string name = self.displacedNames.pop();
			Node previous = self.displacedTypes.pop();
			if (self.displacedPresent.pop()) {
				self.variables.put(name, previous);
			} else {
				self.variables.remove(name);
			}
		}
	}

	/* Bind a local in the innermost scope; an unknown type hides the name's
	 * enclosing type rather than leaving it visible. */
	public void bindLocal(string? name, Node? typeExpr) {
		if (name == null || name == "") { return; }
		if (self.scopeMarks.len > 0) {
			bool present = self.variables.has(name);
			self.displacedNames.push(name);
			self.displacedTypes.push(present ? self.variables.get(name) : Node());
			self.displacedPresent.push(present);
		}
		if (typeExpr != null) {
			self.variables.put(name, typeExpr);
		} else {
			self.variables.remove(name);
		}
	}
}

class RealtimeWitness {
	public string category;
	public string operation;
	public int line;
	public int col;
	public Vector<string> path;

	public RealtimeWitness() {
		self.category = "";
		self.operation = "";
		self.line = 0;
		self.col = 0;
		self.path = [];
	}
}

class RealtimeLoopProof {
	public bool valid;
	public string induction;
	public string bound;
	public int inductionIndex; /* The induction declarator in the initializer. */
	public int stepIndex; /* Its step among the update's operands. */

	public RealtimeLoopProof() {
		self.valid = false;
		self.induction = "";
		self.bound = "";
		self.inductionIndex = -1;
		self.stepIndex = -1;
	}
}

class RealtimeLoopGuard {
	public Map<string, bool> names;
	public Node site;
	public bool violated;

	public RealtimeLoopGuard(Node site) {
		self.names = {};
		self.site = site;
		self.violated = false;
	}
}

/* Tarjan's strongly connected components over the callable call graph. Call
 * edges to callables outside the index are dead ends, as they are for the
 * per-path reachability search this replaces. */
class RealtimeCallGraphComponents {
	private Map<string, RealtimeCallable> callables;
	private Map<string, int> indexes;
	private Map<string, int> lowLinks;
	private Map<string, bool> onStack;
	private Vector<string> stack;
	private int nextIndex;
	public Map<string, bool> recursive;

	public RealtimeCallGraphComponents(Map<string, RealtimeCallable> callables) {
		self.callables = callables;
		self.indexes = {};
		self.lowLinks = {};
		self.onStack = {};
		self.stack = [];
		self.nextIndex = 0;
		self.recursive = {};
	}

	public void connect(string key) {
		if (self.indexes.has(key)) { return; }
		self.strongConnect(key);
	}

	private void lowerLink(string key, int candidate) {
		if (candidate < self.lowLinks.get(key)) { self.lowLinks.put(key, candidate); }
	}

	private void strongConnect(string key) {
		int index = self.nextIndex;
		self.nextIndex = self.nextIndex + 1;
		self.indexes.put(key, index);
		self.lowLinks.put(key, index);
		self.stack.push(key);
		self.onStack.put(key, true);
		bool selfEdge = false;
		Vector<RealtimeEvent> events = self.callables.get(key).events;
		int eventIndex = 0;
		while (eventIndex < events.len) {
			RealtimeEvent event = events.get(eventIndex);
			if (!event.isEffect && self.callables.has(event.target)) {
				string target = event.target;
				if (target == key) { selfEdge = true; }
				if (!self.indexes.has(target)) {
					self.strongConnect(target);
					self.lowerLink(key, self.lowLinks.get(target));
				} else if (self.onStack.has(target)) {
					self.lowerLink(key, self.indexes.get(target));
				}
			}
			eventIndex = eventIndex + 1;
		}
		if (self.lowLinks.get(key) != index) { return; }
		Vector<string> members = [];
		string member = self.stack.pop();
		self.onStack.remove(member);
		members.push(member);
		while (member != key) {
			member = self.stack.pop();
			self.onStack.remove(member);
			members.push(member);
		}
		if (members.len > 1 || selfEdge) {
			int memberIndex = 0;
			while (memberIndex < members.len) {
				self.recursive.put(members.get(memberIndex), true);
				memberIndex = memberIndex + 1;
			}
		}
	}
}

class RealtimeAnalyzer {
	private Node program;
	private Analyzed analyzed;
	private HostedAbiRepository hostedAbi;
	private SourceRuntimeSymbols runtimeSymbols;
	private ExpressionTypeResolver expressionTypes;
	private Map<string, RealtimeCallable> callables;
	private Vector<string> order;
	private Map<string, string> declarationKeys;
	private Map<string, string> propertyKeys;
	private Vector<RealtimeLoopGuard> loopGuards;
	private IValidationRecords? records = null;
	private Node? indexOwner = null;
	/* Stage B: the top-level declaration each callable belongs to, and the
	 * declarations (by identity) whose realtime scan replays a record. */
	private Map<string, Node> ownerOfCallable = {};
	private Map<string, Vector<ValidationFact>> replays = {};

	public RealtimeAnalyzer(Node program, Analyzed analyzed, HostedAbiRepository hostedAbi, SourceRuntimeSymbols runtimeSymbols, ExpressionTypeResolver expressionTypes) {
		self.program = program;
		self.analyzed = analyzed;
		self.hostedAbi = hostedAbi;
		self.runtimeSymbols = runtimeSymbols;
		self.expressionTypes = expressionTypes;
		self.callables = {};
		self.order = [];
		self.declarationKeys = {};
		self.propertyKeys = {};
		self.loopGuards = [];
	}

	public void useRecords(IValidationRecords? records) { self.records = records; }

	public void validate() {
		bool hasRealtimeRoot = false;
		int index = 0;
		while (index < self.program.declarations().len) {
			Node declaration = self.program.declarations().get(index);
			if (declaration.kind == NK_FUNCTION_DECL && declaration.isRealtime) {
				hasRealtimeRoot = true;
			} else if (declaration.kind == NK_CLASS_DECL) {
				int member = 0;
				while (member < declaration.members().len) {
					Node item = declaration.members().get(member);
					if (item.kind == NK_METHOD_DECL && item.isRealtime) {
						hasRealtimeRoot = true;
					}
					member = member + 1;
				}
			}
			index = index + 1;
		}
		if (!hasRealtimeRoot) { return; }
		self.indexCallables();
		BtrccPhaseTimer.mark("r-index");
		self.installReplays();
		/* Callables of one declaration are contiguous in `order`; each
		 * declaration scanned live is journaled for a record when wanted. */
		string owner = "";
		Node? current = null;
		ValidationJournal? journal = null;
		index = 0;
		while (index < self.order.len) {
			string key = self.order.get(index);
			Node declaration = self.ownerOfCallable.get(key);
			string identity = AstIdentity.key(declaration);
			if (!self.replays.has(identity)) {
				if (!identity.equals(owner)) {
					self.endJournal(current, journal);
					owner = identity;
					current = declaration;
					journal = self.beginJournal(declaration);
				}
				self.scanCallable(self.callables.get(key));
			}
			index = index + 1;
		}
		self.endJournal(current, journal);
		BtrccPhaseTimer.mark("r-scan");
		Map<string, bool> unsafe = self.unsafeFixedPoint();
		BtrccPhaseTimer.mark("r-fixed-point");
		index = 0;
		while (index < self.order.len) {
			RealtimeCallable callable = self.callables.get(self.order.get(index));
			if (callable.declaration.isRealtime && unsafe.has(callable.key)) {
				Map<string, bool> visiting = {};
				RealtimeWitness? witness = self.firstWitness(callable.key, unsafe, visiting);
				if (witness == null) {
					fprintf(stderr, "internal compiler error: realtime fixed-point lost witness for %s\n", callable.label);
					exit(1);
				}
				self.fail(callable, witness);
			}
			index = index + 1;
		}
	}

	private void indexCallables() {
		int index = 0;
		while (index < self.program.declarations().len) {
			Node declaration = self.program.declarations().get(index);
			IValidationRecords? records = self.records;
			if (records != null && (declaration.kind == NK_FUNCTION_DECL || declaration.kind == NK_CLASS_DECL)) {
				Vector<ValidationFact>? facts = records.recorded(RECORD_PHASE_REALTIME, declaration);
				if (facts != null) { self.replays.put(AstIdentity.key(declaration), facts); }
			}
			self.indexOwner = declaration;
			if (declaration.kind == NK_FUNCTION_DECL) {
				self.addCallable("function:" + declaration.name, declaration.name, declaration, declaration.bodyNode, "");
			} else if (declaration.kind == NK_CLASS_DECL) {
				int memberIndex = 0;
				while (memberIndex < declaration.members().len) {
					Node member = declaration.members().get(memberIndex);
					if (member.kind == NK_METHOD_DECL) {
						string label = declaration.name + "." + member.name;
						self.addCallable("method:" + label, label, member, member.bodyNode, declaration.name);
					} else if (member.kind == NK_PROPERTY_DECL) {
						if (member.hasGetter) {
							self.addPropertyCallable(declaration.name, member, "get", member.getterBody);
						}
						if (member.hasSetter) {
							self.addPropertyCallable(declaration.name, member, "set", member.setterBody);
						}
					}
					memberIndex = memberIndex + 1;
				}
			}
			index = index + 1;
		}
	}

	private void addPropertyCallable(string owner, Node declaration, string kind, Node? body) {
		string key = "property:" + owner + "." + declaration.name + ":" + kind;
		string label = owner + "." + declaration.name + "." + kind;
		self.propertyKeys.put(owner + "." + declaration.name + ":" + kind, key);
		self.propertyKeys.put(AstIdentity.key(declaration) + ":" + kind, key);
		self.addCallable(key, label, declaration, body, owner);
	}

	private void addCallable(string key, string label, Node declaration, Node? body, string owner) {
		RealtimeCallable callable = RealtimeCallable(key, label, declaration);
		callable.body = body;
		Node? indexed = self.indexOwner;
		Node top = indexed == null ? declaration : indexed;
		self.ownerOfCallable.put(key, top);
		/* A replayed callable keeps its recorded events and is never scanned,
		 * so only a callable scanned live needs its variable types. */
		if (!self.replays.has(AstIdentity.key(top))) {
			callable.variables.merge(self.analyzed.globalVarTypes);
			if (owner != "") {
				Node selfType = Node();
				selfType.kind = NK_TYPE_EXPR;
				selfType.base = owner;
				callable.variables.put("self", selfType);
			}
			int index = 0;
			while (index < declaration.params().len) {
				Node parameter = declaration.params().get(index);
				callable.variables.put(parameter.name, parameter.type);
				callable.localNames.put(parameter.name, true);
				index = index + 1;
			}
			if (key.endsWith(":set")) {
				callable.variables.put("value", declaration.type);
				callable.localNames.put("value", true);
			}
			self.collectLocals(body, callable);
		}
		self.callables.put(key, callable);
		self.order.push(key);
		self.declarationKeys.put(AstIdentity.key(declaration), key);
	}

	private void collectLocals(Node? node, RealtimeCallable callable) {
		if (node == null || node.kind == NK_TYPE_EXPR) { return; }
		if (node.kind == NK_VAR_DECL_STMT) {
			callable.localNames.put(node.name, true);
		}
		self.collectChildren(node, callable, true);
	}

	private void scanCallable(RealtimeCallable callable) {
		Node declaration = callable.declaration;
		if (declaration.kind == NK_PROPERTY_DECL && self.managedType(declaration.type, {})) {
			string kind = callable.key.endsWith(":set") ? "setter" : "getter";
			self.effect(callable, "ARC", "managed property " + kind, declaration);
		}
		if (declaration.kind == NK_METHOD_DECL && declaration.isConstructor) {
			self.effect(callable, "allocation", "constructor entry", declaration);
		}
		if (declaration.isGpu) {
			self.effect(callable, "runtime", "GPU dispatch", declaration);
		}
		if (declaration.kind != NK_PROPERTY_DECL && callable.body == null) {
			var contract = self.analyzed.nativeCallContract(declaration);
			if (contract == null || !contract.realtimeSafe) {
				self.effect(callable, "unknown", "bodyless or abstract callable", declaration);
			} else { self.externalCall(declaration.name, declaration, callable, true); }
			return;
		}
		int index = 0;
		while (index < declaration.params().len) {
			Node parameter = declaration.params().get(index);
			if (self.managedType(parameter.type, {})) {
				self.effect(callable, "ARC", "managed parameter '" + parameter.name + "'", parameter);
			}
			index = index + 1;
		}
		if (declaration.kind != NK_PROPERTY_DECL && declaration.returnType != null && self.managedType(declaration.returnType, {})) {
			self.effect(callable, "ARC", "managed return type", declaration.returnType);
		}
		self.visit(callable.body, callable);
	}

	private void visit(Node? node, RealtimeCallable callable) {
		if (node == null || node.kind == NK_TYPE_EXPR) { return; }
		/* Each block, case and lambda scopes the locals it declares, so a
		 * local types only the uses it encloses and never a global's. */
		if (node.kind == NK_BLOCK || node.kind == NK_CASE_CLAUSE) {
			callable.openScope();
			self.collectChildren(node, callable, false);
			callable.closeScope();
			return;
		}
		if (node.kind == NK_LAMBDA_EXPR) {
			self.effect(callable, "allocation", "closure construction", node);
			callable.openScope();
			for parameter in node.params() { callable.bindLocal(parameter.name, parameter.type); }
			self.collectChildren(node, callable, false);
			callable.closeScope();
			return;
		}
		if (node.kind == NK_PARALLEL_FOR_STMT) {
			self.effect(callable, "blocking", "parallel for", node);
			self.visit(node.iterable, callable);
			callable.openScope();
			callable.bindLocal(node.varName, null);
			self.visit(node.bodyNode, callable);
			callable.closeScope();
			return;
		}
		if (node.kind == NK_TRY_CATCH_STMT) {
			self.effect(callable, "exceptions", "exception operation", node);
			self.visit(node.tryBlock, callable);
			callable.openScope();
			callable.bindLocal(node.catchVar, node.catchType);
			self.visit(node.catchBlock, callable);
			callable.closeScope();
			self.visit(node.finallyBlock, callable);
			return;
		}
		if (node.kind == NK_WHILE_STMT) {
			self.effect(callable, "blocking", "unproven while loop", node);
			self.visit(node.condition, callable);
			self.visit(node.bodyNode, callable);
			return;
		}
		if (node.kind == NK_DO_WHILE_STMT) {
			self.effect(callable, "blocking", "unproven do-while loop", node);
			self.visit(node.bodyNode, callable);
			self.visit(node.condition, callable);
			return;
		}
		if (node.kind == NK_C_FOR_STMT) {
			callable.openScope();
			self.visitCFor(node, callable);
			callable.closeScope();
			return;
		}
		if (node.kind == NK_CALL_EXPR) {
			self.visitCallee(node.callee, callable);
			int argument = 0;
			while (argument < node.args().len) {
				self.visit(node.args().get(argument), callable);
				argument = argument + 1;
			}
			self.visitOmittedDefaults(node, callable);
			self.callEvent(node, callable);
			return;
		}
		if (node.kind == NK_NEW_EXPR) {
			int argument = 0;
			while (argument < node.args().len) {
				self.visit(node.args().get(argument), callable);
				argument = argument + 1;
			}
			self.effect(callable, "allocation", "new " + node.type.base, node);
			return;
		}
		if (node.kind == NK_ASSIGN_EXPR) {
			self.guardMutation(node.target, callable);
			if (node.target.kind == NK_FIELD_ACCESS_EXPR) {
				self.visit(node.target.obj, callable);
				if (node.op != "=") {
					self.propertyEvent(node.target, "get", callable);
				}
			} else if (node.target.kind == NK_INDEX_EXPR) {
				self.visit(node.target.obj, callable);
				self.visit(node.target.index, callable);
				if (node.op != "=") {
					self.indexEvent(node.target, "get", callable);
				}
			} else {
				self.visit(node.target, callable);
			}
			self.visit(node.valueNode, callable);
			if (node.op != "=") {
				self.operatorEvent(node.target, node.op.substring(0, node.op.length() - 1), false, node, callable);
			}
			if (node.target.kind == NK_FIELD_ACCESS_EXPR) {
				self.propertyEvent(node.target, "set", callable);
			} else if (node.target.kind == NK_INDEX_EXPR) {
				self.indexEvent(node.target, "set", callable);
			}
			Node? valueType = self.expressionTypes.infer(node.valueNode, callable.variables);
			if (self.managedType(valueType, {})) {
				self.effect(callable, "ARC", "managed assignment", node);
			}
			return;
		}
		if (node.kind == NK_FIELD_ACCESS_EXPR) {
			self.visit(node.obj, callable);
			self.valueEffect(node, "field '" + node.field + "'", null, callable);
			self.propertyEvent(node, "get", callable);
			return;
		}
		if (node.kind == NK_CAST_EXPR) {
			self.visit(node.expr, callable);
			self.valueEffect(node, "cast result", node.targetType, callable);
			return;
		}
		if (node.kind == NK_IDENTIFIER) {
			self.valueEffect(node, "identifier '" + node.name + "'", null, callable);
			return;
		}
		if (node.kind == NK_VAR_DECL_STMT) {
			self.guardMutationName(node.name, callable);
			self.visit(node.initializer, callable);
			Node? declaredType = node.type;
			if (declaredType == null && node.initializer != null) {
				declaredType = self.expressionTypes.infer(node.initializer, callable.variables);
			}
			if (self.managedType(declaredType, {})) {
				self.effect(callable, "ARC", "managed local '" + node.name + "'", node);
			}
			callable.bindLocal(node.name, declaredType);
			return;
		}
		if (node.kind == NK_RETURN_STMT) {
			self.visit(node.valueNode, callable);
			Node? valueType = self.expressionTypes.infer(node.valueNode, callable.variables);
			if (self.managedType(valueType, {})) {
				self.effect(callable, "ARC", "managed return value", node);
			}
			return;
		}
		if (node.kind == NK_FOR_IN_STMT) {
			self.effect(callable, "blocking", "unproven for-in loop", node);
			self.visit(node.iterable, callable);
			self.iterationEvents(node, callable);
			callable.openScope();
			callable.bindLocal(node.varName, null);
			callable.bindLocal(node.varName2, null);
			self.visit(node.bodyNode, callable);
			callable.closeScope();
			return;
		}
		if (node.kind == NK_UNARY_EXPR && (node.op == "++" || node.op == "--")) {
			self.guardMutation(node.operand, callable);
			if (node.operand.kind == NK_FIELD_ACCESS_EXPR) {
				self.visit(node.operand.obj, callable);
				self.propertyEvent(node.operand, "get", callable);
				self.propertyEvent(node.operand, "set", callable);
			} else if (node.operand.kind == NK_INDEX_EXPR) {
				self.visit(node.operand.obj, callable);
				self.visit(node.operand.index, callable);
				self.indexEvent(node.operand, "get", callable);
				self.indexEvent(node.operand, "set", callable);
			} else {
				self.visit(node.operand, callable);
			}
			return;
		}
		if (node.kind == NK_STRING_CONCAT) {
			self.effect(callable, "strings", "string value", node);
			return;
		}
		if (node.kind == NK_STRING_LITERAL || node.kind == NK_F_STRING_LITERAL) {
			self.effect(callable, "strings", "string value", node);
		} else if (node.kind == NK_LIST_LITERAL || node.kind == NK_MAP_LITERAL) {
			self.effect(callable, "collections", "collection literal", node);
		} else if (node.kind == NK_SPAWN_EXPR) {
			self.effect(callable, "blocking", "thread spawn", node);
		} else if (node.kind == NK_THROW_STMT) {
			self.effect(callable, "exceptions", "exception operation", node);
		} else if (node.kind == NK_DELETE_STMT || node.kind == NK_KEEP_STMT || node.kind == NK_RELEASE_STMT) {
			self.effect(callable, "ARC", "managed lifetime operation", node);
		} else if (node.kind == NK_BINARY_EXPR) {
			self.visit(node.left, callable);
			self.visit(node.right, callable);
			bool overloaded = self.operatorEvent(node.left, node.op, false, node, callable);
			Node? leftType = self.expressionTypes.infer(node.left, callable.variables);
			Node? rightType = self.expressionTypes.infer(node.right, callable.variables);
			if (!overloaded && (node.op == "/" || node.op == "%")) {
				self.effect(callable, "runtime", "checked '" + node.op + "' operator", node);
			} else if (leftType != null && leftType.base == "string" || rightType != null && rightType.base == "string") {
				self.effect(callable, "strings", "string '" + node.op + "' operator", node);
			} else if (leftType != null && self.collectionType(leftType.base) || rightType != null && self.collectionType(rightType.base)) {
				self.effect(callable, "collections", "collection '" + node.op + "' operator", node);
			}
			return;
		} else if (node.kind == NK_UNARY_EXPR) {
			if (node.op == "&") {
				self.guardMutation(node.operand, callable);
			}
			self.visit(node.operand, callable);
			self.operatorEvent(node.operand, node.op, true, node, callable);
			return;
		} else if (node.kind == NK_INDEX_EXPR) {
			self.visit(node.obj, callable);
			self.visit(node.index, callable);
			self.indexEvent(node, "get", callable);
			return;
		}
		self.collectChildren(node, callable, false);
	}

	/* A C-style loop's declarators bind for the whole loop. Bind them before
	 * the bound proof reads their types. */
	private void visitCFor(Node node, RealtimeCallable callable) {
		if (node.init != null && node.init.kind == NK_FOR_INIT_VAR) {
			for declaration in node.init.declarations() {
				Node? declaredType = declaration.type;
				if (declaredType == null && declaration.initializer != null) {
					declaredType = self.expressionTypes.infer(declaration.initializer, callable.variables);
				}
				callable.bindLocal(declaration.name, declaredType);
			}
		}
		RealtimeLoopProof proof = self.canonicalCFor(node, callable);
		if (!proof.valid) {
			self.effect(callable, "blocking", "unproven C-style loop", node);
			self.collectChildren(node, callable, false);
			return;
		}
		Vector<Node> declarations = node.init.declarations();
		Vector<Node> updates = RealtimeAnalyzer.forUpdateOperands(node.update);
		self.visit(declarations.get(proof.inductionIndex), callable);
		/* The other declarators run before the loop. Each may declare the
		 * bound but never write, or take the address of, the induction
		 * variable or a bound declared before it. */
		bool violated = false;
		int declarationIndex = 0;
		while (declarationIndex < declarations.len) {
			Node declaration = declarations.get(declarationIndex);
			if (declarationIndex != proof.inductionIndex) {
				RealtimeLoopGuard initializer = RealtimeLoopGuard(node);
				initializer.violated = violated;
				if (declaration.name != proof.induction) { initializer.names.put(proof.induction, true); }
				if (proof.bound != "" && declaration.name != proof.bound) { initializer.names.put(proof.bound, true); }
				self.loopGuards.push(initializer);
				self.visit(declaration, callable);
				self.loopGuards.pop();
				violated = initializer.violated;
			}
			declarationIndex++;
		}
		self.visit(node.condition, callable);
		self.visit(updates.get(proof.stepIndex), callable);
		RealtimeLoopGuard guard = RealtimeLoopGuard(node);
		guard.violated = violated;
		guard.names.put(proof.induction, true);
		if (proof.bound != "") { guard.names.put(proof.bound, true); }
		self.loopGuards.push(guard);
		/* Every other update operand runs each iteration, so like the body
		 * it may write neither the induction variable nor its bound. */
		int updateIndex = 0;
		while (updateIndex < updates.len) {
			if (updateIndex != proof.stepIndex) { self.visit(updates.get(updateIndex), callable); }
			updateIndex++;
		}
		self.visit(node.bodyNode, callable);
		self.loopGuards.pop();
		if (!guard.violated) {
			self.analyzed.recordRealtimeBoundedLoop(node);
		}
	}

	private void visitCallee(Node callee, RealtimeCallable callable) {
		if (callee.kind == NK_FIELD_ACCESS_EXPR) {
			self.visit(callee.obj, callable);
		} else if (callee.kind != NK_IDENTIFIER) {
			self.visit(callee, callable);
		}
	}

	private void collectChildren(Node node, RealtimeCallable callable, bool collecting) {
		if (node.spec != null) { self.dispatchChild(node.spec, callable, collecting); }
		if (node.returnType != null) { self.dispatchChild(node.returnType, callable, collecting); }
		if (node.bodyNode != null) { self.dispatchChild(node.bodyNode, callable, collecting); }
		if (node.original != null) { self.dispatchChild(node.original, callable, collecting); }
		if (node.type != null) { self.dispatchChild(node.type, callable, collecting); }
		if (node.default_ != null) { self.dispatchChild(node.default_, callable, collecting); }
		if (node.initializer != null) { self.dispatchChild(node.initializer, callable, collecting); }
		if (node.valueNode != null) { self.dispatchChild(node.valueNode, callable, collecting); }
		if (node.condition != null) { self.dispatchChild(node.condition, callable, collecting); }
		if (node.thenBlock != null) { self.dispatchChild(node.thenBlock, callable, collecting); }
		if (node.elseBlock != null) { self.dispatchChild(node.elseBlock, callable, collecting); }
		if (node.iterable != null) { self.dispatchChild(node.iterable, callable, collecting); }
		if (node.init != null) { self.dispatchChild(node.init, callable, collecting); }
		if (node.update != null) { self.dispatchChild(node.update, callable, collecting); }
		if (node.expr != null) { self.dispatchChild(node.expr, callable, collecting); }
		if (node.tryBlock != null) { self.dispatchChild(node.tryBlock, callable, collecting); }
		if (node.catchType != null) { self.dispatchChild(node.catchType, callable, collecting); }
		if (node.catchBlock != null) { self.dispatchChild(node.catchBlock, callable, collecting); }
		if (node.finallyBlock != null) { self.dispatchChild(node.finallyBlock, callable, collecting); }
		if (node.ifStmt != null) { self.dispatchChild(node.ifStmt, callable, collecting); }
		if (node.expression != null) { self.dispatchChild(node.expression, callable, collecting); }
		if (node.left != null) { self.dispatchChild(node.left, callable, collecting); }
		if (node.right != null) { self.dispatchChild(node.right, callable, collecting); }
		if (node.operand != null) { self.dispatchChild(node.operand, callable, collecting); }
		if (node.callee != null) { self.dispatchChild(node.callee, callable, collecting); }
		if (node.obj != null) { self.dispatchChild(node.obj, callable, collecting); }
		if (node.index != null) { self.dispatchChild(node.index, callable, collecting); }
		if (node.targetType != null) { self.dispatchChild(node.targetType, callable, collecting); }
		if (node.trueExpr != null) { self.dispatchChild(node.trueExpr, callable, collecting); }
		if (node.falseExpr != null) { self.dispatchChild(node.falseExpr, callable, collecting); }
		if (node.target != null) { self.dispatchChild(node.target, callable, collecting); }
		if (node.arraySize != null) { self.dispatchChild(node.arraySize, callable, collecting); }
		if (node.fn != null) { self.dispatchChild(node.fn, callable, collecting); }
		if (node.key != null) { self.dispatchChild(node.key, callable, collecting); }

		if (node.declarationsStorage != null) { self.dispatchVector(node.declarationsStorage, callable, collecting); }
		if (node.membersStorage != null) { self.dispatchVector(node.membersStorage, callable, collecting); }
		if (node.methodsStorage != null) { self.dispatchVector(node.methodsStorage, callable, collecting); }
		if (node.paramsStorage != null) { self.dispatchVector(node.paramsStorage, callable, collecting); }
		if (node.fieldsStorage != null) { self.dispatchVector(node.fieldsStorage, callable, collecting); }
		if (node.valuesStorage != null) { self.dispatchVector(node.valuesStorage, callable, collecting); }
		if (node.variantsStorage != null) { self.dispatchVector(node.variantsStorage, callable, collecting); }
		if (node.genericArgsStorage != null) { self.dispatchVector(node.genericArgsStorage, callable, collecting); }
		if (node.statementsStorage != null) { self.dispatchVector(node.statementsStorage, callable, collecting); }
		if (node.casesStorage != null) { self.dispatchVector(node.casesStorage, callable, collecting); }
		if (node.argsStorage != null) { self.dispatchVector(node.argsStorage, callable, collecting); }
		if (node.elementsStorage != null) { self.dispatchVector(node.elementsStorage, callable, collecting); }
		if (node.entriesStorage != null) { self.dispatchVector(node.entriesStorage, callable, collecting); }
		if (node.partsStorage != null) { self.dispatchVector(node.partsStorage, callable, collecting); }
		if (node.capturesStorage != null) { self.dispatchVector(node.capturesStorage, callable, collecting); }
		if (node.bodyNodeListStorage != null) { self.dispatchVector(node.bodyNodeListStorage, callable, collecting); }
	}

	private void dispatchChild(Node? node, RealtimeCallable callable, bool collecting) {
		if (collecting) {
			self.collectLocals(node, callable);
		} else {
			self.visit(node, callable);
		}
	}

	private void dispatchVector(Vector<Node> nodes, RealtimeCallable callable, bool collecting) {
		int index = 0;
		while (index < nodes.len) {
			self.dispatchChild(nodes.get(index), callable, collecting);
			index = index + 1;
		}
	}

	private Node? directDeclaration(Node call, RealtimeCallable callable) {
		Node callee = call.callee;
		if (callee.kind == NK_IDENTIFIER) {
			if (callable.localNames.has(callee.name) || self.analyzed.globalVarTypes.has(callee.name)) {
				return null;
			}
			if (self.analyzed.funcTable.has(callee.name)) {
				return self.analyzed.funcTable.get(callee.name);
			}
			return null;
		}
		if (callee.kind == NK_FIELD_ACCESS_EXPR) {
			return self.methodDeclaration(callee, callable);
		}
		return null;
	}

	private void visitOmittedDefaults(Node call, RealtimeCallable callable) {
		Node? declaration = self.directDeclaration(call, callable);
		if (declaration == null) { return; }
		Vector<bool> supplied = [];
		int index = 0;
		while (index < declaration.params().len) {
			supplied.push(false);
			index = index + 1;
		}
		int positional = 0;
		index = 0;
		while (index < call.args().len) {
			string argumentName = index < call.argNames().len ? call.argNames().get(index) : "";
			if (argumentName == "") {
				if (positional < supplied.len) {
					supplied.set(positional, true);
					positional = positional + 1;
				}
			} else {
				int parameter = 0;
				while (parameter < declaration.params().len) {
					if (declaration.params().get(parameter).name == argumentName) {
						supplied.set(parameter, true);
					}
					parameter = parameter + 1;
				}
			}
			index = index + 1;
		}
		index = 0;
		while (index < declaration.params().len) {
			Node parameter = declaration.params().get(index);
			if (!supplied.get(index) && parameter.default_ != null) {
				self.visit(parameter.default_, callable);
			}
			index = index + 1;
		}
	}

	private void callEvent(Node call, RealtimeCallable callable) {
		Node callee = call.callee;
		Node? calleeType = self.expressionTypes.infer(callee, callable.variables);
		if (SemanticTypeSystem.realtimeFunctionPointer(calleeType, self.analyzed)) { return; }
		if (callee.kind == NK_IDENTIFIER) {
			string name = callee.name;
			if (callable.localNames.has(name) || self.analyzed.globalVarTypes.has(name)) {
				self.effect(callable, "unknown", "indirect call through '" + name + "'", call);
				return;
			}
			if (self.analyzed.funcTable.has(name) && !self.analyzed.hostedCallKeys.has(AstIdentity.key(call))) {
				self.sourceCall(self.analyzed.funcTable.get(name), call, callable);
				return;
			}
			if (self.runtimeSymbols.intrinsicRealtimeEffect(name, "constructor") == "safe") {
				return;
			}
			if (self.analyzed.isClass(name) || self.analyzed.isGenericClass(name)) {
				self.effect(callable, "allocation", "constructor call '" + name + "'", call);
				return;
			}
			self.externalCall(name, call, callable);
			return;
		}
		if (callee.kind == NK_FIELD_ACCESS_EXPR) {
			Node? receiver = self.expressionTypes.infer(callee.obj, callable.variables);
			if (receiver != null && self.runtimeSymbols.intrinsicRealtimeEffect(receiver.base, callee.field) == "safe") {
				return;
			}
			if (receiver != null && self.collectionType(receiver.base)) {
				self.effect(callable, "collections", receiver.base + "." + callee.field + "()", call);
				return;
			}
			if (receiver != null && receiver.base == "string") {
				self.effect(callable, "strings", "string." + callee.field + "()", call);
				return;
			}
			if (receiver != null && receiver.base == "Mutex") {
				self.effect(callable, "locks", "Mutex." + callee.field + "()", call);
				return;
			}
			Node? declaration = self.methodDeclaration(callee, callable);
			if (declaration != null) {
				self.sourceCall(declaration, call, callable);
				return;
			}
			self.effect(callable, "unknown", "unresolved member call '" + callee.field + "'", call);
			return;
		}
		self.effect(callable, "unknown", "indirect callable value", call);
	}

	private Node? methodDeclaration(Node callee, RealtimeCallable callable) {
		string owner = "";
		if (callee.obj.kind == NK_IDENTIFIER && (self.analyzed.isClass(callee.obj.name) || self.analyzed.isGenericClass(callee.obj.name))) {
			owner = callee.obj.name;
		} else {
			Node? receiver = self.expressionTypes.infer(callee.obj, callable.variables);
			if (receiver != null && (self.analyzed.isClass(receiver.base) || self.analyzed.isGenericClass(receiver.base))) {
				owner = receiver.base;
			}
		}
		if (owner == "") { return null; }
		if (self.analyzed.isGenericClass(owner)) {
			return self.analyzed.genericClassMethod(owner, callee.field);
		}
		return self.analyzed.classMethod(owner, callee.field);
	}

	private void propertyEvent(Node access, string kind, RealtimeCallable callable) {
		string owner = "";
		if (access.obj.kind == NK_IDENTIFIER && (self.analyzed.isClass(access.obj.name) || self.analyzed.isGenericClass(access.obj.name))) {
			owner = access.obj.name;
		} else {
			Node? receiver = self.expressionTypes.infer(access.obj, callable.variables);
			if (receiver != null && (self.analyzed.isClass(receiver.base) || self.analyzed.isGenericClass(receiver.base))) {
				owner = receiver.base;
			}
		}
		if (owner == "") { return; }
		Node? member = self.analyzed.classMember(owner, access.field);
		if (member == null || member.kind != NK_PROPERTY_DECL) { return; }
		string propertyKey = AstIdentity.key(member) + ":" + kind;
		if (!self.propertyKeys.has(propertyKey)) {
			self.effect(callable, "unknown", "unresolved property " + kind + " '" + access.field + "'", access);
			return;
		}
		string target = self.propertyKeys.get(propertyKey);
		if (!self.callables.has(target)) {
			self.effect(callable, "unknown", "unresolved property " + kind + " '" + access.field + "'", access);
			return;
		}
		self.edge(callable, target, access);
	}

	private void sourceCall(Node declaration, Node call, RealtimeCallable callable) {
		string declarationKey = AstIdentity.key(declaration);
		if (!self.declarationKeys.has(declarationKey)) {
			self.effect(callable, "unknown", "unindexed source call '" + declaration.name + "'", call);
			return;
		}
		self.edge(callable, self.declarationKeys.get(declarationKey), call);
	}

	private Node? methodForType(Node? receiver, string name) {
		if (receiver == null) { return null; }
		if (self.analyzed.isGenericClass(receiver.base)) {
			return self.analyzed.genericClassMethod(receiver.base, name);
		}
		if (self.analyzed.isClass(receiver.base)) {
			return self.analyzed.classMethod(receiver.base, name);
		}
		return null;
	}

	private bool operatorEvent(Node operand, string op, bool unary, Node site, RealtimeCallable callable) {
		string methodName = "";
		if (unary && op == "-") {
			methodName = "__neg__";
		} else if (!unary) {
			if (op == "+") { methodName = "__add__"; }
			else if (op == "-") { methodName = "__sub__"; }
			else if (op == "*") { methodName = "__mul__"; }
			else if (op == "/") { methodName = "__div__"; }
			else if (op == "%") { methodName = "__mod__"; }
			else if (op == "==") { methodName = "__eq__"; }
			else if (op == "!=") { methodName = "__ne__"; }
			else if (op == "<") { methodName = "__lt__"; }
			else if (op == ">") { methodName = "__gt__"; }
			else if (op == "<=") { methodName = "__le__"; }
			else if (op == ">=") { methodName = "__ge__"; }
		}
		if (methodName == "") { return false; }
		Node? receiver = self.expressionTypes.infer(operand, callable.variables);
		Node? declaration = self.methodForType(receiver, methodName);
		if (declaration == null) { return false; }
		self.sourceCall(declaration, site, callable);
		return true;
	}

	private void indexEvent(Node index, string kind, RealtimeCallable callable) {
		Node? indexedType = self.expressionTypes.infer(index.obj, callable.variables);
		if (indexedType == null) { return; }
		if (self.collectionType(indexedType.base)) {
			self.effect(callable, "collections", "collection indexing", index);
			return;
		}
		if (indexedType.base == "string") {
			self.effect(callable, "strings", "string indexing", index);
			return;
		}
		Node? declaration = self.methodForType(indexedType, kind);
		if (declaration != null) {
			self.sourceCall(declaration, index, callable);
		}
	}

	private void iterationEvents(Node loop, RealtimeCallable callable) {
		Node? iterableType = self.expressionTypes.infer(loop.iterable, callable.variables);
		if (iterableType == null) { return; }
		if (self.collectionType(iterableType.base)) {
			self.effect(callable, "collections", "collection iteration", loop);
			return;
		}
		if (iterableType.base == "string") {
			self.effect(callable, "strings", "string iteration", loop);
			return;
		}
		Node? length = self.methodForType(iterableType, "iterLen");
		Node? item = self.methodForType(iterableType, "iterGet");
		if (length != null) { self.sourceCall(length, loop, callable); }
		if (item != null) { self.sourceCall(item, loop, callable); }
		if (loop.varName2 != null) {
			Node? value = self.methodForType(iterableType, "iterValueAt");
			if (value != null) { self.sourceCall(value, loop, callable); }
		}
	}

	/* A for update's operands: a comma expression's elements, or the one expression. */
	class Vector<Node> forUpdateOperands(Node? update) {
		Vector<Node> operands = [];
		if (update == null) { return operands; }
		if (update.kind == NK_COMMA_EXPR) {
			for element in update.elements() { operands.push(element); }
			return operands;
		}
		operands.push(update);
		return operands;
	}

	/* Prove `for (T i = literal, ...; i < bound; ..., i++, ...)` bounded. The
	 * induction variable is the declarator the condition compares; the update
	 * must step it exactly once in the condition's direction. */
	private RealtimeLoopProof canonicalCFor(Node loop, RealtimeCallable callable) {
		if (loop.init == null || loop.init.kind != NK_FOR_INIT_VAR) {
			return RealtimeLoopProof();
		}
		Node? condition = loop.condition;
		if (condition == null || condition.kind != NK_BINARY_EXPR || condition.op != "<" && condition.op != ">") {
			return RealtimeLoopProof();
		}
		/* Either side may name the induction variable; with a declarator on
		 * each side, the one the update steps is it. */
		if (condition.left.kind == NK_IDENTIFIER) {
			RealtimeLoopProof leftProof = self.canonicalInduction(loop, callable, condition.left.name, condition.right, condition.op == "<" ? "++" : "--");
			if (leftProof.valid) { return leftProof; }
		}
		if (condition.right.kind == NK_IDENTIFIER) {
			return self.canonicalInduction(loop, callable, condition.right.name, condition.left, condition.op == "<" ? "--" : "++");
		}
		return RealtimeLoopProof();
	}

	private RealtimeLoopProof canonicalInduction(Node loop, RealtimeCallable callable, string name, Node bound, string direction) {
		RealtimeLoopProof proof = RealtimeLoopProof();
		Vector<Node> declarations = loop.init.declarations();
		int inductionIndex = -1;
		int index = 0;
		while (index < declarations.len) {
			Node candidate = declarations.get(index);
			if (candidate.kind == NK_VAR_DECL_STMT && candidate.name == name) { inductionIndex = index; }
			index++;
		}
		if (inductionIndex < 0) { return proof; }
		Node declaration = declarations.get(inductionIndex);
		if (declaration.initializer == null || declaration.initializer.kind != NK_INT_LITERAL) {
			return proof;
		}
		Node? inductionType = declaration.type;
		if (inductionType == null) {
			inductionType = self.expressionTypes.infer(declaration.initializer, callable.variables);
		}
		if (!self.integralScalar(inductionType, {})) { return proof; }

		string boundName = "";
		if (bound.kind == NK_IDENTIFIER) {
			if (bound.name == declaration.name || !callable.localNames.has(bound.name) || !self.integralScalar(self.expressionTypes.infer(bound, callable.variables), {})) {
				return proof;
			}
			boundName = bound.name;
		} else if (bound.kind != NK_INT_LITERAL) {
			return proof;
		}

		Vector<Node> updates = RealtimeAnalyzer.forUpdateOperands(loop.update);
		int stepIndex = -1;
		int steps = 0;
		index = 0;
		while (index < updates.len) {
			Node update = updates.get(index);
			if (update.kind == NK_UNARY_EXPR && update.op == direction && update.operand.kind == NK_IDENTIFIER && update.operand.name == declaration.name) {
				stepIndex = index;
				steps++;
			}
			index++;
		}
		if (steps != 1) { return proof; }
		proof.valid = true;
		proof.induction = declaration.name;
		proof.bound = boundName;
		proof.inductionIndex = inductionIndex;
		proof.stepIndex = stepIndex;
		return proof;
	}

	private bool integralScalar(Node? typeExpr, Map<string, bool> seen) {
		if (typeExpr == null || seen.has(typeExpr.base)) { return false; }
		if (self.analyzed.typedefTable.has(typeExpr.base)) {
			return self.integralScalar(self.analyzed.typedefTable.get(typeExpr.base), self.nextSeen(seen, typeExpr.base));
		}
		return NumericSemantics.isScalar(typeExpr) && typeExpr.base != "bool" && !self.analyzed.isEnum(typeExpr.base) && !typeExpr.base.startsWith("enum ") && NumericSemantics.isType(typeExpr, self.analyzed) && !NumericSemantics.isFloating(typeExpr);
	}

	private void guardMutation(Node? expression, RealtimeCallable callable) {
		if (expression != null && expression.kind == NK_IDENTIFIER) {
			self.guardMutationName(expression.name, callable);
		}
	}

	private void guardMutationName(string name, RealtimeCallable callable) {
		int index = self.loopGuards.len - 1;
		while (index >= 0) {
			RealtimeLoopGuard guard = self.loopGuards.get(index);
			if (guard.names.has(name)) {
				if (!guard.violated) {
					self.effect(callable, "blocking", "unproven C-style loop", guard.site);
				}
				guard.violated = true;
			}
			index = index - 1;
		}
	}

	private void valueEffect(Node expression, string operation, Node? fallback, RealtimeCallable callable) {
		Node? typeExpr = fallback;
		if (typeExpr == null) {
			typeExpr = self.expressionTypes.infer(expression, callable.variables);
		}
		string category = self.valueCategory(typeExpr);
		if (category == "") { return; }
		string valueKind = "managed";
		if (category == "strings") { valueKind = "string"; }
		else if (category == "collections") { valueKind = "collection"; }
		self.effect(callable, category, valueKind + " " + operation, expression);
	}

	private string valueCategory(Node? typeExpr) {
		if (typeExpr == null) { return ""; }
		if (typeExpr.base == "string") { return "strings"; }
		if (self.collectionType(typeExpr.base)) { return "collections"; }
		if (self.managedType(typeExpr, {})) { return "ARC"; }
		return "";
	}

	private bool collectionType(string base) { return base == "Array" || base == "List" || base == "Map" || base == "Set" || base == "Vector"; }

	private bool allocationCall(string name) { return name == "malloc" || name == "calloc" || name == "realloc" || name == "aligned_alloc" || name == "free" || name == "strdup" || name == "strndup"; }

	private bool lockCall(string name) { return name.startsWith("pthread_mutex_") || name.startsWith("pthread_cond_"); }

	private bool logCall(string name) { return name == "print" || name == "printf" || name == "fprintf" || name == "vprintf" || name == "vfprintf" || name == "syslog"; }

	private bool blockingCall(string name) { return name == "sleep" || name == "usleep" || name == "nanosleep" || name == "wait" || name == "waitpid" || name == "pthread_join" || name == "thrd_join"; }

	private bool ioCall(string name) { return name == "open" || name == "close" || name == "read" || name == "write" || name == "pread" || name == "pwrite" || name == "fopen" || name == "fclose" || name == "fread" || name == "fwrite" || name == "socket" || name == "accept" || name == "connect" || name == "recv" || name == "send"; }

	private void externalCall(string name, Node call, RealtimeCallable callable, bool reviewedNative = false) {
		string category = reviewedNative ? "safe" : "unknown";
		if (self.allocationCall(name)) {
			category = "allocation";
		} else if (self.lockCall(name)) {
			category = "locks";
		} else if (self.logCall(name)) {
			category = "logging";
		} else if (self.blockingCall(name)) {
			category = "blocking";
		} else if (self.ioCall(name)) {
			category = "I/O";
		} else if (name == "len") {
			category = "collections";
		} else if (self.runtimeSymbols.helper(name)) {
			category = self.catalogCategory(self.runtimeSymbols.realtimeEffect(name));
		} else if (self.hostedAbi.functionOwnedName(name)) {
			category = self.catalogCategory(self.hostedAbi.realtimeEffect(name));
		}
		if (category != "safe") {
			self.effect(callable, category, "external call '" + name + "()'", call);
		}
	}

	private string catalogCategory(string effect) {
		if (effect == "arc") { return "ARC"; }
		if (effect == "io") { return "I/O"; }
		return effect;
	}

	private bool managedType(Node? typeExpr, Map<string, bool> seen) {
		if (typeExpr == null || seen.has(typeExpr.base)) { return false; }
		string base = typeExpr.base;
		if (self.analyzed.nativeInvocation(base)) { return false; }
		if (base == "string" || self.collectionType(base) || self.analyzed.isClass(base) || self.analyzed.isGenericClass(base) || self.analyzed.isInterface(base)) {
			return true;
		}
		if (self.analyzed.typedefTable.has(base) && self.managedType(self.analyzed.typedefTable.get(base), self.nextSeen(seen, base))) {
			return true;
		}
		if (self.analyzed.structTable.has(base)) {
			Node structure = self.analyzed.structTable.get(base);
			Vector<Node> structureFields = SemanticTypeSystem.recordFields(structure);
			int field = 0;
			while (field < structureFields.len) {
				if (self.managedType(structureFields.get(field).type, self.nextSeen(seen, base))) {
					return true;
				}
				field = field + 1;
			}
		}
		if (self.analyzed.richEnumTable.has(base)) {
			Node declaration = self.analyzed.richEnumTable.get(base);
			int variant = 0;
			while (variant < declaration.variants().len) {
				Node item = declaration.variants().get(variant);
				int parameter = 0;
				while (parameter < item.params().len) {
					if (self.managedType(item.params().get(parameter).type, self.nextSeen(seen, base))) {
						return true;
					}
					parameter = parameter + 1;
				}
				variant = variant + 1;
			}
		}
		int argument = 0;
		while (argument < typeExpr.genericArgs().len) {
			if (self.managedType(typeExpr.genericArgs().get(argument), self.nextSeen(seen, base))) {
				return true;
			}
			argument = argument + 1;
		}
		return false;
	}

	private Map<string, bool> nextSeen(Map<string, bool> seen, string base) {
		Map<string, bool> next = {};
		Vector<string> names = seen.keys();
		int index = 0;
		while (index < names.len) {
			next.put(names.get(index), true);
			index = index + 1;
		}
		next.put(base, true);
		return next;
	}

	/* After a callable's first effect nothing it does changes a verdict: it
	 * is unsafe, and a witness search returns at that effect before any later
	 * event. A cycle through one of its later calls leaves every member
	 * reaching an effect by earlier calls, so unsafe all the same. Later events
	 * are neither kept nor recorded, which was nine in ten record lines. */
	private void effect(RealtimeCallable callable, string category, string operation, Node site) {
		if (callable.settled) { return; }
		callable.settled = true;
		RealtimeEvent event = RealtimeEvent();
		event.isEffect = true;
		event.category = category;
		event.operation = operation;
		event.line = site.line;
		event.col = site.col;
		callable.events.push(event);
		ValidationFact? fact = self.analyzed.journalFact(VALIDATION_REALTIME_EFFECT, site, null);
		if (fact != null) {
			fact.name = callable.key;
			fact.member = category;
			fact.detail = operation;
		}
	}

	private void edge(RealtimeCallable callable, string target, Node site) {
		if (callable.settled) { return; }
		RealtimeEvent event = RealtimeEvent();
		event.target = target;
		event.line = site.line;
		event.col = site.col;
		callable.events.push(event);
		ValidationFact? fact = self.analyzed.journalFact(VALIDATION_REALTIME_EDGE, site, null);
		if (fact != null) {
			fact.name = callable.key;
			fact.member = target;
		}
	}

	/* Installs every replayed declaration's recorded events on its callables,
	 * with sites at their nodes' current positions, and its bounded-loop
	 * proofs. */
	private void installReplays() {
		for declaration in self.program.declarations() {
			string identity = AstIdentity.key(declaration);
			if (!self.replays.has(identity)) { continue; }
			for fact in self.replays.get(identity) {
				Node? site = fact.node;
				if (site == null) { self.replayMismatch(declaration); return; }
				if (fact.kind == VALIDATION_BOUNDED_LOOP) {
					self.analyzed.recordRealtimeBoundedLoop(site);
					continue;
				}
				if ((fact.kind != VALIDATION_REALTIME_EFFECT && fact.kind != VALIDATION_REALTIME_EDGE) || !self.callables.has(fact.name)) { self.replayMismatch(declaration); return; }
				RealtimeEvent event = RealtimeEvent();
				event.isEffect = fact.kind == VALIDATION_REALTIME_EFFECT;
				if (event.isEffect) {
					event.category = fact.member;
					event.operation = fact.detail;
				} else {
					event.target = fact.member;
				}
				event.line = site.line;
				event.col = site.col;
				RealtimeCallable owner = self.callables.get(fact.name);
				if (owner.settled) { continue; }
				if (event.isEffect) { owner.settled = true; }
				owner.events.push(event);
			}
		}
	}

	/* A record names a callable its unchanged declaration no longer has:
	 * the record key did not capture something it should have. */
	private void replayMismatch(Node declaration) {
		fprintf(stderr, "internal compiler error: realtime record does not match its declaration at %d:%d\n", declaration.line, declaration.col);
		exit(1);
	}

	private ValidationJournal? beginJournal(Node declaration) {
		IValidationRecords? records = self.records;
		if (records == null || (declaration.kind != NK_FUNCTION_DECL && declaration.kind != NK_CLASS_DECL) || !records.journals(RECORD_PHASE_REALTIME, declaration)) { return null; }
		ValidationJournal journal = ValidationJournal();
		self.analyzed.journal = journal;
		return journal;
	}

	private void endJournal(Node? declaration, ValidationJournal? journal) {
		if (declaration == null || journal == null) { return; }
		self.analyzed.journal = null;
		IValidationRecords? records = self.records;
		if (records != null && !records.finish(RECORD_PHASE_REALTIME, declaration, journal)) {
			fprintf(stderr, "error: realtime record disagrees with live analysis at %d:%d\n", declaration.line, declaration.col);
			exit(1);
		}
	}

	private Map<string, bool> unsafeFixedPoint() {
		Map<string, bool> unsafe = self.recursiveCallables();
		int index = 0;
		while (index < self.order.len) {
			string key = self.order.get(index);
			Vector<RealtimeEvent> events = self.callables.get(key).events;
			int eventIndex = 0;
			while (eventIndex < events.len) {
				if (events.get(eventIndex).isEffect) {
					unsafe.put(key, true);
				}
				eventIndex = eventIndex + 1;
			}
			index = index + 1;
		}
		bool changed = true;
		while (changed) {
			changed = false;
			index = 0;
			while (index < self.order.len) {
				string key = self.order.get(index);
				if (!unsafe.has(key)) {
					Vector<RealtimeEvent> events = self.callables.get(key).events;
					int eventIndex = 0;
					while (eventIndex < events.len) {
						RealtimeEvent event = events.get(eventIndex);
						if (!event.isEffect && unsafe.has(event.target)) {
							unsafe.put(key, true);
							changed = true;
						}
						eventIndex = eventIndex + 1;
					}
				}
				index = index + 1;
			}
		}
		return unsafe;
	}

	/* A callable is recursive when some call edge leads back to it. That is
	 * membership in a strongly connected component of more than one callable,
	 * or a direct self-edge: the same answer as a search over every simple
	 * path from each callee, which is exponential in the call graph. */
	private Map<string, bool> recursiveCallables() {
		RealtimeCallGraphComponents components = RealtimeCallGraphComponents(self.callables);
		int index = 0;
		while (index < self.order.len) {
			components.connect(self.order.get(index));
			index = index + 1;
		}
		return components.recursive;
	}

	private RealtimeWitness? firstWitness(string key, Map<string, bool> unsafe, Map<string, bool> visiting) {
		if (visiting.has(key)) { return null; }
		Map<string, bool> nextVisiting = {};
		Vector<string> visited = visiting.keys();
		int visitedIndex = 0;
		while (visitedIndex < visited.len) {
			nextVisiting.put(visited.get(visitedIndex), true);
			visitedIndex = visitedIndex + 1;
		}
		nextVisiting.put(key, true);
		Vector<RealtimeEvent> events = self.callables.get(key).events;
		int index = 0;
		while (index < events.len) {
			RealtimeEvent event = events.get(index);
			if (event.isEffect) {
				RealtimeWitness witness = RealtimeWitness();
				witness.category = event.category;
				witness.operation = event.operation;
				witness.line = event.line;
				witness.col = event.col;
				return witness;
			}
			if (unsafe.has(event.target)) {
				if (nextVisiting.has(event.target)) {
					RealtimeWitness cycle = RealtimeWitness();
					cycle.category = "blocking";
					cycle.operation = "recursive call cycle";
					cycle.line = event.line;
					cycle.col = event.col;
					cycle.path.push(self.callables.get(event.target).label);
					return cycle;
				}
				RealtimeWitness? downstream = self.firstWitness(event.target, unsafe, nextVisiting);
				if (downstream != null) {
					RealtimeWitness witness = RealtimeWitness();
					witness.category = downstream.category;
					witness.operation = downstream.operation;
					witness.line = downstream.line;
					witness.col = downstream.col;
					witness.path.push(self.callables.get(event.target).label);
					int pathIndex = 0;
					while (pathIndex < downstream.path.len) {
						witness.path.push(downstream.path.get(pathIndex));
						pathIndex = pathIndex + 1;
					}
					return witness;
				}
			}
			index = index + 1;
		}
		return null;
	}

	private void fail(RealtimeCallable root, RealtimeWitness witness) {
		string path = root.label;
		int index = 0;
		while (index < witness.path.len) {
			path = path + " -> " + witness.path.get(index);
			index = index + 1;
		}
		FeDiagnosticSources.fail(f"@realtime callable '{root.label}' reaches forbidden {witness.category} operation '{witness.operation}' via {path}", witness.line, witness.col);
	}
}
