import std.map;
import std.strings;
import std.vector;
import ../generated/ast/node.btrc;
import ../syntax/identity.btrc;
import ../syntax/literals.btrc;
import ../syntax/types.btrc;
import ./models.btrc;
import ./types.btrc;

/* Analyzer-owned numeric and operator domains.
 *
 * This is the self-hosted mirror of compiler/python/analyzer/types.py. Keep
 * these decisions outside IR generation so inference, ordinary expressions,
 * generic bodies, ternaries, and lvalue updates cannot drift apart. */

class NumericSemantics {
    class bool isScalar(Node? typeExpr) {
        if (typeExpr == null) { return false; }
        return typeExpr.pointer_depth == 0 && !typeExpr.is_array
            && typeExpr.generic_args.len == 0;
    }

    class bool isFloating(Node? typeExpr) {
        if (typeExpr == null) { return false; }
        if (!NumericSemantics.isScalar(typeExpr)) { return false; }
        return typeExpr.base == "float" || typeExpr.base == "double"
            || typeExpr.base == "long double";
    }

    class bool isStandardTypedef(string base) {
        return base == "int8_t" || base == "uint8_t"
            || base == "int16_t" || base == "uint16_t"
            || base == "int32_t" || base == "uint32_t"
            || base == "int64_t" || base == "uint64_t"
            || base == "int_least8_t" || base == "uint_least8_t"
            || base == "int_least16_t" || base == "uint_least16_t"
            || base == "int_least32_t" || base == "uint_least32_t"
            || base == "int_least64_t" || base == "uint_least64_t"
            || base == "int_fast8_t" || base == "uint_fast8_t"
            || base == "int_fast16_t" || base == "uint_fast16_t"
            || base == "int_fast32_t" || base == "uint_fast32_t"
            || base == "int_fast64_t" || base == "uint_fast64_t"
            || base == "intptr_t" || base == "uintptr_t"
            || base == "intmax_t" || base == "uintmax_t"
            || base == "ptrdiff_t" || base == "size_t"
            || base == "wchar_t" || base == "wint_t"
            || base == "sig_atomic_t" || base == "ssize_t"
            || base == "pid_t" || base == "uid_t" || base == "gid_t"
            || base == "off_t" || base == "mode_t" || base == "dev_t"
            || base == "ino_t" || base == "nlink_t"
            || base == "blksize_t" || base == "blkcnt_t"
            || base == "time_t" || base == "clock_t"
            || base == "suseconds_t" || base == "useconds_t"
            || base == "socklen_t" || base == "tcflag_t";
    }

    /* These typedef families have a language-level width/sign contract.  The
     * remaining C/POSIX integer typedefs deliberately do not: their underlying
     * type is selected by the target ABI. */
    class bool isPortableWidthTypedef(string base) {
        return base == "int8_t" || base == "uint8_t"
            || base == "int16_t" || base == "uint16_t"
            || base == "int32_t" || base == "uint32_t"
            || base == "int64_t" || base == "uint64_t"
            || base == "int_least8_t" || base == "uint_least8_t"
            || base == "int_least16_t" || base == "uint_least16_t"
            || base == "int_least32_t" || base == "uint_least32_t"
            || base == "int_least64_t" || base == "uint_least64_t";
    }

    class bool isAbiDependentTypedef(string base) {
        return NumericSemantics.isStandardTypedef(base)
            && !NumericSemantics.isPortableWidthTypedef(base);
    }

    /* A floating operand determines the result domain without consulting the
     * integer ABI.  Same-typedef operations preserve that typedef.  Every other
     * mix involving an ABI-selected integer typedef needs an explicit cast. */
    class bool integerMixIsPortable(Node? left, Node? right) {
        if (left == null || right == null) { return true; }
        if (NumericSemantics.isFloating(left)
                || NumericSemantics.isFloating(right)) { return true; }
        if (left.base == right.base) { return true; }
        return !NumericSemantics.isAbiDependentTypedef(left.base)
            && !NumericSemantics.isAbiDependentTypedef(right.base);
    }

    class bool isIntegralBase(string base) {
        return base == "bool" || base == "byte" || base == "char"
            || base == "signed char" || base == "unsigned char"
            || base == "short" || base == "short int"
            || base == "signed short" || base == "signed short int"
            || base == "unsigned short" || base == "unsigned short int"
            || base == "int" || base == "signed" || base == "signed int"
            || base == "uint" || base == "unsigned" || base == "unsigned int"
            || base == "long" || base == "long int"
            || base == "signed long" || base == "signed long int"
            || base == "unsigned long" || base == "unsigned long int"
            || base == "long long" || base == "long long int"
            || base == "signed long long" || base == "signed long long int"
            || base == "unsigned long long"
            || base == "unsigned long long int";
    }

    class bool isType(Node? typeExpr, Analyzed analyzed) {
        if (typeExpr == null) { return false; }
        if (!NumericSemantics.isScalar(typeExpr)) { return false; }
        string base = typeExpr.base;
        return NumericSemantics.isIntegralBase(base)
            || NumericSemantics.isFloating(typeExpr)
            || NumericSemantics.isStandardTypedef(base) || analyzed.isEnum(base)
            || base.startsWith("enum ");
    }

    class bool isUnsignedBase(string base) {
        if (base == "uint" || base == "unsigned" || base == "unsigned int"
                || base == "unsigned long" || base == "unsigned long int"
                || base == "unsigned long long"
                || base == "unsigned long long int") {
            return true;
        }
        return base == "uint8_t" || base == "uint16_t"
            || base == "uint32_t" || base == "uint64_t"
            || base == "uint_least8_t" || base == "uint_least16_t"
            || base == "uint_least32_t" || base == "uint_least64_t"
            || base == "uint_fast8_t" || base == "uint_fast16_t"
            || base == "uint_fast32_t" || base == "uint_fast64_t"
            || base == "uintptr_t" || base == "uintmax_t"
            || base == "size_t" || base == "uid_t" || base == "gid_t"
            || base == "mode_t" || base == "dev_t" || base == "ino_t"
            || base == "nlink_t" || base == "useconds_t"
            || base == "socklen_t" || base == "tcflag_t";
    }

    class int integralRank(string base, Analyzed analyzed) {
        if (base == "long long" || base == "long long int"
                || base == "signed long long" || base == "signed long long int"
                || base == "unsigned long long"
                || base == "unsigned long long int") {
            return 5;
        }
        if (base == "long" || base == "long int"
                || base == "signed long" || base == "signed long int"
                || base == "unsigned long" || base == "unsigned long int") {
            return 4;
        }
        if (NumericSemantics.isPortableWidthTypedef(base)) {
            if (base.contains("64")) { return 5; }
            return 3;
        }
        /* No target-independent rank exists for fast-, pointer-, max-, C library,
         * or POSIX-selected typedefs.  Portable mixed operations are rejected
         * before asking for a rank. */
        if (NumericSemantics.isAbiDependentTypedef(base)) { return -1; }
        if (analyzed.isEnum(base) || base.startsWith("enum ")) { return 3; }
        return 3;
    }

    class Node? resultType(Node? left, Node? right, Analyzed analyzed) {
        if (!NumericSemantics.isType(left, analyzed)
                || !NumericSemantics.isType(right, analyzed)) {
            return null;
        }
        if (left == null || right == null) { return null; }
        if (NumericSemantics.isFloating(left)
                || NumericSemantics.isFloating(right)) {
            if (left.base == "long double" || right.base == "long double") {
                return SemanticTypeSystem.primitive("long double");
            }
            if (left.base == "double" || right.base == "double") {
                return SemanticTypeSystem.primitive("double");
            }
            return SemanticTypeSystem.primitive("float");
        }
        if (!NumericSemantics.integerMixIsPortable(left, right)) { return null; }
        if (left.base == right.base
                && NumericSemantics.isStandardTypedef(left.base)) {
            return SemanticTypeSystem.primitive(left.base);
        }
        int rank = NumericSemantics.integralRank(left.base, analyzed);
        int rightRank = NumericSemantics.integralRank(right.base, analyzed);
        if (rank < 0 || rightRank < 0) { return null; }
        if (rightRank > rank) { rank = rightRank; }
        bool isUnsigned = NumericSemantics.isUnsignedBase(left.base)
            || NumericSemantics.isUnsignedBase(right.base);
        if (rank >= 5) {
            if (isUnsigned) { return SemanticTypeSystem.primitive("unsigned long long"); }
            return SemanticTypeSystem.primitive("long long");
        }
        if (rank == 4) {
            if (isUnsigned) { return SemanticTypeSystem.primitive("unsigned long"); }
            return SemanticTypeSystem.primitive("long");
        }
        if (isUnsigned) { return SemanticTypeSystem.primitive("uint"); }
        return SemanticTypeSystem.primitive("int");
    }

    class bool operandsNeedCast(Node left, Node right, Analyzed analyzed) {
        if (left.base == right.base) { return false; }
        if (!NumericSemantics.integerMixIsPortable(left, right)) { return false; }
        if (NumericSemantics.isStandardTypedef(left.base)
                || NumericSemantics.isStandardTypedef(right.base)) {
            return true;
        }
        if (NumericSemantics.isFloating(left)
                || NumericSemantics.isFloating(right)) { return false; }
        bool leftUnsigned = NumericSemantics.isUnsignedBase(left.base);
        bool rightUnsigned = NumericSemantics.isUnsignedBase(right.base);
        if (leftUnsigned == rightUnsigned) { return false; }
        int signedRank = NumericSemantics.integralRank(left.base, analyzed);
        int unsignedRank = NumericSemantics.integralRank(right.base, analyzed);
        if (leftUnsigned) {
            unsignedRank = NumericSemantics.integralRank(left.base, analyzed);
            signedRank = NumericSemantics.integralRank(right.base, analyzed);
        }
        return signedRank > unsignedRank;
    }

    class Node? integerLiteralType(string raw) {
        string name = IntegerLiteral(raw).typeName();
        if (name == "") { return null; }
        return SemanticTypeSystem.primitive(name);
    }

    class Node floatLiteralType(string raw) {
        return SemanticTypeSystem.primitive(FloatLiteral(raw).typeName());
    }
}

/* Per-compilation comparison, reference, coalescing, overload, and hashing
 * domains. The owner mirrors Python OperatorSemantics by retaining the
 * analyzed nominal/enum universe and delegating structural identity to
 * TypeIdentity. */

enum OperatorDomain {
    OP_DOMAIN_UNRESOLVED = -1,
    OP_DOMAIN_INVALID = 0,
    OP_DOMAIN_STRING = 1,
    OP_DOMAIN_NUMERIC = 2,
    OP_DOMAIN_REFERENCE = 3,
};

enum HashDomain {
    HASH_DOMAIN_INVALID = 0,
    HASH_DOMAIN_STRING = 1,
    HASH_DOMAIN_FLOATING = 2,
    HASH_DOMAIN_INTEGRAL = 3,
    HASH_DOMAIN_REFERENCE = 4,
};

class OperatorSemantics {
    private Analyzed analyzed;

    public OperatorSemantics(Analyzed analyzed) {
        self.analyzed = analyzed;
    }

    public Node nullType() {
        Node typeExpr = SemanticTypeSystem.primitive("void");
        typeExpr.pointer_depth = 1;
        typeExpr.is_nullable = true;
        return typeExpr;
    }

    public bool isNullType(Node? typeExpr) {
        return typeExpr != null
            && (typeExpr.base == "null" || typeExpr.base == "void")
            && typeExpr.pointer_depth > 0 && typeExpr.is_nullable;
    }

    public int referenceDepth(Node typeExpr) {
        int depth = typeExpr.pointer_depth;
        bool intrinsicReference = typeExpr.base == "string"
            || typeExpr.base == "Thread" || typeExpr.base == "Mutex"
            || typeExpr.base == "__fn_ptr";
        if (TypeComposition.nullableCollapsesReferenceLayer(
                typeExpr, intrinsicReference)) {
            depth = depth - 1;
        }
        if (typeExpr.is_array) { depth = depth + 1; }
        if (intrinsicReference) { depth = depth + 1; }
        return depth;
    }

    /* Effective expression-value depth.  Class and opaque handle declarations
     * omit their intrinsic pointer in source, while inferred/member types may
     * already carry it.  These spellings describe the same runtime value shape. */
    public int valueDepth(Node typeExpr) {
        int depth = self.referenceDepth(typeExpr);
        if (depth == 0 && (self.analyzed.isClass(typeExpr.base)
                || (typeExpr.generic_args.len > 0
                    && self.analyzed.isGenericClass(typeExpr.base)))) {
            depth = 1;
        }
        return depth;
    }

    public bool isVoidPointer(Node typeExpr) {
        return typeExpr.base == "void"
            && self.referenceDepth(typeExpr) == 1;
    }

    /* Exactly one C `char` indirection is interoperable with semantic `string`.
     * Arrays count as one indirection; char** and pointer-to-array shapes do not. */
    public bool isCStringPointer(Node? typeExpr) {
        return typeExpr != null && typeExpr.base == "char"
            && self.referenceDepth(typeExpr) == 1
            && typeExpr.generic_args.len == 0;
    }

    public bool isReferenceType(Node? typeExpr) {
        if (typeExpr == null) { return false; }
        if (self.isNullType(typeExpr)
                || TypeComposition.isSemanticScalarString(typeExpr)) {
            return true;
        }
        return typeExpr.pointer_depth > 0 || typeExpr.is_array
            || self.analyzed.isClass(typeExpr.base)
            || self.analyzed.isGenericClass(typeExpr.base)
            || typeExpr.base == "Thread" || typeExpr.base == "Mutex"
            || typeExpr.base == "__fn_ptr";
    }

    public bool genericArgsEqual(Vector<Node> left, Vector<Node> right) {
        if (left.len != right.len) { return false; }
        int index = 0;
        while (index < left.len) {
            if (TypeIdentity.shapeKey(left.get(index)) != TypeIdentity.shapeKey(right.get(index))) {
                return false;
            }
            index = index + 1;
        }
        return true;
    }

    public bool specializationIsSubtype(Node child, Node parent) {
        string currentBase = child.base;
        bool carriesArgs = true;
        Map<string, bool> seen = {};
        while (currentBase != "" && !seen.has(currentBase)) {
            seen.put(currentBase, true);
            if (currentBase == parent.base) {
                if (!carriesArgs) { return parent.generic_args.len == 0; }
                return self.genericArgsEqual(
                    child.generic_args, parent.generic_args);
            }
            Node? declaration = null;
            if (self.analyzed.classTable.has(currentBase)) {
                declaration = self.analyzed.classTable.get(currentBase);
            } else if (self.analyzed.genericClassTable.has(currentBase)) {
                declaration = self.analyzed.genericClassTable.get(currentBase);
            }
            if (declaration == null) { return false; }
            string ancestor = (declaration.parent == null ? "" : declaration.parent);
            if (ancestor == "") { return false; }
            int ancestorArity = 0;
            if (self.analyzed.genericClassTable.has(ancestor)) {
                ancestorArity = self.analyzed.genericClassTable.get(
                    ancestor).generic_params.len;
            }
            if (ancestorArity > 0) {
                int currentArity = declaration.generic_params.len;
                if (!carriesArgs || ancestorArity != currentArity
                        || currentArity != child.generic_args.len) {
                    return false;
                }
            } else {
                carriesArgs = false;
            }
            currentBase = ancestor;
        }
        return false;
    }

    public bool nominallyRelated(Node left, Node right) {
        bool nominalLeft = self.analyzed.isClass(left.base)
            || self.analyzed.isGenericClass(left.base);
        bool nominalRight = self.analyzed.isClass(right.base)
            || self.analyzed.isGenericClass(right.base);
        if (!nominalLeft || !nominalRight) { return false; }
        return self.specializationIsSubtype(left, right)
            || self.specializationIsSubtype(right, left);
    }

    public bool referenceTypesCompatible(Node? left, Node? right) {
        if (self.isNullType(left)) {
            return self.isReferenceType(right);
        }
        if (self.isNullType(right)) {
            return self.isReferenceType(left);
        }
        if (left == null || right == null) { return false; }
        if (!self.isReferenceType(left)
                || !self.isReferenceType(right)) {
            return false;
        }
        if (left.base == "__fn_ptr" || right.base == "__fn_ptr") {
            return left.base == "__fn_ptr" && right.base == "__fn_ptr"
                && self.genericArgsEqual(
                    left.generic_args, right.generic_args);
        }
        if (self.isVoidPointer(left)
                || self.isVoidPointer(right)) {
            return true;
        }
        if ((TypeComposition.isSemanticScalarString(left)
                    && self.isCStringPointer(right))
                || (TypeComposition.isSemanticScalarString(right)
                    && self.isCStringPointer(left))) {
            return true;
        }
        if (self.valueDepth(left) != self.valueDepth(right)) {
            return false;
        }
        if (left.base == right.base) {
            return self.genericArgsEqual(
                left.generic_args, right.generic_args);
        }
        return self.nominallyRelated(left, right);
    }

    public bool isComparisonOperator(string op) {
        return op == "==" || op == "!=" || op == "<" || op == ">"
            || op == "<=" || op == ">=";
    }

    public int comparisonDomain(string op, Node? left, Node? right) {
        if (left == null || right == null) { return OP_DOMAIN_UNRESOLVED; }
        bool leftString = TypeComposition.isSemanticScalarString(left);
        bool rightString = TypeComposition.isSemanticScalarString(right);
        if (leftString || rightString) {
            if ((leftString || self.isCStringPointer(left)
                        || self.isNullType(left))
                    && (rightString || self.isCStringPointer(right)
                        || self.isNullType(right))) {
                return OP_DOMAIN_STRING;
            }
            return OP_DOMAIN_INVALID;
        }
        if (NumericSemantics.isType(left, self.analyzed)
                && NumericSemantics.isType(right, self.analyzed)) {
            return OP_DOMAIN_NUMERIC;
        }
        bool leftRef = self.isReferenceType(left);
        bool rightRef = self.isReferenceType(right);
        if (leftRef || rightRef) {
            if (op != "==" && op != "!=") { return OP_DOMAIN_INVALID; }
            if (self.referenceTypesCompatible(left, right)) {
                return OP_DOMAIN_REFERENCE;
            }
            return OP_DOMAIN_INVALID;
        }
        return OP_DOMAIN_INVALID;
    }

    public int hashDomain(Node? operand) {
        if (operand == null) { return HASH_DOMAIN_INVALID; }
        if (TypeComposition.isSemanticScalarString(operand)) { return HASH_DOMAIN_STRING; }
        if (NumericSemantics.isFloating(operand)) { return HASH_DOMAIN_FLOATING; }
        if (NumericSemantics.isType(operand, self.analyzed)) {
            return HASH_DOMAIN_INTEGRAL;
        }
        if (operand.base == "__fn_ptr") { return HASH_DOMAIN_INVALID; }
        if (self.isReferenceType(operand)) {
            return HASH_DOMAIN_REFERENCE;
        }
        return HASH_DOMAIN_INVALID;
    }

    /* One shared source of truth for overloadable binary operators.  Both semantic
     * validation and IR lowering consume this mapping. */
    public string binaryMethodName(string op) {
        if (op == "+") { return "__add__"; }
        if (op == "-") { return "__sub__"; }
        if (op == "*") { return "__mul__"; }
        if (op == "/") { return "__div__"; }
        if (op == "%") { return "__mod__"; }
        if (op == "==") { return "__eq__"; }
        if (op == "!=") { return "__ne__"; }
        if (op == "<") { return "__lt__"; }
        if (op == ">") { return "__gt__"; }
        if (op == "<=") { return "__le__"; }
        if (op == ">=") { return "__ge__"; }
        return "";
    }

    public Node? overloadReturnType(
            Node? receiverType, string op, bool unary) {
        if (receiverType == null) { return null; }
        string methodName = unary && op == "-"
            ? "__neg__" : self.binaryMethodName(op);
        if (methodName == "") { return null; }
        Node? method = null;
        if (self.analyzed.isClass(receiverType.base)) {
            method = self.analyzed.classMethod(receiverType.base, methodName);
        } else if (self.analyzed.isGenericClass(receiverType.base)) {
            method = self.analyzed.genericClassMethod(
                receiverType.base, methodName);
        }
        if (method == null || method.kind != NK_METHOD_DECL) { return null; }
        Node concreteMethod = method;
        if (receiverType.generic_args.len > 0
                && self.analyzed.isGenericClass(receiverType.base)) {
            return SemanticTypeSystem.resolveGenericType(concreteMethod.return_type,
                SemanticTypeSystem.genericTypeMap(self.analyzed, receiverType),
                self.analyzed);
        }
        return concreteMethod.return_type;
    }

    public bool isRawPointer(Node? typeExpr) {
        return typeExpr != null
            && (typeExpr.pointer_depth > 0 || typeExpr.is_array)
            && !self.analyzed.isClass(typeExpr.base)
            && !self.analyzed.isGenericClass(typeExpr.base);
    }

    public Node? pointerArithmeticType(
            Node? left, Node? right, string op) {
        if (op == "-" && self.isRawPointer(left)) {
            if (self.isRawPointer(right)) {
                return SemanticTypeSystem.primitive("long");
            }
            return left;
        }
        if (op == "+") {
            if (self.isRawPointer(left)) { return left; }
            if (self.isRawPointer(right)) { return right; }
        }
        return null;
    }

    private bool isOptionalValueExpression(Node? expression) {
        if (expression == null) { return false; }
        if (expression.kind == NK_FIELD_ACCESS_EXPR) {
            return expression.optional;
        }
        return expression.kind == NK_CALL_EXPR
            && expression.callee != null
            && expression.callee.kind == NK_FIELD_ACCESS_EXPR
            && expression.callee.optional;
    }

    /* `obj?.value ?? fallback` and `obj?.method() ?? fallback` are value-domain
     * coalesces, not null tests on their scalar results.  The optional expression
     * already carries the presence condition as structured IR; lowering replaces
     * only its absent value definition. */
    public bool isOptionalValueCoalesce(
            Node? leftExpression, Node? leftType, Node? rightType) {
        return self.isOptionalValueExpression(leftExpression)
            && NumericSemantics.isType(leftType, self.analyzed)
            && NumericSemantics.isType(rightType, self.analyzed);
    }
}
