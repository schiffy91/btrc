/* Per-compilation semantic-analysis composition root. */

import Library.Vector;

import ../generated/ast/Node.btrc;
import ../generated/hosted_abi/Tables.btrc;
import ../frontend/Models.btrc;
import ../frontend/Timing.btrc;
import ../parser/SourceMacros.btrc;
import ./Declarations.btrc;
import ./Expressions.btrc;
import ./Generics.btrc;
import ./GPU.btrc;
import ./HostedAbi.btrc;
import ./Models.btrc;
import ./Operators.btrc;
import ./ownership/Cycles.btrc;
import ./ownership/Values.btrc;
import ./Realtime.btrc;
import ./Types.btrc;
import ./validation/Names.btrc;
import ./validation/Validator.btrc;

class SemanticAnalyzer {
	private Analyzed analysis;
	private SemanticTypeSystem types;
	private DeclarationRegistry declarations;
	private OperatorSemantics operators;
	private ExpressionTypeResolver expressions;
	private GenericSpecializer generics;
	private GpuSemantics gpu;
	private ManagedValueSemantics managedValues;
	private CycleSemantics cycles;
	private SourceRuntimeSymbols sourceRuntimeSymbols;
	private IValidationRecords? validationRecords = null;
	/* The #define/#undef name rules conditioning shares (M1-M4). */
	private SourceMacroRules macroRules;

	/* `target` is the selected row, whose data model the analysis follows. */
	public SemanticAnalyzer(SourceRuntimeSymbols sourceRuntimeSymbols, SourceMacroRules macroRules, GeneratedTargetRow target) {
		self.analysis = Analyzed();
		self.analysis.longBits = target.sizeofLong * 8;
		self.sourceRuntimeSymbols = sourceRuntimeSymbols;
		self.macroRules = macroRules;
	}

	public Analyzed analyze(Node program, HostedAbiRepository hostedAbi) {
		self.types = SemanticTypeSystem(self.analysis);
		self.declarations = DeclarationRegistry(self.analysis, hostedAbi);
		self.operators = OperatorSemantics(self.analysis);
		self.expressions = ExpressionTypeResolver(self.analysis, hostedAbi, self.operators, self.types, self.declarations);
		self.generics = GenericSpecializer(self.analysis, self.operators, self.expressions, hostedAbi.genericArgumentNestingLimit());
		self.generics.useRecords(self.validationRecords);
		self.gpu = GpuSemantics(self.analysis, hostedAbi, self.expressions);
		self.managedValues = ManagedValueSemantics(self.analysis);
		self.cycles = CycleSemantics(self.analysis, self.managedValues);
		self.declarations.registerProgram(program);
		BtrccPhaseTimer.mark("a-register");
		self.expressions.inferGlobals(program);
		self.generics.discover(program);
		BtrccPhaseTimer.mark("a-generics");
		SemanticValidator validator = SemanticValidator(program, self.analysis, hostedAbi, self.macroRules, self.operators, self.gpu, self.cycles, self.sourceRuntimeSymbols, self.types, self.declarations, self.expressions);
		validator.useRecords(self.validationRecords);
		validator.validate();
		BtrccPhaseTimer.mark("a-validate");
		self.generics.closeExpressionGraph(program, hostedAbi);
		BtrccPhaseTimer.mark("a-close-generics");
		RealtimeAnalyzer realtime = RealtimeAnalyzer(program, self.analysis, hostedAbi, self.sourceRuntimeSymbols, self.expressions);
		realtime.useRecords(self.validationRecords);
		realtime.validate();
		validator.validateCompletedGeneratedSymbols();
		BtrccPhaseTimer.mark("a-realtime");
		/* The validator and realtime analyzer index most of the program. One
		 * compile is one process, and releasing those indices costs the ARC
		 * runtime a reverse-reachability proof per entry (minutes on a large
		 * program), so they are kept until the process exits. */
		keep validator;
		keep realtime;
		return self.analysis;
	}

	public OperatorSemantics operatorSemantics() { return self.operators; }

	public ExpressionTypeResolver expressionTypes() { return self.expressions; }

	public DeclarationRegistry declarationRegistry() { return self.declarations; }

	public void configureValidationRecords(IValidationRecords? records) { self.validationRecords = records; }

	public void configureNativeDeclarations(Vector<FeNativeImportedDeclaration> declarations) { self.analysis.setNativeDeclarations(declarations); }

	/* The frontend's strict-import marks of visible generic type-parameter names. */
	public void configureVisibleTypeParameters(Map<string, bool>? names) { self.analysis.visibleTypeParameters = names; }

	/* Record every line of a user source file that has a raw quoted include
	 * of an unmodeled C header or source. */
	public void configureUnmodeledIncludes(Node program, int stdlibLineCount, Vector<FeLine> userLines) {
		self.analysis.stdlibLineCount = stdlibLineCount;
		self.analysis.sourceLines = userLines;
		Map<string, bool> files = {};
		for declaration in program.declarations() {
			if (declaration.kind != NK_PREPROCESSOR_DIRECTIVE || !NameValidator.unmodeledInclude(declaration.text)) { continue; }
			int index = declaration.line - stdlibLineCount - 1;
			if (index >= 0 && index < userLines.len) { files.put(userLines.get(index).sourceFile, true); }
		}
		if (files.len == 0) { return; }
		for (int index = 0; index < userLines.len; index++) {
			if (files.has(userLines.get(index).sourceFile)) { self.analysis.unmodeledIncludeLines.put(stdlibLineCount + index + 1, true); }
		}
	}

	public ManagedValueSemantics managedValueSemantics() { return self.managedValues; }

	public GpuSemantics gpuSemantics() { return self.gpu; }

	public CycleSemantics cycleSemantics() { return self.cycles; }
}
