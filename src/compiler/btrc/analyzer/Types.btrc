/* Canonical semantic types, qualifiers, aliases, and storage shapes. */

import Library.Map;
import Library.Strings;
import Library.Vector;

import ../generated/ast/Node.btrc;
import ../frontend/Models.btrc;
import ../syntax/Identity.btrc;
import ../syntax/Literals.btrc;
#include <limits.h>
import ../syntax/Types.btrc;
import ./Models.btrc;

class SemanticTypeSystem {
	private Analyzed analyzed;

	public SemanticTypeSystem(Analyzed analyzed) { self.analyzed = analyzed; }

	public Node? canonical(Node? typeExpr) { return SemanticTypeSystem.resolveTypedefType(typeExpr, self.analyzed.typedefTable); }

	/* A plain source alias of its own declared C tag is a redeclaration. */
	class bool isIdentityTypedef(Node declaration, Analyzed analyzed) {
		if (declaration.kind != NK_TYPEDEF_DECL || analyzed.isNativeDeclaration(declaration)) { return false; }
		Node original = declaration.original;
		if (original.pointerDepth != 0 || original.isArray || original.arraySize != null || original.elements().len != 0 || original.arrayPointerDepth != 0 || original.genericArgs().len != 0 || original.isNullable || original.nullableOuterDepth != 0 || TypeIdentity.qualifierBits(original) != 0) { return false; }
		if (analyzed.structTable.has(declaration.alias)) {
			Node record = analyzed.structTable.get(declaration.alias);
			return !analyzed.isNativeDeclaration(record) && original.base == SemanticTypeSystem.recordKeyword(record) + " " + declaration.alias;
		}
		if (analyzed.enumTable.has(declaration.alias)) {
			return !analyzed.isNativeDeclaration(analyzed.enumTable.get(declaration.alias)) && original.base == "enum " + declaration.alias;
		}
		return false;
	}

	class Node? directFunctionPointer(Node? typeExpr, Analyzed analyzed) {
		Node? resolved = SemanticTypeSystem.resolveTypedefType(typeExpr, analyzed.typedefTable);
		if (resolved == null || (resolved.base != "__fn_ptr" && resolved.base != "__realtime_fn_ptr") || resolved.pointerDepth != 0 || resolved.isArray || resolved.genericArgs().len == 0) {
			return null;
		}
		return resolved;
	}

	class Node? directFunctionPointerSpecialization(Node? typeExpr, Analyzed analyzed) {
		Node? resolved = SemanticTypeSystem.resolveOuterTypedefType(typeExpr, analyzed.typedefTable);
		if (resolved == null || (resolved.base != "__fn_ptr" && resolved.base != "__realtime_fn_ptr") || resolved.pointerDepth != 0 || resolved.isArray || resolved.genericArgs().len == 0) {
			return null;
		}
		return resolved;
	}

	/* The signature a call through a value uses: a direct function pointer,
	 * or the nullable `CFunction<...>?` as the one plain C word it is. The
	 * nullable flow refuses the call unless it proved the value non-null.
	 * The reference compiler's TypeSystem.callable_signature. */
	class Node? callableSpecialization(Node? typeExpr, Analyzed analyzed) {
		Node? direct = SemanticTypeSystem.directFunctionPointerSpecialization(typeExpr, analyzed);
		if (direct != null) { return direct; }
		Node? resolved = SemanticTypeSystem.resolveOuterTypedefType(typeExpr, analyzed.typedefTable);
		if (resolved == null || (resolved.base != "__fn_ptr" && resolved.base != "__realtime_fn_ptr") || resolved.pointerDepth != 1 || resolved.isArray || resolved.genericArgs().len == 0 || !TypeComposition.nullableCollapsesReferenceLayer(resolved, true)) {
			return null;
		}
		Node plain = TypeShape.copy(resolved);
		plain.pointerDepth = 0;
		plain.isNullable = false;
		plain.nullableOuterDepth = 0;
		return plain;
	}

	class bool realtimeFunctionPointer(Node? typeExpr, Analyzed analyzed) {
		Node? resolved = SemanticTypeSystem.resolveTypedefType(typeExpr, analyzed.typedefTable);
		return resolved != null && resolved.base == "__realtime_fn_ptr" && resolved.pointerDepth == 0 && !resolved.isArray && resolved.genericArgs().len > 0;
	}

	class bool ownedClosureInvokeIsAdmissible(Node? typeExpr, Analyzed analyzed, Map<string, bool> activeTypeParameters) {
		Node? canonical = SemanticTypeSystem.resolveTypedefType(typeExpr, analyzed.typedefTable);
		if (canonical == null || canonical.base != "OwnedClosure" || canonical.genericArgs().len == 0) {
			return true;
		}
		Node? invokeType = SemanticTypeSystem.resolveTypedefType(canonical.genericArgs().get(0), analyzed.typedefTable);
		if (invokeType == null || activeTypeParameters.has(invokeType.base)) {
			return true;
		}
		return invokeType.base == "__fn_ptr" && invokeType.pointerDepth == 0 && !invokeType.isArray;
	}

	class Node namedClass(string name) {
		Node t = Node();
		t.kind = NK_TYPE_EXPR;
		t.base = name;
		return t;
	}

	/* Class instance type as the analyzer sees it: pointer_depth 1 (classes are
     * always heap-allocated). Mirrors _upgrade_class_type. Generic args / array /
     * nullable carry over; line/col are irrelevant for inference. */
	class Node classReference(Node? t) {
		if (t == null) { return SemanticTypeSystem.primitive("void"); }
		Node u = Node();
		u.kind = NK_TYPE_EXPR;
		u.base = t.base;
		u.genericArgsStorage = t.genericArgsStorage;
		u.pointerDepth = 1;
		u.isArray = t.isArray;
		u.isNullable = t.isNullable;
		u.nullableOuterDepth = t.nullableOuterDepth;
		return u;
	}

	/* Upgrade class-typed GENERIC ARGUMENTS in a TypeExpr IN PLACE so they become
     * pointers (mirrors the reference's _upgrade_class_type, which raises any
     * class_table base — regular OR generic — to pointer_depth 1, recursing through
     * generic args). After this runs, a `Vector<OwnedItem>`'s arg is `OwnedItem*`
     * and a `Vector<Vector<int>>`'s arg is `Vector<int>*`, so:
     *   - the mangled name carries the `_p1` suffix (`btrc_Vector_OwnedItem_p1`),
     *   - the per-instance type map resolves `T` to a pointer (so `T* data` -> `**`).
     * The OUTER class type is left at its source pointer_depth — CTypeLowerer applies the
     * class pointer lazily there; only nested args need the eager AST upgrade so the
     * mangled name and field types agree everywhere. */
	class void upgradeConcreteTypeGenericArgs(Node? t, Analyzed a) {
		Map<string, bool> unresolved = {};
		SemanticTypeSystem.upgradeTypeGenericArgs(t, a, unresolved);
	}

	class void upgradeTypeGenericArgs(Node? t, Analyzed a, Map<string, bool> unresolved) {
		if (t == null) { return; }
		int i = 0;
		while (i < t.genericArgs().len) {
			Node arg = t.genericArgs().get(i);
			/* Recurse into the arg's own generic args first. */
			SemanticTypeSystem.upgradeTypeGenericArgs(arg, a, unresolved);
			/* A class instance (regular or generic) is a heap pointer: a bare
             * (depth-0) class-typed arg gains one pointer level. A lexically
             * shadowing type parameter is never reinterpreted as a global class. */
			if (!unresolved.has(arg.base) && (a.isClass(arg.base) || a.isGenericClass(arg.base) || a.isInterface(arg.base)) && arg.pointerDepth == 0) {
				a.recordWrittenPointerDepth(arg);
				arg.pointerDepth = 1;
			}
			i = i + 1;
		}
	}

	/* --- small TypeExpr helpers --- */

	class Node primitive(string base) {
		Node t = Node();
		t.kind = NK_TYPE_EXPR;
		t.base = base;
		return t;
	}

	/* Supported unresolved C integer seam. Mirrors c_call_types.py exactly:
     * errno and all-uppercase identifiers (with digits/underscores allowed) are
     * treated as integer-valued C macros. At least one uppercase letter is needed,
     * matching Python str.isupper(). */
	class bool isCIntegerIdentifier(string name) {
		if (name == "errno") { return true; }
		if (name == "" || name == "NULL") { return false; }
		bool sawUpper = false;
		int index = 0;
		while (index < name.length()) {
			char value = name[index];
			if (value >= 'a' && value <= 'z') { return false; }
			if (value >= 'A' && value <= 'Z') { sawUpper = true; }
			index = index + 1;
		}
		return sawUpper;
	}

	/* Object-like C macros have no safe default ABI.  Keep them unresolved so a
     * typed use site can supply storage shape without silently narrowing through
     * the historical implicit-int seam. */
	class bool isCOpaqueValueIdentifier(string name) { return name != "errno" && SemanticTypeSystem.isCIntegerIdentifier(name); }

	/* True for the btrc `string` scalar (base "string", no generics, depth 0).
     * Mirrors types.is_string_type. */
	class bool isString(Node? t) { return TypeComposition.isSemanticScalarString(t); }

	/* Return type of a builtin string method (mirrors type_utils
     * ._string_method_return_type over the shared string_methods spec). Returns null
     * for an unknown method. `split` returns a `string*` (heap list of strings). */
	class Node? stringMethodResult(string method) {
		if (method == "len" || method == "byteLen" || method == "length" || method == "charLen" || method == "indexOf" || method == "lastIndexOf" || method == "find" || method == "count" || method == "toInt") {
			return SemanticTypeSystem.primitive("int");
		}
		if (method == "equals" || method == "contains" || method == "startsWith" || method == "endsWith" || method == "isEmpty" || method == "isBlank" || method == "isUpper" || method == "isLower" || method == "isAlnum" || method == "isDigit" || method == "isAlpha" || method == "toBool") {
			return SemanticTypeSystem.primitive("bool");
		}
		if (method == "charAt") { return SemanticTypeSystem.primitive("char"); }
		if (method == "toFloat") { return SemanticTypeSystem.primitive("float"); }
		if (method == "toDouble") { return SemanticTypeSystem.primitive("double"); }
		if (method == "toLong") { return SemanticTypeSystem.primitive("long"); }
		if (method == "trim" || method == "lstrip" || method == "rstrip" || method == "toUpper" || method == "toLower" || method == "substring" || method == "replace" || method == "repeat" || method == "reverse" || method == "capitalize" || method == "title" || method == "swapCase" || method == "padLeft" || method == "padRight" || method == "center" || method == "zfill" || method == "removePrefix" || method == "removeSuffix") {
			return SemanticTypeSystem.primitive("string");
		}
		if (method == "split") {
			Node t = Node();
			t.kind = NK_TYPE_EXPR;
			t.base = "string";
			t.pointerDepth = 1;
			return t;
		}
		return null;
	}

	class bool isComparisonOperator(string op) { return op == "==" || op == "!=" || op == "<" || op == ">" || op == "<=" || op == ">=" || op == "&&" || op == "||"; }


	/* Analyzer-owned types for C predefined source identifiers. */

	class Node? predefinedIdentifier(string name) {
		if (name == "__DATE__" || name == "__FILE__" || name == "__TIME__") {
			Node result = SemanticTypeSystem.primitive("char");
			result.pointerDepth = 1;
			result.isConst = true;
			return result;
		}
		if (name == "__STDC_VERSION__") { return SemanticTypeSystem.primitive("long"); }
		if (name == "__LINE__" || name == "__STDC__" || name == "__STDC_HOSTED__") {
			return SemanticTypeSystem.primitive("int");
		}
		return null;
	}


	/* Source string-method ownership policy shared by validation and lowering. */

	class bool stringResultIsTracked(string method) {
		if (method == "trim" || method == "lstrip" || method == "rstrip" || method == "toUpper" || method == "toLower" || method == "substring" || method == "replace" || method == "repeat" || method == "reverse" || method == "capitalize" || method == "title" || method == "swapCase" || method == "padLeft" || method == "padRight" || method == "center" || method == "zfill" || method == "removePrefix" || method == "removeSuffix") {
			return true;
		}
		return false;
	}


	/* Canonical analyzer query for the payload edge of a direct Mutex<T>. */

	class Node? mutexPayloadFor(Analyzed analyzed, Node? typeExpr) {
		if (typeExpr == null) { return null; }
		Node? resolved = SemanticTypeSystem.resolveTypedefType(typeExpr, analyzed.typedefTable);
		if (resolved == null || resolved.isArray || resolved.pointerDepth != 0 || resolved.base != "Mutex" || resolved.genericArgs().len != 1) {
			return null;
		}
		return resolved.genericArgs().get(0);
	}


	/* Complete-struct layout validation and dependency ordering. */

	class string resolvedStructName(Node? typeExpr, Analyzed analyzed) {
		if (typeExpr == null) { return ""; }
		Node resolved = typeExpr;
		Node? alias = SemanticTypeSystem.resolveTypedefType(typeExpr, analyzed.typedefTable);
		if (alias != null) { resolved = alias; }
		string explicitName = SemanticTypeSystem.recordTagName(resolved.base);
		if (explicitName != resolved.base) {
			if (analyzed.structTable.has(explicitName)) { return explicitName; }
			return "";
		}
		if (analyzed.structTable.has(resolved.base)) { return resolved.base; }
		return "";
	}

	/* Record members (C11 6.7.2.1). Every walk over a struct's or union's
	 * members goes through these class methods; the record-member contract
	 * test refuses a raw fields() walk anywhere else. A record without
	 * anonymous members or unnamed bit-fields answers with its own list. */

	/* Every member declarator of a record or anonymous member, in source
	 * order: named fields, unnamed bit-fields and anonymous members. Only
	 * layout (emission and its type dependencies) reads unnamed bit-fields;
	 * semantic walks read recordMembers or recordFields. */
	class Vector<Node> recordDeclarators(Node record) { return record.fields(); }

	/* The C keyword that declares record: `struct` or `union`. */
	class string recordKeyword(Node record) { return record.isUnion ? "union" : "struct"; }

	/* The keyword as a diagnostic's first word. */
	class string recordKeywordTitle(Node record) { return record.isUnion ? "Union" : "Struct"; }

	/* The record a by-value base names: `struct S` and `union U` name S and
	 * U. A canonical base already went through the tag alias rows; this
	 * reads one that may not have. */
	class string recordTagName(string base) {
		if (base.startsWith("struct ")) { return base.substring(7, base.length() - 7); }
		if (base.startsWith("union ")) { return base.substring(6, base.length() - 6); }
		return base;
	}

	class bool recordIsFlat(Node record) {
		for member in record.fields() {
			if (member.kind == NK_ANONYMOUS_MEMBER || member.name == "") { return false; }
		}
		return true;
	}

	/* The direct members, which are also the positional initializer slots:
	 * named FieldDefs and AnonymousMembers. An unnamed bit-field is not a
	 * member (C11 6.7.2.1p12). */
	class Vector<Node> recordMembers(Node record) {
		if (SemanticTypeSystem.recordIsFlat(record)) { return record.fields(); }
		Vector<Node> members = [];
		for member in record.fields() {
			if (member.kind == NK_ANONYMOUS_MEMBER || member.name != "") { members.push(member); }
		}
		return members;
	}

	/* Every named member's FieldDef, flattened through anonymous members
	 * (C11 6.7.2.1p13), in declaration order. */
	class Vector<Node> recordFields(Node record) {
		if (SemanticTypeSystem.recordIsFlat(record)) { return record.fields(); }
		Vector<Node> fields = [];
		SemanticTypeSystem.appendRecordFields(record, fields);
		return fields;
	}

	class void appendRecordFields(Node record, Vector<Node> out) {
		for member in record.fields() {
			if (member.kind == NK_ANONYMOUS_MEMBER) {
				SemanticTypeSystem.appendRecordFields(member, out);
			} else if (member.name != "") {
				out.push(member);
			}
		}
	}

	/* The member path of the named member fieldName: the anonymous members
	 * it is reached through, then the FieldDef itself; null when absent. */
	class Vector<Node>? recordMemberPath(Node record, string fieldName) {
		if (fieldName == "") { return null; }
		for member in record.fields() {
			if (member.kind == NK_ANONYMOUS_MEMBER) {
				Vector<Node>? nested = SemanticTypeSystem.recordMemberPath(member, fieldName);
				if (nested != null) {
					Vector<Node> path = [member];
					for step in nested { path.push(step); }
					return path;
				}
			} else if (member.name == fieldName) {
				Vector<Node> path = [member];
				return path;
			}
		}
		return null;
	}

	/* The named member fieldName, found through anonymous members too. */
	class Node? recordMember(Node record, string fieldName) {
		if (fieldName == "") { return null; }
		for member in record.fields() {
			if (member.kind == NK_ANONYMOUS_MEMBER) {
				Node? nested = SemanticTypeSystem.recordMember(member, fieldName);
				if (nested != null) { return nested; }
			} else if (member.name == fieldName) {
				return member;
			}
		}
		return null;
	}

	/* Whether a record member is declared `T name[]` (C11 6.7.2.1p18). P1
	 * refuses the `T[] name` spelling in record bodies, so an unsized array on
	 * a FieldDef's own type is always this declarator; a typedef never makes
	 * one. Placement is validated separately. */
	class bool flexibleArrayMember(Node member) { return member.kind == NK_FIELD_DEF && member.type != null && member.type.isArray && member.type.arraySize == null; }

	/* The flexible array member of a complete record, or null. */
	class Node? flexibleArrayField(Node? record) {
		if (record == null || record.isForward) { return null; }
		for field in SemanticTypeSystem.recordFields(record) {
			if (SemanticTypeSystem.flexibleArrayMember(field)) { return field; }
		}
		return null;
	}

	/* The struct with a flexible array member that typeExpr holds by value,
	 * directly or through a generic argument, or "". */
	class string flexibleArrayValueStruct(Node? typeExpr, Analyzed analyzed) {
		if (typeExpr == null) { return ""; }
		Node resolved = typeExpr;
		Node? alias = SemanticTypeSystem.resolveTypedefType(typeExpr, analyzed.typedefTable);
		if (alias != null) { resolved = alias; }
		if (resolved.pointerDepth == 0) {
			string name = SemanticTypeSystem.resolvedStructName(resolved, analyzed);
			if (name != "" && SemanticTypeSystem.flexibleArrayField(analyzed.structTable.get(name)) != null) { return name; }
		}
		for argument in resolved.genericArgs() {
			string found = SemanticTypeSystem.flexibleArrayValueStruct(argument, analyzed);
			if (found != "") { return found; }
		}
		return "";
	}

	/* The complete record a by-value member type names, for designator chains. */
	class Node? memberRecord(Node? memberType, Analyzed analyzed) {
		Node? resolved = SemanticTypeSystem.resolveTypedefType(memberType, analyzed.typedefTable);
		if (resolved == null || resolved.pointerDepth != 0 || resolved.isArray) { return null; }
		string name = SemanticTypeSystem.resolvedStructName(resolved, analyzed);
		if (name == "" || !analyzed.structTable.has(name)) { return null; }
		Node declaration = analyzed.structTable.get(name);
		if (declaration.isForward) { return null; }
		return declaration;
	}

	/* Map each brace element to a member path of record (C11 6.7.9p17).
	 * Positional elements fill the direct members in order (only the first
	 * member of a union); an anonymous member is one slot that takes its own
	 * braces, and unnamed bit-fields take none. A designated element names a
	 * flattened member, and its chain continues through nested records and
	 * array elements (the IndexDesignator itself is the step). A positional
	 * element after a designated one continues within that subobject before
	 * advancing to the enclosing record's next member. */
	class bool hasDesignators(Node initializer) {
		if (initializer.kind != NK_BRACE_INITIALIZER) { return false; }
		for entry in initializer.entries() { if (entry.parts().len > 0) { return true; } }
		return false;
	}

	class SemanticInitializerPlan planInitializerSlots(Node record, Node initializer, Analyzed analyzed) {
		if (record.kind == NK_TYPE_EXPR && record.isArray) { return SemanticTypeSystem.planArrayInitializerSlots(record, initializer, analyzed); }
		Vector<Node> members = SemanticTypeSystem.recordMembers(record);
		int capacity = members.len;
		if (record.isUnion && capacity > 1) { capacity = 1; }
		Vector<SemanticInitializerSlot> slots = [];
		int excess = 0;
		int cursor = 0;
		SemanticInitializerSlot? continuation = null;
		bool anonymousContinuation = false;
		Vector<SemanticInitializerProblem> problems = [];
		/* Only a brace initializer carries designations; a map literal's
		 * entries are its key/value pairs. */
		Vector<Node> designations = [];
		if (initializer.kind == NK_BRACE_INITIALIZER) { designations = initializer.entries(); }
		int position = 0;
		while (position < initializer.elements().len) {
			Node element = initializer.elements().get(position);
			bool designated = position < designations.len && designations.get(position).parts().len > 0;
			if (designated) {
				int before = problems.len;
				SemanticInitializerSlot? slot = SemanticTypeSystem.designatedSlot(record, element, designations.get(position).parts(), analyzed, problems);
				if (slot == null) {
					if (problems.len == before) { excess = excess + 1; }
				} else {
					SemanticTypeSystem.checkInitializerSlot(record, slot, slots, problems, analyzed);
					slots.push(slot);
					cursor = SemanticTypeSystem.memberPosition(members, slot.path.get(0)) + 1;
					continuation = SemanticTypeSystem.nextNestedInitializerSlot(record, slot, analyzed);
					anonymousContinuation = false;
					for step in slot.path {
						if (step.kind == NK_ANONYMOUS_MEMBER) { anonymousContinuation = true; }
					}
				}
			} else if (anonymousContinuation) {
				problems.push(SemanticInitializerProblem("A positional initializer cannot follow a designator into an anonymous member; designate the next member", element));
			} else if (continuation == null && cursor >= capacity) {
				excess = excess + 1;
			} else {
				Vector<Node> path = [];
				Node? slotType = null;
				if (continuation != null) {
					path = continuation.path;
					slotType = continuation.type;
				} else {
					Node member = members.get(cursor);
					cursor++;
					path.push(member);
					if (member.kind != NK_ANONYMOUS_MEMBER) { slotType = member.type; }
				}
				SemanticInitializerSlot slot = SemanticInitializerSlot(element, path, slotType);
				slot.site = element;
				continuation = SemanticTypeSystem.nextNestedInitializerSlot(record, slot, analyzed);
				SemanticTypeSystem.checkInitializerSlot(record, slot, slots, problems, analyzed);
				slots.push(slot);
			}
			position = position + 1;
		}
		SemanticInitializerPlan plan = SemanticInitializerPlan(slots, capacity, excess, record);
		plan.problems = problems;
		return plan;
	}

	class SemanticInitializerPlan planArrayInitializerSlots(Node target, Node initializer, Analyzed analyzed) {
		Node canonical = target;
		Node? resolved = SemanticTypeSystem.resolveTypedefType(target, analyzed.typedefTable);
		if (resolved != null) { canonical = resolved; }
		long long bound = SemanticTypeSystem.initializerArrayBound(canonical, analyzed);
		Vector<SemanticInitializerSlot> slots = [];
		Vector<SemanticInitializerProblem> problems = [];
		unsigned long long cursor = 0ULL;
		unsigned long long extent = 0ULL;
		SemanticInitializerSlot? continuation = null;
		int position = 0;
		for element in initializer.elements() {
			Vector<Node> parts = [];
			if (initializer.kind == NK_BRACE_INITIALIZER && position < initializer.entries().len) { parts = initializer.entries().get(position).parts(); }
			position++;
			SemanticInitializerSlot? slot = null;
			if (parts.len > 0) {
				slot = SemanticTypeSystem.designatedSlot(target, element, parts, analyzed, problems);
				if (slot == null) { continue; }
				cursor = (unsigned long long)SemanticTypeSystem.initializerIndexValue(slot.path.get(0), analyzed) + 1ULL;
			} else if (continuation != null) {
				slot = SemanticInitializerSlot(element, continuation.path, continuation.type);
				slot.site = element;
			} else {
				if (cursor > (unsigned long long)LLONG_MAX || (bound >= 0LL && cursor >= (unsigned long long)bound)) {
					string name = SemanticTypeSystem.initializerStorageName(canonical, analyzed);
					problems.push(SemanticInitializerProblem(f"Initializer element for index {cursor} is outside '{name}'", element));
					cursor++;
					continue;
				}
				Node literal = Node();
				literal.kind = NK_INT_LITERAL;
				literal.raw = f"{cursor}";
				Node step = Node();
				step.kind = NK_INDEX_DESIGNATOR;
				step.index = literal;
				step.line = element.line;
				step.col = element.col;
				Vector<Node> path = [step];
				slot = SemanticInitializerSlot(element, path, TypeShape.withoutOuterArray(canonical));
				slot.site = element;
				cursor++;
			}
			SemanticTypeSystem.checkInitializerSlot(target, slot, slots, problems, analyzed);
			slots.push(slot);
			if (cursor > extent) { extent = cursor; }
			continuation = SemanticTypeSystem.nextNestedInitializerSlot(target, slot, analyzed);
		}
		SemanticInitializerPlan plan = SemanticInitializerPlan(slots, 0, 0, target);
		plan.extent = extent;
		plan.problems = problems;
		return plan;
	}

	/* The outer cursor belongs to the caller. Resume inside nested subobjects,
	 * climbing exhausted arrays and records. A union has no following member;
	 * an aggregate sibling remains one slot requiring its own braces. */
	class SemanticInitializerSlot? nextNestedInitializerSlot(Node target, SemanticInitializerSlot slot, Analyzed analyzed) {
		if (slot.path.len < 2) { return null; }
		Vector<Node> parents = [];
		Node current = target;
		for step in slot.path {
			parents.push(current);
			if (step.kind == NK_INDEX_DESIGNATOR) {
				Node canonical = current;
				Node? resolved = SemanticTypeSystem.resolveTypedefType(current, analyzed.typedefTable);
				if (resolved != null) { canonical = resolved; }
				current = TypeShape.withoutOuterArray(canonical);
			} else if (step.kind == NK_ANONYMOUS_MEMBER) {
				current = step;
			} else {
				Node? fieldType = step.type;
				if (fieldType == null) { return null; }
				current = fieldType;
			}
		}
		int depth = slot.path.len - 1;
		while (depth > 0) {
			Node parent = parents.get(depth);
			Node step = slot.path.get(depth);
			Node? member = null;
			Node? memberType = null;
			if (step.kind == NK_INDEX_DESIGNATOR) {
				Node canonical = parent;
				Node? resolved = SemanticTypeSystem.resolveTypedefType(parent, analyzed.typedefTable);
				if (resolved != null) { canonical = resolved; }
				long long previous = SemanticTypeSystem.initializerIndexValue(step, analyzed);
				long long bound = SemanticTypeSystem.initializerArrayBound(canonical, analyzed);
				if (previous < LLONG_MAX && (bound < 0LL || previous + 1LL < bound)) {
					Node literal = Node();
					literal.kind = NK_INT_LITERAL;
					literal.raw = f"{previous + 1LL}";
					Node nextStep = Node();
					nextStep.kind = NK_INDEX_DESIGNATOR;
					nextStep.index = literal;
					nextStep.line = step.line;
					nextStep.col = step.col;
					member = nextStep;
					memberType = TypeShape.withoutOuterArray(canonical);
				}
			} else {
				Node? record = parent.kind == NK_TYPE_EXPR ? SemanticTypeSystem.memberRecord(parent, analyzed) : parent;
				if (record != null && !record.isUnion) {
					Vector<Node> members = SemanticTypeSystem.recordMembers(record);
					int index = SemanticTypeSystem.memberPosition(members, step) + 1;
					if (index < members.len) {
						Node nextMember = members.get(index);
						member = nextMember;
						if (nextMember.kind != NK_ANONYMOUS_MEMBER) { memberType = nextMember.type; }
					}
				}
			}
			if (member != null) {
				Vector<Node> path = [];
				int index = 0;
				while (index < depth) { path.push(slot.path.get(index)); index++; }
				path.push(member);
				SemanticInitializerSlot next = SemanticInitializerSlot(slot.element, path, memberType);
				next.site = slot.site;
				return next;
			}
			depth--;
		}
		return null;
	}

	/* Source indexes have analyzed facts; positional steps carry a synthesized literal. */
	class bool hasInitializerIndexValue(Node step, Analyzed analyzed) { return analyzed.designatorIndexValues.has(AstIdentity.key(step)) || (step.index != null && step.index.kind == NK_INT_LITERAL); }

	class long long initializerIndexValue(Node step, Analyzed analyzed) {
		string key = AstIdentity.key(step);
		if (analyzed.designatorIndexValues.has(key)) { return analyzed.designatorIndexValues.get(key); }
		return (long long)IntegerLiteral(step.index.raw).details().magnitude;
	}

	class void checkInitializerSlot(Node record, SemanticInitializerSlot slot, Vector<SemanticInitializerSlot> previous, Vector<SemanticInitializerProblem> problems, Analyzed analyzed) {
		for earlier in previous {
			string conflict = SemanticTypeSystem.initializerPathConflict(record, earlier, slot, analyzed);
			if (!conflict.isEmpty()) {
				Node site = slot.element;
				if (slot.site != null) { site = slot.site; }
				problems.push(SemanticInitializerProblem(conflict, site));
				break;
			}
		}
	}

	class string initializerPathConflict(Node record, SemanticInitializerSlot previous, SemanticInitializerSlot current, Analyzed analyzed) {
		bool arrayTarget = record.kind == NK_TYPE_EXPR && record.isArray;
		Node? parentRecord = arrayTarget ? null : record;
		Node? parentType = arrayTarget ? record : null;
		int index = 0;
		while (index < previous.path.len && index < current.path.len) {
			Node left = previous.path.get(index);
			Node right = current.path.get(index);
			bool same = SemanticTypeSystem.sameNode(left, right);
			if (left.kind == NK_INDEX_DESIGNATOR && right.kind == NK_INDEX_DESIGNATOR) {
				same = SemanticTypeSystem.hasInitializerIndexValue(left, analyzed) && SemanticTypeSystem.hasInitializerIndexValue(right, analyzed) && SemanticTypeSystem.initializerIndexValue(left, analyzed) == SemanticTypeSystem.initializerIndexValue(right, analyzed);
			}
			if (!same) {
				if (parentRecord == null || !parentRecord.isUnion) { return ""; }
				string leftName = SemanticTypeSystem.initializerMemberName(previous, index);
				string rightName = SemanticTypeSystem.initializerMemberName(current, index);
				string name = parentRecord.name.isEmpty() ? record.name : parentRecord.name;
				return "Union '" + name + "' initializer sets both '" + leftName + "' and '" + rightName + "'; a union initializer sets one member";
			}
			if (left.kind == NK_ANONYMOUS_MEMBER) {
				parentRecord = left;
				parentType = null;
			} else if (left.kind == NK_INDEX_DESIGNATOR) {
				if (parentType == null) { return ""; }
				parentType = TypeShape.withoutOuterArray(parentType);
				parentRecord = SemanticTypeSystem.memberRecord(parentType, analyzed);
			} else {
				parentType = SemanticTypeSystem.resolveTypedefType(left.type, analyzed.typedefTable);
				parentRecord = SemanticTypeSystem.memberRecord(parentType, analyzed);
			}
			index++;
		}
		if (arrayTarget) {
			Node first = previous.site == null ? previous.element : previous.site;
			long long value = SemanticTypeSystem.initializerIndexValue(current.path.get(0), analyzed);
			string name = SemanticTypeSystem.initializerStorageName(record, analyzed);
			return f"Index {value} of '{name}' is initialized more than once (first at {first.line}:{first.col}); each element may be initialized once";
		}
		string member = "";
		for step in previous.path {
			if (step.kind == NK_FIELD_DEF) { member = step.name; break; }
		}
		if (member.isEmpty()) {
			for step in current.path {
				if (step.kind == NK_FIELD_DEF) { member = step.name; break; }
			}
		}
		Node first = previous.element;
		if (previous.site != null) { first = previous.site; }
		return "Field '" + member + "' of " + SemanticTypeSystem.recordKeyword(record) + " '" + record.name + "' is initialized more than once (first at " + Strings.fromInt(first.line) + ":" + Strings.fromInt(first.col) + "); each member may be initialized once";
	}

	class string initializerMemberName(SemanticInitializerSlot slot, int depth) {
		Node step = slot.path.get(depth);
		if (step.kind != NK_ANONYMOUS_MEMBER) { return step.name; }
		int index = depth + 1;
		while (index < slot.path.len) {
			Node nested = slot.path.get(index);
			if (nested.kind == NK_FIELD_DEF) { return nested.name; }
			index++;
		}
		return "anonymous " + SemanticTypeSystem.recordKeyword(step);
	}

	class bool sameNode(Node left, Node right) { return (uintptr_t)left == (uintptr_t)right; }

	/* The direct members a static initializer list zero-fills: those after the
	 * plan's last initialized slot. A union's initializer names exactly one
	 * member, so it fills none (a second element would be excess). */
	class Vector<Node> zeroFilledMembers(Node record, SemanticInitializerPlan plan) {
		Vector<Node> filled = [];
		if (record.isUnion) { return filled; }
		Vector<Node> members = SemanticTypeSystem.recordMembers(record);
		int next = 0;
		for slot in plan.slots {
			int position = SemanticTypeSystem.memberPosition(members, slot.path.get(0)) + 1;
			if (position > next) { next = position; }
		}
		while (next < members.len) {
			filled.push(members.get(next));
			next = next + 1;
		}
		return filled;
	}

	class int memberPosition(Vector<Node> members, Node member) {
		int index = 0;
		while (index < members.len) {
			if (SemanticTypeSystem.sameNode(members.get(index), member)) { return index; }
			index = index + 1;
		}
		return -1;
	}

	class SemanticInitializerSlot? designatedSlot(Node record, Node element, Vector<Node> parts, Analyzed analyzed, Vector<SemanticInitializerProblem> problems) {
		Node? currentRecord = record.kind == NK_TYPE_EXPR ? null : record;
		Node? slotType = record.kind == NK_TYPE_EXPR ? record : SemanticTypeSystem.primitive(record.name);
		Vector<Node> steps = [];
		for part in parts {
			if (part.kind == NK_FIELD_DESIGNATOR) {
				Node? nested = currentRecord == null ? SemanticTypeSystem.memberRecord(slotType, analyzed) : currentRecord;
				if (nested == null) {
					string name = SemanticTypeSystem.initializerStorageName(slotType, analyzed);
					problems.push(SemanticInitializerProblem("Designator '." + part.field + "' needs a struct or union, but the initialized type is '" + name + "'", part));
					return null;
				}
				Vector<Node>? path = SemanticTypeSystem.recordMemberPath(nested, part.field);
				if (path == null) {
					string kind = nested.isUnion ? "Union" : "Struct";
					problems.push(SemanticInitializerProblem(kind + " '" + nested.name + "' has no field '" + part.field + "'", part));
					return null;
				}
				for step in path { steps.push(step); }
				slotType = steps.get(steps.len - 1).type;
			} else {
				if (!SemanticTypeSystem.hasInitializerIndexValue(part, analyzed)) { return null; }
				long long value = SemanticTypeSystem.initializerIndexValue(part, analyzed);
				if (slotType == null || !slotType.isArray) {
					string name = SemanticTypeSystem.initializerStorageName(slotType, analyzed);
					problems.push(SemanticInitializerProblem(f"Designator '[{value}]' needs an array, but the initialized type is '{name}'", part));
					return null;
				}
				Node? canonical = SemanticTypeSystem.resolveTypedefType(slotType, analyzed.typedefTable);
				if (canonical == null || !canonical.isArray) { return null; }
				long long bound = SemanticTypeSystem.initializerArrayBound(canonical, analyzed);
				if (value < 0LL || (bound >= 0LL && value >= bound)) {
					string name = SemanticTypeSystem.initializerStorageName(canonical, analyzed);
					problems.push(SemanticInitializerProblem(f"Array designator index {value} is outside '{name}'", part));
					return null;
				}
				steps.push(part);
				slotType = TypeShape.withoutOuterArray(canonical);
			}
			currentRecord = null;
		}
		SemanticInitializerSlot slot = SemanticInitializerSlot(element, steps, slotType);
		slot.site = parts.get(0);
		return slot;
	}

	/* Analyzed bounds retain their full width; native literals need no evaluator.
	 * Negative one denotes an unknown bound, never a valid array extent. */
	class long long initializerArrayBound(Node typeExpr, Analyzed analyzed) {
		Node? bound = typeExpr.arraySize;
		if (bound == null) { return -1LL; }
		string key = AstIdentity.key(bound);
		if (analyzed.arrayBoundValues.has(key)) { return analyzed.arrayBoundValues.get(key); }
		if (bound.kind == NK_INT_LITERAL) {
			IntegerLiteralInfo literal = IntegerLiteral(bound.raw).details();
			if (literal.valid && literal.magnitude <= (unsigned long long)LLONG_MAX) { return (long long)literal.magnitude; }
		}
		return -1LL;
	}

	class string initializerStorageName(Node? typeExpr, Analyzed analyzed) {
		if (typeExpr == null) { return "<unknown>"; }
		string name = SemanticTypeSystem.recordTagName(typeExpr.base);
		if (typeExpr.genericArgs().len > 0) {
			Vector<string> arguments = [];
			for argument in typeExpr.genericArgs() { arguments.push(SemanticTypeSystem.initializerStorageName(argument, analyzed)); }
			name = name + "<" + Strings.join(arguments, ", ") + ">";
		}
		int pointer = 0;
		while (pointer < typeExpr.pointerDepth) { name = name + "*"; pointer++; }
		if (typeExpr.isArray) {
			long long bound = SemanticTypeSystem.initializerArrayBound(typeExpr, analyzed);
			name = name + "[" + (bound >= 0LL ? f"{bound}" : "") + "]";
		}
		return name;
	}

	/* The slot type of element in plan; null when the element found no slot
	 * or initializes an anonymous member. */
	class Node? initializerSlotType(SemanticInitializerPlan plan, Node element) {
		for slot in plan.slots {
			if (SemanticTypeSystem.sameNode(slot.element, element)) { return slot.type; }
		}
		return null;
	}

	/* The validator's recorded plan for initializer; an initializer validation
	 * never typed as this record (a generic body's T x = {...}, a replayed
	 * module-unit record) is planned again here, identically. */
	class SemanticInitializerPlan initializerSlots(Node record, Node initializer, Analyzed analyzed) {
		string key = AstIdentity.key(initializer);
		if (analyzed.initializerPlans.has(key)) {
			SemanticInitializerPlan plan = analyzed.initializerPlans.get(key);
			Node? cached = plan.record;
			if (cached != null) {
				if (SemanticTypeSystem.sameNode(cached, record)) { return plan; }
				bool sameBound = cached.arraySize == null && record.arraySize == null;
				if (cached.arraySize != null && record.arraySize != null) { sameBound = SemanticTypeSystem.sameNode(cached.arraySize, record.arraySize); }
				if (record.kind == NK_TYPE_EXPR && cached.kind == NK_TYPE_EXPR && sameBound && TypeIdentity.shapeKey(cached) == TypeIdentity.shapeKey(record)) { return plan; }
			}
		}
		return SemanticTypeSystem.planInitializerSlots(record, initializer, analyzed);
	}

	/* Typed leaves in evaluation order, with anonymous brace slots expanded. */
	class Vector<SemanticInitializerSlot> initializerLeafSlots(Node record, Node initializer, Analyzed analyzed, Vector<SemanticInitializerProblem>? problems = null) {
		Vector<SemanticInitializerSlot> result = [];
		SemanticInitializerPlan plan = SemanticTypeSystem.initializerSlots(record, initializer, analyzed);
		if (problems != null) {
			for problem in plan.problems { problems.push(problem); }
			if (plan.excess > 0) { problems.push(SemanticInitializerProblem("Initializer has more elements than the concrete target has fields", initializer)); }
		}
		for slot in plan.slots {
			if (slot.member().kind == NK_ANONYMOUS_MEMBER && slot.element.kind == NK_BRACE_INITIALIZER) {
				for nested in SemanticTypeSystem.initializerLeafSlots(slot.member(), slot.element, analyzed, problems) {
					Vector<Node> path = [];
					for step in slot.path { path.push(step); }
					for step in nested.path { path.push(step); }
					result.push(SemanticInitializerSlot(nested.element, path, nested.type));
				}
			} else {
				result.push(slot);
			}
		}
		return result;
	}

	class Node? structFieldFor(Node? typeExpr, string fieldName, Analyzed analyzed) {
		string name = SemanticTypeSystem.resolvedStructName(typeExpr, analyzed);
		if (name == "" || !analyzed.structTable.has(name)) { return null; }
		Node declaration = analyzed.structTable.get(name);
		if (declaration.isForward) { return null; }
		Node? field = SemanticTypeSystem.recordMember(declaration, fieldName);
		if (field == null) { return null; }
		return field.type;
	}


	/* Canonical user-typedef expansion shared by analysis and IR generation.
     * Source declarations still emit their aliases; inferred expression types use
     * the underlying shape so operators, members, calls, and generic arguments all
     * see one semantic type domain. */

	class void typedefSemanticFail(string message, Node site) { FeDiagnosticSources.fail(message, site.line, site.col); }

	class Node composeTypedefType(Node useType, Node originalType) {
		if (useType.isArray && originalType.isArray) {
			SemanticTypeSystem.typedefSemanticFail("Nested array composition through typedef is not supported", useType);
		}
		return TypeComposition.compose(useType, originalType, TypeComposition.resolvedReferenceShape(originalType));
	}

	/* Resolve only the alias naming the represented value. Generic arguments keep
     * their source spelling because they also identify emitted monomorphizations:
     * Box<Text> and Box<string> may share a C-compatible payload, but they have
     * distinct generated symbols when both are requested by the source program. */
	class Node? resolveOuterTypedefTypeInner(Node? typeExpr, Map<string, Node> typedefs, Map<string, bool> visited, Node site) {
		if (typeExpr == null) { return null; }
		Node current = typeExpr;
		if (current.genericArgs().len > 0 || !typedefs.has(current.base)) {
			return current;
		}
		if (visited.has(current.base)) {
			SemanticTypeSystem.typedefSemanticFail("Cyclic typedef involving '" + current.base + "'", site);
		}
		visited.put(current.base, true);
		Node? resolved = SemanticTypeSystem.resolveOuterTypedefTypeInner(typedefs.get(current.base), typedefs, visited, site);
		if (resolved == null) {
			SemanticTypeSystem.typedefSemanticFail("Invalid null typedef target", site);
		}
		Node target = resolved;
		return SemanticTypeSystem.composeTypedefType(current, target);
	}

	class Node? resolveOuterTypedefType(Node? typeExpr, Map<string, Node> typedefs) {
		if (typeExpr == null) { return null; }
		/* Most queries name no typedef; answer them without building a visit set. */
		if (typeExpr.genericArgs().len > 0 || !typedefs.has(typeExpr.base)) { return typeExpr; }
		Map<string, bool> visited = {};
		return SemanticTypeSystem.resolveOuterTypedefTypeInner(typeExpr, typedefs, visited, typeExpr);
	}

	/* Remove one represented pointer/array layer while retaining the alias that
     * names the resulting element.  Canonical expansion is appropriate for
     * deciding whether a value is indexable/dereferenceable, but returning the
     * flattened element would lose qualifier placement carried by an inner
     * typedef (for example P -> V* -> volatile int*). */
	class Node? typeWithoutOuterStorageThroughTypedefInner(Node? typeExpr, Map<string, Node> typedefs, Map<string, bool> visiting) {
		if (typeExpr == null) { return null; }
		if (typeExpr.isArray) {
			return TypeShape.withoutOuterArray(typeExpr);
		}
		if (typeExpr.pointerDepth > 0) {
			return TypeShape.withoutOuterPointers(typeExpr, 1);
		}
		if (typeExpr.genericArgs().len > 0 || !typedefs.has(typeExpr.base) || visiting.has(typeExpr.base)) {
			return null;
		}
		visiting.put(typeExpr.base, true);
		Node? result = SemanticTypeSystem.typeWithoutOuterStorageThroughTypedefInner(typedefs.get(typeExpr.base), typedefs, visiting);
		visiting.remove(typeExpr.base);
		return result;
	}

	class Node? typeWithoutOuterStorageThroughTypedef(Node? typeExpr, Map<string, Node> typedefs) {
		Map<string, bool> visiting = {};
		return SemanticTypeSystem.typeWithoutOuterStorageThroughTypedefInner(typeExpr, typedefs, visiting);
	}

	class Node? resolveTypedefType(Node? typeExpr, Map<string, Node> typedefs) {
		Node? outer = SemanticTypeSystem.resolveOuterTypedefType(typeExpr, typedefs);
		if (outer == null) { return null; }
		Node current = outer;
		if (current.genericArgs().len == 0) { return current; }
		Vector<Node> args = [];
		bool changed = false;
		int index = 0;
		while (index < current.genericArgs().len) {
			Node argument = current.genericArgs().get(index);
			Node? resolved = SemanticTypeSystem.resolveTypedefType(argument, typedefs);
			if (resolved == null) {
				SemanticTypeSystem.typedefSemanticFail("Invalid null generic type", typeExpr != null ? typeExpr : current);
			}
			Node concrete = resolved;
			if (concrete != argument) { changed = true; }
			args.push(concrete);
			index = index + 1;
		}
		/* No argument named a typedef: the type is already its own resolution. */
		if (!changed) { return current; }
		return TypeShape.copyWithArguments(current, args);
	}


	/* Declarator-aware const/volatile provenance through typedef boundaries.
     * Depth zero is the declared object; depth one is reached through one
     * pointer/array layer.  Keeping this query separate from alias flattening
     * prevents `typedef volatile int V; V*` from becoming a volatile pointer. */

	class int qualifierAppliedStorageLayers(Node typeExpr, Node? target) {
		bool referenceShape = target != null && TypeComposition.resolvedReferenceShape(target);
		int pointerDepth = typeExpr.pointerDepth;
		if (TypeComposition.nullableCollapsesReferenceLayer(typeExpr, referenceShape)) {
			pointerDepth = pointerDepth - 1;
		}
		return pointerDepth + (typeExpr.isArray ? 1 : 0);
	}

	class bool typeVolatileAtDepthInner(Node? typeExpr, Map<string, Node> typedefs, int depth, Map<string, bool> visiting) {
		if (typeExpr == null || depth < 0) { return false; }
		int directDepth = typeExpr.isArray ? 1 : 0;
		if (typeExpr.isVolatile && depth == directDepth) { return true; }
		if (typeExpr.genericArgs().len > 0 || !typedefs.has(typeExpr.base) || visiting.has(typeExpr.base)) {
			return false;
		}
		visiting.put(typeExpr.base, true);
		Node target = typedefs.get(typeExpr.base);
		int shift = SemanticTypeSystem.qualifierAppliedStorageLayers(typeExpr, target);
		bool result = SemanticTypeSystem.typeVolatileAtDepthInner(target, typedefs, depth - shift, visiting);
		visiting.remove(typeExpr.base);
		return result;
	}

	class bool typeVolatileAtDepth(Node? typeExpr, Map<string, Node> typedefs, int depth) {
		Map<string, bool> visiting = {};
		return SemanticTypeSystem.typeVolatileAtDepthInner(typeExpr, typedefs, depth, visiting);
	}

	class bool typeConstAtDepthInner(Node? typeExpr, Map<string, Node> typedefs, int depth, Map<string, bool> visiting) {
		if (typeExpr == null || depth < 0) { return false; }
		Node? target = null;
		if (typeExpr.genericArgs().len == 0 && typedefs.has(typeExpr.base) && !visiting.has(typeExpr.base)) {
			target = typedefs.get(typeExpr.base);
		}
		int shift = SemanticTypeSystem.qualifierAppliedStorageLayers(typeExpr, target);
		int implicitDepth = 0;
		if (target == null && (typeExpr.base == "string" || typeExpr.base == "Thread" || typeExpr.base == "Mutex")) {
			implicitDepth = 1;
		}
		if (typeExpr.isConst && depth == shift + implicitDepth) {
			return true;
		}
		if (target == null) { return false; }
		visiting.put(typeExpr.base, true);
		bool result = SemanticTypeSystem.typeConstAtDepthInner(target, typedefs, depth - shift, visiting);
		visiting.remove(typeExpr.base);
		return result;
	}

	class bool typeConstAtDepth(Node? typeExpr, Map<string, Node> typedefs, int depth) {
		Map<string, bool> visiting = {};
		return SemanticTypeSystem.typeConstAtDepthInner(typeExpr, typedefs, depth, visiting);
	}

	class bool typeEffectiveOuterVolatile(Node? typeExpr, Map<string, Node> typedefs) {
		if (typeExpr == null) { return false; }
		if (typeExpr.isVolatile) { return true; }
		if (typeExpr.genericArgs().len > 0 || !typedefs.has(typeExpr.base)) {
			return false;
		}
		Node target = typedefs.get(typeExpr.base);
		bool referenceShape = TypeComposition.resolvedReferenceShape(target);
		int pointerDepth = typeExpr.pointerDepth;
		if (TypeComposition.nullableCollapsesReferenceLayer(typeExpr, referenceShape)) {
			pointerDepth = pointerDepth - 1;
		}
		if (pointerDepth > 0) { return false; }
		Map<string, bool> visiting = {};
		return SemanticTypeSystem.typeEffectiveOuterVolatileInner(target, typedefs, visiting);
	}

	class bool typeEffectiveOuterVolatileInner(Node? typeExpr, Map<string, Node> typedefs, Map<string, bool> visiting) {
		if (typeExpr == null) { return false; }
		if (typeExpr.isVolatile) { return true; }
		if (typeExpr.genericArgs().len > 0 || !typedefs.has(typeExpr.base) || visiting.has(typeExpr.base)) {
			return false;
		}
		visiting.put(typeExpr.base, true);
		Node target = typedefs.get(typeExpr.base);
		bool referenceShape = TypeComposition.resolvedReferenceShape(target);
		int pointerDepth = typeExpr.pointerDepth;
		if (TypeComposition.nullableCollapsesReferenceLayer(typeExpr, referenceShape)) {
			pointerDepth = pointerDepth - 1;
		}
		bool result = false;
		if (pointerDepth == 0) {
			result = SemanticTypeSystem.typeEffectiveOuterVolatileInner(target, typedefs, visiting);
		}
		visiting.remove(typeExpr.base);
		return result;
	}

	class bool typeEffectiveOuterConst(Node? typeExpr, Map<string, Node> typedefs) { return SemanticTypeSystem.typeConstAtDepth(typeExpr, typedefs, 0); }

	class int typeVolatileMaxDepthInner(Node? typeExpr, Map<string, Node> typedefs, Map<string, bool> visiting) {
		if (typeExpr == null) { return -1; }
		int result = -1;
		if (typeExpr.isVolatile) {
			result = typeExpr.isArray ? 1 : 0;
		}
		if (typeExpr.genericArgs().len > 0 || !typedefs.has(typeExpr.base) || visiting.has(typeExpr.base)) {
			return result;
		}
		visiting.put(typeExpr.base, true);
		Node target = typedefs.get(typeExpr.base);
		int nested = SemanticTypeSystem.typeVolatileMaxDepthInner(target, typedefs, visiting);
		visiting.remove(typeExpr.base);
		if (nested < 0) { return result; }
		int inherited = SemanticTypeSystem.qualifierAppliedStorageLayers(typeExpr, target) + nested;
		if (inherited > result) { return inherited; }
		return result;
	}

	class int typeVolatileMaxDepth(Node? typeExpr, Map<string, Node> typedefs) {
		Map<string, bool> visiting = {};
		return SemanticTypeSystem.typeVolatileMaxDepthInner(typeExpr, typedefs, visiting);
	}


	/* Generic type composition is a type-system operation. Discovery owns
     * which specializations exist; it does not own the meaning of applying a
     * substitution to a type shape. */

	class bool genericSubstitutionReferenceShape(Node typeExpr, Analyzed analyzed) { return TypeComposition.resolvedReferenceShape(typeExpr) || analyzed.isClass(typeExpr.base) || analyzed.isGenericClass(typeExpr.base) || analyzed.isInterface(typeExpr.base); }

	class Node resolveGenericType(Node? typeExpr, Map<string, Node> substitutions, Analyzed analyzed) {
		if (typeExpr == null) {
			return SemanticTypeSystem.primitive("void");
		}
		if (substitutions.has(typeExpr.base) && typeExpr.genericArgs().len == 0) {
			Node resolved = substitutions.get(typeExpr.base);
			Node referenceShape = resolved;
			Node? canonical = SemanticTypeSystem.resolveOuterTypedefType(resolved, analyzed.typedefTable);
			if (canonical != null) { referenceShape = canonical; }
			if (typeExpr.isArray && referenceShape.isArray) {
				TypeIdentity.fail("nested array composition for type parameter '" + typeExpr.base + "' is not supported");
			}
			return TypeComposition.compose(typeExpr, resolved, SemanticTypeSystem.genericSubstitutionReferenceShape(referenceShape, analyzed));
		}
		if (typeExpr.genericArgs().len > 0) {
			Node result = Node();
			result.kind = NK_TYPE_EXPR;
			result.base = typeExpr.base;
			Vector<Node> arguments = [];
			int index = 0;
			while (index < typeExpr.genericArgs().len) {
				arguments.push(SemanticTypeSystem.resolveGenericType(typeExpr.genericArgs().get(index), substitutions, analyzed));
				index = index + 1;
			}
			result.genericArgsStorage = arguments;
			result.pointerDepth = typeExpr.pointerDepth;
			result.isArray = typeExpr.isArray;
			TypeShape.copyArrayExtents(result, typeExpr);
			result.isConst = typeExpr.isConst;
			result.isNullable = typeExpr.isNullable;
			result.nullableOuterDepth = typeExpr.nullableOuterDepth;
			result.isStatic = typeExpr.isStatic;
			result.isExtern = typeExpr.isExtern;
			result.isVolatile = typeExpr.isVolatile;
			result.arrayPointerDepth = typeExpr.arrayPointerDepth;
			result.line = typeExpr.line;
			result.col = typeExpr.col;
			return result;
		}
		return typeExpr;
	}

	public Node resolveGeneric(Node? typeExpr, Map<string, Node> substitutions) { return SemanticTypeSystem.resolveGenericType(typeExpr, substitutions, self.analyzed); }

	class Map<string, Node> genericTypeMap(Analyzed analyzed, Node instanceType) {
		Map<string, Node> substitutions = {};
		if (!analyzed.genericClassTable.has(instanceType.base)) {
			return substitutions;
		}
		Node declaration = analyzed.genericClassTable.get(instanceType.base);
		int index = 0;
		while (index < declaration.genericParams().len && index < instanceType.genericArgs().len) {
			substitutions.put(declaration.genericParams().get(index), instanceType.genericArgs().get(index));
			index = index + 1;
		}
		return substitutions;
	}

	public Map<string, Node> instanceTypeMap(Node instanceType) { return SemanticTypeSystem.genericTypeMap(self.analyzed, instanceType); }

	class Map<string, Node> methodCallTypeMap(Analyzed analyzed, Node call, Node method, Map<string, Node> classArguments) {
		Map<string, Node> substitutions = {};
		Vector<string> classNames = classArguments.keys();
		int classIndex = 0;
		while (classIndex < classNames.len) {
			string name = classNames.get(classIndex);
			substitutions.put(name, classArguments.get(name));
			classIndex = classIndex + 1;
		}
		Vector<Node>? inferred = analyzed.methodCallArguments(call);
		if (inferred == null) {
			return substitutions;
		}
		Vector<Node> methodArguments = inferred;
		int methodIndex = 0;
		while (methodIndex < method.genericParams().len && methodIndex < methodArguments.len) {
			substitutions.put(method.genericParams().get(methodIndex), methodArguments.get(methodIndex));
			methodIndex = methodIndex + 1;
		}
		return substitutions;
	}

	public Map<string, Node> callTypeMap(Node call, Node method, Map<string, Node> classArguments) { return SemanticTypeSystem.methodCallTypeMap(self.analyzed, call, method, classArguments); }

	class Node? genericMember(Analyzed analyzed, string base, string member) {
		analyzed.requireMemberIndex();
		string key = Analyzed.memberKey(base, member);
		if (analyzed.genericMemberIndex.has(key)) {
			return analyzed.genericMemberIndex.get(key);
		}
		return null;
	}

	class bool rawIndexedPointer(Node objectType, Analyzed analyzed) {
		if (objectType.pointerDepth <= 0) { return false; }
		if (analyzed.isClass(objectType.base) || analyzed.isGenericClass(objectType.base)) {
			return objectType.pointerDepth > 1;
		}
		return true;
	}

	class Node? indexedMethod(Node objectType, string name, Analyzed analyzed) {
		/* An array of collections indexes its storage, not a collection. */
		if (objectType.isArray) { return null; }
		if (analyzed.isGenericClass(objectType.base) && objectType.pointerDepth <= 1) {
			return analyzed.genericClassMethod(objectType.base, name);
		}
		if (analyzed.isClass(objectType.base)) {
			return analyzed.classMethod(objectType.base, name);
		}
		return null;
	}

	class Node? indexResultType(Node? objectType, Analyzed analyzed) {
		if (objectType == null || (objectType.base == "Tuple" && !objectType.isArray && objectType.pointerDepth == 0)) { return null; }
		if (SemanticTypeSystem.isString(objectType)) {
			Node character = SemanticTypeSystem.primitive("char");
			character.isConst = objectType.isConst;
			return character;
		}
		if (objectType.isArray) {
			return TypeShape.withoutOuterArray(objectType);
		}
		if (SemanticTypeSystem.rawIndexedPointer(objectType, analyzed)) {
			return TypeShape.withoutOuterPointers(objectType, 1);
		}
		Node? getter = SemanticTypeSystem.indexedMethod(objectType, "get", analyzed);
		Node? result = null;
		if (getter != null && getter.access != "class" && getter.genericParams().len == 0 && getter.params().len == 1 && !getter.params().get(0).keep_ && getter.returnType != null && !(getter.returnType.base == "void" && getter.returnType.pointerDepth == 0 && !getter.returnType.isArray)) {
			result = getter.returnType;
		} else {
			Node? setter = SemanticTypeSystem.indexedMethod(objectType, "set", analyzed);
			if (setter != null && setter.access != "class" && setter.genericParams().len == 0 && setter.params().len == 2 && !setter.params().get(0).keep_ && setter.returnType != null && setter.returnType.base == "void" && setter.returnType.pointerDepth == 0 && !setter.returnType.isArray) {
				result = setter.params().get(1).type;
			}
		}
		if (result == null) { return null; }
		if (analyzed.isGenericClass(objectType.base) && objectType.genericArgs().len > 0) {
			return SemanticTypeSystem.resolveGenericType(result, SemanticTypeSystem.genericTypeMap(analyzed, objectType), analyzed);
		}
		return result;
	}

	public Node? instanceMember(string base, string member) { return SemanticTypeSystem.genericMember(self.analyzed, base, member); }

	class Map<string, bool> genericParameterSet(Vector<string> parameters) {
		Map<string, bool> names = {};
		int index = 0;
		while (index < parameters.len) {
			names.put(parameters.get(index), true);
			index = index + 1;
		}
		return names;
	}

	class Node? genericParameterBinding(Node actual, Node declared) {
		int extra = declared.pointerDepth;
		Node binding = actual;
		int removed = 0;
		while (removed < extra) {
			if (binding.pointerDepth <= 0) { return null; }
			binding = TypeShape.withoutOuterPointers(binding, 1);
			removed = removed + 1;
		}
		return binding;
	}

	class void unifyGenericParameter(Node? declared, Node? actual, Map<string, bool> parameters, Map<string, Node> substitutions) {
		if (declared == null || actual == null) { return; }
		if (parameters.has(declared.base) && declared.genericArgs().len == 0) {
			if (!substitutions.has(declared.base)) {
				Node? binding = SemanticTypeSystem.genericParameterBinding(actual, declared);
				if (binding != null) {
					substitutions.put(declared.base, binding);
				}
			}
			return;
		}
		if (declared.genericArgs().len > 0 && actual.genericArgs().len > 0) {
			int index = 0;
			while (index < declared.genericArgs().len && index < actual.genericArgs().len) {
				SemanticTypeSystem.unifyGenericParameter(declared.genericArgs().get(index), actual.genericArgs().get(index), parameters, substitutions);
				index = index + 1;
			}
		}
	}

	/* Tuple field spelling shared by inference and semantic validation. */

	class int tupleIndex(string field) {
		if (field.length() < 2 || field[0] != '_') { return -1; }
		int result = 0;
		int index = 1;
		while (index < field.length()) {
			char value = field[index];
			if (value < '0' || value > '9') { return -1; }
			result = result * 10 + ((int)value - (int)'0');
			index = index + 1;
		}
		return result;
	}
}
