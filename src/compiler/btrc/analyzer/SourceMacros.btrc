/* Immutable analyzer view of C preprocessor namespace mutations. */

import Library.Map;
import Library.Vector;

import ../frontend/Models.btrc;
import ../generated/ast/Node.btrc;
import ./HostedAbi.btrc;
import ../parser/SourceMacros.btrc;
import ../syntax/Literals.btrc;

class SourceMacroNamespace {
	private Map<string, bool> declaredNames;
	private Map<string, SourceMacroDefinition> activeDefinitions;
	/* Every name some live #undef names. */
	private Map<string, bool> undefinedNames;
	private HostedAbiRepository? hostedAbi;
	private SourceMacroRules? rules;
	private int stdlibLineCount;
	private Vector<FeLine> sourceLines;

	/* With `rules`, collection validates every directive in hoisted program
	 * order (M1-M4 and the name rules) and fails at the first refusal,
	 * positioned in its own file through `sourceLines`. */
	public SourceMacroNamespace(Node program, HostedAbiRepository? hostedAbi = null, SourceMacroRules? rules = null, int stdlibLineCount = 0, Vector<FeLine>? sourceLines = null) {
		self.declaredNames = {};
		self.activeDefinitions = {};
		self.undefinedNames = {};
		self.hostedAbi = hostedAbi;
		self.rules = rules;
		self.stdlibLineCount = stdlibLineCount;
		Vector<FeLine> none = [];
		self.sourceLines = sourceLines != null ? sourceLines : none;
		self.collect(program);
	}

	public bool declared(string name) { return self.declaredNames.has(name); }

	/* Whether some live #undef names the macro. */
	public bool undefined(string name) { return self.undefinedNames.has(name); }

	/* Fail at `site`, at its own file's position when the combined line maps
	 * to one; validation reports one error and stops. */
	public void fail(string message, Node site) {
		int index = site.line - self.stdlibLineCount - 1;
		if (index >= 0 && index < self.sourceLines.len) {
			FeLine line = self.sourceLines.get(index);
			fprintf(stderr, "%s\n", FeVisibilityDiagnostic(message, line.sourceFile, line.lineNumber, site.col, line.text).render());
		} else {
			fprintf(stderr, "error: %s at %d:%d\n", message, site.line, site.col);
		}
		exit(1);
	}

	/* Why code may not use a declared source macro (U1, U2), or "". Every
	 * directive is emitted before the program, so code sees each macro's
	 * final state, never the one at its own position. */
	public string codeUseViolation(string name) {
		if (self.undefinedNames.len == 0 || !self.declaredNames.has(name)) { return ""; }
		string suffix = "btrc emits every #define and #undef before the program";
		if (self.undefinedNames.has(name)) { return f"Source macro '{name}' cannot be used in code because it is #undef'd; {suffix}"; }
		if (self.active(name) == null) { return ""; }
		for identifier in self.reachedIdentifiers(name) {
			if (self.undefinedNames.has(identifier)) { return f"Source macro '{name}' cannot be used in code because it expands to #undef'd macro '{identifier}'; {suffix}"; }
		}
		return "";
	}

	/* Refuse a code use of an #undef'd source macro at its identifier. */
	public void refuseCodeUse(string name, Node site) {
		string violation = self.codeUseViolation(name);
		if (!violation.isEmpty()) { self.fail(violation, site); }
	}

	/* Replacement identifiers reachable from an active macro, breadth first
	 * in discovery order. */
	private Vector<string> reachedIdentifiers(string name) {
		Vector<string> reached = [];
		Vector<string> pending = [name];
		Map<string, bool> visiting = {};
		int cursor = 0;
		while (cursor < pending.len) {
			string current = pending.get(cursor);
			cursor++;
			if (visiting.has(current)) { continue; }
			visiting.put(current, true);
			SourceMacroDefinition? definition = self.active(current);
			if (definition == null) { continue; }
			for identifier in definition.replacementIdentifiers() {
				if (!reached.contains(identifier)) { reached.push(identifier); }
				if (!visiting.has(identifier) && self.active(identifier) != null) { pending.push(identifier); }
			}
		}
		return reached;
	}

	public SourceMacroDefinition? active(string name) {
		if (!self.activeDefinitions.has(name)) { return null; }
		return self.activeDefinitions.get(name);
	}

	public Vector<string> freeIdentifiers(SourceMacroDefinition definition) {
		Map<string, bool> visiting = {};
		Vector<string> result = [];
		self.collectFreeIdentifiers(definition, visiting, result);
		return result;
	}

	/* The "..." spellings an object-like macro expands to; empty when it
	 * expands to anything else. */
	public Vector<string> stringSpellings(string name) {
		Map<string, bool> visiting = {};
		return self.stringSpellingsImpl(name, visiting);
	}

	private Vector<string> stringSpellingsImpl(string name, Map<string, bool> visiting) {
		Vector<string> spellings = [];
		SourceMacroDefinition? definition = self.active(name);
		if (definition == null || definition.functionLike() || visiting.has(name)) { return spellings; }
		Vector<string> pieces = StringConstant.pieces(definition.replacement());
		visiting.put(name, true);
		int index = 0;
		while (index < pieces.len) {
			string piece = pieces.get(index);
			if (piece[0] == '"') {
				spellings.push(piece);
			} else {
				Vector<string> nested = self.stringSpellingsImpl(piece, visiting);
				if (nested.len == 0) {
					visiting.remove(name);
					return nested;
				}
				spellings.extend(nested);
			}
			index++;
		}
		visiting.remove(name);
		return spellings;
	}

	/* The first piece of an adjacent-literal sequence that is no string literal. */
	public Node? unresolvedStringPiece(Node expression) {
		if (expression.kind != NK_STRING_CONCAT) { return null; }
		int index = 0;
		while (index < expression.parts().len) {
			Node part = expression.parts().get(index);
			if (part.kind == NK_IDENTIFIER && self.stringSpellings(part.name).len == 0) { return part; }
			index++;
		}
		return null;
	}

	public string unresolvedPieceMessage(Node piece) { return "Cannot concatenate '" + piece.name + "' with an adjacent string literal: it is not a source macro that expands to a string literal"; }

	/* The decoded byte length of a string-constant expression, without
	 * terminator; -1 for anything else. Every piece decodes separately. */
	public int stringConstantLength(Node? expression) {
		if (expression == null) { return -1; }
		if (expression.kind == NK_STRING_LITERAL) { return StringConstant.decodedLength(expression.valueString); }
		if (expression.kind != NK_STRING_CONCAT) { return -1; }
		int length = 0;
		int index = 0;
		while (index < expression.parts().len) {
			Node part = expression.parts().get(index);
			if (part.kind == NK_STRING_LITERAL) {
				length = length + StringConstant.decodedLength(part.valueString);
			} else {
				if (part.kind != NK_IDENTIFIER) { return -1; }
				Vector<string> spellings = self.stringSpellings(part.name);
				if (spellings.len == 0) { return -1; }
				int spelling = 0;
				while (spelling < spellings.len) {
					length = length + StringConstant.decodedLength(spellings.get(spelling));
					spelling++;
				}
			}
			index++;
		}
		return length;
	}

	public bool expandsToAny(string name, Map<string, bool> identifiers) {
		Map<string, bool> visiting = {};
		return self.expandsToAnyImpl(name, identifiers, visiting);
	}

	private bool expandsToAnyImpl(string name, Map<string, bool> identifiers, Map<string, bool> visiting) {
		if (visiting.has(name)) { return false; }
		SourceMacroDefinition? definition = self.active(name);
		if (definition == null) { return false; }
		visiting.put(name, true);
		Vector<string> referenced = definition.replacementIdentifiers();
		int index = 0;
		while (index < referenced.len) {
			string identifier = referenced.get(index);
			if (identifiers.has(identifier) || self.expandsToAnyImpl(identifier, identifiers, visiting)) {
				return true;
			}
			index++;
		}
		return false;
	}

	private bool stdlibDirective(Node declaration) {
		HostedAbiRepository? hostedAbi = self.hostedAbi;
		return hostedAbi != null && hostedAbi.compilerStdlibNode(declaration);
	}

	private void collect(Node program) {
		Vector<Node> sites = [];
		Vector<SourceMacroDefinition> definitions = [];
		Map<string, bool> ownDefinitions = {};
		for declaration in program.declarations() {
			if (declaration.kind != NK_PREPROCESSOR_DIRECTIVE) { continue; }
			SourceMacroDefinition definition = SourceMacroDefinition(declaration.text);
			if (!definition.isDefinition() && !definition.isUndef()) { continue; }
			sites.push(declaration);
			definitions.push(definition);
			if (definition.isDefinition() && !self.stdlibDirective(declaration)) { ownDefinitions.put(definition.name(), true); }
		}
		SourceMacroRules? rules = self.rules;
		for (int index = 0; index < definitions.len; index++) {
			SourceMacroDefinition definition = definitions.get(index);
			Node declaration = sites.get(index);
			string name = definition.name();
			if (rules != null) {
				string violation = rules.violation(name, definition.isDefinition());
				if (!violation.isEmpty()) { self.fail(violation, declaration); }
			}
			if (definition.isDefinition()) {
				if (rules != null && self.activeDefinitions.has(name) && !SourceMacroRules.sameDefinition(self.activeDefinitions.get(name), definition)) { self.fail(SourceMacroRules.redefinitionMessage(name), declaration); }
				self.declaredNames.put(name, true);
				self.activeDefinitions.put(name, definition);
				continue;
			}
			if (rules != null && !ownDefinitions.has(name)) { self.fail(f"#undef of '{name}' is not allowed; btrc undefines only macros that its own sources #define", declaration); }
			self.undefinedNames.put(name, true);
			self.activeDefinitions.remove(name);
		}
	}

	private void collectFreeIdentifiers(SourceMacroDefinition definition, Map<string, bool> visiting, Vector<string> result) {
		string name = definition.name();
		if (name != "" && visiting.has(name)) { return; }
		if (name != "") { visiting.put(name, true); }
		Vector<string> identifiers = definition.replacementIdentifiers();
		int index = 0;
		while (index < identifiers.len) {
			string identifier = identifiers.get(index);
			SourceMacroDefinition? nested = self.active(identifier);
			if (nested != null) {
				self.collectFreeIdentifiers(nested, visiting, result);
			} else if (!result.contains(identifier)) {
				result.push(identifier);
			}
			index++;
		}
	}
}
