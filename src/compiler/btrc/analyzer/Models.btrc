import Library.Map;
import Library.Vector;

import ../generated/ast/Node.btrc;
import ../frontend/Models.btrc;
import ../syntax/Identity.btrc;

/* Semantic-analysis result and value models.
 *
 * This module contains per-compilation data only. Traversal, inference, and
 * mutation policy live on the retained analyzer owners in sibling modules. */

/* A concrete monomorphization request: base generic class + the concrete type
 * args it was instantiated with, plus the precomputed mangled name. */
class GenInstance {
	public string base;
	public Vector<Node> args;
	public string mangled;
	public GenInstance(string base, Vector<Node> args, string mangled) {
		self.base = base;
		self.args = args;
		self.mangled = mangled;
	}
}

/* One monomorphization target for a generic METHOD (a method with its own
 * type parameters, e.g. Vector<T>.mapTo<U>). `classBase` is the owning class
 * base name, `classArgs` the receiver instance's type args (e.g. [int] for
 * Vector<int>; empty for a non-generic owner), `methodArgs` the inferred
 * method type args (e.g. [string] for mapTo<string>). Mirrors one entry of
 * the reference's analyzed.generic_method_instances. */
class MethodGenInstance {
	public string classBase;
	public string methodName;
	public Vector<Node> classArgs;
	public Vector<Node> methodArgs;
	public MethodGenInstance(string classBase, string methodName, Vector<Node> classArgs, Vector<Node> methodArgs) {
		self.classBase = classBase;
		self.methodName = methodName;
		self.classArgs = classArgs;
		self.methodArgs = methodArgs;
	}
}

class Analyzed {
	public Vector<FeNativeImportedDeclaration> nativeDeclarations;
	private Map<string, FeNativeImportedDeclaration> nativeClassIndex;
	private Map<string, Node> nativeOwnedFunctions = {};
	public Map<string, bool> nativeLifetimeOperations = {};
	/* Native globals by name, first declaration first, exactly as the linear
	 * scans they replace answered: any declaration for read-only-ness, the first
	 * uninitialised typed one for ownership, and whether an Objective-C one exists. */
	private Map<string, FeNativeImportedDeclaration> nativeGlobalAnyIndex = {};
	private Map<string, FeNativeImportedDeclaration> nativeTypedGlobalIndex = {};
	private Map<string, bool> objectiveCGlobals = {};
	/* The other per-query scans, by declaration identity or name, first match first. */
	private Map<string, FeNativeImportedDeclaration> nativeByDeclaration = {};
	private Map<string, FeNativeCallContract> nativeMethodContracts = {};
	private Map<string, bool> nativeTypedefAliases = {};
	private Map<string, Vector<FeNativeImportedDeclaration>> nativeStructsByName = {};
	private Map<string, string> nativeTypeSpellings = {};
	private Map<string, bool> objectiveCRecords = {};

	/* Native declarations are installed before analysis, then read-only. Keep
	 * class queries independent of the number of unrelated SDK declarations. */
	public void setNativeDeclarations(Vector<FeNativeImportedDeclaration> declarations) {
		self.nativeDeclarations = declarations;
		self.nativeClassIndex = {};
		self.nativeLifetimeOperations = {};
		self.nativeOwnedFunctions = {};
		self.nativeGlobalAnyIndex = {};
		self.nativeTypedGlobalIndex = {};
		self.objectiveCGlobals = {};
		self.nativeByDeclaration = {};
		self.nativeMethodContracts = {};
		self.nativeTypedefAliases = {};
		self.nativeStructsByName = {};
		self.nativeTypeSpellings = {};
		self.objectiveCRecords = {};
		for imported in declarations {
			var contract = imported.callContract;
			Node native = imported.declaration;
			string identity = AstIdentity.key(native);
			if (!self.nativeByDeclaration.has(identity)) { self.nativeByDeclaration.put(identity, imported); }
			if (native.kind == NK_CLASS_DECL) {
				for member in native.members {
					if (!imported.methods.has(member.name)) { continue; }
					string memberIdentity = AstIdentity.key(member);
					if (!self.nativeMethodContracts.has(memberIdentity)) { self.nativeMethodContracts.put(memberIdentity, imported.methods.get(member.name)); }
				}
			}
			if (native.kind == NK_TYPEDEF_DECL) {
				self.nativeTypedefAliases.put(native.alias, true);
				if (!imported.coalesced && !self.nativeTypeSpellings.has(native.alias)) { self.nativeTypeSpellings.put(native.alias, imported.typeSpelling); }
			}
			if (native.kind == NK_STRUCT_DECL) {
				if (!self.nativeStructsByName.has(native.name)) { Vector<FeNativeImportedDeclaration> fresh = []; self.nativeStructsByName.put(native.name, fresh); }
				self.nativeStructsByName.get(native.name).push(imported);
				if (!imported.coalesced) {
					if (!self.nativeTypeSpellings.has(native.name)) { self.nativeTypeSpellings.put(native.name, imported.typeSpelling); }
					if (!self.objectiveCRecords.has(native.name)) { self.objectiveCRecords.put(native.name, imported.language == "objective-c"); }
				}
			}
			if (imported.declaration.kind == NK_VAR_DECL_STMT) {
				string globalName = imported.declaration.name;
				if (!self.nativeGlobalAnyIndex.has(globalName)) { self.nativeGlobalAnyIndex.put(globalName, imported); }
				if (imported.declaration.initializer == null) {
					if (imported.language == "objective-c") { self.objectiveCGlobals.put(globalName, true); }
					if (imported.declaration.type != null && !self.nativeTypedGlobalIndex.has(globalName)) { self.nativeTypedGlobalIndex.put(globalName, imported); }
				}
			}
			if (imported.declaration.kind == NK_FUNCTION_DECL && contract != null && contract.returnsOwned() && !imported.coalesced) { self.nativeOwnedFunctions.put(imported.declaration.name, imported.declaration); }
			var resource = imported.resource;
			if (resource != null) { self.nativeLifetimeOperations.put(resource.retainFunction, true); self.nativeLifetimeOperations.put(resource.releaseFunction, true); }
			if (imported.declaration.kind == NK_CLASS_DECL && !self.nativeClassIndex.has(imported.declaration.name)) { self.nativeClassIndex.put(imported.declaration.name, imported); }
		}
	}

	public bool isNativeDeclaration(Node site) { return self.nativeByDeclaration.has(AstIdentity.key(site)); }

	public bool isNativeTypedef(string name) { return self.nativeTypedefAliases.has(name); }

	public bool nativeRecordHasPrivateFields(Node declaration) {
		string identity = AstIdentity.key(declaration);
		if (!self.nativeByDeclaration.has(identity)) { return false; }
		for imported in self.nativeDeclarations { if (imported.declaration == declaration && imported.privateFields) { return true; } }
		return false;
	}

	public string nativeClassLanguage(string name) { return self.nativeClassIndex.has(name) ? self.nativeClassIndex.get(name).language : ""; }

	public bool nativeInvocation(string name) { return self.nativeClassIndex.has(name) && !self.nativeClassIndex.get(name).invocation.isEmpty(); }

	public bool nativeFunctionReturnsOwned(Node declaration) { return self.nativeOwnedFunctions.has(declaration.name) && self.nativeOwnedFunctions.get(declaration.name) == declaration; }

	public bool nativeGlobalReadOnly(string name) {
		if (!self.nativeGlobalAnyIndex.has(name)) { return false; }
		return self.nativeGlobalAnyIndex.get(name).readOnly;
	}

	public bool isObjectiveCGlobal(string name) { return self.objectiveCGlobals.has(name); }

	public bool nativeGlobalReturnsOwned(string name) {
		if (!self.nativeTypedGlobalIndex.has(name)) { return false; }
		var imported = self.nativeTypedGlobalIndex.get(name);
		return self.nativeClassLanguage(imported.declaration.type.base) == "objective-c" || (imported.callContract != null && !imported.callContract.resourceResult.isEmpty());
	}

	public FeNativeCallContract? nativeCallContract(Node declaration) {
		string identity = AstIdentity.key(declaration);
		if (self.nativeByDeclaration.has(identity)) { return self.nativeByDeclaration.get(identity).callContract; }
		if (self.nativeMethodContracts.has(identity)) { return self.nativeMethodContracts.get(identity); }
		return null;
	}

	public FeNativeCallContract? nativeFieldCallContract(string owner, string field) {
		if (!self.nativeStructsByName.has(owner)) { return null; }
		for imported in self.nativeStructsByName.get(owner) {
			if (imported.fieldContracts.has(field)) { return imported.fieldContracts.get(field); }
		}
		return null;
	}

	public string nativeTypeSpelling(string name) { return self.nativeTypeSpellings.has(name) ? self.nativeTypeSpellings.get(name) : ""; }

	public bool isObjectiveCRecord(string name) { return self.objectiveCRecords.has(name) && self.objectiveCRecords.get(name); }
	private Map<string, bool>? lexicalTypeParameterNames;
	private int lexicalTypeParameterTableSize;
	/* Inheritance closure per class/interface name, and its inverse in class-table
	 * order, both rebuilt when a declaration table grows (cycle analysis asks
	 * for the descendants of every field type; the walk used to run per query). */
	private Map<string, Map<string, bool>> ancestorSets = {};
	private Map<string, Vector<string>> descendantLists = {};
	private bool descendantListsBuilt = false;
	private int inheritanceTableSize = -1;
	/* function name -> the function's return TypeExpr node (NK_TYPE_EXPR) */
	public Map<string, Node> funcRetTypes;
	/* set of declared function names (value always "1") */
	public Map<string, bool> funcNames;
	/* function name -> its FunctionDecl node (for default-parameter filling). */
	public Map<string, Node> funcTable;
	/* class name -> its ClassDecl node (NK_CLASS_DECL). Mirrors class_table. */
	public Map<string, Node> classTable;
	/* generic class base name -> its ClassDecl node (generic_params non-empty). */
	public Map<string, Node> genericClassTable;
	/* Interface declaration index shared by semantic checks and runtime dispatch. */
	public Map<string, Node> interfaceTable;
	/* Concrete generic instances in discovery (declaration-walk) order, deduped
     * by mangled name. Mirrors analyzer.generic_instances flattened. */
	public Vector<GenInstance> genericInstances;
	/* set of canonical recursive instance keys already collected (dedup). */
	public Map<string, bool> genericSeen;
	/* enum type name -> its EnumDecl node (NK_ENUM_DECL). Mirrors enum_table
     * keyed by type name (Python enum_table maps name -> [value names]). */
	public Map<string, Node> enumTable;
	/* bare enum value name (e.g. "RED") -> owning enum type name ("Color"). Lets
     * a bare identifier lower to its prefixed C constant. */
	public Map<string, string> enumValueOwner;
	/* Number of enum declarations that export each bare spelling. Qualified
     * access remains legal when the bare form is ambiguous. */
	public Map<string, int> enumValueOwnerCount;
	/* rich (tagged-union) enum type name -> its RichEnumDecl node
     * (NK_RICH_ENUM_DECL). Mirrors rich_enum_table. */
	public Map<string, Node> richEnumTable;
	/* Generic-method monomorphization targets, in discovery order, deduped by
     * the same mangled-key as their emitted C name. Mirrors
     * analyzed.generic_method_instances. */
	public Vector<MethodGenInstance> methodGenInstances;
	public Map<string, bool> methodGenSeen;
	/* call-site AstIdentity.key (stable Node identity) -> the inferred method
     * type args, so IR-gen can mangle the call to its monomorphized instance
     * without re-running inference. Mirrors generic_method_call_args. */
	public Map<string, Vector<Node>> methodGenCallArgs;
	/* Canonical stdlib call sites that must bypass a user source definition
     * sharing a compiler-owned hosted spelling. */
	public Map<string, bool> hostedCallKeys;
	/* Generic constructor call identity -> exact context/inference result.
     * This is the self-hosted counterpart of reference node_types: no-arg and
     * nested constructors retain the concrete specialization selected by a
     * return, argument, initializer, or assignment boundary. */
	public Map<string, Node> genericConstructorTypes;
	/* Module-level (file-scope) variable name -> its TypeExpr. Mirrors the
     * reference's global scope: a bare identifier referencing a top-level var
     * resolves to this type during inference (e.g. `string order` so
     * `order.equals(...)` lowers as a string method). Seeded into each
     * function's local varTypes at lowering entry. */
	public Map<string, Node> globalVarTypes;
	/* Global names with a concrete definition (not an initializer-less extern).
     * IR generation suppresses redundant extern redeclarations when the same
     * composed translation unit already owns the definition. */
	public Map<string, bool> globalHasDefinition;
	/* user typedef alias -> original TypeExpr; inference canonicalizes through
     * this table while IR declarations preserve source alias spelling. */
	public Map<string, Node> typedefTable;
	/* struct tag/name -> complete definition when available, otherwise its
     * forward declaration. */
	public Map<string, Node> structTable;
	/* Immutable declaration indexes built after registration and before the
     * first inference query. General-member and method-only namespaces remain
     * separate so a value member never masks an inherited method. */
	public bool memberIndexReady;
	public Map<string, Node> classMemberIndex;
	public Map<string, Node> classMethodIndex;
	public Map<string, Node> classConstructorIndex;
	public Map<string, Node> genericMemberIndex;
	public Map<string, Node> genericMethodIndex;
	public Map<string, Node> genericConstructorIndex;
	/* for-in iterable identity -> semantic proof of real array capacity. */
	public Map<string, bool> arrayIterationCapacityKeys;
	/* Array-bound identity -> semantic proof of a C integer constant
     * expression. IR generation uses this to fail closed if an invalid VLA
     * initializer somehow bypasses validation. */
	public Map<string, bool> constantArrayBoundKeys;
	/* Source C-for identity -> canonical realtime bounded-loop proof. */
	public Map<string, bool> realtimeBoundedLoopKeys;

	public Analyzed() {
		self.nativeDeclarations = [];
		self.nativeClassIndex = {};
		self.lexicalTypeParameterNames = null;
		self.lexicalTypeParameterTableSize = -1;
		self.funcRetTypes = {};
		self.funcNames = {};
		self.funcTable = {};
		self.classTable = {};
		self.genericClassTable = {};
		self.interfaceTable = {};
		self.genericInstances = [];
		self.genericSeen = {};
		self.enumTable = {};
		self.enumValueOwner = {};
		self.enumValueOwnerCount = {};
		self.richEnumTable = {};
		self.methodGenInstances = [];
		self.methodGenSeen = {};
		self.methodGenCallArgs = {};
		self.hostedCallKeys = {};
		self.genericConstructorTypes = {};
		self.globalVarTypes = {};
		self.globalHasDefinition = {};
		self.typedefTable = {};
		self.structTable = {};
		self.memberIndexReady = false;
		self.classMemberIndex = {};
		self.classMethodIndex = {};
		self.classConstructorIndex = {};
		self.genericMemberIndex = {};
		self.genericMethodIndex = {};
		self.genericConstructorIndex = {};
		self.arrayIterationCapacityKeys = {};
		self.constantArrayBoundKeys = {};
		self.realtimeBoundedLoopKeys = {};
	}

	private Node primitiveType(string base) {
		Node typeExpr = Node();
		typeExpr.kind = NK_TYPE_EXPR;
		typeExpr.base = base;
		return typeExpr;
	}

	private string parentName(Node declaration) {
		if (declaration.parent == null) { return ""; }
		return declaration.parent;
	}

	class string memberKey(string owner, string member) { return owner + "." + member; }

	/* Generic type-parameter names of every class and method, rebuilt only when a
	 * class table grows: the binding-name conflict check below runs once per
	 * lexical binding during lowering, so scanning every declaration per call is
	 * quadratic in program size. */
	private Map<string, bool> lexicalTypeParameterNameSet() {
		int tableSize = self.classTable.len + self.genericClassTable.len;
		Map<string, bool>? cached = self.lexicalTypeParameterNames;
		if (cached != null && self.lexicalTypeParameterTableSize == tableSize) { return cached; }
		Map<string, bool> names = {};
		Vector<string> classNames = self.classTable.keys();
		Vector<string> genericClassNames = self.genericClassTable.keys();
		int table = 0;
		while (table < 2) {
			Vector<string> keys = table == 0 ? classNames : genericClassNames;
			int classIndex = 0;
			while (classIndex < keys.len) {
				Node declaration = table == 0 ? self.classTable.get(keys.get(classIndex)) : self.genericClassTable.get(keys.get(classIndex));
				int parameterIndex = 0;
				while (parameterIndex < declaration.genericParams.len) {
					names.put(declaration.genericParams.get(parameterIndex), true);
					parameterIndex = parameterIndex + 1;
				}
				int memberIndex = 0;
				while (memberIndex < declaration.members.len) {
					Node member = declaration.members.get(memberIndex);
					int methodParameterIndex = 0;
					while (methodParameterIndex < member.genericParams.len) {
						names.put(member.genericParams.get(methodParameterIndex), true);
						methodParameterIndex = methodParameterIndex + 1;
					}
					memberIndex = memberIndex + 1;
				}
				classIndex = classIndex + 1;
			}
			table = table + 1;
		}
		self.lexicalTypeParameterNames = names;
		self.lexicalTypeParameterTableSize = tableSize;
		return names;
	}

	public bool lexicalBindingConflictsType(string name) {
		if (self.isClass(name) || self.isGenericClass(name) || self.isEnum(name) || self.isRichEnum(name) || self.structTable.has(name) || self.typedefTable.has(name)) {
			return true;
		}
		return self.lexicalTypeParameterNameSet().has(name);
	}

	/* True if any generic-method monomorphization target exists. */

	/* True if `name` names a known (plain) enum type. */
	public bool isEnum(string name) { return self.enumTable.has(name); }

	/* True if `name` names a known rich (tagged-union) enum type. */
	public bool isRichEnum(string name) { return self.richEnumTable.has(name); }

	/* True if `name` is a bare enum value (e.g. RED). */
	public bool isEnumValue(string name) { return self.enumValueOwner.has(name) && self.enumValueOwnerCount.get(name) == 1; }

	public bool isAmbiguousEnumValue(string name) { return self.enumValueOwnerCount.has(name) && self.enumValueOwnerCount.get(name) > 1; }

	public bool enumContains(string enumName, string valueName) {
		if (!self.enumTable.has(enumName)) { return false; }
		Node declaration = self.enumTable.get(enumName);
		int index = 0;
		while (index < declaration.values.len) {
			if (declaration.values.get(index).name == valueName) {
				return true;
			}
			index = index + 1;
		}
		return false;
	}

	/* The owning enum type name of bare value `name` ("" if unknown). */
	public string enumOwnerOf(string name) {
		if (self.enumValueOwner.has(name)) { return self.enumValueOwner.get(name); }
		return "";
	}

	/* True if `name` names a known generic class. */
	public bool isGenericClass(string name) { return self.genericClassTable.has(name); }

	/* True if any concrete generic instance exists (drives macro emission). */

	/* True if `name` names a known (non-generic) class. */
	public bool isClass(string name) { return self.classTable.has(name); }

	/* Interfaces share managed receiver identity with their implementers. */
	public bool isInterface(string name) { return self.interfaceTable.has(name); }

	/* Find an interface method through its declared inheritance chain. The
     * declaration index belongs to Analyzed so validation and lowering resolve
     * exactly the same interface surface. */
	public Node? interfaceMethod(string interfaceName, string methodName) {
		string current = interfaceName;
		Map<string, bool> seen = {};
		while (current != "" && !seen.has(current)) {
			seen.put(current, true);
			if (!self.interfaceTable.has(current)) { return null; }
			Node declaration = self.interfaceTable.get(current);
			int index = 0;
			while (index < declaration.methods.len) {
				Node method = declaration.methods.get(index);
				if (method.name == methodName) { return method; }
				index = index + 1;
			}
			if (declaration.parent == null) { return null; }
			current = declaration.parent;
		}
		return null;
	}

	public Vector<Node> interfaceMethods(string name) {
		Vector<Node> methods = [];
		if (!self.interfaceTable.has(name)) { return methods; }
		Node declaration = self.interfaceTable.get(name);
		if (declaration.parent != null) { methods = self.interfaceMethods(declaration.parent); }
		for method in declaration.methods {
			int slot = -1;
			for index in range(methods.len) { if (methods.get(index).name == method.name) { slot = index; } }
			if (slot < 0) { methods.push(method); }
			else { methods.set(slot, method); }
		}
		return methods;
	}

	/* Return types for language builtins that do not have source declarations
     * or hosted-ABI entries. Keeping this on the analyzed semantic environment
     * gives every inference consumer the same typed contract. */
	public Node? builtinCallResultType(string name) {
		if (name == "len") { return self.primitiveType("int"); }
		if (name == "print") { return self.primitiveType("void"); }
		return null;
	}

	public void requireMemberIndex() {
		if (self.memberIndexReady) { return; }
		fprintf(stderr, "internal compiler error: declaration member index is not ready\n");
		exit(1);
	}

	/* Nominal ancestry includes class inheritance and implemented interfaces. */
	public bool isSubclass(string sub, string base) {
		if (self.nativeClassLanguage(sub) == "objective-c" || self.nativeClassLanguage(sub) == "c") {
			if (self.nativeClassLanguage(base) != self.nativeClassLanguage(sub)) { return false; }
			return sub == base || self.nativeClassIndex.get(sub).nativeAncestors.contains(base);
		}
		return sub == base || self.ancestorsOf(sub).has(base);
	}

	private void refreshInheritanceIndex() {
		int tableSize = self.classTable.len + self.genericClassTable.len + self.interfaceTable.len;
		if (tableSize == self.inheritanceTableSize) { return; }
		self.inheritanceTableSize = tableSize;
		self.ancestorSets = {};
		self.descendantLists = {};
		self.descendantListsBuilt = false;
	}

	/* Every name the inheritance walk from `sub` visits, itself included; the
	 * walk follows parents and interfaces through the three declaration tables
	 * and keeps names it cannot resolve, exactly as the query used to. */
	private Map<string, bool> ancestorsOf(string sub) {
		self.refreshInheritanceIndex();
		if (self.ancestorSets.has(sub)) { return self.ancestorSets.get(sub); }
		Map<string, bool> seen = {};
		Vector<string> pending = [sub];
		while (pending.len > 0) {
			string cur = pending.pop();
			if (cur == "" || seen.has(cur)) { continue; }
			seen.put(cur, true);
			Node? declaration = null;
			if (self.classTable.has(cur)) { declaration = self.classTable.get(cur); }
			else if (self.genericClassTable.has(cur)) { declaration = self.genericClassTable.get(cur); }
			else if (self.interfaceTable.has(cur)) { declaration = self.interfaceTable.get(cur); }
			if (declaration == null) { continue; }
			if (declaration.parent != null) { pending.push(declaration.parent); }
			for implemented in declaration.interfaces { pending.push(implemented); }
		}
		self.ancestorSets.put(sub, seen);
		return seen;
	}

	/* The classes for which isSubclass(class, base) holds, in class-table order. */
	public Vector<string> subclassesOf(string base) {
		self.refreshInheritanceIndex();
		if (!self.descendantListsBuilt) {
			self.descendantListsBuilt = true;
			Vector<string> classNames = self.classTable.keys();
			for name in classNames {
				Vector<string> bases = [];
				if (self.nativeClassLanguage(name) == "objective-c" || self.nativeClassLanguage(name) == "c") {
					bases.push(name);
					for ancestor in self.nativeClassIndex.get(name).nativeAncestors {
						if (self.nativeClassLanguage(ancestor) == self.nativeClassLanguage(name)) { bases.push(ancestor); }
					}
				} else {
					bases = self.ancestorsOf(name).keys();
				}
				for ancestor in bases {
					if (!self.descendantLists.has(ancestor)) { Vector<string> fresh = []; self.descendantLists.put(ancestor, fresh); }
					self.descendantLists.get(ancestor).push(name);
				}
			}
		}
		if (!self.descendantLists.has(base)) { Vector<string> none = []; return none; }
		return self.descendantLists.get(base);
	}

	public string nativeResourceQueryType(Node? target, Node? source) {
		if (source == null || target == null || !target.isNullable || target.isArray || source.isArray || source.base == target.base || self.nativeClassLanguage(source.base) != "c" || self.nativeClassLanguage(target.base) != "c") { return ""; }
		if (source.pointerDepth - (source.isNullable ? 1 : 0) != 0 || target.pointerDepth - 1 != 0 || self.isSubclass(source.base, target.base)) { return ""; }
		string query = self.nativeClassIndex.get(target.base).resourceQueryType;
		return query != "" && self.isSubclass(source.base, query) ? query : "";
	}

	/* Look up an ordinary class member by name, walking the inheritance chain.
     * Constructors are declaration-only call targets and never instance
     * members; classConstructor() is their sole lookup path. */
	public Node? classMember(string cls, string member) {
		self.requireMemberIndex();
		string key = Analyzed.memberKey(cls, member);
		if (self.classMemberIndex.has(key)) {
			return self.classMemberIndex.get(key);
		}
		return null;
	}

	/* Method-only lookup has a separate source namespace from fields and
     * properties. Walk inheritance just like classMember, but never let a
     * same-named value member mask the callable declaration. */
	public Node? classMethod(string cls, string method) {
		self.requireMemberIndex();
		string key = Analyzed.memberKey(cls, method);
		if (self.classMethodIndex.has(key)) {
			return self.classMethodIndex.get(key);
		}
		return null;
	}

	/* The explicitly marked constructor MethodDecl of class `cls`, or null. */
	public Node? classConstructor(string cls) {
		self.requireMemberIndex();
		if (self.classConstructorIndex.has(cls)) {
			return self.classConstructorIndex.get(cls);
		}
		return null;
	}

	/* The MethodDecl named `member` on generic class `cls` (own members only;
     * generic classes are not inherited in this compiler), or null. Used to
     * order named args / fill defaults on generic-instance method calls. */
	public Node? genericClassMethod(string cls, string member) {
		self.requireMemberIndex();
		string key = Analyzed.memberKey(cls, member);
		if (self.genericMethodIndex.has(key)) {
			return self.genericMethodIndex.get(key);
		}
		return null;
	}

	public Node? genericClassConstructor(string cls) {
		self.requireMemberIndex();
		if (self.genericConstructorIndex.has(cls)) {
			return self.genericConstructorIndex.get(cls);
		}
		return null;
	}

	/* True if `member` is a property (PropertyDecl) of class `cls` (own or
     * inherited). */

	/* The merged method set of class `cls` — own methods plus all inherited ones,
     * with the dict-merge ordering the analyzer uses: parent (already-merged)
     * methods first in their order, child's own appended, an override keeping the
     * parent's position but using the child's decl. Excludes constructors and
     * __del__. Mirrors ClassInfo.methods after _resolve_class_parents. */
	public Vector<MethodEntry> mergedMethods(string cls) {
		Vector<MethodEntry> out = [];
		if (!self.classTable.has(cls)) { return out; }
		Node decl = self.classTable.get(cls);
		Map<string, int> idx = {};
		string par = self.parentName(decl);
		if (par != "" && self.classTable.has(par)) {
			Vector<MethodEntry> pm = self.mergedMethods(par);
			int p = 0;
			while (p < pm.len) {
				MethodEntry pe = pm.get(p);
				idx.put(pe.name, out.len);
				out.push(MethodEntry(pe.name, pe.sig));
				p = p + 1;
			}
		}
		int i = 0;
		while (i < decl.members.len) {
			Node m = decl.members.get(i);
			if (m.kind == NK_METHOD_DECL && !m.isConstructor && m.name != "__del__") {
				if (idx.has(m.name)) {
					out.set(idx.get(m.name), MethodEntry(m.name, m));
				} else {
					idx.put(m.name, out.len);
					out.push(MethodEntry(m.name, m));
				}
			}
			i = i + 1;
		}
		return out;
	}
}

/* A method available on a class: its name and the MethodDecl that defines its
 * signature (own or inherited). */
class MethodEntry {
	public string name;
	public Node sig;
	public MethodEntry(string name, Node sig) {
		self.name = name;
		self.sig = sig;
	}
}

/* Precomputed expression facts consumed by raw-projection analysis. */

class RawProjectionCarrierContext {
	private Analyzed analysis;
	private Map<string, bool> preparedExpressions;
	private Map<string, Node> expressionTypes;
	private Map<string, bool> managedTypes;
	private Map<string, Node> aliasArguments;
	private Map<string, bool> overriddenExpressions;

	public RawProjectionCarrierContext(Analyzed analysis) {
		self.analysis = analysis;
		self.preparedExpressions = {};
		self.expressionTypes = {};
		self.managedTypes = {};
		self.aliasArguments = {};
		self.overriddenExpressions = {};
	}

	public bool prepared(Node expression) { return self.preparedExpressions.has(AstIdentity.key(expression)); }

	public void recordExpression(Node expression, Node? typeExpr, bool managed, bool overridden) {
		string key = AstIdentity.key(expression);
		self.preparedExpressions.put(key, true);
		if (typeExpr != null) {
			self.expressionTypes.put(key, typeExpr);
			self.managedTypes.put(TypeIdentity.shapeKey(typeExpr), managed);
		}
		if (overridden) { self.overriddenExpressions.put(key, true); }
	}

	public void recordAlias(Node expression, Node argument) { self.aliasArguments.put(AstIdentity.key(expression), argument); }

	public Node? expressionType(Node? expression) {
		if (expression == null) { return null; }
		string key = AstIdentity.key(expression);
		return self.expressionTypes.has(key) ? self.expressionTypes.get(key) : null;
	}

	public bool managedType(Node? typeExpr) { return typeExpr != null && self.managedTypes.has(TypeIdentity.shapeKey(typeExpr)) && self.managedTypes.get(TypeIdentity.shapeKey(typeExpr)); }

	public Node? aliasArgument(Node? expression) {
		if (expression == null) { return null; }
		string key = AstIdentity.key(expression);
		return self.aliasArguments.has(key) ? self.aliasArguments.get(key) : null;
	}

	public bool overridden(Node? expression) { return expression != null && self.overriddenExpressions.has(AstIdentity.key(expression)); }

	public Analyzed analyzed() { return self.analysis; }
}

class RawProjectionCarrier {
	public string kind;
	public Node expression;
	public bool directStorage;
	public Vector<RawProjectionCarrier> branches;

	public RawProjectionCarrier(string kind, Node expression, bool directStorage) {
		self.kind = kind;
		self.expression = expression;
		self.directStorage = directStorage;
		self.branches = [];
	}
}

class RawProjectionStorageRoot {
	public Node expression;
	public bool managed;

	public RawProjectionStorageRoot(Node expression, bool managed) {
		self.expression = expression;
		self.managed = managed;
	}
}
