/* Per-program semantic-validation composition and ordered validation cascade. */

import Library.Map;

import ../../frontend/Timing.btrc;
import ../../generated/ast/Node.btrc;
import ../../parser/SourceMacros.btrc;
import ../Declarations.btrc;
import ../Expressions.btrc;
import ../GPU.btrc;
import ../HostedAbi.btrc;
import ../Models.btrc;
import ../Operators.btrc;
import ../ownership/Cycles.btrc;
import ../SourceMacros.btrc;
import ../Types.btrc;
import ./Borrows.btrc;
import ./Calls.btrc;
import ./Constants.btrc;
import ./ControlFlow.btrc;
import ./Declarations.btrc;
import ./Expressions.btrc;
import ./Names.btrc;
import ./Ownership.btrc;
import ./Storage.btrc;
import ./Types.btrc;

class SemanticValidator {
	private Node program;
	private SemanticValidationState state;
	private TypeValidator types;
	private ConstantValidator constants;
	private NameValidator names;
	private StorageValidator storage;
	private OwnershipValidator ownership;
	private BorrowValidator borrows;
	private CallValidator calls;
	private ExpressionValidator expressions;
	private ControlFlowValidator controlFlow;
	private DeclarationValidator declarations;
	private IValidationRecords? records = null;

	public SemanticValidator(Node program, Analyzed analyzed, HostedAbiRepository hostedAbi, SourceMacroRules macroRules, OperatorSemantics operators, GpuSemantics gpu, CycleSemantics cycles, SourceRuntimeSymbols sourceRuntimeSymbols, SemanticTypeSystem semanticTypes, DeclarationRegistry declarationRegistry, ExpressionTypeResolver expressionTypes) {
		self.program = program;
		self.state = SemanticValidationState(analyzed);
		SourceMacroNamespace sourceMacros = SourceMacroNamespace(program, hostedAbi, macroRules, analyzed.stdlibLineCount, analyzed.sourceLines);
		analyzed.sourceMacros = sourceMacros;

		self.types = TypeValidator(self.state, operators, gpu, semanticTypes, declarationRegistry, expressionTypes);
		self.constants = ConstantValidator(self.state, self.types, sourceMacros);
		self.storage = StorageValidator(self.state, operators, self.types, self.constants);
		self.ownership = OwnershipValidator(self.state, hostedAbi, operators, self.types, self.storage);
		self.borrows = BorrowValidator(self.state, hostedAbi, self.types, self.storage, self.ownership);
		self.calls = CallValidator(self.state, hostedAbi, operators, gpu, sourceMacros, sourceRuntimeSymbols, self.types, self.storage, self.ownership, self.borrows);
		self.names = NameValidator(self.state, hostedAbi, cycles, sourceRuntimeSymbols, self.types, self.storage, self.calls);
		self.expressions = ExpressionValidator(self.state, operators, sourceMacros, sourceRuntimeSymbols, expressionTypes, self.types, self.names, self.storage, self.ownership, self.borrows, self.calls);
		self.controlFlow = ControlFlowValidator(self.state, operators, self.types, self.constants, self.names, self.storage, self.ownership, self.borrows, self.expressions, NullableFlow(self.state, self.types, hostedAbi));
		self.declarations = DeclarationValidator(self.state, hostedAbi, operators, self.types, self.constants, self.names, self.storage, self.ownership, self.expressions, self.controlFlow, GpuKernelValidator(analyzed, gpu));
	}

	public void validate() {
		self.types.validateTypedefs(self.program);
		self.declarations.validateInterfaceDeclarations(self.program);
		int index = 0;
		while (index < self.program.declarations().len) {
			Node declaration = self.program.declarations().get(index);
			if (declaration.kind == NK_CLASS_DECL) {
				self.declarations.validateClassInheritanceCycle(declaration);
			}
			index = index + 1;
		}
		BtrccPhaseTimer.mark("v-inheritance");
		self.constants.validateProgramEnumValues(self.program);
		self.types.validateAggregateDeclarationTypes(self.program);
		self.ownership.validateConcreteMutexInstances();
		self.declarations.validateStructLayouts(self.program);
		BtrccPhaseTimer.mark("v-layouts");
		self.names.validateDeclarationNames(self.program);
		self.names.validateDeclarationDuplicates(self.program);
		BtrccPhaseTimer.mark("v-names");
		self.names.publishKnownGeneratedSymbols(self.program);
		BtrccPhaseTimer.mark("v-symbols");
		self.borrows.validateNativeInvocations(self.program);
		BtrccPhaseTimer.mark("v-native-invocations");
		self.declarations.validateCallableShapes(self.program);

		BtrccPhaseTimer.mark("v-shapes");
		index = 0;
		while (index < self.program.declarations().len) {
			Node declaration = self.program.declarations().get(index);
			if (declaration.kind == NK_CLASS_DECL) {
				self.declarations.validateClassContracts(declaration);
			}
			index = index + 1;
		}

		index = 0;
		while (index < self.program.declarations().len) {
			Node declaration = self.program.declarations().get(index);
			if (declaration.kind == NK_RICH_ENUM_DECL) {
				self.declarations.validateRichEnumDefaults(declaration);
			}
			index = index + 1;
		}

		self.controlFlow.flow.computeNonreturning(self.program);
		BtrccPhaseTimer.mark("v-program");
		Map<string, Node> globals = self.declarations.globalTypes(self.state.analyzed);
		/* Field and global array bounds before any body, so every body sees
		 * which are constant whatever the declaration order. */
		for declaration in self.program.declarations() {
			if (declaration.kind == NK_CLASS_DECL) {
				for member in declaration.members() {
					if (member.kind == NK_FIELD_DECL) {
						self.controlFlow.validateArrayBound(member.type, "Field '" + declaration.name + "." + member.name + "'", "field", member, globals);
					}
				}
			} else if (declaration.kind == NK_STRUCT_DECL && !declaration.isForward) {
				for field in declaration.fields() {
					self.controlFlow.validateArrayBound(field.type, "struct field '" + declaration.name + "." + field.name + "'", "field", field, globals);
				}
			} else if (declaration.kind == NK_RICH_ENUM_DECL) {
				for variant in declaration.variants() {
					for parameter in variant.params() {
						self.controlFlow.validateArrayBound(parameter.type, "rich-enum payload '" + declaration.name + "." + variant.name + "." + parameter.name + "'", "field", parameter, globals);
					}
				}
			} else if (declaration.kind == NK_TYPEDEF_DECL) {
				self.controlFlow.validateArrayBound(declaration.original, "typedef '" + declaration.alias + "'", "global", declaration, globals);
			} else if (declaration.kind == NK_VAR_DECL_STMT && declaration.type != null) {
				self.controlFlow.validateArrayBound(declaration.type, "Global '" + declaration.name + "'", "global", declaration, globals);
			}
		}
		index = 0;
		while (index < self.program.declarations().len) {
			Node declaration = self.program.declarations().get(index);
			/* Each declaration's bodies start reachable and know no non-null facts. */
			self.controlFlow.flow.enterBody();
			if (declaration.kind == NK_FUNCTION_DECL || declaration.kind == NK_CLASS_DECL) {
				self.validateBodies(declaration);
			} else if (declaration.kind == NK_VAR_DECL_STMT) {
				/* Always live: cheap, and it extends `globals` for later
				 * globals, which a record does not carry. */
				self.controlFlow.validateVariable(declaration, globals);
			}
			index = index + 1;
		}
		BtrccPhaseTimer.mark("v-bodies");
	}

	public void useRecords(IValidationRecords? records) {
		self.records = records;
		self.state.records = records;
	}

	/* A function's or class's bodies: replayed from a validation record when
	 * its group has one, otherwise validated live (and journaled for a
	 * record when one is wanted). */
	private void validateBodies(Node declaration) {
		IValidationRecords? records = self.records;
		if (records != null) {
			Vector<ValidationFact>? facts = records.recorded(RECORD_PHASE_VALIDATE, declaration);
			if (facts != null) {
				if (self.replay(facts)) { return; }
				records.abandon(declaration);
			}
			if (records.journals(RECORD_PHASE_VALIDATE, declaration)) {
				ValidationJournal journal = ValidationJournal();
				self.state.analyzed.journal = journal;
				self.validateLive(declaration);
				self.state.analyzed.journal = null;
				if (!records.finish(RECORD_PHASE_VALIDATE, declaration, journal)) {
					TypeValidator.fail("Validation record disagrees with live validation", declaration);
				}
				return;
			}
		}
		self.validateLive(declaration);
	}

	private void validateLive(Node declaration) {
		if (declaration.kind == NK_FUNCTION_DECL) {
			self.declarations.validateCallableBody(declaration, null);
		} else {
			self.declarations.validateClassBodies(declaration);
		}
	}

	/* Installs a record's facts in their original order. Raw-borrow proofs
	 * read callee bodies, which the record's key does not cover, so each is
	 * re-proved; if one no longer holds, the replay is undone as far as it
	 * matters (deferred references are dropped; side-table writes are ones
	 * live validation repeats) and the caller validates live. */
	private bool replay(Vector<ValidationFact> facts) {
		/* Whether a callee never returns is a fact of its body: a record
		 * whose answers moved is validated live, before anything installs. */
		for fact in facts {
			if (fact.kind == VALIDATION_DIVERGENCE && self.controlFlow.flow.divergenceAnswer(fact.detail, fact.name, fact.member) != (fact.parameter == 1)) { return false; }
		}
		int references = self.names.deferredReferenceCount();
		for fact in facts {
			Node? node = fact.node;
			if (node == null) {
				self.names.truncateDeferredReferences(references);
				return false;
			}
			if (fact.kind == VALIDATION_HOSTED_CALL) {
				self.state.analyzed.recordHostedCall(node);
			} else if (fact.kind == VALIDATION_CONSTANT_BOUND) {
				self.state.analyzed.recordConstantArrayBound(node);
			} else if (fact.kind == VALIDATION_ITERATION_CAPACITY) {
				self.state.analyzed.recordArrayIterationCapacity(node);
			} else if (fact.kind == VALIDATION_GENERIC_CONSTRUCTOR) {
				Node? value = fact.value;
				if (value == null) { return false; }
				self.state.analyzed.recordGenericConstructorType(node, value);
			} else if (fact.kind == VALIDATION_GENERATED_REFERENCE) {
				self.names.deferGenerated(node, fact.directCall, fact.sourceKnown);
			} else if (fact.kind == VALIDATION_RAW_BORROW) {
				if (!self.borrows.rawParameterBorrowOnly(node, fact.parameter)) {
					self.names.truncateDeferredReferences(references);
					return false;
				}
			} else if (fact.kind == VALIDATION_CALL_ARGUMENTS) {
				self.state.analyzed.recordMethodCallArguments(node, fact.arguments);
			} else if (fact.kind == VALIDATION_WARNING) {
				self.state.analyzed.recordWarning(fact.detail, node);
			} else if (fact.kind != VALIDATION_DIVERGENCE) {
				self.names.truncateDeferredReferences(references);
				return false;
			}
		}
		return true;
	}

	public void validateCompletedGeneratedSymbols() { self.names.validateCompletedGeneratedSymbols(self.program); }
}
