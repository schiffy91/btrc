/* Semantic type compatibility, aliases, and declared-type contracts. */

import Library.Map;
import Library.Strings;
import Library.Vector;

import ../../generated/ast/Node.btrc;
import ../../syntax/Identity.btrc;
import ../../syntax/Types.btrc;
import ../Declarations.btrc;
import ../Expressions.btrc;
import ../GPU.btrc;
import ../Models.btrc;
import ../Operators.btrc;
import ../Types.btrc;

class SemanticValidationState {
	public Analyzed analyzed;
	public IValidationRecords? records = null;
	public Node? returnType;
	public string owner;
	public Map<string, bool> typeParams;
	public Map<string, Node> interfaces;
	public int loopDepth;
	public int breakDepth;
	public bool gpuCallable;
	public Node? callable;
	public Node? previousStatement;
	public Node? standaloneExpression;
	public Node? gpuArrayResultBoundary;
	public Map<string, bool> parameterNames;
	public Map<string, bool> borrowedBindings;
	/* Lexical binding identity reduced to the property needed by capture
     * analysis: whether the currently resolved name is local rather than the
     * same-spelled global. Scope entry/exit snapshots preserve shadowing. */
	public Map<string, bool> localBindings;
	/* Partially evaluated simple-enum constants, keyed by `Enum.member`.
     * The known map distinguishes a legitimate unknown macro-derived value
     * from a missing/invalid member. */
	public Map<string, int> enumConstantValues;
	public Map<string, bool> enumConstantKnown;
	/* Exact emitted-name claims that are compiler-owned call boundaries. */
	public Map<string, string> generatedSymbols;
	/* Conservative proofs for source raw-pointer parameters. */
	public Map<string, bool> rawBorrowEffects;
	public Map<string, bool> rawBorrowEffectKnown;
	public Map<string, bool> rawBorrowVisiting;
	public bool allowOwnedOpaqueVariable;
	public bool inParameterDefault;
	/* The file-scope variable being validated. A binding declared inside its
	 * initializer (a lambda local) or inside a field default has no owner
	 * either, but it is not a global. */
	public Node? globalDeclaration = null;
	/* Lambda literals spawned directly, keyed by AstIdentity.key: their
	 * results are Thread<T> results. */
	public Map<string, bool> spawnedLambdas;

	public SemanticValidationState(Analyzed analyzed) {
		self.analyzed = analyzed;
		self.returnType = null;
		self.owner = "";
		self.typeParams = {};
		self.interfaces = {};
		self.loopDepth = 0;
		self.breakDepth = 0;
		self.gpuCallable = false;
		self.callable = null;
		self.previousStatement = null;
		self.standaloneExpression = null;
		self.gpuArrayResultBoundary = null;
		self.parameterNames = {};
		self.borrowedBindings = {};
		self.localBindings = {};
		self.enumConstantValues = {};
		self.enumConstantKnown = {};
		self.generatedSymbols = {};
		self.rawBorrowEffects = {};
		self.rawBorrowEffectKnown = {};
		self.rawBorrowVisiting = {};
		self.allowOwnedOpaqueVariable = false;
		self.inParameterDefault = false;
		self.spawnedLambdas = {};
	}
}

class TypeValidator {
	private SemanticValidationState state;
	private OperatorSemantics operators;
	private GpuSemantics gpu;
	private SemanticTypeSystem semanticTypes;
	private DeclarationRegistry declarationRegistry;
	private ExpressionTypeResolver expressionTypes;

	public TypeValidator(SemanticValidationState state, OperatorSemantics operators, GpuSemantics gpu, SemanticTypeSystem semanticTypes, DeclarationRegistry declarationRegistry, ExpressionTypeResolver expressionTypes) {
		self.state = state;
		self.operators = operators;
		self.gpu = gpu;
		self.semanticTypes = semanticTypes;
		self.declarationRegistry = declarationRegistry;
		self.expressionTypes = expressionTypes;
	}

	class bool scalarVoid(Node? typeExpr) { return typeExpr != null && typeExpr.base == "void" && typeExpr.pointerDepth == 0 && !typeExpr.isArray && typeExpr.genericArgs().len == 0; }

	class void fail(string message, Node site) {
		fprintf(stderr, "error: %s at %d:%d\n", message, site.line, site.col);
		exit(1);
	}

	/* Explain a tuple literal flowing into a non-tuple (D19 row 19): btrc reads
	 * a parenthesized comma list as a tuple; C's comma operator exists only in
	 * for headers. */
	class string commaTupleHint(Node? value, Node? target) {
		if (value != null && value.kind == NK_TUPLE_LITERAL && target != null && target.base != "Tuple") {
			return "; btrc reads a parenthesized comma list as a tuple, not C's comma operator";
		}
		return "";
	}

	/* A declaration's name token, where the reference reports a duplicate. */
	class void failAtName(string message, Node declaration) {
		int line = declaration.nameLine != 0 ? declaration.nameLine : declaration.line;
		int col = declaration.nameLine != 0 ? declaration.nameCol : declaration.col;
		fprintf(stderr, "error: %s at %d:%d\n", message, line, col);
		exit(1);
	}

	class Map<string, Node> cloneTypes(Map<string, Node> source) {
		Map<string, Node> result = {};
		result.merge(source);
		return result;
	}

	public Map<string, bool> typeParamSet(Vector<string> names) {
		Map<string, bool> result = {};
		int index = 0;
		while (index < names.len) {
			result.put(names.get(index), true);
			index = index + 1;
		}
		return result;
	}

	public Map<string, bool> cloneFlags(Map<string, bool> source) {
		Map<string, bool> result = {};
		Vector<string> keys = source.keys();
		int index = 0;
		while (index < keys.len) {
			string key = keys.get(index);
			result.put(key, source.get(key));
			index = index + 1;
		}
		return result;
	}

	public Map<string, bool> combinedTypeParams(Vector<string> classParams, Vector<string> methodParams) {
		Map<string, bool> result = self.typeParamSet(classParams);
		int index = 0;
		while (index < methodParams.len) {
			result.put(methodParams.get(index), true);
			index = index + 1;
		}
		return result;
	}

	/* Format a type as its source spells it: a nullable reference as `T?`,
	 * generic arguments likewise. */
	public string formatWrittenType(Node? typeExpr) {
		if (typeExpr == null) { return "<unknown>"; }
		string result = typeExpr.isConst ? "const " : "";
		if (typeExpr.base == "__fn_ptr") { result = result + "CFunction"; } else if (typeExpr.base == "__realtime_fn_ptr") { result = result + "RealtimeFunction"; } else { result = result + typeExpr.base; }
		if (typeExpr.genericArgs().len > 0) {
			result = result + "<";
			int index = 0;
			for argument in typeExpr.genericArgs() {
				if (index > 0) { result = result + ", "; }
				result = result + self.formatWrittenType(argument);
				index = index + 1;
			}
			result = result + ">";
		}
		int stars = typeExpr.pointerDepth - (typeExpr.isNullable ? 1 : 0);
		while (stars > 0) { result = result + "*"; stars = stars - 1; }
		if (typeExpr.isNullable) { result = result + "?"; }
		if (typeExpr.isArray) { result = result + "[]"; }
		return result;
	}

	public string formatType(Node? typeExpr) {
		if (typeExpr == null) { return "<unknown>"; }
		string result = typeExpr.isConst ? "const " : "";
		if (typeExpr.base == "__fn_ptr") {
			result = result + "CFunction";
		} else if (typeExpr.base == "__realtime_fn_ptr") {
			result = result + "RealtimeFunction";
		} else {
			result = result + typeExpr.base;
		}
		if (typeExpr.genericArgs().len > 0) {
			result = result + "<";
			int index = 0;
			while (index < typeExpr.genericArgs().len) {
				if (index > 0) { result = result + ", "; }
				result = result + self.formatType(typeExpr.genericArgs().get(index));
				index = index + 1;
			}
			result = result + ">";
		}
		int pointer = 0;
		while (pointer < typeExpr.pointerDepth) {
			result = result + "*";
			pointer = pointer + 1;
		}
		if (typeExpr.isArray) { result = result + "[]"; }
		return result;
	}

	public bool typeContainsParams(Node? typeExpr, Map<string, bool> typeParams) {
		if (typeExpr == null) { return false; }
		if (typeParams.has(typeExpr.base)) { return true; }
		int index = 0;
		while (index < typeExpr.genericArgs().len) {
			if (self.typeContainsParams(typeExpr.genericArgs().get(index), typeParams)) {
				return true;
			}
			index = index + 1;
		}
		return false;
	}

	public bool integralType(Node? typeExpr, Analyzed analyzed) { return typeExpr != null && NumericSemantics.isType(typeExpr, analyzed) && !NumericSemantics.isFloating(typeExpr); }

	public void rejectRuntimeInterfaceType(Node? typeExpr, Node site) {
		Node? resolvedType = self.resolveAliases(typeExpr);
		if (resolvedType == null) { return; }
		if (self.state.typeParams.has(resolvedType.base)) { return; }
		if (self.state.interfaces.has(resolvedType.base) && self.state.interfaces.get(resolvedType.base).genericParams().len > 0) {
			TypeValidator.fail("Generic interface type '" + resolvedType.base + "' cannot be used as a runtime value yet", site);
		}
		int index = 0;
		while (index < resolvedType.genericArgs().len) {
			self.rejectRuntimeInterfaceType(resolvedType.genericArgs().get(index), site);
			index = index + 1;
		}
	}

	public Node? resolveAliases(Node? typeExpr) { return self.semanticTypes.canonical(typeExpr); }

	public Node? arrayValueType(Node? typeExpr) {
		Node? canonical = self.resolveAliases(typeExpr);
		if (typeExpr == null || canonical == null || typeExpr.isArray || !canonical.isArray) {
			return typeExpr;
		}
		return TypeShape.withOuterPointer(TypeShape.withoutOuterArray(canonical));
	}

	public Node? inferType(Node? expression, Map<string, Node> vars) {
		if (expression != null && expression.kind == NK_INDEX_EXPR) {
			Node? objectType = self.inferType(expression.obj,  vars);
			return self.resolveAliases(self.indexResultType(objectType));
		}
		if (self.state.gpuCallable) {
			return self.resolveAliases(self.gpu.contextualExprType(expression, vars));
		}
		return self.resolveAliases(self.expressionTypes.infer(expression, vars));
	}

	public Node? inferRaw(Node? expression, Map<string, Node> vars) { return self.expressionTypes.inferRaw(expression, vars); }

	public Node? indexResultType(Node? objectType) {
		if (objectType == null || (objectType.base == "Tuple" && !objectType.isArray && objectType.pointerDepth == 0)) { return null; }
		if (SemanticTypeSystem.isString(objectType)) {
			Node character = SemanticTypeSystem.primitive("char");
			character.isConst = objectType.isConst;
			return character;
		}
		if (objectType.isArray) {
			return TypeShape.withoutOuterArray(objectType);
		}
		if (objectType.pointerDepth > 0 && (!self.state.analyzed.isClass(objectType.base) && !self.state.analyzed.isGenericClass(objectType.base) || objectType.pointerDepth > 1)) {
			return TypeShape.withoutOuterPointers(objectType, 1);
		}
		Node? getter = self.indexedMethod(objectType, "get");
		Node? result = null;
		if (getter != null && getter.access != "class" && getter.genericParams().len == 0 && getter.params().len == 1 && !getter.params().get(0).keep_ && getter.returnType != null && !TypeValidator.scalarVoid(getter.returnType)) {
			result = getter.returnType;
		} else {
			Node? setter = self.indexedMethod(objectType, "set");
			if (setter != null && setter.access != "class" && setter.genericParams().len == 0 && setter.params().len == 2 && !setter.params().get(0).keep_ && TypeValidator.scalarVoid(setter.returnType)) {
				result = setter.params().get(1).type;
			}
		}
		if (result == null) { return null; }
		if (self.state.analyzed.isGenericClass(objectType.base) && objectType.genericArgs().len > 0) {
			return SemanticTypeSystem.resolveGenericType(result, SemanticTypeSystem.genericTypeMap(self.state.analyzed, objectType), self.state.analyzed);
		}
		return result;
	}

	private Node? indexedMethod(Node objectType, string name) {
		if (self.state.typeParams.has(objectType.base) || objectType.isArray) { return null; }
		if (self.state.analyzed.isGenericClass(objectType.base) && objectType.pointerDepth <= 1) {
			return self.state.analyzed.genericClassMethod(objectType.base, name);
		}
		if (self.state.analyzed.isClass(objectType.base)) {
			return self.state.analyzed.classMethod(objectType.base, name);
		}
		return null;
	}

	public bool containsThreadStorage(Node? typeExpr) {
		Node? canonical = self.resolveAliases(typeExpr);
		if (canonical == null) { return false; }
		if (canonical.base == "Thread") { return true; }
		int index = (canonical.base == "__fn_ptr" || canonical.base == "__realtime_fn_ptr") ? 1 : 0;
		while (index < canonical.genericArgs().len) {
			if (self.containsThreadStorage(canonical.genericArgs().get(index))) {
				return true;
			}
			index = index + 1;
		}
		return false;
	}

	public bool containsRealtimeFunctionStorage(Node? typeExpr) {
		Map<string, bool> visiting = {};
		return self.containsRealtimeFunctionStorageInner(typeExpr, visiting);
	}

	private bool containsRealtimeFunctionStorageInner(Node? typeExpr, Map<string, bool> visiting) {
		Node? canonical = self.resolveAliases(typeExpr);
		if (canonical == null) { return false; }
		if (canonical.base == "__realtime_fn_ptr") { return true; }
		int argument = 0;
		while (argument < canonical.genericArgs().len) {
			if (self.containsRealtimeFunctionStorageInner(canonical.genericArgs().get(argument), visiting)) { return true; }
			argument = argument + 1;
		}
		if (canonical.pointerDepth > 0) { return false; }
		string name = canonical.base;
		name = SemanticTypeSystem.recordTagName(name);
		if (visiting.has(name) || !self.state.analyzed.structTable.has(name)) { return false; }
		Node declaration = self.state.analyzed.structTable.get(name);
		if (declaration.isForward) { return false; }
		Map<string, bool> nested = self.cloneFlags(visiting);
		nested.put(name, true);
		Vector<Node> declarationFields = SemanticTypeSystem.recordFields(declaration);
		int field = 0;
		while (field < declarationFields.len) {
			if (self.containsRealtimeFunctionStorageInner(declarationFields.get(field).type, nested)) { return true; }
			field = field + 1;
		}
		return false;
	}

	public bool directManagedThreadResult(Node? typeExpr) {
		Node? canonical = self.resolveAliases(typeExpr);
		if (canonical == null || canonical.isArray) { return false; }
		return TypeComposition.isSemanticScalarString(canonical) || (canonical.pointerDepth <= 1 && (self.state.analyzed.isClass(canonical.base) || (canonical.genericArgs().len > 0 && self.state.analyzed.isGenericClass(canonical.base))));
	}

	private bool aggregateTypeMatches(Node? typeExpr, int query, Map<string, bool> visiting) {
		Node? canonical = self.resolveAliases(typeExpr);
		if (canonical == null) { return false; }
		if (query == 1 && canonical.base == "Mutex") { return true; }
		if (query == 2 && canonical.base == "Thread") { return true; }
		if (query == 6 && canonical.base == "Span") { return true; }
		/* Function pointers retain code, not their parameter values. Generic
		 * slots are validated independently as return/parameter domains. */
		if (query == 6 && (canonical.base == "__fn_ptr" || canonical.base == "__realtime_fn_ptr")) { return false; }
		if (query == 7 && canonical.base == "Atomic" && canonical.pointerDepth == 0) {
			return true;
		}
		if (canonical.isArray) {
			if (query == 3 && canonical.arraySize == null) { return true; }
			if (query == 4) { return true; }
			return self.aggregateTypeMatches(TypeShape.withoutOuterArray(canonical), query, visiting);
		}
		if (query == 5 && self.directManagedThreadResult(canonical)) {
			return true;
		}
		int argumentIndex = (canonical.base == "__fn_ptr" || canonical.base == "__realtime_fn_ptr") ? 1 : 0;
		while (argumentIndex < canonical.genericArgs().len) {
			if (self.aggregateTypeMatches(canonical.genericArgs().get(argumentIndex), query, visiting)) {
				return true;
			}
			argumentIndex = argumentIndex + 1;
		}
		if (canonical.pointerDepth > 0) { return false; }
		string name = canonical.base;
		name = SemanticTypeSystem.recordTagName(name);
		string key = (self.state.analyzed.structTable.has(name) ? "struct:" : "rich-enum:") + name;
		if (visiting.has(key)) { return false; }
		Map<string, bool> nested = self.cloneFlags(visiting);
		nested.put(key, true);
		if (self.state.analyzed.structTable.has(name)) {
			Node declaration = self.state.analyzed.structTable.get(name);
			if (!declaration.isForward) {
				Vector<Node> declarationFields = SemanticTypeSystem.recordFields(declaration);
				int fieldIndex = 0;
				while (fieldIndex < declarationFields.len) {
					if (self.aggregateTypeMatches(declarationFields.get(fieldIndex).type, query, nested)) {
						return true;
					}
					fieldIndex = fieldIndex + 1;
				}
			}
		}
		if (self.state.analyzed.richEnumTable.has(name)) {
			Node declaration = self.state.analyzed.richEnumTable.get(name);
			int variantIndex = 0;
			while (variantIndex < declaration.variants().len) {
				Node variant = declaration.variants().get(variantIndex);
				int parameterIndex = 0;
				while (parameterIndex < variant.params().len) {
					if (self.aggregateTypeMatches(variant.params().get(parameterIndex).type, query, nested)) {
						return true;
					}
					parameterIndex = parameterIndex + 1;
				}
				variantIndex = variantIndex + 1;
			}
		}
		return false;
	}

	public bool containsMutexStorage(Node? typeExpr) {
		Map<string, bool> visiting = {};
		return self.aggregateTypeMatches(typeExpr, 1, visiting);
	}

	public bool containsSpanStorage(Node? typeExpr) {
		Map<string, bool> visiting = {};
		return self.aggregateTypeMatches(typeExpr, 6, visiting);
	}

	public bool containsAtomicStorage(Node? typeExpr) {
		Map<string, bool> visiting = {};
		return self.aggregateTypeMatches(typeExpr, 7, visiting);
	}

	class string recordName(string base) { return base.startsWith("struct ") ? base.substring(7, base.length() - 7) : base; }

	class string threadAggregateResultMessage() { return "Thread<T> aggregate result type cannot contain string or class references; return the managed value directly or use a scalar-only aggregate"; }

	class string nonescapingRichEnumReason() { return "its managed payloads are borrowed references that it never retains"; }

	/* A rich-enum value never retains its payloads, so one that carries a
	 * string, class, interface or collection is a lexical borrow like Span<T>.
	 * Returns that enum's name, or "" when the type is not one. */
	public string nonescapingRichEnum(Node? typeExpr) {
		Node? canonical = self.resolveAliases(typeExpr);
		if (canonical == null || !self.state.analyzed.richEnumTable.has(canonical.base)) { return ""; }
		Node declaration = self.state.analyzed.richEnumTable.get(canonical.base);
		Map<string, bool> visiting = {};
		visiting.put("rich-enum:" + declaration.name, true);
		for variant in declaration.variants() {
			for parameter in variant.params() {
				if (self.payloadBorrowsManagedReference(parameter.type, visiting)) { return declaration.name; }
			}
		}
		return "";
	}

	private bool payloadBorrowsManagedReference(Node? typeExpr, Map<string, bool> visiting) {
		Node? canonical = self.resolveAliases(typeExpr);
		if (canonical == null) { return false; }
		if (canonical.isArray) { return self.payloadBorrowsManagedReference(TypeShape.withoutOuterArray(canonical), visiting); }
		if (TypeComposition.isSemanticScalarString(canonical)) { return true; }
		if (canonical.pointerDepth <= 1 && (self.state.analyzed.isClass(canonical.base) || self.state.analyzed.isInterface(canonical.base) || (canonical.genericArgs().len > 0 && self.state.analyzed.isGenericClass(canonical.base)))) {
			return true;
		}
		if (canonical.pointerDepth > 0 || canonical.base == "__fn_ptr" || canonical.base == "__realtime_fn_ptr") { return false; }
		if (canonical.base == "Tuple") {
			for argument in canonical.genericArgs() {
				if (self.payloadBorrowsManagedReference(argument, visiting)) { return true; }
			}
			return false;
		}
		Map<string, bool>? nested = self.nestedAggregateVisit(canonical, visiting);
		if (nested == null) { return false; }
		Map<string, bool> fieldVisiting = nested;
		for field in self.aggregateFieldTypes(canonical) {
			if (self.payloadBorrowsManagedReference(field, fieldVisiting)) { return true; }
		}
		return false;
	}

	/* The nonescaping rich enum this storage transitively contains, or "". */
	public string containsNonescapingRichEnum(Node? typeExpr, Map<string, bool> visiting) {
		Node? canonical = self.resolveAliases(typeExpr);
		if (canonical == null) { return ""; }
		string direct = self.nonescapingRichEnum(canonical);
		if (direct != "") { return direct; }
		/* Thread<T> results have their own refusal: an aggregate result with a
		 * string or class reference, which every nonescaping rich enum carries. */
		if (canonical.base == "__fn_ptr" || canonical.base == "__realtime_fn_ptr" || canonical.base == "Thread") { return ""; }
		for argument in canonical.genericArgs() {
			string contained = self.containsNonescapingRichEnum(argument, visiting);
			if (contained != "") { return contained; }
		}
		if (canonical.pointerDepth > 0) { return ""; }
		Map<string, bool>? nested = self.nestedAggregateVisit(canonical, visiting);
		if (nested == null) { return ""; }
		Map<string, bool> fieldVisiting = nested;
		for field in self.aggregateFieldTypes(canonical) {
			string contained = self.containsNonescapingRichEnum(field, fieldVisiting);
			if (contained != "") { return contained; }
		}
		return "";
	}

	/* The visiting set for one struct or rich-enum layer, or null when that
	 * layer is already on the path (mirrors the reference `_aggregate_field_types`). */
	private Map<string, bool>? nestedAggregateVisit(Node canonical, Map<string, bool> visiting) {
		string name = TypeValidator.recordName(canonical.base);
		string key = (self.state.analyzed.structTable.has(name) ? "struct:" : "rich-enum:") + name;
		if (visiting.has(key)) { return null; }
		Map<string, bool> nested = self.cloneFlags(visiting);
		nested.put(key, true);
		return nested;
	}

	private Vector<Node> aggregateFieldTypes(Node canonical) {
		Vector<Node> fieldTypes = [];
		string name = TypeValidator.recordName(canonical.base);
		if (self.state.analyzed.structTable.has(name)) {
			Node declaration = self.state.analyzed.structTable.get(name);
			if (!declaration.isForward) {
				for field in SemanticTypeSystem.recordFields(declaration) { fieldTypes.push(field.type); }
			}
			return fieldTypes;
		}
		if (self.state.analyzed.richEnumTable.has(name)) {
			for variant in self.state.analyzed.richEnumTable.get(name).variants() {
				for parameter in variant.params() { fieldTypes.push(parameter.type); }
			}
		}
		return fieldTypes;
	}

	/* A borrowing rich enum is a direct lexical local or parameter only. */
	public void validateNonescapingRichEnumRole(Node? canonical, string subject, string role, Node site) {
		if (canonical == null) { return; }
		string richEnum = self.nonescapingRichEnum(canonical);
		if (richEnum == "") {
			Map<string, bool> visiting = {};
			string contained = self.containsNonescapingRichEnum(canonical, visiting);
			if (contained != "") {
				TypeValidator.fail(subject + " cannot contain nonescaping rich enum '" + contained + "' in aggregate or managed storage", site);
			}
			return;
		}
		if (canonical.pointerDepth > 0 || canonical.isArray || canonical.isNullable) {
			TypeValidator.fail("Rich enum '" + richEnum + "' borrows its managed payloads and must be one direct value; " + "pointer, nullable and array shapes are not supported", site);
		}
		if (role == "field" || role == "stable_field") {
			TypeValidator.fail(subject + " cannot store nonescaping rich enum '" + richEnum + "'; " + TypeValidator.nonescapingRichEnumReason(), site);
		}
		if (role == "return") {
			TypeValidator.fail(subject + " cannot be nonescaping rich enum '" + richEnum + "'; " + TypeValidator.nonescapingRichEnumReason(), site);
		}
	}

	public bool threadAggregateHasManagedReference(Node? typeExpr, Map<string, bool> visiting) { return self.aggregateTypeMatches(typeExpr, 5, visiting); }

	public bool threadResultHasUnsizedArray(Node? typeExpr, Map<string, bool> visiting) { return self.aggregateTypeMatches(typeExpr, 3, visiting); }

	public void validateMutexPayloadsInType(Node? typeExpr, Node site) {
		Node? canonical = self.resolveAliases(typeExpr);
		if (canonical == null) { return; }
		if (canonical.base == "Mutex" && canonical.genericArgs().len == 1) {
			Node payload = canonical.genericArgs().get(0);
			Map<string, bool> visiting = {};
			string problem = "";
			if (self.aggregateTypeMatches(payload, 2, visiting)) {
				problem = "cannot contain a Thread handle";
			} else {
				visiting = {};
				if (self.aggregateTypeMatches(payload, 1, visiting)) {
					problem = "cannot contain a Mutex handle";
				} else {
					visiting = {};
					if (self.aggregateTypeMatches(payload, 4, visiting)) {
						problem = "cannot contain array storage";
					} else if (!self.directManagedThreadResult(payload)) {
						visiting = {};
						if (self.aggregateTypeMatches(payload, 5, visiting)) {
							problem = "aggregate cannot contain string or class references";
						}
					}
				}
			}
			if (problem != "") {
				TypeValidator.fail("Mutex<T> payload type " + problem, site);
			}
		}
		int index = 0;
		while (index < canonical.genericArgs().len) {
			self.validateMutexPayloadsInType(canonical.genericArgs().get(index), site);
			index = index + 1;
		}
	}

	public void validateArrayReturn(Node callable, string label) {
		if (callable.returnType != null && callable.returnType.isArray && !callable.isGpu) {
			TypeValidator.fail(label + " cannot return an array outside @gpu", callable);
		}
	}

	public bool managedOwnershipType(Node? typeExpr) {
		if (typeExpr == null) { return false; }
		if (self.state.typeParams.has(typeExpr.base)) {
			return !typeExpr.isArray && (typeExpr.pointerDepth == 0 || (typeExpr.isNullable && typeExpr.pointerDepth == 1));
		}
		return !typeExpr.isArray && typeExpr.pointerDepth <= 1 && (SemanticTypeSystem.isString(typeExpr) || (typeExpr.base == "Mutex" && typeExpr.genericArgs().len == 1 && typeExpr.pointerDepth == 0) || self.state.analyzed.isClass(typeExpr.base) || self.state.analyzed.isGenericClass(typeExpr.base));
	}

	public Node arrayElementType(Node arrayType) {
		Node element = TypeShape.withoutOuterArray(arrayType);
		element.isStatic = false;
		element.isExtern = false;
		return element;
	}

	public bool contextualAggregateInitializer(Node? initializer) { return initializer != null && (initializer.kind == NK_BRACE_INITIALIZER || initializer.kind == NK_LIST_LITERAL || initializer.kind == NK_MAP_LITERAL); }

	public bool gpuArrayResultCall(Node? expression, Map<string, Node> variables) {
		if (expression == null || expression.kind != NK_CALL_EXPR || expression.callee == null || expression.callee.kind != NK_IDENTIFIER) {
			return false;
		}
		string name = expression.callee.name;
		if (variables.has(name) || !self.state.analyzed.funcTable.has(name)) {
			return false;
		}
		Node declaration = self.state.analyzed.funcTable.get(name);
		return declaration.kind == NK_FUNCTION_DECL && declaration.isGpu && declaration.returnType != null && declaration.returnType.isArray;
	}

	public bool gpuOutputCollectionType(Node? typeExpr) { return self.gpu.outputCollectionType(typeExpr); }

	public Node? binaryOverloadMethod(Node? leftType, string op) {
		string magic = self.operators.binaryMethodName(op);
		Node? receiver = self.resolveAliases(leftType);
		if (magic == "" || receiver == null) { return null; }
		Node concreteReceiver = receiver;
		Node? method = null;
		if (self.state.analyzed.isClass(concreteReceiver.base)) {
			method = self.state.analyzed.classMethod(concreteReceiver.base, magic);
		} else if (self.state.analyzed.isGenericClass(concreteReceiver.base)) {
			method = self.state.analyzed.genericClassMethod(concreteReceiver.base, magic);
		}
		if (method == null || method.kind != NK_METHOD_DECL) { return null; }
		return method;
	}

	public Node resolvedBinaryOverloadType(Node declaredType, Node receiverType) {
		Node resolved = declaredType;
		Node? receiver = self.resolveAliases(receiverType);
		if (receiver != null) {
			Node concreteReceiver = receiver;
			if (concreteReceiver.genericArgs().len > 0 && self.state.analyzed.isGenericClass(concreteReceiver.base)) {
				resolved = SemanticTypeSystem.resolveGenericType(declaredType, SemanticTypeSystem.genericTypeMap(self.state.analyzed, concreteReceiver), self.state.analyzed);
			}
		}
		Node? canonical = self.resolveAliases(resolved);
		if (canonical != null) { return canonical; }
		return resolved;
	}

	public bool hasBinaryOverload(Node leftType, string op) { return self.binaryOverloadMethod(leftType, op) != null; }

	public bool hasUnaryOverload(Node operandType, string op) {
		if (op != "-") { return false; }
		Node? method = null;
		if (self.state.analyzed.isClass(operandType.base)) {
			method = self.state.analyzed.classMethod(operandType.base, "__neg__");
		} else if (self.state.analyzed.isGenericClass(operandType.base)) {
			method = self.state.analyzed.genericClassMethod(operandType.base, "__neg__");
		}
		return method != null && method.kind == NK_METHOD_DECL;
	}

	public void operatorFailure(Node expression, Node left, Node right) { TypeValidator.fail("Operator '" + expression.op + "' is not defined for '" + self.formatType(left) + "' and '" + self.formatType(right) + "'", expression); }

	public void validatePortableNumericMix(Node site, Node left, Node right, string context) {
		if (NumericSemantics.isType(left, self.state.analyzed) && NumericSemantics.isType(right, self.state.analyzed) && !NumericSemantics.integerMixIsPortable(left, right)) {
			TypeValidator.fail(context + " mixes ABI-dependent integer type '" + self.formatType(left) + "' with '" + self.formatType(right) + "'; cast explicitly to a fixed-width or built-in integer type", site);
		}
	}

	public bool threadCopySource(Node value) {
		if (value.kind == NK_SPAWN_EXPR || value.kind == NK_CALL_EXPR || value.kind == NK_NULL_LITERAL) {
			return false;
		}
		if (value.kind == NK_TERNARY_EXPR) {
			return self.threadCopySource(value.trueExpr) || self.threadCopySource(value.falseExpr);
		}
		return true;
	}

	public bool scalarConditionType(Node? typeExpr) { return typeExpr != null && (NumericSemantics.isType(typeExpr, self.state.analyzed) || self.operators.isReferenceType(typeExpr)); }

	public void validateRealtimeFunctionValue(Node? expected, Node? value, Map<string, Node> variables) {
		Node? canonical = self.resolveAliases(expected);
		if (canonical == null || canonical.base != "__realtime_fn_ptr" || canonical.pointerDepth != 0 || canonical.isArray || value == null) { return; }
		Node? actual = self.resolveAliases(self.inferType(value, variables));
		bool exactCopy = actual != null && actual.base == "__realtime_fn_ptr" && self.assignmentCompatible(canonical, actual) && value.kind != NK_CAST_EXPR;
		bool directRoot = false;
		if (value.kind == NK_IDENTIFIER && !variables.has(value.name) && self.state.analyzed.funcTable.has(value.name)) {
			Node declaration = self.state.analyzed.funcTable.get(value.name);
			Node directType = CallableSignature.sourceFunctionPointer(declaration);
			directRoot = declaration.isRealtime && self.assignmentCompatible(canonical, directType);
		}
		if (!exactCopy && !directRoot) {
			TypeValidator.fail("RealtimeFunction value must be a direct named " + "@realtime function or an exact RealtimeFunction copy", value);
		}
	}

	public void validateTypedInitializer(Node? expected, Node? initializer, string subject, Map<string, Node> variables, Node? site = null) {
		if (expected != null && initializer != null && initializer.kind == NK_BRACE_INITIALIZER) {
			self.validateRecordInitializerArity(expected, initializer, subject, site != null ? site : initializer);
		}
		if (expected == null || initializer == null || self.contextualAggregateInitializer(initializer)) {
			return;
		}
		self.validateRealtimeFunctionValue(expected, initializer, variables);
		Node? actual = self.inferType(initializer, variables);
		if (actual != null && !self.assignmentCompatible(expected, actual)) {
			string hint = subject == "Assignment" ? TypeValidator.commaTupleHint(initializer, expected) : "";
			TypeValidator.fail(subject + " expects '" + self.formatType(expected) + "' but got '" + self.formatType(actual) + "'" + hint, initializer);
		}
	}

	/* A brace list passed or assigned as a record has no more elements than
	 * the record has positional slots (one for a union), as in a declaration. */
	public void validateRecordInitializerArity(Node expected, Node initializer, string subject, Node site) {
		Node? canonical = self.resolveAliases(expected);
		if (canonical == null || canonical.pointerDepth != 0 || canonical.isArray) { return; }
		string name = SemanticTypeSystem.recordTagName(canonical.base);
		if (!self.state.analyzed.structTable.has(name)) { return; }
		Node declaration = self.state.analyzed.structTable.get(name);
		if (declaration.isForward) { return; }
		SemanticInitializerPlan plan = SemanticTypeSystem.planInitializerSlots(declaration, initializer, self.state.analyzed);
		if (plan.excess == 0) { return; }
		if (declaration.isUnion) {
			TypeValidator.fail("Union '" + declaration.name + "' initializer has " + Strings.fromInt(initializer.elements().len) + " elements; a positional union initializer sets only the first member (use a designator such as {.f = ...})", initializer);
		}
		TypeValidator.fail(subject + " has " + Strings.fromInt(initializer.elements().len) + " initializer elements but struct '" + declaration.name + "' has " + Strings.fromInt(plan.capacity) + " fields", site);
	}

	public Node? richEnumVariant(string enumName, string variantName) {
		if (!self.state.analyzed.richEnumTable.has(enumName)) { return null; }
		Node declaration = self.state.analyzed.richEnumTable.get(enumName);
		int index = 0;
		while (index < declaration.variants().len) {
			Node variant = declaration.variants().get(index);
			if (variant.name == variantName) { return variant; }
			index = index + 1;
		}
		return null;
	}

	public Map<string, Node> genericClassMap(Node declaration, Vector<Node> arguments) {
		Map<string, Node> substitutions = {};
		int index = 0;
		while (index < declaration.genericParams().len && index < arguments.len) {
			substitutions.put(declaration.genericParams().get(index), arguments.get(index));
			index = index + 1;
		}
		return substitutions;
	}

	public Node? inferSpecialization(Node? expression, Map<string, Node> vars) { return self.expressionTypes.inferSpecialization(expression, vars); }

	public bool aliasTypesSame(Node? left, Node? right) {
		Node? resolvedLeft = self.resolveAliases(left);
		Node? resolvedRight = self.resolveAliases(right);
		if (resolvedLeft == null || resolvedRight == null) {
			return resolvedLeft == null && resolvedRight == null;
		}
		return TypeIdentity.shapeKey(resolvedLeft) == TypeIdentity.shapeKey(resolvedRight);
	}

	public void validateTypedefs(Node program) {
		int index = 0;
		while (index < program.declarations().len) {
			Node declaration = program.declarations().get(index);
			if (declaration.kind == NK_TYPEDEF_DECL) {
				self.semanticTypes.canonical(declaration.original);
			}
			index = index + 1;
		}
	}

	public int assignmentDepth(Node typeExpr, OperatorSemantics operators) { return operators.valueDepth(typeExpr); }

	public bool sameTypeShape(Node left, Node right, OperatorSemantics operators) { return left.base == right.base && self.assignmentDepth(left, operators) == self.assignmentDepth(right, operators) && left.isArray == right.isArray && operators.genericArgsEqual(left.genericArgs(), right.genericArgs()); }

	public bool callableComponentSameTypeShape(Node left, Node right, OperatorSemantics operators) { return left.base == right.base && operators.valueDepth(left) == operators.valueDepth(right) && left.isArray == right.isArray && left.isNullable == right.isNullable && left.nullableOuterDepth == right.nullableOuterDepth && left.isConst == right.isConst && left.isVolatile == right.isVolatile && operators.genericArgsEqual(left.genericArgs(), right.genericArgs()); }

	public bool callableAssignmentCompatible(Node target, Node source, OperatorSemantics operators) {
		bool targetCallable = target.base == "__fn_ptr" || target.base == "__realtime_fn_ptr";
		bool sourceCallable = source.base == "__fn_ptr" || source.base == "__realtime_fn_ptr";
		if (!targetCallable || !sourceCallable || target.genericArgs().len == 0 || target.genericArgs().len != source.genericArgs().len) {
			return false;
		}
		Node targetReturn = target.genericArgs().get(0);
		Node sourceReturn = source.genericArgs().get(0);
		if (!self.callableComponentSameTypeShape(targetReturn, sourceReturn, operators)) {
			return false;
		}
		int index = 1;
		while (index < target.genericArgs().len) {
			if (!self.callableComponentSameTypeShape(target.genericArgs().get(index), source.genericArgs().get(index), operators)) {
				return false;
			}
			index = index + 1;
		}
		return true;
	}

	/* Const layers of callable signature components, read before typedefs
	 * flatten them. Flattening puts a slot const (`Handle const*` with Handle =
	 * S*) and a pointee const (`const S**`) on one shape; C keeps them distinct,
	 * as the Python TypeSystem.types_equal does through declaration_const_depths.
	 * Callers pass the argument's unflattened type; only callables are compared. */
	public bool callableConstLayersMatch(Node? target, Node? source) {
		Map<string, Node> typedefs = self.state.analyzed.typedefTable;
		Node? left = SemanticTypeSystem.resolveOuterTypedefType(target, typedefs);
		Node? right = SemanticTypeSystem.resolveOuterTypedefType(source, typedefs);
		if (left == null || right == null || left.pointerDepth != 0 || right.pointerDepth != 0 || left.isArray || right.isArray) { return true; }
		bool leftCallable = left.base == "__fn_ptr" || left.base == "__realtime_fn_ptr";
		bool rightCallable = right.base == "__fn_ptr" || right.base == "__realtime_fn_ptr";
		if (!leftCallable || !rightCallable || left.genericArgs().len != right.genericArgs().len) { return true; }
		for index in range(left.genericArgs().len) {
			Node first = left.genericArgs().get(index);
			Node second = right.genericArgs().get(index);
			int layers = 2;
			for component in [first, second] {
				Node? flat = self.resolveAliases(component);
				if (flat != null && flat.pointerDepth + (flat.isArray ? 1 : 0) + 2 > layers) { layers = flat.pointerDepth + (flat.isArray ? 1 : 0) + 2; }
			}
			for depth in range(layers) {
				if (SemanticTypeSystem.typeConstAtDepth(first, typedefs, depth) != SemanticTypeSystem.typeConstAtDepth(second, typedefs, depth)) { return false; }
			}
			if (!self.callableConstLayersMatch(first, second)) { return false; }
		}
		return true;
	}

	/* An argument passed to a callable parameter keeps its declared const layers. */
	public bool argumentConstLayersMatch(Node? expected, Node argument, Map<string, Node> vars) {
		Node? callable = SemanticTypeSystem.directFunctionPointerSpecialization(expected, self.state.analyzed);
		if (callable == null) { return true; }
		return self.callableConstLayersMatch(expected, self.inferRaw(argument, vars));
	}

	public bool assignmentCompatible(Node? target, Node? source) {
		Node? valueTarget = self.arrayValueType(target);
		Node? valueSource = self.arrayValueType(source);
		Node? resolvedTarget = self.resolveAliases(valueTarget);
		Node? resolvedSource = self.resolveAliases(valueSource);
		if (resolvedTarget == null || resolvedSource == null) { return false; }
		if (resolvedTarget.base == "null") { return self.operators.isNullType(resolvedSource); }
		if (self.operators.isNullType(resolvedSource)) {
			return self.operators.isReferenceType(resolvedTarget) || self.state.interfaces.has(resolvedTarget.base);
		}
		if (self.state.analyzed.isInterface(resolvedTarget.base) && !self.state.analyzed.isClass(resolvedSource.base) && !self.state.analyzed.isGenericClass(resolvedSource.base) && !self.state.analyzed.isInterface(resolvedSource.base)) { return false; }
		/* A generic template cannot know whether T's eventual value already has
		 * reference shape. T -> T? is the one deferred promotion: nullable adds
		 * the optional boundary when needed and otherwise annotates that resolved
		 * reference. Keep this narrower than the former "any unresolved T fits"
		 * shortcut so unrelated callable/storage shapes still fail closed. */
		if (resolvedTarget.base == resolvedSource.base && resolvedTarget.genericArgs().len == 0 && self.state.typeParams.has(resolvedTarget.base) && resolvedTarget.isNullable && resolvedTarget.pointerDepth == resolvedSource.pointerDepth + 1) {
			return self.operators.genericArgsEqual(resolvedTarget.genericArgs(), resolvedSource.genericArgs());
		}
		if (self.sameTypeShape(resolvedTarget, resolvedSource, self.operators)) { return true; }
		if (self.callableAssignmentCompatible(resolvedTarget, resolvedSource, self.operators)) { return true; }
		/* C array-to-pointer decay is directional.  Do not collapse both shapes to
         * one effective depth: a pointer cannot initialize an array declaration. */
		if (resolvedSource.isArray && !resolvedTarget.isArray && resolvedTarget.base == resolvedSource.base && resolvedTarget.pointerDepth == resolvedSource.pointerDepth + 1 && self.operators.genericArgsEqual(resolvedTarget.genericArgs(), resolvedSource.genericArgs())) {
			return true;
		}
		if (NumericSemantics.isType(resolvedTarget, self.state.analyzed) && NumericSemantics.isType(resolvedSource, self.state.analyzed) && resolvedTarget.base != "bool" && resolvedSource.base != "bool") {
			return true;
		}
		if (TypeComposition.isSemanticScalarString(resolvedTarget) && self.operators.isCStringPointer(resolvedSource)) {
			return true;
		}
		if (self.operators.isCStringPointer(resolvedTarget) && TypeComposition.isSemanticScalarString(resolvedSource)) {
			return true;
		}
		if (self.operators.isVoidPointer(resolvedTarget) && self.operators.isReferenceType(resolvedSource)) {
			return true;
		}
		if (self.operators.isVoidPointer(resolvedSource) && self.operators.isReferenceType(resolvedTarget)) {
			return true;
		}
		bool targetNominal = self.state.analyzed.isClass(resolvedTarget.base) || self.state.analyzed.isGenericClass(resolvedTarget.base);
		bool sourceNominal = self.state.analyzed.isClass(resolvedSource.base) || self.state.analyzed.isGenericClass(resolvedSource.base);
		if (self.state.interfaces.has(resolvedTarget.base) && sourceNominal) {
			return self.operators.specializationIsSubtype(resolvedSource, resolvedTarget);
		}
		if (self.state.interfaces.has(resolvedTarget.base) && self.state.interfaces.has(resolvedSource.base)) {
			return self.operators.specializationIsSubtype(resolvedSource, resolvedTarget);
		}
		if (targetNominal && sourceNominal) {
			return self.operators.specializationIsSubtype(resolvedSource, resolvedTarget);
		}
		if (TypeComposition.isSemanticScalarString(resolvedTarget) && self.sourceHasToString(resolvedSource)) {
			return true;
		}
		return false;
	}

	public bool sourceHasToString(Node? source) {
		Node? resolvedSource = self.resolveAliases(source);
		if (resolvedSource == null || resolvedSource.isArray || self.operators.valueDepth(resolvedSource) != 1 || (!self.state.analyzed.isClass(resolvedSource.base) && !self.state.analyzed.isGenericClass(resolvedSource.base))) {
			return false;
		}
		Node concreteSource = resolvedSource;
		Node? method = null;
		if (self.state.analyzed.isClass(concreteSource.base)) {
			method = self.state.analyzed.classMethod(concreteSource.base, "toString");
		} else {
			method = self.state.analyzed.genericClassMethod(concreteSource.base, "toString");
		}
		return method != null && method.kind == NK_METHOD_DECL && method.params().len == 0 && method.returnType != null && TypeComposition.isSemanticScalarString(method.returnType);
	}

	public bool requiresTargetStringConversion(Node? target, Node? source) {
		Node? resolvedTarget = self.resolveAliases(target);
		return resolvedTarget != null && TypeComposition.isSemanticScalarString(resolvedTarget) && self.sourceHasToString(source);
	}

	/* The refusal for a C tag that names a declaration of another kind, or
	 * "". `union P` for a btrc or native `struct P` (or an enum, class,
	 * interface, rich enum or typedef `P`) would compile to a C type that is
	 * not `P`. A tag naming nothing stays a trusted foreign C tag. */
	public string tagKeywordMismatch(string base) {
		string keyword = "";
		if (base.startsWith("struct ")) { keyword = "struct"; } else if (base.startsWith("union ")) { keyword = "union"; } else if (base.startsWith("enum ")) { keyword = "enum"; } else { return ""; }
		string name = base.substring(keyword.length() + 1, base.length() - keyword.length() - 1);
		if (name == "" || name.contains(" ")) { return ""; }
		string kind = "";
		if (self.state.analyzed.structTable.has(name)) {
			kind = SemanticTypeSystem.recordKeyword(self.state.analyzed.structTable.get(name));
		} else if (self.state.analyzed.isEnum(name)) {
			kind = "enum";
		} else if (self.state.analyzed.isRichEnum(name)) {
			kind = "rich enum";
		} else if (self.state.analyzed.isGenericClass(name) || (self.state.analyzed.isInterface(name) && self.state.analyzed.interfaceTable.get(name).genericParams().len > 0)) {
			/* A generic class's C names are mangled per instance; it owns no C
			 * tag, so a header's `struct ListNode` stays a foreign C tag. */
			return "";
		} else if (self.state.analyzed.isClass(name)) {
			kind = "class";
		} else if (self.state.analyzed.isInterface(name)) {
			kind = "interface";
		} else if (self.state.analyzed.typedefTable.has(name)) {
			Node original = self.state.analyzed.typedefTable.get(name);
			/* `typedef struct X X;` for a foreign tag: both spell one type. */
			if (original.base == base && original.pointerDepth == 0 && !original.isArray && original.genericArgs().len == 0) { return ""; }
			kind = "typedef";
		} else {
			return "";
		}
		if (kind == keyword) { return ""; }
		return "'" + base + "' does not name " + TypeValidator.article(keyword) + ": '" + name + "' is " + TypeValidator.article(kind);
	}

	class string article(string word) { return (word == "enum" || word == "interface") ? "an " + word : "a " + word; }

	/* A union cannot be printed or formatted: nothing records which member
	 * is live (C row 9). */
	public void validateFormattedValue(Node? typeExpr, Node site) {
		Node? canonical = self.resolveAliases(typeExpr);
		if (canonical == null || canonical.pointerDepth != 0 || canonical.isArray) { return; }
		string name = SemanticTypeSystem.recordTagName(canonical.base);
		if (!self.state.analyzed.structTable.has(name)) { return; }
		Node declaration = self.state.analyzed.structTable.get(name);
		if (declaration.isUnion) {
			TypeValidator.fail("Union '" + declaration.name + "' cannot be printed or formatted; a union cannot tell which member is live, so print one of its members", site);
		}
	}

	/* Report tagKeywordMismatch for a written type and its generic
	 * arguments, at the type that spells the tag. */
	public void validateTagKeyword(Node? typeExpr, Node site) {
		if (typeExpr == null) { return; }
		Node at = typeExpr.line > 0 ? typeExpr : site;
		string message = self.tagKeywordMismatch(typeExpr.base);
		if (message != "") { TypeValidator.fail(message, at); }
		for argument in typeExpr.genericArgs() { self.validateTagKeyword(argument, at); }
	}

	public bool explicitCTag(string base) { return base.startsWith("struct ") || base.startsWith("enum ") || base.startsWith("union "); }

	public bool atomicPayload(Node? typeExpr) {
		Node? canonical = self.resolveAliases(typeExpr);
		if (canonical == null || canonical.isArray || canonical.isNullable || canonical.genericArgs().len > 0) {
			return false;
		}
		if (canonical.pointerDepth > 0) {
			return canonical.base != "string" && canonical.base != "Atomic" && canonical.base != "Span" && !self.state.analyzed.isClass(canonical.base) && !self.state.analyzed.isGenericClass(canonical.base) && !self.state.analyzed.isInterface(canonical.base);
		}
		if (canonical.isConst || canonical.isVolatile) { return false; }
		return canonical.base == "bool" || canonical.base == "int" || canonical.base == "signed" || canonical.base == "signed int" || canonical.base == "uint" || canonical.base == "unsigned" || canonical.base == "unsigned int";
	}

	private bool realtimePodInner(Node? typeExpr, Map<string, bool> visiting) {
		Node? canonical = self.resolveAliases(typeExpr);
		if (canonical == null || canonical.isArray || canonical.isNullable) {
			return false;
		}
		if (canonical.pointerDepth > 0) {
			return canonical.base != "string" && !self.state.analyzed.isClass(canonical.base) && !self.state.analyzed.isGenericClass(canonical.base) && !self.state.analyzed.isInterface(canonical.base);
		}
		if (canonical.base == "__realtime_fn_ptr") { return true; }
		if (canonical.genericArgs().len > 0) { return false; }
		if (canonical.base == "bool" || NumericSemantics.isType(canonical, self.state.analyzed) || self.state.analyzed.isEnum(canonical.base)) {
			return true;
		}
		string name = canonical.base;
		name = SemanticTypeSystem.recordTagName(name);
		if (visiting.has(name) || !self.state.analyzed.structTable.has(name)) {
			return false;
		}
		Node declaration = self.state.analyzed.structTable.get(name);
		if (declaration.isForward) { return false; }
		/* Every union member is a plain C value (unionMemberBlocker). */
		if (declaration.isUnion) { return true; }
		Map<string, bool> nested = self.cloneFlags(visiting);
		nested.put(name, true);
		Vector<Node> declarationFields = SemanticTypeSystem.recordFields(declaration);
		int fieldIndex = 0;
		while (fieldIndex < declarationFields.len) {
			Node? payload = self.resolveAliases(declarationFields.get(fieldIndex).type);
			if (payload != null && payload.isArray) {
				if (payload.arraySize == null || payload.isNullable) { return false; }
				payload = TypeShape.withoutOuterArray(payload);
			}
			if (!self.realtimePodInner(payload, nested)) {
				return false;
			}
			fieldIndex = fieldIndex + 1;
		}
		return true;
	}

	/* Why a union cannot hold typeExpr, or an empty answer for a plain C
	 * value. A union cannot tell which member is live, so its members are
	 * plain C values, transitively (realtimePod with C's foreign tags and
	 * managed-free CFunction pointers admitted, and RealtimeFunction
	 * refused). The answer is ["realtime"], ["managed", type] or
	 * ["contains", record, field]. A direct Atomic<T> is left to the
	 * existing shallow-storage refusal. */
	public Vector<string> unionMemberBlocker(Node? typeExpr, Map<string, bool> visiting) {
		Vector<string> plain = [];
		Node? resolved = self.resolveAliases(typeExpr);
		if (resolved == null) { return plain; }
		Node canonical = resolved;
		if (canonical.isArray && !canonical.isNullable && canonical.arraySize != null) { canonical = TypeShape.withoutOuterArray(canonical); }
		Vector<string> managed = ["managed", self.formatWrittenType(typeExpr)];
		if (canonical.base == "__realtime_fn_ptr") {
			Vector<string> realtime = ["realtime"];
			return realtime;
		}
		if (canonical.base == "__fn_ptr") {
			if (canonical.pointerDepth != 0 || canonical.isArray || canonical.isNullable) { return managed; }
			for argument in canonical.genericArgs() {
				Node? argumentType = self.resolveAliases(argument);
				if (argumentType != null && argumentType.base == "void" && argumentType.pointerDepth == 0) { continue; }
				if (self.unionMemberBlocker(argument, visiting).len > 0) { return managed; }
			}
			return plain;
		}
		if (canonical.isArray || canonical.isNullable) { return managed; }
		if (canonical.base == "Atomic" || self.containsAtomicStorage(canonical)) { return plain; }
		bool reference = canonical.base == "string" || self.state.analyzed.isClass(canonical.base) || self.state.analyzed.isGenericClass(canonical.base) || self.state.analyzed.isInterface(canonical.base);
		if (canonical.pointerDepth > 0) {
			if (reference) { return managed; }
			return plain;
		}
		if (canonical.genericArgs().len > 0 || (self.runtimeTypeBase(canonical.base) && canonical.base != "MemoryOrder") || reference || self.state.analyzed.isRichEnum(canonical.base)) { return managed; }
		string name = SemanticTypeSystem.recordTagName(canonical.base);
		if (visiting.has(name) || !self.state.analyzed.structTable.has(name)) { return plain; }
		Node declaration = self.state.analyzed.structTable.get(name);
		if (declaration.isForward) { return plain; }
		Map<string, bool> nested = self.cloneFlags(visiting);
		nested.put(name, true);
		for field in SemanticTypeSystem.recordFields(declaration) {
			Vector<string> reason = self.unionMemberBlocker(field.type, nested);
			if (reason.len == 0) { continue; }
			if (reason.get(0) == "realtime") { return reason; }
			string fieldName = reason.get(0) == "managed" ? field.name : reason.get(2);
			Vector<string> contains = ["contains", name, fieldName];
			return contains;
		}
		return plain;
	}

	/* A union cannot tell which member is live, so every member is a plain C
	 * value (C row 9): no ARC, no proof-carrying callback. */
	public void validateUnionMembers(Node declaration) {
		for field in SemanticTypeSystem.recordFields(declaration) {
			Map<string, bool> visiting = {};
			Vector<string> reason = self.unionMemberBlocker(field.type, visiting);
			if (reason.len == 0) { continue; }
			string prefix = "Union '" + declaration.name + "' member '" + field.name + "' cannot hold";
			if (reason.get(0) == "realtime") {
				TypeValidator.fail(prefix + " a RealtimeFunction; a union could reinterpret it without its realtime proof", field);
			}
			string held = reason.get(0) == "managed" ? "managed type '" + reason.get(1) + "'" : "'" + reason.get(1) + "', which contains managed field '" + reason.get(2) + "'";
			TypeValidator.fail(prefix + " " + held + "; a union cannot tell which member is live, so its members must be plain C values", field);
		}
	}

	public bool realtimePod(Node? typeExpr) {
		Map<string, bool> visiting = {};
		return self.realtimePodInner(typeExpr, visiting);
	}

	/* The struct with a flexible array member that typeExpr stores by value
	 * (directly or as array storage), or "". */
	public string flexibleArrayStruct(Node? typeExpr) {
		Node? canonical = self.resolveAliases(typeExpr);
		if (typeExpr == null || canonical == null || canonical.pointerDepth > 0) { return ""; }
		// A type parameter named like a struct never resolves to that struct.
		if (self.state.typeParams.has(typeExpr.base)) { return ""; }
		string name = SemanticTypeSystem.resolvedStructName(canonical, self.state.analyzed);
		if (name == "" || SemanticTypeSystem.flexibleArrayField(self.state.analyzed.structTable.get(name)) == null) { return ""; }
		return name;
	}

	/* r13: a struct with a flexible array member exists only behind a pointer,
	 * so no object, parameter, return, record, tuple, payload or generic
	 * argument may hold one by value. */
	public void validateFlexibleArrayValue(Node? typeExpr, string subject, Node site) {
		string name = self.flexibleArrayStruct(typeExpr);
		if (name != "") {
			TypeValidator.fail(subject + " uses struct '" + name + "' with a flexible array member by value; use a pointer", site);
		}
		// A generic argument is by-value storage even behind a class reference
		// or a pointer: Box<S>* still names a Box that holds an S.
		Node? canonical = self.resolveAliases(typeExpr);
		if (canonical == null) { return; }
		int index = 0;
		while (index < canonical.genericArgs().len) {
			self.validateFlexibleArrayValue(canonical.genericArgs().get(index), "Generic argument " + Strings.fromInt(index + 1) + " of " + subject, site);
			index = index + 1;
		}
	}

	/* A complete plain C flexible-array element: realtime POD, a function
	 * pointer or a fixed array of these. Managed elements are refused for
	 * now; relaxing to the shallow-aggregate rule later stays compatible. */
	public bool flexibleArrayElement(Node? typeExpr) {
		Node? element = self.resolveAliases(typeExpr);
		if (element == null) { return true; }
		if (element.isArray && element.arraySize != null && !element.isNullable) {
			return self.flexibleArrayElement(TypeShape.withoutOuterArray(element));
		}
		if (element.base == "__fn_ptr" && element.pointerDepth == 0 && !element.isNullable) { return true; }
		if (element.isNullable && element.pointerDepth > 0) {
			// A nullable raw or function pointer is a plain C pointer.
			return element.base != "string" && !self.state.analyzed.isClass(element.base) && !self.state.analyzed.isGenericClass(element.base) && !self.state.analyzed.isInterface(element.base);
		}
		if (element.pointerDepth == 0) {
			string name = SemanticTypeSystem.resolvedStructName(element, self.state.analyzed);
			// The by-value checks report incomplete and flexible-array elements.
			if (name != "" && (self.state.analyzed.structTable.get(name).isForward || self.flexibleArrayStruct(element) != "")) { return true; }
		}
		return self.realtimePod(element);
	}

	public bool runtimeTypeBase(string base) { return base == "Array" || base == "List" || base == "Map" || base == "Atomic" || base == "MemoryOrder" || base == "Mutex" || base == "Set" || base == "Span" || base == "Thread" || base == "Tuple" || base == "Vector" || base == "__fn_ptr" || base == "__realtime_fn_ptr"; }

	public bool knownDeclarationType(Node typeExpr) {
		if (typeExpr.pointerDepth > 0 && typeExpr.genericArgs().len == 0) {
			return true;
		}
		string base = typeExpr.base;
		return self.state.typeParams.has(base) || NumericSemantics.isIntegralBase(base) || NumericSemantics.isStandardTypedef(base) || base == "float" || base == "double" || base == "long double" || base == "bool" || base == "string" || base == "void" || self.runtimeTypeBase(base) || self.state.analyzed.isClass(base) || self.state.analyzed.isGenericClass(base) || self.state.interfaces.has(base) || self.state.analyzed.isEnum(base) || self.state.analyzed.isRichEnum(base) || self.state.analyzed.structTable.has(base) || self.state.analyzed.typedefTable.has(base) || base.endsWith("_t") || self.explicitCTag(base);
	}

	private int declaredGenericArity(string base) {
		if (self.state.analyzed.genericClassTable.has(base)) {
			return self.state.analyzed.genericClassTable.get(base).genericParams().len;
		}
		if (self.state.analyzed.classTable.has(base)) {
			return self.state.analyzed.classTable.get(base).genericParams().len;
		}
		if (self.state.analyzed.interfaceTable.has(base)) {
			return self.state.analyzed.interfaceTable.get(base).genericParams().len;
		}
		if (base == "Array" || base == "Atomic" || base == "List" || base == "Mutex" || base == "Set" || base == "Span" || base == "Thread" || base == "Vector") {
			return 1;
		}
		if (base == "Map") { return 2; }
		return -1;
	}

	public void validateDeclaredType(Node? typeExpr, string subject, string role, Node site) {
		if (typeExpr == null) { return; }
		self.validateTagKeyword(typeExpr, site);
		int expectedArguments = self.declaredGenericArity(typeExpr.base);
		if (expectedArguments >= 0 && !self.state.typeParams.has(typeExpr.base) && typeExpr.genericArgs().len != expectedArguments) {
			TypeValidator.fail("Type '" + typeExpr.base + "' expects " + Strings.fromInt(expectedArguments) + " generic argument(s) but got " + Strings.fromInt(typeExpr.genericArgs().len), site);
		}
		if (typeExpr.isStatic && typeExpr.isExtern) {
			TypeValidator.fail(subject + " cannot be both static and extern", site);
		}
		if ((role == "parameter" || role == "field" || role == "stable_field") && (typeExpr.isStatic || typeExpr.isExtern)) {
			TypeValidator.fail(subject + " cannot carry static/extern storage qualifiers", site);
		}
		if (role == "return" && (SemanticTypeSystem.typeEffectiveOuterConst(typeExpr, self.state.analyzed.typedefTable) || SemanticTypeSystem.typeEffectiveOuterVolatile(typeExpr, self.state.analyzed.typedefTable))) {
			TypeValidator.fail(subject + " cannot carry an outer const/volatile qualifier; " + "C discards qualifiers on returned values", site);
		}
		Node? canonical = self.resolveAliases(typeExpr);
		if (canonical != null && canonical.base == "__realtime_fn_ptr" && (canonical.pointerDepth != 0 || canonical.isArray || canonical.isNullable || canonical.isConst || canonical.isVolatile)) {
			TypeValidator.fail("RealtimeFunction must be one direct, unqualified proof-carrying function pointer", site);
		}
		if (!SemanticTypeSystem.ownedClosureInvokeIsAdmissible(typeExpr, self.state.analyzed, self.state.typeParams)) {
			TypeValidator.fail("OwnedClosure<Invoke> requires an exact " + "CFunction<Signature> invoke type", site);
		}
		if (canonical != null && canonical.base == "SPSCQueue" && canonical.genericArgs().len > 0 && !self.state.typeParams.has(canonical.genericArgs().get(0).base) && !self.realtimePod(canonical.genericArgs().get(0))) {
			TypeValidator.fail("SPSCQueue<T> payload must be realtime POD without managed ownership", site);
		}
		if (canonical != null && canonical.base == "OwnedBuffer" && canonical.genericArgs().len > 0 && !self.state.typeParams.has(canonical.genericArgs().get(0).base)) {
			Node payload = canonical.genericArgs().get(0);
			if (!self.realtimePod(payload)) {
				TypeValidator.fail("OwnedBuffer<T> payload must be realtime POD without " + "managed or atomic ownership", site);
			}
		}
		if (canonical != null && canonical.base == "AtomicBuffer" && canonical.genericArgs().len > 0 && !self.state.typeParams.has(canonical.genericArgs().get(0).base) && !self.atomicPayload(canonical.genericArgs().get(0))) {
			TypeValidator.fail("AtomicBuffer<T> payload must be bool, int, uint, or a raw pointer", site);
		}
		if (canonical != null && canonical.base == "Span") {
			bool directSpan = canonical.pointerDepth == 0 && !canonical.isArray;
			if (!directSpan || canonical.isConst || canonical.isNullable) {
				TypeValidator.fail("Span<T> must be one direct, nonnullable borrowed view", site);
			}
			if (directSpan && (role == "field" || role == "stable_field")) {
				TypeValidator.fail(subject + " cannot store nonescaping Span<T>", site);
			}
			if (directSpan && role == "return") {
				TypeValidator.fail(subject + " cannot be nonescaping Span<T>", site);
			}
			if (directSpan && canonical.genericArgs().len > 0 && !self.state.typeParams.has(canonical.genericArgs().get(0).base) && !self.realtimePod(canonical.genericArgs().get(0))) {
				TypeValidator.fail("Span<T> element type must be realtime POD without managed ownership", site);
			}
		}
		if (canonical != null && canonical.base == "Atomic") {
			bool directAtomic = canonical.pointerDepth == 0 && !canonical.isArray;
			if (canonical.isArray || canonical.isConst || canonical.isNullable) {
				TypeValidator.fail("Atomic<T> owner type must be direct mutable stable storage", site);
			}
			if (directAtomic && role == "parameter") {
				TypeValidator.fail("Atomic<T> owner cannot be passed by value; pass Atomic<T>*", site);
			}
			if (directAtomic && role == "return") {
				TypeValidator.fail("Atomic<T> owner cannot be returned by value", site);
			}
			if (directAtomic && role == "field") {
				TypeValidator.fail(subject + " cannot embed an Atomic<T> owner in shallow copyable " + "storage; keep Atomic<T> as a direct class field or " + "local owner", typeExpr);
			}
			if (canonical.genericArgs().len > 0 && !self.state.typeParams.has(canonical.genericArgs().get(0).base) && !self.atomicPayload(canonical.genericArgs().get(0))) {
				TypeValidator.fail("Atomic<T> payload must be bool, int, uint, or a raw pointer", site);
			}
		}
		if (canonical != null && canonical.base != "Span" && self.containsSpanStorage(canonical)) {
			TypeValidator.fail(subject + " cannot contain nonescaping Span<T> in aggregate or managed " + "storage", site);
		}
		self.validateNonescapingRichEnumRole(canonical, subject, role, site);
		if (canonical != null && canonical.base != "Atomic" && self.containsAtomicStorage(canonical)) {
			TypeValidator.fail(subject + " cannot embed an Atomic<T> owner in shallow copyable storage; " + "keep Atomic<T> as a direct class field or local owner", site);
		}
		if (canonical != null && canonical.base == "Mutex" && (canonical.pointerDepth > 0 || canonical.isArray || canonical.isConst)) {
			TypeValidator.fail("Mutex<T> owner type must be one direct mutable handle; " + "pointer, array, and const Mutex shapes are not supported", site);
		}
		if (canonical != null && canonical.base != "Mutex" && canonical.base != "Thread" && canonical.base != "__fn_ptr" && canonical.base != "__realtime_fn_ptr" && !self.state.analyzed.isClass(canonical.base) && !self.state.analyzed.isGenericClass(canonical.base) && self.containsMutexStorage(canonical)) {
			TypeValidator.fail(subject + " cannot embed a Mutex handle in shallow by-value storage; " + "keep Mutex<T> as a direct managed value", site);
		}
		self.validateMutexPayloadsInType(typeExpr, site);
		if (canonical != null && canonical.base == "Thread" && (canonical.pointerDepth > 0 || canonical.isArray || canonical.isConst || canonical.isNullable)) {
			TypeValidator.fail("Thread<T> owner type must be one direct mutable handle; " + "pointer, array, const, and nullable Thread shapes are not " + "supported", site);
		}
		if ((role == "field" || role == "stable_field" || role == "parameter") && self.containsThreadStorage(typeExpr)) {
			TypeValidator.fail(subject + " cannot own a Thread handle; keep each Thread<T> in one " + "initialized local variable or return it", site);
		}
		if (canonical != null && canonical.base == "Thread" && canonical.genericArgs().len > 0) {
			Node resultType = canonical.genericArgs().get(0);
			Map<string, bool> visiting = {};
			if (self.threadResultHasUnsizedArray(resultType, visiting)) {
				TypeValidator.fail("Thread<T> result type cannot contain an unsized array; " + "return a managed collection or another explicitly " + "owned value", site);
			}
			if (self.containsThreadStorage(resultType)) {
				TypeValidator.fail("Thread<T> result type cannot contain another Thread handle", site);
			}
			if (self.containsMutexStorage(resultType)) {
				TypeValidator.fail("Thread<T> result type cannot contain a Mutex handle", site);
			}
			if (!self.directManagedThreadResult(resultType) && self.threadAggregateHasManagedReference(resultType, visiting)) {
				TypeValidator.fail(TypeValidator.threadAggregateResultMessage(), site);
			}
		}
		if (role != "return" && role != "alias" && TypeValidator.scalarVoid(canonical)) {
			TypeValidator.fail(subject + " cannot have scalar/non-pointer void type", site);
		}
		/* A typedef may name an incomplete struct, as SDK handle types do; only by-value use sites need the definition. */
		if (canonical != null && role != "alias" && canonical.pointerDepth == 0 && !self.state.typeParams.has(typeExpr.base)) {
			string name = SemanticTypeSystem.recordTagName(canonical.base);
			if (self.state.analyzed.structTable.has(name) && self.state.analyzed.structTable.get(name).isForward) {
				TypeValidator.fail("Incomplete " + SemanticTypeSystem.recordKeyword(self.state.analyzed.structTable.get(name)) + " '" + name + "' cannot be used by value for " + subject, site);
			}
		}
		if (!self.knownDeclarationType(typeExpr)) {
			TypeValidator.fail(subject + " uses unknown by-value type '" + self.formatType(typeExpr) + "'", site);
		}
		int index = 0;
		while (index < typeExpr.genericArgs().len) {
			string argumentRole = "object";
			if ((typeExpr.base == "__fn_ptr" || typeExpr.base == "__realtime_fn_ptr" || typeExpr.base == "Thread") && index == 0) {
				argumentRole = "return";
			} else if (typeExpr.base == "__fn_ptr" || typeExpr.base == "__realtime_fn_ptr") {
				argumentRole = "parameter";
			}
			Node argument = typeExpr.genericArgs().get(index);
			self.validateDeclaredType(argument, "Generic argument " + Strings.fromInt(index + 1) + " of " + subject, argumentRole, argument);
			index = index + 1;
		}
	}

	public void validateAggregateDeclarationTypes(Node program) {
		int index = 0;
		while (index < program.declarations().len) {
			Node declaration = program.declarations().get(index);
			if (declaration.kind == NK_STRUCT_DECL && !declaration.isForward) {
				Vector<Node> declarationFields = SemanticTypeSystem.recordFields(declaration);
				int fieldIndex = 0;
				while (fieldIndex < declarationFields.len) {
					Node field = declarationFields.get(fieldIndex);
					self.validateDeclaredType(field.type, SemanticTypeSystem.recordKeywordTitle(declaration) + " field '" + declaration.name + "." + field.name + "'", "field", field);
					fieldIndex = fieldIndex + 1;
				}
				if (declaration.isUnion) { self.validateUnionMembers(declaration); }
			} else if (declaration.kind == NK_TYPEDEF_DECL) {
				self.validateDeclaredType(declaration.original, "Typedef '" + declaration.alias + "'", "alias", declaration);
			} else if (declaration.kind == NK_INTERFACE_DECL) {
				Map<string, bool> previousParams = self.cloneFlags(self.state.typeParams);
				self.state.typeParams = self.typeParamSet(declaration.genericParams());
				int methodIndex = 0;
				while (methodIndex < declaration.methods().len) {
					Node method = declaration.methods().get(methodIndex);
					self.validateDeclaredType(method.returnType, "Return type of interface method '" + declaration.name + "." + method.name + "'", "return", method);
					self.validateArrayReturn(method, "Interface method '" + declaration.name + "." + method.name + "'");
					int parameterIndex = 0;
					while (parameterIndex < method.params().len) {
						Node parameter = method.params().get(parameterIndex);
						self.validateDeclaredType(parameter.type, "Parameter '" + declaration.name + "." + method.name + "." + parameter.name + "'", "parameter", parameter);
						parameterIndex = parameterIndex + 1;
					}
					methodIndex = methodIndex + 1;
				}
				self.state.typeParams = previousParams;
			} else if (declaration.kind == NK_RICH_ENUM_DECL) {
				int variantIndex = 0;
				while (variantIndex < declaration.variants().len) {
					Node variant = declaration.variants().get(variantIndex);
					int parameterIndex = 0;
					while (parameterIndex < variant.params().len) {
						Node parameter = variant.params().get(parameterIndex);
						self.validateDeclaredType(parameter.type, "Rich-enum payload '" + declaration.name + "." + variant.name + "." + parameter.name + "'", "field", parameter);
						if (SemanticTypeSystem.typeEffectiveOuterConst(parameter.type, self.state.analyzed.typedefTable)) {
							TypeValidator.fail("Rich-enum payload '" + declaration.name + "." + variant.name + "." + parameter.name + "' cannot use const storage " + "until rich-enum constructors use structured " + "initialization", parameter);
						}
						parameterIndex = parameterIndex + 1;
					}
					variantIndex = variantIndex + 1;
				}
			}
			index = index + 1;
		}
	}
}
