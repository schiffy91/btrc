/* Top-level, class, interface, hosted-ABI, and static declaration contracts. */

import std.Map;
import std.Strings;
import std.Vector;

import ../../generated/ast/Node.btrc;
import ../../syntax/Types.btrc;
import ../Declarations.btrc;
import ../HostedAbi.btrc;
import ../Models.btrc;
import ../Operators.btrc;
import ../Types.btrc;
import ./Constants.btrc;
import ./ControlFlow.btrc;
import ./Expressions.btrc;
import ./Names.btrc;
import ./Ownership.btrc;
import ./Storage.btrc;
import ./Types.btrc;

class DeclarationValidator {
	private SemanticValidationState state;
	private HostedAbiRepository hostedAbi;
	private OperatorSemantics operators;
	private TypeValidator types;
	private ConstantValidator constants;
	private NameValidator names;
	private StorageValidator storage;
	private OwnershipValidator ownership;
	private ExpressionValidator expressions;
	private ControlFlowValidator controlFlow;

	public DeclarationValidator(SemanticValidationState state, HostedAbiRepository hostedAbi, OperatorSemantics operators, TypeValidator types, ConstantValidator constants, NameValidator names, StorageValidator storage, OwnershipValidator ownership, ExpressionValidator expressions, ControlFlowValidator controlFlow) {
		self.state = state;
		self.hostedAbi = hostedAbi;
		self.operators = operators;
		self.types = types;
		self.constants = constants;
		self.names = names;
		self.storage = storage;
		self.ownership = ownership;
		self.expressions = expressions;
		self.controlFlow = controlFlow;
	}

	public string hostedNormalizedBase(string base) {
		if (base == "__fn_ptr") { return "CFunction"; }
		if (base == "__realtime_fn_ptr") { return "RealtimeFunction"; }
		if (base == "byte") { return "unsigned char"; }
		if (base == "long int") { return "long"; }
		if (base == "long long int") { return "long long"; }
		if (base == "short int") { return "short"; }
		if (base == "signed" || base == "signed int") { return "int"; }
		if (base == "string") { return "char"; }
		if (base == "unsigned" || base == "uint") { return "unsigned int"; }
		if (base == "unsigned long int") { return "unsigned long"; }
		if (base == "unsigned long long int") {
			return "unsigned long long";
		}
		if (base == "unsigned short int") { return "unsigned short"; }
		return base;
	}

	public int hostedPointerDepth(Node typeNode) {
		int depth = typeNode.pointerDepth;
		if (TypeComposition.nullableCollapsesReferenceLayer(typeNode, typeNode.base == "string")) {
			depth = depth - 1;
		}
		if (typeNode.isArray) { depth = depth + 1; }
		if (typeNode.base == "string") {
			depth = depth + 1;
		}
		return depth;
	}

	public bool hostedTypeMatchesResult(Node typeNode, string name) {
		GeneratedHostedFunctionRow? row = self.hostedAbi.exactSpec(name);
		return row != null && self.hostedTypeMatchesShape(typeNode, row.result);
	}

	public bool hostedTypeMatchesParameter(Node typeNode, string name, int index) {
		GeneratedHostedParameterRow? row = self.hostedAbi.parameter(name, index);
		return row != null && self.hostedTypeMatchesShape(typeNode, row.typeShape);
	}

	public bool hostedTypeMatchesShape(Node typeNode, GeneratedAbiTypeRow shape) {
		Node? optionalCanonical = self.types.resolveAliases(typeNode);
		if (optionalCanonical == null) { return false; }
		Node canonical = optionalCanonical;
		if (self.hostedNormalizedBase(canonical.base) != shape.base || self.hostedPointerDepth(canonical) != shape.pointerDepth || canonical.isConst != shape.isConst || canonical.genericArgs.len != shape.genericArgs.len) {
			return false;
		}
		int index = 0;
		while (index < canonical.genericArgs.len) {
			if (!self.hostedTypeMatchesShape(canonical.genericArgs.get(index), shape.genericArgs.get(index))) {
				return false;
			}
			index = index + 1;
		}
		return true;
	}

	public bool hostedDeclarationModifiersValid(Node declaration) {
		if (declaration.returnType.isStatic || declaration.returnType.isVolatile || declaration.isGpu || declaration.keepReturn) {
			return false;
		}
		int index = 0;
		while (index < declaration.params.len) {
			Node parameter = declaration.params.get(index);
			if (parameter.keep_ || parameter.default_ != null || parameter.type.isStatic || parameter.type.isExtern || parameter.type.isVolatile) {
				return false;
			}
			index = index + 1;
		}
		return true;
	}

	public string hostedExpectedSignature(string name) {
		GeneratedHostedFunctionRow? row = self.hostedAbi.exactSpec(name);
		if (row == null) { return ""; }
		string result = self.hostedExpectedType(row.result);
		string parameters = "";
		int index = 0;
		while (index < row.parameters.len) {
			if (index > 0) { parameters = parameters + ", "; }
			parameters = parameters + self.hostedExpectedType(row.parameters.get(index).typeShape);
			index = index + 1;
		}
		if (parameters == "") { parameters = "void"; }
		return result + " (" + parameters + ")";
	}

	public string hostedExpectedType(GeneratedAbiTypeRow shape) {
		string result = shape.base;
		if (shape.genericArgs.len > 0) {
			result = result + "<";
			int index = 0;
			while (index < shape.genericArgs.len) {
				if (index > 0) { result = result + ", "; }
				result = result + self.hostedExpectedType(shape.genericArgs.get(index));
				index = index + 1;
			}
			result = result + ">";
		}
		int resultDepth = shape.pointerDepth;
		while (resultDepth > 0) {
			result = result + "*";
			resultDepth = resultDepth - 1;
		}
		return shape.isConst ? "const " + result : result;
	}

	public void validateHostedBodylessDeclaration(Node declaration) {
		if (declaration.bodyNode != null) { return; }
		string name = declaration.name;
		if (self.hostedAbi.macroName(name)) {
			TypeValidator.fail("Hosted macro '" + name + "' cannot be redeclared as a function", declaration);
			return;
		}
		if (!self.hostedAbi.exactFunction(name)) {
			if (self.hostedAbi.compilerStdlibNode(declaration)) { return; }
			if (self.hostedAbi.ownedName(name)) {
				TypeValidator.fail("Hosted symbol '" + name + "' has no source-representable prototype; include its " + "standard header and call it directly", declaration);
			}
			return;
		}
		if (self.hostedAbi.variadic(name)) {
			TypeValidator.fail("Hosted function '" + name + "' has an ABI that btrc prototypes cannot represent; include " + "its standard header and call it directly", declaration);
			return;
		}
		bool valid = self.hostedDeclarationModifiersValid(declaration) && declaration.params.len == self.hostedAbi.parameterCount(name) && self.hostedTypeMatchesResult(declaration.returnType, name);
		int index = 0;
		while (valid && index < declaration.params.len) {
			valid = self.hostedTypeMatchesParameter(declaration.params.get(index).type, name, index);
			index = index + 1;
		}
		if (!valid) {
			TypeValidator.fail("Hosted function declaration '" + name + "' does not match compiler-owned C ABI '" + self.hostedExpectedSignature(name) + "'", declaration);
		}
	}

	public bool plainType(Node? typeExpr, string base) {
		Node? resolvedType = self.types.resolveAliases(typeExpr);
		return resolvedType != null && resolvedType.base == base && resolvedType.pointerDepth == 0 && !resolvedType.isArray && resolvedType.genericArgs.len == 0;
	}

	public int magicArity(string name) {
		if (name == "__neg__" || name == "toString" || name == "__del__") {
			return 0;
		}
		if (name == "__add__" || name == "__sub__" || name == "__mul__" || name == "__div__" || name == "__mod__" || name == "__eq__" || name == "__ne__" || name == "__lt__" || name == "__gt__" || name == "__le__" || name == "__ge__") {
			return 1;
		}
		return -1;
	}

	public string magicReturn(string name) {
		if (name == "__eq__" || name == "__ne__" || name == "__lt__" || name == "__gt__" || name == "__le__" || name == "__ge__") {
			return "bool";
		}
		if (name == "toString") { return "string"; }
		if (name == "__del__") { return "void"; }
		return "";
	}

	public void validateArrayReturn(Node callable, string label) {
		if (callable.returnType != null && callable.returnType.isArray && !callable.isGpu) {
			TypeValidator.fail(label + " cannot return an array outside @gpu", callable);
		}
	}

	public void validateMainShape(Node functionDecl) {
		if (functionDecl.name != "main") { return; }
		bool resultValid = self.plainType(functionDecl.returnType, "int") || self.plainType(functionDecl.returnType, "void");
		bool paramsValid = functionDecl.params.len == 0;
		if (self.plainType(functionDecl.returnType, "int") && functionDecl.params.len == 2) {
			Node argc = self.types.resolveAliases(functionDecl.params.get(0).type);
			Node argv = self.types.resolveAliases(functionDecl.params.get(1).type);
			int argvDepth = argv.pointerDepth;
			if (argv.isArray) { argvDepth = argvDepth + 1; }
			paramsValid = argc.base == "int" && argc.pointerDepth == 0 && !argc.isArray && argc.genericArgs.len == 0 && argv.base == "char" && argvDepth == 2 && argv.genericArgs.len == 0;
		}
		if (!resultValid || !paramsValid || functionDecl.isGpu) {
			TypeValidator.fail("main must be 'int main()', 'int main(int, char**)', or 'void main()'", functionDecl);
		}
	}

	public void validateConstructorShape(Node classDeclaration, Node method) {
		string label = "Constructor '" + classDeclaration.name + "'";
		if (method.name != classDeclaration.name) {
			TypeValidator.fail(label + " must be named '" + classDeclaration.name + "'", method);
		}
		if (method.access == "class") {
			TypeValidator.fail(label + " cannot be class/static", method);
		}
		if (method.isAbstract) {
			TypeValidator.fail(label + " cannot be abstract", method);
		}
		if (method.isGpu) {
			TypeValidator.fail(label + " cannot be @gpu", method);
		}
		if (method.keepReturn) {
			TypeValidator.fail(label + " cannot use keep-return", method);
		}
		if (method.bodyNode == null) {
			TypeValidator.fail(label + " requires a concrete body", method);
		}
		if (method.genericParams.len > 0) {
			TypeValidator.fail(label + " cannot be generic", method);
		}
	}

	public void validateMagicShape(Node classDeclaration, Node method) {
		int arity = self.magicArity(method.name);
		if (arity < 0) { return; }
		string label = "Magic method '" + classDeclaration.name + "." + method.name + "'";
		if (method.access == "class") {
			TypeValidator.fail(label + " must be an instance method", method);
		}
		if (method.isAbstract || method.bodyNode == null) {
			TypeValidator.fail(label + " requires a concrete body", method);
		}
		if (method.genericParams.len > 0) {
			TypeValidator.fail(label + " cannot be generic", method);
		}
		if (method.params.len != arity) {
			TypeValidator.fail(label + " expects " + Strings.fromInt(arity) + " explicit parameter(s) but got " + Strings.fromInt(method.params.len), method);
		}
		string requiredReturn = self.magicReturn(method.name);
		if (requiredReturn != "" && !self.plainType(method.returnType, requiredReturn)) {
			TypeValidator.fail(label + " must return '" + requiredReturn + "'", method);
		}
	}

	public void validateClassCallableShapes(Node classDeclaration) {
		int index = 0;
		while (index < classDeclaration.members.len) {
			Node member = classDeclaration.members.get(index);
			if (member.kind == NK_METHOD_DECL) {
				string label = "Method '" + classDeclaration.name + "." + member.name + "'";
				self.validateArrayReturn(member, label);
				if (member.isConstructor) {
					self.validateConstructorShape(classDeclaration, member);
				} else {
					if (member.name == classDeclaration.name) {
						if (member.returnType.base != classDeclaration.name) {
							TypeValidator.fail("Constructor '" + classDeclaration.name + "' cannot have return type '" + self.types.formatType(member.returnType) + "'", member);
						}
						TypeValidator.fail("Method '" + classDeclaration.name + "." + member.name + "' uses explicit-return constructor syntax", member);
					}
					if (member.isAbstract && !classDeclaration.isAbstract) {
						TypeValidator.fail("Abstract " + label + " requires an abstract class", member);
					}
					if (!member.isAbstract && member.bodyNode == null) {
						TypeValidator.fail("Concrete " + label + " requires a body", member);
					}
					self.validateMagicShape(classDeclaration, member);
				}
			}
			index = index + 1;
		}
	}

	public void validateCallableShapes(Node program) {
		int index = 0;
		while (index < program.declarations.len) {
			Node declaration = program.declarations.get(index);
			if (declaration.kind == NK_FUNCTION_DECL) {
				self.validateArrayReturn(declaration, "Function '" + declaration.name + "'");
				self.validateMainShape(declaration);
			} else if (declaration.kind == NK_CLASS_DECL) {
				self.validateClassCallableShapes(declaration);
			}
			index = index + 1;
		}
	}

	public bool interfaceExtends(string child, string parent) {
		string current = child;
		Map<string, bool> seen = {};
		while (current != "" && !seen.has(current)) {
			if (current == parent) { return true; }
			seen.put(current, true);
			if (!self.state.interfaces.has(current)) { return false; }
			Node declaration = self.state.interfaces.get(current);
			if (declaration.parent == null) { return false; }
			current = declaration.parent;
		}
		return false;
	}

	public Node? interfaceMethod(string interfaceName, string methodName) {
		string current = interfaceName;
		Map<string, bool> seen = {};
		while (current != "" && !seen.has(current)) {
			seen.put(current, true);
			if (!self.state.interfaces.has(current)) { return null; }
			Node declaration = self.state.interfaces.get(current);
			int index = 0;
			while (index < declaration.methods.len) {
				Node method = declaration.methods.get(index);
				if (method.name == methodName) { return method; }
				index = index + 1;
			}
			if (declaration.parent == null) { return null; }
			current = declaration.parent;
		}
		return null;
	}

	public bool methodSignatureMatches(Node requirement, Node implementation, Map<string, Node> substitutions) {
		Node? expectedReturn = requirement.returnType;
		if (expectedReturn != null && substitutions.len > 0) {
			expectedReturn = SemanticTypeSystem.resolveGenericType(expectedReturn, substitutions, self.state.analyzed);
		}
		if (implementation.kind != NK_METHOD_DECL || implementation.isAbstract || expectedReturn == null || implementation.returnType == null || !self.types.aliasTypesSame(expectedReturn, implementation.returnType) || requirement.params.len != implementation.params.len || requirement.keepReturn != implementation.keepReturn) {
			return false;
		}
		int index = 0;
		while (index < requirement.params.len) {
			Node expected = requirement.params.get(index);
			Node actual = implementation.params.get(index);
			Node expectedType = expected.type;
			if (substitutions.len > 0) {
				expectedType = SemanticTypeSystem.resolveGenericType(expectedType, substitutions, self.state.analyzed);
			}
			if (!self.types.aliasTypesSame(expectedType, actual.type) || expected.keep_ != actual.keep_) {
				return false;
			}
			index = index + 1;
		}
		return true;
	}

	public void validateInterfaceRequirements(Node classDeclaration, string interfaceName, Map<string, bool> visited) {
		if (visited.has(interfaceName)) { return; }
		if (!self.state.interfaces.has(interfaceName)) {
			TypeValidator.fail("Class '" + classDeclaration.name + "' implements unknown interface '" + interfaceName + "'", classDeclaration);
		}
		visited.put(interfaceName, true);
		Node interfaceDeclaration = self.state.interfaces.get(interfaceName);
		Map<string, Node> substitutions = {};
		int typeIndex = 0;
		while (typeIndex < interfaceDeclaration.genericParams.len && typeIndex < classDeclaration.genericParams.len) {
			substitutions.put(interfaceDeclaration.genericParams.get(typeIndex), SemanticTypeSystem.primitive(classDeclaration.genericParams.get(typeIndex)));
			typeIndex = typeIndex + 1;
		}
		if (interfaceDeclaration.parent != null) {
			self.validateInterfaceRequirements(classDeclaration, interfaceDeclaration.parent, visited);
		}
		int index = 0;
		while (index < interfaceDeclaration.methods.len) {
			Node requirement = interfaceDeclaration.methods.get(index);
			Node? implementation = null;
			if (self.state.analyzed.isGenericClass(classDeclaration.name)) {
				implementation = self.state.analyzed.genericClassMethod(classDeclaration.name, requirement.name);
			} else {
				implementation = self.state.analyzed.classMethod(classDeclaration.name, requirement.name);
			}
			if (implementation == null) {
				TypeValidator.fail("Class '" + classDeclaration.name + "' does not implement interface method '" + interfaceName + "." + requirement.name + "'", classDeclaration);
			}
			Node concreteImplementation = implementation;
			if (!self.methodSignatureMatches(requirement, concreteImplementation, substitutions)) {
				TypeValidator.fail("Method '" + classDeclaration.name + "." + requirement.name + "' does not match interface signature '" + interfaceName + "." + requirement.name + "'", concreteImplementation);
			}
			if (concreteImplementation.access != "public") {
				TypeValidator.fail("Interface method implementation '" + classDeclaration.name + "." + requirement.name + "' must be public", concreteImplementation);
			}
			index = index + 1;
		}
	}

	public void validateConcreteAbstractMethods(Node declaration) {
		if (declaration.isAbstract) { return; }
		Vector<MethodEntry> methods = self.state.analyzed.mergedMethods(declaration.name);
		int index = 0;
		while (index < methods.len) {
			MethodEntry entry = methods.get(index);
			if (entry.sig.isAbstract) {
				TypeValidator.fail("Concrete class '" + declaration.name + "' does not implement abstract method '" + entry.name + "'", declaration);
			}
			index = index + 1;
		}
	}

	public void validateClassInheritanceCycle(Node declaration) {
		string current = declaration.name;
		Map<string, bool> ancestors = {};
		while (current != "") {
			if (ancestors.has(current)) {
				TypeValidator.fail("Class inheritance cycle involving '" + declaration.name + "'", declaration);
			}
			ancestors.put(current, true);
			if (self.state.analyzed.classTable.has(current)) {
				current = DeclarationRegistry.parentName(self.state.analyzed.classTable.get(current));
			} else if (self.state.analyzed.genericClassTable.has(current)) {
				current = DeclarationRegistry.parentName(self.state.analyzed.genericClassTable.get(current));
			} else {
				current = "";
			}
		}
	}

	public void validateClassInheritance(Node declaration) {
		string parent = DeclarationRegistry.parentName(declaration);
		if (parent != "" && !self.state.analyzed.isClass(parent) && !self.state.analyzed.isGenericClass(parent)) {
			TypeValidator.fail("Class '" + declaration.name + "' extends unknown class '" + parent + "'", declaration);
		}
		if (parent != "" && (declaration.genericParams.len > 0 || self.state.analyzed.isGenericClass(parent))) {
			TypeValidator.fail("Generic class inheritance is not supported: " + "class '" + declaration.name + "' extends '" + parent + "'", declaration);
		}
		self.validateClassInheritanceCycle(declaration);
	}

	public void validateClassContracts(Node declaration) {
		self.validateClassInheritance(declaration);
		self.validateConcreteAbstractMethods(declaration);
		Map<string, bool> visited = {};
		int index = 0;
		while (index < declaration.interfaces.len) {
			self.validateInterfaceRequirements(declaration, declaration.interfaces.get(index), visited);
			index = index + 1;
		}
	}

	public void validateInterfaceDeclarations(Node program) {
		int index = 0;
		while (index < program.declarations.len) {
			Node declaration = program.declarations.get(index);
			if (declaration.kind == NK_INTERFACE_DECL) {
				if (self.state.interfaces.has(declaration.name)) {
					TypeValidator.fail("Duplicate interface declaration '" + declaration.name + "'", declaration);
				}
				self.state.interfaces.put(declaration.name, declaration);
			}
			index = index + 1;
		}
		Vector<string> names = self.state.interfaces.keys();
		int interfaceIndex = 0;
		while (interfaceIndex < names.len) {
			Node declaration = self.state.interfaces.get(names.get(interfaceIndex));
			if (declaration.parent != null && !self.state.interfaces.has(declaration.parent)) {
				TypeValidator.fail("Interface '" + declaration.name + "' extends unknown interface '" + declaration.parent + "'", declaration);
			}
			if (declaration.parent != null && self.interfaceExtends(declaration.parent, declaration.name)) {
				TypeValidator.fail("Interface inheritance cycle involving '" + declaration.name + "'", declaration);
			}
			Map<string, bool> methodNames = {};
			int methodIndex = 0;
			while (methodIndex < declaration.methods.len) {
				Node method = declaration.methods.get(methodIndex);
				bool exposesRealtimeFunction = self.types.containsRealtimeFunctionStorage(method.returnType);
				int realtimeParameter = 0;
				while (realtimeParameter < method.params.len) {
					exposesRealtimeFunction = exposesRealtimeFunction || self.types.containsRealtimeFunctionStorage(method.params.get(realtimeParameter).type);
					realtimeParameter = realtimeParameter + 1;
				}
				if (exposesRealtimeFunction) {
					TypeValidator.fail("Interface method '" + declaration.name + "." + method.name + "' cannot expose RealtimeFunction; downgrade to CFunction at the boundary", method);
				}
				if (methodNames.has(method.name)) {
					TypeValidator.fail("Duplicate interface method '" + declaration.name + "." + method.name + "'", method);
				}
				methodNames.put(method.name, true);
				if (declaration.parent != null) {
					Node? inherited = self.interfaceMethod(declaration.parent, method.name);
					if (inherited != null) {
						Node inheritedMethod = inherited;
						if (!self.names.callableSignatureSame(method, inheritedMethod)) {
							TypeValidator.fail("Interface method '" + declaration.name + "." + method.name + "' conflicts with inherited signature", method);
						}
					}
				}
				methodIndex = methodIndex + 1;
			}
			interfaceIndex = interfaceIndex + 1;
		}
	}

	public void validateProperty(Node property, Node classDeclaration) {
		Node synthetic = Node();
		synthetic.kind = NK_METHOD_DECL;
		synthetic.access = property.access;
		synthetic.name = "get_" + property.name;
		synthetic.returnType = property.type;
		synthetic.bodyNode = property.getterBody;
		synthetic.hasGetter = true;
		synthetic.line = property.line;
		synthetic.col = property.col;
		if (property.getterBody != null) {
			self.validateCallableBody(synthetic, classDeclaration);
		}
		synthetic.name = "set_" + property.name;
		synthetic.returnType = SemanticTypeSystem.primitive("void");
		synthetic.bodyNode = property.setterBody;
		synthetic.hasGetter = false;
		if (property.setterBody != null) {
			Node valueParameter = Node();
			valueParameter.kind = NK_PARAM;
			valueParameter.name = "value";
			valueParameter.type = property.type;
			synthetic.params.push(valueParameter);
			self.validateCallableBody(synthetic, classDeclaration);
		}
	}

	public void validateClassBodies(Node declaration) {
		Map<string, Node> fieldVars = self.globalTypes(self.state.analyzed);
		fieldVars.put("self", self.selfType(declaration));
		Map<string, bool> previousParams = self.types.cloneFlags(self.state.typeParams);
		self.state.typeParams = self.types.typeParamSet(declaration.genericParams);
		int index = 0;
		while (index < declaration.members.len) {
			Node member = declaration.members.get(index);
			if (member.kind == NK_FIELD_DECL) {
				self.types.validateDeclaredType(member.type, "Field '" + declaration.name + "." + member.name + "'", "stable_field", member);
				self.types.rejectRuntimeInterfaceType(member.type, member);
				self.storage.validateArrayBound(member.type, "field '" + declaration.name + "." + member.name + "'", "field", member, fieldVars);
				Node? canonicalField = self.types.resolveAliases(member.type);
				if (canonicalField != null && canonicalField.isArray && canonicalField.arraySize != null) {
					Node elementType = TypeShape.withoutOuterArray(canonicalField);
					if (self.ownership.managedOwnershipType(elementType)) {
						TypeValidator.fail("Field '" + declaration.name + "." + member.name + "' cannot contain managed elements " + "without elementwise ownership support", member);
					}
				}
				if (member.access == "class" && canonicalField != null && canonicalField.base == "Mutex") {
					TypeValidator.fail("Static field '" + declaration.name + "." + member.name + "' cannot own a Mutex handle until managed global " + "teardown is supported", member);
				}
				if (member.initializer != null && canonicalField != null && canonicalField.isConst && canonicalField.pointerDepth == 0) {
					TypeValidator.fail("Field '" + declaration.name + "." + member.name + "' cannot initialize scalar const storage after allocation", member);
				}
				if (member.initializer != null) {
					Node? fieldValueType = self.storage.arrayFieldValueType(member);
					Node? canonicalFieldValue = self.types.resolveAliases(fieldValueType);
					if (member.access == "class" && canonicalField != null && canonicalField.isArray && canonicalFieldValue != null && !canonicalFieldValue.isArray && self.storage.aggregateArrayBacking(member.initializer)) {
						TypeValidator.fail("Field '" + declaration.name + "." + member.name + "' cannot use aggregate backing for " + "a pointer-valued array field", member);
					}
					if (member.access != "class" && canonicalField != null && canonicalField.isArray && (member.initializer.kind == NK_BRACE_INITIALIZER || member.initializer.kind == NK_LIST_LITERAL)) {
						TypeValidator.fail("Array-valued class field defaults require persistent " + "backing storage ('" + declaration.name + "." + member.name + "')", member);
					}
					if (member.access == "class" && !self.storage.staticInitializer(member.initializer, member.type)) {
						TypeValidator.fail("Static field '" + declaration.name + "." + member.name + "' requires a C constant/address initializer for " + "static storage", member);
					}
					self.expressions.contextualizeGenericConstructor(member.type, member.initializer, fieldVars);
					self.controlFlow.prepareExpression(member.initializer, fieldVars);
					self.expressions.validateExpr(member.initializer,  fieldVars);
					self.expressions.validateTypedInitializer(fieldValueType, member.initializer, "Field '" + declaration.name + "." + member.name + "'", fieldVars);
					Node? actual = self.types.inferType(member.initializer, fieldVars);
					if (actual != null && !self.expressions.contextualAggregateInitializer(member.initializer) && !self.types.assignmentCompatible(fieldValueType, actual)) {
						TypeValidator.fail("Field '" + declaration.name + "." + member.name + "' expects '" + self.types.formatType(member.type) + "' but got '" + self.types.formatType(actual) + "'", member);
					}
				}
			} else if (member.kind == NK_METHOD_DECL) {
				self.validateCallableBody(member, declaration);
			} else if (member.kind == NK_PROPERTY_DECL) {
				self.types.validateDeclaredType(member.type, "Property '" + declaration.name + "." + member.name + "'", "field", member);
				self.types.rejectRuntimeInterfaceType(member.type, member);
				Node? canonicalProperty = self.types.resolveAliases(member.type);
				if (canonicalProperty != null && canonicalProperty.isArray && canonicalProperty.arraySize != null) {
					TypeValidator.fail("Property '" + declaration.name + "." + member.name + "' cannot use fixed-size array storage; " + "use an instance field plus accessors", member);
				}
				if (member.hasSetter && canonicalProperty != null && canonicalProperty.isConst && canonicalProperty.pointerDepth == 0) {
					TypeValidator.fail("Property '" + declaration.name + "." + member.name + "' cannot have a setter for scalar const storage", member);
				}
				self.validateProperty(member, declaration);
			}
			index = index + 1;
		}
		self.state.typeParams = previousParams;
	}

	public Map<string, Node> globalTypes(Analyzed analyzed) { return TypeValidator.cloneTypes(analyzed.globalVarTypes); }

	public bool gpuDefaultInheritsArrayCapacity(Node expression, Vector<Node> params, int paramIndex) {
		if (expression == null || expression.kind != NK_IDENTIFIER) {
			return false;
		}
		int index = 0;
		while (index < paramIndex) {
			Node prior = params.get(index);
			Node? priorType = self.types.resolveAliases(prior.type);
			if (prior.name == expression.name && priorType != null && priorType.isArray) {
				return true;
			}
			index = index + 1;
		}
		return false;
	}

	public void validateParameterDefaults(Vector<Node> params, Map<string, Node> vars, Node owner) {
		bool sawDefault = false;
		int index = 0;
		while (index < params.len) {
			Node parameter = params.get(index);
			Node? parameterValueType = self.storage.arrayParameterValueType(parameter.type);
			self.types.rejectRuntimeInterfaceType(parameter.type, parameter);
			if (parameter.default_ != null) {
				sawDefault = true;
				self.expressions.contextualizeGenericConstructor(parameter.type, parameter.default_, vars);
				bool previousDefault = self.state.inParameterDefault;
				self.state.inParameterDefault = true;
				self.controlFlow.prepareExpression(parameter.default_, vars);
				self.expressions.validateExpr(parameter.default_,  vars);
				self.state.inParameterDefault = previousDefault;
				self.expressions.validateTypedInitializer(parameterValueType, parameter.default_, "Default for parameter '" + parameter.name + "'", vars);
				Node? actual = self.types.inferType(parameter.default_, vars);
				Node? gpuParameterType = self.types.resolveAliases(parameter.type);
				if (self.state.gpuCallable && gpuParameterType != null && gpuParameterType.isArray && actual != null && !self.gpuDefaultInheritsArrayCapacity(parameter.default_, params, index) && !self.storage.arrayTargetHasCapacity(parameter.default_, actual, vars)) {
					TypeValidator.fail("Default for parameter '" + parameter.name + "' has no provable readable GPU " + "buffer capacity", parameter.default_);
				}
				if (actual != null && !self.expressions.contextualAggregateInitializer(parameter.default_) && !self.types.assignmentCompatible(parameterValueType, actual)) {
					TypeValidator.fail("Default for parameter '" + parameter.name + "' expects '" + self.types.formatType(parameter.type) + "' but got '" + self.types.formatType(actual) + "'", parameter);
				}
			} else if (sawDefault) {
				TypeValidator.fail("Non-default parameter '" + parameter.name + "' follows default parameter", parameter);
			}
			if (parameterValueType != null) {
				vars.put(parameter.name, parameterValueType);
			}
			index = index + 1;
		}
	}

	public Node selfType(Node classDeclaration) {
		Node selfType = SemanticTypeSystem.namedClass(classDeclaration.name);
		selfType.pointerDepth = 1;
		int index = 0;
		while (index < classDeclaration.genericParams.len) {
			selfType.genericArgs.push(SemanticTypeSystem.primitive(classDeclaration.genericParams.get(index)));
			index = index + 1;
		}
		return selfType;
	}

	private Node declaredCallableReturnType(Node? classDeclaration, Node callable) {
		if (classDeclaration == null || !callable.isConstructor || callable.returnType.genericArgs.len > 0 || classDeclaration.genericParams.len == 0) {
			return callable.returnType;
		}
		Vector<Node> ownerArguments = [];
		int index = 0;
		while (index < classDeclaration.genericParams.len) {
			ownerArguments.push(SemanticTypeSystem.primitive(classDeclaration.genericParams.get(index)));
			index = index + 1;
		}
		return TypeShape.copyWithArguments(callable.returnType, ownerArguments);
	}

	public void validateCallableBody(Node callable, Node? classDeclaration) {
		if (classDeclaration == null) {
			self.validateHostedBodylessDeclaration(callable);
		}
		Map<string, bool> signaturePreviousParams = self.types.cloneFlags(self.state.typeParams);
		Vector<string> signatureClassParams = [];
		if (classDeclaration != null) {
			int signatureClassIndex = 0;
			while (signatureClassIndex < classDeclaration.genericParams.len) {
				signatureClassParams.push(classDeclaration.genericParams.get(signatureClassIndex));
				signatureClassIndex = signatureClassIndex + 1;
			}
		}
		self.state.typeParams = self.types.combinedTypeParams(signatureClassParams, callable.genericParams);
		Node declaredReturnType = self.declaredCallableReturnType(classDeclaration, callable);
		if (callable.bodyNode == null) {
			bool exposesRealtimeFunction = self.types.containsRealtimeFunctionStorage(declaredReturnType);
			int realtimeParameter = 0;
			while (realtimeParameter < callable.params.len) {
				exposesRealtimeFunction = exposesRealtimeFunction || self.types.containsRealtimeFunctionStorage(callable.params.get(realtimeParameter).type);
				realtimeParameter = realtimeParameter + 1;
			}
			if (exposesRealtimeFunction) {
				string callableLabel = classDeclaration == null ? "Native function declaration '" + callable.name + "'" : "Bodyless method '" + classDeclaration.name + "." + callable.name + "'";
				TypeValidator.fail(callableLabel + " cannot expose RealtimeFunction; downgrade to CFunction at the boundary", callable);
			}
		}
		string returnSubject = classDeclaration == null ? "Return type of function '" + callable.name + "'" : "Return type of method '" + classDeclaration.name + "." + callable.name + "'";
		self.types.validateDeclaredType(declaredReturnType, returnSubject, "return", callable);
		self.types.rejectRuntimeInterfaceType(declaredReturnType, callable);
		int typeIndex = 0;
		while (typeIndex < callable.params.len) {
			Node parameter = callable.params.get(typeIndex);
			self.names.validateGeneratedLexicalBindingName(parameter.name, "Parameter", parameter);
			self.types.validateDeclaredType(parameter.type, "Parameter '" + parameter.name + "'", "parameter", parameter);
			self.storage.validateGpuArrayParameter(callable, parameter);
			self.types.rejectRuntimeInterfaceType(parameter.type, parameter);
			typeIndex = typeIndex + 1;
		}
		self.state.typeParams = signaturePreviousParams;
		Node? previousReturn = self.state.returnType;
		string previousOwner = self.state.owner;
		Map<string, bool> previousParams = self.types.cloneFlags(self.state.typeParams);
		int previousLoop = self.state.loopDepth;
		int previousBreak = self.state.breakDepth;
		bool previousGpu = self.state.gpuCallable;
		Node? previousCallable = self.state.callable;
		Map<string, bool> previousParameterNames = self.types.cloneFlags(self.state.parameterNames);
		Map<string, bool> previousBorrowedBindings = self.types.cloneFlags(self.state.borrowedBindings);
		Map<string, bool> previousLocalBindings = self.types.cloneFlags(self.state.localBindings);
		Map<string, Node> vars = self.globalTypes(self.state.analyzed);
		Vector<string> classParams = [];
		if (classDeclaration != null) {
			int classParamIndex = 0;
			while (classParamIndex < classDeclaration.genericParams.len) {
				classParams.push(classDeclaration.genericParams.get(classParamIndex));
				classParamIndex = classParamIndex + 1;
			}
			self.state.owner = classDeclaration.name + "." + callable.name;
			if (callable.access != "class") {
				vars.put("self", self.selfType(classDeclaration));
			}
		} else {
			self.state.owner = callable.name;
		}
		self.state.typeParams = self.types.combinedTypeParams(classParams, callable.genericParams);
		bool isConstructor = classDeclaration != null && callable.isConstructor;
		if (isConstructor) {
			self.state.returnType = SemanticTypeSystem.primitive("void");
		} else {
			self.state.returnType = self.types.arrayValueType(callable.returnType);
		}
		self.state.loopDepth = 0;
		self.state.breakDepth = 0;
		self.state.gpuCallable = callable.isGpu;
		Map<string, bool> parameterNames = self.names.parameterNames(callable.params, "callable '" + self.state.owner + "'");
		self.state.callable = callable;
		self.state.parameterNames = self.types.cloneFlags(parameterNames);
		self.state.borrowedBindings = self.types.cloneFlags(parameterNames);
		self.state.localBindings = self.types.cloneFlags(parameterNames);
		if (classDeclaration != null && callable.access != "class") {
			self.state.borrowedBindings.put("self", true);
			self.state.localBindings.put("self", true);
		}
		if (callable.bodyNode != null) {
			self.names.validateDirectLocalNames(callable.bodyNode, parameterNames);
		}
		self.validateParameterDefaults(callable.params, vars, callable);
		if (callable.bodyNode != null) {
			bool ownsMemo = self.expressions.beginBodyMemo();
			self.controlFlow.validateBlock(callable.bodyNode,  vars);
			self.expressions.endBodyMemo(ownsMemo);
		}
		bool nonVoid = self.state.returnType != null && !TypeValidator.scalarVoid(self.state.returnType);
		if (callable.bodyNode != null && nonVoid && !ControlFlowValidator.blockTerminates(callable.bodyNode)) {
			TypeValidator.fail("Callable '" + self.state.owner + "' has non-void return type but does not return on every path", callable);
		}
		self.state.returnType = previousReturn;
		self.state.owner = previousOwner;
		self.state.typeParams = previousParams;
		self.state.loopDepth = previousLoop;
		self.state.breakDepth = previousBreak;
		self.state.gpuCallable = previousGpu;
		self.state.callable = previousCallable;
		self.state.parameterNames = previousParameterNames;
		self.state.borrowedBindings = previousBorrowedBindings;
		self.state.localBindings = previousLocalBindings;
	}

	public void validateRichEnumDefaults(Node declaration) {
		string previousOwner = self.state.owner;
		Node? previousCallable = self.state.callable;
		Map<string, bool> previousParameterNames = self.types.cloneFlags(self.state.parameterNames);
		Map<string, bool> previousBorrowedBindings = self.types.cloneFlags(self.state.borrowedBindings);
		Map<string, bool> previousLocalBindings = self.types.cloneFlags(self.state.localBindings);
		int variantIndex = 0;
		while (variantIndex < declaration.variants.len) {
			Node variant = declaration.variants.get(variantIndex);
			Map<string, bool> parameterNames = self.names.parameterNames(variant.params, "rich-enum variant '" + declaration.name + "." + variant.name + "'");
			self.state.owner = declaration.name + "." + variant.name;
			self.state.callable = variant;
			self.state.parameterNames = self.types.cloneFlags(parameterNames);
			self.state.borrowedBindings = self.types.cloneFlags(parameterNames);
			self.state.localBindings = self.types.cloneFlags(parameterNames);
			Map<string, Node> vars = self.globalTypes(self.state.analyzed);
			self.validateParameterDefaults(variant.params, vars, variant);
			variantIndex = variantIndex + 1;
		}
		self.state.owner = previousOwner;
		self.state.callable = previousCallable;
		self.state.parameterNames = previousParameterNames;
		self.state.borrowedBindings = previousBorrowedBindings;
		self.state.localBindings = previousLocalBindings;
	}

	class string structFieldTarget(Node typeExpr, Map<string, Node> declarations, Map<string, Node> registrations) {
		if (typeExpr.pointerDepth > 0) { return ""; }
		if (typeExpr.base.startsWith("struct ")) {
			return typeExpr.base.substring(7, typeExpr.base.length() - 7);
		}
		if (declarations.has(typeExpr.base) || registrations.has(typeExpr.base)) {
			return typeExpr.base;
		}
		return "";
	}

	class void visitStructDefinition(string name, Map<string, Node> declarations, Map<string, Node> registrations, Map<string, int> states, Vector<Node> ordered) {
		if (states.has(name) && states.get(name) == 2) { return; }
		Node declaration = declarations.get(name);
		if (states.has(name) && states.get(name) == 1) {
			TypeValidator.fail("By-value struct dependency cycle involving '" + name + "'", declaration);
		}
		states.put(name, 1);
		int fieldIndex = 0;
		while (fieldIndex < declaration.fields.len) {
			Node field = declaration.fields.get(fieldIndex);
			string target = DeclarationValidator.structFieldTarget(field.type, declarations, registrations);
			if (target != "") {
				if (!declarations.has(target)) {
					if (registrations.has(target) && registrations.get(target).isForward) {
						TypeValidator.fail("Struct field '" + name + "." + field.name + "' uses incomplete struct '" + target + "' by value", field);
					}
				} else {
					DeclarationValidator.visitStructDefinition(target, declarations, registrations, states, ordered);
				}
			}
			fieldIndex = fieldIndex + 1;
		}
		states.put(name, 2);
		ordered.push(declaration);
	}

	class Vector<Node> orderedStructDefinitions(Node program, Map<string, Node> registrations) {
		Map<string, Node> declarations = {};
		Vector<string> sourceOrder = [];
		int index = 0;
		while (index < program.declarations.len) {
			Node declaration = program.declarations.get(index);
			if (declaration.kind == NK_STRUCT_DECL && !declaration.isForward) {
				declarations.put(declaration.name, declaration);
				sourceOrder.push(declaration.name);
			}
			index = index + 1;
		}
		Map<string, int> states = {};
		Vector<Node> ordered = [];
		index = 0;
		while (index < sourceOrder.len) {
			DeclarationValidator.visitStructDefinition(sourceOrder.get(index), declarations, registrations, states, ordered);
			index = index + 1;
		}
		return ordered;
	}

	public void validateStructLayouts(Node program) { DeclarationValidator.orderedStructDefinitions(program, self.state.analyzed.structTable); }
}
