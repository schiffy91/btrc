/* Retained generic normalization, inference, and closure owner. */

import Library.Map;
import Library.Strings;
import Library.Vector;

import ../generated/ast/Node.btrc;
import ../frontend/Models.btrc;
import ../frontend/Timing.btrc;
import ../syntax/Identity.btrc;
import ../syntax/Types.btrc;
import ./Declarations.btrc;
import ./Expressions.btrc;
import ./HostedAbi.btrc;
import ./Models.btrc;
import ./Operators.btrc;
import ./Types.btrc;

/* One edge of the type-parameter use graph: a type parameter flowing into a
 * parameter of the generic it uses (the reference's _add_use key). */
class GenericUse {
	public string source;
	public string target;
	public bool growing;
	public int line;
	public int col;
	public string generic;

	public GenericUse(string source, string target, bool growing, int line, int col, string generic) {
		self.source = source;
		self.target = target;
		self.growing = growing;
		self.line = line;
		self.col = col;
		self.generic = generic;
	}
}

/* A generic-method call a template makes in its own type parameters, kept in
 * the template's terms until a specialization of the template is reached. */
class TemplateMethodCall {
	public string owner;
	public string method;
	public Vector<Node> classArgs;
	public Vector<string> methodParameters;
	public Vector<Node> methodArgs;
	public int line;
	public int col;

	public TemplateMethodCall(string owner, string method, Vector<Node> classArgs, Vector<string> methodParameters, Vector<Node> methodArgs, int line, int col) {
		self.owner = owner;
		self.method = method;
		self.classArgs = classArgs;
		self.methodParameters = methodParameters;
		self.methodArgs = methodArgs;
		self.line = line;
		self.col = col;
	}
}

class GenericSpecializer {
	private Analyzed analyzed;
	private OperatorSemantics operators;
	private ExpressionTypeResolver expressions;
	private Map<string, bool> validatedSpecializations;
	/* Instances whose bodies the closure already walked. Discovery closes the
	 * graph twice per analysis, once after class generics and once after
	 * method generics are collected; a scan is deterministic for its instance,
	 * so only instances registered since the last closure need walking. */
	private Map<string, bool> closedClassInstances;
	private Map<string, bool> closedMethodInstances;
	/* Type parameters of the template whose body is being scanned, if any. */
	private Map<string, bool> templateParameters;
	private IValidationRecords? records = null;
	/* Whether validation's facts exist yet: instance scans that run before and
	 * after validation are recorded apart. */
	private bool validated = false;
	/* hosted_abi.toml's limits.generic_argument_nesting. */
	private int nestingLimit;
	/* The declaration whose specialization is being scanned ("" for none),
	 * and its method when the scan is a generic method's. */
	private string scopeOwner;
	private string scopeMethod;
	/* The declaration whose template body the method-generics walk is in. */
	/* The generic method of the scanned class instance whose body or
	 * signature is being scanned (the reference's _member_method). */
	private string memberOwner;
	private string memberMethod;
	private string templateOwner;
	private string templateMethod;
	/* The type-parameter use graph (the reference's _uses and _successors). */
	private Map<string, bool> useKeys;
	private Vector<GenericUse> uses;
	private Map<string, Vector<string>> successors;
	/* Whether the graph holds a growing cycle; from then on no derived
	 * specialization is admitted, and reportGrowth names it once discovery
	 * drains. */
	private bool growthFound;
	/* Template generic-method calls by scope, and the scopes a specialization
	 * has reached; a call's uses join the graph once its scope is reached. */
	private Map<string, Vector<TemplateMethodCall>> templateCalls;
	private Map<string, bool> templateCallKeys;
	/* Whether the method-generics walk only gathers template calls. */
	private bool gatheringTemplates;
	private Map<string, bool> reachedScopes;

	public GenericSpecializer(Analyzed analyzed, OperatorSemantics operators, ExpressionTypeResolver expressions, int nestingLimit) {
		self.nestingLimit = nestingLimit;
		self.scopeOwner = "";
		self.scopeMethod = "";
		self.memberOwner = "";
		self.memberMethod = "";
		self.templateOwner = "";
		self.templateMethod = "";
		self.useKeys = {};
		self.uses = [];
		self.successors = {};
		self.growthFound = false;
		self.templateCalls = {};
		self.templateCallKeys = {};
		self.gatheringTemplates = false;
		self.reachedScopes = {};
		self.closedClassInstances = {};
		self.closedMethodInstances = {};
		self.templateParameters = {};
		self.analyzed = analyzed;
		self.operators = operators;
		self.expressions = expressions;
		self.validatedSpecializations = {};
	}

	public void discover(Node program) {
		int index = 0;
		while (index < program.declarations().len) {
			self.upgradeDeclGenericArgs(program.declarations().get(index), self.analyzed);
			index = index + 1;
		}
		BtrccPhaseTimer.mark("g-upgrade");
		index = 0;
		while (index < program.declarations().len) {
			self.collectGenericsDecl(program.declarations().get(index), self.analyzed);
			index = index + 1;
		}
		BtrccPhaseTimer.mark("g-collect");
		/* The use graph needs every template's generic-method calls before the
		 * first closure specializes anything, as the reference's template
		 * dependencies are; gather them without registering instances. */
		self.gatheringTemplates = true;
		for declaration in program.declarations() {
			if (declaration.kind == NK_CLASS_DECL) { self.collectMethodGenericsDecl(declaration, self.analyzed, self.operators); }
		}
		self.gatheringTemplates = false;
		BtrccPhaseTimer.mark("g-templates");
		self.registerTransitiveGenericInstances(self.analyzed, self.operators);
		BtrccPhaseTimer.mark("g-transitive");
		index = 0;
		while (index < program.declarations().len) {
			Node declaration = program.declarations().get(index);
			if (!self.replayRecorded(RECORD_PHASE_DISCOVER, declaration)) {
				ValidationJournal? journal = self.beginJournal(RECORD_PHASE_DISCOVER, declaration);
				self.collectMethodGenericsDecl(declaration, self.analyzed, self.operators);
				self.endJournal(RECORD_PHASE_DISCOVER, declaration, journal);
			}
			index = index + 1;
		}
		BtrccPhaseTimer.mark("g-method-scan");
		self.registerTransitiveGenericInstances(self.analyzed, self.operators);
		BtrccPhaseTimer.mark("g-transitive-methods");
		self.reportGrowth();
	}

	public void useRecords(IValidationRecords? records) { self.records = records; }

	/* Stage B: a function's or class's recorded generic demand for `phase`,
	 * replayed in its original order before de-duplication, so the instance
	 * lists and call arguments come out exactly as a live scan leaves them.
	 * False when the declaration must be scanned live. */
	private bool replayRecorded(int phase, Node declaration) {
		IValidationRecords? records = self.records;
		if (records == null || (declaration.kind != NK_FUNCTION_DECL && declaration.kind != NK_CLASS_DECL)) { return false; }
		Vector<ValidationFact>? facts = records.recorded(phase, declaration);
		if (facts == null) { return false; }
		self.replayDemand(facts);
		return true;
	}

	/* Recorded demand, re-applied exactly as the scan applied it: each
	 * instance is de-duplicated and pushed, and call arguments go to the
	 * active instance's table. */
	private void replayDemand(Vector<ValidationFact> facts) {
		Analyzed a = self.analyzed;
		for fact in facts {
			if (fact.kind == VALIDATION_GENERIC_CLASS) {
				string key = TypeIdentity.genericInstanceKey(fact.name, fact.arguments);
				if (!a.genericSeen.has(key)) {
					a.genericSeen.put(key, true);
					a.genericInstances.push(GenInstance(fact.name, fact.arguments, TypeIdentity.mangleGenericType(fact.name, fact.arguments)));
				}
			} else if (fact.kind == VALIDATION_GENERIC_METHOD) {
				string key = TypeIdentity.methodInstanceKey(fact.name, fact.arguments, fact.member, fact.moreArguments);
				if (!a.methodGenSeen.has(key)) {
					a.methodGenSeen.put(key, true);
					a.methodGenInstances.push(MethodGenInstance(fact.name, fact.member, fact.arguments, fact.moreArguments));
				}
			} else if (fact.kind == VALIDATION_CALL_ARGUMENTS) {
				Node? call = fact.node;
				if (call != null) { a.recordMethodCallArguments(call, fact.arguments); }
			}
		}
	}

	private string instanceSection(string context) { return (self.validated ? "after" : "before") + "\t" + context; }

	/* An instance's recorded scan, replayed under its specialization context;
	 * false when it must be scanned live. */
	private bool replayInstance(Node? template, string context) {
		IValidationRecords? records = self.records;
		if (records == null || template == null) { return false; }
		Vector<ValidationFact>? facts = records.recordedInstance(template, self.instanceSection(context));
		if (facts == null) { return false; }
		string previous = self.analyzed.beginInstance(context);
		self.replayDemand(facts);
		self.analyzed.endInstance(previous);
		return true;
	}

	private ValidationJournal? beginInstanceJournal(Node? template) {
		IValidationRecords? records = self.records;
		if (records == null || template == null || !records.journalsInstance(template)) { return null; }
		ValidationJournal journal = ValidationJournal();
		self.analyzed.journal = journal;
		return journal;
	}

	private void endInstanceJournal(Node? template, string context, ValidationJournal? journal) {
		if (template == null || journal == null) { return; }
		self.analyzed.journal = null;
		IValidationRecords? records = self.records;
		if (records != null && !records.finishInstance(template, self.instanceSection(context), journal)) {
			fprintf(stderr, "error: generic instance record disagrees with live analysis for %s\n", context);
			exit(1);
		}
	}

	private ValidationJournal? beginJournal(int phase, Node declaration) {
		IValidationRecords? records = self.records;
		if (records == null || (declaration.kind != NK_FUNCTION_DECL && declaration.kind != NK_CLASS_DECL) || !records.journals(phase, declaration)) { return null; }
		ValidationJournal journal = ValidationJournal();
		self.analyzed.journal = journal;
		return journal;
	}

	private void endJournal(int phase, Node declaration, ValidationJournal? journal) {
		if (journal == null) { return; }
		self.analyzed.journal = null;
		IValidationRecords? records = self.records;
		if (records != null && !records.finish(phase, declaration, journal)) {
			fprintf(stderr, "error: generic analysis record disagrees with live analysis at %d:%d\n", declaration.line, declaration.col);
			exit(1);
		}
	}

	public void closeExpressionGraph(Node program, HostedAbiRepository hostedAbi) {
		self.validated = true;
		self.collectNativeCallbackInstances(hostedAbi);
		BtrccPhaseTimer.mark("c-native");
		self.closeProgramGenericExpressionGraph(program, self.analyzed, self.operators);
		self.reportGrowth();
	}

	private void collectNativeCallbackInstances(HostedAbiRepository hostedAbi) {
		for imported in self.analyzed.nativeDeclarations {
			Vector<Node> members = imported.declaration.members();
			if (imported.declaration.kind == NK_FUNCTION_DECL) { members = [imported.declaration]; }
			for member in members {
				FeNativeCallContract? contract = imported.callContract;
				if (member.kind != NK_FUNCTION_DECL) { contract = imported.methods.has(member.name) ? imported.methods.get(member.name) : null; }
				if (contract == null) { continue; }
				if ((contract.copiedResult != null && contract.copiedResult.kind == "bytes") || (contract.recordSnapshot != null && !contract.recordSnapshot.byteField.isEmpty())) {
					Node? constructor = self.analyzed.classConstructor("Bytes");
					Node? fromRaw = self.analyzed.classMethod("Bytes", "fromRaw");
					if (constructor == null || fromRaw == null || !hostedAbi.compilerStdlibNode(constructor) || !hostedAbi.compilerStdlibNode(fromRaw)) { throw "Copied native bytes require authenticated import Library.Bytes"; }
				}
				for callback in contract.callbacks {
					if (callback.unregister == null && !callback.oneShot) { continue; }
					if (callback.realtime != null) {
						Node? constructor = self.analyzed.classConstructor("CallbackState");
						if (constructor == null || !hostedAbi.compilerStdlibNode(constructor)) { throw "Stored native callbacks require import Library.Callback"; }
						continue;
					}
					Node context = member.returnType;
					if (callback.oneShot && context.base == "CallbackResult") {
						if (!self.analyzed.genericClassTable.has(context.base) || !hostedAbi.compilerStdlibNode(self.analyzed.genericClassTable.get(context.base))) { throw "Stored native callbacks require import Library.Callback"; }
						self.registerGenericInstanceWithUnresolved(context, self.analyzed, {});
						context = context.genericArgs().get(1);
					}
					if (!self.analyzed.genericClassTable.has(context.base) || !hostedAbi.compilerStdlibNode(self.analyzed.genericClassTable.get(context.base))) { throw "Stored native callbacks require import Library.Callback"; }
					Vector<string> methods = ["activate", "publish", "abortActivation", "enter", "leave", "close", "cancel", "pollCompletion"];
					if (callback.oneShot) { methods.push("complete"); }
					for name in methods {
						Node? method = self.analyzed.genericClassMethod(context.base, name);
						if (method == null || !hostedAbi.compilerStdlibNode(method)) { throw "Stored native callbacks require import Library.Callback"; }
					}
					var unregister = callback.unregister;
					if (!callback.oneShot && unregister != null && unregister.signature.parameters.len > 0 && !unregister.classMethod) {
						Node token = context.genericArgs().get(1);
						if (!self.analyzed.genericClassTable.has(token.base) || !hostedAbi.compilerStdlibNode(self.analyzed.genericClassTable.get(token.base))) { throw "Stored native callbacks require import Library.Callback"; }
						for name in ["publish", "source", "value"] {
							Node? method = self.analyzed.genericClassMethod(token.base, name);
							if (method == null || !hostedAbi.compilerStdlibNode(method)) { throw "Stored native callbacks require import Library.Callback"; }
						}
						self.registerGenericInstanceWithUnresolved(token, self.analyzed, {});
					}
					/* Class closure scans the actual specialized methods, including
					 * dependencies invoked only by generated native ingress. */
					self.registerGenericInstanceWithUnresolved(context, self.analyzed, {});
				}
			}
		}
	}

	/* --- Generic-method instance collection (varTypes-tracking body walk). ---
     * Walks each function/method body building a {var -> TypeExpr} map (the same
     * map IR-gen later uses), and at every method call whose resolved method has
     * its own type parameters, infers the concrete method type args and records a
     * monomorphization target. Each body owns one expression-inference memo, as
     * IR lowering does: every receiver in a deep builder chain is otherwise
     * re-inferred once per enclosing call, which is exponential in chain depth
     * and matches the reference analyzer's session-wide node-type cache. */
	private void collectMethodGenericsDecl(Node d, Analyzed a, OperatorSemantics operators) {
		if (d.kind == NK_FUNCTION_DECL) {
			Map<string, Node> vt = {};
			int i = 0;
			while (i < d.params().len) {
				vt.put(d.params().get(i).name, d.params().get(i).type);
				i = i + 1;
			}
			if (d.bodyNode != null) {
				bool ownsMemo = self.expressions.beginScopedMemo();
				self.collectMethodGenericsBlock(d.bodyNode, a, operators, vt);
				self.expressions.endScopedMemo(ownsMemo);
			}
		} else if (d.kind == NK_CLASS_DECL && d.genericParams().len == 0) {
			int i = 0;
			while (i < d.members().len) {
				Node mem = d.members().get(i);
				bool genericMethod = mem.kind == NK_METHOD_DECL && mem.genericParams().len > 0;
				if (mem.kind == NK_METHOD_DECL && mem.bodyNode != null && (genericMethod || !self.gatheringTemplates)) {
					Map<string, Node> vt = {};
					Node selfT = SemanticTypeSystem.namedClass(d.name);
					selfT.pointerDepth = 1;
					vt.put("self", selfT);
					int p = 0;
					while (p < mem.params().len) {
						vt.put(mem.params().get(p).name, mem.params().get(p).type);
						p = p + 1;
					}
					/* A generic method's body is a template in its own parameters. */
					Map<string, bool> previousParameters = self.templateParameters;
					self.templateParameters = SemanticTypeSystem.genericParameterSet(mem.genericParams());
					self.templateOwner = d.name;
					self.templateMethod = mem.genericParams().len > 0 ? mem.name : "";
					bool ownsMemo = self.expressions.beginScopedMemo();
					self.collectMethodGenericsBlock(mem.bodyNode, a, operators, vt);
					self.expressions.endScopedMemo(ownsMemo);
					self.templateParameters = previousParameters;
					self.templateOwner = "";
					self.templateMethod = "";
				}
				i = i + 1;
			}
		} else if (d.kind == NK_CLASS_DECL) {
			/* Generic-class method bodies are templates. Their calls are recorded
			 * in the template's own terms for validating the template; concrete
			 * instances come from the per-instance closure scans. */
			Vector<Node> parameters = [];
			for name in d.genericParams() {
				Node parameter = Node();
				parameter.kind = NK_TYPE_EXPR;
				parameter.base = name;
				parameters.push(parameter);
			}
			for member in d.members() {
				if (member.kind != NK_METHOD_DECL || member.bodyNode == null) { continue; }
				Map<string, bool> previous = self.templateParameters;
				self.templateParameters = SemanticTypeSystem.genericParameterSet(d.genericParams());
				for name in member.genericParams() { self.templateParameters.put(name, true); }
				self.templateOwner = d.name;
				self.templateMethod = member.genericParams().len > 0 ? member.name : "";
				Map<string, Node> vt = {};
				vt.put("self", self.genericClosureSelfType(d.name, parameters));
				for parameter in member.params() { vt.put(parameter.name, parameter.type); }
				bool ownsMemo = self.expressions.beginScopedMemo();
				self.collectMethodGenericsBlock(member.bodyNode, a, operators, vt);
				self.expressions.endScopedMemo(ownsMemo);
				self.templateParameters = previous;
				self.templateOwner = "";
				self.templateMethod = "";
			}
		}
	}

	private void collectMethodGenericsBlock(Node block, Analyzed a, OperatorSemantics operators, Map<string, Node> vt) {
		if (block == null) { return; }
		int i = 0;
		while (i < block.statements().len) {
			self.collectMethodGenericsStmt(block.statements().get(i), a, operators, vt);
			i = i + 1;
		}
	}

	private void collectMethodGenericsStmt(Node s, Analyzed a, OperatorSemantics operators, Map<string, Node> vt) {
		if (s == null) { return; }
		if (s.kind == NK_VAR_DECL_STMT) {
			self.collectMethodGenericsExpr(s.initializer, a, operators, vt);
			if (s.type != null) {
				vt.put(s.name, s.type);
			} else if (s.initializer != null) {
				Node? it = self.expressions.inferSpecialization(s.initializer, vt);
				if (it != null) { vt.put(s.name, it); }
			}
		} else if (s.kind == NK_RETURN_STMT) {
			self.collectMethodGenericsExpr(s.valueNode, a, operators, vt);
		} else if (s.kind == NK_EXPR_STMT) {
			self.collectMethodGenericsExpr(s.expr, a, operators, vt);
		} else if (s.kind == NK_IF_STMT) {
			self.collectMethodGenericsExpr(s.condition, a, operators, vt);
			self.collectMethodGenericsBlock(s.thenBlock, a, operators, vt);
			if (s.elseBlock != null) {
				self.collectMethodGenericsStmt(s.elseBlock, a, operators, vt);
			}
		} else if (s.kind == NK_ELSE_BLOCK) {
			self.collectMethodGenericsBlock(s.bodyNode, a, operators, vt);
		} else if (s.kind == NK_ELSE_IF) {
			self.collectMethodGenericsStmt(s.ifStmt, a, operators, vt);
		} else if (s.kind == NK_WHILE_STMT || s.kind == NK_DO_WHILE_STMT) {
			self.collectMethodGenericsExpr(s.condition, a, operators, vt);
			self.collectMethodGenericsBlock(s.bodyNode, a, operators, vt);
		} else if (s.kind == NK_C_FOR_STMT) {
			if (s.init != null) {
				if (s.init.kind == NK_FOR_INIT_VAR) {
					for declaration in s.init.declarations() { self.collectMethodGenericsStmt(declaration, a, operators, vt); }
				} else if (s.init.kind == NK_FOR_INIT_EXPR) {
					self.collectMethodGenericsExpr(s.init.expression, a, operators, vt);
				}
			}
			self.collectMethodGenericsExpr(s.condition, a, operators, vt);
			self.collectMethodGenericsExpr(s.update, a, operators, vt);
			self.collectMethodGenericsBlock(s.bodyNode, a, operators, vt);
		} else if (s.kind == NK_FOR_IN_STMT || s.kind == NK_PARALLEL_FOR_STMT) {
			self.collectMethodGenericsExpr(s.iterable, a, operators, vt);
			self.collectMethodGenericsBlock(s.bodyNode, a, operators, vt);
		} else if (s.kind == NK_DELETE_STMT) {
			self.collectMethodGenericsExpr(s.expr, a, operators, vt);
		} else if (s.kind == NK_TRY_CATCH_STMT) {
			if (s.tryBlock != null) {
				self.collectMethodGenericsBlock(s.tryBlock, a, operators, vt);
			}
			if (s.catchBlock != null) {
				self.collectMethodGenericsBlock(s.catchBlock, a, operators, vt);
			}
			if (s.finallyBlock != null) {
				self.collectMethodGenericsBlock(s.finallyBlock, a, operators, vt);
			}
		} else if (s.kind == NK_SWITCH_STMT) {
			self.collectMethodGenericsExpr(s.valueNode, a, operators, vt);
			int ci = 0;
			while (ci < s.cases().len) {
				Node c = s.cases().get(ci);
				self.collectMethodGenericsExpr(c.valueNode, a, operators, vt);
				int cj = 0;
				while (cj < c.bodyNodeList().len) {
					self.collectMethodGenericsStmt(c.bodyNodeList().get(cj), a, operators, vt);
					cj = cj + 1;
				}
				ci = ci + 1;
			}
		} else if (s.kind == NK_BLOCK) {
			self.collectMethodGenericsBlock(s, a, operators, vt);
		}
	}

	private void collectMethodGenericsExpr(Node e, Analyzed a, OperatorSemantics operators, Map<string, Node> vt) {
		if (e == null) { return; }
		if (e.kind == NK_CALL_EXPR) {
			self.collectMethodGenericCall(e, a, operators, vt);
		}
		self.collectMethodGenericsExpr(e.callee, a, operators, vt);
		self.collectMethodGenericsExpr(e.left, a, operators, vt);
		self.collectMethodGenericsExpr(e.right, a, operators, vt);
		self.collectMethodGenericsExpr(e.operand, a, operators, vt);
		self.collectMethodGenericsExpr(e.expr, a, operators, vt);
		self.collectMethodGenericsExpr(e.obj, a, operators, vt);
		self.collectMethodGenericsExpr(e.index, a, operators, vt);
		self.collectMethodGenericsExpr(e.condition, a, operators, vt);
		self.collectMethodGenericsExpr(e.trueExpr, a, operators, vt);
		self.collectMethodGenericsExpr(e.falseExpr, a, operators, vt);
		self.collectMethodGenericsExpr(e.target, a, operators, vt);
		self.collectMethodGenericsExpr(e.valueNode, a, operators, vt);
		int i = 0;
		while (i < e.args().len) {
			self.collectMethodGenericsExpr(e.args().get(i), a, operators, vt);
			i = i + 1;
		}
		if (e.kind == NK_COMMA_EXPR) {
			for element in e.elements() { self.collectMethodGenericsExpr(element, a, operators, vt); }
		}
	}

	/* If `call` is an instance method call to a generic method, infer its method
     * type args and record a monomorphization target. Mirrors
     * generic_methods._collect_generic_method_instance. */
	private void collectMethodGenericCall(Node call, Analyzed a, OperatorSemantics operators, Map<string, Node> vt) {
		Node callee = call.callee;
		if (callee == null || callee.kind != NK_FIELD_ACCESS_EXPR) { return; }
		Node objNode = callee.obj;
		string method = callee.field;
		/* Static (ClassName.method) calls are not receiver-instance method generics. */
		if (objNode != null && objNode.kind == NK_IDENTIFIER && a.isClass(objNode.name)) {
			return;
		}
		Node? ot = self.expressions.inferSpecialization(objNode, vt);
		if (ot == null) { return; }
		/* Resolve the owning method declaration (generic instance OR plain class).
         * `classArgs` is a FRESH copy of the receiver's generic args (never an alias
         * of the AST's `ot.generic_args` — aliasing a borrowed managed vector into a
         * scope-released local would underflow its refcount and free the AST node). */
		Node? methodDecl = null;
		string classBase = "";
		Vector<Node> classArgs = [];
		bool ownerGeneric = ot.genericArgs().len > 0 && a.isGenericClass(ot.base);
		if (ownerGeneric) {
			methodDecl = a.genericClassMethod(ot.base, method);
			classBase = ot.base;
			int ca = 0;
			while (ca < ot.genericArgs().len) { classArgs.push(ot.genericArgs().get(ca)); ca = ca + 1; }
		} else if (a.isClass(ot.base)) {
			methodDecl = a.classMethod(ot.base, method);
			classBase = ot.base;
		} else {
			return;
		}
		if (methodDecl == null || methodDecl.kind != NK_METHOD_DECL) { return; }
		if (methodDecl.genericParams().len == 0) { return; }

		/* Class-level substitutions (e.g. {T: int} for Vector<int>). */
		Map<string, Node> classSubs = {};
		if (ownerGeneric) {
			Node gdecl = a.genericClassTable.get(ot.base);
			int gi = 0;
			while (gi < gdecl.genericParams().len && gi < ot.genericArgs().len) {
				classSubs.put(gdecl.genericParams().get(gi), ot.genericArgs().get(gi));
				gi = gi + 1;
			}
		}

		/* Infer each method type parameter from the arguments. */
		Map<string, Node> methodSubs = {};
		self.inferMethodTypeArgs(call, methodDecl, classSubs, a, operators, vt, methodSubs);
		Vector<Node> methodArgs = [];
		Map<string, bool> tparams = SemanticTypeSystem.genericParameterSet(methodDecl.genericParams());
		int mp = 0;
		bool ok = true;
		while (mp < methodDecl.genericParams().len) {
			string gp = methodDecl.genericParams().get(mp);
			if (!methodSubs.has(gp)) { ok = false; }
			else {
				Node arg = methodSubs.get(gp);
				if (TypeIdentity.referencesNames(arg, tparams)) { ok = false; }
				else { methodArgs.push(arg); }
			}
			mp = mp + 1;
		}
		/* A call in a template whose type arguments name the template's
		 * parameters carries them into every specialization of the template
		 * (the reference records it as a template dependency); its uses join
		 * the use graph once the template's scope is reached. */
		if (self.templateParameters.len > 0 && self.templateOwner != "") {
			bool symbolic = false;
			Vector<string> methodParameters = [];
			Vector<Node> symbolicArgs = [];
			for argument in classArgs {
				if (TypeIdentity.referencesNames(argument, self.templateParameters)) { symbolic = true; }
			}
			for parameter in methodDecl.genericParams() {
				if (methodSubs.has(parameter)) {
					methodParameters.push(parameter);
					symbolicArgs.push(methodSubs.get(parameter));
					if (TypeIdentity.referencesNames(methodSubs.get(parameter), self.templateParameters)) { symbolic = true; }
				}
			}
			if (symbolic) {
				self.addTemplateCall(call, TemplateMethodCall(classBase, method, classArgs, methodParameters, symbolicArgs, call.line, call.col));
			}
		}
		if (!ok || self.gatheringTemplates) { return; }
		/* A template call whose args name the template's parameters is not an
		 * instance; keep its args for validating the template itself. */
		if (self.templateParameters.len > 0) {
			bool templated = false;
			for argument in classArgs { if (TypeIdentity.referencesNames(argument, self.templateParameters)) { templated = true; } }
			for argument in methodArgs { if (TypeIdentity.referencesNames(argument, self.templateParameters)) { templated = true; } }
			if (templated) {
				a.recordMethodCallArguments(call, methodArgs);
				return;
			}
		}

		string owner = classBase + "." + method;
		string key = TypeIdentity.methodInstanceKey(classBase, classArgs, method, methodArgs);
		if (!a.methodGenSeen.has(key)) {
			Vector<Node> instanceArguments = [];
			for argument in classArgs { instanceArguments.push(argument); }
			for argument in methodArgs { instanceArguments.push(argument); }
			if (!self.admitSpecialization("method '" + owner + "'", instanceArguments, call)) { return; }
		}
		self.validateGenericArgumentsForOwner(owner, methodArgs);

		/* Resolve and validate the full signature before recording an instance.
         * This catches nested-array composition and nested writable class
         * specializations after class- and method-level substitution. */
		Map<string, Node> full = {};
		Vector<string> csk = classSubs.keys();
		int ci = 0;
		while (ci < csk.len) {
			full.put(csk.get(ci), classSubs.get(csk.get(ci)));
			ci = ci + 1;
		}
		int mi = 0;
		while (mi < methodDecl.genericParams().len) {
			string gp = methodDecl.genericParams().get(mi);
			if (methodSubs.has(gp)) { full.put(gp, methodSubs.get(gp)); }
			mi = mi + 1;
		}
		self.validateSpecializedType(owner, methodDecl.returnType, full, a);
		int vsi = 0;
		while (vsi < methodDecl.params().len) {
			self.validateSpecializedType(owner, methodDecl.params().get(vsi).type, full, a);
			vsi = vsi + 1;
		}

		ValidationFact? demand = a.journalFact(VALIDATION_GENERIC_METHOD, null, null);
		if (demand != null) {
			demand.name = classBase;
			demand.member = method;
			demand.arguments = classArgs;
			demand.moreArguments = methodArgs;
		}
		if (!a.methodGenSeen.has(key)) {
			a.methodGenSeen.put(key, true);
			a.methodGenInstances.push(MethodGenInstance(classBase, method, classArgs, methodArgs));
		}
		/* Record per-call-site method args for IR-gen mangling, per instance
		 * while an instance's body is scanned. */
		a.recordMethodCallArguments(call, methodArgs);

		/* Register concrete generic types that the substituted signature mentions
         * (e.g. Vector<string> from mapTo's return type), reached from this
         * method instance. */
		string previousOwner = self.scopeOwner;
		string previousMethod = self.scopeMethod;
		self.enterScope(classBase, method);
		self.registerSubstitutedGenerics(methodDecl.returnType, full, a);
		int pi = 0;
		while (pi < methodDecl.params().len) {
			self.registerSubstitutedGenerics(methodDecl.params().get(pi).type, full, a);
			pi = pi + 1;
		}
		self.scopeOwner = previousOwner;
		self.scopeMethod = previousMethod;
	}

	/* Resolve `t` through `subs` and register any concrete generic instance it
     * (or its nested args) names. */
	private void registerSubstitutedGenerics(Node? t, Map<string, Node> subs, Analyzed a) {
		if (t == null) { return; }
		self.recordUses(t);
		Node resolved = SemanticTypeSystem.resolveGenericType(t, subs, a);
		self.registerGenericInstance(resolved, a);
	}

	/* Infer concrete bindings for each method type parameter by unifying every
     * method parameter's declared type (after class-level substitution) against
     * the corresponding argument's inferred type. Writes results into `subs`. */
	private void inferMethodTypeArgs(Node call, Node method, Map<string, Node> classSubs, Analyzed a, OperatorSemantics operators, Map<string, Node> vt, Map<string, Node> subs) {
		/* Set of method type-param names. */
		Map<string, bool> tparams = {};
		int t = 0;
		while (t < method.genericParams().len) {
			tparams.put(method.genericParams().get(t), true);
			t = t + 1;
		}
		int i = 0;
		while (i < method.params().len && i < call.args().len) {
			Node declared = SemanticTypeSystem.resolveGenericType(method.params().get(i).type, classSubs, a);
			Node? actual = self.expressions.genericArgumentType(call.args().get(i), vt);
			if (actual != null) {
				SemanticTypeSystem.unifyGenericParameter(declared, actual, tparams, subs);
			}
			i = i + 1;
		}
	}

	private Map<string, bool> mergeTypeParameterSets(Map<string, bool> inherited, Vector<string> parameters) {
		Map<string, bool> names = {};
		Vector<string> inheritedNames = inherited.keys();
		int inheritedIndex = 0;
		while (inheritedIndex < inheritedNames.len) {
			names.put(inheritedNames.get(inheritedIndex), true);
			inheritedIndex = inheritedIndex + 1;
		}
		int parameterIndex = 0;
		while (parameterIndex < parameters.len) {
			names.put(parameters.get(parameterIndex), true);
			parameterIndex = parameterIndex + 1;
		}
		return names;
	}

	/* Whether a specialization may be registered. Growth itself is refused
	 * through the use graph (addUse): once a growing cycle is seen no derived
	 * specialization is admitted. A derived specialization nested past
	 * hosted_abi.toml's limit is refused as a backstop. Types a program
	 * writes out are not limited. The reference's _admit_specialization. */
	private bool admitSpecialization(string generic, Vector<Node> arguments, Node site) {
		if (self.scopeOwner == "") { return true; }
		if (self.growthFound) { return false; }
		int depth = 0;
		for argument in arguments {
			int nesting = TypeIdentity.typeNestingDepth(argument);
			if (nesting > depth) { depth = nesting; }
		}
		if (depth > self.nestingLimit) {
			fprintf(stderr, "error: Generic %s needs type arguments nested deeper than %d levels, the limit that keeps specialization finite at %d:%d\n", generic, self.nestingLimit, site.line, site.col);
			exit(1);
		}
		return true;
	}

	class string scopeKey(string owner, string method) { return method == "" ? owner : owner + "." + method; }

	/* Scan within a declaration's specialization scope, adding the uses of the
	 * template calls it makes. The caller restores the previous scope. */
	private void enterScope(string owner, string method) {
		self.scopeOwner = owner;
		self.scopeMethod = method;
		string key = GenericSpecializer.scopeKey(owner, method);
		if (self.reachedScopes.has(key)) { return; }
		self.reachedScopes.put(key, true);
		if (self.templateCalls.has(key)) {
			for templateCall in self.templateCalls.get(key) { self.recordMethodUse(templateCall); }
		}
	}

	/* Keep a template call in the method-generics walk's scope, adding its
	 * uses now if a specialization already reached that scope. */
	private void addTemplateCall(Node call, TemplateMethodCall templateCall) {
		string key = GenericSpecializer.scopeKey(self.templateOwner, self.templateMethod);
		string callKey = key + "|" + AstIdentity.key(call);
		if (self.templateCallKeys.has(callKey)) { return; }
		self.templateCallKeys.put(callKey, true);
		if (!self.templateCalls.has(key)) {
			Vector<TemplateMethodCall> calls = [];
			self.templateCalls.put(key, calls);
		}
		self.templateCalls.get(key).push(templateCall);
		if (self.reachedScopes.has(key)) {
			string previousOwner = self.scopeOwner;
			string previousMethod = self.scopeMethod;
			self.scopeOwner = self.templateOwner;
			self.scopeMethod = self.templateMethod;
			self.recordMethodUse(templateCall);
			self.scopeOwner = previousOwner;
			self.scopeMethod = previousMethod;
		}
	}

	private Node? scopeOwnerDeclaration(string owner) {
		if (self.analyzed.isGenericClass(owner)) { return self.analyzed.genericClassTable.get(owner); }
		if (self.analyzed.isClass(owner)) { return self.analyzed.classTable.get(owner); }
		return null;
	}

	private Node? scopeMethodDeclaration(string owner, string method) {
		if (self.analyzed.isGenericClass(owner)) { return self.analyzed.genericClassMethod(owner, method); }
		if (self.analyzed.isClass(owner)) { return self.analyzed.classMethod(owner, method); }
		return null;
	}

	/* Each type parameter of a declaration's scope, with its node in the use
	 * graph: Owner.T, or Owner.method.U (and Owner.method.T) for a generic
	 * method's. */
	private Map<string, string> scopeNodes(string owner, string methodName) {
		Map<string, string> nodes = {};
		if (owner == "") { return nodes; }
		Node? declaration = self.scopeOwnerDeclaration(owner);
		if (declaration == null) { return nodes; }
		string prefix = GenericSpecializer.scopeKey(owner, methodName);
		for parameter in declaration.genericParams() { nodes.put(parameter, prefix + "." + parameter); }
		if (methodName != "") {
			Node? method = self.scopeMethodDeclaration(owner, methodName);
			if (method != null) {
				for parameter in method.genericParams() { nodes.put(parameter, prefix + "." + parameter); }
			}
		}
		return nodes;
	}

	/* Add the use graph's edges for one template type the scanned declaration
	 * uses. A class instance's scan specializes its generic methods' bodies
	 * and signatures too: a type there that names only the class's parameters
	 * is a use of every class instance, and one that names the method's own
	 * parameters is a use of the method's scope, which holds only once the
	 * method is specialized. The reference's _record_uses. */
	private void recordUses(Node? template) {
		if (template == null || self.scopeOwner == "") { return; }
		string methodName = self.scopeMethod;
		if (self.memberMethod != "" && self.memberOwner == self.scopeOwner && self.scopeMethod == "") {
			Node? method = self.scopeMethodDeclaration(self.scopeOwner, self.memberMethod);
			if (method != null && TypeIdentity.referencesNames(template, SemanticTypeSystem.genericParameterSet(method.genericParams()))) {
				methodName = self.memberMethod;
			}
		}
		Map<string, string> nodes = self.scopeNodes(self.scopeOwner, methodName);
		if (nodes.len > 0) { self.recordTypeUses(template, nodes); }
	}

	private void recordTypeUses(Node typeExpr, Map<string, string> nodes) {
		if (self.analyzed.isGenericClass(typeExpr.base)) {
			Node declaration = self.analyzed.genericClassTable.get(typeExpr.base);
			if (declaration.genericParams().len == typeExpr.genericArgs().len) {
				int index = 0;
				while (index < typeExpr.genericArgs().len) {
					string target = typeExpr.base + "." + declaration.genericParams().get(index);
					self.recordArgument(typeExpr.genericArgs().get(index), nodes, target, typeExpr.line, typeExpr.col, "class '" + typeExpr.base + "'");
					index = index + 1;
				}
			}
		}
		for argument in typeExpr.genericArgs() { self.recordTypeUses(argument, nodes); }
	}

	/* Add the use graph's edges for one generic-method call in the scanned
	 * declaration. */
	private void recordMethodUse(TemplateMethodCall templateCall) {
		Map<string, string> nodes = self.scopeNodes(self.scopeOwner, self.scopeMethod);
		Node? method = self.scopeMethodDeclaration(templateCall.owner, templateCall.method);
		if (nodes.len == 0 || method == null) { return; }
		/* A call specializes the method's own scope, whose nodes carry the
		 * class's parameters as well as the method's. */
		string prefix = templateCall.owner + "." + templateCall.method;
		Node? owner = self.scopeOwnerDeclaration(templateCall.owner);
		if (owner != null) {
			int index = 0;
			while (index < owner.genericParams().len && index < templateCall.classArgs.len) {
				string target = prefix + "." + owner.genericParams().get(index);
				self.recordArgument(templateCall.classArgs.get(index), nodes, target, templateCall.line, templateCall.col, "class '" + templateCall.owner + "'");
				index = index + 1;
			}
		}
		string generic = "method '" + templateCall.owner + "." + templateCall.method + "'";
		int argument = 0;
		while (argument < templateCall.methodArgs.len) {
			string target = prefix + "." + templateCall.methodParameters.get(argument);
			self.recordArgument(templateCall.methodArgs.get(argument), nodes, target, templateCall.line, templateCall.col, generic);
			argument = argument + 1;
		}
		for classArgument in templateCall.classArgs { self.recordTypeUses(classArgument, nodes); }
		for methodArgument in templateCall.methodArgs { self.recordTypeUses(methodArgument, nodes); }
	}

	private void recordArgument(Node argument, Map<string, string> nodes, string target, int line, int col, string generic) {
		for name in nodes.keys() {
			Map<string, bool> names = {};
			names.put(name, true);
			if (TypeIdentity.referencesNames(argument, names)) {
				/* A pure nullable marker saturates instead of adding a pointer
				 * layer on each specialization, as composeTypeExpr records. */
				int nullableLayer = argument.isNullable && argument.nullableOuterDepth == 0 ? 1 : 0;
				bool nonGrowing = argument.base == name && argument.genericArgs().len == 0 && argument.pointerDepth <= nullableLayer && !argument.isArray;
				self.addUse(nodes.get(name), target, !nonGrowing, line, col, generic);
			}
		}
	}

	/* Add one use edge, and note a growing use that lies on a cycle. A type
	 * parameter flows into a parameter of the generic it uses; the use is
	 * growing when the argument wraps the parameter (Chain<(T, int)> inside
	 * Chain<T>). A cycle through a growing use makes every pass around it nest
	 * one more level, so specialization never ends. Edges come from the uses
	 * specialization follows, so the cycle is found once each declaration on
	 * it has been scanned, however many uses grow. From then on no derived
	 * specialization is admitted, and the uses of the specializations already
	 * found still join the graph, so reportGrowth sees the same graph whatever
	 * order they were scanned. The reference's _add_use. */
	private void addUse(string source, string target, bool growing, int line, int col, string generic) {
		int growth = growing ? 1 : 0;
		string key = f"{source}|{target}|{growth}|{line}:{col}|{generic}";
		if (self.useKeys.has(key)) { return; }
		self.useKeys.put(key, true);
		self.uses.push(GenericUse(source, target, growing, line, col, generic));
		self.addEdge(self.successors, source, target);
		if (!self.growthFound && self.reachable(target, self.successors).has(source)) {
			self.growthFound = self.growingCycleUse() != null;
		}
	}

	/* The growing use on a cycle that comes first in source, preferring one
	 * with a source position: a use the analyzer inferred has none. */
	private GenericUse? growingCycleUse() {
		GenericUse? first = null;
		for use in self.uses {
			if (!use.growing || !self.reachable(use.target, self.successors).has(use.source)) { continue; }
			if (first == null || GenericSpecializer.useBefore(use, first)) { first = use; }
		}
		return first;
	}

	/* Refuse the growing cycle's first use, once discovery has drained. The
	 * reference's _report_growth. */
	private void reportGrowth() {
		if (!self.growthFound) { return; }
		GenericUse? first = self.growingCycleUse();
		if (first == null) { return; }
		fprintf(stderr, "error: Generic %s grows its own type arguments through this use, so its specializations never end at %d:%d\n", first.generic, first.line, first.col);
		exit(1);
	}

	class bool useBefore(GenericUse left, GenericUse right) {
		bool leftLocated = left.line != 0 || left.col != 0;
		bool rightLocated = right.line != 0 || right.col != 0;
		if (leftLocated != rightLocated) { return leftLocated; }
		if (left.line != right.line) { return left.line < right.line; }
		if (left.col != right.col) { return left.col < right.col; }
		return Strings.compare(left.generic, right.generic) < 0;
	}

	private void addEdge(Map<string, Vector<string>> edges, string from, string to) {
		if (!edges.has(from)) {
			Vector<string> following = [];
			edges.put(from, following);
		}
		edges.get(from).push(to);
	}

	private Map<string, bool> reachable(string start, Map<string, Vector<string>> edges) {
		Map<string, bool> seen = {};
		seen.put(start, true);
		Vector<string> pending = [start];
		while (pending.len > 0) {
			string node = pending.pop();
			if (!edges.has(node)) { continue; }
			for following in edges.get(node) {
				if (!seen.has(following)) {
					seen.put(following, true);
					pending.push(following);
				}
			}
		}
		return seen;
	}

	private void validateGenericArgumentsForOwner(string owner, Vector<Node> args) {
		int index = 0;
		while (index < args.len) {
			string problem = TypeIdentity.genericArgumentProblem(args.get(index));
			if (problem != "") {
				TypeIdentity.fail("Generic argument " + Strings.fromInt(index + 1) + " for '" + owner + "' is invalid: " + problem);
			}
			index = index + 1;
		}
	}

	/* Qualifiers are coherent inside structural Tuple/__fn_ptr shapes, but not in
     * a nested writable class specialization. Validate only known generic classes
     * and then recurse so nested class shapes cannot bypass the policy. */
	private void validateNestedClassArguments(string owner, Node? typeExpr, Analyzed a) {
		if (typeExpr == null) { return; }
		if (a.genericClassTable.has(typeExpr.base)) {
			self.validateGenericArgumentsForOwner(owner + " via " + typeExpr.base, typeExpr.genericArgs());
		}
		int index = 0;
		while (index < typeExpr.genericArgs().len) {
			self.validateNestedClassArguments(owner, typeExpr.genericArgs().get(index), a);
			index = index + 1;
		}
	}

	private void validateSpecializedType(string owner, Node? declared, Map<string, Node> substitutions, Analyzed a) {
		if (declared == null) { return; }
		Node resolved = SemanticTypeSystem.resolveGenericType(declared, substitutions, a);
		self.validateNestedClassArguments(owner, resolved, a);
		self.validateSpecializedContracts(resolved, a);
	}

	private void validateSpecializedContracts(Node? typeExpr, Analyzed analyzed) {
		if (typeExpr == null) { return; }
		Map<string, bool> noUnresolvedParameters = {};
		if (!SemanticTypeSystem.ownedClosureInvokeIsAdmissible(typeExpr, analyzed, noUnresolvedParameters)) {
			TypeIdentity.fail("OwnedClosure<Invoke> requires an exact " + "CFunction<Signature> invoke type");
		}
		int argumentIndex = 0;
		while (argumentIndex < typeExpr.genericArgs().len) {
			self.validateSpecializedContracts(typeExpr.genericArgs().get(argumentIndex), analyzed);
			argumentIndex = argumentIndex + 1;
		}
	}

	private void validateGenericClassSpecialization(Node typeExpr, Analyzed a) {
		if (!a.genericClassTable.has(typeExpr.base)) { return; }
		self.validateGenericArgumentsForOwner(typeExpr.base, typeExpr.genericArgs());
		Node declaration = a.genericClassTable.get(typeExpr.base);
		if (declaration.genericParams().len != typeExpr.genericArgs().len) { return; }
		Map<string, Node> substitutions = {};
		int parameter = 0;
		while (parameter < declaration.genericParams().len) {
			substitutions.put(declaration.genericParams().get(parameter), typeExpr.genericArgs().get(parameter));
			parameter = parameter + 1;
		}
		int memberIndex = 0;
		while (memberIndex < declaration.members().len) {
			Node member = declaration.members().get(memberIndex);
			if (member.kind == NK_FIELD_DECL || member.kind == NK_PROPERTY_DECL) {
				self.validateSpecializedType(typeExpr.base, member.type, substitutions, a);
			} else if (member.kind == NK_METHOD_DECL) {
				self.validateSpecializedType(typeExpr.base, member.returnType, substitutions, a);
				int paramIndex = 0;
				while (paramIndex < member.params().len) {
					self.validateSpecializedType(typeExpr.base, member.params().get(paramIndex).type, substitutions, a);
					paramIndex = paramIndex + 1;
				}
			}
			memberIndex = memberIndex + 1;
		}
	}

	/* Register the transitive generic-instance closure: for every concrete generic
     * instance, resolve its member field/method/param types through that instance's
     * type map and register any resolved generic-class type. Repeats until the
     * instance set stops growing (new instances can imply further ones). */
	private void registerTransitiveGenericInstances(Analyzed a, OperatorSemantics operators) {
		int idx = 0;
		/* One pass closes this fixed point. Instances are only ever appended, and
		 * re-reading .len each step walks the ones the pass itself adds, so no
		 * instance is left unprocessed when it ends. What an instance implies
		 * depends on its own arguments and the static generic class table, never
		 * on which other instances are registered, so a repeated pass could only
		 * re-derive what this one already registered. */
		while (idx < a.genericInstances.len) {
			GenInstance inst = a.genericInstances.get(idx);
			string previousOwner = self.scopeOwner;
			string previousMethod = self.scopeMethod;
			self.enterScope(inst.base, "");
			if (a.genericClassTable.has(inst.base)) {
				Node decl = a.genericClassTable.get(inst.base);
				Map<string, Node> tm = {};
				int g = 0;
				while (g < decl.genericParams().len && g < inst.args.len) {
					tm.put(decl.genericParams().get(g), inst.args.get(g));
					g = g + 1;
				}
				int mi = 0;
				while (mi < decl.members().len) {
					Node mem = decl.members().get(mi);
					Map<string, bool> unresolved = {};
					if (mem.kind == NK_METHOD_DECL) {
						unresolved = SemanticTypeSystem.genericParameterSet(mem.genericParams());
					}
					if (mem.kind == NK_FIELD_DECL || mem.kind == NK_PROPERTY_DECL) {
						self.registerResolvedGenericInstance(mem.type, tm, unresolved, a);
					} else if (mem.kind == NK_METHOD_DECL) {
						self.memberOwner = inst.base;
						self.memberMethod = mem.genericParams().len > 0 ? mem.name : "";
						self.registerResolvedGenericInstance(mem.returnType, tm, unresolved, a);
						int p = 0;
						while (p < mem.params().len) {
							self.registerResolvedGenericInstance(mem.params().get(p).type, tm, unresolved, a);
							p = p + 1;
						}
						self.memberMethod = "";
					}
					mi = mi + 1;
				}
			}
			self.scopeOwner = previousOwner;
			self.scopeMethod = previousMethod;
			idx = idx + 1;
		}
		BtrccPhaseTimer.mark("g-members");
		self.closeGenericInstanceGraph(a, operators);
	}

	/* Resolve a member TypeExpr through `tm` and, if the result is a concrete
     * generic-class instance not yet seen, register it. */
	private void registerResolvedGenericInstance(Node? t, Map<string, Node> tm, Map<string, bool> unresolved, Analyzed a) {
		if (t == null) { return; }
		self.recordUses(t);
		self.registerGenericInstanceWithUnresolved(SemanticTypeSystem.resolveGenericType(t, tm, a), a, unresolved);
	}

	/* --- AST pass: upgrade class-typed generic args to pointers in place. ---
     * Walks the same type/expr surface as the generic-collection walkers below, but
     * for each TypeExpr it calls upgradeTypeGenericArgs so nested class args become
     * pointers. Generic-class member templates (T-typed fields) are intentionally
     * skipped — their T resolves per instance from the (already-upgraded) instance
     * args, exactly as in the reference. */
	private void upgradeDeclGenericArgs(Node d, Analyzed a) {
		if (d.kind == NK_INTERFACE_DECL) {
			/* Requirements and implementations must use the same representation
			 * for nested class arguments, including nullable container returns. */
			Map<string, bool> unresolved = SemanticTypeSystem.genericParameterSet(d.genericParams());
			for method in d.methods() {
				SemanticTypeSystem.upgradeTypeGenericArgs(method.returnType, a, unresolved);
				for parameter in method.params() { SemanticTypeSystem.upgradeTypeGenericArgs(parameter.type, a, unresolved); }
			}
		} else if (d.kind == NK_FUNCTION_DECL) {
			Map<string, bool> unresolved = SemanticTypeSystem.genericParameterSet(d.genericParams());
			int i = 0;
			while (i < d.params().len) {
				SemanticTypeSystem.upgradeTypeGenericArgs(d.params().get(i).type, a, unresolved);
				i = i + 1;
			}
			SemanticTypeSystem.upgradeTypeGenericArgs(d.returnType, a, unresolved);
			if (d.bodyNode != null) {
				self.upgradeBlockGenericArgs(d.bodyNode, a, unresolved);
			}
		} else if (d.kind == NK_CLASS_DECL) {
			/* Keep class parameters as unresolved templates while normalizing every
             * concrete nested class type. This matters for signatures such as
             * `Mutex<Payload>` inside a generic class: Payload still has pointer
             * representation even though an unrelated `T` remains unresolved. */
			Map<string, bool> classParameters = SemanticTypeSystem.genericParameterSet(d.genericParams());
			int i = 0;
			while (i < d.members().len) {
				Node mem = d.members().get(i);
				if (mem.kind == NK_FIELD_DECL || mem.kind == NK_PROPERTY_DECL) {
					SemanticTypeSystem.upgradeTypeGenericArgs(mem.type, a, classParameters);
				} else if (mem.kind == NK_METHOD_DECL) {
					Map<string, bool> unresolved = self.mergeTypeParameterSets(classParameters, mem.genericParams());
					int p = 0;
					while (p < mem.params().len) {
						SemanticTypeSystem.upgradeTypeGenericArgs(mem.params().get(p).type, a, unresolved);
						p = p + 1;
					}
					SemanticTypeSystem.upgradeTypeGenericArgs(mem.returnType, a, unresolved);
					if (mem.bodyNode != null) {
						self.upgradeBlockGenericArgs(mem.bodyNode, a, unresolved);
					}
				}
				i = i + 1;
			}
		} else if (d.kind == NK_VAR_DECL_STMT) {
			Map<string, bool> unresolved = {};
			SemanticTypeSystem.upgradeTypeGenericArgs(d.type, a, unresolved);
			self.upgradeExprGenericArgs(d.initializer, a, unresolved);
		}
	}

	private void upgradeBlockGenericArgs(Node block, Analyzed a, Map<string, bool> unresolved) {
		if (block == null) { return; }
		int i = 0;
		while (i < block.statements().len) {
			self.upgradeStmtGenericArgs(block.statements().get(i), a, unresolved);
			i = i + 1;
		}
	}

	private void upgradeStmtGenericArgs(Node s, Analyzed a, Map<string, bool> unresolved) {
		if (s == null) { return; }
		if (s.kind == NK_VAR_DECL_STMT) {
			SemanticTypeSystem.upgradeTypeGenericArgs(s.type, a, unresolved);
			self.upgradeExprGenericArgs(s.initializer, a, unresolved);
		} else if (s.kind == NK_RETURN_STMT) {
			self.upgradeExprGenericArgs(s.valueNode, a, unresolved);
		} else if (s.kind == NK_EXPR_STMT) {
			self.upgradeExprGenericArgs(s.expr, a, unresolved);
		} else if (s.kind == NK_IF_STMT) {
			self.upgradeExprGenericArgs(s.condition, a, unresolved);
			self.upgradeBlockGenericArgs(s.thenBlock, a, unresolved);
			if (s.elseBlock != null) {
				self.upgradeStmtGenericArgs(s.elseBlock, a, unresolved);
			}
		} else if (s.kind == NK_ELSE_BLOCK) {
			self.upgradeBlockGenericArgs(s.bodyNode, a, unresolved);
		} else if (s.kind == NK_ELSE_IF) {
			self.upgradeStmtGenericArgs(s.ifStmt, a, unresolved);
		} else if (s.kind == NK_WHILE_STMT || s.kind == NK_DO_WHILE_STMT) {
			self.upgradeExprGenericArgs(s.condition, a, unresolved);
			self.upgradeBlockGenericArgs(s.bodyNode, a, unresolved);
		} else if (s.kind == NK_C_FOR_STMT) {
			if (s.init != null) {
				if (s.init.kind == NK_FOR_INIT_VAR) {
					for declaration in s.init.declarations() { self.upgradeStmtGenericArgs(declaration, a, unresolved); }
				} else if (s.init.kind == NK_FOR_INIT_EXPR) {
					self.upgradeExprGenericArgs(s.init.expression, a, unresolved);
				}
			}
			self.upgradeExprGenericArgs(s.condition, a, unresolved);
			self.upgradeExprGenericArgs(s.update, a, unresolved);
			self.upgradeBlockGenericArgs(s.bodyNode, a, unresolved);
		} else if (s.kind == NK_FOR_IN_STMT || s.kind == NK_PARALLEL_FOR_STMT) {
			self.upgradeExprGenericArgs(s.iterable, a, unresolved);
			self.upgradeBlockGenericArgs(s.bodyNode, a, unresolved);
		} else if (s.kind == NK_DELETE_STMT) {
			self.upgradeExprGenericArgs(s.expr, a, unresolved);
		} else if (s.kind == NK_TRY_CATCH_STMT) {
			if (s.tryBlock != null) {
				self.upgradeBlockGenericArgs(s.tryBlock, a, unresolved);
			}
			if (s.catchBlock != null) {
				self.upgradeBlockGenericArgs(s.catchBlock, a, unresolved);
			}
			if (s.finallyBlock != null) {
				self.upgradeBlockGenericArgs(s.finallyBlock, a, unresolved);
			}
		} else if (s.kind == NK_SWITCH_STMT) {
			self.upgradeExprGenericArgs(s.valueNode, a, unresolved);
			int ci = 0;
			while (ci < s.cases().len) {
				Node c = s.cases().get(ci);
				self.upgradeExprGenericArgs(c.valueNode, a, unresolved);
				int cj = 0;
				while (cj < c.bodyNodeList().len) {
					self.upgradeStmtGenericArgs(c.bodyNodeList().get(cj), a, unresolved);
					cj = cj + 1;
				}
				ci = ci + 1;
			}
		} else if (s.kind == NK_BLOCK) {
			self.upgradeBlockGenericArgs(s, a, unresolved);
		}
	}

	private void upgradeExprGenericArgs(Node e, Analyzed a, Map<string, bool> unresolved) {
		if (e == null) { return; }
		if (e.kind == NK_NEW_EXPR) {
			SemanticTypeSystem.upgradeTypeGenericArgs(e.type, a, unresolved);
		}
		if (e.kind == NK_CAST_EXPR) {
			SemanticTypeSystem.upgradeTypeGenericArgs(e.targetType, a, unresolved);
		}
		if (e.kind == NK_SIZEOF_TYPE) {
			SemanticTypeSystem.upgradeTypeGenericArgs(e.type, a, unresolved);
		}
		if (e.kind == NK_LAMBDA_EXPR) {
			SemanticTypeSystem.upgradeTypeGenericArgs(e.returnType, a, unresolved);
			int parameter = 0;
			while (parameter < e.params().len) {
				Node value = e.params().get(parameter);
				SemanticTypeSystem.upgradeTypeGenericArgs(value.type, a, unresolved);
				self.upgradeExprGenericArgs(value.default_, a, unresolved);
				parameter = parameter + 1;
			}
			int capture = 0;
			while (capture < e.captures().len) {
				SemanticTypeSystem.upgradeTypeGenericArgs(e.captures().get(capture).type, a, unresolved);
				capture = capture + 1;
			}
			if (e.bodyNode != null && e.bodyNode.kind == NK_LAMBDA_BLOCK) {
				self.upgradeBlockGenericArgs(e.bodyNode.bodyNode, a, unresolved);
			} else if (e.bodyNode != null && e.bodyNode.kind == NK_LAMBDA_EXPR_BODY) {
				self.upgradeExprGenericArgs(e.bodyNode.expression, a, unresolved);
			}
		}
		self.upgradeExprGenericArgs(e.callee, a, unresolved);
		self.upgradeExprGenericArgs(e.left, a, unresolved);
		self.upgradeExprGenericArgs(e.right, a, unresolved);
		self.upgradeExprGenericArgs(e.operand, a, unresolved);
		self.upgradeExprGenericArgs(e.expr, a, unresolved);
		self.upgradeExprGenericArgs(e.obj, a, unresolved);
		self.upgradeExprGenericArgs(e.index, a, unresolved);
		self.upgradeExprGenericArgs(e.condition, a, unresolved);
		self.upgradeExprGenericArgs(e.trueExpr, a, unresolved);
		self.upgradeExprGenericArgs(e.falseExpr, a, unresolved);
		self.upgradeExprGenericArgs(e.target, a, unresolved);
		self.upgradeExprGenericArgs(e.valueNode, a, unresolved);
		self.upgradeExprGenericArgs(e.expression, a, unresolved);
		self.upgradeExprGenericArgs(e.fn, a, unresolved);
		self.upgradeExprGenericArgs(e.key, a, unresolved);
		int i = 0;
		while (i < e.args().len) {
			self.upgradeExprGenericArgs(e.args().get(i), a, unresolved);
			i = i + 1;
		}
		i = 0;
		while (i < e.elements().len) {
			self.upgradeExprGenericArgs(e.elements().get(i), a, unresolved);
			i = i + 1;
		}
		i = 0;
		while (i < e.entries().len) {
			self.upgradeExprGenericArgs(e.entries().get(i), a, unresolved);
			i = i + 1;
		}
		i = 0;
		while (i < e.parts().len) {
			self.upgradeExprGenericArgs(e.parts().get(i), a, unresolved);
			i = i + 1;
		}
	}

	/* Register a concrete generic instance (deduped, in discovery order), while
     * filtering only the type-parameter names that are unresolved in this lexical
     * template. A declared one-letter class is therefore never mistaken for T. */
	private void registerGenericInstance(Node? t, Analyzed a) {
		Map<string, bool> unresolved = {};
		self.registerGenericInstanceWithUnresolved(t, a, unresolved);
	}

	private void registerGenericInstanceWithUnresolved(Node? t, Analyzed a, Map<string, bool> unresolved) {
		if (t == null) { return; }
		if (t.genericArgs().len == 0) { return; }
		string base = t.base;
		bool generic = a.genericClassTable.has(base);
		/* One key serves both the validation de-duplication and the instance
		 * table: both identify the exact specialization. */
		string key = generic ? TypeIdentity.genericInstanceKey(base, t.genericArgs()) : "";
		if (generic && !a.genericSeen.has(key) && !TypeIdentity.referencesNames(t, unresolved)) {
			if (!self.admitSpecialization("class '" + base + "'", t.genericArgs(), t)) { return; }
		}
		if (generic) {
			/* A specialization's validity depends only on its owner declaration and
			 * exact arguments, so validate each distinct specialization once instead
			 * of once per expression that mentions it. */
			if (!self.validatedSpecializations.has(key)) {
				self.validateGenericClassSpecialization(t, a);
				self.validatedSpecializations.put(key, true);
			}
		}
		if (generic && !TypeIdentity.referencesNames(t, unresolved)) {
			ValidationFact? demand = a.journalFact(VALIDATION_GENERIC_CLASS, null, null);
			if (demand != null) {
				demand.name = base;
				demand.arguments = t.genericArgs();
			}
			if (!a.genericSeen.has(key)) {
				/* By this point class-typed args have been upgraded to pointers in
				 * the AST by upgradeProgramGenericArgs, so the mangled name carries
				 * the `_p1` suffix and the per-instance type map resolves T to a
				 * pointer. */
				a.genericSeen.put(key, true);
				a.genericInstances.push(GenInstance(base, t.genericArgs(), TypeIdentity.mangleGenericType(base, t.genericArgs())));
			}
		}
		/* Even when the outer shape is unresolved, a concrete nested argument is
         * independently registerable and must not be lost. */
		int i = 0;
		while (i < t.genericArgs().len) {
			self.registerGenericInstanceWithUnresolved(t.genericArgs().get(i), a, unresolved);
			i = i + 1;
		}
	}

	/* Walk a top-level declaration for generic instances (param/return/field types
     * and statement bodies). */
	private void collectGenericsDecl(Node d, Analyzed a) {
		if (d.kind == NK_INTERFACE_DECL) {
			/* Dispatch signatures need concrete types even when no implementation
			 * or call site independently instantiates the interface's containers. */
			Map<string, bool> unresolved = SemanticTypeSystem.genericParameterSet(d.genericParams());
			for method in d.methods() {
				self.registerGenericInstanceWithUnresolved(method.returnType, a, unresolved);
				for parameter in method.params() { self.registerGenericInstanceWithUnresolved(parameter.type, a, unresolved); }
			}
		} else if (d.kind == NK_FUNCTION_DECL) {
			Map<string, bool> unresolved = SemanticTypeSystem.genericParameterSet(d.genericParams());
			int i = 0;
			while (i < d.params().len) {
				self.registerGenericInstanceWithUnresolved(d.params().get(i).type, a, unresolved);
				i = i + 1;
			}
			self.registerGenericInstanceWithUnresolved(d.returnType, a, unresolved);
			if (d.bodyNode != null) {
				self.collectGenericsBlock(d.bodyNode, a, unresolved);
			}
		} else if (d.kind == NK_CLASS_DECL) {
			/* Field/method/property types of NON-generic classes can mention generic
             * instances; generic class members are templated (their T-typed members
             * resolve per instance, not here). */
			if (d.genericParams().len == 0) {
				Map<string, bool> none = {};
				int i = 0;
				while (i < d.members().len) {
					Node mem = d.members().get(i);
					if (mem.kind == NK_FIELD_DECL || mem.kind == NK_PROPERTY_DECL) {
						self.registerGenericInstanceWithUnresolved(mem.type, a, none);
					} else if (mem.kind == NK_METHOD_DECL) {
						Map<string, bool> unresolved = SemanticTypeSystem.genericParameterSet(mem.genericParams());
						int p = 0;
						while (p < mem.params().len) {
							self.registerGenericInstanceWithUnresolved(mem.params().get(p).type, a, unresolved);
							p = p + 1;
						}
						self.registerGenericInstanceWithUnresolved(mem.returnType, a, unresolved);
						if (mem.bodyNode != null) {
							self.collectGenericsBlock(mem.bodyNode, a, unresolved);
						}
					}
					i = i + 1;
				}
			}
		}
	}

	/* Walk a block's statements for generic-instance-bearing types/exprs. */
	private void collectGenericsBlock(Node block, Analyzed a, Map<string, bool> unresolved) {
		if (block == null) { return; }
		int i = 0;
		while (i < block.statements().len) {
			self.collectGenericsStmt(block.statements().get(i), a, unresolved);
			i = i + 1;
		}
	}

	private void collectGenericsStmt(Node s, Analyzed a, Map<string, bool> unresolved) {
		if (s == null) { return; }
		if (s.kind == NK_VAR_DECL_STMT) {
			self.registerGenericInstanceWithUnresolved(s.type, a, unresolved);
			self.collectGenericsExpr(s.initializer, a, unresolved);
		} else if (s.kind == NK_RETURN_STMT) {
			self.collectGenericsExpr(s.valueNode, a, unresolved);
		} else if (s.kind == NK_EXPR_STMT) {
			self.collectGenericsExpr(s.expr, a, unresolved);
		} else if (s.kind == NK_IF_STMT) {
			self.collectGenericsExpr(s.condition, a, unresolved);
			self.collectGenericsBlock(s.thenBlock, a, unresolved);
			if (s.elseBlock != null) {
				self.collectGenericsStmt(s.elseBlock, a, unresolved);
			}
		} else if (s.kind == NK_ELSE_BLOCK) {
			self.collectGenericsBlock(s.bodyNode, a, unresolved);
		} else if (s.kind == NK_ELSE_IF) {
			self.collectGenericsStmt(s.ifStmt, a, unresolved);
		} else if (s.kind == NK_WHILE_STMT || s.kind == NK_DO_WHILE_STMT) {
			self.collectGenericsExpr(s.condition, a, unresolved);
			self.collectGenericsBlock(s.bodyNode, a, unresolved);
		} else if (s.kind == NK_C_FOR_STMT) {
			if (s.init != null) {
				if (s.init.kind == NK_FOR_INIT_VAR) {
					for declaration in s.init.declarations() { self.collectGenericsStmt(declaration, a, unresolved); }
				} else if (s.init.kind == NK_FOR_INIT_EXPR) {
					self.collectGenericsExpr(s.init.expression, a, unresolved);
				}
			}
			self.collectGenericsExpr(s.condition, a, unresolved);
			self.collectGenericsExpr(s.update, a, unresolved);
			self.collectGenericsBlock(s.bodyNode, a, unresolved);
		} else if (s.kind == NK_DELETE_STMT) {
			self.collectGenericsExpr(s.expr, a, unresolved);
		} else if (s.kind == NK_TRY_CATCH_STMT) {
			if (s.tryBlock != null) {
				self.collectGenericsBlock(s.tryBlock, a, unresolved);
			}
			if (s.catchBlock != null) {
				self.collectGenericsBlock(s.catchBlock, a, unresolved);
			}
			if (s.finallyBlock != null) {
				self.collectGenericsBlock(s.finallyBlock, a, unresolved);
			}
		} else if (s.kind == NK_SWITCH_STMT) {
			self.collectGenericsExpr(s.valueNode, a, unresolved);
			int ci = 0;
			while (ci < s.cases().len) {
				Node c = s.cases().get(ci);
				self.collectGenericsExpr(c.valueNode, a, unresolved);
				int cj = 0;
				while (cj < c.bodyNodeList().len) {
					self.collectGenericsStmt(c.bodyNodeList().get(cj), a, unresolved);
					cj = cj + 1;
				}
				ci = ci + 1;
			}
		} else if (s.kind == NK_BLOCK) {
			self.collectGenericsBlock(s, a, unresolved);
		}
	}

	private void collectGenericsExpr(Node e, Analyzed a, Map<string, bool> unresolved) {
		if (e == null) { return; }
		if (e.kind == NK_NEW_EXPR) {
			self.registerGenericInstanceWithUnresolved(e.type, a, unresolved);
		}
		if (e.kind == NK_CAST_EXPR) {
			self.registerGenericInstanceWithUnresolved(e.targetType, a, unresolved);
		}
		/* Recurse through sub-expressions that can hold a generic-typed expr. */
		self.collectGenericsExpr(e.callee, a, unresolved);
		self.collectGenericsExpr(e.left, a, unresolved);
		self.collectGenericsExpr(e.right, a, unresolved);
		self.collectGenericsExpr(e.operand, a, unresolved);
		self.collectGenericsExpr(e.expr, a, unresolved);
		self.collectGenericsExpr(e.obj, a, unresolved);
		self.collectGenericsExpr(e.index, a, unresolved);
		self.collectGenericsExpr(e.condition, a, unresolved);
		self.collectGenericsExpr(e.trueExpr, a, unresolved);
		self.collectGenericsExpr(e.falseExpr, a, unresolved);
		self.collectGenericsExpr(e.target, a, unresolved);
		self.collectGenericsExpr(e.valueNode, a, unresolved);
		int i = 0;
		while (i < e.args().len) {
			self.collectGenericsExpr(e.args().get(i), a, unresolved);
			i = i + 1;
		}
		if (e.kind == NK_COMMA_EXPR) {
			for element in e.elements() { self.collectGenericsExpr(element, a, unresolved); }
		}
	}

	/* Substitution-aware AST walk used by generic-instance closure. */

	private Map<string, Node> genericClosureCopyTypes(Map<string, Node> source) {
		Map<string, Node> copy = {};
		copy.merge(source);
		return copy;
	}

	private void genericClosureRegisterType(Node? typeExpr, Map<string, Node> substitutions, Map<string, bool> unresolved, Analyzed analyzed) {
		if (typeExpr == null) { return; }
		Node resolved = SemanticTypeSystem.resolveGenericType(typeExpr, substitutions, analyzed);
		if (resolved.genericArgs().len > 0) {
			self.validateSpecializedContracts(resolved, analyzed);
			self.recordUses(typeExpr);
			self.registerGenericInstanceWithUnresolved(resolved, analyzed, unresolved);
		}
	}

	private bool genericClosureExpressionKind(int kind) { return kind >= NK_INT_LITERAL && kind <= NK_SPAWN_EXPR; }

	private Node? genericClosureExpressionType(Node? expression, Map<string, Node> substitutions, Analyzed analyzed, OperatorSemantics operators, Map<string, Node> variables) {
		if (expression == null) { return null; }
		Node? inferred = self.expressions.inferSpecialization(expression, variables);
		if (inferred == null) { return null; }
		return SemanticTypeSystem.resolveGenericType(inferred, substitutions, analyzed);
	}

	private Node? genericClosureIterationType(Node? iterableType, Analyzed analyzed) {
		if (iterableType == null) { return null; }
		if (SemanticTypeSystem.isString(iterableType)) { return SemanticTypeSystem.primitive("char"); }
		if (iterableType.genericArgs().len > 0) {
			return iterableType.genericArgs().get(0);
		}
		if (iterableType.isArray || iterableType.pointerDepth > 0) {
			if (iterableType.isArray) {
				return TypeShape.withoutOuterArray(iterableType);
			}
			return TypeShape.withoutOuterPointers(iterableType, 1);
		}
		return null;
	}

	private void genericClosureWalkVector(Vector<Node> nodes, Map<string, Node> substitutions, Map<string, bool> unresolved, Analyzed analyzed, OperatorSemantics operators, Map<string, Node> variables) {
		int index = 0;
		while (index < nodes.len) {
			self.genericClosureWalkNode(nodes.get(index), substitutions, unresolved, analyzed, operators, variables);
			index = index + 1;
		}
	}

	private void genericClosureWalkLambda(Node lambda, Map<string, Node> substitutions, Map<string, bool> unresolved, Analyzed analyzed, OperatorSemantics operators, Map<string, Node> variables) {
		Map<string, Node> nested = self.genericClosureCopyTypes(variables);
		self.genericClosureRegisterType(lambda.returnType, substitutions, unresolved, analyzed);
		int parameter = 0;
		while (parameter < lambda.params().len) {
			Node value = lambda.params().get(parameter);
			Node resolved = SemanticTypeSystem.resolveGenericType(value.type, substitutions, analyzed);
			self.genericClosureRegisterType(value.type, substitutions, unresolved, analyzed);
			nested.put(value.name, resolved);
			self.genericClosureWalkNode(value.default_, substitutions, unresolved, analyzed, operators, nested);
			parameter = parameter + 1;
		}
		int capture = 0;
		while (capture < lambda.captures().len) {
			Node value = lambda.captures().get(capture);
			Node resolved = SemanticTypeSystem.resolveGenericType(value.type, substitutions, analyzed);
			self.genericClosureRegisterType(value.type, substitutions, unresolved, analyzed);
			nested.put(value.name, resolved);
			capture = capture + 1;
		}
		self.genericClosureWalkNode(lambda.bodyNode, substitutions, unresolved, analyzed, operators, nested);
		self.genericClosureWalkNode(lambda.expression, substitutions, unresolved, analyzed, operators, nested);
	}

	private void genericClosureWalkNode(Node? node, Map<string, Node> substitutions, Map<string, bool> unresolved, Analyzed analyzed, OperatorSemantics operators, Map<string, Node> variables) {
		if (node == null) { return; }
		if (node.kind == NK_TYPE_EXPR) {
			self.genericClosureRegisterType(node, substitutions, unresolved, analyzed);
			self.genericClosureWalkNode(node.arraySize, substitutions, unresolved, analyzed, operators, variables);
			return;
		}
		if (self.genericClosureExpressionKind(node.kind)) {
			Node? inferred = self.genericClosureExpressionType(node, substitutions, analyzed, operators, variables);
			self.genericClosureRegisterType(inferred, substitutions, unresolved, analyzed);
			if (node.kind == NK_CALL_EXPR) {
				self.collectMethodGenericCall(node, analyzed, operators, variables);
			}
		}
		if (node.kind == NK_VAR_DECL_STMT) {
			self.genericClosureWalkNode(node.initializer, substitutions, unresolved, analyzed, operators, variables);
			Node? declared = null;
			if (node.type != null) {
				declared = SemanticTypeSystem.resolveGenericType(node.type, substitutions, analyzed);
			} else {
				declared = self.genericClosureExpressionType(node.initializer, substitutions, analyzed, operators, variables);
			}
			self.genericClosureRegisterType(node.type != null ? node.type : declared, substitutions, unresolved, analyzed);
			if (declared != null) { variables.put(node.name, declared); }
			return;
		}
		if (node.kind == NK_FOR_IN_STMT || node.kind == NK_PARALLEL_FOR_STMT) {
			self.genericClosureWalkNode(node.iterable, substitutions, unresolved, analyzed, operators, variables);
			Node? iterableType = self.genericClosureExpressionType(node.iterable, substitutions, analyzed, operators, variables);
			Node? elementType = self.genericClosureIterationType(iterableType, analyzed);
			Map<string, Node> nested = self.genericClosureCopyTypes(variables);
			if (elementType != null) { nested.put(node.varName, elementType); }
			string? valueName = node.varName2;
			if (valueName != null && iterableType != null && iterableType.genericArgs().len > 1) {
				nested.put(valueName, iterableType.genericArgs().get(1));
			}
			self.genericClosureWalkNode(node.bodyNode, substitutions, unresolved, analyzed, operators, nested);
			return;
		}
		if (node.kind == NK_TRY_CATCH_STMT) {
			self.genericClosureWalkNode(node.tryBlock, substitutions, unresolved, analyzed, operators, variables);
			Map<string, Node> caught = self.genericClosureCopyTypes(variables);
			if (node.catchType != null) {
				Node catchType = SemanticTypeSystem.resolveGenericType(node.catchType, substitutions, analyzed);
				self.genericClosureRegisterType(catchType, substitutions, unresolved, analyzed);
				if (node.catchVar != "") { caught.put(node.catchVar, catchType); }
			}
			self.genericClosureWalkNode(node.catchBlock, substitutions, unresolved, analyzed, operators, caught);
			self.genericClosureWalkNode(node.finallyBlock, substitutions, unresolved, analyzed, operators, variables);
			return;
		}
		if (node.kind == NK_LAMBDA_EXPR) {
			self.genericClosureWalkLambda(node, substitutions, unresolved, analyzed, operators, variables);
			return;
		}

		/* Skip unset fields and unwritten lists without a call. */
		if (node.returnType != null) { self.genericClosureWalkNode(node.returnType, substitutions, unresolved, analyzed, operators, variables); }
		if (node.bodyNode != null) { self.genericClosureWalkNode(node.bodyNode, substitutions, unresolved, analyzed, operators, variables); }
		if (node.type != null) { self.genericClosureWalkNode(node.type, substitutions, unresolved, analyzed, operators, variables); }
		if (node.default_ != null) { self.genericClosureWalkNode(node.default_, substitutions, unresolved, analyzed, operators, variables); }
		if (node.initializer != null) { self.genericClosureWalkNode(node.initializer, substitutions, unresolved, analyzed, operators, variables); }
		if (node.getterBody != null) { self.genericClosureWalkNode(node.getterBody, substitutions, unresolved, analyzed, operators, variables); }
		if (node.setterBody != null) { self.genericClosureWalkNode(node.setterBody, substitutions, unresolved, analyzed, operators, variables); }
		if (node.valueNode != null) { self.genericClosureWalkNode(node.valueNode, substitutions, unresolved, analyzed, operators, variables); }
		if (node.condition != null) { self.genericClosureWalkNode(node.condition, substitutions, unresolved, analyzed, operators, variables); }
		if (node.thenBlock != null) { self.genericClosureWalkNode(node.thenBlock, substitutions, unresolved, analyzed, operators, variables); }
		if (node.elseBlock != null) { self.genericClosureWalkNode(node.elseBlock, substitutions, unresolved, analyzed, operators, variables); }
		if (node.iterable != null) { self.genericClosureWalkNode(node.iterable, substitutions, unresolved, analyzed, operators, variables); }
		if (node.init != null) { self.genericClosureWalkNode(node.init, substitutions, unresolved, analyzed, operators, variables); }
		if (node.update != null) { self.genericClosureWalkNode(node.update, substitutions, unresolved, analyzed, operators, variables); }
		if (node.expr != null) { self.genericClosureWalkNode(node.expr, substitutions, unresolved, analyzed, operators, variables); }
		if (node.ifStmt != null) { self.genericClosureWalkNode(node.ifStmt, substitutions, unresolved, analyzed, operators, variables); }
		if (node.expression != null) { self.genericClosureWalkNode(node.expression, substitutions, unresolved, analyzed, operators, variables); }
		if (node.left != null) { self.genericClosureWalkNode(node.left, substitutions, unresolved, analyzed, operators, variables); }
		if (node.right != null) { self.genericClosureWalkNode(node.right, substitutions, unresolved, analyzed, operators, variables); }
		if (node.operand != null) { self.genericClosureWalkNode(node.operand, substitutions, unresolved, analyzed, operators, variables); }
		if (node.callee != null) { self.genericClosureWalkNode(node.callee, substitutions, unresolved, analyzed, operators, variables); }
		if (node.obj != null) { self.genericClosureWalkNode(node.obj, substitutions, unresolved, analyzed, operators, variables); }
		if (node.index != null) { self.genericClosureWalkNode(node.index, substitutions, unresolved, analyzed, operators, variables); }
		if (node.targetType != null) { self.genericClosureWalkNode(node.targetType, substitutions, unresolved, analyzed, operators, variables); }
		if (node.trueExpr != null) { self.genericClosureWalkNode(node.trueExpr, substitutions, unresolved, analyzed, operators, variables); }
		if (node.falseExpr != null) { self.genericClosureWalkNode(node.falseExpr, substitutions, unresolved, analyzed, operators, variables); }
		if (node.target != null) { self.genericClosureWalkNode(node.target, substitutions, unresolved, analyzed, operators, variables); }
		if (node.fn != null) { self.genericClosureWalkNode(node.fn, substitutions, unresolved, analyzed, operators, variables); }
		if (node.key != null) { self.genericClosureWalkNode(node.key, substitutions, unresolved, analyzed, operators, variables); }
		if (node.arraySize != null) { self.genericClosureWalkNode(node.arraySize, substitutions, unresolved, analyzed, operators, variables); }

		if (node.declarationsStorage != null) { self.genericClosureWalkVector(node.declarationsStorage, substitutions, unresolved, analyzed, operators, variables); }
		if (node.paramsStorage != null) { self.genericClosureWalkVector(node.paramsStorage, substitutions, unresolved, analyzed, operators, variables); }
		if (node.statementsStorage != null) { self.genericClosureWalkVector(node.statementsStorage, substitutions, unresolved, analyzed, operators, variables); }
		if (node.casesStorage != null) { self.genericClosureWalkVector(node.casesStorage, substitutions, unresolved, analyzed, operators, variables); }
		if (node.bodyNodeListStorage != null) { self.genericClosureWalkVector(node.bodyNodeListStorage, substitutions, unresolved, analyzed, operators, variables); }
		if (node.argsStorage != null) { self.genericClosureWalkVector(node.argsStorage, substitutions, unresolved, analyzed, operators, variables); }
		if (node.elementsStorage != null) { self.genericClosureWalkVector(node.elementsStorage, substitutions, unresolved, analyzed, operators, variables); }
		if (node.entriesStorage != null) { self.genericClosureWalkVector(node.entriesStorage, substitutions, unresolved, analyzed, operators, variables); }
		if (node.partsStorage != null) { self.genericClosureWalkVector(node.partsStorage, substitutions, unresolved, analyzed, operators, variables); }
		if (node.capturesStorage != null) { self.genericClosureWalkVector(node.capturesStorage, substitutions, unresolved, analyzed, operators, variables); }
	}


	/* Deterministic fixed-point discovery for instantiated generic templates. */

	private Map<string, Node> genericClosureGlobalTypes(Analyzed analyzed) { return self.genericClosureCopyTypes(analyzed.globalVarTypes); }

	private Map<string, Node> genericClosureClassMap(Node declaration, Vector<Node> arguments) {
		Map<string, Node> substitutions = {};
		int index = 0;
		while (index < declaration.genericParams().len && index < arguments.len) {
			substitutions.put(declaration.genericParams().get(index), arguments.get(index));
			index = index + 1;
		}
		return substitutions;
	}

	private Node genericClosureSelfType(string base, Vector<Node> arguments) {
		Node selfType = Node();
		selfType.kind = NK_TYPE_EXPR;
		selfType.base = base;
		selfType.genericArgsStorage = arguments;
		selfType.pointerDepth = 1;
		return selfType;
	}

	private void genericClosureSeedParameters(Node method, Map<string, Node> substitutions, Map<string, bool> unresolved, Analyzed analyzed, OperatorSemantics operators, Map<string, Node> variables) {
		self.genericClosureRegisterType(method.returnType, substitutions, unresolved, analyzed);
		int index = 0;
		while (index < method.params().len) {
			Node parameter = method.params().get(index);
			Node resolved = SemanticTypeSystem.resolveGenericType(parameter.type, substitutions, analyzed);
			self.genericClosureRegisterType(parameter.type, substitutions, unresolved, analyzed);
			variables.put(parameter.name, resolved);
			self.genericClosureWalkNode(parameter.default_, substitutions, unresolved, analyzed, operators, variables);
			index = index + 1;
		}
	}

	private void genericClosureScanProperty(Node property, Map<string, Node> substitutions, Analyzed analyzed, OperatorSemantics operators, Map<string, Node> baseVariables) {
		Map<string, bool> unresolved = {};
		self.genericClosureRegisterType(property.type, substitutions, unresolved, analyzed);
		Map<string, Node> getterVariables = self.genericClosureCopyTypes(baseVariables);
		self.genericClosureWalkNode(property.getterBody, substitutions, unresolved, analyzed, operators, getterVariables);
		Map<string, Node> setterVariables = self.genericClosureCopyTypes(baseVariables);
		setterVariables.put("value", SemanticTypeSystem.resolveGenericType(property.type, substitutions, analyzed));
		self.genericClosureWalkNode(property.setterBody, substitutions, unresolved, analyzed, operators, setterVariables);
	}

	private void genericClosureScanMembers(Node declaration, Map<string, Node> substitutions, Analyzed analyzed, OperatorSemantics operators, Map<string, Node> baseVariables, bool includeConstructor) {
		int index = 0;
		while (index < declaration.members().len) {
			Node member = declaration.members().get(index);
			if (member.kind == NK_FIELD_DECL) {
				Map<string, bool> unresolved = {};
				self.genericClosureRegisterType(member.type, substitutions, unresolved, analyzed);
				self.genericClosureWalkNode(member.initializer, substitutions, unresolved, analyzed, operators, baseVariables);
			} else if (member.kind == NK_PROPERTY_DECL) {
				self.genericClosureScanProperty(member, substitutions, analyzed, operators, baseVariables);
			} else if (member.kind == NK_METHOD_DECL) {
				if (includeConstructor || !member.isConstructor) {
					Map<string, bool> unresolved = SemanticTypeSystem.genericParameterSet(member.genericParams());
					Map<string, Node> variables = self.genericClosureCopyTypes(baseVariables);
					string previousOwner = self.memberOwner;
					string previousMember = self.memberMethod;
					self.memberOwner = self.scopeOwner;
					self.memberMethod = member.genericParams().len > 0 ? member.name : "";
					self.genericClosureSeedParameters(member, substitutions, unresolved, analyzed, operators, variables);
					self.genericClosureWalkNode(member.bodyNode, substitutions, unresolved, analyzed, operators, variables);
					self.memberOwner = previousOwner;
					self.memberMethod = previousMember;
				}
			}
			index = index + 1;
		}
	}

	private void genericClosureScanHierarchy(Node declaration, Vector<Node> arguments, Map<string, Node> substitutions, Analyzed analyzed, OperatorSemantics operators, Map<string, Node> baseVariables, Map<string, bool> visited, bool includeConstructor) {
		if (visited.has(declaration.name)) { return; }
		visited.put(declaration.name, true);
		string parent = DeclarationRegistry.parentName(declaration);
		Node? parentDeclaration = null;
		if (analyzed.genericClassTable.has(parent)) {
			parentDeclaration = analyzed.genericClassTable.get(parent);
		} else if (analyzed.classTable.has(parent)) {
			parentDeclaration = analyzed.classTable.get(parent);
		}
		if (parentDeclaration != null) {
			Map<string, Node> parentSubstitutions = self.genericClosureClassMap(parentDeclaration, arguments);
			self.genericClosureScanHierarchy(parentDeclaration, arguments, parentSubstitutions, analyzed, operators, baseVariables, visited, false);
		}
		self.genericClosureScanMembers(declaration, substitutions, analyzed, operators, baseVariables, includeConstructor);
	}

	private void genericClosureScanClassInstance(GenInstance instance, Analyzed analyzed, OperatorSemantics operators) {
		if (!analyzed.genericClassTable.has(instance.base)) { return; }
		Node declaration = analyzed.genericClassTable.get(instance.base);
		Map<string, Node> substitutions = self.genericClosureClassMap(declaration, instance.args);
		Map<string, Node> baseVariables = self.genericClosureGlobalTypes(analyzed);
		baseVariables.put("self", self.genericClosureSelfType(instance.base, instance.args));
		Map<string, bool> visited = {};
		bool ownsMemo = self.expressions.beginScopedMemo();
		string previous = analyzed.beginInstance(GenericSpecializer.classInstanceContext(instance));
		string previousOwner = self.scopeOwner;
		string previousMethod = self.scopeMethod;
		self.enterScope(instance.base, "");
		self.genericClosureScanHierarchy(declaration, instance.args, substitutions, analyzed, operators, baseVariables, visited, true);
		self.scopeOwner = previousOwner;
		self.scopeMethod = previousMethod;
		analyzed.endInstance(previous);
		self.expressions.endScopedMemo(ownsMemo);
	}

	/* The specialization context of a class instance's body, shared with lowering. */
	class string classInstanceContext(GenInstance instance) { return "class " + instance.mangled; }

	/* The specialization context of a generic method instance's body. */
	class string methodInstanceContext(MethodGenInstance instance) { return "method " + TypeIdentity.methodInstanceKey(instance.classBase, instance.classArgs, instance.methodName, instance.methodArgs); }

	private Node? genericClosureMethodDeclaration(MethodGenInstance instance, Analyzed analyzed) {
		if (analyzed.isGenericClass(instance.classBase)) {
			return analyzed.genericClassMethod(instance.classBase, instance.methodName);
		}
		if (analyzed.isClass(instance.classBase)) {
			return analyzed.classMethod(instance.classBase, instance.methodName);
		}
		return null;
	}

	private Node? genericClosureOwnerDeclaration(MethodGenInstance instance, Analyzed analyzed) {
		if (analyzed.isGenericClass(instance.classBase)) {
			return analyzed.genericClassTable.get(instance.classBase);
		}
		if (analyzed.isClass(instance.classBase)) {
			return analyzed.classTable.get(instance.classBase);
		}
		return null;
	}

	private void genericClosureScanMethodInstance(MethodGenInstance instance, Analyzed analyzed, OperatorSemantics operators) {
		Node? declaration = self.genericClosureOwnerDeclaration(instance, analyzed);
		Node? method = self.genericClosureMethodDeclaration(instance, analyzed);
		if (declaration == null || method == null) { return; }
		Map<string, Node> substitutions = self.genericClosureClassMap(declaration, instance.classArgs);
		int methodIndex = 0;
		while (methodIndex < method.genericParams().len && methodIndex < instance.methodArgs.len) {
			substitutions.put(method.genericParams().get(methodIndex), instance.methodArgs.get(methodIndex));
			methodIndex = methodIndex + 1;
		}
		Map<string, bool> unresolved = {};
		Map<string, Node> variables = self.genericClosureGlobalTypes(analyzed);
		variables.put("self", self.genericClosureSelfType(instance.classBase, instance.classArgs));
		bool ownsMemo = self.expressions.beginScopedMemo();
		string previous = analyzed.beginInstance(GenericSpecializer.methodInstanceContext(instance));
		string previousOwner = self.scopeOwner;
		string previousMethod = self.scopeMethod;
		self.enterScope(instance.classBase, instance.methodName);
		self.genericClosureSeedParameters(method, substitutions, unresolved, analyzed, operators, variables);
		self.genericClosureWalkNode(method.bodyNode, substitutions, unresolved, analyzed, operators, variables);
		self.scopeOwner = previousOwner;
		self.scopeMethod = previousMethod;
		analyzed.endInstance(previous);
		self.expressions.endScopedMemo(ownsMemo);
	}

	private void closeGenericInstanceGraph(Analyzed analyzed, OperatorSemantics operators) {
		Map<string, bool> processedClasses = self.closedClassInstances;
		Map<string, bool> processedMethods = self.closedMethodInstances;
		int classIndex = 0;
		int methodIndex = 0;
		int scannedClasses = 0;
		int replayedClasses = 0;
		int scannedMethods = 0;
		int replayedMethods = 0;
		while (classIndex < analyzed.genericInstances.len || methodIndex < analyzed.methodGenInstances.len) {
			while (classIndex < analyzed.genericInstances.len) {
				GenInstance instance = analyzed.genericInstances.get(classIndex);
				classIndex = classIndex + 1;
				if (!processedClasses.has(instance.mangled)) {
					processedClasses.put(instance.mangled, true);
					Node? template = analyzed.genericClassTable.has(instance.base) ? analyzed.genericClassTable.get(instance.base) : null;
					string context = GenericSpecializer.classInstanceContext(instance);
					if (self.replayInstance(template, context)) {
						replayedClasses = replayedClasses + 1;
					} else {
						ValidationJournal? journal = self.beginInstanceJournal(template);
						self.genericClosureScanClassInstance(instance, analyzed, operators);
						self.endInstanceJournal(template, context, journal);
						scannedClasses = scannedClasses + 1;
					}
				}
			}
			while (methodIndex < analyzed.methodGenInstances.len) {
				MethodGenInstance instance = analyzed.methodGenInstances.get(methodIndex);
				methodIndex = methodIndex + 1;
				string key = TypeIdentity.methodInstanceKey(instance.classBase, instance.classArgs, instance.methodName, instance.methodArgs);
				if (!processedMethods.has(key)) {
					processedMethods.put(key, true);
					Node? template = self.genericClosureOwnerDeclaration(instance, analyzed);
					string context = GenericSpecializer.methodInstanceContext(instance);
					if (self.replayInstance(template, context)) {
						replayedMethods = replayedMethods + 1;
					} else {
						ValidationJournal? journal = self.beginInstanceJournal(template);
						self.genericClosureScanMethodInstance(instance, analyzed, operators);
						self.endInstanceJournal(template, context, journal);
						scannedMethods = scannedMethods + 1;
					}
				}
			}
		}
		BtrccPhaseTimer.note(f"instance-closure=class:{scannedClasses}+{replayedClasses}r,method:{scannedMethods}+{replayedMethods}r");
	}

	private void genericClosureScanOrdinaryCallable(Node callable, Node? owner, Analyzed analyzed, OperatorSemantics operators) {
		Map<string, Node> substitutions = {};
		Map<string, bool> unresolved = SemanticTypeSystem.genericParameterSet(callable.genericParams());
		Map<string, Node> variables = self.genericClosureGlobalTypes(analyzed);
		if (owner != null && callable.access != "class") {
			Vector<Node> noArguments = [];
			variables.put("self", self.genericClosureSelfType(owner.name, noArguments));
		}
		bool ownsMemo = self.expressions.beginScopedMemo();
		string previousOwner = self.scopeOwner;
		string previousMethod = self.scopeMethod;
		self.scopeOwner = "";
		self.scopeMethod = "";
		self.genericClosureSeedParameters(callable, substitutions, unresolved, analyzed, operators, variables);
		self.genericClosureWalkNode(callable.bodyNode, substitutions, unresolved, analyzed, operators, variables);
		self.scopeOwner = previousOwner;
		self.scopeMethod = previousMethod;
		self.expressions.endScopedMemo(ownsMemo);
	}

	/* Semantic validation records target-directed no-arg constructor types after
     * the analyzer's initial declaration walk. Scan ordinary bodies once more at
     * that point, then close any newly discovered specialization graph. */
	/* Each closure-scan unit (an ordinary callable body, a plain class's field and
     * property initializers, a global initializer, or one generic class/method
     * instance) owns a scoped expression-inference memo: the walk infers the type
     * of every subexpression it visits, so without a memo a builder chain of
     * depth n costs n full inferences of its suffixes. Units never share a memo
     * because generic instances resolve the same template nodes under different
     * substitutions. */
	private void closeProgramGenericExpressionGraph(Node program, Analyzed analyzed, OperatorSemantics operators) {
		Map<string, Node> substitutions = {};
		Map<string, bool> unresolved = {};
		int declarationIndex = 0;
		while (declarationIndex < program.declarations().len) {
			Node declaration = program.declarations().get(declarationIndex);
			if ((declaration.kind == NK_FUNCTION_DECL || (declaration.kind == NK_CLASS_DECL && declaration.genericParams().len == 0)) && self.replayRecorded(RECORD_PHASE_CLOSE, declaration)) {
				declarationIndex = declarationIndex + 1;
				continue;
			}
			ValidationJournal? journal = null;
			if (declaration.kind == NK_FUNCTION_DECL || (declaration.kind == NK_CLASS_DECL && declaration.genericParams().len == 0)) { journal = self.beginJournal(RECORD_PHASE_CLOSE, declaration); }
			if (declaration.kind == NK_FUNCTION_DECL) {
				self.genericClosureScanOrdinaryCallable(declaration, null, analyzed, operators);
			} else if (declaration.kind == NK_CLASS_DECL && declaration.genericParams().len == 0) {
				Map<string, Node> fieldVariables = self.genericClosureGlobalTypes(analyzed);
				Vector<Node> noArguments = [];
				fieldVariables.put("self", self.genericClosureSelfType(declaration.name, noArguments));
				bool ownsMemo = self.expressions.beginScopedMemo();
				int memberIndex = 0;
				while (memberIndex < declaration.members().len) {
					Node member = declaration.members().get(memberIndex);
					if (member.kind == NK_FIELD_DECL) {
						self.genericClosureWalkNode(member.initializer, substitutions, unresolved, analyzed, operators, fieldVariables);
					} else if (member.kind == NK_PROPERTY_DECL) {
						self.genericClosureScanProperty(member, substitutions, analyzed, operators, fieldVariables);
					} else if (member.kind == NK_METHOD_DECL && member.genericParams().len == 0) {
						self.genericClosureScanOrdinaryCallable(member, declaration, analyzed, operators);
					}
					memberIndex = memberIndex + 1;
				}
				self.expressions.endScopedMemo(ownsMemo);
			} else {
				bool ownsMemo = self.expressions.beginScopedMemo();
				self.genericClosureWalkNode(declaration.initializer, substitutions, unresolved, analyzed, operators, self.genericClosureGlobalTypes(analyzed));
				self.expressions.endScopedMemo(ownsMemo);
			}
			self.endJournal(RECORD_PHASE_CLOSE, declaration, journal);
			declarationIndex = declarationIndex + 1;
		}
		BtrccPhaseTimer.mark("c-declarations");
		self.closeGenericInstanceGraph(analyzed, operators);
		BtrccPhaseTimer.mark("c-instances");
	}


	/* Analyzer-owned emitted symbol contract for source destructors. */

	class string destructorHookName(string ownerName) { return "__btrc_" + ownerName + "_destructor_hook"; }


	/* Analyzer-owned emitted symbol contract for generic method instances. */

	class string genericMethodInstanceName(string classBase, Vector<Node> classArgs, string methodName, Vector<Node> methodArgs) { return TypeIdentity.mangleMethodInstanceSymbol(classBase, classArgs, methodName, methodArgs); }
}
