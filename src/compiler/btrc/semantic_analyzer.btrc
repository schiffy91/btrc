/* Per-compilation semantic composition and its operator type universe. */

class SemanticAnalyzer {
    private Analyzed analysis;
    private OperatorSemantics operators;
    private ManagedValueSemantics managedValues;
    private CycleMetadata cycles;

    public SemanticAnalyzer() {
        self.analysis = Analyzed();
        self.operators = OperatorSemantics(self.analysis);
        self.managedValues = ManagedValueSemantics(self.analysis);
        self.cycles = CycleMetadata(
            self.analysis, self.managedValues);
    }

    public Analyzed analyze(Node program) {
        analyzeProgram(program, self.analysis, self.operators);
        semanticValidateProgram(
            program, self.analysis, self.operators, self.cycles);
        closeProgramGenericExpressionGraph(
            program, self.analysis, self.operators);
        return self.analysis;
    }

    public OperatorSemantics operatorSemantics() {
        return self.operators;
    }

    public ManagedValueSemantics managedValueSemantics() {
        return self.managedValues;
    }

    public CycleMetadata cycleMetadata() {
        return self.cycles;
    }
}
