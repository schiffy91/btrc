/* Front-end driver: compose the full source for a btrc program and print it
 * verbatim to stdout (byte-identical to the Python compiler's
 * CompilationPipeline.resolve(...).source).
 *
 * Strict imports are the default. `--relaxed-imports` explicitly enables
 * legacy whole-stdlib composition; `--no-stdlib` disables that composition
 * without affecting explicit includes/imports.
 */

import Library.Console;

import ../cli/Driver.btrc;
import ../frontend/Models.btrc;
import ../frontend/Packages.btrc;
import ../frontend/Resolver.btrc;
import ../frontend/SourceIo.btrc;
import ../frontend/Stdlib.btrc;
import ../pipeline/Pipeline.btrc;
import ../syntax/Grammar.btrc;

class FrontendInspectionCommand {
	private BtrccOutput output;
	private FeSourceFileReader sourceFiles;

	public FrontendInspectionCommand(BtrccOutput output) {
		self.output = output;
		self.sourceFiles = FeSourceFileReader();
	}

	private string usage() { return "usage: frontend [--strict-imports | --relaxed-imports] " + "[--no-stdlib] [--target OS-ARCH[-ENV]] <file.btrc>\n" + "--target selects one of " + Strings.join(FePackageTarget.labels(), ", ") + "; default: this host"; }

	public int run(int argc, char** argv) {
		if (argc < 2) {
			Console.error(self.usage());
			return 1;
		}

		bool includeStdlib = true;
		bool strictImports = true;
		string target = "";
		bool targetGiven = false;
		bool targetRepeated = false;
		int argumentIndex = 1;
		while (argumentIndex < argc) {
			string option = Strings.copy(argv[argumentIndex]);
			if (option.equals("--no-stdlib")) {
				includeStdlib = false;
			} else if (option.equals("--strict-imports")) {
				strictImports = true;
			} else if (option.equals("--relaxed-imports")) {
				strictImports = false;
			} else if (option.equals("--target")) {
				argumentIndex++;
				if (argumentIndex >= argc) {
					Console.error("--target requires OS-ARCH[-ENV]");
					return 1;
				}
				if (targetGiven) { targetRepeated = true; }
				targetGiven = true;
				target = Strings.copy(argv[argumentIndex]);
			} else {
				break;
			}
			argumentIndex++;
		}
		if (argumentIndex >= argc) {
			Console.error(self.usage());
			return 1;
		}

		/* As in btrcc: the target is checked after the arguments and before
		 * the input is read. */
		if (targetRepeated) {
			Console.error("error: --target may be specified only once");
			return 1;
		}
		FePackageTarget selected = FePackageTarget.host();
		if (targetGiven) {
			try {
				selected = FePackageTarget.parse(target);
			} catch (string error) {
				Console.error("error: " + error);
				return 1;
			}
		} else if (!selected.known()) {
			Console.error("error: " + FePackageTarget.unknownHostMessage());
			return 1;
		}
		target = selected.label();
		string path = Strings.copy(argv[argumentIndex]);
		string source = self.sourceFiles.readRequired(path);
		BtrccRuntimePaths runtimePaths = BtrccRuntimePaths(Strings.copy(argv[0]));
		BtrccDataPaths dataPaths = runtimePaths.resolve();
		if (!dataPaths.valid) {
			Console.error(dataPaths.diagnostic);
			return 1;
		}
		GrammarInfo grammar = EbnfGrammarParser(self.sourceFiles.readRequired(dataPaths.grammar)).parse();
		FeStdlibRepository stdlib = FeStdlibRepository(dataPaths.stdlib, self.sourceFiles);
		FeResolvedPackages packages = FePackageGraphResolver(self.sourceFiles).resolveFor(path, target);
		/* Conditioned for --target (else the host) through the compiler's own
		 * environment, so this inspection matches what a compile resolves. */
		FeConditionalEnvironment environment = CompilerPipeline(grammar, dataPaths.stdlib, self.sourceFiles).conditionalEnvironment(packages);
		FeFrontendResolver resolver = FeFrontendResolver(grammar, stdlib, includeStdlib, strictImports, packages, null, environment);
		FeResolvedSource resolved = resolver.resolve(source, path);
		if (self.output.write(resolved.source)) { return 0; }
		fprintf(stderr, "frontend: error: cannot write standard output\n");
		return 1;
	}
}

int main(int argc, char** argv) { return FrontendInspectionCommand(BtrccOutput(stdout)).run(argc, argv); }
