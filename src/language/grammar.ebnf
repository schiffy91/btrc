-- btrc language grammar
--
-- This is the single source of truth for the lexical and syntactic structure
-- of the btrc language. Both the Python bootstrap compiler and the self-hosted
-- btrc compiler read this file at compile time.
--
-- Lexical section: defines tokens (keywords, operators, literal patterns).
-- Syntax section: defines grammar rules for the parser.
--
-- The lexer extracts keywords and operators from @lexical to build its
-- lookup tables. The parser uses @syntax as a checked specification for
-- its hand-written recursive descent methods.

-- ================================================================
-- LEXICAL RULES
-- ================================================================

@lexical {

  -- Keywords: identifiers reserved by the language.
  -- The lexer maps these to distinct token types.
  --
  -- RESERVED (lexed as keywords, but no @syntax rule consumes them yet —
  -- using them is a parse error; they are reserved to keep the C surface
  -- intact and to leave room for future syntax):
  --   auto, register  -- C storage classes, not implemented
  --   goto            -- no goto/label syntax
  --   override        -- not a member modifier (member_body has no slot for
  --                      it); `public override int f()` is a parse error
  --   union           -- only usable as a `union IDENT` base_type, never as a
  --                      top-level declaration
  -- These remain in @keywords so the keyword/token round-trip stays total
  -- (every keyword maps to an existing TokenType, and tokens.py validates it).

  @keywords {
    -- C keywords
    auto break case char const continue default do double else enum extern
    float for goto if int long register return short signed sizeof static
    struct switch typedef union unsigned void volatile while

    -- btrc keywords
    abstract bool catch class delete extends false finally function
    implements import in interface keep new null override parallel private
    public release self spawn string super throw true try var
  }

  -- Operators and delimiters, ordered longest-first within each line.
  -- The lexer builds a trie from this list for longest-match tokenization.

  @operators {
    -- 3-character operators
    "<<=" ">>="

    -- 2-character operators
    "+=" "-=" "*=" "/=" "%=" "&=" "|=" "^="
    "++" "--" "==" "!=" "<=" ">=" "&&" "||"
    "?." "??" "=>" "->" "<<" ">>"

    -- 1-character operators
    "+" "-" "*" "/" "%" "=" "<" ">" "!" "&" "|" "^" "~" "?"

    -- Delimiters
    "(" ")" "[" "]" "{" "}" "." "," ";" ":"
  }

  -- Literal token patterns (regex notation, for specification only).
  -- Actual literal parsing is hand-coded in the lexer for robustness.

  @literals {
    IDENT       = /[a-zA-Z_][a-zA-Z0-9_]*/
    INT_LIT     = /0[xX][0-9a-fA-F]+(([uU]([lL]|ll|LL)?)|(([lL]|ll|LL)[uU]?))?/
                | /0[bB][01]+(([uU]([lL]|ll|LL)?)|(([lL]|ll|LL)[uU]?))?/
                | /0[oO][0-7]+(([uU]([lL]|ll|LL)?)|(([lL]|ll|LL)[uU]?))?/
                | /0(([uU]([lL]|ll|LL)?)|(([lL]|ll|LL)[uU]?))?/
                | /0[0-7]+(([uU]([lL]|ll|LL)?)|(([lL]|ll|LL)[uU]?))?/
                | /[1-9][0-9]*(([uU]([lL]|ll|LL)?)|(([lL]|ll|LL)[uU]?))?/
    FLOAT_LIT   = /[0-9]+\.[0-9]+([eE][+-]?[0-9]+)?[fF]?/
                | /[0-9]+[eE][+-]?[0-9]+[fF]?/
    STRING_LIT  = /"([^"\\\r\n]|\\.)*"/
    CHAR_LIT    = /'([^'\\\r\n]|\\.)*'/
    FSTRING_LIT = /f"..."/ -- brace-balanced sub-lexing; see lexer
    PATH_SPEC   = /[^;\n]+/ -- raw filesystem path; see lexer note below

    -- `\\.` above is compact notation, not the scanner's actual contract.
    -- Strings/f-strings accept strict-C simple/octal/hex escapes, valid 4/8-digit
    -- universal character names, and LF/CRLF backslash-newline splices. Narrow
    -- character literals accept exactly one printable ASCII source character or
    -- one simple/octal/greedy-hex escape whose value fits unsigned char; they
    -- deliberately reject UCNs, multibyte characters, and line splices.
  }

  -- Import path mode (lexer): immediately after the "import" keyword, if the
  -- next non-space character is '.', '/' or '~' (a relative/absolute path), the
  -- lexer reads the rest of the line up to ';' or newline as ONE raw PATH_SPEC
  -- token. This keeps whitespace-bearing paths intact and prevents bogus
  -- rejoins like "./ dir / **". For std.x / std.{a,b} / std.* / "quoted" / bare
  -- packages (mathx.vec), path mode is NOT entered: those lex as ordinary
  -- IDENT/DOT/STAR/LBRACE/STRING_LIT tokens and the parser assembles them.

  -- Tokens to skip (not passed to parser).
  @ignore {
    whitespace    = /[ \t\r\n]+/
    line_comment  = /\/\/[^\n]*/
    block_comment = /\/\*([^*]|\*[^\/])*\*\//
  }

  -- Preprocessor directives are passed through as single tokens.
  @preprocessor = /^#[^\n]*/

  -- Annotations: decorators that modify declarations.
  -- The lexer reads "@" followed by an identifier and emits a single
  -- AT_<NAME> token. Only annotations listed here are recognized.

  @annotations {
    gpu    -- marks a function as a GPU compute kernel
  }
}

-- ================================================================
-- SYNTAX RULES
-- ================================================================
--
-- Notation:
--   { X }        = zero or more X
--   [ X ]        = optional X
--   X | Y        = alternation
--   "keyword"    = terminal keyword or operator
--   UPPER_CASE   = terminal token from @literals
--   lower_case   = non-terminal production rule
--   (* ... *)    = disambiguation comment

@syntax {

  -- ----------------------------------------------------------------
  -- Top-level
  -- ----------------------------------------------------------------

  program     = { top_level } ;

  top_level   = preprocessor_directive
              | import_decl
              | class_decl
              | interface_decl
              | struct_decl
              | enum_decl
              | rich_enum_decl
              | typedef_decl
              | function_decl
              | var_decl_stmt ;

  preprocessor_directive = PREPROCESSOR ;

  -- ----------------------------------------------------------------
  -- Import declaration
  -- ----------------------------------------------------------------
  --
  -- Imports are resolved by the front-end *after* parsing (see frontend.py):
  -- each ImportDecl spec is mapped to one or more files whose declarations are
  -- spliced in. Because import is now a real keyword parsed from the token
  -- stream, imports inside comments/strings are never resolved.

  import_decl = "import" import_spec [ ";" ] ;

  import_spec = std_spec
              | quoted_path
              | path_spec
              | package_path ;

  std_spec    = "std" "." ( "*" | "*" "*" | IDENT | "{" ident_list "}" ) ;
  package_path = IDENT { "." IDENT }    (* e.g. mathx, mathx.vec *) ;
  quoted_path = STRING_LIT ;
  path_spec   = PATH_SPEC                (* ./x.btrc, ./dir/*, ./dir/**, ../y, /abs, ~/home *) ;

  -- ----------------------------------------------------------------
  -- Class declaration
  -- ----------------------------------------------------------------

  class_decl  = [ "abstract" ] "class" IDENT [ "<" ident_list ">" ]
                [ "extends" IDENT ]
                [ "implements" ident_list ]
                "{" { class_member } "}" ;

  ident_list  = IDENT { "," IDENT } ;

  class_member = access_modifier member_body ;

  access_modifier = "public" | "private" | "class" | "static"
                  (* "class" and "static" both mark a static member; the
                     parser maps both to access "class". *) ;

  member_body = [ "abstract" ] [ "@gpu" ] [ "keep" ] method_or_field_or_property
                (* Modifier order is fixed: abstract, then @gpu, then keep.
                   "abstract" is only accepted inside an `abstract class`
                   (abstract methods elsewhere are a parse error). "keep" marks
                   the return value as keep-retained. *) ;

  method_or_field_or_property
              = type_expr IDENT method_rest        (* method: has ( *)
              | type_expr IDENT property_rest       (* property: has { get/set *)
              | type_expr IDENT field_rest          (* field: has ; or = *)
              | type_expr "(" param_list ")" block  (* constructor: name matches class *)
              (* Disambiguation: peek at tokens after "type IDENT" to decide.
                 If "(": method or constructor.
                 If "{" followed by "get" or "set": property.
                 Otherwise: field. *) ;

  method_rest     = "(" param_list ")" ( block | ";" ) ;
  property_rest   = "{" { property_accessor } "}" ;
  field_rest      = [ "=" expr ] ";" ;

  property_accessor = ( "get" | "set" ) ( ";" | block ) ;

  -- ----------------------------------------------------------------
  -- Interface declaration
  -- ----------------------------------------------------------------

  interface_decl = "interface" IDENT [ "<" ident_list ">" ]
                   [ "extends" IDENT ]
                   "{" { method_signature } "}"
                   (* Generic interfaces (interface Box<T>) are supported. *) ;

  method_signature = [ "keep" ] type_expr IDENT "(" param_list ")" ";"
                     (* "keep" marks the returned value as keep-retained. *) ;

  -- ----------------------------------------------------------------
  -- Struct declaration
  -- ----------------------------------------------------------------

  struct_decl = "struct" [ IDENT ] "{" { struct_field } "}" ";"
              | "struct" IDENT ";"
                (* The name is optional, allowing anonymous structs
                   (struct { int x; };). A named struct with no body is a
                   forward declaration (struct Foo;). *) ;

  struct_field = type_expr IDENT [ "[" expr "]" ] ";" ;

  -- ----------------------------------------------------------------
  -- Enum declarations
  -- ----------------------------------------------------------------

  enum_decl      = "enum" [ IDENT ] "{" enum_value { "," enum_value } [ "," ] "}" ";"
                   (* The name is optional: anonymous enums (enum { A, B };)
                      are supported. *) ;
  enum_value     = IDENT [ "=" expr ] ;

  rich_enum_decl = "enum" "class" IDENT "{"
                     rich_variant { "," rich_variant } [ "," ]
                   "}" ;
  rich_variant   = IDENT [ "(" param_list ")" ] ;

  -- ----------------------------------------------------------------
  -- Typedef
  -- ----------------------------------------------------------------

  typedef_decl = "typedef" type_expr IDENT ";" ;

  -- ----------------------------------------------------------------
  -- Function declaration
  -- ----------------------------------------------------------------

  function_decl = [ "@gpu" ] [ "keep" ] type_expr IDENT "(" param_list ")" ( block | ";" ) ;

  -- ----------------------------------------------------------------
  -- Type expressions
  -- ----------------------------------------------------------------

  type_expr = { type_qualifier } base_type [ generic_args ]
              [ "[" "]" ] { "*" } [ "?" ]
              (* Fixed parse order: qualifiers, base type, generic args, then
                 at most one UNSIZED array suffix "[]", then zero or more
                 pointer "*", then at most one nullable "?".
                 "?" is nullable sugar: adds one pointer level.
                 SIZED arrays ("[" expr "]") are NOT part of type_expr; they
                 are parsed only in param, struct_field, and var-decl contexts
                 as a suffix on the declared name (e.g. int arr[10]). *) ;

  type_qualifier = "const" | "static" | "extern" | "volatile" ;

  base_type = "void" | "int" | "float" | "double" | "char" | "bool" | "string"
            | "short" [ "int" ]
            | "long" [ "int" | "double" | "long" [ "int" ] ]
            | "unsigned" [ "int" | "short" [ "int" ]
                           | "long" [ "long" ] [ "int" ] | "char" ]
            | "signed" [ "int" | "short" [ "int" ]
                         | "long" [ "long" ] [ "int" ] | "char" ]
            | "struct" IDENT | "enum" IDENT | "union" IDENT
            | IDENT
            | "(" type_list ")"  (* tuple type: (int, string, bool) *)
            ;

  generic_args = "<" type_list ">"
                 (* Disambiguation ('<' generic vs. less-than comparison):
                    the parser scans forward from "<" tracking nesting depth,
                    splitting ">>" into two closing ">". If it hits ";", "{",
                    "}", or EOF before the nesting closes, it is NOT generic.
                    When the matching ">" is found, it is treated as generic
                    args only if the token immediately AFTER the closing ">"
                    is one of:
                      IDENT  "*"  "("  ")"  "["  ","  ">"  ">>"  ";"  "{"  "="
                      "?"  "function"
                    (a type/name continuation, nesting close, or declarator
                    boundary). Otherwise the "<" is a comparison operator.
                    The ">>" split also handles nested generics like
                    List<Map<int, int>>. *) ;

  type_list = type_expr { "," type_expr } ;

  -- ----------------------------------------------------------------
  -- Parameters
  -- ----------------------------------------------------------------

  param_list = [ param { "," param } ] ;

  param = [ "keep" ] type_expr IDENT [ "[" [ expr ] "]" ] [ "=" expr ]
          (* "keep" qualifier: the callee keep-retains the argument.
             Array-style params: int arr[], int arr[10]
             Default values: int x = 42 *) ;

  -- ----------------------------------------------------------------
  -- Statements
  -- ----------------------------------------------------------------

  block = "{" { statement } "}" ;

  statement = block
            | var_decl_stmt
            | return_stmt
            | if_stmt
            | while_stmt
            | do_while_stmt
            | for_stmt
            | parallel_for_stmt
            | switch_stmt
            | break_stmt
            | continue_stmt
            | try_catch_stmt
            | throw_stmt
            | delete_stmt
            | keep_stmt
            | release_stmt
            | expr_stmt ;

  var_decl_stmt = ( "var" IDENT "=" expr
                  | type_expr IDENT [ "[" [ expr ] "]" ] [ "=" expr ]
                  ) ";"
                  (* Disambiguation: "var" keyword is unambiguous.
                     For typed declarations, parser uses lookahead to check
                     if the token sequence matches "type_expr IDENT" pattern
                     vs an expression statement. *) ;

  return_stmt     = "return" [ expr ] ";" ;
  if_stmt         = "if" "(" expr ")" block [ "else" ( if_stmt | block ) ] ;
  while_stmt      = "while" "(" expr ")" block ;
  do_while_stmt   = "do" block "while" "(" expr ")" ";" ;
  break_stmt      = "break" ";" ;
  continue_stmt   = "continue" ";" ;
  throw_stmt      = "throw" expr ";" ;
  delete_stmt     = "delete" expr ";" ;
  keep_stmt       = "keep" expr ";" ;
  release_stmt    = "release" expr ";" ;
  expr_stmt       = expr ";" ;

  for_stmt = "for" ( for_in_clause | c_for_clause ) ;

  for_in_clause = IDENT [ "," IDENT ] "in" expr block
                  (* Single var: for x in list { }
                     Two vars: for k, v in map { }
                     Disambiguation: if token after "for" is IDENT and
                     second-next is "in" or ",", it is for-in.
                     Otherwise it is C-style for. *) ;

  c_for_clause  = "(" [ for_init ] ";" [ expr ] ";" [ expr ] ")" block ;

  for_init = var_decl_no_semi | expr ;
  var_decl_no_semi = "var" IDENT "=" expr
                   | type_expr IDENT [ "=" expr ] ;

  parallel_for_stmt = "parallel" "for" IDENT "in" expr block ;

  switch_stmt = "switch" "(" expr ")" "{" { case_clause } "}" ;
  case_clause = ( "case" expr | "default" ) ":" { statement } ;

  try_catch_stmt = "try" block
                   [ "catch" "(" [ type_expr ] IDENT ")" block ]
                   [ "finally" block ]
                   (* At least one of "catch" or "finally" must be present, so
                      try/finally without a catch is legal. The catch clause may
                      carry an optional type annotation (catch (Error e)); the
                      type is parsed but currently not stored in the AST. *) ;

  -- ----------------------------------------------------------------
  -- Expressions (precedence: lowest to highest)
  -- ----------------------------------------------------------------

  expr           = assignment ;

  assignment     = ternary [ assign_op assignment ]
                   (* Right-associative *) ;

  assign_op      = "=" | "+=" | "-=" | "*=" | "/=" | "%="
                 | "&=" | "|=" | "^=" | "<<=" | ">>=" ;

  ternary        = null_coalesce [ "?" expr ":" ternary ] ;

  null_coalesce  = logical_or { "??" logical_or } ;

  logical_or     = logical_and { "||" logical_and } ;

  logical_and    = bitwise_or { "&&" bitwise_or } ;

  bitwise_or     = bitwise_xor { "|" bitwise_xor } ;

  bitwise_xor    = bitwise_and { "^" bitwise_and } ;

  bitwise_and    = equality { "&" equality } ;

  equality       = relational { ( "==" | "!=" ) relational } ;

  relational     = shift { ( "<" | ">" | "<=" | ">=" ) shift } ;

  shift          = additive { ( "<<" | ">>" ) additive } ;

  additive       = multiplicative { ( "+" | "-" ) multiplicative } ;

  multiplicative = unary { ( "*" | "/" | "%" ) unary } ;

  unary          = ( "!" | "~" | "-" | "+" | "++" | "--" ) unary
                 | "*" unary          (* dereference *)
                 | "&" unary          (* address-of *)
                 | "sizeof" "(" type_or_expr ")"
                 | "(" type_expr ")" unary  (* C-style cast *)
                 | postfix
                 (* Unary "+" is accepted as a C-style no-op (e.g. +5, +x).

                    Cast disambiguation is NOT a trial parse; it is a bounded
                    lookahead. After "(", the parser inspects what follows:

                    (a) Type-keyword cast — "(" begins with a base-type keyword
                        (int, float, struct, const, ...): scan to the matching
                        ")"; it is a cast iff the token AFTER ")" is in the
                        cast-follow set below.

                    (b) Bare-identifier / explicit-type cast — "(" begins with
                        IDENT, optionally followed by "<...>" generic args,
                        "*" pointers, and/or "?". If any of those explicit-type
                        markers are present (e.g. (Foo*)x, (Box<int>)x, (Foo?)x)
                        the full cast-follow set applies. For a BARE identifier
                        with no type markers (e.g. (a)) the follow set EXCLUDES
                        "+", "-", "*", "&", so that (a) + 1, (a) - 1, (a) * b,
                        (a) & b parse as grouped binary expressions, not casts.

                    Cast-follow set (token immediately after the closing ")"
                    that makes the parenthesized type a cast):
                      IDENT INT_LIT FLOAT_LIT STRING_LIT CHAR_LIT FSTRING_LIT
                      "(" "sizeof" "*" "&" "!" "~" "+" "-" "++" "--"
                      "self" "true" "false" "null" "new" "spawn"
                    For a bare identifier, "+" "-" "*" "&" are removed from
                    this set (see above). *) ;

  type_or_expr   = type_expr | expr
                   (* Ambiguous: sizeof(int) vs sizeof(x). The parser uses
                      lookahead: a type keyword, or an IDENT immediately
                      followed by ")", "*", or "<", is read as a type;
                      otherwise the operand is parsed as an expression. *) ;

  postfix        = primary { postfix_op } ;

  postfix_op     = "(" arg_list ")"         (* function call *)
                 | "[" expr "]"             (* indexing *)
                 | "." IDENT               (* field access *)
                 | "." INT_LIT             (* tuple field: .0, .1, .2 *)
                                           (* LIMITATION: chained tuple access
                                              like x.0.1 does NOT parse — the
                                              lexer greedily reads "0.1" as one
                                              FLOAT_LIT. Use (x.0).1 or bind an
                                              intermediate. *)
                 | "?." IDENT              (* optional chaining *)
                 | "->" IDENT              (* arrow access *)
                 | "++"                     (* postfix increment *)
                 | "--"                     (* postfix decrement *) ;

  primary        = INT_LIT
                 | FLOAT_LIT
                 | STRING_LIT
                 | CHAR_LIT
                 | FSTRING_LIT
                 | "true" | "false" | "null" | "self" | "super"
                 | new_expr
                 | spawn_expr
                 | lambda_expr
                 | paren_or_tuple
                 | list_literal
                 | map_or_brace
                 | IDENT ;

  new_expr       = "new" type_expr "(" arg_list ")" ;

  spawn_expr     = "spawn" "(" lambda_expr ")"
                   (* Returns Thread<T> where T is the return type of lambda *) ;

  lambda_expr    = arrow_lambda | verbose_lambda ;

  arrow_lambda   = "(" param_list ")" "=>" ( block | expr )
                   (* Disambiguation: starts with "(" like a paren_or_tuple.
                      Parser tries param_list + "=>" lookahead. *) ;

  verbose_lambda = type_expr "function" "(" param_list ")" block ;

  paren_or_tuple = "(" expr [ "," expr_list ] ")"
                   (* If comma present: tuple literal (a, b, c).
                      Otherwise: parenthesized expression (a). *) ;

  list_literal   = "[" [ expr_list [ "," ] ] "]"
                   (* A trailing comma is allowed: [1, 2, 3,] *) ;

  map_or_brace   = "{" map_entries "}"            (* map literal: {k: v, ...} *)
                 | "{" [ expr_list [ "," ] ] "}"  (* brace initializer: {a, b, c} *)
                 (* Disambiguation: if first expr is followed by ":",
                    treat as map literal. Otherwise brace initializer.
                    Both forms allow a trailing comma: {1: 2,} and {1, 2,}. *) ;

  map_entries    = map_entry { "," map_entry } [ "," ] ;
  map_entry      = expr ":" expr ;

  arg_list       = [ arg { "," arg } ] ;
  arg            = [ IDENT "=" ] expr       (* named argument; positional args must precede named args *) ;
  expr_list      = expr { "," expr } ;
}
