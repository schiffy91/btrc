{
  "name": "btrc",
  "displayName": "btrc Language",
  "description": "Language support for btrc — a language that transpiles to C",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "btrc-dev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "icons/btrc.png",
  "activationEvents": [
    "onLanguage:btrc",
    "onDebugResolve:btrc",
    "onDebugDynamicConfigurations:btrc"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "btrc",
        "aliases": [
          "btrc",
          "BTRC"
        ],
        "extensions": [
          ".btrc"
        ],
        "icon": {
          "light": "./icons/btrc.png",
          "dark": "./icons/btrc.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "btrc",
        "scopeName": "source.btrc",
        "path": "./syntaxes/btrc.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[btrc]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "breakpoints": [
      {
        "language": "btrc"
      }
    ],
    "debuggers": [
      {
        "type": "btrc",
        "label": "btrc Debug",
        "languages": [
          "btrc"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Absolute path to the .btrc file to compile and debug.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Command-line arguments passed to the debugged program.",
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Break at the program's entry point.",
                "default": false
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the debugged program.",
                "default": "${workspaceFolder}"
              },
              "btrcpy": {
                "type": [
                  "string",
                  "array"
                ],
                "description": "Command that runs the btrc compiler (e.g. \"bin/btrcpy\"). Auto-detected from the workspace when omitted."
              },
              "cc": {
                "type": "string",
                "description": "C compiler used to build the debug binary.",
                "default": "cc"
              },
              "cflags": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Extra flags passed to the C compiler.",
                "default": []
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "btrc",
            "request": "launch",
            "name": "btrc: debug current file",
            "program": "${file}",
            "stopOnEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": "btrc: Debug current file",
            "description": "Compile the active .btrc file with debug info and debug it",
            "body": {
              "type": "btrc",
              "request": "launch",
              "name": "btrc: debug current file",
              "program": "^\"\\${file}\"",
              "stopOnEntry": false
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": "btrc",
      "properties": {
        "btrc.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to Python 3 interpreter for the btrc language server"
        },
        "btrc.serverPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the btrc LSP server script (server.py). When set, the extension uses this directly instead of searching for it."
        },
        "btrc.serverCommand": {
          "type": "string",
          "default": "btrc-lsp",
          "description": "Command or absolute path for the btrc language server, defaulting to btrc-lsp. Workspace direnv, shell.nix, or flake.nix takes precedence for relative commands so app repos use their pinned toolchain."
        },
        "btrc.useNixDevShell": {
          "type": "boolean",
          "default": true,
          "description": "When the project has a flake.nix and `nix` is on PATH, run the language server inside the Nix dev shell (which provides the pinned Python 3.13+ with pygls/lsprotocol). A local src/devex/lsp/.venv or an explicit btrc.pythonPath takes precedence, so no manual venv is needed."
        },
        "btrc.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Traces the communication between VS Code and the btrc language server"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run prepare-lsp && npm run esbuild-base",
    "esbuild-base": "esbuild ./src/extension.ts ./src/launch.ts ./src/debug_launch.ts --bundle --outdir=out --external:vscode --format=cjs --platform=node",
    "compile": "npm run esbuild-base",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run compile && node --test test/*.test.js",
    "prepare-lsp": "python3 scripts/prepare_lsp_package.py",
    "watch": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --watch",
    "package": "vsce package --out btrc.vsix --allow-missing-repository",
    "install-ext": "npm run package && code --install-extension btrc.vsix --force"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "1.85.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.3.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
