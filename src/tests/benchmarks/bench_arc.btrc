// ARC-heavy: a cyclable graph (nodes referencing nodes) that drives the phased
// scope-release path, the cycle collector, and per-class visit/destroy emission.
// This is the path most sensitive to dead-function elimination correctness.
class Node {
    public int id;
    public Node next;
    public Node(int id) {
        self.id = id;
        self.next = null;
    }
}

int build_and_walk(int n) {
    Node head = new Node(0);
    Node cur = head;
    for (int i = 1; i < n; i++) {
        Node m = new Node(i);
        cur.next = m;
        cur = m;
    }
    // Create a cycle so the collector has real work to do.
    cur.next = head;

    int sum = 0;
    Node walk = head;
    for (int i = 0; i < n; i++) {
        sum += walk.id;
        walk = walk.next;
    }
    return sum;
}

int main() {
    int s = build_and_walk(100);
    print(s);
    return 0;
}
