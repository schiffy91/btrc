// Generated by python -m tools.bench.app_scale; edit the generator.
// Every model reaches its own Map, Vector, Result, index, edit and history
// instances. Runtime assertions cover lookups, replacements and undo snapshots.
import Library.Audio.Audio;
import Library.Audio.AudioDevice;
import Library.BackgroundJobs.HostWorkerPools;
import Library.BackgroundJobs.WorkerPools;
import Library.Bytes;
import Library.FileSystem.FileTree;
import Library.FileSystem.FileSystem;
import Library.GPU.GPUProgram;
import Library.GPU.WebGPU;
import Library.GUI.GUI;
import Library.GUI.TextRun;
import Library.HTTP.HTTPResponse;
import Library.HTTP.HTTPClient;
import Library.HTTP.HTTPUrl;
import Library.Image.Pixels;
import Library.Map;
import Library.Result;
import Library.Vector;

#include <assert.h>

class AppIndex<T> {
	private Map<string, T> entries = {};
	private Vector<string> keys = [];
	public void put(string key, T value) {
		if (!self.entries.has(key)) { self.keys.push(key); }
		self.entries.put(key, value);
	}

	public Result<T, string> lookup(string key) {
		assert(self.entries.has(key));
		Result<T, string> result = Result(true, self.entries.get(key), "");
		return result;
	}

	public Vector<T> snapshot() {
		Vector<T> result = [];
		for key in self.keys { result.push(self.entries.get(key)); }
		return result;
	}

	public int size() { return self.keys.len; }
}

class AppChange<T> {
	private T before;
	private T after;
	public AppChange(T before, T after) { self.before = before; self.after = after; }

	public T apply() { return self.after; }

	public T reverse() { return self.before; }
}

class AppHistory<T> {
	private Vector<Vector<T>> frames = [];
	public void remember(Vector<T> values) { self.frames.push(values); }

	public Vector<T> take() { assert(self.frames.len > 0); return self.frames.pop(); }

	public int size() { return self.frames.len; }
}

class AppRequestHandler implements IWorkerRequestHandler {
	public string handle(string request) { return HTTPUrl.decode(request); }
}

void verifyPackages(int checksum) {
	TextRun text = TextRun("application benchmark", 14, 20);
	assert(text.fontSize() == 14 && text.lineHeight() == 20);
	AudioSampleRateRange rate = AudioSampleRateRange.exact(44100);
	assert(rate.contains(44100) && !rate.contains(48000));
	Image pixels = Image(4, 4);
	pixels.fill(RGBA(10, 20, 30));
	TextRasterization raster = TextRasterization(text);
	raster.complete(pixels);
	assert(raster.image().pixel(3, 3).green == 20);
	GPUValidationCompletion completion = GPUValidationCompletion();
	completion.invoke(WGPUPopErrorScopeStatus_Success, WGPUErrorType_NoError, "");
	assert(completion.delivered && completion.errorType == (int)WGPUErrorType_NoError);
	InlineWorkerPool pool = InlineWorkerPool(AppRequestHandler());
	assert(pool.send(0, HTTPUrl.encode("application benchmark")));
	WorkerReply reply = pool.awaitReply();
	assert(reply.kind == WorkerReplyKind.WORKER_REPLY_READY && reply.payload == text.text());
	assert(pool.close());
	HTTPResponse response = HTTPResponse(200, "text/plain", reply.payload);
	assert(response.bodyLength() == 21LL);
	FileRevisionBuilder revision = FileRevisionBuilder();
	revision.appendTerminatedText(reply.payload);
	FileRevision before = revision.revision();
	revision.appendU64((unsigned long long)checksum);
	assert(!before.equals(revision.revision()));
}

class AppProject {
	public string key;
	private int value;
	private Vector<int> samples;
	public AppProject(string key, int value) {
		self.key = key; self.value = value; self.samples = [value, value + 1, value + 2];
	}

	public int score() {
		assert(self.samples.len == 3 && self.samples.get(1) == self.value + 1);
		return self.value;
	}

	public AppProject revised(int delta) { return AppProject(self.key, self.value + delta); }
}

int exerciseProject() {
	AppIndex<AppProject> index = new AppIndex<AppProject>();
	AppHistory<AppProject> history = new AppHistory<AppProject>();
	for (int item = 0; item < 4; item++) {
		string key = f"item-{item}";
		index.put(key, AppProject(key, 0 + item));
	}
	assert(index.size() == 4);
	history.remember(index.snapshot());
	Result<AppProject, string> found = index.lookup("item-0");
	assert(found.isOk());
	AppProject original = found.unwrap();
	AppChange<AppProject> change = AppChange(original, original.revised(10));
	index.put("item-0", change.apply());
	assert(index.size() == 4 && change.reverse().score() == 0);
	history.remember(index.snapshot());
	Vector<AppProject> edited = history.take();
	int checksum = 0;
	for record in edited { checksum += record.score(); }
	Vector<AppProject> previous = history.take();
	assert(previous.get(0).score() == 0 && history.size() == 0);
	assert(checksum == 16);
	return checksum;
}

