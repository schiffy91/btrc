	AppIndex<AppWorkerLog> index = new AppIndex<AppWorkerLog>();
	AppHistory<AppWorkerLog> history = new AppHistory<AppWorkerLog>();
	for (int item = 0; item < 4; item++) {
		string key = f"item-{item}";
		index.put(key, AppWorkerLog(key, 6200 + item));
	}
	assert(index.size() == 4);
	history.remember(index.snapshot());
	Result<AppWorkerLog, string> found = index.lookup("item-0");
	assert(found.isOk());
	AppWorkerLog original = found.unwrap();
	AppChange<AppWorkerLog> change = AppChange(original, original.revised(10));
	index.put("item-0", change.apply());
	assert(index.size() == 4 && change.reverse().score() == 6200);
	history.remember(index.snapshot());
	Vector<AppWorkerLog> edited = history.take();
	int checksum = 0;
	for record in edited { checksum += record.score(); }
	Vector<AppWorkerLog> previous = history.take();
	assert(previous.get(0).score() == 6200 && history.size() == 0);
	assert(checksum == 24816);
	return checksum;
}

class AppWorkerCheckpoint {
	public string key;
	private int value;
	private Vector<int> samples;
	public AppWorkerCheckpoint(string key, int value) {
		self.key = key; self.value = value; self.samples = [value, value + 1, value + 2];
	}

	public int score() {
		assert(self.samples.len == 3 && self.samples.get(1) == self.value + 1);
		return self.value;
	}

	public AppWorkerCheckpoint revised(int delta) { return AppWorkerCheckpoint(self.key, self.value + delta); }
}

int exerciseWorkerCheckpoint() {
	AppIndex<AppWorkerCheckpoint> index = new AppIndex<AppWorkerCheckpoint>();
	AppHistory<AppWorkerCheckpoint> history = new AppHistory<AppWorkerCheckpoint>();
	for (int item = 0; item < 4; item++) {
		string key = f"item-{item}";
		index.put(key, AppWorkerCheckpoint(key, 6300 + item));
	}
	assert(index.size() == 4);
	history.remember(index.snapshot());
	Result<AppWorkerCheckpoint, string> found = index.lookup("item-0");
	assert(found.isOk());
	AppWorkerCheckpoint original = found.unwrap();
	AppChange<AppWorkerCheckpoint> change = AppChange(original, original.revised(10));
	index.put("item-0", change.apply());
	assert(index.size() == 4 && change.reverse().score() == 6300);
	history.remember(index.snapshot());
	Vector<AppWorkerCheckpoint> edited = history.take();
	int checksum = 0;
	for record in edited { checksum += record.score(); }
	Vector<AppWorkerCheckpoint> previous = history.take();
	assert(previous.get(0).score() == 6300 && history.size() == 0);
	assert(checksum == 25216);
	return checksum;
}

