import std.vector;

#include <assert.h>

// Simple (int-backed) enum used as a collection element type.
enum Color { RED, GREEN, BLUE };

int main() {
    Vector<Color> v = [RED, BLUE];
    assert(v[0] == RED);
    assert(v[1] == BLUE);
    v.push(GREEN);
    assert(v.size() == 3);
    assert(v[2] == GREEN);
    print("PASS: test_enum_in_collection");
    return 0;
}
