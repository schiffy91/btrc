#include <assert.h>

// Enum-typed value passed as a parameter and returned from a function.
enum Color { RED, GREEN, BLUE };

Color next(Color c) {
    if (c == BLUE) {
        return RED;
    }
    return c + 1;
}

int main() {
    assert(next(RED) == GREEN);
    assert(next(GREEN) == BLUE);
    assert(next(BLUE) == RED);
    print("PASS: test_enum_param_and_return");
    return 0;
}
