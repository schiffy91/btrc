// Nested for-in loops that reuse the SAME loop-variable name across nesting
// levels: the inner `for i in ...` shadows the outer `i`. After the inner loop
// ends, the outer `i` must be restored (not clobbered by the inner declaration).
// The for-in lowering emits index temps + a fresh loop-var per loop, so same-name
// nesting stresses scope/temp-name uniqueness.
#include <assert.h>

int main() {
    int total = 0;
    int outerSum = 0;
    for i in range(3) {           // outer i = 0, 1, 2
        for i in range(2) {       // inner i = 0, 1 (shadows outer)
            total += i;           // (0 + 1) per outer iter
        }
        total += 100;             // 100 per outer iter
        outerSum += i;            // outer i must be restored: 0 + 1 + 2
    }
    // inner contributes (0+1) * 3 = 3, plus 100 * 3 = 300 -> total 303
    assert(total == 303);
    // outer i visible/correct after each inner loop -> 0+1+2 = 3
    assert(outerSum == 3);

    print("PASS: test_forin_shadowed_loop_var");
    return 0;
}
