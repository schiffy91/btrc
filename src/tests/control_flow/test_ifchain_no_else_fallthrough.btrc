// if / else-if chain with NO final `else`, exercising the all-conditions-false
// fall-through path that no existing else-if chain test covers (they all end in
// a trailing `else`). Also confirms a chain whose LAST else-if matches still
// binds correctly without a trailing else.
#include <assert.h>

int main() {
    // ---- all conditions false, no else -> nothing executes ----
    int hits = 0;
    int x = 50;
    if (x < 0) {
        hits = 1;
    } else if (x < 10) {
        hits = 2;
    } else if (x < 20) {
        hits = 3;
    }
    assert(hits == 0);

    // ---- last else-if matches, no trailing else -> only it fires ----
    int branch = 0;
    int y = 15;
    if (y < 0) {
        branch = 5;
    } else if (y < 10) {
        branch = 6;
    } else if (y < 20) {
        branch = 7;   // only this one is true (10 <= 15 < 20)
    }
    assert(branch == 7);

    print("PASS: test_ifchain_no_else_fallthrough");
    return 0;
}
