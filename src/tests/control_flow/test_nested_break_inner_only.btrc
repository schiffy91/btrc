// btrc has no labeled break or goto statement, so `break` in nested loops only
// exits the innermost loop; the outer loop continues. Canonical test of that.
#include <assert.h>

int main() {
    // inner range loop breaks at j==1 on every outer iteration
    int count = 0;
    for i in range(3) {
        for j in range(3) {
            if (j == 1) {
                break; // exits inner loop only
            }
            count++; // only j==0 counted, once per outer iteration
        }
    }
    assert(count == 3);

    // breaking out of more than one loop requires a flag (no labeled break)
    int found_i = -1;
    int found_j = -1;
    bool done = false;
    for i in range(4) {
        for j in range(4) {
            if (i * 4 + j == 6) {
                found_i = i;
                found_j = j;
                done = true;
                break; // inner only
            }
        }
        if (done) {
            break; // outer, driven by the flag
        }
    }
    assert(found_i == 1);
    assert(found_j == 2);

    print("PASS: test_nested_break_inner_only");
    return 0;
}
