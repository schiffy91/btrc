/* Verifies that `finally` runs when control flow escapes a `try` or `catch`
 * block via `return` or `break`, including nested `try`/`finally` blocks and
 * managed return values whose lifetimes cross the `finally` body. */
#include <assert.h>

int finCount = 0;
int destroyedCount = 0;

class Resource {
	public int value;
	public Resource(int value) { self.value = value; }

	public void __del__() { destroyedCount = destroyedCount + 1; }
}

int returnsFromTry() {
	try {
		return 7;
	} finally {
		finCount = finCount + 1;
	}
}

int returnsFromCatch() {
	try {
		throw "boom";
	} catch (string err) {
		return 11;
	} finally {
		finCount = finCount + 10;
	}
}

Resource returnsManagedThroughFinally() {
	Resource outer = new Resource(40);
	try {
		Resource inner = new Resource(2);
		return outer;
	} finally {
		assert(outer.value == 40);
		finCount = finCount + 100;
	}
}

int overridesReturnInFinally() {
	try {
		Resource temp = new Resource(9);
		return temp.value;
	} finally {
		return 99;
	}
}

int main() {
	int r = returnsFromTry();
	assert(r == 7);
	assert(finCount == 1);

	int c = returnsFromCatch();
	assert(c == 11);
	assert(finCount == 11);

	{
		Resource kept = returnsManagedThroughFinally();
		assert(kept.value == 40);
		assert(finCount == 111);
		assert(destroyedCount == 1);
	}
	assert(destroyedCount == 2);

	assert(overridesReturnInFinally() == 99);
	assert(destroyedCount == 3);

	// break out of a try inside a loop: the breaking iteration runs finally too.
	int total = 0;
	int loopFin = 0;
	for (int i = 0; i < 10; i = i + 1) {
		try {
			if (i == 5) { break; }
			total = total + i;      // 0+1+2+3+4 = 10
		} finally {
			loopFin = loopFin + 1;  // runs for i=0..4 and the i==5 break
		}
	}
	assert(total == 10);
	assert(loopFin == 6);

	print("PASS: test_exceptions_finally_control_flow_escape");
	return 0;
}
