/* Verifies that `continue` out of a try-with-finally inside a loop runs the
 * `finally` body before advancing to the next loop iteration, including nested
 * `try`/`finally` regions. */
#include <assert.h>

int main() {
	int finCount = 0;
	int outerFinCount = 0;
	int body = 0;
	for (int i = 0; i < 6; i = i + 1) {
		try {
			try {
				if (i % 2 == 0) { continue; }
				body = body + 1;
			} finally {
				finCount = finCount + 1;
			}
		} finally {
			outerFinCount = outerFinCount + 1;
		}
	}
	assert(finCount == 6);
	assert(outerFinCount == 6);
	assert(body == 3);

	print("PASS: test_exceptions_finally_continue_escape");
	return 0;
}
