// Switch intentional fall-through: a non-empty case body with NO break
// falls through into the next case (C semantics, no auto-break).
#include <assert.h>

int run(int x) {
    int a = 0;
    switch (x) {
        case 1:
            a += 1;
            // intentional fall-through into case 2
        case 2:
            a += 10;
            break;
        case 3:
            a += 100;
    }
    return a;
}

int main() {
    // x==1 falls through 1 -> 2: 1 + 10
    assert(run(1) == 11);
    // x==2 enters at case 2 only: 10
    assert(run(2) == 10);
    // x==3 is the last clause, no break needed: 100
    assert(run(3) == 100);
    // unmatched value does nothing
    assert(run(9) == 0);

    print("PASS: test_switch_fallthrough");
    return 0;
}
