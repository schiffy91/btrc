#include <assert.h>

int main() {
	// if/else basic branching
	int x = 10;
	int result = 0;
	if (x > 5) {
		result = 1;
	} else {
		result = 0;
	}
	assert(result == 1);

	// if/else if/else chain
	int grade = 85;
	int level = 0;
	if (grade >= 90) {
		level = 3;
	} else if (grade >= 80) {
		level = 2;
	} else if (grade >= 70) {
		level = 1;
	} else {
		level = 0;
	}
	assert(level == 2);

	// while loop: sum 1..10
	int sum = 0;
	int i = 1;
	while (i <= 10) {
		sum += i;
		i++;
	}
	assert(sum == 55);

	// C-style for loop: factorial of 5
	int fact = 1;
	for (int j = 1; j <= 5; j++) {
		fact *= j;
	}
	assert(fact == 120);

	// for-in with range(n): sum of 0..4
	int rangeSum = 0;
	for k in range(5) { rangeSum += k; }
	assert(rangeSum == 10);

	// for-in with range(start, end): sum of 2..7
	int rangeSum2 = 0;
	for k in range(2, 8) { rangeSum2 += k; }
	assert(rangeSum2 == 27);

	// for-in with range(start, end, step): count even numbers 0,2,4,6,8
	int count = 0;
	for k in range(0, 10, 2) { count++; }
	assert(count == 5);

	// ternary operator
	int val = 8;
	int ternaryResult = val > 5 ? 100 : 0;
	assert(ternaryResult == 100);

	int val2 = 3;
	int ternaryResult2 = val2 > 5 ? 100 : 0;
	assert(ternaryResult2 == 0);

	// switch/case
	int day = 3;
	int dayType = 0;
	switch (day) {
		case 1: case 2: case 3: case 4: case 5: dayType = 1;
		break;
		case 6: case 7: dayType = 2;
		break;
		default: dayType = 0;
		break;
	}
	assert(dayType == 1);

	// break in while loop
	int breakVal = 0;
	int counter = 0;
	while (true) {
		counter++;
		if (counter == 5) {
			breakVal = counter;
			break;
		}
	}
	assert(breakVal == 5);

	// continue in for loop
	int skipSum = 0;
	for (int n = 0; n < 10; n++) {
		if (n % 2 == 0) {
			continue;
		}
		skipSum += n;
	}
	assert(skipSum == 25);

	print("PASS: test_control_flow");
	return 0;
}
