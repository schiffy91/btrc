/* break/continue run a surrounding finally once and pop that try frame so a
 * later throw after the loop or switch never re-enters the completed frame. */
#include <assert.h>

int main() {
	int breakFinally = 0;
	string breakCaught = "";
	try {
		for i in range(1) {
			try {
				break;
			} finally {
				breakFinally++;
			}
		}
		assert(breakFinally == 1);
		throw "after-break";
	} catch (string message) {
		breakCaught = message;
	}
	assert(breakFinally == 1);
	assert(breakCaught.equals("after-break"));

	int continueFinally = 0;
	string continueCaught = "";
	try {
		for i in range(1) {
			try {
				continue;
			} finally {
				continueFinally++;
			}
		}
		assert(continueFinally == 1);
		throw "after-continue";
	} catch (string message) {
		continueCaught = message;
	}
	assert(continueFinally == 1);
	assert(continueCaught.equals("after-continue"));

	int switchFinally = 0;
	string switchCaught = "";
	try {
		switch (1) {
			case 1:
				try {
					break;
				} finally {
					switchFinally++;
				}
			default: break;
		}
		assert(switchFinally == 1);
		throw "after-switch";
	} catch (string message) {
		switchCaught = message;
	}
	assert(switchFinally == 1);
	assert(switchCaught.equals("after-switch"));

	print("PASS: test_exceptions_control_escape_frame_cleanup");
	return 0;
}
