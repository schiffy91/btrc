/* try/catch/throw inside a `while` loop and a `do-while` loop body, verifying the
 * per-iteration try-stack push/pop on the non-C-for loop forms. The corpus only
 * ever puts a complete try/catch inside a C-style `for` loop
 * (test_exceptions_try_in_loop); the while and do-while loop bodies are a distinct
 * lowering path for the per-iteration try-stack and are exercised here. */
#include <assert.h>

int main() {
    // while loop: throw on a subset of iterations, caught each time, loop runs
    // to completion with exact caught/passed counts (try-stack does not drift).
    int caught = 0;
    int passed = 0;
    int i = 0;
    while (i < 20) {
        try {
            if (i % 4 == 0) { throw f"mod4:{i}"; }
            passed = passed + 1;
        } catch (string e) {
            caught = caught + 1;
            assert(e.startsWith("mod4:"));
        }
        i = i + 1;
    }
    // i % 4 == 0 for i in 0..19 -> 0,4,8,12,16 = 5 thrown; rest pass.
    assert(caught == 5);
    assert(passed == 15);
    assert(caught + passed == 20);

    // do-while loop: the body runs at least once; a single throw on j==2 is
    // caught, and the loop continues to completion.
    int doCaught = 0;
    int doBody = 0;
    int j = 0;
    do {
        try {
            if (j == 2) { throw "boom"; }
            doBody = doBody + 1;
        } catch (string e) {
            doCaught = doCaught + 1;
            assert(e.equals("boom"));
        }
        j = j + 1;
    } while (j < 5);
    assert(doCaught == 1);      // exactly one throw caught (j==2)
    assert(doBody == 4);        // j=0,1,3,4 reach the body increment
    assert(j == 5);             // loop ran to completion

    print("PASS: test_exceptions_try_in_while_loop");
    return 0;
}
