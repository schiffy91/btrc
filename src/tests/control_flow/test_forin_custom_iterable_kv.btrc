// Two-variable for-in (for k, v in obj) over a USER-DEFINED class that
// implements the Iterable protocol with iterLen + iterGet + iterValueAt and
// two generic params. Every other two-variable for-in test iterates the
// built-in Map; the user-defined iterValueAt lowering path (analyzer binds
// generic_args[0] -> key var, generic_args[1] -> value var; IR gen emits the
// {mangled}_iterValueAt call for the second loop variable) is otherwise
// untested. Also exercises break and continue over that path.
#include <assert.h>

class Pairs<K, V> implements Iterable {
    private Vector<K> keys;
    private Vector<V> vals;

    public Pairs() {
        self.keys = [];
        self.vals = [];
    }

    public void add(K k, V v) {
        self.keys.push(k);
        self.vals.push(v);
    }

    public int iterLen() {
        return self.keys.size();
    }

    public K iterGet(int i) {
        return self.keys.get(i);
    }

    public V iterValueAt(int i) {
        return self.vals.get(i);
    }
}

int main() {
    Pairs<string, int> p = Pairs();
    p.add("a", 1);
    p.add("b", 2);
    p.add("c", 3);

    // Plain two-variable iteration: key binds via iterGet, value via iterValueAt.
    int sum = 0;
    string concat = "";
    for k, v in p {
        concat += k;
        sum += v;
    }
    assert(sum == 6);                       // 1 + 2 + 3
    assert(strcmp(concat, "abc") == 0);     // visited in insertion order

    // break binds correctly over the user-defined iterValueAt path:
    // stop as soon as the value reaches 2.
    int seen = 0;
    string before = "";
    for k, v in p {
        if (v == 2) {
            break;
        }
        before += k;
        seen += 1;
    }
    assert(seen == 1);                      // only the "a"/1 entry processed
    assert(strcmp(before, "a") == 0);

    // continue binds correctly: skip even values, accumulate the rest.
    int oddSum = 0;
    string oddKeys = "";
    for k, v in p {
        if (v % 2 == 0) {
            continue;
        }
        oddSum += v;
        oddKeys += k;
    }
    assert(oddSum == 4);                    // 1 + 3
    assert(strcmp(oddKeys, "ac") == 0);     // "b"/2 skipped

    print("PASS: test_forin_custom_iterable_kv");
    return 0;
}
