// for-in over a user-defined class implementing the Iterable protocol
// (iterLen + iterGet). All other for-in tests use built-in collections; the
// custom-class iterable path is never exercised in the control-flow suite.
import std.Iterable;
import std.Vector;

#include <assert.h>

class Squares<T> implements Iterable {
	private Vector<T> data;

	public Squares(Vector<T> data) { self.data = data; }

	public int iterLen() { return self.data.size(); }

	public T iterGet(int i) { return self.data.get(i); }
}

int main() {
	Vector<int> values = [0, 1, 4, 9];
	Squares<int> sq = Squares(values);

	// plain accumulation over the custom iterable
	int sum = 0;
	for v in sq {
		sum += v;
	}
	assert(sum == 14); // 0 + 1 + 4 + 9

	// break works over a custom iterable
	int count = 0;
	for v in sq {
		if (v == 4) {
			break;
		}
		count++;
	}
	assert(count == 2); // 0 and 1 before 4

	// continue works over a custom iterable
	int oddlike = 0;
	for v in sq {
		if (v % 2 == 0) {
			continue;
		}
		oddlike += v;
	}
	assert(oddlike == 10); // 1 + 9

	print("PASS: test_forin_custom_iterable");
	return 0;
}
