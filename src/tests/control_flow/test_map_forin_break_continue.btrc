// for-in over Map<K,V> two-variable (k, v) with break and continue inside.
// continue skips an entry; break stops iteration mid-map. kv iteration is
// tested elsewhere but never combined with loop control.
#include <assert.h>

int main() {
    Map<string, int> m = {};
    m.put("a", 1);
    m.put("b", 0);
    m.put("c", 3);
    m.put("d", 5);

    // continue: skip entries whose value is 0
    int sum = 0;
    for k, v in m {
        if (v == 0) {
            continue;
        }
        sum += v;
    }
    assert(sum == 9); // 1 + 3 + 5

    // break: stop accumulating once the running total passes a threshold.
    // Order over the map is implementation-defined, so assert a bound that holds
    // regardless of traversal order: the total is at least the first counted
    // value and never exceeds the full sum.
    int running = 0;
    int counted = 0;
    for k, v in m {
        running += v;
        counted++;
        if (running >= 4) {
            break;
        }
    }
    assert(running >= 4);
    assert(counted >= 1);
    assert(counted <= 4);

    m.free();

    print("PASS: test_map_forin_break_continue");
    return 0;
}
