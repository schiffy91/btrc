// range() degenerate/empty cases with the positive default step:
// range(0), range(5,5), and range(5,2) (start >= stop) must iterate zero times.
#include <assert.h>

int main() {
    int n = 0;

    // range(0): empty
    for i in range(0) {
        n++;
    }
    assert(n == 0);

    // range(5, 5): start == stop, empty
    for i in range(5, 5) {
        n++;
    }
    assert(n == 0);

    // range(5, 2): start > stop with default +1 step, empty
    for i in range(5, 2) {
        n++;
    }
    assert(n == 0);

    // a non-empty range still runs after the empty ones (loop state not poisoned)
    for i in range(3) {
        n++;
    }
    assert(n == 3);

    print("PASS: test_range_empty");
    return 0;
}
