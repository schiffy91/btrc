/* A full try/catch INSIDE a loop body where the throw happens on some iterations
 * and is caught each time, so the loop keeps going. Verifies the try-stack is
 * pushed/popped per iteration without drift over many iterations and that the
 * accumulated counts are exact. No corpus test puts a complete try/catch (not just
 * a bare throw) inside a loop with per-iteration throws. */
#include <assert.h>

int main() {
	int caught = 0;
	int passed = 0;
	for (int i = 0; i < 100; i = i + 1) {
		try {
			if (i % 3 == 0) { throw f"div3:{i}"; }
			passed = passed + 1;
		} catch (string e) {
			caught = caught + 1;
			assert(e.startsWith("div3:"));
		}
	}
	// i % 3 == 0 for i in 0..99 -> 0,3,...,99 = 34 values thrown; rest pass.
	assert(caught == 34);
	assert(passed == 66);
	assert(caught + passed == 100);

	print("PASS: test_exceptions_try_in_loop");
	return 0;
}
