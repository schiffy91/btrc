#include <assert.h>
#include <limits.h>
#include <stddef.h>
#include <unistd.h>

int sequenceStep = 0;
int signedReads = 0;
int unsignedReads = 0;
int pointerReads = 0;
int ordinaryReads = 0;
int arithmeticReads = 0;
int bitwiseReads = 0;
int offsetReads = 0;
int adversarialReads = 0;
int explicitReads = 0;
int callReads = 0;
int literalReads = 0;
int dependentReads = 0;
int pointerTarget = 17;
int pointerValues[3] = {11, 22, 33};
long long dependentValue = 5LL;

class ChildProcessClock {
    class long long deadline(long long now, int timeoutMilliseconds) {
        long long duration = (long long)timeoutMilliseconds;
        return duration > (long long)LLONG_MAX - now
            ? LLONG_MAX : now + duration;
    }
}

long long signedLeft() {
    assert(sequenceStep == 0);
    sequenceStep = 1;
    return LLONG_MAX;
}

long long signedOpaqueValue() {
    assert(sequenceStep == 1);
    sequenceStep = 2;
    signedReads++;
    return LLONG_MAX;
}

unsigned long long unsignedOpaqueValue() {
    assert(sequenceStep == 0);
    sequenceStep = 1;
    unsignedReads++;
    return ULLONG_MAX;
}

unsigned long long unsignedRight() {
    assert(sequenceStep == 1);
    sequenceStep = 2;
    return ULLONG_MAX;
}

int* pointerLeft() {
    assert(sequenceStep == 0);
    sequenceStep = 1;
    return &pointerTarget;
}

int* pointerOpaqueValue() {
    assert(sequenceStep == 1);
    sequenceStep = 2;
    pointerReads++;
    return &pointerTarget;
}

int ordinaryLeft() {
    assert(sequenceStep == 0);
    sequenceStep = 1;
    ordinaryReads++;
    return 4;
}

int ordinaryRight() {
    assert(sequenceStep == 1);
    sequenceStep = 2;
    ordinaryReads++;
    return 5;
}

long long arithmeticLeft() {
    assert(sequenceStep == 0);
    sequenceStep = 1;
    arithmeticReads++;
    return LLONG_MAX - 3LL;
}

long long arithmeticOpaqueValue() {
    assert(sequenceStep == 1);
    sequenceStep = 2;
    arithmeticReads++;
    return 3LL;
}

unsigned int bitwiseLeft() {
    assert(sequenceStep == 0);
    sequenceStep = 1;
    bitwiseReads++;
    return 0x10U;
}

unsigned int bitwiseOpaqueValue() {
    assert(sequenceStep == 1);
    sequenceStep = 2;
    bitwiseReads++;
    return 0x03U;
}

int* pointerBase() {
    assert(sequenceStep == 0);
    sequenceStep = 1;
    offsetReads++;
    return pointerValues;
}

ptrdiff_t pointerOpaqueOffset() {
    assert(sequenceStep == 1);
    sequenceStep = 2;
    offsetReads++;
    return (ptrdiff_t)1;
}

int adversarialZero() {
    assert(sequenceStep == 0);
    sequenceStep = 1;
    adversarialReads++;
    return 0;
}

long long adversarialOpaqueWide() {
    assert(sequenceStep == 1);
    sequenceStep = 2;
    adversarialReads++;
    return LLONG_MAX;
}

unsigned long long explicitOpaqueWide() {
    assert(sequenceStep == 0);
    sequenceStep = 1;
    explicitReads++;
    return ULLONG_MAX;
}

unsigned long long explicitRight() {
    assert(sequenceStep == 1);
    sequenceStep = 2;
    explicitReads++;
    return ULLONG_MAX;
}

string callOwnedText() {
    assert(sequenceStep == 0);
    sequenceStep = 1;
    callReads++;
    return "opaque call\n";
}

FILE* callOpaqueStream() {
    assert(sequenceStep == 1);
    sequenceStep = 2;
    callReads++;
    return stdout;
}

long long literalOpaqueWide() {
    literalReads++;
    return 5000000000LL;
}

long long dependentOpaqueValue() {
    dependentReads++;
    dependentValue = 9LL;
    return 5LL;
}

#define OPAQUE_SIGNED_VALUE signedOpaqueValue()
#define OPAQUE_UNSIGNED_VALUE unsignedOpaqueValue()
#define OPAQUE_POINTER_VALUE pointerOpaqueValue()
#define OPAQUE_WIDE_ADDEND arithmeticOpaqueValue()
#define OPAQUE_FLAGS bitwiseOpaqueValue()
#define OPAQUE_POINTER_OFFSET pointerOpaqueOffset()
#define OPAQUE_ADVERSARIAL_WIDE adversarialOpaqueWide()
#define OPAQUE_EXPLICIT_WIDE explicitOpaqueWide()
#define OPAQUE_STREAM callOpaqueStream()
#define OPAQUE_LITERAL_WIDE literalOpaqueWide()
#define OPAQUE_DEPENDENT_VALUE dependentOpaqueValue()

int main() {
    assert(access("/", F_OK) == 0);
    char workingDirectory[4096];
    while ((char*)getcwd(
            workingDirectory, (size_t)sizeof(workingDirectory)) == NULL) {
        assert(0);
    }
    assert(ChildProcessClock.deadline(LLONG_MAX - 2LL, 10) == LLONG_MAX);

    sequenceStep = 0;
    assert(signedLeft() == OPAQUE_SIGNED_VALUE);
    assert(sequenceStep == 2 && signedReads == 1);

    sequenceStep = 0;
    assert(((unsigned long long)OPAQUE_UNSIGNED_VALUE) == unsignedRight());
    assert(sequenceStep == 2 && unsignedReads == 1);

    sequenceStep = 0;
    assert(pointerLeft() == OPAQUE_POINTER_VALUE);
    assert(sequenceStep == 2 && pointerReads == 1);

    sequenceStep = 0;
    assert(ordinaryLeft() < ordinaryRight());
    assert(sequenceStep == 2 && ordinaryReads == 2);

    sequenceStep = 0;
    assert(arithmeticLeft() + OPAQUE_WIDE_ADDEND == LLONG_MAX);
    assert(sequenceStep == 2 && arithmeticReads == 2);

    sequenceStep = 0;
    assert((bitwiseLeft() | OPAQUE_FLAGS) == 0x13U);
    assert(sequenceStep == 2 && bitwiseReads == 2);

    sequenceStep = 0;
    assert(*(pointerBase() + OPAQUE_POINTER_OFFSET) == 22);
    assert(sequenceStep == 2 && offsetReads == 2);

    sequenceStep = 0;
    assert(adversarialZero() < OPAQUE_ADVERSARIAL_WIDE);
    assert(sequenceStep == 2 && adversarialReads == 2);

    sequenceStep = 0;
    assert(((unsigned long long)OPAQUE_EXPLICIT_WIDE) == explicitRight());
    assert(sequenceStep == 2 && explicitReads == 2);

    sequenceStep = 0;
    assert(fputs(callOwnedText(), OPAQUE_STREAM) >= 0);
    assert(sequenceStep == 2 && callReads == 2);

    assert(OPAQUE_LITERAL_WIDE == (long long)5000000000LL);
    assert(literalReads == 1);

    dependentValue = 5LL;
    assert(dependentValue == OPAQUE_DEPENDENT_VALUE);
    assert(dependentValue == 9LL && dependentReads == 1);
    return 0;
}
