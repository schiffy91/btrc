import std.set;

#include <assert.h>

int destroyed = 0;
int firstCalls = 0;
int secondCalls = 0;
int thirdCalls = 0;

class SetDrop {
    public int id;

    public SetDrop(int id) { self.id = id; }

    public void __del__() {
        destroyed++;
        if (self.id == 1) { firstCalls++; }
        if (self.id == 2) {
            secondCalls++;
            throw "set-failure";
        }
        if (self.id == 3) { thirdCalls++; }
    }
}

int main() {
    {
        Set<SetDrop> values = {};
        values.add(new SetDrop(1));
        values.add(new SetDrop(2));
        values.add(new SetDrop(3));

        bool caughtFailure = false;
        try {
            values.free();
        } catch (string error) {
            caughtFailure = error.equals("set-failure");
        }

        assert(caughtFailure);
        assert(values.keys == null);
        assert(values.occupied == null);
        assert(values.len == 0 && values.cap == 0);
        assert(destroyed == 3);
        assert(firstCalls == 1 && secondCalls == 1 && thirdCalls == 1);

        values.free();
        assert(destroyed == 3);
    }

    assert(destroyed == 3);
    assert(firstCalls == 1 && secondCalls == 1 && thirdCalls == 1);
    return 0;
}
