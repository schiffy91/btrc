/* Drives btrc's FePackageTarget for test_target_contract.py.
 * `parse SPELLING...` prints one line per spelling: "ok LABEL OS ARCH ENV"
 * (ENV "-" when empty) or "error MESSAGE". `host PLATFORM ARCHITECTURE...`
 * takes code pairs of the host seam and prints the label each selects, or
 * "none". `labels` prints the canonical labels, one per line. */

import Library.Console;
import Library.Strings;
import Library.Vector;

import ../../../compiler/btrc/frontend/Packages.btrc;

class TargetContractDriver {
	public string parsed(string spelling) {
		try {
			FePackageTarget target = FePackageTarget.parse(spelling);
			string environment = target.environment.isEmpty() ? "-" : target.environment;
			return f"ok {target.label()} {target.operatingSystem} {target.architecture} {environment}";
		} catch (string error) {
			return "error " + error;
		}
		return "";
	}

	public string host(int platform, int architecture) {
		FePackageTarget target = FePackageTarget.hostFrom(platform, architecture);
		return target.known() ? target.label() : "none";
	}
}

int main(int argc, char** argv) {
	if (argc < 2) { return 2; }
	TargetContractDriver driver = TargetContractDriver();
	string mode = Strings.copy(argv[1]);
	if (mode.equals("labels")) {
		for label in FePackageTarget.labels() { Console.log(label); }
		return 0;
	}
	if (mode.equals("parse")) {
		for (int index = 2; index < argc; index++) { Console.log(driver.parsed(Strings.copy(argv[index]))); }
		return 0;
	}
	if (mode.equals("host")) {
		for (int index = 2; index + 1 < argc; index += 2) { Console.log(driver.host(Strings.toInt(Strings.copy(argv[index])), Strings.toInt(Strings.copy(argv[index + 1])))); }
		return 0;
	}
	return 2;
}
