#include "../../../compiler/btrc/runtime_paths.btrc"

int main(int argc, char** argv) {
    BtrccDataPaths paths = BtrccRuntimePaths.resolve(
        argc > 0 ? Strings.copy(argv[0]) : "");
    if (!paths.valid) {
        fprintf(stderr, "%s\n", paths.diagnostic);
        return 2;
    }
    print(paths.root);
    print(paths.grammar);
    print(paths.stdlib);
    return 0;
}
