#include <assert.h>

extern void arc_test_allocation_checkpoint();
extern long arc_test_allocation_delta();

int throwingMutexAlive = 0;
int throwingMutexDestroyed = 0;
bool throwFromMutexCycle = false;

class ThrowingMutexCycleNode {
	public ThrowingMutexCycleNode next;

	public ThrowingMutexCycleNode() {
		self.next = null;
		throwingMutexAlive++;
	}

	public void __del__() {
		throwingMutexAlive--;
		throwingMutexDestroyed++;
		if (throwFromMutexCycle) {
			throw "mutex cycle hook failure";
		}
	}
}

ThrowingMutexCycleNode makeThrowingMutexCycle() {
	ThrowingMutexCycleNode first = new ThrowingMutexCycleNode();
	ThrowingMutexCycleNode second = new ThrowingMutexCycleNode();
	first.next = second;
	second.next = first;
	return first;
}

void warmMutexBoundary() {
	try {
		ThrowingMutexCycleNode root = makeThrowingMutexCycle();
		Mutex<ThrowingMutexCycleNode> owner = Mutex(root);
		release root;
		owner.destroy();
	} catch (string error) {
		assert(false);
	}
}

int main() {
	warmMutexBoundary();
	assert(throwingMutexAlive == 0);
	assert(throwingMutexDestroyed == 2);

	bool caught = false;
	try {
		throwFromMutexCycle = true;
		arc_test_allocation_checkpoint();
		ThrowingMutexCycleNode root = makeThrowingMutexCycle();
		Mutex<ThrowingMutexCycleNode> owner = Mutex(root);
		release root;
		owner.destroy();
		assert(false);
	} catch (string error) {
		caught = error.equals("mutex cycle hook failure");
	}

	assert(caught);
	assert(throwingMutexAlive == 0);
	assert(throwingMutexDestroyed == 4);
	/* Final destruction may rethrow only after freeing the boxed value,
     * copied type context, and mutex handle. */
	assert(arc_test_allocation_delta() == 0);
	return 0;
}
