import Library.IO;
import Library.Map;
import Library.Strings;
import Library.Vector;

import ../../../compiler/btrc/generated/hosted_abi/Tables.btrc;
import ../../../compiler/btrc/syntax/Grammar.btrc;
import ../../../compiler/btrc/frontend/Models.btrc;
import ../../../compiler/btrc/frontend/Resolver.btrc;
#include <assert.h>

class RememberedDirectives implements FeDirectiveCache {
	public int loads = 0;
	public int stores = 0;
	public Vector<FeDirectiveRange>? ranges = null;
	private string source = "";
	private string grammar = "";

	public Vector<FeDirectiveRange>? load(string source, string grammar) {
		self.loads++;
		if (!self.source.equals(source) || !self.grammar.equals(grammar)) { return null; }
		return self.ranges;
	}

	public void store(string source, string grammar, Vector<FeDirectiveRange> ranges) {
		self.stores++;
		self.source = source;
		self.grammar = grammar;
		self.ranges = ranges;
	}
}

/* Every stored scan, keyed by the scanned (conditioned) text. */
class KeyedDirectives implements FeDirectiveCache {
	public int hits = 0;
	public Map<string, Vector<FeDirectiveRange>> entries = {};

	public Vector<FeDirectiveRange>? load(string source, string grammar) {
		if (!self.entries.has(source)) { return null; }
		self.hits++;
		return self.entries.get(source);
	}

	public void store(string source, string grammar, Vector<FeDirectiveRange> ranges) { self.entries.put(source, ranges); }
}

string conditioned(GrammarInfo grammar, string source, string operatingSystem) {
	GeneratedHostedAbiData data = GeneratedHostedAbiData();
	Map<string, bool> hosted = {};
	for name in data.ownedNames() { hosted.put(name, true); }
	Map<string, string> defines = {};
	var environment = FeConditionalEnvironment(operatingSystem, "x86_64", "gnu", FeConditionalEnvironment.macroRulesFor(grammar.vocabulary, hosted, data), data, defines);
	return FeSourceConditionals(environment, grammar).condition(source, "/t/Input.btrc").text;
}

void printDirectives(string label, Vector<FeDirective> directives) {
	for item in directives { print(f"{label}:{item.kind}:{item.start}:{item.end}:{item.payload}"); }
}

/* The cache scans conditioned text: one raw text under two targets gives
 * two entries, and a restore brings back only that target's imports. */
int conditionedMode(GrammarInfo grammar, string source) {
	var cache = KeyedDirectives();
	var scanner = FeDirectiveScanner(grammar, cache);
	string linux = conditioned(grammar, source, "linux");
	string windows = conditioned(grammar, source, "windows");
	var linuxCold = scanner.scan(linux);
	var windowsCold = scanner.scan(windows);
	assert(cache.entries.len == 2 && cache.hits == 0);
	var linuxWarm = scanner.scan(linux);
	var windowsWarm = scanner.scan(windows);
	assert(cache.hits == 2);
	assert(linuxWarm.len == linuxCold.len && windowsWarm.len == windowsCold.len);
	printDirectives("linux", linuxWarm);
	printDirectives("windows", windowsWarm);
	print(f"entries={cache.entries.len} hits={cache.hits}");
	return 0;
}

int main(int argc, char** argv) {
	if (argc != 4) { return 2; }
	var grammar = EbnfGrammarParser(Path.readAll(Strings.copy(argv[1]))).parse();
	string source = Path.readAll(Strings.copy(argv[2]));
	string mode = Strings.copy(argv[3]);
	if (mode.equals("conditioned")) { return conditionedMode(grammar, source); }
	var cache = RememberedDirectives();
	var scanner = FeDirectiveScanner(grammar, cache);
	var first = scanner.scan(source);
	if (mode.equals("malformed")) {
		assert(cache.stores == 0);
		scanner.scan(source);
		assert(cache.stores == 0);
		print("uncached lexical failure");
		return 0;
	}
	assert(cache.stores == 1);
	if (mode.equals("grammar")) {
		grammar.vocabulary.addKeyword("unusedKeyword", "UNUSED");
	} else if (mode.equals("grammar-keyword-replace")) {
		grammar.vocabulary.addKeyword("return", "CHANGED");
	} else if (mode.equals("grammar-operator")) {
		grammar.vocabulary.addOperator("~~", "UNUSED");
	} else if (mode.equals("grammar-operator-replace")) {
		grammar.vocabulary.addOperator("+", "CHANGED");
	} else if (mode.equals("grammar-annotation")) {
		grammar.vocabulary.addAnnotation("unusedAnnotation", "UNUSED");
	} else if (mode.equals("bad-range")) {
		Vector<FeDirectiveRange> invalid = [FeDirectiveRange(0, 1)];
		cache.ranges = invalid;
	} else if (mode.equals("bad-fragment")) {
		/* Line two is an invalid import inside a multiline comment. A
		 * speculative fragment must miss rather than terminate the process. */
		Vector<FeDirectiveRange> invalid = [FeDirectiveRange(2, 2)];
		cache.ranges = invalid;
	}
	var second = scanner.scan(source);
	assert(first.len == second.len);
	for (int index = 0; index < second.len; index++) {
		var item = second.get(index);
		assert(first.get(index).kind.equals(item.kind));
		assert(first.get(index).payload.equals(item.payload));
		assert(first.get(index).start == item.start);
		assert(first.get(index).end == item.end);
		print(f"{item.kind}:{item.start}:{item.end}:{item.payload}");
	}
	if (mode.equals("warm")) { assert(cache.stores == 1); }
	else { assert(cache.stores == 2); }
	assert(cache.loads == 2);
	print(f"loads={cache.loads} stores={cache.stores}");
	return 0;
}
