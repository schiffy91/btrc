import std.RealtimeAudio;

#include <assert.h>

struct GainContext {
	float gain;
	float total;
	int calls;
	unsigned long long inputDeviceFrame;
	unsigned long long outputDeviceFrame;
	unsigned long long streamEpoch;
	unsigned long long hostTimeNanoseconds;
	uint flags;
};

@realtime void applyGain(void* raw, struct AudioBlockView block, Span<const float> inputs, Span<float> outputs) {
	GainContext* context = (GainContext*)raw;
	if (context == null || !inputs.isValid() || !outputs.isValid() || block.inputChannelCount != 1 || block.outputChannelCount != 0 || !outputs.isEmpty()) {
		return;
	}
	int frameCount = block.frameCount;
	for (int frame = 0; frame < frameCount; frame++) {
		float sample = 0.0f;
		if (inputs.tryGet((size_t)frame, &sample)) { context->total += sample * context->gain; }
	}
	context->calls++;
	context->inputDeviceFrame = block.inputDeviceFrame;
	context->outputDeviceFrame = block.outputDeviceFrame;
	context->streamEpoch = block.streamEpoch;
	context->hostTimeNanoseconds = block.hostTimeNanoseconds;
	context->flags = block.flags;
}

int main() {
	const float inputSamples[3] = {1.0f, -2.0f, 0.5f};
	GainContext context = {2.0f, 0.0f, 0, 0ULL, 0ULL, 0ULL, 0ULL, 0u};

	RealtimeAudioProgram program = RealtimeAudioProgram(applyGain, &context);
	RealtimeAudioProcess invoke = program.invokePointer();
	struct AudioBlockView block = {1, 0, 3, 41ULL, 73ULL, 5ULL, 9001ULL, (uint)(AUDIO_BLOCK_INPUT_DISCONTINUITY | AUDIO_BLOCK_OUTPUT_DISCONTINUITY)};
	invoke(program.context(), block, Span(inputSamples), Span((float*)null, (size_t)0));

	assert(context.calls == 1);
	assert(context.total == -1.0f);
	assert(context.inputDeviceFrame == 41ULL && context.outputDeviceFrame == 73ULL);
	assert(context.streamEpoch == 5ULL && context.hostTimeNanoseconds == 9001ULL);
	assert((context.flags & (uint)AUDIO_BLOCK_INPUT_DISCONTINUITY) != 0u);
	assert((context.flags & (uint)AUDIO_BLOCK_OUTPUT_DISCONTINUITY) != 0u);
	print("PASS RealtimeAudioProgram");
	return 0;
}
