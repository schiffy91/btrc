import std.io;
import std.vector;

#include "../../../compiler/btrc/syntax/tokens.btrc"
#include "../../../compiler/btrc/syntax/grammar.btrc"
#include "../../../compiler/btrc/lexer/lexer.btrc"
#include <assert.h>

int main() {
	string grammarText = Path.readAll("src/language/grammar.ebnf");
	GrammarInfo grammar = EbnfGrammarParser(grammarText).parse();
	Lexer lexer = Lexer("int value = 1;", grammar);

	Vector<Token> first = lexer.tokenize();
	Vector<Token> second = lexer.tokenize();

	assert(first.len == 6);
	assert(second.len == 6);
	assert(second.get(5).type.equals("EOF"));
	print("PASS: lexer reuse is idempotent");
	return 0;
}
