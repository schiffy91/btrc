import std.map;
import std.strings;
import std.vector;

#include "../../../compiler/btrc/cleanup_ir.btrc"

const int IRK_VAR_DECL = 1;
const int IRK_CALL = 2;
const int IRK_CAST = 3;
const int IRK_ADDRESS_OF = 4;
const int IRK_VAR = 5;
const int IRK_EXPR_STMT = 6;
const int IRK_BLOCK = 7;
const int IRK_FUNCTION_REF = 8;

class IRParam {
    public string c_type;
    public string name;

    public IRParam(string cType, string name) {
        self.c_type = cType;
        self.name = name;
    }
}

class IRNode {
    public int kind;
    public string name;
    public string c_type;
    public string callee;
    public string helper_ref;
    public string target_type;
    public string text;
    public bool is_static;
    public bool is_extern;
    public bool is_array_decl;
    public bool is_volatile;
    public IRCleanupSlot cleanup_slot;
    public IRNode left;
    public IRNode right;
    public IRNode operand;
    public IRNode expr;
    public IRNode obj;
    public IRNode index;
    public IRNode condition;
    public IRNode true_expr;
    public IRNode false_expr;
    public IRNode array_size;
    public IRNode init;
    public IRNode value;
    public IRNode target;
    public IRNode then_block;
    public IRNode else_block;
    public IRNode body;
    public IRNode update;
    public IRNode result;
    public Vector<IRNode> args;
    public Vector<IRNode> stmts;

    public IRNode() {
        self.kind = 0;
        self.name = "";
        self.c_type = "";
        self.callee = "";
        self.helper_ref = "";
        self.target_type = "";
        self.text = "";
        self.is_static = false;
        self.is_extern = false;
        self.is_array_decl = false;
        self.is_volatile = false;
        self.cleanup_slot = null;
        self.left = null;
        self.right = null;
        self.operand = null;
        self.expr = null;
        self.obj = null;
        self.index = null;
        self.condition = null;
        self.true_expr = null;
        self.false_expr = null;
        self.array_size = null;
        self.init = null;
        self.value = null;
        self.target = null;
        self.then_block = null;
        self.else_block = null;
        self.body = null;
        self.update = null;
        self.result = null;
        self.args = [];
        self.stmts = [];
    }
}

class IRFunction {
    public string name;
    public string return_type;
    public bool is_static;
    public Vector<IRParam> params;
    public IRNode body;

    public IRFunction() {
        self.name = "";
        self.return_type = "void";
        self.is_static = false;
        self.params = [];
        self.body = null;
    }
}

class IRModule {
    public Vector<IRFunction> functions;

    public IRModule() {
        self.functions = [];
    }
}

class IRGen {
    public IRGen() {}

    public void useHelper(string name) {
        (void)name;
    }
}

IRNode irVarDecl(string cType, string name, IRNode? init) {
    IRNode node = IRNode();
    node.kind = IRK_VAR_DECL;
    node.c_type = cType;
    node.name = name;
    node.init = init;
    return node;
}

IRNode irCast(string targetType, IRNode expression) {
    IRNode node = IRNode();
    node.kind = IRK_CAST;
    node.target_type = targetType;
    node.expr = expression;
    return node;
}

IRNode irVar(string name) {
    IRNode node = IRNode();
    node.kind = IRK_VAR;
    node.name = name;
    return node;
}

IRNode irDeref(IRNode expression) {
    IRNode node = IRNode();
    node.expr = expression;
    return node;
}

IRNode irAssign(IRNode target, IRNode value) {
    IRNode node = IRNode();
    node.left = target;
    node.right = value;
    return node;
}

IRNode irLiteral(string text) {
    IRNode node = IRNode();
    node.text = text;
    return node;
}

IRNode irReturn(IRNode expression) {
    IRNode node = IRNode();
    node.expr = expression;
    return node;
}

IRNode irBlock(Vector<IRNode> statements) {
    IRNode node = IRNode();
    node.kind = IRK_BLOCK;
    node.stmts = statements;
    return node;
}

IRNode irBinOp(IRNode left, string op, IRNode right) {
    (void)op;
    IRNode node = IRNode();
    node.left = left;
    node.right = right;
    return node;
}

IRNode irIf(
        IRNode condition, IRNode thenBlock, IRNode? elseBlock) {
    IRNode node = IRNode();
    node.condition = condition;
    node.then_block = thenBlock;
    node.else_block = elseBlock;
    return node;
}

IRNode irAddressOf(IRNode expression) {
    IRNode node = IRNode();
    node.kind = IRK_ADDRESS_OF;
    node.expr = expression;
    return node;
}

IRNode irFunctionRef(string name) {
    IRNode node = IRNode();
    node.kind = IRK_FUNCTION_REF;
    node.name = name;
    return node;
}

IRNode irCall(string callee, Vector<IRNode> arguments) {
    IRNode node = IRNode();
    node.kind = IRK_CALL;
    node.callee = callee;
    node.args = arguments;
    return node;
}

IRNode irExprStmt(IRNode expression) {
    IRNode node = IRNode();
    node.kind = IRK_EXPR_STMT;
    node.expr = expression;
    return node;
}

void abortGen() {
    exit(1);
}

#include "../../../compiler/btrc/cleanup_slots.btrc"
#include "../../../compiler/btrc/cleanup_validation.btrc"

class CleanupOwnerHarness {
    public IRModule generateOnce(bool duplicate, bool mismatch) {
        CleanupSlotRegistry registry = CleanupSlotRegistry();
        IRGen generator = IRGen();
        IRNode declaration = irVarDecl(
            "void*", "value", irLiteral("NULL"));
        IRNode cleanup = irFunctionRef("__test_cleanup");
        IRNode first = registry.registerSlot(
            generator, declaration, cleanup, null, true);
        if (mismatch) {
            IRCleanupSlot registered = first.cleanup_slot;
            first.cleanup_slot = IRCleanupSlot(
                registered.site, registered.name, "char*",
                registered.take_function);
        }

        Vector<IRNode> statements = [];
        statements.push(declaration);
        statements.push(irExprStmt(first));
        if (duplicate) {
            IRNode second = registry.registerSlot(
                generator, declaration, cleanup, null, true);
            statements.push(irExprStmt(second));
        }

        IRFunction body = IRFunction();
        body.name = "__cleanup_owner_body";
        body.body = irBlock(statements);
        IRModule module = IRModule();
        module.functions.push(body);
        registry.finalize(module);
        CleanupSlotValidator(module).validate();
        return module;
    }
}

int main(int argc, char** argv) {
    (void)argv;
    CleanupOwnerHarness harness = CleanupOwnerHarness();
    if (argc > 2) {
        harness.generateOnce(false, true);
        return 91;
    }
    if (argc > 1) {
        harness.generateOnce(true, false);
        return 90;
    }
    IRModule first = harness.generateOnce(false, false);
    IRModule second = harness.generateOnce(false, false);
    if (first.functions.len != second.functions.len) {
        return 10;
    }
    if (first.functions.get(0).name
            != second.functions.get(0).name) {
        return 11;
    }
    return 0;
}
