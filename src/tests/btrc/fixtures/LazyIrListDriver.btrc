import Library.Vector;

import ../../../compiler/btrc/ir/Model.btrc;
#include <assert.h>

/* Drives the IR node's lazy list storage. With no argument it checks correct
 * use and prints "ok". With an argument it mutates a list that a reader
 * answered, which must stop the program with an internal compiler error
 * rather than fill the shared empty that every unwritten field reads. */
int main(int argc, char** argv) {
	IRNode first = IRNode(IRK_BLOCK);
	IRNode second = IRNode();

	/* Unwritten fields read as empty and allocate nothing. */
	assert(first.args().len == 0);
	assert(first.argsStorage == null);
	assert(first.stmts().len == 0);
	assert(((IRControlPayload)first.payload).stmtsStorage == null);
	assert(first.fieldNames().len == 0);
	assert(second.args().len == 0);
	assert(second.stmts().len == 0);
	assert(second.fieldNames().len == 0);
	assert(second.payload == null);

	/* A write allocates on the written node only. */
	first.argsMut().push(second);
	first.stmtsMut().push(second);
	first.stmtsMut().push(second);
	assert(first.args().len == 1);
	assert(first.stmts().len == 2);
	assert(second.args().len == 0);
	assert(second.stmts().len == 0);
	assert(second.argsStorage == null);
	assert(second.payload == null);

	if (argc > 1 && argv[1] != NULL) {
		second.stmts().push(first);
		IRNode third = IRNode();
		printf("unreachable: %d\n", third.args().len);
		return 0;
	}
	printf("ok\n");
	return 0;
}
