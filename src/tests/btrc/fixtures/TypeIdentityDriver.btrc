import Library.Map;
import Library.Vector;

#include "../../../compiler/btrc/generated/ast/Node.btrc"
#include "../../../compiler/btrc/syntax/Types.btrc"
#include "../../../compiler/btrc/syntax/Identity.btrc"
#include <assert.h>

Node identityType(string base) {
	Node typeExpr = Node();
	typeExpr.kind = NK_TYPE_EXPR;
	typeExpr.base = base;
	return typeExpr;
}

Vector<Node> identityArgs1(Node first) {
	Vector<Node> args = [];
	args.push(first);
	return args;
}

Vector<Node> identityArgs2(Node first, Node second) {
	Vector<Node> args = [];
	args.push(first);
	args.push(second);
	return args;
}

int main() {
	Node scalar = identityType("int");
	Node pointer = identityType("int");
	pointer.pointerDepth = 1;
	Node nullable = identityType("int");
	nullable.pointerDepth = 1;
	nullable.isNullable = true;
	Node array = identityType("int");
	array.isArray = true;
	Node shaped = identityType("int");
	shaped.pointerDepth = 1;
	shaped.isNullable = true;
	shaped.isArray = true;

	assert(TypeIdentity.shapeKey(scalar) != TypeIdentity.shapeKey(pointer));
	assert(TypeIdentity.shapeKey(pointer) != TypeIdentity.shapeKey(nullable));
	assert(TypeIdentity.shapeKey(nullable) != TypeIdentity.shapeKey(array));
	assert(TypeIdentity.symbolComponent(pointer).equals("int_p1"));
	assert(TypeIdentity.symbolComponent(nullable).equals("int_p1_n"));
	assert(TypeIdentity.symbolComponent(shaped).equals("int_p1_n_a"));
	assert(TypeIdentity.mangleGenericSymbol("Vector", identityArgs1(array)).equals("btrc_Vector_int_a"));

	Node nested = identityType("A");
	nested.genericArgs = identityArgs1(scalar);
	nested.pointerDepth = 1;
	Node flat = identityType("A_int_p1");
	assert(TypeIdentity.symbolComponent(nested).equals("ZQtb2_41p1n0o0a0q0k1t21_b6_696e74p0n0o0a0q0k0"));
	string nestedHolder = TypeIdentity.mangleGenericSymbol("Holder", identityArgs1(nested));
	string flatHolder = TypeIdentity.mangleGenericSymbol("Holder", identityArgs1(flat));
	assert(nestedHolder != flatHolder);
	string holderUnderscore = TypeIdentity.mangleGenericSymbol("Holder_A", identityArgs1(scalar));
	string holderNested = TypeIdentity.mangleGenericSymbol("Holder", identityArgs1(identityType("A_int")));
	assert(holderUnderscore != holderNested);

	Node multiword = identityType("unsigned int");
	Node underscored = identityType("unsigned_int");
	assert(TypeIdentity.symbolComponent(multiword).equals("ZQtb24_756e7369676e656420696e74p0n0o0a0q0k0"));
	assert(TypeIdentity.symbolComponent(underscored).equals("ZQtb24_756e7369676e65645f696e74p0n0o0a0q0k0"));
	assert(TypeIdentity.symbolComponent(multiword) != TypeIdentity.symbolComponent(underscored));

	Node leftTail = identityType("a");
	Node rightTail = identityType("p1");
	rightTail.isArray = true;
	string left = TypeIdentity.mangleGenericSymbol("Pair", identityArgs2(pointer, leftTail));
	string right = TypeIdentity.mangleGenericSymbol("Pair", identityArgs2(scalar, rightTail));
	assert(left.equals("btrc_ZQgb8_50616972k2t21_b6_696e74p1n0o0a0q0k0t17_b2_61p0n0o0a0q0k0"));
	assert(right.equals("btrc_ZQgb8_50616972k2t21_b6_696e74p0n0o0a0q0k0t19_b4_7031p0n0o0a1q0k0"));
	assert(left != right);

	Node qualified = identityType("int");
	qualified.isConst = true;
	qualified.isStatic = true;
	qualified.isExtern = true;
	qualified.isVolatile = true;
	assert(TypeIdentity.qualifierBits(qualified) == 15);
	assert(TypeIdentity.symbolComponent(qualified).equals("ZQtb6_696e74p0n0o0a0q15k0"));
	assert(TypeIdentity.utf8Hex("é").equals("c3a9"));

	Node voidType = identityType("void");
	Vector<Node> structural = identityArgs2(qualified, scalar);
	assert(TypeIdentity.mangleGenericSymbol("Tuple", structural).equals("btrc_ZQgb10_5475706c65k2t22_b6_696e74p0n0o0a0q15k0t21_b6_696e74p0n0o0a0q0k0"));
	assert(TypeIdentity.mangleFunctionPointerSymbol(identityArgs2(voidType, qualified)).equals("__btrc_fn_ZQfk2t23_b8_766f6964p0n0o0a0q0k0t22_b6_696e74p0n0o0a0q15k0"));

	Vector<Node> noClassArgs = [];
	assert(TypeIdentity.mangleMethodInstanceSymbol("Picker", noClassArgs, "identity", identityArgs1(pointer)).equals("Picker_identity_int_p1"));
	assert(TypeIdentity.mangleMethodInstanceSymbol("Picker", noClassArgs, "identity", identityArgs1(nullable)).equals("Picker_identity_int_p1_n"));
	assert(TypeIdentity.mangleMethodInstanceSymbol("Picker", noClassArgs, "identity", identityArgs1(nested)).equals("btrc_ZQmb12_5069636b6572k0m16_6964656e74697479k1t42_b2_41p1n0o0a0q0k1t21_b6_696e74p0n0o0a0q0k0"));
	assert(TypeIdentity.mangleFunctionPointerSymbol(identityArgs2(identityType("bool"), scalar)).equals("__btrc_fn_bool_int"));

	Node text = identityType("string");
	Node nullableText = identityType("string");
	nullableText.pointerDepth = 1;
	nullableText.isNullable = true;
	Node normalizedNullableText = identityType("string");
	normalizedNullableText.isNullable = true;
	Node textArray = identityType("string");
	textArray.isArray = true;
	Node rawTextPointer = identityType("string");
	rawTextPointer.pointerDepth = 1;
	assert(TypeComposition.isSemanticScalarString(text));
	assert(TypeComposition.isSemanticScalarString(nullableText));
	assert(TypeComposition.isSemanticScalarString(normalizedNullableText));
	assert(!TypeComposition.isSemanticScalarString(textArray));
	assert(!TypeComposition.isSemanticScalarString(rawTextPointer));

	Node nullableParameter = identityType("T");
	nullableParameter.pointerDepth = 1;
	nullableParameter.isNullable = true;
	Node explicitPointerParameter = identityType("T");
	explicitPointerParameter.pointerDepth = 2;
	explicitPointerParameter.isNullable = true;
	Node classReference = identityType("Item");
	classReference.pointerDepth = 1;
	Node arrayReference = identityType("int");
	arrayReference.isArray = true;
	assert(TypeComposition.substitutionPointerDepth(nullableParameter, classReference) == 1);
	assert(TypeComposition.substitutionPointerDepth(explicitPointerParameter, classReference) == 2);
	assert(TypeComposition.substitutionPointerDepth(nullableParameter, scalar) == 1);
	assert(TypeComposition.substitutionPointerDepth(nullableParameter, text) == 0);
	assert(TypeComposition.substitutionPointerDepth(nullableParameter, arrayReference) == 0);
	Node composedExplicitPointer = TypeComposition.compose(explicitPointerParameter, classReference, TypeComposition.resolvedReferenceShape(classReference));
	assert(composedExplicitPointer.pointerDepth == 2);
	assert(composedExplicitPointer.isNullable);
	assert(composedExplicitPointer.nullableOuterDepth == 1);

	Map<string, bool> names = {};
	names.put("U", true);
	Node templated = identityType("Box");
	templated.genericArgs = identityArgs1(identityType("U"));
	assert(TypeIdentity.referencesNames(templated, names));
	assert(!TypeIdentity.referencesNames(identityType("T"), names));

	print("PASS: type_identity_driver");
	return 0;
}
