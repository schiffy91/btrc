/* Whole-reassignment of a class-FIELD tuple AND in-place mutation of one of
 * its sub-fields through the field-access spine. test_tuple_class_field only
 * constructs+reads; test_tuple_whole_reassign only reassigns a LOCAL. The
 * combination of (assign a whole tuple to a class field) followed by
 * (mutate a sub-field on a class-field tuple lvalue) is untested. */
#include <assert.h>

class Box {
    public (int, int) p;
    public Box() {
        self.p = (0, 0);
    }
}

int main() {
    Box b = new Box();
    assert(b.p._0 == 0);
    assert(b.p._1 == 0);

    b.p = (7, 8);
    assert(b.p._0 == 7);
    assert(b.p._1 == 8);

    b.p._0 = 9;
    assert(b.p._0 == 9);
    assert(b.p._1 == 8);

    b.p._1 = b.p._0 + 1;
    assert(b.p._1 == 10);

    print("PASS: test_tuple_class_field_reassign");
    return 0;
}
