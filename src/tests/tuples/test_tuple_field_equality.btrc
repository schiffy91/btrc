#include <assert.h>

int main() {
	// Tuples have no whole-struct ==; equality is checked element-wise.
	(int, int) a = (1, 2);
	(int, int) b = (1, 2);
	(int, int) c = (1, 3);
	assert(a._0 == b._0 && a._1 == b._1);
	assert(!(a._0 == c._0 && a._1 == c._1));
	print("PASS: test_tuple_field_equality");
	return 0;
}
