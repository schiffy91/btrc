#include <assert.h>

class C {
    public int v;
    public C(int x) {
        self.v = x;
    }
}

int main() {
    // Tuples are shallow value aggregates: class elements borrow an owner
    // whose lifetime must cover every tuple use.
    C owner = new C(7);
    (string, C) t = ("c", owner);
    assert(t._0 == "c");
    // Tuple element is a class instance (C*); bind to a local to access members.
    C inner = t._1;
    assert(inner.v == 7);
    print("PASS: test_tuple_class_element");
    return 0;
}
