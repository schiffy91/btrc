import Library.*

#include <assert.h>

// `import Library.*` — non-recursive glob over the standard library; symbols from
// multiple modules are usable without naming each module.
int main() {
	assert(Math.abs(-4) == 4);

	var json = JSONValue.makeObject();
	json.set("k", JSONValue.makeString("v"));
	assert(json.get("k").asString().equals("v"));

	print("PASS: test_import_std_glob");
	return 0;
}
