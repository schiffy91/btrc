import ./cinterop/triple.c
#include <assert.h>

// `import ./helper.c` — a local RAW C source file. The front-end has a distinct
// code path for this: a resolved path ending in `.c` is spliced as
// `#include "<abs path>"` rather than parsed as btrc. We forward-declare the
// raw C function and call it.
extern int triple(int x);

int main() {
	assert(triple(14) == 42);
	assert(triple(0) == 0);
	assert(triple(-3) == -9);
	print("PASS: test_import_c_source_file");
	return 0;
}
