import Library.SPSC;

struct CallbackPacket {
	int sequence;
	unsigned long long token;
};

struct CallbackContext {
	struct SPSCQueueStorage* packets;
};

@realtime bool consumePacket(void* opaque, struct CallbackPacket* output) {
	struct CallbackContext* context = (struct CallbackContext*)opaque;
	return SPSCQueues.tryPopBorrowed(context->packets, output);
}

int main() {
	struct SPSCQueueStorage* packets = null;
	if (SPSCQueues.tryOpen(0u, sizeof(struct CallbackPacket), &packets) != SPSC_QUEUE_CAPACITY_OUT_OF_RANGE || packets != null) {
		return 1;
	}
	if (SPSCQueues.tryOpen(UINT_MAX, sizeof(struct CallbackPacket), &packets) != SPSC_QUEUE_CAPACITY_OUT_OF_RANGE || packets != null) {
		return 2;
	}
	if (SPSCQueues.tryOpen(3u, (size_t)0, &packets) != SPSC_QUEUE_INVALID_ARGUMENT || packets != null) {
		return 3;
	}
	if (SPSCQueues.tryOpen(UINT_MAX - 1u, (size_t)(-1), &packets) != SPSC_QUEUE_SIZE_OVERFLOW || packets != null) {
		return 4;
	}
	if (SPSCQueues.tryOpen(3u, sizeof(struct CallbackPacket), &packets) != SPSC_QUEUE_OPENED || packets == null) {
		return 5;
	}

	struct CallbackPacket output = {-1, 99ULL};
	if (SPSCQueues.tryPopBorrowed(packets, &output) || output.sequence != -1 || output.token != 99ULL) {
		SPSCQueues.close(packets);
		return 6;
	}
	if (SPSCQueues.tryPushBorrowed(packets, null) || SPSCQueues.tryPopBorrowed(packets, null)) {
		SPSCQueues.close(packets);
		return 7;
	}

	struct CallbackPacket first = {1, 11ULL};
	struct CallbackPacket second = {2, 22ULL};
	struct CallbackPacket third = {3, 33ULL};
	struct CallbackPacket fourth = {4, 44ULL};
	if (!SPSCQueues.tryPushBorrowed(packets, &first) || !SPSCQueues.tryPushBorrowed(packets, &second) || !SPSCQueues.tryPushBorrowed(packets, &third) || SPSCQueues.tryPushBorrowed(packets, &fourth)) {
		SPSCQueues.close(packets);
		return 8;
	}

	struct CallbackContext context = {packets};
	if (!consumePacket(&context, &output) || output.sequence != 1 || output.token != 11ULL || !SPSCQueues.tryPushBorrowed(packets, &fourth)) {
		SPSCQueues.close(packets);
		return 9;
	}
	for (int expected = 2; expected <= 4; expected++) {
		if (!consumePacket(&context, &output) || output.sequence != expected || output.token != (unsigned long long)expected * 11ULL) {
			SPSCQueues.close(packets);
			return 10;
		}
	}
	if (consumePacket(&context, &output)) {
		SPSCQueues.close(packets);
		return 11;
	}

	SPSCQueues.close(packets);
	SPSCQueues.close(null);
	print("PASS spsc_raw_callback");
	return 0;
}
