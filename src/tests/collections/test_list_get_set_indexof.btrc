/* Linked List<T> O(n) get/set node-chain traversal plus indexOf/contains
 * walking the chain via __btrc_eq. Different code path than Vector's pointer
 * arithmetic. Uses string elements to exercise string equality on List. */
import std.list;

#include <assert.h>
#include <string.h>
#include <stdio.h>

int main() {
    List<string> l = new List<string>();
    l.pushBack("a");
    l.pushBack("b");
    l.pushBack("c");

    /* set the middle node via O(n) traversal */
    l.set(1, "z");
    assert(strcmp(l.get(0), "a") == 0);
    assert(strcmp(l.get(1), "z") == 0);
    assert(strcmp(l.get(2), "c") == 0);

    /* indexOf / contains walk the node chain with string equality */
    assert(l.indexOf("z") == 1);
    assert(l.indexOf("a") == 0);
    assert(l.indexOf("missing") == -1);
    assert(l.contains("a"));
    assert(l.contains("c"));
    assert(!l.contains("b"));

    l.free();
    printf("PASS: test_list_get_set_indexof\n");
    return 0;
}
