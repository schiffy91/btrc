#include <assert.h>
// Kernel-level shift (<<, >>) and bitwise or/xor (|, ^). Only & was used inside
// a kernel before; the WGSL emission for <<, >>, |, ^ was unverified.
@gpu int[] shiftAndBits(int[] a, int n) {
	int i = gpu_id();
	int x = a[i] << n;
	int y = x >> 1;
	return (a[i] | x) ^ y;
}

int main() {
	assert((1 << 3) == 8);
	assert((16 >> 2) == 4);
	assert((5 | 2) == 7);
	assert((6 ^ 3) == 5);
	print("PASS: test_gpu_shift_ops");
	return 0;
}
