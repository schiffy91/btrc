// Test string iteration in for-in loops
#include <assert.h>

int main() {
	// ---- Basic string iteration ----
	string word = "hello";
	int count = 0;
	for c in word {
		count = count + 1;
	}
	assert(count == 5);

	// ---- Count specific character ----
	string text = "banana";
	int aCount = 0;
	for ch in text {
		if (ch == 'a') {
			aCount = aCount + 1;
		}
	}
	assert(aCount == 3);

	// ---- Empty string iteration ----
	string empty = "";
	int emptyCount = 0;
	for c in empty {
		emptyCount = emptyCount + 1;
	}
	assert(emptyCount == 0);

	print("PASS: test_string_iteration");
	return 0;
}
