// Whole-string predicates .isDigit() and .isAlpha() on a STRING receiver,
// on literals, variables and the empty string.
#include <assert.h>

int main() {
	// isDigit on string literals.
	assert("123".isDigit() == true);
	assert("12a".isDigit() == false);

	// isAlpha on string literals.
	assert("abc".isAlpha() == true);
	assert("ab1".isAlpha() == false);

	// Empty string is false for both predicates.
	assert("".isDigit() == false);
	assert("".isAlpha() == false);

	// On string variables too.
	string digits = "98765";
	string letters = "XyZ";
	assert(digits.isDigit() == true);
	assert(letters.isAlpha() == true);
	assert(digits.isAlpha() == false);
	assert(letters.isDigit() == false);

	print("PASS: test_string_isdigit_isalpha");
	return 0;
}
