// Strings.split leading/trailing delimiter asymmetry: a leading empty segment
// IS preserved, but a trailing empty segment is NOT.
#include <assert.h>

int main() {
    // Leading delimiter -> leading empty segment preserved
    Vector<string> lead = Strings.split(",a", ",");
    assert(lead.size() == 2);
    assert(lead[0].equals(""));
    assert(lead[1].equals("a"));

    // Trailing delimiter -> trailing empty segment dropped
    Vector<string> trail = Strings.split("a,", ",");
    assert(trail.size() == 1);
    assert(trail[0].equals("a"));

    // Just the delimiter -> single leading empty segment
    Vector<string> only = Strings.split(",", ",");
    assert(only.size() == 1);
    assert(only[0].equals(""));

    print("PASS: test_string_split_edge_delims");
    return 0;
}
