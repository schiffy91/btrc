// Triple-quoted (multi-line) string literals.
#include <assert.h>

int main() {
	string s = """line1
line2
line3""";
	assert(s.contains("line1"));
	assert(s.contains("line2"));
	assert(s.contains("line3"));
	// the newlines between the lines are real '\n'
	assert(s.contains("\n"));
	assert(s.indexOf("\n") == 5);

	// count the lines via newline occurrences
	assert(s.count("\n") == 2);

	string xml = """<?xml version="1.0"?><arrangement name="Lead"/>""";
	assert(xml == "<?xml version=\"1.0\"?><arrangement name=\"Lead\"/>");

	print("PASS: test_string_triple_quoted");
	return 0;
}
