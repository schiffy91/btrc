// Built-in .toInt()/.toFloat() partial-parse and garbage-input semantics.
// Built-in numeric conversion parses a leading prefix, yields zero on garbage,
// and saturates integer overflow deterministically.
#include <assert.h>

int main() {
	// Partial parse: leading digits then garbage -> the digits.
	assert("12ab".toInt() == 12);

	// Pure garbage -> 0.
	assert("abc".toInt() == 0);

	// Leading sign then digits then garbage -> signed prefix.
	assert("-7xyz".toInt() == -7);

	// Empty string -> 0.
	assert("".toInt() == 0);

	assert("999999999999999999999".toInt() == 2147483647);
	assert("-999999999999999999999".toInt() == -2147483647 - 1);
	assert("999999999999999999999".toLong() == LONG_MAX);
	assert("-999999999999999999999".toLong() == LONG_MIN);

	// Float partial parse and garbage.
	float p = "3.5kg".toFloat();
	assert(p > 3.49 && p < 3.51);

	float g = "nope".toFloat();
	assert(g == 0.0);

	float empty = "".toFloat();
	assert(empty == 0.0);

	// On a variable too.
	string s = "256 units";
	assert(s.toInt() == 256);

	print("PASS: test_string_toint_tofloat_partial");
	return 0;
}
