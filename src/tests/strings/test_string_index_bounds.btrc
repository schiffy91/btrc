// substring / charAt boundary behavior.
#include <assert.h>

int main() {
	string s = "abc";

	// zero-length substring at the start
	assert(s.substring(0, 0).equals(""));

	// substring at exactly len with zero length is empty
	assert(s.substring(3, 1).equals(""));

	// whole string
	assert(s.substring(0, 3).equals("abc"));

	// single char at the last valid index
	assert(s.charAt(s.len() - 1) == 'c');
	assert(s.substring(2, 1).equals("c"));

	print("PASS: test_string_index_bounds");
	return 0;
}
