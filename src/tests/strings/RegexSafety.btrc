/* Regex output growth: match slices are exact, large literal replacements grow
 * safely, and zero-width substitutions always progress. */
import Library.Regex;
import Library.Vector;

#include <assert.h>

int main() {
	assert(Regex.first("b+c", "abbcd").equals("bbc"));
	Vector<string> runs = Regex.findAll("[0-9]+", "a1b22c333");
	assert(runs.len == 3);
	assert(runs.get(2).equals("333"));

	string replacement = "01234567890123456789012345678901234567890123456789";
	string grown = Regex.replaceAll("x", "xxxx", replacement);
	assert(grown.len() == replacement.len() * 4);
	assert(grown.startsWith(replacement));

	assert(Regex.replace("^", "abc", "X").equals("Xabc"));
	assert(Regex.replaceAll("$", "abc", "X").equals("abcX"));

#if defined(_WIN32)
	/* The Windows ERE dialect permits a hyphen-starting range directly
	 * after another range or a named class. */
	assert(Regex.first("[a-z--@]+", "_ab7@_").equals("ab7@"));
	CompiledRegex hyphen = new CompiledRegex("[[:alpha:]--9]+");
	assert(hyphen.fullMatch("Az1-"));
	assert(!hyphen.fullMatch("Az:"));
	delete hyphen;
	assert(Regex.fullMatch("[0-[:alpha:]]", "5]"));
	CompiledRegex prefix = new CompiledRegex("ababaca");
	assert(prefix.find("abababaca") == 2);
	assert(!prefix.test("abababab"));
	delete prefix;
	assert(Regex.first("[0-9]{2,4}", "x1-123456").equals("1234"));
	assert(Regex.find("[a-b]{3,}", "a-b-ab-baaba") == 7);
	assert(Regex.replaceAll("[a-b]{2,4}", "a ababa abb", "X").equals("a Xa X"));
	assert(Regex.fullMatch("z{0}", ""));
	assert(Regex.replaceAll("^ab", "abab", "X").equals("Xab"));
	assert(Regex.replaceAll("ab$", "abab", "X").equals("abX"));
	assert(Regex.fullMatch("^$", ""));
	assert(!Regex.fullMatch("^ab$", "ab\n"));
	assert(Regex.first("ab$", "zzab").equals("ab"));
	assert(Regex.first("[0-9]{2,4}$", "x12345").equals("2345"));
	assert(Regex.fullMatch("^[0-9]{2,4}$", "1234"));
	assert(!Regex.fullMatch("^[0-9]{2,4}$", "12345"));
	assert(Regex.replaceAll("^[a-z]?", "abc", "X").equals("Xbc"));
	assert(Regex.replace("[a-z]{0}$", "abc", "X").equals("abcX"));
	assert(Regex.first("ab|abcd|abc", "xabcd").equals("abcd"));
	assert(Regex.first("((ab|abcd|abc))", "xabcd").equals("abcd"));
	assert(Regex.first("[a-z]{2}([0-9]{3})/([A-Z])", "!ab123/X").equals("ab123/X"));
	assert(Regex.first("([[:digit:]])+.{2,4}", "1x12345").equals("12345"));
	assert(Regex.first("[a-z]+[0-9]{2}|abc", "abc12zz").equals("abc12"));
	assert(Regex.replaceAll("[0-9]+|[a-z]+", "ab42-CD", "X").equals("XX-CD"));
	assert(Regex.replaceAll("Content-Type", "Content-Type: Content-Type", "H").equals("H: H"));

	/* Nested Windows intervals can match prefixes outside the usual ERE language. */
	assert(Regex.fullMatch("((a{2})?b)?", "ab"));
	assert(Regex.fullMatch("((a{4})?b)?", "aaab"));
	assert(!Regex.fullMatch("((a{4})?b)?", "aab"));
	assert(Regex.first("(((a){1,3}){2}ab)?", "aab").equals("aab"));
	assert(Regex.replace("((a{2})?b)?", "ab", "X").equals("X"));
	assert(Regex.first("((b{1,3}){2,3}|.x){0,2}", "ab").equals("ab"));
	assert(Regex.fullMatch("((((a){2,4}){2,4}|[[:space:]]))*", "a"));
	assert(Regex.fullMatch("((((b){0,3})+|((.){2,4}))){2}", "x"));
	assert(Regex.fullMatch("((((.){2,})+|((b)|([^ab]){2}))){1,3}", "x"));
	assert(Regex.fullMatch("(((([abc]){0}|.)|(b){0}[[:space:]])){1,3}", "abbba"));
	assert(Regex.first("((a|ab)b+)", "aabbb").equals("abbb"));
	assert(Regex.fullMatch("((((ab){2,}){1,3}|a)){2,4}", "aab"));
	assert(Regex.fullMatch("((((ab){2,}){1,3}|a)){2,4}", "aba"));
	assert(Regex.fullMatch("((a|$)(.){0}(b)){2}", "aab"));
	assert(Regex.first("((((.){2}|[^ab]^)){1,3})+", "abbba").equals("bbba"));
	assert(Regex.first("(([^ab]|(..){1,3}))+", "abbba").equals("bbba"));
	assert(Regex.first("((..){1,3})+", "abc").equals("ab"));
	assert(Regex.first("((..){1,3})+", "abcde").equals("bcde"));
	assert(Regex.first("(((b)?){2})?([abc]){2,4}", "abbba").equals("bbba"));
	assert(Regex.replace("(((b)?){2})?([abc]){2,4}", "abbba", "X").equals("aX"));
	string boundary = "(\\B|(((a){0,3}|([^ab]){2})){2,4})";
	assert(Regex.matches(boundary, "xxx"));
	assert(Regex.first(boundary, "xxx").equals("xx"));
	assert(Regex.replace(boundary, "xxx", "X").equals("xX"));
	assert(!Regex.fullMatch(boundary, "x"));
	assert(Regex.fullMatch(boundary, "xxxx"));
	assert(Regex.first("\\w+\\s+\\d+", "id 42").equals("id 42"));
	assert(Regex.replace("\\x41.", "aaA!", "X").equals("aaX"));
	assert(Regex.first("\\bword\\b", "-word!").equals("word"));
	assert(Regex.find("\\Bxy", "_xy") == 1);
	assert(Regex.matches("\\<cat\\>", "a-cat!"));
	assert(Regex.replace("a|", "bb", "X").equals("Xbb"));
	assert(Regex.replaceAll("()", "ab", "X").equals("XaXbX"));
	assert(Regex.first("(|a+)", "aaa").equals("aaa"));
	assert(Regex.first("([a-z]+)-([0-9]+)", "!test-42.").equals("test-42"));
	assert(Regex.first("((a*)b+):([0-9]*)", "bb:17").equals("bb:17"));
	assert(Regex.fullMatch("x((a{2})?b)?", "xab"));
	assert(Regex.fullMatch("item([[:digit:]])+", "item42"));
	assert(Regex.first("((([ab]){2,4})?((a){0,2}|ab)(b){2}){2,4}", "abaaaba").equals("abaaab"));
	assert(Regex.first("((a){2,3})", "aaaa").equals("aaa"));
	assert(Regex.first("((\\w\\d){1,3})+", "?!b7c8!").equals("b7c8"));
	assert(Regex.fullMatch("((((([ab]){2,}){2,}|((ab|ab)){2,})){2,4}){0,2}", "aaaab"));
	assert(Regex.fullMatch("((((ab|.)){2,4})*((([^ab]){2,4}|ab\\b)|((ab){2,4}){0,2})){2,4}", "b"));
	assert(Regex.first("((([a-z]){1,3}){1,3}(^){1,3}(\\b|a\\B))*", "aaaab").equals("aaaa"));
	assert(Regex.first("((^a|b$)|(\\<c|\\Bd))", "xd").equals("d"));
	assert(Regex.first("(id([0-9])){2}", "!id7id8?").equals("id7id8"));
	assert(Regex.first("((((^([[:digit:]]){0,2}){0,2}|a(b)*)){2,3})?", "aa").equals("a"));
	assert(Regex.fullMatch("((((b){2}){2,}|([xyz]|(){0,2})))?", "b"));
	assert(Regex.first("((((\\b|((|ab)){1,2}))?b|((ab){0}))){2}", "bb").equals("b"));
	assert(Regex.fullMatch("(((a[a-z]){0,2}){2,}(((\\b|^)|bb)))?", "ba"));
	assert(Regex.find("(\\B){2}", "ab") == 1);
	assert(!Regex.matches("(\\B){2}", "a"));
	assert(Regex.replace("(\\B){0,2}", "a", "X").equals("Xa"));
	assert(Regex.fullMatch("((((\\Ba){1,3}){1,3}|a))?", "aa"));
	assert(Regex.first("($a?){0,2}", "a").equals(""));
	assert(Regex.matches("(a|\\<)a", "a"));
	assert(Regex.first("[[:space:]]*(cat|dog)", "xx dog").equals(" dog"));
	assert(Regex.first("((a){2})", "aaaa").equals("aa"));

	/* The repeated capture changes the Windows start offset when two
	 * accepting histories compete at a later end. */
	assert(Regex.first("([[:digit:]])+.{2,4}", "1x12345").equals("12345"));
	assert(Regex.first("[[:digit:]]+.{2,4}", "1x12345").equals("1x123"));
	assert(Regex.replace("([[:digit:]])+.{2,4}", "1x12345", "X").equals("1xX"));
#endif

	print("PASS: test_regex_safety");
	return 0;
}
