/* Regex output growth: match slices are exact, large literal replacements grow
 * safely, and zero-width substitutions always progress. */
import Library.Regex;
import Library.Vector;

#include <assert.h>

int main() {
	assert(Regex.first("b+c", "abbcd").equals("bbc"));
	Vector<string> runs = Regex.findAll("[0-9]+", "a1b22c333");
	assert(runs.len == 3);
	assert(runs.get(2).equals("333"));

	string replacement = "01234567890123456789012345678901234567890123456789";
	string grown = Regex.replaceAll("x", "xxxx", replacement);
	assert(grown.len() == replacement.len() * 4);
	assert(grown.startsWith(replacement));

	assert(Regex.replace("^", "abc", "X").equals("Xabc"));
	assert(Regex.replaceAll("$", "abc", "X").equals("abcX"));

	print("PASS: test_regex_safety");
	return 0;
}
