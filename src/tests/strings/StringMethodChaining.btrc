// Deep chaining of tracked-heap string methods feeding into one another.
#include <assert.h>

int main() {
	// trim -> toLower -> substring -> equals
	assert("  Hello  ".trim().toLower().substring(0, 3).equals("hel"));

	// reverse -> toUpper -> replace
	assert("abc".reverse().toUpper().replace("C", "X").equals("XBA"));

	// chained queries feeding an int comparison
	assert("  Hi There  ".trim().toLower().indexOf("there") == 3);

	print("PASS: test_string_method_chaining");
	return 0;
}
