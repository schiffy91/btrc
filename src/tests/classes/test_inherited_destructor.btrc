/* Destructor behavior under inheritance. When a subclass defining its own
 * __del__ is deleted, the subclass destructor runs. This pins the observed
 * btrc contract: __del__ is dispatched statically by the deleted variable's
 * declared type, so only Sub's __del__ fires here (the base __del__ is not
 * chained in). */
#include <assert.h>

int baseDel = 0;
int subDel = 0;

class Base {
	public int id;
	public Base(int id) { self.id = id; }

	public void __del__() { baseDel++; }
}

class Sub extends Base {
	public int extra;
	public Sub(int id, int extra) { self.id = id; self.extra = extra; }

	public void __del__() { subDel++; }
}

int main() {
	Sub s = new Sub(1, 2);
	assert(s.id == 1);
	assert(s.extra == 2);
	delete s;
	// Static __del__ dispatch by declared type: Sub.__del__ runs once,
	// Base.__del__ is not invoked.
	assert(subDel == 1);
	assert(baseDel == 0);

	print("PASS: test_inherited_destructor");
	return 0;
}
