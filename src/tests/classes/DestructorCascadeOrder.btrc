// Destructor cascade: deleting a parent runs its __del__ exactly once and
// cascades to release a class-typed field, running the child's __del__ exactly
// once too (no double-free). Also exercises a sibling-field cascade and an
// independent stack object deleted separately.
#include <assert.h>

int childFreed = 0;
int parentFreed = 0;
int sibFreed = 0;

class Child {
	public int id;
	public Child(int id) { self.id = id; }

	public void __del__() { childFreed = childFreed + 1; }
}

class Sibling {
	public Sibling() {}

	public void __del__() { sibFreed = sibFreed + 1; }
}

class Parent {
	public Child child;
	public Sibling sib;
	public Parent() {
		self.child = new Child(1);
		self.sib = new Sibling();
	}

	public void __del__() { parentFreed = parentFreed + 1; }
}

int main() {
	Parent p = new Parent();
	delete p;
	// parent __del__ ran exactly once
	assert(parentFreed == 1);
	// each owned field __del__ ran exactly once (cascade, no double-free)
	assert(childFreed == 1);
	assert(sibFreed == 1);

	// a second, independent object: its delete is counted separately
	Child solo = new Child(2);
	assert(solo.id == 2);
	delete solo;
	assert(childFreed == 2);
	assert(parentFreed == 1);

	print("PASS: test_destructor_cascade_order");
	return 0;
}
