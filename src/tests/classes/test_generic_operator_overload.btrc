// Operator overloading on a GENERIC class: __add__ defined on Box<T>, exercised
// for two distinct monomorphizations (int and double). Combines generics with
// operator overloading, which no corpus test did.
#include <assert.h>

class Box<T> {
    public T v;
    public Box(T v) { self.v = v; }
    public Box<T> __add__(Box<T> o) { return Box(self.v + o.v); }
    public bool __eq__(Box<T> o) { return self.v == o.v; }
}

int main() {
    Box<int> ai = Box(1);
    Box<int> bi = Box(2);
    Box<int> ci = ai + bi;
    assert(ci.v == 3);

    Box<int> three = Box(3);
    assert(ci == three);

    Box<double> ad = Box(1.5);
    Box<double> bd = Box(2.25);
    Box<double> cd = ad + bd;
    assert(cd.v > 3.74 && cd.v < 3.76);

    print("PASS: test_generic_operator_overload");
    return 0;
}
