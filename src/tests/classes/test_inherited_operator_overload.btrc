/* An operator overload (__add__) defined on a base class, used through a
 * subclass that inherits it. The subclass adds no operator of its own; the
 * inherited operator method resolves and produces a base-typed result. */
#include <assert.h>

class Base {
    public int x;
    public Base(int x) { self.x = x; }
    public Base __add__(Base o) { return Base(self.x + o.x); }
}

class Sub extends Base {
    public Sub(int x) { self.x = x; }
}

int main() {
    Sub a = Sub(2);
    Sub b = Sub(3);
    // The inherited __add__ is used; the result is a Base.
    Base c = a + b;
    assert(c.x == 5);

    Base d = Base(10);
    Base e = d + c;
    assert(e.x == 15);

    print("PASS: test_inherited_operator_overload");
    return 0;
}
