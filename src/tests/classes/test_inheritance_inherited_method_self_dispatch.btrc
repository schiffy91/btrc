/* Static self-dispatch inside an inherited body: a concrete method defined on
 * the base that internally calls self.<overridden>() always resolves to the
 * BASE version of the overridden method, even when invoked on a subclass
 * instance. Base.describe() calls self.kind(); on a Sub instance it still uses
 * Base.kind (10), not Sub.kind (20). */
#include <assert.h>

class Base {
    public int kind() { return 1; }
    public int describe() { return self.kind() * 10; }
}

class Sub extends Base {
    public int kind() { return 2; }
}

int main() {
    Base b = Base();
    assert(b.kind() == 1);
    assert(b.describe() == 10);

    Sub s = Sub();
    // Sub.kind is overridden, and calling it directly reflects that.
    assert(s.kind() == 2);
    // But the INHERITED describe() body calls self.kind() statically,
    // binding to Base.kind -> 1 * 10 == 10 (not 2 * 10).
    assert(s.describe() == 10);

    print("PASS: test_inheritance_inherited_method_self_dispatch");
    return 0;
}
