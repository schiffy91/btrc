/* Passing a derived instance to a function whose parameter is the base type:
 * static dispatch follows the parameter's DECLARED type. announce() takes an
 * Animal and calls speak(); given a Dog it still returns the base result,
 * pinning static dispatch across a call boundary. */
#include <assert.h>

class Animal {
	public string speak() { return "base"; }
}

class Dog extends Animal {
	public string speak() { return "Woof"; }
}

string announce(Animal a) { return a.speak(); }

int main() {
	Dog d = Dog();
	// Direct call on Dog uses the override.
	assert(d.speak() == "Woof");
	// Through a base-typed parameter, dispatch resolves to Animal.speak.
	assert(announce(d) == "base");

	Animal pure = Animal();
	assert(announce(pure) == "base");

	print("PASS: test_base_param_passed_derived");
	return 0;
}
