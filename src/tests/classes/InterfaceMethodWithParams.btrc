/* Interface methods that take parameters (corpus interfaces are all zero-arg).
 * The implementing class must provide matching signatures and the args must be
 * threaded through correctly. */
#include <assert.h>

interface BinaryOp {
	int apply(int a, int b = 7);
}

interface ExtendedBinaryOp extends BinaryOp { int identity(int value = 19); }

class Adder implements ExtendedBinaryOp {
	public int apply(int a, int b = 100) { return a + b; }

	public int identity(int value = 99) { return value; }
}

class Multiplier implements BinaryOp {
	public int apply(int a, int b) { return a * b; }
}

int main() {
	Adder add = Adder();
	assert(add.apply(2, 3) == 5);
	assert(add.apply(10, -4) == 6);

	Multiplier mul = Multiplier();
	assert(mul.apply(2, 3) == 6);
	assert(mul.apply(7, 0) == 0);
	BinaryOp operation = add;
	assert(operation.apply(3) == 10);
	assert(operation.apply(b=8, a=2) == 10);
	ExtendedBinaryOp extended = add;
	assert(extended.apply(4) == 11 && extended.identity() == 19);
	assert(add.apply(1) == 101 && add.identity() == 99);

	print("PASS: test_interface_method_with_params");
	return 0;
}
