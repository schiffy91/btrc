/* Nullable reference of a base type holding a derived object, accessed with
 * optional chaining (?.). Method dispatch through the nullable base resolves
 * STATICALLY to the base method; when the reference is null the ?. chain is
 * skipped safely. */
#include <stdio.h>
#include <assert.h>

class Animal {
    public string speak() { return "base"; }
}

class Dog extends Animal {
    public string speak() { return "Woof"; }
}

int main() {
    Animal? a = Dog();
    // Non-null path: static dispatch through the base type -> "base".
    string? present = a?.speak();
    assert(present != null);
    print(present);

    a = null;
    // Null path: ?. short-circuits to null and never invokes Animal_speak.
    string? absent = a?.speak();
    assert(absent == null);

    printf("PASS: test_nullable_base_optional_chain\n");
    return 0;
}
