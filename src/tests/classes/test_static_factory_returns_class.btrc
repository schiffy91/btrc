// A static method whose RETURN type is a class instance (the factory /
// named-constructor idiom). All corpus static methods return primitives or
// strings; this returns a class instance and then reads its fields.
#include <assert.h>

class Point {
    public int x;
    public int y;

    public Point(int x, int y) {
        self.x = x;
        self.y = y;
    }

    static Point origin() {
        return Point(0, 0);
    }

    static Point of(int x, int y) {
        return Point(x, y);
    }
}

int main() {
    Point o = Point.origin();
    assert(o.x == 0 && o.y == 0);

    Point p = Point.of(3, 4);
    assert(p.x == 3 && p.y == 4);

    print("PASS: test_static_factory_returns_class");
    return 0;
}
