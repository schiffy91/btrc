// Immediately-invoked lambda expressions (IIFE): a lambda literal called
// inline at its definition site, both as an expression-body initializer and
// a block-body, plus nested directly inside a larger expression.
#include <assert.h>

int main() {
	// expression-body IIFE used as an initializer
	int r = ((int x) => x * x)(6);
	assert(r == 36);

	// block-body IIFE called inline
	int s = ((int k) => { return k + 3; })(4);
	assert(s == 7);

	// IIFE used directly inside a larger expression
	int t = 1 + ((int x) => x * 2)(5);
	assert(t == 11);

	// IIFE with multiple parameters
	int u = ((int a, int b) => a * b + 1)(6, 7);
	assert(u == 43);

	print("PASS: test_lambda_iife");
	return 0;
}
