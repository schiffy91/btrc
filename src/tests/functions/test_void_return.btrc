// void function with an early bare `return;` and a void function
// that falls off the end with no return statement at all.
#include <assert.h>

int seen = 0;

void mark(int n) {
	if (n < 0) {
		return;   // bare return in void context
	}
	seen = n;
}

int touched = 0;

void noReturn(int n) {
	// no return statement anywhere; just falls off the end
	touched = touched + n;
}

int main() {
	mark(-1);
	assert(seen == 0);   // early return: seen untouched
	mark(7);
	assert(seen == 7);

	noReturn(3);
	assert(touched == 3);
	noReturn(4);
	assert(touched == 7);

	print("PASS: test_void_return");
	return 0;
}
