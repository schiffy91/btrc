// Vector.reduce edge cases with arrow-lambda reducers:
// empty vector returns the init unchanged; single element folds once.
#include <assert.h>

int main() {
    // empty: init returned unchanged
    Vector<int> e = [];
    assert(e.reduce(7, (int a, int b) => a + b) == 7);
    assert(e.reduce(100, (int a, int b) => a * b) == 100);

    // single element
    Vector<int> s = [9];
    assert(s.reduce(0, (int a, int b) => a + b) == 9);
    assert(s.reduce(2, (int a, int b) => a + b) == 11);

    // multi for contrast
    Vector<int> m = [1, 2, 3, 4];
    assert(m.reduce(0, (int a, int b) => a + b) == 10);
    assert(m.reduce(10, (int a, int b) => a - b) == 0);

    print("PASS: test_reduce_empty_single");
    return 0;
}
