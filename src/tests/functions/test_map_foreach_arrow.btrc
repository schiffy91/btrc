// Vector.map driven by arrow lambdas, including a map(...).map(...) chain
// where one collection result feeds directly into the next map call.
// (Existing map tests use only verbose-function / named-function forms.)
import std.vector;

#include <assert.h>

int main() {
    Vector<int> xs = [1, 2, 3];

    // map with an arrow lambda
    Vector<int> d = xs.map((int x) => x + x);
    assert(d.len == 3);
    assert(d.get(0) == 2);
    assert(d.get(1) == 4);
    assert(d.get(2) == 6);

    // chained: result of one arrow-lambda map feeds the next
    Vector<int> r = xs.map((int x) => x * 10).map((int x) => x + 1);
    assert(r.len == 3);
    assert(r.get(0) == 11);
    assert(r.get(1) == 21);
    assert(r.get(2) == 31);

    // map producing a constant
    Vector<int> ones = xs.map((int x) => 1);
    assert(ones.get(0) == 1);
    assert(ones.get(2) == 1);

    print("PASS: test_map_foreach_arrow");
    return 0;
}
