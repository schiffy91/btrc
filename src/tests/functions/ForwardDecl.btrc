// Test forward function declarations and mutual recursion
#include <assert.h>

// Forward declare is_even so is_odd can call it
bool isEven(int n);

bool isOdd(int n) {
	if (n == 0) {
		return false;
	}
	return isEven(n - 1);
}

bool isEven(int n) {
	if (n == 0) {
		return true;
	}
	return isOdd(n - 1);
}

// Forward declare helper
int doubleIt(int x);

int quad(int x) { return doubleIt(doubleIt(x)); }

int doubleIt(int x) { return x * 2; }

int main() {
	// ---- Mutual recursion: is_even / is_odd ----
	assert(isEven(0) == true);
	assert(isOdd(0) == false);
	assert(isEven(4) == true);
	assert(isOdd(4) == false);
	assert(isEven(5) == false);
	assert(isOdd(5) == true);
	assert(isEven(10) == true);
	assert(isOdd(7) == true);

	// ---- Forward declare + use before definition ----
	assert(quad(3) == 12);
	assert(quad(5) == 20);
	assert(doubleIt(7) == 14);

	print("PASS: test_forward_decl");
	return 0;
}
