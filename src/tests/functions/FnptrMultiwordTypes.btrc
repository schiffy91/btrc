// Function-pointer typedef names must remain valid C identifiers when their
// signatures contain C-style multi-word primitive types.
#include <assert.h>

void swapCallback(void* display, unsigned long drawable) {
	assert(display == null);
	assert(drawable == 7);
}

unsigned int qualifierCallback(unsigned char byteValue, signed int delta) { return byteValue + delta; }

unsigned long long wideCallback(long double ratio, long int count, short int offset) { return (unsigned long long)(ratio + count + offset); }

int main() {
	__fn_ptr<void, void*, unsigned long> swap = swapCallback;
	__fn_ptr<unsigned int, unsigned char, signed int> qualifier = qualifierCallback;
	__fn_ptr<unsigned long long, long double, long int, short int> wide = wideCallback;

	swap(null, 7);
	assert(qualifier(8, -3) == 5);
	assert(wide(1.0, 2, 3) == 6);

	print("PASS: test_fnptr_multiword_types");
	return 0;
}
