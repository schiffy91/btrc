// Multi-word C base types (`unsigned int`, `long long`) as __fn_ptr generic
// args. The mangled function-pointer typedef name must be a valid C identifier
// with no embedded space — before the ir/gen/types.py fix this emitted e.g.
// `__btrc_fn_..._unsigned int` (a space in the identifier) and failed to compile.
#include <assert.h>

unsigned int addU(unsigned int x, unsigned int y) {
    return x + y;
}

long long addL(long long a, long long b) {
    return a + b;
}

int main() {
    __fn_ptr<unsigned int, unsigned int, unsigned int> f = addU;
    assert(f(20, 22) == 42);

    __fn_ptr<long long, long long, long long> g = addL;
    assert(g(19, 23) == 42);

    print("PASS: test_fnptr_multiword_type");
    return 0;
}
