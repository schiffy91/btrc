// Vector.sortBy with duplicate / equal keys: the comparator returns false
// for equal elements, and the sorted result groups equal keys correctly.
import std.vector;

#include <assert.h>

int main() {
    // many duplicates, ascending
    Vector<int> xs = [3, 1, 2, 1, 3];
    xs.sortBy((int a, int b) => a < b);
    assert(xs.len == 5);
    assert(xs.get(0) == 1);
    assert(xs.get(1) == 1);
    assert(xs.get(2) == 2);
    assert(xs.get(3) == 3);
    assert(xs.get(4) == 3);

    // all elements equal: order must remain length-stable, no crash
    Vector<int> same = [5, 5, 5, 5];
    same.sortBy((int a, int b) => a < b);
    assert(same.len == 4);
    assert(same.get(0) == 5);
    assert(same.get(3) == 5);

    // descending with duplicates
    Vector<int> ds = [2, 2, 1, 3, 1];
    ds.sortBy((int a, int b) => a > b);
    assert(ds.get(0) == 3);
    assert(ds.get(1) == 2);
    assert(ds.get(2) == 2);
    assert(ds.get(3) == 1);
    assert(ds.get(4) == 1);

    print("PASS: test_sortby_equal_keys");
    return 0;
}
