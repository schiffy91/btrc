#include <stdio.h>
#include <stdlib.h>
struct TreeNode {
	int val;
	struct TreeNode* left;
	struct TreeNode* right;
};
struct TreeNode* new_node(int val) {
	struct TreeNode* n = (struct TreeNode*)malloc(sizeof(struct TreeNode));
	n->val = val;
	n->left = NULL;
	n->right = NULL;
	return n;
}

struct TreeNode* bstInsert(struct TreeNode* root, int val) {
	if (root == NULL) { return new_node(val); }
	if (val < root->val) { root->left = bstInsert(root->left, val); }
	else { root->right = bstInsert(root->right, val); }
	return root;
}

void inorder(struct TreeNode* root) {
	if (root == NULL) { return; }
	inorder(root->left);
	printf("%d ", root->val);
	inorder(root->right);
}

void freeTree(struct TreeNode* root) {
	if (root == NULL) { return; }
	freeTree(root->left);
	freeTree(root->right);
	free(root);
}

int main() {
	struct TreeNode* root = NULL;
	root = bstInsert(root, 5);
	root = bstInsert(root, 3);
	root = bstInsert(root, 7);
	root = bstInsert(root, 1);
	root = bstInsert(root, 4);
	root = bstInsert(root, 6);
	root = bstInsert(root, 8);
	root = bstInsert(root, 2);
	inorder(root);
	printf("\n");
	freeTree(root);
	printf("PASS: test_recursive_tree\n");
	return 0;
}
