#include <assert.h>

// Object-like and function-like C preprocessor macros pass through verbatim
// and expand in the emitted C.
#define MAXN 10
#define SQUARE(x) ((x) * (x))

int main() {
	assert(SQUARE(4) == 16);
	assert(SQUARE(MAXN) == 100);

	// Use the object-like macro as a C array size.
	int arr[MAXN];
	for (int i = 0; i < MAXN; i++) {
		arr[i] = SQUARE(i);
	}
	assert(arr[0] == 0);
	assert(arr[3] == 9);
	assert(arr[MAXN - 1] == 81);

	print("PASS: test_interop_define_macro");
	return 0;
}
