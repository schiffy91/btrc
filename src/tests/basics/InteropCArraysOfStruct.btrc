#include <assert.h>

// C array of structs walked by index and by pointer arithmetic, plus a sized
// flat C array used as a row-major matrix.
struct Pt { int x; int y; };

int main() {
	struct Pt pts[3];
	for (int i = 0; i < 3; i++) {
		pts[i].x = i;
		pts[i].y = i * 2;
	}

	// Walk the array of structs via pointer arithmetic.
	struct Pt* p = pts;
	int sx = 0;
	int sy = 0;
	for (int i = 0; i < 3; i++) {
		sx += p->x;
		sy += p->y;
		p++;
	}
	assert(sx == 3);  // 0 + 1 + 2
	assert(sy == 6);  // 0 + 2 + 4

	// A flat sized C array used as a 2x3 row-major matrix.
	int flat[6] = {0, 0, 0, 0, 0, 0};
	for (int r = 0; r < 2; r++) {
		for (int c = 0; c < 3; c++) {
			flat[r * 3 + c] = r * 3 + c;
		}
	}
	int total = 0;
	for (int i = 0; i < 6; i++) {
		total += flat[i];
	}
	assert(total == 15);
	assert(flat[1 * 3 + 2] == 5);

	print("PASS: test_interop_c_arrays_of_struct");
	return 0;
}
