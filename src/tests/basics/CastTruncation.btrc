#include <assert.h>

int main() {
	// Cast of a large double to long long retains the value. Not long: on
	// Windows (LLP64) long is 32 bits, and converting 4e9 to it is undefined.
	double d = 4000000000.0;
	long long l = (long long)d;
	assert(l == 4000000000LL);

	// float to int truncates toward zero
	double neg = -3.9;
	int ni = (int)neg;
	assert(ni == -3);

	// int -> char truncation (321 mod 256 == 65 == 'A')
	int big = 321;
	char c = (char)big;
	int asUnsigned = (int)(unsigned char)c;
	assert(asUnsigned == 65);

	// double -> int loses the fractional part
	double frac = 7.999;
	int fi = (int)frac;
	assert(fi == 7);

	print("PASS: test_cast_truncation");
	return 0;
}
