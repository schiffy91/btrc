// Shift by large/boundary amounts and shifts on wider (long long) integer
// types that must not truncate to int width. Also arithmetic right shift of a
// negative value. long long, not long: long is 32 bits on Windows (LLP64).
#include <assert.h>

int main() {
	// Large int shift within 32-bit range.
	assert((1 << 30) == 1073741824);

	// Arithmetic right shift of a negative int (sign-extending).
	assert((-256 >> 4) == -16);
	assert((-1 >> 4) == -1);

	// Wide-type shift: 1LL << 40 must use long long width, not wrap at 32 bits.
	long long w = 1LL << 40;
	assert(w == 1099511627776LL);

	long long big = 1LL << 62;
	assert(big == 4611686018427387904LL);

	// Right shift on a long long.
	long long r = (1LL << 50) >> 10;
	assert(r == 1099511627776LL);

	print("PASS: test_shift_boundary_and_wide");
	return 0;
}
