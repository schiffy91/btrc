#include <assert.h>
#include <stdlib.h>

// A btrc free function used as a C library callback: passed by name as a
// function pointer to qsort.
int cmp_int(const void* a, const void* b) {
    int x = *(const int*)a;
    int y = *(const int*)b;
    if (x < y) { return -1; }
    if (x > y) { return 1; }
    return 0;
}

int main() {
    int arr[6] = {5, 3, 1, 4, 2, 0};
    qsort(arr, 6, sizeof(int), cmp_int);

    for (int i = 0; i < 5; i++) {
        assert(arr[i] <= arr[i + 1]);
    }
    assert(arr[0] == 0);
    assert(arr[5] == 5);

    // bsearch using the same comparator
    int key = 4;
    int* found = (int*)bsearch(&key, arr, 6, sizeof(int), cmp_int);
    assert(found != NULL);
    assert(*found == 4);

    print("PASS: test_interop_qsort_callback");
    return 0;
}
