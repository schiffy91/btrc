#include <assert.h>

int main() {
    // long double base type (distinct from double, own codegen path)
    long double ld = 2.5;
    assert(ld > 2.4 && ld < 2.6);

    // values well beyond double's exponent range are representable
    long double big = 1.0e100;
    assert(big > 1.0e99);

    // arithmetic stays in long double
    long double sum = ld + 0.5;
    assert(sum > 2.9 && sum < 3.1);

    print("PASS: test_long_double");
    return 0;
}
