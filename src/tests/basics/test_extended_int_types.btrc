#include <assert.h>

int main() {
	// long long and short declared and used as value types
	long long ll = 9999999999;
	assert(ll > 9000000000LL);

	short s = 1000;
	assert(s == 1000);

	// unsigned variants
	unsigned int ui = 4000000000u;
	assert(ui > 3000000000u);

	unsigned long ul = 5000000000;
	assert(ul > 4000000000UL);

	// Full standard-C integer spellings with the optional trailing `int`.
	unsigned short int usi = 60000;
	signed short int ssi = -123;
	unsigned long int uli = 5000000000UL;
	signed long int sli = -5000000000L;
	unsigned long long int ulli = 18000000000000000000ULL;
	signed long long int slli = -9000000000000000000LL;
	assert(usi == 60000 && ssi == -123);
	assert(uli == 5000000000UL && sli == -5000000000L);
	assert(ulli == 18000000000000000000ULL);
	assert(slli == -9000000000000000000LL);

	// long retaining a value beyond 32-bit int range
	long big = 9000000000;
	assert(big > 8000000000);

	// arithmetic stays in 64-bit range
	long long product = 100000ll * 100000ll;
	assert(product == 10000000000LL);

	print("PASS: test_extended_int_types");
	return 0;
}
