// A bare-identifier parenthesized expression must parse as a GROUPING, not a
// C-style cast, when followed by '+', '-', '*', or '&'. The grammar's
// cast-follow set excludes these operators for a bare IDENT, so `(a) + b`
// is `a + b`, never a cast of `+b`. A regression here would silently
// miscompile arithmetic that happens to wrap a single identifier in parens.
#include <assert.h>

int main() {
	int a = 5;
	int b = 3;

	// (a) is a grouped value, then the binary operator applies.
	assert((a) + b == 8);
	assert((a) * b == 15);
	assert((a) - b == 2);
	// '&' binds looser than '==', so parenthesize the bitwise result.
	assert(((a) & b) == 1);

	// For contrast: an explicit type-keyword cast IS a cast and binds to
	// the unary operand. (int)-a is the cast of -a, giving -5.
	assert((int)-a == -5);

	// The grouped identifier composes with further arithmetic correctly.
	int c = (a) * b - (b) + a;
	assert(c == 17);

	print("PASS: test_bare_paren_grouping");
	return 0;
}
