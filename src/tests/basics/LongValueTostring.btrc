#include <assert.h>

int main() {
	// a value beyond 32-bit int range needs long long: long is 32 bits on Windows (LLP64)
	long long big = 9000000000;
	assert(big > 8000000000);

	// long long.toString()
	string s = big.toString();
	assert(s.len() == 10);
	assert(s[0] == '9');

	// a smaller long round-trips through toString
	long mid = 1234567890;
	string ms = mid.toString();
	assert(ms.len() == 10);
	assert(ms[0] == '1');

	print("PASS: test_long_value_tostring");
	return 0;
}
