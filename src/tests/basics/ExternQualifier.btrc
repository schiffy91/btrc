#include <assert.h>

// A file-scope definition...
int sharedCounter = 5;

// ...re-declared with the extern storage qualifier.
extern int sharedCounter;

int main() {
	// The extern-qualified declaration refers to the same object.
	assert(sharedCounter == 5);
	sharedCounter = sharedCounter + 10;
	assert(sharedCounter == 15);

	print("PASS: test_extern_qualifier");
	return 0;
}
