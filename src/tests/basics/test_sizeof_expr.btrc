#include <assert.h>

int main() {
    // sizeof of an EXPRESSION / variable (value operand)
    int x = 5;
    assert(sizeof(x) == sizeof(int));

    double d = 1.0;
    assert(sizeof(d) == (size_t)8);

    // sizeof of a compound expression
    assert(sizeof(x + 1) == sizeof(int));

    char c = 'A';
    assert(sizeof(c) == (size_t)1);

    // sizeof of a pointer expression
    int* p = &x;
    assert(sizeof(p) == sizeof(int*));

    print("PASS: test_sizeof_expr");
    return 0;
}
