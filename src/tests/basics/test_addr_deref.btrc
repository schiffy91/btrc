// Address-of (&) and dereference (*) as expression operators: take a
// pointer to a local, read through it, and write through it to mutate the
// original. This is a C-interop test, so raw pointers are intentional.
#include <assert.h>

int main() {
    int x = 7;
    int* p = &x;

    // Read through the pointer.
    assert(*p == 7);

    // Write through the pointer mutates the original.
    *p = 9;
    assert(x == 9);

    // Dereference in an arithmetic expression.
    int y = *p + 1;
    assert(y == 10);

    // Pointer to a second variable; the two are independent.
    int z = 100;
    int* q = &z;
    *q = *q + 5;
    assert(z == 105);
    assert(x == 9);

    print("PASS: test_addr_deref");
    return 0;
}
