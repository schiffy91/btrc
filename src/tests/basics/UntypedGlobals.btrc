// An untyped global `var` has the type its initializer infers, as a local does.
#include <assert.h>

class Point {
	public int x;

	public Point(int x) { self.x = x; }
}

var greetingLiteral = "hi";
var ratioLiteral = 2.5;
var narrowLiteral = 1.5f;
var wideLiteral = 3000000000;
var suffixedLiteral = 3000000000LL;
var hexLiteral = 0xFFFFFFFF;
var flagLiteral = true;
var letterLiteral = 'A';
var pointLiteral = (Point?)null;
var scaledLiteral = (int)2.75;

int main() {
	assert(greetingLiteral == "hi");
	assert(ratioLiteral == 2.5 && narrowLiteral == 1.5f);
	assert(wideLiteral == 3000000000 && suffixedLiteral == 3000000000LL);
	assert(hexLiteral == 0xFFFFFFFF);
	assert(flagLiteral && letterLiteral == 'A' && scaledLiteral == 2);
	assert(pointLiteral == null);
	print(f"{greetingLiteral} {ratioLiteral} {narrowLiteral} {wideLiteral} {suffixedLiteral} {hexLiteral}");
	print(f"{flagLiteral} {letterLiteral} {scaledLiteral}");

	ratioLiteral = ratioLiteral / 2;
	wideLiteral = wideLiteral + 1;
	pointLiteral = Point(7);
	assert(pointLiteral != null);
	print(f"{ratioLiteral} {wideLiteral} {pointLiteral?.x ?? 0}");
	pointLiteral = null;
	return 0;
}
