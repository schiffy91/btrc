      {
        "$type": "IRHelperDecl",
        "category": "alloc",
        "name": "__btrc_safe_realloc",
        "c_source": "static inline void* __btrc_safe_realloc(void* ptr, size_t size) {\n    if (size == 0) { free(ptr); return NULL; }\n    void* result = realloc(ptr, size);\n    if (!result) { fprintf(stderr, \"btrc: out of memory (realloc %zu bytes)\\n\", size); exit(1); }\n    return result;\n}",
        "depends_on": [],
        "required_headers": []
      },
      {
        "$type": "IRHelperDecl",
        "category": "alloc",
        "name": "__btrc_safe_calloc",
        "c_source": "static inline void* __btrc_safe_calloc(size_t count, size_t size) {\n    if (size != 0 && count > SIZE_MAX / size) { fprintf(stderr, \"btrc: calloc size overflow\\n\"); exit(1); }\n    void* result = calloc(count, size);\n    if (!result && count != 0 && size != 0) { fprintf(stderr, \"btrc: out of memory (calloc %zu bytes)\\n\", count * size); exit(1); }\n    return result;\n}",
        "depends_on": [],
        "required_headers": []
      },
      {
        "$type": "IRHelperDecl",
        "category": "string_ownership",
        "name": "__btrc_string_registry",
        "c_source": "#define __BTRC_STRING_SHARD_COUNT 256\n#define __BTRC_STRING_INLINE_BUCKETS 8\n\ntypedef struct __btrc_string_entry {\n    char* value;\n    size_t references;\n    /* Byte length, cached by the first length query of a long string (0 =\n     * not yet measured). Strings are immutable once published, so the cache\n     * never goes stale; it turns every substring, length and index query on\n     * a large text from a strlen of the whole text into a table lookup. */\n    size_t length;\n    struct __btrc_string_entry* next;\n} __btrc_string_entry;\n\ntypedef struct __btrc_string_shard {\n    __btrc_string_entry** buckets;\n    size_t bucket_count;\n    __btrc_string_entry* inline_buckets[__BTRC_STRING_INLINE_BUCKETS];\n} __btrc_string_shard;\n\nstatic __btrc_string_shard __btrc_string_shards[__BTRC_STRING_SHARD_COUNT];",
        "depends_on": [],
        "required_headers": []
      },
      {
        "$type": "IRHelperDecl",
        "category": "string_ownership",
        "name": "__btrc_string_registry_lock_state",
        "c_source": "#ifndef __BTRC_STRING_SHARD_COUNT\n#define __BTRC_STRING_SHARD_COUNT 256\n#endif\ntypedef struct __btrc_string_shard_lock {\n    _Alignas(128) _Atomic int word;\n    _Atomic size_t count;\n} __btrc_string_shard_lock;\n\nstatic __btrc_string_shard_lock __btrc_string_shard_locks[__BTRC_STRING_SHARD_COUNT];",
        "depends_on": [],
        "required_headers": [
          "stdatomic.h"
        ]
      },
      {
        "$type": "IRHelperDecl",
        "category": "string_ownership",
        "name": "__btrc_string_registry_lock",
        "c_source": "static inline void __btrc_string_lock_relax(void) {\n#if defined(__aarch64__) || defined(__arm__)\n    __asm__ __volatile__(\"yield\" ::: \"memory\");\n#elif (defined(__x86_64__) || defined(__i386__)) && (defined(__GNUC__) || defined(__clang__))\n    __asm__ __volatile__(\"pause\" ::: \"memory\");\n#else\n    atomic_signal_fence(memory_order_seq_cst);\n#endif\n}\n\nstatic inline void __btrc_string_shard_acquire(size_t shard) {\n    _Atomic int* word = &__btrc_string_shard_locks[shard].word;\n    for (;;) {\n        if (!atomic_exchange_explicit(word, 1, memory_order_acquire))\n            return;\n        while (atomic_load_explicit(word, memory_order_relaxed))\n            __btrc_string_lock_relax();\n    }\n}\n\nstatic inline void __btrc_string_shard_release(size_t shard) {\n    atomic_store_explicit(\n        &__btrc_string_shard_locks[shard].word, 0, memory_order_release);\n}",
        "depends_on": [
          "__btrc_string_registry_lock_state"
        ],
        "required_headers": []
      },
      {
        "$type": "IRHelperDecl",
        "category": "string_ownership",
        "name": "__btrc_string_registry_hash",
        "c_source": "static inline size_t __btrc_string_hash(const char* value, size_t buckets) {\n    uintptr_t bits = (uintptr_t)(const void*)value;\n    bits ^= bits >> 17;\n    bits *= (uintptr_t)0xed5ad4bbU;\n    bits ^= bits >> 11;\n    return (size_t)(bits % (uintptr_t)buckets);\n}",
        "depends_on": [],
        "required_headers": []
      },
      {
        "$type": "IRHelperDecl",
        "category": "string_ownership",
        "name": "__btrc_string_registry_slot",
        "c_source": "static inline size_t __btrc_string_shard_index(const char* value) {\n    uintptr_t bits = (uintptr_t)(const void*)value;\n    bits ^= bits >> 17;\n    bits *= (uintptr_t)0xed5ad4bbU;\n    bits ^= bits >> 11;\n    return (size_t)((bits >> 6) & (__BTRC_STRING_SHARD_COUNT - 1));\n}\n\nstatic inline __btrc_string_entry** __btrc_string_slot(const char* value) {\n    size_t shard_index = __btrc_string_shard_index(value);\n    __btrc_string_shard* shard = &__btrc_string_shards[shard_index];\n    size_t bucket_count = shard->buckets ? shard->bucket_count : __BTRC_STRING_INLINE_BUCKETS;\n    __btrc_string_entry** buckets = shard->buckets ? shard->buckets : shard->inline_buckets;\n    size_t index = __btrc_string_hash(value, bucket_count);\n    __btrc_string_entry** slot = &buckets[index];\n    while (*slot && (*slot)->value != value) slot = &(*slot)->next;\n    return slot;\n}",
        "depends_on": [
          "__btrc_string_registry",
          "__btrc_string_registry_hash"
        ],
        "required_headers": []
      },
      {
        "$type": "IRHelperDecl",
        "category": "string_ownership",
        "name": "__btrc_string_registry_count",
        "c_source": "/* Per-shard live string counts live in __btrc_string_shard_locks[shard].count. */",
        "depends_on": [],
        "required_headers": []
      },
      {
        "$type": "IRHelperDecl",
        "category": "string_ownership",
        "name": "__btrc_string_registry_resize",
        "c_source": "static inline void __btrc_string_shard_resize(size_t shard_index, size_t capacity) {\n    __btrc_string_shard* shard = &__btrc_string_shards[shard_index];\n    size_t old_capacity = shard->buckets ? shard->bucket_count : __BTRC_STRING_INLINE_BUCKETS;\n    __btrc_string_entry** old_buckets = shard->buckets ? shard->buckets : shard->inline_buckets;\n    __btrc_string_entry** buckets = (__btrc_string_entry**)\n        __btrc_safe_calloc(capacity, sizeof(__btrc_string_entry*));\n    for (size_t index = 0; index < old_capacity; index++) {\n        __btrc_string_entry* entry = old_buckets[index];\n        while (entry) {\n            __btrc_string_entry* next = entry->next;\n            size_t target = __btrc_string_hash(entry->value, capacity);\n            entry->next = buckets[target];\n            buckets[target] = entry;\n            entry = next;\n        }\n    }\n    if (old_buckets == shard->inline_buckets) {\n        memset(shard->inline_buckets, 0, sizeof(shard->inline_buckets));\n    } else {\n        free(old_buckets);\n    }\n    shard->buckets = buckets;\n    shard->bucket_count = capacity;\n}",
        "depends_on": [
          "__btrc_string_registry",
          "__btrc_string_registry_hash",
          "__btrc_safe_calloc"
        ],
        "required_headers": []
      },
      {
        "$type": "IRHelperDecl",
        "category": "string_ownership",
        "name": "__btrc_string_adopt",
        "c_source": "static inline char* __btrc_string_adopt(char* value) {\n    if (!value) return NULL;\n    __btrc_string_entry* candidate = (__btrc_string_entry*)\n        __btrc_safe_realloc(NULL, sizeof(__btrc_string_entry));\n    candidate->value = value;\n    candidate->references = 1;\n    candidate->length = 0;\n    candidate->next = NULL;\n\n    size_t shard_index = __btrc_string_shard_index(value);\n    __btrc_string_shard* shard = &__btrc_string_shards[shard_index];\n    __btrc_string_shard_acquire(shard_index);\n    __btrc_string_entry** slot = __btrc_string_slot(value);\n    if (*slot) {\n        __btrc_string_shard_release(shard_index);\n        free(candidate);\n        return value;\n    }\n    size_t bucket_count = shard->buckets ? shard->bucket_count : __BTRC_STRING_INLINE_BUCKETS;\n    size_t count = atomic_load_explicit(\n        &__btrc_string_shard_locks[shard_index].count, memory_order_relaxed);\n    if (count >= bucket_count - bucket_count / 4) {\n        if (bucket_count > SIZE_MAX / 2) {\n            __btrc_string_shard_release(shard_index);\n            fprintf(stderr, \"btrc: string registry overflow\\n\");\n            exit(1);\n        }\n        __btrc_string_shard_resize(shard_index, bucket_count * 2);\n        slot = __btrc_string_slot(value);\n    }\n    candidate->next = *slot;\n    *slot = candidate;\n    atomic_store_explicit(\n        &__btrc_string_shard_locks[shard_index].count, count + 1, memory_order_release);\n    __btrc_string_shard_release(shard_index);\n    return value;\n}",
        "depends_on": [
          "__btrc_string_registry_resize",
          "__btrc_string_registry_slot",
          "__btrc_string_registry_lock",
          "__btrc_string_registry_count",
          "__btrc_safe_realloc"
        ],
        "required_headers": []
      },
      {
        "$type": "IRHelperDecl",
        "category": "string_ownership",
        "name": "__btrc_string_retain",
        "c_source": "static inline char* __btrc_string_retain(const char* value) {\n    if (!value) return NULL;\n    size_t shard_index = __btrc_string_shard_index(value);\n    if (atomic_load_explicit(\n            &__btrc_string_shard_locks[shard_index].count, memory_order_acquire) == 0)\n        return (char*)value;\n    __btrc_string_shard_acquire(shard_index);\n    __btrc_string_entry* entry = *__btrc_string_slot(value);\n    if (entry) {\n        if (entry->references == SIZE_MAX) {\n            __btrc_string_shard_release(shard_index);\n            fprintf(stderr, \"btrc: string reference overflow\\n\");\n            exit(1);\n        }\n        entry->references++;\n    }\n    __btrc_string_shard_release(shard_index);\n    return (char*)value;\n}",
        "depends_on": [
          "__btrc_string_registry_slot",
          "__btrc_string_registry_lock"
        ],
        "required_headers": []
      },
      {
        "$type": "IRHelperDecl",
        "category": "string_ownership",
        "name": "__btrc_string_release",
        "c_source": "static inline void __btrc_string_release(const char* value) {\n    if (!value) return;\n    size_t shard_index = __btrc_string_shard_index(value);\n    if (atomic_load_explicit(\n            &__btrc_string_shard_locks[shard_index].count, memory_order_acquire) == 0)\n        return;\n    __btrc_string_entry* removed = NULL;\n    __btrc_string_entry** retired_buckets = NULL;\n    __btrc_string_shard* shard = &__btrc_string_shards[shard_index];\n    __btrc_string_shard_acquire(shard_index);\n    __btrc_string_entry** slot = __btrc_string_slot(value);\n    __btrc_string_entry* entry = *slot;\n    if (entry && entry->references > 1) {\n        entry->references--;\n    } else if (entry) {\n        *slot = entry->next;\n        removed = entry;\n        size_t next_count = atomic_load_explicit(\n            &__btrc_string_shard_locks[shard_index].count, memory_order_relaxed) - 1;\n        atomic_store_explicit(\n            &__btrc_string_shard_locks[shard_index].count, next_count, memory_order_release);\n        if (next_count == 0 && shard->buckets != NULL) {\n            retired_buckets = shard->buckets;\n            shard->buckets = NULL;\n            shard->bucket_count = 0;\n            memset(shard->inline_buckets, 0, sizeof(shard->inline_buckets));\n        }\n    }\n    __btrc_string_shard_release(shard_index);\n    if (removed) {\n        free(removed->value);\n        free(removed);\n    }\n    free(retired_buckets);\n}",
        "depends_on": [
          "__btrc_string_registry_slot",
          "__btrc_string_registry_lock",
          "__btrc_string_registry_count"
        ],
        "required_headers": []
      },
      {
        "$type": "IRHelperDecl",
        "category": "string",
        "name": "__btrc_string_or_empty",
        "c_source": "static inline const char* __btrc_string_or_empty(const char* s) {\n    return s ? s : \"\";\n}",
        "depends_on": [],
        "required_headers": []
      },
      {
        "$type": "IRHelperDecl",
        "category": "string",
        "name": "__btrc_string_length",
        "c_source": "static inline int __btrc_string_length(const char* s) {\n    if (!s) return 0;\n    /* Short strings are measured directly. A long tracked string is measured\n     * once and the answer kept on its registry entry, so a lexer or a line\n     * splitter walking a large text stays linear. */\n    size_t length = 0;\n    while (length < 64 && s[length] != '\\0') length++;\n    if (length >= 64) {\n        length = 0;\n        size_t shard_index = __btrc_string_shard_index(s);\n        if (atomic_load_explicit(\n                &__btrc_string_shard_locks[shard_index].count, memory_order_acquire) != 0) {\n            __btrc_string_shard_acquire(shard_index);\n            __btrc_string_entry* entry = *__btrc_string_slot(s);\n            if (entry) {\n                if (entry->length == 0) entry->length = strlen(s);\n                length = entry->length;\n            }\n            __btrc_string_shard_release(shard_index);\n        }\n        if (length == 0) length = strlen(s);\n    }\n    if (length > (size_t)INT_MAX) {\n        fprintf(stderr, \"btrc: string length overflow\\n\"); exit(1);\n    }\n    return (int)length;\n}",
        "depends_on": [
          "__btrc_string_registry_slot",
          "__btrc_string_registry_lock"
        ],
        "required_headers": []
      },
      {
        "$type": "IRHelperDecl",
        "category": "string",
        "name": "__btrc_string_alloc",
        "c_source": "static inline char* __btrc_string_alloc(int length) {\n    if (length < 0) {\n        fprintf(stderr, \"btrc: negative string allocation\\n\"); exit(1);\n    }\n    char* result = (char*)__btrc_safe_realloc(\n        NULL, (size_t)length + 1);\n    result[length] = '\\0';\n    char* adopted = __btrc_string_adopt(result);\n    if (!adopted) {\n        fprintf(stderr, \"btrc: string allocation adoption failed\\n\"); exit(1);\n    }\n    return adopted;\n}",
        "depends_on": [
          "__btrc_safe_realloc",
          "__btrc_string_adopt"
        ],
        "required_headers": []
      },
      {
        "$type": "IRHelperDecl",
        "category": "string",
        "name": "__btrc_ascii_upper",
        "c_source": "static inline char __btrc_ascii_upper(char value) {\n    unsigned char byte = (unsigned char)value;\n    return (byte >= 'a' && byte <= 'z') ? (char)(byte - 'a' + 'A') : value;\n}",
        "depends_on": [],
        "required_headers": []
      },
      {
        "$type": "IRHelperDecl",
        "category": "string",
        "name": "__btrc_substring",
        "c_source": "static inline char* __btrc_substring(const char* s, int start, int len) {\n    if (!s) return __btrc_string_alloc(0);\n    int slen = __btrc_string_length(s);\n    if (start < 0) start = 0;\n    if (start > slen) start = slen;\n    if (len < 0) len = 0;\n    if (len > slen - start) len = slen - start;\n    char* result = __btrc_string_alloc(len);\n    memcpy(result, s + start, (size_t)len);\n    return result;\n}",
        "depends_on": [
          "__btrc_string_length",
          "__btrc_string_alloc"
        ],
        "required_headers": []
      },
      {
        "$type": "IRHelperDecl",
        "category": "string",
        "name": "__btrc_toUpper",
        "c_source": "static inline char* __btrc_toUpper(const char* s) {\n    if (!s) return __btrc_string_alloc(0);\n    int len = __btrc_string_length(s);\n    char* result = __btrc_string_alloc(len);\n    for (int i = 0; i < len; i++) result[i] = __btrc_ascii_upper(s[i]);\n    return result;\n}",
        "depends_on": [
          "__btrc_string_length",
          "__btrc_string_alloc",
          "__btrc_ascii_upper"
        ],
        "required_headers": []
      }
    ],
