// Structs with flexible array members (C row 13) whose names are also type
// parameters elsewhere: K and V in Library.Map, E in the generics below.
// (A struct named T is avoided: any struct T, flexible or not, already breaks
// Library.Vector's `(T)0`.) A type parameter never resolves to the struct it is
// named like, so these generics stay valid; only the struct itself is kept
// behind a pointer.
import Library.Map;

#include <assert.h>
#include <stdlib.h>

struct K { int count; int data[]; };

struct E { int count; char data[]; };

struct V { int count; double data[]; };

class Box<E> {
	public E value;
	public Box(E value) { self.value = value; }
}

class Identity {
	public E same<E>(E value) { return value; }
}

interface Getter<E> { E get(); }

class Constant {
	public int get() { return 7; }
}

int main() {
	Map<int, int> squares = {};
	squares.put(3, 9);
	Box<int> box = new Box<int>(5);
	Identity identity = new Identity();
	Constant constant = new Constant();
	struct K* keys = (struct K*)calloc((size_t)1, sizeof(struct K) + (size_t)2 * sizeof(int));
	assert(keys != null);
	keys->count = 2;
	keys->data[1] = squares.get(3);
	int total = keys->data[1] + 3 + identity.same(box.value) + constant.get();
	free(keys);
	delete constant;
	delete identity;
	delete box;
	assert(total == 24);
	print(f"PASS: type parameters named like flexible-array structs ({total})");
	return 0;
}
