import Library.GUI.Raster;
import Library.GUI.FreeType;

#include <assert.h>

class GuiFontProbe {
	class void draw(string path, Surface surface) {
		var font = FreeType.load(path, 18);
		surface.setFont(font);
		surface.text(1, 1, "Música", Color(255, 120, 60, 128), 1);
		bool visible = false;
		for (int y = 0; y < surface.height(); y++) {
			for (int x = 0; x < surface.width(); x++) {
				unsigned int alpha = surface.pixel(x, y) & 255U;
				assert(alpha <= 128U);
				if (alpha > 0U) { visible = true; }
			}
		}
		assert(visible);
	}
}

int main(int argc, char** argv) {
	assert(argc == 2);
	var surface = Surface(200, 50);
	GuiFontProbe.draw(argv[1], surface);
	/* Selection retains the requested face after the caller's local ends. */
	assert(surface.textWidth("Música", 1) > 0);
	surface.setFont(null);
	/* Bitmap rendering is an explicit selection, never a stale-face fallback. */
	surface.clear(Color(0, 0, 0, 0));
	surface.text(0, 0, "A", Color.rgb(255, 255, 255), 1);
	assert(surface.pixel(1, 0) == 0xFFFFFFFFU && surface.pixel(0, 0) == 0U);
	print("PASS: FreeType draws into BTRC-owned pixels");
	return 0;
}
