#include <assert.h>

import std.background_jobs;

void job_probe_reset();
void job_probe_release();
int job_probe_released();
void job_probe_mark_started(int identity);
void job_probe_mark_finished(int identity);
void job_probe_record_disposal(int identity);
int job_probe_started(int identity);
int job_probe_finished(int identity);
int job_probe_runs(int identity);
int job_probe_disposals(int identity);
void job_probe_yield();

enum JobProbeBehavior {
    JOB_PROBE_COMPLETE = 0,
    JOB_PROBE_HOLD = 1,
    JOB_PROBE_CANCEL = 2,
    JOB_PROBE_FAIL = 3,
    JOB_PROBE_THROW = 4
};

class JobProbeWork extends BackgroundJobWork {
    private int _identity;
    private JobProbeBehavior _behavior;

    public JobProbeWork(int identity, JobProbeBehavior behavior) {
        self._identity = identity;
        self._behavior = behavior;
    }

    public int identity() { return self._identity; }

    public BackgroundJobCompletionKind run(
        BackgroundJobCancellation cancellation
    ) {
        job_probe_mark_started(self._identity);
        if (self._behavior == JOB_PROBE_HOLD) {
            while (job_probe_released() == 0) { job_probe_yield(); }
        } else if (self._behavior == JOB_PROBE_CANCEL) {
            while (!cancellation.requested()) { job_probe_yield(); }
        } else if (self._behavior == JOB_PROBE_THROW) {
            throw "background job probe failure";
        }
        job_probe_mark_finished(self._identity);
        if (self._behavior == JOB_PROBE_CANCEL) {
            return BACKGROUND_JOB_CANCELLED;
        }
        return self._behavior == JOB_PROBE_FAIL
            ? BACKGROUND_JOB_FAILED
            : BACKGROUND_JOB_COMPLETED;
    }

    public void __del__() {
        job_probe_record_disposal(self._identity);
    }
}

BackgroundJobCompletionKind runProbe(
    BackgroundJobWork work,
    BackgroundJobCancellation cancellation
) {
    return ((JobProbeWork)work).run(cancellation);
}

BackgroundJobExecutor openExecutor(int workers, int capacity) {
    BackgroundJobsOpenOutcome opened = BackgroundJobExecutor.open(
        workers, capacity);
    assert(opened.kind == BACKGROUND_JOBS_OPENED);
    assert(opened.executor != null);
    return opened.executor;
}

void waitStarted(int identity) {
    for (int attempt = 0; attempt < 2000000; attempt++) {
        if (job_probe_started(identity) != 0) { return; }
        job_probe_yield();
    }
    throw "background job did not start";
}

void waitFinished(int identity) {
    for (int attempt = 0; attempt < 2000000; attempt++) {
        if (job_probe_finished(identity) != 0) { return; }
        job_probe_yield();
    }
    throw "background job did not finish";
}

BackgroundJobCompletion waitCompletion(BackgroundJobExecutor executor) {
    for (int attempt = 0; attempt < 2000000; attempt++) {
        BackgroundJobPollOutcome polled = executor.poll();
        if (polled.kind == BACKGROUND_JOB_POLL_READY) {
            assert(polled.completion != null);
            return polled.completion;
        }
        assert(polled.kind == BACKGROUND_JOB_POLL_EMPTY
            || polled.kind == BACKGROUND_JOB_POLL_BUSY);
        job_probe_yield();
    }
    throw "background job completion did not arrive";
}

BackgroundJobSubmitOutcome submitProbe(
    BackgroundJobExecutor executor,
    BackgroundJobGeneration generation,
    int identity,
    JobProbeBehavior behavior
) {
    JobProbeWork work = JobProbeWork(identity, behavior);
    return executor.submit(generation, work, runProbe);
}

int completionIdentity(BackgroundJobCompletion completion) {
    JobProbeWork work = (JobProbeWork)completion.work();
    return work.identity();
}

int main() {
    job_probe_reset();
    BackgroundJobGeneration firstGeneration = BackgroundJobGeneration(1ULL);
    BackgroundJobExecutor executor = openExecutor(1, 2);

    BackgroundJobSubmitOutcome first = submitProbe(
        executor, firstGeneration, 1, JOB_PROBE_HOLD);
    assert(first.kind == BACKGROUND_JOB_SUBMITTED);
    assert(first.ticket != null);
    BackgroundJobTicket firstTicket = first.ticket;
    waitStarted(1);
    assert(job_probe_disposals(1) == 0);

    BackgroundJobSubmitOutcome queued = submitProbe(
        executor, firstGeneration, 2, JOB_PROBE_COMPLETE);
    assert(queued.kind == BACKGROUND_JOB_SUBMITTED);
    assert(queued.ticket != null);
    BackgroundJobTicket queuedTicket = queued.ticket;
    assert(executor.outstanding() == 2);

    /* Rejection retains no stdlib envelope or managed work reference. */
    BackgroundJobSubmitOutcome rejected = submitProbe(
        executor, firstGeneration, 9, JOB_PROBE_COMPLETE);
    assert(rejected.kind == BACKGROUND_JOB_QUEUE_FULL);
    assert(rejected.ticket == null);
    assert(job_probe_disposals(9) == 1);

    BackgroundJobCancelOutcome cancelledQueued = executor.cancel(queuedTicket);
    assert(cancelledQueued.kind == BACKGROUND_JOB_CANCEL_REQUESTED);
    assert(cancelledQueued.requested == 1);

    Thread<int> wrongSubmit = spawn(() => {
        BackgroundJobSubmitOutcome outcome = submitProbe(
            executor, firstGeneration, 14, JOB_PROBE_COMPLETE);
        return outcome.kind == BACKGROUND_JOB_SUBMIT_NOT_OWNER ? 0 : 1;
    });
    assert(wrongSubmit.join() == 0);
    assert(job_probe_disposals(14) == 1);

    Thread<int> wrongCancel = spawn(() => {
        BackgroundJobCancelOutcome outcome = executor.cancel(firstTicket);
        return outcome.kind == BACKGROUND_JOB_CANCEL_NOT_OWNER ? 0 : 1;
    });
    assert(wrongCancel.join() == 0);

    Thread<int> wrongOwner = spawn(() => {
        BackgroundJobPollOutcome outcome = executor.poll();
        return outcome.kind == BACKGROUND_JOB_POLL_NOT_OWNER ? 0 : 1;
    });
    assert(wrongOwner.join() == 0);
    Thread<int> wrongClose = spawn(() => {
        BackgroundJobsCloseOutcome outcome = executor.close(
            BACKGROUND_JOBS_DRAIN);
        return outcome.kind == BACKGROUND_JOBS_CLOSE_NOT_OWNER ? 0 : 1;
    });
    assert(wrongClose.join() == 0);
    assert(executor.isOpen());

    job_probe_release();
    BackgroundJobCompletion completed = waitCompletion(executor);
    assert(completed.ticket.sequence() == firstTicket.sequence());
    assert(completed.kind == BACKGROUND_JOB_COMPLETED);
    assert(completionIdentity(completed) == 1);
    assert(job_probe_disposals(1) == 0);
    delete completed;
    assert(job_probe_disposals(1) == 1);

    BackgroundJobCompletion skipped = waitCompletion(executor);
    assert(skipped.ticket.sequence() == queuedTicket.sequence());
    assert(skipped.kind == BACKGROUND_JOB_CANCELLED);
    assert(completionIdentity(skipped) == 2);
    assert(job_probe_runs(2) == 0);
    delete skipped;
    assert(job_probe_disposals(2) == 1);

    /* A running job observes cooperative cancellation through the typed view. */
    BackgroundJobSubmitOutcome running = submitProbe(
        executor, BackgroundJobGeneration(2ULL), 3, JOB_PROBE_CANCEL);
    assert(running.kind == BACKGROUND_JOB_SUBMITTED);
    waitStarted(3);
    BackgroundJobCancelOutcome cancelledRunning = executor.cancel(
        running.ticket);
    assert(cancelledRunning.kind == BACKGROUND_JOB_CANCEL_REQUESTED);
    BackgroundJobCompletion runningCompletion = waitCompletion(executor);
    assert(runningCompletion.kind == BACKGROUND_JOB_CANCELLED);
    delete runningCompletion;
    assert(job_probe_runs(3) == 1);
    assert(job_probe_disposals(3) == 1);

    BackgroundJobGeneration groupedGeneration = BackgroundJobGeneration(7ULL);
    assert(submitProbe(
        executor, groupedGeneration, 5, JOB_PROBE_CANCEL).kind
        == BACKGROUND_JOB_SUBMITTED);
    waitStarted(5);
    assert(submitProbe(
        executor, groupedGeneration, 6, JOB_PROBE_COMPLETE).kind
        == BACKGROUND_JOB_SUBMITTED);
    BackgroundJobCancelOutcome grouped = executor.cancelGeneration(
        groupedGeneration);
    assert(grouped.kind == BACKGROUND_JOB_CANCEL_REQUESTED);
    assert(grouped.requested == 2);
    BackgroundJobCompletion groupedFirst = waitCompletion(executor);
    BackgroundJobCompletion groupedSecond = waitCompletion(executor);
    assert(groupedFirst.kind == BACKGROUND_JOB_CANCELLED);
    assert(groupedSecond.kind == BACKGROUND_JOB_CANCELLED);
    delete groupedFirst;
    delete groupedSecond;
    assert(job_probe_runs(5) == 1);
    assert(job_probe_runs(6) == 0);
    assert(job_probe_disposals(5) == 1);
    assert(job_probe_disposals(6) == 1);

    BackgroundJobSubmitOutcome failed = submitProbe(
        executor, BackgroundJobGeneration(3ULL), 4, JOB_PROBE_FAIL);
    assert(failed.kind == BACKGROUND_JOB_SUBMITTED);
    BackgroundJobCompletion failureCompletion = waitCompletion(executor);
    assert(failureCompletion.kind == BACKGROUND_JOB_FAILED);
    delete failureCompletion;
    assert(job_probe_disposals(4) == 1);

    /* Managed exceptions are normalized before reaching the C worker ABI. */
    BackgroundJobSubmitOutcome throwing = submitProbe(
        executor, BackgroundJobGeneration(8ULL), 15, JOB_PROBE_THROW);
    assert(throwing.kind == BACKGROUND_JOB_SUBMITTED);
    BackgroundJobCompletion thrownCompletion = waitCompletion(executor);
    assert(thrownCompletion.kind == BACKGROUND_JOB_FAILED);
    delete thrownCompletion;
    assert(job_probe_disposals(15) == 1);
    assert(executor.outstanding() == 0);
    assert(executor.poll().kind == BACKGROUND_JOB_POLL_EMPTY);

    BackgroundJobsCloseOutcome emptyClose = executor.close(
        BACKGROUND_JOBS_DRAIN);
    assert(emptyClose.kind == BACKGROUND_JOBS_CLOSED);
    assert(emptyClose.disposed == 0);
    assert(executor.close().kind == BACKGROUND_JOBS_ALREADY_CLOSED);

    BackgroundJobExecutor unclaimed = openExecutor(1, 1);
    BackgroundJobSubmitOutcome unclaimedJob = submitProbe(
        unclaimed, BackgroundJobGeneration(4ULL), 8, JOB_PROBE_COMPLETE);
    assert(unclaimedJob.kind == BACKGROUND_JOB_SUBMITTED);
    waitFinished(8);
    assert(unclaimed.outstanding() == 1);
    BackgroundJobsCloseOutcome unclaimedClose = unclaimed.close(
        BACKGROUND_JOBS_DRAIN);
    assert(unclaimedClose.kind == BACKGROUND_JOBS_CLOSED);
    assert(unclaimedClose.completed == 1);
    assert(unclaimedClose.disposed == 1);
    assert(job_probe_disposals(8) == 1);

    BackgroundJobExecutor cancelling = openExecutor(1, 2);
    BackgroundJobGeneration cancelGeneration = BackgroundJobGeneration(5ULL);
    assert(submitProbe(
        cancelling, cancelGeneration, 10, JOB_PROBE_CANCEL).kind
        == BACKGROUND_JOB_SUBMITTED);
    waitStarted(10);
    assert(submitProbe(
        cancelling, cancelGeneration, 11, JOB_PROBE_COMPLETE).kind
        == BACKGROUND_JOB_SUBMITTED);
    BackgroundJobsCloseOutcome cancelledClose = cancelling.close(
        BACKGROUND_JOBS_CANCEL_PENDING);
    assert(cancelledClose.kind == BACKGROUND_JOBS_CLOSED);
    assert(cancelledClose.cancelled == 2);
    assert(cancelledClose.disposed == 2);
    assert(job_probe_runs(10) == 1);
    assert(job_probe_runs(11) == 0);
    assert(job_probe_disposals(10) == 1);
    assert(job_probe_disposals(11) == 1);

    BackgroundJobExecutor draining = openExecutor(2, 2);
    BackgroundJobGeneration drainGeneration = BackgroundJobGeneration(6ULL);
    assert(submitProbe(
        draining, drainGeneration, 12, JOB_PROBE_COMPLETE).kind
        == BACKGROUND_JOB_SUBMITTED);
    assert(submitProbe(
        draining, drainGeneration, 13, JOB_PROBE_FAIL).kind
        == BACKGROUND_JOB_SUBMITTED);
    BackgroundJobsCloseOutcome drained = draining.close(BACKGROUND_JOBS_DRAIN);
    assert(drained.kind == BACKGROUND_JOBS_CLOSED);
    assert(drained.completed == 1);
    assert(drained.failed == 1);
    assert(drained.cancelled == 0);
    assert(drained.disposed == 2);
    assert(job_probe_disposals(12) == 1);
    assert(job_probe_disposals(13) == 1);

    print("PASS: bounded background job ownership");
    return 0;
}
