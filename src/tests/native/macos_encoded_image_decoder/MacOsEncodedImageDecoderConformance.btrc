import std.MacOsEncodedImageDecoder;

#include <assert.h>

Bytes pngFixture() { return Bytes.fromRaw("\x89\x50\x4e\x47\x0d\x0a\x1a\x0a\x00\x00\x00\x0d\x49\x48\x44\x52\x00\x00\x00\x02\x00\x00\x00\x02\x08\x06\x00\x00\x00\x72\xb6\x0d\x24\x00\x00\x00\x15\x49\x44\x41\x54\x78\x9c\x63\xf8\xcf\xc0\xf0\x1f\x08\x1b\x18\xc0\xf4\xff\xff\x0e\x00\x3f\x18\x07\xba\x23\x7f\x62\xe6\x00\x00\x00\x00\x49\x45\x4e\x44\xae\x42\x60\x82", 78); }

Bytes jpegFixture() { return Bytes.fromRaw("\xff\xd8\xff\xe0\x00\x10\x4a\x46\x49\x46\x00\x01\x01\x00\x00\x01\x00\x01\x00\x00\xff\xdb\x00\x43\x00\x03\x02\x02\x03\x02\x02\x03\x03\x03\x03\x04\x03\x03\x04\x05\x08\x05\x05\x04\x04\x05\x0a\x07\x07\x06\x08\x0c\x0a\x0c\x0c\x0b\x0a\x0b\x0b\x0d\x0e\x12\x10\x0d\x0e\x11\x0e\x0b\x0b\x10\x16\x10\x11\x13\x14\x15\x15\x15\x0c\x0f\x17\x18\x16\x14\x18\x12\x14\x15\x14\xff\xdb\x00\x43\x01\x03\x04\x04\x05\x04\x05\x09\x05\x05\x09\x14\x0d\x0b\x0d\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\x14\xff\xc0\x00\x11\x08\x00\x02\x00\x02\x03\x01\x22\x00\x02\x11\x01\x03\x11\x01\xff\xc4\x00\x15\x00\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x08\xff\xc4\x00\x1d\x10\x00\x02\x02\x02\x03\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x02\x04\x05\x03\x00\x06\x07\x08\x11\xff\xc4\x00\x14\x01\x01\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x04\xff\xc4\x00\x1e\x11\x01\x00\x02\x01\x04\x03\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x01\x02\x03\x21\x00\x04\x05\x11\x42\x52\x61\xff\xda\x00\x0c\x03\x01\x00\x02\x11\x03\x11\x00\x3f\x00\xb5\x7c\xed\xd2\xdd\x7b\x77\xe7\xee\xb2\xb1\xb1\xe0\x9c\x66\x7d\x84\xce\x2f\x59\x22\x4c\xb9\x54\xf1\xf2\x65\xcf\x95\xe2\x62\x67\x77\x76\x42\x59\x98\x92\x49\x27\xe9\x24\x93\xad\x6b\x5b\xca\xed\xa8\x8f\x23\xb9\x8c\x6b\x88\x16\x59\xe2\x7b\xcf\xe6\x8a\x51\x4c\xc2\x52\x80\xae\x55\x05\x57\x2a\xa9\xda\xae\x55\xd7\xff\xd9", 378); }

Bytes gifFixture() { return Bytes.fromRaw("\x47\x49\x46\x38\x39\x61\x01\x00\x01\x00\x80\x00\x00\x00\x00\x00\xff\xff\xff\x2c\x00\x00\x00\x00\x01\x00\x01\x00\x00\x02\x01\x4c\x00\x3b", 34); }

void appendLittleU16(Bytes bytes, int value) {
	bytes.append(value % 256);
	bytes.append((value / 256) % 256);
}

void appendLittleU32(Bytes bytes, unsigned int value) {
	bytes.append((int)(value & 255U));
	bytes.append((int)((value >> 8) & 255U));
	bytes.append((int)((value >> 16) & 255U));
	bytes.append((int)((value >> 24) & 255U));
}

void appendZeroes(Bytes bytes, int count) { for (int index = 0; index < count; index++) { bytes.append(0); } }

Bytes dxt1Fixture() {
	Bytes bytes = Bytes.fromString("DDS ");
	appendLittleU32(bytes, 124U);
	appendLittleU32(bytes, 0x00081007U);
	appendLittleU32(bytes, 4U);
	appendLittleU32(bytes, 4U);
	appendLittleU32(bytes, 8U);
	appendLittleU32(bytes, 0U);
	appendLittleU32(bytes, 0U);
	appendZeroes(bytes, 44);
	appendLittleU32(bytes, 32U);
	appendLittleU32(bytes, 4U);
	bytes.appendBytes(Bytes.fromString("DXT1"));
	appendZeroes(bytes, 20);
	appendLittleU32(bytes, 0x1000U);
	appendZeroes(bytes, 16);
	appendLittleU16(bytes, 0xf800);
	appendLittleU16(bytes, 0x0000);
	appendLittleU32(bytes, 0U);
	return bytes;
}

int main() {
	MacOsEncodedImageDecoder decoder = MacOsEncodedImageDecoder();
	EncodedImageDecodeLimits limits = EncodedImageDecodeLimits(1024, 4, 4, 16LL);
	Bytes png = pngFixture();
	EncodedImageDecodeOutcome decodedPng = decoder.decode(png, limits);
	assert(decodedPng.succeeded() && decodedPng.inputBytes() == 78 && decodedPng.decodedBytes() == 16ULL && png.get(0) == 137);
	Image image = decodedPng.image();
	assert(image.width == 2 && image.height == 2);
	assert(image.pixel(0, 0).equals(RGBA(255, 0, 0, 255)));
	assert(image.pixel(1, 0).equals(RGBA(0, 255, 0, 128)));
	assert(image.pixel(0, 1).alpha == 0);
	assert(image.pixel(1, 1).equals(RGBA(255, 255, 255, 64)));

	EncodedImageDecodeOutcome decodedJpeg = decoder.decode(jpegFixture(), limits);
	assert(decodedJpeg.succeeded() && decodedJpeg.image().width == 2 && decodedJpeg.image().height == 2);
	EncodedImageDecodeOutcome decodedGif = decoder.decode(gifFixture(), limits);
	assert(decodedGif.succeeded() && decodedGif.image().width == 1 && decodedGif.image().height == 1);
	EncodedImageDecodeOutcome decodedDds = decoder.decode(dxt1Fixture(), limits);
	assert(decodedDds.succeeded() && decodedDds.image().pixel(3, 3).equals(RGBA(255, 0, 0, 255)));

	assert(decoder.decode(png, EncodedImageDecodeLimits(1024, 1, 2, 2LL)).status() == ENCODED_IMAGE_DECODE_LIMIT_EXCEEDED);
	assert(decoder.decode(png, EncodedImageDecodeLimits(77, 4, 4, 16LL)).status() == ENCODED_IMAGE_DECODE_LIMIT_EXCEEDED);
	assert(decoder.decode(png.slice(0, 24), limits).status() == ENCODED_IMAGE_DECODE_CORRUPT);
	assert(decoder.decode(Bytes.fromString("not an image"), limits).status() == ENCODED_IMAGE_DECODE_UNSUPPORTED);
	for (int iteration = 0; iteration < 64; iteration++) { assert(decoder.decode(png, limits).succeeded()); }
	print("PASS MacOsEncodedImageDecoderConformance");
	return 0;
}
