import Library.Bytes;
import Library.Strings;

import ./TLS13CertificateRequest.btrc;

int main(int argc, char** argv) {
	for (int i = 1; i < argc; i++) {
		var body = Bytes.fromHex(Strings.copy(argv[i]));
		if (body == null) { return 2; }
		print(TLS13CertificateRequest.valid(body) ? "valid" : "invalid");
	}
	return 0;
}
