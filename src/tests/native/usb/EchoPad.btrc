/* The emulated device the USB tests plug in. */

import Library.Bytes;
import Library.USB.USBDescriptors;
import Library.USB.USBVirtualDevice;

/* A vendor-defined HID device: it keeps one feature report, and answers each
 * packet written to endpoint 1 with one packet that counts and echoes it. */
class EchoPad implements IUSBFunction {
	private Bytes feature;
	private Bytes echo;
	private int due = 0;
	private int count = 0;

	public EchoPad() {
		self.feature = Bytes();
		self.echo = Bytes();
	}

	class Bytes reportDescriptor() {
		Bytes descriptor = Bytes();
		int items[23] = {0x06, 0x00, 0xFF, 0x09, 0x01, 0xA1, 0x01, 0x15, 0x00, 0x26, 0xFF, 0x00, 0x75, 0x08, 0x95, 0x08, 0x09, 0x01, 0x81, 0x02, 0x09, 0x01, 0x91};
		for (int index = 0; index < 23; index++) { descriptor.append(items[index]); }
		descriptor.append(0x02);
		descriptor.append(0xC0);
		return descriptor;
	}

	class USBDeviceDescription description() { return USBDeviceDescription(0x1209, 0x0001, 0x0100).named("btrc", "Echo Pad", "ECHO0001").add(USBInterface(0, 3, 0, 0).hid(EchoPad.reportDescriptor().length()).endpoint(USBEndpoint(0x81, USB_TRANSFER_INTERRUPT, 64, 1)).endpoint(USBEndpoint(0x01, USB_TRANSFER_INTERRUPT, 64, 1))); }

	public int control(USBSetup setup, Bytes data) {
		if (setup.scope() == USB_REQUEST_STANDARD && setup.request == USB_REQUEST_GET_DESCRIPTOR && (setup.value >> 8) == USB_DESCRIPTOR_HID_REPORT) {
			Bytes descriptor = EchoPad.reportDescriptor();
			data.appendBytes(descriptor);
			return descriptor.length();
		}
		if (setup.scope() != USB_REQUEST_CLASS) { return USB_CONTROL_STALL; }
		/* HID SET_REPORT and GET_REPORT for the feature report. */
		if (setup.request == 0x09 && (setup.value >> 8) == 3) {
			self.feature = data.slice(0, data.length());
			return data.length();
		}
		if (setup.request == 0x01 && (setup.value >> 8) == 3) {
			data.appendBytes(self.feature);
			return self.feature.length();
		}
		if (setup.request == 0x0A) { return 0; }
		return USB_CONTROL_STALL;
	}

	public bool produce(int endpoint, Bytes packet) {
		if (endpoint != 0x81 || self.due == 0) { return false; }
		self.due--;
		packet.append(self.count);
		packet.appendBytes(self.echo);
		return true;
	}

	public void consume(int endpoint, Bytes packet) {
		if (endpoint != 0x01) { return; }
		self.echo = packet.slice(0, packet.length());
		self.count++;
		self.due++;
	}
}
