import Library.Audio;
import Library.Audio.AudioDevice;
import Library.Audio.RealtimeAudio;
import Library.Console;
import Library.Strings;
import Library.Timer;

#include <assert.h>

@realtime void pluginRouteProcess(void* context, struct AudioBlockView block, RealtimeAudioInputSamples input, RealtimeAudioOutputSamples output) {
	Atomic<uint>* count = (Atomic<uint>*)context;
	int frames = block.frameCount;
	for (int frame = 0; frame < frames; frame++) {
		size_t offset = (size_t)frame * (size_t)2;
		output.trySet(offset, 0.25f);
		output.trySet(offset + (size_t)1, -0.5f);
	}
	count->fetchAdd(1u, MemoryOrder.RELAXED);
}

int main() {
	string id = Strings.copy(getenv("BTRC_PCM_ID"));
	var opened = Audio.createDevice();
	if (!opened.succeeded()) { Console.log("PCM unavailable"); return 3; }
	var provider = opened.provider();
	var found = provider.inventory();
	if (!found.succeeded() || found.inventory().find(id) == null) {
		assert(provider.close().succeeded());
		Console.log("PCM unavailable");
		return 3;
	}
	var inventory = found.inventory();
	var fallback = inventory.defaultOutput();
	assert(fallback != null && fallback.id() == "default");
	Atomic<uint> count;
	count.store(0u, MemoryOrder.RELAXED);
	var request = DuplexAudioOpenRequest.outputOnly(inventory.generation(), id, AudioChannelSelection.leading(2), AudioStreamRequest(48000, 256));
	var stream = provider.openDuplex(request, RealtimeAudioProgram(pluginRouteProcess, &count));
	assert(stream.succeeded());
	var session = stream.session();
	assert(session.start().succeeded());
	for (int i = 0; i < 400 && count.load(MemoryOrder.RELAXED) < 32u; i++) { Timer.sleepMillis(5); }
	assert(session.suspend().succeeded() && session.drain().succeeded() && session.close().succeeded());
	assert(count.load(MemoryOrder.RELAXED) >= 32u && provider.close().succeeded());
	Console.log("PASS: configured device " + id);
	return 0;
}
