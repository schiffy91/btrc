/* The ALSA provider against the machine's default PCM: inventory, a duplex
 * or output-only session, realtime blocks with monotonic clocks, and the
 * suspend/drain/close barrier before the provider closes. */
import Library.Audio.Audio;
import Library.Audio.AudioDevice;
import Library.Audio.RealtimeAudio;
import Library.Datetime;
import Library.Console;

#include <assert.h>

struct BlockLog { unsigned long long blocks; unsigned long long lastOutputFrame; unsigned long long epoch; int badFrames; int inputBlocks; int framesPerBlock; int flaggedBlocks; };

@realtime void logProcess(void* context, struct AudioBlockView block, RealtimeAudioInputSamples input, RealtimeAudioOutputSamples output) {
	struct BlockLog* state = (struct BlockLog*)context;
	if (state->blocks > 0ULL && block.outputDeviceFrame != state->lastOutputFrame + (unsigned long long)state->framesPerBlock) { state->badFrames++; }
	state->lastOutputFrame = block.outputDeviceFrame;
	state->epoch = block.streamEpoch;
	state->blocks++;
	if (block.inputChannelCount > 0) { state->inputBlocks++; }
	if (block.flags != 0u) { state->flaggedBlocks++; }
	int samples = block.frameCount * block.outputChannelCount;
	for (int index = 0; index < samples; index++) { output.trySet((size_t)index, 0.0f); }
}

int main() {
	var opened = Audio.createDevice();
	assert(opened.succeeded());
	var provider = opened.provider();
	var inventoried = provider.inventory();
	assert(inventoried.succeeded());
	var inventory = inventoried.inventory();
	assert(inventory.count() > 0);
	var output = inventory.defaultOutput();
	assert(output != null);
	assert(output.streamCapability().isKnown());
	var input = inventory.defaultInput();
	struct BlockLog state = {0ULL, 0ULL, 0ULL, 0, 0, 128, 0};
	var program = RealtimeAudioProgram(logProcess, &state);
	var stream = AudioStreamRequest(48000, 128);
	var request = input == null ? DuplexAudioOpenRequest.outputOnly(inventory.generation(), output.id(), AudioChannelSelection.leading(2), stream) : DuplexAudioOpenRequest.duplex(inventory.generation(), input.id(), AudioChannelSelection.leading(1), output.id(), AudioChannelSelection.leading(2), stream);
	var session = provider.openDuplex(request, program);
	assert(session.succeeded());
	var duplex = session.session();
	assert(duplex.format().bufferFrames() == 128);
	assert(duplex.format().outputFormat().sampleRate() == 48000);
	assert(provider.openDuplex(request, program).status() == AUDIO_DEVICE_BUSY);
	assert(duplex.start().succeeded());
	assert(duplex.streamEpoch() != 0ULL);
	Timer.sleepMillis(600);
	assert(duplex.suspend().succeeded());
	assert(duplex.drain().succeeded());
	assert(duplex.close().succeeded());
	assert(!duplex.isOpen());
	assert(state.blocks > 100ULL);
	assert(state.badFrames == 0);
	/* Only the first block after start is a discontinuity; a steady stream has no xruns. */
	assert(state.flaggedBlocks == 1);
	assert(state.epoch == duplex.streamEpoch());
	if (input != null) { assert(state.inputBlocks > 100); }
	var stale = DuplexAudioOpenRequest.outputOnly(inventory.generation() + 5ULL, output.id(), AudioChannelSelection.leading(2), stream);
	assert(provider.openDuplex(stale, program).status() == AUDIO_DEVICE_STALE_INVENTORY);
	assert(provider.close().succeeded());
	assert(!provider.isOpen());
	Console.log("PASS: linux audio session");
	return 0;
}
