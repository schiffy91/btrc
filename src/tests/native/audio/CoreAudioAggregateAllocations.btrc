import Library.Audio.MacOS.MacOSAudioDevice;

#include <assert.h>

void requireUnavailableDictionary(CoreAudioAggregateDescription description) {
	bool rejected = false;
	try { description.dictionary(); }
	catch (string error) {
		assert(error == "CoreAudio aggregate description is unavailable");
		rejected = true;
	}
	assert(rejected);
}

int prepareDescription(int failure) {
	aggregateAllocationFailure(failure);
	var description = CoreAudioAggregateDescription();
	requireUnavailableDictionary(description);
	assert(!description.prepare("", "device-b"));
	requireUnavailableDictionary(description);
	assert(description.prepare("device-a", "device-b") == (failure == 0));
	if (failure == 0) {
		var dictionary = description.dictionary();
		assert(dictionary != null && CFDictionaryGetCount(dictionary) > 0L);
	} else { requireUnavailableDictionary(description); }
	assert(!description.prepare("device-a", "device-b"));
	if (failure != 0) { requireUnavailableDictionary(description); }
	return aggregateAllocationCalls();
}

int main() {
	int calls = prepareDescription(0);
	assert(calls > 0 && aggregateOwnedReferences() == 0);
	for (int failure = 1; failure <= calls; failure++) {
		prepareDescription(failure);
		assert(aggregateOwnedReferences() == 0);
	}
	print("PASS: CoreAudio aggregate releases every partial allocation");
	return 0;
}
