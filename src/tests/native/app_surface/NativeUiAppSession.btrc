import Library.App;
import Library.GPU;
import Library.Image;
import Library.NativeUI;
import Library.NativeUIApp;
import Library.Vector;

#include <assert.h>
#include "fake_app_gpu_runtime.h"

void fake_platform_reset();
void fake_gpu_set_next_frame(int status);
int fake_native_ui_upload_count();
int fake_native_ui_chevron_count();
int fake_native_ui_chevron_expanded();
int fake_native_ui_first_rect_red();
int fake_native_ui_first_rect_green();
int fake_native_ui_first_rect_blue();
int fake_native_ui_first_rect_alpha();
int fake_gpu_frame_begin_count();
int fake_gpu_frame_present_count();
string fake_platform_lifecycle();
int fake_platform_live_resources();

NativeUIEventBatch clickEditAction(NativeUIAppSession session, NativeUITextEditAction action) {
	NativeUITextMenu menu = session.input().textMenu();
	assert(menu != null);
	NativeUIRect row = menu.geometry.optionBounds((int)action);
	AppWindowEvent pointer = AppWindowEvent(APP_EVENT_POINTER);
	pointer.pointer = AppPointerEvent(APP_POINTER_PRESSED, APP_POINTER_BUTTON_PRIMARY, (float)(row.x + 2), (float)(row.y + 2), AppKeyModifiers(false, false, false, false));
	assert(session.dispatch(pointer).eventCount() == 0);
	pointer.pointer = AppPointerEvent(APP_POINTER_RELEASED, APP_POINTER_BUTTON_PRIMARY, (float)(row.x + 2), (float)(row.y + 2), AppKeyModifiers(false, false, false, false));
	return session.dispatch(pointer);
}

void verifyLeadingInput(NativeUIAppSession session) {
	Image icon = Image(32, 34);
	icon.setPixel(0, 0, RGBA(220, 30, 40));
	NativeUIElement input = NativeUIElement.textInput("icon-search", "Hello", "Search", 64).style("height: 35px; padding: 1px; padding-left: 12px; padding-right: 12px").leadingIcon(icon, 16, 17, 11).imageRevision(1ULL);
	int uploads = fake_native_ui_upload_count();
	assert(session.present(input).kind == NATIVE_UI_PRESENTED);
	assert(fake_native_ui_upload_count() == uploads + 1);
	assert(session.input().currentFrame().boxCount() == 1);
	NativeUILayoutBox box = session.input().currentFrame().boxFor("icon-search");
	assert(box.style.paddingLeft() == 39 && NativeUITextInput.iconBounds(box).x == 12);
	AppWindowEvent pointer = AppWindowEvent(APP_EVENT_POINTER);
	pointer.pointer = AppPointerEvent(APP_POINTER_PRESSED, APP_POINTER_BUTTON_PRIMARY, 20.0f, 17.0f, AppKeyModifiers(false, false, false, false));
	session.dispatch(pointer);
	pointer.pointer = AppPointerEvent(APP_POINTER_RELEASED, APP_POINTER_BUTTON_PRIMARY, 20.0f, 17.0f, AppKeyModifiers(false, false, false, false));
	session.dispatch(pointer);
	assert(session.input().focusedId() == "icon-search" && session.input().focusedCaret() == 0);
	assert(session.present(input).kind == NATIVE_UI_PRESENTED);
	assert(fake_native_ui_upload_count() == uploads + 1);
	assert(session.present(input.copy().imageRevision(2ULL)).kind == NATIVE_UI_PRESENTED);
	assert(fake_native_ui_upload_count() == uploads + 2);
}

int main() {
	fake_platform_reset();
	Application application = Application();
	assert(application.isOpen());
	AppWindowOpenOutcome opened = application.openWindow(AppWindowDescriptor("native UI", 240, 120));
	assert(opened.kind == APP_WINDOW_OPENED);
	ApplicationWindow window = opened.window;
	AppSurfaceOpenOutcome surfaceOpened = window.surface();
	assert(surfaceOpened.kind == APP_SURFACE_OPENED);
	AppSurfaceAttachment surface = surfaceOpened.surface;
	GPUAttachOutcome attached = GPU.attach(surface);
	assert(attached.kind == GPU_ATTACHED);
	GPU gpu = attached.gpu;

	NativeUIStyleSheet sheet = NativeUIStyleSheet().rule("root", "gap: 6px; padding: 6px").rule("card", "border-radius: 6px; background-image: linear-gradient(#303030,#242424); color: #ffffff; font-size: 18px; line-height: 22px; font-weight: 600; text-align: center");
	NativeUITypography typography = NativeUITypography();
	NativeUIAppAttachOutcome uiAttached = NativeUIAppSession.attach(window, gpu, sheet, null, typography);
	assert(uiAttached.kind == NATIVE_UI_APP_ATTACHED);
	NativeUIAppSession session = uiAttached.session;
	NativeUIPresentOutcome styledButtonPresented = session.present(NativeUIElement.button("styled-button", "").style("padding: 0px; border-radius: 0px; background-color: #393c43ff; color: #ffffffff"));
	assert(styledButtonPresented.kind == NATIVE_UI_PRESENTED);
	assert(fake_native_ui_first_rect_red() == 57 && fake_native_ui_first_rect_green() == 60 && fake_native_ui_first_rect_blue() == 67 && fake_native_ui_first_rect_alpha() == 255);

	Image artwork = Image(2, 2);
	artwork.setRGBA(0, 0, 220, 40, 20, 255);
	NativeUISemanticRange transportRange = NativeUISemanticRange.horizontal("Song position", 0LL, 1000LL, 100LL, 5LL, 50LL);
	NativeUIElement root = NativeUIElement.column("library").className("root").child(NativeUIElement.text("transport-range", "Albums").semanticRange(transportRange)).child(NativeUIElement.textInput("query", "a", "Search albums", 16)).child(NativeUIElement.button("album:one", "Album One").className("card").child(NativeUIElement.image("art:one", artwork, "Album One").imageRevision(1ULL)));

	NativeUIPresentOutcome first = session.present(root);
	assert(first.kind == NATIVE_UI_PRESENTED);
	assert(first.frame.ok());
	assert(first.frame.image.isEmpty());
	assert(session.commandCount() > 0);
	assert(session.cachedImageCount() == 1);
	assert(fake_native_ui_upload_count() == 1);
	assert(fake_gpu_frame_begin_count() == 2);
	assert(fake_gpu_frame_present_count() == 2);
	NativeUIPrepareOutcome retained = session.prepareCurrent(true);
	assert(retained.kind == NATIVE_UI_PREPARED && retained.frame == first.frame);
	assert(retained.layoutMilliseconds == 0.0f);
	assert(fake_gpu_frame_begin_count() == 2 && fake_gpu_frame_present_count() == 2);

	NativeUIPresentOutcome unchanged = session.present(root);
	assert(unchanged.kind == NATIVE_UI_PRESENTED);
	assert(fake_native_ui_upload_count() == 1);
	NativeUIPrepareOutcome immutableFirst = session.prepareImmutable(root, true);
	assert(immutableFirst.kind == NATIVE_UI_PREPARED && immutableFirst.measuredNodes == immutableFirst.frame.boxCount() && immutableFirst.reusedNodes == 0);
	NativeUIPrepareOutcome immutableAgain = session.prepareImmutable(root, true);
	assert(immutableAgain.kind == NATIVE_UI_PREPARED && immutableAgain.measuredNodes == 0 && immutableAgain.reusedNodes == immutableAgain.frame.boxCount());

	Vector<NativeUISelectOption> monitorOptions = [];
	monitorOptions.push(NativeUISelectOption("song-effects", "Song effects"));
	monitorOptions.push(NativeUISelectOption("raw-signal", "Raw signal"));
	NativeUIElement monitorRoot = NativeUIElement.column("settings").className("root").child(NativeUIElement.select("monitor", NativeUISelect(monitorOptions, "song-effects")).semantics(NativeUISemantics(NATIVE_UI_SEMANTIC_ROLE_AUTOMATIC, "Monitor")));
	assert(session.present(monitorRoot).kind == NATIVE_UI_PRESENTED);
	int collapsedSelectCommands = session.commandCount();
	assert(fake_native_ui_chevron_count() == 1 && fake_native_ui_chevron_expanded() == 0);
	NativeUILayoutBox monitor = session.input().currentFrame().boxFor("monitor");
	fake_platform_push_pointer(APP_POINTER_PRESSED, APP_POINTER_BUTTON_PRIMARY, (float)(monitor.bounds.x + 4), (float)(monitor.bounds.y + 4), 0);
	assert(session.dispatch(application.poll()).eventCount() <= 1);
	fake_platform_push_pointer(APP_POINTER_RELEASED, APP_POINTER_BUTTON_PRIMARY, (float)(monitor.bounds.x + 4), (float)(monitor.bounds.y + 4), 0);
	assert(session.dispatch(application.poll()).eventCount() == 0);
	assert(session.input().expandedSelectId() == "monitor");
	NativeUIFrame expandedMonitor = session.input().currentFrame();
	assert(session.prepareCurrent().frame == expandedMonitor);
	assert(session.commandCount() > collapsedSelectCommands);
	NativeUIEventBatch closedByScroll = session.input().scrollBy(0, 1);
	assert(session.input().expandedSelectId().isEmpty());
	assert(closedByScroll.frame.boxFor("monitor").resolvedSemantics().expansionState() == NATIVE_UI_SEMANTIC_EXPANSION_OFF);
	assert(expandedMonitor.boxFor("monitor").resolvedSemantics().expansionState() == NATIVE_UI_SEMANTIC_EXPANSION_ON);
	assert(session.prepareCurrent().kind == NATIVE_UI_PREPARED);
	assert(session.input().activate("monitor").eventCount() == 0);
	assert(session.present(monitorRoot).kind == NATIVE_UI_PRESENTED);
	assert(session.commandCount() > collapsedSelectCommands);
	assert(fake_native_ui_chevron_count() == 1 && fake_native_ui_chevron_expanded() == 1);
	NativeUISelectPopup monitorPopup = session.input().selectPopup();
	assert(monitorPopup.visible() && monitorPopup.ownerId() == "monitor");
	NativeUIRect rawSignalOption = monitorPopup.optionBounds(1);
	int rawSignalX = rawSignalOption.x + 4;
	int rawSignalY = rawSignalOption.y + rawSignalOption.height / 2;
	fake_platform_push_pointer(APP_POINTER_PRESSED, APP_POINTER_BUTTON_PRIMARY, (float)rawSignalX, (float)rawSignalY, 0);
	session.dispatch(application.poll());
	fake_platform_push_pointer(APP_POINTER_RELEASED, APP_POINTER_BUTTON_PRIMARY, (float)rawSignalX, (float)rawSignalY, 0);
	NativeUIEventBatch monitorSelected = session.dispatch(application.poll());
	assert(monitorSelected.eventCount() == 1);
	assert(monitorSelected.eventAt(0).kind() == NATIVE_UI_SELECTION_CHANGED);
	assert(monitorSelected.eventAt(0).elementId() == "monitor");
	assert(monitorSelected.eventAt(0).value() == "raw-signal");
	NativeUIElement rawMonitorRoot = NativeUIElement.column("settings").className("root").child(NativeUIElement.select("monitor", NativeUISelect(monitorOptions, "raw-signal")).semantics(NativeUISemantics(NATIVE_UI_SEMANTIC_ROLE_AUTOMATIC, "Monitor")));
	assert(session.present(rawMonitorRoot).kind == NATIVE_UI_PRESENTED);
	NativeUILayoutBox rawMonitor = session.input().currentFrame().boxFor("monitor");
	assert(rawMonitor.resolvedSemantics().value() == "Raw signal");
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_DOWN, 0);
	assert(session.dispatch(application.poll()).eventCount() == 0);
	assert(session.input().expandedSelectId() == "monitor");
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_UP, 0);
	assert(session.dispatch(application.poll()).eventCount() == 0);
	assert(session.input().highlightedSelectIndex() == 0);
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_ENTER, 0);
	NativeUIEventBatch keyboardMonitorSelected = session.dispatch(application.poll());
	assert(keyboardMonitorSelected.eventCount() == 1);
	assert(keyboardMonitorSelected.eventAt(0).kind() == NATIVE_UI_SELECTION_CHANGED);
	assert(keyboardMonitorSelected.eventAt(0).value() == "song-effects");
	assert(session.input().expandedSelectId().isEmpty());
	assert(session.input().focusedId() == "monitor");
	assert(session.present(root).kind == NATIVE_UI_PRESENTED);

	NativeUILayoutBox query = session.input().currentFrame().boxFor("query");
	AppWindowEvent focusQuery = AppWindowEvent(APP_EVENT_POINTER);
	focusQuery.pointer = AppPointerEvent(APP_POINTER_PRESSED, APP_POINTER_BUTTON_PRIMARY, (float)(query.bounds.x + query.bounds.width - 3), (float)(query.bounds.y + 2), AppKeyModifiers(false, false, false, false));
	assert(session.dispatch(focusQuery).eventCount() <= 1);
	assert(session.input().focusedId() == "query");
	session.input().pointerReleased(query.bounds.x + query.bounds.width - 3, query.bounds.y + 2);

	fake_platform_push_text("\xc3\xa9");
	AppWindowEvent enteredText = application.poll();
	assert(enteredText.kind == APP_EVENT_TEXT);
	NativeUIEventBatch entered = session.dispatch(enteredText);
	assert(entered.eventCount() == 1);
	assert(entered.eventAt(0).kind() == NATIVE_UI_VALUE_CHANGED);
	assert(entered.eventAt(0).elementId() == "query");
	assert(entered.eventAt(0).value() == "a\xc3\xa9");

	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_LEFT, 0);
	assert(session.dispatch(application.poll()).eventCount() == 0);
	fake_platform_push_text("Z");
	NativeUIEventBatch inserted = session.dispatch(application.poll());
	assert(inserted.eventCount() == 1);
	assert(inserted.eventAt(0).value() == "aZ\xc3\xa9");
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_BACKSPACE, 0);
	NativeUIEventBatch removed = session.dispatch(application.poll());
	assert(removed.eventCount() == 1);
	assert(removed.eventAt(0).value() == "a\xc3\xa9");
	fake_platform_push_text("\xc3");
	assert(session.dispatch(application.poll()).eventCount() == 0);
	assert(session.input().focusedValue() == "a\xc3\xa9");
	focusQuery.pointer = AppPointerEvent(APP_POINTER_PRESSED, APP_POINTER_BUTTON_PRIMARY, (float)(query.bounds.x + query.style.paddingLeft() + 1), (float)(query.bounds.y + 2), AppKeyModifiers(false, false, false, false), 2);
	session.dispatch(focusQuery);
	assert(session.input().selectedText() == "a\xc3\xa9");
	session.input().pointerReleased(query.bounds.x + query.style.paddingLeft() + 1, query.bounds.y + 2);
	assert(session.input().selectedText() == "a\xc3\xa9");
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_A, 8);
	assert(session.dispatch(application.poll()).eventCount() == 0);
	assert(session.input().selectedText() == "a\xc3\xa9");
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_C, 8);
	assert(session.dispatch(application.poll()).eventCount() == 0);
	assert(window.clipboardText().text == "a\xc3\xa9");
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_X, 8);
	assert(session.dispatch(application.poll()).eventAt(0).value() == "");
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_Z, 8);
	assert(session.dispatch(application.poll()).eventAt(0).value() == "a\xc3\xa9");
	assert(session.input().selectedText() == "a\xc3\xa9");
	fake_platform_push_keyboard(APP_KEY_RELEASED, APP_KEY_Z, 8);
	assert(session.dispatch(application.poll()).eventCount() == 0);
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_Z, 9);
	assert(session.dispatch(application.poll()).eventAt(0).value() == "");
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_V, 8);
	assert(session.dispatch(application.poll()).eventAt(0).value() == "a\xc3\xa9");
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_Z, 8);
	assert(session.dispatch(application.poll()).eventAt(0).value() == "");
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_Z, 9);
	assert(session.dispatch(application.poll()).eventAt(0).value() == "a\xc3\xa9");
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_LEFT, 1);
	assert(session.dispatch(application.poll()).eventCount() == 0);
	assert(session.input().selectedText() == "\xc3\xa9");
	assert(session.prepareCurrent().kind == NATIVE_UI_PREPARED);
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_BACKSPACE, 4);
	assert(session.dispatch(application.poll()).eventAt(0).value() == "a");
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_BACKSPACE, 8);
	assert(session.dispatch(application.poll()).eventAt(0).value() == "");
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_V, 8);
	assert(session.dispatch(application.poll()).eventAt(0).value() == "a\xc3\xa9");

	fake_platform_push_surface(APP_EVENT_RESIZED, 320, 240, 640, 480, 2.0f, 2.0f);
	session.dispatch(application.poll());
	query = session.input().currentFrame().boxFor("query");
	session.input().selectAllText();
	AppWindowEvent contextClick = AppWindowEvent(APP_EVENT_POINTER);
	contextClick.pointer = AppPointerEvent(APP_POINTER_PRESSED, APP_POINTER_BUTTON_SECONDARY, (float)(query.bounds.x + query.style.paddingLeft() + 1), (float)(query.bounds.y + 2), AppKeyModifiers(false, false, false, false));
	session.dispatch(contextClick);
	assert(session.input().textMenu() != null && session.input().selectedText() == "a\xc3\xa9");
	assert(session.prepareCurrent().kind == NATIVE_UI_PREPARED);
	assert(clickEditAction(session, NATIVE_UI_TEXT_EDIT_COPY).eventCount() == 0);
	assert(window.clipboardText().text == "a\xc3\xa9" && session.input().textMenu() == null);
	session.dispatch(contextClick);
	assert(clickEditAction(session, NATIVE_UI_TEXT_EDIT_CUT).eventAt(0).value() == "");
	assert(window.clipboardText().text == "a\xc3\xa9");
	session.dispatch(contextClick);
	assert(!session.input().textMenu().enabled(NATIVE_UI_TEXT_EDIT_CUT));
	assert(clickEditAction(session, NATIVE_UI_TEXT_EDIT_PASTE).eventAt(0).value() == "a\xc3\xa9");
	session.dispatch(contextClick);
	assert(clickEditAction(session, NATIVE_UI_TEXT_EDIT_SELECT_ALL).eventCount() == 0);
	assert(session.input().selectedText() == "a\xc3\xa9");
	session.dispatch(contextClick);
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_ESCAPE, 0);
	assert(session.dispatch(application.poll()).eventCount() == 0);
	assert(session.input().textMenu() == null && session.input().focusedId() == "query");
	session.dispatch(contextClick);
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_DOWN, 0);
	session.dispatch(application.poll());
	assert(session.input().textMenu().highlighted == NATIVE_UI_TEXT_EDIT_CUT);
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_DOWN, 0);
	session.dispatch(application.poll());
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_ENTER, 0);
	assert(session.dispatch(application.poll()).eventCount() == 0);
	assert(session.input().textMenu() == null && window.clipboardText().text == "a\xc3\xa9");
	fake_platform_push_surface(APP_EVENT_RESIZED, 240, 120, 240, 120, 1.0f, 1.0f);
	session.dispatch(application.poll());

	artwork.setRGBA(0, 0, 10, 200, 30, 255);
	NativeUIElement revisedRoot = NativeUIElement.column("library").className("root").child(NativeUIElement.text("transport-range", "Albums").semanticRange(transportRange)).child(NativeUIElement.textInput("query", "a\xc3\xa9", "Search albums", 16)).child(NativeUIElement.button("album:one", "Album One").className("card").child(NativeUIElement.image("art:one", artwork, "Album One").imageRevision(2ULL)));
	assert(session.present(revisedRoot).kind == NATIVE_UI_PRESENTED);
	assert(fake_native_ui_upload_count() == 2);
	assert(session.input().focusedId() == "query");
	assert(session.input().focusedValue() == "a\xc3\xa9");
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_ESCAPE, 0);
	assert(session.dispatch(application.poll()).eventCount() == 0);
	assert(session.input().focusedId().isEmpty());
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_TAB, 0);
	assert(session.dispatch(application.poll()).eventCount() == 0);
	assert(session.input().focusedId() == "transport-range");
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_TAB, 0);
	assert(session.dispatch(application.poll()).eventCount() == 0);
	assert(session.input().focusedId() == "query");

	NativeUILayoutBox transport = session.input().currentFrame().boxFor("transport-range");
	int transportX = transport.bounds.x + 10;
	int transportY = transport.bounds.y + 4;
	fake_platform_push_pointer(APP_POINTER_PRESSED, APP_POINTER_BUTTON_PRIMARY, (float)transportX, (float)transportY, 0);
	NativeUIEventBatch rangePressed = session.dispatch(application.poll());
	assert(rangePressed.eventCount() >= 1);
	assert(rangePressed.eventAt(rangePressed.eventCount() - 1).kind() == NATIVE_UI_RANGE_POINTER_PRESSED);
	NativeUIPointerSample? optionalPressedPointer = rangePressed.eventAt(rangePressed.eventCount() - 1).pointer();
	assert(optionalPressedPointer != null);
	NativeUIPointerSample pressedPointer = optionalPressedPointer;
	assert(pressedPointer.coordinate() == 10);
	assert(session.input().focusedId() == "transport-range");
	fake_platform_push_pointer(APP_POINTER_MOVED, APP_POINTER_BUTTON_NONE, (float)(transport.bounds.x + transport.bounds.width + 12), (float)transportY, 0);
	NativeUIEventBatch rangeMoved = session.dispatch(application.poll());
	assert(rangeMoved.eventAt(rangeMoved.eventCount() - 1).kind() == NATIVE_UI_RANGE_POINTER_MOVED);
	NativeUIPointerSample? optionalMovedPointer = rangeMoved.eventAt(rangeMoved.eventCount() - 1).pointer();
	assert(optionalMovedPointer != null);
	NativeUIPointerSample movedPointer = optionalMovedPointer;
	assert(movedPointer.coordinate() == transport.bounds.width + 12);
	fake_platform_push_pointer(APP_POINTER_RELEASED, APP_POINTER_BUTTON_PRIMARY, (float)(transport.bounds.x - 7), (float)transportY, 0);
	NativeUIEventBatch rangeReleased = session.dispatch(application.poll());
	assert(rangeReleased.eventAt(rangeReleased.eventCount() - 1).kind() == NATIVE_UI_RANGE_POINTER_RELEASED);
	NativeUIPointerSample? optionalReleasedPointer = rangeReleased.eventAt(rangeReleased.eventCount() - 1).pointer();
	assert(optionalReleasedPointer != null);
	NativeUIPointerSample releasedPointer = optionalReleasedPointer;
	assert(releasedPointer.coordinate() == -7);

	fake_platform_push_pointer(APP_POINTER_MOVED, APP_POINTER_BUTTON_NONE, (float)transportX, (float)transportY, 0);
	session.dispatch(application.poll());
	fake_platform_push_scroll(0.0f, -1.0f);
	NativeUIEventBatch rangeWheel = session.dispatch(application.poll());
	assert(rangeWheel.eventCount() == 1);
	assert(rangeWheel.eventAt(0).kind() == NATIVE_UI_RANGE_WHEEL);
	assert(rangeWheel.eventAt(0).scroll().y() == 40);
	assert(rangeWheel.eventAt(0).rangeAdjustment() == NATIVE_UI_RANGE_ADJUST_SMALL_INCREMENT);
	assert(rangeWheel.eventAt(0).rangeValue() == 105LL);
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_LEFT, 0);
	NativeUIEventBatch smallAdjustment = session.dispatch(application.poll());
	assert(smallAdjustment.eventAt(0).rangeAdjustment() == NATIVE_UI_RANGE_ADJUST_SMALL_DECREMENT);
	assert(smallAdjustment.eventAt(0).rangeValue() == 95LL);
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_RIGHT, 1);
	NativeUIEventBatch largeAdjustment = session.dispatch(application.poll());
	assert(largeAdjustment.eventAt(0).rangeAdjustment() == NATIVE_UI_RANGE_ADJUST_LARGE_INCREMENT);
	assert(largeAdjustment.eventAt(0).rangeValue() == 150LL);
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_RIGHT, 2);
	NativeUIEventBatch maximumAdjustment = session.dispatch(application.poll());
	assert(maximumAdjustment.eventAt(0).rangeAdjustment() == NATIVE_UI_RANGE_ADJUST_MAXIMUM);
	assert(maximumAdjustment.eventAt(0).rangeValue() == 1000LL);
	NativeUISemanticRange verticalTransportRange = NativeUISemanticRange.vertical("Song position", 0LL, 1000LL, 100LL, 5LL, 50LL);
	NativeUIElement verticalRoot = NativeUIElement.column("library").className("root").child(NativeUIElement.text("transport-range", "Albums").semanticRange(verticalTransportRange)).child(NativeUIElement.textInput("query", "a\xc3\xa9", "Search albums", 16)).child(NativeUIElement.button("album:one", "Album One").className("card").child(NativeUIElement.image("art:one", artwork, "Album One").imageRevision(2ULL)));
	assert(session.present(verticalRoot).kind == NATIVE_UI_PRESENTED);
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_UP, 0);
	NativeUIEventBatch verticalSmall = session.dispatch(application.poll());
	assert(verticalSmall.eventAt(0).rangeAdjustment() == NATIVE_UI_RANGE_ADJUST_SMALL_INCREMENT);
	assert(verticalSmall.eventAt(0).rangeValue() == 105LL);
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_DOWN, 1);
	NativeUIEventBatch verticalLarge = session.dispatch(application.poll());
	assert(verticalLarge.eventAt(0).rangeAdjustment() == NATIVE_UI_RANGE_ADJUST_LARGE_DECREMENT);
	assert(verticalLarge.eventAt(0).rangeValue() == 50LL);
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_DOWN, 8);
	NativeUIEventBatch verticalMinimum = session.dispatch(application.poll());
	assert(verticalMinimum.eventAt(0).rangeAdjustment() == NATIVE_UI_RANGE_ADJUST_MINIMUM);
	assert(verticalMinimum.eventAt(0).rangeValue() == 0LL);
	assert(session.present(revisedRoot).kind == NATIVE_UI_PRESENTED);

	NativeUILayoutBox button = session.input().currentFrame().boxFor("album:one");
	int pointerX = button.bounds.x + 2;
	int pointerY = button.bounds.y + 2;
	AppWindowEvent press = AppWindowEvent(APP_EVENT_POINTER);
	press.pointer = AppPointerEvent(APP_POINTER_PRESSED, APP_POINTER_BUTTON_PRIMARY, (float)pointerX, (float)pointerY, AppKeyModifiers(false, false, false, false));
	NativeUIEventBatch pressed = session.dispatch(press);
	assert(pressed.eventCount() <= 2);
	AppWindowEvent releasedEvent = AppWindowEvent(APP_EVENT_POINTER);
	releasedEvent.pointer = AppPointerEvent(APP_POINTER_RELEASED, APP_POINTER_BUTTON_PRIMARY, (float)pointerX, (float)pointerY, AppKeyModifiers(false, false, false, false));
	NativeUIEventBatch clicked = session.dispatch(releasedEvent);
	assert(clicked.eventCount() >= 1);
	assert(clicked.eventAt(clicked.eventCount() - 1).kind() == NATIVE_UI_CLICKED);
	assert(clicked.eventAt(clicked.eventCount() - 1).elementId() == "album:one");
	assert(session.input().focusedId() == "album:one");
	fake_platform_push_keyboard(APP_KEY_PRESSED, APP_KEY_ENTER, 0);
	NativeUIEventBatch keyboardActivated = session.dispatch(application.poll());
	assert(keyboardActivated.eventCount() == 1);
	assert(keyboardActivated.eventAt(0).kind() == NATIVE_UI_CLICKED);
	assert(keyboardActivated.eventAt(0).elementId() == "album:one");

	NativeUIElement floatingButton = NativeUIElement.button("floating-control", "").style("padding: 0px; width: 40px; height: 36px; border-color: #112233; background-color: #445566").floating(10, 10).child(NativeUIElement.image("floating-icon", artwork, "Icon").style("padding: 0px; width: 8px; height: 8px").floating(4, 4));
	NativeUIElement floatingRoot = NativeUIElement.column("floating-root").style("padding: 0px; gap: 0px").child(floatingButton);
	NativeUIPresentOutcome floatingPresented = session.present(floatingRoot);
	assert(floatingPresented.kind == NATIVE_UI_PRESENTED && floatingPresented.frame.contentHeight == 1);
	assert(fake_native_ui_first_rect_red() == 17 && fake_native_ui_first_rect_green() == 34 && fake_native_ui_first_rect_blue() == 51);
	assert(floatingPresented.frame.hitId(15, 15, true) == "floating-control");
	fake_platform_push_pointer(APP_POINTER_PRESSED, APP_POINTER_BUTTON_PRIMARY, 15.0f, 15.0f, 0);
	session.dispatch(application.poll());
	fake_platform_push_pointer(APP_POINTER_RELEASED, APP_POINTER_BUTTON_PRIMARY, 15.0f, 15.0f, 0);
	NativeUIEventBatch floatingClicked = session.dispatch(application.poll());
	assert(floatingClicked.eventCount() == 1 && floatingClicked.eventAt(0).elementId() == "floating-control");

	NativeUIElement duplicate = NativeUIElement.column("duplicate").child(NativeUIElement.text("same", "one")).child(NativeUIElement.text("same", "two"));
	int framesBeforeReject = fake_gpu_frame_begin_count();
	NativeUIPresentOutcome rejected = session.present(duplicate);
	assert(rejected.kind == NATIVE_UI_PRESENT_PREPARE_REJECTED);
	assert(rejected.frame.status == NATIVE_UI_FRAME_INVALID_TREE);
	assert(fake_gpu_frame_begin_count() == framesBeforeReject);

	NativeUIPresentOutcome invalidInput = session.present(NativeUIElement.textInput("invalid-input", "\xc3", "", 8));
	assert(invalidInput.kind == NATIVE_UI_PRESENT_PREPARE_REJECTED);
	assert(invalidInput.frame.status == NATIVE_UI_FRAME_INVALID_TREE);
	assert(fake_gpu_frame_begin_count() == framesBeforeReject);

	fake_gpu_set_next_frame(GPU_FRAME_OUTDATED);
	NativeUIPresentOutcome deferred = session.present(revisedRoot);
	assert(deferred.kind == NATIVE_UI_PRESENT_DEFERRED);
	assert(deferred.gpuFrame == GPU_FRAME_OUTDATED);

	fake_platform_push_pointer(APP_POINTER_PRESSED, APP_POINTER_BUTTON_PRIMARY, (float)transportX, (float)transportY, 0);
	session.dispatch(application.poll());
	NativeUIEventBatch failureCancelled = session.dispatch(AppWindowEvent(APP_EVENT_FAILED));
	assert(failureCancelled.eventCount() == 1);
	assert(failureCancelled.eventAt(0).kind() == NATIVE_UI_RANGE_POINTER_CANCELLED);
	fake_platform_push_pointer(APP_POINTER_PRESSED, APP_POINTER_BUTTON_PRIMARY, (float)transportX, (float)transportY, 0);
	session.dispatch(application.poll());
	fake_platform_push_close();
	NativeUIEventBatch closeCancelled = session.dispatch(application.poll());
	assert(closeCancelled.eventCount() == 1);
	assert(closeCancelled.eventAt(0).kind() == NATIVE_UI_RANGE_POINTER_CANCELLED);
	assert(session.input().pointerCancelled().eventCount() == 0);
	fake_platform_push_pointer(APP_POINTER_PRESSED, APP_POINTER_BUTTON_BACK, 40.0f, 30.0f, 0);
	NativeUIEventBatch back = session.dispatch(application.poll());
	assert(back.eventCount() == 1 && back.eventAt(0).kind() == NATIVE_UI_NAVIGATE_BACK);
	fake_platform_push_pointer(APP_POINTER_RELEASED, APP_POINTER_BUTTON_BACK, 40.0f, 30.0f, 0);
	assert(session.dispatch(application.poll()).eventCount() == 0);
	fake_platform_push_pointer(APP_POINTER_PRESSED, APP_POINTER_BUTTON_FORWARD, 40.0f, 30.0f, 0);
	NativeUIEventBatch forward = session.dispatch(application.poll());
	assert(forward.eventCount() == 1 && forward.eventAt(0).kind() == NATIVE_UI_NAVIGATE_FORWARD);

	verifyLeadingInput(session);
	assert(session.close().kind == GPU_CLOSED);
	assert(gpu.close().kind == GPU_CLOSED);
	assert(surface.close().kind == APP_CLOSED);
	assert(window.close().kind == APP_CLOSED);
	assert(application.close().kind == APP_CLOSED);
	assert(fake_platform_live_resources() == 0);
	assert(fake_platform_lifecycle() == "native-ui,gpu-surface,surface,window,application");

	print("PASS: unified native UI app GPU session");
	return 0;
}
