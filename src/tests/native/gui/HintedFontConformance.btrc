import Library.Bytes;
import Library.GUI.Font;
import Library.GUI.FreeType;
import Library.GUI.IFontFace;
import Library.Vector;

/* The final glyph uses FLIPON, a native fallback instruction. It is reached
 * after loading the supported triangle variants and unlinking the font. */
int main(int argc, char** argv) {
	if (argc != 3) { return 2; }
	var font = FreeType.load(argv[1], 8);
	if (remove(argv[1]) != 0) { return 3; }
	string interpolated = "5e2d04000000fffff8ca982dffffef912900cb630a000000";
	string untouched = "5f2e05000000fffff9cd9b2dffffee8f2600cb6209000000";
	string shifted = "5f2e05000000fffff9cd8920e1a4672a0100";
	// G has two distinct IUP anchors that round to the same 26.6 position.
	string anchors = "0000000d00000035c2f9ac43affeffffffc4fffffffff177ffffdf720e00c75603000000";
	Vector<string> masks = [anchors, interpolated, untouched, shifted, untouched, shifted, untouched];
	int count = argv[2][0] == '6' ? 6 : 5;
	for (int i = 0; i <= count; i++) {
		int codepoint = i == 0 ? 71 : 64 + i;
		var m = font.glyph(codepoint, false);
		var g = font.glyph(codepoint, true);
		var expected = Bytes.fromHex(masks.get(i));
		if (expected == null || m == null || g == null || m.advanceFixed() != 512LL || g.advanceFixed() != 512LL || m.width() != 0 || g.bitmapLeft() != 0 || g.bitmapTop() != (i == 0 ? 6 : 4) || g.width() != 6 || g.rows() * 6 != expected.length() || g.pixelMode() != FONT_PIXEL_GRAY || g.numGrays() != 256) { return 4; }
		for (int j = 0; j < expected.length(); j++) {
			if (g.coverage(j / 6, j % 6) != expected.get(j)) { return 5; }
		}
	}
	if (argv[2][0] == 'u') {
		// The full Unicode map supplies A at U+10000 and U+0041. The BMP
		// table has a different glyph at U+0041.
		var wide = font.glyph(0x10000, true);
		var missing = font.glyph(0x10001, true);
		var expected = Bytes.fromHex(interpolated);
		if (wide == null || missing == null || expected == null || wide.advanceFixed() != 512LL || wide.width() != 6 || wide.rows() != 4 || missing.width() != 0) { return 6; }
		for (int j = 0; j < expected.length(); j++) { if (wide.coverage(j / 6, j % 6) != expected.get(j)) { return 7; } }
	}
	print("PASS: hinted outline snapshots after unlink");
	return 0;
}
