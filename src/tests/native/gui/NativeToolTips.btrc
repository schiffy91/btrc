import Library.Image;
import Library.GUI;
import Library.GUI.IApplication;
import Library.GUI.IWindow;
import Library.GUI.IPanel;
import Library.GUI.IButton;
import Library.GUI.ISlider;

#include <assert.h>

/* Runs on the native loop once the shown window has been dispatched. */
class ToolTipTeardown implements IApplicationWork {
	private IWindow _window;
	private IPanel _background;
	private IButton _button;
	private ISlider _slider;

	public ToolTipTeardown(IWindow window, IPanel background, IButton button, ISlider slider) { self._window = window; self._background = background; self._button = button; self._slider = slider; }

	public void run() {
		assert(self._slider.toolTip().equals("Volume") && self._button.toolTip().equals(""));
		self._background.detach(self._slider);
		self._background.detach(self._button);
		self._slider.close();
		self._button.close();
		assert(self._window.detachRoot() == self._background);
		self._background.close();
		self._window.close();
		GUI.requestQuit();
	}
}

/* Hover help on native controls: set through the portable interfaces, read
 * back from AppKit, replaced and cleared without touching titles or values. */
int main() {
	GUI.initialize();
	var window = GUI.createWindow("Native tool tips", 360.0, 160.0);
	var background = GUI.createPanel(RGBA(30, 30, 30));
	window.attachRoot(background);
	var button = GUI.createButton("Play");
	assert(button.toolTip().equals(""));
	button.setToolTip("Play");
	assert(button.toolTip().equals("Play"));
	assert(button.title().equals("Play"));
	button.setToolTip("Pause");
	assert(button.toolTip().equals("Pause"));
	button.setToolTip("Métronome – on");
	assert(button.toolTip().equals("Métronome – on"));
	background.attach(button);
	button.arrange(20.0, 20.0, 120.0, 30.0);
	assert(button.toolTip().equals("Métronome – on"));
	button.setToolTip("");
	assert(button.toolTip().equals(""));
	var slider = GUI.createSlider(0.0, 100.0);
	assert(slider.toolTip().equals(""));
	slider.setToolTip("Volume");
	assert(slider.toolTip().equals("Volume"));
	slider.setValue(40.0);
	assert(slider.value() == 40.0 && slider.toolTip().equals("Volume"));
	background.attach(slider);
	slider.arrange(20.0, 80.0, 320.0, 30.0);
	window.show();
	GUI.post(ToolTipTeardown(window, background, button, slider));
	GUI.run();
	assert(!window.isOpen() && !background.isOpen() && !button.isOpen() && !slider.isOpen());
	print("PASS: native control tool tips set, replaced and cleared through the portable interfaces");
	return 0;
}
