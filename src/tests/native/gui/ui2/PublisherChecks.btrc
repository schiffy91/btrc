import Library.GUI.ApplicationNativeWake;
import Library.Callback;
import Library.GUI.IApplication;
import Library.GUI.ApplicationPublisher;

#include <assert.h>

class UI2PublicationReceiver implements IApplicationPublicationHandler {
	public int calls = 0;
	public long long value = 0LL;
	public void deliver(ApplicationPublication publication) { self.calls++; self.value = publication.payload; }
}

class UI2ThrowingHost implements IApplicationHost {
	public bool raises = false;
	public int calls = 0;
	public bool requestTurn() { self.calls++; if (self.raises) { throw "deliberate host wake failure"; } return true; }

	public void scheduleTurn(unsigned long long deadline) {}
}

class UI2CancellingPublicationReceiver implements IApplicationPublicationHandler {
	public ApplicationPublisher? publisher;
	public bool cancelDuringDelivery = false;
	public int calls = 0;
	public void deliver(ApplicationPublication publication) {
		var publisher = self.publisher; if (publisher == null) { throw "Missing active publisher"; }
		self.calls++;
		/* Entry has already happened, but this receipt is not terminal yet. */
		assert(publisher.requestCancel(publication.generation, publication.sequence) == PUBLISH_CANCEL_REQUESTED);
		if (self.cancelDuringDelivery) { assert(publisher.cancel() == CALLBACK_CANCELLATION_PENDING); }
	}
}

class UI2PublisherFailureChecks {
	class void cancellationIdentity(IApplicationNativeWake wake) {
		var publisher = ApplicationPublisher(2, wake, null); var receiver = UI2CancellingPublicationReceiver();
		var scope = CallbackScope(); assert(publisher.initialized()); receiver.publisher = publisher;
		publisher.activate(receiver, scope);
		assert(publisher.tryPublish(1LL, 10LL, WORK_SUSPENSION_DEFER, 0LL, 1LL) == PUBLISH_ACCEPTED);
		assert(publisher.requestCancel(1LL, 9LL) == PUBLISH_CANCEL_STALE);
		assert(publisher.deliverOne() && receiver.calls == 1);
		assert(publisher.requestCancel(1LL, 10LL) == PUBLISH_CANCEL_ALREADY_TERMINAL);
		assert(publisher.tryPublish(1LL, 20LL, WORK_SUSPENSION_DEFER, 0LL, 2LL) == PUBLISH_ACCEPTED);
		assert(publisher.deliverOne());
		assert(publisher.tryPublish(1LL, 30LL, WORK_SUSPENSION_DEFER, 0LL, 3LL) == PUBLISH_ACCEPTED);
		assert(publisher.deliverOne() && receiver.calls == 3);
		/* Recent terminal identities are bounded by capacity; unknown or evicted
		 * identities never masquerade as receipts that reached a terminal state. */
		assert(publisher.requestCancel(1LL, 10LL) == PUBLISH_CANCEL_STALE);
		assert(publisher.requestCancel(1LL, 20LL) == PUBLISH_CANCEL_ALREADY_TERMINAL);
		assert(publisher.requestCancel(1LL, 21LL) == PUBLISH_CANCEL_STALE);
		assert(publisher.tryPublish(1LL, 40LL, WORK_SUSPENSION_DEFER, 0LL, 4LL) == PUBLISH_ACCEPTED);
		assert(publisher.requestCancel(1LL, 40LL) == PUBLISH_CANCEL_REQUESTED);
		assert(publisher.requestCancel(1LL, 40LL) == PUBLISH_CANCEL_ALREADY_TERMINAL);
		assert(publisher.acceptedCount() == 4LL && publisher.pendingCount() == 0);
		assert(publisher.retiredCount(APPLICATION_PUBLICATION_DELIVERED) == 3LL && publisher.retiredCount(APPLICATION_PUBLICATION_CANCELLED) == 1LL);
		assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE); receiver.publisher = null;
	}

	class void callbackCancellation(IApplicationNativeWake wake) {
		var publisher = ApplicationPublisher(2, wake, null); var receiver = UI2CancellingPublicationReceiver();
		var scope = CallbackScope(); receiver.publisher = publisher; receiver.cancelDuringDelivery = true;
		publisher.activate(receiver, scope);
		assert(publisher.tryPublish(1LL, 1LL, WORK_SUSPENSION_DEFER, 0LL, 1LL) == PUBLISH_ACCEPTED);
		assert(publisher.deliverOne() && receiver.calls == 1);
		assert(publisher.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE);
		assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE); receiver.publisher = null;
		var rejected = ApplicationPublisher(2, wake, null); bool caught = false;
		try { rejected.activate(receiver, scope); } catch (string error) { caught = true; }
		assert(caught && !rejected.isOpen());
	}

	class void throwingHost(IApplicationNativeWake wake, bool replacement) {
		var host = UI2ThrowingHost(); var publisher = ApplicationPublisher(2, wake, host);
		var receiver = UI2PublicationReceiver(); var scope = CallbackScope();
		assert(publisher.initialized()); publisher.activate(receiver, scope);
		if (replacement) { assert(publisher.tryPublish(1LL, 1LL, WORK_SUSPENSION_DEFER, 1LL, 60LL) == PUBLISH_ACCEPTED); }
		host.raises = true;
		assert(publisher.tryPublish(1LL, 2LL, WORK_SUSPENSION_DEFER, 1LL, 61LL) == (replacement ? PUBLISH_REPLACED : PUBLISH_ACCEPTED));
		assert(publisher.tryPublish(1LL, 3LL, WORK_SUSPENSION_DEFER, 1LL, 62LL) == PUBLISH_CLOSED);
		bool failed = false;
		try { publisher.deliverOne(); } catch (string error) { failed = true; }
		assert(failed && receiver.calls == 0 && host.calls == (replacement ? 2 : 1));
		assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE);
		assert(publisher.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE);
		assert(publisher.cancel() == CALLBACK_CANCELLATION_COMPLETE);
		assert(publisher.tryPublish(1LL, 4LL, WORK_SUSPENSION_DEFER, 1LL, 63LL) == PUBLISH_CLOSED);
		assert(receiver.calls == 0 && host.calls == (replacement ? 2 : 1));
		assert(publisher.pendingCount() == 0 && publisher.acceptedCount() == (replacement ? 2LL : 1LL));
		assert(publisher.retiredCount(APPLICATION_PUBLICATION_FAILED) == 1LL);
		assert(publisher.retiredCount(APPLICATION_PUBLICATION_SUPERSEDED) == (replacement ? 1LL : 0LL));
	}

	class void receipts(IApplicationNativeWake wake) {
		var publisher = ApplicationPublisher(2, wake, null); var receiver = UI2PublicationReceiver(); var scope = CallbackScope();
		assert(publisher.initialized()); publisher.activate(receiver, scope);
		assert(publisher.tryPublish(1LL, 1LL, WORK_SUSPENSION_DEFER, 1LL, 1LL) == PUBLISH_ACCEPTED);
		assert(publisher.tryPublish(1LL, 2LL, WORK_SUSPENSION_DEFER, 1LL, 2LL) == PUBLISH_REPLACED);
		assert(publisher.tryPublish(2LL, 1LL, WORK_SUSPENSION_DEFER, 0LL, 3LL) == PUBLISH_ACCEPTED);
		assert(publisher.tryPublish(1LL, 3LL, WORK_SUSPENSION_DEFER, 0LL, 90LL) == PUBLISH_STALE);
		assert(publisher.deliverOne() && receiver.calls == 1 && receiver.value == 3LL);
		assert(publisher.tryPublish(2LL, 2LL, WORK_SUSPENSION_CANCEL, 0LL, 4LL) == PUBLISH_ACCEPTED);
		publisher.suspend(true); assert(!publisher.deliverOne());
		assert(publisher.tryPublish(2LL, 3LL, WORK_SUSPENSION_DEFER, 0LL, 5LL) == PUBLISH_ACCEPTED);
		assert(publisher.requestCancel(2LL, 3LL) == PUBLISH_CANCEL_REQUESTED);
		assert(publisher.tryPublish(2LL, 4LL, WORK_SUSPENSION_DEFER, 0LL, 6LL) == PUBLISH_ACCEPTED);
		assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE);
		assert(publisher.pendingCount() == 0 && publisher.acceptedCount() == 6LL);
		assert(publisher.retiredCount(APPLICATION_PUBLICATION_DELIVERED) == 1LL);
		assert(publisher.retiredCount(APPLICATION_PUBLICATION_SUPERSEDED) == 1LL);
		assert(publisher.retiredCount(APPLICATION_PUBLICATION_STALE) == 1LL);
		assert(publisher.retiredCount(APPLICATION_PUBLICATION_CANCELLED) == 3LL);
		assert(publisher.retiredCount(APPLICATION_PUBLICATION_FAILED) == 0LL && receiver.calls == 1);
	}
}

