import Library.Callback;
import Library.Vector;
import Library.GUI.ControlEventQueue;

#include <assert.h>
#include <stdio.h>

class QueueSnapshot { public int value; public QueueSnapshot(int value) { self.value = value; } }
interface IQueueReceiver { void receive(QueueSnapshot snapshot); }
class QueueTarget implements IControlEventTarget {
	public bool eligible = true;
	public long long generation = 1LL;
	public ControlEventDisposition admission(long long generation) { return generation != self.generation ? CONTROL_EVENT_STALE_GENERATION : (self.eligible ? CONTROL_EVENT_DELIVERED : CONTROL_EVENT_INELIGIBLE); }
}
class QueueReceiver implements IQueueReceiver {
	public Vector<int> values = [];
	public ICallbackRegistration? cancelDuring = null;
	public bool fail = false;
	public void receive(QueueSnapshot snapshot) {
		self.values.push(snapshot.value);
		if (self.fail) { throw "deliberate semantic failure"; }
		if (self.cancelDuring != null) { var registration = self.cancelDuring; self.cancelDuring = null; assert(registration.cancel() == CALLBACK_CANCELLATION_PENDING); }
	}

	class void deliver(IQueueReceiver receiver, QueueSnapshot snapshot) { receiver.receive(snapshot); }
}

class QueueRetirementReceiver implements IQueueReceiver {
	public ControlEventChannel<IQueueReceiver, QueueSnapshot>? channel;
	public ControlEventChannel<IQueueReceiver, QueueSnapshot>? other;
	public ControlEventTicket? ticket;
	public ControlEventTerminalPool? pool;
	public int calls = 0;
	public void receive(QueueSnapshot snapshot) {
		self.calls++;
		assert(self.channel.cancel() == CALLBACK_CANCELLATION_PENDING);
		bool refused = false;
		try { self.channel.publishTerminal(snapshot, 1LL, 1LL, self.ticket); } catch (string error) { refused = true; }
		assert(refused && self.pool.available() == 0 && self.other.beginInteraction() == null);
		refused = false;
		try { self.ticket.retire(); } catch (string error) { refused = true; }
		assert(refused && self.pool.available() == 0);
	}
}

class QueueWake implements IControlEventWake {
	public bool fail = false;
	public bool raises = false;
	public int calls = 0;
	public bool requestTurn() { self.calls++; if (self.raises) { throw "deliberate wake failure"; } return !self.fail; }
}

class QueueFailureChecks {
	class void wakeFailure(bool raises, bool replacement) {
		var pool = ControlEventTerminalPool(1); var queue = ControlEventQueue(2, pool);
		var wake = QueueWake(); queue.setWake(wake);
		var target = QueueTarget(); var receiver = QueueReceiver(); var scope = CallbackScope();
		var channel = new ControlEventChannel<IQueueReceiver, QueueSnapshot>(queue, target, receiver, QueueReceiver.deliver, scope);
		if (replacement) { assert(channel.publish(QueueSnapshot(60), 1LL, 1LL, 1LL)); }
		wake.raises = raises; wake.fail = true;
		assert(channel.publish(QueueSnapshot(61), 1LL, 1LL, 1LL));
		assert(queue.pendingCount() == 1 && receiver.values.len == 0);
		assert(queue.retired(CONTROL_EVENT_SUPERSEDED) == (replacement ? 1LL : 0LL));
		assert(!channel.publish(QueueSnapshot(62), 1LL, 1LL, 1LL));
		assert(wake.calls == (replacement ? 2 : 1));
		bool failed = false;
		try { queue.dispatchOne(); } catch (string error) { failed = true; }
		assert(failed && queue.pendingCount() == 1 && receiver.values.len == 0);
		assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE);
		assert(channel.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE);
		assert(queue.pendingCount() == 0 && queue.retired(CONTROL_EVENT_CANCELLED) == 1LL && pool.available() == 1);
		assert(!channel.publish(QueueSnapshot(63), 1LL, 1LL, 1LL));
		queue.close(); assert(receiver.values.len == 0 && wake.calls == (replacement ? 2 : 1));
	}

	class void enteredTerminalCredit() {
		var pool = ControlEventTerminalPool(3); var queue = ControlEventQueue(2, pool);
		var target = QueueTarget(); var receiver = QueueRetirementReceiver(); var scope = CallbackScope();
		var first = new ControlEventChannel<IQueueReceiver, QueueSnapshot>(queue, target, receiver, QueueReceiver.deliver, scope);
		var second = new ControlEventChannel<IQueueReceiver, QueueSnapshot>(queue, target, receiver, QueueReceiver.deliver, scope);
		var base = first.beginInteraction(); assert(base != null);
		var extra = first.beginInteraction(); assert(extra != null);
		var otherBase = second.beginInteraction(); assert(otherBase != null && pool.available() == 0);
		receiver.channel = first; receiver.other = second; receiver.ticket = extra; receiver.pool = pool;
		first.publishTerminal(QueueSnapshot(70), 1LL, 1LL, extra);
		assert(queue.dispatchOne() && receiver.calls == 1);
		assert(first.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE && pool.available() == 2);
		bool refused = false;
		try { first.publishTerminal(QueueSnapshot(71), 1LL, 2LL, otherBase); } catch (string error) { refused = true; }
		assert(refused && otherBase.isOpen() && pool.available() == 2);
		assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE && pool.available() == 3);
		receiver.channel = null; receiver.other = null; receiver.ticket = null; receiver.pool = null;
		queue.close();
	}

	class void cancelledOwner() {
		var pool = ControlEventTerminalPool(1); var queue = ControlEventQueue(2, pool);
		var target = QueueTarget(); var receiver = QueueReceiver(); var scope = CallbackScope();
		assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE);
		bool failed = false;
		try { var channel = new ControlEventChannel<IQueueReceiver, QueueSnapshot>(queue, target, receiver, QueueReceiver.deliver, scope); }
		catch (string error) { failed = true; }
		assert(failed && pool.available() == 1 && queue.pendingCount() == 0 && receiver.values.len == 0);
		queue.close();
	}
}

int main() {
	QueueFailureChecks.cancelledOwner(); QueueFailureChecks.enteredTerminalCredit();
	QueueFailureChecks.wakeFailure(false, false); QueueFailureChecks.wakeFailure(true, false);
	QueueFailureChecks.wakeFailure(false, true); QueueFailureChecks.wakeFailure(true, true);
	var pool = ControlEventTerminalPool(2);
	var queue = ControlEventQueue(4, pool);
	var target = QueueTarget(); var receiver = QueueReceiver(); var scope = CallbackScope();
	var first = new ControlEventChannel<IQueueReceiver, QueueSnapshot>(queue, target, receiver, QueueReceiver.deliver, scope);
	var second = new ControlEventChannel<IQueueReceiver, QueueSnapshot>(queue, target, receiver, QueueReceiver.deliver, scope);
	assert(pool.available() == 0 && receiver.values.len == 0);
	/* Replacement stays in place only in a replaceable suffix. */
	assert(first.publish(QueueSnapshot(1), 1LL, 1LL, 1LL));
	assert(first.publish(QueueSnapshot(2), 1LL, 1LL, 1LL));
	var terminal = second.beginInteraction(); assert(terminal != null);
	second.publishTerminal(QueueSnapshot(3), 1LL, 1LL, terminal);
	assert(first.publish(QueueSnapshot(4), 1LL, 1LL, 1LL));
	assert(second.beginInteraction() == null); // no spare overlapping terminal reservation
	while (queue.dispatchOne()) {}
	assert(receiver.values.len == 3 && receiver.values.get(0) == 2 && receiver.values.get(1) == 3 && receiver.values.get(2) == 4);
	assert(queue.retired(CONTROL_EVENT_SUPERSEDED) == 1LL);
	/* Ordinary pressure cannot spend a reserved terminal credit. */
	for (int index = 0; index < 4; index++) { assert(first.publish(QueueSnapshot(10 + index), 1LL, (long long)index + 2LL, 1LL)); }
	assert(!first.publish(QueueSnapshot(90), 1LL, 9LL, 1LL));
	terminal = second.beginInteraction(); assert(terminal != null);
	second.publishTerminal(QueueSnapshot(20), 1LL, 2LL, terminal);
	while (queue.dispatchOne()) {}
	assert(receiver.values.get(receiver.values.len - 1) == 20);
	/* Generation and eligibility are checked at invocation, not capture. */
	assert(first.publish(QueueSnapshot(30), 1LL, 10LL, 1LL)); target.eligible = false;
	assert(queue.dispatchOne()); assert(queue.retired(CONTROL_EVENT_INELIGIBLE) == 1LL);
	target.eligible = true;
	assert(first.publish(QueueSnapshot(31), 1LL, 11LL, 1LL)); target.generation = 2LL;
	assert(queue.dispatchOne()); assert(queue.retired(CONTROL_EVENT_STALE_GENERATION) == 1LL);
	/* In-flight cancellation is pending and keeps the reserved capacity until
 	 * receiver leave; queued records never enter after cancellation. */
	receiver.cancelDuring = first;
	terminal = first.beginInteraction(); assert(terminal != null);
	first.publishTerminal(QueueSnapshot(40), 2LL, 12LL, terminal);
	assert(first.publish(QueueSnapshot(41), 2LL, 12LL, 1LL));
	assert(second.publish(QueueSnapshot(42), 2LL, 12LL, 1LL));
	assert(queue.dispatchOne()); assert(first.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE);
	assert(receiver.values.get(receiver.values.len - 1) == 40);
	assert(queue.dispatchOne() && receiver.values.get(receiver.values.len - 1) == 42);
	assert(!queue.dispatchOne() && queue.retired(CONTROL_EVENT_CANCELLED) == 1LL);
	receiver.cancelDuring = null;
	/* A retained subscription can cross window/detached domains; old queued
	 * input is disposed, while a same-queue reorder preserves its ticket. */
	var destination = ControlEventQueue(4, pool);
	assert(second.publish(QueueSnapshot(50), 2LL, 13LL, 1LL));
	IControlEventChannel route = second; route.rebind(destination);
	assert(!queue.dispatchOne() && queue.retired(CONTROL_EVENT_INELIGIBLE) == 2LL);
	terminal = second.beginInteraction(); assert(terminal != null);
	second.rebind(destination);
	second.publishTerminal(QueueSnapshot(51), 2LL, 14LL, terminal);
	assert(destination.dispatchOne() && receiver.values.get(receiver.values.len - 1) == 51);
	receiver.fail = true;
	assert(second.publish(QueueSnapshot(52), 2LL, 15LL, 1LL));
	bool failed = false;
	try { destination.dispatchOne(); } catch (string error) { failed = true; }
	assert(failed && destination.retired(CONTROL_EVENT_FAILED) == 1LL);
	receiver.fail = false;
	terminal = second.beginInteraction(); assert(terminal != null); terminal.retire();
	assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE && pool.available() == 2);
	destination.close();
	queue.close();
	printf("PASS: UI2 semantic order reservations cancellation and eligibility\n");
	return 0;
}
