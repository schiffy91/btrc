import Library.Callback;
import Library.BackgroundJobs.NativeWorker;
import Library.GUI.MacOS.MacOSRunLoop;

import ./Foundation.btrc;
#include <assert.h>
#include <time.h>

class SignalReceiver implements IAppKitNotificationObserver {
	public int calls = 0;
	public MacOSRunLoopSignal? closeDuring;
	public void invoke(NSNotification notification) {
		assert(NSThread.isMainThread()); self.calls++;
		if (self.closeDuring != null) { assert(self.closeDuring.close()); self.closeDuring = null; }
	}
}
class SignalWorker implements INativeWorkerBody {
	private MacOSRunLoopSignal signal;
	public bool accepted = false;
	public SignalWorker(MacOSRunLoopSignal signal) { self.signal = signal; }

	public int workLoop() {
		struct timespec delay; delay.tv_sec = (time_t)0; delay.tv_nsec = 40000000L;
		nanosleep(&delay, null);
		self.accepted = self.signal.requestTurn(); return 0;
	}
}

class SignalRace implements INativeWorkerBody {
	private MacOSRunLoopSignal signal;
	public Atomic<bool> started;
	public bool wrongThreadRejected = false;
	public SignalRace(MacOSRunLoopSignal signal) { self.signal = signal; self.started.init(false); }

	public int workLoop() {
		try { var invalid = MacOSRunLoopSignal(); } catch (string error) { self.wrongThreadRejected = true; }
		self.started.store(true, MemoryOrder.RELEASE);
		while (self.signal.requestTurn()) {}
		return 0;
	}
}

class SignalRearm implements IAppKitNotificationObserver {
	public MacOSRunLoopSignal signal;
	public int calls = 0;
	public SignalRearm(MacOSRunLoopSignal signal) { self.signal = signal; }

	public void invoke(NSNotification notification) {
		self.calls++;
		for (int index = 0; index < 100; index++) { assert(self.signal.requestTurn()); }
		if (self.calls == 3) { assert(self.signal.close()); }
	}
}
class SignalCoolingWorker implements INativeWorkerBody {
	private MacOSRunLoopSignal _signal;
	public int accepted = 0;
	public SignalCoolingWorker(MacOSRunLoopSignal signal) { self._signal = signal; }

	public int workLoop() {
		for (int index = 0; index < 100; index++) { if (self._signal.requestTurn()) { self.accepted++; } }
		return 0;
	}
}

class SignalCloseRace implements IAppKitNotificationObserver {
	private MacOSRunLoopSignal _signal;
	public int calls = 0;
	public SignalCloseRace(MacOSRunLoopSignal signal) { self._signal = signal; }

	public void invoke(NSNotification notification) {
		self.calls++; self._signal.close();
		/* A worker already inside requestTurn may defer native retirement,
		 * but callback-close must seal every subsequent request immediately. */
		assert(!self._signal.requestTurn());
	}
}

void verifyContinuation(CFStringRef mode) {
	var signal = MacOSRunLoopSignal(); var scope = CallbackScope(); var receiver = SignalRearm(signal);
	signal.subscribe(receiver, scope); signal.wake();
	for (int expected = 1; expected <= 3; expected++) {
		CFRunLoopRunInMode(mode, 1.0, (Boolean)1);
		assert(receiver.calls == expected);
	}
	assert(!signal.requestTurn() && signal.close());
	assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE);
	CFRunLoopRunInMode(mode, 0.01, (Boolean)0); assert(receiver.calls == 3);

	for (int iteration = 0; iteration < 100; iteration++) {
		var raced = MacOSRunLoopSignal(); var racedScope = CallbackScope(); var closing = SignalCloseRace(raced);
		raced.subscribe(closing, racedScope); var body = SignalRace(raced); var worker = NativeWorker();
		assert(worker.start(body) == NATIVE_WORKER_STARTED);
		while (!body.started.load(MemoryOrder.ACQUIRE)) { usleep(100); }
		CFRunLoopRunInMode(mode, 1.0, (Boolean)1);
		assert(closing.calls == 1 && worker.join() && !worker.workerFailed());
		assert(raced.close() && !raced.requestTurn() && racedScope.cancel() == CALLBACK_CANCELLATION_COMPLETE);
	}

	var cooled = MacOSRunLoopSignal(); var cooledScope = CallbackScope(); var cooledReceiver = SignalReceiver();
	cooled.subscribe(cooledReceiver, cooledScope); cooled.wake();
	CFRunLoopRunInMode(mode, 1.0, (Boolean)1); assert(cooledReceiver.calls == 1);
	/* The main loop is stopped while this worker joins, so the first
	 * delivery's continuation cannot fire until all worker requests arrive. */
	var body = SignalCoolingWorker(cooled); var worker = NativeWorker();
	assert(worker.start(body) == NATIVE_WORKER_STARTED);
	assert(worker.join() && !worker.workerFailed() && body.accepted == 100);
	assert(cooledReceiver.calls == 1);
	CFRunLoopRunInMode(mode, 1.0, (Boolean)1); assert(cooledReceiver.calls == 2);
	CFRunLoopRunInMode(mode, 0.01, (Boolean)0); assert(cooledReceiver.calls == 2);
	cooled.wake(); CFRunLoopRunInMode(mode, 1.0, (Boolean)1); assert(cooledReceiver.calls == 3);
	assert(cooled.requestTurn());
	assert(cooledScope.cancel() == CALLBACK_CANCELLATION_COMPLETE && cooled.close());
	CFRunLoopRunInMode(mode, 0.01, (Boolean)0); assert(cooledReceiver.calls == 3);
}

int main() {
	var mode = CFStringCreateWithCString(null, "BTRC.UI2.SignalCommonMode", kCFStringEncodingUTF8);
	CFRunLoopAddCommonMode(CFRunLoopGetMain(), mode);
	verifyContinuation(mode);
	for (int iteration = 0; iteration < 100; iteration++) {
		var signal = MacOSRunLoopSignal(); var other = MacOSRunLoopSignal();
		var scope = CallbackScope(); var receiver = SignalReceiver(); var unrelated = SignalReceiver();
		signal.subscribe(receiver, scope); other.subscribe(unrelated, scope);
		assert(receiver.calls == 0 && unrelated.calls == 0);
		signal.wake(); signal.wake();
		CFRunLoopRunInMode(mode, 1.0, (Boolean)1);
		assert(receiver.calls == 1 && unrelated.calls == 0);
		receiver.closeDuring = signal; signal.wake();
		CFRunLoopRunInMode(kCFRunLoopDefaultMode, 1.0, (Boolean)1);
		assert(receiver.calls == 2 && !signal.requestTurn() && signal.close());
		assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE);
		other.wake(); CFRunLoopRunInMode(mode, 1.0, (Boolean)1);
		assert(unrelated.calls == 0 && other.close());
	}
	var signal = MacOSRunLoopSignal(); var receiver = SignalReceiver(); var scope = CallbackScope();
	signal.subscribe(receiver, scope);
	var producer = SignalWorker(signal); var worker = NativeWorker();
	assert(worker.start(producer) == NATIVE_WORKER_STARTED);
	/* No timer or application polling is armed: the worker wakes this wait. */
	CFRunLoopRunInMode(mode, 2.0, (Boolean)1);
	assert(worker.join() && !worker.workerFailed() && producer.accepted && receiver.calls == 1);
	assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE && signal.close());
	for (int iteration = 0; iteration < 100; iteration++) {
		var raced = MacOSRunLoopSignal(); var body = SignalRace(raced); var racing = NativeWorker();
		assert(racing.start(body) == NATIVE_WORKER_STARTED);
		while (!body.started.load(MemoryOrder.ACQUIRE)) { usleep(100); }
		raced.close();
		assert(racing.join() && !racing.workerFailed() && body.wrongThreadRejected);
		assert(raced.close() && !raced.requestTurn());
	}
	var timed = MacOSRunLoopSignal(); var timedScope = CallbackScope(); var timedReceiver = SignalReceiver();
	timed.subscribe(timedReceiver, timedScope);
	unsigned long long began = MacOSRunLoopSignal.now();
	timed.scheduleDeadline((unsigned long long)began + 3000000000ULL);
	timed.scheduleDeadline((unsigned long long)began + 40000000ULL);
	while (timedReceiver.calls == 0) { CFRunLoopRunInMode(mode, 1.0, (Boolean)1); }
	assert(timedReceiver.calls == 1 && MacOSRunLoopSignal.now() - began >= 30000000ULL);
	CFRunLoopRunInMode(mode, 0.01, (Boolean)0); assert(timedReceiver.calls == 1);
	timed.scheduleDeadline((unsigned long long)MacOSRunLoopSignal.now() + 10000000ULL);
	timed.scheduleDeadline(0ULL);
	CFRunLoopRunInMode(mode, 0.03, (Boolean)0); assert(timedReceiver.calls == 1);
	timed.scheduleDeadline((unsigned long long)MacOSRunLoopSignal.now() + 10000000ULL);
	assert(timed.close() && timedScope.cancel() == CALLBACK_CANCELLATION_COMPLETE);
	CFRunLoopRunInMode(mode, 0.03, (Boolean)0); assert(timedReceiver.calls == 1);
	bool closedTimerRejected = false;
	try { timed.scheduleDeadline(0ULL); } catch (string error) { closedTimerRejected = true; }
	assert(closedTimerRejected);

	print("PASS: UI2 macOS scoped common-mode wake and worker signal");
	return 0;
}
