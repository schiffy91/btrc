import Library.Callback;
import Library.Vector;
import Library.GUI.IApplication;
import Library.GUI.IWindow;
import Library.GUI.MacOS.MacOSApplication;

#include <assert.h>

class ExistingApplicationDelegate implements IAppKitApplicationEvents {
	public unsigned long applicationShouldTerminate(NSApplication application) { return NSTerminateCancel; }
}
class AttachedApplicationHost implements IApplicationHost {
	public Atomic<int> wakes;
	public unsigned long long deadline = 0ULL;
	public AttachedApplicationHost() { self.wakes.init(0); }

	public bool requestTurn() { self.wakes.fetchAdd(1, MemoryOrder.ACQ_REL); return true; }

	public void scheduleTurn(unsigned long long deadline) { assert(NSThread.isMainThread()); self.deadline = deadline; }
}
class HostedApplicationWork implements IApplicationWork {
	public MacOSApplication application;
	public Vector<int> trace;
	public int value;
	public HostedApplicationWork(MacOSApplication application, Vector<int> trace, int value) { self.application = application; self.trace = trace; self.value = value; }

	public void run() { assert(NSThread.isMainThread()); self.trace.push(self.value); if (self.value == 4) { self.application.requestQuit(); } }
}
int main() {
	var native = NSApplication.sharedApplication(); var delegateScope = CallbackScope();
	native.setDelegate(ExistingApplicationDelegate(), delegateScope); var original = native.delegate(); assert(original != null);
	var application = MacOSApplication(4); assert(native.delegate() == original);
	var host = AttachedApplicationHost(); var owner = CallbackScope(); var attached = application.attachHost(host, owner);
	assert(attached.kind == APPLICATION_HOST_ATTACHED && attached.attachment != null && application.isRunning());
	assert(native.delegate() == original);
	assert(application.attachHost(host, owner).kind == APPLICATION_HOST_ALREADY_ATTACHED);
	bool nested = false; try { application.run(); } catch (string error) { nested = true; } assert(nested);
	Vector<int> trace = [];
	var cancelled = application.schedule(HostedApplicationWork(application, trace, 1), 0.0, WORK_SUSPENSION_CANCEL, 0LL);
	var deferred = application.schedule(HostedApplicationWork(application, trace, 2), 0.0, WORK_SUSPENSION_DEFER, 0LL);
	var replaced = application.schedule(HostedApplicationWork(application, trace, 3), 0.0, WORK_SUSPENSION_REPLACE, 7LL);
	attached.attachment.transition(APPLICATION_ACTIVITY_SUSPENDED);
	assert(application.schedule(HostedApplicationWork(application, trace, 4), 0.0, WORK_SUSPENSION_REPLACE, 7LL).kind == SCHEDULE_REPLACED);
	attached.attachment.serviceTurn(); assert(trace.isEmpty() && host.deadline == 0ULL);
	assert(cancelled.registration.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE && replaced.registration.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE);
	attached.attachment.transition(APPLICATION_ACTIVITY_ACTIVE); attached.attachment.serviceTurn();
	assert(trace.len == 2 && trace.get(0) == 2 && trace.get(1) == 4);
	assert(attached.attachment.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE && !application.isRunning());
	assert(deferred.registration.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE && owner.cancel() == CALLBACK_CANCELLATION_COMPLETE);
	assert(native.delegate() == original);
	var direct = MacOSApplication(1); var directOwner = CallbackScope(); var directAttachment = direct.attachHost(host, directOwner);
	assert(directAttachment.kind == APPLICATION_HOST_ATTACHED && direct.close() == CALLBACK_CANCELLATION_COMPLETE);
	assert(!direct.isRunning() && directAttachment.attachment.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE);
	assert(directOwner.cancel() == CALLBACK_CANCELLATION_COMPLETE && native.delegate() == original);
	assert(delegateScope.cancel() == CALLBACK_CANCELLATION_COMPLETE);
	print("PASS: UI2 macOS host attachment preserves delegate and drains application work"); return 0;
}
