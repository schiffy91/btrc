import Library.Callback;
import Library.GUI.ControlEventQueue;
import Library.GUI.IWindow;
import Library.GUI.IView;
import Library.GUI.MacOS.MacOSWindow;
import Library.GUI.MacOS.MacOSView;
import Library.GUI.MacOS.MacOSViewState;

#include <assert.h>

class WindowWake implements IControlEventWake { public bool requestTurn() { return true; } }
class WindowStates implements IWindowStateHandler {
	public int calls = 0;
	public WindowState? latest;
	public void stateChanged(WindowState state) { self.calls++; self.latest = state; }
}
class WindowDecision implements IWindowCloseRequestHandler {
	public int calls = 0;
	public IWindowCloseTransaction? transaction;
	public MacOSWindow? alertWindow;
	public bool discard = false;
	public IView? ownedRoot;
	public bool modalRejected = false;
	public void closeRequested(IWindowCloseTransaction transaction) {
		self.calls++; self.transaction = transaction;
		if (self.alertWindow != null) { try { self.alertWindow.showAlert("forbidden", "nested"); } catch (string error) { self.modalRejected = true; } }
		if (self.discard) { transaction.decide(WINDOW_CLOSE_DECISION_DISCARD, 1LL); if (self.ownedRoot != null) { assert(self.ownedRoot.isOpen()); } }
	}
}

void drain(MacOSViewContext context) { int turns = 0; while (context.dispatchOne()) { assert(turns++ < 100); } }

void verifyState() {
	var context = MacOSViewContext(WindowWake(), 1); var window = MacOSWindow("state", 120.0, 80.0, null, context);
	var first = window.state(); assert(first.width == 120.0 && first.height == 80.0 && first.backingScale > 0.0 && first.stateRevision > 0LL);
	assert(!first.nativeVisible && !first.requestedVisible && !first.presentable && first.exposure == WINDOW_EXPOSURE_NOT_EXPOSED && first.notExposedReason == WINDOW_EXPOSURE_REASON_HIDDEN);
	first.width = -10.0; assert(window.state().width == 120.0);
	var owner = CallbackScope(); var states = WindowStates(); window.onStateChanged(states, owner); assert(states.calls == 0);
	drain(context); assert(states.calls == 1 && states.latest != null); states.latest.width = -5.0; assert(window.state().width == 120.0);
	long long revision = window.state().stateRevision;
	window.setContentSize(150.0, 90.0); window.setContentSize(160.0, 100.0); assert(states.calls == 1);
	assert(window.state().width == 160.0 && window.state().stateRevision > revision); drain(context);
	assert(states.calls == 2 && states.latest != null && states.latest.width == 160.0 && states.latest.height == 100.0);
	revision = window.state().stateRevision; window.setContentSize(160.0, 100.0); drain(context); assert(states.calls == 2 && window.state().stateRevision == revision);
	window.applicationActivity(APPLICATION_ACTIVITY_SUSPENDED); drain(context); assert(states.calls == 3 && !window.state().presentable && window.state().applicationActivity == APPLICATION_ACTIVITY_SUSPENDED);
	assert(owner.cancel() == CALLBACK_CANCELLATION_COMPLETE && window.close() == CALLBACK_CANCELLATION_COMPLETE);
	assert(!window.state().nativeVisible && !window.state().presentable && window.state().width == 160.0); context.close();
}

void verifySaveAndCancel() {
	var context = MacOSViewContext(WindowWake()); var window = MacOSWindow("save", 100.0, 100.0, null, context);
	var owner = CallbackScope(); var handler = WindowDecision(); window.onCloseRequested(handler, owner);
	var request = window.requestClose(WINDOW_CLOSE_PROGRAM_REQUEST); assert(request.kind == WINDOW_CLOSE_REQUEST_PENDING && request.transaction != null && handler.calls == 0);
	var again = window.requestClose(WINDOW_CLOSE_PROGRAM_REQUEST); assert(again.kind == WINDOW_CLOSE_REQUEST_ALREADY_PENDING && again.transaction == request.transaction);
	drain(context); assert(handler.calls == 1 && handler.transaction == request.transaction);
	var transaction = request.transaction; assert(transaction != null); var saving = transaction.decide(WINDOW_CLOSE_DECISION_SAVE, 3LL); assert(saving.state == WINDOW_CLOSE_SAVING && saving.attempt > 0LL);
	assert(transaction.decide(WINDOW_CLOSE_DECISION_SAVE, 4LL).attempt == saving.attempt);
	assert(transaction.completeSave(saving.attempt, 3LL, true, "").kind == WINDOW_CLOSE_OUTCOME_STALE_REVISION && window.isOpen());
	var retry = transaction.decide(WINDOW_CLOSE_DECISION_SAVE, 4LL); assert(retry.attempt > saving.attempt);
	assert(transaction.completeSave(saving.attempt, 4LL, true, "").kind == WINDOW_CLOSE_OUTCOME_STALE_ATTEMPT);
	assert(transaction.completeSave(retry.attempt, 4LL, false, "disk failure").state == WINDOW_CLOSE_AWAITING_DECISION);
	assert(transaction.decide(WINDOW_CLOSE_DECISION_CANCEL, 4LL).state == WINDOW_CLOSE_CANCELLED && window.isOpen());
	assert(transaction.completeSave(retry.attempt, 4LL, true, "").kind == WINDOW_CLOSE_OUTCOME_NOT_PENDING);
	var second = window.requestClose(WINDOW_CLOSE_PROGRAM_REQUEST); assert(second.transaction != null && second.transaction != transaction); owner.cancel();
	assert(second.transaction.state() == WINDOW_CLOSE_CANCELLED); drain(context); assert(handler.calls == 1 && window.isOpen());
	assert(window.requestClose(WINDOW_CLOSE_PROGRAM_REQUEST).kind == WINDOW_CLOSE_REQUEST_AUTHORIZED_NO_HANDLER && window.pollClose() == CALLBACK_CANCELLATION_COMPLETE);
	assert(window.requestClose(WINDOW_CLOSE_PROGRAM_REQUEST).kind == WINDOW_CLOSE_REQUEST_CLOSED); context.close();
}

void verifyNativeAndEnteredClose() {
	var context = MacOSViewContext(WindowWake()); var first = MacOSWindow("native", 100.0, 100.0, null, context); var second = MacOSWindow("other", 100.0, 100.0, null, context);
	var root = MacOSView(); first.attachRoot(root);
	var scope = CallbackScope(); var handler = WindowDecision(); handler.alertWindow = second; handler.ownedRoot = root; first.onCloseRequested(handler, scope);
	first.nativeWindow().performClose(null); first.nativeWindow().performClose(null);
	assert(first.isOpen() && handler.calls == 0); first.dispatchPendingEvents(); assert(handler.calls == 0); drain(context);
	assert(handler.calls == 1 && handler.modalRejected && handler.transaction != null && second.isOpen());
	handler.transaction.decide(WINDOW_CLOSE_DECISION_CANCEL, 1LL); assert(first.isOpen() && second.isOpen());
	// The new request resolves from its entered callback. Native teardown must
	// wait for that callback to leave instead of treating PENDING as failure.
	handler.discard = true; first.nativeWindow().performClose(null); first.dispatchPendingEvents(); drain(context);
	assert(!first.isOpen() && first.pollClose() == CALLBACK_CANCELLATION_COMPLETE && handler.calls == 2 && !root.isOpen() && second.isOpen());
	assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE && second.close() == CALLBACK_CANCELLATION_COMPLETE); context.close();
}

void verifyForcedClose() {
	var context = MacOSViewContext(WindowWake()); var window = MacOSWindow("forced", 100.0, 100.0, null, context);
	var scope = CallbackScope(); var handler = WindowDecision(); window.onCloseRequested(handler, scope);
	var request = window.requestClose(WINDOW_CLOSE_PROGRAM_REQUEST); assert(request.transaction != null);
	assert(window.close() == CALLBACK_CANCELLATION_COMPLETE && request.transaction.state() == WINDOW_CLOSE_OWNER_LOST); drain(context);
	assert(handler.calls == 0 && request.transaction.decide(WINDOW_CLOSE_DECISION_DISCARD, 1LL).kind == WINDOW_CLOSE_OUTCOME_NOT_PENDING); scope.cancel(); context.close();
}

int main() {
	NSApplication.sharedApplication();
	verifyState(); verifySaveAndCancel(); verifyNativeAndEnteredClose(); verifyForcedClose();
	print("PASS: UI2 macOS window state and reversible close transactions"); return 0;
}
