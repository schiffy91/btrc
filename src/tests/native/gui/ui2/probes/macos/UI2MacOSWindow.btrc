import Library.Callback;
import Library.Vector;
import Library.GUI.ControlEventQueue;
import Library.GUI.IWindow;
import Library.GUI.IView;
import Library.GUI.MacOS.MacOSWindow;
import Library.GUI.MacOS.MacOSView;
import Library.GUI.MacOS.MacOSViewState;

#include <assert.h>

class WindowWake implements IControlEventWake { public bool requestTurn() { return true; } }
class WindowStates implements IWindowStateHandler {
	public int calls = 0;
	public int ignored = 0;
	public long long floorRevision = 0LL;
	public WindowState? latest;
	public WindowState current() { var state = self.latest; if (state == null) { throw "No window state delivered"; } return state; }

	public void stateChanged(WindowState state) { self.calls++; if (state.stateRevision <= self.floorRevision) { self.ignored++; return; } self.latest = state; }
}
class WindowDecision implements IWindowCloseRequestHandler {
	public int calls = 0;
	public IWindowCloseTransaction? transaction;
	public IWindowCloseTransaction current() { var transaction = self.transaction; if (transaction == null) { throw "No close transaction delivered"; } return transaction; }
	public MacOSWindow? alertWindow;
	public bool discard = false;
	public IView? ownedRoot;
	public bool modalRejected = false;
	public void closeRequested(IWindowCloseTransaction transaction) {
		self.calls++; self.transaction = transaction;
		if (self.alertWindow != null) { try { self.alertWindow.showAlert("forbidden", "nested"); } catch (string error) { self.modalRejected = true; } }
		if (self.discard) { transaction.decide(WINDOW_CLOSE_DECISION_DISCARD, 1LL); if (self.ownedRoot != null) { assert(self.ownedRoot.isOpen()); } }
	}
}

IWindowCloseTransaction requiredTransaction(WindowCloseRequestOutcome request) { var transaction = request.transaction; if (transaction == null) { throw "No close transaction accepted"; } return transaction; }

void drain(MacOSViewContext context) { int turns = 0; while (context.dispatchOne()) { assert(turns++ < 100); } }

void verifyState() {
	var context = MacOSViewContext(WindowWake(), 1); var window = MacOSWindow("state", 120.0, 80.0, null, context);
	var first = window.state(); assert(first.width == 120.0 && first.height == 80.0 && first.backingScale > 0.0 && first.stateRevision > 0LL);
	assert(!first.nativeVisible && !first.requestedVisible && !first.presentable && first.exposure == WINDOW_EXPOSURE_NOT_EXPOSED && first.notExposedReason == WINDOW_EXPOSURE_REASON_HIDDEN);
	first.width = -10.0; assert(window.state().width == 120.0);
	var owner = CallbackScope(); var states = WindowStates(); window.onStateChanged(states, owner); assert(states.calls == 0);
	states.floorRevision = window.state().stateRevision; drain(context); assert(states.calls == 0 && states.latest == null);
	long long revision = states.floorRevision;
	window.setContentSize(150.0, 90.0); window.setContentSize(160.0, 100.0); assert(states.calls == 0);
	var observed = window.state(); assert(observed.width == 160.0 && observed.stateRevision > revision);
	states.floorRevision = observed.stateRevision; drain(context); assert(states.calls == 1 && states.ignored == 1 && states.latest == null);
	window.setContentSize(170.0, 110.0); drain(context);
	assert(states.calls == 2 && states.latest != null && states.current().stateRevision > states.floorRevision && states.current().width == 170.0 && states.current().height == 110.0);
	states.current().width = -5.0; assert(window.state().width == 170.0);
	revision = window.state().stateRevision; window.setContentSize(170.0, 110.0); drain(context); assert(states.calls == 2 && window.state().stateRevision == revision);
	window.applicationActivity(APPLICATION_ACTIVITY_SUSPENDED); drain(context); assert(states.calls == 3 && !window.state().presentable && window.state().applicationActivity == APPLICATION_ACTIVITY_SUSPENDED);
	assert(owner.cancel() == CALLBACK_CANCELLATION_COMPLETE && window.close() == CALLBACK_CANCELLATION_COMPLETE);
	assert(!window.state().nativeVisible && !window.state().presentable && window.state().width == 170.0); context.close();
}

void verifyResubscribeWithPendingState(int captureCapacity = 0) {
	var context = MacOSViewContext(WindowWake(), 1, null, captureCapacity); var window = MacOSWindow("resubscribe", 100.0, 100.0, null, context);
	var previousOwner = CallbackScope(); var previous = WindowStates(); window.onStateChanged(previous, previousOwner);
	var closeOwner = CallbackScope(); var closeHandler = WindowDecision(); window.onCloseRequested(closeHandler, closeOwner);
	window.setContentSize(110.0, 100.0);
	var transaction = requiredTransaction(window.requestClose(WINDOW_CLOSE_PROGRAM_REQUEST));
	window.setContentSize(120.0, 100.0);
	assert(previousOwner.cancel() == CALLBACK_CANCELLATION_COMPLETE);
	var nextOwner = CallbackScope(); var next = WindowStates(); window.onStateChanged(next, nextOwner);
	drain(context); assert(previous.calls == 0 && next.calls == 0 && window.state().width == 120.0);
	transaction.decide(WINDOW_CLOSE_DECISION_CANCEL, 1LL);
	window.setContentSize(130.0, 100.0); drain(context); assert(next.calls == 1 && next.current().width == 130.0);
	assert(nextOwner.cancel() == CALLBACK_CANCELLATION_COMPLETE && closeOwner.cancel() == CALLBACK_CANCELLATION_COMPLETE);
	assert(window.close() == CALLBACK_CANCELLATION_COMPLETE); context.close();
}

void verifySaveAndCancel() {
	var context = MacOSViewContext(WindowWake()); var window = MacOSWindow("save", 100.0, 100.0, null, context);
	var owner = CallbackScope(); var handler = WindowDecision(); window.onCloseRequested(handler, owner);
	var request = window.requestClose(WINDOW_CLOSE_PROGRAM_REQUEST); assert(request.kind == WINDOW_CLOSE_REQUEST_PENDING && request.transaction != null && handler.calls == 0);
	var again = window.requestClose(WINDOW_CLOSE_PROGRAM_REQUEST); assert(again.kind == WINDOW_CLOSE_REQUEST_ALREADY_PENDING && again.transaction == request.transaction);
	drain(context); assert(handler.calls == 1 && handler.transaction == request.transaction);
	var transaction = requiredTransaction(request); var saving = transaction.decide(WINDOW_CLOSE_DECISION_SAVE, 3LL); assert(saving.state == WINDOW_CLOSE_SAVING && saving.attempt > 0LL);
	assert(transaction.decide(WINDOW_CLOSE_DECISION_SAVE, 4LL).attempt == saving.attempt);
	assert(transaction.completeSave(saving.attempt, 3LL, true, "").kind == WINDOW_CLOSE_OUTCOME_STALE_REVISION && window.isOpen());
	var retry = transaction.decide(WINDOW_CLOSE_DECISION_SAVE, 4LL); assert(retry.attempt > saving.attempt);
	assert(transaction.completeSave(saving.attempt, 4LL, true, "").kind == WINDOW_CLOSE_OUTCOME_STALE_ATTEMPT);
	assert(transaction.completeSave(retry.attempt, 4LL, false, "disk failure").state == WINDOW_CLOSE_AWAITING_DECISION);
	assert(transaction.decide(WINDOW_CLOSE_DECISION_CANCEL, 4LL).state == WINDOW_CLOSE_CANCELLED && window.isOpen());
	assert(transaction.completeSave(retry.attempt, 4LL, true, "").kind == WINDOW_CLOSE_OUTCOME_NOT_PENDING);
	var second = window.requestClose(WINDOW_CLOSE_PROGRAM_REQUEST); assert(second.transaction != null && second.transaction != transaction); owner.cancel();
	assert(requiredTransaction(second).state() == WINDOW_CLOSE_CANCELLED); drain(context); assert(handler.calls == 1 && window.isOpen());
	assert(window.requestClose(WINDOW_CLOSE_PROGRAM_REQUEST).kind == WINDOW_CLOSE_REQUEST_AUTHORIZED_NO_HANDLER && window.pollClose() == CALLBACK_CANCELLATION_COMPLETE);
	assert(window.requestClose(WINDOW_CLOSE_PROGRAM_REQUEST).kind == WINDOW_CLOSE_REQUEST_CLOSED); context.close();
}

void verifyNativeAndEnteredClose() {
	var context = MacOSViewContext(WindowWake()); var first = MacOSWindow("native", 100.0, 100.0, null, context); var second = MacOSWindow("other", 100.0, 100.0, null, context);
	var root = MacOSView(); first.attachRoot(root);
	var scope = CallbackScope(); var handler = WindowDecision(); handler.alertWindow = second; handler.ownedRoot = root; first.onCloseRequested(handler, scope);
	first.nativeWindow().performClose(null); first.nativeWindow().performClose(null);
	assert(first.isOpen() && handler.calls == 0); first.dispatchPendingEvents(); assert(handler.calls == 0); drain(context);
	assert(handler.calls == 1 && handler.modalRejected && handler.transaction != null && second.isOpen());
	handler.current().decide(WINDOW_CLOSE_DECISION_CANCEL, 1LL); assert(first.isOpen() && second.isOpen());
	// The new request resolves from its entered callback. Native teardown must
	// wait for that callback to leave instead of treating PENDING as failure.
	handler.discard = true; first.nativeWindow().performClose(null); first.dispatchPendingEvents(); drain(context);
	assert(!first.isOpen() && first.pollClose() == CALLBACK_CANCELLATION_COMPLETE && handler.calls == 2 && !root.isOpen() && second.isOpen());
	assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE && second.close() == CALLBACK_CANCELLATION_COMPLETE); context.close();
}

void verifyForcedClose() {
	var context = MacOSViewContext(WindowWake()); var window = MacOSWindow("forced", 100.0, 100.0, null, context);
	var scope = CallbackScope(); var handler = WindowDecision(); window.onCloseRequested(handler, scope);
	var request = window.requestClose(WINDOW_CLOSE_PROGRAM_REQUEST); assert(request.transaction != null);
	assert(window.close() == CALLBACK_CANCELLATION_COMPLETE && requiredTransaction(request).state() == WINDOW_CLOSE_OWNER_LOST); drain(context);
	assert(handler.calls == 0 && requiredTransaction(request).decide(WINDOW_CLOSE_DECISION_DISCARD, 1LL).kind == WINDOW_CLOSE_OUTCOME_NOT_PENDING); scope.cancel(); context.close();
}

void verifyQuitGroup() {
	var context = MacOSViewContext(WindowWake()); var first = MacOSWindow("quit first", 100.0, 100.0, null, context); var second = MacOSWindow("quit second", 100.0, 100.0, null, context); var clean = MacOSWindow("clean", 100.0, 100.0, null, context);
	Vector<MacOSWindow> windows = [first, second, clean]; var scope = CallbackScope(); var a = WindowDecision(); var b = WindowDecision(); first.onCloseRequested(a, scope); second.onCloseRequested(b, scope);
	var group = MacOSWindowQuitCoordinator(windows, context); assert(!group.advance()); drain(context); assert(a.calls == 1 && b.calls == 1 && a.transaction != null && b.transaction != null);
	// Repeated native close on a no-handler member cannot close it early.
	clean.nativeWindow().performClose(null); clean.dispatchPendingEvents(); assert(clean.isOpen());
	assert(first.requestCoordinatedClose().transaction == a.transaction && !group.advance()); drain(context); assert(a.calls == 1);
	var firstSave = a.current().decide(WINDOW_CLOSE_DECISION_SAVE, 1LL); var secondSave = b.current().decide(WINDOW_CLOSE_DECISION_SAVE, 8LL);
	assert(a.current().completeSave(firstSave.attempt, 1LL, true, "").state == WINDOW_CLOSE_AUTHORIZED && first.isOpen());
	assert(a.current().decide(WINDOW_CLOSE_DECISION_DISCARD, 0LL).kind == WINDOW_CLOSE_OUTCOME_STALE_REVISION);
	var newSave = a.current().decide(WINDOW_CLOSE_DECISION_SAVE, 2LL); assert(newSave.attempt > firstSave.attempt && newSave.state == WINDOW_CLOSE_SAVING);
	assert(b.current().completeSave(secondSave.attempt, 8LL, true, "").state == WINDOW_CLOSE_AUTHORIZED && !group.advance() && second.isOpen());
	assert(a.current().completeSave(firstSave.attempt, 1LL, true, "").kind == WINDOW_CLOSE_OUTCOME_STALE_ATTEMPT && !group.advance());
	assert(a.current().completeSave(newSave.attempt, 2LL, true, "").state == WINDOW_CLOSE_AUTHORIZED && group.advance());
	group.commit(); assert(first.isOpen() && second.isOpen() && clean.isOpen()); assert(a.current().state() == WINDOW_CLOSE_CLOSING && b.current().state() == WINDOW_CLOSE_CLOSING && !context.nativeQuitPending());
	assert(first.close() == CALLBACK_CANCELLATION_COMPLETE && second.close() == CALLBACK_CANCELLATION_COMPLETE && clean.close() == CALLBACK_CANCELLATION_COMPLETE); scope.cancel(); context.close();
}

void verifyQuitCancellation() {
	var context = MacOSViewContext(WindowWake()); var first = MacOSWindow("cancel first", 100.0, 100.0, null, context); var second = MacOSWindow("cancel second", 100.0, 100.0, null, context);
	Vector<MacOSWindow> windows = [first, second]; var scope = CallbackScope(); var a = WindowDecision(); var b = WindowDecision(); first.onCloseRequested(a, scope); second.onCloseRequested(b, scope);
	var group = MacOSWindowQuitCoordinator(windows, context); assert(!group.advance()); drain(context); assert(a.transaction != null && b.transaction != null);
	a.current().decide(WINDOW_CLOSE_DECISION_DISCARD, 3LL); var saving = b.current().decide(WINDOW_CLOSE_DECISION_SAVE, 2LL);
	assert(a.current().decide(WINDOW_CLOSE_DECISION_CANCEL, 4LL).state == WINDOW_CLOSE_CANCELLED && !group.advance() && group.cancelled());
	assert(first.isOpen() && second.isOpen() && b.current().state() == WINDOW_CLOSE_CANCELLED);
	assert(b.current().completeSave(saving.attempt, 2LL, true, "").kind == WINDOW_CLOSE_OUTCOME_NOT_PENDING);
	var old = a.transaction; var fresh = MacOSWindowQuitCoordinator(windows, context); assert(!fresh.advance()); drain(context); assert(a.calls == 2 && a.transaction != old); fresh.cancel();
	assert(first.close() == CALLBACK_CANCELLATION_COMPLETE && second.close() == CALLBACK_CANCELLATION_COMPLETE); scope.cancel(); context.close();
}

void verifyQuitMembership() {
	var context = MacOSViewContext(WindowWake()); var first = MacOSWindow("member", 100.0, 100.0, null, context); var clean = MacOSWindow("initially clean", 100.0, 100.0, null, context);
	Vector<MacOSWindow> windows = [first, clean]; var scope = CallbackScope(); var a = WindowDecision(); first.onCloseRequested(a, scope);
	var group = MacOSWindowQuitCoordinator(windows, context); assert(!group.advance()); drain(context); assert(a.transaction != null); a.current().decide(WINDOW_CLOSE_DECISION_DISCARD, 1LL);
	var b = WindowDecision(); var registration = clean.onCloseRequested(b, scope); assert(!group.advance() && group.cancelled() && a.current().state() == WINDOW_CLOSE_CANCELLED && first.isOpen() && clean.isOpen());
	registration.cancel(); var fresh = MacOSWindowQuitCoordinator(windows, context); assert(!fresh.advance()); drain(context);
	var added = MacOSWindow("new member", 100.0, 100.0, null, context); windows.push(added); assert(!fresh.advance() && fresh.cancelled() && first.isOpen() && clean.isOpen() && added.isOpen());
	assert(first.close() == CALLBACK_CANCELLATION_COMPLETE && clean.close() == CALLBACK_CANCELLATION_COMPLETE && added.close() == CALLBACK_CANCELLATION_COMPLETE); scope.cancel(); context.close();
}

void verifyQuitUndeliveredCancellation() {
	var context = MacOSViewContext(WindowWake()); var first = MacOSWindow("queued first", 100.0, 100.0, null, context); var second = MacOSWindow("queued second", 100.0, 100.0, null, context);
	Vector<MacOSWindow> windows = [first, second]; var scope = CallbackScope(); var a = WindowDecision(); var b = WindowDecision(); first.onCloseRequested(a, scope); second.onCloseRequested(b, scope);
	var group = MacOSWindowQuitCoordinator(windows, context); assert(!group.advance() && a.calls == 0 && b.calls == 0);
	var added = MacOSWindow("membership changed", 100.0, 100.0, null, context); windows.push(added); assert(!group.advance() && group.cancelled());
	var fresh = MacOSWindowQuitCoordinator(windows, context); assert(!fresh.advance()); drain(context);
	assert(a.calls == 1 && b.calls == 1 && a.current().state() == WINDOW_CLOSE_AWAITING_DECISION && b.current().state() == WINDOW_CLOSE_AWAITING_DECISION);
	fresh.cancel(); assert(first.isOpen() && second.isOpen() && added.isOpen());
	assert(first.close() == CALLBACK_CANCELLATION_COMPLETE && second.close() == CALLBACK_CANCELLATION_COMPLETE && added.close() == CALLBACK_CANCELLATION_COMPLETE); scope.cancel(); context.close();
}

void verifyQuitCapturedCancellation() {
	var context = MacOSViewContext(WindowWake()); var first = MacOSWindow("captured first", 100.0, 100.0, null, context); var second = MacOSWindow("captured second", 100.0, 100.0, null, context);
	Vector<MacOSWindow> windows = [first, second]; var scope = CallbackScope(); var a = WindowDecision(); var b = WindowDecision(); first.onCloseRequested(a, scope); second.onCloseRequested(b, scope);
	var request = first.requestClose(WINDOW_CLOSE_PROGRAM_REQUEST); drain(context); var pending = requiredTransaction(request); var saving = pending.decide(WINDOW_CLOSE_DECISION_SAVE, 1LL);
	var group = MacOSWindowQuitCoordinator(windows, context);
	assert(pending.completeSave(saving.attempt, 1LL, true, "").state == WINDOW_CLOSE_AUTHORIZED && first.isOpen());
	// This transaction did not exist when the group captured its members.
	var newer = requiredTransaction(second.requestClose(WINDOW_CLOSE_PROGRAM_REQUEST)); newer.decide(WINDOW_CLOSE_DECISION_CANCEL, 2LL);
	assert(!group.advance() && group.cancelled() && pending.state() == WINDOW_CLOSE_CANCELLED); drain(context);
	assert(a.calls == 1 && b.calls == 0 && first.isOpen() && second.isOpen());
	var fresh = MacOSWindowQuitCoordinator(windows, context); assert(!fresh.advance()); drain(context);
	assert(a.calls == 2 && b.calls == 1 && a.current() != pending && b.current() != newer); fresh.cancel();
	assert(first.close() == CALLBACK_CANCELLATION_COMPLETE && second.close() == CALLBACK_CANCELLATION_COMPLETE); scope.cancel(); context.close();
}

class WindowRootObservation implements IViewInteractionStateHandler { public void interactionChanged(ViewInteractionState state) {} }

void verifyCapturedRootPressure() {
	var context = MacOSViewContext(WindowWake(), 1, null, 1); var window = MacOSWindow("capture root", 120.0, 80.0, null, context);
	var root = MacOSView(); root.stateNode().configure(context); var scope = CallbackScope(); root.onInteractionStateChanged(WindowRootObservation(), scope);
	var windowScope = CallbackScope(); window.onStateChanged(WindowStates(), windowScope); long long generation = root.stateNode().generation();
	bool rejected = false; try { window.attachRoot(root); } catch (string error) { rejected = true; }
	assert(rejected && window.root() == null && root.nativeView().superview() == null && root.stateNode().generation() == generation);
	windowScope.cancel(); window.attachRoot(root); assert(window.root() == root && root.stateNode().generation() == generation + 1LL);
	var blocker = context.detachedEvents.captureOwner().reserveRegistration(true, false); assert(blocker != null);
	generation = root.stateNode().generation(); rejected = false; try { window.detachRoot(); } catch (string error) { rejected = true; }
	assert(rejected && window.root() == root && root.nativeView().superview() != null && root.stateNode().generation() == generation && window.isOpen());
	blocker.cancel(); assert(window.detachRoot() == root && root.nativeView().superview() == null);
	assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE && root.close() == CALLBACK_CANCELLATION_COMPLETE && window.close() == CALLBACK_CANCELLATION_COMPLETE); context.close();
}

int main() {
	NSApplication.sharedApplication();
	verifyState(); verifyResubscribeWithPendingState(); verifyResubscribeWithPendingState(8); verifyCapturedRootPressure(); verifySaveAndCancel(); verifyNativeAndEnteredClose(); verifyForcedClose(); verifyQuitGroup(); verifyQuitCancellation(); verifyQuitMembership(); verifyQuitUndeliveredCancellation(); verifyQuitCapturedCancellation();
	print("PASS: UI2 macOS window state and reversible close transactions"); return 0;
}
