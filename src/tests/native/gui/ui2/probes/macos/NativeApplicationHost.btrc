import Library.Callback;
import Library.GUI.IApplication;
import Library.GUI.IView;
import Library.GUI.IWindow;
import Library.GUI.MacOS.MacOSApplication;
import Library.GUI.MacOS.MacOSContainer;

import ./ApplicationHostProbe.btrc;
#include <assert.h>

/* Test-host requestTurn only records a plain atomic wake. It never services
 * application work on the producer's stack or owns an application receiver. */
class PublicTestHost implements IApplicationHost {
	private Atomic<int> _requests;
	public unsigned long long deadline = 0ULL;
	public PublicTestHost() { self._requests.init(0); }

	public bool requestTurn() { self._requests.fetchAdd(1, MemoryOrder.RELAXED); return true; }

	public void scheduleTurn(unsigned long long deadline) { self.deadline = deadline; }

	public int requests() { return self._requests.load(MemoryOrder.ACQUIRE); }
}

class PublicCountWork implements IApplicationWork {
	public int calls = 0;
	public void run() { self.calls++; }
}

class PublicRepostingWork implements IApplicationWork {
	private IApplication _application;
	private IApplicationHostAttachment _attachment;
	public int calls = 0;
	public PublicRepostingWork(IApplication application, IApplicationHostAttachment attachment) { self._application = application; self._attachment = attachment; }

	public void run() {
		self.calls++;
		if (self.calls == 1) {
			self._application.post(self);
			self._attachment.serviceTurn();
			assert(self.calls == 1);
		}
	}
}

class PublicPublicationReceiver implements IApplicationPublicationHandler {
	public int calls = 0;
	public long long payload = 0LL;
	public void deliver(ApplicationPublication publication) { self.calls++; self.payload = publication.payload; }
}

class PublicStateReceiver implements IViewInteractionStateHandler {
	public int calls = 0;
	public bool visible = true;
	public void interactionChanged(ViewInteractionState state) { self.calls++; self.visible = state.localVisible; }
}

class PublicClosingWork implements IApplicationWork {
	private IApplication _application;
	public bool returned = false;
	public PublicClosingWork(IApplication application) { self._application = application; }

	public void run() { assert(self._application.close() == CALLBACK_CANCELLATION_PENDING); self.returned = true; }
}

int main() {
	ui2InstallHostDelegate();
	var independent = MacOSContainer();
	IApplication application = MacOSApplication(2);
	assert(ui2HostDelegateUnchanged() && !application.isRunning());
	var host = PublicTestHost();
	var scope = CallbackScope();
	var attached = application.attachHost(host, scope);
	assert(attached.kind == APPLICATION_HOST_ATTACHED);
	var attachment = attached.attachment;
	if (attachment == null) { throw "Successful public host attachment has no registration"; }
	assert(application.isRunning() && ui2HostDelegateUnchanged());
	assert(application.attachHost(host, scope).kind == APPLICATION_HOST_ALREADY_ATTACHED);
	bool runRejected = false;
	try { application.run(); } catch (string error) { runRejected = true; }
	assert(runRejected && attachment.isOpen());

	var first = PublicCountWork(); var later = PublicCountWork();
	var delayed = application.schedule(later, 10.0, WORK_SUSPENSION_DEFER, 0LL);
	assert(delayed.kind == SCHEDULE_ACCEPTED);
	var delayedRegistration = delayed.registration;
	if (delayedRegistration == null) { throw "Accepted public scheduled work has no registration"; }
	application.post(first);
	assert(application.schedule(first, 0.0, WORK_SUSPENSION_DEFER, 0LL).kind == SCHEDULE_FULL);
	assert(first.calls == 0 && later.calls == 0);
	attachment.serviceTurn();
	assert(first.calls == 1 && later.calls == 0 && host.deadline > 0ULL);
	assert(delayedRegistration.cancel() == CALLBACK_CANCELLATION_COMPLETE);
	attachment.serviceTurn();
	assert(host.deadline == 0ULL && later.calls == 0);

	var repeat = PublicRepostingWork(application, attachment);
	application.post(repeat); attachment.serviceTurn();
	assert(repeat.calls == 1);
	attachment.serviceTurn(); assert(repeat.calls == 2);

	attachment.transition(APPLICATION_ACTIVITY_SUSPENDED);
	assert(application.schedule(first, 0.0, WORK_SUSPENSION_CANCEL, 0LL).kind == SCHEDULE_CANCELLED);
	assert(application.schedule(first, 0.0, WORK_SUSPENSION_REPLACE, 7LL).kind == SCHEDULE_ACCEPTED);
	assert(application.schedule(later, 0.0, WORK_SUSPENSION_REPLACE, 7LL).kind == SCHEDULE_REPLACED);
	attachment.serviceTurn(); assert(first.calls == 1 && later.calls == 0);
	attachment.transition(APPLICATION_ACTIVITY_ACTIVE);
	attachment.serviceTurn(); attachment.serviceTurn();
	assert(first.calls == 1 && later.calls == 1);

	var receiver = PublicPublicationReceiver();
	var publication = application.createPublisher(2, receiver, scope);
	assert(publication.kind == APPLICATION_PUBLISHER_CREATED);
	var publisher = publication.publisher;
	var publisherRegistration = publication.registration;
	if (publisher == null || publisherRegistration == null) { throw "Created public publisher has no owned route"; }
	int previousRequests = host.requests();
	Thread<int> producer = spawn(() => { return publisher.tryPublish(1LL, 1LL, WORK_SUSPENSION_DEFER, 0LL, 37LL) == PUBLISH_ACCEPTED ? 0 : 1; });
	assert(producer.join() == 0 && receiver.calls == 0 && host.requests() > previousRequests);
	attachment.serviceTurn();
	assert(receiver.calls == 1 && receiver.payload == 37LL);
	assert(publisherRegistration.cancel() == CALLBACK_CANCELLATION_COMPLETE);

	/* The real public factory must share the application's semantic context.
	 * No fixture reaches into a queue or invokes the observer itself. */
	var view = application.createContainer();
	bool foreignRejected = false;
	try { view.attach(independent); } catch (string error) { foreignRejected = true; }
	assert(foreignRejected && view.childCount() == 0 && independent.isOpen());
	var stateReceiver = PublicStateReceiver();
	view.onInteractionStateChanged(stateReceiver, scope);
	view.setVisible(false);
	assert(stateReceiver.calls == 0);
	attachment.serviceTurn();
	assert(stateReceiver.calls == 1 && !stateReceiver.visible);

	var closing = PublicClosingWork(application);
	application.post(closing); attachment.serviceTurn();
	assert(closing.returned);
	assert(application.pollClose() == CALLBACK_CANCELLATION_COMPLETE);
	assert(attachment.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE && !application.isRunning());
	assert(!view.isOpen() && ui2HostDelegateUnchanged());
	assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE);
	assert(application.attachHost(host, scope).kind == APPLICATION_HOST_APPLICATION_CLOSED);
	assert(independent.isOpen() && independent.close() == CALLBACK_CANCELLATION_COMPLETE);
	ui2RestoreHostDelegate();
	print("UI2 public application host shares bounded work, worker ingress and native view delivery");
	return 0;
}
