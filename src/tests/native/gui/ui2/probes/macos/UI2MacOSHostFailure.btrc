import Library.Callback;
import Library.GUI.IApplication;
import Library.GUI.IWindow;
import Library.GUI.ITextField;
import Library.GUI.MacOS.MacOSApplication;
import Library.GUI.MacOS.MacOSApplicationExecutor;
import Library.BackgroundJobs.NativeWorker;

import ./Foundation.btrc;
#include <unistd.h>
#include <assert.h>

class ThrowingHost implements IApplicationHost {
	public bool failSchedule = false;
	public bool failWake = false;
	public int failures = 0;
	public bool requestTurn() { if (self.failWake) { self.failures++; throw "controlled macOS host wake failure"; } return true; }

	public void scheduleTurn(unsigned long long deadline) { if (self.failSchedule) { self.failures++; throw "controlled macOS host schedule failure"; } }
}

class HostCounter implements IApplicationWork {
	public int calls = 0;
	public void run() { self.calls++; }
}

class ArmHostFailure implements IApplicationWork {
	public MacOSApplication application;
	public ThrowingHost host;
	public HostCounter child;
	public bool failWake = false;
	public int calls = 0;
	public ICallbackRegistration? childRegistration;
	public void run() {
		self.calls++;
		// Admitted this round, the child remains queued for the next fair turn.
		var outcome = self.application.schedule(self.child, 0.0, WORK_SUSPENSION_DEFER, 0LL);
		assert(outcome.kind == SCHEDULE_ACCEPTED && outcome.registration != null); self.childRegistration = outcome.registration;
		self.host.failWake = self.failWake; self.host.failSchedule = !self.failWake;
	}
}

void verifyHostFailure(bool failWake) {
	var application = MacOSApplication(4); var scope = CallbackScope(); var host = ThrowingHost();
	var window = application.createWindow("host failure", 140.0, 100.0); var field = application.createTextField("owned", ""); window.attachRoot(field);
	var attached = application.attachHost(host, scope); assert(attached.kind == APPLICATION_HOST_ATTACHED);
	var attachment = attached.attachment; if (attachment == null) { throw "Missing host attachment"; }
	var child = HostCounter(); var work = ArmHostFailure(); work.application = application; work.host = host; work.child = child; work.failWake = failWake;
	var registration = application.postAfter(0.0, work);
	bool escaped = false;
	try { attachment.serviceTurn(); } catch (string error) { escaped = true; }
	assert(!escaped && work.calls == 1 && child.calls == 0 && host.failures == 1);
	for (int turn = 0; turn < 100 && attachment.pollCompletion() == CALLBACK_CANCELLATION_PENDING; turn++) { attachment.serviceTurn(); }
	assert(attachment.pollCompletion() == CALLBACK_CANCELLATION_FAILED && !attachment.isOpen());
	assert(!window.isOpen() && window.pollClose() == CALLBACK_CANCELLATION_COMPLETE && !field.isOpen());
	assert(registration.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE);
	var childRegistration = work.childRegistration; assert(childRegistration != null && childRegistration.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE);
	string expected = failWake ? "controlled macOS host wake failure" : "controlled macOS host schedule failure";
	assert(application.workFailure() == expected);
	application.recordHostFailure("later failure"); assert(application.workFailure() == expected);
	attachment.serviceTurn(); assert(host.failures == 1 && child.calls == 0);
	assert(application.close() == CALLBACK_CANCELLATION_COMPLETE); assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE && scope.pendingCount() == 0);
	assert(attachment.cancel() == CALLBACK_CANCELLATION_FAILED && attachment.pollCompletion() == CALLBACK_CANCELLATION_FAILED);
}

class EnteredHostFailure implements IApplicationWork {
	public MacOSApplication application;
	public IApplicationHostAttachment attachment;
	public CallbackScope scope;
	public IWindow window;
	public bool pendingObserved = false;
	public void run() {
		self.application.recordHostFailure("entered host work failure");
		assert(self.attachment.cancel() == CALLBACK_CANCELLATION_PENDING);
		assert(self.scope.cancel() == CALLBACK_CANCELLATION_PENDING && self.scope.pendingCount() == 1);
		self.pendingObserved = self.window.isOpen();
	}
}

void verifyEnteredFailureDrain() {
	var application = MacOSApplication(4); var scope = CallbackScope(); var window = application.createWindow("entered failure", 140.0, 100.0);
	var attached = application.attachHost(ThrowingHost(), scope); var attachment = attached.attachment;
	if (attachment == null) { throw "Missing entered host attachment"; }
	var work = EnteredHostFailure(); work.application = application; work.attachment = attachment; work.scope = scope; work.window = window;
	var registration = application.postAfter(0.0, work); attachment.serviceTurn();
	assert(work.pendingObserved && registration.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE);
	assert(attachment.pollCompletion() == CALLBACK_CANCELLATION_FAILED && window.pollClose() == CALLBACK_CANCELLATION_COMPLETE);
	assert(scope.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE && scope.pendingCount() == 0);
	assert(application.workFailure() == "entered host work failure" && application.close() == CALLBACK_CANCELLATION_COMPLETE);
}

void verifyDirectCloseFailure() {
	var application = MacOSApplication(4); var scope = CallbackScope(); var host = ThrowingHost();
	var window = application.createWindow("direct close failure", 140.0, 100.0);
	var attached = application.attachHost(host, scope); var attachment = attached.attachment;
	if (attachment == null) { throw "Missing direct-close attachment"; }
	host.failSchedule = true;
	assert(application.close() == CALLBACK_CANCELLATION_COMPLETE && window.pollClose() == CALLBACK_CANCELLATION_COMPLETE);
	assert(host.failures == 1 && attachment.pollCompletion() == CALLBACK_CANCELLATION_FAILED);
	assert(application.workFailure() == "controlled macOS host schedule failure");
	assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE && scope.pendingCount() == 0);
	assert(attachment.cancel() == CALLBACK_CANCELLATION_FAILED && application.close() == CALLBACK_CANCELLATION_COMPLETE && host.failures == 1);
}

class BlockingHost implements IApplicationHost {
	public Atomic<bool> entered;
	public Atomic<bool> released;
	public bool failSchedule = false;
	public int failures = 0;
	public BlockingHost() { self.entered.init(false); self.released.init(false); }

	public bool requestTurn() {
		if (NSThread.isMainThread()) { return true; }
		self.entered.store(true, MemoryOrder.RELEASE);
		while (!self.released.load(MemoryOrder.ACQUIRE)) { usleep(100); }
		return true;
	}

	public void scheduleTurn(unsigned long long deadline) { if (self.failSchedule) { self.failures++; throw "controlled blocked-host schedule failure"; } }
}

class HostPublication implements IApplicationPublicationHandler {
	public int calls = 0;
	public void deliver(ApplicationPublication publication) { self.calls++; }
}

class HostProducer implements INativeWorkerBody {
	public IApplicationPublisher publisher;
	public PublishOutcome outcome = PUBLISH_INVALID;
	public int workLoop() { self.outcome = self.publisher.tryPublish(1LL, 1LL, WORK_SUSPENSION_DEFER, 0LL, 9LL); return 0; }
}

void verifyAdmittedHostNotificationDrain() {
	var application = MacOSApplication(4); var scope = CallbackScope(); var publications = CallbackScope(); var host = BlockingHost();
	var window = application.createWindow("admitted host wake", 140.0, 100.0); var receiver = HostPublication();
	var attached = application.attachHost(host, scope); var attachment = attached.attachment;
	if (attachment == null) { throw "Missing blocked-host attachment"; }
	var created = application.createPublisher(2, receiver, publications); var publisher = created.publisher;
	if (publisher == null) { throw "Missing blocked-host publisher"; }
	var body = HostProducer(); body.publisher = publisher; var worker = NativeWorker(); assert(worker.start(body) == NATIVE_WORKER_STARTED);
	unsigned long long deadline = MacOSApplicationExecutor.now() + 5000000000ULL;
	while (!host.entered.load(MemoryOrder.ACQUIRE) && MacOSApplicationExecutor.now() < deadline) { usleep(100); }
	assert(host.entered.load(MemoryOrder.ACQUIRE)); host.failSchedule = true;
	assert(application.close() == CALLBACK_CANCELLATION_PENDING && attachment.cancel() == CALLBACK_CANCELLATION_PENDING);
	assert(scope.cancel() == CALLBACK_CANCELLATION_PENDING && window.isOpen() && host.failures == 1);
	assert(publisher.tryPublish(1LL, 2LL, WORK_SUSPENSION_DEFER, 0LL, 10LL) == PUBLISH_CLOSED && receiver.calls == 0);
	host.released.store(true, MemoryOrder.RELEASE); assert(worker.join() && !worker.workerFailed() && body.outcome == PUBLISH_ACCEPTED);
	assert(attachment.pollCompletion() == CALLBACK_CANCELLATION_FAILED && window.pollClose() == CALLBACK_CANCELLATION_COMPLETE);
	assert(scope.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE && publications.cancel() == CALLBACK_CANCELLATION_COMPLETE);
	assert(application.workFailure() == "controlled blocked-host schedule failure" && host.failures == 1 && receiver.calls == 0);
	assert(attachment.cancel() == CALLBACK_CANCELLATION_FAILED && application.close() == CALLBACK_CANCELLATION_COMPLETE);
}

int main() {
	verifyHostFailure(false); verifyHostFailure(true); verifyEnteredFailureDrain(); verifyDirectCloseFailure(); verifyAdmittedHostNotificationDrain();
	print("PASS: UI2 macOS host failure ownership drains without losing failure"); return 0;
}
