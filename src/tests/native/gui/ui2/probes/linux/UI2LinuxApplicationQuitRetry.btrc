import Library.Callback;
import Library.GUI.IApplication;
import Library.GUI.Linux.LinuxApplication;
import Library.GUI.Linux.SDL;

import ./ApplicationQuitFaults.btrc;
#include <assert.h>

class LinuxQuitRetryPublication implements IApplicationPublicationHandler {
	public void deliver(ApplicationPublication publication) { assert(false); }
}

int main() {
	assert(SDL_Init((unsigned int)SDL_INIT_VIDEO | (unsigned int)SDL_INIT_EVENTS));
	var application = LinuxApplication(8); var scope = CallbackScope();
	var first = application.createPublisher(2, LinuxQuitRetryPublication(), scope);
	var second = application.createPublisher(2, LinuxQuitRetryPublication(), scope);
	var firstRegistration = first.registration; var secondRegistration = second.registration;
	assert(first.kind == APPLICATION_PUBLISHER_CREATED && second.kind == APPLICATION_PUBLISHER_CREATED);
	if (firstRegistration == null || secondRegistration == null) { throw "Cleanup requires both real publisher registrations"; }
	assert(ui2ArmQuitPublisherFault());
	try {
		application.requestQuit();
		assert(application.close() == CALLBACK_CANCELLATION_RETRYABLE_FAILURE);
		assert(ui2QuitPublisherFaultCount() == 1);
		assert(firstRegistration.pollCompletion() == CALLBACK_CANCELLATION_RETRYABLE_FAILURE);
		assert(secondRegistration.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE);
		assert(application.pollClose() == CALLBACK_CANCELLATION_RETRYABLE_FAILURE);
		assert(ui2QuitPublisherFaultCount() == 2);
	} finally { ui2DisarmQuitPublisherFault(); }
	assert(application.pollClose() == CALLBACK_CANCELLATION_COMPLETE);
	assert(firstRegistration.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE && secondRegistration.pollCompletion() == CALLBACK_CANCELLATION_COMPLETE);
	assert(ui2QuitPublisherFaultCount() == 2 && scope.cancel() == CALLBACK_CANCELLATION_COMPLETE);
	assert(application.close() == CALLBACK_CANCELLATION_COMPLETE);
	SDL_Quit();
	print("PASS: UI2 Linux quit retries native publisher cleanup without reopening ingress");
	return 0;
}
