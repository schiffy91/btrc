class UI2LinuxButtonReceiver implements IButtonAction {
	public int calls = 0;
	public void invoke() { self.calls++; }
}

class UI2LinuxClosingButtonReceiver implements IButtonAction {
	public IWindow window;
	public IButton button;
	public CallbackCancellation enteredState = CALLBACK_CANCELLATION_NOT_REQUESTED;
	public void invoke() { self.window.close(); self.enteredState = self.button.pollClose(); }
}

class UI2LinuxButtonChecks {
	class void click(ILinuxView view) {
		var event = AppPointerEvent(APP_POINTER_PRESSED, APP_POINTER_BUTTON_PRIMARY, 5.0, 5.0, AppKeyModifiers(false, false, false, false));
		assert(view.pointer(event)); event.action = APP_POINTER_RELEASED; assert(view.pointer(event));
	}

	class void retirement(LinuxApplication application) {
		var window = application.createWindow("UI2 button eligibility", 140.0, 90.0);
		var root = application.createContainer(); var button = application.createButton("queued");
		root.attach(button); window.attachRoot(root); window.show(); button.arrange(0.0, 0.0, 100.0, 30.0);
		var view = (ILinuxView?)button; assert(view != null);
		var receiver = UI2LinuxButtonReceiver(); var scope = CallbackScope(); button.onAction(receiver, scope);
		var actions = view.node().context.actions;
		var observed = actions.bind(view.node()); observed.onAction(receiver, scope); observed.invoke();
		UI2LinuxButtonChecks.click(view); assert(actions.pendingCount() == 2);
		root.setVisible(false); root.setVisible(true);
		actions.dispatchOne(); assert(receiver.calls == 0 && actions.pendingCount() == 0 && observed.ineligibleCount() == 1LL);
		UI2LinuxButtonChecks.click(view); button.setEnabled(false); button.setEnabled(true);
		actions.dispatchOne(); assert(receiver.calls == 0);
		UI2LinuxButtonChecks.click(view); var detached = root.detach(button); root.attach(detached);
		actions.dispatchOne(); assert(receiver.calls == 0);
		UI2LinuxButtonChecks.click(view); actions.dispatchOne(); assert(receiver.calls == 1);
		assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE); actions.unbind(observed);
		var closing = UI2LinuxClosingButtonReceiver(); closing.window = window; closing.button = button;
		var closingScope = CallbackScope(); button.onAction(closing, closingScope);
		UI2LinuxButtonChecks.click(view); actions.dispatchOne();
		assert(closing.enteredState == CALLBACK_CANCELLATION_PENDING);
		for (int turn = 0; turn < 100 && window.pollClose() == CALLBACK_CANCELLATION_PENDING; turn++) { application.pumpOnce(0); }
		assert(window.pollClose() == CALLBACK_CANCELLATION_COMPLETE && closingScope.cancel() == CALLBACK_CANCELLATION_COMPLETE);
	}
}

class UI2LinuxStateReceiver implements IViewInteractionStateHandler {
	public Vector<ViewInteractionState> states = [];
	public void interactionChanged(ViewInteractionState state) { assert(SDL_IsMainThread()); self.states.push(state); }
}

class UI2LinuxWindowStateReceiver implements IWindowStateHandler {
	public Vector<WindowState> states = [];
	public IWindow? closeDuring;
	public void stateChanged(WindowState state) {
		self.states.push(state);
		var window = self.closeDuring;
		if (window != null) { self.closeDuring = null; assert(window.close() == CALLBACK_CANCELLATION_PENDING); }
	}
}

class UI2LinuxWindowStateChecks {
	class void state(LinuxApplication application) {
		var window = application.createWindow("UI2 coherent window state", 140.0, 90.0);
		var receiver = UI2LinuxWindowStateReceiver(); var scope = CallbackScope(); window.onStateChanged(receiver, scope);
		var initial = window.state(); assert(!initial.requestedVisible && !initial.nativeVisible && !initial.presentable);
		assert(receiver.states.len == 0 && initial.width == 140.0 && initial.height == 90.0 && initial.backingScale > 0.0);
		for (int turn = 0; turn < 20; turn++) { application.pumpOnce(0); }
		assert(receiver.states.len == 0 && window.state().stateRevision == initial.stateRevision);
		window.show(); var shown = window.state(); assert(shown.requestedVisible && shown.nativeVisible && shown.presentable && shown.stateRevision > initial.stateRevision);
		window.setContentSize(180.0, 120.0); var resized = window.state();
		unsigned long long resizeDeadline = SDL_GetTicksNS() + 5000000000ULL;
		while ((resized.width != 180.0 || resized.height != 120.0) && SDL_GetTicksNS() < resizeDeadline) { application.pumpOnce(1); resized = window.state(); }
		assert(resized.width == 180.0 && resized.height == 120.0 && resized.stateRevision > shown.stateRevision);
		for (int turn = 0; turn < 20; turn++) { application.pumpOnce(0); }
		assert(receiver.states.len > 0 && receiver.states.get(receiver.states.len - 1).width == 180.0);
		var delivered = receiver.states.get(receiver.states.len - 1); var beforeMutation = window.state();
		assert(delivered.stateRevision > initial.stateRevision && delivered.stateRevision == beforeMutation.stateRevision);
		delivered.width = -1.0; delivered.requestedVisible = false; delivered.stateRevision = -1LL;
		var preserved = window.state(); assert(preserved.width == beforeMutation.width && preserved.requestedVisible && preserved.stateRevision == beforeMutation.stateRevision);
		long long revision = window.state().stateRevision; window.setContentSize(180.0, 120.0); assert(window.state().stateRevision == revision);
		window.hide(); var hidden = window.state(); assert(!hidden.requestedVisible && !hidden.nativeVisible && !hidden.presentable && hidden.notExposedReason == WINDOW_EXPOSURE_REASON_HIDDEN);
		for (int turn = 0; turn < 20; turn++) { application.pumpOnce(0); }
		receiver.closeDuring = window; window.show();
		for (int turn = 0; turn < 100 && window.pollClose() != CALLBACK_CANCELLATION_COMPLETE; turn++) { application.pumpOnce(0); }
		assert(window.pollClose() == CALLBACK_CANCELLATION_COMPLETE && !window.state().nativeVisible && !window.state().presentable);
		assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE);
	}
}

class UI2LinuxImageChecks {
	class void retainedPixels(LinuxApplication application) {
		var window = application.createWindow("UI2 retained pixels", 80.0, 80.0);
		var native = application.firstWindow(); assert(native != null && (IWindow)native == window);
		var view = application.createImageView(); window.attachRoot(view); window.show();
		var pixels = Image(2, 2);
		for (int index = 0; index < 4; index++) { pixels.data[index * 4] = 12; pixels.data[index * 4 + 1] = 210; pixels.data[index * 4 + 2] = 34; pixels.data[index * 4 + 3] = 255; }
		var handle = LinuxImageHandle.create(pixels, 4); view.setImageHandle(handle);
		unsigned long long deadline = SDL_GetTicksNS() + 5000000000ULL;
		while (!native.pollDevice() && SDL_GetTicksNS() < deadline) { application.pumpOnce(1); }
		assert(native.pollDevice());
		var before = native.render(true); assert(before != null);
		var first = before.pixel(before.width / 2, before.height / 2); assert(first.green > 190 && first.red < 30);
		int identity = handle.identity(); handle.close(); assert(handle.identity() == identity);
		var after = native.render(true); assert(after != null);
		var retained = after.pixel(after.width / 2, after.height / 2);
		assert(retained.red == first.red && retained.green == first.green && retained.blue == first.blue);
		assert(view.fittingWidth() == 2.0 && view.fittingHeight() == 2.0);
		bool refused = false; try { view.setImageHandle(handle); } catch (string error) { refused = true; } assert(refused);
		view.setImageHandle(null);
		var cleared = native.render(true); assert(cleared != null);
		assert(cleared.pixel(cleared.width / 2, cleared.height / 2).green < 100);
		window.close();
		for (int turn = 0; turn < 100 && window.pollClose() == CALLBACK_CANCELLATION_PENDING; turn++) { application.pumpOnce(0); }
		assert(window.pollClose() == CALLBACK_CANCELLATION_COMPLETE);
	}
}

/* This injected provider attachment fails after its actual node transition;
 * one failure exercises successful inverse attachment, two exercise quarantine.
 * It never implements batch behavior or modifies the production result. */
class UI2LinuxAttachFault extends LinuxNodeView {
	public int failures = 0;
	public UI2LinuxAttachFault(LinuxContext context) { self.adoptNode(LinuxViewNode(context)); }

	public void attachTo(LinuxViewHost? host) { self.node().setHost(host); if (self.failures > 0) { self.failures--; throw "deliberate provider attachment failure"; } }
}

class UI2LinuxMutationChecks {
	class void pendingImage(LinuxApplication application, int cycle) {
		var window = application.createWindow("UI2 focused pending image mutation", 160.0, 80.0);
		var root = application.createContainer(); var text = LinuxTextField(application.context(), "draft", "");
		var image = application.createImageView(); var retained = image;
		root.attach(text); root.attach(image); window.attachRoot(root); window.show();
		text.arrange(0.0, 0.0, 80.0, 30.0); image.arrange(80.0, 0.0, 80.0, 80.0);
		var native = application.firstWindow(); assert(native != null && (IWindow)native == window);
		unsigned long long deadline = SDL_GetTicksNS() + 5000000000ULL;
		while (!native.pollDevice() && SDL_GetTicksNS() < deadline) { application.pumpOnce(1); }
		assert(native.pollDevice()); text.node().requestFocus();
		for (int turn = 0; turn < 20; turn++) { application.pumpOnce(0); }
		var host = text.node().host; assert(host != null && host.focusedId == text.node().id);
		var events = UI2LinuxMutationTextEvents(); var scope = CallbackScope();
		text.onCommit(events, scope); text.onCancel(events, scope);
		text.textEditing("pending", 3, 0); string draft = text.text();
		var previous = LinuxImageHandle.create(PendingImageGate.pixels(31), 4); image.setImageHandle(previous); previous.close();
		var gate = PendingImageGate(); int red = 100 + cycle;
		Thread<LinuxImageHandle> worker = spawn(() => { var handle = LinuxImageHandle.create(PendingImageGate.pixels(red), 4); gate.hold(); return handle; });
		LinuxImageHandle? completed = null;
		try {
			gate.waitReady(); assert(!gate.proceed.load(MemoryOrder.ACQUIRE));
			long long revision = root.treeRevision();
			var fault = UI2LinuxAttachFault(application.context()); fault.failures = cycle % 3 == 0 ? 0 : 1;
			var move = ContainerEdit(); move.kind = CONTAINER_EDIT_MOVE; move.child = image; move.index = 0;
			var insert = ContainerEdit(); insert.kind = CONTAINER_EDIT_INSERT; insert.child = fault; insert.index = 1;
			Vector<ContainerEdit> edits = [move, insert];
			if (cycle % 3 == 1) { edits = [insert, move]; }
			var result = root.applyBatch(revision, edits);
			if (cycle % 3 != 0) {
				assert(result.kind == CONTAINER_BATCH_ROLLED_BACK && result.failedStep == (cycle % 3 == 1 ? 0 : 1));
				assert(root.treeRevision() == revision && root.childCount() == 2 && root.childAt(0) == text && root.childAt(1) == retained && !fault.node().attached);
				assert(text.node().host == host && host.focusedId == text.node().id && text.text().equals(draft));
				result = root.applyBatch(revision, edits);
			}
			assert(result.kind == CONTAINER_BATCH_COMMITTED && root.childCount() == 3 && root.childAt(0) == retained);
			assert(result.retained.contains(retained) && fault.isOpen());
			assert(root.detach(fault) == fault && root.childCount() == 2 && fault.close() == CALLBACK_CANCELLATION_COMPLETE);
			assert(text.node().host == host && host.focusedId == text.node().id && text.text().equals(draft) && events.calls == 0);
			var before = native.render(true); assert(before != null);
			var pixel = before.pixel(before.width * 3 / 4, before.height / 2); assert(pixel.red == 31 && pixel.green == 17 && pixel.blue == 39);
		} finally { gate.proceed.store(true, MemoryOrder.RELEASE); completed = worker.join(); }
		assert(completed != null && completed.isOpen() && !gate.expired.load(MemoryOrder.ACQUIRE));
		retained.setImageHandle(completed); completed.close();
		var after = native.render(true); assert(after != null);
		var pixel = after.pixel(after.width * 3 / 4, after.height / 2); assert(pixel.red == red && pixel.green == 17 && pixel.blue == 39);
		assert(text.node().host == host && host.focusedId == text.node().id && text.text().equals(draft) && events.calls == 0);
		assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE);
		var lateGate = PendingImageGate();
		Thread<LinuxImageHandle> late = spawn(() => { var handle = LinuxImageHandle.create(PendingImageGate.pixels(240), 4); lateGate.hold(); return handle; });
		LinuxImageHandle? lateImage = null;
		try {
			lateGate.waitReady(); window.close();
			for (int turn = 0; turn < 100 && window.pollClose() == CALLBACK_CANCELLATION_PENDING; turn++) { application.pumpOnce(0); }
			assert(window.pollClose() == CALLBACK_CANCELLATION_COMPLETE && !retained.isOpen());
		} finally { lateGate.proceed.store(true, MemoryOrder.RELEASE); lateImage = late.join(); }
		assert(lateImage != null);
		bool rejected = false; try { retained.setImageHandle(lateImage); } catch (string error) { rejected = true; }
		lateImage.close(); assert(rejected && !lateImage.isOpen() && !lateGate.expired.load(MemoryOrder.ACQUIRE));
	}

	class void mutation(LinuxApplication application) {
		var window = application.createWindow("UI2 mutation", 80.0, 80.0);
		var root = application.createContainer(); var red = application.createPanel(RGBA(220, 10, 10, 255), 0.0); var blue = application.createPanel(RGBA(10, 10, 220, 255), 0.0);
		red.arrange(0.0, 0.0, 80.0, 80.0); blue.arrange(0.0, 0.0, 80.0, 80.0);
		root.attach(red); root.attach(blue);
		// An empty committed batch must also leave the application dispatchable.
		Vector<ContainerEdit> empty = []; var emptyResult = root.applyBatch(root.treeRevision(), empty);
		assert(emptyResult.kind == CONTAINER_BATCH_COMMITTED); application.pumpOnce(0);
		window.attachRoot(root); window.show();
		var nativeWindow = application.firstWindow(); assert(nativeWindow != null && (IWindow)nativeWindow == window); var nativeRoot = (ILinuxView?)root; var nativeRed = (ILinuxView?)red;
		assert(nativeWindow != null && nativeRoot != null && nativeRed != null);
		unsigned long long deadline = SDL_GetTicksNS() + 5000000000ULL;
		while (!nativeWindow.pollDevice() && SDL_GetTicksNS() < deadline) { application.pumpOnce(1); }
		assert(nativeWindow.pollDevice());
		var before = nativeWindow.render(true); assert(before != null && before.pixel(before.width / 2, before.height / 2).blue > 200);
		long long generation = nativeRed.node().generation(); long long revision = root.treeRevision();
		root.move(red, 1); assert(root.childAt(1) == red && root.treeRevision() == revision + 1LL && nativeRed.node().generation() == generation);
		var after = nativeWindow.render(true); assert(after != null && after.pixel(after.width / 2, after.height / 2).red > 200);
		var edit = ContainerEdit(); edit.kind = CONTAINER_EDIT_MOVE; edit.child = red; edit.index = 0; Vector<ContainerEdit> edits = [edit];
		var stale = root.applyBatch(revision, edits); assert(stale.kind == CONTAINER_BATCH_REJECTED && root.childAt(1) == red);
		revision = root.treeRevision();
		var fault = UI2LinuxAttachFault(nativeRoot.node().context); fault.failures = 1;
		edit = ContainerEdit(); edit.kind = CONTAINER_EDIT_INSERT; edit.child = fault; edit.index = 1; edits = [edit];
		var rolled = root.applyBatch(revision, edits);
		assert(rolled.kind == CONTAINER_BATCH_ROLLED_BACK && rolled.failedStep == 0 && rolled.treeRevision == revision);
		assert(root.childCount() == 2 && root.childAt(1) == red && !fault.node().attached && fault.isOpen());
		fault.failures = 2;
		var quarantined = root.applyBatch(revision, edits);
		assert(quarantined.kind == CONTAINER_BATCH_FAILED_QUARANTINED && root.interactionState().faulted);
		assert(root.childCount() == 2 && root.childAt(1) == red && quarantined.retained.contains(fault));
		bool refused = false; try { root.move(red, 0); } catch (string error) { refused = true; } assert(refused);
		window.close();
		for (int turn = 0; turn < 100 && window.pollClose() == CALLBACK_CANCELLATION_PENDING; turn++) { application.pumpOnce(0); }
		assert(window.pollClose() == CALLBACK_CANCELLATION_COMPLETE && !red.isOpen() && !blue.isOpen() && !fault.isOpen());
	}
}

class UI2LinuxMutationTextEvents implements ITextControlEventHandler {
	public int calls = 0;
	public void textEvent(TextControlEvent event) { self.calls++; }
}

void verifyLifecycleCycle(int cycle) {
	var application = LinuxApplication(16); int credits = application.context().terminalPool.available(); var window = application.createWindow("UI2 eligibility", 240.0, 120.0);
	var root = application.createContainer(); var button = application.createButton("retained preference");
	var receiver = UI2LinuxStateReceiver(); var scope = CallbackScope();
	var initial = button.interactionState();
	assert(initial.localVisible && initial.localEnabled && !initial.effectiveEligible && initial.layoutParticipating);
	button.onInteractionStateChanged(receiver, scope);
	assert(receiver.states.len == 0);
	root.attach(button); window.attachRoot(root); window.show();
	for (int turn = 0; turn < 20; turn++) { application.pumpOnce(0); }
	assert(button.interactionState().effectiveEligible && button.interactionState().stateRevision > initial.stateRevision);
	root.setVisible(false);
	var hidden = button.interactionState();
	assert(hidden.localVisible && hidden.localEnabled && !hidden.inheritedEligible && !hidden.effectiveEligible && hidden.layoutParticipating);
	for (int turn = 0; turn < 20; turn++) { application.pumpOnce(0); }
	assert(receiver.states.len > 0 && !receiver.states.get(receiver.states.len - 1).effectiveEligible);
	button.setEnabled(false); root.setVisible(true);
	var disabled = button.interactionState();
	assert(disabled.localVisible && !disabled.localEnabled && disabled.inheritedEligible && !disabled.effectiveEligible);
	button.setEnabled(true); assert(button.interactionState().effectiveEligible);
	var detached = root.detach(button);
	assert(detached == button && !button.interactionState().effectiveEligible);
	root.attach(button); assert(button.interactionState().effectiveEligible);
	for (int turn = 0; turn < 20; turn++) { application.pumpOnce(0); }
	assert(receiver.states.get(receiver.states.len - 1).effectiveEligible);
	assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE);
	int delivered = receiver.states.len; root.setVisible(false);
	for (int turn = 0; turn < 20; turn++) { application.pumpOnce(0); }
	assert(receiver.states.len == delivered);
	window.close();
	for (int turn = 0; turn < 100 && window.pollClose() == CALLBACK_CANCELLATION_PENDING; turn++) { application.pumpOnce(0); }
	assert(window.pollClose() == CALLBACK_CANCELLATION_COMPLETE && !button.isOpen());
	UI2LinuxButtonChecks.retirement(application); UI2LinuxWindowStateChecks.state(application); UI2LinuxImageChecks.retainedPixels(application); UI2LinuxMutationChecks.mutation(application);
	UI2LinuxMutationChecks.pendingImage(application, cycle);
	assert(application.context().actions.pendingCount() == 0);
	assert(application.close() == CALLBACK_CANCELLATION_COMPLETE);
	assert(application.context().terminalPool.available() == credits);
	assert(application.context().detachedEvents.pendingCount() == 0);
	assert(scope.pendingCount() == 0 && ui2NativeWindowCount() == 0);
}

int main() {
	assert(SDL_Init((unsigned int)SDL_INIT_VIDEO | (unsigned int)SDL_INIT_EVENTS));
	assert(ui2NativeWindowCount() == 0);
	for (int cycle = 0; cycle < 100; cycle++) {
		verifyLifecycleCycle(cycle); assert(ui2NativeWindowCount() == 0);
		printf("UI2_CYCLE lifecycle %d windows=0\n", cycle + 1); fflush(stdout);
	}
	printf("UI2_POLICY lifecycle work_capacity=16 fault_step=0 rollback_failures=1 quarantine_failures=2\n");
	printf("UI2_E29 pending_image cycles=100 commit=34 rollback_step0=33 rollback_step1=33 late_closed=100\n");
	printf("PASS: UI2 Linux inherited eligibility and scoped observations\n"); SDL_Quit(); return 0;
}
