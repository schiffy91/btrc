import Library.Callback;
import Library.Vector;
import Library.UI.Element;
import Library.GUI.ISlider;
import Library.GUI.ControlEvents;
import Library.GUI.Linux.LinuxApplication;
import Library.GUI.Linux.LinuxWindow;
import Library.GUI.Linux.SDL;

#include <assert.h>

class LinuxSliderReceiver implements ISliderControlEventHandler {
	public Vector<SliderControlEvent> events = [];
	public void sliderEvent(SliderControlEvent event) { assert(SDL_IsMainThread()); self.events.push(event); }
}
class LinuxSliderChecks {
	class void pump(LinuxApplication application) { for (int turn = 0; turn < 20; turn++) { application.pumpOnce(0); } }

	class void key(unsigned int window, unsigned int key) { btrcSdlPushKey(window, 0u, key, 0u, 1, 0); btrcSdlPushKey(window, 0u, key, 0u, 0, 0); }
}

int main() {
	var application = LinuxApplication(64); var window = application.createWindow("UI2 slider interactions", 240.0, 60.0);
	var slider = application.createSlider(0.0, 10.0, 1001); slider.setRange(0.0, 10.0, 1.0);
	window.attachRoot(slider); window.show();
	var native = (ILinuxWindow?)window; if (native == null) { throw "Missing Linux window"; }
	var previews = LinuxSliderReceiver(); var commits = LinuxSliderReceiver(); var cancels = LinuxSliderReceiver(); var scope = CallbackScope();
	slider.onPreview(previews, scope); slider.onCommit(commits, scope); slider.onCancel(cancels, scope);
	LinuxSliderChecks.pump(application); assert(previews.events.isEmpty() && commits.events.isEmpty() && cancels.events.isEmpty());
	btrcSdlPushPointerButton(native.nativeId(), 120.0f, 20.0f, 1u, 1, 1u);
	assert(previews.events.isEmpty()); LinuxSliderChecks.pump(application);
	assert(previews.events.len == 1 && commits.events.isEmpty());
	double midpoint = slider.value(); slider.setValue(midpoint); assert(cancels.events.isEmpty());
	btrcSdlPushPointerButton(native.nativeId(), 120.0f, 20.0f, 1u, 0, 1u); LinuxSliderChecks.pump(application);
	assert(commits.events.len == 1 && commits.events.get(0).value == midpoint);
	btrcSdlPushPointerButton(native.nativeId(), 230.0f, 20.0f, 1u, 1, 1u); LinuxSliderChecks.pump(application);
	assert(slider.value() > midpoint);
	LinuxSliderChecks.key(native.nativeId(), (unsigned int)SDLK_ESCAPE); LinuxSliderChecks.pump(application);
	assert(slider.value() == midpoint && cancels.events.len == 1 && cancels.events.get(0).cancelReason == CONTROL_CANCEL_ESCAPE);
	btrcSdlPushPointerButton(native.nativeId(), 230.0f, 20.0f, 1u, 0, 1u); LinuxSliderChecks.pump(application); assert(commits.events.len == 1);
	btrcSdlPushPointerButton(native.nativeId(), 230.0f, 20.0f, 1u, 1, 1u); LinuxSliderChecks.pump(application);
	var range = SliderRange(); range.minimum = -5.0; range.maximum = 15.0; range.step = 2.0;
	slider.setRangeValue(range, 3.0); LinuxSliderChecks.pump(application);
	assert(slider.value() == 3.0 && cancels.events.len == 2 && cancels.events.get(1).context.origin == CONTROL_ORIGIN_MODEL);
	btrcSdlPushPointerButton(native.nativeId(), 230.0f, 20.0f, 1u, 0, 1u); LinuxSliderChecks.pump(application); assert(commits.events.len == 1);
	int previewCount = previews.events.len;
	LinuxSliderChecks.key(native.nativeId(), (unsigned int)SDLK_RIGHT); LinuxSliderChecks.pump(application);
	assert(slider.value() == 5.0 && commits.events.len == 2 && previews.events.len == previewCount);
	assert(commits.events.get(1).input == SLIDER_INPUT_RELATIVE_ADJUSTMENT && commits.events.get(1).adjustment == UI_RANGE_ADJUST_SMALL_INCREMENT);
	slider.setRange(7.0, 7.0, 0.0);
	LinuxSliderChecks.key(native.nativeId(), (unsigned int)SDLK_RIGHT); LinuxSliderChecks.pump(application);
	assert(slider.value() == 7.0 && commits.events.len == 2);
	assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE); window.close(); LinuxSliderChecks.pump(application);
	assert(window.pollClose() == CALLBACK_CANCELLATION_COMPLETE && application.close() == CALLBACK_CANCELLATION_COMPLETE);
	print("PASS: UI2 Linux slider drag cancellation and keyboard intents"); SDL_Quit(); return 0;
}
