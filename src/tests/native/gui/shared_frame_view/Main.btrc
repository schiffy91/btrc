import Library.GUI;
import Library.Platform;
import Library.GUI.SharedFrameView;
import Library.Console;
import Library.FileSystem;
import Library.Timer;

class Visit implements IApplicationWork {
	private ISharedFrameView view;
	private string folder;
	private int producer;
	private int step = 0;
	private long long deadline = MonotonicClock.deadlineAfter(25000);
	public int status = 1;

	public Visit(ISharedFrameView view, string folder, int producer) {
		self.view = view;
		self.folder = folder;
		self.producer = producer;
		self.publishAddress("first");
	}

	private void publishAddress(string name) {
		var endpoint = self.view.listen(self.producer);
		if (endpoint.transport() != (Platform.isApple() ? "iosurface" : "dmabuf") || endpoint.address().isEmpty()) { throw "Invalid frame endpoint"; }
		if (!FileSystem.writeAtomic(PathTools.join(self.folder, name), endpoint.address(), 0o600)) { throw "Cannot publish test address"; }
	}

	public void run() {
		try {
			if (!MonotonicClock.before(self.deadline)) { throw "Shared frame test timed out"; }
			if (FileSystem.isFile(PathTools.join(self.folder, f"sent-{self.step}"))) {
				var accepted = self.view.presentPending();
				if (self.step < 2) {
					if (accepted || self.view.frameWidth() != 0) { throw "Unexpected producer or pixel format accepted"; }
				} else {
					var width = self.step == 2 ? 640 : 320;
					if (!accepted || self.view.frameWidth() != width || self.view.frameHeight() != width / 2) { throw "Expected frame was not presented"; }
					if (self.view.presentPending()) { throw "An empty receiver presented a frame"; }
				}
				if (self.step == 3) { self.publishAddress("second"); }
				if (self.step == 4) {
					self.view.disconnect();
					if (self.view.frameWidth() != 0 || self.view.frameHeight() != 0 || self.view.presentPending()) { throw "Disconnect retained a frame"; }
				}
				if (!FileSystem.writeText(PathTools.join(self.folder, f"done-{self.step}"), "1")) { throw "Cannot confirm test frame"; }
				if (self.step == 4) { self.status = 0; GUI.requestQuit(); return; }
				self.step++;
			}
			GUI.postAfter(0.005, self);
		} catch (string error) { Console.error(error); GUI.requestQuit(); }
	}
}

int main(Vector<string> args) {
	if (args.length != 2) { return 1; }
	GUI.initialize();
	try {
		var window = GUI.createWindow("Shared frame view", 640.0, 320.0);
		var root = GUI.createContainer();
		window.attachRoot(root);
		var view = SharedFrameView.create();
		root.attach(view);
		view.arrange(0.0, 0.0, 640.0, 320.0);
		window.show();
		var visit = Visit(view, args.get(0), args.get(1).toInt());
		GUI.post(visit);
		GUI.run();
		return visit.status;
	} finally { GUI.close(); }
}
