/* D24: recovered lossless-delivery reproduction; never merge the fixture-only
 * commit without the event-pump fix. The native observer only isolates the input
 * queue and peeks its length; ShimApplication owns every dequeue. */
import Library.App;
import Library.Callback;
import Library.Vector;
import Library.GUI.IApplication;
import Library.GUI.IWindow;
import Library.GUI.ITextField;
import Library.GUI.Shim.Shim;
import Library.GUI.Shim.ShimApplication;
import Library.GUI.Shim.ShimView;
import Library.GUI.Shim.ShimWindow;

#include <assert.h>
#include <stdio.h>
#include <stdlib.h>

class BoundaryKeys implements IWindowKeyHandler {
	public Vector<int> codes = [];
	public int releases = 0;
	public bool key(AppKeyboardEvent event) {
		self.codes.push(eventBoundaryLatest());
		if (event.action == APP_KEY_RELEASED) { self.releases++; }
		return true;
	}
}

class BoundaryWork implements IApplicationWork {
	public int runs = 0;
	public void run() { self.runs++; }
}

class BoundaryTrial {
	class int run(int count, int terminal) {
		assert(count == 4095 || count == 4096 || count == 4097 || count == 8193);
		assert(terminal >= 0 && terminal <= 3);
		var owner = ShimApplication(16);
		IApplication application = owner;
		var window = application.createWindow("E40 boundary", 160.0, 80.0);
		var native = owner.firstWindow();
		assert(native != null);
		var field = application.createTextField("", "");
		window.attachRoot(field);
		unsigned int id = native == null ? 0u : native.nativeId();
		IShimView? fieldView = (IShimView?)field;
		assert(fieldView != null);
		unsigned int fieldControl = fieldView == null ? 0u : (unsigned int)fieldView.node().id;
		var keys = BoundaryKeys();
		var scope = CallbackScope();
		window.onKey(keys, scope);
		int setupFrames = eventBoundaryFrames();
		window.show();
		unsigned long long readyDeadline = btrcShimTicksNS() + 10000000000ULL;
		while (eventBoundaryFrames() == setupFrames && btrcShimTicksNS() < readyDeadline) { owner.pumpOnce(10); }
		assert(eventBoundaryFrames() > setupFrames);
		eventBoundaryArm(id);
		Vector<int> expected = [];
		int boundary = count < 4097 ? count : 4097;
		for (int position = 1; position <= count; position++) {
			/* The text terminal is the field's own control reporting its edited text. */
			if (position == boundary && terminal == 2) { eventBoundaryText(id, fieldControl, "committed"); }
			else if (position == boundary && terminal == 3) { eventBoundaryClose(id); }
			else {
				eventBoundaryKey(id, position, position == boundary && terminal == 1 ? 0 : 1);
				expected.push(position);
			}
		}
		assert(eventBoundaryQueued() == count);
		var work = BoundaryWork();
		application.post(work);
		/* A change the provider needs a new frame for: GTK redraws a field's
		 * placeholder on its own, and its font changes the field's size. */
		field.setFont(14.0);
		int framesBefore = eventBoundaryFrames();
		owner.pumpOnce(0);
		int remaining = eventBoundaryQueued();
		int firstDelivered = keys.codes.len;
		/* A turn ends at either its count limit or its monotonic slice. Slow
	 * native handlers and sanitized builds may yield before event 4096. */
		int consumed = count - remaining;
		bool bounded = consumed > 0 && consumed <= 4096;
		bool workProgress = work.runs == 1;
		bool frameProgress;
		if (terminal == 3 && !window.isOpen()) { frameProgress = true; }
		else { frameProgress = eventBoundaryFrames() > framesBefore; }
		unsigned long long drainDeadline = btrcShimTicksNS() + 10000000000ULL;
		while (eventBoundaryQueued() > 0 && btrcShimTicksNS() < drainDeadline) { owner.pumpOnce(0); }
		int mismatch = 0;
		for (int index = 0; index < keys.codes.len; index++) {
			if (index >= expected.len || keys.codes.get(index) != expected.get(index)) { mismatch = index + 1; break; }
		}
		if (mismatch == 0 && terminal != 3 && keys.codes.len < expected.len) { mismatch = keys.codes.len + 1; }
		bool textDelivered = terminal == 2 && field.isOpen() && field.text().equals("committed");
		bool closeDelivered = terminal == 3 && !window.isOpen();
		/* Close is requested during dispatch and completed at the end of a turn.
	 * All pre-close keys must arrive. Later keys may form an ordered prefix
	 * before closure cancels the tail; no duplicate or extra delivery passes. */
		bool cardinality = keys.codes.len == expected.len;
		if (terminal == 3) { cardinality = keys.codes.len >= boundary - 1 && keys.codes.len <= expected.len; }
		bool passed = bounded && workProgress && frameProgress && mismatch == 0 && cardinality && eventBoundaryQueued() == 0 && (terminal != 1 || keys.releases == 1) && (terminal != 2 || textDelivered) && (terminal != 3 || closeDelivered);
		printf("E40 count=%d terminal=%d boundary=%d first_keys=%d queued_after_first=%d total_keys=%d expected_keys=%d closed_keys=%d first_key_mismatch=%d releases=%d text=%d close=%d bounded=%d work=%d frame=%d lossless=%d\n", count, terminal, boundary, firstDelivered, remaining, keys.codes.len, expected.len, terminal == 3 ? expected.len - keys.codes.len : 0, mismatch, keys.releases, textDelivered ? 1 : 0, closeDelivered ? 1 : 0, bounded ? 1 : 0, work.runs, frameProgress ? 1 : 0, passed ? 1 : 0);
		fflush(stdout);
		printf("E40_ADMISSION accepted=%d rejected=%d\n", eventBoundaryAccepted(), eventBoundaryRejected());
		fflush(stdout);
		assert(eventBoundaryAccepted() == count && eventBoundaryRejected() == 0);
		eventBoundaryDisarm();
		scope.cancel();
		var closing = application.close();
		unsigned long long deadline = btrcShimTicksNS() + 10000000000ULL;
		while (closing == CALLBACK_CANCELLATION_PENDING && btrcShimTicksNS() < deadline) { owner.pumpOnce(10); closing = application.pollClose(); }
		assert(closing == CALLBACK_CANCELLATION_COMPLETE);
		return passed ? 0 : 1;
	}
}

int main(int argc, char** argv) {
	assert(argc == 3 || argc == 4);
	int repetitions = argc == 4 ? atoi(argv[3]) : 1;
	assert(repetitions >= 1 && repetitions <= 100);  // 100 qualifies; a gate may repeat less often
	assert(btrcShimInit());
	for (int iteration = 0; iteration < repetitions; iteration++) { assert(BoundaryTrial.run(atoi(argv[1]), atoi(argv[2])) == 0); }
	return 0;
}
