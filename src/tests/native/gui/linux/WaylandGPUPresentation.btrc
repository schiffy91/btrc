import Library.Timer;
import Library.GPU.GPUDevice;
import Library.GPU.GPUSurfaceRenderer;

class WaylandPresentation {
	class bool render() {
		var instance = createGPUInstance();
		if (instance == null) { return false; }
		var surface = attachGPUView(instance);
		if (surface == null) { return false; }
		var device = GPUDevice(instance, surface);
		var deadline = Timer();
		deadline.start();
		while (device.poll() != GPU_DEVICE_READY) {
			if (device.state() == GPU_DEVICE_FAILED || deadline.elapsedMillis() > 5000.0) { return false; }
			Timer.sleepMillis(1);
		}
		var renderer = GPUSurfaceRenderer(device, surface);
		renderer.resize(160, 100);
		bool shown = renderer.beginFrame(1.0, 0.0, 0.0, 1.0) == GPU_SURFACE_FRAME_READY && renderer.present();
		bool interacted = shown && waitForInput();
		renderer.close();
		device.close();
		while (device.poll() == GPU_DEVICE_CLOSING && deadline.elapsedMillis() < 25000.0) { Timer.sleepMillis(1); }
		return interacted && device.state() == GPU_DEVICE_CLOSED;
	}
}

int main() {
	if (!openSoftwareWindow()) { return 1; }
	bool success = WaylandPresentation.render();
	closeSoftwareWindow();
	return success ? 0 : 1;
}
