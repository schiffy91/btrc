import Library.GUI;
import Library.GUI.TextRun;
import Library.Image;

Image draw(string text) {
	var request = TextRasterization(TextRun(text, 16, 23));
	GUI.rasterizeText(request);
	return request.image();
}

bool samePixels(Image first, Image second) { return first.width == second.width && first.height == second.height && memcmp(first.data, second.data, (size_t)first.width * (size_t)first.height * (size_t)4) == 0; }

int main() {
	GUI.initialize();
	var pair = draw("AV");
	var ligature = draw("fi");
	var unsupported = draw("A\tV");
	if (gtkTextGlyphCalls() != 2 || gtkTextLayoutCalls() != 1) { return 2; }
	gtkTextUseNativeLayout();
	if (!samePixels(pair, draw("AV")) || !samePixels(ligature, draw("fi")) || !samePixels(unsupported, draw("A\tV"))) { return 3; }
	if (gtkTextLayoutCalls() != 4 || gtkTextGlyphCalls() != 2) { return 4; }
	GUI.close();
	print("PASS: public Latin shaping and native fallback produce the same RGBA pixels");
	return 0;
}
