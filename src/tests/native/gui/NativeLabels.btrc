import Library.Image;
import Library.Vector;
import Library.GUI;
import Library.GUI.IApplication;
import Library.GUI.IWindow;
import Library.GUI.IPanel;
import Library.GUI.ILabel;
import Library.GUI.Capture;

#include <assert.h>

Image labelPixels(IPanel root) {
	Vector<GUICaptureLayer> layers = [];
	return GUI.capture(root, layers);
}

int labelInkRows(Image image) {
	int scale = image.width / 240;
	int rows = 0;
	for (int y = 20 * scale; y < 180 * scale; y++) {
		bool ink = false;
		for (int x = 20 * scale; x < 220 * scale; x++) {
			if (image.pixel(x, y).red > 90) { ink = true; break; }
		}
		if (ink) { rows++; }
	}
	return rows;
}

/* An all-M caption must end in a short dot, not a clipped full-height M.
 * Inspect the rightmost connected ink columns at actual backing resolution. */
int finalGlyphHeight(Image image) {
	int scale = image.width / 240;
	int top = image.height;
	int bottom = 0;
	bool found = false;
	for (int x = 220 * scale - 1; x >= 20 * scale; x--) {
		bool ink = false;
		for (int y = 20 * scale; y < 180 * scale; y++) {
			if (image.pixel(x, y).red <= 90) { continue; }
			ink = true;
			if (y < top) { top = y; }
			if (y > bottom) { bottom = y; }
		}
		if (found && !ink) { break; }
		if (ink) { found = true; }
	}
	assert(found);
	return bottom - top + 1;
}

/* Runs on the native loop once the shown window has been dispatched. */
class LabelLayout implements IApplicationWork {
	private IWindow _window;
	private IPanel _background;
	private ILabel _label;
	private string _text;

	public LabelLayout(IWindow window, IPanel background, ILabel label, string text) { self._window = window; self._background = background; self._label = label; self._text = text; }

	public void run() {
		var label = self._label;
		label.setWrapping(false);
		var single = labelPixels(self._background);
		int scale = single.width / 240;
		assert(scale > 0 && label.text() == self._text);
		int singleRows = labelInkRows(single);
		assert(singleRows > 8 * scale && singleRows < 24 * scale);
		assert(finalGlyphHeight(single) <= 6 * scale);
		label.setWrapping(true);
		var wrapped = labelPixels(self._background);
		assert(label.text() == self._text && labelInkRows(wrapped) > singleRows * 2);
		label.setWrapping(false);
		var restored = labelPixels(self._background);
		assert(labelInkRows(restored) == singleRows && finalGlyphHeight(restored) <= 6 * scale);
		label.setText("MMMM");
		var shortText = labelPixels(self._background);
		assert(label.text() == "MMMM" && finalGlyphHeight(shortText) > 8 * scale);
		assert(self._background.detach(label) == label);
		label.close();
		label.close();
		bool rejected = false;
		try { label.setWrapping(true); } catch (string error) { rejected = true; }
		assert(rejected);
		assert(self._window.detachRoot() == self._background);
		self._background.close();
		self._window.close();
		GUI.requestQuit();
	}
}

int main() {
	GUI.initialize();
	var window = GUI.createWindow("Native label layout", 240.0, 200.0);
	var background = GUI.createPanel(RGBA(30, 30, 30), 0.0);
	window.attachRoot(background);
	// The ink probes read light text on a dark fill, so pin the subtree's
	// appearance instead of inheriting the host's (light on a fresh runner).
	background.setDarkAppearance(true);
	string text = "MMMM MMMM MMMM MMMM MMMM MMMM MMMM MMMM";
	var label = GUI.createLabel(text);
	label.setFont(20.0);
	background.attach(label);
	label.arrange(20.0, 20.0, 200.0, 160.0);
	assert(label.isVisible() && label.isOpen());
	label.setVisible(false);
	assert(!label.isVisible());
	label.setVisible(true);
	window.show();
	GUI.post(LabelLayout(window, background, label, text));
	GUI.run();
	assert(!window.isOpen() && !background.isOpen() && !label.isOpen());
	print("PASS: native label ellipsis, wrapping, full text and teardown");
	return 0;
}
