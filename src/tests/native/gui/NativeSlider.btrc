import Library.Image;
import Library.Vector;
import Library.GUI;
import Library.GUI.IApplication;
import Library.GUI.IWindow;
import Library.GUI.IPanel;
import Library.GUI.ISlider;
import Library.GUI.Capture;
import Library.GUI.MacOS.MacOSView;

#include <assert.h>

NSView nativeSlider(ISlider slider) {
	IMacOSView? native = (IMacOSView?)slider;
	if (native == null) { throw "Slider has no macOS implementation"; }
	return native.nativeView();
}

Image sliderPixels(IPanel root) {
	Vector<GUICaptureLayer> layers = [];
	return GUI.capture(root, layers);
}

void clickSlider(ISlider slider) {
	var view = nativeSlider(slider);
	var window = view.window();
	if (window == null) { throw "Slider is not in a window"; }
	var content = window.contentView();
	if (content == null) { throw "Slider window has no content view"; }
	var point = view.bounds().origin;
	point.x += 285.0;
	point.y += 15.0;
	point = content.convertPoint(point, view);
	var hit = content.hitTest(point);
	// AppKit may route a hit to a private descendant inside the native slider.
	assert(hit != null && (hit == view || hit.isDescendantOf(view)));
	var down = NSEvent.mouseEventWithType(NSEventTypeLeftMouseDown, point, 0UL, 0.0, window.windowNumber(), null, 1L, 1L, 1.0f);
	var up = NSEvent.mouseEventWithType(NSEventTypeLeftMouseUp, point, 0UL, 0.0, window.windowNumber(), null, 2L, 1L, 0.0f);
	assert(down != null && up != null);
	NSApplication.sharedApplication().postEvent(up, false);
	// Match native button tests: AppKit routes/tracks the synthetic click,
	// without assuming WindowServer activation (including on a locked Mac).
	window.sendEvent(down);
}

/* One step per native loop turn: each click is dispatched before its
 * result is read, as the embedded pump used to do. */
class SliderInput implements IApplicationWork {
	private IWindow _window;
	private IPanel _background;
	private ISlider _slider;
	private int _step = 0;

	public SliderInput(IWindow window, IPanel background, ISlider slider) { self._window = window; self._background = background; self._slider = slider; }

	public void run() {
		var slider = self._slider;
		if (self._step == 0) {
			slider.setValue(100.0);
			var maximum = sliderPixels(self._background);
			assert(maximum.width >= 360 && slider.value() == 100.0);
			slider.setValue(10.0);
			clickSlider(slider);
		} else if (self._step == 1) {
			assert(slider.value() > 10.0 && slider.value() <= 100.0 && (int)slider.value() % 10 == 0);
			slider.setEnabled(false);
			assert(!slider.isEnabled());
			slider.setValue(20.0);
			clickSlider(slider);
		} else {
			assert(slider.value() == 20.0);
			self.finish();
			return;
		}
		self._step++;
		GUI.post(self);
	}

	private void finish() {
		var slider = self._slider;
		slider.setEnabled(true);
		assert(slider.isEnabled());
		slider.setVisible(false);
		slider.setValue(100.0);
		// Native frame (120, 65, 64, 14) from the bottom of the 160-point background.
		slider.arrange(120.0, 81.0, 64.0, 14.0);
		slider.setVisible(true);
		assert(slider.value() == 100.0);
		var compact = sliderPixels(self._background);
		assert(compact.width >= 360);
		var view = nativeSlider(slider);
		var intrinsic = view.intrinsicContentSize();
		var fitting = view.fittingSize();
		fprintf(stderr, "Native slider intrinsic=%f,%f fitting=%f,%f\n", intrinsic.width, intrinsic.height, fitting.width, fitting.height);
		assert(intrinsic.height > 14.0);
		slider.arrange(120.0, 95.0 - intrinsic.height, 64.0, intrinsic.height);
		assert(slider.value() == 100.0);
		var natural = sliderPixels(self._background);
		assert(natural.width == compact.width && natural.height == compact.height);
		self._background.detach(slider);
		slider.close();
		slider.close();
		bool rejected = false;
		try { slider.value(); } catch (string error) { rejected = true; }
		assert(rejected);
		assert(self._window.detachRoot() == self._background);
		self._background.close();
		self._window.close();
		GUI.requestQuit();
	}
}

int main() {
	GUI.initialize();
	var window = GUI.createWindow("Native slider", 360.0, 160.0);
	var background = GUI.createPanel(RGBA(30, 30, 30));
	window.attachRoot(background);
	var slider = GUI.createSlider(10.0, 100.0, 9);
	// Player model projection sets the initial value before the first layout.
	slider.setValue(100.0);
	assert(slider.value() == 100.0);
	background.attach(slider);
	slider.arrange(20.0, 65.0, 320.0, 30.0);
	assert(slider.value() == 100.0);
	slider.setValue(10.0);
	assert(slider.value() == 10.0);
	for (int percent = 10; percent <= 100; percent += 10) { slider.setValue((double)percent); assert(slider.value() == (double)percent); }
	slider.setValue(53.0);
	assert(slider.value() == 50.0);
	bool rejected = false;
	try { slider.setValue(101.0); } catch (string error) { rejected = true; }
	assert(rejected && slider.value() == 50.0);
	rejected = false;
	try { var invalid = GUI.createSlider(100.0, 10.0); } catch (string error) { rejected = true; }
	assert(rejected);
	var continuous = GUI.createSlider(0.0, 1.0);
	continuous.setValue(0.375);
	assert(continuous.value() == 0.375);
	continuous.close();
	window.show();
	GUI.post(SliderInput(window, background, slider));
	GUI.run();
	assert(!window.isOpen() && !background.isOpen() && !slider.isOpen());
	print("PASS: native slider, stepped tracking, disabled input and teardown");
	return 0;
}
