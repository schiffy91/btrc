import Library.Image;
import Library.Vector;
import Library.Callback;
import Library.GUI;
import Library.GUI.IApplication;
import Library.GUI.IWindow;
import Library.GUI.IContainer;
import Library.GUI.IPanel;
import Library.GUI.IImageView;
import Library.GUI.Capture;
import Library.GUI.MacOS.AppKitText;
import Library.GUI.MacOS.MacOSView;
import Library.GUI.MacOS.MacOSPanel;

#include <assert.h>

Image panelPixels(IContainer root) {
	Vector<GUICaptureLayer> layers = [];
	return GUI.capture(root, layers);
}

/* AppKit appearance readback goes through the provider's native projection. */
NSView nativePanel(IPanel panel) {
	IMacOSView? native = (IMacOSView?)panel;
	if (native == null) { throw "Panel has no macOS implementation"; }
	return native.nativeView();
}

/* Runs on the native loop once the window has been dispatched. */
class PanelRendering implements IApplicationWork {
	private IWindow _window;
	private IContainer _root;
	private IPanel _panel;
	private IImageView _imageView;

	public PanelRendering(IWindow window, IContainer root, IPanel panel, IImageView imageView) { self._window = window; self._root = root; self._panel = panel; self._imageView = imageView; }

	public void run() {
		var panel = self._panel;
		var rounded = panelPixels(self._root);
		int scale = rounded.width / 200;
		assert(scale > 0 && rounded.pixel(21 * scale, 21 * scale).alpha < 10);
		assert(rounded.pixel(100 * scale, 35 * scale).red > 180);
		assert(rounded.pixel(100 * scale, 150 * scale).blue > 60);
		panel.setCornerRadius(0.0);
		panel.setFill(RGBA(20, 180, 40));
		var square = panelPixels(self._root);
		assert(square.pixel(21 * scale, 21 * scale).red > 180);
		assert(square.pixel(100 * scale, 150 * scale).green > 150);
		bool invalid = false;
		try { panel.setCornerRadius(-1.0); } catch (string error) { invalid = true; }
		assert(invalid);
		assert(self._root.detach(panel) == panel);
		assert(panel.close() == CallbackCancellation.Complete);
		assert(!self._imageView.isOpen());
		assert(panel.close() == CallbackCancellation.Complete);
		bool closed = false;
		try { panel.setFill(RGBA(0, 0, 0)); } catch (string error) { closed = true; }
		assert(closed);
		self._window.close();
		assert(rounded.pixel(100 * scale, 35 * scale).red > 180);
		GUI.requestQuit();
	}
}

int main() {
	GUI.initialize();
	var window = GUI.createWindow("Native rounded panel", 200.0, 200.0);
	var root = GUI.createContainer();
	window.attachRoot(root);
	var panel = GUI.createPanel(RGBA(20, 40, 80), 32.0);
	panel.setDarkAppearance(true);
	var appearance = nativePanel(panel).appearance();
	assert(appearance != null && AppKitText.ownedValue(appearance.name()) == AppKitText.ownedValue(NSAppearanceNameDarkAqua));
	panel.setDarkAppearance(false);
	appearance = nativePanel(panel).appearance();
	assert(appearance != null && AppKitText.ownedValue(appearance.name()) == AppKitText.ownedValue(NSAppearanceNameAqua));
	panel.inheritAppearance();
	assert(nativePanel(panel).appearance() == null);
	root.attach(panel);
	panel.arrange(20.0, 20.0, 160.0, 160.0);
	var artwork = Image(160, 80);
	artwork.fill(RGBA(220, 30, 20));
	var imageView = GUI.createImageView();
	imageView.setImage(artwork);
	panel.attach(imageView);
	imageView.arrange(0.0, 0.0, 160.0, 80.0);
	assert(panel.childCount() == 1 && panel.childAt(0) == imageView);
	bool attachedClose = false;
	try { imageView.close(); } catch (string error) { attachedClose = true; }
	assert(attachedClose && imageView.isOpen());
	GUI.post(PanelRendering(window, root, panel, imageView));
	GUI.run();
	assert(!window.isOpen() && !root.isOpen());
	print("PASS: native panel fill, rounded child clipping, restyling and teardown");
	return 0;
}
