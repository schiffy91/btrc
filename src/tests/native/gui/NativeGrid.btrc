import Library.Image;
import Library.Vector;
import Library.Math;
import Library.Callback;
import Library.GUI;
import Library.GUI.IApplication;
import Library.GUI.IWindow;
import Library.GUI.IView;
import Library.GUI.IPanel;
import Library.GUI.IGrid;
import Library.GUI.ILabel;
import Library.GUI.ISelect;
import Library.GUI.Capture;
import Library.GUI.MacOS.MacOSView;

#include <assert.h>

/* Cell frames are AppKit's own layout result, read through the provider. */
NSView nativeOf(IView view) {
	IMacOSView? native = (IMacOSView?)view;
	if (native == null) { throw "View has no macOS implementation"; }
	return native.nativeView();
}

/* Runs on the native loop once the shown window has been dispatched. */
class GridLayout implements IApplicationWork {
	private IWindow _window;
	private IPanel _background;
	private IGrid _form;
	private ILabel _inputLabel;
	private ILabel _monitorLabel;
	private ISelect _input;
	private ISelect _monitor;

	public GridLayout(IWindow window, IPanel background, IGrid form, ILabel inputLabel, ILabel monitorLabel, ISelect input, ISelect monitor) {
		self._window = window;
		self._background = background;
		self._form = form;
		self._inputLabel = inputLabel;
		self._monitorLabel = monitorLabel;
		self._input = input;
		self._monitor = monitor;
	}

	public void run() {
		var form = self._form;
		var input = self._input;
		var monitor = self._monitor;
		form.layout();
		var inputFrame = nativeOf(input).frame();
		var monitorFrame = nativeOf(monitor).frame();
		assert(inputFrame.size.width > 400.0 && inputFrame.size.height > 20.0);
		assert(Math.absDouble(inputFrame.origin.x - monitorFrame.origin.x) < 0.5);
		assert(inputFrame.origin.y > monitorFrame.origin.y);
		double fullWidth = nativeOf(form).fittingSize().width;
		form.setColumnHidden(1, true);
		form.layout();
		assert(nativeOf(form).fittingSize().width < fullWidth);
		form.setColumnHidden(1, false);
		form.layout();
		assert(Math.absDouble(nativeOf(form).fittingSize().width - fullWidth) < 0.5);
		Vector<GUICaptureLayer> layers = [];
		var pixels = GUI.capture(self._background, layers);
		assert(pixels.width >= 660 && pixels.height >= 260);
		form.setColumnWidth(1, 220.0);
		// Native frame (30, 45, 400, 130) from the bottom of the 260-point background.
		form.arrange(30.0, 85.0, 400.0, 130.0);
		form.layout();
		assert(nativeOf(input).frame().size.width < inputFrame.size.width - 150.0);
		bool rejected = false;
		try { form.setChild(2, 0, null); } catch (string error) { rejected = true; }
		assert(rejected);
		rejected = false;
		try { form.setChild(0, 0, self._background); } catch (string error) { rejected = true; }
		assert(rejected);
		rejected = false;
		try { form.setChild(0, 0, monitor); } catch (string error) { rejected = true; }
		assert(rejected);
		form.setChild(1, 1, null);
		assert(monitor.isOpen() && form.childAt(1, 1) == null);
		var nested = GUI.createGrid(1, 1);
		nested.setChild(0, 0, monitor);
		form.setChild(1, 1, nested);
		form.layout();
		assert(nativeOf(monitor).frame().size.width > 100.0);
		self._background.detach(form);
		assert(form.close() == CallbackCancellation.Complete);
		assert(form.close() == CallbackCancellation.Complete);
		nested.close();
		assert(!input.isOpen() && !monitor.isOpen() && !nested.isOpen());
		input.close();
		monitor.close();
		self._inputLabel.close();
		self._monitorLabel.close();
		assert(self._window.detachRoot() == self._background);
		self._background.close();
		self._window.close();
		GUI.requestQuit();
	}
}

int main() {
	GUI.initialize();
	var window = GUI.createWindow("Native form layout", 660.0, 260.0);
	var background = GUI.createPanel(RGBA(30, 30, 30));
	window.attachRoot(background);
	var form = GUI.createGrid(2, 2, 20.0, 15.0);
	background.attach(form);
	// Native frame (30, 45, 600, 130) from the bottom of the 260-point background.
	form.arrange(30.0, 85.0, 600.0, 130.0);
	form.setColumnWidth(0, 160.0);
	form.setColumnWidth(1, 420.0);
	form.setRowHeight(0, 50.0);
	form.setRowHeight(1, 50.0);
	var inputLabel = GUI.createLabel("Input Device");
	var monitorLabel = GUI.createLabel("Monitor");
	var input = GUI.createSelect();
	input.setItems(["Quad Cortex", "System Default"], 0);
	var monitor = GUI.createSelect();
	monitor.setItems(["Song Effects", "Raw Signal"], 0);
	form.setChild(0, 0, inputLabel);
	form.setChild(1, 0, input);
	form.setChild(0, 1, monitorLabel);
	form.setChild(1, 1, monitor);
	assert(form.childAt(1, 0) == input);
	bool attachedClose = false;
	try { input.close(); } catch (string error) { attachedClose = true; }
	assert(attachedClose && input.isOpen());
	window.show();
	GUI.post(GridLayout(window, background, form, inputLabel, monitorLabel, input, monitor));
	GUI.run();
	assert(!window.isOpen() && !background.isOpen() && !form.isOpen());
	print("PASS: native grid layout, resizing, recursive cells and ownership");
	return 0;
}
