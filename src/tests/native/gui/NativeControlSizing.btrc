import Library.Image;
import Library.Vector;
import Library.GUI;
import Library.GUI.IApplication;
import Library.GUI.IWindow;
import Library.GUI.IPanel;
import Library.GUI.IButton;
import Library.GUI.ISelect;
import Library.GUI.Capture;

#include <assert.h>

Image sizingPixels(IPanel root) {
	Vector<GUICaptureLayer> layers = [];
	return GUI.capture(root, layers);
}

/* Compare labeled and blank captures so the test measures actual title ink,
 * independently of the system appearance. The bezel is sampled off-title. */
void containedTitle(Image labeled, Image blank, int left, int top) {
	int scale = labeled.width / 600;
	int inkTop = labeled.height;
	int inkBottom = -1;
	int bezelTop = labeled.height;
	int bezelBottom = -1;
	int background = blank.pixel(0, 0).red;
	for (int y = top * scale; y < (top + 60) * scale; y++) {
		var edge = blank.pixel((left + 35) * scale, y);
		if (edge.red < background - 8 || edge.red > background + 8) {
			if (y < bezelTop) { bezelTop = y; }
			bezelBottom = y;
		}
		for (int x = (left + 45) * scale; x < (left + 230) * scale; x++) {
			var a = labeled.pixel(x, y);
			var b = blank.pixel(x, y);
			if (a.red == b.red && a.green == b.green && a.blue == b.blue) { continue; }
			if (y < inkTop) { inkTop = y; }
			inkBottom = y;
		}
	}
	assert(inkBottom - inkTop > 12 * scale);
	assert(inkTop >= bezelTop + scale && inkBottom <= bezelBottom - scale);
}

/* Runs on the native loop once the shown window has been dispatched. */
class SizingScenario implements IApplicationWork {
	private IWindow _window;
	private IPanel _root;
	private IButton _button;
	private ISelect _select;
	private double _regularButton;
	private double _regularSelect;

	public SizingScenario(IWindow window, IPanel root, IButton button, ISelect select, double regularButton, double regularSelect) {
		self._window = window;
		self._root = root;
		self._button = button;
		self._select = select;
		self._regularButton = regularButton;
		self._regularSelect = regularSelect;
	}

	public void run() {
		var button = self._button;
		var select = self._select;
		var labeled = sizingPixels(self._root);
		assert(labeled.width >= 600 && labeled.height * 6 == labeled.width);
		bool rejected = false;
		try { button.setFont(24.0); } catch (string error) { rejected = true; }
		assert(rejected);
		rejected = false;
		try { select.setFont(24.0); } catch (string error) { rejected = true; }
		assert(rejected);
		button.setBordered(false);
		button.setFont(24.0);
		rejected = false;
		try { button.setBordered(true); } catch (string error) { rejected = true; }
		assert(rejected);
		button.setFont(20.0);
		button.setBordered(true);
		var restored = sizingPixels(self._root);
		button.setTitle("");
		select.setItems([""], 0);
		var blank = sizingPixels(self._root);
		containedTitle(labeled, blank, 15, 20);
		containedTitle(labeled, blank, 315, 20);
		containedTitle(restored, blank, 15, 20);
		containedTitle(restored, blank, 315, 20);
		button.setFont(13.0);
		select.setFont(13.0);
		assert(button.fittingHeight() == self._regularButton && select.fittingHeight() == self._regularSelect);
		self._window.close();
		GUI.requestQuit();
	}
}

void sizingScenario(bool dark) {
	GUI.initialize();
	var window = GUI.createWindow("Native control sizing", 600.0, 100.0);
	var background = dark ? RGBA(30, 30, 30) : RGBA(255, 255, 255);
	var root = GUI.createPanel(background);
	root.setDarkAppearance(dark);
	window.attachRoot(root);
	var panel = GUI.createPanel(background);
	root.attach(panel);
	panel.arrange(0.0, 0.0, 600.0, 100.0);
	var button = GUI.createButton("Mgyp Button");
	var select = GUI.createSelect();
	select.setItems(["Mgyp Selection"], 0);
	panel.attach(button);
	panel.attach(select);
	button.arrange(15.0, 20.0, 270.0, 60.0);
	select.arrange(315.0, 20.0, 270.0, 60.0);
	button.setFont(13.0);
	select.setFont(13.0);
	double regularButton = button.fittingHeight();
	double regularSelect = select.fittingHeight();
	button.setFont(20.0);
	select.setFont(20.0);
	assert(button.fittingHeight() > regularButton && select.fittingHeight() > regularSelect);
	window.show();
	GUI.post(SizingScenario(window, root, button, select, regularButton, regularSelect));
	GUI.run();
	assert(!window.isOpen() && !root.isOpen() && !button.isOpen() && !select.isOpen());
}

int main() {
	sizingScenario(false);
	sizingScenario(true);
	print("PASS: native control sizing, contained 20-point ink, rejected oversized bezels and restoration");
	return 0;
}
