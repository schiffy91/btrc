import Library.Image;
import Library.Vector;
import Library.GUI;
import Library.GUI.IApplication;
import Library.GUI.IWindow;
import Library.GUI.IPanel;
import Library.GUI.ILevelIndicator;
import Library.GUI.GUICaptureLayer;

#include <assert.h>

/* Runs on the native loop once the shown window has been dispatched. */
class LevelTeardown implements IApplicationWork {
	private IWindow _window;
	private IPanel _panel;
	private ILevelIndicator _level;

	public LevelTeardown(IWindow window, IPanel panel, ILevelIndicator level) { self._window = window; self._panel = panel; self._level = level; }

	public void run() {
		Vector<GUICaptureLayer> layers = [];
		var pixels = GUI.capture(self._panel, layers);
		assert(pixels.width >= 400 && pixels.height >= 160);
		self._panel.detach(self._level);
		self._level.close();
		self._level.close();
		bool rejected = false;
		try { self._level.setValue(0.0); } catch (string error) { rejected = true; }
		assert(rejected);
		assert(self._window.detachRoot() == self._panel);
		self._panel.close();
		self._window.close();
		GUI.requestQuit();
	}
}

int main() {
	GUI.initialize();
	var window = GUI.createWindow("Native level", 400.0, 160.0);
	var panel = GUI.createPanel(RGBA(24, 24, 24));
	window.attachRoot(panel);
	var level = GUI.createLevelIndicator(0.8, 0.95);
	panel.attach(level);
	level.arrange(24.0, 72.0, 352.0, 24.0);
	assert(level.value() == 0.0);
	level.setValue(1.0);
	assert(level.value() == 1.0);
	level.setValue(0.45);
	assert(level.value() == 0.45);
	bool rejected = false;
	try { level.setValue(1.1); } catch (string error) { rejected = true; }
	assert(rejected && level.value() == 0.45);
	rejected = false;
	try { var invalid = GUI.createLevelIndicator(0.9, 0.8); } catch (string error) { rejected = true; }
	assert(rejected);
	window.show();
	GUI.post(LevelTeardown(window, panel, level));
	GUI.run();
	assert(!window.isOpen() && !panel.isOpen() && !level.isOpen());
	print("PASS: native level value, invalid input and teardown");
	return 0;
}
