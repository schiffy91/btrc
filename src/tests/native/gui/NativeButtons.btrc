import Library.Image;
import Library.Vector;
import Library.GUI;
import Library.GUI.IApplication;
import Library.GUI.IWindow;
import Library.GUI.IView;
import Library.GUI.IContainer;
import Library.GUI.IPanel;
import Library.GUI.IButton;
import Library.GUI.GUICaptureLayer;
import Library.GUI.MacOS.MacOSActionQueue;
import Library.GUI.MacOS.MacOSButton;
import Library.GUI.MacOS.MacOSView;

#include <assert.h>

bool takesButton(MacOSActionQueue actions, MacOSButton button) {
	var sender = actions.take();
	return sender != null && button.matches(sender);
}

void verifyPortableButton(IButton button) {
	assert(button.isOpen() && button.isEnabled() && button.title().equals("Library"));
	double width = button.fittingWidth();
	assert(width > 0.0 && button.fittingHeight() > 0.0);
	button.setTitle("A much longer native button title — 音楽");
	assert(button.title().equals("A much longer native button title — 音楽"));
	assert(button.fittingWidth() > width);
	button.setTitle("Library");
	button.setVisible(false);
	assert(!button.isVisible());
	button.setVisible(true);
	assert(button.isVisible());
	button.setEnabled(false);
	assert(!button.activate());
	button.setEnabled(true);
}

void verifyCoordinates(NSView parent, bool flipped) {
	assert(parent.isFlipped() == flipped);
	var parentFrame = parent.frame();
	parentFrame.size.width = 220.0;
	parentFrame.size.height = 130.0;
	parent.setFrame(parentFrame);
	var origin = parent.bounds().origin;
	origin.x = 11.0;
	origin.y = 17.0;
	parent.setBoundsOrigin(origin);
	var child = MacOSView();
	IView view = child;
	child.attachTo(parent);
	view.arrange(3.0, 5.0, 31.0, 23.0);
	var frame = child.nativeView().frame();
	assert(frame.origin.x == 14.0 && frame.origin.y == (flipped ? 22.0 : 119.0));
	assert(frame.size.width == 31.0 && frame.size.height == 23.0);
	child.detachFrom(parent);
	view.close();
	assert(!child.isOpen());
}

NSView nativeOf(IView view) {
	IMacOSView? native = (IMacOSView?)view;
	if (native == null) { throw "View has no macOS implementation"; }
	return native.nativeView();
}

/* Points are in the root's coordinates, which fill the window's content. */
void clickNativeButton(IContainer root, MacOSButton button) {
	var point = button.nativeView().frame().origin;
	point.x += 30.0;
	point.y += 16.0;
	assert(nativeOf(root).hitTest(point) == button.nativeView());
	var window = button.nativeView().window();
	if (window == null) { throw "Button is not in a window"; }
	var down = NSEvent.mouseEventWithType(NSEventTypeLeftMouseDown, point, 0UL, 0.0, window.windowNumber(), null, 1L, 1L, 1.0f);
	var up = NSEvent.mouseEventWithType(NSEventTypeLeftMouseUp, point, 0UL, 0.0, window.windowNumber(), null, 2L, 1L, 0.0f);
	assert(down != null && up != null);
	NSApplication.sharedApplication().postEvent(up, false);
	// Synthetic events have no WindowServer activation. Deliver the down event
	// through NSWindow routing; native button tracking consumes the queued up.
	// This exercises AppKit hit testing/tracking even when the Mac is locked,
	// not desktop activation or external WindowServer input delivery.
	window.sendEvent(down);
}

bool hasButtonText(Image image, int left) {
	int scale = image.width / 400;
	int minimum = 255;
	int maximum = 0;
	for (int y = 68 * scale; y < 78 * scale; y++) {
		for (int x = (left + 20) * scale; x < (left + 130) * scale; x++) {
			int value = image.pixel(x, y).red;
			if (value < minimum) { minimum = value; }
			if (value > maximum) { maximum = value; }
		}
	}
	return maximum - minimum > 60;
}

void verifyBoundedActions() {
	bool rejected = false;
	try { var invalid = MacOSActionQueue(0); } catch (string error) { rejected = true; }
	assert(rejected);
	var actions = MacOSActionQueue(2);
	var first = MacOSButton("First", actions);
	var second = MacOSButton("Second", actions);
	for (int index = 0; index < 4; index++) {
		assert(first.activate() && second.activate());
		first.cancelPendingActions();
		assert(first.activate());
		assert(takesButton(actions, second) && takesButton(actions, first));
		assert(actions.take() == null);
	}
	assert(first.activate() && takesButton(actions, first));
	assert(first.activate() && second.activate());
	first.cancelPendingActions();
	assert(first.activate());
	assert(takesButton(actions, second) && takesButton(actions, first));
	assert(first.activate() && second.activate() && first.activate());
	for (int attempt = 0; attempt < 2; attempt++) {
		rejected = false;
		try { actions.take(); } catch (string error) { rejected = error.contains("capacity"); }
		assert(rejected);
	}
	first.close();
	second.close();
	actions.close();
}

void abandonActionQueue(NSButton control) {
	var actions = MacOSActionQueue(2);
	var action = actions.bind(control);
	control.performClick(null);
	assert(actions.take() == action);
	control.performClick(null);
}

void verifyActionLifetime() {
	assert(ActionButtonProbe.liveCount() == 0L);
	IMacOSAction? retired = null;
	{
		var control = ActionButtonProbe.new();
		assert(control != null && ActionButtonProbe.liveCount() == 1L);
		abandonActionQueue(control);
		assert(!control.hasAction());
		var actions = MacOSActionQueue(3);
		var action = actions.bind(control);
		retired = action;
		for (int index = 0; index < 1000; index++) {
			control.fire();
			control.fire();
			assert(actions.take() == action);
			control.fire();
			assert(actions.take() == action && actions.take() == action);
		}
		control.fire();
		actions.unbind(control);
		assert(actions.take() == null && !control.hasAction());
		actions.close();
	}
	assert(retired != null && ActionButtonProbe.liveCount() == 0L);
}

Image captureButtons(IContainer root) {
	Vector<GUICaptureLayer> layers = [];
	return GUI.capture(root, layers);
}

/* Runs on the native loop: the first turn renders and clicks, the second
 * reads the click AppKit tracked and tears the window down. */
class ButtonInput implements IApplicationWork {
	private IWindow _window;
	private IContainer _root;
	private IPanel _background;
	private MacOSActionQueue _actions;
	private MacOSButton _first;
	private MacOSButton _second;
	private bool _clicked = false;

	public ButtonInput(IWindow window, IContainer root, IPanel background, MacOSActionQueue actions, MacOSButton first, MacOSButton second) {
		self._window = window;
		self._root = root;
		self._background = background;
		self._actions = actions;
		self._first = first;
		self._second = second;
	}

	public void run() {
		if (!self._clicked) { self.click(); self._clicked = true; GUI.post(self); }
		else { self.finish(); }
	}

	private void click() {
		var actions = self._actions;
		var first = self._first;
		var second = self._second;
		assert(actions.take() == null);
		var otherActions = MacOSActionQueue();
		var unowned = NSButton.new();
		assert(unowned != null);
		var expectedAction = actions.bind(unowned);
		bool duplicateRejected = false;
		try { otherActions.bind(unowned); } catch (string error) { duplicateRejected = true; }
		assert(duplicateRejected);
		unowned.performClick(null);
		assert(actions.take() == expectedAction && otherActions.take() == null);
		actions.unbind(unowned);
		var reboundAction = otherActions.bind(unowned);
		assert(reboundAction != expectedAction);
		unowned.performClick(null);
		assert(otherActions.take() == reboundAction && actions.take() == null);
		otherActions.unbind(unowned);
		otherActions.close();
		assert(first.activate() && second.activate() && first.activate());
		assert(takesButton(actions, first) && takesButton(actions, second) && takesButton(actions, first));
		assert(actions.take() == null);
		second.setEnabled(false);
		assert(!second.isEnabled() && !second.activate() && actions.take() == null);
		second.setEnabled(true);
		for (int index = 0; index < 8; index++) { assert(first.activate() && second.activate()); }
		for (int index = 0; index < 8; index++) { assert(takesButton(actions, first) && takesButton(actions, second)); }
		assert(actions.take() == null);
		bool rejected = false;
		try { actions.close(); } catch (string error) { rejected = true; }
		assert(rejected && second.activate() && takesButton(actions, second));
		var decoded = captureButtons(self._root);
		assert(hasButtonText(decoded, 20) && hasButtonText(decoded, 220));
		first.setTransparent(true);
		var transparent = captureButtons(self._root);
		assert(!hasButtonText(transparent, 20) && hasButtonText(transparent, 220));
		clickNativeButton(self._root, first);
	}

	private void finish() {
		var actions = self._actions;
		var first = self._first;
		var second = self._second;
		IView view = first;
		assert(takesButton(actions, first) && actions.take() == null);
		assert(first.activate() && second.activate() && first.activate());
		first.cancelPendingActions();
		assert(takesButton(actions, second) && actions.take() == null);
		assert(first.activate() && takesButton(actions, first));
		first.setTransparent(false);
		assert(first.activate() && second.activate() && first.activate());
		self._root.detach(view);
		view.close();
		assert(!view.isOpen() && !first.isOpen());
		first.close();
		assert(takesButton(actions, second) && actions.take() == null);
		bool rejected = false;
		try { first.activate(); } catch (string error) { rejected = true; }
		assert(rejected);
		self._root.detach(second);
		second.close();
		actions.close();
		actions.close();
		rejected = false;
		try { actions.take(); } catch (string error) { rejected = true; }
		assert(rejected);
		self._root.detach(self._background);
		self._background.close();
		self._window.close();
		GUI.requestQuit();
	}
}

int main() {
	GUI.initialize();
	verifyBoundedActions();
	verifyActionLifetime();
	verifyCoordinates(NSView.new(), false);
	verifyCoordinates(FlippedTestView.new(), true);
	var window = GUI.createWindow("Native actions", 400.0, 140.0);
	var root = GUI.createContainer();
	window.attachRoot(root);
	/* Native dark-mode button drawing composites with its destination. An
	 * empty transparent capture is not the window's actual background. */
	var background = GUI.createPanel(RGBA(30, 30, 30), 0.0);
	root.attach(background);
	background.arrange(0.0, 0.0, 400.0, 140.0);
	var actions = MacOSActionQueue();
	var first = MacOSButton("Library", actions);
	var second = MacOSButton("Settings", actions);
	IButton portable = first;
	IView view = portable;
	IMacOSView? native = (IMacOSView?)view;
	assert(native != null && native.nativeView() == first.nativeView());
	IButton? projectedButton = (IButton?)native;
	assert(projectedButton != null && projectedButton.title().equals("Library"));
	verifyPortableButton(portable);
	assert(actions.take() == null);
	bool unattachedRejected = false;
	try { view.arrange(20.0, 58.0, 150.0, 32.0); } catch (string error) { unattachedRejected = true; }
	assert(unattachedRejected);
	first.setFont(18.0);
	second.setFont(18.0);
	first.setSystemSymbol("folder");
	first.setSelected(true);
	assert(first.isSelected());
	assert(first.activate() && !first.isSelected() && takesButton(actions, first));
	first.setSelected(false);
	bool invalidFont = false;
	try { first.setFont(0.0); } catch (string error) { invalidFont = true; }
	assert(invalidFont);
	root.attach(first);
	root.attach(second);
	first.arrange(20.0, 58.0, 150.0, 32.0);
	second.arrange(220.0, 58.0, 150.0, 32.0);
	view.arrange(20.0, 58.0, 150.0, 32.0);
	assert(first.nativeView().frame().origin.x == 20.0 && first.nativeView().frame().origin.y == 50.0);
	bool invalidBounds = false;
	try { view.arrange(20.0, 58.0, -1.0, 32.0); } catch (string error) { invalidBounds = true; }
	assert(invalidBounds && first.nativeView().frame().size.width == 150.0);
	for button in [first, second] { assert(button.isEnabled()); }
	window.show();
	GUI.post(ButtonInput(window, root, background, actions, first, second));
	GUI.run();
	assert(!window.isOpen() && !root.isOpen());
	print("PASS: ordered native button actions, disabled state, cancellation and teardown");
	return 0;
}
