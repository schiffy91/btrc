import Library.GUI;
import Library.GUI.FreeType;
import Library.GUI.Font;
import Library.GUI.IDirectoryPicker;
import Library.GUI.TextRun;
import Library.Platform;
import Library.Testing;

import ./Suite.btrc;

/* The system's own text, drawn into pixels the program can place anywhere:
 * more text is wider, and something is actually drawn. */
class TextRaster implements IConformanceCase {
	public string name() { return "text.raster"; }

	class int inked(TextRasterization request) {
		var image = request.image();
		int inked = 0;
		for (int y = 0; y < image.height; y++) {
			for (int x = 0; x < image.width; x++) { if (image.pixel(x, y).alpha > 0) { inked++; } }
		}
		return inked;
	}

	public void run(Turns turns) {
		var brief = TextRasterization(TextRun("Hi", 16, 20));
		var full = TextRasterization(TextRun("Hello, conformance", 16, 20));
		GUI.rasterizeText(brief);
		GUI.rasterizeText(full);
		Expect.isTrue(brief.image().width > 0 && brief.image().height >= 20, "a run has its line height");
		Expect.isTrue(full.image().width > brief.image().width, "more text is wider");
		Expect.isTrue(TextRaster.inked(brief) > 0 && TextRaster.inked(full) > TextRaster.inked(brief), "the text is drawn");
		var bold = TextRasterization(TextRun("Hello, conformance", 16, 20, 700));
		GUI.rasterizeText(bold);
		Expect.isTrue(TextRaster.inked(bold) > 0);
	}
}

/* A font face from a file: its metrics, and a glyph's bitmap and advance.
 * BTRC_CONFORMANCE_FONT names a font the host has. */
class FontFace implements IConformanceCase {
	public string name() { return "font.face"; }

	public void run(Turns turns) {
		string path = Environment.get("BTRC_CONFORMANCE_FONT", "");
		if (path.isEmpty()) { throw "BTRC_CONFORMANCE_FONT names no font file"; }
		var font = FreeType.load(path, 24);
		var metrics = font.metrics();
		Expect.isTrue(metrics.heightFixed() > 0LL && metrics.ascenderFixed() > 0LL && metrics.ascenderFixed() <= metrics.heightFixed());
		var glyph = font.glyph(65, true);
		if (glyph == null) { throw "the font has no capital A"; }
		Expect.isTrue(glyph.advanceFixed() > 0LL && glyph.width() > 0 && glyph.rows() > 0, "a rendered glyph has a bitmap and an advance");
		var measured = font.glyph(65, false);
		Expect.isTrue(measured != null && measured.advanceFixed() == glyph.advanceFixed(), "measuring and rendering agree on the advance");
		bool refused = false;
		try { FreeType.load("/no/such/font.ttf", 24); } catch (string error) { refused = true; }
		Expect.isTrue(refused, "a missing font file is refused");
	}
}
