import Library.GUI;
import Library.GUI.IDirectoryPicker;
import Library.GUI.TextRun;
import Library.Testing;

import ./Suite.btrc;

/* The system's own text, drawn into pixels the program can place anywhere:
 * more text is wider, and something is actually drawn. */
class TextRaster implements IConformanceCase {
	public string name() { return "text.raster"; }

	class int inked(TextRasterization request) {
		var image = request.image();
		int inked = 0;
		for (int y = 0; y < image.height; y++) {
			for (int x = 0; x < image.width; x++) { if (image.pixel(x, y).alpha > 0) { inked++; } }
		}
		return inked;
	}

	public void run(Turns turns) {
		var brief = TextRasterization(TextRun("Hi", 16, 20));
		var full = TextRasterization(TextRun("Hello, conformance", 16, 20));
		GUI.rasterizeText(brief);
		GUI.rasterizeText(full);
		Expect.isTrue(brief.image().width > 0 && brief.image().height >= 20, "a run has its line height");
		Expect.isTrue(full.image().width > brief.image().width, "more text is wider");
		Expect.isTrue(TextRaster.inked(brief) > 0 && TextRaster.inked(full) > TextRaster.inked(brief), "the text is drawn");
		var bold = TextRasterization(TextRun("Hello, conformance", 16, 20, 700));
		GUI.rasterizeText(bold);
		Expect.isTrue(TextRaster.inked(bold) > 0);
	}
}
