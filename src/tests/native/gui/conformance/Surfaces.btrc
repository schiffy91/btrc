import Library.Callback;
import Library.GPU.GPUImageTexture;
import Library.GPU.GPUProgram;
import Library.GPU.GPUReadback;
import Library.GPU.GPUSurfaceRenderer;
import Library.GPU.GPUUniformBuffer;
import Library.GUI;
import Library.GUI.GUICaptureLayer;
import Library.GUI.IGPUView;
import Library.Image;
import Library.Testing;
import Library.Timer;
import Library.Vector;

import ./Layout.btrc;
import ./Picture.btrc;
import ./Suite.btrc;

/* A capture is the picture of the view it is asked for, at that view's own
 * size, and it follows show() without a turn of the loop: what was attached
 * and arranged before it is in it, a native control as much as a panel. */
class CaptureSubtree implements IConformanceCase {
	public string name() { return "capture.subtree"; }

	/* A provider whose window draws with a GPU device refuses a capture until
	 * the device has arrived. Nothing here turns the loop meanwhile. */
	class Image straightAway(IView view) {
		long long started = MonotonicClock.milliseconds();
		while (true) {
			try { return GUI.capture(view, []); } catch (string refused) {
				if (MonotonicClock.milliseconds() - started > 15000LL) { throw refused; }
				Timer.sleepMillis(5);
			}
		}
		throw "unreachable";
	}

	public void run(Turns turns) {
		var window = GUI.createWindow("conformance capture.subtree", 320.0, 200.0);
		var root = GUI.createContainer();
		var group = GUI.createContainer();
		var ground = GUI.createPanel(Palette.green());
		var image = GUI.createImageView();
		var outside = GUI.createPanel(Palette.red());
		var pixels = Image(32, 32);
		pixels.fill(Palette.blue());
		image.setImage(pixels);
		window.attachRoot(root);
		root.attach(group);
		root.attach(outside);
		group.attach(ground);
		group.attach(image);
		group.arrange(40.0, 30.0, 200.0, 120.0);
		ground.arrange(0.0, 0.0, 200.0, 120.0);
		image.arrange(20.0, 10.0, 60.0, 60.0);
		outside.arrange(250.0, 160.0, 60.0, 30.0);
		window.show();
		var whole = CaptureSubtree.straightAway(root);
		var part = CaptureSubtree.straightAway(group);
		double scale = (double)whole.width / window.contentWidth();
		Expect.isTrue(Picture.same(whole.pixel((int)(280.0 * scale), (int)(175.0 * scale)), Palette.red()), "the window's picture has the panel beside the group");
		Expect.isTrue(Frame.close((double)part.width, 200.0 * scale, 1.0) && Frame.close((double)part.height, 120.0 * scale, 1.0), f"a view's capture is the view's size: {part.width} by {part.height} at scale {scale}");
		Expect.isTrue(Picture.same(part.pixel((int)(150.0 * scale), (int)(100.0 * scale)), Palette.green()), "and its own picture, from its own corner");
		Expect.isTrue(Picture.same(part.pixel((int)(50.0 * scale), (int)(40.0 * scale)), Palette.blue()), "with a native control that was attached before the loop turned");
		bool beside = false;
		for (int y = 0; y < part.height && !beside; y++) {
			for (int x = 0; x < part.width && !beside; x++) { beside = Picture.same(part.pixel(x, y), Palette.red()); }
		}
		Expect.isFalse(beside, "and nothing of a view outside it");
		window.close();
		turns.settle();
	}
}

/* A GPU view is an ordinary child whose content the program draws: its device
 * arrives over turns, a frame clears to the colour asked for, a readback
 * returns those pixels, and a capture shows them in the window's picture. */
class GPUFrame implements IConformanceCase {
	public string name() { return "gpu.frame"; }

	class string shader() { return "struct Tint { color: vec4<f32> };\n" + "@group(0) @binding(0) var<uniform> tint: Tint;\n" + "@vertex fn vs_main(@builtin(vertex_index) index: u32) -> @builtin(position) vec4<f32> {\n" + "  var corners = array<vec2<f32>, 3>(vec2<f32>(-1.0, -1.0), vec2<f32>(3.0, -1.0), vec2<f32>(-1.0, 3.0));\n" + "  return vec4<f32>(corners[index], 0.0, 1.0);\n" + "}\n" + "@fragment fn fs_main() -> @location(0) vec4<f32> { return tint.color; }\n"; }

	public void run(Turns turns) {
		var window = GUI.createWindow("conformance gpu.frame", 320.0, 200.0);
		var root = GUI.createContainer();
		var view = GUI.createGPUView(true);
		window.attachRoot(root);
		root.attach(view);
		view.arrange(40.0, 20.0, 120.0, 80.0);
		window.show();
		long long started = MonotonicClock.milliseconds();
		while (!view.poll() && view.error().isEmpty() && MonotonicClock.milliseconds() - started < 15000LL) { turns.turn(); }
		Expect.isTrue(view.error().isEmpty(), f"the GPU device failed: {view.error()}");
		Expect.isTrue(view.poll(), "the GPU device did not arrive within fifteen seconds");
		Expect.isTrue(view.backingScale() > 0.0);
		view.setVisible(false);
		Expect.isTrue(view.beginFrame(0.0, 0.0, 0.0) == GPU_SURFACE_FRAME_EMPTY, "a hidden view has no frame to draw");
		view.setVisible(true);
		turns.settle();
		Expect.isTrue(view.beginFrame(0.0, 0.5, 1.0) == GPU_SURFACE_FRAME_READY);
		Expect.isTrue(Frame.close((double)view.pixelWidth(), 120.0 * view.backingScale(), 1.0), "the frame is the view's size in device pixels");
		Expect.isTrue(Frame.close((double)view.pixelHeight(), 80.0 * view.backingScale(), 1.0));
		var renderer = view.frameRenderer();
		Expect.isTrue(renderer.width() == view.pixelWidth() && renderer.height() == view.pixelHeight());
		var readback = view.readback();
		Expect.isTrue(readback.submit());
		while (readback.poll() != GPU_READBACK_READY && readback.error().isEmpty() && MonotonicClock.milliseconds() - started < 30000LL) { turns.turn(); }
		Expect.isTrue(readback.state() == GPU_READBACK_READY, f"the readback did not arrive: {readback.error()}");
		var pixels = readback.takeImage();
		Expect.isTrue(pixels.width == view.pixelWidth() && pixels.height == view.pixelHeight());
		var middle = pixels.pixel(pixels.width / 2, pixels.height / 2);
		Expect.isTrue(middle.red == 0 && middle.green >= 127 && middle.green <= 128 && middle.blue == 255, "the frame is the colour it was cleared to");
		Vector<GUICaptureLayer> layers = [GUICaptureLayer(view, pixels)];
		var picture = GUI.capture(root, layers);
		double scale = (double)picture.width / window.contentWidth();
		var shown = picture.pixel((int)(100.0 * scale), (int)(60.0 * scale));
		Expect.isTrue(shown.red == 0 && shown.blue == 255, "a capture shows the GPU view's pixels where the view is");
		var outside = picture.pixel((int)(260.0 * scale), (int)(160.0 * scale));
		Expect.isFalse(outside.red == 0 && outside.blue == 255, "and nowhere else");
		view.requestCapture();
		var program = view.createProgram(GPUFrame.shader(), 4, false);
		while (program.poll() != GPU_PROGRAM_READY && program.state() != GPU_PROGRAM_FAILED && MonotonicClock.milliseconds() - started < 45000LL) { turns.turn(); }
		Expect.isTrue(program.state() == GPU_PROGRAM_READY, f"the program did not validate: {program.error()}");
		var broken = view.createProgram("not a shader", 4, false);
		while (broken.poll() != GPU_PROGRAM_READY && broken.state() != GPU_PROGRAM_FAILED && MonotonicClock.milliseconds() - started < 60000LL) { turns.turn(); }
		Expect.isTrue(broken.state() == GPU_PROGRAM_FAILED && !broken.error().isEmpty(), "an invalid shader fails with its reason and does not break the view");
		window.close();
		for (int turn = 0; turn < 2000 && window.pollClose() != CALLBACK_CANCELLATION_COMPLETE; turn++) { turns.turn(); }
		Expect.isTrue(window.pollClose() == CALLBACK_CANCELLATION_COMPLETE, "closing the window finishes the GPU view's pending work");
		Expect.isFalse(view.isOpen());
	}
}

/* A program draws into a GPU view's frame with what it is given: a uniform
 * buffer's values and an image's pixels reach the fragment shader, a frame
 * that has drawn with them holds them as they were, and what changes after it
 * is uploaded again for the next. */
class GPUTextureCase implements IConformanceCase {
	public string name() { return "gpu.texture"; }

	class string shader() { return "struct Tint { color: vec4<f32> };\n" + "@group(0) @binding(0) var<uniform> tint: Tint;\n" + "@group(0) @binding(1) var image: texture_2d<f32>;\n" + "@group(0) @binding(2) var imageSampler: sampler;\n" + "@vertex fn vs_main(@builtin(vertex_index) index: u32) -> @builtin(position) vec4<f32> {\n" + "  var corners = array<vec2<f32>, 3>(vec2<f32>(-1.0, -1.0), vec2<f32>(3.0, -1.0), vec2<f32>(-1.0, 3.0));\n" + "  return vec4<f32>(corners[index], 0.0, 1.0);\n" + "}\n" + "@fragment fn fs_main() -> @location(0) vec4<f32> { return textureSample(image, imageSampler, vec2<f32>(0.5, 0.5)) * tint.color; }\n"; }

	class void tint(GPUUniformBuffer uniform, float red, float green, float blue) {
		uniform.set(0, red);
		uniform.set(1, green);
		uniform.set(2, blue);
		uniform.set(3, 1.0f);
	}

	/* The middle pixel of the frame the view holds, once its readback arrives. */
	class RGBA drawn(IGPUView view, Turns turns) {
		long long started = MonotonicClock.milliseconds();
		var readback = view.readback();
		Expect.isTrue(readback.submit());
		while (readback.poll() != GPU_READBACK_READY && readback.error().isEmpty() && MonotonicClock.milliseconds() - started < 15000LL) { turns.turn(); }
		Expect.isTrue(readback.state() == GPU_READBACK_READY, f"the readback did not arrive: {readback.error()}");
		var pixels = readback.takeImage();
		return pixels.pixel(pixels.width / 2, pixels.height / 2);
	}

	/* A channel as the texture held it, give or take the sampler's rounding. */
	class bool channel(int found, int expected) { return found >= expected - 1 && found <= expected + 1; }

	public void run(Turns turns) {
		var window = GUI.createWindow("conformance gpu.texture", 320.0, 200.0);
		var root = GUI.createContainer();
		var view = GUI.createGPUView(true);
		window.attachRoot(root);
		root.attach(view);
		view.arrange(40.0, 20.0, 120.0, 80.0);
		window.show();
		long long started = MonotonicClock.milliseconds();
		while (!view.poll() && view.error().isEmpty() && MonotonicClock.milliseconds() - started < 15000LL) { turns.turn(); }
		Expect.isTrue(view.error().isEmpty(), f"the GPU device failed: {view.error()}");
		Expect.isTrue(view.poll(), "the GPU device did not arrive within fifteen seconds");
		turns.settle();
		var program = view.createProgram(GPUTextureCase.shader(), 4);
		while (program.poll() != GPU_PROGRAM_READY && program.state() != GPU_PROGRAM_FAILED && MonotonicClock.milliseconds() - started < 30000LL) { turns.turn(); }
		Expect.isTrue(program.state() == GPU_PROGRAM_READY, f"the program did not validate: {program.error()}");
		var device = view.frameRenderer().device();
		var image = Image(2, 2);
		image.fill(RGBA(255, 255, 128));
		var texture = GPUImageTexture(device, image);
		var uniform = GPUUniformBuffer(device, 4);
		GPUTextureCase.tint(uniform, 0.0f, 1.0f, 1.0f);
		Expect.isTrue(view.beginFrame(0.0, 0.0, 0.0) == GPU_SURFACE_FRAME_READY);
		program.draw(view.frameRenderer(), uniform, 3, texture);
		bool held = false;
		try { uniform.set(0, 1.0f); } catch (string refused) { held = true; }
		Expect.isTrue(held, "a uniform keeps its values while a frame that drew with it is open");
		held = false;
		try { texture.update(image); } catch (string refused) { held = true; }
		Expect.isTrue(held, "and so does a texture its pixels");
		var first = GPUTextureCase.drawn(view, turns);
		Expect.isTrue(first.red == 0 && first.green == 255 && GPUTextureCase.channel(first.blue, 128), f"the frame is the image's pixels through the uniform's tint: {first.red} {first.green} {first.blue}");
		image.fill(RGBA(128, 255, 255));
		texture.update(image);
		GPUTextureCase.tint(uniform, 1.0f, 0.0f, 0.0f);
		Expect.isTrue(view.beginFrame(0.0, 0.0, 0.0) == GPU_SURFACE_FRAME_READY);
		program.draw(view.frameRenderer(), uniform, 3, texture);
		var second = GPUTextureCase.drawn(view, turns);
		Expect.isTrue(GPUTextureCase.channel(second.red, 128) && second.green == 0 && second.blue == 0, f"the next frame is what both were changed to: {second.red} {second.green} {second.blue}");
		texture.close();
		uniform.close();
		window.close();
		for (int turn = 0; turn < 2000 && window.pollClose() != CALLBACK_CANCELLATION_COMPLETE; turn++) { turns.turn(); }
		Expect.isTrue(window.pollClose() == CALLBACK_CANCELLATION_COMPLETE, "closing the window finishes the GPU view's pending work");
		Expect.isFalse(view.isOpen());
	}
}
