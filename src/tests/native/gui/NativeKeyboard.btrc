import Library.GUI;
import Library.GUI.IWindow;
import Library.GUI.ITextField;
import Library.GUI.MacOS.MacOSWindow;
import Library.GUI.MacOS.AppKitEvents;
import Library.GUI.MacOS.AppKitText;
import Library.Callback;
import Library.App;

#include <assert.h>

class KeyboardReceiver implements IWindowKeyHandler {
	public int calls = 0;
	public bool consume = true;
	public AppKeyCode last = APP_KEY_UNKNOWN;
	public AppScanCode? physical = null;
	public AppKeyAction action = APP_KEY_PRESSED;
	public bool key(AppKeyboardEvent event) {
		self.calls++;
		self.last = event.key;
		self.physical = event.scanCode;
		self.action = event.action;
		return self.consume;
	}
}

void sendKey(MacOSWindow window, unsigned short code, string characters, unsigned long kind = NSEventTypeKeyDown, unsigned long flags = 0UL) {
	var location = window.nativeWindow().frame().origin;
	location.x = 0.0; location.y = 0.0;
	var text = AppKitText.nativeValue(characters);
	var event = NSEvent.keyEventWithType(kind, location, flags, 0.0, window.nativeWindow().windowNumber(), null, text, text, false, code);
	if (event == null) { throw "Cannot create a synthetic key event"; }
	NSApplication.sharedApplication().sendEvent(event);
}

int main() {
	GUI.initialize();
	var native = MacOSWindow("Keyboard routing", 360.0, 220.0);
	var otherNative = MacOSWindow("Other window", 240.0, 120.0);
	IWindow window = native;
	IWindow other = otherNative;
	var receiver = KeyboardReceiver();
	var scope = CallbackScope();
	var registration = window.onKey(receiver, scope);
	sendKey(native, kVK_ANSI_A, "a");
	assert(receiver.calls == 1 && receiver.last == APP_KEY_A);
	sendKey(otherNative, kVK_ANSI_A, "a");
	assert(receiver.calls == 1);
	receiver.consume = false;
	sendKey(native, kVK_ANSI_D, "d");
	assert(receiver.calls == 2 && receiver.last == APP_KEY_D);
	var physical = receiver.physical;
	assert(physical != null && physical.set == APP_SCAN_MAC_VIRTUAL && physical.code == (int)kVK_ANSI_D);
	// The B key sits at virtual keycode 11, even when the layout types another character.
	sendKey(native, 11, "x");
	physical = receiver.physical;
	assert(receiver.calls == 3 && receiver.last == APP_KEY_UNKNOWN && physical != null && physical.code == 11);
	sendKey(native, 11, "x", NSEventTypeKeyUp);
	assert(receiver.calls == 4 && receiver.action == APP_KEY_RELEASED);
	sendKey(native, kVK_RightControl, "", NSEventTypeFlagsChanged, (unsigned long)NX_DEVICERCTLKEYMASK | (unsigned long)NSEventModifierFlagControl);
	assert(receiver.calls == 5 && receiver.action == APP_KEY_PRESSED);
	sendKey(native, kVK_RightControl, "", NSEventTypeFlagsChanged);
	assert(receiver.calls == 6 && receiver.action == APP_KEY_RELEASED);
	assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE);
	sendKey(native, kVK_ANSI_A, "a");
	assert(receiver.calls == 6);
	var next = CallbackScope();
	window.onKey(receiver, next);
	assert(window.close() == CALLBACK_CANCELLATION_COMPLETE);
	assert(next.cancel() == CALLBACK_CANCELLATION_COMPLETE);
	other.close();
	assert(GUI.close() == CALLBACK_CANCELLATION_COMPLETE);
	return 0;
}
