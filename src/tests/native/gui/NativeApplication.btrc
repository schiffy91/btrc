import Library.Callback;
import Library.GUI.IApplication;
import Library.GUI.IWindow;
import Library.GUI.IView;
import Library.GUI.ControlEventQueue;
import Library.GUI.MacOS.MacOSApplication;
import Library.GUI.MacOS.MacOSContainer;
import Library.GUI.MacOS.MacOSControlEvents;
import Library.GUI.MacOS.MacOSView;

#include <assert.h>
#include <string.h>

int deliveries = 0;
int receiversDestroyed = 0;
int workDelivered = 0;
int workDestroyed = 0;

class ScheduledWork implements IApplicationWork {
	private IApplication _application;
	private IWindow _window;
	private int _target;

	public ScheduledWork(IApplication application, IWindow window, int target) { self._application = application; self._window = window; self._target = target; }

	public void run() {
		assert(self._application.isRunning() && self._window.isOpen());
		workDelivered++;
		if (self._target == -2) { throw ""; }
		if (self._target < 0) { throw "Expected application work failure"; }
		if (workDelivered < self._target) { self._application.post(ScheduledWork(self._application, self._window, self._target)); }
		else { self._application.requestQuit(); }
		assert(self._window.isOpen());
	}

	public void __del__() { workDestroyed++; }
}

void verifyQuitAdmission(IApplication application) {
	bool rejected = false;
	try { application.createWindow("After quit request", 100.0, 100.0); } catch (string error) { rejected = true; }
	assert(rejected);
}

/* Native timer entry belongs to this fixture. Normal work enters through the
 * application executor; a modal timer runs inside an already active turn. */
interface IApplicationTimer {
	void invoke(NSTimer timer);
}

class QuitOnTimer implements IApplicationTimer, IApplicationWork {
	private IApplication _application;
	private IWindow _window;
	private IView _child;
	private bool _native;
	private bool _pending;
	private bool _modal;

	public QuitOnTimer(IApplication application, IWindow window, IView child, bool native, bool pending, bool modal = false) {
		self._application = application;
		self._window = window;
		self._child = child;
		self._native = native;
		self._pending = pending;
		self._modal = modal;
	}

	public void invoke(NSTimer timer) {
		assert(self._application.isRunning() && timer.isValid());
		if (self._modal) { self.run(); } else { self._application.post(self); }
	}

	public void run() {
		assert(self._application.isRunning());
		bool rejected = false;
		try { self._application.run(); } catch (string error) { rejected = true; }
		assert(rejected);
		deliveries++;
		if (self._pending) {
			int beforeWork = workDelivered;
			int beforeDestroyed = workDestroyed;
			self._application.post(ScheduledWork(self._application, self._window, 0));
			self._application.post(ScheduledWork(self._application, self._window, 0));
			assert(workDelivered == beforeWork && workDestroyed == beforeDestroyed);
		}
		if (self._native) { NSApplication.sharedApplication().terminate(null); }
		else { self._application.requestQuit(); }
		self._application.requestQuit();
		verifyQuitAdmission(self._application);
		assert(self._application.close() == CALLBACK_CANCELLATION_PENDING);
		// Shutdown must happen after this callback and NSApplication.run return.
		assert(self._window.isOpen() && self._child.isOpen());
		assert(ApplicationProbe.liveViews() == 1L);
	}

	public void __del__() { receiversDestroyed++; }
}

class ModalWork implements IApplicationWork {
	private IApplication _application;
	private IWindow _window;
	private IView _child;
	private bool _native;

	public ModalWork(IApplication application, IWindow window, IView child, bool native) { self._application = application; self._window = window; self._child = child; self._native = native; }

	public void run() {
		workDelivered++;
		var scope = CallbackScope();
		ApplicationProbe.modalTimer(QuitOnTimer(self._application, self._window, self._child, self._native, true, true), scope);
		var response = ApplicationProbe.runAlert();
		fprintf(stderr, "modal response=%ld delivered=%d pending-work-delivered=%d\n", (long)response, deliveries, workDelivered);
		assert(response == NSModalResponseAbort);
		assert(self._window.isOpen() && self._child.isOpen());
		assert(scope.cancel() == CALLBACK_CANCELLATION_COMPLETE);
	}

	public void __del__() { workDestroyed++; }
}

bool holdClose = false;

/* A subtree whose shutdown stays Pending while holdClose is set, as a native
 * owner that never reaches its closed state would. */
class StuckView implements IMacOSView {
	private MacOSView _view;
	private bool _closing = false;

	public StuckView(MacOSView view) { self._view = view; }

	public NSView nativeView() { return self._view.nativeView(); }

	public MacOSViewState interactionOwner() { return self._view.interactionOwner(); }

	public ViewInteractionState interactionState() { return self._view.interactionState(); }

	public ICallbackRegistration onInteractionStateChanged(IViewInteractionStateHandler handler, CallbackScope owner) { return self._view.onInteractionStateChanged(handler, owner); }

	public void markInteraction(bool inherited, WindowExposure exposure, ControlEventQueue? events) { self._view.markInteraction(inherited, exposure, events); }

	public void settleInteraction() { self._view.settleInteraction(); }

	public void publishInteraction() { self._view.publishInteraction(); }

	public void attachTo(NSView parent) { self._view.attachTo(parent); }

	public void detachFrom(NSView parent) { self._view.detachFrom(parent); }

	public void reconcileAttachment(NSView? parent) { self._view.reconcileAttachment(parent); }

	public void cancelPointerCapture() { self._view.cancelPointerCapture(); }

	public bool isOpen() { return !self._closing && self._view.isOpen(); }

	public double fittingWidth() { return self._view.fittingWidth(); }

	public double fittingHeight() { return self._view.fittingHeight(); }

	public void arrange(double x, double y, double width, double height) { self._view.arrange(x, y, width, height); }

	public bool isVisible() { return self._view.isVisible(); }

	public void setVisible(bool visible) { self._view.setVisible(visible); }

	public ICallbackRegistration onPointer(IViewPointerHandler handler, CallbackScope owner) { return self._view.onPointer(handler, owner); }

	public ICallbackRegistration onScroll(IViewScrollHandler handler, CallbackScope owner) { return self._view.onScroll(handler, owner); }

	public CallbackCancellation close() { self._closing = true; return self.pollClose(); }

	public CallbackCancellation pollClose() {
		if (!self._closing) { return CALLBACK_CANCELLATION_NOT_REQUESTED; }
		return holdClose ? CALLBACK_CANCELLATION_PENDING : self._view.close();
	}
}

/* run() bounds its shutdown drain: it reports the stuck subtree, keeps the
 * pending owners retained, and a later close() completes once they finish. */
void verifyStuckShutdown() {
	var application = MacOSApplication(4);
	var window = application.createWindow("Native stuck shutdown", 240.0, 120.0);
	var root = application.createContainer();
	var nativeRoot = (IMacOSView?)root;
	assert(nativeRoot != null);
	if (nativeRoot == null) { throw "Application container has no native view projection"; }
	var child = StuckView(MacOSView(ApplicationProbe.newView(), nativeRoot.interactionOwner().context()));
	root.attach(child);
	window.attachRoot(root);
	holdClose = true;
	application.post(ScheduledWork(application, window, 0));
	string failure = "";
	try { application.run(); } catch (string error) { failure = error; }
	assert(failure.equals("Native subtree shutdown did not complete"));
	assert(!application.isRunning() && !child.isOpen() && ApplicationProbe.liveViews() == 1L);
	assert(application.pollClose() == CALLBACK_CANCELLATION_PENDING && ApplicationProbe.liveViews() == 1L);
	holdClose = false;
	assert(application.close() == CALLBACK_CANCELLATION_COMPLETE);
	assert(!window.isOpen() && !root.isOpen() && ApplicationProbe.liveViews() == 0L && !ApplicationProbe.hasDelegate());
}

IView abandonedApplicationView() {
	var application = MacOSApplication();
	var child = application.createButton("Surviving alias");
	var root = application.createContainer();
	root.attach(child);
	return child;
}

int main(int argc, char** argv) {
	assert(argc == 2);
	if (strcmp(argv[1], "stuck-subtree") == 0) {
		verifyStuckShutdown();
		print("native application loop, deferred quit and owned subtree shutdown");
		return 0;
	}
	if (strcmp(argv[1], "scope-exit") == 0) {
		var child = abandonedApplicationView();
		assert(!child.isOpen() && !ApplicationProbe.hasDelegate());
		print("native application loop, deferred quit and owned subtree shutdown");
		return 0;
	}
	bool beforeRun = strcmp(argv[1], "before-run") == 0;
	bool scheduled = strcmp(argv[1], "scheduled") == 0;
	bool cancelledWork = strcmp(argv[1], "cancelled-work") == 0;
	bool failedWork = strcmp(argv[1], "failed-work") == 0;
	bool emptyFailure = strcmp(argv[1], "empty-failure") == 0;
	failedWork = failedWork || emptyFailure;
	bool nativePending = strcmp(argv[1], "native-pending") == 0;
	bool modal = strcmp(argv[1], "modal-native") == 0 || strcmp(argv[1], "modal-portable") == 0;
	IApplication application = MacOSApplication(4);
	assert(!application.isRunning() && !ApplicationProbe.hasDelegate());
	bool rejected = false;
	var window = application.createWindow("Native application lifecycle", 480.0, 240.0);
	var root = application.createContainer();
	var nativeRoot = (IMacOSView?)root;
	assert(nativeRoot != null);
	if (nativeRoot == null) { throw "Application container has no native view projection"; }
	var child = MacOSView(ApplicationProbe.newView(), nativeRoot.interactionOwner().context());
	root.attach(child);
	window.attachRoot(root);
	assert(ApplicationProbe.liveViews() == 1L);
	ApplicationProbe.occupyDelegate();
	try {
		var duplicate = MacOSApplication();
		assert(ApplicationProbe.ownsDelegate());
		assert(duplicate.close() == CALLBACK_CANCELLATION_COMPLETE);
		try { application.run(); } catch (string error) { rejected = error.equals("Native delegate slot is already occupied"); }
		assert(rejected && ApplicationProbe.ownsDelegate());
		assert(!application.isRunning() && window.isOpen() && child.isOpen());
	} finally { ApplicationProbe.releaseDelegate(); }
	assert(!ApplicationProbe.hasDelegate());
	var timers = CallbackScope();
	if (modal) { application.post(ModalWork(application, window, child, strcmp(argv[1], "modal-native") == 0)); }
	else if (scheduled) { application.post(ScheduledWork(application, window, 2048)); assert(workDelivered == 0); }
	else if (failedWork) { application.post(ScheduledWork(application, window, emptyFailure ? -2 : -1)); application.post(ScheduledWork(application, window, 0)); }
	else if (cancelledWork) {
		for (int index = 0; index < 4; index++) { application.post(ScheduledWork(application, window, 0)); }
		rejected = false;
		try { application.post(ScheduledWork(application, window, 0)); } catch (string error) { rejected = error.equals("Application work capacity exceeded"); }
		assert(rejected && workDestroyed == 1 && workDelivered == 0);
		assert(window.isOpen());
		application.requestQuit();
		int beforeRejected = workDestroyed;
		rejected = false;
		try { application.post(ScheduledWork(application, window, 0)); } catch (string error) { rejected = true; }
		assert(rejected && workDestroyed == beforeRejected + 1);
	}
	else if (beforeRun) { application.requestQuit(); application.requestQuit(); verifyQuitAdmission(application); }
	else { ApplicationProbe.timer(QuitOnTimer(application, window, child, strcmp(argv[1], "native") == 0 || nativePending, nativePending), timers); }
	bool workFailure = false;
	if (beforeRun || cancelledWork) {
		rejected = false;
		try { application.run(); } catch (string error) { rejected = true; }
		assert(rejected && window.isOpen() && child.isOpen());
		assert(application.close() == CALLBACK_CANCELLATION_COMPLETE);
		assert(application.pollClose() == CALLBACK_CANCELLATION_COMPLETE);
	} else {
		try { application.run(); } catch (string error) {
			if (!failedWork || !error.equals(emptyFailure ? "" : "Expected application work failure")) { throw error; }
			workFailure = true;
		}
	}
	assert(workFailure == failedWork);
	assert(!application.isRunning() && !ApplicationProbe.hasDelegate());
	assert(!window.isOpen() && !root.isOpen() && !child.isOpen());
	assert(window.root() == null && ApplicationProbe.liveViews() == 0L);
	assert(deliveries == (beforeRun || scheduled || cancelledWork || failedWork ? 0 : 1));
	assert(workDelivered == (scheduled ? 2048 : (failedWork || modal ? 1 : 0)));
	assert(workDestroyed == (scheduled ? 2048 : (cancelledWork ? 6 : (modal ? 3 : (failedWork || nativePending ? 2 : 0)))));
	assert(timers.cancel() == CALLBACK_CANCELLATION_COMPLETE);
	assert(receiversDestroyed == deliveries);
	application.requestQuit();
	application.close();
	rejected = false;
	try { application.run(); } catch (string error) { rejected = true; }
	assert(rejected);
	rejected = false;
	try { application.createWindow("Too late", 100.0, 100.0); } catch (string error) { rejected = true; }
	assert(rejected);
	print("native application loop, deferred quit and owned subtree shutdown");
	return 0;
}
