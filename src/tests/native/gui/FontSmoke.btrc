/* Headless smoke test for explicit optional FreeType loading failures. */
import Library.GUI.FreeType;

int main() {
	bool failed = false;
	try { var missing = FreeType.load("/no/such/font.ttf", 16); }
	catch (string error) { failed = true; }
	if (!failed) { print("FAIL: bogus font was loaded"); return 1; }
	print("FONT SMOKE TEST PASSED");
	return 0;
}
