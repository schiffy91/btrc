import Library.GUI;
import Library.GUI.IApplication;
import Library.GUI.IView;
import Library.GUI.IContainer;
import Library.GUI.IWindow;
import Library.GUI.ITextField;

import ./ControlProbe.btrc;
#include <assert.h>

/* A queued key reaches the field editor through the running native loop. */
class KeyDelivery implements IApplicationWork {
	private IWindow _window;
	private IContainer _root;
	private ITextField _field;
	private int _polls = 0;

	public KeyDelivery(IWindow window, IContainer root, ITextField field) { self._window = window; self._root = root; self._field = field; }

	public void run() {
		if (self._polls == 0) { assert(NativeTextFieldProbe.queueKey()); }
		self._polls++;
		if (!self._field.text().equals("n 🎸")) {
			assert(self._polls < 200);
			GUI.postAfter(0.01, self);
			return;
		}
		self.finish();
	}

	private void finish() {
		Thread<int> applicationWorker = spawn(() => {
				try { GUI.initialize(); } catch (string error) { return error.equals("GUI requires the main thread") ? 0 : 1; }
				return 2;
			});
		assert(applicationWorker.join() == 0);
		IView view = self._field;
		self._root.detach(view);
		view.close();
		assert(!self._field.isOpen() && !view.isOpen());
		self._field.close();
		assert(NativeTextFieldProbe.finish());
		self._window.close();
		self._window.close();
		bool windowClosed = false;
		try { self._window.title(); } catch (string error) { windowClosed = error.equals("Window is closed"); }
		assert(windowClosed);
		bool invalidSize = false;
		try { var invalid = GUI.createWindow("Invalid", -1.0, 180.0); } catch (string error) { invalidSize = error.equals("Invalid window content size"); }
		assert(invalidSize);
		bool closed = false;
		try { self._field.text(); } catch (string error) { closed = error.equals("Text field is closed"); }
		assert(closed);
		Thread<int> worker = spawn(() => {
				try { var invalid = GUI.createTextField(); } catch (string error) { return error.equals("GUI requires the main thread") ? 0 : 1; }
				return 2;
			});
		assert(worker.join() == 0);
		Thread<int> windowWorker = spawn(() => {
				try { var invalid = GUI.createWindow("Worker", 480.0, 180.0); } catch (string error) { return error.equals("GUI requires the main thread") ? 0 : 1; }
				return 2;
			});
		assert(windowWorker.join() == 0);
		GUI.requestQuit();
	}
}

int main() {
	GUI.initialize();
	var window = GUI.createWindow("Library Música 🎸", 480.0, 180.0);
	var root = GUI.createContainer();
	window.attachRoot(root);
	assert(NativeTextFieldProbe.prepare());
	var field = GUI.createTextField("Library Música 🎸", "Search library");
	IView view = field;
	assert(field.text().equals("Library Música 🎸") && view.isOpen());
	assert(view.fittingWidth() >= 0.0 && view.fittingHeight() > 0.0);
	field.setEnabled(false);
	assert(!field.isEnabled());
	field.setEnabled(true);
	assert(field.isEnabled());
	view.setVisible(false);
	assert(!view.isVisible());
	view.setVisible(true);
	root.attach(field);
	assert(NativeTextFieldProbe.fittingWidth(view.fittingWidth(), view.fittingHeight()));
	view.arrange(24.25, 77.375, 431.75, 30.125);
	bool invalidFrame = false;
	try { view.arrange(0.0, 0.0, -1.0, 30.0); } catch (string error) { invalidFrame = error.equals("Invalid native view frame"); }
	assert(invalidFrame);
	assert(NativeTextFieldProbe.mount());
	assert(NativeTextFieldProbe.replaceSelection());
	assert(field.text().equals("Guitar 🎸"));
	field.setText("Guitar 🎸");
	assert(NativeTextFieldProbe.selectionUnchanged());
	assert(NativeTextFieldProbe.undo());
	assert(field.text().equals("Library Música 🎸"));
	assert(NativeTextFieldProbe.redo());
	assert(field.text().equals("Guitar 🎸"));
	GUI.post(KeyDelivery(window, root, field));
	GUI.run();
	print("PASS: AppKit text field editing from BTRC");
	return 0;
}
