/* Real AppKit provider lifecycle, built through the native link plan. */
import Library.Tray.Tray;

int main() {
	/* The quit sentinel is a stable, documented token. */
	assert(TraySignal.quit().equals("__quit__"));

	/* Builder mirrors Tray and populates the portable model. */
	SystemTray tray = SystemTray("btrc").tip("native tray test").icon("/no/such/icon.png").item("Open", "echo open").add(TrayItem("Disabled", "noop").disabled()).checkItem("Marked", "true", "true").checkItem("Unmarked", "true", "false").item("Quit", TraySignal.quit());

	assert(tray.model.title.equals("btrc"));
	assert(tray.model.tooltip.equals("native tray test"));
	assert(tray.model.iconPath.equals("/no/such/icon.png"));
	assert(tray.model.items.len == 5);
	assert(tray.model.items.get(0).label.equals("Open"));
	assert(tray.model.items.get(0).enabled);
	assert(!tray.model.items.get(1).enabled);
	assert(tray.model.items.get(0).stateCommand.isEmpty());
	assert(tray.model.items.get(2).stateCommand.equals("true"));
	assert(tray.model.items.get(3).stateCommand.equals("false"));
	assert(tray.probeState("true"));
	assert(!tray.probeState("false"));
	assert(tray.model.items.get(4).command.equals("__quit__"));

	/* fromTray adopts an existing portable Tray unchanged. */
	Tray portable = Tray("Adopted").item("A", "echo a");
	SystemTray adopted = SystemTray.fromTray(portable);
	assert(adopted.model.title.equals("Adopted"));
	assert(adopted.model.items.len == 1);

	/* Native initialization is required; a headless false-success is a failure. */
	assert(!tray.available());
	assert(tray.show());
	assert(tray.available());
	assert(tray.realized);
	for (int index = 0; index < 3; index++) { assert(tray.pump(0)); }
	tray.quit();
	assert(!tray.pump(0));

	tray.close();
	tray.close();
	assert(!tray.available());
	assert(!tray.realized);
	assert(tray.show());
	tray.close();
	print("PASS: test_tray_native");
	return 0;
}
