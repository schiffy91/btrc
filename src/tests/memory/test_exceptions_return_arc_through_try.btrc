/* ARC ownership of an object RETURNED out of a function that has a try/catch:
 * one path returns the object built inside the try (success), the other throws,
 * is caught, and returns a fresh object from the catch. Both returned objects are
 * owned by the caller and must free with no leak. Exercises the interaction of
 * return-value ARC ownership with the try-stack pop on both the normal and the
 * caught paths. */
#include <assert.h>

int alive = 0;

class R {
    public int v;
    public R(int v) { self.v = v; alive = alive + 1; }
    public void __del__() { alive = alive - 1; }
}

R make(bool fail) {
    try {
        R r = new R(1);
        if (fail) { throw "fail"; }
        return r;            // returned out of the try on the success path
    } catch (string e) {
        return new R(2);     // returned out of the catch on the failure path
    }
}

int main() {
    R ok = make(false);
    assert(ok.v == 1);
    delete ok;

    R recovered = make(true);
    assert(recovered.v == 2);
    delete recovered;

    assert(alive == 0);      // no leak on either path

    print("PASS: test_exceptions_return_arc_through_try");
    return 0;
}
