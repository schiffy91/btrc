/* A nested owned collection (Vector<Vector<Obj>>) released via an EARLY RETURN.
 * Both the outer and inner collections, and all elements, must be released
 * exactly once on the early-exit path. */
#include <assert.h>

int alive = 0;

class Obj {
    public int v;

    public Obj(int v) {
        self.v = v;
        alive++;
    }

    public void __del__() {
        alive--;
    }
}

// Builds a nested collection then returns early; the early-return release path
// must free both nesting levels and their elements.
void build(bool early) {
    Vector<Vector<Obj>> vv = {};
    Vector<Obj> inner = {};
    inner.push(new Obj(1));
    inner.push(new Obj(2));
    vv.push(inner);
    if (early) {
        return;             // early exit: must release vv (and the moved inner)
    }
    Vector<Obj> more = {};
    more.push(new Obj(3));
    vv.push(more);
}

int main() {
    build(true);
    assert(alive == 0);

    build(false);
    assert(alive == 0);

    print("PASS: test_nested_collection_early_return");
    return 0;
}
