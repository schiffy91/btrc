/* Inheritance + `__del__`: deleting a subclass instance runs the DERIVED
 * destructor; the base `__del__` does NOT chain. Pins the current
 * (non-chaining) destructor behavior for the self-hosted port. */
#include <assert.h>

int baseD = 0;
int derD = 0;

class Base {
	public int id;

	public Base(int id) { self.id = id; }

	public void __del__() { baseD++; }
}

class Derived extends Base {
	public int extra;

	public Derived(int id, int extra) {
		self.id = id;
		self.extra = extra;
	}

	public void __del__() { derD++; }
}

int main() {
	Derived d = new Derived(1, 2);
	assert(d.id == 1);
	assert(d.extra == 2);

	delete d;
	// Only the derived destructor runs; base does not chain.
	assert(derD == 1);
	assert(baseD == 0);

	print("PASS: test_inherited_destructor");
	return 0;
}
