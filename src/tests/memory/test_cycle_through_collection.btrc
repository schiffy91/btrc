/* A reference cycle formed through a Vector field is reclaimed by typed
 * collection-slot traversal in both compilers. */
import std.vector;

#include <assert.h>

int nodeCount = 0;

class Node {
	public int id;
	public Vector<Node> children;

	public Node(int id) {
		self.id = id;
		self.children = {};
		nodeCount++;
	}

	public void __del__() { nodeCount--; }
}

int main() {
	{
		Node a = new Node(1);
		Node b = new Node(2);
		assert(nodeCount == 2);

		// Cycle via collection-held refs: a.children -> b, b.children -> a.
		a.children.push(b);
		b.children.push(a);
		assert(a.children.get(0).id == 2);
		assert(b.children.get(0).id == 1);
		// Scope exit traverses the Vector's element slots and breaks the cycle.
	}
	assert(nodeCount == 0);

	print("PASS: test_cycle_through_collection");
	return 0;
}
