/* A constructor keep parameter guards the call; the constructed object's
 * managed field independently owns the stored argument. */
#include <assert.h>

int alive = 0;

class Obj {
	public int id;

	public Obj(int id) {
		self.id = id;
		alive++;
	}

	public void __del__() { alive--; }
}

class Box {
	public Obj held;

	public Box(keep Obj o) { self.held = o; }

	public void __del__() {}
}

int main() {
	Obj o = new Obj(1);
	assert(alive == 1);

	// The constructor call is guarded and the field retains o.
	Box b = new Box(o);
	assert(b.held.id == 1);

	// Deleting the Box runs its destructor and releases the held field,
	// while the local handle still keeps o alive.
	delete b;
	assert(alive == 1);

	delete o;
	assert(alive == 0);

	print("PASS: test_keep_param_constructor");
	return 0;
}
