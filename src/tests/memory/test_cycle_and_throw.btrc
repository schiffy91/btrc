/* ARC cleanup across an exception when the unwound scope contains a CYCLABLE
 * object. A self-referential / mutually-referential node graph built in a try
 * block, then a throw, must be cleaned up by the exception cleanup path
 * (phased release + cycle collection) -- no leak, no use-after-free. */
#include <assert.h>

int nodeCount = 0;

class Node {
	public int id;
	public Node next;

	public Node(int id) {
		self.id = id;
		self.next = null;
		nodeCount++;
	}

	public void __del__() { nodeCount--; }
}

int main() {
	// Two-node cycle unwound by a throw.
	try {
		Node a = new Node(1);
		Node b = new Node(2);
		a.next = b;
		b.next = a;
		assert(nodeCount == 2);
		throw "boom";
	} catch (string e) {
		// exception cleanup must reclaim the cycle.
	}
	assert(nodeCount == 0);

	// Self-loop unwound by a throw.
	try {
		Node n = new Node(3);
		n.next = n;
		assert(nodeCount == 1);
		throw "again";
	} catch (string e) {
	}
	assert(nodeCount == 0);

	print("PASS: test_cycle_and_throw");
	return 0;
}
