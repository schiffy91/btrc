/* Vector<T> owns class elements it stores. */
import std.Vector;

#include <assert.h>

int liveItems = 0;

class OwnedItem {
	public int id;

	public OwnedItem(int id) {
		self.id = id;
		liveItems++;
	}

	public void __del__() { liveItems--; }
}

Vector<OwnedItem> makeItems() {
	Vector<OwnedItem> items = [];
	OwnedItem item = new OwnedItem(7);
	items.push(item);
	assert(liveItems == 1);
	return items;
}

int main() {
	Vector<OwnedItem> items = makeItems();
	assert(items.len == 1);
	assert(items.get(0).id == 7);
	assert(liveItems == 1);
	items.free();
	assert(liveItems == 0);
	print("PASS: test_vector_object_ownership");
	return 0;
}
