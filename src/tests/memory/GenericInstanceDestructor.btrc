/* Test direct delete and scope-exit auto-release of a USER-GENERIC class
 * instance that defines its own __del__. The delete/scope-release path builds
 * a mangled Holder_Thing_destroy callee -- a distinct code path from a plain
 * non-generic delete. The generic destructor runs __del__ and frees the
 * struct, but does NOT release the contained value (documented limitation). */
#include <assert.h>

int boxAlive = 0;
int objAlive = 0;

class Thing {
	public int x;

	public Thing(int x) {
		self.x = x;
		objAlive++;
	}

	public void __del__() { objAlive--; }
}

class Holder<T> {
	public T val;

	public Holder() {
		self.val = null;
		boxAlive++;
	}

	public void __del__() { boxAlive--; }
}

int main() {
	// Direct delete of a generic instance: runs Holder<Thing> __del__.
	Holder<Thing> h = new Holder<Thing>();
	assert(boxAlive == 1);

	Thing t = new Thing(5);
	h.val = t;
	assert(objAlive == 1);

	// delete runs the mangled generic destructor (box_alive--); the contained
	// value is NOT released (documented).
	delete h;
	assert(boxAlive == 0);
	assert(objAlive == 1);

	delete t;
	assert(objAlive == 0);

	// Scope-exit auto-release variant of a generic instance.
	{
		Holder<Thing> g = new Holder<Thing>();
		assert(boxAlive == 1);
	}
	assert(boxAlive == 0);

	print("PASS: test_generic_instance_destructor");
	return 0;
}
