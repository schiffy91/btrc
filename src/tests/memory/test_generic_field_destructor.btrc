/* A user generic class (Box<T>) holding an object does NOT participate in ARC
 * release of its contained T: the generic-class destructor frees its own struct
 * but does NOT release the contained object, and storing into a generic field
 * does NOT retain. Pins this documented limitation so the self-hosted compiler
 * matches the same behavior (the contained object must be managed manually). */
#include <assert.h>

int alive = 0;

class Obj {
    public int id;

    public Obj(int id) {
        self.id = id;
        alive++;
    }

    public void __del__() {
        alive--;
    }
}

class Box<T> {
    public T item;

    public Box() {
        self.item = null;
    }

    public void put(T x) {
        self.item = x;
    }
}

class Owner {
    public Box<Obj> box;

    public Owner() {
        self.box = new Box<Obj>();
    }
}

int main() {
    Owner owner = new Owner();
    Obj o = new Obj(7);          // rc 1
    owner.box.put(o);            // stored in the generic field (no retain)
    assert(owner.box.item.id == 7);
    assert(alive == 1);

    // Deleting the owner frees the Box<Obj> struct but does NOT release the
    // contained Obj -- it survives and is still reachable via the local handle.
    delete owner;
    assert(alive == 1);
    assert(o.id == 7);

    // The contained object must be released manually.
    delete o;
    assert(alive == 0);

    print("PASS: test_generic_field_destructor");
    return 0;
}
