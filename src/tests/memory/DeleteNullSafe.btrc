/* Null-handling of managed locals. A managed local that is null (never
 * allocated, or set to null) is skipped by the scope-exit release path (which
 * null-guards), so no destructor runs for it. Conversely `delete` is an
 * unconditional force-destroy, so a deleted handle must be nulled (which it is)
 * to keep scope-exit safe. Pins the null-guard on the auto-release path. */
#include <assert.h>

int alive = 0;

class Obj {
	public int id;

	public Obj(int id) {
		self.id = id;
		alive++;
	}

	public void __del__() { alive--; }
}

// A never-allocated managed local: scope exit must null-guard and not destroy.
void neverAllocated() {
	Obj o = null;
	assert(o == null);
}

// Replacing an owned local with null releases its previous reference; scope
// exit then sees the null slot and remains a no-op.
void nulledMidScope() {
	Obj a = new Obj(1);
	assert(alive == 1);
	a = null;
	assert(a == null && alive == 0);
}

// delete nulls the handle; the subsequent scope-exit release is a safe no-op.
void deleteThenScopeExit() {
	Obj b = new Obj(2);
	delete b;
	assert(b == null);
	// scope exit: b is null -> guarded, no second destruction
}

int main() {
	neverAllocated();
	assert(alive == 0);   // nothing was ever created

	nulledMidScope();
	assert(alive == 0);

	deleteThenScopeExit();
	assert(alive == 0);   // b was cleaned exactly once

	print("PASS: test_delete_null_safe");
	return 0;
}
