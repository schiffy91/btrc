/* JsonObject.setRaw(key, value): emit an UNquoted raw JSON fragment (a nested
 * array/object literal) — the one JsonObject builder setter the suite never
 * touches. It distinguishes the quoted vs unquoted code path in stringify():
 * setString wraps its value in quotes and escapes it; setRaw emits the value
 * verbatim. */
import std.json;

#include <assert.h>

int main() {
	JsonObject o = JsonObject();
	o.setString("name", "x");      /* quoted path */
	o.setRaw("nums", "[1,2,3]");   /* raw path: array literal, no quotes */

	string s = o.stringify();
	/* The raw fragment appears verbatim, NOT wrapped in quotes. */
	assert(s.contains("\"nums\":[1,2,3]"));
	/* The string value IS quoted. */
	assert(s.contains("\"name\":\"x\""));
	/* The raw value is not quoted: the quoted form must be absent. */
	assert(!s.contains("\"nums\":\"[1,2,3]\""));

	/* A nested object literal also survives raw. */
	JsonObject o2 = JsonObject();
	o2.setRaw("obj", "{\"k\":1}");
	string s2 = o2.stringify();
	assert(s2.contains("\"obj\":{\"k\":1}"));

	print("PASS: test_stdlib_json_setraw");
	return 0;
}
