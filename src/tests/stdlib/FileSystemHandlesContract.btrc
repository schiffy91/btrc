/* Typed exact-handle values never require dummy success or error payloads. */
import std.FileSystem;

#include <assert.h>

int main() {
	FileSystemError denied = FileSystemError(FS_ACCESS_DENIED, "open file", "/denied", 13, "permission denied");
	assert(denied.kind() == FS_ACCESS_DENIED);
	assert(denied.operation().equals("open file"));
	assert(denied.path().equals("/denied"));
	assert(denied.nativeCode() == 13);
	assert(denied.message().equals("permission denied"));

	FileSnapshot first = FileSnapshot(FILE_REGULAR, 12LL, 1ULL, 2ULL, 33188ULL, 3ULL, 4ULL, 5ULL, 6ULL);
	FileSnapshot same = FileSnapshot(FILE_REGULAR, 12LL, 1ULL, 2ULL, 33188ULL, 3ULL, 4ULL, 5ULL, 6ULL);
	FileSnapshot changed = FileSnapshot(FILE_REGULAR, 12LL, 1ULL, 2ULL, 33188ULL, 3ULL, 4ULL, 7ULL, 8ULL);
	FileSnapshot replacement = FileSnapshot(FILE_REGULAR, 12LL, 1ULL, 9ULL, 33188ULL, 3ULL, 4ULL, 5ULL, 6ULL);
	assert(first.sameObject(same));
	assert(first.sameVersion(same));
	assert(first.sameObject(changed));
	assert(!first.sameVersion(changed));
	assert(!first.sameObject(replacement));
	assert(first.cacheToken().equals(same.cacheToken()));
	assert(!first.cacheToken().equals(changed.cacheToken()));

	FileOpenOutcome fileFailure = FileOpenOutcome.failed(denied);
	assert(!fileFailure.ok());
	assert(fileFailure.error() == denied);
	DirectoryOpenOutcome directoryFailure = DirectoryOpenOutcome.failed(denied);
	assert(!directoryFailure.ok());
	assert(directoryFailure.error() == denied);
	FileSnapshotOutcome snapshotFailure = FileSnapshotOutcome.failed(denied);
	assert(!snapshotFailure.ok());
	assert(snapshotFailure.error() == denied);

	DirectoryStepOutcome end = DirectoryStepOutcome.end();
	assert(end.ok());
	assert(end.kind() == DIRECTORY_STEP_END);
	DirectoryStepOutcome failed = DirectoryStepOutcome.failed(denied);
	assert(!failed.ok());
	assert(failed.kind() == DIRECTORY_STEP_FAILED);
	assert(failed.error() == denied);

	FileReadOutcome eof = FileReadOutcome.end();
	assert(eof.ok());
	assert(eof.kind() == FILE_READ_END);
	FileReadOutcome readFailure = FileReadOutcome.failed(denied);
	assert(!readFailure.ok());
	assert(readFailure.error() == denied);

	Bytes exactEmptyBytes = Bytes();
	ExactFileReadOutcome exactEmpty = ExactFileReadOutcome.data(exactEmptyBytes);
	assert(exactEmpty.ok());
	assert(exactEmpty.bytes().isEmpty());
	ExactFileReadOutcome exactFailure = ExactFileReadOutcome.failed(denied);
	assert(!exactFailure.ok());
	assert(exactFailure.error() == denied);
	RegularFileSnapshotOpenOutcome regularFailure = RegularFileSnapshotOpenOutcome.failed(denied);
	assert(!regularFailure.ok());
	assert(regularFailure.error() == denied);

	assert(!FileSystem.openFileExact("").ok());
	assert(FileSystem.openFileExact("").error().kind() == FS_INVALID_ARGUMENT);
	assert(!FileSystem.openDirectoryExact("").ok());
	assert(!FileSystem.inspectExact("").ok());
	assert(!FileSystem.createTemporaryDirectory("../escape").ok());
	assert(!FileSystem.openRegularFileSnapshot("", 1LL).ok());
	assert(FileSystem.openRegularFileSnapshot("", 1LL).error().kind() == FS_INVALID_ARGUMENT);
	assert(!FileSystem.openRegularFileSnapshot("source.psarc", -1LL).ok());
	assert(FileSystem.openRegularFileSnapshot("source.psarc", -1LL).error().kind() == FS_INVALID_ARGUMENT);
	assert(!FileSystem.openRegularFileSnapshot("source.psarc", 1LL).ok());
	assert(FileSystem.openRegularFileSnapshot("source.psarc", 1LL).error().kind() == FS_NOT_FOUND);

	FileSystemHandleInventory emptyInventory = FileSystemHandleInventory(0);
	FileSystemHandleInventory twoHandles = FileSystemHandleInventory(2);
	assert(emptyInventory.openCount() == 0);
	assert(twoHandles.openCount() == 2);
	assert(emptyInventory.sameAs(FileSystemHandleInventory(0)));
	assert(!emptyInventory.sameAs(twoHandles));
	assert(FileSystem.ownedHandleInventory().openCount() >= 0);

	assert(FileSystemCloseOutcome.closed().ok());
	assert(FileSystemCloseOutcome.alreadyClosed().ok());
	assert(!FileSystemCloseOutcome.failed(denied).ok());

	PrivateDirectoryOpenOutcome privateFailure = PrivateDirectoryOpenOutcome.failed(denied);
	assert(!privateFailure.ok());
	assert(privateFailure.error() == denied);
	ExclusiveFileLeaseOpenOutcome leaseFailure = ExclusiveFileLeaseOpenOutcome.failed(denied);
	assert(!leaseFailure.ok());
	assert(leaseFailure.error() == denied);

	Bytes empty = Bytes();
	PrivateFileReadOutcome emptyData = PrivateFileReadOutcome.data(empty);
	assert(emptyData.ok());
	assert(emptyData.found());
	assert(emptyData.kind() == PRIVATE_FILE_DATA);
	assert(emptyData.bytes().isEmpty());
	PrivateFileReadOutcome missing = PrivateFileReadOutcome.missing();
	assert(missing.ok());
	assert(!missing.found());
	assert(missing.kind() == PRIVATE_FILE_MISSING);
	PrivateFileReadOutcome privateReadFailure = PrivateFileReadOutcome.failed(denied);
	assert(!privateReadFailure.ok());
	assert(privateReadFailure.kind() == PRIVATE_FILE_READ_FAILED);
	assert(privateReadFailure.error() == denied);

	DurableReplaceOutcome committed = DurableReplaceOutcome.succeeded();
	assert(committed.kind() == DURABLE_REPLACE_COMMITTED);
	assert(committed.committed());
	assert(committed.mayHaveCommitted());
	DurableReplaceOutcome replaceFailure = DurableReplaceOutcome.failed(denied);
	assert(replaceFailure.kind() == DURABLE_REPLACE_FAILED);
	assert(!replaceFailure.committed());
	assert(!replaceFailure.mayHaveCommitted());
	assert(replaceFailure.error() == denied);
	DurableReplaceOutcome uncertain = DurableReplaceOutcome.durabilityUncertain(denied);
	assert(uncertain.kind() == DURABLE_REPLACE_DURABILITY_UNCERTAIN);
	assert(!uncertain.committed());
	assert(uncertain.mayHaveCommitted());
	assert(uncertain.error() == denied);

	assert(!FileSystem.openPrivateDirectory("").ok());
	assert(FileSystem.openPrivateDirectory("").error().kind() == FS_INVALID_ARGUMENT);
	assert(!FileSystem.openPrivateDirectory("relative/private").ok());
	assert(FileSystem.openPrivateDirectory("relative/private").error().kind() == FS_INVALID_ARGUMENT);

	print("PASS: typed filesystem handle contract");
	return 0;
}
