import Library.FileSystem;
import Library.FileSystem.FileSystemHandles;

#include <assert.h>

int main() {
	FileSystemHandleInventory initial = FileSystem.ownedHandleInventory();

	FileSystemOutcome<TemporaryDirectory> temporary = FileSystem.createTemporaryDirectory("btrc-handle-inventory");
	assert(temporary.ok());
	TemporaryDirectory root = temporary.value();
	FileSystemHandleInventory withTemporary = FileSystem.ownedHandleInventory();
	assert(withTemporary.openCount() == initial.openCount() + 1);
	assert(FileSystem.writeText(root.path() + "/value.bin", "value"));

	FileSystemOutcome<FileHandle> fileOpen = FileSystem.openFileExact(root.path() + "/value.bin");
	FileSystemOutcome<DirectoryHandle> directoryOpen = FileSystem.openDirectoryExact(root.path());
	assert(fileOpen.ok() && directoryOpen.ok());
	FileHandle file = fileOpen.value();
	DirectoryHandle directory = directoryOpen.value();
	FileSystemHandleInventory withExactHandles = FileSystem.ownedHandleInventory();
	assert(withExactHandles.openCount() == initial.openCount() + 3);
	assert(withTemporary.openCount() == initial.openCount() + 1);

	assert(file.close().ok());
	assert(file.close().kind() == FS_ALREADY_CLOSED);
	assert(FileSystem.ownedHandleInventory().openCount() == initial.openCount() + 2);
	assert(directory.close().ok());
	assert(directory.close().kind() == FS_ALREADY_CLOSED);
	assert(FileSystem.ownedHandleInventory().sameAs(withTemporary));

	/* A private directory and its exclusive lease each count once. */
	FileSystemOutcome<PrivateDirectory> privateOpen = FileSystem.openPrivateDirectory(root.path() + "/private");
	assert(privateOpen.ok());
	PrivateDirectory privateDirectory = privateOpen.value();
	assert(FileSystem.ownedHandleInventory().openCount() == initial.openCount() + 2);
	FileSystemOutcome<ExclusiveFileLease> leaseOpen = privateDirectory.acquireExclusiveLease("state.lock");
	assert(leaseOpen.ok());
	ExclusiveFileLease lease = leaseOpen.value();
	assert(FileSystem.ownedHandleInventory().openCount() == initial.openCount() + 3);
	assert(lease.close().ok());
	assert(lease.close().kind() == FS_ALREADY_CLOSED);
	assert(FileSystem.ownedHandleInventory().openCount() == initial.openCount() + 2);
	assert(privateDirectory.close().ok());
	assert(FileSystem.ownedHandleInventory().sameAs(withTemporary));
	FileSystemOutcome<PrivateDirectory> closedChild = privateDirectory.openChildDirectory("child");
	assert(!closedChild.ok());
	assert(closedChild.error().kind() == FS_CLOSED);
	assert(FileSystem.removeRecursive(root.path() + "/private") == 0);

	assert(root.close().ok());
	assert(root.close().kind() == FS_ALREADY_CLOSED);
	assert(FileSystem.ownedHandleInventory().sameAs(initial));

	print("PASS: typed filesystem handle inventory lifecycle");
	return 0;
}
