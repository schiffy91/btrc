/* TOML standalone helpers: key / value / unquote / sectionName / tableArrayName
 * / stripInlineComment, plus rootMap stopping at the first section header. */
import Library.TOML;
import Library.Vector;

#include <assert.h>

int main() {
	// key / value split on the first structural '='.
	assert(TOML.key("a = 1").equals("a"));
	assert(TOML.value("a = 1").equals("1"));
	assert(TOML.key("name = \"x\"").equals("name"));
	assert(TOML.value("name = \"x\"").equals("x"));

	// unquote: double, single (literal), and bare.
	assert(TOML.unquote("\"dq\"").equals("dq"));
	assert(TOML.unquote("'lit'").equals("lit"));
	assert(TOML.unquote("bare").equals("bare"));
	// single-quoted is literal: backslash is NOT an escape.
	assert(TOML.unquote("'a\\tb'").equals("a\\tb"));

	// Basic strings decode TOML's escapes, matching Python's tomllib.
	assert(TOML.unquote("\"a\\tb\\n\\\"q\\\"\\\\\"").equals("a\tb\n\"q\"\\"));
	assert(TOML.unquote("\"\\b\\f\\r\"").equals("\b\f\r"));
	assert(TOML.unquote("\"caf\\u00e9\"").equals("café"));
	assert(TOML.unquote("\"\\U0001F600\"").equals("😀"));
	assert(TOML.unquote("\"\\u20AC\"").equals("€"));
	// A literal tab is valid inside a basic string.
	assert(TOML.unquote("\"a\tb\"").equals("a\tb"));
	// Literal UTF-8 bytes are at or above 0x80: never control characters,
	// whether plain char is signed or unsigned.
	assert(TOML.unquote("\"café €\"").equals("café €"));
	assert(TOML.unquote("\"\xff\"").equals("\xff"));
	Vector<string> invalid = ["\"\\x41\"", "\"\\e\"", "\"\\uD800\"", "\"\\u12\"", "\"\\U00110000\"", "\"\\u0000\"", "\"bad\\\"", "\"a\x01b\"", "\"a\x7f\""];
	for text in invalid {
		bool rejected = false;
		try {
			TOML.unquote(text);
		} catch (string error) {
			rejected = error.startsWith("TOML");
		}
		assert(rejected);
	}

	// sectionName matches [x] but NOT [[x]].
	assert(TOML.sectionName("[srv]").equals("srv"));
	assert(TOML.sectionName("[[t]]").equals(""));
	assert(TOML.sectionName("key = 1").equals(""));

	// tableArrayName matches [[x]] but NOT [x].
	assert(TOML.tableArrayName("[[t]]").equals("t"));
	assert(TOML.tableArrayName("[srv]").equals(""));

	// stripInlineComment removes a trailing '# comment'.
	assert(TOML.stripInlineComment("x = 1 # comment").equals("x = 1"));
	assert(TOML.stripInlineComment("plain").equals("plain"));

	// rootMap reads top-level keys and STOPS at the first section header.
	string doc = "title = \"root\"\n" + "count = 3\n" + "[section]\n" + "inside = \"no\"\n";
	var root = TOML.rootMap(doc);
	assert(root.getOrDefault("title", "").equals("root"));
	assert(root.getOrDefault("count", "").equals("3"));
	// keys after the [section] header never reach rootMap.
	assert(root.getOrDefault("inside", "absent").equals("absent"));

	print("PASS: test_stdlib_toml_utilities");
	return 0;
}
