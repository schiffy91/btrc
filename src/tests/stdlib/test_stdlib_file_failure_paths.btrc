/* File failure paths: opening an unwritable location leaves ok()==false and the
 * write/writeLine/read/readLine methods all return their not-open sentinels
 * (false / "") rather than crashing. */
#include <assert.h>

int main() {
    // A path under a nonexistent directory cannot be opened for writing.
    File bad = File("/nonexistent_dir_btrc/x.txt", "w");
    assert(!bad.ok());
    assert(!bad.write("x"));
    assert(!bad.writeLine("x"));
    bad.flush();        // no-op when not open; must not crash
    bad.close();        // safe to close an unopened handle

    // Opening a missing file for reading: ok()==false and reads are empty.
    File missing = File("/nonexistent_dir_btrc/y.txt", "r");
    assert(!missing.ok());
    assert(missing.read().equals(""));
    assert(missing.readLine().equals(""));
    Vector<string> none = missing.readLines();
    assert(none.len == 0);
    assert(missing.eof());      // eof() reports true on a closed/unopened handle
    missing.close();

    print("PASS: test_stdlib_file_failure_paths");
    return 0;
}
