/* Result<T, E> carrying an Error OBJECT as the error type (Result<int, Error>),
 * combining the two stdlib error idioms. Existing Result tests only use
 * primitive/string E. Confirms the Err branch holds the structured error and the
 * Ok branch holds the value, with no inline Result/Error definitions (both come
 * from the stdlib). */
import std.error;
import std.result;

#include <assert.h>

int main() {
	// Err case: error payload is a structured Error subclass.
	Result<int, Error> bad = new Result<int, Error>(false, 0, new ValueError("bad"));
	assert(bad.isErr());
	assert(!bad.isOk());
	Error e = bad.unwrapErr();
	assert(e.code == 1);                 // ValueError.code
	assert(e.toString().equals("bad"));  // inherited toString()
	assert(e.message.equals("bad"));

	// Ok case: value payload is intact, error side unused.
	Result<int, Error> good = new Result<int, Error>(true, 42, new IOError(""));
	assert(good.isOk());
	assert(good.unwrap() == 42);

	print("PASS: test_exceptions_result_error_object");
	return 0;
}
