import Library.Image;
import Library.NativeUI;
import Library.Vector;

#include <assert.h>

int main() {
	Image artwork = Image(2, 2);
	artwork.setRGBA(0, 0, 10, 20, 30, 255);

	NativeUIElement tree = NativeUIElement.column("library").className("library-root").style("padding: 8px; gap: 12px").child(NativeUIElement.text("status", "Two albums")).child(NativeUIElement.grid("albums").child(NativeUIElement.button("album:first", "First").style("border-radius: 8px").child(NativeUIElement.image("album-art:first", artwork, "First album").imageRevision(7ULL))));

	assert(tree.kind() == NATIVE_UI_COLUMN);
	assert(tree.id() == "library");
	assert(tree.cssClass() == "library-root");
	assert(tree.inlineStyle() == "padding: 8px; gap: 12px");
	assert(tree.styleError().ok());
	assert(tree.childCount() == 2);
	assert(tree.childAt(1).kind() == NATIVE_UI_GRID);
	NativeUIElement button = tree.childAt(1).childAt(0);
	assert(button.kind() == NATIVE_UI_BUTTON);
	assert(button.contentText() == "First");
	assert(button.childAt(0).contentImage() == artwork);
	assert(button.childAt(0).contentImageRevision() == 7ULL);
	assert(button.childAt(0).imageAlt() == "First album");

	NativeUIElement query = NativeUIElement.textInput("library-query", "caf\xc3\xa9", "Search albums", 64).className("library-query").style("height: 40px; border-radius: 6px");
	assert(query.kind() == NATIVE_UI_TEXT_INPUT);
	assert(query.id() == "library-query");
	assert(query.contentText() == "caf\xc3\xa9");
	assert(query.placeholderText() == "Search albums");
	assert(query.textInputMaxBytes() == 64);
	assert(query.styleError().ok());
	Vector<NativeUISelectOption> monitorOptions = [];
	monitorOptions.push(NativeUISelectOption("song-effects", "Song effects"));
	monitorOptions.push(NativeUISelectOption("raw-signal", "Raw signal"));
	monitorOptions.push(NativeUISelectOption("unavailable", "Unavailable", false));
	NativeUISelect monitorDescriptor = NativeUISelect(monitorOptions, "song-effects");
	assert(monitorDescriptor.valid());
	assert(monitorDescriptor.optionCount() == 3);
	assert(monitorDescriptor.optionAt(1).value() == "raw-signal");
	assert(monitorDescriptor.optionAt(1).label() == "Raw signal");
	assert(!monitorDescriptor.optionAt(2).enabled());
	assert(monitorDescriptor.selectedIndex() == 0);
	assert(monitorDescriptor.selectedValue() == "song-effects");
	assert(monitorDescriptor.selectedLabel() == "Song effects");
	NativeUIElement monitor = NativeUIElement.select("monitor", monitorDescriptor);
	assert(monitor.kind() == NATIVE_UI_SELECT);
	assert(monitor.contentText() == "Song effects");
	assert(monitor.selectDescriptor() != null);
	NativeUISelect resolvedMonitorDescriptor = monitor.selectDescriptor();
	assert(resolvedMonitorDescriptor.selectedValue() == "song-effects");
	NativeUIEvent selected = NativeUIEvent.selectionChanged("monitor", "raw-signal");
	assert(selected.kind() == NATIVE_UI_SELECTION_CHANGED);
	assert(selected.elementId() == "monitor");
	assert(selected.value() == "raw-signal");
	Vector<NativeUISelectOption> duplicateOptions = [];
	duplicateOptions.push(NativeUISelectOption("same", "First"));
	duplicateOptions.push(NativeUISelectOption("same", "Second"));
	assert(!NativeUISelect(duplicateOptions, "same").valid());
	assert(!NativeUISelect(monitorOptions, "missing").valid());
	Vector<NativeUISelectOption> tooManyOptions = [];
	for (int index = 0; index < 129; index++) { tooManyOptions.push(NativeUISelectOption(f"value-{index}", f"Option {index}")); }
	assert(!NativeUISelect(tooManyOptions, "value-0").valid());
	Vector<NativeUISelectOption> emptyLabelOptions = [];
	emptyLabelOptions.push(NativeUISelectOption("empty-label", ""));
	assert(!NativeUISelect(emptyLabelOptions, "empty-label").valid());
	NativeUIElement typography = NativeUIElement.text("typography", "Editorial heading").style("font-size: 28px; line-height: 34px; font-weight: 600; text-align: center");
	assert(typography.styleError().ok());
	NativeUIColor teal = NativeUIColor.hex("#1a2b3c");
	assert(teal.css() == "#1a2b3cff");
	assert(teal.withAlpha(16).css() == "#1a2b3c10");
	assert(teal.equals(NativeUIColor(26, 43, 60)));
	assert(!teal.equals(teal.withAlpha(16)));
	assert(NativeUIColor.fromRgba(RGBA(1, 2, 3, 4)).css() == "#01020304");
	RGBA bridged = teal.rgba();
	assert(bridged.red == 26 && bridged.green == 43 && bridged.blue == 60 && bridged.alpha == 255);
	assert(NativeUIStyle.validate("color: " + teal.css()).ok());
	assert(NativeUITheme.dark().equals(NativeUITheme.dark()));
	assert(!NativeUITheme.dark().equals(NativeUITheme.light()));
	assert(!NativeUITheme.light().equals(NativeUITheme.nativeDefault()));
	assert(NativeUITheme.light().background.equals(NativeUIColor(242, 242, 244)));
	assert(NativeUITheme.dark().text.equals(NativeUIColor(236, 236, 238)));
	assert(!NativeUIElement.text("small-type", "bad").style("font-size: 7px").styleError().ok());
	assert(!NativeUIElement.text("tall-type", "bad").style("line-height: 513px").styleError().ok());
	assert(!NativeUIElement.text("bad-weight", "bad").style("font-weight: 800").styleError().ok());
	assert(!NativeUIElement.text("bad-alignment", "bad").style("text-align: justify").styleError().ok());

	NativeUIElement rejected = NativeUIElement.text("unsafe", "No browser CSS").style("position: fixed");
	assert(!rejected.styleError().ok());
	assert(rejected.styleError().code() == NATIVE_UI_STYLE_UNSUPPORTED_PROPERTY);
	assert(rejected.styleError().property() == "position");

	NativeUIStyleSheet sheet = NativeUIStyleSheet().rule("library-root", "background-color: #f6f6f8; padding: 8px").rule("album-card", "border-radius: 8px; color: #202024");
	assert(sheet.ok());
	assert(sheet.ruleCount() == 2);
	assert(sheet.classNameAt(1) == "album-card");
	assert(sheet.cssFor("album-card") == "border-radius: 8px; color: #202024");
	assert(sheet.cssFor("missing").isEmpty());
	NativeUIStyleSheet duplicateSheet = NativeUIStyleSheet().rule("album-card", "padding: 4px").rule("album-card", "padding: 8px");
	assert(!duplicateSheet.ok());
	assert(duplicateSheet.issue().code() == NATIVE_UI_STYLE_DUPLICATE_RULE);
	NativeUIStyleSheet invalidSheet = NativeUIStyleSheet().rule("browser descendant", "padding: 8px");
	assert(!invalidSheet.ok());
	assert(invalidSheet.issue().code() == NATIVE_UI_STYLE_INVALID_SELECTOR);

	NativeUIVirtualGrid virtualLayout = NativeUIVirtualGrid(2000, 4, 180, 1984);
	NativeUIElement virtualGrid = NativeUIElement.virtualGrid("virtual-albums", virtualLayout).child(NativeUIElement.button("album:1984", "Album 1984")).child(NativeUIElement.button("album:1985", "Album 1985"));
	assert(virtualGrid.kind() == NATIVE_UI_VIRTUAL_GRID);
	assert(virtualGrid.virtualGridDescriptor() != null);
	NativeUIVirtualGrid resolvedLayout = virtualGrid.virtualGridDescriptor();
	assert(resolvedLayout.ok());
	assert(resolvedLayout.totalCount() == 2000);
	assert(resolvedLayout.columns() == 4);
	assert(resolvedLayout.rowHeight() == 180);
	assert(resolvedLayout.firstDataIndex() == 1984);
	assert(!NativeUIVirtualGrid(4, 0, 180, 0).ok());
	assert(NativeUIVirtualGrid(4, 0, 180, 0).issue().code() == NATIVE_UI_VIRTUAL_GRID_INVALID_COLUMNS);

	NativeUIViewportMetrics viewport = NativeUIViewportMetrics(800, 600, 0, 240);
	NativeUIScrollDelta delta = NativeUIScrollDelta(0, 120);
	NativeUIEvent scrolled = NativeUIEvent.scrolled("albums", viewport, delta);
	assert(scrolled.kind() == NATIVE_UI_SCROLLED);
	assert(scrolled.elementId() == "albums");
	assert(scrolled.viewport().width() == 800);
	assert(scrolled.viewport().height() == 600);
	assert(scrolled.viewport().scrollY() == 240);
	assert(scrolled.scroll().x() == 0);
	assert(scrolled.scroll().y() == 120);

	assert(NativeUIEvent.clicked("album:first").kind() == NATIVE_UI_CLICKED);
	assert(NativeUIEvent.hoverEntered("album:first").kind() == NATIVE_UI_HOVER_ENTERED);
	assert(NativeUIEvent.hoverLeft("album:first").kind() == NATIVE_UI_HOVER_LEFT);
	assert(NativeUIEvent.viewportChanged("albums", viewport).kind() == NATIVE_UI_VIEWPORT_CHANGED);
	NativeUIEvent changed = NativeUIEvent.valueChanged("library-query", "new query");
	assert(changed.kind() == NATIVE_UI_VALUE_CHANGED);
	assert(changed.elementId() == "library-query");
	assert(changed.value() == "new query");

	print("PASS: native UI values");
	return 0;
}
