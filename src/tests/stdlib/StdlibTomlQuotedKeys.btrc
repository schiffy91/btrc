/* Assignment delimiters inside quoted TOML keys are data, not the key/value
 * separator. Basic-string escapes are decoded consistently with JSON escapes. */
import Library.TOML;

#include <assert.h>

int main() {
	string doc = "\"a=b\" = \"value\"\n" + "'literal=key' = 'literal'\n" + "\"unicode\\u003dkey\" = \"decoded\\u0021\"\n" + "plain = \"x=y#z\" # comment\n";

	var root = TOML.rootMap(doc);
	assert(root.getOrDefault("a=b", "").equals("value"));
	assert(root.getOrDefault("literal=key", "").equals("literal"));
	assert(root.getOrDefault("unicode=key", "").equals("decoded!"));
	assert(root.getOrDefault("plain", "").equals("x=y#z"));

	assert(TOML.key("\"a=b\" = 1").equals("a=b"));
	assert(TOML.value("\"a=b\" = 1").equals("1"));
	assert(TOML.key("\"a=b\"").equals(""));

	print("PASS: test_stdlib_toml_quoted_keys");
	return 0;
}
