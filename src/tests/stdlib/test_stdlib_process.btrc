/* ExecResult.trimmed() + UnixShell.capture() — the run-and-trim idiom. */
#include <assert.h>

int main() {
    UnixShell sh = UnixShell();
    assert(sh.runUnchecked("printf '  hi  '").trimmed().equals("hi"));
    assert(sh.capture(Command("printf").arg("world")).equals("world"));
    assert(sh.run("printf 'x'").trimmed().equals("x"));
    assert(sh.run("false", check=false).code == 1);
    assert(sh.run("printf 'quiet'", capture=false).code == 0);
    assert(sh.runRaw("printf 'raw'", check=true).trimmed().equals("raw"));
    print("PASS");
    return 0;
}
