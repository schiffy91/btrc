/* Real lock ownership and filesystem identity, through both frontends. */
import Library.FileSystem;
import Library.FileSystem.FileSystemHandles;
import Library.Platform;

#include <assert.h>
#include <errno.h>
#include <sys/stat.h>
#include <unistd.h>
#if defined(_WIN32)

/* CreateHardLinkW, for the second-link case; the support file does not use
 * the provider's code. */
import ../native/filesystem_windows/WindowsFileSystemSupport.c

extern int btrcTestHardLink(string existing, string link);
#endif

int main() {
	var initial = FileSystem.ownedHandleInventory();
	var temporary = FileSystem.createTemporaryDirectory("btrc-advisory-lock");
	assert(temporary.ok());
	var root = temporary.value();
	string path = root.path() + "/coordination.lock";
	assert(!AdvisoryFileLock.acquire("").ok());
	assert(AdvisoryFileLock.acquire("").error().kind() == FS_INVALID_ARGUMENT);
	var opened = AdvisoryFileLock.acquire(path);
	assert(opened.ok());
	var owner = opened.value();
	var alias = owner;
	assert(owner.isOpen());
	assert(owner.validate().ok());
	assert(FileSystem.ownedHandleInventory().openCount() == initial.openCount() + 2);
	var contended = AdvisoryFileLock.acquire(path);
	assert(!contended.ok());
	assert(contended.error().kind() == FS_RESOURCE_EXHAUSTED);
	assert(FileSystem.ownedHandleInventory().openCount() == initial.openCount() + 2);
	assert(owner.close().ok());
	assert(!alias.isOpen());
	assert(!alias.validate().ok());
	assert(alias.close().kind() == FS_ALREADY_CLOSED);
	assert(FileSystem.isFile(path));

	for (int cycle = 0; cycle < 100; cycle++) {
		var acquired = AdvisoryFileLock.acquire(path);
		assert(acquired.ok());
		assert(acquired.value().close().ok());
	}
	assert(FileSystem.ownedHandleInventory().openCount() == initial.openCount() + 1);

	string linked = root.path() + "/linked.lock";
#if defined(_WIN32)
	assert(FileSystem.symlink(path, linked) == 0);
#else
	assert(symlink(path, linked) == 0);
#endif
	assert(!AdvisoryFileLock.acquire(linked).ok());
	assert(AdvisoryFileLock.acquire(linked).error().kind() == FS_SYMLINK);
	assert(unlink(linked) == 0);
#if defined(_WIN32)
	assert(btrcTestHardLink(path, linked) == 0);
	assert(!AdvisoryFileLock.acquire(path).ok());
	assert(!AdvisoryFileLock.acquire(linked).ok());
	assert(unlink(linked) == 0);
	/* Windows file systems have no FIFOs; a directory is the wrong-type case. */
#else
	char nativePath[4096];
	char nativeLinked[4096];
	assert(snprintf(nativePath, sizeof(nativePath), "%s", path) < 4096);
	assert(snprintf(nativeLinked, sizeof(nativeLinked), "%s", linked) < 4096);
	/* Android's SELinux policy gives the shell and app domains no link
	 * permission, so a second name for the lock file cannot exist there. */
	int linkedStatus = link(nativePath, nativeLinked);
	if (Platform.isAndroid()) {
		assert(linkedStatus != 0 && errno == EACCES);
	} else {
		assert(linkedStatus == 0);
		assert(!AdvisoryFileLock.acquire(path).ok());
		assert(!AdvisoryFileLock.acquire(linked).ok());
		assert(unlink(linked) == 0);
	}
	int fifoStatus = mkfifo(nativeLinked, (mode_t)0600);
	int fifoError = errno;
	if (fifoStatus == 0) {
		assert(!AdvisoryFileLock.acquire(linked).ok());
		assert(AdvisoryFileLock.acquire(linked).error().kind() == FS_WRONG_TYPE);
		assert(unlink(linked) == 0);
	} else {
		// Android's shell policy can deny FIFO creation in shell_data_file.
		// Directory rejection below still exercises the wrong-type contract.
		if (!Platform.isAndroid() || fifoError != EACCES) { fprintf(stderr, "lock fixture FIFO creation failed: %d\n", fifoError); }
		assert(Platform.isAndroid() && fifoError == EACCES);
		assert(!FileSystem.exists(linked));
	}
#endif
	assert(!AdvisoryFileLock.acquire(root.path()).ok());
	assert(AdvisoryFileLock.acquire(root.path()).error().kind() == FS_WRONG_TYPE);

	var replaced = AdvisoryFileLock.acquire(path);
	assert(replaced.ok());
	string previous = root.path() + "/previous.lock";
	assert(rename(path, previous) == 0);
	assert(FileSystem.writeText(path, "replacement"));
	assert(!replaced.value().validate().ok());
	assert(replaced.value().validate().error().kind() == FS_CHANGED);
	assert(replaced.value().close().ok());
	assert(FileSystem.readText(path).equals("replacement"));
	assert(FileSystem.ownedHandleInventory().openCount() == initial.openCount() + 1);
	assert(root.close().ok());
	assert(FileSystem.ownedHandleInventory().sameAs(initial));
	print("PASS: advisory lock ownership and identity");
	return 0;
}
