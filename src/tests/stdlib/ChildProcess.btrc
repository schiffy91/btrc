/* Structured child execution: argv stays tokenized, cwd/environment are
 * applied without a shell, stdout/stderr and status are captured separately,
 * and a timeout kills the whole process group. On Windows the same checks run
 * through the CreateProcessW provider: there is no fork, so the descendant of
 * the timeout cases is a grandchild the child starts through ChildProcess
 * (the whole tree lives in the parent's job), the spaced helper is a copy of
 * this image, and a child's text-mode stdio writes CRLF. */
import Library.Timer;
import Library.FileSystem;
import Library.Platform;
import Library.Process;
import Library.Strings;
import Library.Vector;

#include <assert.h>

#if defined(_WIN32)
bool copyExecutable(string source, string destination) {
	FILE* input = fopen(source, "rb");
	if (input == NULL) { return false; }
	FILE* output = fopen(destination, "wb");
	if (output == NULL) {
		fclose(input);
		return false;
	}
	char buffer[65536];
	bool copied = true;
	size_t count = fread(buffer, 1, 65536, input);
	while (count > (size_t)0) {
		if (fwrite(buffer, 1, count, output) != count) {
			copied = false;
			break;
		}
		count = fread(buffer, 1, 65536, input);
	}
	if (ferror(input) != 0) { copied = false; }
	fclose(input);
	if (fclose(output) != 0) { copied = false; }
	return copied;
}

string lines(string text) { return text.replace("\r\n", "\n"); }
#endif

int childProbe(int argc, char** argv) {
	string mode = Strings.copy(argv[1]);
	if (mode.equals("--probe")) {
		char cwd[4096];
		assert(getcwd(cwd, 4096) != NULL);
		string overrideValue = Environment.get("BTRC_CHILD_OVERRIDE", "");
		string newValue = Environment.get("BTRC_CHILD_NEW", "");
		string? removedValue = null;
		char* removedRaw = getenv("BTRC_CHILD_REMOVE");
		if (removedRaw != NULL) { removedValue = Strings.copy(removedRaw); }
		printf("cwd=%s\n", cwd);
		printf("override=%s\n", overrideValue);
		printf("new=%s\n", newValue);
		printf("removed=%s\n", removedValue == null ? "missing" : removedValue);
		for (int i = 2; i < argc; i++) {
			printf("arg=%s\n", argv[i]);
		}
		fprintf(stderr, "captured stderr\n");
		return 23;
	}
	if (mode.equals("--timeout-group")) {
#if defined(_WIN32)
		// The child waits on its own descendant; only the parent's deadline,
		// which owns the whole tree, ends both before the marker appears.
		ChildProcess.run(Strings.copy(argv[0]), ["--descendant", Strings.copy(argv[2])]);
		return 0;
#else
		pid_t descendant = fork();
		if (descendant == (pid_t)0) {
			usleep(500000);
			FILE* marker = fopen(argv[2], "w");
			if (marker != NULL) {
				fputs("survived", marker);
				fclose(marker);
			}
			_exit(0);
		}
		// Exit the direct child immediately. Its descendant keeps the capture
		// pipes open, so the run is only bounded if timeout owns the group.
		return 0;
#endif
	}
#if defined(_WIN32)
	if (mode.equals("--descendant")) {
		usleep(500000);
		FILE* marker = fopen(argv[2], "w");
		if (marker != NULL) {
			fputs("survived", marker);
			fclose(marker);
		}
		return 0;
	}
	if (mode.equals("--linger")) {
		usleep(500000);
		return 0;
	}
#endif
	if (mode.equals("--escaped-pipe")) {
#if defined(_WIN32)
		// The descendant writes straight into the parent's capture pipe.
		ChildProcess.run(Strings.copy(argv[0]), ["--linger"], stdout=COMMAND_OUTPUT_STREAM, stderr=COMMAND_OUTPUT_STREAM);
		return 0;
#else
		pid_t descendant = fork();
		if (descendant == (pid_t)0) {
			setsid();
			usleep(500000);
			_exit(0);
		}
		return 0;
#endif
	}
	if (mode.equals("--stdin")) {
		char input[128];
		size_t count = fread(input, 1, 127, stdin);
		input[(int)count] = '\0';
		printf("stdin=%s", input);
		return 0;
	}
	if (mode.equals("--volume")) {
		for (int i = 0; i < 20000; i++) { fputs("out\n", stdout); }
		for (int i = 0; i < 20000; i++) { fputs("err\n", stderr); }
		return 0;
	}
	if (mode.equals("--binary")) {
		fputs("before", stdout);
		fputc(0, stdout);
		fputs("after", stdout);
		fputs("err", stderr);
		fputc(0, stderr);
		fputs("tail", stderr);
		return 0;
	}
	return 64;
}

int main(int argc, char** argv) {
	if (argc > 1) { return childProbe(argc, argv); }

#if !defined(_WIN32)
	ChildProcessCapture invalidCapture = ChildProcessCapture(2147483647);
	invalidCapture.readReady();
	assert(invalidCapture.failed && !invalidCapture.open);

	int cloexecPipe[2];
	assert(ChildProcess.openPipe(cloexecPipe) == 0);
	assert((fcntl(cloexecPipe[0], F_GETFD) & FD_CLOEXEC) != 0);
	assert((fcntl(cloexecPipe[1], F_GETFD) & FD_CLOEXEC) != 0);
	ChildProcess.closePipe(cloexecPipe);
#endif

	string secret = "pa'ss word";
	string renderedSecret = "tool --token " + ShellWords.quote(secret);
	string redacted = ShellWords.redact(renderedSecret, secret);
	assert(redacted.equals("tool --token ***"));
	string nestedRendered = ShellWords.quote(renderedSecret);
	string nestedRedacted = ShellWords.redact(nestedRendered, secret);
	assert(nestedRedacted.contains("***"));
	assert(!nestedRedacted.contains("ss word"));

#if defined(_WIN32)
	// FileSystem.tempDir reads TMPDIR; Windows names its directory TEMP.
	assert(setenv("TMPDIR", Environment.get("TEMP", ""), 1) == 0);
#endif
	string root = FileSystem.tempDir("btrc child process");
	assert(!root.isEmpty());
	root = PathTools.absolute(root);
	string executable = PathTools.absolute(argv[0]);
	string spacedExecutable = PathTools.join(root, "helper with spaces");
#if defined(_WIN32)
	// An extensionless name probes .exe, as CreateProcessW's own rule does.
	assert(copyExecutable(executable, spacedExecutable + ".exe"));
#else
	assert(FileSystem.symlink(executable, spacedExecutable) == 0);
#endif

	string shellMarker = PathTools.join(root, "shell-expanded");
	string metacharacters = f"; touch {shellMarker}";
	Vector<string> arguments = [
		"--probe",
		"space value",
		"$HOME `literal` * ?",
		metacharacters,
		"quote'\"value"
	];
	setenv("BTRC_CHILD_OVERRIDE", "old", 1);
	setenv("BTRC_CHILD_REMOVE", "inherited", 1);
	ExecResult result = ChildProcess.run(
		spacedExecutable,
		arguments,
		cwd=root,
		environment=[
		"BTRC_CHILD_OVERRIDE=two words",
		"BTRC_CHILD_NEW=$literal=with=equals"
	],
		unsetEnvironment=["BTRC_CHILD_REMOVE"],
		timeoutMilliseconds=2000
	);

	assert(result.code == 23);
	assert(!result.ok());
	assert(!result.wasTimedOut());
	assert(result.command.startsWith("'" + spacedExecutable + "'"));
#if defined(_WIN32)
	assert(lines(result.stderr()).equals("captured stderr\n"));
#else
	assert(result.stderr().equals("captured stderr\n"));
#endif
	string expected = f"cwd={root}\n" + "override=two words\n" + "new=$literal=with=equals\n" + "removed=missing\n" + "arg=space value\n" + "arg=$HOME `literal` * ?\n" + f"arg={metacharacters}\n" + "arg=quote'\"value\n";
#if defined(_WIN32)
	assert(lines(result.stdout()).equals(expected));
#else
	assert(result.stdout().equals(expected));
#endif
	assert(!FileSystem.exists(shellMarker));

	ExecResult input = ChildProcess.run(executable, ["--stdin"], stdinData="anonymous input");
	assert(input.ok());
	assert(input.stdout().equals("stdin=anonymous input"));
	assert(input.capturedStdoutBytes == input.stdout().length());
	assert(input.capturedStderrBytes == 0);

	ExecResult binary = ChildProcess.run(executable, ["--binary"]);
	assert(binary.ok());
	assert(binary.stdout().equals("before"));
	assert(binary.stderr().equals("err"));
	assert(binary.capturedStdoutBytes == 12 && binary.capturedStderrBytes == 8);
	ExecResult combined = ChildProcess.run(executable, ["--binary"], stderr=COMMAND_OUTPUT_COMBINE);
	assert(combined.ok());
	assert(combined.capturedStdoutBytes == 20 && combined.capturedStderrBytes == 0);
	ExecResult suppressed = ChildProcess.run(executable, ["--binary"], stdout=COMMAND_OUTPUT_SUPPRESS, stderr=COMMAND_OUTPUT_SUPPRESS);
	assert(suppressed.ok());
	assert(suppressed.capturedStdoutBytes == 0 && suppressed.capturedStderrBytes == 0);
#if defined(_WIN32)
	ExecResult shellBinary = UnixShell().run(ShellWords.quote(executable) + " --binary", stderr=COMMAND_OUTPUT_COLLECT, logFailure=false);
	assert(shellBinary.code == 127);
	assert(shellBinary.stderr().contains("UnixShell.run is unavailable on Windows"));
#else
	ExecResult shellBinary = UnixShell().run(ShellWords.quote(executable) + " --binary", stderr=COMMAND_OUTPUT_COLLECT);
	assert(shellBinary.ok());
	assert(shellBinary.capturedStdoutBytes == 12 && shellBinary.capturedStderrBytes == 8);
#endif

	ExecResult pathOverride = ChildProcess.run("helper with spaces", ["--probe"], cwd=root, environment=["PATH=" + root], timeoutMilliseconds=2000);
	assert(pathOverride.code == 23);

	// A signal and the exit status 128 + N share a code; only the signal
	// sets terminatingSignal, here and through UnixShell.
	assert(result.terminatingSignal == 0);
	ExecResult signaled = ChildProcess.run("/bin/sh", ["-c", "kill -TERM $$"], timeoutMilliseconds=5000);
	assert(signaled.code == 143 && signaled.terminatingSignal == 15);
	ExecResult exited = ChildProcess.run("/bin/sh", ["-c", "exit 143"], timeoutMilliseconds=5000);
	assert(exited.code == 143 && exited.terminatingSignal == 0);
	ExecResult shellKilled = UnixShell().run("kill -KILL $$", logFailure=false);
	assert(shellKilled.code == 137 && shellKilled.terminatingSignal == 9);

	bool rejected = false;
	Vector<string> noArguments = [];
	try {
#if defined(_WIN32)
		// A Windows name may hold '-' but never '='.
		ChildProcess.run(executable, noArguments, unsetEnvironment=["BAD=NAME"]);
#else
		ChildProcess.run(executable, noArguments, environment=["BAD-NAME=value"]);
#endif
	} catch (string error) {
		rejected = error.contains("invalid environment variable name");
	}
	assert(rejected);

	ExecResult missing = ChildProcess.run(PathTools.join(root, "missing executable"), noArguments, timeoutMilliseconds=1000);
	assert(missing.code == 127);
	string missingStderr = missing.stderr();
	assert(missingStderr.contains("failed to execute") || missingStderr.contains("failed to start"));

	// Without stdinData the child reads /dev/null, so a reader sees EOF at
	// once instead of blocking on the parent's stdin.
#if defined(_WIN32)
	ExecResult silent = ChildProcess.run(executable, ["--stdin"], timeoutMilliseconds=5000);
	assert(silent.ok());
	assert(!silent.wasTimedOut());
	assert(silent.stdout().equals("stdin="));
#else
	ExecResult silent = ChildProcess.run("cat", noArguments, timeoutMilliseconds=5000);
	assert(silent.ok());
	assert(!silent.wasTimedOut());
	assert(silent.stdout().isEmpty());
#endif

	ExecResult volume = ChildProcess.run(executable, ["--volume"], timeoutMilliseconds=2000);
	assert(volume.ok());
#if defined(_WIN32)
	// Text-mode stdio writes each line's LF as CRLF.
	assert(volume.stdout().len() == 100000);
	assert(volume.stderr().len() == 100000);
	assert(volume.capturedStdoutBytes == 100000 && volume.capturedStderrBytes == 100000);
#else
	assert(volume.stdout().len() == 80000);
	assert(volume.stderr().len() == 80000);
	assert(volume.capturedStdoutBytes == 80000 && volume.capturedStderrBytes == 80000);
#endif

	ExecResult bounded = ChildProcess.run(executable, ["--volume"], timeoutMilliseconds=2000, maxStdoutBytes=1024, maxStderrBytes=1024);
	assert(bounded.code == 125);
	assert(bounded.stdout().len() <= 1024);
	assert(bounded.stderr().contains("capture limit"));
	assert(bounded.captureExceeded && !bounded.captureFailed);
	assert(!volume.captureExceeded && !volume.captureFailed);
	assert(bounded.capturedStdoutBytes <= 1024 && bounded.capturedStderrBytes <= 1024);

	string descendantMarker = PathTools.join(root, "descendant survived");
	Timer timer = Timer();
	timer.start();
	ExecResult timeout = ChildProcess.run(executable, ["--timeout-group", descendantMarker], timeoutMilliseconds=100);
	timer.stop();
	assert(timeout.code == 124);
	assert(timeout.wasTimedOut());
	// The API's own kill is a timeout, not a terminating signal.
	assert(timeout.terminatingSignal == 0 && bounded.terminatingSignal == 0);
	assert(timer.elapsedMillis() < 2000.0f);
	usleep(700000);
	assert(!FileSystem.exists(descendantMarker));

	Timer escapedTimer = Timer();
	escapedTimer.start();
	ExecResult escaped = ChildProcess.run(executable, ["--escaped-pipe"], timeoutMilliseconds=100);
	escapedTimer.stop();
	assert(escaped.code == 124);
	assert(escaped.wasTimedOut());
	assert(escapedTimer.elapsedMillis() < 2000.0f);

	unsetenv("BTRC_CHILD_OVERRIDE");
	unsetenv("BTRC_CHILD_REMOVE");
#if defined(_WIN32)
	// Exact-handle tree removal has no Windows provider yet (row 7): remove
	// the two files this test made, then the directory.
	remove(spacedExecutable + ".exe");
	rmdir(root);
#else
	FileSystem.removeRecursive(root);
#endif
	print("PASS: test_stdlib_child_process");
	return 0;
}
