/* Library.Terminal on redirected standard streams, the same on every
 * platform: bounded line reads, prompts and password prompts from a file, and
 * no terminal size, colours or raw mode when the streams are not terminals.
 * TerminalPty.btrc covers a real Unix terminal; on Windows a real console is
 * driven through a pseudoconsole by test_windows_terminal.py. */
import Library.FileSystem;
import Library.IO;
import Library.Terminal;
import Library.Terminal.TerminalPasswordInput;

#include <assert.h>
#include <stdio.h>

int main() {
	/* The corpus runner gives this program pipes, never a terminal. */
	assert(Terminal.size() == null);
	assert(!Terminal.enableColors());

	string dir = FileSystem.tempDir("btrc_terminal");
	assert(!dir.isEmpty());
	string path = PathTools.join(dir, "input.txt");
	string longLine = "x".repeat(9000);
	Path.writeAll(path, longLine + "\nplain\nsecret\n");
	FILE* input = freopen(path, "r", stdin);
	assert(input != NULL);
	assert(Terminal.enterRawMode() == null);

	assert(Terminal.readLine().equals(longLine));
	assert(Terminal.prompt("plain: ").equals("plain"));
	assert(Terminal.promptPassword("secret: ").equals("secret"));

	/* Both line readers are bounded: plain input keeps a prefix and resumes
	 * on the next line; an oversized password is rejected, not truncated. */
	string boundedPath = PathTools.join(dir, "bounded.txt");
	Path.writeAll(boundedPath, "abcdef\nnext\n" + "p".repeat(5000) + "\nshort\n");
	input = freopen(boundedPath, "r", stdin);
	assert(input != NULL);
	assert(Terminal.readLine(3).equals("abc"));
	assert(Terminal.readLine().equals("next"));
	assert(TerminalPasswordInput.maxPasswordBytes() == 4096);
	assert(Terminal.promptPassword("long secret: ").isEmpty());
	assert(Terminal.promptPassword("short secret: ").equals("short"));
	assert(Terminal.readLine().isEmpty());

	/* Windows cannot remove a file that is still open. */
	fclose(stdin);
	assert(remove(path) == 0);
	assert(remove(boundedPath) == 0);
	assert(rmdir(dir) == 0);

	print("PASS: test_stdlib_terminal");
	return 0;
}
