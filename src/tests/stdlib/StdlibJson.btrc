/* JSONObject: typed setters/getters, stringify→parse round-trip, escaping. */
import Library.JSON;
import Library.JSONX;

#include <assert.h>
#include <string.h>

int main() {
	var profile = JSONObject();
	profile.setString("name", "Ada");
	profile.setInt("age", 36);
	profile.setBool("admin", true);

	assert(profile.has("name"));
	assert(!profile.has("missing"));
	assert(strcmp(profile.getString("name", "?"), "Ada") == 0);
	assert(profile.getInt("age", 0) == 36);
	assert(profile.getBool("admin", false) == true);
	assert(profile.getInt("missing", -1) == -1);
	assert(profile.getBool("missing", true) == true);

	var parsedProfile = JSONObject.parse(profile.stringify());
	assert(strcmp(parsedProfile.getString("name", "?"), "Ada") == 0);
	assert(parsedProfile.getInt("age", 0) == 36);
	assert(parsedProfile.getBool("admin", false) == true);

	var escaped = JSONObject();
	escaped.setString("path", "a\"b\\c");
	var parsedEscaped = JSONObject.parse(escaped.stringify());
	assert(strcmp(parsedEscaped.getString("path", "?"), "a\"b\\c") == 0);
	escaped.setString("control", "a\tb\rc");
	var controls = JSONObject.parse(escaped.stringify());
	assert(strcmp(controls.getString("control", "?"), "a\tb\rc") == 0);
	assert(controls.stringify().contains("\\t"));
	assert(controls.stringify().contains("\\r"));
	assert(JSONObject.parse("{\"n\":\"oops\"}").getInt("n", -7) == -7);
	assert(JSONText.intField("{\"n\":\"\"}", "n", -8) == -8);
	assert(JSONText.intField("{\"n\":\"oops\"}", "n", -9) == -9);

	string nested = "{\"nodes\":[{\"name\":\"inner\",\"args\":{\"state\":\"nested\"}}],\"name\":\"outer\",\"args\":{\"name\":\"arg\"},\"default\":[\"final\"]}";
	assert(JSONText.field(nested, "name", "?").equals("outer"));
	assert(JSONText.argsObject(nested).get("name").equals("arg"));
	assert(JSONText.stringArray(nested, "default").get(0).equals("final"));
	var nodes = JSONText.objectArray(nested, "nodes");
	assert(nodes.len == 1);
	assert(JSONText.field(nodes.get(0), "name", "?").equals("inner"));
	assert(JSONText.objectPath(nested, ["args"]).contains("\"name\""));
	assert(JSONText.fieldPath(nested, ["args", "name"], "?").equals("arg"));
	assert(JSONText.fieldPath(nested, ["missing", "name"], "?").equals("?"));
	assert(JSON.str("a\"b\\c").equals("\"a\\\"b\\\\c\""));
	assert(JSON.getString("{\"content\":\"hi\\nthere\"}", "content").equals("hi\nthere"));
	assert(JSON.getStringAfter("{\"message\":{\"content\":\"nested\"}}", "message", "content").equals("nested"));
	assert(JSON.getString("{\"content\": false}", "content").equals(""));

	print("PASS: test_stdlib_json");
	return 0;
}
