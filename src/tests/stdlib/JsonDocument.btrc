/* Canonical pretty JSON: exact layout, insertion order, and escaping. */
import Library.JSON;

#include <assert.h>

int main() {
	string escapedKey = "key\"\\\n";
	string escapedValue = "quote \" backslash \\ slash / newline\n tab\t carriage\r control\x01";

	JSONValue array = JSONValue.makeArray();
	array.push(JSONValue.makeString(escapedValue));
	array.push(JSONValue.makeInt(7));
	array.push(JSONValue.makeBool(true));
	array.push(JSONValue.makeNull());

	JSONValue nested = JSONValue.makeObject();
	nested.set("array", array);
	nested.set("empty", JSONValue.makeObject());

	JSONValue value = JSONValue.makeObject();
	value.set("zeta", JSONValue.makeString(escapedValue));
	value.set("alpha", nested);
	value.set(escapedKey, JSONValue.makeArray());

	string expected = "{\n" + "  \"zeta\": \"quote \\\" backslash \\\\ slash / newline\\n tab\\t carriage\\r control\\u0001\",\n" + "  \"alpha\": {\n" + "    \"array\": [\n" + "      \"quote \\\" backslash \\\\ slash / newline\\n tab\\t carriage\\r control\\u0001\",\n" + "      7,\n" + "      true,\n" + "      null\n" + "    ],\n" + "    \"empty\": {}\n" + "  },\n" + "  \"key\\\"\\\\\\n\": []\n" + "}";
	string compact = "{\"zeta\":\"quote \\\" backslash \\\\ slash / newline\\n tab\\t carriage\\r control\\u0001\"," + "\"alpha\":{\"array\":[\"quote \\\" backslash \\\\ slash / newline\\n tab\\t carriage\\r control\\u0001\",7,true,null],\"empty\":{}}," + "\"key\\\"\\\\\\n\":[]}";

	string pretty = value.stringifyPretty();
	string document = value.document();
	assert(pretty.equals(expected));
	assert(document.equals(expected + "\n"));
	assert(value.stringify().equals(compact));
	assert(value.stringifyPretty(-1).equals(value.stringifyPretty(0)));
	assert(value.stringifyPretty(4).contains("\n    \"alpha\": {\n        \"array\": [\n"));
	assert(JSONValue.makeInt(7).stringifyPretty().equals("7"));
	assert(JSONValue.makeInt(7).document().equals("7\n"));
	assert(JSONValue.makeArray().document().equals("[]\n"));

	JSONValue parsed = JSONValue.parse(document);
	assert(!parsed.isError());
	assert(parsed.stringify().equals(compact));
	assert(parsed.document().equals(document));
	assert(parsed.has(escapedKey));
	assert(parsed.get("zeta").asString().equals(escapedValue));

	print("pretty:");
	print(pretty);
	print("PASS: test_stdlib_json_document");
	return 0;
}
