/* Structured child execution: argv stays tokenized, cwd/environment are
 * applied without a shell, stdout/stderr and status are captured separately,
 * and a timeout kills the whole process group. */
#include <assert.h>

int childProbe(int argc, char** argv) {
    string mode = argv[1];
    if (mode.equals("--probe")) {
        char cwd[4096];
        assert(getcwd(cwd, 4096) != NULL);
        string overrideValue = getenv("BTRC_CHILD_OVERRIDE");
        string newValue = getenv("BTRC_CHILD_NEW");
        string removedValue = getenv("BTRC_CHILD_REMOVE");
        printf("cwd=%s\n", cwd);
        printf("override=%s\n", overrideValue);
        printf("new=%s\n", newValue);
        printf("removed=%s\n", removedValue == null ? "missing" : removedValue);
        for (int i = 2; i < argc; i++) {
            printf("arg=%s\n", argv[i]);
        }
        fprintf(stderr, "captured stderr\n");
        return 23;
    }
    if (mode.equals("--timeout-group")) {
        pid_t descendant = fork();
        if (descendant == 0) {
            usleep(500000);
            FILE* marker = fopen(argv[2], "w");
            if (marker != NULL) {
                fputs("survived", marker);
                fclose(marker);
            }
            _exit(0);
        }
        // Exit the direct child immediately. Its descendant keeps the capture
        // pipes open, so the run is only bounded if timeout owns the group.
        return 0;
    }
    if (mode.equals("--volume")) {
        for (int i = 0; i < 20000; i++) { fputs("out\n", stdout); }
        for (int i = 0; i < 20000; i++) { fputs("err\n", stderr); }
        return 0;
    }
    return 64;
}

int main(int argc, char** argv) {
    if (argc > 1) { return childProbe(argc, argv); }

    ChildProcessCapture invalidCapture = ChildProcessCapture(2147483647);
    invalidCapture.readReady();
    assert(invalidCapture.failed && !invalidCapture.open);

    string root = FileSystem.tempDir("btrc child process");
    assert(!root.isEmpty());
    root = PathTools.absolute(root);
    string executable = PathTools.absolute(argv[0]);
    string spacedExecutable = PathTools.join(root, "helper with spaces");
    assert(FileSystem.symlink(executable, spacedExecutable) == 0);

    string shellMarker = PathTools.join(root, "shell-expanded");
    string metacharacters = f"; touch {shellMarker}";
    Vector<string> arguments = [
        "--probe",
        "space value",
        "$HOME `literal` * ?",
        metacharacters,
        "quote'\"value"
    ];
    setenv("BTRC_CHILD_OVERRIDE", "old", 1);
    setenv("BTRC_CHILD_REMOVE", "inherited", 1);
    ExecResult result = ChildProcess.run(
        spacedExecutable,
        arguments,
        cwd=root,
        environment=[
            "BTRC_CHILD_OVERRIDE=two words",
            "BTRC_CHILD_NEW=$literal=with=equals"
        ],
        unsetEnvironment=["BTRC_CHILD_REMOVE"],
        timeoutMilliseconds=2000
    );

    assert(result.code == 23);
    assert(!result.ok());
    assert(!result.wasTimedOut());
    assert(result.command.startsWith("'" + spacedExecutable + "'"));
    assert(result.stderr().equals("captured stderr\n"));
    string expected = f"cwd={root}\n"
        + "override=two words\n"
        + "new=$literal=with=equals\n"
        + "removed=missing\n"
        + "arg=space value\n"
        + "arg=$HOME `literal` * ?\n"
        + f"arg={metacharacters}\n"
        + "arg=quote'\"value\n";
    assert(result.stdout().equals(expected));
    assert(!FileSystem.exists(shellMarker));

    bool rejected = false;
    Vector<string> noArguments = [];
    try {
        ChildProcess.run(executable, noArguments, environment=["BAD-NAME=value"]);
    } catch (string error) {
        rejected = error.contains("invalid environment variable name");
    }
    assert(rejected);

    ExecResult missing = ChildProcess.run(
        PathTools.join(root, "missing executable"),
        noArguments,
        timeoutMilliseconds=1000
    );
    assert(missing.code == 127);
    assert(missing.stderr().contains("failed to execute"));

    ExecResult volume = ChildProcess.run(
        executable,
        ["--volume"],
        timeoutMilliseconds=2000
    );
    assert(volume.ok());
    assert(volume.stdout().len() == 80000);
    assert(volume.stderr().len() == 80000);

    string descendantMarker = PathTools.join(root, "descendant survived");
    Timer timer = Timer();
    timer.start();
    ExecResult timeout = ChildProcess.run(
        executable,
        ["--timeout-group", descendantMarker],
        timeoutMilliseconds=100
    );
    timer.stop();
    assert(timeout.code == 124);
    assert(timeout.wasTimedOut());
    assert(timer.elapsedMillis() < 2000.0f);
    usleep(700000);
    assert(!FileSystem.exists(descendantMarker));

    unsetenv("BTRC_CHILD_OVERRIDE");
    unsetenv("BTRC_CHILD_REMOVE");
    FileSystem.removeRecursive(root);
    print("PASS: test_stdlib_child_process");
    return 0;
}
