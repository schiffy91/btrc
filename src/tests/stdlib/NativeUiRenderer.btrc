	NativeUiRenderer wordRenderer = NativeUiRenderer();
	NativeUiFrame wordFrame = wordRenderer.render(NativeUiElement.textInput("words", "Hello,  Bj\xc3\xb6rk world!", "", 64), 500, 48);
	NativeUiLayoutBox wordBox = wordFrame.boxFor("words");
	NativeUiResolvedStyle wordStyle = wordBox.style;
	int wordLeft = wordBox.bounds.x + wordStyle.paddingLeft();
	int wordY = wordBox.bounds.y + wordBox.bounds.height / 2;
	int bjorkX = wordLeft + NativeUiTextViewport.width("Hello,  B", 0, 9, wordRenderer.typography(), wordStyle) - 1;
	wordRenderer.pointerPressed(bjorkX, wordY, false, 2);
	assert(wordRenderer.selectedText() == "Bj\xc3\xb6rk");
	wordRenderer.pointerReleased(bjorkX, wordY);
	assert(wordRenderer.selectedText() == "Bj\xc3\xb6rk");
	wordRenderer.pointerPressed(bjorkX, wordY, false, 2);
	wordRenderer.pointerMoved(wordLeft + 1, wordY);
	assert(wordRenderer.selectedText() == "Hello,  Bj\xc3\xb6rk");
	wordRenderer.pointerMoved(bjorkX, wordY);
	assert(wordRenderer.selectedText() == "Bj\xc3\xb6rk");
	int worldX = wordLeft + NativeUiTextViewport.width("Hello,  Bj\xc3\xb6rk w", 0, 16, wordRenderer.typography(), wordStyle) - 1;
	wordRenderer.pointerMoved(worldX, wordY);
	assert(wordRenderer.selectedText() == "Bj\xc3\xb6rk world");
	wordRenderer.pointerReleased(worldX, wordY);
	assert(wordRenderer.selectedText() == "Bj\xc3\xb6rk world");
	wordRenderer.pointerPressed(bjorkX, wordY, false, 3);
	wordRenderer.pointerReleased(bjorkX, wordY);
	assert(wordRenderer.selectedText() == "Hello,  Bj\xc3\xb6rk world!");
	wordRenderer.pointerPressed(wordLeft, wordY);
	wordRenderer.pointerReleased(wordLeft, wordY);
	assert(wordRenderer.selectedText().isEmpty() && wordRenderer.focusedCaret() == 0);
	wordRenderer.pointerPressed(bjorkX, wordY, false, 2);
	assert(wordRenderer.textEntered("Bowie").eventAt(0).value() == "Hello,  Bowie world!");
	wordRenderer.pointerCancelled();
	wordRenderer.pointerMoved(wordLeft, wordY);
	assert(wordRenderer.selectedText().isEmpty());
	assert(NativeUiTextInput.selectionWordStart("a,  b", 1) == 1 && NativeUiTextInput.selectionWordEnd("a,  b", 1) == 2);
	assert(NativeUiTextInput.selectionWordStart("a,  b", 3) == 2 && NativeUiTextInput.selectionWordEnd("a,  b", 3) == 4);
	assert(NativeUiTextInput.selectionWordStart("", 0) == 0 && NativeUiTextInput.selectionWordEnd("", 0) == 0);
	assert(NativeUiTextInput.selectionWordStart("last", 4) == 0 && NativeUiTextInput.selectionWordEnd("last", 4) == 4);
	print("PASS: native UI layout, virtual scroll, and input");
	return 0;
}
