import std.image;
import std.native_ui;
import std.vector;

#include <assert.h>

int platformTypographyMeasure(unsigned long long provider, string value, int fontSize, int lineHeight, int fontWeight, int* widthOut, int* heightOut, int* ascentOut, int* descentOut, int* advanceOut) {
	assert(provider == 42ULL);
	assert(value == "System");
	assert(fontSize == 20 && lineHeight == 26 && fontWeight == 600);
	widthOut[0] = 71;
	heightOut[0] = 26;
	ascentOut[0] = 18;
	descentOut[0] = 5;
	advanceOut[0] = 15;
	return 1;
}

NativeUiElement deepVirtualGrid() {
	NativeUiElement grid = NativeUiElement.virtualGrid("albums", NativeUiVirtualGrid(2000, 4, 40, 1984)).className("album-grid");
	for (int index = 1984; index < 2000; index++) {
		grid.child(NativeUiElement.button(f"album:{index}", f"Album {index}").className("album-card"));
	}
	return NativeUiElement.column("library").className("library-root").child(NativeUiElement.text("status", "2000 albums")).child(grid);
}

void assertRejected(NativeUiFrame frame, NativeUiFrameStatus status) {
	assert(!frame.ok());
	assert(frame.status == status);
	assert(frame.image.isEmpty());
	assert(frame.boxCount() == 0);
}

void assertRowLayout() {
	NativeUiElement sidebar = NativeUiElement.column("row-sidebar").style("padding: 0px; width: 100px; height: 50px");
	NativeUiElement first = NativeUiElement.column("row-first").style("padding: 0px; height: 30px");
	NativeUiElement second = NativeUiElement.column("row-second").style("padding: 0px; height: 70px");
	NativeUiElement row = NativeUiElement.row("row").style("gap: 10px; padding: 0px").child(sidebar).child(first).child(second);
	assert(row.kind() == NATIVE_UI_ROW);
	NativeUiFrame frame = NativeUiRenderer().layout(NativeUiElement.column("row-root").style("padding: 0px; gap: 0px").child(row), 400, 200);
	assert(frame.ok());
	NativeUiLayoutBox rowBox = frame.boxFor("row");
	NativeUiLayoutBox sidebarBox = frame.boxFor("row-sidebar");
	NativeUiLayoutBox firstBox = frame.boxFor("row-first");
	NativeUiLayoutBox secondBox = frame.boxFor("row-second");
	assert(rowBox.bounds.width == 400 && rowBox.bounds.height == 70);
	assert(rowBox.resolvedSemantics().role() == NATIVE_UI_SEMANTIC_ROLE_GROUP);
	assert(sidebarBox.bounds.x == 0 && sidebarBox.bounds.width == 100 && sidebarBox.bounds.height == 50);
	assert(firstBox.bounds.x == 110 && firstBox.bounds.width == 140 && firstBox.bounds.height == 30);
	assert(secondBox.bounds.x == 260 && secondBox.bounds.width == 140 && secondBox.bounds.height == 70);
	assert(sidebarBox.bounds.y == rowBox.bounds.y && firstBox.bounds.y == rowBox.bounds.y && secondBox.bounds.y == rowBox.bounds.y);
}

void assertRowCrossAlignment() {
	NativeUiElement tall = NativeUiElement.column("align-tall").style("padding: 0px; width: 60px; height: 80px");
	NativeUiElement centred = NativeUiElement.column("align-centred").style("padding: 0px; height: 20px");
	NativeUiElement ended = NativeUiElement.column("align-ended").style("padding: 0px; width: 40px; height: 30px");
	NativeUiElement row = NativeUiElement.row("align-row").style("gap: 0px; padding: 5px; align-items: center").child(tall).child(centred).child(ended);
	NativeUiFrame frame = NativeUiRenderer().layout(NativeUiElement.column("align-root").style("padding: 0px; gap: 0px").child(row), 300, 200);
	assert(frame.ok());
	NativeUiLayoutBox rowBox = frame.boxFor("align-row");
	assert(rowBox.bounds.height == 90);
	assert(frame.boxFor("align-tall").bounds.y == rowBox.bounds.y + 5);
	assert(frame.boxFor("align-centred").bounds.y == rowBox.bounds.y + 5 + 30);
	assert(frame.boxFor("align-ended").bounds.y == rowBox.bounds.y + 5 + 25);
	NativeUiElement endRow = NativeUiElement.row("end-row").style("gap: 0px; padding: 0px; align-items: end").child(NativeUiElement.column("end-tall").style("padding: 0px; width: 60px; height: 80px")).child(NativeUiElement.column("end-short").style("padding: 0px; height: 20px"));
	NativeUiFrame endFrame = NativeUiRenderer().layout(NativeUiElement.column("end-root").style("padding: 0px; gap: 0px").child(endRow), 300, 200);
	assert(endFrame.ok());
	assert(endFrame.boxFor("end-short").bounds.y == endFrame.boxFor("end-row").bounds.y + 60);
	assert(NativeUiStyle.validate("align-items: start").ok());
	assert(!NativeUiStyle.validate("align-items: top").ok());
}

void assertStyleSheetOverrides() {
	NativeUiStyleSheet base = NativeUiStyleSheet().rule("card", "padding: 4px; color: #101010; gap: 2px");
	NativeUiStyleSheet themed = base.copy().extend("card", "color: #fefefe").extend("fresh", "gap: 9px").kindRule(NATIVE_UI_BUTTON, "border-radius: 7px; padding: 3px");
	assert(themed.ok());
	assert(base.ok());
	assert(base.ruleCount() == 1);
	assert(themed.ruleCount() == 2);
	assert(base.cssFor("card") == "padding: 4px; color: #101010; gap: 2px");
	assert(themed.cssFor("card") == "padding: 4px; color: #101010; gap: 2px; color: #fefefe");
	assert(themed.cssFor("fresh") == "gap: 9px");
	assert(themed.kindCssFor(NATIVE_UI_BUTTON) == "border-radius: 7px; padding: 3px");
	assert(themed.kindCssFor(NATIVE_UI_TEXT) == "");
	NativeUiResolvedStyle card = NativeUiResolvedStyle.from(NativeUiElement.column("card-a").className("card"), themed);
	assert(card.padding == 4 && card.gap == 2);
	assert(card.hasForeground && card.foreground.red == 254 && card.foreground.green == 254 && card.foreground.blue == 254);
	NativeUiResolvedStyle button = NativeUiResolvedStyle.from(NativeUiElement.button("card-b", "Play").className("card").style("padding: 1px"), themed);
	assert(button.radius == 7);
	assert(button.padding == 1);
	NativeUiResolvedStyle plainButton = NativeUiResolvedStyle.from(NativeUiElement.button("card-c", "Play"), themed);
	assert(plainButton.radius == 7 && plainButton.padding == 3);
	assert(!NativeUiStyleSheet().rule("card", "gap: 1px").extend("card", "gap: nope").ok());
	assert(!NativeUiStyleSheet().rule("card", "gap: 1px").rule("card", "gap: 2px").ok());
}

void assertTextRaster() {
	NativeUiTypography typography = NativeUiTypography();
	NativeUiColor ink = NativeUiColor(200, 100, 50, 255);
	Image raster = NativeUiTextRaster.rasterize(typography, "Ab", 16, 20, 600, ink);
	NativeUiTextMetrics metrics = typography.measure("Ab", 16, 20, 600);
	assert(raster.width == metrics.width());
	assert(raster.height == 20);
	int inked = 0;
	int clear = 0;
	for (int y = 0; y < raster.height; y++) {
		for (int x = 0; x < raster.width; x++) {
			int offset = (y * raster.width + x) * 4;
			int alpha = (int)raster.data[offset + 3];
			if (alpha == 0) {
				clear++;
				assert((int)raster.data[offset] == 0);
			} else {
				inked++;
				assert(alpha == 255 && (int)raster.data[offset] == 200 && (int)raster.data[offset + 1] == 100 && (int)raster.data[offset + 2] == 50);
			}
		}
	}
	assert(inked > 0 && clear > 0);
	Image scaled = NativeUiTextRaster.rasterize(typography, "Ab", 16, 20, 600, ink, 2.0f);
	assert(scaled.width == metrics.width() * 2 && scaled.height == 40);
	assert(NativeUiTextRaster.rasterize(typography, "", 16, 20, 400, ink).isEmpty());
	assert(NativeUiTextRaster.tryPlatformRasterize(typography, "Ab", 16, 20, 400, ink) == null);
	Image translucent = NativeUiTextRaster.rasterize(typography, "A", 16, 20, 400, NativeUiColor(0, 0, 255, 128));
	bool sawHalf = false;
	for (int i = 0; i < translucent.width * translucent.height; i++) {
		int alpha = (int)translucent.data[i * 4 + 3];
		assert(alpha == 0 || alpha == 128);
		if (alpha == 128) { sawHalf = true; }
	}
	assert(sawHalf);
	Image canvas = Image(raster.width + 4, raster.height + 4);
	NativeUiTextRaster.blit(canvas, raster, 2, 2);
	assert((int)canvas.data[3] == 0);
	int blitted = 0;
	for (int i = 0; i < canvas.width * canvas.height; i++) { if ((int)canvas.data[i * 4 + 3] == 255) { blitted++; } }
	assert(blitted == inked);
	Image opaque = Image(4, 4);
	opaque.setRGBA(1, 1, 0, 0, 0, 255);
	Image dot = Image(1, 1);
	dot.setRGBA(0, 0, 255, 255, 255, 128);
	NativeUiTextRaster.blit(opaque, dot, 1, 1);
	assert((int)opaque.data[(1 * 4 + 1) * 4] == 128 && (int)opaque.data[(1 * 4 + 1) * 4 + 3] == 255);
	string longRun = "";
	for (int i = 0; i < 1400; i++) { longRun = longRun + "\xc3\xa9" + "a"; }
	string bounded = NativeUiTextRaster.bounded(longRun);
	assert(bounded.len() == 4095);
	assert(NativeUiTextInput.validUtf8(bounded));
	assert(NativeUiTextRaster.bounded("short") == "short");
}

int main() {
	assertRowLayout();
	assertRowCrossAlignment();
	assertStyleSheetOverrides();
	assertTextRaster();
	NativeUiStyleSheet sheet = NativeUiStyleSheet().rule("library-root", "gap: 10px; padding: 6px").rule("album-grid", "gap: 4px; padding: 4px; background-color: #112233").rule("album-card", "border-radius: 4px; color: #fefefe");
	NativeUiRenderer renderer = NativeUiRenderer.styled(sheet);
	NativeUiFrame frame = renderer.render(deepVirtualGrid(), 320, 120);
	assert(frame.ok());
	assert(frame.boxCount() == 19);
	assert(frame.contentHeight == 22044);
	assert(frame.viewport.scrollX() == 0);
	assert(frame.viewport.scrollY() == 0);
	assert(frame.virtualGridCount() == 1);
	NativeUiVirtualGridViewport initialGeometry = frame.virtualGridFor("albums");
	assert(initialGeometry.gridId() == "albums");
	assert(initialGeometry.contentOffsetY() == 38);
	assert(initialGeometry.rowPitch() == 44);
	assert(initialGeometry.firstVisibleDataIndex() == 0);
	assert(initialGeometry.visibleDataCount() == 8);
	NativeUiLayoutBox rootBox = frame.boxFor("albums");
	assert(rootBox.style.padding == 4);
	assert(rootBox.style.gap == 4);
	assert(rootBox.style.hasBackground);
	assert(rootBox.style.background.red == 17);
	NativeUiTypography typography = NativeUiTypography();
	NativeUiTextMetrics headingMetrics = typography.measure("AB", 28, 34);
	assert(headingMetrics.width() == 48 && headingMetrics.height() == 34 && headingMetrics.advance() == 24);
	assert(!typography.platformBacked());
	NativeUiTypography platformTypography = NativeUiTypography.platform(42ULL, platformTypographyMeasure);
	NativeUiTextMetrics platformMetrics = platformTypography.measure("System", 20, 26, 600);
	assert(platformTypography.platformBacked());
	assert(platformMetrics.width() == 71 && platformMetrics.height() == 26 && platformMetrics.ascent() == 18 && platformMetrics.descent() == 5 && platformMetrics.advance() == 15);
	assert(typography.alignedX(10, 100, 8, 48, NATIVE_UI_TEXT_ALIGN_LEFT) == 18);
	assert(typography.alignedX(10, 100, 8, 48, NATIVE_UI_TEXT_ALIGN_CENTER) == 36);
	assert(typography.alignedX(10, 100, 8, 48, NATIVE_UI_TEXT_ALIGN_RIGHT) == 54);
	NativeUiRenderer typographyRenderer = NativeUiRenderer(null, null, typography);
	NativeUiFrame typographyFrame = typographyRenderer.render(NativeUiElement.text("heading", "AB").style("width: 100px; padding: 8px; font-size: 28px; line-height: 34px; font-weight: 600; text-align: right"), 160, 80);
	assert(typographyFrame.ok());
	NativeUiLayoutBox heading = typographyFrame.boxFor("heading");
	assert(typographyFrame.contentWidth == 100 && heading.bounds.width == 160 && heading.bounds.height == 50);
	assert(heading.style.fontSize == 28 && heading.style.lineHeight == 34 && heading.style.fontWeight == 600 && heading.style.textAlignment == NATIVE_UI_TEXT_ALIGN_RIGHT);
	NativeUiFrame styledButtonFrame = NativeUiRenderer().render(NativeUiElement.button("styled-button", "").style("padding: 0px; border-radius: 0px; background-color: #393c43ff; color: #ffffffff"), 40, 36);
	assert(styledButtonFrame.ok());
	NativeUiLayoutBox styledButton = styledButtonFrame.boxFor("styled-button");
	assert(styledButton.style.hasBackground && styledButton.style.background.red == 57 && styledButton.style.background.green == 60 && styledButton.style.background.blue == 67 && styledButton.style.background.alpha == 255);
	assert(styledButtonFrame.image.data[0] == 57 && styledButtonFrame.image.data[1] == 60 && styledButtonFrame.image.data[2] == 67 && styledButtonFrame.image.data[3] == 255);

	NativeUiRenderer layoutRenderer = NativeUiRenderer.styled(sheet);
	for (int iteration = 0; iteration < 32; iteration++) {
		NativeUiFrame layoutOnly = layoutRenderer.layout(deepVirtualGrid(), 320, 120);
		assert(layoutOnly.ok());
		assert(layoutOnly.image.isEmpty());
		assert(layoutOnly.boxCount() == 19);
	}
	NativeUiEventBatch layoutScroll = layoutRenderer.scrollBy(0, 400);
	assert(layoutScroll.frame.ok());
	assert(layoutScroll.frame.image.isEmpty());
	assert(layoutScroll.frame.boxCount() == 19);

	NativeUiRenderer inputRenderer = NativeUiRenderer();
	NativeUiElement inputTree = NativeUiElement.column("query-root").child(NativeUiElement.textInput("query", "a\xc3\xa9", "Search albums", 5)).child(NativeUiElement.textInput("secondary-query", "", "Second", 16));
	NativeUiFrame inputFrame = inputRenderer.render(inputTree, 240, 120);
	assert(inputFrame.ok());
	NativeUiLayoutBox inputBox = inputFrame.boxFor("query");
	inputRenderer.pointerPressed(inputBox.bounds.x + 2, inputBox.bounds.y + 2);
	assert(inputRenderer.focusedId() == "query");
	assert(inputRenderer.focusedValue() == "a\xc3\xa9");
	assert(inputRenderer.focusedCaret() == 3);
	inputRenderer.moveCaretLeft();
	assert(inputRenderer.focusedCaret() == 1);
	NativeUiEventBatch inserted = inputRenderer.textEntered("Z");
	assert(inserted.eventCount() == 1);
	assert(inserted.eventAt(0).kind() == NATIVE_UI_VALUE_CHANGED);
	assert(inserted.eventAt(0).elementId() == "query");
	assert(inserted.eventAt(0).value() == "aZ\xc3\xa9");
	NativeUiEventBatch removed = inputRenderer.backspace();
	assert(removed.eventCount() == 1);
	assert(removed.eventAt(0).value() == "a\xc3\xa9");
	inputRenderer.moveCaretRight();
	NativeUiEventBatch appended = inputRenderer.textEntered("!");
	assert(appended.eventCount() == 1);
	assert(appended.eventAt(0).value() == "a\xc3\xa9!");
	assert(inputRenderer.textEntered("\xf0\x9f\x98\x80").eventCount() == 0);
	assert(inputRenderer.focusedValue() == "a\xc3\xa9!");
	assert(inputRenderer.textEntered("\xc3").eventCount() == 0);
	assert(inputRenderer.focusedValue() == "a\xc3\xa9!");
	inputRenderer.focusNext();
	assert(inputRenderer.focusedId() == "secondary-query");
	inputRenderer.focusNext(true);
	assert(inputRenderer.focusedId() == "query");
	inputRenderer.blur();
	assert(inputRenderer.focusedId().isEmpty());

	NativeUiRenderer controlledRenderer = NativeUiRenderer();
	NativeUiFrame controlledFrame = controlledRenderer.layout(NativeUiElement.textInput("controlled", "old", "", 16), 200, 48);
	NativeUiLayoutBox controlledBox = controlledFrame.boxFor("controlled");
	controlledRenderer.pointerPressed(controlledBox.bounds.x + 2, controlledBox.bounds.y + 2);
	assert(controlledRenderer.textEntered("!").eventAt(0).value() == "old!");
	controlledRenderer.layout(NativeUiElement.textInput("controlled", "server", "", 16), 200, 48);
	assert(controlledRenderer.focusedValue() == "server");
	assert(controlledRenderer.focusedCaret() == 6);

	Vector<NativeUiSelectOption> selectOptions = [];
	selectOptions.push(NativeUiSelectOption("song-effects", "Song effects"));
	selectOptions.push(NativeUiSelectOption("unavailable", "Unavailable", false));
	selectOptions.push(NativeUiSelectOption("raw-signal", "Raw signal"));
	NativeUiElement selectElement = NativeUiElement.select("monitor", NativeUiSelect(selectOptions, "song-effects"));
	NativeUiRenderer selectRenderer = NativeUiRenderer();
	NativeUiFrame selectFrame = selectRenderer.render(selectElement, 240, 200);
	assert(selectFrame.ok());
	NativeUiLayoutBox selectBox = selectFrame.boxFor("monitor");
	assert(selectBox.bounds.height == 36 && selectBox.selectable());
	selectRenderer.pointerPressed(selectBox.bounds.x + 4, selectBox.bounds.y + 4);
	NativeUiEventBatch openedSelect = selectRenderer.pointerReleased(selectBox.bounds.x + 4, selectBox.bounds.y + 4);
	assert(openedSelect.eventCount() == 0);
	assert(selectRenderer.expandedSelectId() == "monitor");
	NativeUiSelectPopup popup = selectRenderer.selectPopup();
	assert(popup.visible() && popup.ownerId() == "monitor");
	assert(popup.firstOptionIndex() == 0 && popup.visibleOptionCount() == 3 && popup.rowHeight() == 36);
	assert(popup.bounds().y == selectBox.bounds.y + selectBox.bounds.height);
	assert(openedSelect.frame.image.data[(popup.bounds().y * openedSelect.frame.image.width + popup.bounds().x + popup.bounds().width / 2) * 4] == 205);
	assert(openedSelect.frame.image.data[((popup.bounds().y + 2) * openedSelect.frame.image.width + popup.bounds().x + 2) * 4] == 24);
	NativeUiRect rawOption = popup.optionBounds(2);
	int rawX = rawOption.x + 4;
	int rawY = rawOption.y + rawOption.height / 2;
	selectRenderer.pointerPressed(rawX, rawY);
	NativeUiEventBatch pointerSelected = selectRenderer.pointerReleased(rawX, rawY);
	assert(pointerSelected.eventCount() == 1);
	assert(pointerSelected.eventAt(0).kind() == NATIVE_UI_SELECTION_CHANGED);
	assert(pointerSelected.eventAt(0).elementId() == "monitor");
	assert(pointerSelected.eventAt(0).value() == "raw-signal");
	assert(selectRenderer.expandedSelectId().isEmpty());
	assert(selectRenderer.focusedId() == "monitor");
	NativeUiElement controlledSelect = NativeUiElement.select("monitor", NativeUiSelect(selectOptions, "raw-signal"));
	assert(selectRenderer.render(controlledSelect, 240, 200).ok());
	NativeUiLayoutBox controlledSelectBox = selectRenderer.currentFrame().boxFor("monitor");
	NativeUiSelect controlledSelectDescriptor = controlledSelectBox.element.selectDescriptor();
	assert(controlledSelectDescriptor.selectedValue() == "raw-signal");
	selectRenderer.activate("monitor");
	NativeUiRect disabledOption = selectRenderer.selectPopup().optionBounds(1);
	selectRenderer.pointerPressed(disabledOption.x + 4, disabledOption.y + 4);
	assert(selectRenderer.pointerReleased(disabledOption.x + 4, disabledOption.y + 4).eventCount() == 0);
	assert(selectRenderer.expandedSelectId() == "monitor");
	selectRenderer.dismiss();
	assert(selectRenderer.focusedId() == "monitor");
	selectRenderer.navigateFocusedSelect(-1);
	assert(selectRenderer.expandedSelectId() == "monitor");
	assert(selectRenderer.highlightedSelectIndex() == 2);
	selectRenderer.navigateFocusedSelect(-1);
	assert(selectRenderer.highlightedSelectIndex() == 0);
	NativeUiEventBatch keyboardSelected = selectRenderer.activate("monitor");
	assert(keyboardSelected.eventCount() == 1);
	assert(keyboardSelected.eventAt(0).kind() == NATIVE_UI_SELECTION_CHANGED);
	assert(keyboardSelected.eventAt(0).value() == "song-effects");

	Vector<NativeUiSelectOption> noOptions = [];
	assertRejected(NativeUiRenderer().render(NativeUiElement.select("empty-select", NativeUiSelect(noOptions, "none")), 120, 80), NATIVE_UI_FRAME_INVALID_TREE);
	Vector<NativeUiSelectOption> duplicateSelectOptions = [];
	duplicateSelectOptions.push(NativeUiSelectOption("same", "First"));
	duplicateSelectOptions.push(NativeUiSelectOption("same", "Second"));
	assertRejected(NativeUiRenderer().render(NativeUiElement.select("duplicate-select", NativeUiSelect(duplicateSelectOptions, "same")), 120, 80), NATIVE_UI_FRAME_INVALID_TREE);
	assertRejected(NativeUiRenderer().render(NativeUiElement.select("missing-selection", NativeUiSelect(selectOptions, "missing")), 120, 80), NATIVE_UI_FRAME_INVALID_TREE);
	Vector<NativeUiSelectOption> invalidUtf8Options = [];
	invalidUtf8Options.push(NativeUiSelectOption("bad", "\xc3"));
	assertRejected(NativeUiRenderer().render(NativeUiElement.select("invalid-option", NativeUiSelect(invalidUtf8Options, "bad")), 120, 80), NATIVE_UI_FRAME_INVALID_TREE);

	NativeUiSemanticRange maximumEdge = NativeUiSemanticRange.horizontal("Maximum edge", -10LL, 9223372036854775807LL, 9223372036854775806LL, 10LL, 100LL);
	assert(maximumEdge.valid());
	assert(maximumEdge.adjustedValue(NATIVE_UI_RANGE_ADJUST_SMALL_INCREMENT) == 9223372036854775807LL);
	assert(maximumEdge.adjustedValue(NATIVE_UI_RANGE_ADJUST_MAXIMUM) == 9223372036854775807LL);
	NativeUiSemanticRange minimumEdge = NativeUiSemanticRange.vertical("Minimum edge", -9223372036854775807LL - 1LL, 10LL, -9223372036854775807LL, 10LL, 100LL);
	assert(minimumEdge.valid());
	assert(minimumEdge.adjustedValue(NATIVE_UI_RANGE_ADJUST_SMALL_DECREMENT) == -9223372036854775807LL - 1LL);
	assert(minimumEdge.adjustedValue(NATIVE_UI_RANGE_ADJUST_MINIMUM) == -9223372036854775807LL - 1LL);
	assert(!NativeUiSemanticRange.horizontal("", 0LL, 10LL, 5LL).valid());
	assert(!NativeUiSemanticRange.horizontal("Backwards", 10LL, 0LL, 5LL).valid());
	assert(!NativeUiSemanticRange.horizontal("Outside", 0LL, 10LL, 11LL).valid());
	assert(!NativeUiSemanticRange.horizontal("Zero step", 0LL, 10LL, 5LL, 0LL, 1LL).valid());

	NativeUiSemanticRange positionRange = NativeUiSemanticRange.horizontal("Song position", 0LL, 1000LL, 100LL, 5LL, 50LL);
	Image scrubImage = Image(80, 20);
	NativeUiElement scrubElement = NativeUiElement.image("scrubber", scrubImage, "Song position").semanticRange(positionRange);
	assert(scrubElement.semanticRangeDescriptor() != null);
	NativeUiRenderer rangeRenderer = NativeUiRenderer();
	NativeUiFrame rangeFrame = rangeRenderer.layout(scrubElement, 120, 60);
	assert(rangeFrame.ok());
	NativeUiLayoutBox scrubBox = rangeFrame.boxFor("scrubber");
	assert(scrubBox.adjustable() && scrubBox.focusable() && !scrubBox.clickable());
	int scrubX = scrubBox.bounds.x + 10;
	int scrubY = scrubBox.bounds.y + 4;
	rangeRenderer.pointerMoved(scrubX, scrubY);
	NativeUiEventBatch rangePressed = rangeRenderer.pointerPressed(scrubX, scrubY);
	assert(rangePressed.eventCount() == 1);
	assert(rangePressed.eventAt(0).kind() == NATIVE_UI_RANGE_POINTER_PRESSED);
	NativeUiPointerSample pressedSample = rangePressed.eventAt(0).pointer();
	assert(pressedSample.coordinate() == 10 && pressedSample.extent() == scrubBox.bounds.width);
	assert(rangeRenderer.capturedRangeId() == "scrubber");
	assert(rangeRenderer.focusedId() == "scrubber");
	assert(rangeRenderer.textEntered("ignored").eventCount() == 0);
	assert(rangeRenderer.backspace().eventCount() == 0);

	NativeUiEventBatch rangeMoved = rangeRenderer.pointerMoved(scrubBox.bounds.x + scrubBox.bounds.width + 25, scrubY);
	assert(rangeMoved.eventCount() == 2);
	assert(rangeMoved.eventAt(0).kind() == NATIVE_UI_HOVER_LEFT);
	NativeUiEvent movedEvent = rangeMoved.eventAt(1);
	assert(movedEvent.kind() == NATIVE_UI_RANGE_POINTER_MOVED);
	NativeUiPointerSample movedSample = movedEvent.pointer();
	assert(movedSample.coordinate() == scrubBox.bounds.width + 25 && movedSample.extent() == scrubBox.bounds.width);
	NativeUiEventBatch rangeReleased = rangeRenderer.pointerReleased(scrubBox.bounds.x - 15, scrubY);
	assert(rangeReleased.eventCount() == 1);
	assert(rangeReleased.eventAt(0).kind() == NATIVE_UI_RANGE_POINTER_RELEASED);
	NativeUiPointerSample releasedSample = rangeReleased.eventAt(0).pointer();
	assert(releasedSample.coordinate() == -15 && releasedSample.extent() == scrubBox.bounds.width);
	assert(rangeRenderer.capturedRangeId().isEmpty());

	rangeRenderer.pointerPressed(scrubX, scrubY);
	rangeRenderer.pointerMoved(scrubBox.bounds.x + 30, scrubY);
	NativeUiEventBatch rangeCancelled = rangeRenderer.pointerCancelled();
	assert(rangeCancelled.eventCount() == 1);
	assert(rangeCancelled.eventAt(0).kind() == NATIVE_UI_RANGE_POINTER_CANCELLED);
	NativeUiPointerSample cancelledSample = rangeCancelled.eventAt(0).pointer();
	assert(cancelledSample.coordinate() == 30 && cancelledSample.extent() == scrubBox.bounds.width);
	assert(rangeRenderer.pointerCancelled().eventCount() == 0);
	assert(rangeRenderer.pointerReleased(scrubX, scrubY).eventCount() == 0);

	rangeRenderer.pointerMoved(scrubX, scrubY);
	NativeUiEventBatch rangeWheel = rangeRenderer.wheelBy(0, 40);
	assert(rangeWheel.eventCount() == 1);
	assert(rangeWheel.eventAt(0).kind() == NATIVE_UI_RANGE_WHEEL);
	assert(rangeWheel.eventAt(0).elementId() == "scrubber");
	assert(rangeWheel.eventAt(0).rangeAdjustment() == NATIVE_UI_RANGE_ADJUST_SMALL_INCREMENT);
	assert(rangeWheel.eventAt(0).rangeValue() == 105LL);
	assert(rangeWheel.eventAt(0).scroll().x() == 0 && rangeWheel.eventAt(0).scroll().y() == 40);
	assert(rangeWheel.frame.viewport.scrollY() == 0);
	NativeUiRenderer wheelRenderer = NativeUiRenderer();
	Image wheelFiller = Image(80, 200);
	NativeUiElement wheelTree = NativeUiElement.column("wheel-root").child(NativeUiElement.image("wheel-range", scrubImage, "Position").semanticRange(positionRange)).child(NativeUiElement.image("wheel-filler", wheelFiller, "Filler"));
	NativeUiFrame wheelFrame = wheelRenderer.layout(wheelTree, 120, 60);
	NativeUiLayoutBox wheelRangeBox = wheelFrame.boxFor("wheel-range");
	wheelRenderer.pointerMoved(wheelRangeBox.bounds.x + 4, wheelRangeBox.bounds.y + 4);
	assert(wheelRenderer.wheelBy(0, 40).eventAt(0).kind() == NATIVE_UI_RANGE_WHEEL);
	assert(wheelRenderer.currentFrame().viewport.scrollY() == 0);
	wheelRenderer.pointerMoved(wheelRangeBox.bounds.x + 4, wheelRangeBox.bounds.y + wheelRangeBox.bounds.height + 4);
	NativeUiEventBatch ordinaryWheel = wheelRenderer.wheelBy(0, 40);
	assert(ordinaryWheel.eventCount() == 1);
	assert(ordinaryWheel.eventAt(0).kind() == NATIVE_UI_SCROLLED);
	assert(ordinaryWheel.eventAt(0).elementId() == "wheel-root");
	assert(ordinaryWheel.frame.viewport.scrollY() == 40);
	NativeUiEventBatch smallAdjusted = rangeRenderer.adjustFocusedRange(NATIVE_UI_RANGE_ADJUST_SMALL_DECREMENT);
	assert(smallAdjusted.eventCount() == 1 && smallAdjusted.eventAt(0).rangeValue() == 95LL);
	NativeUiEventBatch largeAdjusted = rangeRenderer.adjustFocusedRange(NATIVE_UI_RANGE_ADJUST_LARGE_INCREMENT);
	assert(largeAdjusted.eventCount() == 1 && largeAdjusted.eventAt(0).rangeValue() == 150LL);
	NativeUiEventBatch endpointAdjusted = rangeRenderer.adjustRange("scrubber", NATIVE_UI_RANGE_ADJUST_MAXIMUM);
	assert(endpointAdjusted.eventCount() == 1 && endpointAdjusted.eventAt(0).rangeValue() == 1000LL);
	assert(rangeRenderer.adjustRange("missing", NATIVE_UI_RANGE_ADJUST_SMALL_INCREMENT).eventCount() == 0);
	assert(rangeRenderer.adjustRange("scrubber", (NativeUiRangeAdjustment)99).eventCount() == 0);

	NativeUiSemanticRange verticalRange = NativeUiSemanticRange.vertical("Column value", -100LL, 100LL, 0LL, 2LL, 20LL);
	NativeUiElement rangeSurface = NativeUiElement.column("range-surface").semanticRange(verticalRange).child(NativeUiElement.text("range-label", "Range"));
	NativeUiRenderer surfaceRenderer = NativeUiRenderer();
	NativeUiFrame surfaceFrame = surfaceRenderer.layout(rangeSurface, 120, 60);
	assert(surfaceFrame.ok());
	NativeUiLayoutBox surfaceBox = surfaceFrame.boxFor("range-surface");
	assert(surfaceBox.adjustable());
	NativeUiEventBatch targetedVertical = surfaceRenderer.adjustRange("range-surface", NATIVE_UI_RANGE_ADJUST_LARGE_DECREMENT);
	assert(targetedVertical.eventCount() == 1 && targetedVertical.eventAt(0).rangeValue() == -20LL);

	NativeUiRenderer rangeFocusRenderer = NativeUiRenderer();
	NativeUiElement focusTree = NativeUiElement.column("focus-root").child(NativeUiElement.image("focus-range", scrubImage, "Position").semanticRange(positionRange)).child(NativeUiElement.textInput("focus-input", "", "Text", 8));
	assert(rangeFocusRenderer.layout(focusTree, 120, 80).ok());
	rangeFocusRenderer.focusNext();
	assert(rangeFocusRenderer.focusedId() == "focus-range");
	rangeFocusRenderer.focusNext();
	assert(rangeFocusRenderer.focusedId() == "focus-input");
	rangeFocusRenderer.focusNext(true);
	assert(rangeFocusRenderer.focusedId() == "focus-range");

	NativeUiEventBatch deepScroll = renderer.scrollBy(0, 1000000000);
	assert(deepScroll.frame.ok());
	assert(deepScroll.frame.boxCount() == 19);
	assert(deepScroll.frame.viewport.scrollY() == 21924);
	assert(deepScroll.eventCount() == 1);
	assert(deepScroll.eventAt(0).kind() == NATIVE_UI_SCROLLED);
	assert(deepScroll.eventAt(0).elementId() == "albums");
	assert(deepScroll.eventAt(0).scroll().y() == 21924);
	NativeUiVirtualGridViewport deepGeometry = deepScroll.eventAt(0).virtualGridViewport();
	assert(deepGeometry.gridId() == "albums");
	assert(deepGeometry.contentOffsetY() == 38);
	assert(deepGeometry.contentLocalScrollY() == 21886);
	assert(deepGeometry.columns() == 4);
	assert(deepGeometry.rowHeight() == 40);
	assert(deepGeometry.rowPitch() == 44);
	assert(deepGeometry.firstVisibleDataIndex() == 1988);
	assert(deepGeometry.visibleDataCount() == 12);
	NativeUiLayoutBox item1990 = deepScroll.frame.boxFor("album:1990");
	assert(item1990.bounds.y == 21906);
	NativeUiLayoutBox item1999 = deepScroll.frame.boxFor("album:1999");
	assert(item1999.bounds.y == 21994);

	NativeUiEventBatch hovered = renderer.pointerMoved(245, 80);
	assert(hovered.eventCount() == 1);
	assert(hovered.eventAt(0).kind() == NATIVE_UI_HOVER_ENTERED);
	assert(hovered.eventAt(0).elementId() == "album:1999");
	NativeUiEventBatch pressed = renderer.pointerPressed(245, 80);
	assert(pressed.eventCount() == 0);
	NativeUiEventBatch clicked = renderer.pointerReleased(245, 80);
	assert(clicked.eventCount() == 1);
	assert(clicked.eventAt(0).kind() == NATIVE_UI_CLICKED);
	assert(clicked.eventAt(0).elementId() == "album:1999");
	renderer.pointerPressed(245, 80);
	renderer.pointerCancelled();
	assert(renderer.pointerReleased(245, 80).eventCount() == 0);
	NativeUiEventBatch resized = renderer.viewportChanged(320, 160);
	assert(resized.eventCount() >= 1);
	assert(resized.eventAt(0).kind() == NATIVE_UI_VIEWPORT_CHANGED);
	assert(resized.eventAt(0).elementId() == "albums");
	assert(resized.frame.viewport.width() == 320);
	assert(resized.frame.viewport.height() == 160);
	assert(resized.frame.viewport.scrollY() == 21884);
	NativeUiVirtualGridViewport resizedGeometry = resized.eventAt(0).virtualGridViewport();
	assert(resizedGeometry.gridId() == "albums");
	assert(resizedGeometry.contentLocalScrollY() == 21846);
	assert(resizedGeometry.firstVisibleDataIndex() == 1984);
	assert(resizedGeometry.visibleDataCount() == 16);

	NativeUiElement firstGrid = NativeUiElement.virtualGrid("first-grid", NativeUiVirtualGrid(1, 1, 40, 0)).child(NativeUiElement.text("first-item", "first"));
	NativeUiElement secondGrid = NativeUiElement.virtualGrid("second-grid", NativeUiVirtualGrid(1, 1, 40, 0)).child(NativeUiElement.text("second-item", "second"));
	NativeUiFrame multiple = NativeUiRenderer().render(NativeUiElement.column("multiple").child(firstGrid).child(secondGrid), 160, 180);
	assert(multiple.ok());
	assert(multiple.virtualGridCount() == 2);
	assert(multiple.scrollOwnerId(-1, -1) == "first-grid");
	assert(multiple.scrollOwnerId(20, 100) == "second-grid");

	NativeUiElement duplicate = NativeUiElement.column("root").child(NativeUiElement.text("same", "one")).child(NativeUiElement.text("same", "two"));
	assertRejected(NativeUiRenderer().render(duplicate, 80, 80), NATIVE_UI_FRAME_INVALID_TREE);

	NativeUiElement shared = NativeUiElement.text("shared", "shared");
	NativeUiElement sharedTree = NativeUiElement.column("shared-root").child(shared).child(shared);
	assertRejected(NativeUiRenderer().render(sharedTree, 80, 80), NATIVE_UI_FRAME_INVALID_TREE);

	NativeUiElement cycle = NativeUiElement.column("cycle");
	cycle.child(cycle);
	assertRejected(NativeUiRenderer().render(cycle, 80, 80), NATIVE_UI_FRAME_INVALID_TREE);

	NativeUiElement badStyle = NativeUiElement.text("bad-style", "bad").style("position: fixed");
	NativeUiFrame badStyleFrame = NativeUiRenderer().render(badStyle, 80, 80);
	assertRejected(badStyleFrame, NATIVE_UI_FRAME_INVALID_STYLE);
	assert(badStyleFrame.styleIssue.code() == NATIVE_UI_STYLE_UNSUPPORTED_PROPERTY);

	NativeUiElement badClass = NativeUiElement.text("bad-class", "bad").className("two classes");
	assertRejected(NativeUiRenderer().render(badClass, 80, 80), NATIVE_UI_FRAME_INVALID_STYLE);

	NativeUiStyleSheet badSheet = NativeUiStyleSheet().rule("bad", "display: block");
	assertRejected(NativeUiRenderer.styled(badSheet).render(NativeUiElement.text("sheet", "bad"), 80, 80), NATIVE_UI_FRAME_INVALID_STYLE);

	assertRejected(NativeUiRenderer().render(NativeUiElement.text("viewport", "bad"), 0, 80), NATIVE_UI_FRAME_INVALID_VIEWPORT);

	assertRejected(NativeUiRenderer().render(NativeUiElement.textInput("bad-utf8", "\xc3", "", 8), 80, 80), NATIVE_UI_FRAME_INVALID_TREE);
	assertRejected(NativeUiRenderer().render(NativeUiElement.text("bad-content-utf8", "\xc3"), 80, 80), NATIVE_UI_FRAME_INVALID_TREE);
	assertRejected(NativeUiRenderer().render(NativeUiElement.textInput("bad-bound", "four", "", 3), 80, 80), NATIVE_UI_FRAME_INVALID_TREE);
	assertRejected(NativeUiRenderer().render(NativeUiElement.textInput("bad-max", "", "", 0), 80, 80), NATIVE_UI_FRAME_INVALID_TREE);
	assertRejected(NativeUiRenderer().render(NativeUiElement.textInput("bad-placeholder", "", "\xc3", 8), 80, 80), NATIVE_UI_FRAME_INVALID_TREE);
	assertRejected(NativeUiRenderer().render(NativeUiElement.textInput("too-large-max", "", "", 4097), 80, 80), NATIVE_UI_FRAME_INVALID_TREE);
	assertRejected(NativeUiRenderer().render(NativeUiElement.text("invalid-range", "bad").semanticRange(NativeUiSemanticRange.horizontal("", 0LL, 1LL, 0LL)), 80, 80), NATIVE_UI_FRAME_INVALID_TREE);
	assertRejected(NativeUiRenderer().render(NativeUiElement.text("invalid-range-label", "bad").semanticRange(NativeUiSemanticRange.horizontal("\xc3", 0LL, 1LL, 0LL)), 80, 80), NATIVE_UI_FRAME_INVALID_TREE);

	Image tooWide = Image(4097, 1);
	assertRejected(NativeUiRenderer().render(NativeUiElement.image("too-wide", tooWide, "oversized"), 80, 80), NATIVE_UI_FRAME_LIMIT_EXCEEDED);

	NativeUiElement invalidPool = NativeUiElement.virtualGrid("invalid-pool", NativeUiVirtualGrid(2, 1, 40, 2)).child(NativeUiElement.text("past-end", "bad"));
	assertRejected(NativeUiRenderer().render(invalidPool, 80, 80), NATIVE_UI_FRAME_INVALID_TREE);

	NativeUiElement deep = NativeUiElement.column("depth:0");
	NativeUiElement cursor = deep;
	for (int index = 1; index <= 66; index++) {
		NativeUiElement child = NativeUiElement.column(f"depth:{index}");
		cursor.child(child);
		cursor = child;
	}
	assertRejected(NativeUiRenderer().render(deep, 80, 80), NATIVE_UI_FRAME_LIMIT_EXCEEDED);

	print("PASS: native UI layout, virtual scroll, and input");
	return 0;
}
