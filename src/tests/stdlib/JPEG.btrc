import Library.Bytes;
import Library.Image.JPEG;
import Library.Math;
import Library.Testing;
import Library.Vector;

Bytes oriented(Bytes bytes, int orientation) {
	var prefix = Bytes.fromHex("ffd8ffe1002245786966000049492a000800000001001201030001000000");
	if (prefix == null) { throw "Bad test fixture"; }
	prefix.appendU16LE(orientation);
	prefix.appendU16LE(0);
	prefix.appendU32LE(0);
	prefix.appendBytes(bytes.slice(2, bytes.length));
	return prefix;
}

bool rejects(Bytes bytes, int maxPixels = 64000000) {
	try { JPEG.decode(bytes, maxPixels); return false; }
	catch (string error) { return true; }
}

// An independent progressive grayscale stream with AC refinement and restart markers.
void progressiveJPEG() {
	var encoded = Bytes.fromHex("");
	if (encoded == null) { throw "Bad progressive fixture"; }
	var image = JPEG.decode(encoded);
	Expect.intEq(image.width, 23);
	Expect.intEq(image.height, 13);
	Expect.isTrue(Math.abs(image.pixel(1, 1).red - 19) <= 1);
	Expect.isTrue(Math.abs(image.pixel(13, 6).red - 169) <= 1);
	Expect.isTrue(Math.abs(image.pixel(21, 12).red - 46) <= 1);
}

// Lossless predictor 7, one low bit discarded, with a restart at each row.
void losslessJPEG() {
	var bytes = Bytes.fromHex("ffd8ffee000e41646f626500640000000000ffc30011080003000403521100471100421100ffc4001800010101010100000000000000000000000507040603ffdd00040004ffda000c035200470042000700019ff1e03cfbcfbcfbcfbdffd01737bbef3ef3f1d8f475ff00ffd1daef5cf3f1d8f475f79f7bffd9");
	if (bytes == null) { throw "Bad lossless JPEG fixture"; }
	var image = JPEG.decode(bytes);
	Expect.isTrue(image.width == 4 && image.height == 3);
	for (int y = 0; y < 3; y++) {
		for (int x = 0; x < 4; x++) {
			var base = x * 61 + y * 77;
			var pixel = image.pixel(x, y);
			Expect.isTrue(pixel.red == (base & 254) && pixel.green == ((base + 33) & 254) && pixel.blue == ((base + 66) & 254) && pixel.alpha == 255);
		}
	}
}

// Integer inverse transform and centered 4:2:0 chroma expansion, including
// an odd-sized final row and column. Pixels are from TurboJPEG RGBA output.
void subsampledJPEG() {
	var encoded = Bytes.fromHex("");
	var expected = Bytes.fromHex("032f52ff30567bff5b76a1ffa09eb4fff8c7b6ff6c412eff111b34ff0b375aff40668aff728fb1ffaeadbfffe1b09fff6b4030ff2b354eff255176ff4d7493ff809fb4ffcccdd2ffebbaacff93675eff47516cff2b577eff6189a3ff94b6b8ffb4b7aeff7b4940ff46181aff48526dff446f99ff719aaeffa3c8b6ffc9cfb5ff7e4b48ff5b2b39ff5c6584ff");
	if (encoded == null || expected == null) { throw "Bad subsampled JPEG fixture"; }
	var image = JPEG.decode(encoded);
	Expect.isTrue(image.width == 7 && image.height == 5);
	Expect.isTrue(Bytes.fromRaw((char*)image.data, 140).equals(expected));

	// JFIF explicitly selects YCbCr even with component identifiers "RGB".
	for (int i = 2; i < encoded.length - 19; i++) {
		var marker = encoded.readU16BE(i);
		if (marker == 0xffc0) { encoded.set(i + 10, 82); encoded.set(i + 13, 71); encoded.set(i + 16, 66); }
		if (marker == 0xffda) { encoded.set(i + 5, 82); encoded.set(i + 7, 71); encoded.set(i + 9, 66); break; }
	}
	var jfif = JPEG.decode(encoded);
	Expect.isTrue(Bytes.fromRaw((char*)jfif.data, 140).equals(expected));
}

// The same 19x9 grayscale raster in the two arithmetic DCT modes, with a
// restart every two MCUs. Both streams use non-default DAC parameters.
void arithmeticJPEG() {
	var sequential = Bytes.fromHex("");
	var progressive = Bytes.fromHex("");
	if (sequential == null || progressive == null) { throw "Bad arithmetic JPEG fixture"; }
	var image = JPEG.decode(sequential);
	Expect.isTrue(image.diff(JPEG.decode(progressive)).exact());
	Expect.intEq(image.width, 19);
	Expect.intEq(image.height, 9);
	Expect.isTrue(Math.abs(image.pixel(0, 0).red - 3) <= 1);
	Expect.isTrue(Math.abs(image.pixel(1, 5).red - 162) <= 1);
	Expect.isTrue(Math.abs(image.pixel(12, 7).red - 124) <= 1);
	Expect.isTrue(Math.abs(image.pixel(18, 8).red - 145) <= 1);

	// An invalid DC conditioning range (lower bound 15, upper bound 0).
	for (int i = 0; i < sequential.length - 5; i++) {
		if (sequential.get(i) == 255 && sequential.get(i + 1) == 204) {
			sequential.set(i + 5, 15);
			Expect.isTrue(rejects(sequential));
			return;
		}
	}
	throw "Missing DAC fixture";
}

int main() {
	arithmeticJPEG();
	subsampledJPEG();
	losslessJPEG();
	progressiveJPEG();
	var image = Image(32, 16);
	for (int y = 0; y < image.height; y++) {
		for (int x = 0; x < image.width; x++) {
			var level = 32 + (x / 16) * 64 + (y / 8) * 128;
			image.setRGBA(x, y, level, level, level);
		}
	}
	var source = JPEG.encode(image, 95);
	// Corners in display order, for TIFF orientations one through eight.
	Vector<int> corners = [0,1,2,3, 1,0,3,2, 3,2,1,0, 2,3,0,1, 0,2,1,3, 2,0,3,1, 3,1,2,0, 1,3,0,2];
	for (int o = 1; o <= 8; o++) {
		var preview = JPEGPhoto(oriented(source, o)).thumbnail(16, 16, 95);
		var header = JPEGHeader.inspect(preview);
		Expect.intEq(header.orientation, 1);
		Expect.intEq(header.width, o >= 5 ? 8 : 16);
		Expect.intEq(header.height, o >= 5 ? 16 : 8);
		var decoded = JPEG.decode(preview);
		for (int i = 0; i < 4; i++) {
			var value = decoded.pixel((1 + 2 * (i % 2)) * decoded.width / 4, (1 + 2 * (i / 2)) * decoded.height / 4).red;
			var delta = value - (32 + corners.get((o - 1) * 4 + i) * 64);
			Expect.isTrue(delta >= -4 && delta <= 4, "EXIF did not move a corner correctly");
		}
	}
	var originalSize = JPEGHeader.inspect(JPEGPhoto(source).thumbnail(100, 100));
	Expect.intEq(originalSize.width, 32);
	Expect.intEq(originalSize.height, 16);
	Expect.isTrue(rejects(source, 511));
	Expect.isTrue(rejects(source.slice(0, source.length - 2)));
	print("PASS JPEG");
	return 0;
}
