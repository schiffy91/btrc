import Library.Bytes;
import Library.Image.JPEG;
import Library.Math;
import Library.Testing;
import Library.Vector;

Bytes oriented(Bytes bytes, int orientation) {
	var prefix = Bytes.fromHex("ffd8ffe1002245786966000049492a000800000001001201030001000000");
	if (prefix == null) { throw "Bad test fixture"; }
	prefix.appendU16LE(orientation);
	prefix.appendU16LE(0);
	prefix.appendU32LE(0);
	prefix.appendBytes(bytes.slice(2, bytes.length));
	return prefix;
}

bool rejects(Bytes bytes, int maxPixels = 64000000) {
	try { JPEG.decode(bytes, maxPixels); return false; }
	catch (string error) { return true; }
}

// An independent progressive grayscale stream with AC refinement and restart markers.
void progressiveJPEG() {
	var encoded = Bytes.fromHex("");
	if (encoded == null) { throw "Bad progressive fixture"; }
	var image = JPEG.decode(encoded);
	Expect.intEq(image.width, 23);
	Expect.intEq(image.height, 13);
	Expect.isTrue(Math.abs(image.pixel(1, 1).red - 19) <= 1);
	Expect.isTrue(Math.abs(image.pixel(13, 6).red - 169) <= 1);
	Expect.isTrue(Math.abs(image.pixel(21, 12).red - 46) <= 1);
}

int main() {
	progressiveJPEG();
	var image = Image(32, 16);
	for (int y = 0; y < image.height; y++) {
		for (int x = 0; x < image.width; x++) {
			var level = 32 + (x / 16) * 64 + (y / 8) * 128;
			image.setRGBA(x, y, level, level, level);
		}
	}
	var source = JPEG.encode(image, 95);
	// Corners in display order, for TIFF orientations one through eight.
	Vector<int> corners = [0,1,2,3, 1,0,3,2, 3,2,1,0, 2,3,0,1, 0,2,1,3, 2,0,3,1, 3,1,2,0, 1,3,0,2];
	for (int o = 1; o <= 8; o++) {
		var preview = JPEGPhoto(oriented(source, o)).thumbnail(16, 16, 95);
		var header = JPEGHeader.inspect(preview);
		Expect.intEq(header.orientation, 1);
		Expect.intEq(header.width, o >= 5 ? 8 : 16);
		Expect.intEq(header.height, o >= 5 ? 16 : 8);
		var decoded = JPEG.decode(preview);
		for (int i = 0; i < 4; i++) {
			var value = decoded.pixel((1 + 2 * (i % 2)) * decoded.width / 4, (1 + 2 * (i / 2)) * decoded.height / 4).red;
			var delta = value - (32 + corners.get((o - 1) * 4 + i) * 64);
			Expect.isTrue(delta >= -4 && delta <= 4, "EXIF did not move a corner correctly");
		}
	}
	var originalSize = JPEGHeader.inspect(JPEGPhoto(source).thumbnail(100, 100));
	Expect.intEq(originalSize.width, 32);
	Expect.intEq(originalSize.height, 16);
	Expect.isTrue(rejects(source, 511));
	Expect.isTrue(rejects(source.slice(0, source.length - 2)));
	print("PASS JPEG");
	return 0;
}
