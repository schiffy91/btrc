/* Image file loads fail closed on open, read, decode, and close errors. */
import std.image;
import std.fs;

#include <assert.h>

#define fclose(stream) imageIoTestCloseResult(fclose(stream))

int imageIoCloseCalls = 0;
int imageIoFailNextClose = 0;

int imageIoTestCloseResult(int status) {
    imageIoCloseCalls++;
    if (status == 0 && imageIoFailNextClose != 0) {
        imageIoFailNextClose = 0;
        return EOF;
    }
    return status;
}

int main() {
    string dir = FileSystem.tempDir("btrc_image_io_failures");
    assert(FileSystem.isDir(dir));

    Image source = Image(1, 1);
    source.setRGBA(0, 0, 10, 20, 30, 40);
    string ppmPath = PathTools.join(dir, "valid.ppm");
    string bmpPath = PathTools.join(dir, "valid.bmp");
    assert(ImageIO.savePpm(source, ppmPath));
    assert(ImageIO.saveBmp(source, bmpPath));

    /* fopen accepts directories on POSIX, but fread reports an I/O error.
     * The partial/empty buffer must never be handed to a decoder. */
    ImageLoad autoReadFailure = ImageIO.load(dir);
    assert(!autoReadFailure.ok());
    assert(autoReadFailure.error.equals(f"cannot read image: {dir}"));
    ImageLoad ppmReadFailure = ImageIO.loadPpm(dir);
    assert(!ppmReadFailure.ok());
    assert(ppmReadFailure.error.equals(f"cannot read PPM: {dir}"));
    ImageLoad bmpReadFailure = ImageIO.loadBmp(dir);
    assert(!bmpReadFailure.ok());
    assert(bmpReadFailure.error.equals(f"cannot read BMP: {dir}"));

    Bytes ppm = ImageIO.encodePpm(source);
    string truncatedPath = PathTools.join(dir, "truncated.ppm");
    File truncatedFile = File(truncatedPath, "wb");
    assert(truncatedFile.ok());
    assert(truncatedFile.writeBytes(ppm.slice(0, ppm.length() - 1)));
    assert(truncatedFile.close());
    ImageLoad truncated = ImageIO.loadPpm(truncatedPath);
    assert(!truncated.ok());
    assert(truncated.error.equals("PPM raster is truncated"));

    int closesBefore = imageIoCloseCalls;
    imageIoFailNextClose = 1;
    ImageLoad autoCloseFailure = ImageIO.load(ppmPath);
    assert(!autoCloseFailure.ok());
    assert(autoCloseFailure.error.equals(f"cannot close image: {ppmPath}"));
    assert(imageIoFailNextClose == 0);
    assert(imageIoCloseCalls == closesBefore + 1);

    closesBefore = imageIoCloseCalls;
    imageIoFailNextClose = 1;
    ImageLoad ppmCloseFailure = ImageIO.loadPpm(ppmPath);
    assert(!ppmCloseFailure.ok());
    assert(ppmCloseFailure.error.equals(f"cannot close PPM: {ppmPath}"));
    assert(imageIoFailNextClose == 0);
    assert(imageIoCloseCalls == closesBefore + 1);

    closesBefore = imageIoCloseCalls;
    imageIoFailNextClose = 1;
    ImageLoad bmpCloseFailure = ImageIO.loadBmp(bmpPath);
    assert(!bmpCloseFailure.ok());
    assert(bmpCloseFailure.error.equals(f"cannot close BMP: {bmpPath}"));
    assert(imageIoFailNextClose == 0);
    assert(imageIoCloseCalls == closesBefore + 1);

    FileSystem.removeRecursive(dir);
    print("PASS: test_stdlib_image_io_failures");
    return 0;
}
