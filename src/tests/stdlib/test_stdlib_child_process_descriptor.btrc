import std.FileSystem;
import std.process;
import std.strings;
import std.vector;

#include <assert.h>

int childProbe(int argc, char** argv) {
    if (argc != 3 || !Strings.copy(argv[1]).equals("--leased-child")) {
        return 64;
    }
    int unrelatedDescriptor = atoi(argv[2]);
    errno = 0;
    if (fcntl(unrelatedDescriptor, F_GETFD, 0) >= 0 || errno != EBADF) {
        fputs("leaked", stdout);
        return 9;
    }
    fputs("leased", stdout);
    return 0;
}

int main(int argc, char** argv) {
    if (argc > 1) { return childProbe(argc, argv); }

    string root = FileSystem.tempDir("btrc descriptor executable");
    assert(!root.isEmpty());
    string replacement = PathTools.join(root, "replacement executable");
    assert(FileSystem.writeText(
        replacement, "#!/bin/sh\nprintf replacement\n"));
    assert(FileSystem.chmod(replacement, 0700) == 0);

    int leasedDescriptor = open(argv[0], (int)O_RDONLY | (int)O_CLOEXEC);
    assert(leasedDescriptor >= 3);
    int scriptDescriptor = open(
        replacement, (int)O_RDONLY | (int)O_CLOEXEC);
    assert(scriptDescriptor >= 3);

    FILE* unrelated = tmpfile();
    assert(unrelated != NULL);
    int unrelatedDescriptor = fcntl(fileno(unrelated), F_DUPFD, 200);
    assert(unrelatedDescriptor >= 200);
    int unrelatedFlags = fcntl(unrelatedDescriptor, F_GETFD, 0);
    assert(unrelatedFlags >= 0);
    assert(fcntl(unrelatedDescriptor, F_SETFD,
        unrelatedFlags & ~FD_CLOEXEC) == 0);

    ExecResult result = ChildProcess.run(
        replacement,
        ["--leased-child", Strings.fromInt(unrelatedDescriptor)],
        executableDescriptor=leasedDescriptor,
        timeoutMilliseconds=2000);

    if (FileSystem.exists("/proc/self/exe")) {
        assert(result.ok());
        assert(result.stdout().equals("leased"));
        assert(!result.stdout().contains("replacement"));

        Vector<string> noArguments = [];
        ExecResult script = ChildProcess.run(
            replacement,
            noArguments,
            executableDescriptor=scriptDescriptor,
            timeoutMilliseconds=2000);
        assert(!script.ok());
        assert(!script.stdout().contains("replacement"));
    } else {
        assert(!result.ok());
        assert(result.stderr().contains(
            "executable descriptor is invalid or unsupported"));
    }

    assert(close(unrelatedDescriptor) == 0);
    assert(fclose(unrelated) == 0);
    assert(close(scriptDescriptor) == 0);
    assert(close(leasedDescriptor) == 0);
    assert(FileSystem.removeRecursive(root) == 0);
    print("PASS: test_stdlib_child_process_descriptor");
    return 0;
}
