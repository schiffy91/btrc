#include <assert.h>
#include <errno.h>
#include <poll.h>
#include <sys/wait.h>
#include <termios.h>
#include <unistd.h>

bool childWriteAll(string value) {
    size_t offset = 0;
    size_t length = strlen(value);
    while (offset < length) {
        ssize_t count = write(
            STDOUT_FILENO, (char*)value + offset, length - offset);
        if (count > (ssize_t)0) {
            offset += (size_t)count;
        } else if (count < (ssize_t)0 && errno == EINTR) {
            continue;
        } else {
            return false;
        }
    }
    return true;
}

bool childReadLineEquals(string expected) {
    char value[128];
    int length = 0;
    while (length < 128) {
        char byte = 0;
        ssize_t count = read(STDIN_FILENO, &byte, (size_t)1);
        if (count < (ssize_t)0 && errno == EINTR) { continue; }
        if (count != (ssize_t)1) { return false; }
        if (byte == '\n') { break; }
        value[length] = byte;
        length++;
    }
    return length == expected.len()
        && memcmp(value, (char*)expected, (size_t)length) == 0;
}

bool childSetEcho(bool enabled) {
    struct termios attributes;
    if (tcgetattr(STDIN_FILENO, &attributes) != 0) { return false; }
    if (enabled) {
        attributes.c_lflag = attributes.c_lflag | ECHO;
    } else {
        attributes.c_lflag = attributes.c_lflag & ~ECHO;
    }
    return tcsetattr(STDIN_FILENO, TCSANOW, &attributes) == 0;
}

int main() {
    /* A real forkpty child with hidden input drives the exact production
     * classifier, quiescence, tcgetattr gate, and response writer twice. */
    int hiddenMaster = -1;
    pid_t hiddenChild = forkpty(&hiddenMaster, NULL, NULL, NULL);
    assert(hiddenChild >= (pid_t)0);
    if (hiddenChild == (pid_t)0) {
        bool okay = childSetEcho(false)
            && childWriteAll("New password: ")
            && childReadLineEquals("first-secret")
            && childWriteAll("Retype new password: ")
            && childReadLineEquals("second-secret");
        _exit(okay ? 0 : 1);
    }
    assert(UnixPamPassword.configureMaster(hiddenMaster));
    char* hiddenResponses[3];
    hiddenResponses[0] = (char*)"first-secret";
    hiddenResponses[1] = (char*)"second-secret";
    hiddenResponses[2] = NULL;
    long long hiddenDeadline = TerminalClock.deadlineAfter(4000);
    assert(UnixPamPassword.answerPasswordPrompts(
        hiddenMaster, hiddenResponses, 2, hiddenDeadline));
    int hiddenStatus = UnixPamPassword.waitForPtyExitUntil(
        hiddenChild, hiddenMaster, hiddenDeadline);
    close(hiddenMaster);
    assert(hiddenStatus >= 0 && WIFEXITED(hiddenStatus)
        && WEXITSTATUS(hiddenStatus) == 0);

    /* A prompt-shaped diagnostic cannot receive a secret while ECHO is on.
     * Its suffix deliberately arrives after the bounded quiet interval, which
     * demonstrates why the independent terminal-state gate is mandatory. */
    int echoMaster = -1;
    pid_t echoChild = forkpty(&echoMaster, NULL, NULL, NULL);
    assert(echoChild >= (pid_t)0);
    if (echoChild == (pid_t)0) {
        bool okay = childSetEcho(true)
            && childWriteAll("New password:");
        poll(NULL, 0,
            UnixPasswdPromptExchange.quietIntervalMilliseconds() + 150);
        okay = okay && childWriteAll(" policy diagnostic\r\n");
        struct pollfd input;
        input.fd = STDIN_FILENO;
        input.events = POLLIN;
        input.revents = 0;
        int ready = poll(&input, (nfds_t)1, 500);
        _exit(okay && ready == 0 ? 0 : 1);
    }
    assert(UnixPamPassword.configureMaster(echoMaster));
    char* echoResponses[3];
    echoResponses[0] = (char*)"must-not-send";
    echoResponses[1] = (char*)"must-not-send";
    echoResponses[2] = NULL;
    long long echoDeadline = TerminalClock.deadlineAfter(3000);
    assert(!UnixPamPassword.answerPasswordPrompts(
        echoMaster, echoResponses, 2, echoDeadline));
    int echoStatus = UnixPamPassword.waitForPtyExitUntil(
        echoChild, echoMaster, echoDeadline);
    close(echoMaster);
    assert(echoStatus >= 0 && WIFEXITED(echoStatus)
        && WEXITSTATUS(echoStatus) == 0);

    int ordinaryPipe[2];
    assert(pipe(ordinaryPipe) == 0);
    assert(!UnixPamPassword.passwordInputHidden(ordinaryPipe[0]));
    close(ordinaryPipe[0]);
    close(ordinaryPipe[1]);

    print("PASS: test_stdlib_terminal_password_exchange");
    return 0;
}
