/* An error-object class hierarchy used polymorphically: store distinct
 * subclasses in a Vector<Failure>, then iterate and read the per-subclass `code`
 * field plus the inherited toString() in a loop. */
import Library.Vector;

#include <assert.h>

class Failure {
	public string message;
	public int code;

	public Failure(string message, int code) {
		self.message = message;
		self.code = code;
	}

	public string toString() { return self.message; }
}

class ValueFailure extends Failure {
	public ValueFailure(string message) {
		self.message = message;
		self.code = 1;
	}
}

class IOFailure extends Failure {
	public IOFailure(string message) {
		self.message = message;
		self.code = 2;
	}
}

class KeyFailure extends Failure {
	public KeyFailure(string message) {
		self.message = message;
		self.code = 5;
	}
}

int main() {
	Vector<Failure> errs = [];
	errs.push(new ValueFailure("v"));   // code 1
	errs.push(new IOFailure("i"));      // code 2
	errs.push(new KeyFailure("k"));     // code 5
	assert(errs.len == 3);

	int sumCodes = 0;
	string joined = "";
	for e in errs {
		sumCodes = sumCodes + e.code;
		joined = joined + e.toString();
	}
	assert(sumCodes == 1 + 2 + 5);
	assert(joined.equals("vik"));

	// Indexed access dispatches the same way.
	assert(errs[0].code == 1);
	assert(errs[1].code == 2);
	assert(errs[2].code == 5);
	assert(errs[1].toString().equals("i"));

	print("PASS: test_exceptions_error_polymorphism");
	return 0;
}
