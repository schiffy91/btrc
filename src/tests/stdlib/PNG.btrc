import Library.Image.PNG;
import Library.Testing;

// The fixtures were written with Python's zlib and struct, one per case. A
// decodable fixture carries its size and the FNV-1a fingerprint of the RGBA
// raster the PNG specification gives it, computed from the source samples.

Bytes fixture(string hex) {
	var bytes = Bytes.fromHex(hex);
	if (bytes == null) { throw "Bad PNG test fixture"; }
	return bytes;
}

string outline(Image image) {
	unsigned int hash = 2166136261u;
	for (int i = 0; i < image.width * image.height * 4; i++) { hash = (hash ^ (unsigned int)image.data[i]) * 16777619u; }
	var digest = Bytes();
	digest.appendU32BE(hash);
	return f"{image.width}x{image.height}:{digest.toHex()}";
}

void decodes(string name, string expected, string hex) { Expect.strEq(outline(PNG.decode(fixture(hex))), expected, name); }

string refusal(Bytes bytes, int maxPixels = 64000000) {
	try { PNG.decode(bytes, maxPixels); }
	catch (string error) { return error; }
	return "";
}

void refuses(string name, string hex) { Expect.isFalse(refusal(fixture(hex)).isEmpty(), name); }

