/* Environment.has(name) and Environment.get fallback semantics: a set-but-EMPTY
 * variable is treated as absent (both has() and get() fall back). Uses setenv to
 * stay hermetic — no dependence on the ambient environment. */
import std.platform;

#include <assert.h>
#include <stdlib.h>

int main() {
    // A set, non-empty variable: has() true, get() returns the value.
    setenv("BTRC_TEST_X", "val", 1);
    assert(Environment.has("BTRC_TEST_X"));
    assert(Environment.get("BTRC_TEST_X", "fallback").equals("val"));

    // A set-but-EMPTY variable is treated as absent.
    setenv("BTRC_TEST_E", "", 1);
    assert(!Environment.has("BTRC_TEST_E"));
    assert(Environment.get("BTRC_TEST_E", "fb").equals("fb"));

    // A genuinely unset variable: has() false, get() returns the fallback.
    unsetenv("BTRC_TEST_MISSING");
    assert(!Environment.has("BTRC_TEST_MISSING"));
    assert(Environment.get("BTRC_TEST_MISSING", "default").equals("default"));

    // Overwriting flips has() back on.
    setenv("BTRC_TEST_E", "now", 1);
    assert(Environment.has("BTRC_TEST_E"));
    assert(Environment.get("BTRC_TEST_E", "fb").equals("now"));

    print("PASS: test_stdlib_environment");
    return 0;
}
