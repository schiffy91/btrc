/* Append mode ("a") appends to existing content instead of truncating it, and
 * creates the file if it does not yet exist. The line-oriented File test only
 * covers writeLine within one open session; nothing else verifies that
 * reopening a file in "a" mode preserves prior bytes. File()'s ctor passes the
 * mode straight to fopen, so fopen(path, "a") is standard C.
 * Hermetic: one temp dir, removed at the end. */
#include <assert.h>

int main() {
    string dir = FileSystem.tempDir("btrc_file_append");
    assert(FileSystem.isDir(dir));

    // --- Append preserves existing content ---
    string path = PathTools.join(dir, "log.txt");
    assert(Path.writeAll(path, "line1\n"));

    File f = File(path, "a");
    assert(f.ok());
    assert(f.write("line2\n"));     // raw write, no extra newline
    assert(f.writeLine("line3"));   // adds the trailing newline
    f.close();

    // line1 must still be there: append did not truncate it.
    string back = Path.readAll(path);
    assert(back.equals("line1\nline2\nline3\n"));

    // --- Append to a NON-existent path creates it ---
    string fresh = PathTools.join(dir, "fresh.txt");
    assert(!FileSystem.exists(fresh));
    File g = File(fresh, "a");
    assert(g.ok());                 // "a" creates the file
    assert(g.write("created"));
    g.close();
    assert(FileSystem.exists(fresh));
    assert(Path.readAll(fresh).equals("created"));

    // --- A second append session continues to accumulate ---
    File h = File(fresh, "a");
    assert(h.ok());
    assert(h.write(" then more"));
    h.close();
    assert(Path.readAll(fresh).equals("created then more"));

    FileSystem.removeRecursive(dir);
    assert(!FileSystem.exists(dir));

    print("PASS: test_stdlib_file_append");
    return 0;
}
