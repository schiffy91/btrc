/* JSON file I/O round-trip: JSONValue.document written with Path.writeAll,
 * then read back through JSONValue.readFile. All other json tests parse from
 * in-memory strings. Hermetic: a fresh temp dir, removed at the end. */
import Library.FileSystem;
import Library.IO;
import Library.JSON;

#include <assert.h>

int main() {
	string dir = FileSystem.tempDir("btrc_jsonf");
	assert(FileSystem.isDir(dir));
	string path = PathTools.join(dir, "o.json");

	/* Build an object and write it to disk. */
	JSONValue o = JSONValue.makeObject();
	o.set("n", JSONValue.makeInt(42));
	o.set("s", JSONValue.makeString("hi"));
	assert(Path.writeAll(path, o.document()));
	assert(FileSystem.isFile(path));
	assert(Path.readAll(path).equals("{\n  \"n\": 42,\n  \"s\": \"hi\"\n}\n"));

	/* Read it back through the recursive JSONValue parser. */
	JSONValue r = JSONValue.readFile(path);
	assert(r.isObject());
	assert(r.get("n").asInt() == 42);
	assert(r.get("s").asString().equals("hi"));

	FileSystem.removeRecursive(dir);
	assert(!FileSystem.exists(dir));

	print("PASS: test_stdlib_json_file_roundtrip");
	return 0;
}
