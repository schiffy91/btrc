/* HttpServer parse edges not covered by test_http_util:
 *   queryParams: duplicate key "later wins", '+' -> space in a value.
 *   parse headers: value containing ':' kept whole (split on FIRST colon only),
 *                  empty header value, duplicate header (later wins in the map),
 *                  header name lower-cased for lookup. */
#include <assert.h>

int main() {
    HttpServer srv = HttpServer(0);

    // --- queryParams duplicate key + '+' decoding ---
    HttpRequest q = srv.parse("GET /s?a=1&a=2&b=x+y&flag HTTP/1.1\r\nHost: h\r\n\r\n");
    Map<string, string> params = q.queryParams();
    assert(params.get("a").equals("2"));     // later duplicate wins
    assert(params.get("b").equals("x y"));   // '+' decodes to space
    assert(params.get("flag").equals(""));   // bare key -> ""

    // --- header value containing ':' (split on first colon only) ---
    string raw =
        "GET / HTTP/1.1\r\n" +
        "Host: example.com\r\n" +
        "Date: Mon, 01 Jan 2024 00:00:00 GMT\r\n" +
        "X-Empty:\r\n" +
        "X-Dup: first\r\n" +
        "X-Dup: second\r\n" +
        "\r\n";
    HttpRequest req = srv.parse(raw);

    // The value past the first colon is kept intact, including its own colons.
    assert(req.header("date").equals("Mon, 01 Jan 2024 00:00:00 GMT"));
    // Header lookup is case-insensitive (names lower-cased on store).
    assert(req.header("DATE").contains("GMT"));
    assert(req.header("Host").equals("example.com"));

    // An empty header value maps to "".
    assert(req.header("x-empty").equals(""));

    // Duplicate header: the later value wins in the map.
    assert(req.header("x-dup").equals("second"));

    // A header that was never sent returns "".
    assert(req.header("authorization").equals(""));

    print("PASS: test_stdlib_http_parse_edges");
    return 0;
}
