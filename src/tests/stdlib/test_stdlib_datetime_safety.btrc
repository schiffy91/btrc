/* Date/time values fail closed before C narrowing or floating/integer UB. */
#include <assert.h>
#include <float.h>
#include <limits.h>
#include <math.h>

bool rejectsUnsupportedTimestamp(long long seconds) {
    try {
        DateTime.fromUnix(seconds);
    } catch (string error) {
        return error.contains("supported year range");
    }
    return false;
}

int main() {
    /* Keep mutable test state out of a setjmp scope: this fixture checks the
     * DateTime range guard, not C longjmp volatility. */
    assert(rejectsUnsupportedTimestamp(LLONG_MIN));
    assert(rejectsUnsupportedTimestamp(LLONG_MAX));

    /* These inputs previously reached an undefined floating-to-time_t cast.
     * Invalid/unportable sleep durations retain the no-op API contract. */
    Timer.sleep(NAN);
    Timer.sleep(INFINITY);
    Timer.sleep(DBL_MAX);

    Timer timer = Timer();
    timer.start();
    Timer.sleepMillis(1);
    timer.stop();
    assert(timer.elapsedMillis() >= 0.0f);

    print("PASS: test_stdlib_datetime_safety");
    return 0;
}
