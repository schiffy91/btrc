/* OpenSSL 3 known answers for RSASSA-PKCS1-v1_5 and RSASSA-PSS.
 * Negative PKCS1 and trailer vectors sign the malformed encoded message.
 * Every valid and invalid signature was independently checked with openssl dgst. */
import Library.Bytes;
import Library.Crypto.Primitives.RSA;
import Library.Testing;

class RSAVectors {
	class Bytes hex(string text) {
		Bytes? value = Bytes.fromHex(text);
		if (value == null) { throw "invalid RSA fixture"; }
		return value;
	}
}

int main() {
	Bytes message = Bytes.fromString("btrc RSA certificate signature verification");
	Bytes exponent = RSAVectors.hex("010001");
	Bytes three = RSAVectors.hex("03");
	Bytes n2048 = RSAVectors.hex("");
	Bytes n2049 = RSAVectors.hex("");
	Bytes n8192 = RSAVectors.hex("");
	/* PKCS1 SHA-256, 2048-bit modulus */
	Expect.isTrue(RSA.verify(0x0401, n2048, exponent, message, RSAVectors.hex("")));
	/* PSS SHA-256, 2048-bit modulus */
	Expect.isTrue(RSA.verify(0x0804, n2048, exponent, message, RSAVectors.hex("")));
	/* PKCS1 SHA-384, 2048-bit modulus */
	Expect.isTrue(RSA.verify(0x0501, n2048, exponent, message, RSAVectors.hex("")));
	/* PSS SHA-384, 2048-bit modulus */
	Expect.isTrue(RSA.verify(0x0805, n2048, exponent, message, RSAVectors.hex("")));
	/* PKCS1 SHA-512, 2048-bit modulus */
	Expect.isTrue(RSA.verify(0x0601, n2048, exponent, message, RSAVectors.hex("")));
	/* PSS SHA-512, 2048-bit modulus */
	Expect.isTrue(RSA.verify(0x0806, n2048, exponent, message, RSAVectors.hex("")));
	/* PSS SHA-256, 2049-bit modulus */
	Expect.isTrue(RSA.verify(0x0804, n2049, three, message, RSAVectors.hex("")));
	/* PSS SHA-512, 8192-bit modulus */
	Expect.isTrue(RSA.verify(0x0806, n8192, exponent, message, RSAVectors.hex("")));
	/* short padding */
	Expect.isFalse(RSA.verify(0x0401, n2048, exponent, message, RSAVectors.hex("")));
	/* wrong DigestInfo digest */
	Expect.isFalse(RSA.verify(0x0401, n2048, exponent, message, RSAVectors.hex("")));
	/* malformed DigestInfo parameters */
	Expect.isFalse(RSA.verify(0x0401, n2048, exponent, message, RSAVectors.hex("")));
	/* wrong PSS salt length */
	Expect.isFalse(RSA.verify(0x0804, n2048, exponent, message, RSAVectors.hex("")));
	/* wrong PSS trailer */
	Expect.isFalse(RSA.verify(0x0804, n2048, exponent, message, RSAVectors.hex("")));
	/* nonzero initial PSS padding octet */
	Expect.isFalse(RSA.verify(0x0804, n2048, exponent, message, RSAVectors.hex("")));
	/* signature representative exceeds modulus */
	Expect.isFalse(RSA.verify(0x0804, n2048, exponent, message, RSAVectors.hex("")));
	/* nonzero unused bit above the PSS encoded message */
	Expect.isFalse(RSA.verify(0x0804, n2048, exponent, message, RSAVectors.hex("")));
	/* nonzero unused bit above the PSS encoded message */
	Expect.isFalse(RSA.verify(0x0804, n2049, three, message, RSAVectors.hex("")));
	Bytes signature = RSAVectors.hex("");
	Bytes withSign = RSAVectors.hex("00");
	withSign.appendBytes(n2048);
	Expect.isTrue(RSA.verify(0x0401, withSign, exponent, message, signature));
	Expect.isFalse(RSA.verify(0x0401, n2048, exponent, message, n2048));
	Expect.isFalse(RSA.verify(0x0401, n2048, exponent, Bytes.zeros(0), signature));
	Expect.isFalse(RSA.verify(0x0201, n2048, exponent, message, signature));
	Expect.isFalse(RSA.verify(0x0401, n2048, RSAVectors.hex("01"), message, signature));
	Expect.isFalse(RSA.verify(0x0401, n2048, RSAVectors.hex("04"), message, signature));
	Expect.isFalse(RSA.verify(0x0401, n2048, n2048, message, signature));
	Expect.isFalse(RSA.verify(0x0401, Bytes.zeros(255), exponent, message, signature));
	Expect.isFalse(RSA.verify(0x0401, Bytes.zeros(1026), exponent, message, signature));
	Expect.isFalse(RSA.verify(0x0401, n2048, exponent, message, Bytes.zeros(255)));
	n2048.set(n2048.length() - 1, 0);
	Expect.isFalse(RSA.verify(0x0401, n2048, exponent, message, signature));
	print("PASS RSA signature verification");
	return 0;
}
