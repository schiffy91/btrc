/* Error class hierarchy used polymorphically: store distinct Error subclasses in
 * a Vector<Error>, then iterate and read the per-subclass `code` field plus the
 * inherited toString() in a loop. test_stdlib_error only does flat field access on
 * individually-typed locals; it never stores subclasses in a collection nor
 * dispatches over them. */
import std.error;
import std.vector;

#include <assert.h>

int main() {
	Vector<Error> errs = [];
	errs.push(new ValueError("v"));   // code 1
	errs.push(new IOError("i"));      // code 2
	errs.push(new KeyError("k"));     // code 5
	assert(errs.len == 3);

	int sumCodes = 0;
	string joined = "";
	for e in errs {
		sumCodes = sumCodes + e.code;
		joined = joined + e.toString();
	}
	assert(sumCodes == 1 + 2 + 5);
	assert(joined.equals("vik"));

	// Indexed access dispatches the same way.
	assert(errs[0].code == 1);
	assert(errs[1].code == 2);
	assert(errs[2].code == 5);
	assert(errs[1].toString().equals("i"));

	print("PASS: test_exceptions_error_polymorphism");
	return 0;
}
