/* Timer: the running-branch of elapsed()/elapsedMillis() (running ? monoNanos
 * : end_time), stop() freezing the value, and reset() returning both clocks to
 * zero so elapsed() reads exactly 0. Deterministic: no wall-clock assertions
 * beyond monotonicity (elapsed never decreases, never negative). */
import std.datetime;

#include <assert.h>
#include "../../stdlib/datetime.btrc"

int main() {
	Timer t = Timer();

	// Before start, reset state: both clocks 0 -> elapsed is exactly 0.
	assert(t.elapsed() == 0.0f);
	assert(t.elapsedMillis() == 0.0f);

	// While running, the running branch samples monoNanos(): non-negative and
	// millis is consistent with seconds (millis >= 0 too).
	t.start();
	float s1 = t.elapsed();
	float m1 = t.elapsedMillis();
	assert(s1 >= 0.0f);
	assert(m1 >= 0.0f);

	// Burn some monotonic time so a second sample is >= the first.
	int acc = 0;
	for i in range(200000) { acc = acc + (i % 7); }
	assert(acc >= 0);
	float s2 = t.elapsed();
	assert(s2 >= s1);

	// stop() freezes: the not-running branch uses end_time, so two reads match.
	t.stop();
	float fixedA = t.elapsed();
	float fixedB = t.elapsed();
	assert(fixedA == fixedB);
	assert(fixedA >= 0.0f);

	// reset() zeroes both clocks again.
	t.reset();
	assert(t.elapsed() == 0.0f);
	assert(t.elapsedMillis() == 0.0f);

	print("PASS: test_stdlib_timer_running");
	return 0;
}
