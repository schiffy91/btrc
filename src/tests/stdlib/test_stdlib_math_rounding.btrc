/* Math rounding methods: ceil/floor return float; round/truncate cast a
 * libc double result to int ((int)round(x), (int)trunc(x)). */
#include <assert.h>
#include "../../stdlib/math.btrc"

int main() {
    // ceil rounds up toward +inf
    assert(Math.fabs(Math.ceil(2.1f) - 3.0f) < 0.0001f);
    assert(Math.fabs(Math.ceil(2.0f) - 2.0f) < 0.0001f);
    assert(Math.fabs(Math.ceil(-2.1f) - (-2.0f)) < 0.0001f);

    // floor rounds down toward -inf
    assert(Math.fabs(Math.floor(2.9f) - 2.0f) < 0.0001f);
    assert(Math.fabs(Math.floor(2.0f) - 2.0f) < 0.0001f);
    assert(Math.fabs(Math.floor(-2.1f) - (-3.0f)) < 0.0001f);

    // round returns int (cast of libc round)
    assert(Math.round(2.4f) == 2);
    assert(Math.round(2.5f) == 3);
    assert(Math.round(2.6f) == 3);
    assert(Math.round(-2.5f) == -3);

    // truncate drops the fractional part toward zero
    assert(Math.truncate(2.9f) == 2);
    assert(Math.truncate(-2.9f) == -2);
    assert(Math.truncate(0.0f) == 0);

    print("PASS: test_stdlib_math_rounding");
    return 0;
}
