/* JSONValue trees stored inside a user Vector<JSONValue> local, where each tree
 * nests arrays-of-objects-of-arrays. Exercises ARC release of
 * Vector<JSONValue>-of-Vector<JSONValue> when the local vector goes out of scope
 * (recursive teardown, no leak / double-free). */
import Library.JSON;
import Library.Vector;

#include <assert.h>

int main() {
	// Hold several JSONValue trees in one vector.
	Vector<JSONValue> trees = [];

	for t in range(3) {
		JSONValue root = JSONValue.makeArray();
		for c in range(3) {
			JSONValue obj = JSONValue.makeObject();
			JSONValue inner = JSONValue.makeArray();
			inner.push(JSONValue.makeInt(c));
			inner.push(JSONValue.makeString(f"item{c}"));
			obj.set("children", inner);
			obj.set("index", JSONValue.makeInt(c));
			root.push(obj);
		}
		trees.push(root);
	}

	// Structure assertions: trees -> array(3) -> object{children: array(2), index}
	assert(trees.len == 3);
	for t in range(3) {
		JSONValue root = trees.get(t);
		assert(root.isArray());
		assert(root.size() == 3);
		JSONValue obj = root.at(1);
		assert(obj.isObject());
		assert(obj.get("index").asInt() == 1);
		JSONValue children = obj.get("children");
		assert(children.isArray());
		assert(children.size() == 2);
		assert(children.at(0).asInt() == 1);
		assert(children.at(1).asString().equals("item1"));
	}

	// Round-trip the first tree through stringify/parse to confirm structure.
	string s = trees.get(0).stringify();
	JSONValue reparsed = JSONValue.parse(s);
	assert(reparsed.isArray());
	assert(reparsed.size() == 3);
	assert(reparsed.at(2).get("index").asInt() == 2);

	// Scope exit releases `trees`, which recursively releases every nested
	// Vector<JSONValue> and child JSONValue.
	print("PASS: test_stdlib_json_nested_vector_arc");
	return 0;
}
