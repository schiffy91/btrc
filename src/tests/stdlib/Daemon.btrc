/* Portable daemon lifecycle, arguments, logs, restart and stale-state refusal.
 * The managed child uses this fixture's child modes; supervision itself uses
 * the platform provider and, on Windows, the separate production companion. */
import Library.Bytes;
import Library.Daemon;
import Library.Daemon.DaemonControl;
import Library.FileSystem;
import Library.FileSystem.FileSystemHandles;
import Library.IO;
import Library.Platform;
import Library.Process;
import Library.Strings;
import Library.Timer;
#if defined(_WIN32)
import Library.FileSystem.ApplicationDirectories;
#endif

bool waitForTextLength(string path, int length, int timeoutMilliseconds) {
	int attempts = timeoutMilliseconds / 20;
	while (attempts > 0) {
		if (Path.readAll(path).len() >= length) { return true; }
		Timer.sleepMillis(20);
		attempts--;
	}
	return false;
}

int childProbe(int argc, char** argv) {
	string mode = Strings.copy(argv[1]);
#if defined(_WIN32)
	if (mode.equals("--descendant")) {
		assert(argc == 3 && Path.writeAll(Strings.copy(argv[2]), "ready"));
		Timer.sleepMillis(1000);
		assert(Path.writeAll(Strings.copy(argv[2]), "survived"));
		return 0;
	}
	if (mode.equals("--tree")) {
		assert(argc == 3);
		return ChildProcess.run(Strings.copy(argv[0]), ["--descendant", Strings.copy(argv[2])], timeoutMilliseconds=5000).code;
	}
#endif
	if (mode.equals("--worker")) {
		assert(argc == 5);
		assert(Strings.copy(argv[2]).equals("space value"));
		assert(Strings.copy(argv[3]).equals("quote'\"value"));
		assert(Strings.copy(argv[4]).isEmpty());
		assert(getchar() == EOF);
		fputs("worker stdout\n", stdout);
		fputs("worker stderr\n", stderr);
		assert(fflush(stdout) == 0 && fflush(stderr) == 0);
		assert(Path.writeAll("worker.ready", "ready"));
		Timer.sleepMillis(10000);
		return 0;
	}
	if (mode.equals("--restart")) {
		assert(argc == 3);
		FILE* count = fopen(argv[2], "ab");
		assert(count != NULL && fputc('x', count) != EOF && fclose(count) == 0);
		return 0;
	}
	if (mode.equals("--once")) {
		assert(argc == 3);
		string root = Strings.copy(argv[2]);
		FILE* count = fopen(PathTools.join(root, "once-count"), "ab");
		assert(count != NULL && fputc('x', count) != EOF && fclose(count) == 0);
		assert(waitForTextLength(PathTools.join(root, "once-exit"), 1, 2000));
		return 23;
	}
	return 64;
}

Command worker(string executable) { return Command(executable).arg("--worker").arg("space value").arg("quote'\"value").arg(""); }

#if defined(_WIN32)
bool copyExecutable(string source, string destination) {
	FILE* input = fopen(source, "rb");
	if (input == NULL) { return false; }
	FILE* output = fopen(destination, "wb");
	if (output == NULL) { fclose(input); return false; }
	char buffer[65536];
	bool copied = true;
	size_t count = fread(buffer, 1, 65536, input);
	while (count > (size_t)0) {
		if (fwrite(buffer, 1, count, output) != count) { copied = false; break; }
		count = fread(buffer, 1, 65536, input);
	}
	if (ferror(input) != 0) { copied = false; }
	if (fclose(input) != 0) { copied = false; }
	if (fclose(output) != 0) { copied = false; }
	return copied;
}

int imageProbe(string executable, bool expectSuccess) {
	var opened = FileSystem.createTemporaryDirectory("btrc daemon image");
	assert(opened.ok());
	var temporary = opened.value();
	string root = temporary.path();
	DaemonSpec spec = DaemonSpec("image-probe", worker(executable)).control(PathTools.join(root, "control")).log(PathTools.join(root, "log")).cwd(root);
	DaemonController controller = DaemonController();
	ExecResult started = controller.start(spec);
	if (expectSuccess) {
		assert(started.ok());
		assert(controller.status(spec).ok());
		assert(controller.stop(spec).ok());
		Timer.sleepMillis(100);
	} else {
		assert(started.code == 125 && started.err.equals("failed to launch daemon supervisor"));
		assert(!started.startIndeterminate && !FileSystem.exists(spec.controlFile));
		assert(!FileSystem.exists(PathTools.join(root, "worker.ready")));
	}
	assert(temporary.close().ok());
	return 0;
}
#endif

int main(int argc, char** argv) {
	string executable = PathTools.absolute(argv[0]);
	if (argc > 1) {
#if defined(_WIN32)
		string mode = Strings.copy(argv[1]);
		if (mode.equals("--image-success")) { return imageProbe(executable, true); }
		if (mode.equals("--image-refusal")) { return imageProbe(executable, false); }
#endif
		return childProbe(argc, argv);
	}
	var opened = FileSystem.createTemporaryDirectory("btrc daemon");
	assert(opened.ok());
	var temporary = opened.value();
	string dir = temporary.path();
	assert(FileSystem.isDir(dir));
	DaemonController controller = DaemonController();

	DaemonSpec defaults = DaemonSpec("default-path", worker(executable));
	assert(PathTools.dirname(defaults.controlFile).equals(DaemonControlPaths.defaultDirectory()));
	assert(!defaults.controlFile.equals(defaults.logFile));
	assert(!DaemonSpec("d", worker(executable)).restart(false).autoRestart);

	string controlFile = PathTools.join(dir, "live.control");
	string logFile = PathTools.join(dir, "live.log");
	DaemonSpec live = DaemonSpec("btrclive", worker(executable)).control(controlFile).log(logFile).cwd(dir);
	assert(controller.status(live).code == 1);
	assert(controller.stop(live).code == 1);
	ExecResult liveStart = controller.start(live);
	if (!liveStart.ok()) { fprintf(stderr, "daemon start failed (%d): %s\n", liveStart.code, liveStart.err); }
	assert(liveStart.ok() && !liveStart.startIndeterminate);
	assert(FileSystem.exists(controlFile));
	assert(controller.status(live).ok());
	ExecResult duplicate = controller.start(live);
	assert(duplicate.code == 1 && duplicate.err.equals("daemon control record already exists"));
	assert(waitForTextLength(PathTools.join(dir, "worker.ready"), 1, 2000));
	string logged = Path.readAll(logFile).replace("\r\n", "\n");
	assert(logged.contains("worker stdout\n") && logged.contains("worker stderr\n"));
	assert(controller.stop(live).ok());
	assert(!FileSystem.exists(controlFile));
	assert(!controller.status(live).ok());
	assert(live.controlFile.equals(controlFile) && live.logFile.equals(logFile) && live.workingDirectory.equals(dir));

	// Let the child exit itself after start has returned. Its nonzero exit
	// must retire the supervisor and record without restarting the command.
	DaemonSpec once = DaemonSpec("once", Command(executable).arg("--once").arg(dir)).control(PathTools.join(dir, "once.control")).log(PathTools.join(dir, "once.log"));
	assert(controller.start(once).ok());
	assert(waitForTextLength(PathTools.join(dir, "once-count"), 1, 2000));
	assert(Path.writeAll(PathTools.join(dir, "once-exit"), "exit"));
	int exitAttempts = 100;
	while (FileSystem.exists(once.controlFile) && exitAttempts > 0) { Timer.sleepMillis(20); exitAttempts--; }
	assert(!FileSystem.exists(once.controlFile));
	assert(controller.status(once).code == 1);
	assert(Path.readAll(PathTools.join(dir, "once-count")).equals("x"));

	string restartCount = PathTools.join(dir, "restart-count");
	DaemonSpec restarting = DaemonSpec("restart", Command(executable).arg("--restart").arg(restartCount)).control(PathTools.join(dir, "restart.control")).log(PathTools.join(dir, "restart.log")).restart(true);
	assert(controller.start(restarting).ok());
	assert(waitForTextLength(restartCount, 2, 3000));
	assert(controller.status(restarting).ok());
	assert(controller.stop(restarting).ok());
	int stoppedLength = Path.readAll(restartCount).len();
	Timer.sleepMillis(250);
	assert(Path.readAll(restartCount).len() == stoppedLength);

	// The filesystem lease publishes genuinely owner-only fixture files on
	// both platforms; ordinary fopen permissions are not an ACL assertion.
	var directoryOpen = FileSystem.openPrivateDirectory(dir);
	assert(directoryOpen.ok());
	var directory = directoryOpen.value();
	var leaseOpen = directory.acquireExclusiveLease("fixture.lock");
	assert(leaseOpen.ok());
	var lease = leaseOpen.value();
	string staleControl = PathTools.join(dir, "stale.control");
	string forgedToken = "0123456789abcdef0123456789abcdef";
	assert(lease.replaceRegularChildDurably("stale.control", Bytes.fromString(f"btrc-daemon-v1\n{forgedToken}\n2147483647\n")).committed());
	DaemonSpec stale = DaemonSpec("stale", worker(executable)).control(staleControl).log(PathTools.join(dir, "stale.log"));
	assert(!controller.status(stale).ok());
	assert(!controller.stop(stale, timeoutMilliseconds=250).ok());
	assert(FileSystem.exists(staleControl));
	assert(lease.removeRegularChildDurably("stale.control").committed());

	string injected = PathTools.join(dir, "injected.control");
	string marker = PathTools.join(dir, "injected-marker");
	assert(lease.replaceRegularChildDurably("injected.control", Bytes.fromString(f"1; touch {marker}")).committed());
	DaemonSpec injection = DaemonSpec("injection", worker(executable)).control(injected).log(PathTools.join(dir, "injection.log"));
	assert(!controller.stop(injection).ok());
	assert(!FileSystem.exists(marker));
	assert(FileSystem.exists(injected));
	assert(lease.removeRegularChildDurably("injected.control").committed());
	assert(lease.close().ok() && directory.close().ok());

#if defined(_WIN32)
	var roots = ApplicationDirectories.resolveStandard();
	assert(roots.ok());
	assert(DaemonControlPaths.defaultDirectory().equals(PathTools.join(PathTools.join(roots.value().stateRoot(), "btrc"), "daemons")));
	var defaultCwdOpen = FileSystem.createTemporaryDirectory("btrc daemon default");
	assert(defaultCwdOpen.ok());
	var defaultCwd = defaultCwdOpen.value();
	DaemonSpec defaultLive = DaemonSpec(f"btrc-corpus-{Platform.pid()}", worker(executable)).cwd(defaultCwd.path());
	string defaultState = PathTools.dirname(defaultLive.controlFile);
	bool stateExisted = FileSystem.isDir(defaultState);
	assert(controller.status(defaultLive).code == 1 && controller.stop(defaultLive).code == 1);
	assert(FileSystem.isDir(defaultState) == stateExisted);
	assert(!FileSystem.exists(defaultLive.controlFile) && !FileSystem.exists(defaultLive.logFile));
	assert(controller.start(defaultLive).ok());
	assert(waitForTextLength(PathTools.join(defaultCwd.path(), "worker.ready"), 1, 2000));
	assert(controller.status(defaultLive).ok() && controller.stop(defaultLive).ok());
	assert(!FileSystem.exists(defaultLive.controlFile));
	int cleanupAttempts = 100;
	while (FileSystem.removeRecursive(defaultLive.logFile) != 0 && cleanupAttempts > 0) { Timer.sleepMillis(20); cleanupAttempts--; }
	assert(!FileSystem.exists(defaultLive.logFile) && defaultCwd.close().ok());

	// First prove the descendant reaches its delayed write normally, then
	// stop the same tree before that write. Nested Process jobs must remain
	// contained in the supervisor's owned job.
	string descendant = PathTools.join(dir, "descendant-marker");
	assert(ChildProcess.run(executable, ["--descendant", descendant], timeoutMilliseconds=2500).ok());
	assert(Path.readAll(descendant).equals("survived"));
	assert(FileSystem.removeRecursive(descendant) == 0);
	DaemonSpec tree = DaemonSpec("tree", Command(executable).arg("--tree").arg(descendant)).control(PathTools.join(dir, "tree.control")).log(PathTools.join(dir, "tree.log"));
	assert(controller.start(tree).ok());
	assert(waitForTextLength(descendant, 1, 2000));
	assert(Path.readAll(descendant).equals("ready"));
	assert(controller.stop(tree).ok() && !FileSystem.exists(tree.controlFile));
	Timer.sleepMillis(1100);
	assert(Path.readAll(descendant).equals("ready"));

	bool renderingRefused = false;
	try { live.renderStartCommand(controlFile, logFile); } catch (string message) {
		renderingRefused = message.equals("DaemonSpec.renderStartCommand is unavailable on Windows: the supervisor is a POSIX /bin/sh script; use DaemonController.start");
	}
	assert(renderingRefused);
	// Consumer metadata retains the companion basename across a consumer
	// rename. A missing, renamed or modified companion must fail before spawn.
	string companionName = PathTools.basename(executable) + ".btrc-supervisor.exe";
	string renamed = PathTools.join(dir, "renamed consumer.exe");
	string companion = PathTools.join(dir, companionName);
	assert(copyExecutable(executable, renamed));
	assert(copyExecutable(PathTools.join(PathTools.dirname(executable), companionName), companion));
	assert(ChildProcess.run(renamed, ["--image-success"], timeoutMilliseconds=6000).ok());
	string moved = companion + ".moved";
	assert(rename(companion, moved) == 0);
	assert(ChildProcess.run(renamed, ["--image-refusal"], timeoutMilliseconds=3000).ok());
	assert(rename(moved, companion) == 0);
	FILE* modified = fopen(companion, "ab");
	assert(modified != NULL && fputc(1, modified) != EOF && fclose(modified) == 0);
	assert(ChildProcess.run(renamed, ["--image-refusal"], timeoutMilliseconds=3000).ok());
#endif

	assert(temporary.close().ok());
	assert(!FileSystem.exists(dir));
	print("PASS: test_stdlib_daemon");
	return 0;
}
