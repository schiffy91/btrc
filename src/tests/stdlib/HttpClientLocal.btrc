/* HTTPClient end-to-end check: verifies Apple, Android, and Linux never invoke
 * curl even when a stand-in executable exists first on PATH. */
import Library.FileSystem;
import Library.HTTP.HTTPClient;
import Library.Platform;
import Library.Vector;

#include <assert.h>
#include <sys/stat.h>

int main() {
	string oldPath = Environment.get("PATH", "");
	string oldTemp = Environment.get("TMPDIR", "/tmp");
	string fixture = FileSystem.tempDir("btrc-http-client-test");
	assert(!fixture.isEmpty());
	string curlPath = PathTools.join(fixture, "curl");
	string argumentLog = PathTools.join(fixture, "argv.log");
#if defined(__ANDROID__)
	string script = "#!/system/bin/sh\n" + ": > \"$BTRC_CURL_LOG\"\n" + "exit 99\n";
#else
	string script = "#!/bin/sh\n" + "body=''\n" + ": > \"$BTRC_CURL_LOG\"\n" + "for item in \"$@\"; do printf '%s\\n' \"$item\" >> \"$BTRC_CURL_LOG\"; done\n" + "while [ \"$#\" -gt 0 ]; do\n" + "  case \"$1\" in\n" + "    --data-binary) [ \"$2\" = '@-' ] || exit 70; body=$(cat); shift 2 ;;\n" + "    --proto|--proto-redir|--max-time|--max-filesize|--request|--write-out|--header) shift 2 ;;\n" + "    --) shift; break ;;\n" + "    *) shift ;;\n" + "  esac\n" + "done\n" + "if [ -n \"$body\" ]; then printf '%s' \"$body\"; " + "else printf 'local-response'; fi\n" + "printf '\\n__BTRC_HTTP_STATUS__:201'\n";
#endif
	assert(FileSystem.writeText(curlPath, script));
	assert(chmod(curlPath, 0700) == 0);
	assert(setenv("PATH", fixture + ":" + oldPath, 1) == 0);
	assert(setenv("TMPDIR", fixture, 1) == 0);
	assert(setenv("BTRC_CURL_LOG", argumentLog, 1) == 0);

	string injectionMarker = PathTools.join(fixture, "shell-injection");
	Vector<string> headers = [
		"X-Test: local",
		"X-Injection: ; touch " + injectionMarker
	];
	HTTPClient client = HTTPClient().timeout(3);
#if defined(__APPLE__)
	/* Apple targets use native URLSession/Network.framework and never run curl,
	 * even when a curl executable sits first on PATH. */
	HTTPClientResponse get = client.get("https://unused.invalid", headers);
	assert(get.status == 0);
	assert(!get.error.isEmpty());
	assert(!FileSystem.exists(argumentLog));
	assert(!FileSystem.exists(injectionMarker));

	HTTPClientResponse getWithBody = client.request("GET", "https://unused.invalid", headers, "body");
	assert(getWithBody.status == 0);
	assert(!FileSystem.exists(argumentLog));

	HTTPClientResponse unsupported = client.get("file:///etc/passwd", headers);
	assert(unsupported.status == 0);
	assert(unsupported.error.contains("unsupported URL scheme"));
	assert(!FileSystem.exists(argumentLog));

	Vector<string> remaining = FileSystem.listDir(fixture);
	assert(remaining.len == 1);
#elif defined(__ANDROID__)
	HTTPClientResponse get = client.get("https://unused.invalid", headers);
	assert(get.status == 0);
	assert(get.body.isEmpty());
	assert(get.error.equals("HTTPS on Android requires an Android application VM"));
	assert(!FileSystem.exists(argumentLog));
	assert(!FileSystem.exists(injectionMarker));

	HTTPClientResponse post = client.post("https://unused.invalid", headers, "request-body");
	assert(post.status == 0);
	assert(post.body.isEmpty());
	assert(post.error.equals("HTTPS on Android requires an Android application VM"));
	assert(!FileSystem.exists(argumentLog));

	HTTPClientResponse unsupported = client.get("file:///etc/passwd", headers);
	assert(unsupported.status == 0);
	assert(unsupported.error.contains("unsupported URL scheme"));

	/* Standalone Android never invokes curl and leaves no capture files behind. */
	Vector<string> remaining = FileSystem.listDir(fixture);
	assert(remaining.len == 1);
#else
	/* Linux uses first-party TLS and must never invoke curl on PATH even when
	 * SSL_CERT_DIR is configured. */
	bool hadCertDir = Environment.has("SSL_CERT_DIR");
	string oldCertDir = Environment.get("SSL_CERT_DIR", "");
	assert(setenv("no_proxy", "*", 1) == 0);
	assert(setenv("SSL_CERT_DIR", fixture, 1) == 0);
	HTTPClientResponse get = client.get("https://unused.invalid", headers);
	assert(get.status == 0);
	assert(!get.error.isEmpty());
	assert(!FileSystem.exists(argumentLog));
	assert(!FileSystem.exists(injectionMarker));

	HTTPClientResponse unsupported = client.get("file:///etc/passwd", headers);
	assert(unsupported.status == 0);
	assert(unsupported.error.contains("unsupported URL scheme"));

	Vector<string> remaining = FileSystem.listDir(fixture);
	assert(remaining.len == 1);
	if (hadCertDir) {
		setenv("SSL_CERT_DIR", oldCertDir, 1);
	} else {
		unsetenv("SSL_CERT_DIR");
	}
#endif

	setenv("PATH", oldPath, 1);
	setenv("TMPDIR", oldTemp, 1);
	unsetenv("BTRC_CURL_LOG");
	assert(FileSystem.removeRecursive(fixture) == 0);
	print("PASS: test_stdlib_http_client_local");
	return 0;
}
