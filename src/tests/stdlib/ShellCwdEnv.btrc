/* UnixShell.run with cwd= and env= applied to the shell process itself,
 * plus a multi-KB stdin round-trip through the temp-file mechanism and a
 * simultaneous stderr=collect capture. Hermetic: cwd is /tmp, no network. */
import Library.Process;
import Library.Vector;

#include <assert.h>

int main() {
	UnixShell sh = UnixShell();

	// cwd= is the shell's working directory, so pwd reports /tmp.
	var pwd = sh.run("pwd", cwd="/tmp", logFailure=false).trimmed();
	assert(pwd.endsWith("tmp"));

	// env= is the shell's own environment, so it reaches every command in
	// the line, and shell expansion sees it too.
	Vector<string> env = ["FOO=bar"];
	var got = sh.run("printenv FOO", env=env, logFailure=false).trimmed();
	assert(got.equals("bar"));
	assert(sh.run("printenv FOO; printenv FOO", env=env, logFailure=false).stdout().equals("bar\nbar\n"));
	assert(sh.run("printf '%s' \"$FOO\"", env=env, logFailure=false).stdout().equals("bar"));

	// The recorded command is redacted like the log line.
	var redacted = sh.run("printf '%s' s3cret", redactSubstring="s3cret", logFailure=false);
	assert(redacted.stdout().equals("s3cret"));
	assert(!redacted.command.contains("s3cret"));

	// cwd and env combine.
	Vector<string> env2 = ["MSG=hi"];
	var combo = sh.run("printenv MSG", cwd="/tmp", env=env2, logFailure=false).trimmed();
	assert(combo.equals("hi"));

	// A multi-KB stdin round-trips through the temp stdin file unchanged.
	string big = "";
	for i in range(1000) { big += "0123456789"; }   // 10000 bytes
	var echoed = sh.run("cat", stdin=big, logFailure=false).stdout();
	assert(echoed.len() == 10000);
	assert(echoed.equals(big));

	// stderr=collect captures the error stream separately from stdout.
	var res = sh.run("printf err >&2; printf out", stdout=COMMAND_OUTPUT_COLLECT, stderr=COMMAND_OUTPUT_COLLECT, logFailure=false);
	assert(res.stdout().equals("out"));
	assert(res.stderr().equals("err"));

	print("PASS: test_stdlib_shell_cwd_env");
	return 0;
}
