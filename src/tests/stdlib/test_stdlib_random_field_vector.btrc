/* Random.shuffle / choice over a Vector<int> held as a class FIELD (not a local).
 * shuffle must preserve the multiset (same elements, possibly reordered) and
 * choice must return a member. Deterministic via a fixed seed. */
#include <assert.h>
#include "../../stdlib/random.btrc"

class Deck {
    public Vector<int> cards;
    public Deck() {
        self.cards = [];
        for i in range(10) { self.cards.push(i); }
    }
}

int main() {
    Random rng = new Random();
    rng.seed(1234);

    Deck d = new Deck();
    assert(d.cards.len == 10);

    // shuffle a FIELD vector in place: length unchanged, multiset preserved.
    rng.shuffle(d.cards);
    assert(d.cards.len == 10);

    int sum = 0;
    for i in range(10) {
        assert(d.cards.contains(i));   // every original element still present
        sum = sum + d.cards.get(i);
    }
    assert(sum == 45);                 // 0+1+...+9, multiset intact

    // choice picks a member of the field vector.
    for i in range(20) {
        int c = rng.choice(d.cards);
        assert(c >= 0 && c <= 9);
    }

    delete d;
    delete rng;

    print("PASS: test_stdlib_random_field_vector");
    return 0;
}
