/* Hermetic HTTP/1.1 framing, validation, and binary-body regressions. */
#include <assert.h>

int main() {
    HttpServer server = HttpServer(0);

    HttpRequest clamped = server.parse(
        "POST /one HTTP/1.1\r\nHost: local\r\nContent-Length: 5\r\n\r\nhelloEXTRA");
    assert(clamped.valid);
    assert(clamped.body.equals("hello"));
    assert(clamped.bodyBytes.length() == 5);

    HttpRequest unframed = server.parse(
        "POST /two HTTP/1.1\r\nHost: local\r\n\r\nnot-a-request-body");
    assert(unframed.valid);
    assert(unframed.body.isEmpty());

    HttpRequest sameLengths = server.parse(
        "POST / HTTP/1.1\r\nHost: local\r\nContent-Length: 3, 3\r\n\r\nabc");
    assert(sameLengths.valid && sameLengths.body.equals("abc"));

    assert(!server.parse(
        "POST / HTTP/1.1\r\nHost: local\r\nContent-Length: 4\r\n\r\nabc").valid);
    assert(!server.parse(
        "POST / HTTP/1.1\r\nHost: local\r\nContent-Length: 3x\r\n\r\nabc").valid);
    assert(!server.parse(
        "POST / HTTP/1.1\r\nHost: local\r\nContent-Length: 3,\r\n\r\nabc").valid);
    assert(!server.parse(
        "POST / HTTP/1.1\r\nHost: local\r\nContent-Length: 2147483648\r\n\r\n").valid);
    assert(!server.parse(
        "POST / HTTP/1.1\r\nHost: local\r\nContent-Length: 3\r\nContent-Length: 4\r\n\r\nabc").valid);
    assert(!server.parse(
        "POST / HTTP/1.1\r\nHost: local\r\nContent-Length: 3\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n").valid);
    assert(!server.parse(
        "POST / HTTP/1.1\r\nHost: local\r\nTransfer-Encoding: notchunked\r\n\r\n").valid);
    assert(!server.parse(
        "POST / HTTP/1.1\r\nHost: local\r\nTransfer-Encoding: gzip, chunked\r\n\r\n0\r\n\r\n").valid);
    assert(!server.parse(
        "POST / HTTP/1.0\r\nTransfer-Encoding: chunked\r\n\r\n0\r\n\r\n").valid);

    assert(!server.parse("GET / HTTP/1.1\r\n\r\n").valid);
    assert(!server.parse(
        "GET / HTTP/1.1\r\nHost: one\r\nHost: two\r\n\r\n").valid);
    assert(!server.parse(
        "GET / HTTP/1.1\r\nHost: local\r\n folded\r\n\r\n").valid);
    assert(!server.parse(
        "GET / NOT-HTTP\r\nHost: local\r\n\r\n").valid);

    HttpRequest chunked = server.parse(
        "POST /chunk HTTP/1.1\r\nHost: local\r\nTransfer-Encoding: Chunked\r\n\r\n"
        + "3;name=value\r\nabc\r\n0;done=yes\r\nX-Trailer: yes\r\n\r\nEXTRA");
    assert(chunked.valid);
    assert(chunked.body.equals("abc"));
    assert(!server.parse(
        "POST / HTTP/1.1\r\nHost: local\r\nTransfer-Encoding: chunked\r\n\r\n"
        + "5\r\nabc\r\n0\r\n\r\n").valid);
    assert(!server.parse(
        "POST / HTTP/1.1\r\nHost: local\r\nTransfer-Encoding: chunked\r\n\r\n"
        + "80000000\r\n").valid);
    assert(!server.parse(
        "POST / HTTP/1.1\r\nHost: local\r\nTransfer-Encoding: chunked\r\n\r\n"
        + "0\r\nContent-Length: 5\r\n\r\n").valid);

    Bytes binary = Bytes.fromString(
        "POST /binary HTTP/1.1\r\nHost: local\r\nTransfer-Encoding: chunked\r\n\r\n3\r\n");
    binary.append(65);
    binary.append(0);
    binary.append(66);
    binary.appendRaw("\r\n0\r\n\r\n", 7);
    HttpRequest binaryRequest = server.parseBytes(binary);
    assert(binaryRequest.valid);
    assert(binaryRequest.bodyBytes.length() == 3);
    assert(binaryRequest.bodyBytes.get(0) == 65);
    assert(binaryRequest.bodyBytes.get(1) == 0);
    assert(binaryRequest.bodyBytes.get(2) == 66);
    assert((int)strlen(binaryRequest.body) == 1);

    server.maxBodyBytes = 2;
    assert(!server.parse(
        "POST / HTTP/1.1\r\nHost: local\r\nContent-Length: 3\r\n\r\nabc").valid);

    assert(HttpServer.urlDecode("a%00b").equals("a%00b"));
    string fakeChunked =
        "GET / HTTP/1.1\r\nTransfer-Encoding: notchunked\r\n\r\n";
    int fakeHeaderEnd = Strings.find(fakeChunked, "\r\n\r\n", 0);
    assert(!HttpServer.isChunked(fakeChunked, fakeHeaderEnd));

    HttpClient client = HttpClient().timeout(-10);
    assert(client.timeoutSecs == 1);
    Vector<string> headers = [];
    assert(client.request("BAD METHOD", "http://local", headers, "").status == 0);
    assert(client.request("GET", "bad url", headers, "").status == 0);
    headers.push("Missing-Colon");
    assert(client.request("GET", "http://local", headers, "").status == 0);
    headers = [];
    client.maxRequestBytes = 2;
    assert(client.request("POST", "http://local", headers, "abc").status == 0);
    client.maxResponseBytes = -1;
    assert(client.request("GET", "http://local", headers, "").status == 0);

    assert(!HttpServer(-1).start());
    assert(!HttpServer(70000).start());

    print("PASS: test_stdlib_http_framing_safety");
    return 0;
}
