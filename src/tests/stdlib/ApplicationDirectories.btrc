import Library.FileSystem.ApplicationDirectories;
import Library.FileSystem.FileSystemHandles;

#include <assert.h>
#include <errno.h>

class ApplicationDirectoryTest {
	class bool normalized(string path) { return !path.isEmpty() && path[0] == '/' && (path.equals("/") || path[path.len() - 1] != '/') && !path.contains("//") && !path.contains("/./") && !path.contains("/../"); }
}

int main() {
	FileSystemOutcome<ApplicationDirectoryRoots> invalid = ApplicationDirectories.resolve(ApplicationDirectoryLimits(0));
	assert(!invalid.ok());
	assert(invalid.error().kind() == FS_INVALID_ARGUMENT);
	assert(invalid.error().nativeCode() == 0);
	assert(!invalid.error().message().isEmpty());

	FileSystemOutcome<ApplicationDirectoryRoots> limited = ApplicationDirectories.resolve(ApplicationDirectoryLimits(1));
	int platform = __btrc_target_platform();
	if (platform == 1 || platform == 2) {
		assert(!limited.ok());
		assert(limited.error().kind() == FS_INVALID_ARGUMENT);
		assert(limited.error().nativeCode() == ENAMETOOLONG);

		FileSystemOutcome<ApplicationDirectoryRoots> resolved = ApplicationDirectories.resolveStandard();
		assert(resolved.ok());
		assert(ApplicationDirectoryTest.normalized(resolved.value().stateRoot()));
		assert(ApplicationDirectoryTest.normalized(resolved.value().cacheRoot()));
		assert(ApplicationDirectoryTest.normalized(resolved.value().configRoot()));
	} else {
		assert(!limited.ok());
		assert(limited.error().kind() == FS_UNSUPPORTED);
	}

	print("PASS: bounded platform application directory roots");
	return 0;
}
