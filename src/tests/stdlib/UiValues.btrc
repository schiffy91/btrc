import Library.Image;
import Library.UI;
import Library.Vector;

#include <assert.h>

int main() {
	Image artwork = Image(2, 2);
	artwork.setRGBA(0, 0, 10, 20, 30, 255);

	UIElement tree = UIElement.column("library").className("library-root").style("padding: 8px; gap: 12px").child(UIElement.text("status", "Two albums")).child(UIElement.grid("albums").child(UIElement.button("album:first", "First").style("border-radius: 8px").child(UIElement.image("album-art:first", artwork, "First album").imageRevision(7ULL))));

	assert(tree.kind() == UI_COLUMN);
	assert(tree.id() == "library");
	assert(tree.cssClass() == "library-root");
	assert(tree.inlineStyle() == "padding: 8px; gap: 12px");
	assert(tree.styleError().ok());
	assert(tree.childCount() == 2);
	assert(tree.childAt(1).kind() == UI_GRID);
	UIElement button = tree.childAt(1).childAt(0);
	assert(button.kind() == UI_BUTTON);
	assert(button.contentText() == "First");
	assert(button.childAt(0).contentImage() == artwork);
	assert(button.childAt(0).contentImageRevision() == 7ULL);
	assert(button.childAt(0).imageAlt() == "First album");

	UIElement query = UIElement.textInput("library-query", "caf\xc3\xa9", "Search albums", 64).className("library-query").style("height: 40px; border-radius: 6px");
	assert(query.kind() == UI_TEXT_INPUT);
	assert(query.id() == "library-query");
	assert(query.contentText() == "caf\xc3\xa9");
	assert(query.placeholderText() == "Search albums");
	assert(query.textInputMaxBytes() == 64);
	assert(query.styleError().ok());
	Vector<UISelectOption> monitorOptions = [];
	monitorOptions.push(UISelectOption("song-effects", "Song effects"));
	monitorOptions.push(UISelectOption("raw-signal", "Raw signal"));
	monitorOptions.push(UISelectOption("unavailable", "Unavailable", false));
	UISelect monitorDescriptor = UISelect(monitorOptions, "song-effects");
	assert(monitorDescriptor.valid());
	assert(monitorDescriptor.optionCount() == 3);
	assert(monitorDescriptor.optionAt(1).value() == "raw-signal");
	assert(monitorDescriptor.optionAt(1).label() == "Raw signal");
	assert(!monitorDescriptor.optionAt(2).enabled());
	assert(monitorDescriptor.selectedIndex() == 0);
	assert(monitorDescriptor.selectedValue() == "song-effects");
	assert(monitorDescriptor.selectedLabel() == "Song effects");
	UIElement monitor = UIElement.select("monitor", monitorDescriptor);
	assert(monitor.kind() == UI_SELECT);
	assert(monitor.contentText() == "Song effects");
	assert(monitor.selectDescriptor() != null);
	UISelect resolvedMonitorDescriptor = monitor.selectDescriptor();
	assert(resolvedMonitorDescriptor.selectedValue() == "song-effects");
	UIEvent selected = UIEvent.selectionChanged("monitor", "raw-signal");
	assert(selected.kind() == UI_SELECTION_CHANGED);
	assert(selected.elementId() == "monitor");
	assert(selected.value() == "raw-signal");
	Vector<UISelectOption> duplicateOptions = [];
	duplicateOptions.push(UISelectOption("same", "First"));
	duplicateOptions.push(UISelectOption("same", "Second"));
	assert(!UISelect(duplicateOptions, "same").valid());
	assert(!UISelect(monitorOptions, "missing").valid());
	Vector<UISelectOption> tooManyOptions = [];
	for (int index = 0; index < 129; index++) { tooManyOptions.push(UISelectOption(f"value-{index}", f"Option {index}")); }
	assert(!UISelect(tooManyOptions, "value-0").valid());
	Vector<UISelectOption> emptyLabelOptions = [];
	emptyLabelOptions.push(UISelectOption("empty-label", ""));
	assert(!UISelect(emptyLabelOptions, "empty-label").valid());
	UIElement typography = UIElement.text("typography", "Editorial heading").style("font-size: 28px; line-height: 34px; font-weight: 600; text-align: center");
	assert(typography.styleError().ok());
	UIColor teal = UIColor.hex("#1a2b3c");
	assert(teal.css() == "#1a2b3cff");
	assert(teal.withAlpha(16).css() == "#1a2b3c10");
	assert(teal.equals(UIColor(26, 43, 60)));
	assert(!teal.equals(teal.withAlpha(16)));
	assert(UIColor.fromRgba(RGBA(1, 2, 3, 4)).css() == "#01020304");
	RGBA bridged = teal.rgba();
	assert(bridged.red == 26 && bridged.green == 43 && bridged.blue == 60 && bridged.alpha == 255);
	assert(UIStyle.validate("color: " + teal.css()).ok());
	assert(UITheme.dark().equals(UITheme.dark()));
	assert(!UITheme.dark().equals(UITheme.light()));
	assert(!UITheme.light().equals(UITheme.nativeDefault()));
	assert(UITheme.light().background.equals(UIColor(242, 242, 244)));
	assert(UITheme.dark().text.equals(UIColor(236, 236, 238)));
	assert(!UIElement.text("small-type", "bad").style("font-size: 7px").styleError().ok());
	assert(!UIElement.text("tall-type", "bad").style("line-height: 513px").styleError().ok());
	assert(!UIElement.text("bad-weight", "bad").style("font-weight: 800").styleError().ok());
	assert(!UIElement.text("bad-alignment", "bad").style("text-align: justify").styleError().ok());

	UIElement rejected = UIElement.text("unsafe", "No browser CSS").style("position: fixed");
	assert(!rejected.styleError().ok());
	assert(rejected.styleError().code() == UI_STYLE_UNSUPPORTED_PROPERTY);
	assert(rejected.styleError().property() == "position");

	UIStyleSheet sheet = UIStyleSheet().rule("library-root", "background-color: #f6f6f8; padding: 8px").rule("album-card", "border-radius: 8px; color: #202024");
	assert(sheet.ok());
	assert(sheet.ruleCount() == 2);
	assert(sheet.classNameAt(1) == "album-card");
	assert(sheet.cssFor("album-card") == "border-radius: 8px; color: #202024");
	assert(sheet.cssFor("missing").isEmpty());
	UIStyleSheet duplicateSheet = UIStyleSheet().rule("album-card", "padding: 4px").rule("album-card", "padding: 8px");
	assert(!duplicateSheet.ok());
	assert(duplicateSheet.issue().code() == UI_STYLE_DUPLICATE_RULE);
	UIStyleSheet invalidSheet = UIStyleSheet().rule("browser descendant", "padding: 8px");
	assert(!invalidSheet.ok());
	assert(invalidSheet.issue().code() == UI_STYLE_INVALID_SELECTOR);

	UIVirtualGrid virtualLayout = UIVirtualGrid(2000, 4, 180, 1984);
	UIElement virtualGrid = UIElement.virtualGrid("virtual-albums", virtualLayout).child(UIElement.button("album:1984", "Album 1984")).child(UIElement.button("album:1985", "Album 1985"));
	assert(virtualGrid.kind() == UI_VIRTUAL_GRID);
	assert(virtualGrid.virtualGridDescriptor() != null);
	UIVirtualGrid resolvedLayout = virtualGrid.virtualGridDescriptor();
	assert(resolvedLayout.ok());
	assert(resolvedLayout.totalCount() == 2000);
	assert(resolvedLayout.columns() == 4);
	assert(resolvedLayout.rowHeight() == 180);
	assert(resolvedLayout.firstDataIndex() == 1984);
	assert(!UIVirtualGrid(4, 0, 180, 0).ok());
	assert(UIVirtualGrid(4, 0, 180, 0).issue().code() == UI_VIRTUAL_GRID_INVALID_COLUMNS);

	UIViewportMetrics viewport = UIViewportMetrics(800, 600, 0, 240);
	UIScrollDelta delta = UIScrollDelta(0, 120);
	UIEvent scrolled = UIEvent.scrolled("albums", viewport, delta);
	assert(scrolled.kind() == UI_SCROLLED);
	assert(scrolled.elementId() == "albums");
	assert(scrolled.viewport().width() == 800);
	assert(scrolled.viewport().height() == 600);
	assert(scrolled.viewport().scrollY() == 240);
	assert(scrolled.scroll().x() == 0);
	assert(scrolled.scroll().y() == 120);

	assert(UIEvent.clicked("album:first").kind() == UI_CLICKED);
	assert(UIEvent.hoverEntered("album:first").kind() == UI_HOVER_ENTERED);
	assert(UIEvent.hoverLeft("album:first").kind() == UI_HOVER_LEFT);
	assert(UIEvent.viewportChanged("albums", viewport).kind() == UI_VIEWPORT_CHANGED);
	UIEvent changed = UIEvent.valueChanged("library-query", "new query");
	assert(changed.kind() == UI_VALUE_CHANGED);
	assert(changed.elementId() == "library-query");
	assert(changed.value() == "new query");

	print("PASS: native UI values");
	return 0;
}
