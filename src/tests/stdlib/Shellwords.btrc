/* ShellWords quoting and env-assignment edges:
 *   - quote("") -> '' (empty needs quoting, isSafeArg false on empty);
 *   - quote of a string with an embedded single quote uses the '\'' dance;
 *   - safe args pass through unquoted;
 *   - shell env entries reach the environment verbatim, never as shell text;
 *   - a missing '=' or a bad variable name throws;
 *   - redact replaces a sensitive substring. */
import Library.Process;

#include <assert.h>

int main() {
	// Empty string must be quoted to '' (a bare empty word would vanish).
	assert(ShellWords.quote("").equals("''"));

	// A safe arg (alnum + a few punctuation) passes through verbatim.
	assert(ShellWords.quote("safe-arg_1.2/x:y=z,+a").equals("safe-arg_1.2/x:y=z,+a"));

	// A space forces quoting.
	assert(ShellWords.quote("a b").equals("'a b'"));

	// An embedded single quote becomes '\'' inside the single-quoted form:
	// a'b -> 'a'\''b'
	assert(ShellWords.quote("a'b").equals("'a'\\''b'"));

	// env values reach the shell's environment verbatim; nothing is quoted.
	UnixShell sh = UnixShell();
#if defined(_WIN32)
	// Windows has no POSIX shell: the run is refused with the adaptation
	// diagnostic, after the same request validation as on Unix.
	ExecResult refused = sh.run("printenv FOO", env=["FOO=a b"], logFailure=false);
	assert(refused.code == 127 && refused.stdout().isEmpty());
	assert(refused.stderr().equals("UnixShell.run is unavailable on Windows: there is no POSIX /bin/sh; use ChildProcess.run with an argument vector\n"));
#else
	assert(sh.run("printenv FOO", env=["FOO=a b"], logFailure=false).stdout().equals("a b\n"));
	assert(sh.run("printenv FOO", env=["FOO=it's $HOME"], logFailure=false).stdout().equals("it's $HOME\n"));
#endif

	// Missing '=' throws.
	bool noEq = false;
	try {
		sh.run("true", env=["NOEQ"]);
	} catch (string e) {
		noEq = e.contains("invalid environment assignment");
	}
	assert(noEq);

	// A leading-digit (invalid) variable name throws.
	bool badName = false;
	try {
		sh.run("true", env=["1BAD=x"]);
	} catch (string e) {
		badName = e.contains("invalid environment variable name");
	}
	assert(badName);

	// redact masks the sensitive substring; an empty sensitive arg is a no-op.
	assert(ShellWords.redact("pw=secret done", "secret").equals("pw=*** done"));
	assert(ShellWords.redact("nothing", "").equals("nothing"));

	print("PASS: test_stdlib_shellwords");
	return 0;
}
