/* Platform euid / isRoot probes: Platform.euid() reads geteuid(), and
 * isRoot() is exactly euid()==0. Pid is also non-negative.
 * Deterministic relationships only — never asserts a specific uid. */
import Library.Platform;

#include <assert.h>

int main() {
	int euid = Platform.euid();
	assert(euid >= 0);

	// isRoot() is precisely euid()==0.
	assert(Platform.isRoot() == (euid == 0));

	// pid is a positive process id.
	int pid = Platform.pid();
	assert(pid > 0);

	// Static platform facts.
	assert(Platform.isUnix());
	assert(!Platform.isWindows());
	assert(Platform.pathSeparator().equals("/"));

	print("PASS: test_stdlib_platform_euid");
	return 0;
}
