/* CliArgs flag/command/value lookup, CliCommand aliases, and CliHelp rendering. */
import std.cli;

#include <assert.h>

int main() {
	var arguments = CliArgs(0, null);
	arguments.values.push("build");
	arguments.values.push("--name");
	arguments.values.push("lorem");
	arguments.values.push("--level=3");
	arguments.values.push("--dry-run");
	arguments.values.push("--");
	arguments.values.push("--literal");

	assert(arguments.count() == 7);
	assert(arguments.get(0).equals("build"));
	assert(arguments.require(1, "missing").equals("--name"));
	assert(arguments.command().equals("build"));
	assert(arguments.commandIs("build") && !arguments.commandIs("run"));
	assert(arguments.has("--name") && !arguments.has("--missing"));
	assert(arguments.valueAfter("--name", "?").equals("lorem"));
	assert(arguments.valueAfter("--missing", "def").equals("def"));
	assert(arguments.valueAfterPrefix("--level=", "0").equals("3"));

	var parsed = CliCommandLine.parse(arguments);
	assert(parsed.ok());
	assert(parsed.operandCount() == 2);
	assert(parsed.operand(0).equals("build"));
	assert(parsed.operand(1).equals("--literal"));
	assert(parsed.has("--name"));
	assert(parsed.option("--name").equals("lorem"));
	assert(parsed.option("--level").equals("3"));
	assert(parsed.flag("--dry-run"));
	assert(parsed.values("--name").len == 1);
	assert(parsed.values("--name").get(0).equals("lorem"));
	assert(parsed.option("--missing", "fallback").equals("fallback"));
	assert(parsed.operand(9, "fallback").equals("fallback"));

	var missingRaised = false;
	try {
		arguments.require(99, "required");
	} catch (string error) {
		missingRaised = error.equals("required");
	}
	assert(missingRaised);

	var repeated = CliArgs(0, null);
	repeated.values.push("run");
	repeated.values.push("--arg");
	repeated.values.push("one=1");
	repeated.values.push("--arg=two=2");
	var repeatedCommandLine = CliCommandLine.parseFrom(repeated, 1);
	assert(repeatedCommandLine.operandCount() == 0);
	assert(repeatedCommandLine.values("--arg").len == 2);
	assert(repeatedCommandLine.values("--arg").get(1).equals("two=2"));

	var negative = CliArgs(0, null);
	negative.values.push("--limit");
	negative.values.push("-1");
	negative.values.push("--verbose");
	var negativeCommandLine = CliCommandLine.parse(negative);
	assert(negativeCommandLine.option("--limit").equals("-1"));
	assert(negativeCommandLine.flag("--verbose"));
	assert(negativeCommandLine.operandCount() == 0);

	var command = CliCommand("build");
	command.alias("b");
	assert(command.matches("build") && command.matches("b") && !command.matches("run"));

	var help = CliHelp().withWidth(12);
	help.line("Usage: app").section("Commands").item("run", "Run it").item("very-long-command", "wraps").continuation("more detail");
	var rendered = help.render();
	assert(rendered.contains("Usage: app"));
	assert(rendered.contains("Commands:"));
	assert(rendered.contains("  run         Run it"));
	assert(rendered.contains("  very-long-command"));
	assert(rendered.contains("            wraps"));
	assert(rendered.contains("            more detail"));

	print("PASS: test_stdlib_cli");
	return 0;
}
