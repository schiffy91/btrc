/* ProcessStatus signal/error decoding through ChildProcess, plus capture
 * growth across several pipe reads:
 *   - ProcessStatus(-1).code() == 127 (the wait failure sentinel);
 *   - normal exits decode to their code;
 *   - a SIGTERM-killed process decodes to 128 + signal;
 *   - 9000 bytes of stdout span more than one 4096-byte pipe read.
 * Windows has no wait status, /bin/sh or signals: a status is the child's own
 * exit code, an NTSTATUS exit keeps all 32 bits in the signed code, and this
 * program is its own child. */
import Library.Process;
import Library.Strings;

#include <assert.h>

int main(int argc, char** argv) {
	if (argc > 1) { return childProbe(Strings.copy(argv[1])); }
#if defined(_WIN32)
	assert(ProcessStatus(-1).code() == -1);
	assert(ProcessStatus(5).code() == 5);
	string program = Strings.copy(argv[0]);
	assert(ChildProcess.run(program,["--exit-0"]).code == 0);
	assert(ChildProcess.run(program,["--exit-5"]).code == 5);
	// STATUS_CONTROL_C_EXIT (0xC000013A), bit for bit.
	assert(ChildProcess.run(program,["--ntstatus"]).code == -1073741510);
	ExecResult large = ChildProcess.run(program,["--large"]);
	assert(large.ok());
	assert((int)strlen(large.stdout()) == 9000);
	assert(large.capturedStdoutBytes == 9000);
	assert(ChildProcess.run(program,["--hello"]).stdout().equals("hello"));
#else
	// raw == -1 -> 127 (the documented failure code).
	assert(ProcessStatus(-1).code() == 127);
	assert(!ProcessStatus(-1).ok());

	// A normal exit decodes to its code.
	assert(ChildProcess.run("/bin/sh", ["-c", "exit 0"]).code == 0);
	assert(ChildProcess.run("/bin/sh", ["-c", "exit 5"]).code == 5);

	// A signal-terminated process: 128 + SIGTERM(15) == 143.
	assert(ChildProcess.run("/bin/sh", ["-c", "kill -TERM $$"]).code == 143);

	// Capture across several 4096-byte reads: exactly 9000 bytes via head -c.
	ExecResult large = ChildProcess.run("/bin/sh", ["-c", "yes x | head -c 9000"]);
	assert(large.ok());
	assert((int)strlen(large.stdout()) == 9000);
	assert(large.capturedStdoutBytes == 9000);

	// A tiny capture still works (baseline for the same path).
	assert(ChildProcess.run("printf", ["hello"]).stdout().equals("hello"));
#endif

	print("PASS: test_stdlib_process_status_pipe");
	return 0;
}

/* The modes of this program as its own child, which the Windows checks use. */
int childProbe(string mode) {
	if (mode.equals("--exit-5")) { return 5; }
	if (mode.equals("--ntstatus")) { return -1073741510; }
	if (mode.equals("--large")) {
		for (int i = 0; i < 9000; i++) { fputc('x', stdout); }
		return 0;
	}
	if (mode.equals("--hello")) {
		fputs("hello", stdout);
		return 0;
	}
	return 0;
}
