import std.cli;
import std.daemon;
import std.fs;
import std.json;
import std.pattern;
import std.platform;
import std.process;
import std.strings;
import std.ui;
import std.vector;

int main(int argc, char** argv) {
    assert(Platform.isUnix());
    assert(!Platform.isWindows());
    assert(Platform.pathSeparator().equals("/"));
    assert(Platform.pid() > 0);
    assert(UnixPlatform.pid() == Platform.pid());
    assert(Environment.get("__BTRC_TEST_MISSING__", "fallback").equals("fallback"));

    assert(UnixShell.quote("simple").equals("simple"));
    var quoted = UnixShell.quote("hello world");
    assert(quoted.equals("'hello world'"));
    var split = Strings.split("alpha beta gamma", " ");
    assert(split.len == 3);
    assert(split.get(0).equals("alpha"));
    assert(split.get(2).equals("gamma"));
    assert(Strings.removePrefix("--arg=name=value", "--arg=").equals("name=value"));
    assert(Strings.removePrefix("plain", "--arg=").equals("plain"));

    var shell = UnixShell();
    var result = shell.run("printf btrc");
    assert(result.ok());
    assert(result.stdout().equals("btrc"));

    var pipe = UnixProcess.pipe("printf pipe");
    assert(pipe.ok());
    assert(pipe.readAll().equals("pipe"));
    assert(pipe.close().ok());

    var command = Command("printf")
        .arg("hello world");
    var commandResult = shell.run(command);
    assert(commandResult.ok());
    assert(commandResult.stdout().equals("hello world"));

    var envCommand = Command("sh")
        .arg("-c")
        .arg("printf '%s' \"$BTRC_ENV_VALUE\"");
    var envResult = shell.run(envCommand, env=["BTRC_ENV_VALUE=hello world"]);
    assert(envResult.ok());
    assert(envResult.stdout().equals("hello world"));
    var envRejected = 0;
    try {
        shell.run("true", env=["BTRC-BAD=value"], logFailure=false);
    } catch (string e) {
        envRejected = 1;
    }
    assert(envRejected == 1);

    var ps = PowerShell();
    var unsupported = ps.run("Write-Output nope");
    assert(!unsupported.ok());
    assert(unsupported.stderr().equals("PowerShell support is not implemented"));

    UiNode root = Ui.div()
        .id("root")
        .child(Ui.button("Save & Close"))
        .child(Ui.input("path", "/tmp/a b"));
    UiDocument document = Ui.document("Demo <App>", root)
        .style("body { color: red; }");
    string html = document.renderHtml();
    assert(html.contains("&lt;App&gt;"));
    assert(html.contains("Save &amp; Close"));
    assert(html.contains("name=\"path\""));
    UiDocument rawDocument = Ui.document("Raw", Ui.rawHtml("<main><strong>Native</strong></main>"));
    assert(rawDocument.renderHtml().contains("<strong>Native</strong>"));
    assert(!rawDocument.renderHtml().contains("&lt;strong&gt;"));

    NativeUiBackend linuxUi = LinuxUiBuilder.native();
    assert(linuxUi.name.equals("linux"));
    assert(linuxUi.notifyCommand("Title", "Body").render().contains("notify-send"));
    assert(linuxUi.alertCommand("Title", "Body").render().contains("zenity"));
    NativeUiBackend macUi = MacUiBuilder.native();
    assert(macUi.notifyCommand("Title", "Body").render().contains("osascript"));
    assert(NativeUi.applescriptString("a \"quote\"").contains("\\\"quote\\\""));

    Thread<int> uiThread = UiRuntime.runCommandAsync(Command("printf").arg("ui"));
    assert(uiThread.join() == 0);

    Tray tray = Tray("NixOS")
        .tip("System controls")
        .item("Upgrade", "nixosctl upgrade")
        .add(TrayItem("Disabled", "noop").disabled());
    assert(tray.items.len == 2);
    assert(tray.items.get(1).renderLabel().contains("disabled"));

    State<int> counter = new State<int>(1);
    int seenVersion = counter.version;
    counter.set(2);
    assert(counter.get() == 2);
    assert(counter.changedSince(seenVersion));

    Signal signal = Signal();
    signal.emit("ready");
    assert(signal.hasEvents());
    assert(signal.latest().equals("ready"));
    signal.clear();
    assert(!signal.hasEvents());

    string daemonDir = FileSystem.tempDir("btrc_system_daemon");
    DaemonSpec daemon = DaemonSpec("demo", Command("printf").arg("hi"))
        .pid(PathTools.join(daemonDir, "demo.control"))
        .log(PathTools.join(daemonDir, "demo.log"))
        .cwd("/tmp");
    string startCommand = daemon.renderStartCommand();
    assert(startCommand.contains("btrc-daemon-supervisor"));
    assert(startCommand.contains("printf hi"));
    assert(startCommand.contains("demo.control"));
    DaemonApp daemonApp = DaemonApp("demo", daemon);
    assert(daemonApp.name.equals("demo"));
    assert(daemonApp.daemon.name.equals("demo"));
    assert(rmdir(daemonDir) == 0);

    string systemFixtureDir = FileSystem.tempDir("btrc_stdlib_system");
    assert(!systemFixtureDir.isEmpty());
    string helpersPath = PathTools.join(systemFixtureDir, "helpers.txt");
    assert(FileSystem.writeText(helpersPath, "contents"));
    FileStatus status = FileStatus(helpersPath);
    assert(status.exists());
    assert(status.isFile());
    assert(FileSystem.exists(helpersPath));
    assert(FileSystem.isFile(helpersPath));
    assert(!FileSystem.isDir(helpersPath));
    assert(FileSystem.readText(helpersPath).equals("contents"));
    assert(PathTools.basename("/tmp/example.txt").equals("example.txt"));
    assert(PathTools.dirname("/tmp/example.txt").equals("/tmp"));
    assert(PathTools.join("/tmp", "example.txt").equals("/tmp/example.txt"));
    assert(FileSystem.removeRecursive(helpersPath) == 0);
    assert(!FileSystem.exists(helpersPath));

    string tempDir = FileSystem.tempDir("btrc-stdlib-fs");
    assert(tempDir.len() > 0);
    assert(FileSystem.isDir(tempDir));
    string linkTarget = PathTools.join(tempDir, "target.txt");
    string linkPath = PathTools.join(tempDir, "target.link");
    FileSystem.writeText(linkTarget, "link target");
    assert(FileSystem.symlink(linkTarget, linkPath) == 0);
    assert(FileSystem.isSymlink(linkPath));
    assert(FileSystem.readLink(linkPath).equals(linkTarget));
    FileSystem.removeRecursive(tempDir);
    assert(!FileSystem.exists(tempDir));

    Directory tmp = Directory("/tmp");
    Vector<string> entries = tmp.entries();
    assert(entries.len >= 0);

    assert(Pattern.matches("*.nix", "host.nix"));
    assert(!Pattern.matches("*.nix", "host.btrc"));

    CliArgs args = CliArgs(argc, argv);
    assert(args.count() == argc - 1);
    assert(!args.has("--missing"));
    assert(args.valueAfter("--missing", "fallback").equals("fallback"));
    assert(args.valueAfterPrefix("--missing=", "fallback").equals("fallback"));
    assert(!args.commandIs("__missing__"));

    var json = JsonObject();
    json.setString("host_path", "modules/hosts/x86_64/VM-TEST.nix");
    json.setString("target", "Standard-Boot");
    json.setBool("enabled", true);
    json.setInt("generation", 42);
    assert(json.has("target"));
    assert(json.getString("target", "").equals("Standard-Boot"));
    assert(json.getBool("enabled", false));
    assert(json.getInt("generation", 0) == 42);

    var encoded = json.stringify();
    assert(encoded.contains("\"target\""));
    assert(encoded.contains("\"Standard-Boot\""));

    var parsed = JsonObject.parse("{\"host_path\":\"modules/hosts/x86_64/VM-TEST.nix\",\"target\":\"Standard-Boot\",\"enabled\":true,\"generation\":42}");
    assert(parsed.getString("host_path", "").equals("modules/hosts/x86_64/VM-TEST.nix"));
    assert(parsed.getString("target", "").equals("Standard-Boot"));
    assert(parsed.getBool("enabled", false));
    assert(parsed.getInt("generation", 0) == 42);

    var jsonPath = PathTools.join(systemFixtureDir, "system.json");
    parsed.writeFile(jsonPath);
    var loaded = JsonObject.readFile(jsonPath);
    assert(loaded.getString("target", "").equals("Standard-Boot"));
    assert(FileSystem.removeRecursive(systemFixtureDir) == 0);
    assert(!FileSystem.exists(systemFixtureDir));

    print("PASS: test_stdlib_system");
    return 0;
}
