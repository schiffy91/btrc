/* Deprecated JSON string extraction still has defined bounds behavior: escaped
 * key names work, non-key string occurrences are skipped, and unterminated
 * values do not return a partial string. */
import Library.JSONX;

#include <assert.h>

int main() {
	string escapedKeys = "{\"a\\\"b\":\"quote\",\"path\\\\key\":\"slash\"}";
	assert(JSON.getString(escapedKeys, "a\"b").equals("quote"));
	assert(JSON.getString(escapedKeys, "path\\key").equals("slash"));

	string valueBeforeKey = "{\"note\":\"x\",\"x\":\"real\"}";
	assert(JSON.getString(valueBeforeKey, "x").equals("real"));

	string afterAnchor = "{\"marker\":\"x\",\"x\":\"second\"}";
	assert(JSON.getStringAfter(afterAnchor, "marker", "x").equals("second"));

	assert(JSON.getString("{\"x\":\"unterminated}", "x").equals(""));
	assert(JSON.getString("{\"u\":\"\\u00e9\"}", "u").equals("\xc3\xa9"));

	print("PASS: test_stdlib_jsonx_safety");
	return 0;
}
