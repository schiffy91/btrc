/* PathTools.basename / dirname edge cases: trailing slashes, root, empty string,
 * and a relative no-slash path. These hit the loops that strip trailing '/' and
 * scan backward for the last separator. */
import Library.FileSystem;
import Library.Platform;

#include <assert.h>

int main() {
	// Normal case (baseline).
	assert(PathTools.basename("/a/b/c.txt").equals("c.txt"));
	assert(PathTools.dirname("/a/b/c.txt").equals("/a/b"));

	// Trailing slash: the trailing '/' is stripped before taking the last part.
	assert(PathTools.basename("/a/b/").equals("b"));
	assert(PathTools.dirname("/a/b/").equals("/a"));

	// Root: dirname of "/" is "/", basename of "/" is "/" (end stays at 0).
	assert(PathTools.dirname("/").equals("/"));
	assert(PathTools.basename("/").equals("/"));

	// Relative path with no slash: dirname is ".", basename is the name itself.
	assert(PathTools.dirname("file.txt").equals("."));
	assert(PathTools.basename("file.txt").equals("file.txt"));

	// Empty string: dirname is ".", basename is "".
	assert(PathTools.dirname("").equals("."));
	assert(PathTools.basename("").equals(""));

	// join keeps a single separator and handles empty sides. These pin the
	// POSIX spelling, so they name it: join itself uses '\' on Windows.
	assert(PathTools.joinFor("/a/", "b", false).equals("/a/b"));
	assert(PathTools.joinFor("/a", "b", false).equals("/a/b"));
	assert(PathTools.joinFor("", "b", false).equals("b"));
	assert(PathTools.joinFor("a", "", false).equals("a"));
	// The host's join agrees with its own platform's rules.
	assert(PathTools.join("/a", "b").equals(PathTools.joinFor("/a", "b", Platform.isWindows())));

	// Platform-independent probes cover drive, UNC, and drive-relative forms.
	assert(PathTools.isAbsoluteFor("C:\\a\\b", true));
	assert(PathTools.isAbsoluteFor("\\\\host\\share\\a", true));
	assert(!PathTools.isAbsoluteFor("C:a", true));
	assert(!PathTools.isAbsoluteFor("a/b", true));
	assert(PathTools.isAbsoluteFor("/a/b", false));
	assert(!PathTools.isAbsoluteFor("a\\b", false));
	assert(PathTools.isRootRelativeFor("\\a", true));
	assert(PathTools.rootLengthFor("C:\\", true) == 3);
	assert(PathTools.rootLengthFor("C:relative", true) == 2);
	assert(PathTools.rootLengthFor("\\\\host\\share\\a", true) == 12);
	assert(PathTools.joinFor("C:\\base", "C:tail", true).equals("C:\\base\\tail"));
	assert(PathTools.joinFor("C:\\base", "D:tail", true).equals("D:tail"));
	assert(PathTools.joinFor("C:", "tail", true).equals("C:tail"));
	assert(PathTools.joinFor("C:\\base", "\\tail", true).equals("C:\\tail"));
	assert(PathTools.joinFor("\\\\host\\share\\dir", "\\tail", true).equals("\\\\host\\share\\tail"));
	assert(PathTools.joinFor("/base", "tail", false).equals("/base/tail"));

	assert(PathTools.basenameFor("C:\\state\\control", true).equals("control"));
	assert(PathTools.dirnameFor("C:\\state\\control", true).equals("C:\\state"));
	assert(PathTools.dirnameFor("C:\\control", true).equals("C:\\"));
	assert(PathTools.basenameFor("C:\\", true).equals("C:\\"));
	assert(PathTools.dirnameFor("\\\\host\\share\\control", true).equals("\\\\host\\share"));
	assert(PathTools.basenameFor("a\\b", false).equals("a\\b"));
	assert(PathTools.dirnameFor("a\\b", false).equals("."));

	print("PASS: test_stdlib_path_edges");
	return 0;
}
