import std.terminal;
import std.terminal_clock;
import std.terminal_cstring_array;
import std.terminal_password_prompts;
import std.vector;

#include <assert.h>
#include <unistd.h>

bool sendIfExpected(UnixPasswdPromptClassifier classifier, int descriptor,
                    string response, string output) {
    if (!classifier.feedText(output)) { return false; }
    return UnixPamPassword.writeResponseUntil(
        descriptor, response, TerminalClock.deadlineAfter(1000));
}

int main() {
    Vector<string> invalidEntries = [];
    invalidEntries.len = -1;
    assert(UnixPamCStringArray.copyAll(invalidEntries) == NULL);

    UnixPasswdPromptClassifier root = UnixPasswdPromptClassifier(2);
    assert(!root.feedText("passwd: Authentication token error\r\n"));
    assert(!root.feedText("audit: detail: New password policy applies\n"));
    assert(!root.feedText("Retype password:\n"));
    string newPrefix = "New pass";
    assert(!root.feedChunk(newPrefix));
    string newSuffix = "word: \t";
    assert(root.feedChunk(newSuffix));
    assert(root.acceptPending());
    assert(root.matchedResponses() == 1);
    assert(root.feedText("Re-enter new password:  "));
    assert(root.complete());
    assert(!root.feedText("New password:"));

    UnixPasswdPromptClassifier busybox = UnixPasswdPromptClassifier(2);
    assert(!busybox.feedText("Retype password:\n"));
    assert(busybox.feedText("New password:"));
    assert(busybox.feedText("\r\nRetype password:"));
    assert(busybox.complete());

    UnixPasswdPromptClassifier user = UnixPasswdPromptClassifier(3);
    assert(!user.feedRaw((char*)"\x1b[", 2));
    string colorAndPrefix = "33mCurrent pass";
    assert(!user.feedChunk(colorAndPrefix));
    string coloredSuffix = "word:\x1b[0m ";
    assert(user.feedChunk(coloredSuffix));
    assert(user.acceptPending());
    assert(user.feedText("\r\nEnter new UNIX password:"));
    assert(user.feedText("\nRetype new UNIX password:"));
    assert(user.complete());

    UnixPasswdPromptClassifier unixVariant = UnixPasswdPromptClassifier(3);
    assert(unixVariant.feedText("(current) UNIX password:"));
    assert(unixVariant.feedText("\r\nNew Password:"));
    assert(unixVariant.feedText("\nRetype New Password:"));
    assert(unixVariant.complete());

    /* A candidate cannot be accepted while an ANSI sequence is incomplete;
     * arbitrary PTY chunking may subsequently complete a valid SGR sequence. */
    UnixPasswdPromptClassifier incomplete = UnixPasswdPromptClassifier(2);
    string incompleteCsi = "New password:\x1b[0";
    assert(!incomplete.feedChunk(incompleteCsi));
    assert(incomplete.incompleteCandidate());
    assert(!incomplete.acceptPending());
    assert(incomplete.feedRaw((char*)"m", 1));
    assert(!incomplete.incompleteCandidate());
    assert(incomplete.acceptPending());

    UnixPasswdPromptClassifier malformed = UnixPasswdPromptClassifier(2);
    assert(!malformed.feedText("New password:\x1b[1; m"));
    assert(!malformed.feedText("New password:"));
    assert(malformed.feedText("\nNew password:"));

    UnixPasswdPromptClassifier osc = UnixPasswdPromptClassifier(2);
    assert(!osc.feedText("New password:\x1b]0;title\x07"));
    assert(!osc.acceptPending());
    assert(!osc.feedText("New password:"));

    UnixPasswdPromptClassifier unknownEscape =
        UnixPasswdPromptClassifier(2);
    assert(!unknownEscape.feedText("New pass\x1bXword:"));
    assert(!unknownEscape.feedText("\nNew password:\x1b[2K"));

    UnixPasswdPromptClassifier longEscape =
        UnixPasswdPromptClassifier(2);
    string excessiveCsi = "\x1b[" + "1".repeat(17)
        + "mNew password:";
    assert(!longEscape.feedText(excessiveCsi));

    UnixPasswdPromptClassifier longVisible =
        UnixPasswdPromptClassifier(2);
    assert(!longVisible.feedText("x".repeat(129) + "New password:"));

    UnixPasswdPromptClassifier longRaw = UnixPasswdPromptClassifier(2);
    string decoration = "\x1b[00000000000000m";
    assert(!longRaw.feedText(
        decoration.repeat(12) + "New password:"));

    UnixPasswdPromptClassifier whitespace =
        UnixPasswdPromptClassifier(2);
    assert(!whitespace.feedText("\tNew password:"));
    assert(!whitespace.feedText("\nNew  password:"));
    assert(whitespace.feedText("\nNew password:\t "));

    UnixPasswdPromptClassifier delayed = UnixPasswdPromptClassifier(2);
    string candidate = "New password:";
    assert(delayed.feedChunk(candidate));
    string diagnosticSuffix = " policy diagnostic\r\n";
    assert(!delayed.feedChunk(diagnosticSuffix));
    assert(!delayed.acceptPending());
    assert(delayed.feedText("New password:"));

    UnixPasswdPromptClassifier invalidCount =
        UnixPasswdPromptClassifier(4);
    assert(!invalidCount.feedText("Current password:"));
    assert(!invalidCount.complete());

    /* The ordered classifier and independent response cap jointly ensure that
     * diagnostics and prompt-shaped output after completion emit no bytes. */
    int channel[2];
    assert(pipe(channel) == 0);
    UnixPasswdPromptClassifier writer = UnixPasswdPromptClassifier(2);
    assert(!sendIfExpected(
        writer, channel[1], "no-send", "backend: diagnostic:\n"));
    assert(sendIfExpected(
        writer, channel[1], "first-secret", "New password:"));
    assert(sendIfExpected(
        writer, channel[1], "second-secret", "Retype new password:"));
    assert(!sendIfExpected(
        writer, channel[1], "extra-secret", "New password:"));
    close(channel[1]);

    char captured[128];
    ssize_t capturedLength = read(channel[0], captured, sizeof(captured));
    close(channel[0]);
    string expected = "first-secret\nsecond-secret\n";
    assert(capturedLength == (ssize_t)expected.len());
    assert(memcmp(captured, (char*)expected,
        (size_t)expected.len()) == 0);

    print("PASS: test_stdlib_terminal_password_prompts");
    return 0;
}
