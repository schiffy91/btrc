/* Generic interface declared with type params (interface Gettable<T>),
 * implemented by a generic class via a bare `implements Gettable`. Verifies the
 * interface method and the type-parameter accessor across two instantiations.
 *
 * NOTE: `implements Gettable<T>` (with explicit type args) is a parse error in
 * the reference compiler ("Expected LBRACE, got LT '<'"); only the bare form
 * `implements Gettable` parses, so that is what this test exercises. */
#include <assert.h>
#include <string.h>

interface Gettable<T> {
	int tag();
}

class Box<T> implements Gettable {
	public T v;
	public Box(T x) { self.v = x; }

	public int tag() { return 1; }

	public T get() { return self.v; }
}

int main() {
	Box<int> bi = new Box<int>(5);
	assert(bi.tag() == 1);
	assert(bi.get() == 5);

	Box<string> bs = new Box<string>("hi");
	assert(bs.tag() == 1);
	assert(strcmp(bs.get(), "hi") == 0);

	print("PASS: test_generic_interface_impl");
	return 0;
}
