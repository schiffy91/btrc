#include <assert.h>
#define OP_CAP 64

int left_calls = 0;
int right_calls = 0;
int receiver_calls = 0;
int index_calls = 0;
int rhs_calls = 0;
int getter_calls = 0;
int setter_calls = 0;
int raw_values[3];

string? left_probe(string? value) {
    left_calls++;
    return value;
}

string? right_probe(string? value) {
    right_calls++;
    return value;
}

int index_probe() {
    index_calls++;
    return 1;
}

int rhs_probe() {
    rhs_calls++;
    return 4;
}

int* raw_receiver() {
    receiver_calls++;
    return &raw_values[0];
}

int identity(int value) { return value; }

class StringOps<T> {
    public T value;
    public StringOps(T value) { self.value = value; }
    public bool eq(T other) { return self.value == other; }
    public bool ne(T other) { return self.value != other; }
    public bool lt(T other) { return self.value < other; }
    public bool gt(T other) { return self.value > other; }
    public bool le(T other) { return self.value <= other; }
    public bool ge(T other) { return self.value >= other; }
}

class MagicOps<T> {
    public MagicOps() {}
    public bool eq(T left, T right) { return __btrc_eq(left, right); }
    public bool lt(T left, T right) { return __btrc_lt(left, right); }
    public bool gt(T left, T right) { return __btrc_gt(left, right); }
    public uint hash(T value) { return __btrc_hash(value); }
}

class NumberOps<T> {
    public NumberOps() {}
    public T divide(T left, T right) { return left / right; }
    public T modulo(T left, T right) { return left % right; }
}

class Gauge {
    private int stored;
    public Gauge(int initial) { self.stored = initial; }
    public int value {
        get { getter_calls++; return self.stored; }
        set { setter_calls++; self.stored = value; }
    }
}

class Worker {
    public Worker() {}
    public int update(Vector<int> values, int index, int delta) {
        return values[index] += delta;
    }
    public int updateGauge(Gauge target, int delta) {
        return target.value += delta;
    }
}

class Base {
    public Base() {}
}

class Child extends Base {
    public Child() {}
}

class GenericBase<T> {
    public GenericBase() {}
}

Gauge gauge;
Vector<int> vector;

Gauge gauge_probe() {
    receiver_calls++;
    return gauge;
}

Vector<int> vector_probe() {
    receiver_calls++;
    return vector;
}

int main() {
    string dynamic = "sa" + "me";
    string? nil = null;
    assert(dynamic == "same");
    assert(dynamic != "different");
    assert("alpha" < "beta");
    assert("beta" > "alpha");
    assert("alpha" <= "alpha");
    assert("beta" >= "beta");
    assert(nil == null);
    assert(nil < "alpha");
    assert("alpha" > nil);
    assert(nil <= null);
    assert("alpha" >= nil);
    assert(nil != "alpha");
    assert(left_probe(null) < right_probe("x"));
    assert(left_calls == 1 && right_calls == 1);

    StringOps<string?> empty = new StringOps<string?>(null);
    StringOps<string?> text = new StringOps<string?>(dynamic);
    assert(empty.eq(null));
    assert(empty.ne("same"));
    assert(empty.lt("same"));
    assert(text.gt(null));
    assert(empty.le(null));
    assert(text.ge("same"));

    MagicOps<string?> strings = new MagicOps<string?>();
    assert(strings.eq(dynamic, "same"));
    assert(strings.lt(null, "same"));
    assert(strings.gt("same", null));
    assert(strings.hash(null) == 0u);
    assert(strings.hash(dynamic) == strings.hash("same"));
    MagicOps<double> reals = new MagicOps<double>();
    assert(reals.hash(0.0) == reals.hash(-0.0));
    assert(reals.hash(1.5) == reals.hash(1.5));
    assert(reals.hash(NAN) == reals.hash(NAN));
    assert(reals.hash(INFINITY) == reals.hash(INFINITY));

    NumberOps<long long> wide = new NumberOps<long long>();
    assert(wide.divide(8589934592LL, 2LL) == 4294967296LL);
    assert(wide.modulo(8589934593LL, 2LL) == 1LL);
    NumberOps<float> floats = new NumberOps<float>();
    assert(floats.modulo(7.9, 2.0) == 1.0);
    long negative = -2L;
    uint one = 1u;
    var mixed_first = negative + one;
    var mixed_second = one + negative;
    assert(mixed_first == (unsigned long)-1L);
    assert(mixed_second == (unsigned long)-1L);
    unsigned long long ternary = true ? 1LL : 2u;
    assert(ternary == 1ULL);
    uint macro_modulo = 130u % OP_CAP;
    assert(macro_modulo == 2u);

    raw_values[1] = 10;
    receiver_calls = 0;
    index_calls = 0;
    rhs_calls = 0;
    raw_receiver()[index_probe()] += rhs_probe();
    assert(raw_values[1] == 14);
    assert(receiver_calls == 1 && index_calls == 1 && rhs_calls == 1);
    receiver_calls = 0;
    index_calls = 0;
    int raw_old = raw_receiver()[index_probe()]++;
    int raw_new = ++raw_receiver()[index_probe()];
    assert(raw_old == 14 && raw_new == 16);
    assert(receiver_calls == 2 && index_calls == 2);

    gauge = new Gauge(10);
    receiver_calls = 0;
    rhs_calls = 0;
    int property_result = gauge_probe().value += rhs_probe();
    assert(property_result == 14 && gauge.value == 14);
    assert(receiver_calls == 1 && rhs_calls == 1);
    assert(getter_calls == 2 && setter_calls == 1);
    getter_calls = 0;
    setter_calls = 0;
    receiver_calls = 0;
    int property_old = gauge_probe().value++;
    int property_new = ++gauge_probe().value;
    assert(property_old == 14 && property_new == 16 && gauge.value == 16);
    assert(receiver_calls == 2 && getter_calls == 3 && setter_calls == 2);

    vector = [10, 20];
    receiver_calls = 0;
    index_calls = 0;
    rhs_calls = 0;
    int vector_result = vector_probe()[index_probe()] += rhs_probe();
    assert(vector_result == 24 && vector[1] == 24);
    assert(receiver_calls == 1 && index_calls == 1 && rhs_calls == 1);
    receiver_calls = 0;
    index_calls = 0;
    int vector_old = vector_probe()[index_probe()]++;
    int vector_new = ++vector_probe()[index_probe()];
    assert(vector_old == 24 && vector_new == 26 && vector[1] == 26);
    assert(receiver_calls == 2 && index_calls == 2);

    Worker worker = new Worker();
    assert(worker.update(vector, 1, 4) == 30 && vector[1] == 30);
    getter_calls = 0;
    setter_calls = 0;
    assert(worker.updateGauge(gauge, 4) == 20);
    assert(getter_calls == 1 && setter_calls == 1 && gauge.value == 20);

    long long direct_wide = 8589934592LL;
    direct_wide /= 2LL;
    direct_wide %= 3LL;
    assert(direct_wide == 1LL);

    Base base = new Base();
    Child child = new Child();
    Base alias = child;
    assert(alias == child);
    assert(base != child);
    assert((void*)child == child);
    __fn_ptr<int, int> callback = identity;
    assert(callback == callback);
    assert(callback != null);
    GenericBase<int> generic_base = new GenericBase<int>();
    GenericBase<int> generic_other = new GenericBase<int>();
    assert(generic_base != generic_other);

    print("PASS: test_typed_operator_lvalue_parity");
    return 0;
}
