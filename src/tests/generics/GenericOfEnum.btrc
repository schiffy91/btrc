/* Generic class parameterized by a simple enum type: Box<Color>. Verifies an
 * enum value stored as T round-trips through the field and compares correctly
 * after get(). */
#include <assert.h>

enum Color { RED, GREEN, BLUE };

class Box<T> {
	public T v;
	public Box(T x) { self.v = x; }

	public T get() { return self.v; }

	public void set(T x) { self.v = x; }
}

int main() {
	Box<Color> b = new Box<Color>(GREEN);
	assert(b.get() == GREEN);
	assert(b.get() != RED);
	b.set(BLUE);
	assert(b.get() == BLUE);

	print("PASS: test_generic_of_enum");
	return 0;
}
