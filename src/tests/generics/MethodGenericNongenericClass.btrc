/* Generic METHOD on a NON-generic class. The class itself has no type params,
 * so the mangling branch where class_args is empty (class_part == class_base)
 * is exercised. Two distinct U instantiations (int and string). */
#include <assert.h>
#include <string.h>

class Util {
	public Util() {}
	public U pick<U>(U a, U b, bool first) {
		if (first) { return a; }
		return b;
	}
}

int main() {
	Util u = Util();
	assert(u.pick(1, 2, true) == 1);
	assert(u.pick(1, 2, false) == 2);
	assert(strcmp(u.pick("x", "y", true), "x") == 0);
	assert(strcmp(u.pick("x", "y", false), "y") == 0);

	print("PASS: test_method_generic_nongeneric_class");
	return 0;
}
