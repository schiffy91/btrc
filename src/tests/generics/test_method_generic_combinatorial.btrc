/* Combinatorial method-generic mangling: two class instantiations (Holder<int>
 * and Holder<string>) each invoking the generic method transform<U> with two
 * distinct U (identity and a converter). Verifies (class_args x method_args)
 * each monomorphize independently. */
#include <assert.h>
#include <string.h>
import std.strings;

int idInt(int x) { return x; }
string intToStr(int x) { return Strings.fromInt(x); }
string idStr(string s) { return s; }
int strLen(string s) { return s.len(); }

class Holder<T> {
    public T value;
    public Holder(T v) { self.value = v; }
    public U transform<U>(__fn_ptr<U, T> fn) { return fn(self.value); }
}

int main() {
    Holder<int> hi = new Holder<int>(5);
    assert(hi.transform(idInt) == 5);
    assert(strcmp(hi.transform(intToStr), "5") == 0);

    Holder<string> hs = new Holder<string>("abc");
    assert(strcmp(hs.transform(idStr), "abc") == 0);
    assert(hs.transform(strLen) == 3);

    print("PASS: test_method_generic_combinatorial");
    return 0;
}
