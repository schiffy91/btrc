/* A generic METHOD (with its own method type-param <U>) whose RETURN type is the
 * CLASS type param T, not U. Existing method-generic tests all return a
 * method-level type param or a collection of one; none returns the enclosing
 * class's T while still being a generic method, exercising the combined
 * {classArgs, methodArgs} type-map where T resolves from the class and U is
 * monomorphized but unused-in-return. */
#include <assert.h>
#include <string.h>

class Box<T> {
    public T v;
    public Box(T x) { self.v = x; }
    public T choose<U>(U key, T fallback) { return self.v; }
}

int main() {
    Box<int> bi = new Box<int>(7);
    assert(bi.choose("k", 0) == 7);
    assert(bi.choose(99, 0) == 7);

    Box<string> bs = new Box<string>("hi");
    assert(strcmp(bs.choose(1, "x"), "hi") == 0);

    print("PASS: test_generic_method_returns_class_t");
    return 0;
}
