/* Round-trip a type-parameter value into and out of a generic class field via
 * put()/take() across int, float and string instantiations. Verifies plain
 * value-copy correctness of T through field assignment, beyond the magic
 * comparison helpers. */
#include <assert.h>
#include <string.h>

class Cell<T> {
    public T v;
    public Cell(T x) { self.v = x; }
    public void put(T x) { self.v = x; }
    public T take() { return self.v; }
}

int main() {
    Cell<int> ci = new Cell<int>(1);
    assert(ci.take() == 1);
    ci.put(2);
    ci.put(3);
    assert(ci.take() == 3);

    Cell<float> cf = new Cell<float>(1.5);
    assert(cf.take() > 1.4 && cf.take() < 1.6);
    cf.put(9.25);
    assert(cf.take() > 9.2 && cf.take() < 9.3);

    Cell<string> cs = new Cell<string>("a");
    cs.put("hello");
    assert(strcmp(cs.take(), "hello") == 0);

    print("PASS: test_generic_value_roundtrip");
    return 0;
}
