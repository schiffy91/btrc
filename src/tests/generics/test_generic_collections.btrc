/* Regression: collections inside generic class methods.
 * Previously a Vector<T> field emitted bare push()/get() (undeclared C) and a
 * collection for-in inside a generic method was silently dropped. This checks
 * push/get/len, for-in over the generic field, and a concrete-Vector local +
 * for-in — across both an int and a string instantiation. */
import std.vector;

#include <assert.h>
#include <string.h>

class Bag<T> {
    public Vector<T> items;
    public Bag() { self.items = []; }

    public void add(T x) { self.items.push(x); }
    public T at(int i) { return self.items.get(i); }
    public int size() { return self.items.len; }

    /* for-in over the Vector<T> field */
    public int countVia() {
        int n = 0;
        for it in self.items { n = n + 1; }
        return n;
    }

    /* concrete Vector<int> local + list literal + for-in inside a generic method */
    public int localSum() {
        Vector<int> tmp = [1, 2, 3];
        int s = 0;
        for v in tmp { s = s + v; }
        return s;
    }
}

int main() {
    Bag<int> bi = Bag();
    bi.add(10); bi.add(20); bi.add(30);
    assert(bi.size() == 3);
    assert(bi.at(2) == 30);
    assert(bi.countVia() == 3);
    assert(bi.localSum() == 6);

    Bag<string> bs = Bag();
    bs.add("x"); bs.add("y");
    assert(bs.size() == 2);
    assert(strcmp(bs.at(1), "y") == 0);
    assert(bs.countVia() == 2);
    assert(bs.localSum() == 6);

    print("PASS: test_generic_collections");
    return 0;
}
