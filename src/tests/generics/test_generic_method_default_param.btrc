/* A method on a generic class declared with a DEFAULT parameter value
 * (int n = 5). Default params are tested in functions/ and on non-generic
 * constructors, but never on a method of a monomorphized generic class, where
 * the default-fill lowering runs inside the per-instantiation method copy. */
#include <assert.h>
#include <string.h>

class Box<T> {
	public T v;
	public Box(T x) { self.v = x; }

	public int bump(int n = 5) { return n + 1; }

	public T get() { return self.v; }
}

int main() {
	Box<int> bi = new Box<int>(7);
	assert(bi.bump() == 6);
	assert(bi.bump(10) == 11);
	assert(bi.get() == 7);

	/* a second instantiation gets its own copy of the defaulted method */
	Box<string> bs = new Box<string>("hi");
	assert(bs.bump() == 6);
	assert(strcmp(bs.get(), "hi") == 0);

	print("PASS: test_generic_method_default_param");
	return 0;
}
