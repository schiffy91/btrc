import Library.Vector;

#include <assert.h>
#define OP_CAP 64

int leftCalls = 0;
int rightCalls = 0;
int receiverCalls = 0;
int indexCalls = 0;
int rhsCalls = 0;
int getterCalls = 0;
int setterCalls = 0;
int rawValues[3];

string? leftProbe(string? value) {
	leftCalls++;
	return value;
}

string? rightProbe(string? value) {
	rightCalls++;
	return value;
}

int indexProbe() {
	indexCalls++;
	return 1;
}

int rhsProbe() {
	rhsCalls++;
	return 4;
}

int* rawReceiver() {
	receiverCalls++;
	return &rawValues[0];
}

int identity(int value) { return value; }

class StringOps<T> {
	public T value;
	public StringOps(T value) { self.value = value; }

	public bool eq(T other) { return self.value == other; }

	public bool ne(T other) { return self.value != other; }

	public bool lt(T other) { return self.value < other; }

	public bool gt(T other) { return self.value > other; }

	public bool le(T other) { return self.value <= other; }

	public bool ge(T other) { return self.value >= other; }
}

class MagicOps<T> {
	public MagicOps() {}

	public bool eq(T left, T right) { return __btrc_eq(left, right); }

	public bool lt(T left, T right) { return __btrc_lt(left, right); }

	public bool gt(T left, T right) { return __btrc_gt(left, right); }

	public uint hash(T value) { return __btrc_hash(value); }
}

class NumberOps<T> {
	public NumberOps() {}

	public T divide(T left, T right) { return left / right; }

	public T modulo(T left, T right) { return left % right; }
}

class Gauge {
	private int stored;
	public Gauge(int initial) { self.stored = initial; }
	public int value {
		get { getterCalls++; return self.stored; }
		set { setterCalls++; self.stored = value; }
	}
}

class Worker {
	public Worker() {}

	public int update(Vector<int> values, int index, int delta) { return values[index] += delta; }

	public int updateGauge(Gauge target, int delta) { return target.value += delta; }
}

class Base {
	public Base() {}
}

class Child extends Base {
	public Child() {}
}

class GenericBase<T> {
	public GenericBase() {}
}

Gauge gauge;
Vector<int> vector;

Gauge gaugeProbe() {
	receiverCalls++;
	return gauge;
}

Vector<int> vectorProbe() {
	receiverCalls++;
	return vector;
}

int main() {
	string dynamic = "sa" + "me";
	string? nil = null;
	assert(dynamic == "same");
	assert(dynamic != "different");
	assert("alpha" < "beta");
	assert("beta" > "alpha");
	assert("alpha" <= "alpha");
	assert("beta" >= "beta");
	assert(nil == null);
	assert(nil < "alpha");
	assert("alpha" > nil);
	assert(nil <= null);
	assert("alpha" >= nil);
	assert(nil != "alpha");
	assert(leftProbe(null) < rightProbe("x"));
	assert(leftCalls == 1 && rightCalls == 1);

	StringOps<string?> empty = new StringOps<string?>(null);
	StringOps<string?> text = new StringOps<string?>(dynamic);
	assert(empty.eq(null));
	assert(empty.ne("same"));
	assert(empty.lt("same"));
	assert(text.gt(null));
	assert(empty.le(null));
	assert(text.ge("same"));

	MagicOps<string?> strings = new MagicOps<string?>();
	assert(strings.eq(dynamic, "same"));
	assert(strings.lt(null, "same"));
	assert(strings.gt("same", null));
	assert(strings.hash(null) == 0u);
	assert(strings.hash(dynamic) == strings.hash("same"));
	MagicOps<double> reals = new MagicOps<double>();
	assert(reals.hash(0.0) == reals.hash(-0.0));
	assert(reals.hash(1.5) == reals.hash(1.5));
	assert(reals.hash(NAN) == reals.hash(NAN));
	assert(reals.hash(INFINITY) == reals.hash(INFINITY));

	NumberOps<long long> wide = new NumberOps<long long>();
	assert(wide.divide(8589934592LL, 2LL) == 4294967296LL);
	assert(wide.modulo(8589934593LL, 2LL) == 1LL);
	NumberOps<float> floats = new NumberOps<float>();
	assert(floats.modulo(7.9, 2.0) == 1.0);
	long negative = -2L;
	uint one = 1u;
	var mixedFirst = negative + one;
	var mixedSecond = one + negative;
	assert(mixedFirst == (unsigned long)-1L);
	assert(mixedSecond == (unsigned long)-1L);
	unsigned long long ternary = true ? 1LL : 2u;
	assert(ternary == 1ULL);
	uint macroModulo = 130u % OP_CAP;
	assert(macroModulo == 2u);

	rawValues[1] = 10;
	receiverCalls = 0;
	indexCalls = 0;
	rhsCalls = 0;
	rawReceiver()[indexProbe()] += rhsProbe();
	assert(rawValues[1] == 14);
	assert(receiverCalls == 1 && indexCalls == 1 && rhsCalls == 1);
	receiverCalls = 0;
	indexCalls = 0;
	int rawOld = rawReceiver()[indexProbe()]++;
	int rawNew = ++rawReceiver()[indexProbe()];
	assert(rawOld == 14 && rawNew == 16);
	assert(receiverCalls == 2 && indexCalls == 2);

	gauge = new Gauge(10);
	receiverCalls = 0;
	rhsCalls = 0;
	int propertyResult = gaugeProbe().value += rhsProbe();
	assert(propertyResult == 14 && gauge.value == 14);
	assert(receiverCalls == 1 && rhsCalls == 1);
	assert(getterCalls == 2 && setterCalls == 1);
	getterCalls = 0;
	setterCalls = 0;
	receiverCalls = 0;
	int propertyOld = gaugeProbe().value++;
	int propertyNew = ++gaugeProbe().value;
	assert(propertyOld == 14 && propertyNew == 16 && gauge.value == 16);
	assert(receiverCalls == 2 && getterCalls == 3 && setterCalls == 2);

	vector = [10, 20];
	receiverCalls = 0;
	indexCalls = 0;
	rhsCalls = 0;
	int vectorResult = vectorProbe()[indexProbe()] += rhsProbe();
	assert(vectorResult == 24 && vector[1] == 24);
	assert(receiverCalls == 1 && indexCalls == 1 && rhsCalls == 1);
	receiverCalls = 0;
	indexCalls = 0;
	int vectorOld = vectorProbe()[indexProbe()]++;
	int vectorNew = ++vectorProbe()[indexProbe()];
	assert(vectorOld == 24 && vectorNew == 26 && vector[1] == 26);
	assert(receiverCalls == 2 && indexCalls == 2);

	Worker worker = new Worker();
	assert(worker.update(vector, 1, 4) == 30 && vector[1] == 30);
	getterCalls = 0;
	setterCalls = 0;
	assert(worker.updateGauge(gauge, 4) == 20);
	assert(getterCalls == 1 && setterCalls == 1 && gauge.value == 20);

	long long directWide = 8589934592LL;
	directWide /= 2LL;
	directWide %= 3LL;
	assert(directWide == 1LL);

	Base base = new Base();
	Child child = new Child();
	Base alias = child;
	assert(alias == child);
	assert(base != child);
	assert((void*)child == child);
	__fn_ptr<int, int> callback = identity;
	assert(callback == callback);
	assert(callback != null);
	GenericBase<int> genericBase = new GenericBase<int>();
	GenericBase<int> genericOther = new GenericBase<int>();
	assert(genericBase != genericOther);

	print("PASS: test_typed_operator_lvalue_parity");
	return 0;
}
